{
    "word_family": [
        "fencer",
        "fencing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63332de0-6fd4-3a86-a4b9-3e6ef98f595d",
                    "sense_definition": "A structure made of wood, metal, or wire that divides land or keeps people and animals in or out.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "barrier_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer built a new <w>fence</w> around the pasture.",
                            "target_lang_translations": {
                                "ru": "Фермер построил новый <w>забор</w> вокруг пастбища.",
                                "zh": "农夫在牧场周围建了一道新<w>栅栏</w>。",
                                "cs": "Farmář postavil kolem pastviny nový <w>plot</w>."
                            }
                        },
                        {
                            "text": "Our dog jumped over the garden <w>fence</w> and ran away.",
                            "target_lang_translations": {
                                "ru": "Наша собака перепрыгнула через садовую <w>изгородь</w> и убежала.",
                                "zh": "我们的狗跳过花园<w>围栏</w>跑掉了。",
                                "cs": "Náš pes přeskočil zahradní <w>plot</w> a utekl."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wooden fence",
                        "electric fence",
                        "sit on the fence",
                        "garden fence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сооружение из дерева, металла или проволоки, которое разделяет территорию или ограничивает доступ.",
                        "zh": "用木头、金属或铁丝制成的结构，用于划分土地或防止人畜进出。",
                        "cs": "Konstrukce ze dřeva, kovu nebo drátu, která rozděluje pozemek nebo brání lidem a zvířatům v přístupu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забор",
                                "target_lang_sense_clarification": "наиболее общее слово"
                            },
                            {
                                "target_lang_word": "изгородь",
                                "target_lang_sense_clarification": "обычно легкая или живая ограда"
                            },
                            {
                                "target_lang_word": "ограда",
                                "target_lang_sense_clarification": "сооружение, препятствующее проходу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "栅栏",
                                "target_lang_sense_clarification": "最通用的术语"
                            },
                            {
                                "target_lang_word": "围栏",
                                "target_lang_sense_clarification": "用于围住区域的结构"
                            },
                            {
                                "target_lang_word": "篱笆",
                                "target_lang_sense_clarification": "通常指用树枝或植物编成的围栏"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "oplocení",
                                "target_lang_sense_clarification": "obecný termín pro jakoukoli bariéru"
                            },
                            {
                                "target_lang_word": "plot",
                                "target_lang_sense_clarification": "nejčastější označení pro zahradní nebo pozemkovou bariéru"
                            },
                            {
                                "target_lang_word": "ohrada",
                                "target_lang_sense_clarification": "často pro ohraničení prostoru pro zvířata"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2da5a28c-a3f8-33bb-956f-12272ba7157c",
                    "sense_definition": "A person who illegally buys and sells stolen goods.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criminal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief sold the stolen jewelry to a <w>fence</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Вор продал украденные драгоценности <w>скупщику краденого</w> в городе.",
                                "zh": "小偷把偷来的珠宝卖给了城里的一个<w>销赃者</w>。",
                                "cs": "Zloděj prodal ukradené šperky <w>překupníkovi</w> ve městě."
                            }
                        },
                        {
                            "text": "Police arrested the <w>fence</w> for trafficking illegal electronics.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала <w>скупщика краденого</w> за торговлю нелегальной электроникой.",
                                "zh": "警方逮捕了那名非法贩卖电子产品的<w>销赃者</w>。",
                                "cs": "Policie zatkla <w>překupníka</w> za obchodování s nelegální elektronikou."
                            }
                        }
                    ],
                    "common_phrases": [
                        "act as a fence"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in criminal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который незаконно скупает и перепродает краденые вещи.",
                        "zh": "非法购买和销售赃物的人。",
                        "cs": "Osoba, která nelegálně nakupuje a prodává kradené zboží."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скупщик краденого",
                                "target_lang_sense_clarification": "официальный/описательный термин"
                            },
                            {
                                "target_lang_word": "барыга",
                                "target_lang_sense_clarification": "жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "销赃者",
                                "target_lang_sense_clarification": "正式的法律或描述性术语"
                            },
                            {
                                "target_lang_word": "黑市商人",
                                "target_lang_sense_clarification": "指从事非法交易的人"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "překupník",
                                "target_lang_sense_clarification": "osoba obchodující s kradeným zbožím"
                            },
                            {
                                "target_lang_word": "zastavárník",
                                "target_lang_sense_clarification": "v kontextu nelegálního výkupu v zastavárnách"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c224640-97f9-3274-95d9-a52893820ca4",
                    "sense_definition": "To surround or separate an area with a barrier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "barrier_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>fence</w> the backyard to keep the children safe.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>огородить</w> задний двор, чтобы обезопасить детей.",
                                "zh": "他们决定把后院<w>围起来</w>以保障孩子们的安全。",
                                "cs": "Rozhodli se dvorek <w>oplotit</w>, aby zajistili bezpečí dětí."
                            }
                        },
                        {
                            "text": "The construction site was <w>fenced</w> off to prevent accidents.",
                            "target_lang_translations": {
                                "ru": "Строительная площадка была <w>огорожена</w> во избежание несчастных случаев.",
                                "zh": "施工现场被<w>围起</w>以防止发生事故。",
                                "cs": "Staveniště bylo <w>ohrazeno</w>, aby se předešlo nehodám."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fence in",
                        "fence off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать или разделять территорию барьером.",
                        "zh": "用障碍物围住或分隔某区域。",
                        "cs": "Obklopit nebo oddělit prostor bariérou."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огораживать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "огородить",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "围起",
                                "target_lang_sense_clarification": "用围栏等物圈住"
                            },
                            {
                                "target_lang_word": "隔开",
                                "target_lang_sense_clarification": "将区域分开"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "oplotit",
                                "target_lang_sense_clarification": "obehnat plotem"
                            },
                            {
                                "target_lang_word": "ohradit",
                                "target_lang_sense_clarification": "vytvořit ohradu nebo bariéru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2aa2dd1-6d83-3593-838f-f0b430ce9921",
                    "sense_definition": "To fight with swords as a sport.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sport_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He learned to <w>fence</w> while he was at university.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>фехтовать</w>, когда учился в университете.",
                                "zh": "他在大学期间学会了<w>击剑</w>。",
                                "cs": "Během studií na univerzitě se naučil <w>šermovat</w>."
                            }
                        },
                        {
                            "text": "The athletes <w>fence</w> with great skill and speed.",
                            "target_lang_translations": {
                                "ru": "Спортсмены <w>фехтуют</w> с большим мастерством и скоростью.",
                                "zh": "运动员们以高超的技巧和速度进行<w>击剑</w>比赛。",
                                "cs": "Sportovci <w>šermují</w> s velkou obratností a rychlostí."
                            }
                        }
                    ],
                    "common_phrases": [
                        "learn to fence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сражаться на шпагах или рапирах как вид спорта.",
                        "zh": "作为一项运动进行剑术格斗。",
                        "cs": "Bojovat s mečem jako sportovní disciplína."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фехтовать",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击剑",
                                "target_lang_sense_clarification": "体育运动"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "šermovat",
                                "target_lang_sense_clarification": "sportovní šerm"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd3cd55-af93-391b-830e-ae6f46b3aa38",
                    "sense_definition": "To avoid giving a direct answer to a question.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "evasive_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician started to <w>fence</w> when asked about the scandal.",
                            "target_lang_translations": {
                                "ru": "Политик начал <w>уклоняться от ответа</w>, когда его спросили о скандале.",
                                "zh": "当被问及丑闻时，那位政客开始<w>闪烁其词</w>。",
                                "cs": "Když přišla řeč na skandál, politik začal <w>kličkovat</w>."
                            }
                        },
                        {
                            "text": "Don't <w>fence</w> with me; just tell me the truth.",
                            "target_lang_translations": {
                                "ru": "Не <w>увиливай</w>, просто скажи мне правду.",
                                "zh": "别跟我<w>兜圈子</w>，直接告诉我真相。",
                                "cs": "Nekličkuj přede mnou, prostě mi řekni pravdu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fence with someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уклоняться от прямого ответа на вопрос.",
                        "zh": "在回答问题时避免给出直接的答复。",
                        "cs": "Vyhýbat se přímé odpovědi na otázku."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уклоняться от ответа",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "отбиваться от вопросов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁其词",
                                "target_lang_sense_clarification": "指说话躲闪，不正面回答"
                            },
                            {
                                "target_lang_word": "推诿",
                                "target_lang_sense_clarification": "推卸责任或回避问题"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyhýbat se odpovědi",
                                "target_lang_sense_clarification": "přímý popis jednání"
                            },
                            {
                                "target_lang_word": "kličkovat",
                                "target_lang_sense_clarification": "přenesený význam pro vyhýbavé chování"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc311272-7f94-3caa-b48c-27c564211ff9",
                    "sense_definition": "To sell stolen goods illegally.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criminal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was caught trying to <w>fence</w> the stolen watches.",
                            "target_lang_translations": {
                                "ru": "Его поймали при попытке <w>сбыть</w> краденые часы.",
                                "zh": "他在试图<w>销赃</w>那些被盗手表时被抓住了。",
                                "cs": "Chytili ho, když se snažil <w>rozprodat</w> kradené hodinky."
                            }
                        },
                        {
                            "text": "Criminals often <w>fence</w> items quickly to avoid detection.",
                            "target_lang_translations": {
                                "ru": "Преступники часто <w>сбывают</w> вещи быстро, чтобы избежать обнаружения.",
                                "zh": "罪犯通常会迅速<w>销赃</w>以避免被发现。",
                                "cs": "Zločinci často kradené věci rychle <w>rozprodávají</w>, aby nebyli odhaleni."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in criminal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно продавать краденые товары.",
                        "zh": "非法销售赃物。",
                        "cs": "Nelegálně prodávat kradené zboží."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбывать краденое",
                                "target_lang_sense_clarification": "криминальный контекст"
                            },
                            {
                                "target_lang_word": "барыжить",
                                "target_lang_sense_clarification": "жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "销赃",
                                "target_lang_sense_clarification": "犯罪术语，指处理赃物"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "rozprodávat kradené",
                                "target_lang_sense_clarification": "kriminální činnost"
                            },
                            {
                                "target_lang_word": "zastavovat",
                                "target_lang_sense_clarification": "v kontextu nelegálního prodeje v zastavárnách"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}