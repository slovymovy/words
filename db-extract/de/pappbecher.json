                ],
                "senses": [
                    {
                        "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                        "entry_id": "cda5ecbb-1ca8-3f61-9e57-5306c54cf27d",
                        "glosses": [
                            "ein Becher aus dem Material Pappe"
                        ],
                        "tags": [
                            "Trinkgefäß"
                        ],
                        "examples": [
                            {
                                "example_id": "e57a91af-bbab-40c6-8060-3bcd1110378c",
                                "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                                "text": "Beim Kindergeburtstag wurde aus Pappbechern getrunken, um die Gefahr kaputter Gläser auszuschließen."
                            },
                            {
                                "example_id": "4ce7ee16-6c7a-4695-9909-65e7608def38",
                                "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                                "text": "„In meiner Hand hielt ich einen Pappbecher mit Kaffee.“"
                            },
                            {
                                "example_id": "c6d361c8-f04d-437d-a15e-a95aa44eac41",
                                "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                                "text": "„Als ich ihm seinen dampfenden Pappbecher reichte, pustete er hinein, bevor er daran nippte.“"
                            },
                            {
                                "example_id": "b1ae7e5d-73d4-4a54-87a9-0ca8b3bc383c",
                                "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                                "text": "„Sævar trank seinen Pappbecher leer und stellte ihn auf einem Regal ab.“"
                            },
                            {
                                "example_id": "4058ed96-874a-4806-9092-9dbd84bd8ae6",
                                "sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
                                "text": "„Leif nahm meinen leeren Pappbecher, stand auf und warf ihn zusammen mit seinem eigenen weg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a4fff4-8af5-40e5-82fa-6132a0ea16cb",
                        "source_entry_id": "cda5ecbb-1ca8-3f61-9e57-5306c54cf27d",
                        "source_sense_id": "738f838c-71fc-366d-82f6-dca3e4e33dd9",
