    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8b168f65-8d9c-3926-bde5-e697a07c03d6",
                    "sense_definition": "Personne qui emploie des salariés et dont ils dépendent dans leur travail ; employeur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chef_employeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>patron</w> m'a accordé quelques jours de vacances supplémentaires."
                        },
                        {
                            "text": "Je dois parler au <w>patron</w> avant de signer mon contrat de travail."
                        },
                        {
                            "text": "Notre <w>patron</w> exige que nous arrivions à huit heures chaque matin."
                        }
                    ],
                    "synonyms": [
                        "boss"
                    ],
                    "common_phrases": [
                        "parler au patron",
                        "un patron exigeant",
                        "changer de patron"
                    ]
                },
                {
                    "sense_id": "fbaa11b4-1079-38e5-aa0a-de392c5ec888",
                    "sense_definition": "Personne qui dirige et possède une petite entreprise artisanale ou commerciale, comme un café, un restaurant ou une boulangerie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chef_employeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>patron</w> du café nous a offert un verre à la fin du repas."
                        },
                        {
                            "text": "Il est son propre <w>patron</w> depuis qu'il a ouvert sa boutique."
                        },
                        {
                            "text": "Cet apprenti cherche un <w>patron</w> pour terminer sa formation."
                        }
                    ],
                    "common_phrases": [
                        "patron de café",
                        "patron boulanger",
                        "le patron du restaurant"
                    ]
                },
                {
                    "sense_id": "6cb71ae0-1dd3-39a7-b82b-913e0625d212",
                    "sense_definition": "Personne qui se trouve au sommet de la hiérarchie dans une entreprise, un organisme ou un service.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chef_employeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>patron</w> du groupe a annoncé de nouveaux investissements hier soir."
                        },
                        {
                            "text": "Les grands <w>patrons</w> ont été reçus à l'Élysée la semaine dernière."
                        },
                        {
                            "text": "Le grand <w>patron</w> de la banque donnera une conférence demain."
                        }
                    ],
                    "synonyms": [
                        "chef",
                        "boss"
                    ],
                    "common_phrases": [
                        "grand patron",
                        "patron du service",
                        "patron du groupe"
                    ]
                },
                {
