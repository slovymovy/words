                                        "sense_id": "1dcf3997-d6d0-3980-9c5a-f80680509fff",
                                        "entry_id": "dd86085c-ba6f-30ce-b0ca-fedd9df7ee33",
                                        "glosses": [
                                            "Actionnaire de la compagnie du Mississipi."
                                        ],
