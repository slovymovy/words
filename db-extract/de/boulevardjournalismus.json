                "senses": [
                    {
                        "sense_id": "4ce45358-adfb-3737-ad1a-40fff44d9215",
                        "entry_id": "7f00e17b-771a-3a3e-b761-26ee55902bd5",
                        "glosses": [
                            "Journalismus, der sich meist vor allem durch eine oberflächliche Recherche sowie durch subjektive und sensationslüsterne Berichterstattung auszeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a676d9-d23b-4f94-9e17-6e09f9aa42c9",
                                "sense_id": "4ce45358-adfb-3737-ad1a-40fff44d9215",
                                "text": "„Auch kann nicht davon ausgegangen werden,dass den Journalisten die Feinheiten einer Ermittlung oder eines Strafverfahrens immer bewusst sind; insbesondere für den Boulevardjournalismus sind spektakuläre Justizfälle ein gefundenes Fressen, um mit Sensationsgeschichten und Stimmungsmache die Auflage zu steigern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b985b887-9ae9-4cb9-a048-dbd471d9cb9e",
                        "source_entry_id": "7f00e17b-771a-3a3e-b761-26ee55902bd5",
                        "source_sense_id": "4ce45358-adfb-3737-ad1a-40fff44d9215",
                        "source_sense_description": "Journalismus mit oberflächlichen Recherchen und sensationslüsterner Berichterstattung",
                        "target_lang_word": "yellow journalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yellow journalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf98e97-c563-36df-ac02-6d0b0d3c7841",
                                        "entry_id": "7fd4b40c-729a-30dd-835b-b27a91275efa",
                                        "glosses": [
                                            "Journalism which is sensationalistic and of questionable accuracy and taste."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eff5ec8b-976f-41fb-b7b9-8f9e04affe8c",
                                                "sense_id": "1bf98e97-c563-36df-ac02-6d0b0d3c7841",
                                                "text": "Near-synonym: tabloidism"
                                            },
                                            {
                                                "example_id": "93fa8e50-6cf4-47a6-ac38-2b7f7642aac8",
                                                "sense_id": "1bf98e97-c563-36df-ac02-6d0b0d3c7841",
                                                "text": "It is the sort of paper which the father of the family is expected to take home with him from his office and read aloud to the chicks before bed-time. It was founded by its proprietor, Mr. Benjamin White, as an antidote to yellow journalism."
                                            },
                                            {
                                                "example_id": "f19de38e-fe7a-4f55-b7a3-514a008578be",
                                                "sense_id": "1bf98e97-c563-36df-ac02-6d0b0d3c7841",
                                                "text": "In the heyday of yellow journalism, newspapers like Joseph Pulitzer’s World and William Randolph Hearst’s New York Journal sent out squads of reporters to hunt down leads and, if evidence failed to materialize, make up stories."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
