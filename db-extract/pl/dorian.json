                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1b648dd-3860-41a4-91d6-8cf954ab9e7e",
                                                "sense_id": "74573ff7-7f2e-349b-95d9-f38dbfe9da24",
                                                "text": "L’acteur et réalisateur équatorien Dorian Chavez pousse une boule de 2 m de diamètre recouverte de vêtements dans les rues de Toulouse, à l’occasion de la Biennale des arts vivants."
                                            },
                                            {
                                                "example_id": "dccfccd5-c74a-4ee6-9a4b-1231b17d273e",
                                                "sense_id": "74573ff7-7f2e-349b-95d9-f38dbfe9da24",
                                                "text": "Au programme : les sonneurs Yves Berthou, Fanch Perennes et Dorian Creignou, Madéok Trio (musique irlandaise), la petite ferme de Créa-Lien, parade médiévale par la compagnie ArtFlex."
                                            },
                                            {
                                                "example_id": "e131ac28-7d8f-4371-a8ff-0594171756d7",
                                                "sense_id": "74573ff7-7f2e-349b-95d9-f38dbfe9da24",
                                                "text": "Le centre Jonathan Danty et le pilier droit Dorian Aldegheri seront ainsi alignés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
