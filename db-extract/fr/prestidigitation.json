                                ]
                            },
                            {
                                "target_word": "magic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dfac707-5f9c-3065-8ff3-920420b44e58",
                                        "entry_id": "c9bfce39-d041-3a58-923a-d6666adfd50b",
                                        "glosses": [
                                            "To produce, transform (something), (as if) by magic."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cca3201-5428-4a3a-9846-dd151b55d713",
                                                "sense_id": "0dfac707-5f9c-3065-8ff3-920420b44e58",
                                                "text": "He pictured them standing about the dim hallway, magicked into immobility, glazed and mute, one with a hand raised, another bending to set down a bag, and Licht before them, nodding and twitching like a marionette, as usual."
                                            },
                                            {
                                                "example_id": "ad6745d9-0c5c-4acf-a443-7010dcd7bcdd",
                                                "sense_id": "0dfac707-5f9c-3065-8ff3-920420b44e58",
                                                "text": "The Western professionals magic so much money offshore that it is impossible to put a reliable figure on it."
                                            },
                                            {
                                                "example_id": "d1577a2d-1e19-4df1-99d4-a42c49505519",
                                                "sense_id": "0dfac707-5f9c-3065-8ff3-920420b44e58",
                                                "text": "None can be magicked overnight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
