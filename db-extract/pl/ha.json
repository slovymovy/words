                            },
                            {
                                "target_word": "ha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                        "entry_id": "af7186bf-9816-3180-b45d-b2ac130f8541",
                                        "glosses": [
                                            "Said when making a vigorous attack."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b16176c7-af33-4fb7-8822-8932f5fc74fe",
                                                "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                                "text": "\"That's well. Well,\" cried he, now for my turn. Ha! a hit! a hit!\""
                                            },
                                            {
                                                "example_id": "fa14f4a2-ddb4-48af-90d4-1205e27978dc",
                                                "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                                "text": "I hit a cross-court forehand. “Ha ha haa. Great! Say, usin' cross-courts and angles like that is how O'Bramowitts beat Riggs.\""
                                            },
                                            {
                                                "example_id": "b086c436-5e3a-4ebc-a2bf-88289cea4f7e",
                                                "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                                "text": "Mona: Hee! Ha! Ho! Ha! The brain buffet is closed, buddy! Take that! And this!"
                                            },
                                            {
                                                "example_id": "53d5a930-477d-4526-81c3-2c4ca17f2cdc",
                                                "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                                "text": "Ha! Take that, you ugly, stupid devil, you."
                                            },
                                            {
                                                "example_id": "290baff7-8c85-4e33-ad99-0683b81aa166",
                                                "sense_id": "e4e6a6db-f94c-31d6-8315-955ee5072bb4",
                                                "text": "'I'm armed, you lot. And if you think you can take me alive . . . Ha! Take that! And that! And that!'"
                                            }
                                        ]
                                    }
                                ]
                            },
