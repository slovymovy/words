                                    {
                                        "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                        "entry_id": "fa010c89-fe1b-31d0-9d83-16ed8e56c8a3",
                                        "glosses": [
                                            "Divination de ce qui doit arriver, par l’inspection de la main et plus particulièrement de ses lignes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb775f44-fbdd-4779-8edd-187561e6b3cc",
                                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                                "text": "Savoir la chiromancie, les règles de la chiromancie."
                                            },
                                            {
                                                "example_id": "63c7d23f-096d-4638-a7cf-0a04ad14640b",
                                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                                "text": "La chiromancie est une science frivole."
                                            },
                                            {
                                                "example_id": "5d70465d-ca59-4319-b0f1-4095ead8c45b",
                                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                                "text": "Des instructions pratiques spécifiques pour l’examen des mains apparaissent aussi dans les discussions de chiromancie qui sont devenues des parties intégrantes des traités de physiognomonie de la fin du Moyen Âge, puisque la chiromancie est « véritablement une partie de la physiognomonie »."
                                            },
                                            {
                                                "example_id": "a21a115f-2af5-44aa-9f16-0ece58f31b21",
                                                "sense_id": "0d89fe1e-66e4-38c2-94de-e5b324549d1b",
                                                "text": "Les sciences dites occultes avaient droit de cité (l’astrologie, la pronostication ou la chiromancie)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
