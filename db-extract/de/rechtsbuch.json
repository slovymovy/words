                "senses": [
                    {
                        "sense_id": "52bb4267-88c5-3158-949a-8c6affb98862",
                        "entry_id": "c9bf8fd9-fdff-34d0-a719-df59f754672a",
                        "glosses": [
                            "Rechtsbücher werden definiert als „Privatarbeiten, die ein größeres Rechtsgebiet (Landrecht, Lehenrecht, Stadtrecht) möglichst umfassend wiederzugeben (zu »spiegeln«) suchen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587d4d57-22f2-44fd-a7bf-2f532cd958b1",
                                "sense_id": "52bb4267-88c5-3158-949a-8c6affb98862",
                                "text": "„Unter den Rechtsbüchern des Mittelalters ist der Sachsenspiegel das bedeutendste.“"
                            },
                            {
                                "example_id": "d578c978-6a0b-4637-9249-ad0190e36684",
                                "sense_id": "52bb4267-88c5-3158-949a-8c6affb98862",
                                "text": "„Auch die aufstrebenden Städte gingen verstärkt dazu über, in den Kanzleien die Urkunden und Rechtsbücher in deutscher Sprache abzufassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "755b728f-fb74-4939-9658-ea5139a024c4",
                        "source_entry_id": "c9bf8fd9-fdff-34d0-a719-df59f754672a",
                        "source_sense_id": "52bb4267-88c5-3158-949a-8c6affb98862",
                        "target_lang_word": "custumal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "custumal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33234112-4d6a-3261-a764-fd243326ec4a",
                                        "entry_id": "d7e47193-2797-389c-b383-a87c0c522f19",
                                        "glosses": [
                                            "A survey of a medieval English manor, listing each tenant and the customs under which the tenancy was held."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80aebaf2-1f86-4648-a573-8e6ecec0a09e",
                                                "sense_id": "33234112-4d6a-3261-a764-fd243326ec4a",
                                                "text": "However, it may have been too unwieldy for a large and growing city, and its business therefore narrowed as the other courts developed. According to an early thirteenth-century custumal, there were three chief folkmoots a year: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7e04493-4a31-4796-9c6a-cb1d0add8549",
                        "source_entry_id": "c9bf8fd9-fdff-34d0-a719-df59f754672a",
                        "source_sense_id": "52bb4267-88c5-3158-949a-8c6affb98862",
                        "target_lang_word": "coutumier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coutumier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa70d21-2da6-3d0d-8e9d-3712bfc7d4ec",
                                        "entry_id": "e7c19404-f538-33ed-80db-87cbb599eee9",
                                        "glosses": [
                                            "Qui a coutume de faire quelque chose, habitué à."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "021b9518-4349-4df4-b0cd-5828e004f7c3",
                                                "sense_id": "6fa70d21-2da6-3d0d-8e9d-3712bfc7d4ec",
                                                "text": "Car toujours je suis coutumière,\nDe payer toute la première."
                                            },
                                            {
                                                "example_id": "c5fdaa80-5abd-4d2c-9320-98549d2b7483",
                                                "sense_id": "6fa70d21-2da6-3d0d-8e9d-3712bfc7d4ec",
                                                "text": "Ce très léger excès, péché de gourmandise dont il s’accusait d’ailleurs véhémentement, et duquel il n’était guère coutumier, l’avait vivement dérangé."
                                            },
                                            {
                                                "example_id": "94f73d84-2647-4bf1-94ec-9eac6a763f48",
                                                "sense_id": "6fa70d21-2da6-3d0d-8e9d-3712bfc7d4ec",
                                                "text": "Le bon peuple disait : “il a pris les fièvres à la Colonie” et se sentait prêt à les tenir pour excuse de toutes les dingueries dont les coloniaux sont coutumiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e9072a7-b9e4-38c0-9cca-05339f0271b2",
                                        "entry_id": "e7c19404-f538-33ed-80db-87cbb599eee9",
                                        "glosses": [
                                            "Qui est habituel."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5236626-1798-4cd1-8420-328305d7a9b1",
                                                "sense_id": "4e9072a7-b9e4-38c0-9cca-05339f0271b2",
                                                "text": "Promenade coutumière des clairons et tambours, qui ne savent où se placer et que chaque capitaine expédie au bout opposé du village."
                                            },
                                            {
                                                "example_id": "05c1cd88-607a-4d14-9b6d-8859a4ceb73f",
                                                "sense_id": "4e9072a7-b9e4-38c0-9cca-05339f0271b2",
                                                "text": "L’archéologie et l’anthropologie locales sont coutumières, on le sait, d'une grande sérénité dans l'affirmation. Ledit Poignant ne s'en est pas tenu là : à une portée de fusil du tombeau de Merlin, l'« archidruide », il a retrouvé le tombeau de « son épouse » Viviane !"
                                            },
                                            {
                                                "example_id": "ec2f446b-9aa6-464e-acd3-85a75622cae4",
                                                "sense_id": "4e9072a7-b9e4-38c0-9cca-05339f0271b2",
                                                "text": "Ce n’est pas coutumier que quelqu’un du petit peuple ose claquer le beignet à un notable !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85b0452f-a60d-3b85-bbd4-9a42b979e2cb",
                                        "entry_id": "e7c19404-f538-33ed-80db-87cbb599eee9",
                                        "glosses": [
                                            "Relatif à la coutume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "726f43eb-3225-4958-9c67-a4be951f7faf",
                                                "sense_id": "85b0452f-a60d-3b85-bbd4-9a42b979e2cb",
                                                "text": "Droit coutumier, droit médiéval, puis de l’Ancien Régime, qui reposait sur les coutumes provinciales."
                                            },
                                            {
                                                "example_id": "38f3bfad-3fb0-4fe0-aaca-f316ab024302",
                                                "sense_id": "85b0452f-a60d-3b85-bbd4-9a42b979e2cb",
                                                "text": "Pays coutumier, pays dans lequel s’appliquait le droit coutumier."
                                            },
                                            {
                                                "example_id": "c064c931-7dad-4139-8c52-3d4e50085405",
                                                "sense_id": "85b0452f-a60d-3b85-bbd4-9a42b979e2cb",
                                                "text": "L’usage coutumier et les habitudes traditionnelles ont régi les relations commerciales et les transactions en affaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coutumier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                                        "entry_id": "31f718f3-2a25-37eb-9cbd-3790cc33a074",
                                        "glosses": [
                                            "Recueil des coutumes d’une province ou d’un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "629f19bc-a083-420e-8faf-60eb3b238a71",
                                                "sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                                                "text": "Au XIVᵉ siècle, le liber practicus de consilio Remensi nᵒ 36 et les coutumiers de Champagne considèrent le mariage comme émancipant."
                                            },
                                            {
                                                "example_id": "78fe1d5c-04df-4d4c-8c11-173940cbade9",
                                                "sense_id": "e4698303-d972-36f8-bf8e-1c27c813a7ec",
                                                "text": "Lorsqu’un homme était justicié, lit-on dans le Grand Coutumier, le bourreau avait le droit à tout ce qui était au-dessus de la ceinture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
