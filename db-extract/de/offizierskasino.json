                        ]
                    },
                    {
                        "translation_id": "69747734-1c77-4a55-9b5b-855107b4f3ad",
                        "source_entry_id": "5fc9b1d2-a1a7-3329-8ea0-535d1e79479a",
                        "source_sense_id": "7d5baa95-58dc-35fd-af46-5731832ef173",
                        "source_sense_description": "Militär: Speise- und Aufenthaltsort für Offiziere",
                        "target_lang_word": "mess",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mess",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac6e8adc-ce00-3812-9d8d-7d80632c17c9",
                                        "entry_id": "f6853f9f-46a3-3189-8757-f2b0a9427293",
                                        "glosses": [
                                            "Lieu où des officiers ou des sous-officiers prennent leurs repas ensemble."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccaf02d7-81f1-48b5-bb5e-fdcc6dfe636a",
                                                "sense_id": "ac6e8adc-ce00-3812-9d8d-7d80632c17c9",
                                                "text": "Les officiers de la garde, eux, vont à leur mess."
                                            },
                                            {
                                                "example_id": "f3cb2d63-6cba-416f-90d0-2293e451362a",
                                                "sense_id": "ac6e8adc-ce00-3812-9d8d-7d80632c17c9",
                                                "text": "Il n’était pas jusqu’au placide Rétine qui, se souvenant brusquement du mess de Port-Louis où il passait pour savoir filer la romance, ne fredonnât un air badin de son époque pour Mme Vachette attendrie ou inquiétée :\nJ’ai fait une escarpolette\nLà-bas au fond du jardin…"
                                            },
                                            {
                                                "example_id": "38f3ee12-4692-4eb3-ba62-054882a75c0a",
                                                "sense_id": "ac6e8adc-ce00-3812-9d8d-7d80632c17c9",
                                                "text": "Le lendemain, je me rendis à bord du Rochester, où une quarantaine d’officiers, réunis à leur mess autour d’une table immense, me firent une excellente réception."
                                            },
                                            {
                                                "example_id": "61d219e3-f8e4-46ed-b2a1-f50c539fb4a8",
                                                "sense_id": "ac6e8adc-ce00-3812-9d8d-7d80632c17c9",
                                                "text": "Les militaires et les administrateurs de Cox lui ont réservé un accueil glacial à sa descente du vapeur […]. Guindés dans leur uniforme, armés de tapettes à mouches posées à côté de leurs casques en liège et d’un pichet de citronnade, ces messieurs n’étaient pas très à l’aise lorsqu’ils l’ont reçue au mess des officiers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
