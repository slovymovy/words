                "senses": [
                    {
                        "sense_id": "2433c334-c24a-3d63-bffc-723fd391aff0",
                        "entry_id": "7dd72896-735b-3a97-9e8f-70d9b1739020",
                        "glosses": [
                            "Teilgebiet der Biologie, das quantitativ untersucht, wie sich die ökologischen Interaktionen auf die genetische Zusammensetzung von Populationen auswirken und welche Rückwirkungen dies auf die ökologischen Eigenschaften der Population haben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c67d6ec-f967-43d4-b5a4-d41926c341ad",
                                "sense_id": "2433c334-c24a-3d63-bffc-723fd391aff0",
                                "text": "„Das Arbeitsgebiet, das sich mit den genetischen Aspekten der Evolution auf der Ebene der Populationen befaßt, nennt man Populationsgenetik.“"
                            },
                            {
                                "example_id": "b3c784ec-f906-4fb7-ba25-58d7eaddfb12",
                                "sense_id": "2433c334-c24a-3d63-bffc-723fd391aff0",
                                "text": "Als Purging […] bezeichnet man in der Populationsgenetik das Phänomen, dass es in ingezüchteten Populationen unter gewissen Bedingungen trotz starker Inzucht zu einer Reduktion oder sogar Elimination der Inzuchtdepression kommen kann."
                            },
                            {
                                "example_id": "9dff9567-4c0c-4ac3-ae3b-1a79c1136d17",
                                "sense_id": "2433c334-c24a-3d63-bffc-723fd391aff0",
                                "text": "Eusozialität bedingt ein hohes Maß an Altruismus und ist daher aufschlussreich für Fragen der Populationsgenetik."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
