                        "entry_id": "5516c285-21a0-3a58-8e62-9b5931bd192c",
                        "glosses": [
                            "Maßnahme gegen Angriffe aus dem Luftraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c029e6c8-0840-475a-a403-5b32cd413448",
                                "sense_id": "f25628aa-fa2d-3a21-b14b-7ff3480d3c82",
                                "text": "Mittels Luftabwehr konnten mehrere Städte verteidigt werden."
                            }
