                                                "sense_id": "ad9447e9-6f3f-3077-9986-dec97afb24e5",
                                                "text": "\"Si adatti o esca da questa scuola!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9681faa0-454b-31a9-b672-56687f7625f4",
