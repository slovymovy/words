                "forms": [],
                "senses": [
                    {
                        "sense_id": "4bde870f-13d0-3372-9b59-d8d557a43336",
                        "entry_id": "f367adb8-29da-3927-b80f-9c95455d0a01",
                        "glosses": [
                            "een stad en gemeente in de Nederlandse provincie Zuid-Holland, tevens de provinciehoofdstad en de plaats waar de Nederlandse regering zetelt"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "6a1340c8-e411-42af-a38d-7a9071e0574b",
                                "sense_id": "4bde870f-13d0-3372-9b59-d8d557a43336",
                                "text": "De stichting is gevestigd te 's-Gravenhage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "624fb554-4389-447e-a1fc-dc802d24a1ed",
                        "source_entry_id": "f367adb8-29da-3927-b80f-9c95455d0a01",
                        "source_sense_id": "4bde870f-13d0-3372-9b59-d8d557a43336",
                        "source_sense_description": "een stad en gemeente in de Nederlandse provincie Zuid-Holland",
                        "target_lang_word": "Den Haag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Den Haag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                        "entry_id": "b0d74605-9c57-3199-a429-75fe48a1b659",
                                        "glosses": [
                                            "Stadt in den Niederlanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3275323b-e615-4bd6-9dab-dd5bcfad2abf",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "In der Tat ist die UN-Justiz in Den Haag mittlerweile drei Mal vertreten: Die größten Schlagzeilen hat in den letzten Jahren das Kriegsverbrecher-Tribunal für Ex-Jugoslawien (ICTY) gemacht."
                                            },
                                            {
                                                "example_id": "a43ba2ee-d3cf-46ec-87c7-93b05f0ae16e",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„Zu dieser besonderen Gelegenheit hatte sich Den Haag ordentlich herausgeputzt wie eine höhere Tochter, die sich für einen Tanztee am Sonntagnachmittag feinmacht.“"
                                            },
                                            {
                                                "example_id": "2c54ec51-e252-4123-98c3-7781f5bda7e9",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„Unterzeichnet im Haag am 29. Juli 1899, von Seiner k. u. k. Apostolischen Majestät ratifiziert am 10. Juni 1900, die Ratifikationsurkunde im Haag hinterlegt am 4. September 1900.)“"
                                            },
                                            {
                                                "example_id": "783d3727-3a19-40bf-b503-836c8f2dbc9d",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„Der Kongreß findet wiederum auf Einladung der Internationalen Akademie für vergleichende Rechtswissenschaft, gegründet 1924 mit dem ständigen Sitz im Haag, vom 4.–11. August 1937 im Haag statt.“"
                                            },
                                            {
                                                "example_id": "87948667-3af8-4000-b2c6-e4cb5ec4b56f",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„1918 war aus dem Haag mitgeteilt worden, daß die deutsche Regierung ihren Befehl zurückgezogen habe, gefangene alliierte Piloten von Propagandaflugzeugen vor ein Kriegsgericht zu stellen.“"
                                            },
                                            {
                                                "example_id": "0c7098e5-32a7-4adc-bf4f-5e264e4d8132",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„Der Herr van Halewyn, den ein nicht unbekannter Mann aus dem Haag bey der Gurgel ergriffen, und ihm mit einem Messer gedrohet hatte, ward von dem Schreiber Dederichs und einigen andern beschützet und gerettet.“"
                                            },
                                            {
                                                "example_id": "9bf74440-dc9b-4e29-a6dd-340852900b78",
                                                "sense_id": "abc948f3-cdc5-3078-b332-b046f5eed6be",
                                                "text": "„Die Correspondenzen aus dem Haag und aus Amsterdam an Herzog Jacob sind in dieser Beziehung von höchster Wichtigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
