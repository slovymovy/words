                        "examples": [
                            {
                                "example_id": "244277a5-bed8-474b-bb89-f76ac5752519",
                                "sense_id": "1194f79c-88fe-335c-bd5c-63d1eb0edd36",
                                "text": "Verder maakten de Russen bekend dat ze het toezicht bij Aleppo hebben verscherpt. Vanuit een mobiele commandotoren controleren ze of de strijdende partijen het bestand naleven. De toren kijkt uit op een weg die moet worden gebruikt om hulpgoederen te brengen naar belegerde rebellenwijken in de stad."
                            },
                            {
                                "example_id": "bb421d82-8b49-4efb-9fbd-787c42e4ae43",
                                "sense_id": "1194f79c-88fe-335c-bd5c-63d1eb0edd36",
                                "text": "Toen de avond viel zag Lemp vanaf zijn commandotoren een groot onverlicht schip naderen. Hij liet de U 30 duiken en gaf opdracht het schip te volgen. In de veronderstelling dat het een Brits oorlogsschip was, liet hij tegen 19.30 uur twee torpedo's afvuren."
                            }
                        ]
                    }
