                                "sense_id": "fbe92b19-e218-385e-bd8b-da02fd6c70f8",
                                "text": "„Dem Sofa gegenüber waren ein mit blauem Samt bezogener Zweisitzer und zwei Esszimmerstühle aus Rattan aufgestellt.“"
                            },
                            {
                                "example_id": "6ef594f9-864f-4e2b-9416-554e3cf197eb",
                                "sense_id": "fbe92b19-e218-385e-bd8b-da02fd6c70f8",
                                "text": "„Ein Esszimmerstuhl rattert aus dem Haus und verfehlt Fertility nur knapp.“"
                            }
                        ],
