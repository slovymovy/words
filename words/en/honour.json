                    "sense_id": "23c1baec-d172-3949-bf03-4ba7c2c06e4b",
                    "sense_definition": "British, Canadian, Commonwealth, and Ireland standard spelling of <w>honor</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "spelling_variant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a great <w>honour</w> to be invited to speak at this prestigious event.",
                            "target_lang_translations": {
                                "ru": "Для меня большая <w>честь</w> быть приглашенным выступить на этом престижном мероприятии.",
                                "tr": "Bu prestijli etkinlikte konuşmaya davet edilmek büyük bir <w>onur</w>."
                            }
                        },
                        {
                            "text": "The local park was named in <w>honour</w> of the soldiers who fought in the war.",
                            "target_lang_translations": {
                                "ru": "Местный парк был назван в <w>честь</w> солдат, сражавшихся на войне.",
                                "tr": "Yerel park, savaşta savaşan askerlerin <w>anısına</w> adalandırıldı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in honour of",
                        "maid of honour",
                        "guard of honour",
                        "guest of honour"
                    ],
                    "traits": [
