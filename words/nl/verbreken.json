    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47ec5910-0168-3ef3-9642-fac061f92dd6",
                    "sense_definition": "fysiek kapotmaken of een bestaande verbinding beëindigen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fysieke_scheiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij aarzelde om het zegel van de brief te <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "He hesitated to <w>break</w> the seal of the letter.",
                                "ru": "Он колебался, прежде чем <w>вскрыть</w> печать на письме."
                            }
                        },
                        {
                            "text": "De storm kon de verbinding tussen de twee schepen gemakkelijk <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "The storm could easily <w>sever</w> the connection between the two ships.",
                                "ru": "Шторм мог легко <w>разорвать</w> связь между двумя кораблями."
                            }
                        }
                    ],
                    "antonyms": [
                        "verbinden",
                        "maken"
                    ],
                    "common_phrases": [
                        "het zegel verbreken",
                        "de verbinding verbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically break something open or to terminate an existing connection or link.",
                        "ru": "Физически сломать что-то или прекратить существующее соединение или связь."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "a seal or physical connection"
                            },
                            {
                                "target_lang_word": "sever",
                                "target_lang_sense_clarification": "a connection or link"
                            },
                            {
                                "target_lang_word": "disconnect",
                                "target_lang_sense_clarification": "a technical or physical link"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разорвать",
                                "target_lang_sense_clarification": "связь или соединение"
                            },
                            {
                                "target_lang_word": "вскрыть",
                                "target_lang_sense_clarification": "печать или конверт"
                            },
                            {
                                "target_lang_word": "прервать",
                                "target_lang_sense_clarification": "техническое соединение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6a5c061-1327-3fa1-8ab9-80dce82f334f",
                    "sense_definition": "iets abstracts ongedaan maken of beëindigen, zoals een ban of een stilte",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstracte_beëindiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloot eindelijk de stilte te <w>verbreken</w> en haar verhaal te vertellen.",
                            "target_lang_translations": {
                                "en": "She finally decided to <w>break</w> the silence and tell her story.",
                                "ru": "Она наконец решила <w>прервать</w> молчание и рассказать свою историю."
                            }
                        },
                        {
                            "text": "De held in het sprookje probeerde de betovering van de heks te <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "The hero in the fairy tale tried to <w>break</w> the witch's spell.",
                                "ru": "Герой сказки пытался <w>разрушить</w> чары ведьмы."
                            }
                        }
                    ],
                    "antonyms": [
                        "bevestigen",
                        "handhaven"
                    ],
                    "common_phrases": [
                        "de stilte verbreken",
                        "een ban verbreken",
                        "een betovering verbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To undo or end something abstract, such as a spell, a ban, or a period of silence.",
                        "ru": "Отменить или прекратить что-то абстрактное, например, заклятие, запрет или период молчания."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "silence or a spell"
                            },
                            {
                                "target_lang_word": "lift",
                                "target_lang_sense_clarification": "a ban or curse"
                            },
                            {
                                "target_lang_word": "shatter",
                                "target_lang_sense_clarification": "silence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нарушить",
                                "target_lang_sense_clarification": "тишину"
                            },
                            {
                                "target_lang_word": "разрушить",
                                "target_lang_sense_clarification": "чары или заклятие"
                            },
                            {
                                "target_lang_word": "прервать",
                                "target_lang_sense_clarification": "молчание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e873464-6057-3ef0-9cba-26ca522e6169",
                    "sense_definition": "zich niet houden aan de regels van een contract, belofte of wet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je deze regels negeert, zul je het contract <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "If you ignore these rules, you will <w>breach</w> the contract.",
                                "ru": "Если вы проигнорируете эти правила, вы <w>нарушите</w> контракт."
                            }
                        },
                        {
                            "text": "Het is moreel onjuist om een plechtige belofte zomaar te <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "It is morally wrong to just <w>break</w> a solemn promise.",
                                "ru": "Морально неправильно просто так <w>нарушить</w> торжественное обещание."
                            }
                        }
                    ],
                    "antonyms": [
                        "nakomen",
                        "respecteren"
                    ],
                    "common_phrases": [
                        "een contract verbreken",
                        "een belofte verbreken"
                    ],
                    "target_lang_definitions": {
                        "en": "To fail to observe the terms of a contract, promise, or law.",
                        "ru": "Не соблюдать условия контракта, обещания или закона."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "a promise or contract"
                            },
                            {
                                "target_lang_word": "breach",
                                "target_lang_sense_clarification": "a contract or agreement"
                            },
                            {
                                "target_lang_word": "violate",
                                "target_lang_sense_clarification": "rules or terms"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нарушить",
                                "target_lang_sense_clarification": "обещание или контракт"
                            },
                            {
                                "target_lang_word": "расторгнуть",
                                "target_lang_sense_clarification": "договор или контракт"
                            },
                            {
                                "target_lang_word": "сдержать",
                                "target_lang_sense_clarification": "используется с отрицанием для обещания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d21eff-98f1-36eb-bd90-073e808c1fbe",
                    "sense_definition": "een gerechtelijke uitspraak vernietigen op basis van procedurefouten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "juridisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Hoge Raad kan een vonnis <w>verbreken</w> als de wet niet juist is toegepast.",
                            "target_lang_translations": {
                                "en": "The Supreme Court can <w>quash</w> a verdict if the law has not been applied correctly.",
                                "ru": "Верховный суд может <w>отменить</w> приговор, если закон был применен неверно."
                            }
                        },
                        {
                            "text": "De advocaat hoopte dat de rechter de eerdere uitspraak zou <w>verbreken</w>.",
                            "target_lang_translations": {
                                "en": "The lawyer hoped that the judge would <w>overturn</w> the previous ruling.",
                                "ru": "Адвокат надеялся, что судья <w>отменит</w> предыдущее решение."
                            }
                        }
                    ],
                    "antonyms": [
                        "bekrachtigen"
                    ],
                    "common_phrases": [
                        "een vonnis verbreken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridisch jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To annul or quash a judicial ruling based on procedural errors.",
                        "ru": "Аннулировать или отменить судебное решение на основании процессуальных ошибок."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quash",
