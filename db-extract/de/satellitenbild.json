                "senses": [
                    {
                        "sense_id": "3a418558-8bc5-3120-bc70-a86548cf83e9",
                        "entry_id": "01ae7776-37b6-3a53-909e-04fd64562a43",
                        "glosses": [
                            "Foto, aufgenommen von einer Kamera, die in einem Satelliten eingebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7102f9f6-ff54-4601-8a78-a4ae503665e2",
                                "sense_id": "3a418558-8bc5-3120-bc70-a86548cf83e9",
                                "text": "„Hier, beim ersten Copernicus Earth Oberservation Data Hackathon, einem Entwickler-Event für Erdbeobachtungsdaten, sind sie gerade dabei, die Software zur Verarbeitung der Satellitenbilder in den Griff zu bekommen.“"
                            },
                            {
                                "example_id": "e8d531f5-17bd-4da4-89f2-f0cc18b09bd6",
                                "sense_id": "3a418558-8bc5-3120-bc70-a86548cf83e9",
                                "text": "„Mithilfe von Satellitenbildern konnten die Geoforscher den Ort lokalisieren, an dem die Katastrophe ihren Ursprung nahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
