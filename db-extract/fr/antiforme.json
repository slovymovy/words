                    {
                        "translation_id": "0fcb8e8d-2399-4137-a452-a3c24886df77",
                        "source_entry_id": "b7f7b6c8-f646-3400-99a4-12c85eba0d24",
                        "source_sense_id": "f537d2ce-c0da-3e50-8fdf-ac7744d894fb",
                        "source_sense_description": "Geologie, speziell Tektonik: Antiklinale, Antikline, Sattel",
                        "target_lang_word": "Sattel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sattel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                        "entry_id": "64a7dd08-c8c6-32fc-a7f0-db6ef65f7c1a",
                                        "glosses": [
                                            "mit einer Polsterung versehener Sitz in einer dem menschlichen Körper angepassten Form, der auf dem Rücken des Reittieres befestigt wird"
                                        ],
                                        "tags": [
                                            "Reiten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcc88d08-ea7a-42ce-9f42-6009810ca573",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "„Lambe ritt dann ohne Sattel auf einem Pferd, das ihm zur Verfügung gestellt wurde, während der König in einer Sänfte getragen wurde, die mit einem Baldachin und Vorhängen aus golddurchwirktem Stoff versehen war.“"
                                            },
                                            {
                                                "example_id": "c742e7c2-5597-48f5-94fc-a84cd2e12dd6",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "„Mit dem Kind im Arm steigt er in den Sattel und galoppiert zum Dorf hin davon.“"
                                            },
                                            {
                                                "example_id": "ce81988f-d8bc-4c48-b2be-22e9b0796b1d",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "„Auf diese Weise wurden wir den ganzen Weg nach Halifax gebracht, auf Militärmänteln als Sätteln reitend, ohne Steigbügel, die Pferde in flinkem Schritt.“"
                                            },
                                            {
                                                "example_id": "2b8ca329-bd92-48a3-99bc-101024101d9a",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "„Als Martin im Sattel saß, fühlte er sich weit erhoben über allem Unrat der Schlacht von Borodino.“"
                                            },
                                            {
                                                "example_id": "ce64dd9c-ed80-4ea8-bf71-b1fe11c7cef8",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "Der Sattel ist schon ziemlich alt."
                                            },
                                            {
                                                "example_id": "9a8b7c7c-3f3e-41df-b0a7-d8b4759202e6",
                                                "sense_id": "91563185-363b-39ab-806f-2f269cd8ed5c",
                                                "text": "Die Sättel müssen gut aussehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9af97008-b8c4-3776-9e4a-03d1c41ec4ad",
                                        "entry_id": "64a7dd08-c8c6-32fc-a7f0-db6ef65f7c1a",
                                        "glosses": [
                                            "Sitzvorrichtung an Fahr- und Motorrädern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e919e7a3-115e-4bdf-a2fa-f751f77577ee",
                                                "sense_id": "9af97008-b8c4-3776-9e4a-03d1c41ec4ad",
                                                "text": "Der Sattel ist schon ziemlich alt."
                                            },
                                            {
                                                "example_id": "fd13e22b-849f-41f4-a782-ccac11f7bd74",
                                                "sense_id": "9af97008-b8c4-3776-9e4a-03d1c41ec4ad",
                                                "text": "Die Sättel müssen gut aussehen."
                                            },
                                            {
                                                "example_id": "17c23ce4-4910-4b9e-8f83-651c02abd172",
                                                "sense_id": "9af97008-b8c4-3776-9e4a-03d1c41ec4ad",
                                                "text": "„Nach fünfzig Tagen im Sattel und über 3.000 Kilometern hatte ich Ende August das Donaudelta erreicht.“"
                                            },
                                            {
                                                "example_id": "9b16b222-30e2-43dc-99b5-fe89ab90b90f",
                                                "sense_id": "9af97008-b8c4-3776-9e4a-03d1c41ec4ad",
                                                "text": "„Sie kehrten zurück, kletterten über die umgestürzten Eisentore und nahmen ihre Fahrräder, schüttelten das Unbehagen ab und schwangen sich auf die Sättel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
