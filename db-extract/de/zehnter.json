                                        "sense_id": "0612027c-f2bf-3f1e-906e-90c4410a98eb",
                                        "entry_id": "90e9eacf-1dae-3eed-bcb3-a21527d0dbac",
                                        "glosses": [
                                            "The ordinal numeral form of ten; next in order after that which is ninth."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a884bda-b5d1-469f-9e60-0318262608fe",
                                                "sense_id": "0612027c-f2bf-3f1e-906e-90c4410a98eb",
                                                "text": "My dear young lady, here I am for the tenth time."
                                            },
                                            {
                                                "example_id": "206623dc-3eab-44b8-9ee9-777a81ebd9b7",
                                                "sense_id": "0612027c-f2bf-3f1e-906e-90c4410a98eb",
                                                "text": "These words are formed by the rusty iron point with which I write with difficulty in scrapings of soot and charcoal from the chimney, mixed with blood, in the last month of the tenth year of my captivity."
                                            },
                                            {
                                                "example_id": "65208394-b9d0-41f9-9152-e83e9ce49f5d",
                                                "sense_id": "0612027c-f2bf-3f1e-906e-90c4410a98eb",
                                                "text": "A hunger strike at a South Florida immigration detention center state officials have named “Alligator Alcatraz” has entered its tenth day, as detainees protest what they call inhumane and dangerous living conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45cee17-f3fd-36e5-b076-2b44f2811df1",
                                        "entry_id": "90e9eacf-1dae-3eed-bcb3-a21527d0dbac",
                                        "glosses": [
                                            "Being one of ten equal parts of a whole."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56934bc9-f8cb-4a4c-a9e1-0efaffa8eb70",
                                                "sense_id": "a45cee17-f3fd-36e5-b076-2b44f2811df1",
                                                "text": "The Ephah and the Bath shal be of one measure, that the Bath may containe the tenth part of an Homer, and the Ephah the tenth part of an Homer: the measure thereof shall be after the Homer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tenth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e87d8af8-d7a9-36d7-b33c-5d650b8e3db0",
                                        "entry_id": "428d0998-249a-3335-b45f-1131037ee7af",
                                        "glosses": [
                                            "The person or thing coming next after the ninth in a series; that which is in the tenth position."
