                ],
                "senses": [
                    {
                        "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                        "entry_id": "89b580c7-64d0-3888-8d78-f1b81b00e2e0",
                        "glosses": [
                            "im deutschsprachigen Raum Bezeichnung für eine Stadt mit 20.000 bis 100.000 Einwohnern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555841b1-c351-4ccc-83e8-a87cfdefaf90",
                                "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                                "text": "Das Leben in einer Mittelstadt hat Vor- und Nachteile."
                            },
                            {
                                "example_id": "b1f7158c-b0f3-4433-93ae-2a95abcabacd",
                                "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                                "text": "„Für Göttingen gilt auch die Bezeichnung Mittelstadt, was zum Bundesland passt: Niedersachsen hat die meisten Mittelstädte in Deutschland aufzuweisen.“"
                            },
                            {
                                "example_id": "c876e601-36eb-466b-a0eb-f6bd0202afb1",
                                "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                                "text": "„1914 lebte nur ein gutes Drittel aller Deutschen in Groß- und Mittelstädten, die Mehrheit aber in Kleinstädten und auf dem Land.“"
                            },
                            {
                                "example_id": "00112aa6-00cd-4749-9e2d-2c3e1d22d4b3",
                                "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                                "text": "„Aber es war hochkompliziert, zigtausend Deutsche zum Beispiel aus einer Mittelstadt zu erfassen, zusammenzuführen und rasch über die Grenze zu bringen, hinter der oft genug Leute standen, die die Ausgewiesenen nicht wollten.“"
                            },
                            {
                                "example_id": "684d8a0f-7e16-44f7-adf7-d4de5c442163",
                                "sense_id": "6757ff51-f814-370b-b023-7b3ff6124fac",
                                "text": "„Die Straße erinnerte mich, trotz ihrer Breite, sofort an eine häßliche deutsche Mittelstadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
