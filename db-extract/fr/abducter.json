                ],
                "senses": [
                    {
                        "sense_id": "0664ad10-bc96-3fe4-ae1b-80d43004c391",
                        "entry_id": "428eac6a-313f-3ce4-a76a-8dad786e935f",
                        "glosses": [
                            "Éloigner de l’axe médian du corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec2f5ba9-0258-40d9-9f6b-9dc1acb04581",
                                "sense_id": "0664ad10-bc96-3fe4-ae1b-80d43004c391",
                                "text": "Le test d’Ortolani reloge une hanche délogée; il est exécuté en abductant lentement les cuisses tout en maintenant une pression axiale."
                            },
                            {
                                "example_id": "58c7898a-7322-4d36-a474-1c9ff7c7ba33",
                                "sense_id": "0664ad10-bc96-3fe4-ae1b-80d43004c391",
                                "text": "L’extrémité du petit trochanter se trouve en dehors de l’axe mécanique du membre, et cela est d’autant plus marqué que ces animaux abductent fréquemment la hanche, particulièrement au cours du grimper."
                            },
                            {
                                "example_id": "68857740-eaa6-4afb-967e-1aeddcf8e5bf",
                                "sense_id": "0664ad10-bc96-3fe4-ae1b-80d43004c391",
                                "text": "Les obliques inférieur et supérieur abductent l’œil, avec une composante d’abaissement et d’intorsion pour l’oblique supérieur, et d’élévation et d’extorsion pour l’oblique inférieur."
                            },
                            {
                                "example_id": "f73aed8a-1bc4-449a-a6e8-11d8cd8eacb5",
                                "sense_id": "0664ad10-bc96-3fe4-ae1b-80d43004c391",
                                "text": "Nous avons empoisonné 2 chiens avec cette matière et avons vu que le poison, outre l’accès universel, influe sur les centres des abducteurs: les cordes vocales s’abductent."
                            }
                        ]
                    },
                    {
                        "sense_id": "4193beea-9b6e-346a-98db-7ba9bbc45449",
                        "entry_id": "428eac6a-313f-3ce4-a76a-8dad786e935f",
                        "glosses": [
                            "Enlever, ravir un être humain, en particulier en parlant d’extraterrestres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b73f0d-e5ee-4324-bd70-cc3e796f0559",
                                "sense_id": "4193beea-9b6e-346a-98db-7ba9bbc45449",
                                "text": "En vérité, on estime qu’à l'échelle du monde des millions de personnes ont été abductées ou ont vécu des rencontres rapprochées et des visites extraterrestres."
                            },
                            {
                                "example_id": "475facea-dcac-4e1a-ade8-2dc9ad52db49",
                                "sense_id": "4193beea-9b6e-346a-98db-7ba9bbc45449",
                                "text": "Ils enlèvent des gens un peu partout sur la planète, Creva dit qu’ils les \"abductent\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e596c7e-2920-4d8e-bc8f-e201908cbf41",
                        "source_entry_id": "428eac6a-313f-3ce4-a76a-8dad786e935f",
                        "source_sense_description": "écarter de l’axe",
                        "target_lang_word": "abduct",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abduct",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce9029e2-a0cc-36d3-853c-d103444af355",
                                        "entry_id": "7bf1ef1d-c95f-315a-84bb-4d00bd79e62c",
                                        "glosses": [
                                            "To take away by force; to carry away (a human being) wrongfully and usually with violence or deception; to kidnap."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9fe4ea6-7d1d-411e-a581-d700fc2beeb2",
                                                "sense_id": "ce9029e2-a0cc-36d3-853c-d103444af355",
                                                "text": "to abduct children"
                                            },
                                            {
                                                "example_id": "1726d688-fac5-4d44-8203-d634d271c3e6",
                                                "sense_id": "ce9029e2-a0cc-36d3-853c-d103444af355",
                                                "text": "I was abducted by aliens."
                                            },
                                            {
                                                "example_id": "3b668ca6-ed6a-4bc8-bd96-9405d6603bf1",
                                                "sense_id": "ce9029e2-a0cc-36d3-853c-d103444af355",
                                                "text": "That same night he had by force abducted the president and the secretary of the club, and had taken them, much against their will upon a voyage in the wonderful air-ship, the “Albatross,” which he had constructed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28e4c3af-33b4-31c2-85dd-6a6beb72279d",
                                        "entry_id": "7bf1ef1d-c95f-315a-84bb-4d00bd79e62c",
                                        "glosses": [
                                            "To draw away, as a limb or other part, from the median axis of the body."
                                        ],
