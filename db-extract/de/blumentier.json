                        "glosses": [
                            "Vertreter der Tierklasse Anthozoa vom Stamm der Nesseltiere. Hierzu gehören die meisten Korallen und die Seeanemonen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e995576d-8a4c-421f-93bd-4294061f80e9",
                                "sense_id": "44cce852-739c-36b3-91aa-3d339a193020",
                                "text": "Die Farbenpracht von Korallenriffen ist vor allem auf die unzähligen Blumentiere zurück zu führen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
