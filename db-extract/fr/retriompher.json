                ],
                "senses": [
                    {
                        "sense_id": "a298d6ab-94e6-32db-88e1-d353563d8589",
                        "entry_id": "c8752d17-e8d4-32ba-9d6c-1b6cf2094102",
                        "glosses": [
                            "Triompher à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410ae5e6-7857-4979-b5ba-9fcc6075c6d7",
                                "sense_id": "a298d6ab-94e6-32db-88e1-d353563d8589",
                                "text": "Puis, l'injustice, inévitable à l'ignorance, fait retriompher le nombre."
                            },
                            {
                                "example_id": "cfa58a15-0188-41f5-8c59-8d2c356fc777",
                                "sense_id": "a298d6ab-94e6-32db-88e1-d353563d8589",
                                "text": "La jupe collante aux hanches selon le caprice de la mode du jour, le boléro dessinant la fermeté accrue de la poitrine, le cou gracieux s'élançant, dégagé de la chevelure relevée, vers le coquet panache des plumes noires au chapeau, et surtout, l'admirable séduction du teint mat, des yeux bruns largement emplis d'un velours de lumière, tout redisait la beauté d'hier prête à retriompher bientôt sous l'aiguillon d'un peu de bonheur."
                            }
                        ]
                    }
                ],
