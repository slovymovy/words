                        "sense_id": "f71393a0-b6f6-34c2-b050-5cbade1aceb7",
                        "entry_id": "12cc06ed-1860-37e8-b48d-ae9f82e2d8ca",
                        "glosses": [
                            "A thick oily substance, secreted by the sebaceous glands of the skin, that consists of fat, keratin and cellular debris."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d3aed429-bc41-40cd-a126-701a1648d913",
                                "sense_id": "f71393a0-b6f6-34c2-b050-5cbade1aceb7",
                                "text": "‘I mean, it is not simply adolescent acne caused by the over-excretion of sebum.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "756fd42d-b5c1-443b-bfdd-90bbda81798a",
