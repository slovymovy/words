                "senses": [
                    {
                        "sense_id": "53e1ddd5-8694-3a26-a401-0f28ed3904b5",
                        "entry_id": "745685b4-42dc-33b9-b407-804d5b7b3ec5",
                        "glosses": [
                            "Grain de beauté factice placé sur un bouton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ccec921-0560-444d-9868-b5e5d6709bd2",
                                "sense_id": "53e1ddd5-8694-3a26-a401-0f28ed3904b5",
                                "text": "La receleuse était jolie et de nom et d’effet, puisqu’elle était destinée à faire d’un défaut une grace. Avec tout cela, mesdames, je vous aime beaucoup mieux sans mouches, et j’oserois dire, presque sans voiles, telles que vous êtes, si je ne craignais de donner mauvaise opinion et de ma politesse et de mon goût."
                            },
                            {
                                "example_id": "fcd2744b-c034-45d7-958a-9af9cf97b2b6",
                                "sense_id": "53e1ddd5-8694-3a26-a401-0f28ed3904b5",
                                "text": "tout est prévu, même la « receleuse », qui est destinée à cacher les boutons d’acné !"
                            },
                            {
                                "example_id": "f11703b4-ac48-4d37-8602-080a4044b5a5",
                                "sense_id": "53e1ddd5-8694-3a26-a401-0f28ed3904b5",
                                "text": "La neuvième position, celle de la receleuse, n’était pas déterminée car elle servait à cacher une trace de la petite vérole ou un bouton d’acné."
                            }
                        ]
                    }
