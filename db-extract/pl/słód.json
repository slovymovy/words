                    {
                        "translation_id": "529de1d5-d39d-4055-b0e8-6bd61ee3159e",
                        "source_entry_id": "54ee3827-ffed-3418-8270-7fd27e364dfe",
                        "source_sense_id": "ff4bc344-b47f-37ce-9861-d447034a61b1",
                        "target_lang_word": "malt",
