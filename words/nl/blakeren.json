            "pos": "verb",
            "senses": [
                {
                    "sense_id": "521a8305-5657-3a5d-b83a-e2b6f14ae0f4",
                    "sense_definition": "door hitte of vlammen aan de oppervlakte zwart of verschroeid maken of raken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbranding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stammen van de bomen waren zwart <w>geblakerd</w> door de felle bosbrand die er had gewoed.",
                            "target_lang_translations": {
                                "de": "Die Stämme der Bäume waren durch den heftigen Waldbrand, der dort gewütet hatte, schwarz <w>geschwärzt</w>."
                            }
                        },
                        {
                            "text": "De felle zon leek het droge grasland langzaam te <w>blakeren</w> tijdens de hete zomermaanden.",
                            "target_lang_translations": {
                                "de": "Die sengende Sonne schien das trockene Grasland während der heißen Sommermonate langsam zu <w>versengen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schroeien",
                        "zengen"
                    ],
                    "common_phrases": [
                        "zwart geblakerd"
                    ],
                    "target_lang_definitions": {
                        "de": "durch Hitze oder Flammen an der Oberfläche schwärzen oder ansengen, bzw. schwarz oder versengt werden"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schwärzen",
                                "target_lang_sense_clarification": "durch Ruß oder Feuer schwarz machen"
                            },
                            {
                                "target_lang_word": "versengen",
                                "target_lang_sense_clarification": "oberflächlich verbrennen"
                            },
                            {
                                "target_lang_word": "ansengen",
                                "target_lang_sense_clarification": "leicht an der Oberfläche verbrennen"
                            },
                            {
                                "target_lang_word": "verdorren",
                                "target_lang_sense_clarification": "durch Hitze oder Sonne austrocknen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b01e4020-483d-3c0e-ac73-51481de8c1cd",
                    "sense_definition": "het hout van een scheepswand aan vuur blootstellen om paalworm en vuil te verwijderen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verbranding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als onderdeel van het onderhoud <w>blakerden</w> zij de houten romp van het oude schip grondig.",
                            "target_lang_translations": {
                                "de": "Als Teil der Instandhaltung <w>flämmten</w> sie den hölzernen Rumpf des alten Schiffes gründlich <w>ab</w>."
                            }
                        },
                        {
                            "text": "De scheepstimmermannen moesten het vaartuig eerst <w>blakeren</w> voordat ze een nieuwe laag teer aanbrachten.",
                            "target_lang_translations": {
                                "de": "Die Schiffszimmerleute mussten das Fahrzeug zuerst <w>abflämmen</w>, bevor sie eine neue Schicht Teer auftrugen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historische scheepvaartterm"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "historische Seemannssprache: die hölzerne Schiffswand abflämmen, um Schiffsbohrwürmer und Schmutz zu beseitigen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abflämmen",
                                "target_lang_sense_clarification": "mit Flammen reinigen oder behandeln"
                            },
                            {
                                "target_lang_word": "abbrennen",
                                "target_lang_sense_clarification": "Schiffsholz zur Reinigung oberflächlich befeuern"
                            }
                        ]
                    }
                }
            ]
        }
    ]
