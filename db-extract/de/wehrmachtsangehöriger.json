                "senses": [
                    {
                        "sense_id": "50337586-0962-3a5d-a698-ddb29ccb59d1",
                        "entry_id": "6b4fbbea-7841-3a09-a69b-5d69e57cd41b",
                        "glosses": [
                            "Person, die der Wehrmacht angehörte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b111f39a-e23e-41dc-8ffa-97a610517d15",
                                "sense_id": "50337586-0962-3a5d-a698-ddb29ccb59d1",
                                "text": "„Tatsächlich flüchtet sie zusammen mit anderen Wehrmachtsangehörigen 1944 in Richtung Westen, nach Hamburg.“"
                            },
                            {
                                "example_id": "10a5edab-1969-4d16-8fa1-aa488d4e46e6",
                                "sense_id": "50337586-0962-3a5d-a698-ddb29ccb59d1",
                                "text": "„Wie Bobrowski am 3. September 1941 in einem Brief an Eltern und Schwester festgehalten hat, stand ihm damals als Wehrmachtsangehörigem in Russland ‚eine große Kunstgeschichte (von Adolf Rosenberg)‘ zur Verfügung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
