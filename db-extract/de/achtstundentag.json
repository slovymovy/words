                "senses": [
                    {
                        "sense_id": "62db86f9-21b1-339b-a393-23b6cd817494",
                        "entry_id": "8ac00b03-ec19-34cb-a61a-34aed4542452",
                        "glosses": [
                            "Arbeitstag von acht Stunden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5454bd5f-c4bf-41ad-bfcf-971eea4f0c7c",
                                "sense_id": "62db86f9-21b1-339b-a393-23b6cd817494",
                                "text": "„Er hatte sogar schon mit der Idee einer Fünfzigstundenwoche gespielt, doch sie umzusetzen war leichter gesagt als getan, denn am Ende der Achtstundentage lag oft buchstäblich keine Arbeit mehr auf seinem Schreibtisch, und im Übrigen wusste er nur allzu gut, dass lange Stunden im Büro zu verbringen, um einem unglücklichen Zuhause zu entfliehen, genau die Falle war, in die sein Vater getappt war, ja dass das zweifellos Alfreds erster Versuch einer Selbstmedikation gewesen war.“"
                            },
                            {
                                "example_id": "08215d26-b713-4b84-844b-ee5cbedc7368",
                                "sense_id": "62db86f9-21b1-339b-a393-23b6cd817494",
                                "text": "„Der Achtstundentag war vergessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
