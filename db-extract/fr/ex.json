                                                "example_id": "1e17bdbe-abf1-4b82-a6a4-5a0a3950389b",
                                                "sense_id": "998eea8a-7d5f-3077-ab02-190b980f276b",
                                                "text": "The train was the 12.40 p.m. ex Derby on January 14th, 1914"
                                            },
