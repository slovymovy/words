                ],
                "senses": [
                    {
                        "sense_id": "8ef9fb9f-e74c-379a-a814-cc61d8716b50",
                        "entry_id": "7de46718-c9e3-3d3d-b36e-2b054fec23fd",
                        "glosses": [
                            "Celui qui fait, qui vend des ustensiles de fer-blanc."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e9fe3821-6611-4835-8b05-f0f9b9a741c5",
                                "sense_id": "8ef9fb9f-e74c-379a-a814-cc61d8716b50",
                                "text": "On rencontrait le ferblantier en chapeau melon, avec sa boîte d'herboriste pendue à l'épaule."
                            },
                            {
                                "example_id": "db713341-229b-420a-9063-338e0909ecf3",
                                "sense_id": "8ef9fb9f-e74c-379a-a814-cc61d8716b50",
                                "text": "MEURIS (Amable-Joseph) exerçait à Nantes la profession de ferblantier, quand son courage bien connu appela sur lui l'attention des gardes nationaux de cette ville, qui le nommèrent, au mois d'octobre 1792, commandant du troisième bataillon de la Loire-Inférieure."
                            },
                            {
                                "example_id": "f79e3468-c1bc-4544-ad6a-ef8f2678d364",
                                "sense_id": "8ef9fb9f-e74c-379a-a814-cc61d8716b50",
                                "text": "Le plancher était recouvert de tas de limaille de cuivre et de fer ; une grande table supportait des cafetières, des chandeliers, des vis, des instruments. Pirogov devina aussitôt qu’il se trouvait chez un ferblantier."
                            },
                            {
                                "example_id": "d8683e21-1d97-4db5-ab9d-a209b75cec52",
                                "sense_id": "8ef9fb9f-e74c-379a-a814-cc61d8716b50",
                                "text": "Il ne conserva de cette soirée que le souvenir d’un frère de Mme Bresson qui, ferblantier de son métier, voyait dans la ferblanterie le secret du bonheur universel."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ea72ce1-a6b8-3002-8aa3-5472be1d873b",
