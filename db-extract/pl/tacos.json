                                        "sense_id": "3fee8ce5-005c-35d5-8681-4e775334201d",
                                        "entry_id": "56ac4e5d-9d18-3f1d-8f89-fdc4a2239f31",
                                        "glosses": [
                                            "The vulva."
                                        ],
