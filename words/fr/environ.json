        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bf1a3c7-eb57-31a1-a20e-aca268f1020e",
                    "sense_definition": "Espace ou lieu qui entoure un endroit (presque toujours employé au pluriel).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons fait une longue promenade dans les <w>environs</w> du village.",
                            "target_lang_translations": {
                                "en": "We took a long walk in the village's <w>surroundings</w>.",
                                "ru": "Мы долго гуляли по <w>окрестностям</w> деревни.",
                                "nl": "We hebben een lange wandeling gemaakt in de <w>omgeving</w> van het dorp.",
                                "de": "Wir haben einen langen Spaziergang in der <w>Umgebung</w> des Dorfes gemacht.",
                                "pl": "Długo spacerowaliśmy po <w>okolicach</w> wsi.",
                                "it": "Abbiamo fatto una lunga passeggiata nei <w>dintorni</w> del paese.",
                                "cs": "Podnikli jsme dlouhou procházku po <w>okolí</w> vesnice.",
                                "tr": "Köyün <w>çevresinde</w> uzun bir yürüyüş yaptık.",
                                "es": "Dimos un largo paseo por los <w>alrededores</w> del pueblo.",
                                "zh": "我们在村子<w>周围</w>散了很久的步。"
                            }
                        },
                        {
                            "text": "Il n'y a aucun commerce dans les <w>environs</w> immédiats de la maison.",
                            "target_lang_translations": {
                                "en": "There are no shops in the immediate <w>vicinity</w> of the house.",
                                "ru": "В ближайших <w>окрестностях</w> дома нет ни одного магазина.",
                                "nl": "Er is geen enkele winkel in de directe <w>omgeving</w> van het huis.",
                                "de": "Es gibt kein einziges Geschäft in der unmittelbaren <w>Umgebung</w> des Hauses.",
                                "pl": "W najbliższych <w>okolicach</w> domu nie ma żadnego sklepu.",
                                "it": "Non c'è nessun negozio nelle immediate <w>vicinanze</w> della casa.",
                                "cs": "V nejbližším <w>okolí</w> domu není žádný obchod.",
                                "tr": "Evin hemen <w>civarında</w> hiçbir dükkân yok.",
                                "es": "No hay ningún comercio en las <w>inmediaciones</w> de la casa.",
                                "zh": "房子<w>附近</w>连一家商店都没有。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dans les environs",
                        "les environs de la ville"
                    ],
                    "target_lang_definitions": {
                        "en": "The area surrounding a place; almost always used in the plural.",
                        "ru": "Пространство или местность вокруг какого-либо места; обычно употребляется во множественном числе.",
                        "nl": "Gebied dat een plek omringt, bijna altijd in het meervoud.",
                        "de": "Gebiet, das einen Ort umgibt; meist im Plural verwendet.",
                        "pl": "Obszar otaczający dane miejsce; prawie zawsze używany w liczbie mnogiej.",
