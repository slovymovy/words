                        "glosses": [
                            "Wort, das keine lexikalische Bedeutung hat, sondern nur eine grammatische"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea6b02c3-a5cf-4cfb-a1d4-98c219a5474b",
                                "sense_id": "2aa95b12-00a9-383b-98c0-ce345f70c60d",
                                "text": "Zu den Strukturwörtern gehören im Deutschen die Konjunktionen und die Subjunktionen, die Artikel, Pronomen und Präpositionen."
                            },
                            {
                                "example_id": "0d84c0ac-94da-48d7-a233-f0624240454b",
                                "sense_id": "2aa95b12-00a9-383b-98c0-ce345f70c60d",
                                "text": "„Die Abgrenzung zwischen den Strukturwörtern und den Inhaltswörtern mag zwar nicht wirklich trennscharf sein, außer man setzt schon eine bestimmte Logik voraus.“"
                            }
                        ],
