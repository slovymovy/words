                "senses": [
                    {
                        "sense_id": "e900ac10-3afd-31e0-8d5b-d653e034c3d0",
                        "entry_id": "0b38a0dd-1f3d-3dea-8d14-f37381305ac3",
                        "glosses": [
                            "to tarry, to loiter, to linger, to be late"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d96e9df-6788-4cb3-9b9f-10a8f96ff7de",
                                "sense_id": "e900ac10-3afd-31e0-8d5b-d653e034c3d0",
                                "text": "он заме́шкался у свои́х прия́телей",
                                "translation": "he has been delayed at his friends'",
                                "english": "he has been delayed at his friends'"
                            },
                            {
                                "example_id": "f5e9e0ae-0bf2-4ee6-b4f5-1bac947cbbf2",
                                "sense_id": "e900ac10-3afd-31e0-8d5b-d653e034c3d0",
                                "text": "Прия́тель мой заме́шкался в Москве́ и опозда́л двумя́ дня́ми; я без него́ не хоте́л нача́ть охо́ты.",
                                "translation": "My friend lingered in Moscow, and was two days late; I did not care to start shooting without him.",
                                "english": "My friend lingered in Moscow, and was two days late; I did not care to start shooting without him."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
