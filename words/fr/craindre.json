{
    "word_family": [
        "crainte",
        "craintif",
        "craintivement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce01ae5f-f131-3215-9df8-17ca48a5e29c",
                    "sense_definition": "Éprouver de l'inquiétude ou de la peur face à un danger ou un malheur potentiel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "peur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants <w>craignent</w> que la tempête ne cause d'importants dégâts matériels dans la région."
                        },
                        {
                            "text": "Face à cette crise inattendue, tout le monde commence à <w>craindre</w> le pire pour l'avenir."
                        }
                    ],
                    "synonyms": [
                        "avoir peur",
                        "redouter"
                    ],
                    "common_phrases": [
                        "craindre le pire",
                        "craindre pour sa vie"
                    ]
                },
                {
                    "sense_id": "c14e05b5-36e9-3547-a779-e9f0200312ee",
                    "sense_definition": "Être sensible ou vulnérable à une altération physique ou à un dommage causé par un élément extérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces plantes exotiques <w>craignent</w> le froid et doivent impérativement rester dans la serre cet hiver."
                        },
                        {
                            "text": "Ce nouveau matériau synthétique ne <w>craint</w> pas la chaleur ni l'humidité ambiante."
                        }
                    ],
                    "common_phrases": [
                        "craindre le froid",
                        "craindre la chaleur",
                        "craindre le gel"
                    ]
                },
                {
                    "sense_id": "471cafbf-9060-32f8-a79e-de4906ade278",
                    "sense_definition": "Être très déplaisant, décevant ou nul.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "familier_negatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai encore oublié mes clés au bureau, franchement ça <w>craint</w>."
                        },
                        {
                            "text": "Le son était tellement mauvais lors du concert que toute la soirée a vraiment <w>craint</w>."
                        }
                    ],
                    "common_phrases": [
                        "ça craint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier très courant"
                        }
                    ]
                },
                {
                    "sense_id": "149f7085-770c-3e0c-9d9b-600020de4735",
                    "sense_definition": "Présenter un danger, un risque ou susciter une grande méfiance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "familier_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il vaut mieux éviter de marcher seul la nuit car ce quartier <w>craint</w> beaucoup."
                        },
                        {
                            "text": "Ce type a un comportement bizarre avec tout le monde, je trouve qu'il <w>craint</w>."
                        }
                    ],
                    "common_phrases": [
                        "quartier qui craint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "1f26ef72-dc92-356a-84c7-366096e05448",
                    "sense_definition": "Avoir un profond respect mêlé de crainte religieuse ou filiale, révérer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce croyant sincère s'efforçait fidèlement de <w>craindre</w> Dieu dans tous ses choix de vie."
                        },
                        {
                            "text": "Dans cette société ancienne, les jeunes gens devaient <w>craindre</w> et respecter les anciens de la famille."
                        }
                    ],
                    "common_phrases": [
                        "craindre Dieu"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage classique ou religieux"
                        }
                    ]
                }
            ]
        }
    ]
}