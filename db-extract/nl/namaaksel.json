{
    "word": "namaaksel",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "b203fbc4-90d7-3c0e-a370-b5a7e29c6589",
                "word": "namaaksel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "caefa42d-44c9-4aa5-bf64-e1b65c80c001",
                        "entry_id": "b203fbc4-90d7-3c0e-a370-b5a7e29c6589",
                        "tags": [
                            "plural"
                        ],
                        "form": "namaaksels"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                        "entry_id": "b203fbc4-90d7-3c0e-a370-b5a7e29c6589",
                        "glosses": [
                            "iets wat niet door de originele maker is gemaakt maar door iemand anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04572eeb-22cf-4ba5-bea8-085f44119550",
                                "sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                                "text": "Als Boer wel medeplichtig was aan de verkoop van Etermans namaaksels, dan zou men zelfs kunnen opperen dat het een daad van vaderlandsliefde was om de Duitsers met vervalsingen af te schepen. Als dit zo zou zijn, dan was zijn boekje en het briefje aan cultuurbaas Gerdes dubbel doortrapt."
                            },
                            {
                                "example_id": "907c84ef-980d-43ee-bc48-cedb2dabe138",
                                "sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                                "text": "Via Egypte en de door Israel bezette veiligheidszone in Libanon zouden deze namaaksels op de Palestijnse markt zijn beland. In Israel, dat - evenals de Europese Unie - Viagra (op doktersrecept) binnenkort gaat legaliseren, is in juni een 75-jarige man overleden na het innemen van een Viagra-pil."
                            },
                            {
                                "example_id": "15eb5268-4b5f-4735-b631-ad4f4604f1de",
                                "sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                                "text": "Blijkbaar was er tijdens de hele chocomelgeschiedenis (dreiging van) concurrentie, want er werd altijd maar gehamerd op 'Dé chocolademelk heet Fosco', 'Eischt Fosco en laat u geen waardeloos namaaksel opdringen', 'Alleen Nutricia maakt Chocomel, niemand anders' en later natuurlijk het bekende 'De enige echte'."
                            },
                            {
                                "example_id": "e5eea551-7e3f-443c-98ad-786e43a86438",
                                "sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                                "text": "In deel 1 en 3, waarin Hertmans of de op Hertmans lijkende figuur over zijn grootvader spreekt, wordt de nadruk gelegd op deze impotentie van de grootvader om een origineel schilderij te vervaardigen, en deze impotentie lijkt ook betrekking te hebben op het ooggetuigenverslag, dat namelijk niet alleen letterlijk een kopie is omdat Hertmans beweert het te hebben overgetypt, maar het is net als de namaaksels van de grootvader een bewijs van onmacht, een kopie van een origineel. Een vervalsing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65a196bc-7c83-4c2c-9f2c-f2813e8b0605",
                        "source_entry_id": "b203fbc4-90d7-3c0e-a370-b5a7e29c6589",
                        "source_sense_id": "39d4a0e6-12d8-3a97-871c-92784ced07dc",
                        "target_lang_word": "copy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "The result of copying; an identical or nearly identical duplicate of an original."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cfc9cc-3a1f-47d1-8aaa-4d3f17d8116e",
                                                "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                                                "text": "Please bring me at least 200 copies of this report. The photocopier is down the hall on the right."
                                            },
                                            {
                                                "example_id": "a83f161c-f19b-4b86-a431-704fad83487e",
                                                "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                                                "text": "His new book is out. I have a signed copy. He'll send you a copy if you want one. He's giving free copies to his former colleagues who want one. The press run is 3000 copies, and he hopes to sell more press runs after this one."
                                            },
                                            {
                                                "example_id": "70cfd9a9-d19c-4782-9ec3-eb308f5a83c4",
                                                "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                                                "text": "I already saw their draft. She emailed me a copy yesterday. I can forward it to you so that you have your own copy."
                                            },
                                            {
                                                "example_id": "5a47971b-d986-46ad-ac45-ba052802a3be",
                                                "sense_id": "24d372b9-9657-370d-8583-498a8f331c7d",
                                                "text": "I have not the vanity to think my copy equal to the original."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9a090c-5a24-306d-a308-1da290f87ffe",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "The result of copying; an identical or nearly identical duplicate of an original.",
                                            "The result of gene or chromosomal duplication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3223dfcf-6499-4f3f-83e1-aa3d35f70be4",
                                                "sense_id": "9f9a090c-5a24-306d-a308-1da290f87ffe",
                                                "text": "Every cell in this organism contains a copy of each gene, but whether that copy will be expressed depends on complex factors of cell differentiation and epigenetics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93de3ed6-04cc-38a7-b8ba-0c3e5fb71b2a",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "An imitation, sometimes of inferior quality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f80e9909-db1a-4f4b-b892-c074ba958ae5",
                                                "sense_id": "93de3ed6-04cc-38a7-b8ba-0c3e5fb71b2a",
                                                "text": "That handbag is a copy. You can tell because the buckle is different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "749c0492-dc81-33c7-b841-20be687be231",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "The text (words, content) that is to be typeset or similarly prepared and published."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6da3eda-3ae8-4006-91b9-50918c70d07c",
                                                "sense_id": "749c0492-dc81-33c7-b841-20be687be231",
                                                "text": "This organization doesn't publish any copy that hasn't been edited by a good copy editor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a146be8-b713-3475-a562-66f1d88a3eb3",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "The text (words, content) that is to be typeset or similarly prepared and published.",
                                            "The output of copywriters, who are employed to write material which encourages consumers to buy goods or services."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22ba4833-61cd-3a8d-b293-70f6bc472253",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "The text (words, content) that is to be typeset or similarly prepared and published.",
                                            "The text to be set into newspaper articles, magazine pages, or similar."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2acae8d3-3009-4e83-98d5-56dbc8099bca",
                                                "sense_id": "22ba4833-61cd-3a8d-b293-70f6bc472253",
                                                "text": "Submit all copy to the appropriate editor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5cf05e1-7118-3593-b9f6-53c2620276d5",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "A person employed to carry copy and run errands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "633e3fbb-891a-36c7-82f2-a588ce1de803",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "A schoolwork pad or workbook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "709f7401-ba0c-4219-9d61-2740602fc4fa",
                                                "sense_id": "633e3fbb-891a-36c7-82f2-a588ce1de803",
                                                "text": "Tim got in trouble for forgetting his maths copy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fb6daa-bf49-3466-8746-dbec918e3521",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "A particular instance of a book: a single printed impression or digital file representing it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dabd5352-c29f-4f4f-85b5-7f124ee68452",
                                                "sense_id": "30fb6daa-bf49-3466-8746-dbec918e3521",
                                                "text": "Our town's public library has several copies of the Bible, in each of several editions."
                                            },
                                            {
                                                "example_id": "c032b6df-e87a-468c-b1e7-a39a4bfb0bae",
                                                "sense_id": "30fb6daa-bf49-3466-8746-dbec918e3521",
                                                "text": "Our town's public library has several copies of the second edition of Smith's textbook, but it doesn't yet have any copies of any newer edition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a34de4da-a9eb-31d4-acab-087e4251c022",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "A particular instance of an issue of a periodical (e.g., magazine, journal, bulletin): a single printed impression or digital file representing that issue; (metonynmically) the issue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdd35de-454d-4505-a6f1-338dad221b11",
                                                "sense_id": "a34de4da-a9eb-31d4-acab-087e4251c022",
                                                "text": "Have you seen the latest copy of Newsweek yet?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cc75b00-6cc0-3400-821f-9b0548e5303f",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "Writing paper of a particular size: Synonym of bastard."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9ea1569-756a-3574-b8bc-452050d627e6",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "That which is to be imitated, transcribed, or reproduced; a pattern, model, or example."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b199c40-e54e-4cca-871f-a94f904d11bc",
                                                "sense_id": "e9ea1569-756a-3574-b8bc-452050d627e6",
                                                "text": "His virtues are an excellent copy for imitation."
                                            },
                                            {
                                                "example_id": "98dc8d71-2b00-48b3-9e77-2ae1810f285b",
                                                "sense_id": "e9ea1569-756a-3574-b8bc-452050d627e6",
                                                "text": "Let him first learn to write, after a copy of all the letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4760d6b5-e7bb-3f1e-822c-78373f0c3143",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "An abundance or plenty of anything."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91e932d0-d6a8-4c59-a7aa-438e952c1a86",
                                                "sense_id": "4760d6b5-e7bb-3f1e-822c-78373f0c3143",
                                                "text": "[S]he was bleſt with no more Copie of wit, but to ſerue his Humor thus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3263b7e-cabe-33e5-a67e-9dd9b23a8971",
                                        "entry_id": "e41f14d7-f26b-315a-bf50-313144ae0792",
                                        "glosses": [
                                            "copyhold; tenure; lease."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55652764-da5d-4f10-8979-f791a857b6be",
                                                "sense_id": "f3263b7e-cabe-33e5-a67e-9dd9b23a8971",
                                                "text": "But in them nature's copy's not eterne"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "copy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To produce an object identical to a given object."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "507261ad-a515-4895-ae47-d59f37cf2bd5",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "Please copy these reports for me."
                                            },
                                            {
                                                "example_id": "66d6efff-5681-41df-a464-5bc9d23dd81d",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "Don't copy that floppy!"
                                            },
                                            {
                                                "example_id": "ec77c5f6-877b-4c8e-b4a2-c331b50b9193",
                                                "sense_id": "368d186b-05bf-3530-94da-b9f18d6475a2",
                                                "text": "[Isaac Newton] was obsessed with alchemy. He spent hours copying alchemical recipes and trying to replicate them in his laboratory. He believed that the Bible contained numerological codes. The truth is that Newton was very much a product of his time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b048936-97a6-34eb-a90b-f2d64ffc4e7e",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To give or transmit a copy to (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb77ad9e-8943-4cee-a6a9-2b2e11816a95",
                                                "sense_id": "1b048936-97a6-34eb-a90b-f2d64ffc4e7e",
                                                "text": "Make sure you copy me on that important memo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b959b08-baf4-3240-90be-05af46d8f76b",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To place a copy of an object in memory for later use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97b1bed8-ca5d-4b7f-b5a9-b84fdfa80482",
                                                "sense_id": "9b959b08-baf4-3240-90be-05af46d8f76b",
                                                "text": "First copy the files, and then paste them in another directory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To imitate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3181370-6af9-4ca8-9287-7fd998d64cd0",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "Don't copy my dance moves."
                                            },
                                            {
                                                "example_id": "66c6fd20-c503-42fb-8df6-f3f169ce2ebe",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "Mom, he's copying me!"
                                            },
                                            {
                                                "example_id": "bc0fa257-e7f8-4c2f-b014-eb2998a96592",
                                                "sense_id": "8370f360-463d-32be-ac4b-92cba8d338bd",
                                                "text": "We copy instinctively the voices of our companions, their accents, and their modes of pronunciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0442825e-0ca5-3ab6-9233-7c1558bd26e0",
                                        "entry_id": "7d3752f2-ee3d-329c-955b-0109e1a6a9c2",
                                        "glosses": [
                                            "To receive a transmission successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53fbd17d-eb4b-4bc1-b1dc-cba5b69276d9",
                                                "sense_id": "0442825e-0ca5-3ab6-9233-7c1558bd26e0",
                                                "text": "Do you copy?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
