                        ],
                        "examples": [
                            {
                                "example_id": "08536452-b831-4664-a76c-d1093fbcdafc",
                                "sense_id": "54c307fe-d22b-31ff-9e77-8e5e1a5f5fa6",
                                "text": "Tot beeldbepalend programma uit de canon van zestig jaar televisie werd gekozen Man bijt Hond."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd29c0bd-93bd-33fa-86d2-a9f300264dd0",
                        "entry_id": "6eb2194b-e980-37c3-a780-c1ea0a16e188",
                        "glosses": [
                            "iets wat het uiterlijk van iets bepaalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6db55f85-5f83-429c-bb07-e1b2a725e599",
                                "sense_id": "fd29c0bd-93bd-33fa-86d2-a9f300264dd0",
                                "text": "Het is overigens bijzonder dat voor Nederland, in tegenstelling tot de praktijk bij bijna alle andere landen, niet de nationale vlag of de kleuren daarvan beeldbepalend zijn voor de uitdossing van de supporters: niks rood-wit-blauw, maar oranje en nog eens oranje. Die bij uitstek nationale kleur oranje hebben we - dat dan weer wél - te danken aan het koningshuis."
                            }
                        ]
                    }
