                                                "example_id": "ff135cd1-86b0-46e9-969b-1cf324b83af3",
                                                "sense_id": "2d60087e-a677-33f3-9f38-03251d3bd914",
                                                "text": "Shalom has been a member of Knesset since 1992, serving in a number of different ministries, including science and technology, finance, foreign affairs, and most recently, the interior."
                                            },
                                            {
                                                "example_id": "a0c412b4-46e2-4418-b7a9-2e07f6c25062",
                                                "sense_id": "2d60087e-a677-33f3-9f38-03251d3bd914",
                                                "text": "On Tuesday, a month since they were abducted, families of those kidnapped are expected to protest at the Western Wall plaza in Jerusalem, the holiest site in Judaism, as well as at the Knesset, over what they say are inadequate efforts to reach a deal with Hamas to release their loved ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af907cfb-caf3-45ce-9917-635da626b9f6",
                        "source_entry_id": "d7d47ae6-f53e-3870-8493-2c0aa2b32634",
                        "source_sense_id": "d3555f83-4ae5-3718-8c70-dc20b471687e",
                        "source_sense_description": "israelisches Parlamentsgebäude",
