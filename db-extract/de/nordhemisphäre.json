                ],
                "senses": [
                    {
                        "sense_id": "c56f99c6-5af0-3783-93fb-db2dc44474b4",
                        "entry_id": "e4a691c0-6fc0-3ebe-b2ad-de839ec04ae1",
                        "glosses": [
                            "nördlich des Äquators gelegener Erdteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "953f08ea-026e-4e67-95a8-bf9d644bf388",
                                "sense_id": "c56f99c6-5af0-3783-93fb-db2dc44474b4",
                                "text": "„Die Ausdehnung der Meereisbedeckung in der Nordhemisphäre ist in den letzten 50 Jahren im Frühjahr und Sommer um 10 bis 15 Prozent zurückgegangen.“"
                            },
                            {
                                "example_id": "68a6a3d6-2f7e-4c53-87eb-b8b0daf2db9e",
                                "sense_id": "c56f99c6-5af0-3783-93fb-db2dc44474b4",
                                "text": "„Beobachtungen am Boden lassen einen Rückgang der jährlichen Dauer der Eisbedeckung von Seen und Flüssen in mittleren und höheren Breiten der Nordhemisphäre um zwei Wochen erkennen.“"
                            },
                            {
                                "example_id": "3007f254-42c2-4ba8-8fc5-94befee32c45",
                                "sense_id": "c56f99c6-5af0-3783-93fb-db2dc44474b4",
                                "text": "„Auf der südlichen Halbkugel ist der Unterschied der Winterisothermen gegenüber ihrem Verlauf im Sommer nicht so augenfällig wie auf der Nordhemisphäre.“"
                            },
                            {
                                "example_id": "e8d973da-b144-4023-8b9e-fb8973b6e5b8",
                                "sense_id": "c56f99c6-5af0-3783-93fb-db2dc44474b4",
                                "text": "„Aber die sommergrünen Laubwaldgebiete der Nordhemisphäre haben im Süden, abgesehen von einem kleinen Teil Chiles keine Parallele.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
