                        "glosses": [
                            "The property of being lukewarm; ambivalence, weakness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bccab092-c0c9-4342-85c2-d22d901ea5b4",
                                "sense_id": "7abbfa56-cfd4-3ada-8833-e0a93638b72f",
                                "text": "1665, Robert Boyle, New Experiments and Observations Touching Cold, Discourse II, in The Works of the Honourable Robert Boyle, London: A. Millar, 1744, Volume II, p. 246,\nAnd indeed, there is scarce any quality, for whose differences we have fewer distinct names, having scarce any for the many degrees of coldness, that may be conceived to be intermediate, betwixt lukewarmness and the freezing degree of cold […]"
                            },
                            {
                                "example_id": "bd8bc376-cc1d-4e72-a377-046df70fdfad",
                                "sense_id": "7abbfa56-cfd4-3ada-8833-e0a93638b72f",
                                "text": "Mr. Hale was disappointed in his pupil’s lukewarmness about Greek literature, which had but a short time ago so great an interest for him."
                            },
                            {
                                "example_id": "a036115c-0e10-47cb-846c-dc0c1ae51afb",
                                "sense_id": "7abbfa56-cfd4-3ada-8833-e0a93638b72f",
                                "text": "Sazonov was furious at the lukewarmness of the British and French reactions to Russia's protests."
                            }
                        ]
                    }
