                                "sense_id": "d01c37c7-580d-3bb7-b99d-076b43eedfb5",
                                "text": "Der Priester stand am Hochaltar."
                            },
                            {
                                "example_id": "eeff50a9-4193-4d49-9c61-049c6534c8a2",
                                "sense_id": "d01c37c7-580d-3bb7-b99d-076b43eedfb5",
                                "text": "„In ihm stand nicht mehr der Hochaltar im Mittelpunkt, sondern die Kanzel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
