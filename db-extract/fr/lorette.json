                "senses": [
                    {
                        "sense_id": "ce727580-c010-3d53-968f-44687b562c3c",
                        "entry_id": "2be2da86-6799-3ed6-ba31-495195974d94",
                        "glosses": [
                            "loose woman, lorette"
                        ],
                        "tags": [
                            "archaic",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "1d6ab64f-3337-467c-8860-eaee305d0718",
                                "sense_id": "ce727580-c010-3d53-968f-44687b562c3c",
                                "text": "En ce temps-là, ses pareilles à Paris, qui ne trouvaient pas assez sérieux le joli nom de « lorettes » que la littérature leur avait donné et qu'a immortalisé Gavarni, se faisaient appeler orientalement des « panthères ».",
                                "translation": "In those days, her kind in Paris, considering that the pretty name of ‘lorette’, which literature had given them and which was immortalised by Gavarni, was not serious enough, had started calling themselves ‘panthers’, in the Oriental style.",
                                "english": "In those days, her kind in Paris, considering that the pretty name of ‘lorette’, which literature had given them and which was immortalised by Gavarni, was not serious enough, had started calling themselves ‘panthers’, in the Oriental style."
                            },
                            {
                                "example_id": "46e457f8-8ddd-47c1-abed-6dfff4c57489",
                                "sense_id": "ce727580-c010-3d53-968f-44687b562c3c",
                                "text": "On les approuvait de s'amuser avec des filles de petite condition : lorettes, grisettes, midinettes, cousettes […]",
                                "translation": "We gave them permission to amuse themselves with girls of low morals – lorettes, grisettes, shop-girls, seamstresses.",
                                "english": "We gave them permission to amuse themselves with girls of low morals – lorettes, grisettes, shop-girls, seamstresses."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
