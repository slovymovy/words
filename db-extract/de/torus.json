                "senses": [
                    {
                        "sense_id": "8e124a98-a87e-38f3-8909-3fa54f641de2",
                        "entry_id": "9080c236-8618-3780-b252-1afc3f781ffe",
                        "glosses": [
                            "Gebilde, das wulstartig aufgebaut ist und dessen Form mit der eines Schwimmreifens oder Donuts verglichen werden kann"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0e443a-cdac-4d2e-ae58-4fb918298753",
                                "sense_id": "8e124a98-a87e-38f3-8909-3fa54f641de2",
                                "text": "„Der Torus ist ein mathematischer Körper, der dadurch entsteht, dass ein senkrecht stehender Kreis um eine vertikale Achse, die außerhalb des Kreises liegt, rotiert. Kreis und Achse liegen dabei in einer Ebene.“"
                            },
                            {
                                "example_id": "dd080fcb-4f34-4ca5-98ec-0e4243a7d94b",
                                "sense_id": "8e124a98-a87e-38f3-8909-3fa54f641de2",
                                "text": "„Ein Weg, den Archytas für seine Lösung wählte, besteht darin, den Torus mit dem senkrechten Zylinder, dessen Basis aus dem Ausgangskreis mit dem Durchmesser OA (oder Länge 2) besteht, zu schneiden.“"
                            },
                            {
                                "example_id": "7dd9cfb5-d5da-41de-90d5-e7498efd7c90",
                                "sense_id": "8e124a98-a87e-38f3-8909-3fa54f641de2",
                                "text": "„Charakteristisch für alle Vertebraten ist eine Divergenz der Bahnverbindungen im Hirnstamm (Niveau des Nucleus cochlearis, Oliva superior, Lemniscus lateralis) und die darauffolgende Konvergenz der meisten Hirnstammprojektionen im Mittelhirn (Torus semicircularis, Colliculus inferior). Dabei verlaufen Hauptbahnverbindungen zum Mittelhirn vom Niveau des Nucleus cochlearis kontralateral, von der Oliva superior ipsi- und kontralateral und vom Lemniscus lateralis ipsilateral.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
