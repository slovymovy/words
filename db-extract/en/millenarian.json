    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                "word": "millenarian",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ca084ab3-39fc-455f-b6dc-2d52b42428fe",
                        "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more millenarian"
                    },
                    {
                        "form_id": "b149e652-a926-478c-b99b-ae96cca4f604",
                        "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most millenarian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f172ffb-9262-3f2c-988e-d1ca49de9300",
                        "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                        "glosses": [
                            "Pertaining to the belief in an impending period of one thousand years of peace and righteousness associated with the Second Coming of Christ and his reign on earth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffd1f1de-5251-44e7-9887-f62dc6547308",
                                "sense_id": "2f172ffb-9262-3f2c-988e-d1ca49de9300",
                                "text": "Franciscans coming from Iberia were particularly prone to the millenarian enthusiasm which gripped southern Europe around 1500, and which the Franciscan Order had so long fostered. They believed that they were living in the End Times […]"
                            },
                            {
                                "example_id": "6744a59b-907e-4fda-92fe-20793cb29da1",
                                "sense_id": "2f172ffb-9262-3f2c-988e-d1ca49de9300",
                                "text": "Mirandola cultivated a Dominican friar, Savonarola, whose millenarian visions had provoked revolution: in the wake of France's invasion, he had inspired a popular uprising in Florence, its ruling Medici family replaced by a people's republic."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c965e68-781c-380a-a374-236f37ad798e",
                        "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                        "glosses": [
                            "Pertaining to any of various religious or social movements which believe in a coming or ongoing radical change to existing world order."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8f3b8f-d999-4b07-b963-7eca680e00e3",
                                "sense_id": "1c965e68-781c-380a-a374-236f37ad798e",
                                "text": "Restoration of the old empires was not the aim of the totalitarian revolutions in Russia and Germany, since both wanted to bring back the millenarian empire."
                            }
                        ]
                    },
                    {
                        "sense_id": "b51d58fb-d40a-347b-ada1-fca3e8c17337",
                        "entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
                        "glosses": [
                            "Lasting or expected to last a thousand years."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59c66b95-3985-4a43-81ee-5686e28bd3fb",
                                "sense_id": "b51d58fb-d40a-347b-ada1-fca3e8c17337",
                                "text": "[…] contrasts with the rapid decline and demise of the millenarian empire of Byzantium."
                            },
                            {
                                "example_id": "ce2d10bd-4d6c-463f-a6bc-d153abebf899",
                                "sense_id": "b51d58fb-d40a-347b-ada1-fca3e8c17337",
                                "text": "But the ashes of Auschwitz fell on Hitler's folly, on the announcement of the millenarian Reich."
                            },
                            {
                                "example_id": "76798a87-1ddb-4924-893d-6df51c149f14",
                                "sense_id": "b51d58fb-d40a-347b-ada1-fca3e8c17337",
                                "text": "In a few years, by fueling a sense of regained confidence within its own people, which suffered from the fall of a millenarian empire, Ataturk managed to readapt Turkish traditions in the framework of a new model of state."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9547436e-8efd-400c-b66c-5d91ce465539",
                        "source_entry_id": "358f8aae-f76f-3e74-8db0-7c757984c06c",
