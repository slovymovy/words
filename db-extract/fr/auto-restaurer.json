                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4546313-728c-4710-adb5-39755c7e36e9",
                                "sense_id": "b1809be4-dc2a-37a6-a801-a9bbc4770ba6",
                                "text": "Un réseau est dit autonome s'il est capable de s'auto-configurer, s'auto-optimiser, s'auto-protéger et s'auto-restaurer."
                            },
                            {
                                "example_id": "033c2dd2-f9cb-467d-8c24-1f9612839555",
                                "sense_id": "b1809be4-dc2a-37a6-a801-a9bbc4770ba6",
                                "text": "Notre planète -déjà assez endommagée, est incapable de s'auto-restaurer surtout avec tous les déchets toxiques qu'on lui rajoute."
                            },
                            {
                                "example_id": "fe7de975-f859-4500-a8d5-1edb5d763a6d",
                                "sense_id": "b1809be4-dc2a-37a6-a801-a9bbc4770ba6",
                                "text": "La capacité du cours d'eau à s'« auto-restaurer » (fonction de sa puissance et de son transport solide) doit également être prise en compte."
                            }
                        ]
                    }
