                        "entry_id": "c59933d4-3504-36c7-8a66-8b956bb5b2b1",
                        "glosses": [
                            "Petit agneau."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "87ec8187-d468-4678-98fd-382f0078aa08",
                                "sense_id": "5d22420f-6ff5-3b3a-a3b9-59186d28cef1",
                                "text": "Au bas de la côte de la Font d’Eylias, il vit sur le terrier de la route un petit agnelet qui bêlait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2309a96b-c7b8-4266-9035-6478c3ef4081",
