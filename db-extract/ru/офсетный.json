                "senses": [
                    {
                        "sense_id": "a930d6d5-d370-392f-8e49-6871c6368237",
                        "entry_id": "111bebed-41bf-3dd1-8acf-f661bf2eab3c",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным офсет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35cdb6b9-9851-476e-b8ab-ef4f9206bcb5",
                                "sense_id": "a930d6d5-d370-392f-8e49-6871c6368237",
                                "text": "Затем были ксерокс, ротатор и вот, наконец, в 1990-м — офсетный станок."
                            },
                            {
                                "example_id": "ae714526-175b-4a54-a1f9-943f11d9eab2",
                                "sense_id": "a930d6d5-d370-392f-8e49-6871c6368237",
                                "text": "— Переплёт твёрдый, тяжёлый, а бумага офсетная, плотная, высшего сорта?"
                            }
                        ]
                    },
                    {
                        "sense_id": "3a3cdd1e-8734-3eac-b510-c762f3183af0",
                        "entry_id": "111bebed-41bf-3dd1-8acf-f661bf2eab3c",
                        "glosses": [
                            "имеющий особую форму с Z-образным изгибом верхней части цевья"
                        ],
                        "tags": [
                            "о рыболовном крючке"
                        ],
                        "examples": [
                            {
                                "example_id": "abedc060-f2b1-4e39-9783-932692c80549",
                                "sense_id": "3a3cdd1e-8734-3eac-b510-c762f3183af0",
                                "text": "Первый офсетный крючок появился в моём арсенале почти двадцать лет назад – в самом начале двухтысячных."
                            }
                        ]
                    }
