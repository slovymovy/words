                "senses": [
                    {
                        "sense_id": "f3b1d0cc-0343-3422-926e-ba953ca84dd4",
                        "entry_id": "2ebf83c9-8381-3ad9-9ca9-2ad74ba3f71d",
                        "glosses": [
                            "Beibehaltung einer Sache oder eines Zustandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0596e19-3fab-469a-ad5d-3497e8860bfc",
                                "sense_id": "f3b1d0cc-0343-3422-926e-ba953ca84dd4",
                                "text": "„Auch Sozialministerin Petra Köpping (SPD) mahnte zur Bewahrung des Friedens.“"
                            },
                            {
                                "example_id": "e6e983ab-7e29-4e51-b903-9e7384d62ce9",
                                "sense_id": "f3b1d0cc-0343-3422-926e-ba953ca84dd4",
                                "text": "„Landtagspräsident Hendrik Hering (SPD) sagte anlässlich der Veranstaltung mit Vorträgen, Infoständen und Ausstellungen am Samstag auf der Koblenzer Festung Ehrenbreitstein laut Redemanuskript: 'Wir wollen so die Arbeit derjenigen unterstützen, die sich tagtäglich vor Ort für die Aufarbeitung und Bewahrung des historischen Erbes unseres Landes einsetzen.“"
                            },
                            {
                                "example_id": "a2dd5c4d-5c18-49da-bc83-c16eeede6869",
                                "sense_id": "f3b1d0cc-0343-3422-926e-ba953ca84dd4",
                                "text": "„Dazu gehörten die Bewahrung des Feuers, die Herstellung von Speeren zur Jagd und zur Verteidigung sowie das Schärfen der Feuersteinklingen und das Gerben der Tierfelle.“"
                            },
                            {
                                "example_id": "377d75b5-be6d-4b47-8293-eeaeae5541ab",
                                "sense_id": "f3b1d0cc-0343-3422-926e-ba953ca84dd4",
                                "text": "„Gleichzeitig sicherte sie dem neuen Direktor Mahmoud Hammoud die volle Unterstützung der Unesco für die Rettung und Bewahrung des syrischen Kulturgutes zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81e4afe5-3657-4bba-adda-21d3402c57e2",
