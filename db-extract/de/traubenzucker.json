                    {
                        "sense_id": "f61b908b-23ab-3248-8b86-ea156656766f",
                        "entry_id": "d6eb5e40-f3a5-3501-8a86-9db1633dc002",
                        "glosses": [
                            "ein Monosaccharid (Einfachzucker), das zu den Kohlenhydraten gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7268d2-eb6b-4c8c-aa73-fba8da647817",
                                "sense_id": "f61b908b-23ab-3248-8b86-ea156656766f",
                                "text": "Neben Traubenzucker wurden auch Polysaccharide in den Speisen gefunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b0a1838c-b8cd-3eb8-bc68-69f6518944b9",
                        "entry_id": "d6eb5e40-f3a5-3501-8a86-9db1633dc002",
                        "glosses": [
                            "Nahrungsmittel aus Einfachzucker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dbff895-0b22-4e97-b81f-af743c9fc428",
                                "sense_id": "b0a1838c-b8cd-3eb8-bc68-69f6518944b9",
                                "text": "Gib mir bitte zur Stärkung den Traubenzucker aus der Vorratsdose."
                            },
                            {
                                "example_id": "b2e6a6d8-8308-4495-a4fd-472e7a5f7b2c",
                                "sense_id": "b0a1838c-b8cd-3eb8-bc68-69f6518944b9",
                                "text": "„Von diesem Tag, dem 2. August 1945, an geschah zweierlei: Heimlich wurde ein riesiges Lebensmittellager ausgegraben – viele tausend Konservenbüchsen mit Fett, Fleisch, Marmelade, Kunsthonig, Kaffee, Tee, Fliegerschokolade, Traubenzucker, Mehl, Gemüse, Obst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aee905a9-b374-4b97-a4b9-0353d7b2ccd0",
                        "source_entry_id": "d6eb5e40-f3a5-3501-8a86-9db1633dc002",
                        "source_sense_id": "f61b908b-23ab-3248-8b86-ea156656766f",
