    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fde7fc07-8ae1-3a5a-b300-6b552917f93a",
                    "sense_definition": "Animal marin invertébré au corps gélatineux et transparent, muni de tentacules souvent urticants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas toucher cette <w>méduse</w> sur le sable car elle risque de piquer."
                        },
                        {
                            "text": "En nageant près du rivage, j'ai aperçu une magnifique <w>méduse</w> qui flottait dans l'eau claire."
                        }
                    ],
                    "common_phrases": [
                        "piqûre de méduse"
                    ]
                },
                {
                    "sense_id": "e32b0f79-5a14-3df8-8841-01d3fb373cda",
                    "sense_definition": "Personne désagréable, hideuse ou effrayante.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette voisine acariâtre se comportait comme une véritable <w>méduse</w> avec tous les habitants du quartier."
                        },
                        {
                            "text": "Avec son regard hostile et ses cheveux en désordre, elle ressemblait à une <w>méduse</w> furieuse."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "70e1d338-8284-38e7-8ff2-e375837653f0",
                    "sense_definition": "Créature de la mythologie grecque, l'une des trois Gorgones, dont la chevelure est formée de serpents et dont le regard pétrifie ceux qui la fixent.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mythologie",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Selon la légende antique, Persée parvint à décapiter la redoutable <w>Méduse</w> sans la regarder directement."
                        },
                        {
                            "text": "Le héros fixa le reflet de <w>Méduse</w> sur son bouclier de bronze pour éviter son regard mortel."
                        }
                    ],
                    "common_phrases": [
                        "tête de Méduse",
                        "regard de Méduse"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14883f50-d3b7-3eaa-8220-91f17bedcad6",
                    "sense_definition": "Troisième personne du singulier de l'indicatif présent de <w>méduser</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "forme_méduser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette annonce politique inattendue <w>méduse</w> l'ensemble des journalistes présents dans la salle."
                        },
                        {
                            "text": "Son incroyable virtuosité au piano <w>méduse</w> le public à chaque concert."
                        }
                    ]
                }
            ]
        }
    ]
