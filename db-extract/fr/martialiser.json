                "senses": [
                    {
                        "sense_id": "76ade364-05e9-3707-9fb7-1ba90457fca2",
                        "entry_id": "83da5b96-812c-305c-95ba-5268040e6eb9",
                        "glosses": [
                            "Donner un caractère martial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4a274e-02b7-45b6-8a79-03f61585b0de",
                                "sense_id": "76ade364-05e9-3707-9fb7-1ba90457fca2",
                                "text": "Goebbels pouvait sanctionner la chanteuse, mais pas la chanson, qu'il tente de martialiser."
                            },
                            {
                                "example_id": "787009fc-5677-4959-a506-d4bf78576ce8",
                                "sense_id": "76ade364-05e9-3707-9fb7-1ba90457fca2",
                                "text": "Je vais martialiser mes choix de comp, de manière à être plus crédible comme guerrier, au détriment de la dague."
                            },
                            {
                                "example_id": "5f51c6d5-68b4-4d92-bd00-9070497beb39",
                                "sense_id": "76ade364-05e9-3707-9fb7-1ba90457fca2",
                                "text": "Par exemple, les Sentinelles ont été dissoutes, pour finalement se \"martialiser\" aux côtés de nos défenseurs, les Jedi Gardiens."
                            }
                        ]
                    }
