            "senses": [
                {
                    "sense_id": "442452af-d86a-33bd-8c12-255e100e3b7f",
                    "sense_definition": "Действие по созданию, учреждению чего-либо (города, организации, учения).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Историки до сих пор спорят про точную дату <w>основания</w> этого древнего города.",
                            "target_lang_translations": {
                                "en": "Historians still argue about the exact date of the <w>founding</w> of this ancient city.",
                                "tr": "Tarihçiler bu antik kentin kesin <w>kuruluş</w> tarihi hakkında hâlâ tartışıyorlar."
                            }
                        },
                        {
                            "text": "После <w>основания</w> собственной компании он стал работать намного больше.",
                            "target_lang_translations": {
                                "en": "After the <w>founding</w> of his own company, he began to work much more.",
                                "tr": "Kendi şirketini <w>kurduktan</w> sonra çok daha fazla çalışmaya başladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "создание",
                        "учреждение",
                        "организация"
                    ],
                    "antonyms": [
                        "разрушение",
                        "расформирование"
                    ],
                    "common_phrases": [
                        "год основания",
                        "день основания",
                        "с момента основания"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of creating or establishing something (such as a city, organization, or doctrine).",
                        "tr": "Bir şeyin (şehir, kurum, öğreti vb.) kurulması, oluşturulması eylemi."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "founding",
                                "target_lang_sense_clarification": "act of creation"
                            },
                            {
                                "target_lang_word": "foundation",
                                "target_lang_sense_clarification": "act of establishing"
                            },
                            {
