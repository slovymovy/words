                "senses": [
                    {
                        "sense_id": "141977c2-412b-32a4-9c44-b4e91d2cec43",
                        "entry_id": "71e711fc-1112-3839-868e-854269df140c",
                        "glosses": [
                            "Interjection, qui est tantôt une sorte d’imprécation, tantôt un signe d’étonnement, d’admiration."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
