                {
                    "sense_id": "d3b74b74-9d6e-30eb-a545-f7a471a83f66",
                    "sense_definition": "Ironiczne wyrażenie niedowierzania w czyjeś słowa; sugeruje, że rozmówca kłamie lub mówi bzdury.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sarcasm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mówisz, że to nie twoja wina? <w>Jasne</w>, jak zawsze.",
                            "target_lang_translations": {
                                "ru": "Говоришь, это не твоя вина? <w>Ну да</w>, как всегда.",
                                "en": "You say it's not your fault? <w>Yeah, right</w>, as always.",
                                "nl": "Zeg je dat het niet jouw schuld is? <w>Ja hoor</w>, zoals altijd.",
                                "de": "Du sagst, das ist nicht deine Schuld? <w>Ja, klar</w>, wie immer.",
                                "fr": "Tu dis que ce n'est pas ta faute ? <w>C'est ça</w>, comme toujours.",
                                "it": "Dici che non è colpa tua? <w>Sì, certo</w>, come sempre.",
                                "cs": "Říkáš, že to není tvoje vina? <w>Jasně</w>, jako vždy.",
                                "tr": "Bunun senin suçun olmadığını mı söylüyorsun? <w>Hadi oradan</w>, her zamanki gibi.",
                                "es": "¿Dices que no es tu culpa? <w>Claro</w>, como siempre.",
                                "zh": "你说这不是你的错？<w>是啊</w>，一如既往。"
                            }
                        },
                        {
                            "text": "On twierdzi, że wygrał milion na loterii. – <w>Jasne</w>, już mu wierzę.",
                            "target_lang_translations": {
                                "ru": "Он утверждает, что выиграл миллион в лотерею. – <w>Ага</w>, так я ему и поверил.",
                                "en": "He claims he won a million in the lottery. – <w>Sure</w>, I believe him.",
                                "nl": "Hij beweert dat hij een miljoen heeft gewonnen in de loterij. – <w>Tuurlijk</w>, dat geloof ik meteen.",
                                "de": "Er behauptet, er hätte eine Million im Lotto gewonnen. – <w>Ja, sicher</w>, das glaube ich ihm sofort.",
                                "fr": "Il prétend avoir gagné un million à la loterie. – <w>Bien sûr</w>, j'y crois à peine.",
                                "it": "Sostiene di aver vinto un milione alla lotteria. – <w>Come no</w>, ci credo proprio.",
                                "cs": "Tvrdí, že vyhrál milion v loterii. – <w>Jasně</w>, už mu věřím.",
                                "tr": "Piyangodan bir milyon kazandığını iddia ediyor. – <w>Tabii canım</w>, hemen inandım.",
                                "es": "Él afirma que ganó un millón en la lotería. – <w>Ya</w>, claro que le creo.",
                                "zh": "他声称自己中了百万彩票。——<w>得了吧</w>，我才不信呢。"
                            }
                        }
                    ],
