                "senses": [
                    {
                        "sense_id": "3f20c81a-44f1-3043-b74c-86c413a48407",
                        "entry_id": "9a426137-04a3-3ed3-a5c5-81dde903a995",
                        "glosses": [
                            "Eigenschaft, die in deutlichem Maße bescheidenes, unaufwendiges (frugales) Auftreten zeigt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "c82052ca-c417-4994-bd05-6f68224ae167",
                                "sense_id": "3f20c81a-44f1-3043-b74c-86c413a48407",
                                "text": "„Am Abend zuvor hatte ich in den Hallen des Haupthofes die Frugalität des großen Pächters bewundert; jetzt erschien mir dessen Einfachheit als eine breite, an Verschwendung grenzende Einrichtung des Lebens.“"
                            },
                            {
                                "example_id": "6eeb8bc0-7f71-4040-b347-8366ed6f752f",
                                "sense_id": "3f20c81a-44f1-3043-b74c-86c413a48407",
                                "text": "„Zur Beförderung der häuslichen Tugenden kan die Feinheit im Empfinden und im Ausdrucke ebenso wenig beitragen, sondern sie wird der Genügsamkeit, der Frugalität und einer einfachen Lebensart gerade entgegen seyn.“ (1783)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
