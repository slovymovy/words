                                ]
                            },
                            {
                                "target_word": "abscess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efff7b3c-8bd6-3f6a-b885-806787bf2fa4",
                                        "entry_id": "371c962d-fca9-3e53-b58f-204fec0cbbe5",
                                        "glosses": [
                                            "To form a pus-filled cavity, typically from an infection."
                                        ],
