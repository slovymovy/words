                            },
                            {
                                "target_word": "weken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0732ae87-3597-32cf-9238-ba6152cb751d",
                                        "entry_id": "38667d0d-6b26-367a-af61-bcb6d6b1dfa5",
                                        "glosses": [
                                            "meervoud van het zelfstandig naamwoord week"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0188f47-1795-4904-9b33-389f02ca1a9b",
                                                "sense_id": "0732ae87-3597-32cf-9238-ba6152cb751d",
                                                "text": "'De suiker ligt nu al bijna twee weken in zijn pakhuis."
                                            },
                                            {
                                                "example_id": "15133053-d50f-42a7-a4e4-aa481a81f0d4",
                                                "sense_id": "0732ae87-3597-32cf-9238-ba6152cb751d",
                                                "text": "Tot mijn verbazing wist ik deze zes weken durende tocht zonder noemenswaardige problemen te voltooien, waardoor ik voor het eerst echt begon te geloven dat mijn ‘American Dream’ wel eens in vervulling zou kunnen gaan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fccf8288-3cf4-480d-b889-146c27381aaa",
                        "source_entry_id": "dd0efa55-b526-3261-b506-73bf5ef817ba",
                        "source_sense_description": "to soften or separate by immersion in a liquid",
                        "target_lang_word": "macérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "macérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c74239be-7163-3e13-9f26-888c59d9aa6f",
                                        "entry_id": "98bfc1b8-0f2b-3b65-ac04-e4531486a2fe",
                                        "glosses": [
                                            "Laisser séjourner dans un liquide des fruits, des légumes ou de la viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6ac984-b189-4e31-913f-ca200662c6d5",
                                                "sense_id": "c74239be-7163-3e13-9f26-888c59d9aa6f",
                                                "text": "Pendant 25 jours, mettre à macérer dans l'alcool et sans les rompre les baies de cassis avec les feuilles, la cannelle et le girofle. Après ce temps, filtrer sans presser, ajouter le sirop et filtrer encore 10 jours après."
                                            },
                                            {
                                                "example_id": "693edb9d-5be0-4f01-8656-6c05f1c26a27",
                                                "sense_id": "c74239be-7163-3e13-9f26-888c59d9aa6f",
                                                "text": "La première, qui est la plus simple et la plus rapide, consiste à mettre d’abord à macérer les parties de plantes uniquement dans l’alcool."
                                            },
                                            {
                                                "example_id": "48a502ba-bb93-400d-acf5-d00ae4e28c64",
                                                "sense_id": "c74239be-7163-3e13-9f26-888c59d9aa6f",
                                                "text": "Alice avait aussi fait poser une plaque sur les bâtiments qui serviraient d’atelier de fabrication et d’entrepôts pour les fûts où macéraient les fruits, et l’alambic."
                                            },
                                            {
                                                "example_id": "c6552809-b1cc-4b94-af94-897cfbd1f204",
                                                "sense_id": "c74239be-7163-3e13-9f26-888c59d9aa6f",
                                                "text": "— Sur la table, un verre encore à moitié plein où macéraient une douzaine de mégots. Partout de la vaisselle sale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8874be-a27d-319f-8e41-4008f7402d06",
                                        "entry_id": "98bfc1b8-0f2b-3b65-ac04-e4531486a2fe",
                                        "glosses": [
                                            "Être confiné dans une situation inconfortable."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2ccb53-677f-4c40-b07c-2ed521058c09",
                                                "sense_id": "be8874be-a27d-319f-8e41-4008f7402d06",
                                                "text": "Je lui révélai ma méthode ; faire macérer longtemps mes élèves en rangs, dans le couloir, pour décanter leurs impuretés. Ne les laisser entrer en classe que lorsqu’ils étaient en paix."
                                            },
                                            {
                                                "example_id": "24fd2b7e-b58d-478e-85b9-dac352bed467",
                                                "sense_id": "be8874be-a27d-319f-8e41-4008f7402d06",
                                                "text": "Vive la liberté. Et bienvenue à l'air frais sur mes joues qui macéraient sous la laine épaisse de la cagoule depuis trop longtemps."
                                            },
                                            {
                                                "example_id": "956219e8-dd90-47ac-8457-46013a7f2f4b",
                                                "sense_id": "be8874be-a27d-319f-8e41-4008f7402d06",
                                                "text": "Depuis la fin du conseil de discipline, il n'avait pas desserré les dents. Face à lui, les professeurs et les surveillants du petit séminaire macéraient dans un silence lourd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "259d92ee-da3c-3f20-a971-3b6d877087d3",
                                        "entry_id": "98bfc1b8-0f2b-3b65-ac04-e4531486a2fe",
                                        "glosses": [
                                            "Affliger son corps par diverses austérités pour se rendre agréable à Dieu."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177b96fe-3902-47b0-b947-08ca5c670cb5",
                                                "sense_id": "259d92ee-da3c-3f20-a971-3b6d877087d3",
                                                "text": "J’aurais été parfaitement heureux sans un maudit cauchemar qui revenait toutes les nuits, et où je me croyais un curé de village se macérant et faisant pénitence de mes excès du jour."
                                            },
                                            {
                                                "example_id": "ade549aa-ed0f-42f3-b427-cca6b1e3c2b2",
                                                "sense_id": "259d92ee-da3c-3f20-a971-3b6d877087d3",
                                                "text": "Elle passait ses jours dans la maison de Dieu, macérait son corps par des jeûnes continuels, et la nuit comme le jour exhalait sa prière devant l’autel du Seigneur."
                                            },
                                            {
                                                "example_id": "3adea359-fd54-4aa1-b5af-688a54e5554a",
                                                "sense_id": "259d92ee-da3c-3f20-a971-3b6d877087d3",
                                                "text": "Il priait, se macérait continuellement. Jamais on ne lui entendit dire une seule parole oiseuse. Enseveli dans une grotte, il ne vécut pendant de longues années que d'herbes sauvages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
