                ],
                "senses": [
                    {
                        "sense_id": "17b1999f-6704-36e4-afd5-1c41b6571566",
                        "entry_id": "aeb2354e-2ffa-3776-84a7-dd21cf22ac6f",
                        "glosses": [
                            "Faire devenir comme Louis Aragon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b66faf10-6b65-4522-a3db-4143a060ec13",
                                "sense_id": "17b1999f-6704-36e4-afd5-1c41b6571566",
                                "text": "Maniant tour à tour la colère et l'humour, Robin pulvérise les perfidies colportées sur son compte par les « bourgeois aragonisés »."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0966cf0-ec0f-30f3-8560-e56cbee51fbc",
                        "entry_id": "aeb2354e-2ffa-3776-84a7-dd21cf22ac6f",
                        "glosses": [
                            "Faire comme Louis Aragon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf2723d-533b-4902-9b80-a7af692d86f1",
                                "sense_id": "a0966cf0-ec0f-30f3-8560-e56cbee51fbc",
                                "text": "Si avec Pleine poitrine, Cadou, selon l’expression de Michel Manoll, s’est mis à « aragoniser », il n’a point persévéré dans la direction d’un art engagé politiquement ou socialement."
                            },
                            {
                                "example_id": "04380dee-8064-4002-afd0-74acf94b8a14",
                                "sense_id": "a0966cf0-ec0f-30f3-8560-e56cbee51fbc",
                                "text": "Il est parti d’un pimpant anarchisme de droite pour aragoniser tristounettement avec le PC, à un moment où tous les mimiles de la confrérie ayant encore une once d’amour-propre ou d'intégrité ont uriné sur leurs cartes depuis belle lurette."
                            },
                            {
                                "example_id": "0d803314-1e49-4a13-8cba-5d984c334aec",
                                "sense_id": "a0966cf0-ec0f-30f3-8560-e56cbee51fbc",
                                "text": "Exilé de lui-même, il était aussi rejeté par un milieu littéraire qui, pour parler à sa façon, n’en finissait pas d’aragoniser, d’éluardiser, de ségheriser..."
                            }
                        ]
                    }
                ],
