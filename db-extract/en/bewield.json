                        "examples": [
                            {
                                "example_id": "649c395f-e408-460c-9e50-02ca1814646f",
                                "sense_id": "6519bfd4-7e26-3d5f-8d0b-4ee4b18b42b5",
                                "text": "No grey goose quills the weapons used ;—a walking cane one feller With puissant arm bewielded, and the other his umbrella."
                            },
                            {
                                "example_id": "6f56b379-1a6e-4a58-8b8f-68f8abb65971",
                                "sense_id": "6519bfd4-7e26-3d5f-8d0b-4ee4b18b42b5",
                                "text": "But the hands of them that beat him became dry and the hands of the provost also, in such wise that they might not bewield them."
                            },
                            {
                                "example_id": "584a873b-07ea-4331-a6e4-1486a66c9d2e",
                                "sense_id": "6519bfd4-7e26-3d5f-8d0b-4ee4b18b42b5",
                                "text": "6 cubits and a hand's breadth, all which does import that he was a notable Giant, and a 1 great strength to wear such an armor and bewield so heavy a lance."
                            },
                            {
                                "example_id": "92d880e8-8ebd-4e46-8fbd-dad168ce83f8",
                                "sense_id": "6519bfd4-7e26-3d5f-8d0b-4ee4b18b42b5",
                                "text": "She was visibly an acid attack survivor. Ali could be seen wrapping his arms around her in the picture.\nI couldn't bewield this anymore. Interminable sentiments skirmishing inside me shouted for a vent."
