        "fr-extract.jsonl": [
            {
                "entry_id": "4a30c852-739e-32e2-95de-7d7dc7ea3650",
                "word": "plumaison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cad84ce4-f370-4967-9527-d426715a9dbd",
                        "entry_id": "4a30c852-739e-32e2-95de-7d7dc7ea3650",
                        "tags": [
                            "plural"
                        ],
                        "form": "plumaisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "383a83dc-9e39-369d-96c3-37599712dcd1",
                        "entry_id": "4a30c852-739e-32e2-95de-7d7dc7ea3650",
                        "glosses": [
                            "Action de déplumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd3370d1-5c76-45c8-9710-c8e1b52c2bee",
                                "sense_id": "383a83dc-9e39-369d-96c3-37599712dcd1",
                                "text": "Il faut que les deux jours qui suivent leur plumaison, on ait soin de les faire manger, et sur-tout boire; sans cette précaution, il y en a quelquefois qui vont se cacher, et qui meurent faute de nourriture."
                            },
                            {
                                "example_id": "cbe6ef35-2373-4b28-8186-8388b4f0987f",
                                "sense_id": "383a83dc-9e39-369d-96c3-37599712dcd1",
                                "text": "— Les farceuses s’entendent mieux que nous à la plumaison du dinde !…"
                            },
                            {
                                "example_id": "6c7a1962-93b0-4806-a686-ef504c3c151f",
                                "sense_id": "383a83dc-9e39-369d-96c3-37599712dcd1",
                                "text": "Que ce soient l’étourdissement, la saignée, la plumaison (pour les volailles) ou le dépouillage (pour les lapins), l’éviscération ou la réfrigération, chaque étape du process d’abattage joue un rôle capital dans la qualité du produit […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3acfad6-e4ef-4a8b-a14d-140c34c760dc",
                        "source_entry_id": "4a30c852-739e-32e2-95de-7d7dc7ea3650",
                        "source_sense_id": "383a83dc-9e39-369d-96c3-37599712dcd1",
                        "source_sense_description": "Action d’enlever les plumes",
                        "target_lang_word": "pluck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pluck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0126f540-bdc7-3fe9-91fb-329fcdc63c27",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To pull something sharply; to pull something out"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3495cf83-f616-4112-992c-bce38c8388d9",
                                                "sense_id": "0126f540-bdc7-3fe9-91fb-329fcdc63c27",
                                                "text": "She plucked the phone from her bag and dialled."
                                            },
                                            {
                                                "example_id": "1fa50613-6aa9-4e96-955e-716e2d563d28",
                                                "sense_id": "0126f540-bdc7-3fe9-91fb-329fcdc63c27",
                                                "text": "The girl stooped to pluck a rose, and as she bent over it, her profile was clearly outlined."
                                            },
                                            {
                                                "example_id": "22eec2f1-e049-44ef-8f72-4af04bbfede7",
                                                "sense_id": "0126f540-bdc7-3fe9-91fb-329fcdc63c27",
                                                "text": "\"I want to bring that date forward. You only get one shot at this, and if I pluck a date from the air, you will judge me by it. So, until I am certain, I'm sticking with the previous date. [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7272cd9d-6caf-3010-b505-487d42858461",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To take or remove (someone) quickly from a particular place or situation."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb59e258-751c-49ce-b28f-6d10ac1acda4",
                                                "sense_id": "7272cd9d-6caf-3010-b505-487d42858461",
                                                "text": "First of all, he says a lot of the promotions from the ranks are promotions of the sons of officers who have gone wrong , or got \"plucked,\" or what not, and who are brought up again along another road for commissioned rank."
                                            },
                                            {
                                                "example_id": "25d7c14f-7dbe-4495-ae27-b80dfbf5f435",
                                                "sense_id": "7272cd9d-6caf-3010-b505-487d42858461",
                                                "text": "The hardest mission fell to the tanker aircraft, decidedly unglamorous birds, mainly flown by Air Force Reserve crews—most of them plucked from their airline jobs—so rapidly called into service that FAA rules for crew rest time on domestic airlines were quietly violated for the next several weeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed6b26b-5dde-3c02-aad8-675fe4f67c76",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To play (a single string on a musical instrument) by pulling and then releasing it, such as on a guitar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276d9473-fe3a-4d18-a1f7-f2a6cb15efa1",
                                                "sense_id": "0ed6b26b-5dde-3c02-aad8-675fe4f67c76",
                                                "text": "Whereas a piano strikes the string, a harpsichord plucks it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d92fc813-837a-3fc7-a756-049e8366a0cd",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To remove feathers from (a bird)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1365831-8c7b-4d99-adb6-ef86dd00607f",
                                                "sense_id": "d92fc813-837a-3fc7-a756-049e8366a0cd",
                                                "text": "Molly the dairymaid came a little way from the rickyard, and said she would pluck the pigeon that very night after work. She was always ready to do anything for us boys; and we could never quite make out why they scolded her so for an idle hussy indoors. It seemed so unjust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34d9ddf-bd90-38c7-92d6-dcd7bcaad25d",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To rob, steal from; to cheat or swindle (someone)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c9269dc-537d-4417-b87a-36779f9e2581",
                                                "sense_id": "d34d9ddf-bd90-38c7-92d6-dcd7bcaad25d",
                                                "text": "Indeed they seem to consider foreigners as strangers whom they should never see again, and might fairly pluck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2da1f9a5-f5ac-3159-a3a4-d9978fc8ff2d",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To play a string instrument pizzicato."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81de9e89-bb88-46c6-8dd6-61b7ef90555f",
                                                "sense_id": "2da1f9a5-f5ac-3159-a3a4-d9978fc8ff2d",
                                                "text": "Plucking a bow instrument may cause a string to break."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef2e96c-09a0-3501-8149-f11daedb7823",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To pull or twitch sharply."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d779a65-704d-4c12-a4f8-6445fc6e13a9",
                                                "sense_id": "3ef2e96c-09a0-3501-8149-f11daedb7823",
                                                "text": "to pluck at somebody's sleeve"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "To reject (a student) after they fail an examination for a degree."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c536842a-da54-43e8-8feb-cafbccfbb9f0",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "For arguing that a man will be plucked take the Topics following: for among men likely to be plucked are these for the most part. He that hath no friends, he that hath many friends; the first because he hath none to put him in the right way; the second, because he hath many to draw him therefrom."
                                            },
                                            {
                                                "example_id": "676a52f5-82c4-4748-b99a-3138ecdcb7f8",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "He went to college, and he got— plucked, I think they call it: and then his uncles wanted him to be a barrister, and study the law […]"
                                            },
                                            {
                                                "example_id": "c681bea1-46a7-4498-9ad8-7e8b06e6c635",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "Let us hide our heads, and shut up the page. The lists came out; and a dreadful rumour rushed through the university, that Pendennis of Boniface was plucked."
                                            },
                                            {
                                                "example_id": "a4a28c47-f5fb-4cf1-bfb7-d5dba083f9b9",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "He had been a medical student, and got plucked, his foes declared, in his examination."
                                            },
                                            {
                                                "example_id": "d2aab004-7e41-4e63-9ab0-569cf2501492",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "\"Well, the gooseberry pie is really too deep for me: but 'ploughed' is the new Oxfordish for 'plucked.' O mamma, have you forgotten that? 'Plucked' was vulgar, so now they are 'ploughed.' 'For smalls; but I hope I shall not be, to vex you and Puss.'\""
                                            },
                                            {
                                                "example_id": "52934677-e18d-42d3-b65c-b20c79acf338",
                                                "sense_id": "6f2c598f-95d7-3147-a372-6ab39fd2be33",
                                                "text": "I trust that I have never plucked a candidate in the Schools without giving him every opportunity of setting himself right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8985da7-3582-3bde-b615-ac93d72736be",
                                        "entry_id": "9b6a106f-608d-3d0b-bc18-6fee5a9a5783",
                                        "glosses": [
                                            "Of a glacier: to transport individual pieces of bedrock by means of gradual erosion through freezing and thawing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pluck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df702cef-e937-35c1-9f39-f873fd387012",
                                        "entry_id": "5fb64435-7d62-337e-8a2e-7468581c3517",
                                        "glosses": [
                                            "An instance of plucking or pulling sharply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0102a689-d43a-4345-aca3-21b1d1866b52",
                                                "sense_id": "df702cef-e937-35c1-9f39-f873fd387012",
                                                "text": "Those tiny birds are hardly worth the tedious pluck."
                                            },
                                            {
                                                "example_id": "92be842f-1797-400d-8819-1df40552db2b",
                                                "sense_id": "df702cef-e937-35c1-9f39-f873fd387012",
                                                "text": "If you find yourself in this position, there is nothing for it but to haul out using external assistance. This may be from a friend who will give you a pluck off the wall, or you may be able to manage from your own resources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d51d1eb-6d0d-3be9-aac2-6426af496b7f",
                                        "entry_id": "5fb64435-7d62-337e-8a2e-7468581c3517",
                                        "glosses": [
                                            "The lungs, heart with trachea and often oesophagus removed from slaughtered animals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0883757-d6af-344c-8ddf-8ccd7dce0d2b",
                                        "entry_id": "5fb64435-7d62-337e-8a2e-7468581c3517",
                                        "glosses": [
                                            "Guts, nerve, fortitude or persistence."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3652def-ce22-42bf-9e07-6ce1e15f1911",
                                                "sense_id": "d0883757-d6af-344c-8ddf-8ccd7dce0d2b",
                                                "text": "He didn't get far with the attempt, but you have to admire his pluck."
                                            },
                                            {
                                                "example_id": "7bb14ff8-0411-4823-97d4-7027afe8416d",
                                                "sense_id": "d0883757-d6af-344c-8ddf-8ccd7dce0d2b",
                                                "text": "Pen had a very good mare, and rode her with uncommon pluck and grace. He took his fences with great coolness, and yet with judgment, and without bravado."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9a8f40b-5ac9-3227-802b-de31cbefa661",
                                        "entry_id": "5fb64435-7d62-337e-8a2e-7468581c3517",
                                        "glosses": [
                                            "Cheap wine."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
