                "senses": [
                    {
                        "sense_id": "7d32c0e6-a3ee-3c34-8bdb-1aa6102ff749",
                        "entry_id": "6c4e0d81-36c5-3f5a-85a7-be8ebfb9f05f",
                        "glosses": [
                            "Dach in der Form eines halben liegenden Zylinders, halbrunde Dachform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0802838-dc6b-4261-b8fb-8d6db2227278",
                                "sense_id": "7d32c0e6-a3ee-3c34-8bdb-1aa6102ff749",
                                "text": "„Tonnendach heißt ein Dach von der Form eines Tonnengewölbes; meist sind mehrere Tonnen nebeneinander angeordnet.“"
                            },
                            {
                                "example_id": "5aad66ca-a19e-4cd2-91f2-9cf2fbbb301c",
                                "sense_id": "7d32c0e6-a3ee-3c34-8bdb-1aa6102ff749",
                                "text": "„Nach dem Krieg wurde Kassel zum zweiten Mal gebaut. Kaufhäuser, Schulen und Bürogebäude veranschaulichen noch heute den Stil der ‚neuen Dynamik‘. Attikageschosse, Glasbausteine und Tonnendächer säumen die viel zu breiten Straßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
