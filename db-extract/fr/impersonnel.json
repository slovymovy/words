                    },
                    {
                        "form_id": "e770d6d7-7bcf-4a4f-80b2-3fff32eecf59",
                        "entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "impersonnelles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88274b75-16e8-31aa-a12a-4050199aad54",
                        "entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "glosses": [
                            "Qui ne constitue pas une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0629e5cb-aca4-4faf-82db-a3e17f8dee5c",
                                "sense_id": "88274b75-16e8-31aa-a12a-4050199aad54",
                                "text": "Pour les panthéistes, Dieu est impersonnel."
                            }
                        ]
                    },
                    {
                        "sense_id": "44935da2-fc9f-3f5c-ae48-61be4224dc9f",
                        "entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "glosses": [
                            "Qui n’appartient pas, qui ne se rapporte pas à une personne."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "e244e3a9-abf8-4490-87da-cff12a41267c",
                                "sense_id": "44935da2-fc9f-3f5c-ae48-61be4224dc9f",
                                "text": "De toute façon, l’État d’Europe occidentale, en tant qu’expression de la réalité politique et source impersonnelle du droit public, est une institution relativement récente […]."
                            },
                            {
                                "example_id": "fd005d48-358f-420f-90e6-1d3e8dcade6b",
                                "sense_id": "44935da2-fc9f-3f5c-ae48-61be4224dc9f",
                                "text": "On a soutenu que la raison, en tant qu’elle conçoit, dans une certaine mesure, l’infini, est impersonnelle, c’est-à-dire la même chose chez tous, parce qu’elle n’appartient en propre à personne."
                            }
                        ]
                    },
                    {
                        "sense_id": "78b29fd1-f3b0-3144-aeba-45b8ecf08918",
                        "entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "glosses": [
                            "Qui est employé à la troisième personne du singulier, sans relation à un sujet déterminé, en parlant de certains verbes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b91866c-e9fc-44b6-b494-243a6f302111",
                                "sense_id": "78b29fd1-f3b0-3144-aeba-45b8ecf08918",
                                "text": "Les verbes impersonnels proprement dits sont ceux qui n’ont que l’infinitif et la troisième personne du singulier, tels que falloir, pleuvoir (parfois personnel), neiger, etc., qui font il faut, il pleut, il neige, etc. Quelques verbes impersonnels employés figurément prennent le pluriel : Les honneurs pleuvent sur lui. Certains verbes personnels deviennent quelquefois impersonnels, comme Il convient de faire cela, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb7e929d-ef2c-375b-bf05-3411f3d25440",
                        "entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "glosses": [
                            "Modes du verbe qui ne reçoivent pas d’inflexions indiquant les personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee52fb3-e947-4c71-9371-a53f2af5ef0e",
                                "sense_id": "cb7e929d-ef2c-375b-bf05-3411f3d25440",
                                "text": "L’infinitif et le participe sont des modes impersonnels."
                            },
                            {
                                "example_id": "40fd2a20-9db1-4885-be00-4ba66d233000",
                                "sense_id": "cb7e929d-ef2c-375b-bf05-3411f3d25440",
                                "text": "Les formes impersonnelles du verbe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c34f8b10-464b-4e1a-bb9a-ca63e851dc40",
                        "source_entry_id": "0542d3fe-7b0e-3ff2-bf76-8cbb34423125",
                        "target_lang_word": "impersonal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impersonal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62b5e8aa-9155-312c-adf9-0639701bcdfc",
                                        "entry_id": "b2e14b34-ba74-307f-9691-2bdbd218a231",
                                        "glosses": [
                                            "Not personal; not representing a person; not having personality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ded3c291-37fe-45a9-87e1-99a34dd4fa34",
                                                "sense_id": "62b5e8aa-9155-312c-adf9-0639701bcdfc",
                                                "text": "The great tragedians of Greece reveal to us their people's exquisite sense of beauty, and their faith in an awful, an almighty, but an impersonal power, called Fate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98035f4c-29d4-310d-8d7c-2f467aa9ef7b",
                                        "entry_id": "b2e14b34-ba74-307f-9691-2bdbd218a231",
                                        "glosses": [
                                            "Lacking warmth or emotion; cold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "825d80e0-6a30-45c9-bf83-741852963647",
                                                "sense_id": "98035f4c-29d4-310d-8d7c-2f467aa9ef7b",
                                                "text": "She sounded impersonal as she gave her report of the Nazi death camps."
                                            },
                                            {
                                                "example_id": "9196f8ea-c2ac-4f49-a249-7fb646b34515",
                                                "sense_id": "98035f4c-29d4-310d-8d7c-2f467aa9ef7b",
                                                "text": "And now it appeared that there was a mysterious Queen clothed by rumour with dread and wonderful attributes, and commonly known by the impersonal, but, to my mind, rather awesome title of She."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3efa5c4e-9403-3d05-9195-79a114c8b6a6",
                                        "entry_id": "b2e14b34-ba74-307f-9691-2bdbd218a231",
                                        "glosses": [
                                            "Not having a subject, or having a third person pronoun without an antecedent."
                                        ],
                                        "tags": [
                                            "of a verb or other word"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "754fc707-b3d3-4240-a40c-f093193cd20d",
                                                "sense_id": "3efa5c4e-9403-3d05-9195-79a114c8b6a6",
                                                "text": "The verb “rain” is impersonal in sentences like “It’s raining.”"
                                            }
                                        ]
                                    }
                                ]
                            },
