                                        "entry_id": "ccddd0e8-2875-39ae-80f2-bd4f1c97e095",
                                        "glosses": [
                                            "het vrolijk en ongedwongen bezig zijn zoals dat past bij jonge kinderen of jonge dieren"
                                        ],
