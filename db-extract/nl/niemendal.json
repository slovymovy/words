                "translations": [
                    {
                        "translation_id": "a3006e0f-0f36-4ece-83cb-7620b5fc2870",
                        "source_entry_id": "52d80587-1603-3dc6-87aa-67e93e81eaa2",
                        "source_sense_id": "d0457838-cddc-3798-8ca4-bf128ab42100",
                        "target_lang_word": "none",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153a62a1-afde-4683-bde8-9d19fd23999f",
                                                "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                                "text": "None of those is a good example. None are even acceptable."
                                            },
                                            {
                                                "example_id": "98ddb917-c0a7-414d-8b55-41c9078a5fad",
                                                "sense_id": "0e27d5be-1be7-39aa-b41b-7f2f497cd1e1",
                                                "text": "None of this meat tastes right."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b708d97-84da-304e-ae21-b56214f6eb92",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group.",
                                            "No one, nobody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6fc1bc7-e1d2-4510-a8b2-bb8f863e8ced",
                                                "sense_id": "2b708d97-84da-304e-ae21-b56214f6eb92",
                                                "text": "None of those people is my father."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                        "entry_id": "297366bf-80a9-3fde-ba02-64f1568b0cae",
                                        "glosses": [
                                            "Not any of a given number or group.",
                                            "No person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af69913-8d9a-4b35-8191-ac0b551057e5",
                                                "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                                "text": "None of those people are my parents. None shall pass."
                                            },
                                            {
                                                "example_id": "83224277-6799-467e-ade6-248c2ee9d909",
                                                "sense_id": "3086bd57-474a-370b-92df-8c7089c99895",
                                                "text": "Alas, none of these people were writing the reviews."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                        "entry_id": "4898e341-88c2-349f-aba7-f2d5c27df75d",
                                        "glosses": [
                                            "Not any; no (usually used only before a vowel or h)"
                                        ],
                                        "tags": [
                                            "West-Country"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97bda935-2ea3-4342-9871-dd9fbcb1771f",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "Thou shalt have none other gods but me."
                                            },
                                            {
                                                "example_id": "f1911cc1-4cc0-4b49-b177-4c6cc120a9c2",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "the foles toke their lampes, but toke none oyle with them."
                                            },
                                            {
                                                "example_id": "514a77a8-5ba4-4cbe-b751-cf0f5194ac2f",
                                                "sense_id": "c5f6710d-d0ca-32c7-b01b-049bc31642f1",
                                                "text": "None lasses were in the dunces' row. If one had been there people would have looked at her and felt sorry but not boys."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "To no extent, in no way."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "154b13a8-dfb1-4d10-9f36-99ac4d44170d",
                                                "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                                "text": "I felt none the worse for my recent illness."
                                            },
                                            {
                                                "example_id": "d34520bc-ef12-43da-b651-f65e82b54a36",
                                                "sense_id": "442a1e45-51e8-3f62-9fd4-2b562d988461",
                                                "text": "my lack of education hasn't hurt me none"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "Not at all, not very."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197aeb77-ef3b-46da-a267-75a3f5c5bec4",
                                                "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                                "text": "We could hear none too well from the back."
                                            },
                                            {
                                                "example_id": "fe30b065-6836-43bc-8d53-ca0a2b59540e",
                                                "sense_id": "1489aae7-fcdf-3f1a-bb57-d7c7e2c81b9c",
                                                "text": "He was none too pleased with the delays in the program that was supposed to be his legacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad85b53b-5a04-398b-aef8-39ac63d018dd",
                                        "entry_id": "b8da377a-3c78-34f9-813f-7a536102c849",
                                        "glosses": [
                                            "No, not."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                        "entry_id": "2ace23bc-b981-3980-898b-f75275d5388c",
                                        "glosses": [
                                            "A person without religious affiliation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76066c52-03c1-4b51-ae01-d373e461814f",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "Both the religiously dis-identified (\"nones\") and the religiously committed report mystical experiences."
                                            },
                                            {
                                                "example_id": "601af3d5-1eca-4f73-b0fb-4dc994b2231b",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "Stable nones, that is, people who report in both years that they have no religious affiliation, are, in fact, much less religious"
                                            },
                                            {
                                                "example_id": "c923e8af-4504-4ee2-b367-577bdc4fdc00",
                                                "sense_id": "36199f9a-b33a-324c-8bad-5063a158b080",
                                                "text": "we have grouped people into nones (no religion), Jews, Catholics, mainline Protestants, and evangelical protestants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "none",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8e3820-3415-3e57-953f-1786b480ba7c",
                                        "entry_id": "062e4040-133b-3849-a88e-db77550441fb",
                                        "glosses": [
                                            "Alternative form of nones: the ninth hour after dawn; (Christianity) the religious service appointed to this hour."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                        "entry_id": "062e4040-133b-3849-a88e-db77550441fb",
                                        "glosses": [
                                            "Synonym of midafternoon: the time around or following noon or nones."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab4349a-08f5-4f94-8306-73b0d0c004c1",
                                                "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                                "text": "None of the day, is the third quarter of the day beginning at Noon and lasting till the Sun be gone half way towards setting."
                                            },
                                            {
                                                "example_id": "03b2adb6-05d3-45ea-969e-330dd7ea0b79",
                                                "sense_id": "f92cd1c7-c967-3b9f-a57f-674b878859b1",
                                                "text": "The last, which began at the middle of the Afternoon, i.e. at half the Time between Noon and Sun-setting, was called None, because it began at the Ninth Hour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f60420ca-49cd-4b01-a4af-70420303f8d5",
                        "source_entry_id": "52d80587-1603-3dc6-87aa-67e93e81eaa2",
                        "source_sense_id": "d0457838-cddc-3798-8ca4-bf128ab42100",
                        "target_lang_word": "not an ace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad093dc4-9de6-46e5-a6da-6434265ce1da",
                        "source_entry_id": "52d80587-1603-3dc6-87aa-67e93e81eaa2",
                        "source_sense_id": "d0457838-cddc-3798-8ca4-bf128ab42100",
                        "target_lang_word": "nothing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                        "entry_id": "fe9bbaa8-6d9e-3d1e-b7ec-1739e63e7981",
                                        "glosses": [
                                            "Not at all; in no way."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5241cf1d-5b05-4f83-a9d2-4ae6f0c5acbb",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "Nothing too much out of the ordinary."
                                            },
                                            {
                                                "example_id": "7bc240dd-dc3e-49b4-9caa-8585408dfbc8",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "The answer was an impatient one—but, nothing daunted, he continued."
                                            },
                                            {
                                                "example_id": "53b8f05c-3ea6-4393-abc6-b7a7a827aa03",
                                                "sense_id": "0dd19e14-ba4a-3cb6-99be-cc7932f73cad",
                                                "text": "The Motion from London to Syria is as much as nothing; and nothing altereth the relation which is between them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                        "entry_id": "4cc32fa4-c155-367f-8a25-6c79899b33c2",
                                        "glosses": [
                                            "Not any thing; no thing."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b54afed-de49-4aec-b9d8-f76eba2fb138",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Don't just say nothing. Tell me what's going on."
                                            },
                                            {
                                                "example_id": "d0fa8e8b-66db-47a7-b60e-0a9ebc1a04d2",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Nothing bad will happen, will it?"
                                            },
                                            {
                                                "example_id": "de04ff96-67fc-4469-8794-92744d625362",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "There remains nothing more to be done."
                                            },
                                            {
                                                "example_id": "3bdfc966-f2eb-4634-a65e-9061a3e623b0",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "the players see little or nothing of their cards at first starting"
                                            },
                                            {
                                                "example_id": "d704cba5-92dc-4964-b05c-bd0da49a0969",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "A ceremony at which two persons undertake to become one, one undertakes to become nothing, and nothing undertakes to become supportable."
                                            },
                                            {
                                                "example_id": "9fe4de0b-9701-4587-ae17-85286e08634e",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Nothing was too small to receive attention, if a supervising eye could suggest improvements likely to conduce to the common welfare. Mr. Gordon Burnage, for instance, personally visited dust-bins and back premises, accompanied by a sort of village bailiff, going his round like a commanding officer doing billets."
                                            },
                                            {
                                                "example_id": "dfc2c709-d334-4d7a-b076-4d163acd0a8c",
                                                "sense_id": "b78151c0-5ac3-3543-a433-12253df8d833",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66551e4f-53f2-38a0-9167-e2896e342777",
                                        "entry_id": "4cc32fa4-c155-367f-8a25-6c79899b33c2",
                                        "glosses": [
                                            "An absence of anything, including empty space, brightness, darkness, matter, or a vacuum."
                                        ],
                                        "tags": [
                                            "indefinite",
                                            "pronoun"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "Something trifling, or of no consequence or importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f878aab4-5312-48bb-b132-7c3d6b7f8238",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "- What happened to your face?\n- It's nothing."
                                            },
                                            {
                                                "example_id": "ca14a0bc-cb89-42e6-94e8-1e69584c5acb",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "Sermons are not like curious inquiries after new nothings, but pursuances of old truths."
                                            },
                                            {
                                                "example_id": "6eec0bd3-e66c-4d60-a57c-4218c961aaed",
                                                "sense_id": "0658fde9-0038-310e-b620-efc05d9bfb01",
                                                "text": "Knuckles: The Egg Carrier is nothing compared to this!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68240e37-72e6-3bfd-9409-5f58932227e5",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "A trivial remark especially in the term sweet nothings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcf0b2be-66c2-328b-9dde-848c685861fe",
                                        "entry_id": "b9199029-efca-3c82-9464-e3519de44d08",
                                        "glosses": [
                                            "A nobody (insignificant person)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df89f4fe-88a8-3616-97bf-fcef3586022e",
                                        "entry_id": "87e1cc48-1623-3d2b-81ea-bf1b09a19229",
                                        "glosses": [
                                            "Completely unimportant."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49ebe9d6-fbf5-4388-84fb-0c008571f4b7",
                                                "sense_id": "df89f4fe-88a8-3616-97bf-fcef3586022e",
                                                "text": "Dallas scored on what had seemed until then like a nothing play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06a48717-81aa-35c7-8703-fec0334562f5",
                                        "entry_id": "87e1cc48-1623-3d2b-81ea-bf1b09a19229",
                                        "glosses": [
                                            "Lacking effort or commitment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c96cd78-d6a9-4574-a91e-28e315fd0bbc",
                                                "sense_id": "06a48717-81aa-35c7-8703-fec0334562f5",
                                                "text": "The cricketer played a nothing shot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nothing",
                                "target_lang_code": "en",
