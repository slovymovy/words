                    }
                ],
                "senses": [
                    {
                        "sense_id": "9dd820b3-1e8e-3ee5-b5b0-74a917ecbcc7",
                        "entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "glosses": [
                            "Ancienne mesure de masse de 100 livres."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "13109b2a-47d7-4cf1-a2f0-5ae9a33bc129",
                                "sense_id": "9dd820b3-1e8e-3ee5-b5b0-74a917ecbcc7",
                                "text": "Le Sénégal peut fournir , année commune , cinquante captifs, quatre mille cuirs, douze cens quintaux de gomme, & vingt quintaux de morfil."
                            },
                            {
                                "example_id": "469e8fc8-1cce-499c-af67-62c6d6217cab",
                                "sense_id": "9dd820b3-1e8e-3ee5-b5b0-74a917ecbcc7",
                                "text": "Ils emportaient pour trois mois de vivres, c’est-à-dire trois quintaux de farine, cinquante livres de riz, cinquante livres de farine d’avoine, un quintal de viande de cheval séchée."
                            }
                        ]
                    },
                    {
                        "sense_id": "59fdb6d3-0bc8-3778-827f-ddca46d5de92",
                        "entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "glosses": [
                            "Unité de mesure de masse qui correspond à 100 kilogrammes (symbole : q)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8996e048-17a5-4831-a3ab-3c9fdb87bd8c",
                                "sense_id": "59fdb6d3-0bc8-3778-827f-ddca46d5de92",
                                "text": "La commissaire Berudescu (Violeta pour les intimes), sa moustache, son parfum pestilentiel, son quintal et sa dizaine de sbires."
                            },
                            {
                                "example_id": "8abb752f-027e-4288-9d21-48c445304816",
                                "sense_id": "59fdb6d3-0bc8-3778-827f-ddca46d5de92",
                                "text": "Il y a dix quintaux à la tonne."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e596bd7-d3d9-32f2-a1ef-d82742798bfc",
                        "entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "glosses": [
                            "Unité de mesure de masse anglo-saxonne, valant soit 100 livres (quintal court ou cental) ou 112 livres (quintal fort)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3173f7a-675b-4a6f-acd8-f876e1ba6b2e",
                        "source_entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "target_lang_word": "Zentner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zentner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ec41d51-7cfd-30c4-85ce-eaf53de67f52",
                                        "entry_id": "b9bb853b-f489-3aeb-858e-24a6ac1185cd",
                                        "glosses": [
                                            "Maßeinheit für 50 Kilogramm; ursprünglich Gewichtseinheit zu 100 (britisch 112) Pfund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "119c3e97-9178-421b-b867-ff292abc4667",
                                                "sense_id": "5ec41d51-7cfd-30c4-85ce-eaf53de67f52",
                                                "text": "Wir haben drei Zentner Kartoffeln im Keller."
                                            },
                                            {
                                                "example_id": "c625d47f-84e4-4a42-a54a-f2b5503fd3df",
                                                "sense_id": "5ec41d51-7cfd-30c4-85ce-eaf53de67f52",
                                                "text": "„Eine schlachtreife Kuh wog zu Luthers Zeit höchstens fünf Zentner, die Hälfte eines heutigen Mastrindes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "200123af-fe30-3f49-8f21-63f2d74ef637",
                                        "entry_id": "b9bb853b-f489-3aeb-858e-24a6ac1185cd",
                                        "glosses": [
                                            "Gewichtseinheit zu 100 Kilogramm"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "Swiss Standard German",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fb23475-62f4-4aee-a558-2159797d1337",
                                                "sense_id": "200123af-fe30-3f49-8f21-63f2d74ef637",
                                                "text": "In der Schweiz hat der Zentner 100 kg, in Deutschland sagt man Doppelzentner dazu."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9faf2420-7b87-4db9-90d8-7a8c2107c0c8",
                        "source_entry_id": "fdcd0e81-676f-3005-939d-068601d7645b",
                        "target_lang_word": "quintal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quintal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8a88a4e-00a9-3dd6-ad05-b4f00f9fd479",
                                        "entry_id": "c61bced3-fbf4-37fc-a73e-b0f0d53544b9",
                                        "glosses": [
                                            "Referring to five (or more) things; of, in or relating to the quintal grammatical number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9222c5f8-dc6d-4e1f-a4fa-ed2119ca42cf",
                                                "sense_id": "e8a88a4e-00a9-3dd6-ad05-b4f00f9fd479",
                                                "text": "What Table 4 does not show is the possibility of even \"quadral\" and \"quintal\" forms, like yufopela 'you four', 'the four of you', yufaipela 'you five', 'the five of you'."
                                            },
                                            {
                                                "example_id": "87b32c85-4ff9-4900-8eeb-ed5e9d5450d3",
                                                "sense_id": "e8a88a4e-00a9-3dd6-ad05-b4f00f9fd479",
                                                "text": "In sign languages, on the other hand, trial, quadral and quintal forms such as found in UgSL are not uncommon."
                                            },
                                            {
                                                "example_id": "4211e95e-49ac-4c76-84f7-9e3656aeaefc",
                                                "sense_id": "e8a88a4e-00a9-3dd6-ad05-b4f00f9fd479",
                                                "text": "Moreover, trial, quadral and quintal forms are given an identical status as number values in the pronominal domain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quintal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27f0ec95-86a6-312c-a1c5-28a848d802ec",
                                        "entry_id": "40d88c07-5e49-3a92-a8dc-689cb6cedfa6",
                                        "glosses": [
                                            "Synonym of hundredweight, 100 or 112 English or American pounds."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d3d0b7c-b08c-4528-bbb1-a890e27fd735",
                                                "sense_id": "27f0ec95-86a6-312c-a1c5-28a848d802ec",
                                                "text": "In one import license alone, the merchant in question was instructed to bring in 13,000 quintals of alum, which, snapped up by industries in England and the Low Countries, would yield the king a cool £8,666 13s 4d."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020b7b3e-8007-3418-a790-c02b45b5a395",
                                        "entry_id": "40d88c07-5e49-3a92-a8dc-689cb6cedfa6",
                                        "glosses": [
                                            "Various other similar units of weight in other systems."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db1d47df-996c-3b6e-8ceb-8fdd7c0e8ce2",
                                        "entry_id": "40d88c07-5e49-3a92-a8dc-689cb6cedfa6",
                                        "glosses": [
                                            "An unofficial metric unit equal to 100 kg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quintal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be98ae69-1d99-31c1-845c-be67eae00c1c",
                                        "entry_id": "aaa79bca-3910-3036-884b-bc36b11a54eb",
                                        "glosses": [
                                            "A grammatical number referring to five (or more) things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5b8d0c-ce1c-4ca8-bf3c-176623beb2b7",
                                                "sense_id": "be98ae69-1d99-31c1-845c-be67eae00c1c",
                                                "text": "Furthermore, if the number-incorporated pronouns are analyzed as grammatically marked for number, distinct grammatical categories for trial, quadral and quintal must be posited."
                                            },
                                            {
                                                "example_id": "0268026a-cd69-448f-957c-f4ed9f5cf51b",
                                                "sense_id": "be98ae69-1d99-31c1-845c-be67eae00c1c",
                                                "text": "In UgSL, we find a complete set of forms for dual, trial, quadral and quintal in several paradigmatic contrasts."
                                            },
                                            {
                                                "example_id": "b84cb68e-914e-4ed2-929c-a4501cad2a8b",
                                                "sense_id": "be98ae69-1d99-31c1-845c-be67eae00c1c",
                                                "text": "All in all, this suggests that in LSC the differences observed in the motion taken by exact number pronouns is not grounded in a fundamental distinction between the dual vs. the trial, the quadral and the quintal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
