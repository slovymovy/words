                "senses": [
                    {
                        "sense_id": "805c32cb-f440-34c2-b406-52d691cc78a9",
                        "entry_id": "bd3af25a-f0f5-3ff3-b11c-7a0b004efdbe",
                        "glosses": [
                            "reacties tegengaand waarbij elektronen worden uitgewisseld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cd17394-387e-426d-9d77-a63d9eaf43ac",
                                "sense_id": "805c32cb-f440-34c2-b406-52d691cc78a9",
                                "text": "Regelmatig is gesuggereerd dat dagelijkse suppletie aan het voedsel van lage hoeveelheden vitaminen en mineralen met een antioxidante werking de kans op het ontstaan van hart- en vaatziekten en kanker zou verhogen."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
