                "senses": [
                    {
                        "sense_id": "f46f780b-73e4-3176-9e86-de573ab4b554",
                        "entry_id": "c1ea8d1d-8a02-3dcc-aa26-016473401dcb",
                        "glosses": [
                            "derjenige Wortschatz, der einer ganzen Sprachgemeinschaft zur Verfügung steht und nicht auf bestimmte Sprechergruppen (etwa: Wissenschaftler, Ingenieure, ...) begrenzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77eed43-4cef-4a03-8da4-3ebb2071fc86",
                                "sense_id": "f46f780b-73e4-3176-9e86-de573ab4b554",
                                "text": "„Diese Wörter gehören nicht dem Allgemeinwortschatz an und sollten daher auch nicht im amtlichen Wörterverzeichnis angeführt werden (...).“"
                            },
                            {
                                "example_id": "a4d5a6a2-f83e-4ae7-a35b-53a187b82446",
                                "sense_id": "f46f780b-73e4-3176-9e86-de573ab4b554",
                                "text": "„Für den Rechtschreibduden erfasst die Dudenredaktion den Allgemeinwortschatz der deutschen Sprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
