                "senses": [
                    {
                        "sense_id": "633fef16-66cc-36b8-9769-b16857ac72b9",
                        "entry_id": "7d89b020-ba0a-3da8-8ab0-bb613f723c40",
                        "glosses": [
                            "Cable attaché à une charge, au cours du levage, pour la guider."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "e01677e8-2a0d-4c0c-bf60-6847c8fb85cd",
                                "sense_id": "633fef16-66cc-36b8-9769-b16857ac72b9",
                                "text": "VERBOQUET, s. m. (Méchan.) còntre - lien, ou cordeau qu’on attache à l’un des bouts d’une piece de bois ou d’une colonne, & au gros cable qui la porte, pour la tenir mieux en équilibre, & pour empêcher qu’elle ne touche à quelque saillie ou échaffaud, & qu’elle ne tournoie quand on la monte. On dit aussi virebouquet, parce que la corde fait tourner la piece dans le sens que l’on veut. (D.J.)"
                            }
                        ]
                    },
                    {
                        "sense_id": "3ae42a13-c9f2-3b67-9784-4cee1a630788",
                        "entry_id": "7d89b020-ba0a-3da8-8ab0-bb613f723c40",
                        "glosses": [
                            "Tirant d’installation."
                        ],
                        "tags": [
                            "Utilisation récente"
                        ],
                        "examples": [
                            {
                                "example_id": "7806d216-d3cf-43b3-ac72-b1651caad1bc",
                                "sense_id": "3ae42a13-c9f2-3b67-9784-4cee1a630788",
                                "text": "Positionner un écrou M10 dans chaque verboquet en maintenant une distance de la base d’au moins 25 mm, pour permettre de baisser le motoréducteur à la fin de l’installation, […]."
                            },
                            {
                                "example_id": "e8d1e282-1ea9-4366-9480-cbb71960bbb2",
                                "sense_id": "3ae42a13-c9f2-3b67-9784-4cee1a630788",
                                "text": "Introduire les tuyaux dans les trous, serrer les verboquets et ensuite recouvrir les fissures avec du silicone."
                            }
                        ]
                    }
                ],
