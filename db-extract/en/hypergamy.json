                    {
                        "sense_id": "c999ae3f-4f90-33c7-a844-51f9b9bc1e26",
                        "entry_id": "00977266-23dc-358d-b9bd-7bbac9f3bb59",
                        "glosses": [
                            "hipergamia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3b30d9-52a3-4390-9950-3f144ed31133",
                                "sense_id": "c999ae3f-4f90-33c7-a844-51f9b9bc1e26",
                                "text": "Any marriage in which the male belongs to a higher group than the female (…) is an instance of female hypergamy, regardless of the absolute magnitude of the gap.",
                                "translation": "Każde małżeństwo, w którym mężczyzna przynależy do wyższej rangi niż kobieta (…) jest przykładem hipergamii, niezależnie od całkowitej wielkości tej różnicy."
                            },
                            {
                                "example_id": "0af98fd9-a8ac-43cc-90bf-e6c87f06d5e7",
                                "sense_id": "c999ae3f-4f90-33c7-a844-51f9b9bc1e26",
                                "text": "(…) hypergamy doesn’t care about what men consider good or bad.",
                                "translation": "…) hipergamii nie obchodzi to, co mężczyźni uważają za dobre lub za złe."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
