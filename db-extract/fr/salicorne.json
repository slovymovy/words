                        "glosses": [
                            "Plante halophile du genre Salicornia (famille des Amaranthaceae) qui croît sur le bord de la mer, dans les marais salants, et dont on retire de la soude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3d6689-0f92-424e-82c8-19e903f0af0b",
                                "sense_id": "2a5c62a8-0d9c-33ae-8f16-0c8d56e551ff",
                                "text": "Seule une petite parcelle d’un hectare, située à l’autre extrémité du domaine, bénéficie d’un système d’irrigation automatique et fournit une belle salicorne commercialisable."
                            }
                        ]
                    },
