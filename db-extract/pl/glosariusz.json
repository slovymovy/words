                                    {
                                        "sense_id": "fd7076ff-c78d-39f2-90cd-5835819cb196",
                                        "entry_id": "6bdd9143-a8f6-3402-af28-fd60d1faa1d1",
                                        "glosses": [
                                            "A list of difficult words or specialized terms used in a particular book or document, or in a particular domain of knowledge, with their definitions; a list of glosses (explanatory annotations)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d9cb03-41fc-44c0-b719-4386bf828025",
                                                "sense_id": "fd7076ff-c78d-39f2-90cd-5835819cb196",
                                                "text": "At the back of the book you can find the glossary."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7aeb75a-fcf3-41e1-8923-f8c611bfb8ee",
                        "source_entry_id": "c121b2ee-c47f-3605-a3b7-1bc5695a107b",
                        "source_sense_id": "8386e4a8-5eef-39f7-a4a3-a265eaa098a5",
                        "target_lang_word": "glosář",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7406200a-9b58-4168-9d3f-f159ae7a5fcd",
                        "source_entry_id": "c121b2ee-c47f-3605-a3b7-1bc5695a107b",
                        "source_sense_id": "8386e4a8-5eef-39f7-a4a3-a265eaa098a5",
                        "target_lang_word": "glossaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glossaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                        "entry_id": "e69fd13c-f3de-3a2b-909a-911e54454507",
                                        "glosses": [
                                            "Dictionnaire spécialisé servant à expliquer le vocabulaire d'un domaine technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2af0ca-8193-47ef-bd92-ec80bd79541c",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Mon glossaire jmoude était très riche ; mais le sens d'un certain nombre de mots appris de la bouche de paysans grossiers demeurait encore pour moi enveloppé d'une obscurité relative."
                                            },
                                            {
                                                "example_id": "a4ce7745-00ea-437c-a116-be6925c94c35",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "[…]; au premier abord, le lecteur pourra se sentir un peu dérouté, mais qu'il veuille bien se donner la peine, sans être obligé de se reporter au glossaire, de lire quelques lignes à haute voix ; […]."
                                            },
                                            {
                                                "example_id": "cd5937c4-4afa-4c61-914b-da95ede635cd",
                                                "sense_id": "08965ed6-f84f-3b8b-8ae6-18e30ef840fa",
                                                "text": "Cela suppose un vocabulaire commun. Ce glossaire répond au défi de la Babel humaine selon un tempo à deux temps :\n— Au présent, le glossaire, donne des définitions et introduit des réflexions. […].\n— Au futur le glossaire s'enrichira de votre contribution. […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd919fb3-ee56-4f3c-a63f-cd0d2d308f50",
                        "source_entry_id": "c121b2ee-c47f-3605-a3b7-1bc5695a107b",
                        "source_sense_id": "8386e4a8-5eef-39f7-a4a3-a265eaa098a5",
                        "target_lang_word": "glosario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glosario",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "215122d2-f6c5-351a-a17a-52f95dd821b8",
                                        "entry_id": "e27ce38b-2e10-336f-b777-788e122af679",
                                        "glosses": [
                                            "Pequeño vocabulario, generalmente ubicado al final de un libro, que explica las palabras inusuales y propias del texto."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "741b7e22-021c-3746-99b7-a5f2a4a55c59",
                                        "entry_id": "e27ce38b-2e10-336f-b777-788e122af679",
                                        "glosses": [
                                            "Pequeño diccionario que explica los términos propios de una disciplina."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e30ada62-7140-3d6e-9abd-2256670221ed",
                                        "entry_id": "e27ce38b-2e10-336f-b777-788e122af679",
                                        "glosses": [
                                            "Conjunto de glosas reunidas en un texto, acerca de un autor o de un tema."
                                        ],
                                        "tags": [],
