                "senses": [
                    {
                        "sense_id": "75d8f189-aecb-3a41-b7c2-daddb7caf612",
                        "entry_id": "0c2110cb-430c-395e-8fdb-d066ee88c694",
                        "glosses": [
                            "Verbindung mit Arsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e98e832-a9cf-474c-bf43-d90a603da040",
                                "sense_id": "75d8f189-aecb-3a41-b7c2-daddb7caf612",
                                "text": "„Die Toxizität von Arsenverbindungen schwankt sehr stark. Bei Menschen sind Arsenverbindungen eindeutig krebserregend.“"
                            },
                            {
                                "example_id": "a3102d2a-229e-455a-89c8-360dd8324cc7",
                                "sense_id": "75d8f189-aecb-3a41-b7c2-daddb7caf612",
                                "text": "„Die Räume waren sehr feucht und so soll die Feuchtigkeit in Verbindung mit der strahlenden Farbe eine flüchtige Arsenverbindung eingegangen und die Luft vergiftet haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
