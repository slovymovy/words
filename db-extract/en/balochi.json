                    {
                        "translation_id": "7a37ebf3-f32d-45fe-9049-4969af8454da",
                        "source_entry_id": "032fe6b2-1f89-31f1-8c2a-b52b169d096b",
                        "source_sense_id": "d781508c-491e-37bc-adda-67951001f9ca",
