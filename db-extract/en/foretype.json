                "senses": [
                    {
                        "sense_id": "47df6411-56d0-3575-b65d-8632c794e130",
                        "entry_id": "079c3bb5-8521-34f2-80ae-9cff4cf6e6ba",
                        "glosses": [
                            "To make into a foretype, or exemplify as such; to foreshadow; exemplify beforehand"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c6332a83-179a-4cf7-adf0-8367dacd966a",
                                "sense_id": "47df6411-56d0-3575-b65d-8632c794e130",
                                "text": "Whereupon Charlie, of four, foretyped his possible future, and the present of so many, by the exhibition of what might have been called strongly interested affection: …"
                            },
                            {
                                "example_id": "57c2dc49-d296-4be0-a46c-7cb4c8f11ff8",
                                "sense_id": "47df6411-56d0-3575-b65d-8632c794e130",
                                "text": "We may find ourselves going through stages foretyped by the forerunner and pioneer of our faith even as He died and arose again."
                            },
                            {
                                "example_id": "cc63d356-4377-4ac0-a353-8906617a9416",
                                "sense_id": "47df6411-56d0-3575-b65d-8632c794e130",
                                "text": "He came to the red men of the isthmus of America, and they foretyped the blood sacrifice of Jesus the Son of God—and slew thousands of young men!"
                            }
                        ]
                    }
                ],
