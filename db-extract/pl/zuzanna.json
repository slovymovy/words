                        "cross_references": [
                            {
                                "target_word": "Suzanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95b310e0-4162-3e33-8e7f-96dbd9194fd9",
                                        "entry_id": "175da4d3-486b-3475-8235-03cc79e3a0fb",
