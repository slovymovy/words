                                                "sense_id": "4bd444c6-5d76-3cea-a376-5931fcde79e3",
                                                "text": "The Holy Bible, […] (King James Version), London: […] Robert Barker, […], 1611, →OCLC, Genesis 17:1: “I am the Almightie God.”"
                                            }
