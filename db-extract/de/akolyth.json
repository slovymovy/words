                        "sense_id": "017f08ee-6fe5-3adb-a154-5972ea21b66f",
                        "entry_id": "2cbf95d5-9ec8-3f4d-b9f9-e779bcbd6f10",
                        "glosses": [
                            "Laie, der dazu amtlich bestellt ist, im Gottesdienst einen besonderen liturgischen Dienst auszuüben; bis 1972 war das Amt die höchste der vier niederen Weihen"
                        ],
                        "tags": [
                            "katholische",
                            "Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "332e3138-d777-4828-a131-479805793847",
                                "sense_id": "017f08ee-6fe5-3adb-a154-5972ea21b66f",
                                "text": "„Die offiziellen Akolythen werden vom Bischof beauftragt. Sie versehen im Grunde die Aufgaben der ‚normalen‘ Ministranten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da8a5489-2f82-409e-a11e-fd3c4714f23c",
