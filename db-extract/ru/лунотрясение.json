                "senses": [
                    {
                        "sense_id": "1c8c1de9-5aa7-3cd0-943d-24b8b5810fbd",
                        "entry_id": "65762cb6-70c3-3947-9b7d-52f61b50bc2e",
                        "glosses": [
                            "астрон. колебания отдельных участков поверхности Луны, вызываемые тектоническими процессами или ударами метеоритов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc0294c0-1860-427e-a60b-bd14ec1de896",
                                "sense_id": "1c8c1de9-5aa7-3cd0-943d-24b8b5810fbd",
                                "text": "Кратер Арзахель встретил его дневным лунотрясением в самый момент прилунения. Сильнейшие толчки подбросили корабль вверх, когда его стабилизаторы коснулись поверхности планеты."
                            },
                            {
                                "example_id": "4465c406-e1c3-42a0-b878-9ecf8343d3e9",
                                "sense_id": "1c8c1de9-5aa7-3cd0-943d-24b8b5810fbd",
                                "text": "Больше всего «лунотрясений» ― около 3000 в год ― зарегистрировано близ кратера Декарт, причём чаще всего они наблюдаются тогда, когда Луна находится в перигее и Земля вызывает самые значительные приливные силы в лунной коре."
                            }
                        ]
                    }
