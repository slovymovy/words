                                        "entry_id": "45dab199-4685-3692-a93c-2b512fa2916a",
                                        "glosses": [
                                            "een handwerktechniek, waarbij op kant lijkend weefsel wordt vervaardigd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dd9c1f6-1426-442c-bb77-926c64973604",
                                                "sense_id": "bd4a7363-3652-34df-b0bb-768d82a0345f",
                                                "text": "In de Haarstraat en op het plein bij winkelcentrum Hoge Wal gaat het om ambachtslieden die bezig zijn met het maken van glas-in- lood, glasgraveren, beeldhouwen, mosterd maken, Fries houtsnijwerk, vogelportretten en frivolité."
                                            },
                                            {
                                                "example_id": "03cd7dd2-567d-4cf2-8499-69d4817824b7",
                                                "sense_id": "bd4a7363-3652-34df-b0bb-768d82a0345f",
                                                "text": "Het Kijk- & Luistermuseum blijkt ’s middags open te zijn. Ik kom voor het luistergedeelte. De quilts en frivolité laat ik links hangen. Peuter van bijna twee is namelijk ook mee."
                                            },
                                            {
                                                "example_id": "73c86997-bbe2-4d5b-b2aa-3634ef4af444",
                                                "sense_id": "bd4a7363-3652-34df-b0bb-768d82a0345f",
                                                "text": "Verder zijn er onder andere workshops (kaart)weven, frivolité, macramé en hardanger, stokhaken en tunisch haken."
                                            }
                                        ]
                                    }
