                    },
                    {
                        "form_id": "ba69e8b9-9c13-4ecf-a010-5fdb88d7f5a2",
                        "entry_id": "95427c54-29c8-3077-81f1-ed4221be182b",
                        "tags": [
                            "masculine"
                        ],
                        "form": "entrepreneur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30aa83d1-ad09-324c-96d0-58a54ab53bb8",
                        "entry_id": "95427c54-29c8-3077-81f1-ed4221be182b",
                        "glosses": [
                            "Dirigeante d’une entreprise, cheffe d’entreprise."
                        ],
                        "tags": [
                            "Métier",
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "0048b6fa-a4fa-480c-b0ef-231c1922a8c3",
                                "sense_id": "30aa83d1-ad09-324c-96d0-58a54ab53bb8",
                                "text": "Quand Maurice aurait un peu d’argent, elle s’établirait entrepreneuse fleuriste. Elle aurait deux ouvrières qu’elle paierait vingt ou vingt-cinq sous par jour et qui lui gagneraient trois fois autant."
                            },
                            {
                                "example_id": "fe63284a-9c1e-4d81-8c41-92380e3e098a",
                                "sense_id": "30aa83d1-ad09-324c-96d0-58a54ab53bb8",
                                "text": "Pour ma part, je suis devenue entrepreneuse plus tôt que prévu. Je savais bien qu’un jour je créerais ma boîte."
                            },
                            {
                                "example_id": "b30c1768-60ca-421a-b73b-517047d49d06",
                                "sense_id": "30aa83d1-ad09-324c-96d0-58a54ab53bb8",
                                "text": "Anne-Sophie Goujet, finaliste du concours Créatrice d’avenir destiné aux femmes entrepreneuses pour la Seine-et-Marne, propose un service de bagagerie mobile nouvelle génération."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ce4c63b-213b-37d0-a6b5-a27f94dea48d",
                        "entry_id": "95427c54-29c8-3077-81f1-ed4221be182b",
                        "glosses": [
                            "Femme qui entreprend un travail de couture et qui emploie plusieurs ouvrières."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "29c6b674-066c-4737-a8ef-66c36a71312a",
                                "sense_id": "9ce4c63b-213b-37d0-a6b5-a27f94dea48d",
                                "text": "Et Denise s’en allait avec son argent, lorsqu’elle rencontra enfin Robineau. Il avait appris déjà le renvoi, il lui promit de retrouver l’entrepreneuse de cravates."
                            },
                            {
                                "example_id": "7402d81b-93f7-4258-92b6-b9825c53269c",
                                "sense_id": "9ce4c63b-213b-37d0-a6b5-a27f94dea48d",
                                "text": "Nous avons dit qu’à côté des couturiers et couturières, il fallait placer les entrepreneurs et entrepreneuses de confections."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1522807b-f28e-4965-bdb9-2d7b1e5d1ebd",
                        "source_entry_id": "95427c54-29c8-3077-81f1-ed4221be182b",
                        "source_sense_id": "30aa83d1-ad09-324c-96d0-58a54ab53bb8",
                        "source_sense_description": "dirigeante d’entreprise",
                        "target_lang_word": "Unternehmerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unternehmerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                        "entry_id": "d6210f63-c92d-3dfe-9bc9-842e179cc7cd",
                                        "glosses": [
                                            "weibliche Person, die Inhaberin oder Eigentümerin eines Unternehmens ist; Akteurin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980ec9db-925d-4bf0-989a-c8fe7f570a27",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Als Unternehmer beziehungsweise Unternehmerin bezeichnet man meist den Inhaber eines Unternehmens oder Betriebes, das von dieser Person ebenfalls eigenständig geführt wird.“"
                                            },
                                            {
                                                "example_id": "cae11f1a-1e85-4fa2-a4d9-6579560750b1",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Dorsten: Christel Heiming-Mechlinski ist die „Unternehmerin des Jahres 2013“ in Dorsten.“"
                                            },
                                            {
                                                "example_id": "608457d1-657e-4143-939e-95591d0eb77e",
                                                "sense_id": "aa3b9145-575d-3db7-a292-2838e5abbe08",
                                                "text": "„Was ich aber definitiv niemals werden wollte, ist Unternehmerin und Chefin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
