                                "target_lang_word": "decorate",
                                "target_lang_sense_clarification": "give a medal or award"
                            },
                            {
                                "target_lang_word": "award",
                                "target_lang_sense_clarification": "give a prize or honor"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "décorer",
                                "target_lang_sense_clarification": "attribuer un ordre ou une médaille"
                            },
                            {
                                "target_lang_word": "distinguer",
                                "target_lang_sense_clarification": "honorer d'une marque de distinction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77903807-2205-300d-9394-4dbeb4d7114a",
                    "sense_definition": "Zich op een positieve manier afscheiden van anderen door betere prestaties of eigenschappen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "excellence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De atleet wist zich te <w>onderscheiden</w> door een nieuw wereldrecord te vestigen.",
                            "target_lang_translations": {
                                "ru": "Атлет смог <w>выделиться</w>, установив новый мировой рекорд.",
                                "en": "The athlete managed to <w>distinguish</w> himself by setting a new world record.",
                                "fr": "L'athlète a su <w>se distinguer</w> en établissant un nouveau record du monde."
                            }
                        },
                        {
                            "text": "Dit bedrijf <w>onderscheidt</w> zich door zijn uitstekende klantenservice.",
                            "target_lang_translations": {
                                "ru": "Эта компания <w>выделяется</w> своим превосходным обслуживанием клиентов.",
                                "en": "This company <w>distinguishes</w> itself through its excellent customer service.",
                                "fr": "Cette entreprise <w>se distingue</w> par son excellent service client."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitblinken",
                        "excelleren",
                        "opvallen"
                    ],
                    "common_phrases": [
                        "zich onderscheiden door",
                        "zich positief onderscheiden"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделяться среди других положительным образом благодаря лучшим результатам или качествам.",
                        "en": "To separate oneself positively from others through better performance or qualities.",
                        "fr": "Se démarquer positivement des autres grâce à de meilleures performances ou qualités."
                    },
                    "translations": {
