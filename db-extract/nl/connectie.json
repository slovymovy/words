                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c030adf5-279e-49ca-b7fe-3e91a8aa73f8",
                                                "sense_id": "83e73811-cde1-37aa-a17d-7648fd365f92",
                                                "text": "The exact nature of the relations between the boy-wife and his protector are doubtful; they certainly have connection, but the natives repudiate with horror and disgust the idea of sodomy."
                                            },
                                            {
                                                "example_id": "65fc266d-03ee-4e55-b82b-271cb70b879c",
                                                "sense_id": "83e73811-cde1-37aa-a17d-7648fd365f92",
                                                "text": "At the town of Mendes, in the principal temple, there was a living male goat, with which, if the statement of Herodotus is to be accepted, naked female worshippers actually had carnal intercourse. Male worshippers similarly had connexion with she-goats."
                                            }
                                        ]
                                    },
