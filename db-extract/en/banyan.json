                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae30bfff-46ac-3faf-9918-6debb521a457",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "An Indian trader, merchant, cashier, or money changer."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "433016c5-e608-3898-a7e3-93bc151477e4",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "A tropical Indian fig tree, Ficus benghalensis, that has many aerial roots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43da00d-a74d-42ea-8fd3-ab30c6211b21",
                                "sense_id": "433016c5-e608-3898-a7e3-93bc151477e4",
                                "text": "We climb and then descend; we pass by the great banyan which, like Atlas, settling himself powerfully on his contorted haunches, seems awaiting with knee and shoulder the burden of the sky."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba330677-a0a6-36fc-936d-7a0ab6aa6d9b",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "Various other trees of the Ficus subgenus Urostigma, especially Ficus pertusa (Central American banyan) and Ficus microcarpa (Chinese banyan or Malayan banyan)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7a669bae-93fa-368c-9e38-32919d845354",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "A type of loose gown worn in India."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8b634584-1e16-3595-9c97-c871a988bea2",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "A vest; an undershirt; a singlet."
                        ],
                        "tags": [
                            "India",
                            "Pakistan"
                        ],
                        "examples": [
                            {
                                "example_id": "b501ec56-4e8f-4125-bc84-8330fd161447",
                                "sense_id": "8b634584-1e16-3595-9c97-c871a988bea2",
                                "text": "It was an honest letter, written by an honest man, then stewing in the Plains on two hundred rupees a month (for he allowed his wife eight hundred and fifty), and in a silk banian and cotton trousers."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c4fe3f5-1840-361e-a340-b0a33a9fd822",
                        "entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "glosses": [
                            "A camping excursion on shore, to give a ship's crew a break from shipboard routine."
                        ],
                        "tags": [
                            "British",
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8d21a21-df50-4691-a714-35bb33a5d3b4",
                        "source_entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "source_sense_description": "Indian trader, merchant",
                        "target_lang_word": "commerçant indien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2044402d-d6a9-406f-a3ca-df65cb35e929",
                        "source_entry_id": "229848b6-c794-37c6-842d-2437540a1143",
                        "source_sense_description": "Indian trader, merchant",
                        "target_lang_word": "banian",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banian",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63d1c06d-e5e8-3030-b3ff-af54ed4414ae",
                                        "entry_id": "07fd1ca1-e32b-321c-80f0-7573b825619d",
                                        "glosses": [
                                            "Habitant de l’Inde, de religion brahmanique et s’adonnant au commerce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "banian",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                        "entry_id": "a611d0d9-095b-3d97-829c-56c09d8af4f8",
                                        "glosses": [
                                            "Arbre appartenant au genre Ficus de la famille des Moraceae, espèce voisine du figuier qui peut se développer en arbres géants pouvant couvrir plusieurs hectares."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337dd317-2ffb-4b5b-b22a-0c848c3fd67b",
                                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                                "text": "J’ai appris un jour de février 1962, par une lettre d’un de mes frères, que le vieux banian de notre hameau natal vient d’être abattu, sacrifié pour élargir la route d’accès au village."
                                            },
                                            {
                                                "example_id": "187e64e8-7814-4936-badb-f0ea93cf3371",
                                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                                "text": "Je regarde le grand banian devant nous, arbre majestueux et sacré qui étale ses branches comme une immense araignée."
                                            },
                                            {
                                                "example_id": "47420b50-2a09-4e00-a9d2-1c9a1bb285ff",
                                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                                "text": "Il désigna un banian haut comme une cathédrale, non loin du village, dont les énormes racines s’insinuaient dans le sol, pareilles aux doigts fouineurs d’un géant."
                                            },
                                            {
                                                "example_id": "e9d6ea5d-668f-4132-9bae-7e251148b74a",
                                                "sense_id": "122d7a52-a25f-3e86-86df-c2b10347114a",
                                                "text": "Un figuier des Banians, développé dans des proportions gigantesques, étend son ombre triste sur la case royale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
