                        "glosses": [
                            "een stemming die helemaal gedomineerd wordt door ziekte en medische behandeling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4ca83ab-0405-4473-8339-529d8db0a7e2",
                                "sense_id": "c729e4f1-9740-34f2-85a8-d4129deeccf4",
                                "text": "Van der Toorn is inmiddels weer begonnen met zijn tv-werk. „Anders blijf je zo hangen in de ziekenhuissfeer.”"
                            },
                            {
                                "example_id": "ec600e4a-4ee4-4198-b5dc-20f68a9d4e8b",
                                "sense_id": "c729e4f1-9740-34f2-85a8-d4129deeccf4",
                                "text": "In het UMC St Radboud Ziekenhuis in Nijmegen krijgen jongeren met kanker hun eigen hangplek. Tijdens hun opname in het ziekenhuis kunnen de zieke jongeren hier in contact komen met leeftijds- en lotgenoten. Het Nijmeegse ziekenhuis maakte dat dinsdag bekend. De hangplek is een kamer waar volgens een woordvoerster „geen ziekenhuissfeer” hangt."
                            },
                            {
                                "example_id": "5affefde-8300-4830-9918-2ca196bc8fda",
                                "sense_id": "c729e4f1-9740-34f2-85a8-d4129deeccf4",
                                "text": "Enkel in de ondergrondse galerijen en in een voormalige ziekenzaal proef je iets van een ziekenhuissfeer. Eigenlijk past de nieuwe functie, van museum en cultureel centrum, veel beter, maar de historie zorgt wel voor een extra en bijzondere dimensie."
                            }
                        ]
                    }
