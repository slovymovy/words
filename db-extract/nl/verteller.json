                    },
                    {
                        "sense_id": "c4e90548-9214-304f-a05f-36b04f08cbeb",
                        "entry_id": "fc97e183-1b17-3a23-830e-f2368e9aa209",
                        "glosses": [
                            "in een verhaal diegene die vertelt welke gebeurtenissen er plaatsvinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056d4385-0b0a-47b7-a97f-8a30c69b1604",
                                "sense_id": "c4e90548-9214-304f-a05f-36b04f08cbeb",
                                "text": "Tijdens het toneelstuk praatte de verteller de delen van het verhaal aan elkaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35982154-d23b-4092-9a4c-55ca180c2e3c",
                        "source_entry_id": "fc97e183-1b17-3a23-830e-f2368e9aa209",
                        "source_sense_id": "847efd5a-4f83-30bd-9c0e-ab52791959ec",
                        "source_sense_description": "een persoon die vertelt",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
