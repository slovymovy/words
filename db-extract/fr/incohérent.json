                    {
                        "form_id": "3cfe4ce4-0d1e-40e1-a276-81df5ca596a9",
                        "entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "incohérentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                        "entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                        "glosses": [
                            "Qui manque de cohérence, de suite, de liaison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f675826e-5d7a-4e3b-8e11-d2e5f60ec475",
                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                "text": "Couches de terrains incohérentes."
                            },
                            {
                                "example_id": "51be1f82-98fa-43e6-be31-24c3f1ba6d9d",
                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                "text": "Langage incohérent."
                            },
                            {
                                "example_id": "eff6d5d8-a523-45d6-ad7a-ffb09a0a43c0",
                                "sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                                "text": "Figures, images incohérentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                        "entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                        "glosses": [
                            "Qui manque de logique, de réflexion ou de rationalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a676a5-1154-410f-9099-816cec24f954",
                                "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                                "text": "Paris m’étonna. Il me fit l’effet d’un grand bruit et d’une grande folie. Les individus et les foules passaient bizarres, incohérents, effrénés, se hâtant vers des besognes que je me figurais terribles et monstrueuses."
                            },
                            {
                                "example_id": "efb32952-e006-40ff-8868-eef990c3da8c",
                                "sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                                "text": "C’était une réponse si incohérente qu’il faisait ainsi, que maître Faramont n’en comprenait presque pas le sens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae333d26-bf30-473b-8c50-fa1de459c2f2",
                        "source_entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                        "source_sense_id": "950b2376-4e9c-3c25-9f3f-98f0799b0951",
                        "source_sense_description": "Qui manque de cohérence, de suite, de liaison.",
                        "target_lang_word": "inconsistent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not compatible (with another thing); incompatible, discrepant, at odds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd955f6-055f-43c2-adfd-47a929f3be83",
                                                "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                                "text": "His account of the evening was inconsistent with the security-camera footage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Lacking internal consistency; self-contradicting; not compatible with itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68288e3-2718-4293-831b-9d794488dfb2",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He gave an inconsistent account of the evening, saying he called her before eight, but later that he had not talked to her until after nine."
                                            },
                                            {
                                                "example_id": "a82d5d89-c95d-435b-a52f-f80ae0041149",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He was one of those men of inconsistent politics, governed at once by prejudice and sympathies, whose 'attitude' it is impossible to foretell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not consistent or coherent in thought or behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57db2e6-84a7-41be-9523-6577263c28f2",
                                                "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                                "text": "“Take him for better or worse,” added Mr. Lee, “and I think he is the strangest and most inconsistent man I ever saw.”\n“Inconsistent!” resumed Mr. Jones. “He is worse than inconsistent. Inconsistencies may be pardoned as constitutional defects [...]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1c154f-537b-3dd9-91cc-ff4e98fb6f5e",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Having the property that a contradiction can be derived."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a806de7-6125-4037-9da5-5a098de38b23",
                        "source_entry_id": "ff095faa-a658-3ba3-8b9f-35710af7e2cd",
                        "source_sense_id": "844c4c57-7cc6-30e9-a9ef-47726c1566d5",
                        "source_sense_description": "Qui manque de logique, de réflexion ou de rationalité.",
                        "target_lang_word": "incoherent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incoherent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                        "entry_id": "5e8ecc27-79f5-34aa-8c96-4ac3c41c3d3f",
                                        "glosses": [
                                            "Not coherent.",
                                            "Not making logical sense; not logically connected or consistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f063486d-d239-4b5a-a920-6db54068e510",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "When we confronted her, she gave us a hasty, incoherent explanation."
                                            },
                                            {
                                                "example_id": "3b30c045-68aa-44d7-9db5-1acc1e48cd6e",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "After just a few drinks, he becomes incoherent."
                                            },
                                            {
                                                "example_id": "146391a2-713f-4d3a-ba0e-f8db34cd151a",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "By which thus still ouermuch busying your selfe in matters passing your skill, it maketh you so forgetfull, that oftentimes you are faine to vtter matters incoherent, and much contradictorie."
                                            },
                                            {
                                                "example_id": "89edb1a4-15c9-4809-af6f-f5b5a37053d1",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "1765, William Warburton, The Divine Legation of Moses, London: A. Millar and J. and R. Tonson, 4th edition, Volume 3, Book 4, Section 4, p. 103, note z,\n[…] this historian of men and manners goes on in the same rambling incoherent manner […]"
                                            },
                                            {
                                                "example_id": "6d3475cb-0b30-4dfb-bccc-bcccc4e363b3",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "[…] the big dark dining table twinkled here and there in the small candle-light; the pictures on the wall, all of them very brown, looked vague and incoherent."
                                            },
                                            {
                                                "example_id": "6beba12c-e3d0-497a-b7b9-319819f07b54",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "It was as if he was in fear of being swamped, rendered incoherent, by the sheer marvelousness of what he was relating."
                                            },
                                            {
                                                "example_id": "de055e21-0243-4f4c-893f-fec91d01b7b1",
                                                "sense_id": "9766c83d-2dc9-34f3-9d92-5752c23bb6ed",
                                                "text": "The historian […] is a sort of novelist, but one who instead of inventing plot and character is obliged to discover them; who instead of setting characters in motion against one another with foreknowledge of their natures and destinies tries to guess at what often incoherent characters were up to amid a distraction of lies and suppressions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5213cf6b-7423-3f83-9ac6-d4492c8204f8",
                                        "entry_id": "5e8ecc27-79f5-34aa-8c96-4ac3c41c3d3f",
                                        "glosses": [
                                            "Not coherent.",
                                            "Not holding together physically; loose; unconnected."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7af869b-87cb-4d9f-8da7-3c721ac917ec",
                                                "sense_id": "5213cf6b-7423-3f83-9ac6-d4492c8204f8",
                                                "text": "[…] Some hasty and undigested Thoughts, on a Subject I had never before considered, which I set down against our next Meeting, gave the first entrance into this Discourse, which having been thus begun by Chance, was continued by Intreaty; written by incoherent parcels; and, after long intervals of neglect, resum'd again, as my Humour or Occasions permitted; and at last, in a retirement, where an Attendence on my Health gave me leisure, it was brought into that order thou now seest it."
                                            },
                                            {
                                                "example_id": "40bbc415-d574-48f7-a39c-9d9a679de006",
                                                "sense_id": "5213cf6b-7423-3f83-9ac6-d4492c8204f8",
                                                "text": "That Sand-Stone does not still consolidate: i.e. that Matter which was, a few Years ago, lax, incoherent, and in form of Earth, or of Sand, does not become daily more hard and consistent, and by little and little acquire a perfect Solidity, and so turn to Stone; as others have asserted."
                                            },
                                            {
                                                "example_id": "e7291f55-7da0-4d97-a557-ab6d16a27f9d",
                                                "sense_id": "5213cf6b-7423-3f83-9ac6-d4492c8204f8",
                                                "text": "[…] sooner, may all the Material World crumble into Incoherent Atoms, or relapse into the Abyss of Nothingness, than that any Conclusion, thus deduced, can be False […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "533a0715-eade-31ea-8e5e-7b8b6fa204f1",
                                        "entry_id": "5e8ecc27-79f5-34aa-8c96-4ac3c41c3d3f",
                                        "glosses": [
                                            "Not coherent.",
                                            "Not cohering socially, not united."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb735aa-e103-46a5-86a0-c92c6c677fa9",
                                                "sense_id": "533a0715-eade-31ea-8e5e-7b8b6fa204f1",
                                                "text": "At this stage the labourers still form an incoherent mass scattered over the whole country, and broken up by their mutual competition."
                                            },
                                            {
                                                "example_id": "bffbee26-d246-4362-b06a-410a8444da1f",
                                                "sense_id": "533a0715-eade-31ea-8e5e-7b8b6fa204f1",
                                                "text": "[…] because I am an American writer my subject and my material inevitably has to be a handful of incoherent people in an incoherent country."
                                            },
                                            {
                                                "example_id": "fa5d12dd-0c02-4b24-ad1c-4ec7fb1bc17a",
                                                "sense_id": "533a0715-eade-31ea-8e5e-7b8b6fa204f1",
                                                "text": "I was glad, now, to be out of Karhide, an incoherent land driven towards violence by a paranoid, pregnant king and an egomaniac Regent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
