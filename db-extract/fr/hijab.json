                    }
                ],
                "senses": [
                    {
                        "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                        "entry_id": "9fdada4a-4bf9-3802-9198-7e7f70bbb4ee",
                        "glosses": [
                            "Vêtement que les femmes musulmanes portent, qui cache selon les diverses traditions nationales tout ou partie de leur tête, notamment les cheveux, leur cou, et parfois estompe les formes de leur corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d81774e-de54-431c-818e-c21a76bd4066",
                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                "text": "Hedjab (ou hijab). Tenue islamique correcte, littéralement « celui qui empêche de voir ». À l’origine toute chose (tissu, enceinte, paravent) qui cache, qui empêche de voir, qui fait barrière en rendant impossible le contact entre deux choses."
                            },
                            {
                                "example_id": "14d6bfc0-e540-489c-ad74-3c279d62d292",
                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                "text": "Si le hijab n’a pas de signification religieuse, s’il n’est que « décoratif », pourquoi ce refus obstiné de l’enlever pendant quelques heures ?"
                            },
                            {
                                "example_id": "872ba4a2-999c-43fd-ba2a-f3feb60491e0",
                                "sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                                "text": "Il faisait valoir que «le respect ne doit pas altérer le fait que le hijab, le niqab et la burka sont aussi des instruments d’oppression pour des millions de filles et de femmes dans le monde qui n’ont pas la possibilité de faire un choix»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f2cd5ed-0ca2-438c-b145-6f6590dc87dd",
                        "source_entry_id": "9fdada4a-4bf9-3802-9198-7e7f70bbb4ee",
                        "source_sense_id": "94280339-9623-3dd3-9048-49b14928a68c",
                        "target_lang_word": "Hidschab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hidschab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "723c44e8-c305-3d47-afc8-6a46d5d11c87",
                                        "entry_id": "0a039b91-2f8a-30dd-818a-10784ee3fa3c",
                                        "glosses": [
                                            "Gebot der Abschirmung"
                                        ],
                                        "tags": [
                                            "general",
                                            "neuter",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d9bece4-fa79-4926-b1b9-1eb2e23597d2",
                                                "sense_id": "723c44e8-c305-3d47-afc8-6a46d5d11c87",
                                                "text": "Ursprünglich betraf das Hidschab lediglich die Ehefrauen des Propheten Mohammeds."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7133d429-841c-346e-874b-338d1702a97d",
                                        "entry_id": "0a039b91-2f8a-30dd-818a-10784ee3fa3c",
                                        "glosses": [
                                            "jedes Kleidungsstück, das dazu dient [1] zu erfüllen"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73c26c0e-1e73-4ce3-a554-e5af5b6a4076",
                                                "sense_id": "7133d429-841c-346e-874b-338d1702a97d",
                                                "text": "Viele sehr verschiedene Kleidungsstücke werden als Hidschab bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bcdfebf0-33dc-3fb6-896f-81eacab85ede",
                                        "entry_id": "0a039b91-2f8a-30dd-818a-10784ee3fa3c",
                                        "glosses": [
                                            "Kopftuch"
                                        ],
                                        "tags": [
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7c8a19-e0d5-4cd0-8f27-e185e1909478",
                                                "sense_id": "bcdfebf0-33dc-3fb6-896f-81eacab85ede",
                                                "text": "Der Hidschab wird überall auf der Welt von praktizierenden Muslimas getragen."
                                            },
                                            {
                                                "example_id": "a662c34b-2204-4a1e-9bfc-eac97f57aeec",
                                                "sense_id": "bcdfebf0-33dc-3fb6-896f-81eacab85ede",
                                                "text": "„Am 21. April 1945 erreichte die Rote Armee Berlin-Buch. Anna konnte den Hidschab ablegen und sich erstmals wieder offen in das jüdische Mädchen zurückverwandeln, das sie war, ohne um ihr Leben fürchten zu müssen; ein jüdisches Mädchen, das sein Überleben Muslimen verdankte.“"
                                            },
                                            {
                                                "example_id": "0d7c9ca9-5b08-46b2-a9a7-8a68b19955cd",
                                                "sense_id": "bcdfebf0-33dc-3fb6-896f-81eacab85ede",
                                                "text": "„Abaya und Hidschab, der Kopf und Körper bedeckende Schleier, finden in den letzten Jahren immer mehr Verbreitung in Pakistan, werden aber von vielen auch als Importe aus dem Ausland wahrgenommen, die wieder verschwinden sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd2142a-9f2c-47fa-97c2-e0d643d48ad3",
                        "source_entry_id": "9fdada4a-4bf9-3802-9198-7e7f70bbb4ee",
