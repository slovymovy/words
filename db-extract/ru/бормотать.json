                                "target_senses": [
                                    {
                                        "sense_id": "aae2e8a3-17a6-3d28-ad19-f7f50eb81e26",
                                        "entry_id": "5156ae3a-ce89-3705-8c7a-a3c56c49e6e2",
                                        "glosses": [
                                            "To speak unintelligibly or inaudibly; to fail to articulate."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62c8ed5b-1e6e-4715-942a-c788a45c6e1c",
                                                "sense_id": "aae2e8a3-17a6-3d28-ad19-f7f50eb81e26",
                                                "text": "Please try not to mumble so I can hear you better."
                                            },
                                            {
                                                "example_id": "a6934433-6ca1-43cd-aa70-42994f814c53",
                                                "sense_id": "aae2e8a3-17a6-3d28-ad19-f7f50eb81e26",
                                                "text": "Peace, you mumbling fool."
                                            },
                                            {
                                                "example_id": "8e759e2d-a85d-4fce-a11a-f8bed4855c7f",
                                                "sense_id": "aae2e8a3-17a6-3d28-ad19-f7f50eb81e26",
                                                "text": "A wrinkled hag, with age grown double, / Picking dry sticks, and mumbling to herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ad40112-eca0-3f60-81b0-2558ade02ec3",
                                        "entry_id": "5156ae3a-ce89-3705-8c7a-a3c56c49e6e2",
                                        "glosses": [
                                            "To chew something gently with closed lips."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
