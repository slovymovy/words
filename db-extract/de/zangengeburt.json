                "senses": [
                    {
                        "sense_id": "d6924611-e857-342a-a13f-4cab7180c3f9",
                        "entry_id": "c3c62e7a-4a4c-36e6-8def-4049c2841707",
                        "glosses": [
                            "Geburt mit Hilfe einer Geburtszange"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "755937d9-95f4-4711-bede-77922a6a8cfb",
                                "sense_id": "d6924611-e857-342a-a13f-4cab7180c3f9",
                                "text": "„Die Ärzte entschlossen sich zu einer Zangengeburt, doch als das Kind auf der Welt war, war es bereits tot.“"
                            },
                            {
                                "example_id": "ff576817-d68c-472e-bd03-916ff79593f9",
                                "sense_id": "d6924611-e857-342a-a13f-4cab7180c3f9",
                                "text": "„Ein junger Gynäkologe, Assistent von Geheimrat K., führt am Phantom seine erste Zangengeburt durch.“"
                            },
                            {
                                "example_id": "5dea1aae-f003-45bf-9fac-8980bae73be9",
                                "sense_id": "d6924611-e857-342a-a13f-4cab7180c3f9",
                                "text": "„Ein Medizinstudent soll im gynäkologischen Praktikum an einer Puppe eine Zangengeburt demonstrieren.“"
                            },
                            {
                                "example_id": "73dd2349-0017-429e-b501-e9634ac7ba4f",
                                "sense_id": "d6924611-e857-342a-a13f-4cab7180c3f9",
                                "text": "„Man hört das schrille Gequieke von Kindern mit bleichen Gesichtern und knochigen Gliedern, kleinen Bälgern, denen man die Zangengeburt ansieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
