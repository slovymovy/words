                ],
                "senses": [
                    {
                        "sense_id": "72d5be1b-d623-3fb2-aeaa-e9abce58e4da",
                        "entry_id": "7c97ab2a-fa97-346d-ade1-9b35468d832a",
                        "glosses": [
                            "Décliner toute responsabilité, refuser toute intervention."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "bd701450-901c-4768-8eea-33c8aaee4309",
                                "sense_id": "72d5be1b-d623-3fb2-aeaa-e9abce58e4da",
                                "text": "Maintenant, si vous ratez le coche et si vous vous contentez de prendre pour plaisanterie les idées qu’on se donne la peine d’avoir pour vous, je me ponce-pilate les phalanges. Autrement dit : je m’en fous !"
                            },
                            {
                                "example_id": "8ef403cb-436d-4f67-a76b-7cb3439641b5",
                                "sense_id": "72d5be1b-d623-3fb2-aeaa-e9abce58e4da",
                                "text": "Est-ce inconscience, insouciance de l’étrange image que M. le Maire donne lui-même de sa fonction en se ponce-pilatant de problèmes qu’il crée de toutes pièces ?"
                            }
                        ]
                    }
