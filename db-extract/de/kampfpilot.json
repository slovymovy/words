                                "sense_id": "56482758-35f6-3bcb-9184-14278afb7b07",
                                "text": "„Für die Mission wurde der 42-jährige Kampfpilot Zhai Zhigang ausgewählt, wie die Regierung in Peking am Dienstag mitteilte.“"
                            },
                            {
                                "example_id": "b846f225-0b1d-4fba-931e-782de351c1be",
                                "sense_id": "56482758-35f6-3bcb-9184-14278afb7b07",
                                "text": "„James Salter war Kampfpilot der US Air Force, bevor er Schriftsteller wurde.“"
                            }
