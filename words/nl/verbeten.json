{
    "word_family": [
        "verbijten",
        "verbetenheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bf0cc34e-352e-3989-8b9b-43cc42172bb8",
                    "sense_definition": "Fanatiek, hardnekkig en met een grote, soms grimmige inspanning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fanatiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wielrenner deed een <w>verbeten</w> poging om de koploper in te halen.",
                            "target_lang_translations": {
                                "en": "The cyclist made a <w>dogged</w> attempt to catch up with the leader."
                            }
                        },
                        {
                            "text": "Na urenlang proberen deed hij nog een laatste <w>verbeten</w> poging om het probleem op te lossen.",
                            "target_lang_translations": {
                                "en": "After trying for hours, he made one last <w>determined</w> attempt to solve the problem."
                            }
                        }
                    ],
                    "synonyms": [
                        "hardnekkig",
                        "fanatiek",
                        "grimmig",
                        "vastberaden"
                    ],
                    "antonyms": [
                        "laconiek",
                        "onverschillig"
                    ],
                    "common_phrases": [
                        "verbeten poging",
                        "verbeten strijd",
                        "verbeten gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "Fanatical, stubborn, and with a great, sometimes grim effort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dogged",
                                "target_lang_sense_clarification": "stubbornly persevering"
                            },
                            {
                                "target_lang_word": "grim",
                                "target_lang_sense_clarification": "fierce and unyielding"
                            },
                            {
                                "target_lang_word": "determined",
                                "target_lang_sense_clarification": "resolute and persistent"
                            },
                            {
                                "target_lang_word": "fierce",
                                "target_lang_sense_clarification": "intense and fanatical"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70e19f91-5222-3162-bb70-ad2ffa2c4983",
                    "sense_definition": "Met moeite ingehouden of onderdrukt, zoals woede of pijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ingehouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met <w>verbeten</w> woede hoorde hij de onterechte beschuldigingen aan.",
                            "target_lang_translations": {
                                "en": "With <w>suppressed</w> anger, he listened to the unjust accusations."
                            }
                        },
                        {
                            "text": "Zij uitte haar frustratie met een <w>verbeten</w> lachje.",
                            "target_lang_translations": {
                                "en": "She expressed her frustration with a <w>grim</w> smile."
                            }
                        }
                    ],
                    "synonyms": [
                        "ingehouden",
                        "onderdrukt"
                    ],
                    "antonyms": [
                        "ongecontroleerd",
                        "vrij"
                    ],
                    "common_phrases": [
                        "verbeten woede",
                        "verbeten pijn"
                    ],
                    "target_lang_definitions": {
                        "en": "With difficulty restrained or suppressed, such as anger or pain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suppressed",
                                "target_lang_sense_clarification": "held back or restrained"
                            },
                            {
                                "target_lang_word": "grim",
                                "target_lang_sense_clarification": "harshly restrained, of a smile or expression"
                            },
                            {
                                "target_lang_word": "pent-up",
                                "target_lang_sense_clarification": "closely confined or held back"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "03499aa8-6409-329d-a0ea-92196117c930",
                    "sense_definition": "Voltooid deelwoord van <w>verbijten</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbijten_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft zijn pijn dapper <w>verbeten</w> tijdens de behandeling.",
                            "target_lang_translations": {
                                "en": "He bravely <w>suppressed</w> his pain during the treatment."
                            }
                        },
                        {
                            "text": "Zij heeft haar eerste woede <w>verbeten</w> voor ze rustig reageerde.",
                            "target_lang_translations": {
                                "en": "She <w>bit back</w> her initial anger before responding calmly."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "voltooid deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of verbijten (to suppress, to bite back)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suppressed",
                                "target_lang_sense_clarification": "held back, of emotions or pain"
                            },
                            {
                                "target_lang_word": "bitten back",
                                "target_lang_sense_clarification": "repressed, of anger or words"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f9084f-0731-3b63-9071-e1325fd7ed16",
                    "sense_definition": "Meervoud verleden tijd van <w>verbijten</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbijten_vormen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>verbeten</w> onze woede en zeiden er verder niets van.",
                            "target_lang_translations": {
                                "en": "We <w>suppressed</w> our anger and said nothing more about it."
                            }
                        },
                        {
                            "text": "Zij <w>verbeten</w> hun lachen toen de leraar een fout maakte.",
                            "target_lang_translations": {
                                "en": "They <w>stifled</w> their laughter when the teacher made a mistake."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past plural of verbijten (to suppress, to bite back)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suppressed",
                                "target_lang_sense_clarification": "held back, of emotions"
                            },
                            {
                                "target_lang_word": "stifled",
                                "target_lang_sense_clarification": "smothered or suppressed, of laughter or yawns"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}