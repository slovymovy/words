                    {
                        "sense_id": "21a75570-990c-3c8b-95bf-a5748e103f49",
                        "entry_id": "fa49d404-d787-3024-ba5b-42053bc43f26",
                        "glosses": [
                            "Assistance publique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5049d732-9762-4816-91d4-9740d4ade8d1",
                                "sense_id": "21a75570-990c-3c8b-95bf-a5748e103f49",
                                "text": "Nos invités : Dr Catherine Simon (psychiatre, CHRU/Brest, vice-présidente/ANPAA), Dr Michel Jacq psychiatre, médecin-chef/centre Gilbert-Raby), Stéphanie Torremocha (psychologue/CH4V) et notre ami le docteur Éric Hispard (hôpital Fernand-Vidal, CSAPA Cap 14, président collégiale alcoologie de l’AP, administrateur SFA)."
                            },
                            {
                                "example_id": "e5b1ad37-1a52-4260-995c-d856879d5453",
                                "sense_id": "21a75570-990c-3c8b-95bf-a5748e103f49",
                                "text": "François Crémieux, le défi du maintien de l’AP."
                            },
                            {
                                "example_id": "cf4cb03d-0e27-44b4-bbf5-c4db00d5ad2d",
                                "sense_id": "21a75570-990c-3c8b-95bf-a5748e103f49",
                                "text": "Liste pour la vêture d’une fille de l'assistance publique de 6 ans édité par le Magasins des Vêtures de l’AP"
                            }
                        ]
                    }
                ],
