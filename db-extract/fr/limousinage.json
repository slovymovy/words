                "senses": [
                    {
                        "sense_id": "abf49634-16d9-3870-885e-d5b5597ac092",
                        "entry_id": "817022f3-8222-38a6-b03c-a24bebc5451c",
                        "glosses": [
                            "Ouvrage de maçonnerie fait avec des moellons et du mortier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b117b1c-a580-4224-8fc4-8b444887fa91",
                                "sense_id": "abf49634-16d9-3870-885e-d5b5597ac092",
                                "text": "La deuxième sous-espèce de maçonnerie moderne de moellon, c'est le limousinage ou smillage. Elle ne diffère de la précédente , qu'en ce que les moellons, au lieu d'être taillés, sont employés presque bruts, et qu'on ne s'assujettit pas à avoir des hauteur d'assises égales."
                            },
                            {
                                "example_id": "c960cee2-c1c0-4808-9731-55719b3d704d",
                                "sense_id": "abf49634-16d9-3870-885e-d5b5597ac092",
                                "text": "Ce sont nos pères, fiston, qui ont inventé le limousinage. C’est pour ça que, partout, on attend le limousinant."
                            }
                        ]
                    }
                ],
