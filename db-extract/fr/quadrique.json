                "forms": [
                    {
                        "form_id": "591574c7-25aa-472b-af91-2a0d954cf825",
                        "entry_id": "4f28012e-c021-3e0b-873a-7a4485c3b121",
                        "tags": [
                            "plural"
                        ],
                        "form": "quadriques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45edf503-e299-314e-81d1-f19ede35544f",
                        "entry_id": "4f28012e-c021-3e0b-873a-7a4485c3b121",
                        "glosses": [
                            "Surface dont les points sont définis, dans un espace affine euclidien, par une équation du second degré portant sur leurs coordonnées"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e7c762-c67e-404b-946a-9a2d19b032af",
                                "sense_id": "45edf503-e299-314e-81d1-f19ede35544f",
                                "text": "Le paraboloïde hyperbolique est une quadrique réglée"
                            },
                            {
                                "example_id": "269beff0-16a1-4094-a688-a7280bb7d2a7",
                                "sense_id": "45edf503-e299-314e-81d1-f19ede35544f",
                                "text": "Les quadriques sont aux surfaces ce que les coniques sont aux courbes planes."
                            },
                            {
                                "example_id": "d18bbde6-62ad-45ed-933b-7a1b38458e40",
                                "sense_id": "45edf503-e299-314e-81d1-f19ede35544f",
                                "text": "l’intersection d'une quadrique et d'un plan est une conique"
                            },
                            {
                                "example_id": "7d4cbafa-613d-4784-b865-89c86e1fc8e0",
                                "sense_id": "45edf503-e299-314e-81d1-f19ede35544f",
                                "text": "Voilà donc établi, par la rencontre de la géométrie et du calcul différentiel, un système « triple orthogonal », comme celui constitué par exemple des trois quadriques, en ellipsoïde, un hyperboloïde à une nappe et un à deux nappes, qui passent par chaque point de l’espace et sont orthogonales deux à deux."
                            }
                        ]
                    }
                ],
