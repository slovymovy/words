                "senses": [
                    {
                        "sense_id": "4fb7da78-bb76-3c04-b73e-7428edc3726c",
                        "entry_id": "76029968-c09c-386f-9e20-626b5c9fb889",
                        "glosses": [
                            "Remettre quelque chose qui avait été concassé dans son état antérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66e0f95e-7a05-40ff-8d6b-a00a9c414e8c",
                                "sense_id": "4fb7da78-bb76-3c04-b73e-7428edc3726c",
                                "text": "Comment l’injonction faite au Domaine de La Vougeraie de remettre la parcelle en l’état peut-elle être exécutée? Peut-on déconcasser un sol?"
                            },
                            {
                                "example_id": "0e18264c-18b6-4aaa-98c2-610608cf8c34",
                                "sense_id": "4fb7da78-bb76-3c04-b73e-7428edc3726c",
                                "text": "Afin d'éviter les abus de stockage, ce fragment ne pourrait être \"déconcassé\" que dans un autre coffre et aurait une durée de quelques heures comme les certificats de dindon."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee00c15f-7729-3a0f-b7de-50eed3899875",
                        "entry_id": "76029968-c09c-386f-9e20-626b5c9fb889",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc022fc2-0d25-4d84-a905-1c0b232f4cb3",
                                "sense_id": "ee00c15f-7729-3a0f-b7de-50eed3899875",
                                "text": "• plantations : 15 kg de topinambours déterrés, butte déconcassée, plantation de moutarde, ail, amandes et topinambours à fleurs."
                            },
                            {
                                "example_id": "1c228739-8430-4c6c-a9c3-5af4d749d3a3",
                                "sense_id": "ee00c15f-7729-3a0f-b7de-50eed3899875",
                                "text": "ce n'est pas du travail, si vous avez passé le motoculteur, je devrais voir que de la terre déconcassée, avec plus ou moins de la caillasse..."
                            },
                            {
                                "example_id": "676f696d-498d-4012-9ffa-3cf92f18905e",
                                "sense_id": "ee00c15f-7729-3a0f-b7de-50eed3899875",
                                "text": "Et quand elle a les joues aux genoux et que sa bouche est pleine d’écume de cailloux gris, je suis déconcassée, grevée."
                            }
                        ]
                    }
