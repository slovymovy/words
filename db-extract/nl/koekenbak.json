                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f320b905-4a0e-4663-95fb-bc979c7de9eb",
                                "sense_id": "f877f1b6-2977-34c8-923c-01c463556d11",
                                "text": "⧖ Wat heeft Vader ons verrascht met zijn thuiskomst. Daar zaten wij een Zondag lekkertjes koekenbak te eeten en daar was het: „Wie komt daar aan?\" — „Wel het is Vader\", zeide Annaleen. Een ander zei: „Neen, dat kan niet. Vader was „een Vrijdag nog in Brussel\". Maar tog het was Vader."
                            }
                        ]
                    }
