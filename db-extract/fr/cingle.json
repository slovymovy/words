                "senses": [
                    {
                        "sense_id": "df9cff96-13ff-36ee-9690-9e3767376b24",
                        "entry_id": "ff080279-2c68-316f-8721-92018213d7fb",
                        "glosses": [
                            "Sinuosité, méandre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc0af0e-203e-4609-91b9-f1546cae668c",
                                "sense_id": "df9cff96-13ff-36ee-9690-9e3767376b24",
                                "text": "Le site est très beau : des montagnes boisées de végétation alpine entourent le plateau, et une rivière fait un cingle autour de la ville."
                            },
                            {
                                "example_id": "bd1296b4-0a41-4121-930a-091ab257309b",
                                "sense_id": "df9cff96-13ff-36ee-9690-9e3767376b24",
                                "text": "Mais il y avait de quoi être impressionné par la vallée et les méandres de la rivière qui me rappelaient les cingles de la Dordogne."
                            }
                        ]
                    }
                ],
