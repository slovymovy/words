                        ],
                        "form": "politiebureautjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                        "entry_id": "357321a9-e769-3447-ae70-04b9f222c237",
                        "glosses": [
                            "een gebouw van waaruit de politie haar activiteiten ontplooit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58acd0e0-657a-4d38-851c-bfd51bb4af5f",
                                "sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                                "text": "Eerder zei de politie Amsterdam dat de melding van Nathalie de enige was. Na nieuw contact bevestigt de politie nu dat er \"een handvol meldingen\" bekend zijn. Meer politiebureaus bevestigen dat het probleem mogelijk groter is dan nu bekend."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fc746f8-472c-4b63-abe8-a85b85972aad",
                        "source_entry_id": "357321a9-e769-3447-ae70-04b9f222c237",
                        "source_sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                        "target_lang_word": "Polizeiwache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizeiwache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                        "entry_id": "e2b31877-ddfb-3b13-a80c-a80dd4cb97c0",
                                        "glosses": [
                                            "ein Gebäude oder die Diensträume in einem Gebäude, die von einer Abteilung der Polizei genutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "427e8d8e-43a2-4896-aa2f-6f731e1da86c",
                                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                                "text": "Die Beamten brachten den betrunkenen Jugendlichen auf die Polizeiwache."
                                            },
                                            {
                                                "example_id": "125a973a-2862-4d3e-a272-1f3f88e667e0",
                                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                                "text": "„Die Mau-Mau-Krieger stürmen Polizeiwachen und Gefängnisse, erschießen weiße Siedlerfamilien.“"
                                            },
                                            {
                                                "example_id": "ff605556-3b14-4114-81a3-2b1f2a4579ba",
                                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                                "text": "„Die Polizeiwache war ein kleines, mit Stuck verkleidetes Haus am Ende des Parkplatzes, gleich neben der Promenade und in der Nähe des Pavillons.“"
                                            },
                                            {
                                                "example_id": "81422e59-fd44-4df7-a847-d5d16a130f8d",
                                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                                "text": "„Auf der Polizeiwache hatten sie ihnen gedroht, und die Fürsorgerin versuchte es mit freundlichem Zureden, aber sie hatten durchgehalten.“"
                                            },
                                            {
                                                "example_id": "4867ee3b-6ebd-4f15-8d65-d0f3836af364",
                                                "sense_id": "4ca0e67f-2ba5-3f6b-b9cb-d65f4d464328",
                                                "text": "„Er hatte jetzt den Chefposten inne, war der Herr der Polizeiwache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "304fe6be-a7af-438b-8801-f097f701c151",
                        "source_entry_id": "357321a9-e769-3447-ae70-04b9f222c237",
                        "source_sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                        "target_lang_word": "Polizeirevier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizeirevier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                        "entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                                        "glosses": [
                                            "Dienststelle der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "933d85c6-1a1d-4ffb-b38b-91b4136c1f06",
                                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                                "text": "„Allerdings gelang es ihm, auf dem Gemeindebüro und dem Polizeirevier ein paar Informationen über seine norwegische Herkunft zu bekommen.“"
                                            },
                                            {
                                                "example_id": "ad01012f-188b-43dd-83e8-04afada39f1e",
                                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                                "text": "„Sie entschieden, ihn beim nächstgelegenen Polizeirevier abzugeben.“"
                                            },
                                            {
                                                "example_id": "98fd1bda-19bc-4f4d-a784-9bf9eec81d30",
                                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                                "text": "„Vom Fenster aus sah man direkt auf das Polizeirevier 220.“"
                                            },
                                            {
                                                "example_id": "fe1e2e5c-b8ac-409a-9696-c8d84ddd4120",
                                                "sense_id": "84aa34d8-ff40-3c18-a81a-521b44dcf96d",
                                                "text": "„Der zuständige Beamte im Polizeirevier hatte schweigend dem Gendarmen und dem Polizisten , der das Protokoll aufnahm, zugehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a99a865d-9df4-3412-a6ce-8a2cffd87558",
                                        "entry_id": "a5e201c8-14be-3b05-851e-e7ca1b9c21e4",
                                        "glosses": [
                                            "Zuständigkeitsbereich von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7740c45e-7a3a-419c-8f8f-b421b2a16121",
                                                "sense_id": "a99a865d-9df4-3412-a6ce-8a2cffd87558",
                                                "text": "Der Unfall ereignete sich nicht in unserem Polizeirevier."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c8206fd-fd82-4dda-b2b9-5e3efac38bae",
                        "source_entry_id": "357321a9-e769-3447-ae70-04b9f222c237",
                        "source_sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                        "target_lang_word": "police station",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police station",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                        "entry_id": "11cb6928-dd57-3fcc-8a58-3071692449d2",
                                        "glosses": [
                                            "A building serving as the headquarters of a branch of the police force, and sometimes as a temporary place of confinement for offenders."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e86f4f2-9ec9-4b6e-a57b-80f1dd9e657c",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "When the ballots were opened on 19 November, Hsu Hsin-liang’s supporters at a polling station in Chungli City suspected fraud. As the crowd swelled to approximately a thousand, rioting erupted. One protester was killed and the Chungli police station was burned."
                                            },
                                            {
                                                "example_id": "eddfb0b7-c85e-4ece-9e99-11c327fc2a01",
                                                "sense_id": "fa8a0fc2-7ec8-32f3-8857-bdc078e302f2",
                                                "text": "In trying to stop him from exploiting more children, I was ensuring my parents and my siblings would be ostracised. She begged me not to go to the police station."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c243255e-f8f5-491c-9919-d52a570f4209",
                        "source_entry_id": "357321a9-e769-3447-ae70-04b9f222c237",
                        "source_sense_id": "c6e04438-47cc-3b57-9768-ab25c5e4c948",
                        "target_lang_word": "hôtel de police",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hôtel de police",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cecc9180-975c-3e28-8c1d-974dbf3a5930",
                                        "entry_id": "eff1ff1e-0449-3e4e-bf2b-64ca2a577c16",
                                        "glosses": [
                                            "Bâtiment utilisé comme siège de la police."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65c429f-5319-4d1a-8d2c-599f881d28e0",
                                                "sense_id": "cecc9180-975c-3e28-8c1d-974dbf3a5930",
                                                "text": "À midi seize, les rares employés qui travaillaient ce jour-là quittèrent l’hôtel de ville puis ce fut le tour des « administratifs » de l’hôtel de police."
                                            },
                                            {
                                                "example_id": "8340785d-4458-4289-ae25-42ca7c11f975",
                                                "sense_id": "cecc9180-975c-3e28-8c1d-974dbf3a5930",
                                                "text": "Deux ans et trois mois après l’ouverture du chantier, la construction du nouvel hôtel de police et la rénovation de Charleroi Danse arrivent à leur terme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
