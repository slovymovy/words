                "senses": [
                    {
                        "sense_id": "96761e27-a30d-3dfe-83ea-e63553c7f674",
                        "entry_id": "1353b762-f268-3fc0-b0e7-4d60aea09d0a",
                        "glosses": [
                            "eines der acht Tore der Jerusalemer Altstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0114a937-985d-4fab-8b12-4b37f4c8f855",
                                "sense_id": "96761e27-a30d-3dfe-83ea-e63553c7f674",
                                "text": "„Zweitens beschränkte die israelische Polizei zu Beginn des Fastenmonats Ramadan den Zugang zum Platz vor dem Damaskustor, der normalerweise vor allem an den Abenden nach dem Fastenbrechen von der palästinensischen Bevölkerung stark frequentiert wird.“"
                            },
                            {
                                "example_id": "e590a698-a740-40cf-a1e5-367933cb88a6",
                                "sense_id": "96761e27-a30d-3dfe-83ea-e63553c7f674",
                                "text": "„Einer dieser Beerdigungszüge, an dem rund tausendfünfhundert Schüler und Familienangehörige von im Krieg getöteten Palästinensern teilnahmen, wurde von der gut vorbereiteten israelischen Polizei am Damaskustor aufgehalten, sie ließ nur etwa hundert Personen, die Trauerkränze trugen, durch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
