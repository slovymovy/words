                "senses": [
                    {
                        "sense_id": "36912dc4-2b89-3830-bf0e-eb41385f7ebd",
                        "entry_id": "d9a2105d-0e1d-30da-bf4a-3951c9435395",
                        "glosses": [
                            "A small wire rope or line used to pull the main cable (or butt-rigging) back into position after a log has been hauled out."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "f38e0a81-e98f-4036-98ca-e4096ff64622",
                                "sense_id": "36912dc4-2b89-3830-bf0e-eb41385f7ebd",
                                "text": "We ran 3,000 feet of haulback and got only thirty-five logs."
                            },
                            {
                                "example_id": "1ad0ab90-03cc-4539-8f0d-08f63e30d39c",
                                "sense_id": "36912dc4-2b89-3830-bf0e-eb41385f7ebd",
                                "text": "The skyline isn't interlocked with the mainline and haulback, and the mainline and haulback can't both wind the same direction at the same time."
                            },
                            {
                                "example_id": "de53863b-aa16-4450-ae53-63f0eaebd804",
                                "sense_id": "36912dc4-2b89-3830-bf0e-eb41385f7ebd",
                                "text": "Butt rigging—a series of heavy steel links, swivels, and shackles—commected the main line to the haulback line and carried up to six chokers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7e1aa3c-fe38-32f2-9de2-5baa124df7b4",
                        "entry_id": "d9a2105d-0e1d-30da-bf4a-3951c9435395",
                        "glosses": [
                            "A method of surface mining where overburden (the material on top of the coal or ore) is transported from an area and then hauled back after removal of ore or coal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cd665deb-e724-42da-b1ad-320389bceb69",
                                "sense_id": "c7e1aa3c-fe38-32f2-9de2-5baa124df7b4",
                                "text": "This includes mining systems R&D such as development of haulback techniques to redeposit overburden material in a beneficial sequence immediately behind the extraction operation to minimize costs and aesthetic and environmental damage."
                            },
                            {
                                "example_id": "397648d4-7e74-45e0-89e6-1c5c553a5281",
                                "sense_id": "c7e1aa3c-fe38-32f2-9de2-5baa124df7b4",
                                "text": "As a result, haulback systems are being designed in shich the strip mine is continuously filled in behind as the mine advances."
                            }
                        ]
                    }
                ],
