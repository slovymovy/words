                "senses": [
                    {
                        "sense_id": "9d0a8a54-cf4a-39b5-936b-1b7fcce3d3df",
                        "entry_id": "f0e85841-54fa-373e-a9ca-f620ec5312ee",
                        "glosses": [
                            "Duitstalige hit, met vaak een sentimentele inhoud"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d433a75c-74b0-4536-9185-ac2428f30393",
                                "sense_id": "9d0a8a54-cf4a-39b5-936b-1b7fcce3d3df",
                                "text": "We nemen de bus, een rit van twee uur, waarbij we uitgebreid worden getrakteerd op Sloveense schlagers, hitsingles van Tom Jones en de schelle telefoonstem van een Australische jongedame die aan het thuisfront rapporteert."
                            },
                            {
                                "example_id": "01f24a73-0901-46f3-960e-9b851c119561",
                                "sense_id": "9d0a8a54-cf4a-39b5-936b-1b7fcce3d3df",
                                "text": "De Zwitserse Beatrice Egli (25) verraste met Mein Herz in 2013 bij de Duitse versie van Idols: voor het eerst in het tienjarig bestaan van Deutschland sucht den Superstar won een schlager, tot verbazing van Egli zelf. „Ik had nooit gedacht met een schlager zo ver te komen”, zei ze. En ook: „Tieners van nu vinden schlagers uncool, maar dat vind ik er nou net cool aan.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "0de2091f-71cc-3dfa-bc6f-2ac073c43472",
                        "entry_id": "f0e85841-54fa-373e-a9ca-f620ec5312ee",
                        "glosses": [
                            "Duitstalige biermuziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7bb48e9-a10d-45d7-8b7d-2476d0df3fb8",
                                "sense_id": "0de2091f-71cc-3dfa-bc6f-2ac073c43472",
                                "text": "Bier, schlagers én een goed doel op Oktoberfest in Hengelo. Honderden liters bier en schlagermuziek alom. Zoals van de Alpenzusjes en DJ Ötzi, die de groeten kwam brengen van 'Anton aus Tirol'."
                            }
                        ]
                    }
