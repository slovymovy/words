                        "glosses": [
                            "Combiner chimiquement au sodium (en particulier, traiter un composé organique avec l’amidure de sodium)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08ac4040-05e2-4b62-a711-ed66fc99df8e",
                                "sense_id": "2d079a35-9890-36a7-908c-62171fecf1b8",
                                "text": "En traitant le dérivé triméthylé, ou bien un mélange de produits di-, tri- et tétraméthylés, provenant des préparations des mono-, di- et tridérivés, par un léger excès d’amidure de sodium, on arrive, après avoir chauffé la solution éthérée à l’ébullition pendant 5 à 6 heures, à soder la presque totalité des pentanones."
                            },
                            {
                                "example_id": "a7514e71-99fe-4de1-ac9f-05aa882c798f",
                                "sense_id": "2d079a35-9890-36a7-908c-62171fecf1b8",
                                "text": "Le mode opératoire qui nous a donné les meilleurs rendements consiste à soder le camphre au sein de l’éther pendant 5 heures."
                            }
                        ]
                    }
