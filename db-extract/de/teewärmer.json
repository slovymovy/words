                        "entry_id": "0741b28b-7b0b-329c-bea6-1c1a596ff8df",
                        "glosses": [
                            "eine Haube, die über die Teekanne gestülpt wird, um den Tee warm zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebc8694-95e4-40eb-ab81-4c5bb99e71b1",
                                "sense_id": "d73d2629-d2e9-3543-8843-2df9bb51d4d4",
                                "text": "Mit einem maßgehäkelten Teewärmer, bleibt der Tee warm und es sieht gut aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09048e43-5d95-3cf7-aa41-3d24a67969ac",
                        "entry_id": "0741b28b-7b0b-329c-bea6-1c1a596ff8df",
                        "glosses": [
                            "ein Untersetzer aus Metall, Keramik, Porzellan oder Gusseisen mit einem Teelicht, um den Tee warm zu halten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1449ca4-dab9-4d04-9f79-81cf8b4055ec",
                                "sense_id": "09048e43-5d95-3cf7-aa41-3d24a67969ac",
                                "text": "Ein Teewärmer als Untersetzer hält den Tee lange warm und das Teelicht bringt Gemütlichkeit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
