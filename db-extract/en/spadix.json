                    {
                        "translation_id": "c315f884-47f0-4b1c-9f67-218bb7105ceb",
                        "source_entry_id": "bb11e9f1-509c-3849-a6d5-67bb8e414b73",
                        "source_sense_description": "fleshy spike",
                        "target_lang_word": "Kolben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kolben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16a6c10c-3b6c-390e-a809-87706874286e",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "eine Keule oder ihr dickes Ende"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a35ba206-3f8d-460b-82d5-3a7b951e01a8",
                                                "sense_id": "16a6c10c-3b6c-390e-a809-87706874286e",
                                                "text": "Früher stand immer ein Kolben gleich hinter der Eingangstür."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3375bc34-11de-3ba5-86ee-934ccc77d362",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "ein sich bewegendes, zylindrisches Teil in Maschinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85917b3-3fda-4455-8528-15b1e59c9211",
                                                "sense_id": "3375bc34-11de-3ba5-86ee-934ccc77d362",
                                                "text": "Da müssen wir, glaub' ich, den Kolben auswechseln."
                                            },
                                            {
                                                "example_id": "1123fa14-f5e8-4e8c-8970-23096610420a",
                                                "sense_id": "3375bc34-11de-3ba5-86ee-934ccc77d362",
                                                "text": "„Der Kolben setzt sich in Schwung, überträgt die Kraft auf den Balancier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c566436c-4f99-3add-a694-15ae99d63cc9",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "Gewehrkolben, das hintere Ende eines Gewehrs, das man an die Schulter anlegen kann"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29b1c3d-fcbb-4c46-8dc3-6baa696f5471",
                                                "sense_id": "c566436c-4f99-3add-a694-15ae99d63cc9",
                                                "text": "Das Gewehr hatte einen Kolben aus edlem Holz."
                                            },
                                            {
                                                "example_id": "0b9c68f7-a90f-453a-8201-11e3acacc931",
                                                "sense_id": "c566436c-4f99-3add-a694-15ae99d63cc9",
                                                "text": "„Noch bevor sie die Gäste einzuordnen vermochten, bekam jeder von ihnen mit dem Kolben einen stumpfen Schlag auf den Hinterkopf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "51014145-480a-35aa-8304-bef9e7980552",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "verdicktes Pflanzenteil, an dem dichtgedrängt Blüten oder Früchte nebeneinander wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100799f3-574e-436c-a7f4-d7b0c8dcc9b3",
                                                "sense_id": "51014145-480a-35aa-8304-bef9e7980552",
                                                "text": "Ich nahm zehn Kolben Mais mit."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0a7fa5ae-fe9a-3bda-9a3c-306b7ed05d7d",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "Glaskolben"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "536e80bf-3d46-4a32-bc05-4c592769e783",
                                                "sense_id": "0a7fa5ae-fe9a-3bda-9a3c-306b7ed05d7d",
                                                "text": "Ein Rundkolben wird eingespannt und das Lösungsmittel in den Kolben gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b95676c0-62ad-3fb5-9bd6-acc317a239d5",
                                        "entry_id": "c1eb079b-61f5-3985-8315-2d7c9571a230",
                                        "glosses": [
                                            "Nase"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edbf23b4-a0d6-46c7-8bba-192a9f8d83c5",
                                                "sense_id": "b95676c0-62ad-3fb5-9bd6-acc317a239d5",
                                                "text": "Nun nimm mal deinen Kolben aus dem Suppentopf!"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
