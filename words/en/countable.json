{
    "word_family": [
        "count",
        "counter",
        "counting"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5389c1ac-be00-36ba-950d-b8ed6c92ad28",
                    "sense_definition": "Capable of being counted or having a specific quantity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The number of stars in the sky is not <w>countable</w> by the human eye."
                        },
                        {
                            "text": "Small items like paperclips are <w>countable</w> if you have enough time."
                        }
                    ],
                    "synonyms": [
                        "denumerable"
                    ],
                    "antonyms": [
                        "countless",
                        "numberless",
                        "innumerable"
                    ]
                },
                {
                    "sense_id": "89a0e376-fff7-3741-b47c-7be4dc606cea",
                    "sense_definition": "Used to describe a noun that can be used with numbers and the indefinite article.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word apple is a <w>countable</w> noun because you can say one apple or two apples."
                        },
                        {
                            "text": "Students often struggle to distinguish between <w>countable</w> and uncountable nouns in English."
                        }
                    ],
                    "synonyms": [
                        "count"
                    ],
                    "antonyms": [
                        "uncountable",
                        "noncount",
                        "non-count"
                    ],
                    "common_phrases": [
                        "countable noun"
                    ]
                },
                {
                    "sense_id": "f5ae2410-3f9d-390e-93f2-658567f53842",
                    "sense_definition": "Relating to a set that has a one-to-one correspondence with natural numbers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The set of all integers is <w>countable</w> even though it is infinite."
                        },
                        {
                            "text": "Mathematicians study whether certain sets are <w>countable</w> or uncountable."
                        }
                    ],
                    "synonyms": [
                        "denumerable"
                    ],
                    "antonyms": [
                        "uncountable",
                        "non-denumerable"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "453669f1-6edb-346f-8676-6455a33f7d36",
                    "sense_definition": "A noun that can be used with numbers and the indefinite article.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English grammar, a <w>countable</w> can be pluralized by adding an s."
                        },
                        {
                            "text": "You must learn which words are <w>countable</w> to use articles correctly."
                        }
                    ],
                    "synonyms": [
                        "count noun"
                    ],
                    "antonyms": [
                        "uncountable",
                        "mass noun",
                        "noncount noun",
                        "non-count noun",
                        "uncountable noun"
                    ],
                    "common_phrases": [
                        "countable noun"
                    ]
                }
            ]
        }
    ]
