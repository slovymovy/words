                    "sense_definition": "Having gone away or belonging to a time that has passed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum contained many relics from a <w>departed</w> era.",
                            "target_lang_translations": {
                                "ru": "В музее хранилось множество реликвий <w>ушедшей</w> эпохи.",
                                "pl": "Muzeum zawierało wiele reliktów <w>minionej</w> epoki."
                            }
                        },
                        {
                            "text": "She often thought about the happiness of those <w>departed</w> days.",
                            "target_lang_translations": {
                                "ru": "Она часто вспоминала счастье тех <w>минувших</w> дней.",
                                "pl": "Często myślała o szczęściu tamtych <w>minionych</w> dni."
                            }
