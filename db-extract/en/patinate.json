                    {
                        "translation_id": "4a3c00bd-0ddb-462c-8375-477778e3295e",
                        "source_entry_id": "8a2367e6-02db-3db3-94c6-bea13cda4f62",
                        "source_sense_description": "coat with patina",
                        "target_lang_word": "oxidieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oxidieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b92846-a19d-3abf-879e-4c01f44cad01",
                                        "entry_id": "d79e0b49-f108-3d28-af51-03ee7dadb621",
                                        "glosses": [
                                            "sich mit Sauerstoff verbinden, eine Sauerstoffverbindung eingehen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ab62df-7cb7-4b51-beb3-bf52c084185e",
                                                "sense_id": "b7b92846-a19d-3abf-879e-4c01f44cad01",
                                                "text": "Werden solche Moore trockengelegt oder landwirtschaftlich genutzt, gelangt Sauerstoff an den Torf und das Pflanzenmaterial beginnt zu verrotten. Dabei oxidiert der gespeicherte Kohlenstoff zum Treibhausgas CO2 und gelangt in die Atmosphäre."
                                            },
                                            {
                                                "example_id": "594d7422-fe41-4486-b8ef-a6bad8c1d337",
                                                "sense_id": "b7b92846-a19d-3abf-879e-4c01f44cad01",
                                                "text": "Heute verbaut man Alu. Das wird schön eloxiert. Diese Schutzschicht wird aber von aggressiven Waschmitteln zerstört. Das Alu oxidiert und wird schmierig-schwarz."
                                            },
                                            {
                                                "example_id": "2ee181bf-ed73-4242-8f7f-571f30ed9d4d",
                                                "sense_id": "b7b92846-a19d-3abf-879e-4c01f44cad01",
                                                "text": "Mit der Asche gelangen schwefelhaltige Gase in die Stratosphäre, wo sie zu Schwefeldioxid oxidieren und sich schließlich in sulfathaltige Staubteilchen umwandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9e9ebaa-1f19-3d13-8928-b7231ed7d92b",
                                        "entry_id": "d79e0b49-f108-3d28-af51-03ee7dadb621",
                                        "glosses": [
                                            "bewirken, dass sich ein chemischer Stoff mit Sauerstoff verbindet"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d69f16-3d4e-4ae5-91bf-4d64425845b3",
                                                "sense_id": "d9e9ebaa-1f19-3d13-8928-b7231ed7d92b",
                                                "text": "Wahrscheinlich führt die Bestrahlung zu Bindungsbrüchen in der Polycarbonatkette und sorgt so für mehr freie Methylenden, die von den Pilzen oxidiert werden können."
                                            },
                                            {
                                                "example_id": "3e8477c3-6b95-4af4-8cd6-1eff9c9fd20f",
                                                "sense_id": "d9e9ebaa-1f19-3d13-8928-b7231ed7d92b",
                                                "text": "Nun bringt der Tübinger Geomikrobiologe Andreas Kappler einen neuen möglichen Baumeister ins Spiel: Eisenbakterien, die das Metall nicht mit Sauerstoff, sondern mit ultraviolettem Licht oxidieren."
                                            },
                                            {
                                                "example_id": "362cd69a-8133-4e16-9301-93b4b286fe89",
                                                "sense_id": "d9e9ebaa-1f19-3d13-8928-b7231ed7d92b",
                                                "text": "Die heißen Abgase strömen durch den Katalysator, die Edelmetalle setzen eine chemische Reaktion in Gang. Das Kohlenmonoxid oxidiert zu Kohlendioxid, Kohlenwasserstoff wird zum Teil in Wasserstoff und Kohlendioxid aufgespaltet, und die Stickoxide werden reduziert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "41f8a380-e6f2-33d1-90b5-eff69fd46e8e",
                                        "entry_id": "d79e0b49-f108-3d28-af51-03ee7dadb621",
                                        "glosses": [
                                            "Elektronen abgeben, die von einem Elektronenakzeptor aufgenommen werden"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "058f7377-d309-46c8-aa8b-330c5faa8974",
                                                "sense_id": "41f8a380-e6f2-33d1-90b5-eff69fd46e8e",
                                                "text": "Bei der Bildung von Natriumchlorid wird das Natrium oxidiert und das Chlor dabei reduziert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
