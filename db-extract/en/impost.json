                        "glosses": [
                            "The top part of a column, pillar, pier, wall, etc. that supports an arch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9c4f915-7338-4721-9fad-bc7b6d1c5c08",
                                "sense_id": "188861aa-2126-3b50-8d65-fb2e9a1720bb",
                                "text": "The outer circle [of Stonehenge] has been formed by a combination of two uprights and an impost; yet each combination of these three stones is detached, and without any connection with the rest, except that of coinciding in the form of a circle."
                            }
