                    "target_lang_definitions": {
                        "en": "To display a certain quality or boldness to perform an act.",
                        "es": "Demostrar cierta cualidad o valor para llevar a cabo una acción.",
                        "fr": "Faire preuve d'une qualité ou du courage nécessaire pour accomplir un acte."
