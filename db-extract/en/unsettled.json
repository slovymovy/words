                        "target_lang_word": "unsicher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsicher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "eine Gefahr drohend, in sich bergend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4681ad1f-cfb8-47ec-90ff-f70d2b770766",
                                                "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                                "text": "Diese Gegend ist mir zu unsicher."
                                            },
                                            {
                                                "example_id": "0c03141e-e5d1-4b76-89aa-2a52b739bfba",
                                                "sense_id": "803d919a-5796-3c21-bf33-756881cf6394",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62383ea9-f99a-366d-9c40-829d0b425325",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "der Ausgang die Zukunft ist fraglich oder zweifelhaft, nicht klar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a770257-c2cc-4e0f-a0a3-f8ab545d74a3",
                                                "sense_id": "62383ea9-f99a-366d-9c40-829d0b425325",
                                                "text": "Der Autokonzern will den Händler Müller schlucken – Übernahme aller Angestellten unsicher."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bae6d26d-2a32-33fb-a9a7-3303ceba2365",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "kein Selbstbewusstsein, seiner selbst nicht sicher sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163ad52a-68f3-48dd-b283-725ff4c56b29",
                                                "sense_id": "bae6d26d-2a32-33fb-a9a7-3303ceba2365",
                                                "text": "Ich bin mir jetzt unsicher, ob wir von hier oder von dort drüben gekommen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0c0d55a5-431d-360f-b48b-71b7275ff645",
                                        "entry_id": "91445ad4-be77-3c2c-bc2d-dbd10e3d13a8",
                                        "glosses": [
                                            "man kann sich auf etwas nicht verlassen, darauf vertrauen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdf6410-52df-40b6-926d-2804708f4485",
                                                "sense_id": "0c0d55a5-431d-360f-b48b-71b7275ff645",
                                                "text": "Dieses Verfahren ist mir zu unsicher, da kann ich mich nicht darauf verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5364b3e6-fe69-46a9-be24-cd3ff27a5ab5",
                        "source_entry_id": "19764e38-b806-3c10-be82-add72263e6d5",
                        "source_sense_description": "not populated",
                        "target_lang_word": "unbesiedelt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbesiedelt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                        "entry_id": "97f3498d-22a1-364b-8710-cdf784936247",
                                        "glosses": [
                                            "nicht von Menschen (oder Lebewesen) bewohnt, besiedelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a274ccbb-5ab6-4f6b-b704-7e66af6c9bf4",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Der Planet war zuvor unbesiedelt und ist am Firmament für unser Volk ausgewählt worden.“"
                                            },
                                            {
                                                "example_id": "aa538f29-8db1-4007-b9c5-e548c447cd4d",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Der größte Teil des Seeufers ist weitgehend unbesiedelt und steht unter Naturschutz, ebenso wie Olchon, die größte Insel im Baikalsee.“"
                                            },
                                            {
                                                "example_id": "ea718c7f-ef82-4464-b667-4ea340f2a310",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Die hinreißende Landschaft ist dabei völlig unbesiedelt, es lässt sich keinerlei Haus oder dergleichen ausmachen.“"
                                            },
                                            {
                                                "example_id": "a4be18b3-fb33-4404-9090-25c7676964af",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Beiderseits der Strecke ist die Region völlig unbesiedelt, nur Hirten mit Schafherden und halbwilde Schweinefamilien kreuzen ab und an die Straße.“"
                                            },
                                            {
                                                "example_id": "16f1ab1a-d50a-4d33-885b-a44673ef2790",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Durch das starke Bevölkerungswachstum gerade in Asien, Afrika und Südamerika kommt es vermehrt zum Vordringen des Menschen in bisher unbesiedelte Räume.“"
                                            },
                                            {
                                                "example_id": "215efe9c-3d7c-466e-bcbf-b13b22ac3b3f",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Es gab jeder Person über 18 Jahren das Recht, fast sechseinhalb Hektar unbesiedelten Landes zu besetzen.“"
                                            },
                                            {
                                                "example_id": "4755132e-28c8-4f80-bde1-7118ada288df",
                                                "sense_id": "1e4a1a4e-15c6-3d86-b840-f140e4fcdf17",
                                                "text": "„Im Osten sind die Driewitz-Milkeler Heiden, das größte unbesiedelte Waldgebiet der Lausitz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31229b15-92fe-40c9-ba56-ecb10fcd5e47",
