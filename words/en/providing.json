{
    "word_family": [
        "provide",
        "provider",
        "provision",
        "provisional",
        "provident",
        "providence"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05df13db-e49c-38d5-944c-61d826619286",
                    "sense_definition": "The present participle and gerund of <w>provide</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school is <w>providing</w> lunch for all students today.",
                            "target_lang_translations": {
                                "ru": "Сегодня школа <w>предоставляет</w> обед всем ученикам.",
                                "nl": "De school <w>verstrekt</w> vandaag lunch aan alle leerlingen."
                            }
                        },
                        {
                            "text": "Thank you for <w>providing</w> support during this difficult time.",
                            "target_lang_translations": {
                                "ru": "Спасибо за <w>оказание</w> поддержки в это трудное время.",
                                "nl": "Bedankt voor het <w>bieden van</w> steun tijdens deze moeilijke tijd."
                            }
                        }
                    ],
                    "common_phrases": [
                        "providing support",
                        "providing services",
                        "providing information"
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от глагола provide (обеспечивать, предоставлять).",
                        "nl": "De tegenwoordig deelwoord- en gerundiumvorm van het werkwoord 'provide' (voorzien, verstrekken, leveren)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предоставление",
                                "target_lang_sense_clarification": "процесс передачи чего-либо"
                            },
                            {
                                "target_lang_word": "обеспечение",
                                "target_lang_sense_clarification": "снабжение необходимым"
                            },
                            {
                                "target_lang_word": "оказание",
                                "target_lang_sense_clarification": "в сочетании с услугами или помощью"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voorzien van",
                                "target_lang_sense_clarification": "iemand of iets van iets anders voorzien"
                            },
                            {
                                "target_lang_word": "verstrekken",
                                "target_lang_sense_clarification": "officieel of formeel leveren of geven"
                            },
                            {
                                "target_lang_word": "leveren",
                                "target_lang_sense_clarification": "het bezorgen of aanbieden van goederen of diensten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "d8c69210-b432-34b5-9542-f92e38cf9025",
                    "sense_definition": "Used to state that something will happen only if a specific condition is met; on the condition that.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can borrow the car, <w>providing</w> you fill the tank before returning it.",
                            "target_lang_translations": {
                                "ru": "Ты можешь взять машину <w>при условии, что</w> заправишь бак перед возвратом.",
                                "nl": "Je mag de auto lenen, <w>mits</w> je de tank vult voordat je hem terugbrengt."
                            }
                        },
                        {
                            "text": "We will have the picnic tomorrow, <w>providing</w> that it does not rain.",
                            "target_lang_translations": {
                                "ru": "Завтра мы устроим пикник <w>при условии, что</w> не будет дождя.",
                                "nl": "We gaan morgen picknicken, <w>op voorwaarde dat</w> het niet regent."
                            }
                        }
                    ],
                    "synonyms": [
                        "provided"
                    ],
                    "common_phrases": [
                        "providing that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Союз, указывающий на то, что событие произойдет только при выполнении определенного условия.",
                        "nl": "Een voegwoord dat aangeeft dat iets alleen zal gebeuren als aan een specifieke voorwaarde wordt voldaan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "при условии, что",
                                "target_lang_sense_clarification": "формальный союз"
                            },
                            {
                                "target_lang_word": "если только",
                                "target_lang_sense_clarification": "указание на условие"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "mits",
                                "target_lang_sense_clarification": "onder de voorwaarde dat"
                            },
                            {
                                "target_lang_word": "op voorwaarde dat",
                                "target_lang_sense_clarification": "formele uitdrukking voor een conditie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a022ee9-a0ef-3b76-8716-a59dfdc08269",
                    "sense_definition": "Something that is supplied or provided; a provision.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The meager <w>providings</w> were not enough to last the winter.",
                            "target_lang_translations": {
                                "ru": "Скудных <w>припасов</w> не хватило, чтобы продержаться зиму.",
                                "nl": "De schamele <w>voorraden</w> waren niet genoeg om de winter door te komen."
                            }
                        },
                        {
                            "text": "She was grateful for the daily <w>providings</w> of food and water.",
                            "target_lang_translations": {
                                "ru": "Она была благодарна за ежедневное <w>снабжение</w> едой и водой.",
                                "nl": "Ze was dankbaar voor de dagelijkse <w>voorziening</w> van eten en drinken."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что предоставляется или поставляется; запасы или провизия.",
                        "nl": "Iets dat wordt geleverd of verstrekt; voorraden of proviand."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "припасы",
                                "target_lang_sense_clarification": "материальные ресурсы"
                            },
                            {
                                "target_lang_word": "снабжение",
                                "target_lang_sense_clarification": "предоставленные ресурсы"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "voorraad",
                                "target_lang_sense_clarification": "beschikbare hoeveelheid goederen"
                            },
                            {
                                "target_lang_word": "proviand",
                                "target_lang_sense_clarification": "voedselvoorraad"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}