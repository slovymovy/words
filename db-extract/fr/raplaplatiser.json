                "senses": [
                    {
                        "sense_id": "c7a00f6d-6eb4-38f3-861b-2d0c554af761",
                        "entry_id": "5dc1b15a-a1e4-3e2c-b89f-babf698c6282",
                        "glosses": [
                            "Rendre raplapla."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52a4308e-c4e3-4321-9bd8-d56ee35e8d14",
                                "sense_id": "c7a00f6d-6eb4-38f3-861b-2d0c554af761",
                                "text": "Les lisseurs ont tendance à « raplaplatiser » les cheveux, ce n’est absolument pas le cas de cette brosse lissante et, je pense, des brosses chauffantes en général !"
                            },
                            {
                                "example_id": "387b12f4-8ccf-4457-b635-f9cdcd2783eb",
                                "sense_id": "c7a00f6d-6eb4-38f3-861b-2d0c554af761",
                                "text": "Le deuxième je l'ai gardé avec moi jusqu'au bout sauf qu'il s'est fait raplaplatiser par sa soeur...à la 2e écho on ne voyait plus rien."
                            },
                            {
                                "example_id": "470dc027-168c-4b7d-8de0-8deb9f29f2f5",
                                "sense_id": "c7a00f6d-6eb4-38f3-861b-2d0c554af761",
                                "text": "Elle emprisonne les esprits de démons dans des perles dont elle se sert pour raplaplatiser ses ennemis."
                            },
                            {
                                "example_id": "f1db17e7-5538-444b-bac6-281956b47e9c",
                                "sense_id": "c7a00f6d-6eb4-38f3-861b-2d0c554af761",
                                "text": "Grande hésitation là, faire un peu de scrap ou bien aller se raplaplatiser???"
                            }
                        ]
                    }
