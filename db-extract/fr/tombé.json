                    {
                        "sense_id": "cea37405-6ba4-382e-96de-b18c11ca65de",
                        "entry_id": "fbaf3880-32d9-3240-8bb3-629c3a2d09b9",
                        "glosses": [
                            "Déchu, qui n’a plus beaucoup de succès."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "293ab2fb-506f-4eb4-a44e-d80e1b1f87dd",
                                "sense_id": "cea37405-6ba4-382e-96de-b18c11ca65de",
                                "text": "Un auteur tombé, un auteur dramatique dont la pièce a été sifflée."
                            },
                            {
                                "example_id": "24157a5b-3929-4b1f-aa2f-144ba3f65b31",
                                "sense_id": "cea37405-6ba4-382e-96de-b18c11ca65de",
                                "text": "Comme l’Italie, c’est un pays tombé, qui reste en arrière des autres, et ne remonte au niveau des autres que par le contact d’une administration ou d’une civilisation étrangère."
                            }
                        ]
                    },
