                        "examples": [
                            {
                                "example_id": "208d2a4e-d2a3-41eb-9893-0a89741c2b22",
                                "sense_id": "1d54c97e-26da-3b27-a940-69324636c5c8",
                                "text": "[…] the trouble in manipulating the colorotos and rotogravures."
                            },
                            {
                                "example_id": "e24b9254-9963-477a-94d8-87d35ba1bf64",
                                "sense_id": "1d54c97e-26da-3b27-a940-69324636c5c8",
                                "text": "The progress of newspaper illustration can be traced in a few decades from the woodcut through line engraving, the half-tone, the mezzotint process, to rotogravure and coloroto."
                            },
                            {
                                "example_id": "280a360d-8656-4119-9108-935d716a9061",
                                "sense_id": "1d54c97e-26da-3b27-a940-69324636c5c8",
                                "text": "The production's colors, though, are very monochromatic—muted, lots of browns, creams, beiges, dark blues, bottle greens, like a coloroto section of an old newspaper."
                            }
                        ]
