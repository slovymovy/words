                "senses": [
                    {
                        "sense_id": "2605c615-4161-3f1e-a10f-9cd865d77e45",
                        "entry_id": "87ace20c-7fdd-3dc4-a4ef-1bd952e0c366",
                        "glosses": [
                            "Donner un caractère génétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce85772d-872f-418f-93b6-43e6792f4cf6",
                                "sense_id": "2605c615-4161-3f1e-a10f-9cd865d77e45",
                                "text": "Généticiser les maladies reviendrait donc à considérer que les gènes sont la cause la plus importante dans l'explication de toutes les maladies."
                            },
                            {
                                "example_id": "ca160362-8d19-4c9f-a66b-43c63b37a0ae",
                                "sense_id": "2605c615-4161-3f1e-a10f-9cd865d77e45",
                                "text": "Selon elle, généticiser consiste à problématiser des questions de santé ou de société en termes « génétiques » et d’associer leurs causes à l’identification d’un gène."
                            },
                            {
                                "example_id": "4e74a0cc-731f-4a83-9aba-f9a6c1856e08",
                                "sense_id": "2605c615-4161-3f1e-a10f-9cd865d77e45",
                                "text": "La politique de santé est une arme hétéro-patriarcale, qui assigne les identités de sexes et de genres, qui pathologise, psychiatrise, généticise ceux et celles qui se retrouvent hors des normes."
                            }
                        ]
                    }
                ],
