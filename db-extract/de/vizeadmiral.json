                ],
                "senses": [
                    {
                        "sense_id": "84444055-1027-39e1-9451-c892343436d7",
                        "entry_id": "0ff37003-c0bd-3954-8916-2ec113827762",
                        "glosses": [
                            "Rang zwischen dem Konteradmiral und dem Admiral"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69cdf4d9-a79e-4d1d-9802-e4e25a01e7d9",
                                "sense_id": "84444055-1027-39e1-9451-c892343436d7",
                                "text": "Der Vizeadmiral ist der zweithöchste Rang der Marine."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                        "entry_id": "0ff37003-c0bd-3954-8916-2ec113827762",
                        "glosses": [
                            "Offizier im Range eines Vizeadmirals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a02ec2-40c5-4d5b-b106-c3fbb57834fc",
                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                "text": "Bring dem Vizeadmiral sein Fernrohr!"
                            },
                            {
                                "example_id": "3e5eafcd-aa2f-4a68-bc1a-a95e321bfba4",
                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                "text": "„Bereits 1854 wurde [Erzherzog Maximilian von Österreich] zu deren Kommandant (im Range eines Konteradmirals, später eines Vizeadmirals) ernannt.“"
                            },
                            {
                                "example_id": "741ee49b-68b7-4a07-9135-bef583805602",
                                "sense_id": "0aee4d2a-7f5d-3e1b-bddc-bb95784009e4",
                                "text": "„Seit September 1940 ist er Vizeadmiral, am 14. März 1942 wird Hitler ihn zum Admiral befördern und weitere zehn Monate später zum Großadmiral.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
