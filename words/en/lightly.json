                },
                {
                    "sense_id": "6b9d1ec2-2d9b-33d7-b607-a7904421c69d",
                    "sense_definition": "Without proper seriousness, care, or concern.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not take such a serious accusation <w>lightly</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует относиться к такому серьезному обвинению <w>легкомысленно</w>.",
                                "zh": "你不应该<w>轻率地</w>对待如此严重的指控。",
                                "nl": "Je moet zo'n ernstige beschuldiging niet <w>lichtzinnig</w> opvatten.",
                                "pl": "Nie powinieneś <w>lekko</w> traktować tak poważnych oskarżeń.",
                                "de": "Du solltest eine so ernste Anschuldigung nicht <w>leichtfertig</w> nehmen.",
                                "fr": "Tu ne devrais pas prendre une accusation aussi grave <w>à la légère</w>.",
                                "it": "Non dovresti prendere <w>alla leggera</w> un'accusa così grave.",
                                "cs": "Tak vážné obvinění bys neměl brát <w>lehkovážně</w>.",
                                "tr": "Böylesine ciddi bir suçlamayı <w>hafife</w> almamalısın.",
                                "es": "No deberías tomarte una acusación tan seria <w>a la ligera</w>."
                            }
                        },
                        {
                            "text": "He decided <w>lightly</w> to quit his job without having another one lined up.",
                            "target_lang_translations": {
                                "ru": "Он <w>легкомысленно</w> решил уволиться с работы, не подыскав другую.",
                                "zh": "他没找好下家就<w>轻率地</w>决定辞职了。",
                                "nl": "Hij besloot <w>lichtzinnig</w> om zijn baan op te zeggen zonder dat hij al een andere had.",
                                "pl": "Podjął <w>lekko</w> decyzję o rzuceniu pracy, nie mając nagranej innej.",
                                "de": "Er entschied <w>leichtfertig</w>, seinen Job zu kündigen, ohne eine neue Stelle in Aussicht zu haben.",
                                "fr": "Il a décidé <w>légèrement</w> de quitter son travail sans en avoir un autre en vue.",
                                "it": "Ha deciso <w>superficialmente</w> di lasciare il lavoro senza averne trovato un altro.",
                                "cs": "Rozhodl se <w>lehkovážně</w> dát výpověď, aniž by měl zajištěnou jinou práci.",
                                "tr": "Başka bir iş ayarlamadan işinden ayrılmaya <w>hafifçe</w> karar verdi.",
                                "es": "Decidió <w>a la ligera</w> renunciar a su trabajo sin tener otro preparado."
                            }
                        }
                    ],
                    "synonyms": [
                        "carelessly",
                        "frivolously",
                        "indifferently"
                    ],
                    "antonyms": [
                        "seriously",
                        "gravely",
                        "earnestly"
                    ],
                    "common_phrases": [
