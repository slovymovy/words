        "nl-extract.jsonl": [
            {
                "entry_id": "9a76d4a2-a3f5-34e0-9e81-9b0340a68b5f",
                "word": "afgedankt",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a8d9442-2cc1-3a02-a836-e75467c25bed",
                        "entry_id": "9a76d4a2-a3f5-34e0-9e81-9b0340a68b5f",
                        "glosses": [
                            "niet meer in gebruik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e58f0173-f317-4842-8dd5-66601f288e0c",
                                "sense_id": "5a8d9442-2cc1-3a02-a836-e75467c25bed",
                                "text": "De meeste afgedankte onderzeeërs worden gestript, maar deze was nog helemaal bewaard zoals vroeger. We sliepen in de torpedokamer, waar de omhulsels van de torpedo’s nog te zien waren.”"
                            },
                            {
                                "example_id": "5b7475bb-adb9-4529-943c-7ddde1d7c81f",
                                "sense_id": "5a8d9442-2cc1-3a02-a836-e75467c25bed",
                                "text": "Overal zag je ze de afgelopen dagen al liggen, op groenstrookjes en bij ondergrondse vuilcontainers: kerstbomen. TwenteMilieu haalt ze vanaf maandag op in Hengelo, Enschede en Oldenzaal, als service aan de burger. Zo’n 50 ton aan afgedankte kerstbomen levert dat op. Vijf vragen aan Annemiek Prinsen van Twente Milieu over de inzameling van kerstbomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da5005b7-2e40-4296-906a-7c479d4fed44",
                        "source_entry_id": "9a76d4a2-a3f5-34e0-9e81-9b0340a68b5f",
                        "source_sense_id": "5a8d9442-2cc1-3a02-a836-e75467c25bed",
                        "target_lang_word": "disused",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disused",
