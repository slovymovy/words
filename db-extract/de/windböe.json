                    },
                    {
                        "translation_id": "78aedbd3-aa5d-456c-a6b1-e8c5840e9626",
                        "source_entry_id": "70da4af8-22f8-3496-a12a-64815e24cc65",
                        "source_sense_id": "f6823855-bee6-3213-8cbd-12a9929083c8",
                        "source_sense_description": "heftiger, sich drehender Windstoß",
                        "target_lang_word": "rafale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rafale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                        "entry_id": "6d5e886c-8ab9-3ff2-94be-1f9160d96788",
                                        "glosses": [
                                            "Augmentation subite, violente et courte du vent nominal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079e4899-16ac-4724-9d1f-e195a420ae3f",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Les chiens, repoussés par la rafale, aveuglés par les remous de l'atmosphère, ne pouvaient plus avancer."
                                            },
                                            {
                                                "example_id": "ca9ba5d2-28d1-4bf2-a89e-a128493d55d3",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Lors d’un point presse jeudi, Météo-France a reconnu avoir été « surprise par les valeurs des rafales », « tout à fait exceptionnelles ». Les plus fortes ont été enregistrées à Marignana (225 km/h), à L’Île-Rousse (206 km/h) et à Calvi (197 km/h)"
                                            },
                                            {
                                                "example_id": "983d2d74-7b1b-4c07-8898-1704bf4a571d",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Le vent soufflait par rafales et s’engouffrait dans les ravins, avec de sourds et plaintifs murmures."
                                            },
                                            {
                                                "example_id": "c2d3c715-14b5-44fe-a197-b18fe192073c",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Les rafales d'une violence inouïe, accès de colère de Wottan ou de Thor, tombent des hauteurs en sifflant et soulèvent des tourbillons d'embruns qui sillonnent la mer."
                                            },
                                            {
                                                "example_id": "ab7dab5c-ff0d-4b27-9d81-7099a17fadc0",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Une nuit, vers 1 heure du matin, les rafales de vent se firent plus violentes et je fus réveillé par le bruit de mon ancre dérapant sur le fond."
                                            },
                                            {
                                                "example_id": "3549ac5d-faa4-4c07-ba13-04f0a14828f2",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Le Pourquoi Pas lutte, lutte toujours. Mais déjà les chevaux blancs des Walkyries hennissent dans les rafales."
                                            },
                                            {
                                                "example_id": "83b1fe12-f04a-4580-a343-9a72894f993b",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "L'Institut a fait état de vents allant jusqu'à 95 km/h, avec des rafales plus importantes."
                                            },
                                            {
                                                "example_id": "0b9e4a1a-e1da-4d24-bda1-1ba977fd4efe",
                                                "sense_id": "ae6a7505-fbd1-3d68-b1bf-7d719ac8e664",
                                                "text": "Tous sont encore traumatisés par les rafales, dont certaines ont atteint les 260 km/h ce week-end. Des centaines d'habitants se retrouvent sans électricité, ni eau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                        "entry_id": "6d5e886c-8ab9-3ff2-94be-1f9160d96788",
                                        "glosses": [
                                            "Enchaînement rapide de mots, de prises de photos, de coups, de tirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02fa4be-22ad-4c48-a244-8f004116e1f7",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "La pluie frappait la vitre par rafales et je craignais que celle-ci ne se brisât."
                                            },
                                            {
                                                "example_id": "d27358e3-ff86-4c57-b5fe-721ba9b75b6e",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Si les conditions de lumière sont mauvaises ou que votre appareil-photo n'est pas capable de prendre plusieurs photos en rafale, alors il faut trouver un moyen de limiter les objets en mouvement, […]."
                                            },
                                            {
                                                "example_id": "522ef951-c3fb-425b-9265-874775bd66e0",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Pour moi, la seule chose assez évidente c'est qu'il a reçu une belle rafale de gifles, pas longtemps avant de canner, lui dit le médecin."
                                            },
                                            {
                                                "example_id": "afef79cb-4c98-4c95-aa4d-358f56fed406",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Elle marqua un bref temps de pause, puis me fusilla d'une rafale de paroles :"
                                            },
                                            {
                                                "example_id": "910b5970-56e4-4268-ba44-aedd146d7123",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Des jours, des semaines durant […] ils attendaient là un interrogatoire, […] ou bien encore leur « tentative d'évasion », c'est à dire une rafale de mitraillette dans le dos."
                                            },
                                            {
                                                "example_id": "aadea546-f4a7-4d50-9457-f2c7323f29af",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Sus à l'ennemi ! Aurèle sonne le hallali. Tout à l'heure, il pensait rafale de mitraillette, sulfatage, pruneaux. Mais la balle de métal est trop noble : par elle meurent les héros."
                                            },
                                            {
                                                "example_id": "c788dd2e-2088-4327-b3ba-e90a882e95aa",
                                                "sense_id": "b966f743-d392-322e-8f15-125b92e892b7",
                                                "text": "Les yeux bleus étaient traversés, par rafales, d’une expression de désarroi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rafale",
                                "target_lang_code": "fr",
                                "target_senses": [
