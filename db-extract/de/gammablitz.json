                                        "glosses": [
                                            "Flash de rayons gamma d’origine cosmique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed06ad8-b542-49f3-a181-3ad6aad8183a",
                                                "sense_id": "7e6e0c28-e143-3972-bbd6-e252184f9ac6",
                                                "text": "Depuis la révélation de leur détection tout à fait fortuite en 1967 par deux satellites américains chargés de surveiller l’application du traité d’interdiction des essais nucléaires dans l’atmosphère, les sursauts gamma constituent un des plus grands mystères de l’astrophysique."
                                            }
