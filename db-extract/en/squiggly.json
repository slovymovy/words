                                "sense_id": "935184e3-95bf-335e-bf5a-3f366e054747",
                                "text": "She didn't have a ruler, so she drew a squiggly line to highlight the main points."
                            },
                            {
                                "example_id": "58319d1a-3442-4772-8ff1-84b0ca0a40af",
                                "sense_id": "935184e3-95bf-335e-bf5a-3f366e054747",
                                "text": "My first memories of eating are bowls of squiggly pasta with red sauce and lots of white cheese."
                            }
                        ]
