                "senses": [
                    {
                        "sense_id": "affaf6e0-9dbf-3573-8df2-bb3cf7b3cf39",
                        "entry_id": "4915289e-d742-345e-8581-569a4030447f",
                        "glosses": [
                            "Conserver pour soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24205a9-80e3-4283-bcc5-c85fd533b2b6",
                                "sense_id": "affaf6e0-9dbf-3573-8df2-bb3cf7b3cf39",
                                "text": "Etes - vous pour ou contre la possibilité, pour une donneuse d'ovocytes, d'auto-conserver pour elle-même une partie de ses ovocytes ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "27121377-3611-32ba-8df9-892ab4dfcff3",
                        "entry_id": "4915289e-d742-345e-8581-569a4030447f",
                        "glosses": [
                            "Se conserver par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9711bff3-67d9-4a3f-8b5f-9e20d571ade6",
                                "sense_id": "27121377-3611-32ba-8df9-892ab4dfcff3",
                                "text": "Le mélange va chauffer, s'acidifier et donc s'auto-conserver."
                            },
                            {
                                "example_id": "50f16934-edb7-4fc9-a554-d528f97a2b66",
                                "sense_id": "27121377-3611-32ba-8df9-892ab4dfcff3",
                                "text": "Notre programmation nous pousse irrémédiablement à nous auto-conserver, à nous dupliquer et à lutter pour une forme de survie inaliénable."
                            }
                        ]
                    }
