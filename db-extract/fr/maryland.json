                    {
                        "sense_id": "b40f5f4c-e3ad-307d-b3e9-5ca3496debd1",
                        "entry_id": "0b2d5a01-61e9-33b4-8511-9b003e0691fc",
                        "glosses": [
                            "Tabac provenant du Maryland, État des États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ee955c-b2e6-40bf-a04a-4dc71a93a4cc",
                                "sense_id": "b40f5f4c-e3ad-307d-b3e9-5ca3496debd1",
                                "text": "Norine. – C’est aujourd’hui sa fête, à ce pauvre ami… et je veux lui faire une surprise… un pot de tabac, garni de maryland."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b0db155-b27e-35a0-8472-d81d035846df",
                        "entry_id": "0b2d5a01-61e9-33b4-8511-9b003e0691fc",
                        "glosses": [
                            "Cigarette fabriquée avec ce tabac."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "45ee3e46-ee4e-4bd1-aa3b-865aba15f7da",
                                "sense_id": "2b0db155-b27e-35a0-8472-d81d035846df",
                                "text": "« C'est d'accord. Mais on ne refuse pas, à un homme pris, une cigarette ». Je lui en tends une. « Ah ! pouah ! des marylands. Je n'aime pas ça. »"
                            }
                        ]
                    }
