    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                "word": "concurrently",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                        "entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                        "glosses": [
                            "In a concurrent manner; at the same time."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f2b2d65-ac29-430e-8c4d-4ec1322e2d99",
                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                "text": "For the next four years Mr. Johnson continued building 2-4-0 express passenger engines, thus continuing the Kirtley practice, but from 1882 onwards he built all his express engines with the 4-4-0 or the 4-2-2 wheel arrangement, the two types being put in service concurrently between the years of 1887 and 1900."
                            },
                            {
                                "example_id": "461233ef-12db-4340-bda6-915f7743c915",
                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                "text": "Concurrently with the St. Pancras-Bedford service, diesel trains have now taken over that between Kentish Town and Barking, on an even-interval basis at half-hourly intervals."
                            },
                            {
                                "example_id": "4f057840-6f6a-4f67-bb2f-537ae2934bce",
                                "sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                                "text": "In many instances, the military was quite unable to distinguish right away between the Red Guard and Revolutionary organizations led by Maoist activists and those organized by Party officials whom Mao wished to topple, since both sides claimed to be dedicated to Mao’s policy. Furthermore, many military commanders were concurrently local administrators such as those in Tibet and Hsinchiang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b532d0d-f74e-44e4-a18b-2a5370b296dc",
                        "source_entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                        "source_sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                        "source_sense_description": "in a concurrent manner; at the same time",
                        "target_lang_word": "gleichzeitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gleichzeitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "zur selben/gleichen Zeit ablaufend, stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c49837d2-81c0-43cc-a8bf-242674918503",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "Ich kann nicht gleichzeitig an verschiedenen Orten sein."
                                            },
                                            {
                                                "example_id": "078a879a-2b28-4615-ae03-f171711d8851",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„Seit der Jahrtausendwende könne jedoch ein Rückgang der Deutschlernenden bei gleichzeitigem Anstieg der Englischlernenden festgestellt werden.“"
                                            },
                                            {
                                                "example_id": "66fadb38-67bc-437f-9ba9-54ecd3ade6e7",
                                                "sense_id": "a8549f11-bd07-3f0b-b50c-06c06684350d",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                        "entry_id": "75b4721e-8311-334d-a542-198fdc650611",
                                        "glosses": [
                                            "auch noch, daneben, zugleich"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd657abb-350d-46ca-8119-0ccc5303950c",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„K. wartete noch ein Weilchen, sah von seinem Kopfkissen aus die alte Frau, die ihm gegenüber wohnte und die ihn mit einer an ihr ganz ungewöhnlichen Neugierde beobachtete, dann aber, gleichzeitig befremdet und hungrig, läutete er.“"
                                            },
                                            {
                                                "example_id": "915b2cf7-ea87-4aec-a48f-a00c5ed5c151",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Er war Edelmann und gleichzeitig Prolet."
                                            },
                                            {
                                                "example_id": "23df94f1-c644-441c-994c-690d3d55ddf7",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "Unser Nachbar ist gleichzeitig unser Vermieter."
                                            },
                                            {
                                                "example_id": "dc804a4b-abf5-4711-804a-c64e6eb998a4",
                                                "sense_id": "dbdf29fb-4440-37d9-8487-2dd9142138d9",
                                                "text": "„Gleichzeitig könnte der Vulkanausbruch auch das Ende der Trichterbecherkultur in Skandinavien eingeläutet haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7785a92-c399-4b31-934b-1a0962d34bf1",
                        "source_entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                        "source_sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
                        "source_sense_description": "in a concurrent manner; at the same time",
                        "target_lang_word": "zeitgleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeitgleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                        "entry_id": "79838252-221e-3f74-abd9-b655383fcc2a",
                                        "glosses": [
                                            "zur gleichen Zeit seiend; gleichzeitig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600fecdc-4dda-4cee-a096-761b2b793bfb",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "Zeitgleich zur Neujahrsrede des Bürgermeisters findet auch ein Fußballturnier der F-Jugend und die Kindergeburtstagsfeier unserer Nachbarn statt."
                                            },
                                            {
                                                "example_id": "c2002cf8-c2eb-4d2e-8350-470d5e74e37b",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "„Ungeschickterweise verhedderte sich Hamilton fast zeitgleich in eine außereheliche Affäre.“"
                                            },
                                            {
                                                "example_id": "4843519f-269f-4359-83cf-28ba45bc8bde",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "[Tschetschenienkrieg 1994:] „Am 11.12.1994 marschierten nach gescheiterten Verhandlungen 40.000 russische Soldaten in Tschetschenien ein, zeitgleich wurde die Hauptstadt Grosny aus der Luft angegriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "946e2b43-5a02-357c-a90c-83246ed377b8",
                                        "entry_id": "79838252-221e-3f74-abd9-b655383fcc2a",
                                        "glosses": [
                                            "die gleich lange Zeitspanne in Anspruch nehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "397039e4-7409-4771-b7db-e923b380b9fb",
                                                "sense_id": "946e2b43-5a02-357c-a90c-83246ed377b8",
                                                "text": "Die Sieger der beiden nacheinander um 8:00 Uhr und um 8:15 Uhr gestarteten 100m-Vorläufe kamen zeitgleich mit jeweils 10,20 s ins Ziel"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2ff29b-80ee-4e2b-a659-83da74b483be",
                        "source_entry_id": "3d1c7fbe-64d5-331f-9272-eccb3c2c3501",
                        "source_sense_id": "d13fa454-6247-37c9-b5bf-6f1c5e99b120",
