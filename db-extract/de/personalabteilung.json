                        "source_sense_id": "97b08d8f-5730-3423-b034-885eb428181f",
                        "source_sense_description": "für die Mitarbeiter betreffende Angelegenheiten zuständige Einheit in einem Unternehmen",
                        "target_lang_word": "département des ressources humaines",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60925049-c3b9-429a-9dac-ab390f5a2356",
                        "source_entry_id": "f472c1a9-d3a1-3617-8209-fb31fc60c5a8",
                        "source_sense_id": "97b08d8f-5730-3423-b034-885eb428181f",
                        "source_sense_description": "für die Mitarbeiter betreffende Angelegenheiten zuständige Einheit in einem Unternehmen",
                        "target_lang_word": "ressources humaines",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ressources humaines",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c30b52e-7bb9-38a8-9929-1a54c8c24cdc",
                                        "entry_id": "44605914-b9d3-3113-a7a1-b5f58c7b37ad",
                                        "glosses": [
                                            "Ensemble des personnes qui travaillent pour une entreprise, une administration ou une organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c108fd42-49e8-4468-adcf-e8dacf7aab07",
                                                "sense_id": "8c30b52e-7bb9-38a8-9929-1a54c8c24cdc",
                                                "text": "Cependant, si argent et médicaments sont nécessaires, les ressources humaines sont indispensables pour dispenser les soins."
                                            },
                                            {
                                                "example_id": "0ccc70ef-31f1-40f5-aad7-dc159412a94d",
                                                "sense_id": "8c30b52e-7bb9-38a8-9929-1a54c8c24cdc",
                                                "text": "On en est venu à parler des hommes comme de « ressources humaines » en tant que travailleurs, comme s’ils devaient nourrir l’économie au lieu d’être nourris par elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8f9197-eab6-3e95-9d26-6cb991f51c3a",
                                        "entry_id": "44605914-b9d3-3113-a7a1-b5f58c7b37ad",
                                        "glosses": [
                                            "Activité de gestion du personnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d83e7f-2217-4370-a764-341e8e69cba7",
                                                "sense_id": "8f8f9197-eab6-3e95-9d26-6cb991f51c3a",
                                                "text": "Les ressources humaines ne constituent pas un secteur professionnel en soi, mais une activité transversale, présente dans tous les secteurs de l'économie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9600bbeb-9c00-37f1-937c-5f38b6cddfd7",
                                        "entry_id": "44605914-b9d3-3113-a7a1-b5f58c7b37ad",
                                        "glosses": [
                                            "Division d’une entreprise, d’une administration ou d’une organisation qui s’occupe de la gestion du personnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058f3cd9-36b9-4a2e-baaf-6009c73b530a",
                                                "sense_id": "9600bbeb-9c00-37f1-937c-5f38b6cddfd7",
                                                "text": "Il existe des programmes d'aide aux employés, mais comment cette personne pourrait aller voir les ressources humaines sans avoir peur d'être étiquetée ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
