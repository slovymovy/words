                "senses": [
                    {
                        "sense_id": "7607011a-7df6-3a28-b17e-9d4cc077a9a0",
                        "entry_id": "756ee4d8-b7c3-3ccd-91c5-affa03fad6c0",
                        "glosses": [
                            "Qui a rapport à l’urine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c152ed-5f2f-4c53-b681-c838d01f4f6a",
                                "sense_id": "7607011a-7df6-3a28-b17e-9d4cc077a9a0",
                                "text": "Fistule urinaire : un faux kyste urineux ou un épanchement urineux se traduit par l'existence d'une masse rétro-péritonéale liquidienne ou cloisonnée."
                            }
                        ]
                    },
                    {
                        "sense_id": "25081d5d-e62f-3339-b096-8024feb4de80",
                        "entry_id": "756ee4d8-b7c3-3ccd-91c5-affa03fad6c0",
                        "glosses": [
                            "De la nature de l'urine, qui a l'odeur de l'urine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cf25bdfd-365c-4fa3-a250-b0b8361c6b33",
                                "sense_id": "25081d5d-e62f-3339-b096-8024feb4de80",
                                "text": "Les sels alcalis sont nommés urineux, parce qu’ils ont la saveur de l’urine, il y en a de deux sortes, le volatil & le fixe."
                            },
                            {
                                "example_id": "f9d5e9d6-61f8-40c1-a859-2ceb02a655d0",
                                "sense_id": "25081d5d-e62f-3339-b096-8024feb4de80",
                                "text": "Chiqueurs et priseurs, surtout, prétendaient que le tabac qu'on leur vendait avait « une odeur urineuse »."
                            }
                        ]
                    }
                ],
