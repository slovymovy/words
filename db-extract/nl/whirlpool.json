                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a608cb2f-9cbd-4558-b58b-2afb70cbc024",
                                "sense_id": "56ef45cb-c73a-3d3d-9fa1-126bcb5e922d",
                                "text": "Het zwembad bestaat onder andere uit een recreatiebad, whirlpool, een 25-meter wedstrijdbad, peuter- en kleuterbad, twee glijbanen en een versnelde waterstroom, de Lazy River."
                            },
                            {
                                "example_id": "8942a62f-5da0-4821-8e30-aa688830b779",
                                "sense_id": "56ef45cb-c73a-3d3d-9fa1-126bcb5e922d",
                                "text": "Van Houdt snapte de consternatie daarover. \"We hebben dat niet handig naar buiten gebracht. We hadden moeten zeggen 'we nemen afscheid van het subtropisch zwembad met whirlpools en waterstromingen', zei Van Houdt."
                            }
                        ]
                    }
