                    {
                        "sense_id": "035dd33c-b246-32e4-bf9c-c513e2d9ee24",
                        "entry_id": "fe0d6e8a-cd66-3d99-a2e1-51d8f7b256c1",
                        "glosses": [
                            "Ottoman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144bb7e0-a71d-40bb-92c9-fb1f314ae3ea",
                                "sense_id": "035dd33c-b246-32e4-bf9c-c513e2d9ee24",
                                "text": "Avec la campagne de Perse, dont ni Mehmed Pacha ni le serasker Mustafa ne virent la fin, l’Empire osmanli atteignit les rivages de la mer Caspienne et de l’océan Indien."
                            },
                            {
                                "example_id": "98102cf2-e272-40ac-8fde-94f9aac5b3f7",
                                "sense_id": "035dd33c-b246-32e4-bf9c-c513e2d9ee24",
                                "text": "Les participes déclinables jouent un rôle très-important dans la langue osmanlie."
                            },
                            {
                                "example_id": "5c7b44bd-c1cf-4a89-a662-4356d4c7113d",
                                "sense_id": "035dd33c-b246-32e4-bf9c-c513e2d9ee24",
                                "text": "Qu'apportent à la compréhension des faits ces nouveaux spécialistes, qui peuvent souvent lire le vieux turc osmanli (en alphabet arabe)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
