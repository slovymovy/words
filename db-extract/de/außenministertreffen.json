                ],
                "senses": [
                    {
                        "sense_id": "8bd6fca0-40b0-3bb8-904c-50eaf7ea32dd",
                        "entry_id": "73765ff4-ce5b-3805-9517-b4fafe489c80",
                        "glosses": [
                            "Treffen verschiedener Außenminister"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3692f951-517d-4915-aa50-9865c1820131",
                                "sense_id": "8bd6fca0-40b0-3bb8-904c-50eaf7ea32dd",
                                "text": "„Auf einem Außenministertreffen kommende Woche sollen die USA und die Europäische Union (EU) das Thema mit Russland und der Ukraine beraten, wie die EU-Kommission am Dienstagabend mitteilte.“"
                            },
                            {
                                "example_id": "a8de8a78-3fa1-44f2-a029-81a216a4a18c",
                                "sense_id": "8bd6fca0-40b0-3bb8-904c-50eaf7ea32dd",
                                "text": "„[…] Die Beziehungen zu Russland sollen demnach beim nächsten Außenministertreffen im Juni erneut überprüft werden.“"
                            },
                            {
                                "example_id": "6ea1a180-88dc-4656-927c-1b6f0c54421d",
                                "sense_id": "8bd6fca0-40b0-3bb8-904c-50eaf7ea32dd",
                                "text": "„Die Versuche, beim Außenministertreffen in Paris eine Kontaktgruppe für die Ukraine zu bilden, sind vorerst gescheitert.“"
                            },
                            {
                                "example_id": "9540b0c1-ffe8-4ee0-bc10-399e529ce6d3",
                                "sense_id": "8bd6fca0-40b0-3bb8-904c-50eaf7ea32dd",
                                "text": "„Kurz vor Beginn des EU-Außenministertreffens in Luxemburg hat der türkische EU-Minister Europa zur Aufnahme syrischer Flüchtlinge aufgefordert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
