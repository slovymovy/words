                                        "entry_id": "36b26129-1c82-3ac7-a31f-f2ee2b21fd4c",
                                        "glosses": [
                                            "het besluiteloos zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3415d3-ac81-4a28-adf5-35bd4eeb15e9",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "De besluiteloosheid van de zwakke bestuurder deed het bedrijf weinig goed."
                                            },
                                            {
                                                "example_id": "cbfac6bf-165f-4fba-99e3-0c351a4d1180",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "De besluiteloosheid van de arts deed zijn patiënten weinig goed."
                                            },
                                            {
                                                "example_id": "7a607650-2186-4627-87f2-67bd5da21c4e",
                                                "sense_id": "1aa69a55-9e7f-382b-a39e-d4af44fc445d",
                                                "text": "Onzekerheid, besluiteloosheid, twijfel: de verschillende namen kwamen allemaal op hetzelfde neer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "754f8bae-1cd8-4507-b46c-41cba52c4438",
                        "source_entry_id": "2692b6c4-646d-3c8d-ae58-5aeb287f16b3",
