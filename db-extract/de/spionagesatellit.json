                "senses": [
                    {
                        "sense_id": "6b12fef5-840d-3aeb-aa31-44723864e807",
                        "entry_id": "6611bb64-1665-33a9-9b0c-801086c40f6b",
                        "glosses": [
                            "der militärischen Aufklärung dienender Satellit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a44ae233-0d83-450b-be71-e06e1b36a6f5",
                                "sense_id": "6b12fef5-840d-3aeb-aa31-44723864e807",
                                "text": "„Aus Kreisen zuständiger US-Behörden hieß es indes, Spionagesatelliten hätten zum möglichen Unglückszeitpunkt keine Explosionen im Luftraum registriert.“"
                            },
                            {
                                "example_id": "7a379814-f6a2-4134-a1f4-fe17142b2886",
                                "sense_id": "6b12fef5-840d-3aeb-aa31-44723864e807",
                                "text": "„Unklar ist, welche Schrottmengen von Killersatelliten stammen, die während des Kalten Krieges (und vielleicht auch noch heute) gegnerische Spionagesatelliten „neutralisierten“, sie also einfach rammten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
