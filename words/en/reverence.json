                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "I am at your service, Your <w>Reverence</w>."
                        },
                        {
                            "text": "The priest nodded when the parishioner addressed him as Your <w>Reverence</w>."
                        }
                    ],
                    "common_phrases": [
                        "Your Reverence"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
