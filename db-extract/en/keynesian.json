                                        "entry_id": "ebd574e8-ba2d-375d-a548-572a8767e256",
                                        "glosses": [
                                            "volgens de economische leer van John Maynard Keynes waarbij de regering een anticyclische begrotingspolitiek zou moeten voeren: grotere tekorten maken als er crisis is en bezuinigen als de economie groeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4615ec1-5cd2-4ad1-bb9f-7dfcc4c9a80a",
                                                "sense_id": "e7fe1cc9-5f17-3972-a629-4050f034c894",
                                                "text": "Die Zesde Republiek wil Hamon ook. En beiden willen keynesiaans meer geld uitgeven om de economie te stimuleren. Maar anderszins blijven er grote verschillen."
                                            }
                                        ]
                                    }
                                ]
                            }
