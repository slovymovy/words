        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "66a98055-2e9c-396e-ad0e-ee34d849ec09",
                "word": "promiscuity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ada0884c-1a7c-4235-af58-986b1ca0b6f4",
                        "entry_id": "66a98055-2e9c-396e-ad0e-ee34d849ec09",
