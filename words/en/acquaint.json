{
    "word_family": [
        "acquaintance",
        "acquainted"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a75c4b5-1d40-3cc1-bf18-f959f581a7c6",
                    "sense_definition": "To make someone familiar with or aware of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>acquaint</w> him with the new rules before the meeting starts.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>ознакомить</w> его с новыми правилами до начала собрания."
                            }
                        },
                        {
                            "text": "She needed time to <w>acquaint</w> herself with the complex software.",
                            "target_lang_translations": {
                                "ru": "Ей потребовалось время, чтобы <w>ознакомиться</w> со сложным программным обеспечением."
                            }
                        }
                    ],
                    "synonyms": [
                        "familiarize"
                    ],
                    "common_phrases": [
                        "acquaint with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо осведомленным о чем-либо или познакомить с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ознакомить",
                                "target_lang_sense_clarification": "предоставить информацию или дать сведения о чем-либо"
                            },
                            {
                                "target_lang_word": "познакомить",
                                "target_lang_sense_clarification": "ввести в курс дела или представить информацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5060efc4-ceae-3c65-b21f-5952f517196e",
                    "sense_definition": "To give information or notice to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>acquaint</w> the staff with the changes to the schedule immediately.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, немедленно <w>уведомьте</w> персонал об изменениях в расписании."
                            }
                        },
                        {
                            "text": "He wrote a letter to <w>acquaint</w> his family with his safe arrival.",
                            "target_lang_translations": {
                                "ru": "Он написал письмо, чтобы <w>известить</w> свою семью о своем благополучном прибытии."
                            }
                        }
                    ],
                    "synonyms": [
                        "inform",
                        "apprise"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is formal and often found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставить информацию или уведомить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уведомить",
                                "target_lang_sense_clarification": "официально сообщить о чем-либо"
                            },
                            {
                                "target_lang_word": "известить",
                                "target_lang_sense_clarification": "передать информацию или сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1926936-e28c-31b2-b767-2bef1ba4497f",
                    "sense_definition": "To cause someone to become accustomed to something through experience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The training program helps to <w>acquaint</w> new employees with the company culture.",
                            "target_lang_translations": {
                                "ru": "Программа обучения помогает <w>ознакомить</w> новых сотрудников с корпоративной культурой."
                            }
                        },
                        {
                            "text": "It takes time to <w>acquaint</w> oneself with the harsh climate of the north.",
                            "target_lang_translations": {
                                "ru": "Требуется время, чтобы <w>привыкнуть</w> к суровому климату севера."
                            }
                        }
                    ],
                    "synonyms": [
                        "to accustom",
                        "to familiarize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помочь кому-либо привыкнуть к чему-либо через опыт."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приучить",
                                "target_lang_sense_clarification": "сделать привычным через практику"
                            },
                            {
                                "target_lang_word": "адаптировать",
                                "target_lang_sense_clarification": "помочь приспособиться к новым условиям"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}