{
    "word_family": [
        "tingle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e317690-8417-3ad0-aa47-df2b096e2b19",
                    "sense_definition": "A slight prickling or stinging sensation on the skin, often described as pins and needles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a strange <w>tingling</w> in her fingers after sitting in the same position for too long.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала странное <w>покалывание</w> в пальцах после того, как слишком долго просидела в одной позе."
                            }
                        },
                        {
                            "text": "The cold wind caused a sharp <w>tingling</w> on his cheeks as he walked home.",
                            "target_lang_translations": {
                                "ru": "Холодный ветер вызвал резкое <w>покалывание</w> на его щеках, пока он шел домой."
                            }
                        }
                    ],
                    "synonyms": [
                        "prickle"
                    ],
                    "common_phrases": [
                        "slight tingling",
                        "constant tingling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкое покалывание или жжение на коже, часто описываемое как ощущение «мурашек» или онемения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывание",
                                "target_lang_sense_clarification": "общее ощущение легкого раздражения кожи"
                            },
                            {
                                "target_lang_word": "мурашки",
                                "target_lang_sense_clarification": "ощущение бегающих по коже мелких покалываний"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36482c15-547f-3280-9872-a60972272a18",
                    "sense_definition": "Present participle and gerund of <w>tingle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her skin was <w>tingling</w> from the excitement of the surprise party.",
                            "target_lang_translations": {
                                "ru": "Ее кожа <w>покалывала</w> от волнения из-за вечеринки-сюрприза."
                            }
                        },
                        {
                            "text": "The <w>tingling</w> sensation in his feet started to fade once he began walking again.",
                            "target_lang_translations": {
                                "ru": "Ощущение <w>покалывания</w> в ступнях начало проходить, как только он снова начал ходить."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund of tingle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «покалывать» или «ощущать покалывание»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покалывающий",
                                "target_lang_sense_clarification": "причастие, описывающее состояние кожи"
                            },
                            {
                                "target_lang_word": "покалывание",
                                "target_lang_sense_clarification": "герундий, обозначающий процесс ощущения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}