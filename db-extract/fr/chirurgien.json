                        "form_id": "b169f9a0-3cef-4d82-88e7-21581e405db9",
                        "entry_id": "6ae0e669-ac4b-36f5-98f0-1778ed4403e2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "chirurgienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                        "entry_id": "6ae0e669-ac4b-36f5-98f0-1778ed4403e2",
                        "glosses": [
                            "Celui qui pratique la chirurgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbccbc1e-ac77-4684-9a39-69c32f4d66b5",
                                "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                                "text": "Deux sortes de personnes contractent nécessairement beaucoup d'insensibilité : les chirurgiens, les prêtres. A voir toujours souffrir et mourir, on meurt peu à peu soi-même dans les facultés sympathiques."
                            },
                            {
                                "example_id": "b2eab59d-c748-4055-b56e-f958ba1ebfb0",
                                "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                                "text": "Scaër s'approcha du lit d'Alain qui était entre les mains du chirurgien et de ses aides, […]."
                            },
                            {
                                "example_id": "a03bd2dc-a5be-4ad3-bc02-37054fc0ad2f",
                                "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                                "text": "On ne compte plus les bonnes fortunes des chirurgiens à la mode. Ils prennent rang aussitôt après les cabotins du genre comique, un peu avant les cabotins du genre grave."
                            },
                            {
                                "example_id": "63b5c523-bd96-45b5-bbb0-3196bb23389a",
                                "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                                "text": "— On serait livré par drone et soigné avec le dernier cri de la technologie médicale : robots chirurgiens, thérapies cellulaires et thérapies géniques."
                            },
                            {
                                "example_id": "2c716b48-94c2-4f79-b92f-3cde03665752",
                                "sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                                "text": "Au ministère, tout le monde déplorait qu'un chirurgien de son envergure en fût réduit à prescrire des cachets d'aspirine dans un dispensaire de banlieue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18281760-5633-4fc1-ad64-9bf9a1bfaf23",
                        "source_entry_id": "6ae0e669-ac4b-36f5-98f0-1778ed4403e2",
                        "source_sense_id": "2dcff115-65ab-3d58-8aa7-6ab65106371d",
                        "source_sense_description": "Celui qui pratique la chirurgie",
                        "target_lang_word": "Chirurg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chirurg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                        "entry_id": "35e7c20d-ba63-3572-ab1c-6160a1e5a67c",
                                        "glosses": [
                                            "Facharzt für operative Heilbehandlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f625755b-5880-4e65-805f-0b1a69f31559",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "Knochenbrüche sind eine Aufgabe für Chirurgen."
                                            },
                                            {
                                                "example_id": "9bd23140-e0a9-4b89-ad15-6b1381ad3ce6",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Valenti besaß jene Selbstsicherheit, die für berühmte Chirurgen charakteristisch ist, und er war ein vollendeter Showmann.“"
                                            },
                                            {
                                                "example_id": "895ad9c8-1cdc-465b-a472-53895e2ca577",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Bei stark übergewichtigen Menschen können Chirurgen den Magen verkleinern, damit weniger Nahrung hineinpasst.“"
                                            },
                                            {
                                                "example_id": "852bddf2-ffd4-4ed4-8273-fd93e5236b3f",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Keine zehn Minuten später streckt mir ein jüngerer Chirurg seine verschwitzte Hand entgegen.“"
                                            },
                                            {
                                                "example_id": "7353c05d-e07b-4846-bcfa-44bdf71193ab",
                                                "sense_id": "e70a2934-88b2-3856-bf38-00333b68e132",
                                                "text": "„Nur wenige Patienten besitzen die edle Einfalt des Grafen Bobby, der soeben erfahren hat, daß sich ein berühmter Chirurg den Blinddarm eigenhändig herausnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cb897d6-1e83-4b31-812d-c6115dbc61b2",
                        "source_entry_id": "6ae0e669-ac4b-36f5-98f0-1778ed4403e2",
