                ],
                "senses": [
                    {
                        "sense_id": "456b4f15-6729-38cc-90af-f4d9ba575427",
                        "entry_id": "be222410-6cda-32b8-84c9-c65a8a16fa75",
                        "glosses": [
                            "der mit Luft gefüllte Raum über der Erdoberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8d3e20-836c-4e10-972e-127f81f8dd53",
                                "sense_id": "456b4f15-6729-38cc-90af-f4d9ba575427",
                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                            },
                            {
                                "example_id": "77a5eae2-5f8a-477a-b7b7-32237b608aa0",
                                "sense_id": "456b4f15-6729-38cc-90af-f4d9ba575427",
                                "text": "In den Luftraum über Flughäfen darf nur mit Transponder eingeflogen werden."
                            },
                            {
                                "example_id": "8f2959e6-42be-4865-8af0-df9264131b81",
                                "sense_id": "456b4f15-6729-38cc-90af-f4d9ba575427",
                                "text": "IFR (engl. instrument flight rules) Flüge haben im Luftraum E kein generelles Vorflugrecht."
                            },
                            {
                                "example_id": "14067ab1-9b3a-49b7-966b-bbcf9fbe29e9",
                                "sense_id": "456b4f15-6729-38cc-90af-f4d9ba575427",
                                "text": "„Aber meine Gefühle verflogen irgendwo im Luftraum zwischen Iran und Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65151cec-d787-392f-871a-1b556535c348",
