                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00298e38-1381-4995-8961-a0406740789d",
                        "source_entry_id": "5675d98e-7cc9-3b23-9470-cd7a7dbb7487",
                        "source_sense_id": "bfbc32a4-1e18-3c83-a512-3d0025ec8885",
                        "target_lang_word": "simbolismo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "43ffdace-bf12-4cff-be23-8394f63e7426",
                        "source_entry_id": "5675d98e-7cc9-3b23-9470-cd7a7dbb7487",
                        "source_sense_id": "bfbc32a4-1e18-3c83-a512-3d0025ec8885",
                        "target_lang_word": "символи́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "символи́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1dda16c1-1b3a-3eeb-a7a5-ebb0c0b14daa",
                                        "entry_id": "e460a001-79f3-3833-bb49-a15a3c5a3519",
                                        "glosses": [
                                            "искусств. направление в искусстве и литературе, возникшее в конце XIX века и объявившее основным художественным приёмом символ как выразитель непостижимой сущности предметов и явлений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "797dc74e-c92b-4d60-8ecf-a7f5431bff17",
                                                "sense_id": "1dda16c1-1b3a-3eeb-a7a5-ebb0c0b14daa",
                                                "text": "Бодлер развил некоторые мысли, которые Эдгар По не успел высказать или не имел времени договорить, придал символизму особую окраску; которая получила в истории литературы наименование декадентской, и написал целый ряд самостоятельных стихотворений, расширяющих область символической поэзии."
                                            },
                                            {
                                                "example_id": "633adda6-2475-4c4e-b1ac-7badc235de3c",
                                                "sense_id": "1dda16c1-1b3a-3eeb-a7a5-ebb0c0b14daa",
                                                "text": "Французский символизм, родоначальник всего символизма как школы, выдвинул на передний план чисто литературные задачи: свободный стих, более своеобразный и зыбкий слог, метафору, вознесенную превыше всего, и пресловутую «теорию соответствий»."
                                            },
                                            {
                                                "example_id": "ed786f7e-15ae-449d-96d4-6ba449b41bc1",
                                                "sense_id": "1dda16c1-1b3a-3eeb-a7a5-ebb0c0b14daa",
                                                "text": "Внутреннее развитие той поэтической школы, которая возникла у нас в девяностых годах минувшего столетия и известна под именами «декадентства», «модернизма» и «символизма» (в узком значении слова), надо признать законченным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ab3ee9b-5193-337d-b8aa-537a1b4b5f8f",
                                        "entry_id": "e460a001-79f3-3833-bb49-a15a3c5a3519",
                                        "glosses": [
                                            "символическое значение, приписываемое чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a0139e0-989c-449a-be38-b62ed2ba0f06",
                                                "sense_id": "6ab3ee9b-5193-337d-b8aa-537a1b4b5f8f",
                                                "text": "Отточенная композиция картины, выверенная пластика фигур, ритм движения рук, сблизившихся в центре полотна, не касаясь друг друга ― всё это придаёт изображению встречи Марии Магдалины с Иисусом Христом почти эмблематическую форму, полную скрытого символизма, потаённых, сакральных смыслов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "346c1b25-5cd9-47c9-b69a-81e838442e4e",
                        "source_entry_id": "5675d98e-7cc9-3b23-9470-cd7a7dbb7487",
                        "source_sense_id": "bfbc32a4-1e18-3c83-a512-3d0025ec8885",
                        "target_lang_word": "simbolismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simbolismo",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "ab279580-1c31-3510-b712-2adfbf62919d",
                                        "entry_id": "96f3992c-58e1-3fe4-b5ac-ab5178f02e1c",
                                        "glosses": [
                                            "movimento culturale nato in Francia nella seconda metà del diciannovesimo secolo, che proponeva l'uso dei simboli e dell'intuizione poetica per capire gli aspetti meno evidenti della realtà"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38ef9e5d-909a-390b-b342-c2d15a5a6357",
                                        "entry_id": "96f3992c-58e1-3fe4-b5ac-ab5178f02e1c",
                                        "glosses": [
                                            "correlazione tra più elementi simili e loro comprensione attraverso una ricerca intellettiva trascendentale"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d16d83-2542-47f1-96dc-48523095fe4b",
                                                "sense_id": "38ef9e5d-909a-390b-b342-c2d15a5a6357",
                                                "text": "nello studio di un testo, l'individuazione del simbolismo permette di trascendere il significato letterale scorgendo quindi una verità più sottile"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "092de1d3-38a3-3c7c-9b9f-d0e0dea04943",
                                        "entry_id": "96f3992c-58e1-3fe4-b5ac-ab5178f02e1c",
                                        "glosses": [
                                            "simbolismo religioso: nel cattolicesimo si riferisce ai gesti abitudinari quali il segno della croce fatto con il movimento delle mani, l'uso dell'ostia, alcune ricorrenze stesse, ecc"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44b08fce-e957-3a3b-81b7-25f5964b604a",
                                        "entry_id": "96f3992c-58e1-3fe4-b5ac-ab5178f02e1c",
                                        "glosses": [
                                            "significato colto attraverso l'indagine di figure più o meno complesse, siano esse geometriche o semi-artistiche, dunque al di là dell'apparenza estetica visibile ad occhio nudo"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f41820d-34a2-4d80-88ed-d055617aa41c",
                                                "sense_id": "44b08fce-e957-3a3b-81b7-25f5964b604a",
                                                "text": "una parte della massoneria si occupa del simbolismo di elementi composti"
                                            }
                                        ]
                                    }
                                ]
                            }
