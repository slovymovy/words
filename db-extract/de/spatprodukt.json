                        "entry_id": "ebe86eb5-ba41-3c43-a30f-30f83b3a04f4",
                        "glosses": [
                            "vektorielle Multiplikation zweier Vektoren und darauffolgende skalare Multiplikation des Ergebnisses mit einem dritten Vektor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deead40b-7dd4-466d-a0b2-05c33a962511",
                                "sense_id": "4b5d8356-da85-35e2-b5cb-275f9aeb9956",
                                "text": "„Die Kombination aus dem vektoriellen und dem skalaren Produkt führt zum Spatprodukt.“"
                            },
                            {
                                "example_id": "ff99bc44-5520-45a1-ba7e-bdbf56ee1636",
                                "sense_id": "4b5d8356-da85-35e2-b5cb-275f9aeb9956",
                                "text": "„Da dieses Vektorprodukt das Volumen eines Parallelepipeds (Spat) angibt, heißt es manchmal auch Spatprodukt.“"
                            },
                            {
                                "example_id": "33751820-4282-46e2-82be-f84d5952f3cd",
                                "sense_id": "4b5d8356-da85-35e2-b5cb-275f9aeb9956",
                                "text": "„Da wir nun mit dem Spatprodukt umgehen können, wird auch die Berechnung der Ebenengleichung recht übersichtlich..“"
                            }
                        ],
