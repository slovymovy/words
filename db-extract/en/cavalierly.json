                        "glosses": [
                            "In a cavalier manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb129914-7876-445e-82cd-5367264edcb8",
                                "sense_id": "a9d1adc6-5605-35e5-82a4-ef1c93303ed8",
                                "text": "Louis's brow wore its deepest gloom as he said, \"There are few in yonder room who would so cavalierly reject my love.\""
                            },
                            {
                                "example_id": "8b830183-1ef2-4f77-ab04-74ff4e02e6ab",
                                "sense_id": "a9d1adc6-5605-35e5-82a4-ef1c93303ed8",
                                "text": "He had, he felt, treated Mrs Hubbard rather cavalierly."
                            },
                            {
                                "example_id": "a10e6bcc-db02-4d9f-8da8-f153e07bee61",
                                "sense_id": "a9d1adc6-5605-35e5-82a4-ef1c93303ed8",
                                "text": "Far from marking the outer edge of the solar system, as those school-room maps so cavalierly imply, Pluto is barely one fifty-thousandth of the way."
                            }
                        ]
                    }
                ],
