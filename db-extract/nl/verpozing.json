                                        "sense_id": "cffd0524-2e66-3f72-a743-8dfc13a343a9",
                                        "entry_id": "9ee8a3b6-6c1f-3f4e-ae43-cc290412a1a5",
                                        "glosses": [
                                            "To take a temporary rest, take a break for a short period after an effort."
                                        ],
