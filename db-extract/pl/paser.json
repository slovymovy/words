                                "target_senses": [
                                    {
                                        "sense_id": "ffedaf9b-bccb-37f7-982e-db44323044cc",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "An official whose job is to receive taxes or other monies; a tax collector, a treasurer."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ce1e7b6-a895-32a5-914b-4eb3b0a03d5f",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "A person who receives something in a general sense; a recipient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9485474-2aca-43d2-a922-40ff77cf9bd1",
                                                "sense_id": "7ce1e7b6-a895-32a5-914b-4eb3b0a03d5f",
                                                "text": "I, the writer of this paper, have been, for some time, a chosen receiver of Begging Letters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d8e156f-4436-3acb-8c1c-374bfb3e3da5",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "A person who accepts stolen goods."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a79cb2c-f759-3c2f-bcea-4d17b59a6b91",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "A person or company appointed to settle the affairs of an insolvent entity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5dd3fa1-c537-4944-8630-4e892018c419",
                                                "sense_id": "7a79cb2c-f759-3c2f-bcea-4d17b59a6b91",
                                                "text": "It took the name Midland & South Western Junction in 1884 and reached Cheltenham, with its M.R. connection, in 1891; but poverty continued - a receiver had been appointed in 1884."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1ce5041-098b-3760-95be-3a498c2d7cb8",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "An offensive player who catches the ball after it has been passed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45baba83-e0c9-3925-a319-565997398806",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "A person who receives.",
                                            "A person who attempts to return the serve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "103ff32c-4e45-315a-9926-513ff65e7953",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "Something which receives some substance or object, in a general sense; a receptacle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "593bce48-8d61-33b8-9e72-0475ede20007",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "A vessel for receiving and holding the products of distillation, or for containing gases."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bdd58ca-5b8a-37a3-9fc2-b8c9eb3f34df",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "An airtight vessel from which air is pumped in order to form a vacuum."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c21660-a8fb-45be-8fc0-c60667857f8e",
                                                "sense_id": "9bdd58ca-5b8a-37a3-9fc2-b8c9eb3f34df",
                                                "text": "A man can live in thick air, but perishes in an exhausted receiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1c26cae-9656-31ad-965a-476cc6edc6c2",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "The part of a firearm containing the action."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b86de438-e182-37b4-9970-a026198e6d3c",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "A vessel for receiving the exhaust steam from the high-pressure cylinder before it enters the low-pressure cylinder, in a compound steam engine."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "835b8e43-a34c-334f-b680-2d2eb4474c7a",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "Any of several electronic devices that receive electromagnetic waves, or signals transmitted as such."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5aed0c-e28a-4df4-8800-89c4dd9f6533",
                                                "sense_id": "835b8e43-a34c-334f-b680-2d2eb4474c7a",
                                                "text": "The FCC says it decided to attempt standardization of VHF receivers after getting \"thousands of complaints\" from disgruntled boatmen who found their sets brought in mostly a lot of garble and static."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130c5030-e80a-3f14-92f3-a7e857058f35",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "The part of a telephone handset contained in the earpiece; (hence) the handset itself; an earpiece."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34626396-4364-4fa0-83c8-4e768279afa6",
                                                "sense_id": "130c5030-e80a-3f14-92f3-a7e857058f35",
                                                "text": "There they waited until after eleven, then Paulvitch took down the receiver of their telephone. He called a number."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09201ea5-eedd-39d1-8df0-1dd6e3e75e87",
                                        "entry_id": "c0a4a85c-9a96-3deb-a8e9-27ed631b96e9",
                                        "glosses": [
                                            "An item or apparatus that receives.",
                                            "A swaption which gives its holder the option to enter into a swap in which they pay the floating leg and receive the fixed leg."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f63a8f95-9a8b-4783-afa8-8013b9338b62",
                        "source_entry_id": "70e68905-7409-3f2e-88fc-2fbcff911a68",
                        "source_sense_id": "836fac49-4a07-3b40-a8c0-a77552b2c1c8",
                        "target_lang_word": "Hehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                        "entry_id": "b87801c3-aa1d-3f35-a3ca-dd9088ed5f58",
                                        "glosses": [
                                            "Person, die gestohlenes Gut verkauft oder anders verwertet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1759e2ca-a285-41e5-aa5c-7163ad10ec8f",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "Auch wer gestohlene Sachen unwissentlich billig kauft und dann weiterverkauft, kann als Hehler bestraft werden."
                                            },
                                            {
                                                "example_id": "a1ca09d1-75c4-4a75-bfa3-ff4bec992a31",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "„Stevenson erfaßte statt seiner den Sohn, der ebenfalls herbeigesprungen war, den Verbrecher zu halten; ein zweiter Blitz verriet ihnen aber die fliehende Gestalt des Hehlers, und auch Weston, den die erste Überraschung fast gelähmt hatte, floh der Stelle zu, auf der sie eben die Umzäunung betreten.“"
                                            },
                                            {
                                                "example_id": "dbbfc3f0-fe3b-43f0-ae1d-aced03a6c122",
                                                "sense_id": "1c4a3e60-d1dd-3546-ac5c-22c15a37ba45",
                                                "text": "„Luigi sah aus wie der Schauspieler Orson Welles, betrieb ein kleines, schmutziges Freßlokal und war außerdem Hehler, Fälscher und Bandenchef.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
