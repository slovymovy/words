                "senses": [
                    {
                        "sense_id": "422c62be-5503-386a-82ed-a59b4610128e",
                        "entry_id": "a9e171fb-d4bb-39b3-bc6a-8ea62f3da5ce",
                        "glosses": [
                            "frittierte Kartoffelstäbchen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f8e1ab2a-54ce-4891-a6c8-d264b8630a81",
                                "sense_id": "422c62be-5503-386a-82ed-a59b4610128e",
                                "text": "Eine Portion Pommes mit Ketchup bitte!"
                            },
                            {
                                "example_id": "a78ce57a-93ac-4fc4-a4f6-26926e77b749",
                                "sense_id": "422c62be-5503-386a-82ed-a59b4610128e",
                                "text": "„Seinen Freunden erzählte er diese Geschichten mit Genuss, und Roth hörte gut zu und schrieb später über Portnoys »lüsternen Klassenkameraden Smolka, den Schneidersohn« und den an einem Dickdarmkatarrh leidenden, Pommes essenden Melvin Weiner.“"
                            },
                            {
                                "example_id": "d42104d1-3462-4bf7-8ae7-618125b344f1",
                                "sense_id": "422c62be-5503-386a-82ed-a59b4610128e",
                                "text": "„Hin und wieder saß er in der Cafeteria, wo er Musik von seinem iPod hörte und Pommes aß, aber ansonsten sah man ihn nie außerhalb seines Büros.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
