                                "target_lang_sense_clarification": "o jedzeniu (np. makaron, owsianka)"
                            },
                            {
                                "target_lang_word": "dania gotowe",
                                "target_lang_sense_clarification": "w kontekście produktów typu instant"
                            }
                        ],
                        "tr": [
