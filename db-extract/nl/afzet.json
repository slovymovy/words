                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
                                        "glosses": [
                                            "The desire to purchase goods and services."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "140038c6-6e20-4a36-bb32-367ba8e97341",
                                                "sense_id": "8882f474-b9fb-386d-b778-86dd7af2cfef",
                                                "text": "Prices usually go up when demand exceeds supply."
                                            },
                                            {
                                                "example_id": "f6eebb99-5dc1-4eee-8a83-a8fcf4fdf980",
                                                "sense_id": "8882f474-b9fb-386d-b778-86dd7af2cfef",
                                                "text": "Nevertheless, it is clear that the global energy demand for air-conditioning will grow substantially as nations become more affluent, with the consequences of climate change potentially accelerating the demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eecc807-9103-3afe-923f-8a862905726c",
                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
                                        "glosses": [
                                            "The amount of a good or service that consumers are willing to buy at a particular price."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "63b5a266-32ea-3a6f-b6ab-c64230a7491f",
                                        "entry_id": "f37a4905-2e9e-38a6-b672-e0efb91c6f7f",
                                        "glosses": [
                                            "A forceful claim for something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
