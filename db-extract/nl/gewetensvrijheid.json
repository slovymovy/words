                "senses": [
                    {
                        "sense_id": "b301d650-b475-34d0-9251-3ec528a9acd9",
                        "entry_id": "932f3de1-46e1-3a0d-81c9-41980d470d7f",
                        "glosses": [
                            "de vrijheid naar het eigen morele kader te kunnen handelen, zodat er geen gewetensnood optreedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d613f850-161a-4576-9132-09316cc5d1cd",
                                "sense_id": "b301d650-b475-34d0-9251-3ec528a9acd9",
                                "text": "Aan zijn reactionaire vriend en uitgever Aleksej Soevorin schreef Tsjechov tijdens de Dreyfus-affaire over hun vaderland: 'Een Aziatisch land, waar geen pers- en gewetensvrijheid bestaat, waar de regering en negen tiende van de ontwikkelden een journalist beschouwen als een vijand, waar zo bekrompen en beroerd geleefd wordt en weinig hoop bestaat op betere tijden.'"
                            },
                            {
                                "example_id": "d9d03073-1d51-4fe0-9d14-96fdc3cad300",
                                "sense_id": "b301d650-b475-34d0-9251-3ec528a9acd9",
                                "text": "In een brief aan de Tweede Kamer schrijft de minister dat hij onder meer wil weten hoe deze organisaties aankijken tegen \"fundamentele waarden als seksegelijkheid, zelfbeschikkingsrecht, individuele keuzevrijheid en gewetensvrijheid\"."
                            },
                            {
                                "example_id": "69321b62-7160-472e-825a-a1902a77100e",
                                "sense_id": "b301d650-b475-34d0-9251-3ec528a9acd9",
                                "text": "Voor het eerst in haar eeuwenlange geschiedenis sprak de katholieke kerk zich uit voor godsdienst- en gewetensvrijheid, en voor democratie. Ook sprak de kerk zich uit tegen de kernwapenwedloop, die op dat moment plaatsvond."
                            }
                        ]
                    }
