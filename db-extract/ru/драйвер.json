                        ],
                        "form": "драйвера́х"
                    },
                    {
                        "form_id": "f17b489d-c3be-499a-85a0-559c494d64bc",
                        "entry_id": "52786f09-a974-38a2-bfad-41d326c6d735",
                        "tags": [
                            "plural",
