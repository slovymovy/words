                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c90c2237-e85d-46f7-b767-c63c73b7d3f3",
                        "source_entry_id": "4893df5e-5054-3c19-bf29-0a867c1b97fd",
                        "source_sense_id": "f0abde40-5e80-3781-ba6d-d252c17040f2",
