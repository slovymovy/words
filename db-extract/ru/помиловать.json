                                        "entry_id": "d634af06-97b7-3beb-b0e6-7213bba75436",
                                        "glosses": [
                                            "To show mercy or compassion; to stop inflicting punishment or a barrage."
                                        ],
                                        "tags": [
                                            "imperative",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "083ad12c-0fc1-4876-9d24-b1e4b17bafa4",
                                                "sense_id": "71a43319-8477-3093-9bc2-c66c98686b6a",
                                                "text": "\"I have learnt it!\" cried the old man. \"Oh, have mercy on me in this hour, if, in my love for her, so young and good, I slandered Nature in the breasts of mothers rendered desperate! Pity my presumption, wickedness, and ignorance, and save her!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
