                "translations": [
                    {
                        "translation_id": "5143e340-8397-4d48-be51-7c062d4f4df7",
                        "source_entry_id": "05f4510b-63e2-30e5-854c-4c7b9b4fa876",
                        "source_sense_id": "2ac7666e-3c73-30fa-8639-81faf7a6924a",
                        "target_lang_word": "vieillir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieillir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Devenir vieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffa8084-83fd-4859-a254-48800e39163b",
                                                "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                                "text": "Elle se regarda machinalement dans la glace. Elle se dit qu'elle vieillissait, lentement et sûrement."
                                            },
                                            {
                                                "example_id": "bf95cbc4-2694-4a68-ab9d-27da6f445786",
                                                "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                                "text": "Vieillir est sot, ne nous laissons pas abuser par les belles maximes des songe-creux bibliques."
                                            },
                                            {
                                                "example_id": "070d707b-5e3c-4840-8b9d-a97184732a78",
                                                "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                                "text": "Choisir un roi jeune, beau et bien portant n'empêchait pas qu'il vieillît, enlaidît, tombât malade, ni qu'il perdît ses vertus, ses qualités morales – bref, qu'il changeât et cessât d'être adéquat."
                                            },
                                            {
                                                "example_id": "8d392a5f-9710-4de4-8303-a4a0edee48fa",
                                                "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                                "text": "De même les infortunés chrononautes de Temps mort (G. Langelaan) vieillissent en quelques minutes de plusieurs dizaines d'années : tel est le risque d’accident temporel qui attend les pionniers de l'espace-temps."
                                            },
                                            {
                                                "example_id": "b8268274-a02d-426a-a2d2-5066f85c02ad",
                                                "sense_id": "a9bc6c1d-fc6c-3ad2-8cb2-6eab286a5d69",
                                                "text": "C'est pas le fun vieillir, mais c'est la seule façon de vivre longtemps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2cd8cbe-3628-31f1-92e7-d9f95c2ee248",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Paraître vieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e749b03-dc94-435e-b8d4-fb310f00d05d",
                                                "sense_id": "d2cd8cbe-3628-31f1-92e7-d9f95c2ee248",
                                                "text": "Si je ne vieillis pas, gamin, c'est que je bois la sève des bouleaux au printemps. Ça dépure, ça fait pisser par pintes."
                                            },
                                            {
                                                "example_id": "9abb9f73-4ad2-4483-a21a-5d39f0ef52d9",
                                                "sense_id": "d2cd8cbe-3628-31f1-92e7-d9f95c2ee248",
                                                "text": "Il a bien vieilli depuis deux ans."
                                            },
                                            {
                                                "example_id": "1d9c4ecf-5426-4adc-833a-63d0e1d4cca9",
                                                "sense_id": "d2cd8cbe-3628-31f1-92e7-d9f95c2ee248",
                                                "text": "Il est frais et gaillard, il ne vieillit pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96977553-bfbc-3614-a7fa-7fd86fef0753",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Perdre de sa force, de sa vigueur avec le temps, en parlant de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ecc380c-65d2-47c7-96be-e2cf6bd61ef4",
                                                "sense_id": "96977553-bfbc-3614-a7fa-7fd86fef0753",
                                                "text": "L’esprit vieillit comme le corps."
                                            },
                                            {
                                                "example_id": "7c90ba0f-de91-4761-a9ad-635a1046939e",
                                                "sense_id": "96977553-bfbc-3614-a7fa-7fd86fef0753",
                                                "text": "Son talent commence à vieillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48757ab0-fed8-3df8-93f3-300e07b7a0f1",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Murir, perdre de la verdeur et acquérir certaines qualités, en parlant du vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588e5eb1-0265-4e0b-9a8d-e87c6167e4fa",
                                                "sense_id": "48757ab0-fed8-3df8-93f3-300e07b7a0f1",
                                                "text": "Ce vin a besoin de vieillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Commencer à n’être plus d’usage, à passer, à perdre de sa vogue, de son importance, de son utilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad42ccd-cff9-4f74-a996-d14fa8adb267",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "La traduction de Lefèvre d’Etaples m’a paru très belle, mais d’une beauté quelquefois bizarre, et là où elle a le plus vieilli, elle a mal vieilli."
                                            },
                                            {
                                                "example_id": "6c725977-c0be-4f78-a434-42954b52fc61",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "Ce mot, ce terme a beaucoup vieilli."
                                            },
                                            {
                                                "example_id": "afcf37db-fa35-482f-90f1-55ed853d922e",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "Cette locution, cette expression vieillit."
                                            },
                                            {
                                                "example_id": "275f5ba3-eaa9-4df1-a545-3b638f185c6f",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "Le style de cet ouvrage a vieilli."
                                            },
                                            {
                                                "example_id": "a783ca4e-953c-4b02-821c-045195138b65",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "Cette mode vieillit."
                                            },
                                            {
                                                "example_id": "ea127361-03c0-4ad9-9fd2-d2050d6b7660",
                                                "sense_id": "1e8307dc-632d-3c26-8ea4-b54206545b68",
                                                "text": "Ce traité de physique a bien vieilli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf65db23-f6f0-3168-aa2e-26e3e8be40b7",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Demeurer très longtemps dans une fonction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec90013-4b84-465d-bd35-9f2b9e6c73bc",
                                                "sense_id": "bf65db23-f6f0-3168-aa2e-26e3e8be40b7",
                                                "text": "Il a vieilli dans le service, dans les affaires, dans un emploi, dans un poste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb62be2a-10b3-356a-be9d-36f0f6efdca3",
                                        "entry_id": "e0206e7e-d893-371a-b019-be53f002686d",
                                        "glosses": [
                                            "Rendre vieux, faire paraître plus âgé que l’on n’est."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccea655e-4755-4b83-9877-b57bc0c14434",
                                                "sense_id": "bb62be2a-10b3-356a-be9d-36f0f6efdca3",
                                                "text": "Les chagrins l’ont bien vieilli."
                                            },
                                            {
                                                "example_id": "2388e5c3-d670-4f0d-9327-0588677ddff5",
                                                "sense_id": "bb62be2a-10b3-356a-be9d-36f0f6efdca3",
                                                "text": "Six mois de captivité l’ont vieilli de dix ans."
                                            },
                                            {
                                                "example_id": "a835aae4-a0df-4c44-b481-66210b058847",
                                                "sense_id": "bb62be2a-10b3-356a-be9d-36f0f6efdca3",
                                                "text": "Cette coiffure vous vieillit."
                                            },
                                            {
                                                "example_id": "552c4387-1083-4d21-a362-8e8a313bc2bd",
                                                "sense_id": "bb62be2a-10b3-356a-be9d-36f0f6efdca3",
                                                "text": "Se mettre une perruque et des lunettes pour se vieillir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcee5938-632b-4f9e-88d2-e6e8fb53c9db",
