                                    {
                                        "sense_id": "6a0b97d4-0dfc-38cd-9123-d924a88895a8",
                                        "entry_id": "cc536b95-102d-3ddf-b36e-c8b62e7de43f",
                                        "glosses": [
                                            "Habitant de Damas, capitale de Syrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d54529d2-7844-4636-b5ed-0f1397ca00b8",
                                                "sense_id": "6a0b97d4-0dfc-38cd-9123-d924a88895a8",
                                                "text": "La Damascène Anghélos Keusséoglou décrit avec émotion cette fascinante intimité dans Le vieux Damas qui s’en va."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Damascène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "826a13ab-8f7f-3002-91df-57acd5d1ef31",
                                        "entry_id": "f325ffd4-c961-3f90-8dac-77960c824ffd",
                                        "glosses": [
                                            "Région de Damas en Syrie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d012ac-5c81-4d9b-87c1-6b74ce32ba53",
                                                "sense_id": "826a13ab-8f7f-3002-91df-57acd5d1ef31",
                                                "text": "La Damascène se divise en deux zones très contrastées : le bassin de Damas et le Kalamoun."
                                            },
                                            {
                                                "example_id": "443c676a-d232-4cb5-850c-0cd6ce8b304b",
                                                "sense_id": "826a13ab-8f7f-3002-91df-57acd5d1ef31",
                                                "text": "C’est à cette époque que remontent les plus anciennes traces d’occupation de la Damascène."
                                            },
                                            {
                                                "example_id": "4af5ad2d-5b31-40b5-97e8-64fde0e8b7b2",
                                                "sense_id": "826a13ab-8f7f-3002-91df-57acd5d1ef31",
                                                "text": "Édesse était loin et les riches plaines de la Damascène constituaient une proie autrement plus tentante pour la noblesse franque en quête de fiefs."
                                            }
                                        ]
                                    }
                                ]
