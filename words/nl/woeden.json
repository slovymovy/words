{
    "word_family": [
        "woede",
        "woedend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca63601e-8e6f-31ca-b65c-97313d777e3d",
                    "sense_definition": "met grote kracht of geweld aanwezig zijn, vaak gezegd van natuurverschijnselen zoals storm of brand",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geweld",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De afgelopen dagen <w>woedde</w> er een grote brand in het natuurgebied.",
                            "target_lang_translations": {
                                "en": "In recent days, a large fire <w>raged</w> in the nature reserve."
                            }
                        },
                        {
                            "text": "Buiten <w>woedt</w> een hevige storm die veel bomen heeft omvergeblazen.",
                            "target_lang_translations": {
                                "en": "Outside, a violent storm is <w>raging</w> that has blown over many trees."
                            }
                        }
                    ],
                    "synonyms": [
                        "razen",
                        "tekeergaan"
                    ],
                    "common_phrases": [
                        "hevige storm woedt",
                        "grote brand woedt"
                    ],
                    "target_lang_definitions": {
                        "en": "to be present with great force or violence, often said of natural phenomena such as storms or fires"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "of a storm or fire"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "of wind or fire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c215648d-2760-3365-a699-23d12049b143",
                    "sense_definition": "op een hevige of felle manier aan de gang zijn, zoals een conflict, discussie of ziekte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Europa <w>woedt</w> een felle discussie over de nieuwe wetgeving voor privacy.",
                            "target_lang_translations": {
                                "en": "A fierce discussion is <w>raging</w> in Europe about the new privacy legislation."
                            }
                        },
                        {
                            "text": "In dat land heeft jarenlang een bloedige burgeroorlog <w>gewoed</w> tussen verschillende groepen.",
                            "target_lang_translations": {
                                "en": "A bloody civil war <w>raged</w> in that country for years between different groups."
                            }
                        }
                    ],
                    "synonyms": [
                        "razen"
                    ],
                    "common_phrases": [
                        "felle discussie woedt",
                        "hevige strijd woedt"
                    ],
                    "target_lang_definitions": {
                        "en": "to be ongoing in a heavy or fierce manner, such as a conflict, discussion, or disease"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "of a debate, war, or epidemic"
                            },
                            {
                                "target_lang_word": "be rife",
                                "target_lang_sense_clarification": "of a disease or rumor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}