                {
                    "sense_id": "c06fc870-e915-33bc-8a14-defbb6f0fc3c",
                    "sense_definition": "De versterkte rand of zoom van een zeil.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zeilmaker repareerde het gescheurde <w>lijk</w> van het grootzeil.",
                            "target_lang_translations": {
                                "en": "The sailmaker repaired the torn <w>bolt rope</w> of the mainsail.",
                                "ru": "Парусный мастер починил порванную <w>шкаторину</w> грота.",
                                "de": "Der Segelmacher reparierte das gerissene <w>Liek</w> des Großsegels."
                            }
                        },
                        {
                            "text": "Het touw in het <w>lijk</w> zorgt voor extra stevigheid van het zeil.",
                            "target_lang_translations": {
                                "en": "The rope in the <w>bolt rope</w> provides extra sturdiness to the sail.",
                                "ru": "Веревка в <w>шкаторине</w> обеспечивает дополнительную прочность паруса.",
