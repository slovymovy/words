                    {
                        "translation_id": "0cc03225-31a2-4c66-bbd8-24e6a2e1b576",
                        "source_entry_id": "142021b3-926a-3faf-99b1-271af72112ff",
                        "source_sense_id": "c02912c6-ab16-3e43-bb88-2926016b14be",
                        "target_lang_word": "猩猩",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "猩猩",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "edd66149-ac7a-3282-a349-1a95bd602bf3",
                                        "entry_id": "f5cbb970-6dad-32b4-b5c3-287dfefed6a1",
                                        "glosses": [
                                            "與人類在演化關係上最為密切的動物的統稱，除人屬以外的所有人科動物"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bbe879f-d3be-4ad1-8424-3f883eedbef2",
                                                "sense_id": "edd66149-ac7a-3282-a349-1a95bd602bf3",
                                                "text": "猩猩能言，不離禽獸。",
                                                "translation": "即使猩猩能說話，仍然是野獸。"
                                            },
                                            {
                                                "example_id": "05252fa8-9aea-4561-9284-c07d8aa294b8",
                                                "sense_id": "edd66149-ac7a-3282-a349-1a95bd602bf3",
                                                "text": "猩猩能言，不离禽兽。",
                                                "translation": "即使猩猩能說話，仍然是野獸。"
                                            },
                                            {
                                                "example_id": "d35c962c-10d6-43fb-84f7-1f4141aafe95",
                                                "sense_id": "edd66149-ac7a-3282-a349-1a95bd602bf3",
                                                "text": "猩猩者好酒與屐，人有取之者，置二物以誘之，猩猩始見，必大罵曰：「誘我也！」乃絕走遠去，久而復來，稍稍相勸，俄頃俱醉，其足皆絆於屐，因遂獲之。",
                                                "translation": "猩猩是種嗜酒又愛木屐的生物。欲捕捉牠們者，便會擺設這兩樣物品引誘。猩猩一見，便會怒吼：「這是在設局誘惑我！」於是快步跑遠，但過了一段長時間後又折返回來。經同類慫恿後，牠們便開始飲酒作樂，待醉意上頭便會試著穿上木屐，至此便落入圈套。"
                                            },
                                            {
                                                "example_id": "789b0e6f-2571-4afd-818e-dfbed72a2916",
                                                "sense_id": "edd66149-ac7a-3282-a349-1a95bd602bf3",
                                                "text": "猩猩者好酒与屐，人有取之者，置二物以诱之，猩猩始见，必大骂曰：「诱我也！」乃绝走远去，久而复来，稍稍相劝，俄顷俱醉，其足皆绊于屐，因遂获之。",
                                                "translation": "猩猩是種嗜酒又愛木屐的生物。欲捕捉牠們者，便會擺設這兩樣物品引誘。猩猩一見，便會怒吼：「這是在設局誘惑我！」於是快步跑遠，但過了一段長時間後又折返回來。經同類慫恿後，牠們便開始飲酒作樂，待醉意上頭便會試著穿上木屐，至此便落入圈套。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae33d84-f94c-3217-aa16-4d3a19422d8b",
