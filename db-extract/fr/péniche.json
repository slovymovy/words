                ],
                "senses": [
                    {
                        "sense_id": "bf6b0bae-26cf-38a1-9679-800badd396f2",
                        "entry_id": "2b47edb5-e6a3-3516-b7ce-d6fae57878b6",
                        "glosses": [
                            "Bateau à fond plat destiné essentiellement aux transports par fleuves et canaux. Très longues, elles vont parfois par convois."
                        ],
                        "tags": [
                            "Navigation"
                        ],
                        "examples": [
                            {
                                "example_id": "fe51f6c6-2721-4d17-90c4-1e01e029b2c9",
                                "sense_id": "bf6b0bae-26cf-38a1-9679-800badd396f2",
                                "text": "Ils appréhendent le voyage à cent vingt dans la péniche, mais ils sont déterminés et ils se sont mis d’accord sur le fait que ce serait faisable, même s’ils vont être serrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc635430-d4af-3a8c-a5c9-53017904533c",
                        "entry_id": "2b47edb5-e6a3-3516-b7ce-d6fae57878b6",
                        "glosses": [
                            "Chaussure un peu trop grande, dans laquelle on flotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25294dad-21fc-4452-b0b7-2cfca7606961",
                                "sense_id": "fc635430-d4af-3a8c-a5c9-53017904533c",
                                "text": "Qu’on me rende mon Malcolm, sa voix grave, ses yeux bleus, ses péniches taille 44."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6ca3ce7-f56b-4ec4-8051-e3fe9815e27e",
                        "source_entry_id": "2b47edb5-e6a3-3516-b7ce-d6fae57878b6",
                        "source_sense_description": "Bateau à fond plat destiné essentiellement au transports par fleuves et canaux.",
                        "target_lang_word": "Lastkahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lastkahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                        "entry_id": "539c2f2a-a520-350e-a585-8ce20344823e",
                                        "glosses": [
                                            "Wasserfahrzeug ohne Motor zum Transport von Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29dadba5-9f61-47c9-8d35-5cfb1f701220",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Es ging auf schmalen Brücken über Kanäle mit langsam fließendem Wasser, auf dem Lastkähne lagen.“"
                                            },
                                            {
                                                "example_id": "a361614a-928c-4fff-b6a2-96f7226f743d",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Keine 10 Minuten von der Stelle entfernt, an der unsere Reise begann, am heutigen Niederländer Ufer in Köln, wurden die Waren, die auf flachkieligen Segelschiffen transportiert wurden, auf Lastkähne umgeladen.“"
                                            },
                                            {
                                                "example_id": "e17ac6b9-9564-468b-81fe-90949d8ec92b",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Auf den Krananlagen, den Lastkähnen und den Schornsteinen des Kraftwerks gingen die Lichter an.“"
                                            },
                                            {
                                                "example_id": "33a3a8d5-57d8-4f02-b07d-82c081771b9a",
                                                "sense_id": "26e160e0-5f01-31fa-a56f-6bb46e9a5dbd",
                                                "text": "„Wo früher Holzflöße flussabwärts getrieben waren, kamen nun Lastkähne, von Treidlern gezogen, den Fluss herauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
