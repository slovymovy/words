                        "glosses": [
                            "Marked by sweetness; characteristically sweet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e8d464-e4c8-431a-934c-5ae134f3b137",
                                "sense_id": "3bc4a214-75d6-3e0c-b1c2-8f0f22d20f32",
                                "text": "So now Jack rode a hundred miles, a-sweatin' with the thought Of sweetsome words to ask her with, the way a feller ought: \"I'm just a humble cowhand, Miss Cordie, if you please, That hereby asks your heart and hand upon my bended knees!"
                            },
                            {
                                "example_id": "b511981c-3fbe-486b-99d1-bcc7b7ddf7ee",
                                "sense_id": "3bc4a214-75d6-3e0c-b1c2-8f0f22d20f32",
                                "text": "\"Try 'em. Might be the thing for your sweetsome tooth.”"
                            },
                            {
                                "example_id": "eaab4b69-d6b2-4328-93f6-596402a717e9",
                                "sense_id": "3bc4a214-75d6-3e0c-b1c2-8f0f22d20f32",
                                "text": "Woke after sweetsome all-night dreams, / Son House death letter blues / rockin' my skullbone through the wee-est hours."
                            },
                            {
                                "example_id": "62359a9a-772f-4e32-9c7c-0b88c780c803",
                                "sense_id": "3bc4a214-75d6-3e0c-b1c2-8f0f22d20f32",
                                "text": "There poppies bloom in all the dell / To perfume the air in sweetsome smell / To the song of Shirley Seed."
                            }
                        ]
                    }
