{
    "word_family": [
        "désormais",
        "jamais"
    ],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b920289d-564b-3ad3-8d87-da63e561eb72",
                    "sense_definition": "Marque une opposition, une restriction, une différence ou une exception entre deux propositions.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet exercice est difficile, <w>mais</w> nous devons le réussir ensemble."
                        },
                        {
                            "text": "Il voulait venir avec nous au cinéma, <w>mais</w> il était trop fatigué."
                        }
                    ],
                    "synonyms": [
                        "cependant",
                        "pourtant",
                        "toutefois",
                        "néanmoins"
                    ],
                    "common_phrases": [
                        "mais aussi",
                        "mais encore",
                        "mais plutôt"
                    ]
                },
                {
                    "sense_id": "efe29800-91e0-3dae-8c2e-b4bf87cc7942",
                    "sense_definition": "S'emploie en corrélation avec « non seulement » pour lier deux propositions en renforçant la seconde.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "correlation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Non seulement il est intelligent, <w>mais</w> il travaille aussi avec beaucoup de sérieux."
                        },
                        {
                            "text": "Ce projet est non seulement enrichissant, <w>mais</w> encore totalement adapté à nos besoins actuels."
                        }
                    ],
                    "common_phrases": [
                        "non seulement mais",
                        "non seulement mais aussi",
                        "non seulement mais encore"
                    ]
                },
                {
                    "sense_id": "7b610a97-675c-368f-8989-1781b6a0146b",
                    "sense_definition": "Sert de transition pour changer de sujet ou pour revenir au propos principal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une belle histoire, <w>mais</w> revenons au sujet principal de notre réunion."
                        },
                        {
                            "text": "J'ai beaucoup parlé de mes vacances, <w>mais</w> il est temps d'aborder les dossiers en cours."
                        }
                    ],
                    "common_phrases": [
                        "mais passons"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "dea693cc-0c2d-36f3-8905-6fe36df253df",
                    "sense_definition": "Exprime la surprise, l'indignation, l'insistance ou l'incompréhension face à une situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mais</w> qu'est-ce que tu fais là à cette heure tardive ?"
                        },
                        {
                            "text": "<w>Mais</w> enfin, pourquoi refuses-tu de m'écouter quand je te parle ?"
                        }
                    ],
                    "common_phrases": [
                        "mais bien sûr",
                        "mais enfin",
                        "mais non",
                        "mais oui"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "145e7237-c1d8-3c56-9358-07ea05a51411",
                    "sense_definition": "S'emploie pour insister et renforcer une affirmation, un adjectif ou un adverbe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce repas n'était pas seulement bon, il était délicieux, <w>mais</w> vraiment délicieux."
                        },
                        {
                            "text": "La maison est grande, <w>mais</w> très grande pour deux personnes seulement."
                        }
                    ],
                    "common_phrases": [
                        "mais très bien",
                        "mais vraiment"
                    ]
                },
                {
                    "sense_id": "b0d072b8-0efa-38f3-ab48-b5881c96df15",
                    "sense_definition": "Signifiait autrefois « plus », conservé uniquement dans la locution figée « n'en pouvoir mais » pour dire qu'on n'y peut rien.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette affaire compliquée, le pauvre employé n'en pouvait <w>mais</w>."
                        },
                        {
                            "text": "Je n'en puis <w>mais</w> si les événements ont pris une tournure aussi défavorable."
                        }
                    ],
                    "common_phrases": [
                        "n en pouvoir mais"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Uniquement conservé dans la locution figée « n'en pouvoir mais »"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72218dc2-74e5-33dc-b0f3-ecbe93eb9bd7",
                    "sense_definition": "Objection, réserve ou contestation exprimée face à une proposition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "objection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il accepte toujours les projets proposés sans soulever le moindre <w>mais</w>."
                        },
                        {
                            "text": "Finis tes devoirs immédiatement sans discuter, je ne veux entendre aucun <w>mais</w>."
                        }
                    ],
                    "common_phrases": [
                        "des si et des mais",
                        "pas de mais",
                        "sans mais"
                    ]
                },
                {
                    "sense_id": "40eb2afa-750a-30bf-b7fc-54e0e6b461ff",
                    "sense_definition": "Pluriel de <w>mai</w>.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calendrier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les doux <w>mais</w> de mon enfance passée à la campagne me manquent énormément."
                        },
                        {
                            "text": "Durant plusieurs <w>mais</w> consécutifs, le village a organisé ce grand marché floral printanier."
                        }
                    ]
                }
            ]
        }
    ]
}