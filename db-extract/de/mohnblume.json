                ],
                "senses": [
                    {
                        "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                        "entry_id": "f0758d26-1023-3b7e-88f5-158df2ae41d8",
                        "glosses": [
                            "Pflanze mit auffälligen roten Blüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a6b85dd-a67c-45fd-942e-e87c78036bc1",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Mohnblumen wuchsen in den Gräben.“"
                            },
                            {
                                "example_id": "10444a0f-1d3d-465f-9af5-0c3c70a36c91",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Und sie würde daran denken, sich an jedem Gedenktag eine Mohnblume an ihr Revers zu heften.“"
                            },
                            {
                                "example_id": "e55c0d36-c431-463d-9fdb-953fc88313d5",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Die dumme Ludmila erhob sich aus dem hohen Gras, Mohnblumen und Schmeißfliegen im Haar.“"
                            },
                            {
                                "example_id": "f7911b31-188f-4337-9d3a-49dfd0ad40cd",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Ihre Nase wurde überfallen von den süßen Gerüchen von Jasmin und Mohnblumen.“"
                            },
                            {
                                "example_id": "d7b65745-ec56-48a8-8635-d674b332dd66",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Doch loderten Mohnblumen auf den Wiesen und an den Berghängen und breiteten ihre zarte Schönheit gleich einem Scharlachteppich zu Füßen des immerwährenden Winters aus, und die stillen Teiche und träge strömenden Flüsse wurden von weißen Wasserlilien gesäumt.“"
                            },
                            {
                                "example_id": "46790ddc-37cb-40e9-90a1-9ae6b78a962c",
                                "sense_id": "4ce32bc2-52eb-3b25-8657-f87d3f9d37a6",
                                "text": "„Die Soldaten kamen und gossen Dieselöl auf die Felder und die Mohnblumen, auf die Saumpfade und die Wege zwischen den Latifundien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
