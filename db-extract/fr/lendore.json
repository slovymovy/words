                        "sense_id": "94b5612e-8976-330c-9551-b0dab750ecd4",
                        "entry_id": "c6aca859-32de-3336-87f0-08e93d365bd5",
                        "glosses": [
                            "Personne lente, nonchalante, qui semble un peu endormie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d06443a4-06e1-4e6e-81f8-13204c4fcb02",
                                "sense_id": "94b5612e-8976-330c-9551-b0dab750ecd4",
                                "text": "Un lendore désigne une personne lente et qui manque d’énergie."
                            },
                            {
                                "example_id": "8ea07a87-30eb-4f7c-ace0-80083e45addf",
                                "sense_id": "94b5612e-8976-330c-9551-b0dab750ecd4",
                                "text": "Je ne sais pas à quoi elle pense, cette lendore-là…"
                            },
                            {
                                "example_id": "7596e69e-a5f6-479f-864b-4c838168d85a",
                                "sense_id": "94b5612e-8976-330c-9551-b0dab750ecd4",
                                "text": "On les nommait autrefois des cagnards et des lendores, mais je ne sais trop comment les appeler maintenant."
                            },
                            {
                                "example_id": "c97e9bbc-0b2d-4fbc-a730-69cf34a5c60c",
                                "sense_id": "94b5612e-8976-330c-9551-b0dab750ecd4",
                                "text": "Maussades lendores"
                            }
                        ]
                    }
                ],
