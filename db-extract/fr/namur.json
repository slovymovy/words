            {
                "entry_id": "325d990f-91d2-325c-8127-61159ccb2286",
                "word": "Namur",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                        "entry_id": "325d990f-91d2-325c-8127-61159ccb2286",
                        "glosses": [
                            "Commune et ville de Belgique, capitale de la Wallonie, chef-lieu de la province de Namur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7095bc-9ecb-4947-aa30-d4e436f41294",
                                "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                                "text": "C'est à Namur que Gaspard vit le premier beffroi."
                            },
                            {
                                "example_id": "9af6efd6-ed25-4839-b50a-67397ca3a5b4",
                                "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                                "text": "Peu avant de parvenir au village de Champion, la grande route de Namur à Louvain gravit, en quittant la ferme dite de Ponty ou des Pauvres, une éminence dont le sommet se trouve à quelques pas de la borne kilométrique nᵒ 4."
                            },
                            {
                                "example_id": "86b567c1-72e0-4023-9b6f-a7927a9ed2af",
                                "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                                "text": "En effet : nᵒ 1 L’Escaut ne se jette point dans la Meuse, mais dans l'Océan ; tandis que la Sambre se jette dans la Meuse à Namur."
                            },
                            {
                                "example_id": "5aba6cc7-4133-42dd-9764-d10911a9b488",
                                "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                                "text": "Avec six divisions d'infanterie de série B, démunies de cadres, dotées d'un armement hétéroclite et périmé, ne disposant d'aucun moyen de transport autre qu’hippomobile, elle allait s'opposer sur un front de 120 kilomètres, de Namur à Pont-à-Bar, à quatre divisions blindées et sept divisions d'infanterie."
                            },
                            {
                                "example_id": "f3f2548d-015f-475c-b792-ae5cc071a121",
                                "sense_id": "7ce870e7-809e-3613-bd35-8bfe213360c4",
                                "text": "Il faut encore mentionner la villa de Seilles, entre Namur et Huy, celle de Montcy-Saint-Pierre, chef-lieu du Castrensis, et, vraisemblablement, celle qui occupe le futur site de Liège."
                            }
                        ]
                    },
