                "word": "historycznie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31a58984-d991-394d-ab41-f5d3f91cfd91",
                        "entry_id": "07007110-3f57-39b5-ab2a-60a68b3fd441",
                        "glosses": [
                            "w dawnych czasach, ujmując określoną historię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15be07d4-5ba4-4e31-b002-811fc9a4be64",
                                "sense_id": "31a58984-d991-394d-ab41-f5d3f91cfd91",
                                "text": "Gdyby spojrzeć na to zjawisko historycznie, miało ono początek w okolicach przełomu XVI i XVII wieku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "fe90cea2-ae92-3cff-8da5-dcb5eb474a98",
                        "entry_id": "07007110-3f57-39b5-ab2a-60a68b3fd441",
                        "glosses": [
                            "w sposób charakterystyczny dla odległych czasów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fb553fd-2699-4358-bf43-6d3ec5a9ec7b",
                        "source_entry_id": "07007110-3f57-39b5-ab2a-60a68b3fd441",
                        "source_sense_id": "31a58984-d991-394d-ab41-f5d3f91cfd91",
                        "target_lang_word": "historically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62097213-8e63-38f6-9c60-f4850558470b",
                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "In a historic manner; with reference to history or the historical record."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de91f95-a065-4bdd-8e39-4be59a40f5b5",
                                                "sense_id": "62097213-8e63-38f6-9c60-f4850558470b",
                                                "text": "Historically speaking, this company has always collected payment before starting work."
                                            },
                                            {
                                                "example_id": "a075626d-9578-4989-8285-a35e4699420e",
                                                "sense_id": "62097213-8e63-38f6-9c60-f4850558470b",
                                                "text": "Virtually all modern scholars of antiquity agree that Jesus existed historically."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "According to history: formerly, in the past, traditionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b668b272-fc69-47a3-92c8-b8c13cd9d0d0",
                                                "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                                "text": "Historically, this company collected payment before starting work."
                                            },
                                            {
                                                "example_id": "77b21c61-ac84-4a23-bd3b-f8f3a841a9ad",
                                                "sense_id": "79d6102c-9d49-3230-a522-de7770552bfe",
                                                "text": "Holden Matthews, 21, has been charged in connection with fires at three historically black churches in Louisiana."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3698ab4-1fb7-36a5-9aaa-8ad4da3f2199",
                                        "entry_id": "7cb102fa-78a8-3027-99ff-15bcbe0d0fcf",
                                        "glosses": [
                                            "To an unprecedented or extremely rare degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a82c45c6-7f15-4183-b25b-a6ac961a5c63",
                                                "sense_id": "f3698ab4-1fb7-36a5-9aaa-8ad4da3f2199",
                                                "text": "In January, the anti-corruption organization Citizens for Responsibility and Ethics in Washington, or CREW, released a detailed report on the historically unethical presidency of Donald Trump."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e9430b-ed4b-467f-a3cd-fbdd87a1fed0",
                        "source_entry_id": "07007110-3f57-39b5-ab2a-60a68b3fd441",
                        "source_sense_id": "31a58984-d991-394d-ab41-f5d3f91cfd91",
                        "target_lang_word": "historiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "historiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0efdd498-c5ab-3fd7-93c7-312d6ca6628e",
                                        "entry_id": "d18a93c9-789a-3465-8172-b26f78c28ba1",
                                        "glosses": [
                                            "Dans un style historique, sans aucun ornement étranger, par opposition à oratoirement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7640f599-7806-415b-9350-f011a5d4dd96",
                                                "sense_id": "0efdd498-c5ab-3fd7-93c7-312d6ca6628e",
                                                "text": "Raconter un fait historiquement."
                                            },
                                            {
                                                "example_id": "1ffdd0aa-de93-4e85-8296-18bbaadab84e",
                                                "sense_id": "0efdd498-c5ab-3fd7-93c7-312d6ca6628e",
                                                "text": "Je vous fis savoir, il y a huit jours, le mauvais état où j'étais, et vous le fis savoir historiquement, sans user de figure, sans rien ajouter à la vérité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                        "entry_id": "d18a93c9-789a-3465-8172-b26f78c28ba1",
                                        "glosses": [
                                            "En se conformant aux faits véritables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ec69ef-8546-4b8b-9ad8-52c622ebe783",
                                                "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                                "text": "Historiquement, la « tête gouvernante » de l'impérialisme nord-américain prête une attention supérieure au contrôle militaire, tandis que sa « tête privée » de consacre au contrôle économique."
                                            },
                                            {
                                                "example_id": "b7d16b6f-42d9-4a4a-8e9f-bf40f10d0da1",
                                                "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                                "text": "Historiquement, la Méditerranée se caractérise par ses flux migratoires et l'instabilité de ses regroupements politiques: […]."
                                            },
                                            {
                                                "example_id": "1028d75c-67b7-419b-9223-b56e8b6f1967",
                                                "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                                "text": "Il [l'empereur] s’est plaint amèrement de la conduite de M. le maréchal de Broglie ; il l’accuse d’être seul cause de la perte de ses États, qu’il a voulu abandonner sans y être forcé […] je ne fais que rapporter historiquement à Votre Majesté ce qui m’a été dit par l’empereur."
                                            },
                                            {
                                                "example_id": "df99b239-f796-4d06-859e-72306a104d72",
                                                "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                                "text": "En admettant que le mariage des prêtres eût été toléré dans la primitive Église, ce qui ne peut se soutenir ni historiquement, ni canoniquement…"
                                            },
                                            {
                                                "example_id": "b1fa1d8c-f907-481a-87c3-c4cb954f4170",
                                                "sense_id": "8f6e4008-6086-3a73-8bd8-4952fb054bec",
                                                "text": "Le fast-food halal est historiquement dominé de la tête et des épaules par les kebabs, ces petits points de vente dans lesquels les consommateurs de viande halal achètent les « döner kebabs » (« grillade tournante »), ce sandwich d'origine turque garni de viande de veau, de dinde ou de poulet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "955a3750-5a67-379b-a24e-79c19b047740",
                                        "entry_id": "d18a93c9-789a-3465-8172-b26f78c28ba1",
                                        "glosses": [
                                            "Selon les règles de l’histoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88a8009f-821a-4d8e-89fa-8c8d126f48e5",
                                                "sense_id": "955a3750-5a67-379b-a24e-79c19b047740",
                                                "text": "Il n'est plus question ici que d’examiner historiquement si Jésus…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16776f65-9c60-4b52-a7a3-573998808e9e",
                        "source_entry_id": "07007110-3f57-39b5-ab2a-60a68b3fd441",
                        "source_sense_id": "31a58984-d991-394d-ab41-f5d3f91cfd91",
                        "target_lang_word": "históricamente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "históricamente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9cfac451-32e9-3da7-8b72-54a3cb06af76",
                                        "entry_id": "57bdf654-96c9-327e-9f71-c1b7ce8692fc",
                                        "glosses": [
                                            "De modo histórico; según o con base en la historia, la trayectoria o el historial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfb2d63-a1ef-462e-a70e-0d668d4c800e",
                                                "sense_id": "9cfac451-32e9-3da7-8b72-54a3cb06af76",
                                                "text": "Los individuos operan dentro de los límites de lo que les es históricamente posible. Y lo que es históricamente posible para un individuo está en función de los sistemas de lenguaje a que pertenece"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
