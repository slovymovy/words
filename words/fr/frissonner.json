    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b53e0c5-046a-307a-870e-17bf7705dd9d",
                    "sense_definition": "Trembler involontairement sous l'effet du froid ou d'un accès de fièvre.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans son manteau d'hiver, il commence à <w>frissonner</w> de froid dans la rue."
                        },
                        {
                            "text": "Le malade avait une forte température et <w>frissonnait</w> sous ses couvertures."
                        }
                    ],
                    "synonyms": [
                        "grelotter",
                        "trembler"
                    ],
                    "common_phrases": [
                        "frissonner de froid",
                        "frissonner de fièvre"
                    ]
                },
                {
                    "sense_id": "33ccf6b8-4421-3392-aa31-c87c7dc475cc",
                    "sense_definition": "Éprouver un tremblement ou une vive sensation sous le coup d'une émotion intense comme la peur, l'horreur ou le plaisir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film d'horreur a fait <w>frissonner</w> tous les spectateurs de la salle."
                        },
                        {
                            "text": "Elle <w>frissonne</w> de peur chaque fois qu'elle entend ce bruit mystérieux."
                        }
                    ],
                    "synonyms": [
                        "frémir"
                    ],
                    "common_phrases": [
                        "faire frissonner",
                        "frissonner de peur",
                        "frissonner d'effroi"
                    ]
                },
                {
                    "sense_id": "a24039e0-eca0-39dc-8998-70407aa30ceb",
                    "sense_definition": "S'agiter d'un léger mouvement ou bruire doucement, en parlant des feuilles, de l'eau ou de certains objets.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_leger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les feuilles du bouleau se mettent à <w>frissonner</w> au vent frais."
                        },
                        {
                            "text": "Dans le silence de la nuit, la voile du navire <w>frissonne</w> doucement."
                        }
                    ],
                    "synonyms": [
                        "bruire",
                        "frémir"
                    ],
                    "common_phrases": [
                        "frissonner au vent"
                    ]
                }
            ]
        }
    ]
}