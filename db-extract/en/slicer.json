                                                "sense_id": "2a6c2b86-4d11-3546-bf4e-64aaa7e72a4e",
                                                "text": "Na wenigstens aus dem Schneider!"
                                            },
                                            {
                                                "example_id": "ce649910-363c-4727-889e-5fa459a609f9",
                                                "sense_id": "2a6c2b86-4d11-3546-bf4e-64aaa7e72a4e",
                                                "text": "Der geht heute als Schneider nach Hause"
                                            }
                                        ],
