                                "target_senses": [
                                    {
                                        "sense_id": "c6bc55a9-382b-327f-9f15-32cbfe2ff737",
                                        "entry_id": "5030db7f-fb22-3832-9592-5cb4c98ca8da",
                                        "glosses": [
                                            "A beauty salon dedicated to nail care e.g. manicures and pedicures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a945b27b-308e-417f-84cd-b6928b430c57",
                                                "sense_id": "c6bc55a9-382b-327f-9f15-32cbfe2ff737",
                                                "text": "But if the mix is no longer about life's essentials, and instead a new wave of chichi cafés, artisan bakers and fancy nail bars—are we right to ask, not how useful is your high street, but how bougie?"
                                            }
                                        ]
                                    },
