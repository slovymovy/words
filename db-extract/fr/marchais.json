                "senses": [
                    {
                        "sense_id": "fcabed68-cf15-39d9-9855-f688282fcfcc",
                        "entry_id": "9d2c0868-ddb2-31fc-b85e-5910c82540bd",
                        "glosses": [
                            "Première personne du singulier de l’imparfait de l’indicatif de marcher."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "40ec168b-1c7d-42a7-9b45-85042b67b2d5",
                                "sense_id": "fcabed68-cf15-39d9-9855-f688282fcfcc",
                                "text": "Sans arrêt, je marchais de long en large pour tâcher de calmer mes nerfs, et les tcheuf-tcheuf des trains de marchandises commençaient à me forer le crâne, et mes doigts se crispaient convulsivement."
                            },
                            {
                                "example_id": "f80143cd-40f4-4702-b196-096cf04415c8",
                                "sense_id": "fcabed68-cf15-39d9-9855-f688282fcfcc",
                                "text": "Je marchais à la limite des vaguelettes, là où les pieds s’enfoncent peu dans le sable lisse et frais. Le léger ressac effaçait aussitôt l’empreinte de mes pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "d86fd34c-b682-39e6-80bd-b3a6761189fd",
                        "entry_id": "9d2c0868-ddb2-31fc-b85e-5910c82540bd",
