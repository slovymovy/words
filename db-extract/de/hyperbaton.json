                "senses": [
                    {
                        "sense_id": "26fcb5d2-3152-3433-ad8e-336e79a5a174",
                        "entry_id": "230277ae-0b70-38ba-aafa-2debf8f81366",
                        "glosses": [
                            "Unterbrechung/Auflösung einer syntaktisch zusammengehörigen Wortgruppe durch Einschub anderer Wörter oder Wortgruppen oder durch Umstellung"
                        ],
                        "tags": [
                            "Rhetorik",
                            "rhetorische Figur"
                        ],
                        "examples": [
                            {
                                "example_id": "20bc4318-22ca-4348-bc3d-3c593bb074af",
                                "sense_id": "26fcb5d2-3152-3433-ad8e-336e79a5a174",
                                "text": "„Beim Hyperbaton wird eine syntaktisch eigentlich geschlossene Einheit durch einen Einschub oft pleonastisch gebrauchter Wörter oder durch eine bloße Umstellung aufgebrochen…“"
                            },
                            {
                                "example_id": "df32e4f4-61b4-40d1-9a57-adddb1d3ea03",
                                "sense_id": "26fcb5d2-3152-3433-ad8e-336e79a5a174",
                                "text": "Als Beispiel für ein Hyperbaton zitiert Bußmann von Trakl: „Da macht ein Hauch mich von Verfall erzittern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90b3fee3-72e1-4081-b17f-eef0732b6182",
                        "source_entry_id": "230277ae-0b70-38ba-aafa-2debf8f81366",
                        "source_sense_id": "26fcb5d2-3152-3433-ad8e-336e79a5a174",
                        "target_lang_word": "hyperbaton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperbaton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f37a26e-19f0-3ecb-aed4-ab5763ae3a9e",
                                        "entry_id": "77871f20-010a-3823-ab40-8f914cac2053",
                                        "glosses": [
                                            "An inversion of the usual or logical order of words or phrases, for emphasis or poetic effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7bae8cc-3d8e-4157-a7b8-b3a8e5b0115b",
                                                "sense_id": "6f37a26e-19f0-3ecb-aed4-ab5763ae3a9e",
                                                "text": "In real life we often see a man under the influence of rage, or fear, […] begin a sentence, and then swerve aside into some inconsequent parenthesis, and then again double back to his original statement […]Now the figure hyperbaton is the means which is employed by the best writers to imitate these signs of natural emotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9374391-a460-3433-8dbf-a5610e80ffda",
                                        "entry_id": "77871f20-010a-3823-ab40-8f914cac2053",
                                        "glosses": [
                                            "Adding a word or thought to a sentence that is already semantically complete, thus drawing emphasis to the addition."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b83e91c9-130b-4679-ae16-8388a8f93f5c",
                        "source_entry_id": "230277ae-0b70-38ba-aafa-2debf8f81366",
                        "source_sense_id": "26fcb5d2-3152-3433-ad8e-336e79a5a174",
                        "target_lang_word": "hyperbate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
