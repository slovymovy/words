                        "glosses": [
                            "Gaillard, nigaud, andouille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d6b4eaa-6129-4556-823a-1f66fd3d1db3",
                                "sense_id": "8963e5a2-069a-3ba4-9c60-f0b70639f731",
                                "text": "Et qu’un grand galabard de 25 ans pourrait fort bien aider son oncle."
                            },
                            {
                                "example_id": "94931ebf-f447-42a8-b4f4-ddf59a0ff7b7",
                                "sense_id": "8963e5a2-069a-3ba4-9c60-f0b70639f731",
                                "text": "La réponse ne se fit pas longtemps attendre, son grand galabard de Guillaume apparut, en bleu de travail, pour se rendre visiblement à son boulot les mains dans les poches, en sifflotant n'importe quoi."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b0e8d4b-e8da-3d50-b561-143493b3d2ba",
                        "entry_id": "8719099f-5715-3a74-b5b1-fa9b16d3e40f",
                        "glosses": [
                            "Boudin noir avec des inclusions de couenne ou de langue, saucisse."
                        ],
                        "tags": [
                            "Occitanie"
                        ],
                        "examples": [
                            {
                                "example_id": "37ebeb20-5a97-43ec-835e-0d39918d7bb0",
                                "sense_id": "1b0e8d4b-e8da-3d50-b561-143493b3d2ba",
                                "text": "Le jambon de Lacaune en est le fleuron [des produits du Tarn], utilisé en cuisine dans de nombreuses recettes. À ses côtés, le galabard, boudin à la viande, le foie salé ou le melsat, sorte de boudin blanc, sont des spécialités locales."
                            }
                        ]
