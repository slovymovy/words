                                        "sense_id": "d7d736f2-1522-3cd8-b6ed-426a654ba64d",
                                        "entry_id": "bcf613bf-d0aa-3dc8-bef7-49bc25613a75",
                                        "glosses": [
                                            "Person, die andere unter Druck setzt und sie zu etwas zwingt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0081c32d-7537-4635-8209-f4e098fdd555",
                                                "sense_id": "d7d736f2-1522-3cd8-b6ed-426a654ba64d",
