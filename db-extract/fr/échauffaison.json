                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0298b17-bac4-4228-8792-7a51789ce93b",
                                "sense_id": "46bba912-fcec-3811-a12a-9a3a26c2f290",
                                "text": "Ne m'attens pas ce soir à souper. Je ne serai pas le tien; je suis malade; c'est une échauffaison prodigieuse."
                            },
                            {
                                "example_id": "f201d993-4664-46c9-bc6a-5f859d3836d6",
                                "sense_id": "46bba912-fcec-3811-a12a-9a3a26c2f290",
                                "text": "Ainsi on entend souvent des mères dire à leur fils turbulent : « Tu cours trop, tu vas attraper une échauffaison. »"
                            }
                        ]
                    }
                ],
