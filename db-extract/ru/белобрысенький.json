                "senses": [
                    {
                        "sense_id": "49c61991-bd72-3129-a8aa-8664923ef106",
                        "entry_id": "40698561-2bb5-3c71-863b-b8e5645bdd8f",
                        "glosses": [
                            "разг. ласк. к белобрысый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89e7e473-8be0-4a7d-91b3-00e8bb54f52e",
                                "sense_id": "49c61991-bd72-3129-a8aa-8664923ef106",
                                "text": "Феклуша была белобрысенькая, как и отец, девушка лет восемнадцати, с круглым простодушным, довольно миловидным лицом."
                            },
                            {
                                "example_id": "ea6443b2-58b3-48b0-9278-0511860738f6",
                                "sense_id": "49c61991-bd72-3129-a8aa-8664923ef106",
                                "text": "― Был у нас белобрысенький такой паренёк, Сапожников, отшили мы его, глуповат и боязлив чересчур."
                            }
                        ]
                    }
