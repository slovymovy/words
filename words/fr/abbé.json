                    "frequency": "Middle",
                    "semantic_group_id": "clergé",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>abbé</w> bénit les fidèles réunis dans la chapelle du village."
                        },
                        {
                            "text": "Les paroissiens écoutent avec attention les conseils bienveillants de monsieur l'<w>abbé</w>."
                        }
                    ],
                    "synonyms": [
