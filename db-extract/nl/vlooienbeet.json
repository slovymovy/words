                        "examples": [
                            {
                                "example_id": "2c08b58f-a2da-47fb-809c-b73ecd107ed9",
                                "sense_id": "ce1c6e4d-7563-3ee8-8385-ae9e404dac78",
                                "text": "De pest zelf wordt veroorzaakt door de Yersinia pestis die voornamelijk circuleert in reservoirs van in het wild levende knaagdieren. Door vlooienbeten kan de ziekte worden overgedragen op andere dieren en op mensen."
                            },
                            {
                                "example_id": "1f7108bc-22a8-48c6-a26a-c8bf9e5d9862",
                                "sense_id": "ce1c6e4d-7563-3ee8-8385-ae9e404dac78",
                                "text": "De WHO vreest dat de mijnwerkers, van wie tweederde het gebied is ontvlucht uit angst voor besmetting, de ziekte hebben verspreid in dorpen in een straal van tweehonderd kilometer rond de mijn.De pest, die normaliter heerst onder knaagdieren en via vlooien wordt verpreid, kan via vlooienbeten overspringen op mensen."
                            }
                        ]
