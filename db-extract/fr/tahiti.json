        "fr-extract.jsonl": [
            {
                "entry_id": "f3712bad-efea-3e10-8225-c843521f7f8c",
                "word": "Tahiti",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40b7a2b0-e625-3a98-8d04-e116e363ccb9",
                        "entry_id": "f3712bad-efea-3e10-8225-c843521f7f8c",
                        "glosses": [
                            "Principale île de Polynésie française, ayant pour capitale Papeete."
                        ],
                        "tags": [
                            "Toponymie"
                        ],
                        "examples": [
                            {
                                "example_id": "8fab8119-47d5-414b-a49e-c37de74f3ccb",
                                "sense_id": "40b7a2b0-e625-3a98-8d04-e116e363ccb9",
                                "text": "J’attendais beaucoup de Tahiti, mais sa beauté ne me désappointa nullement. Avec le sommet de l’Orohena perdu dans les nuages, le pic curieux et surprenant du Diadème, les profondes vallées qui en descendent vers la mer, la ceinture de corail qui l’encercle et sur laquelle vient se briser l’océan, elle m’apparut plus majestueuse qu’aucune des îles que j’avais visitées, en vérité la reine des mers du Sud."
                            },
                            {
                                "example_id": "ec727438-c805-4e9a-ba06-b3f161230616",
                                "sense_id": "40b7a2b0-e625-3a98-8d04-e116e363ccb9",
                                "text": "L’homme a joué un rôle essentiel dans le peuplement végétal des îles du Pacifique. Ainsi la flore de Tahiti est, pour les trois-quarts, une flore introduite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f6edad2-f1a0-4df2-89fe-283e26e01695",
                        "source_entry_id": "f3712bad-efea-3e10-8225-c843521f7f8c",
                        "source_sense_id": "40b7a2b0-e625-3a98-8d04-e116e363ccb9",
                        "target_lang_word": "Tahiti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tahiti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92f269c0-308e-36ff-bb04-a03d624b1ce6",
                                        "entry_id": "7b005c8b-dad4-3627-9bcb-2eebd723e4bc",
                                        "glosses": [
                                            "größte Insel Französisch-Polynesiens, eine der Gesellschaftsinseln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafc587b-6c7a-4e26-b947-ad7b92ce9ded",
                                                "sense_id": "92f269c0-308e-36ff-bb04-a03d624b1ce6",
                                                "text": "„Entgegen der verbreiteten Meinung ist Tahiti keineswegs von weißen Stränden umgeben.“"
                                            },
                                            {
                                                "example_id": "6cf04f78-cc0e-4d22-81d2-ec7710df4359",
                                                "sense_id": "92f269c0-308e-36ff-bb04-a03d624b1ce6",
                                                "text": "Es ist ein Erlebnis, durch das dichtbewachsene Innere Tahitis zu wandern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
