                ],
                "senses": [
                    {
                        "sense_id": "154b522b-4690-328d-8b02-02c01e352321",
                        "entry_id": "e3b877e6-a04c-3a0d-a336-ab9d4682761f",
                        "glosses": [
                            "ktoś przesadnie religijny lub gorliwie manifestujący swą religijność"
                        ],
                        "tags": [
                            "literary",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "d03adc82-d4a7-47fe-8398-3f654f656247",
                                "sense_id": "154b522b-4690-328d-8b02-02c01e352321",
                                "text": "Czuł w tym zasuszonym szczurze twardego bigota, z którym daleko prędzej można przyjść do kłótni, niż do jakiejkolwiek transakcji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea3fbe2a-e48f-48be-86e2-b3ca12f44206",
                        "source_entry_id": "e3b877e6-a04c-3a0d-a336-ab9d4682761f",
                        "source_sense_id": "154b522b-4690-328d-8b02-02c01e352321",
                        "target_lang_word": "bigot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "156f425c-e558-342d-84b1-cacb8d3cef5a",
                                        "entry_id": "11c5b80e-13c6-3b70-8e40-dce733ed2ec4",
                                        "glosses": [
                                            "One who is narrow-mindedly devoted to their own ideas and groups, and intolerant of (people of) differing ideas, races, genders, religions, politics, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45f98776-21d3-43d1-8ccd-eed4a90c50c1",
                                                "sense_id": "156f425c-e558-342d-84b1-cacb8d3cef5a",
                                                "text": "A former senior minister from Boris Johnson’s government told the Guardian they believed Braverman was a “real racist bigot”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                        "entry_id": "11c5b80e-13c6-3b70-8e40-dce733ed2ec4",
                                        "glosses": [
                                            "One who is overly pious in matters of religion, often hypocritically or else superstitiously so."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffaf8e9-49ae-49dc-af84-83df7301686c",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "He is no bigot or hypocrite, he is not torn and divided betwixt reality and appearance, no wretch of a rugged and peevish disposition, but honest, jovial, resolute, and a good fellow."
                                            },
                                            {
                                                "example_id": "1bf63e6c-5f6c-40db-8d88-8d8f988e804f",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "Thus one part of their Church becomes Sotts and Bigots; and the other that behold this Scene of things, though they profess themselves of their Church, become a company of profane Atheists and clancular Deriders of all Religion. […] Nay it is a question whether those that do more superstitiously cleave to them, doe it not rather in a kind of confusion and obstupefaction of mind out of fear and suspicion, then any determinate assurance or firm belief of the things they outwardly profess."
                                            },
                                            {
                                                "example_id": "ed89d576-1e61-434e-b75a-9b1a6f3806c0",
                                                "sense_id": "98a0efc1-f622-3be4-bf01-326b99d2b7e3",
                                                "text": "Donna Clara was a woman of a cold and grave temper, with all the solemnity of a Spaniard, and all the austerity of a bigot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76c4bbf6-cbdd-48dd-8002-979bfba8654b",
                        "source_entry_id": "e3b877e6-a04c-3a0d-a336-ab9d4682761f",
                        "source_sense_id": "154b522b-4690-328d-8b02-02c01e352321",
                        "target_lang_word": "bigot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                        "entry_id": "2b9da4c6-83db-39f4-9b37-b2b7ca12539e",
                                        "glosses": [
                                            "Dévot de façon outrée et superstitieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af0e579-1e73-456f-b4d1-fe0477448888",
                                                "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                                "text": "Un moine bigot."
                                            },
                                            {
                                                "example_id": "e2d8330c-b9d4-49c8-95d5-61c78f44c389",
                                                "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                                "text": "Une éducation bigote."
                                            },
                                            {
                                                "example_id": "c0884564-eda0-483d-b2af-56a7a42b0c89",
                                                "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                                "text": "Un chrétien bigot, un esprit superstitieux, un ennemi de la raison et des lumières."
                                            },
                                            {
                                                "example_id": "fe187c5d-3e6b-4e79-acdc-67cc7f850e21",
                                                "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                                "text": "Dans ces sinistres et implacables maisons, la bigoterie se peint dans les meubles, dans les gravures, dans les tableaux : le parler y est bigot, le silence est bigot et les figures sont bigotes."
                                            },
                                            {
                                                "example_id": "b7026159-70a1-4918-8fd8-2c41cdb3e509",
                                                "sense_id": "181d9624-d4a3-3ce4-bc69-3777082e4905",
                                                "text": "C’est un cordon… Je vous jure… Oui, un cordon de scapulaire. Pourtant, elle n’était pas bigote. Des soirs, elle courait l’homme."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bigot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e10a7eb7-a0c5-32c6-8487-3fd86dff4a6f",
                                        "entry_id": "8a537d88-b07b-3b17-879e-4b5519db371d",
                                        "glosses": [
                                            "Dévot affichant une religiosité affectée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a9edaf9-b173-49ff-ac72-2907e39726f7",
                                                "sense_id": "e10a7eb7-a0c5-32c6-8487-3fd86dff4a6f",
                                                "text": "Guerrier redoutable, bigot ascétique, ses traits maigres et sévères conservaient l’expression farouche du soldat, et ils étaient également remarquables par la maigreur, fruit de l’abstinence, et par l’orgueil religieux du dévot satisfait de lui-même."
                                            },
                                            {
                                                "example_id": "3c5b4252-206d-4156-81d6-a275a88e2934",
                                                "sense_id": "e10a7eb7-a0c5-32c6-8487-3fd86dff4a6f",
                                                "text": "Hé, face de pet ! Carrie la bigote ! crie Tommy Erbter, un petit garçon de maternelle dont Carrie est le souffre-douleur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bigot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fb14060e-7c7a-379b-ab26-fd50051ea108",
                                        "entry_id": "6c93bff4-61b8-3227-9ee2-57c15b32c838",
                                        "glosses": [
                                            "Bois troué pour passer les cordages."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c493d188-ad99-49fc-b6a4-81191d450505",
                                                "sense_id": "fb14060e-7c7a-379b-ab26-fd50051ea108",
                                                "text": "Les bigots étaient rangés selon la quantité de trous qu'ils avaient."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bigot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a971e580-4caf-3470-a321-52fe1c68d2b3",
                                        "entry_id": "68ac6174-7240-38cf-9b56-c77891f405e4",
                                        "glosses": [
                                            "Pioche dont les deux pannes sont pointues."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dee6d85c-5f5d-47e9-b17c-cb019fa92616",
                                                "sense_id": "a971e580-4caf-3470-a321-52fe1c68d2b3",
                                                "text": "Les pluies abondantes du printemps avaient encouragé le chiendent et la traînasse. Une fois les rangs décavaillonnés, il fallait tirer l'herbe à la main, soigneusement, là où le bigot ne pouvait passer, au risque de blesser les ceps de vigne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a930dd-bbf0-3229-823e-f0bc03d7a195",
                                        "entry_id": "68ac6174-7240-38cf-9b56-c77891f405e4",
                                        "glosses": [
                                            "Fourche recourbée en forme de crochet."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba57c42-5420-4783-b39b-a0452a4be9cf",
                                                "sense_id": "39a930dd-bbf0-3229-823e-f0bc03d7a195",
                                                "text": "Munis chacun d’un « bigot », nous piquions violemment dans la couche épaisse de fumier chaud et nous entassions sur la civière des « bigochées » monstres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
