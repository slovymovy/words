{
    "word_family": [
        "pertinent",
        "pertinence",
        "impertinent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a1bf3db1-d029-3e11-8218-49b0895e8c05",
                    "sense_definition": "To relate to, concern, or be directly relevant to something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please keep your questions limited to matters that <w>pertain</w> to the current discussion.",
                            "target_lang_translations": {
                                "tr": "Lütfen sorularınızı mevcut tartışma ile <w>ilgili</w> konularla sınırlı tutun."
                            }
                        }
                    ],
                    "synonyms": [
                        "relate",
                        "concern",
                        "refer"
                    ],
                    "antonyms": [
                        "be irrelevant"
                    ],
                    "common_phrases": [
                        "pertain to"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyle ilgili olmak, onu ilgilendirmek veya doğrudan bağlantılı olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilgili olmak",
                                "target_lang_sense_clarification": "Bir konuyla doğrudan bağlantı kurmak anlamında."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "587d7eab-377a-30aa-ae3e-1b8d03e09d75",
                    "sense_definition": "To belong to or be connected as a part, quality, or accessory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belonging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rights that <w>pertain</w> to this property are clearly listed in the deed.",
                            "target_lang_translations": {
                                "tr": "Bu mülke <w>âit</w> haklar tapuda açıkça listelenmiştir."
                            }
                        },
                        {
                            "text": "These duties directly <w>pertain</w> to your new office position.",
                            "target_lang_translations": {
                                "tr": "Bu görevler doğrudan yeni ofis pozisyonunuza <w>aittir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "belong",
                        "appertain"
                    ],
                    "common_phrases": [
                        "pertain to the position"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeye ait olmak veya bir parçası, niteliği ya da eklentisi olarak bağlantılı olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "âit olmak",
                                "target_lang_sense_clarification": "Bir şeye veya birine bağlılık/sahiplik bildirmek."
                            },
                            {
                                "target_lang_word": "mahsus olmak",
                                "target_lang_sense_clarification": "Bir şeye özgü veya ona ait olma durumu."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e590999b-3bf8-3e81-9daa-d50811be3bc3",
                    "sense_definition": "To apply or be in effect in a particular situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "applicability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The standard regulations no longer <w>pertain</w> in this emergency situation.",
                            "target_lang_translations": {
                                "tr": "Standart yönetmelikler bu acil durumda artık <w>geçerli değildir</w>."
                            }
                        },
                        {
                            "text": "Different laws <w>pertain</w> when operating a commercial vehicle.",
                            "target_lang_translations": {
                                "tr": "Ticari bir araç kullanırken farklı yasalar <w>uygulanır</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "apply"
                    ],
                    "common_phrases": [
                        "no longer pertain"
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir durumda geçerli olmak veya uygulanmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçerli olmak",
                                "target_lang_sense_clarification": "Bir kuralın veya durumun yürürlükte olması."
                            },
                            {
                                "target_lang_word": "uygulanmak",
                                "target_lang_sense_clarification": "Bir kuralın bir duruma tatbik edilmesi."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f8cb2cc-a0dd-3cfb-acb3-29b222db43f6",
                    "sense_definition": "To be appropriate, suitable, or fitting.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His solemn demeanor did not <w>pertain</w> to such a joyous celebration.",
                            "target_lang_translations": {
                                "tr": "Onun ciddi tavrı, böylesine neşeli bir kutlamaya <w>uygun değildi</w>."
                            }
                        },
                        {
                            "text": "Formal attire would best <w>pertain</w> to an event of this importance.",
                            "target_lang_translations": {
                                "tr": "Bu önemdeki bir etkinlik için resmi kıyafet en <w>uygunu</w> olacaktır."
                            }
                        }
                    ],
                    "synonyms": [
                        "suit",
                        "befit"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English in this sense."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Uygun, münasip veya yakışır olmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uygun olmak",
                                "target_lang_sense_clarification": "Bir duruma veya ortama yakışır, yerinde olmak."
                            },
                            {
                                "target_lang_word": "uymak",
                                "target_lang_sense_clarification": "Bir durumla bağdaşmak veya yakışmak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}