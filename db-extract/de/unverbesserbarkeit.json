                "senses": [
                    {
                        "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                        "entry_id": "a41bd9e7-55c6-3a56-be8a-ac4357f2d575",
                        "glosses": [
                            "Zustand/Eigenschaft, sich nicht (mehr) korrigieren/berichtigen zu lassen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5b0c0147-6b44-42d1-895d-f403246883ca",
                                "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                                "text": "„Aus seiner Wahrheit ist in der Christenheit oft die falsche Konsequenz eines christlichen Konservatismus gezogen worden, der im Namen der Unverbesserbarkeit der Welt die Verbesserbarkeit der Verhältnisse bestritt.“"
                            },
                            {
                                "example_id": "5160c859-12d4-45a7-9530-846f1e08b57e",
                                "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                                "text": "„Der dortigen Betonung der Unveränderlichkeit und Unverbesserbarkeit der regula fidei entspricht hier die Beschreibung ihres graduellen prior als regula principalis.“"
                            },
                            {
                                "example_id": "f7f51de3-a64d-4632-aabf-9681a3dc573f",
                                "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                                "text": "„Zunächst ist es ganz und gar nicht eindeutig, ob ein Urteil der Unfehlbarkeit oder Unverbesserbarkeit für irgendeine von ihnen gerechtfertigt ist.“"
                            },
                            {
                                "example_id": "e7a694ab-7139-44c1-aab7-396338bafb6e",
                                "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                                "text": "„Die Erklärung der Unverbesserbarkeit des Menschen ist die schärfste Abwendung von Raimunds Besserungstheater.“"
                            },
                            {
                                "example_id": "bb0eebc4-b564-411b-b48b-7d7d1be86ee8",
                                "sense_id": "995d45f5-9633-34e3-a866-0df02b7e729e",
                                "text": "„Mit seiner Einsicht in die Unverbesserbarkeit des Volkes will Brunner keine Trauer und keine Beschuldigung verbinden, sondern er will Aufklärung bringen und eine Abrechnung vornehmen […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
