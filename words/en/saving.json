{
    "word_family": [
        "save",
        "saver",
        "savior",
        "salvation",
        "safe"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48fe7224-c6e9-37c2-9c49-f40a6e289194",
                    "sense_definition": "Money that has been set aside for the future rather than spent immediately.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to put all her <w>savings</w> into a high-interest bank account.",
                            "target_lang_translations": {
                                "ru": "Она решила положить все свои <w>сбережения</w> на банковский счет с высокими процентами."
                            }
                        },
                        {
                            "text": "The sudden medical emergency forced the family to use their life <w>savings</w>.",
                            "target_lang_translations": {
                                "ru": "Внезапная медицинская помощь заставила семью использовать все свои пожизненные <w>накопления</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nest egg",
                        "capital",
                        "funds"
                    ],
                    "antonyms": [
                        "debt",
                        "expenditure"
                    ],
                    "common_phrases": [
                        "life savings",
                        "savings account",
                        "personal savings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, отложенные на будущее, а не потраченные сразу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбережения",
                                "target_lang_sense_clarification": "накопленные деньги"
                            },
                            {
                                "target_lang_word": "накопления",
                                "target_lang_sense_clarification": "результат процесса накопления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b203543-c2cf-3987-940b-ce4eb07b3127",
                    "sense_definition": "A reduction in the amount of money, time, or resources that is used or needed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Switching to solar panels resulted in a significant cost <w>saving</w> for the company.",
                            "target_lang_translations": {
                                "ru": "Переход на солнечные панели привел к значительной <w>экономии</w> средств для компании."
                            }
                        },
                        {
                            "text": "The new software offers a time <w>saving</w> of nearly two hours per day.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение обеспечивает <w>экономию</w> времени почти на два часа в день."
                            }
                        }
                    ],
                    "synonyms": [
                        "reduction",
                        "economy",
                        "cut"
                    ],
                    "antonyms": [
                        "increase",
                        "waste"
                    ],
                    "common_phrases": [
                        "cost saving",
                        "time saving",
                        "net saving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение количества денег, времени или ресурсов, которые используются или требуются."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономия",
                                "target_lang_sense_clarification": "сокращение расходов или затрат"
                            },
                            {
                                "target_lang_word": "сбережение",
                                "target_lang_sense_clarification": "сохранение ресурсов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ae1ba96-eeaa-33e9-bb09-9999977d66b4",
                    "sense_definition": "The act of rescuing someone or something from danger or harm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saving</w> of the historic building from demolition was a victory for the community.",
                            "target_lang_translations": {
                                "ru": "<w>Спасение</w> исторического здания от сноса стало победой для общества."
                            }
                        },
                        {
                            "text": "He was honored for his role in the <w>saving</w> of three children from the fire.",
                            "target_lang_translations": {
                                "ru": "Его наградили за роль в <w>спасении</w> троих детей из огня."
                            }
                        }
                    ],
                    "synonyms": [
                        "rescue",
                        "preservation",
                        "salvage"
                    ],
                    "antonyms": [
                        "destruction",
                        "abandonment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт спасения кого-либо или чего-либо от опасности или вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасение",
                                "target_lang_sense_clarification": "избавление от опасности"
                            },
                            {
                                "target_lang_word": "сохранение",
                                "target_lang_sense_clarification": "защита от разрушения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f225fe16-8b53-3ea2-b21a-aa15c75cf21c",
                    "sense_definition": "A formal exception or reservation made in a legal document or agreement.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract included a <w>saving</w> clause to protect the company in case of market collapse.",
                            "target_lang_translations": {
                                "ru": "Контракт включал <w>сохранительную</w> оговорку для защиты компании в случае краха рынка."
                            }
                        },
                        {
                            "text": "The new law contains <w>saving</w> and transitional provisions for existing businesses.",
                            "target_lang_translations": {
                                "ru": "Новый закон содержит <w>оговорки</w> и переходные положения для существующих предприятий."
                            }
                        }
                    ],
                    "synonyms": [
                        "reservation",
                        "exception",
                        "proviso"
                    ],
                    "common_phrases": [
                        "saving clause"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное исключение или оговорка, сделанная в юридическом документе или соглашении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оговорка",
                                "target_lang_sense_clarification": "условие в документе"
                            },
                            {
                                "target_lang_word": "сохранительная оговорка",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32399347-4b3e-3707-b93e-d23e6c5a637c",
                    "sense_definition": "Designed to reduce the consumption of a resource like energy, time, or labor.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "efficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We replaced all the old bulbs with <w>energy-saving</w> ones to lower our bills.",
                            "target_lang_translations": {
                                "ru": "Мы заменили все старые лампочки на <w>энергосберегающие</w>, чтобы уменьшить счета."
                            }
                        },
                        {
                            "text": "The dishwasher is a great <w>labour-saving</w> device for busy families.",
                            "target_lang_translations": {
                                "ru": "Посудомоечная машина — отличное <w>трудосберегающее</w> устройство для занятых семей."
                            }
                        }
                    ],
                    "synonyms": [
                        "efficient",
                        "economical"
                    ],
                    "antonyms": [
                        "wasteful"
                    ],
                    "common_phrases": [
                        "energy-saving",
                        "labour-saving",
                        "time-saving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный для снижения потребления ресурсов, таких как энергия, время или труд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "энергосберегающий",
                                "target_lang_sense_clarification": "о технике"
                            },
                            {
                                "target_lang_word": "экономящий",
                                "target_lang_sense_clarification": "сокращающий затраты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a57e2b3-9b94-32fd-b9f0-fb4133c626ca",
                    "sense_definition": "Careful in the use of money or resources; avoiding waste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frugality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>saving</w> cook knows how to make a delicious meal from leftovers.",
                            "target_lang_translations": {
                                "ru": "<w>Бережливый</w> повар знает, как приготовить вкусное блюдо из остатков еды."
                            }
                        },
                        {
                            "text": "He was known as a <w>saving</w> and sensible man who never spent more than necessary.",
                            "target_lang_translations": {
                                "ru": "Он был известен как <w>экономный</w> и разумный человек, который никогда не тратил больше необходимого."
                            }
                        }
                    ],
                    "synonyms": [
                        "frugal",
                        "thrifty",
                        "economical"
                    ],
                    "antonyms": [
                        "extravagant",
                        "prodigal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бережное использование денег или ресурсов; избегание расточительства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бережливый",
                                "target_lang_sense_clarification": "экономный человек"
                            },
                            {
                                "target_lang_word": "экономный",
                                "target_lang_sense_clarification": "рационально расходующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e21ed2-7efc-338f-a7b5-a29917625253",
                    "sense_definition": "Having the power or quality of preserving or rescuing from harm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rescue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saving</w> grace of the situation was that no one was actually hurt.",
                            "target_lang_translations": {
                                "ru": "<w>Спасительным</w> моментом в этой ситуации было то, что никто на самом деле не пострадал."
                            }
                        },
                        {
                            "text": "He believed in the <w>saving</w> strength of his faith during difficult times.",
                            "target_lang_translations": {
                                "ru": "Он верил в <w>спасительную</w> силу своей веры в трудные времена."
                            }
                        }
                    ],
                    "synonyms": [
                        "preserving",
                        "rescuing",
                        "protective"
                    ],
                    "antonyms": [
                        "destructive"
                    ],
                    "common_phrases": [
                        "saving grace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий силой или качеством сохранения или спасения от вреда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасительный",
                                "target_lang_sense_clarification": "выручающий в беде"
                            },
                            {
                                "target_lang_word": "сохраняющий",
                                "target_lang_sense_clarification": "оберегающий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce8ba43a-7b51-3076-a37f-2180527cd72b",
                    "sense_definition": "Relating to the rescue of a soul from sin or damnation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preacher spoke of the <w>saving</w> power of divine mercy.",
                            "target_lang_translations": {
                                "ru": "Проповедник говорил о <w>спасительной</w> силе божественного милосердия."
                            }
                        },
                        {
                            "text": "They sought <w>saving</w> knowledge through the study of ancient scriptures.",
                            "target_lang_translations": {
                                "ru": "Они искали <w>спасительное</w> знание через изучение древних писаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "redemptive",
                        "salvific"
                    ],
                    "common_phrases": [
                        "saving faith"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к спасению души от греха или проклятия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спасительный",
                                "target_lang_sense_clarification": "религиозный контекст"
                            },
                            {
                                "target_lang_word": "спасающий",
                                "target_lang_sense_clarification": "дарующий спасение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "859dee62-9ff1-371a-8c31-cf1c4fdc8571",
                    "sense_definition": "The present participle and gerund of the verb <w>save</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>saving</w> money to buy a new car next year.",
                            "target_lang_translations": {
                                "ru": "Я <w>коплю</w> деньги, чтобы купить новую машину в следующем году."
                            }
                        },
                        {
                            "text": "The lifeguard is <w>saving</w> the swimmer who got into trouble.",
                            "target_lang_translations": {
                                "ru": "Спасатель <w>спасает</w> пловца, попавшего в беду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий глагола 'save'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копящий",
                                "target_lang_sense_clarification": "о деньгах"
                            },
                            {
                                "target_lang_word": "спасающий",
                                "target_lang_sense_clarification": "о процессе спасения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "9128d587-5c96-34c9-b0b6-67b06e5ac214",
                    "sense_definition": "With the exception of; excluding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was empty <w>saving</w> for a single wooden chair in the corner.",
                            "target_lang_translations": {
                                "ru": "Комната была пуста, <w>кроме</w> единственного деревянного стула в углу."
                            }
                        },
                        {
                            "text": "No one knew the secret <w>saving</w> he who had discovered the map.",
                            "target_lang_translations": {
                                "ru": "Никто не знал секрета, <w>кроме</w> того, кто нашел карту."
                            }
                        }
                    ],
                    "synonyms": [
                        "except",
                        "save",
                        "but"
                    ],
                    "antonyms": [
                        "including"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "often used in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "За исключением; исключая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроме",
                                "target_lang_sense_clarification": "за исключением"
                            },
                            {
                                "target_lang_word": "исключая",
                                "target_lang_sense_clarification": "помимо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c88e14a-39cc-3630-a1cd-7f7947836fc8",
                    "sense_definition": "Used as a polite way to introduce a statement that might otherwise be considered disrespectful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "politeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Saving</w> your presence, I think the plan is bound to fail.",
                            "target_lang_translations": {
                                "ru": "<w>Да</w> <w>простят</w> <w>меня</w> присутствующие, но я думаю, что план обречен на провал."
                            }
                        },
                        {
                            "text": "He is a bit of a fool, <w>saving</w> your reverence.",
                            "target_lang_translations": {
                                "ru": "Он немного глуповат, <w>не</w> <w>в</w> <w>обиду</w> <w>вашей</w> <w>милости</w> будь сказано."
                            }
                        }
                    ],
                    "synonyms": [
                        "despite"
                    ],
                    "common_phrases": [
                        "saving your presence",
                        "saving your reverence"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "formal and dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется как вежливый способ введения утверждения, которое в противном случае могло бы считаться неуважительным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не в обиду будь сказано",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            },
                            {
                                "target_lang_word": "да простят меня",
                                "target_lang_sense_clarification": "вежливая оговорка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}