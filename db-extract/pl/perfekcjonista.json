                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "39ff4811-2961-4e2a-b546-89a9263ab8e1",
                        "source_entry_id": "329f2ba1-fd8c-3e91-9485-d0f03a121e59",
                        "source_sense_id": "d2fd756c-cb5e-3b9d-8e48-415f29f2631c",
                        "target_lang_word": "perfectionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfectionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
                                        "entry_id": "8d5d1402-3274-301a-9b51-bb193660e987",
                                        "glosses": [
                                            "Qui a tendance à rechercher la perfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66939af4-c8f3-4c97-bc1e-cf051ae463ce",
                                                "sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
                                                "text": "Les chanceux sont du groupe A, car ils sont considérés comme ordonnés, perfectionnistes, ou du groupe O (donneur universel), dotés de qualités de leaders."
                                            },
                                            {
                                                "example_id": "a2196a24-f26f-4440-b2aa-02bd69dc2993",
                                                "sense_id": "c297ca2c-4a83-35d7-a9de-1ebd6345e414",
                                                "text": "Perfectionniste dans ses rôles et adepte de son professeur d’art dramatique Stella Adler, qui demandait à ses élèves de « défictionner » la fiction, il apprit à jouer du saxophone pour le film New York, New York, un film musical de Martin Scorsese sorti en 1977."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "perfectionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8151dafa-1d77-37d9-b56b-cd443626280c",
                                        "entry_id": "94a8fe2a-c527-3972-b2d1-bf6c5c269b2a",
                                        "glosses": [
                                            "Personne qui a tendance à rechercher la perfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "519614fa-b558-4d0e-83d6-45d12c59a0f0",
                                                "sense_id": "8151dafa-1d77-37d9-b56b-cd443626280c",
                                                "text": "Cette fausse imperfection, qui leur demande des heures de travail et fait gémir le perfectionniste, voilà le défi qu’aiment les pirates du Rat’s Look."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2197c888-e866-48c3-9c6e-f46d6fe50f9a",
                        "source_entry_id": "329f2ba1-fd8c-3e91-9485-d0f03a121e59",
                        "source_sense_id": "d2fd756c-cb5e-3b9d-8e48-415f29f2631c",
                        "target_lang_word": "perfeccionista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfeccionista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "476c0047-9ea5-3b45-a7f8-927e691f30f1",
                                        "entry_id": "1da1a9d7-8b14-363a-8d48-ae9fe570c1e9",
                                        "glosses": [
                                            "Obsesivo o muy atento a la perfección en cualquier ámbito, que no admite defectos ni errores de ningún tipo."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "662a6625-fb30-47d0-a080-596765e4007d",
                        "source_entry_id": "329f2ba1-fd8c-3e91-9485-d0f03a121e59",
                        "source_sense_id": "d2fd756c-cb5e-3b9d-8e48-415f29f2631c",
                        "target_lang_word": "Perfektionist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perfektionist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                        "entry_id": "1e40f728-2fef-34fd-a186-73e4f3f1860b",
                                        "glosses": [
                                            "Person, die ein Werk (beispielsweise ein handwerkliche Arbeit, einen Aufsatz) absolut fehlerfrei erstellen möchte; Person, die die Erfüllung höchster Standards fordert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea30da8-fa47-4682-962d-40185d845768",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„[DW:] »Dustin Hoffman ist ja bekannt als furchtbarer Perfektionist. Wie war es, wenn zwei Perfektionisten zusammen arbeiten?« [Volker Schlöndorf:] »Alle großen Schauspieler sind Perfektionisten.«“"
                                            },
                                            {
                                                "example_id": "f8f82195-3f47-464a-aa55-0df256014401",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "[Ennio Morricone] gilt als Perfektionist, der besessen an jeder Note feilt."
                                            },
                                            {
                                                "example_id": "dd13de57-5889-4a96-8f40-418e06a20668",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„Beethoven war ein Perfektionist. Er komponierte nicht für seine Zeitgenossen, sondern für die Nachwelt. Immer wieder feilte er an seinen Werken, überarbeitete und korrigierte die Partituren bis spät in die Nacht.“"
                                            },
                                            {
                                                "example_id": "b123d935-e1ef-44f6-abc9-a6360d345107",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„Stefan Soltész zählt zu den Perfektionisten seiner Zunft, ein Arbeitstier, das nach Mitternacht Empfänge verlässt, um eine Partitur durchzuarbeiten.“"
                                            },
                                            {
                                                "example_id": "5ca73c99-a2e3-4fa3-a0ae-169ee53aa888",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„[Die französische Sportpresse] beschrieb Tuchel als gesundheitsbewussten Vegetarier und autoritären Perfektionisten, als detailverliebten Strategen und Ordnungsfanatiker […].“"
                                            },
                                            {
                                                "example_id": "ea4d51dd-dccd-4605-b436-7c9aac5afedb",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„Kai Kazmirek feierte im vergangenen Jahr mit WM-Bronze seinen bisher größten Karriereerfolg. Bei der Heim-EM will der ruhige Perfektionist die nächste Medaille folgen lassen.“"
                                            },
                                            {
                                                "example_id": "f69c13e0-3b8f-4a28-b6d1-796a54eda332",
                                                "sense_id": "621b11d5-5d60-3a1b-bde6-c48d10a4a9ff",
                                                "text": "„Wer aufschiebt, ist weder faul noch bequem, sondern eher ein Perfektionist mit (zu) hohen Ansprüchen an sich selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
