                                    {
                                        "sense_id": "f26e534d-99ff-3269-830f-ded2c3b3ca49",
                                        "entry_id": "19d4043f-5283-3afa-92c8-7318de2582bc",
                                        "glosses": [
                                            "The action of the verb to knit; the process of producing knitted material."
                                        ],
