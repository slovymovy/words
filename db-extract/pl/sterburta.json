                    {
                        "translation_id": "6fd8cf01-9a90-46b5-bc7a-564aa320a0a1",
                        "source_entry_id": "86452efa-c98e-3110-961e-7a09d3ac91c8",
                        "source_sense_id": "a4ad4d2d-e727-3287-bdf6-5b780aefc6b4",
                        "target_lang_word": "Steuerbord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steuerbord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                        "entry_id": "16b52858-2ce4-377c-9462-b8a427b3cb95",
                                        "glosses": [
                                            "die in Fahrtrichtung rechte Seite (eines Schiffes oder Luftfahrzeugs)"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbab96d2-e24f-488b-9846-99ce82b66001",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„1847 endlich ergriff Großbritannien als führende Seefahrernation die Initiative und ging mit der Einführung eines Systems voran, das bald allgemeine Zustimmung fand: weißes Topplicht, an Steuerbord ein grünes Licht und an Backbord ein rotes.“"
                                            },
                                            {
                                                "example_id": "964493ba-1781-43ea-bdf3-4432ea1747d4",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Der Eisberg an Steuerbord hat Ähnlichkeit mit dem Opernhaus von Sydney und ist bestimmt dreihundert Meter lang und einhundert Meter groß.“"
                                            },
                                            {
                                                "example_id": "72f0ee1c-756e-4275-abe3-1431875b1994",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Ein Bie-den-Winder zog an Steuerbord langsam vorbei.“"
                                            },
                                            {
                                                "example_id": "5ca0a3d4-7fb7-475f-b3b3-15642a574d94",
                                                "sense_id": "0f813277-42c3-3afb-9ce3-08960bf42fac",
                                                "text": "„Es gab an Bord zwei Kohlebunker, einer lag an Steuerbord, der andere an Backbord.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
