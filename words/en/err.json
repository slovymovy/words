{
    "word_family": [
        "error",
        "erroneous",
        "errancy",
        "errant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c556c8a-07b3-3b4a-9dff-8122013e41c1",
                    "sense_definition": "To make a mistake or commit an error.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is better to <w>err</w> on the side of caution when dealing with dangerous chemicals.",
                            "target_lang_translations": {
                                "pl": "Lepiej <w>popełnić błąd</w> po stronie ostrożności, pracując z niebezpiecznymi chemikaliami."
                            }
                        },
                        {
                            "text": "Even the most experienced scientists sometimes <w>err</w> during complex experiments.",
                            "target_lang_translations": {
                                "pl": "Nawet najbardziej doświadczeni naukowcy czasami <w>mylą się</w> podczas złożonych eksperymentów."
                            }
                        }
                    ],
                    "synonyms": [
                        "blunder",
                        "miscalculate"
                    ],
                    "common_phrases": [
                        "err on the side of"
                    ],
                    "target_lang_definitions": {
                        "pl": "Popełnić błąd lub pomylić się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "popełnić błąd",
                                "target_lang_sense_clarification": "standardowe określenie na zrobienie błędu"
                            },
                            {
                                "target_lang_word": "pomylić się",
                                "target_lang_sense_clarification": "odnosi się do błędnego osądu lub działania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a964b19-4624-321c-b2c0-eb53d73bad23",
                    "sense_definition": "To commit a sin or moral transgression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>err</w> is human, but to forgive is divine.",
                            "target_lang_translations": {
                                "pl": "<w>Błądzić</w> jest rzeczą ludzką, wybaczać boską."
                            }
                        },
                        {
                            "text": "The preacher warned his congregation that all men <w>err</w> in the eyes of the law.",
                            "target_lang_translations": {
                                "pl": "Kaznodzieja ostrzegł wiernych, że wszyscy ludzie <w>grzeszą</w> w oczach prawa."
                            }
                        }
                    ],
                    "synonyms": [
                        "sin",
                        "transgress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in religious or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Popełnić grzech lub wykroczenie moralne."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zgrzeszyć",
                                "target_lang_sense_clarification": "w kontekście religijnym lub moralnym"
                            },
                            {
                                "target_lang_word": "zbłądzić",
                                "target_lang_sense_clarification": "w znaczeniu moralnym, zejść na złą drogę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48215f79-9737-385c-8318-5ab8c6c1ed05",
                    "sense_definition": "To wander or stray from a path or standard.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mistake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler began to <w>err</w> from the marked trail during the heavy fog.",
                            "target_lang_translations": {
                                "pl": "Podróżnik zaczął <w>zbaczać</w> z wyznaczonego szlaku podczas gęstej mgły."
                            }
                        },
                        {
                            "text": "Do not <w>err</w> from the path of righteousness.",
                            "target_lang_translations": {
                                "pl": "Nie <w>zbaczaj</w> ze ścieżki prawości."
                            }
                        }
                    ],
                    "synonyms": [
                        "stray",
                        "wander"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Zboczyć z drogi lub odejść od ustalonego standardu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "błądzić",
                                "target_lang_sense_clarification": "poruszać się bez celu lub szukać drogi"
                            },
                            {
                                "target_lang_word": "zboczyć",
                                "target_lang_sense_clarification": "zejść z wyznaczonej ścieżki"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "e547ad44-9ede-3236-9908-d1cfe513dc80",
                    "sense_definition": "A sound made when hesitating in speech.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Err</w> I am not sure what the answer is yet.",
                            "target_lang_translations": {
                                "pl": "<w>Yyy</w>, nie jestem jeszcze pewien, jaka jest odpowiedź."
                            }
                        },
                        {
                            "text": "<w>Err</w> let me think about that for a moment.",
                            "target_lang_translations": {
                                "pl": "<w>Eee</w>, pozwól mi się nad tym chwilę zastanowić."
                            }
                        }
                    ],
                    "synonyms": [
                        "um",
                        "uh"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in spoken language to indicate hesitation."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Dźwięk wydawany podczas wahania się w mowie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "yyy",
                                "target_lang_sense_clarification": "najczęstszy polski odpowiednik dźwięku wahania"
                            },
                            {
                                "target_lang_word": "eee",
                                "target_lang_sense_clarification": "alternatywny dźwięk wahania"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}