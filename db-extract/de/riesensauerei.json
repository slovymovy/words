                "senses": [
                    {
                        "sense_id": "15f82900-a535-3df7-b8f7-c51ad6fa658f",
                        "entry_id": "84b97735-b943-3b28-a0b2-f7e2e59c3b5b",
                        "glosses": [
                            "extrem große Verunreinigung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc5941f-de28-4fd8-bb87-20eaa0635343",
                                "sense_id": "15f82900-a535-3df7-b8f7-c51ad6fa658f",
                                "text": "„Eine Schrotflinte macht eine Riesensauerei.“"
                            },
                            {
                                "example_id": "349e051b-6c62-482f-b6f1-3073f652d3f6",
                                "sense_id": "15f82900-a535-3df7-b8f7-c51ad6fa658f",
                                "text": "„›Der Tod ist Mist, Philip, aber Sterben ist eine Riesensauerei.‹“"
                            },
                            {
                                "example_id": "9b92c824-5576-41b1-8602-a2161f2ea5de",
                                "sense_id": "15f82900-a535-3df7-b8f7-c51ad6fa658f",
                                "text": "„Und dann überlasse ich meinem Messer das Reden. Es redet unablässig auf sie ein, bis sie und ich und die Küche vollkommen im Einklang sind. Es ist eine Riesensauerei.“"
                            },
                            {
                                "example_id": "fc7f182c-e143-4d39-a260-8a2b690d514b",
                                "sense_id": "15f82900-a535-3df7-b8f7-c51ad6fa658f",
                                "text": "„›Mensch, ich will nicht unbedingt sehen, was Sie zwischen den Beinen haben, und ich will Ihnen auch nicht unbedingt was abschneiden, das gibt nur eine Riesensauerei.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
