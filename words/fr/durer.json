            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5df6f407-d29e-3d00-a622-d31f8757b514",
                    "sense_definition": "Occuper un certain espace de temps, avoir une durée déterminée.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réunion va <w>durer</w> environ deux heures selon l'ordre du jour."
                        },
                        {
                            "text": "Le concert a <w>duré</w> toute la soirée sous les applaudissements du public."
                        }
                    ],
                    "common_phrases": [
                        "durer longtemps",
                        "durer toujours",
                        "durer des heures"
                    ]
                },
                {
                    "sense_id": "80b30d4f-f921-3b6e-b315-25d8f369a991",
                    "sense_definition": "Continuer d'exister, se maintenir ou persister dans le temps.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette belle amitié entre eux <w>dure</w> depuis leur tendre enfance."
                        },
                        {
                            "text": "La crise politique <w>dure</w> encore malgré les nombreuses négociations."
                        }
                    ],
                    "synonyms": [
                        "persister",
                        "subsister",
                        "continuer"
                    ],
                    "antonyms": [
                        "cesser",
                        "finir"
                    ],
                    "common_phrases": [
                        "faire durer",
                        "durer encore"
                    ]
                },
                {
                    "sense_id": "ee023b59-504e-3117-a1ba-073deb725b65",
                    "sense_definition": "Résister à l'usage, à l'usure ou au temps sans s'altérer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces chaussures en cuir solide sont faites pour <w>durer</w> de longues années."
                        },
                        {
                            "text": "Ce matériau de mauvaise qualité ne <w>durera</w> pas face aux intempéries."
                        }
                    ],
                    "synonyms": [
                        "résister",
                        "tenir"
                    ],
                    "common_phrases": [
                        "fait pour durer"
                    ]
                },
                {
                    "sense_id": "dcadb006-b51a-355a-acc6-0f9751acbac7",
                    "sense_definition": "Sembler long et pénible à cause de l'impatience ou de l'ennui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En attendant son retour dans ce couloir froid, le temps me <w>dure</w>."
                        },
                        {
                            "text": "Elle trouvait les heures interminables et le temps lui <w>durait</w> affreusement."
                        }
                    ],
                    "synonyms": [
                        "peser"
                    ],
                    "common_phrases": [
                        "le temps dure"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement employé dans la tournure « le temps dure à quelqu'un »"
                        }
                    ]
                },
                {
                    "sense_id": "047e2340-36dd-3354-a054-d5b4e3bb5ad8",
                    "sense_definition": "Supporter ou tolérer la compagnie de quelqu'un, vivre en paix avec autrui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tolerance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est si colérique et désagréable qu'on ne peut pas <w>durer</w> avec lui."
                        },
                        {
                            "text": "Personne n'a jamais pu <w>durer</w> bien longtemps sous ses ordres autoritaires."
                        }
                    ],
                    "synonyms": [
                        "endurer",
                        "supporter"
                    ],
                    "common_phrases": [
                        "ne pouvoir durer avec quelqu'un"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "S'emploie surtout négativement"
                        }
                    ]
                }
            ]
        }
    ]
