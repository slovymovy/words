                                        "examples": [
                                            {
                                                "example_id": "a5fc5595-38cf-47ab-972b-a02695442fc3",
                                                "sense_id": "9112e2b0-fc9c-3839-a333-587c1c6be25d",
                                                "text": "Меня зовут Станислав."
                                            }
                                        ]
