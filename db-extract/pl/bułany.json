                        "entry_id": "7d8f365b-7a10-355c-a2cb-0cae873e44ce",
                        "glosses": [
                            "o koniu płowy, żółtawobrązowy, z czarną grzywą i ogonem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f839165d-41e2-42c5-b7bb-c8eccc3aeddb",
                                "sense_id": "51af544e-7169-36f0-aadb-451bc8529bd1",
                                "text": "Biegnie konik bułany przez łąki i przez łany, przez kurze i przez kwiaty — w nieznane biegnie światy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
