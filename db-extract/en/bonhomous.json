                        "source_sense_id": "d793b595-2e5f-3af0-a00e-c600e2ecaca5",
                        "source_sense_description": "Translations",
                        "target_lang_word": "gutmütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gutmütig",
