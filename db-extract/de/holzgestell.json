                ],
                "senses": [
                    {
                        "sense_id": "9fff7310-bfb3-3dc0-89a8-e347270eeae4",
                        "entry_id": "2b774c80-31a2-3825-8fca-367f5aedea55",
                        "glosses": [
                            "Gestell aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e052cdc2-763a-4da7-a739-dd8267250b53",
                                "sense_id": "9fff7310-bfb3-3dc0-89a8-e347270eeae4",
                                "text": "„Die Polizisten entdeckten das Holzgestell des rund 60 Kilogramm schweren Automaten später zwischen aufgehäuftem Restmüll an einer Straße.“"
                            },
                            {
                                "example_id": "6b31a3b3-cc55-4fee-8baa-94bd9a7118c9",
                                "sense_id": "9fff7310-bfb3-3dc0-89a8-e347270eeae4",
                                "text": "„Hier oben ist 20 M. über der Erde ein Mensch in einem Holzgestell verfangen und wehrt sich gegen eine freiwillig übernommene unsichtbare Gefahr.“"
                            },
                            {
                                "example_id": "a9056003-ec63-4d1f-bca2-2cfbece7d7eb",
                                "sense_id": "9fff7310-bfb3-3dc0-89a8-e347270eeae4",
                                "text": "„Ich ging in das Kabinett, in dem die Bilder in ihren Holzgestellen standen, und setzte mich auf einen Stuhl.“"
                            },
                            {
                                "example_id": "27f88757-feb4-4dd5-99e7-2f137c9bad76",
                                "sense_id": "9fff7310-bfb3-3dc0-89a8-e347270eeae4",
                                "text": "„Dass man sich auf einem Holzgestell über den Nachttopf setzte, der von einem Hausknecht im Nebenraum durch eine Wandklappe entnommen werden konnte, war ein seltenes Privileg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
