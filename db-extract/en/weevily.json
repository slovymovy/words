                        "glosses": [
                            "Infested with or containing weevils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34778a2-fb59-48b0-9680-b09a9b1c2945",
                                "sense_id": "2cebd3de-6713-304a-9364-733cdf066367",
                                "text": "1813, The Literary Panorama, Volume 13, “State of Trade,” Lloyd’s Coffee House, June 21, p. 1037,\nA considerable portion of the rice now on hand is of inferior quality, and weevily; it gives distaste in families, and few domestics make sufficiently good use of their eyes to pick it carefully."
                            },
                            {
                                "example_id": "7254826e-0643-4605-848f-48d501934506",
                                "sense_id": "2cebd3de-6713-304a-9364-733cdf066367",
                                "text": "O, I’ll have none of your weevily wheat,\nAnd I’ll have none of your barley,\nO, I’ll have none of your weevily wheat\nTo bake a cake for Charlie."
                            },
                            {
                                "example_id": "69a07c09-0666-43e3-8ea5-7a3dece21ed6",
                                "sense_id": "2cebd3de-6713-304a-9364-733cdf066367",
                                "text": "[…] Hornblower remembered the stuffy dark midshipman’s berth, the smells and the creakings, the bitter cold nights, turning out in response to the call for all hands, the weevilly bread and the wooden beef, and he yearned for them all, with the sick feeling of hopeless longing."
                            },
                            {
                                "example_id": "1e73fe6b-7ba3-47d7-add3-f5ac85d5ee74",
                                "sense_id": "2cebd3de-6713-304a-9364-733cdf066367",
                                "text": "Hind had made his fortune provisioning railway construction gangs and lakeboat crews with the very cheapest of weevily foodstuffs."
                            }
                        ]
                    }
