        "fr-extract.jsonl": [
            {
                "entry_id": "996a18d8-ea35-33ca-8beb-13a9972a9fd3",
                "word": "hardiment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e2abfc17-03ae-3db6-b86d-6fdeadb8fbd0",
                        "entry_id": "996a18d8-ea35-33ca-8beb-13a9972a9fd3",
                        "glosses": [
                            "Avec hardiesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4908276-1b84-4c93-863a-7368a4f817e8",
                                "sense_id": "e2abfc17-03ae-3db6-b86d-6fdeadb8fbd0",
                                "text": "Enfin à la nuit faite, des ombres fantômales, s'avançant hardiment vers l'ennemi, commencent à peupler la paix lacustre et mortuaire."
                            },
                            {
                                "example_id": "b6b954f3-6745-47d4-b704-f20f6a3db59f",
                                "sense_id": "e2abfc17-03ae-3db6-b86d-6fdeadb8fbd0",
                                "text": "Je feins hardiment d’avoir reçu de vous L’ordre qu’on me voit suivre et que je donne à tous."
                            },
                            {
                                "example_id": "83dc0081-0373-4fec-a596-014b7d06940d",
                                "sense_id": "e2abfc17-03ae-3db6-b86d-6fdeadb8fbd0",
                                "text": "Qu'un vieux Sertorius aime je ne sais quelle Viriate, et qu’il soit assassiné par Perpenna, amoureux de cette Espagnole, tout cela est petit et puéril ; il le faut dire hardiment."
                            },
                            {
                                "example_id": "59141306-ab6e-4ebb-863f-9af53c3600b8",
                                "sense_id": "e2abfc17-03ae-3db6-b86d-6fdeadb8fbd0",
                                "text": "De la hardiesse, morbleu ! il n'y a pas d’homme qui avale un verre de vin plus hardiment que toi."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a275bb2-6e1a-382b-aefe-cae1557ff258",
                        "entry_id": "996a18d8-ea35-33ca-8beb-13a9972a9fd3",
                        "glosses": [
                            "Avec effronterie, impudence."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "cd428353-8bf8-41f7-a674-0375c710082d",
                                "sense_id": "6a275bb2-6e1a-382b-aefe-cae1557ff258",
                                "text": "Mentir hardiment."
                            },
                            {
                                "example_id": "aac9615e-d1ce-4264-809d-e64c58e3d8ba",
                                "sense_id": "6a275bb2-6e1a-382b-aefe-cae1557ff258",
                                "text": "On tenait devant le roi des conférences qui peuvent être l’origine des académies […] Charlemagne se nommait David ; Alcuin, Albinus ; et un jeune homme nommé Ilgebert, qui faisait des vers en langue romance, prenait hardiment le nom d’Homère."
                            }
                        ]
                    },
                    {
                        "sense_id": "bad10e32-4224-3364-8bbb-4c17e3302df7",
                        "entry_id": "996a18d8-ea35-33ca-8beb-13a9972a9fd3",
                        "glosses": [
                            "Librement, sans hésiter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac27d234-cf45-4828-a675-c8cef542eb71",
                                "sense_id": "bad10e32-4224-3364-8bbb-4c17e3302df7",
                                "text": "Dites-lui hardiment que je n'y consens pas."
                            },
                            {
                                "example_id": "5f1edae6-2b6e-415a-ba8e-8e5986ddff69",
                                "sense_id": "bad10e32-4224-3364-8bbb-4c17e3302df7",
                                "text": "« Hé ! Margrédel, est-ce que, dans le temps, tu n’as pas eu des idées pour Yéri-Hans, de Kirschberg ? Dis-le hardiment ; tu n’as pas besoin de te cacher. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "4a1dd8ec-c297-3b89-8b09-63f1497569ce",
                        "entry_id": "996a18d8-ea35-33ca-8beb-13a9972a9fd3",
                        "glosses": [
                            "Sans crainte de se tromper, d’aller au delà."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "706265da-6aac-460a-ade7-48f015fab731",
                                "sense_id": "4a1dd8ec-c297-3b89-8b09-63f1497569ce",
                                "text": "Vous pouvez hardiment porter cet article à mille écus."
                            }
                        ]
                    }
                ],
