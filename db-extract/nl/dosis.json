                        "cross_references": [
                            {
                                "target_word": "Dosis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81eee058-87b9-39fe-a766-0c35ddb8b15f",
                                        "entry_id": "e36be22f-7d02-3d36-b5fd-ca2238e029c7",
                                        "glosses": [
                                            "genau abgemessene Menge eines Medikaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aa920c6-e953-4a4f-aff1-6da27885eb69",
                                                "sense_id": "81eee058-87b9-39fe-a766-0c35ddb8b15f",
                                                "text": "Das Abstandsquadratgesetz besagt, dass sich aufgrund der Divergenz ionisierender Strahlung, die Dosis pro Fläche mit zunehmendem Abstand vom Fokus verringert."
                                            },
                                            {
                                                "example_id": "ca67475e-f8bc-4563-a980-ae8a84ae5e4c",
                                                "sense_id": "81eee058-87b9-39fe-a766-0c35ddb8b15f",
                                                "text": "„Sie irrt sich in der Dosis, gibt ihm zu viel davon, daran stirbt er abends gegen 8 Uhr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2afa9d0-6128-3301-af3e-dc7918591aa2",
                                        "entry_id": "e36be22f-7d02-3d36-b5fd-ca2238e029c7",
                                        "glosses": [
                                            "gewisse Menge an Strahlung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78a64ce6-90ec-4c1c-a7b6-1127235d06b5",
                        "source_entry_id": "48b9a265-1a52-32a8-9b4b-4010e80672e8",
                        "source_sense_id": "d2254d13-6292-3623-8d74-7029e20e8bc5",
