                    "frequency": "Low",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de <w>opgave</w> van zijn tegenstander ging de tennisser automatisch door in het toernooi.",
                            "target_lang_translations": {
                                "en": "After his opponent's <w>withdrawal</w>, the tennis player automatically advanced in the tournament."
                            }
                        },
                        {
                            "text": "De blessure leidde tot de voortijdige <w>opgave</w> van de wielrenner.",
                            "target_lang_translations": {
                                "en": "The injury led to the cyclist's premature <w>retirement</w> from the race."
                            }
                        }
                    ],
                    "synonyms": [
                        "opgaaf"
                    ],
                    "common_phrases": [
                        "voortijdige opgave"
                    ],
                    "target_lang_definitions": {
                        "en": "stopping a match or struggle before it has finished; withdrawal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "withdrawal",
