                        "glosses": [
                            "Personne qui manifeste un engouement extrême pour quelque chose ou quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a70d285-9414-4de5-9626-b2f74fb48904",
                                "sense_id": "21d2e899-7c5f-34a3-80bd-927e27f18309",
                                "text": "Il y a les hyperenthousiastes, les inconditionnels, ceux qui font quasiment partie de votre famille ; ils viennent vous voir partout, connaissent tout de vous, sont capables de vous réciter par cœur des textes entiers de vos chansons les moins connues, ils ont tous vos disques, les bouquins, les articles des canards, les photos, tout."
