                        "glosses": [
                            "Accent antiflexe."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "d416f9b0-fd44-4af3-a947-2c40c66440f0",
                                "sense_id": "bfafd508-a1e4-353a-a760-2e95a61d3d2d",
                                "text": "Le lecteur voudra bien excuser les limites que nous a imposé la technique utilisée pour la mise en place des signes diacritiques, spécialement sur les sons i surmonté d’un antiflexe ou d’un macron. En effet, au lieu de i̇̌, i̇̄, le lecteur est prié de lire ǐ, ī."
                            },
                            {
                                "example_id": "aae060cf-3b03-4922-b18c-2e201f3f909c",
                                "sense_id": "bfafd508-a1e4-353a-a760-2e95a61d3d2d",
                                "text": "Employer l’antiflexe sur la lettre qui note une voyelle longue et basse. Ex. kubǎza (Kagama, 1960)."
                            }
                        ]
                    }
                ],
