                ],
                "senses": [
                    {
                        "sense_id": "e97de887-b34f-3fda-8678-f424dc7bd3e7",
                        "entry_id": "0d7a8617-c530-37fa-9a42-c36da53c4c36",
                        "glosses": [
                            "Qui a perdu sa dignité, son rang, sa réputation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad31b68-4ed2-4a86-86ce-1f9de1163adc",
                                "sense_id": "e97de887-b34f-3fda-8678-f424dc7bd3e7",
                                "text": "Nous allons marcher sur le Louvre et nous y entrerons à la tête de la compagnie. Vous ferez conduire le roi déchu à Vincennes."
                            },
                            {
                                "example_id": "d4882631-e49a-436c-b300-3852c0a16b81",
                                "sense_id": "e97de887-b34f-3fda-8678-f424dc7bd3e7",
                                "text": "Souvent, il se contentait d’appeler son fils « enfant déchu ». Il criait : « Va me chercher du tabac, enfant déchu… Remonte une bouteille de bière, enfant déchu… »"
                            },
                            {
                                "example_id": "7fc51e51-771d-4eaa-a22c-5ae697436674",
                                "sense_id": "e97de887-b34f-3fda-8678-f424dc7bd3e7",
                                "text": "Joe Biden, à l’image de Gerald Ford dans le cas de Nixon, pourrait ainsi éviter le spectacle navrant et déchirant d’un procès impliquant le président déchu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82a9ec4c-6356-4217-a17b-654cd6bfe4af",
                        "source_entry_id": "0d7a8617-c530-37fa-9a42-c36da53c4c36",
