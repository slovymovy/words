                    "frequency": "Low",
                    "semantic_group_id": "wegnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Opposition versuchte monatelang vergeblich, der amtierenden Regierung die Macht zu <w>entreißen</w>."
