                        "entry_id": "22212331-9b01-3a3d-b069-fe5b23c736d3",
                        "glosses": [
                            "verschließbarer Behälter, meist aus Blech, Plastik, der zum Transport und Aufbewahren von Wasser benutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7c5690-d8e5-43eb-9754-1e0de8a0cfa3",
                                "sense_id": "659b02bc-8dd8-315e-acb1-403fa723451d",
                                "text": "Der Wasserkanister ist offen."
                            },
                            {
                                "example_id": "bf53a433-dc07-40d8-862e-92919e6f4071",
                                "sense_id": "659b02bc-8dd8-315e-acb1-403fa723451d",
                                "text": "„Er drehte sich um und sah eine junge Frau, die sich vorgebeugt hatte und eine lange Stange ablegte, an der sie vier volle Wasserkanister getragen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
