                ],
                "senses": [
                    {
                        "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                        "entry_id": "fe5e41e0-a369-315d-807b-e6e4605fbc04",
                        "glosses": [
                            "Reim am Ende von Verszeilen (oder anderen sprachlichen Ausdrücken)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9978c52-7f9d-49a4-b531-774c3d8844e3",
                                "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                                "text": "Viele Gedichte haben Endreime."
                            },
                            {
                                "example_id": "0fbd6905-40d9-4f0f-bcb5-053378cbc724",
                                "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                                "text": "Oft wird Reim nur im Sinne von Endreim verstanden."
                            },
                            {
                                "example_id": "53a6d7d1-cd02-4af8-8d35-c25a045db400",
                                "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                                "text": "Endreime kommen auch bei Zwillingsformeln (Paarformeln) vor: „Kreti und Pleti“, „dann und wann“."
                            },
                            {
                                "example_id": "3475a472-58d6-4fc4-bf6c-9769c12a9567",
                                "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                                "text": "„Die Endreime waren für ein Sonett bestimmt.“"
                            },
                            {
                                "example_id": "afa13fff-b61b-4c49-bda3-c9bfcda44ac4",
                                "sense_id": "6912837f-90f5-385f-94e0-ebd13acec698",
                                "text": "„Da fallen besonders die Reime auf, Stabreim und Endreim, wie wir sie aus dem Deutschunterricht kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
