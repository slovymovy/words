                        "examples": [
                            {
                                "example_id": "b1cf3f4f-7bb0-4f4d-99e2-a856514d5a0d",
                                "sense_id": "b0d8f7ee-9fc8-37dd-81e5-b9f8ad5881e7",
                                "text": "„Obwohl er bisher keinerlei Erfahrung im Schiffbau hat, will der Sohn des ehemaligen russischen Energieministers und Gazprom-Aufsichtsrats Igor Jussufow die Werft nun selber führen.“"
                            },
                            {
                                "example_id": "a488b448-f3ef-405f-a6f7-236e2f445fef",
                                "sense_id": "b0d8f7ee-9fc8-37dd-81e5-b9f8ad5881e7",
                                "text": "„Der König erbat sich von uns nur Eisen, das er zum Schiffbau brauchte.“"
                            }
                        ],
