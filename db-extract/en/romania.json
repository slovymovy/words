                            {
                                "example_id": "04519b28-c697-4abd-8b9a-b4148c3ee0bf",
                                "sense_id": "b59d0362-1835-38c4-8b5b-d906973f87bc",
                                "text": "There is strong resistance in much of Europe to fracking, the practice of forcing liquid and sand into wells to release trapped oil and gas. France has a ban on fracking, Germany has imposed a moratorium, and opposition has cropped up and sometimes delayed shale exploration in Eastern European countries like Romania and Poland."
                            }
