                        "entry_id": "3891564c-bc23-37cb-843a-783449d442b6",
                        "glosses": [
                            "uczestnictwo w jakimś czynie lub przedsięwzięciu razem z kimś lub czymś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08cca3fa-f021-4af8-b3ca-1340dedc54a0",
                                "sense_id": "c6c99b79-650b-329e-88fa-af0b7f3fd547",
                                "text": "W końcu maja 1944 oddziały AK, przy współudziale partyzantów radzieckich, bazę zlikwidowały"
                            },
                            {
                                "example_id": "01ea1558-fda7-4402-9d95-aa243ae32b08",
                                "sense_id": "c6c99b79-650b-329e-88fa-af0b7f3fd547",
                                "text": "W liście zgodzi się \"oczywiście, z największą radością\" (jak to postanowił sformułować) na współudział w edycji pierwszego, demokratycznego słownika języka polskiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "aba4242f-07a9-3d55-919c-5904ff675b4e",
                        "entry_id": "3891564c-bc23-37cb-843a-783449d442b6",
                        "glosses": [
                            "pomocnictwo, współsprawstwo, przestępstwo zdefiniowane w art. 18 § 3 KK"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12aa819b-5e5a-40ba-ba9c-c8ea2b649854",
                                "sense_id": "aba4242f-07a9-3d55-919c-5904ff675b4e",
                                "text": "Podejrzewani są o współudział w kradzieży, do której doszło w styczniu"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
