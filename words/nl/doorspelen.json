    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c9ca66a4-a189-3421-b208-f0fd91b0ce85",
                    "sense_definition": "Informatie, gegevens of een bal doorgeven aan een ander persoon of een andere instantie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doorgeven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De getuige besloot de geheime documenten direct naar de politie <w>door</w> te <w>spelen</w>.",
                            "target_lang_translations": {
                                "en": "The witness decided to <w>pass on</w> the secret documents directly to the police."
                            }
                        },
                        {
                            "text": "Je moet die belangrijke informatie zo snel mogelijk aan de directie <w>doorspelen</w>.",
                            "target_lang_translations": {
                                "en": "You must <w>forward</w> that important information to the management as soon as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorgeven",
                        "overdragen",
                        "doorsluizen"
                    ],
                    "antonyms": [
                        "achterhouden"
                    ],
                    "common_phrases": [
                        "informatie doorspelen",
                        "gegevens doorspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pass on, forward, or leak information, data, or a ball to another person or organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pass on",
                                "target_lang_sense_clarification": "information or a ball"
                            },
                            {
                                "target_lang_word": "to forward",
                                "target_lang_sense_clarification": "documents or data"
                            },
                            {
                                "target_lang_word": "to leak",
                                "target_lang_sense_clarification": "secret information"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b78ac93-992e-316a-a3e7-4203822ee58a",
                    "sense_definition": "Blijven spelen of doorgaan met een spel of muziekstuk zonder te stoppen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continueren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoewel het hard begon te regenen, wilden de voetballers toch gewoon <w>doorspelen</w>.",
                            "target_lang_translations": {
                                "en": "Although it started to rain heavily, the soccer players still wanted to just <w>play on</w>."
                            }
                        },
                        {
                            "text": "De muzikanten bleven de hele avond <w>doorspelen</w> tot het publiek naar huis ging.",
                            "target_lang_translations": {
                                "en": "The musicians kept <w>playing</w> all evening until the audience went home."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorgaan",
                        "verder spelen"
                    ],
                    "antonyms": [
                        "stoppen",
                        "ophouden"
                    ],
                    "common_phrases": [
                        "gewoon doorspelen",
                        "blijven doorspelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To continue playing a game, sport, or piece of music without stopping."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to play on",
                                "target_lang_sense_clarification": "continue playing in sports or music"
                            },
                            {
                                "target_lang_word": "to keep playing",
                                "target_lang_sense_clarification": "continue a game or music"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}