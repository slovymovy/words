                    "sense_definition": "einen Stall von tierischen Ausscheidungen und altem Stroh säubern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stallarbeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden Samstagmorgen muss der junge Bauer früh aufstehen und den Pferdestall gründlich <w>misten</w>."
                        },
                        {
                            "text": "Nachdem wir die Ställe sorgfältig <w>gemistet</w> hatten, streuten wir frisches Stroh für die Kühe ein."
                        }
                    ],
                    "synonyms": [
                        "ausmisten",
                        "entmisten"
                    ],
