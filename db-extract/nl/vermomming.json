                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec4be0b8-69d0-45ba-9f86-61d17ae5d49e",
                                                "sense_id": "516f36dc-e848-38f8-8647-baede335c89d",
                                                "text": "Prendre un déguisement."
                                            },
                                            {
                                                "example_id": "3b34c54f-c343-443b-aa22-439d596496f5",
                                                "sense_id": "516f36dc-e848-38f8-8647-baede335c89d",
                                                "text": "Il sera difficile de le reconnaître sous ce déguisement."
                                            },
                                            {
                                                "example_id": "03822507-7192-4d65-ada7-251889e888bc",
                                                "sense_id": "516f36dc-e848-38f8-8647-baede335c89d",
                                                "text": "Un déguisement de clown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b67cdc36-3e41-3671-ba99-9ac27196c0e6",
                                        "entry_id": "9f935092-e56b-3e27-b7bd-af58cfeed21c",
                                        "glosses": [
                                            "Fausses apparences, artifice pour cacher la vérité."
                                        ],
