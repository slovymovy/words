                                "sense_id": "2a9a4e98-f08b-3876-b895-4f120b2e455b",
                                "text": "Ons elftal speelt in het oranje; die groenen zijn onze tegenstanders."
                            },
                            {
                                "example_id": "9b8bf33a-1add-4ec9-ab73-9cd7c6f44b21",
                                "sense_id": "2a9a4e98-f08b-3876-b895-4f120b2e455b",
                                "text": "Hij droeg een groene bandana in zijn lange haar en had als een van de weinigen hoge leren bergschoenen om zijn zwakke enkels te beschermen."
                            }
                        ]
                    }
