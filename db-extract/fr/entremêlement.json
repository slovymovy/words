                "senses": [
                    {
                        "sense_id": "dd063a6f-ed62-326d-9056-2319d46d745d",
                        "entry_id": "f5436d42-f8f2-3147-869e-ba319cdbc29f",
                        "glosses": [
                            "Action d’entremêler, résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb1a066e-cffa-49db-a032-6e3f5d56eec8",
                                "sense_id": "dd063a6f-ed62-326d-9056-2319d46d745d",
                                "text": "Il voyait devant lui d’abord l’entremêlement de milliers d’éventails de rangées de tuiles rondes ouverts de tous les côtés, puis l’étendue des toitures aux formes imprécises, diluées dans la chaleur ; enfin, contenant la ville comme dans un bol de terre grise, le cercle des collines râpées de soleil."
                            },
                            {
                                "example_id": "a16d45ca-d431-469b-b41c-bc2dc8362c4b",
                                "sense_id": "dd063a6f-ed62-326d-9056-2319d46d745d",
                                "text": "Elles étaient comme vivantes, d’une consistance inhabituelle, entremêlement de matières minérales et organiques."
                            },
                            {
                                "example_id": "f2d1d5ef-2c0e-4544-a204-a4e34c1de0d4",
                                "sense_id": "dd063a6f-ed62-326d-9056-2319d46d745d",
                                "text": "Quant aux tricotis et entremêlements de guitares, ils raviront ceux qui adoraient les dialogues entre Jerry Harrison et David Byrne renforcés par Adrian Belew au sein de Talking Heads."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfec2fb7-ad1d-4418-a857-3aee3e564fea",
                        "source_entry_id": "f5436d42-f8f2-3147-869e-ba319cdbc29f",
                        "source_sense_id": "dd063a6f-ed62-326d-9056-2319d46d745d",
