                ],
                "senses": [
                    {
                        "sense_id": "57d4eec6-2522-37ec-9a28-e9dccb71f6b4",
                        "entry_id": "2a65e37e-2692-3aa1-b4b9-a950934ad5ca",
                        "glosses": [
                            "действие по значению гл. отъезжать; отправление в путь (в экипаже, поезде, верхом и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b1919c-687a-41ed-b478-cb4ed2911136",
                                "sense_id": "57d4eec6-2522-37ec-9a28-e9dccb71f6b4",
                                "text": "Татьяне страшен зимний путь. Отъезда день давно просрочен."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72cc77bb-1201-4b5f-9fa6-7a05da5b118f",
                        "source_entry_id": "2a65e37e-2692-3aa1-b4b9-a950934ad5ca",
                        "source_sense_id": "57d4eec6-2522-37ec-9a28-e9dccb71f6b4",
                        "target_lang_word": "departure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "departure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The act of departing or something that has departed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f37bf43-822c-4d43-b05d-9f8c781a200e",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "The departure was scheduled for noon."
                                            },
                                            {
                                                "example_id": "8733b008-122d-442f-a7e6-f2de85cfb329",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "The departure was not unduly prolonged. In the road Mr. Love and the driver favoured the company with a brief chanty running: “Got it?—No, I ain't, 'old on,—Got it? Got it?—No, 'old on sir.”"
                                            },
                                            {
                                                "example_id": "11f822ed-3319-4375-beb3-245d602c6119",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "But the outstanding feature of the new timetable arrangement, additional to the standardised departure times, is the number of intermediate points, in addition to such principal cities as Bristol, Plymouth, Cardiff and Birmingham, that now have departures for Paddington at the same minutes past the hour throughout the day."
                                            },
                                            {
                                                "example_id": "d27d924e-face-4bfa-a84b-290a6c3b0b26",
                                                "sense_id": "87e95196-cd02-3e7f-8a18-02e4e7327ea7",
                                                "text": "Villa spent most of the second period probing from wide areas and had a succession of corners but despite their profligacy they will be glad to overturn the 6-0 hammering they suffered at St James' Park in August following former boss Martin O'Neill's departure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "A deviation from a plan or procedure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d9991c-1888-4801-990a-5956d1dbe751",
                                                "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                                "text": "any departure from a national standard"
                                            },
                                            {
                                                "example_id": "cc4fdb11-f9ff-44b5-a12c-5cd587d2d2d4",
                                                "sense_id": "0b96ea70-c1ad-3702-8376-12446148ca5a",
                                                "text": "There are several significant departures, however, from current practice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "A death."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51923c57-f2dc-4969-b57d-4c5e09c26e4f",
                                                "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                                "text": "The time of my departure is at hand."
                                            },
                                            {
                                                "example_id": "d42d739b-030b-4fd2-9787-1154a86c963f",
                                                "sense_id": "9237fd92-61fd-3482-9db8-1634f7c44cf6",
                                                "text": "His timely departure […] barred him from the knowledge of his son's miseries.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4e1f441-5208-3545-bdcd-8334bae07678",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The distance due east or west made by a ship in its course reckoned in plane sailing as the product of the distance sailed and the sine of the angle made by the course with the meridian."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "015f8494-5324-3fd7-87d0-3b1d950cf8c3",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The difference in easting between the two ends of a line or curve."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d912ab6-cd30-45e1-a8e5-c8a62d6ddf96",
                                                "sense_id": "015f8494-5324-3fd7-87d0-3b1d950cf8c3",
                                                "text": "The area is computed by latitudes and departures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a50eb3d0-40f2-3660-ac92-ccf6e458da70",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "The desertion by a party to any pleading of the ground taken by him in his last antecedent pleading, and the adoption of another"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a96ffe20-7374-3892-a0be-8a6e8f8e4a90",
                                        "entry_id": "9ce0f29e-4f97-3c51-b0ef-745ffb396be0",
                                        "glosses": [
                                            "Division; separation; putting away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5af2c1b-7b77-4c60-8766-c29477a81770",
                                                "sense_id": "a96ffe20-7374-3892-a0be-8a6e8f8e4a90",
                                                "text": "no other remedy […] but absolute departure"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddb6ee3c-9e17-4cc5-9bd4-8f73cf95ec4e",
                        "source_entry_id": "2a65e37e-2692-3aa1-b4b9-a950934ad5ca",
                        "source_sense_id": "57d4eec6-2522-37ec-9a28-e9dccb71f6b4",
                        "target_lang_word": "Abfahrt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abfahrt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "Beginn einer Fahrt (meist zu einem bestimmten Zeitpunkt oder ab einem bestimmten, örtlich festgelegten Punkt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efd44fc8-62ba-42d7-acd6-f7ab8d567031",
                                                "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                                "text": "Abfahrt 9.52 Uhr, Hamburg-Hauptbahnhof, Gleis 5"
                                            },
                                            {
                                                "example_id": "3a769847-c604-4ded-a527-d992b26ebbce",
                                                "sense_id": "fc452c1a-86cb-3993-9873-c03662f86d1d",
                                                "text": "„Obwohl es noch Stunden bis zur Abfahrt waren, kam ich dank des Staus von Autos und Lkws nicht einmal bis an die Schranke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "257671f8-b717-37c0-a681-3b443cad08a9",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "abwärts gerichtete Schräge zum Hinabfahren oder Herabfahren mit einem Fahrzeug, Sportgerät oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca41c3ba-08e6-42b0-854b-5dd9127332cd",
                                                "sense_id": "257671f8-b717-37c0-a681-3b443cad08a9",
                                                "text": "Die Abfahrt wurde immer steiler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "die Fahrt nach unten, die Fahrt herab oder hinab"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2edd8b88-2a98-4e89-84bf-50323b9ec13b",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "Die Abfahrt wurde immer steiler."
                                            },
                                            {
                                                "example_id": "eca62c81-5369-4102-9ed3-e5e07a8a411c",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "Eine Abfahrt in den Schacht könnte an jedem Tag die letzte sein, denn der Bergbau in manchen Gegenden ist mit einem hohen Risiko für Leib und Leben verbunden."
                                            },
                                            {
                                                "example_id": "542102ee-bd74-4006-9624-c2ebc7a772f5",
                                                "sense_id": "9c6f55be-8a0c-3e8c-9d10-1a23587414c6",
                                                "text": "„Seitnerkogel ist der Skigipfel des Seitnerzinkens, von dem die Abfahrt ins Gullingtal gut möglich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "Abfahrtslauf, eine Sportdisziplin beim Skilaufen"
                                        ],
                                        "tags": [
                                            "Kurzform für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6887a72c-8866-4953-b5ed-2004e383a0d1",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "„Spätestens bei den Olympischen Winterspielen 2018 in Südkorea soll Mikaela neben Slalom und Riesenslalom auch in den Speed-Disziplinen Abfahrt und Super-G um Medaillen mitfahren.“"
                                            },
                                            {
                                                "example_id": "de30a09e-720e-4cc9-8847-2261e0e4b781",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Mit dem überraschenden Sieg des Südtirolers Werner Heel endete die erste von zwei Weltcup-Abfahrten im norwegischen Kvitfjell."
                                            },
                                            {
                                                "example_id": "c70678a0-0690-4235-aa1e-a0185471fe64",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Die Abfahrt findet statt am Samstag nun erst am Sonntag um 13:00 Uhr statt, weil für diesen Tag die Prognosen deutlich besser sind als für Samstag."
                                            },
                                            {
                                                "example_id": "61feb804-f364-440a-9567-7b34dff6ff92",
                                                "sense_id": "cf311949-1485-3997-8f08-324050087f64",
                                                "text": "Die US-Amerikanerin hatte Samstag die Abfahrt überlegen mit 62 Hundertstel Vorsprung auf die Kanadierin Kelly Vanderbeek (Kan) gewonnen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                        "entry_id": "97cff0f1-4f66-35fb-94e4-5e14f2007cdb",
                                        "glosses": [
                                            "von einer Autobahn wegführende Straße; Ausfahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e7ae9c-7dbb-4589-8afa-e1f1748cd374",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Der Hinweis auf die Gutsschänke Neuhof bei der Abfahrt Langen südlich Frankfurt ist ebensowenig vergessen wie der Blaubeurer „Forellenfischer\"."
                                            },
                                            {
                                                "example_id": "68f5a360-22c4-47dd-b808-bc4c334113e5",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Dagegen erscheint mir, nach der Landung aus Chicago, Miami, San Franzisko, das Stück Autobahn zwischen Frankfurter Kreuz und Abfahrt Aschaffenburg wie ein einziger Alptraum."
                                            },
                                            {
                                                "example_id": "dc2961f3-5f46-41a5-a0b9-6fdc01b69058",
                                                "sense_id": "80ebac38-05dd-3160-ad4f-99a0e7b1b2ba",
                                                "text": "Nach Angaben des Touringclubs blieben Dienstag früh zahlreiche Lkw auf der schneeglatten Fahrbahn auf der Westautobahn vor der Abfahrt Salzburg Mitte und bei Salzburg Nord hängen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
