        "nl-extract.jsonl": [
            {
                "entry_id": "8b1e83cf-9ed0-3011-8560-6be4c5a49dc8",
                "word": "glooiend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c62b7e5-d088-3c14-b8a7-749c5faae4e2",
                        "entry_id": "8b1e83cf-9ed0-3011-8560-6be4c5a49dc8",
                        "glosses": [
                            "met bergen en heuvels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69aa89cc-5639-43b3-afb0-c11fa29f9350",
                                "sense_id": "4c62b7e5-d088-3c14-b8a7-749c5faae4e2",
                                "text": "„In het aangepaste plan zijn we met de vereniging overeengekomen dat de bestaande buitenmanege wordt uitgebreid en ingepast in de glooiende Rijssense Es”, zegt wethouder Roland Cornelissen."
                            },
                            {
                                "example_id": "30efe187-f104-4107-a475-54d936813146",
                                "sense_id": "4c62b7e5-d088-3c14-b8a7-749c5faae4e2",
                                "text": "Na vandaag volgen nog drie eendagswedstrijden van de Challenge Mallorca. Vrijdag staat de Trofeo Serra de Tramuntana op het programma. Dat is een wedstrijd op een glooiend parcours over ruim 140 kilometer."
                            },
                            {
                                "example_id": "57f2ce54-61b8-4932-acda-2e75f01bb53a",
                                "sense_id": "4c62b7e5-d088-3c14-b8a7-749c5faae4e2",
                                "text": "De glooiende velden in Calabrië bijvoorbeeld waren voor moderne, grootschalige landbouw ongeschikt geworden, vertelt Cusani. Hennepplanten, die zo kostbaar zijn dat ze sowieso met de hand bewerkt moeten worden, vormen wel een ideale begroeiing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a303f369-604f-47b2-aff9-4c1312076202",
                        "source_entry_id": "8b1e83cf-9ed0-3011-8560-6be4c5a49dc8",
                        "source_sense_id": "4c62b7e5-d088-3c14-b8a7-749c5faae4e2",
