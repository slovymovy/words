                    {
                        "sense_id": "609e5477-4f40-33d7-8d75-4eb973a41d2c",
                        "entry_id": "76bf4089-b804-39d1-9292-dd68d27574eb",
                        "glosses": [
                            "einem Dom zugeteilter Baumeister, welcher der Ingenieurwissenschaften mächtig ist und den Dombau vorantreibt"
                        ],
                        "tags": [
                            "Berufsbezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "66d6a73f-de4a-46dc-bcb4-c01a9e6f442e",
                                "sense_id": "609e5477-4f40-33d7-8d75-4eb973a41d2c",
                                "text": "„Nach zwei Jahren als Dombaumeister hatte Michael Hauck die außerordentliche Kündigung erhalten – ein ungewöhnlicher Vorgang auf einem Posten, der als so gut wie verbeamtet gilt.“"
                            },
                            {
                                "example_id": "feb9c150-c766-4d89-ab8c-81fbe3d4dfd9",
                                "sense_id": "609e5477-4f40-33d7-8d75-4eb973a41d2c",
                                "text": "„Für Wenzels Vorgänger als Dombaumeister lassen sich keine Verbindungen zum Prager Dombau nachweisen; …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
