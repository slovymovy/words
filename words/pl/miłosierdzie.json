{
    "word_family": [
        "miłosierny",
        "miłosiernie",
        "niemiłosierny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "208565c4-6667-37ba-b22b-0fdac1bf9d88",
                    "sense_definition": "Okazywane współczucie, dobroć i chęć niesienia pomocy cierpiącym lub przebaczania winnym.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sędzia nie okazał oskarżonemu żadnego <w>miłosierdzia</w>.",
                            "target_lang_translations": {
                                "ru": "Судья не проявил к обвиняемому никакого <w>милосердия</w>.",
                                "en": "The judge showed the defendant no <w>mercy</w>."
                            }
                        },
                        {
                            "text": "To był wielki akt <w>miłosierdzia</w> wobec potrzebujących pomocy.",
                            "target_lang_translations": {
                                "ru": "Это был великий акт <w>милосердия</w> по отношению к нуждающимся в помощи.",
                                "en": "It was a great act of <w>mercy</w> toward those in need of help."
                            }
                        }
                    ],
                    "synonyms": [
                        "litość",
                        "współczucie",
                        "zmiłowanie"
                    ],
                    "antonyms": [
                        "okrucieństwo",
                        "bezwzględność"
                    ],
                    "common_phrases": [
                        "okazać miłosierdzie",
                        "czynić miłosierdzie",
                        "akt miłosierdzia",
                        "siostra miłosierdzia"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявленное сострадание, доброта и желание помочь страдающим или простить виновных.",
                        "en": "Compassion, kindness, and readiness to help those suffering or to forgive wrongdoers."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милосердие",
                                "target_lang_sense_clarification": "готовность помочь из сострадания"
                            },
                            {
                                "target_lang_word": "сострадание",
                                "target_lang_sense_clarification": "чувство жалости к чужому горю"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "mercy",
                                "target_lang_sense_clarification": "forgiveness or leniency toward wrongdoers or sufferers"
                            },
                            {
                                "target_lang_word": "compassion",
                                "target_lang_sense_clarification": "sympathetic pity and concern for the suffering of others"
                            },
                            {
                                "target_lang_word": "clemency",
                                "target_lang_sense_clarification": "mercy or leniency, especially shown by a judge or ruler"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26be5f6e-96f6-3439-b258-62046557184d",
                    "sense_definition": "W teologii: nieskończona dobroć Boga wobec ludzi, objawiająca się w przebaczaniu grzechów.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlą się o <w>miłosierdzie</w> dla całego świata.",
                            "target_lang_translations": {
                                "ru": "Верующие молятся о <w>милосердии</w> для всего мира.",
                                "en": "The faithful pray for <w>mercy</w> for the whole world."
                            }
                        },
                        {
                            "text": "Zakonnice codziennie odmawiają koronkę do <w>Miłosierdzia</w> Bożego.",
                            "target_lang_translations": {
                                "ru": "Монахини ежедневно читают венчик <w>Милосердию</w> Божию.",
                                "en": "The nuns recite the Chaplet of the Divine <w>Mercy</w> every day."
                            }
                        }
                    ],
                    "synonyms": [
                        "zmiłowanie"
                    ],
                    "common_phrases": [
                        "Miłosierdzie Boże",
                        "Koronka do Miłosierdzia Bożego"
                    ],
                    "target_lang_definitions": {
                        "ru": "В теологии: бесконечная доброта Бога к людям, проявляющаяся в прощении грехов.",
                        "en": "In theology: the infinite goodness and grace of God toward humankind, shown through the forgiveness of sins."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милосердие",
                                "target_lang_sense_clarification": "Божественная благодать и прощение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "mercy",
                                "target_lang_sense_clarification": "divine grace and forgiveness of sins"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}