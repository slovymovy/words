                "senses": [
                    {
                        "sense_id": "09eb589b-0ca9-3a80-84d0-355cea67e6d0",
                        "entry_id": "67f67f4e-d5e1-3e61-ab4a-f833447ec2be",
                        "glosses": [
                            "Genre de sels et d’esters qui sont produits par l’acide oléique et une base."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c9c1b69-c955-4ed3-aa99-332e0911e1e8",
                                "sense_id": "09eb589b-0ca9-3a80-84d0-355cea67e6d0",
                                "text": "L’oléate et le margarate de soude sont deux autres principes qui peuvent être retirés immédiatement du sang, auquel ils n’appartiennent pas d’une manière exclusive ; on les rencontre dans d’autres liquides organiques , notamment dans la bile."
                            },
                            {
                                "example_id": "ccd0b5d1-a53d-4d81-a561-ac013dea0a60",
                                "sense_id": "09eb589b-0ca9-3a80-84d0-355cea67e6d0",
                                "text": "Les oléates alcalins, mélangés avec les stéarates et les palmitates, constituent des savons. Ceux-ci sont d'autant plus mous qu'ils contiennent plus d’oléates de potasse, et d'autant plus durs qu'ils sont plus riches en stéarates et palmitates de soude."
                            }
                        ]
                    }
                ],
