                "senses": [
                    {
                        "sense_id": "c113f737-6c93-34b3-85f3-0f9e6bd9fc45",
                        "entry_id": "4b305b90-0c3d-3f48-a34c-b33d41f28938",
                        "glosses": [
                            "Tout à fait simple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716bb36b-47ce-4183-8934-9b55cceef9d2",
                                "sense_id": "c113f737-6c93-34b3-85f3-0f9e6bd9fc45",
                                "text": "Bright Mississipi est une mélodie simplissime, chantante."
                            },
                            {
                                "example_id": "4939bbc9-56af-47a9-8317-9cc116aec43f",
                                "sense_id": "c113f737-6c93-34b3-85f3-0f9e6bd9fc45",
                                "text": "En plus d’être stylé, ce gloss dessine des courbes parfaites et bien définies, grâce à un applicateur pinceau digne des professionnels du maquillage. L’application est facile, rapide, les contours sont nets et précis. Et si vous avez eu un faux mouvement, la rectification est simplissime, d’un coup de pinceau !"
                            },
                            {
                                "example_id": "82fdadde-aad2-4838-9f48-b8bc43dbf5b8",
                                "sense_id": "c113f737-6c93-34b3-85f3-0f9e6bd9fc45",
                                "text": "Excellente maniabilité du personnage, objets, règles et graphismes simplissimes : l’impression d’un contrôle total est très rapide."
                            }
                        ]
                    }
                ],
