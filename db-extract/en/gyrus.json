                                "target_senses": [
                                    {
                                        "sense_id": "ed616220-9dfa-3a98-9889-0629ef0e7705",
                                        "entry_id": "9d1a8f8b-ab6e-3cc9-a6cd-d0bcc7f5d33e",
                                        "glosses": [
                                            "povrch předmětu ve tvaru šroubovice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdef9f7c-fc2f-4b23-9245-c20b40d3178f",
                                                "sense_id": "ed616220-9dfa-3a98-9889-0629ef0e7705",
                                                "text": "Pojistný šroub bude nutno vyměnit, protože má opotřebovaný závit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38921b6d-a483-39d9-b152-75a2f780c223",
                                        "entry_id": "9d1a8f8b-ab6e-3cc9-a6cd-d0bcc7f5d33e",
                                        "glosses": [
                                            "část spirály odpovídající jedné otáčce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac8063f-5e8d-4c6f-8a5c-097104c3daff",
                                                "sense_id": "38921b6d-a483-39d9-b152-75a2f780c223",
                                                "text": "Primární a sekundární cívky v transformátoru mají nestejný počet závitů."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb87e77-5945-32b8-a6c4-aaca2e459420",
                                        "entry_id": "9d1a8f8b-ab6e-3cc9-a6cd-d0bcc7f5d33e",
                                        "glosses": [
                                            "část mozku vymezená na povrchu rýhami"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a1df1c-37cd-4a26-95cb-bc04b43302bd",
                                                "sense_id": "8cb87e77-5945-32b8-a6c4-aaca2e459420",
                                                "text": "Centrum motoriky je umístěno v posledním závitu čelního laloku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
