                "senses": [
                    {
                        "sense_id": "377ab31f-a4c9-3cb5-a754-c16e39164b55",
                        "entry_id": "e125916f-73bb-3b4e-937c-fc20e437cbf8",
                        "glosses": [
                            "Handwerker, der Lauten anfertigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9293bbdf-71f0-45de-a25d-cb08a252edb4",
                                "sense_id": "377ab31f-a4c9-3cb5-a754-c16e39164b55",
                                "text": "„Dass Antonio Stradivari (1644 oder 1648 – 1737) außergewöhnlich gut klingende Violinen, Bratschen und Violoncelli gebaut hat, ist wohlbekannt. Doch hat er, der auch das Handwerk des Lautenmachers beherrschte, vor dem Wechsel vom 17. zum 18. Jahrhundert auch etliche Lauten, Gamben, Mandolinen und Gitarren fabriziert.“"
                            },
                            {
                                "example_id": "882148d1-29ce-49c6-9def-799bb836c10f",
                                "sense_id": "377ab31f-a4c9-3cb5-a754-c16e39164b55",
                                "text": "„Unter den süddeutschen Städten scheint Nürnberg im 15. Jahrhundert der Hauptort für Lautenfabrikation geworden zu sein, 1461 wird ein Hans Ott Lautenmacher, 1463 ein Konrad Gerla oder Gerl daselbst aufgeführt, welcher letztere seine Kunst auf eine Reihe seiner Nachkommen vererbt; […]“"
                            },
                            {
                                "example_id": "d34fce80-da84-4ea9-a403-f1fb5f7acac6",
                                "sense_id": "377ab31f-a4c9-3cb5-a754-c16e39164b55",
                                "text": "„Unter den 19 Geigen⸗ und Lautenmachern und 11 Blaſeinſtrumentenmachern Wiens gibt es Männer von ſeltener Geſchicklichkeit.“ [1835]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
