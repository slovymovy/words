                            {
                                "example_id": "3002a4c5-49f7-47d5-921e-cb5fe434d826",
                                "sense_id": "a993a656-32aa-353a-915f-0a0c1c852513",
                                "text": "Hast du was Neues von Jennifer gehört?"
                            }
