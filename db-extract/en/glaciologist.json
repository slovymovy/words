                        "source_sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
                        "source_sense_description": "one who studies glaciers",
                        "target_lang_word": "Gletscherforscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gletscherforscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17822c9e-f3fd-3d78-bd99-e84c83d182ba",
                                        "entry_id": "5ebab1f8-ff96-3b30-a5dc-4cdd69b0d52f",
                                        "glosses": [
                                            "Forscher, der sich mit der Erforschung der Gletscher beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28412ad1-465a-427a-876e-871ca0070d28",
                                                "sense_id": "17822c9e-f3fd-3d78-bd99-e84c83d182ba",
                                                "text": "„Eine Verhinderung des Klimawandels ist nicht mehr möglich, glaubt Gletscherforscher Georg Kaser.“"
                                            },
                                            {
                                                "example_id": "41d978b8-d63d-4a0e-9866-2c3922c1b908",
                                                "sense_id": "17822c9e-f3fd-3d78-bd99-e84c83d182ba",
                                                "text": "„Angesichts steigender Temperaturen prophezeien Gletscherforscher, dass 95 Prozent der rund 4000 Eisfelder in den Alpen bis Ende dieses Jahrhunderts verschwinden könnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7944481-edaf-4183-9e97-9a1c8275151d",
                        "source_entry_id": "96d37f07-080e-3b18-89f9-aae29c4e187c",
                        "source_sense_id": "14e4a947-6311-3ce8-aa29-87f2cb9df4d1",
                        "source_sense_description": "one who studies glaciers",
                        "target_lang_word": "Gletscherforscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gletscherforscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                                        "entry_id": "710bceed-c781-3247-b7df-b01b0b5654d2",
                                        "glosses": [
                                            "Forscherin, die sich mit der Erforschung der Gletscher beschäftigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d69267c0-fd5c-445c-9feb-e34e4e6846a8",
                                                "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                                                "text": "„Selbst wenn die Gletscher doppelt so schnell schmelzen würden und überhaupt kein Schnee mehr falle, seien rund 50 Jahre nötig, um sie vollständig zum Verschwinden zu bringen, so die Gletscherforscherin.“"
                                            },
                                            {
                                                "example_id": "60228151-085b-400d-bf0b-eb349f83bf2c",
                                                "sense_id": "755998a4-f5e8-32b9-8bdf-b807fb29ff0f",
                                                "text": "„Die Gletscherforscherin Astrid Lambrecht von der Universität Innsbruck erläuterte, verschärft werde die Situation, da auch die Gletscher langfristig als Wasserreservoirs in den Bergen spürbar schrumpften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
