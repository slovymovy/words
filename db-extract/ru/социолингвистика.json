                    {
                        "translation_id": "aa1d0f93-82b0-4e60-9763-0637d6c22fbf",
                        "source_entry_id": "47e87a40-7463-389c-848f-32d17d403009",
                        "source_sense_id": "f2d7b9c8-bc4e-3f8c-badb-26c6d44a9475",
                        "target_lang_word": "Soziolinguistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Soziolinguistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                                        "entry_id": "ed3ef110-13d7-3192-a93a-de3e7e326cbc",
                                        "glosses": [
                                            "linguistische Disziplin, die die sprachlichen Unterschiede zwischen verschiedenen sozialen Gruppen einer Sprachgemeinschaft erforscht"
                                        ],
                                        "tags": [
                                            "Soziolinguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f6e3621-c511-4f58-a680-9bed3b9773a3",
                                                "sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                                                "text": "Die Soziolinguistik erforscht den Zusammenhang zwischen sozialen Gruppen und ihrem je verschiedenen Sprachgebrauch."
                                            },
                                            {
                                                "example_id": "80c183a4-abae-4945-8046-8f06adbe04a1",
                                                "sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                                                "text": "„Zum anderen sind gerade in jüngerer Zeit zahlreiche Untersuchungen im Bereich der Soziolinguistik unternommen worden, die darauf abzielen, den Einfluß außersprachlicher Faktoren auf die spezielle Gestalt und den Gebrauch einzelner Mundarten zu bestimmen (…).“"
                                            },
                                            {
                                                "example_id": "75a61f33-df5f-4521-b507-ef54f5064b5b",
                                                "sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                                                "text": "„Dies ist der Forschungsbereich der Soziolinguistik im engeren Sinne.“"
                                            },
                                            {
                                                "example_id": "2efe4703-7811-427c-809f-3be1b28ea4ae",
                                                "sense_id": "88c39cfe-176c-3d35-b597-51c9f3de4784",
                                                "text": "„Eine Verbindung des korrelationalen und interaktionalen Ansatzes der Soziolinguistik könnte ferner für pädolinguistische Fragen auf der Basis des kommunikativen Aktes fruchtbar gemacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
