                                        "glosses": [
                                            "runde Lauffigur bei zum Beispiel Eislaufen und Rollschuhfahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854fc61a-54d6-426a-afb5-42ddc148ef5a",
                                                "sense_id": "db1f3e95-a991-3459-961c-d5bc834bec22",
