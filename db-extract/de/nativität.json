                    {
                        "sense_id": "439bd267-85be-3d74-9001-726e652592e3",
                        "entry_id": "7a0eac55-0c24-3ae4-abab-9324b314c58d",
                        "glosses": [
                            "Konstellation/Stand der Sterne/Gestirne im Moment der Geburt einer Person"
                        ],
                        "tags": [
                            "Astrologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b55dd2ab-7d3f-4187-ad3e-c4c0481cf51c",
                                "sense_id": "439bd267-85be-3d74-9001-726e652592e3",
                                "text": "„Was hättest du denn gern? Soll ich dir die Nativität stellen (ein Horoskop erstellen)?“"
                            },
                            {
                                "example_id": "cdb6d4be-1ddf-4565-94a7-83fec2318f88",
                                "sense_id": "439bd267-85be-3d74-9001-726e652592e3",
                                "text": "„So sind auch die Arten eine Nativität zu stellen, wie oben gedacht, gar unterschiedlich, und daher müssen die Astrologi, welche z. E. dem Regiomontano folgen, die Prophezeyungen, so auf eine andere Methode sich gründen, verwerffen, wann sie schon eintreffen.“ (1739)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0291770b-a2f2-3f75-8204-e8c874bd632e",
                        "entry_id": "7a0eac55-0c24-3ae4-abab-9324b314c58d",
                        "glosses": [
                            "Geburtsstunde"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c6786a-1a0d-4dd5-91ec-1aca186ef40c",
                                "sense_id": "0291770b-a2f2-3f75-8204-e8c874bd632e",
                                "text": "„ Revolutiones sind nichts anders/ als wann ein Gestirn wieder herumbkombt in den Ort, an welchem es in der Nativität gestanden.“ (1651)"
                            }
                        ],
                        "sense_index_json": "\"2\""
