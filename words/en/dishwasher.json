{
    "word_family": [
        "dishwash",
        "dishwashing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "59cc2d42-d235-3ff7-8225-2e8ccadd0c3a",
                    "sense_definition": "A machine for washing dishes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kitchen appliances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please help me <w>load</w> the <w>dishwasher</w> after we finish eating dinner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помоги мне загрузить <w>посудомоечную машину</w> после того, как мы закончим ужинать."
                            }
                        },
                        {
                            "text": "Our new <w>dishwasher</w> is very quiet and cleans the plates perfectly.",
                            "target_lang_translations": {
                                "ru": "Наша новая <w>посудомойка</w> работает очень тихо и идеально отмывает тарелки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "load the dishwasher",
                        "empty the dishwasher",
                        "run the dishwasher"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина для мытья посуды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посудомоечная машина",
                                "target_lang_sense_clarification": "полное название бытового прибора"
                            },
                            {
                                "target_lang_word": "посудомойка",
                                "target_lang_sense_clarification": "разговорное название прибора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c133222-8c5c-3ac6-9a25-fbb6a5941859",
                    "sense_definition": "Someone who washes dishes, especially one hired to wash dishes in a restaurant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "occupations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He started his career as a <w>dishwasher</w> in a small local cafe.",
                            "target_lang_translations": {
                                "ru": "Он начал свою карьеру в качестве <w>мойщика посуды</w> в небольшом местном кафе."
                            }
                        },
                        {
                            "text": "The restaurant is looking for a reliable <w>dishwasher</w> to work the evening shift.",
                            "target_lang_translations": {
                                "ru": "Ресторан ищет надежного <w>мойщика посуды</w> для работы в вечернюю смену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "restaurant dishwasher",
                        "hired as dishwasher"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который моет посуду, особенно нанятый для этой работы в ресторане."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мойщик посуды",
                                "target_lang_sense_clarification": "мужчина, занимающийся этой работой"
                            },
                            {
                                "target_lang_word": "мойщица посуды",
                                "target_lang_sense_clarification": "женщина, занимающаяся этой работой"
                            },
                            {
                                "target_lang_word": "посудомойка",
                                "target_lang_sense_clarification": "разговорное обозначение человека"
                            },
                            {
                                "target_lang_word": "судомойка",
                                "target_lang_sense_clarification": "устаревающее или разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d64bfb45-cb02-31da-9c0e-2968c40b0567",
                    "sense_definition": "A European bird, the wagtail.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country people often refer to the water-wagtail as a <w>dishwasher</w>.",
                            "target_lang_translations": {
                                "ru": "Сельские жители часто называют трясогузку <w>посудомойкой</w>."
                            }
                        },
                        {
                            "text": "I spotted a <w>dishwasher</w> nesting near the mouth of the old mine shaft.",
                            "target_lang_translations": {
                                "ru": "Я заметил <w>трясогузку</w>, гнездящуюся у входа в старую шахту."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in some British dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Европейская птица, трясогузка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясогузка",
                                "target_lang_sense_clarification": "название птицы в британских диалектах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "437067d3-febe-32cc-8e60-09790c15c246",
                    "sense_definition": "A bird, the restless flycatcher (Myiagra inquieta).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In Australia, the restless flycatcher is sometimes colloquially called a <w>dishwasher</w> due to its sound.",
                            "target_lang_translations": {
                                "ru": "В Австралии беспокойную миагру иногда в просторечии называют <w>посудомойкой</w> из-за издаваемого ею звука."
                            }
                        },
                        {
                            "text": "The <w>dishwasher</w> hovered over the grass while making its unique grinding noise.",
                            "target_lang_translations": {
                                "ru": "<w>Миагра</w> парила над травой, издавая свой уникальный скрежещущий звук."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Австралийская птица, беспокойная миагра (Myiagra inquieta)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойная миагра",
                                "target_lang_sense_clarification": "вид птицы в Австралии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}