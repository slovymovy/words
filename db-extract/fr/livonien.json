                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8717fb7-4225-3a0f-8f99-cdb176a140a6",
                                        "entry_id": "fac655f8-31d8-3f85-b0d2-bf072712123a",
                                        "glosses": [
                                            "A member of the Livonian people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42795fdb-e6b3-4cb8-b1de-9a6e8f19d8e1",
                                                "sense_id": "c8717fb7-4225-3a0f-8f99-cdb176a140a6",
                                                "text": "We must assume that possession of the lands occupied by the Livs was simply asserted, just as designating the entire littoral as Livonia was asserted before the territory was fully conquered."
                                            }
