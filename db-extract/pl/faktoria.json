                                "target_senses": [
                                    {
                                        "sense_id": "b0a097e2-ec4b-31b9-b35b-a6e24dde313a",
                                        "entry_id": "b65889b5-7dad-36ad-8fce-fca5f2c7c23f",
                                        "glosses": [
                                            "überseeische Handelsniederlassung in der Kolonialzeit"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7fdc387-4710-4178-8774-56a392ad5d69",
                                                "sense_id": "b0a097e2-ec4b-31b9-b35b-a6e24dde313a",
                                                "text": "„Diese spezifische Faktorei mit einheimischem Baumaterial befindet sich im Hinterland.“"
                                            },
                                            {
                                                "example_id": "b1d17a98-e536-41ed-8fcb-6f99881efadd",
                                                "sense_id": "b0a097e2-ec4b-31b9-b35b-a6e24dde313a",
                                                "text": "„Der Kapitän verkaufte die Ware in der Faktorei.“"
                                            },
                                            {
                                                "example_id": "97bb7bf8-dfc4-4f11-870f-98a1e84cee2b",
                                                "sense_id": "b0a097e2-ec4b-31b9-b35b-a6e24dde313a",
                                                "text": "„Mochte auch das Siegel des Königs an der Speichertür der Faktorei hängen, für Geld war es ein leichtes, Branntwein zu bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e6351dde-645b-444f-9aa9-10b97b29e273",
                        "source_entry_id": "d1a7788d-1fb4-3c50-b78c-3db141657c5e",
