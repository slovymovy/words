                        "à tout moment",
                        "en tout cas",
                        "à tout prix"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ff14495-c295-323f-8787-ee3b302472a8",
                    "sense_definition": "Ensemble complet formé par l'union de toutes ses parties ; totalité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ensemble_nom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ces pièces mécaniques assemblées forment un <w>tout</w> parfaitement cohérent."
