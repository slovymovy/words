                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachreinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c2c4708-d7ab-3895-850e-b11bea1a7434",
                                        "entry_id": "13c5f536-91a0-300d-990a-67cb774a4549",
                                        "glosses": [
                                            "Bestrebung, eine Sprache von Einflüssen anderer Sprachen zu »reinigen«"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419aac06-b94e-4767-8af6-4a24255398fc",
                                                "sense_id": "9c2c4708-d7ab-3895-850e-b11bea1a7434",
                                                "text": "Sprachreinigung ist der Versuch, die Einflüsse anderer Sprachen auf die eigene einzuschränken, wenn man der Ansicht ist, dass die eigene Sprache durch diese Einflüsse gefährdet ist."
                                            },
                                            {
                                                "example_id": "4d18c409-9b6c-45ff-a4fc-e0b59d28d4e9",
                                                "sense_id": "9c2c4708-d7ab-3895-850e-b11bea1a7434",
                                                "text": "Sprachreinigung betrifft vornehmlich den Wortschatz, aber darüber hinaus durchaus auch grammatische Einflüsse, Redewendungen und anderes mehr."
                                            },
                                            {
                                                "example_id": "ba7df45f-02ba-4a3a-8d3f-28489581b5c5",
                                                "sense_id": "9c2c4708-d7ab-3895-850e-b11bea1a7434",
                                                "text": "„Schwerpunkt seiner Untersuchung ist das 19. Jahrhundert, in dem der herkömmliche Fremdwortbegriff im wesentlichen geprägt und die Sprachreinigung erst recht zu einem meist mit gefühlsmäßigen außersprachlichen, insbesondere nationalistischen Argumenten geführten öffentlichen Kampf gegen die Fremdwörter wurde.“"
                                            },
                                            {
                                                "example_id": "e82be971-a374-4fb3-958a-11f9ebd6b036",
                                                "sense_id": "9c2c4708-d7ab-3895-850e-b11bea1a7434",
                                                "text": "„1885 wurde … der »Allgemeine Deutsche Sprachverein« begründet… Er hat sich von abwegigen Übertreibungen der Sprachreinigung ferngehalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
