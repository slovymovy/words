                        "form": "dem Natriumhydroxide"
                    },
                    {
                        "form_id": "372b4810-d1f6-48ef-b34b-44ae7511a5c4",
                        "entry_id": "c5ac514a-d284-3fb3-acd7-478d871b3372",
                        "tags": [
                            "accusative",
