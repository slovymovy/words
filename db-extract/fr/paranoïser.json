                "senses": [
                    {
                        "sense_id": "2dff1e0f-96c4-3c62-bd70-789cede4cbd5",
                        "entry_id": "adf4f1b8-4258-32cf-8ce8-1f455069f978",
                        "glosses": [
                            "Donner un caractère parano à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fd149d-266d-4285-8ca1-dafe5ba4d3cc",
                                "sense_id": "2dff1e0f-96c4-3c62-bd70-789cede4cbd5",
                                "text": "Selon Azouri, le privilège accordé par Freud à la question de l’homosexualité, visait en fait, de la part de Jones, à marginaliser ou à « paranoïser » Ferenczi, alors même que Jung s’éloignait du mouvement."
                            },
                            {
                                "example_id": "7c1230eb-6426-43d7-b9b3-224ed638d401",
                                "sense_id": "2dff1e0f-96c4-3c62-bd70-789cede4cbd5",
                                "text": "Parler du manque seul, revient à forclore obsessionnellement l’agressivité ; parler d’elle seule en oubliant le manque, revient à paranoïser le transfert."
                            }
                        ]
                    }
