                "senses": [
                    {
                        "sense_id": "6c2c2fc8-cea1-3313-bdba-c301cf0f4779",
                        "entry_id": "8277affe-b0b4-35e6-801d-12742d5570b3",
                        "glosses": [
                            "Cesser de prescrire (ou prescrire moins), en particulier en parlant de médicaments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d5306a0-1216-4b70-8833-e8e8f49be95e",
                                "sense_id": "6c2c2fc8-cea1-3313-bdba-c301cf0f4779",
                                "text": "Réduire ou arrêter l’utilisation de médicaments inutiles, voire délétères, vise à \"ne pas nuire\". Mais \"déprescrire\" n’est pas simple."
                            },
                            {
                                "example_id": "55b79ac8-f73f-4830-8fe2-8d5e179f301f",
                                "sense_id": "6c2c2fc8-cea1-3313-bdba-c301cf0f4779",
                                "text": "Quand « déprescrire » les médicaments chez les personnes âgées pour améliorer leur santé ?"
                            },
                            {
                                "example_id": "ab12448e-ec98-411d-b332-51c324c17718",
                                "sense_id": "6c2c2fc8-cea1-3313-bdba-c301cf0f4779",
                                "text": "Déprescrire, c’est l’avenir !"
                            }
                        ]
                    }
