                                    {
                                        "sense_id": "67d8fe48-3a97-3c8d-b4fe-c798bde65fb9",
                                        "entry_id": "1c94be1d-c465-3bea-915f-c810503d3242",
                                        "glosses": [
                                            "förderlich auf etwas oder auch jemanden wirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afe7abd-3ef4-401f-9064-8beae1fd462f",
                                                "sense_id": "67d8fe48-3a97-3c8d-b4fe-c798bde65fb9",
                                                "text": "Die trockene Witterung und der starke Wind begünstigt die Ausbreitung der Waldbrände."
                                            },
                                            {
                                                "example_id": "f6d171d4-b108-42d2-8361-956be6d0f173",
                                                "sense_id": "67d8fe48-3a97-3c8d-b4fe-c798bde65fb9",
                                                "text": "Die Humuszersetzung wird durch den Bodenumbruch begünstigt."
                                            },
                                            {
                                                "example_id": "5df87ffb-334f-4f8e-8778-f9a6d18d3e9d",
                                                "sense_id": "67d8fe48-3a97-3c8d-b4fe-c798bde65fb9",
                                                "text": "Bewegungsmangel [kann] Herzkreislauf-Erkrankungen, Diabetes, Demenz und einige Krebsformen begünstigen oder verursachen."
                                            },
                                            {
                                                "example_id": "459d1b89-842e-4266-869b-45f53184ca2d",
                                                "sense_id": "67d8fe48-3a97-3c8d-b4fe-c798bde65fb9",
                                                "text": "„Das Glück blieb ihm immer treu und begünstigte ihn in allen Dingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69a90741-b5f9-32b3-a9f0-058b41f1895a",
                                        "entry_id": "1c94be1d-c465-3bea-915f-c810503d3242",
                                        "glosses": [
                                            "etwas oder jemanden deutlich besser behandeln und somit bevorzugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "038ebc8b-98f4-4e8c-9a8b-d3949a8e8575",
                                                "sense_id": "69a90741-b5f9-32b3-a9f0-058b41f1895a",
                                                "text": "„Das Glück blieb ihm immer treu und begünstigte ihn in allen Dingen.“"
                                            },
                                            {
                                                "example_id": "a3256847-d71c-4f27-82bd-ee478bda20fe",
                                                "sense_id": "69a90741-b5f9-32b3-a9f0-058b41f1895a",
                                                "text": "„Wer in Kenntnis seiner Zahlungsunfähigkeit einem Gläubiger eine Sicherheit oder Befriedigung gewährt […] und ihn dadurch absichtlich oder wissentlich vor den übrigen Gläubigern begünstigt, wird mit Freiheitsstrafe bis zu zwei Jahren oder mit Geldstrafe bestraft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
