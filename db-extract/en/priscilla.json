    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cdaa81d4-1112-30a3-adb0-c3dff4fcc6d7",
                "word": "Priscilla",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "46f4ca16-6cdd-3062-bafc-26d08dc28c81",
                        "entry_id": "cdaa81d4-1112-30a3-adb0-c3dff4fcc6d7",
                        "glosses": [
                            "A female given name from Latin of biblical origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9acaabe2-1a4a-490b-b397-235780d36cfd",
                                "sense_id": "46f4ca16-6cdd-3062-bafc-26d08dc28c81",
                                "text": "Letters written by Alden, and full of the name of Priscilla, / Full of the name and the fame of the Puritan maiden Priscilla!"
                            },
                            {
                                "example_id": "7707dba4-2b8d-4678-b4af-86bd816942a9",
                                "sense_id": "46f4ca16-6cdd-3062-bafc-26d08dc28c81",
                                "text": "'Priscilla,' she said, --- 'The same name I've had for twenty years!' She smiled cynically. 'And, before you ask why, I was stoned when I chose it, so any thoughts of Cill were in my subconscious. I used to think it was classier than Louise or Daisy... probably because the Trevelyans were such snobs.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "73f32358-50e6-3ba7-8939-570cd6cda242",
                        "entry_id": "cdaa81d4-1112-30a3-adb0-c3dff4fcc6d7",
                        "glosses": [
                            "An early Christian, mentioned in the Bible and also known as Prisca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a598e67-a561-4d29-b38e-89331cfbc60e",
                                "sense_id": "73f32358-50e6-3ba7-8939-570cd6cda242",
                                "text": "And found a certain Jew named Aquila, born in Pontus, lately come from Italy, with his wife Priscilla; (because that Claudius had commanded all Jews to depart from Rome:) and came unto them."
                            }
                        ]
                    }
                ],
