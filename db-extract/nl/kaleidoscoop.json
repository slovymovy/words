                    {
                        "sense_id": "5e6f2a80-c277-34f1-83bd-dcff59030f68",
                        "entry_id": "72c26d4f-d763-32d1-9777-c77d4cd76106",
                        "glosses": [
                            "kijker, bestaand uit een spiegelende veelhoekige buis of koker die aan het ene einde een compartiment met gekleurde kralen of andere kleurige voorwerpen bevat en zo bij ronddraaien om de lengteas telkens wisselende patronen laat zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2027fce-f957-4593-8bca-5765484525b1",
                                "sense_id": "5e6f2a80-c277-34f1-83bd-dcff59030f68",
                                "text": "Kaleidoscopen werden in 1816 bedacht door David Brewster, een Schotse geleerde die veel verstand had van licht."
                            },
                            {
                                "example_id": "91ab96c8-6b82-4fd0-8fb4-a8fe2c063f74",
                                "sense_id": "5e6f2a80-c277-34f1-83bd-dcff59030f68",
                                "text": "⧖ De voormalige Jou-Jous, zijn thans door eene aardigheid vervangen, die eerst tot een speeltuig voor kinderen diende, maar thans te Parijs, te Londen en te Brussel, in handen der galante wereld is overgegaan. Het is eene soort van Verrekijker, Kaleidoscoop genaamd, van binnen aangevuld met onderscheidene stukjes gekleurde glazen, die zich bij de minste beweging veranderen, en zoodoende, zoo wel bij het daglicht als des avonds bij lamp- of kaarslicht, eene verscheidenheid van vermakelijke voorwerpen opleveren."
                            }
                        ]
                    },
                    {
                        "sense_id": "674cd1cb-2e9f-3193-b2a1-3c3656fb1d5c",
                        "entry_id": "72c26d4f-d763-32d1-9777-c77d4cd76106",
                        "glosses": [
                            "iets dat heel veelvormig en veranderlijk is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4b4eddba-5abc-4757-8b0d-d3b9924bef37",
                                "sense_id": "674cd1cb-2e9f-3193-b2a1-3c3656fb1d5c",
                                "text": "YouTube is een kaleidoscoop gevuld met alle gekte, schoonheid, liefde en kwaadaardigheid die de mens rijk is."
                            },
                            {
                                "example_id": "aceabdb9-eebb-490a-a069-8ca0a6f240cc",
                                "sense_id": "674cd1cb-2e9f-3193-b2a1-3c3656fb1d5c",
                                "text": "‘De wereld een kaleidoskoop?’…\nJa, vrienden! 't schijnt mij dus gelegen."
                            }
                        ]
                    }
