        "fr-extract.jsonl": [
            {
                "entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                "word": "tortilla",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a804cdb1-0a61-4b5f-b173-d4f5ff15628a",
                        "entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                        "tags": [
                            "plural"
                        ],
                        "form": "tortillas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "78c611a6-d9d4-3827-9b4d-14e8d9a43186",
                        "entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                        "glosses": [
                            "Galette plate faite avec de la farine de maïs nixtamalisée (en espagnol « tortilla ») et plus rarement avec de la farine de blé (en espagnol « tortilla de harina »), très populaire au Mexique et au Guatemala et utilisée en accompagnement de presque tous les plats mexicains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c24457-0238-4bbb-8a6b-ad27b99220c5",
                                "sense_id": "78c611a6-d9d4-3827-9b4d-14e8d9a43186",
                                "text": "Un sandwich enroulé (wrap en anglais) dans une tortilla de blé, voilà l'idée toute simple née en Californie dans les années 1990."
                            },
                            {
                                "example_id": "7c951b9a-89c7-45b9-a737-283740bda922",
                                "sense_id": "78c611a6-d9d4-3827-9b4d-14e8d9a43186",
                                "text": "Les tacos sont des tortillas garnies de viande, de chorizo ou de poisson."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac130a23-3044-3d65-9271-79d7faf5dbf0",
                        "entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                        "glosses": [
                            "Spécialité espagnole qui s’apparente à une omelette (et, plus spécialement à une omelette aux pommes de terre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bb140b1-1800-4877-a1f2-ba986d7d5f3e",
                                "sense_id": "ac130a23-3044-3d65-9271-79d7faf5dbf0",
                                "text": "Ce déjeuner se compose d’une soupe à l’ail et aux œufs, de l’inévitable tortilla aux tomates, d’amandes grillées et d’oranges, le tout arrosé d’un vin de Val-de-Peñas assez bon, quoique épais à couper au couteau, empoisonnant la poix et couleur de sirop de mûres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e4d2dd1-61c3-4635-a747-46e2f952d3af",
                        "source_entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                        "source_sense_description": "galette",
                        "target_lang_word": "tortilla",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e0ef0e5-b5c7-3362-8850-9f2a29d3054b",
                                        "entry_id": "72197d4a-7364-396b-8991-595af69dcfc0",
                                        "glosses": [
                                            "A type of Mexican flatbread made out of cornmeal or flour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08ef1f9b-f0a2-435a-975e-388f26d32797",
                                                "sense_id": "3e0ef0e5-b5c7-3362-8850-9f2a29d3054b",
                                                "text": "And then she figured out the whole situation in, maybe, ten minutes, just by watching my face across the dinner table. I didn't say more than ten words—'Pass the tortillas.'"
                                            },
                                            {
                                                "example_id": "8543adda-1900-4a71-b758-ab3e7f1f1495",
                                                "sense_id": "3e0ef0e5-b5c7-3362-8850-9f2a29d3054b",
                                                "text": "From this dough are shaped small round forms, or a tortilla press can be used to more easily flatten many perfectly round, thin cakes. Tortilla machines, found all over Mexico and the Southwest, can produce hundreds of tortillas per hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4545eeec-b9f4-3b4e-8f8f-3df45ba81fac",
                                        "entry_id": "72197d4a-7364-396b-8991-595af69dcfc0",
                                        "glosses": [
                                            "Spanish omelette; a type of omelette containing potatoes and onions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df6351a9-d241-4b29-94b2-c2d6ad5b455e",
                                                "sense_id": "4545eeec-b9f4-3b4e-8f8f-3df45ba81fac",
                                                "text": "An authentic Spanish tortilla is traditionally made with just eggs, potatoes, onions, salt and pepper, but this version contains sliced red and green peppers for a bit of extra colour and flavour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a99b55ae-850a-4b00-b0b6-44a24db6ec2f",
                        "source_entry_id": "565449a8-d39e-3e0f-900c-dc6903a93647",
                        "source_sense_description": "galette",
                        "target_lang_word": "tortilla",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Plato a base de huevo batido, al que se incorporan otros ingredientes; el conjunto se frie en una sola pieza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95de3943-4055-42ce-9e46-1687f3796db9",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "¡Ay, huevo mío de dos yemas, que para echar vos guardava yo! ¡Que de uno o de dos hazía yo una tortilla tan dorada que complía mis vergüenças!"
                                            },
                                            {
                                                "example_id": "260514b4-7f78-4e78-85f3-f09fe740a5ed",
                                                "sense_id": "9b085703-e12a-32fe-b97e-6dacd6cdd4d6",
                                                "text": "Luego pasé a un gallinero de más alante, levantó una gallina clueca que estaba empollando dieciocho huevos de raza e hizo una tortilla como pa un banquete."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Porción de masa de harina de maíz o trigo, redonda, plana y muy delgada que se cocina sobre una superficie caliente, habitualmente un comal; forma parte de la gastronomía tradicional de México y América Central."
                                        ],
                                        "tags": [
                                            "Mexico"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2faed898-fde1-4fa7-9c24-9e1ecbb2a01f",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "El principal y de mayor dignidad, poder y autoridad, sacerdote, ayunaba ochenta días antes; los cuatro días primeros no comía ni bebía más de una tortilla de maíz, que no pesaba una onza, y un poquillo de agua."
                                            },
                                            {
                                                "example_id": "0639f1dd-6158-44ea-bb47-60b646ef9de0",
                                                "sense_id": "a235e113-b4a2-370b-88a7-f77ea9009b01",
                                                "text": "La tortilla mexicana no tiene nada que ver con las tortillas francesa o española. Ya lo dije en otro capítulo. Es un disco de masa de maíz que se lamina y sutiliza a palmetazos maestros."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                        "entry_id": "c2f71a3d-d8e6-31ab-ac63-a3c22afe8bc4",
                                        "glosses": [
                                            "Pan aplanado de masa muy compacta, sin levadura y habitualmente con algo de manteca."
                                        ],
                                        "tags": [
                                            "Bolivia",
                                            "Chile",
                                            "Río-de-la-Plata"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a86180-3cb8-4552-9824-4cf31f40568a",
                                                "sense_id": "3819f62e-3dad-351e-ba5a-a2af02e0afbd",
                                                "text": "\"Pase, no más, mozo."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "tortilla",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                        "entry_id": "c3aa138c-5e36-391d-9b45-d3a46f4738bc",
                                        "glosses": [
                                            "Coito entre mujeres."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c0ea0cb-6fb9-408b-9b73-7e5918daed96",
                                                "sense_id": "f5300680-d5f2-3be4-b29f-6dbda4665d4e",
                                                "text": "Esta tuerca, según las del gremio, es una tortillera clásica, de las que hacen ‘tortilla’ de verdad, pubis contra pubis, y no acepta otras variantes de amor sáfico."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe7566fd-c868-4423-aa8b-a2fd1f88949e",
