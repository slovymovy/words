                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "days_of_week",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spotkajmy się we <w>wtorek</w> po południu.",
                            "target_lang_translations": {
                                "ru": "Давай встретимся во <w>вторник</w> после обеда.",
                                "en": "Let's meet on <w>Tuesday</w> afternoon.",
                                "nl": "Laten we <w>dinsdag</w>middag afspreken.",
                                "de": "Treffen wir uns am <w>Dienstag</w> Nachmittag.",
                                "fr": "Retrouvons-nous <w>mardi</w> après-midi.",
                                "it": "Incontriamoci <w>martedì</w> pomeriggio.",
                                "cs": "Sejdeme se v <w>úterý</w> odpoledne.",
                                "tr": "<w>Salı</w> günü öğleden sonra buluşalım.",
                                "es": "Quedemos el <w>martes</w> por la tarde.",
                                "zh": "我们<w>星期二</w>下午见吧。"
                            }
                        },
                        {
                            "text": "W każdy <w>wtorek</w> chodzę na basen.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>вторник</w> я хожу в бассейн.",
                                "en": "Every <w>Tuesday</w> I go to the swimming pool.",
                                "nl": "Elke <w>dinsdag</w> ga ik naar het zwembad.",
                                "de": "Jeden <w>Dienstag</w> gehe ich ins Schwimmbad.",
                                "fr": "Tous les <w>mardis</w>, je vais à la piscine.",
                                "it": "Ogni <w>martedì</w> vado in piscina.",
                                "cs": "Každé <w>úterý</w> chodím na bazén.",
                                "tr": "Her <w>salı</w> havuza giderim.",
                                "es": "Todos los <w>martes</w> voy a la piscina.",
                                "zh": "我每个<w>星期二</w>都去游泳馆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "we wtorek",
                        "w przyszły wtorek",
                        "Wielki Wtorek"
                    ],
                    "target_lang_definitions": {
