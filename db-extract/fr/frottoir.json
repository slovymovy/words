                    {
                        "translation_id": "103d65ed-62a7-43f9-941d-b521997d344d",
                        "source_entry_id": "531a31b4-60d7-3bb4-b573-98912fc54b4a",
                        "source_sense_description": "Pour le parquet",
                        "target_lang_word": "brush",
