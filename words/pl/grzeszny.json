                    "frequency": "Middle",
                    "semantic_group_id": "niemoralny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starał się odrzucić <w>grzeszne</w> myśli, które nie dawały mu spokoju od samego rana.",
                            "target_lang_translations": {
                                "en": "He tried to cast off the <w>sinful</w> thoughts that had been troubling him since early morning."
                            }
                        },
                        {
                            "text": "Taki <w>grzeszny</w> uczynek z pewnością wymaga szczerej spowiedzi i zadośćuczynienia.",
                            "target_lang_translations": {
                                "en": "Such a <w>sinful</w> deed certainly requires sincere confession and reparation."
                            }
