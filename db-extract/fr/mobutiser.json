                "senses": [
                    {
                        "sense_id": "032275e8-5ffb-3351-aa52-e336752ca3e2",
                        "entry_id": "37a2b82a-a9c4-36a8-9175-5f11b67d4e6c",
                        "glosses": [
                            "Donner un caractère rappelant Joseph-Désiré Mobutu à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e78f01-780b-4b72-954b-46fb704bfc04",
                                "sense_id": "032275e8-5ffb-3351-aa52-e336752ca3e2",
                                "text": "Faudrait-il dire que le Burundi tend à être « mobutisé » ?"
                            },
                            {
                                "example_id": "1be927ed-95be-4e1f-9f62-2ea1cef16d5e",
                                "sense_id": "032275e8-5ffb-3351-aa52-e336752ca3e2",
                                "text": "L'administration a été « mobutisée » car l'Etat se confondait avec le parti unique, le MPR-parti état, où l'on retrouvait, aux côtés des administratifs, des danseurs, des chanteurs."
                            },
                            {
                                "example_id": "781ba6c6-a4de-4e57-8f1e-822794749f9e",
                                "sense_id": "032275e8-5ffb-3351-aa52-e336752ca3e2",
                                "text": "Kabila: \"Ne me demandez pas de me mobutiser\""
                            }
                        ]
                    }
