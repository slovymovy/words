                                            },
                                            {
                                                "example_id": "6f3ce923-3bb3-4b5e-a9a9-8235d0f7bb83",
                                                "sense_id": "256baa13-4cb8-3d4e-80d1-5d56965c4f23",
                                                "text": "Hij verzette zijn gedachten en fantaseerde over het groen van Nottingham, dat een stuk aanlokkelijker was dan het uitzicht waar hij bijna de hele dag mee werd geconfronteerd."
                                            },
                                            {
                                                "example_id": "42525272-23c2-4081-a46c-94a08ec6d431",
                                                "sense_id": "256baa13-4cb8-3d4e-80d1-5d56965c4f23",
                                                "text": "Al sinds Socrates is een van de grondbeginselen van de wijsbegeerte dat mensen uitzonderlijk slecht in staat zijn onderscheid te maken tussen wat ze nodig hebben en wat ze zich wensen, tussen wat een voorwaarde is voor hun welzijn en wat alleen maar aanlokkelijk lijkt, maar hen in werkelijkheid zou kunnen schaden of benadelen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a6c869a-d474-413d-b018-5a7b000bccc3",
                        "source_entry_id": "251f746a-72b7-36b4-8cb0-8c5cd039c906",
                        "source_sense_id": "b43a4e43-c66f-31cf-a558-24f535510814",
                        "target_lang_word": "aantrekkelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aantrekkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                        "entry_id": "19a31603-7d3f-3889-a637-28a9bc5be3d3",
                                        "glosses": [
                                            "bekoorlijk, fijn, leuk, knap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599ae9a6-8236-44df-b71b-71680b925889",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Ze spelen aantrekkelijk voetbal."
                                            },
                                            {
                                                "example_id": "01721cdc-8389-4652-b775-f99a1dbe4727",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Een filmster is vaak een aantrekkelijke vrouw."
                                            },
                                            {
                                                "example_id": "2cd2e2b1-eb69-49da-b59b-89251c30cd6b",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "De selectiecommissie - Gerard Joling, Danny Rook en Jocye Humblet - zag een bonte stoet huwelijkskandidaten aan zich voorbij trekken die bestond uit aantrekkelijke hunks, doorsnee mannen, 'hangbuikzwijntjes' en zelfs een naar liefde verlangende vrouw."
                                            },
                                            {
                                                "example_id": "d784ad04-7afa-4270-9594-f95582f21d40",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Het is een aantrekkelijk plan om eerst hard te gaan werken en daarna op vakantie te gaan."
                                            },
                                            {
                                                "example_id": "2665b986-aa9b-445e-9fa6-45ac6026a4be",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Ik kon mij voorstellen dat haar poëzie compromisloos experimenteel zou zijn, en van een aantrekkelijke eenzelvige gekte, die in feite een getormenteerde en door geen criticus begrepen verschijningsvorm was van passie die woedde als een uitslaande brand."
                                            },
                                            {
                                                "example_id": "1d198cf3-537e-44aa-b419-6e815154f939",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Wat we kennen als de modernistische beweging was deels een bewuste poging om niet langer begrijpelijke, aantrekkelijke werken te creëren, maar te kiezen voor mysterie en ondoorgrondelijkheid. 'Ik snap niet dat een beschaafd mens tv kan kijken, laat staan een toestel bezitten,' aldus de modernistische dichter W."
                                            },
                                            {
                                                "example_id": "0a1b92c6-6543-4a43-9964-4c46817b2c50",
                                                "sense_id": "f76c9de8-243b-3094-b1fa-d1f051e68ffe",
                                                "text": "Achter het bureau zat een aantrekkelijke vrouw die eind vijftig moest zijn, maar een gladde huid had, in het bijzonder rond haar zwaar opgemaakte ogen, wat voor Rebecca een teken was dat ze ofwel goede genen had, of een goede plastisch chirurg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a912d03-53c7-3739-96a7-6650469673f8",
                                        "entry_id": "19a31603-7d3f-3889-a637-28a9bc5be3d3",
                                        "glosses": [
                                            "licht geraakt, zich dingen aantrekkend"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90353d9f-9f43-4a83-97be-c15d8c877646",
                                                "sense_id": "2a912d03-53c7-3739-96a7-6650469673f8",
                                                "text": "En toch was hij, ten gevolge van zijn ligchaamsgestel, niet zelden zwaarmoedig gestemd en doorgaande gevoelig en aantrekkelijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
