{
    "word_family": [
        "potrafienie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a240aa6-11fb-3e1b-882f-66f44893cfd7",
                    "sense_definition": "mieć odpowiednie umiejętności, wiedzę lub możliwości, aby coś wykonać",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "umiejętność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko <w>potrafi</w> już samodzielnie wiązać sznurowadła.",
                            "target_lang_translations": {
                                "ru": "Ребенок уже <w>умеет</w> самостоятельно завязывать шнурки."
                            }
                        },
                        {
                            "text": "Czy <w>potrafisz</w> mówić po hiszpańsku?",
                            "target_lang_translations": {
                                "ru": "Ты <w>умеешь</w> говорить по-испански?"
                            }
                        }
                    ],
                    "synonyms": [
                        "umieć"
                    ],
                    "common_phrases": [
                        "potrafić czytać",
                        "potrafić pływać"
                    ],
                    "target_lang_definitions": {
                        "ru": "обладать необходимыми навыками, знаниями или возможностями для выполнения чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уметь",
                                "target_lang_sense_clarification": "обладать навыком или способностью что-то делать"
                            },
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "быть в состоянии совершить действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd8194c4-41ce-39c8-ac76-4dd73af1f793",
                    "sense_definition": "być zaprojektowanym lub przystosowanym do pełnienia określonej funkcji",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "funkcja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten nowoczesny telefon <w>potrafi</w> robić zdjęcia pod wodą.",
                            "target_lang_translations": {
                                "ru": "Этот современный телефон <w>может</w> делать снимки под водой."
                            }
                        },
                        {
                            "text": "Program <w>potrafi</w> automatycznie wykrywać błędy w tekście.",
                            "target_lang_translations": {
                                "ru": "Программа <w>может</w> автоматически обнаруживать ошибки в тексте."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "быть спроектированным или приспособленным для выполнения определенной функции"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мочь",
                                "target_lang_sense_clarification": "иметь техническую возможность или функционал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ceb90a3-c336-3e54-b82d-c822f53ee15d",
                    "sense_definition": "mieć tendencję do regularnego wykonywania jakiejś czynności, często ocenianej negatywnie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tendencja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On <w>potrafi</w> spóźnić się na każde ważne spotkanie.",
                            "target_lang_translations": {
                                "ru": "Он <w>способен</w> опоздать на любую важную встречу."
                            }
                        },
                        {
                            "text": "Ona <w>potrafi</w> godzinami narzekać na pogodę.",
                            "target_lang_translations": {
                                "ru": "Она <w>может</w> часами жаловаться на погоду."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "иметь склонность к регулярному совершению какого-либо действия, часто с негативным оттенком"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь привычку",
                                "target_lang_sense_clarification": "регулярно делать что-то (часто раздражающее)"
                            },
                            {
                                "target_lang_word": "быть способным",
                                "target_lang_sense_clarification": "иметь склонность к определенному поведению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee36a194-ed9d-33d7-855f-6711eccb2bd7",
                    "sense_definition": "osiągać określony stan lub przekraczać granice w swoim zachowaniu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "granica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W gniewie człowiek <w>potrafi</w> powiedzieć rzeczy, których potem żałuje.",
                            "target_lang_translations": {
                                "ru": "В гневе человек <w>способен</w> сказать вещи, о которых потом жалеет."
                            }
                        },
                        {
                            "text": "W trudnych warunkach organizm <w>potrafi</w> zmobilizować ukryte siły.",
                            "target_lang_translations": {
                                "ru": "В трудных условиях организм <w>способен</w> мобилизовать скрытые силы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "достигать определенного состояния или выходить за рамки в своем поведении"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть способным",
                                "target_lang_sense_clarification": "иметь потенциал проявить себя определенным образом в экстремальной ситуации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}