                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c79a5ec-aacb-3a91-ae11-2c64f9e8028f",
                        "entry_id": "b8cb8875-b0d0-3d46-961f-c094e1ea2908",
                        "glosses": [
                            "разг. часть, доля, полученная от деления чего либо на сто равных частей; одна сотая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "577f908d-7e8b-43b3-89cd-8c519bb7b9b5",
                                "sense_id": "1c79a5ec-aacb-3a91-ae11-2c64f9e8028f",
                                "text": "Или точнее: годичные колебания температуры выражаются сотыми градуса и едва доходят до 0,1° на глубине 15-16 м."
                            },
                            {
                                "example_id": "ebdbc0a2-cb5d-4f38-ba24-cc83d3e7025d",
                                "sense_id": "1c79a5ec-aacb-3a91-ae11-2c64f9e8028f",
                                "text": "Прежде к военной службе призывалась едва ли одна сотая всех людей…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d953bc89-4117-4fe1-9ae3-826bc8b2f267",
                        "source_entry_id": "b8cb8875-b0d0-3d46-961f-c094e1ea2908",
                        "source_sense_id": "1c79a5ec-aacb-3a91-ae11-2c64f9e8028f",
                        "target_lang_word": "centième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "943db8d9-b36b-3825-b2c6-833039ac0264",
                                        "entry_id": "026fe5ff-028c-3fb2-ac1c-1f7f25a2ddd1",
                                        "glosses": [
                                            "Qui a rapport à cent pour l’ordre, le rang."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69212e73-6939-4813-80ac-910cce8f4825",
                                                "sense_id": "943db8d9-b36b-3825-b2c6-833039ac0264",
                                                "text": "La centième, la deux centième année."
                                            },
                                            {
                                                "example_id": "9a1b4ba2-4604-4023-9ad5-b64d04786619",
                                                "sense_id": "943db8d9-b36b-3825-b2c6-833039ac0264",
                                                "text": "Vous êtes le centième, le deux centième sur la liste."
                                            },
                                            {
                                                "example_id": "27ffc17f-d283-45c0-b1e7-f72967558566",
                                                "sense_id": "943db8d9-b36b-3825-b2c6-833039ac0264",
                                                "text": "— Ça veut dire, dit-elle à l’enfant – écrasée – pour la centième fois, ça veut dire modéré et chantant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d85ecc2-a38e-322d-8f01-8804408853f5",
                                        "entry_id": "026fe5ff-028c-3fb2-ac1c-1f7f25a2ddd1",
                                        "glosses": [
                                            "Qui concerne la fraction centième."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b569cd62-a191-4a76-9e55-58c66394612d",
                                                "sense_id": "7d85ecc2-a38e-322d-8f01-8804408853f5",
                                                "text": "Le centilitre est la centième partie du litre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f368820-eafb-36e7-8f2d-5ae11e0cf76b",
                                        "entry_id": "16445aef-1a02-3555-bb85-66b8f28c6b34",
                                        "glosses": [
                                            "Élément ordinal, correspondant au cardinal 100."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f752fa77-5f51-4136-a016-ab4d6a5ae9c9",
                                                "sense_id": "4f368820-eafb-36e7-8f2d-5ae11e0cf76b",
                                                "text": "Le centième suit le quatre-vingt-dix-neuvième et précède le cent-unième."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92c3d30b-10b9-3d78-98c9-675908692233",
                                        "entry_id": "16445aef-1a02-3555-bb85-66b8f28c6b34",
                                        "glosses": [
                                            "Fraction obtenue en divisant cent fois. 1/100."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dc6342-b41c-4e2d-86d2-0a36cb5baeed",
                                                "sense_id": "92c3d30b-10b9-3d78-98c9-675908692233",
                                                "text": "Les millions de morts de la grande guerre sont, pour les quatre-vingts centièmes des ouvriers et des paysans."
                                            },
                                            {
                                                "example_id": "76d6445e-75c0-47f7-b196-61b21dfc9dc6",
                                                "sense_id": "92c3d30b-10b9-3d78-98c9-675908692233",
                                                "text": "La table I donne, en fonction de la durée totale de la montée ou la baissée […], le nombre de centièmes de l’amplitude dont la mer a monté ou baissé depuis l’instant de référence."
                                            },
                                            {
                                                "example_id": "fce99ccc-aa7c-4d03-8830-113bd2e5219c",
                                                "sense_id": "92c3d30b-10b9-3d78-98c9-675908692233",
                                                "text": "C’est vrai que tu étais noyé dans la foule et qu’on ne t’a vu qu’un centième de seconde, mais enfin, c’est déjà quelque chose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85013964-b8d3-366f-972b-2acff7634d2a",
                                        "entry_id": "16445aef-1a02-3555-bb85-66b8f28c6b34",
                                        "glosses": [
                                            "Centième de millimètre, utilisé pour exprimer le diamètre d’un fil de pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993c4010-e589-45a4-919d-888e4da527b4",
                                                "sense_id": "85013964-b8d3-366f-972b-2acff7634d2a",
                                                "text": "— Se priver de ça pour aller vendre des bobines de nylon 16 ou 24 centièmes, c’est pire que tout !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "centième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb33fad-d977-387d-994f-ecb68b137a17",
                                        "entry_id": "c6eb5ae5-a63c-3a2f-980f-a849e49d3b4e",
                                        "glosses": [
                                            "Centième représentation d'un spectacle, notamment d'une pièce de théâtre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d04bf5f-87f5-4566-9843-3977324ec6b1",
                                                "sense_id": "ddb33fad-d977-387d-994f-ecb68b137a17",
                                                "text": "Nous avions été invités, Marcel Achard et moi, à un souper de centième, qui avait lieu chez Maxim's."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
