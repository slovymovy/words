        "de-extract.jsonl": [
            {
                "entry_id": "0ecc3bc4-7de9-39b6-a783-4ed8638c1964",
                "word": "nächtens",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                        "entry_id": "0ecc3bc4-7de9-39b6-a783-4ed8638c1964",
                        "glosses": [
                            "in der Nacht, zur Nachtzeit"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "80220513-e607-40b4-8eeb-bbedbc8b66c4",
                                "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                                "text": "Stellen Sie sich vor, Sie stellen Ihr Auto in einer ruhigen Wohngegend in Berlin ab und dann kommt nächtens irgendein Idiot und zündet es an."
                            },
                            {
                                "example_id": "3233665e-77a1-45b1-98f6-f59a127e72a4",
                                "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                                "text": "„Nächtens auf den Straßen seien nicht nur linke Wirrköpfe, sondern auch Pyromanen, Nachahmungstäter und Versicherungsbetrüger im Einsatz, erklärte der genervte Berliner Innensenator Ehrhart Körting (SPD).“"
                            },
                            {
                                "example_id": "9149519b-ccec-443c-8c86-6d9a0dbaec98",
                                "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                                "text": "„Sie ernähren sich von menschlichem Blut und fühlen sich daher genau dort wohl, wo auch wir es nächtens kuschelig haben: in den Betten.“"
                            },
                            {
                                "example_id": "15d0e982-6ecc-4615-a6db-b1f04d489886",
                                "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                                "text": "„Sie waren damals nächtens unbemerkt in das Museum eingedrungen und hatten das Gemälde aus dem Rahmen geschnitten.“"
                            },
                            {
                                "example_id": "421b141b-d4f0-4043-a684-17e0a1f8468a",
                                "sense_id": "f5f647f5-57cb-3811-a40a-0990b51a3e33",
                                "text": "„Und so tummeln sich denn nächtens hier Stammkunden jenes Etablissements, Gelegenheitsneugierige und jene, die die Durchdringung von Kunst so ernst nehmen, dass sie sich auf Büchels Geheiß auch mal mit Partnertausch und ähnlichen Verrenkungen konfrontieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
