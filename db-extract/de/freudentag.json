                "senses": [
                    {
                        "sense_id": "38ace06b-f590-3879-bee8-d34ea6b73bd6",
                        "entry_id": "1bd3e825-36f2-38be-9013-487b150a05a3",
                        "glosses": [
                            "freudiger Tag; Tag, an dem etwas Freudiges (Geburtstag, Jubiläum und dergleichen) begangen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46755b1-7f40-45a0-84d6-f0da64272338",
                                "sense_id": "38ace06b-f590-3879-bee8-d34ea6b73bd6",
                                "text": "„Die Mutter mußte sterben, sie konnte den Freudentag nicht erleben, der Freund geht zugrunde in seinem Rußland, schon vor drei Jahren war er gelb zum Wegwerfen, und ich, du siehst ja, wie es mit mir steht.“"
                            },
                            {
                                "example_id": "f1f49d96-2e0d-4b72-a4c5-cba5ee57c41a",
                                "sense_id": "38ace06b-f590-3879-bee8-d34ea6b73bd6",
                                "text": "„«Wir wollten schon längst gegessen haben, Mama. […]» «Warum habt ihr nicht ohne mich angefangen?» «Weil heute ein Freudentag ist. Für uns alle.» Er drückte ihre Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
