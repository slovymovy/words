                    }
                ],
                "senses": [
                    {
                        "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                        "entry_id": "8d732cbe-8146-3560-b587-53794ce983a2",
                        "glosses": [
                            "großer Eifer, starker Eifer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a01011-2cd2-433c-831b-8a8ac2ea73a4",
                                "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                                "text": "Er widmete sich seiner neuen Aufgabe mit Feuereifer."
                            },
                            {
                                "example_id": "260a75a2-2b92-43bc-b6d8-aa01b2934312",
                                "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                                "text": "„Auch jetzt geht es mit Feuereifer daran, ein Idyll zu schaffen, ein Idyll des Fressens und Schlafens natürlich."
                            },
                            {
                                "example_id": "c7a50f2a-6672-461b-b082-a597a57beb58",
                                "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                                "text": "„Er missionierte mit Feuereifer und gründete im ganzen Ostkap ländliche Gemeinden.\""
                            },
                            {
                                "example_id": "79dfbfb9-3a13-4201-ad2d-8914c5644498",
                                "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                                "text": "„Im Arbeitszimmer des Hausherrn komplottierten mit Feuereifer Pater Rothschild und Mr. Outrage.“"
                            },
                            {
                                "example_id": "7becc2e2-c88e-45f9-8fab-f9e68f7bfa23",
                                "sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                                "text": "„Pencroff baute mit Feuereifer an seinem Schiff, das nach kurzer Zeit völlig beplankt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1b1adac-c7a7-41e2-8f52-26f687f60c8d",
                        "source_entry_id": "8d732cbe-8146-3560-b587-53794ce983a2",
                        "source_sense_id": "8771f8c6-998c-3a0a-81b5-e67c87acc495",
                        "source_sense_description": "großer Eifer, starker Eifer",
                        "target_lang_word": "ardeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ardeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "275be965-95f0-323d-877d-09df14d7fe41",
                                        "entry_id": "1fc0cd5c-81fb-3a15-b5d6-304ac407b077",
                                        "glosses": [
                                            "Chaleur extrême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c6d5ac9-dc81-4fc1-9c31-d42fd16c2d9c",
                                                "sense_id": "275be965-95f0-323d-877d-09df14d7fe41",
                                                "text": "L’ardeur du feu."
                                            },
                                            {
                                                "example_id": "4c7da2c4-307a-4dc5-adfe-2ecac9acafa2",
                                                "sense_id": "275be965-95f0-323d-877d-09df14d7fe41",
                                                "text": "L’ardeur du soleil."
                                            },
                                            {
                                                "example_id": "79a40545-552b-485e-8270-458ac80ba990",
                                                "sense_id": "275be965-95f0-323d-877d-09df14d7fe41",
                                                "text": "Pendant les ardeurs de la canicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95df0a6-1858-39e5-bbd8-ba20a8b16411",
                                        "entry_id": "1fc0cd5c-81fb-3a15-b5d6-304ac407b077",
                                        "glosses": [
                                            "Chaleur âcre et piquante qu’on éprouve dans certaines maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7761224-5ea7-4849-8eec-fc33f41d01af",
                                                "sense_id": "c95df0a6-1858-39e5-bbd8-ba20a8b16411",
                                                "text": "L’ardeur de la fièvre."
                                            },
                                            {
                                                "example_id": "425f93dd-592f-4fe7-9923-14958e50c567",
                                                "sense_id": "c95df0a6-1858-39e5-bbd8-ba20a8b16411",
                                                "text": "Ardeur d’entrailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                        "entry_id": "1fc0cd5c-81fb-3a15-b5d6-304ac407b077",
                                        "glosses": [
                                            "Chaleur, vivacité avec laquelle on se porte à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b0712dd-a0ae-4aab-8605-9ff2d9a33efb",
                                                "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                                "text": "Nous préparions la Fête-Dieu avec une ardeur et une fébrilité d'autant plus vive que chaque quartier entendait exhiber le plus beau reposoir. Quelle mobilisation !"
                                            },
                                            {
                                                "example_id": "a041b2f9-9d46-43c2-8a4f-556f00dc4f4e",
                                                "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                                "text": "Cette Messinaise était une petite femme appelée Rosina, fort brune, mais portant dans ses yeux noirs et fendus en amande toutes les ardeurs du soleil de la Sicile."
                                            },
                                            {
                                                "example_id": "c4ab3569-4b05-46f6-9fa9-482cb75dd14a",
                                                "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                                "text": "Chez les peuples protestants, il y a d'autant plus d’ardeur morale que l’Église établie est plus fortement battue en brèche par des sectes dissidentes."
                                            },
                                            {
                                                "example_id": "6e220d72-d351-4587-a8e4-20d2e179c41f",
                                                "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                                "text": "Philéas Beauvisage, garçon sage et plein de respect pour sa mère, eut bientôt conclu l’affaire avec son patron ; et comme il tenait de ses parents la bosse que les phrénologistes appellent l’acquisivité, son ardeur de jeunesse se porta sur ce commerce qui lui parut magnifique et qu’il voulut agrandir par la spéculation."
                                            },
                                            {
                                                "example_id": "3542c5c6-b494-43b8-8cc1-e2d850458d74",
                                                "sense_id": "cbae6976-100e-30a7-8fb7-e6448c9a0a08",
                                                "text": "L’ardeur que mettait John Wesley à convertir des femmes jeunes et jolies tenait à la fois du zèle religieux le plus sincère et d'un désir physique, peut-être inconnu de lui même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7b7e948-a955-3ecd-a8a3-9046094952ad",
                                        "entry_id": "1fc0cd5c-81fb-3a15-b5d6-304ac407b077",
                                        "glosses": [
                                            "Passion amoureuse."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f7d9727-42c1-40de-840d-83a0c2e55f5a",
                                                "sense_id": "e7b7e948-a955-3ecd-a8a3-9046094952ad",
                                                "text": "Sa nuit de noce n'avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
