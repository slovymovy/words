    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3a19640f-917a-3914-94df-b33f0bd64df0",
                "word": "Sphynx",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "679f143e-b936-3504-a0df-97fb88a5ff38",
                        "entry_id": "3a19640f-917a-3914-94df-b33f0bd64df0",
                        "glosses": [
                            "Dated form of Sphinx (“Egyptian statue”)."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "ca74ae6b-84c4-4bca-98ea-77c5e6d42b18",
                                "sense_id": "679f143e-b936-3504-a0df-97fb88a5ff38",
                                "text": "Where old Nile is everflowing, / And the Sphynx with heavy lids / Sits by ruins grim and sombre — / Onward to the Pyramids."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
