                                                "example_id": "7ff8c7ab-36ba-414a-aa01-3a29d56203fc",
                                                "sense_id": "bc0fe2cf-9388-3e27-beb3-a44cc5efa994",
                                                "text": "the main gallery"
                                            },
                                            {
                                                "example_id": "7cc81f7e-8d43-4a75-a332-de9a52791150",
                                                "sense_id": "bc0fe2cf-9388-3e27-beb3-a44cc5efa994",
                                                "text": "At about 2500 r.p.m., as much oil is by-passed through the cooler as the amount delivered to the main gallery and at higher engine speeds the flow through the cooler is appreciably greater."
                                            },
                                            {
                                                "example_id": "901f73a7-3299-4c82-a30f-f1349caa80ba",
                                                "sense_id": "bc0fe2cf-9388-3e27-beb3-a44cc5efa994",
                                                "text": "Metal grit from a previous engine failure was lodged in the oil galleries and had come loose upon driving the vehicle."
