    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                "word": "cumbrous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "97ed73a2-6b71-4373-b8f2-e16f473863a4",
                        "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more cumbrous"
                    },
                    {
                        "form_id": "57ce83b0-d016-42ea-ac75-56e7e92e7a16",
                        "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most cumbrous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                        "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                        "glosses": [
                            "Unwieldy because of size or weight; cumbersome."
                        ],
                        "tags": [
                            "also",
                            "figuratively",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "77a7b649-e644-4975-9a83-352c66b9f27a",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "Possession's load was grown so great, / He sunk beneath the cumbrous weight: […]"
                            },
                            {
                                "example_id": "c66f354c-256b-469d-b96a-9e1bc740091c",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "He therefore came to a ſudden reolution of throvving off thoſe cumbrous ornaments of learning, vvhich, as he imagined, hindered his reception; and vvith no other images than arcs and angles, commenced a man of vvit and jocularity."
                            },
                            {
                                "example_id": "2114598d-293b-4947-b5ad-11ce3ebe389b",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "The rest of the furniture is in a suitable style, particularly an arm-chair of cumbrous workmanship, constructed of wood, curiously turned, with a high back and triangular seat, said to have been used by Judge Popham in the reign of Elizabeth."
                            },
                            {
                                "example_id": "eb1f20f3-5a77-4420-966f-83e8d2119351",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "[W]e, upon a large experience in the French literature, affirm that it would be nearly impossible (perhaps strictly so) to cite an instance of that cumbrous and unwieldy style which disfigures English composition so extensively."
                            },
                            {
                                "example_id": "d08863b7-e59c-4f7b-9dd4-36961c11c45d",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "In each country writing began with pictures of the objects intended. […] In the course of thousands of years, this cumbrous system developed into alphabetic writing."
                            },
                            {
                                "example_id": "324c9596-0bcf-40f3-b72d-a776832da56b",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "This class of apparatus, often called today the \"poste classique\", gave first-class service in every respect but became cumbrous if a large layout had to be controlled."
                            },
                            {
                                "example_id": "40968224-3d95-4b94-aaa7-74fd8df6a90d",
                                "sense_id": "1aaddb1e-c43b-31a8-8feb-7d5ea01115b1",
                                "text": "Evidently the imagines agentes, fantastically gesticulating from their places and arousing memory by their emotional appeal, seemed to him as cumbrous and useless for practical mnemonic purposes as they do to us."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bc775af-b778-39f8-ba3e-7c2175e5051f",
                        "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                        "glosses": [
                            "Causing hindrance or obstruction."
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e27e4644-d2e6-482c-8f8d-eddfe316cec7",
                                "sense_id": "9bc775af-b778-39f8-ba3e-7c2175e5051f",
                                "text": "But aftervvards, the Gauls ceaſed to moleſt and trouble, and the Romans gave over to fear, ſo ſoon as they vvere paſſed, and eſcaped the rough, cumbrous, and unpaſſable forreſts."
                            }
                        ]
                    },
                    {
                        "sense_id": "740998db-e0ee-3d9e-9fdc-0971d7b81069",
                        "entry_id": "80dabd7f-1e12-377f-b65f-2066d282a513",
                        "glosses": [
                            "Giving annoyance or trouble; troublesome, vexatious."
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "50f99cf2-3b71-485a-a469-32c619cc47bc",
                                "sense_id": "740998db-e0ee-3d9e-9fdc-0971d7b81069",
                                "text": "A cloud of cumbrous gnattes doe him moleſt, / All ſtriuing to infixe their feeble ſtinges, / That from their noyance he no vvhere can reſt, / But vvith his clovvniſh hands their tender vvings, / He bruſheth oft, and oft doth mar their murmurings."
                            },
                            {
                                "example_id": "f078431b-38d3-431a-b10c-772053c3c632",
                                "sense_id": "740998db-e0ee-3d9e-9fdc-0971d7b81069",
                                "text": "Henceforth I flie not Death, nor would prolong / Life much, bent rather now I may be quit / Faireſt and eaſieſt of this combrous charge, / Which I muſt keep till my appointed day / Of rendring up."
                            }
                        ]
                    }
                ],
