                                        "entry_id": "4f9063ed-ff0c-3c5d-bf54-21474f01a4da",
                                        "glosses": [
                                            "An Israelite prophet in the Abrahamic religions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42387e54-d022-4027-b342-d8ca6b869cac",
                                                "sense_id": "f995fbae-6eb0-3726-b3c4-3bca74883e70",
                                                "text": "Behold, I will send you Elijah the prophet before the coming of the great and dreadful day of the Lord; And he shall turn the heart of the fathers to the children, and the heart of the children to their fathers, lest I come and smite the earth with a curse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf4499d-f1ce-3b3b-813d-6faaddbf653d",
                                        "entry_id": "4f9063ed-ff0c-3c5d-bf54-21474f01a4da",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a714646-a7b2-40d4-b20a-ad6a6024afe8",
                                                "sense_id": "fbf4499d-f1ce-3b3b-813d-6faaddbf653d",
                                                "text": "\"That's wonderful! What's his name?\"\n\"Elijah.\"\n\"Wow! A heavy-duty prophet's name!\"\n\"Yeah, and he's certainly living up to it.\""
                                            }
                                        ]
                                    },
                                    {
