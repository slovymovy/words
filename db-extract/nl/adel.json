                                "sense_id": "4c5f4e23-fc2e-3653-a163-26465b1397dd",
                                "text": "De adel had vroeger veel macht in Europa.",
                                "translation": "The nobility used to have a lot of power in Europe.",
                                "english": "The nobility used to have a lot of power in Europe."
                            },
                            {
                                "example_id": "18015fca-4845-442a-9ee8-678b73a0361b",
                                "sense_id": "4c5f4e23-fc2e-3653-a163-26465b1397dd",
                                "text": "Hij stamt af van de oude adel.",
                                "translation": "He descends from the old nobility.",
                                "english": "He descends from the old nobility."
                            },
                            {
                                "example_id": "aae5cab1-bd67-40fc-a293-fdaa06f08a96",
                                "sense_id": "4c5f4e23-fc2e-3653-a163-26465b1397dd",
                                "text": "In veel landen is de adel een ceremoniële klasse.",
                                "translation": "In many countries, the nobility is a ceremonial class.",
                                "english": "In many countries, the nobility is a ceremonial class."
                            }
                        ]
                    },
                    {
                        "sense_id": "e34572f1-7f21-3f72-b5b4-591adf0f231b",
                        "entry_id": "a45744bd-ebfd-3310-a980-874ce8003cb8",
