                ],
                "senses": [
                    {
                        "sense_id": "cdc59d77-96c7-3e34-b981-0fc949edd7af",
                        "entry_id": "09289e68-0d50-3ba8-9f43-1f0ec47c40a2",
                        "glosses": [
                            "Bewegung, die (ausschließlich) mit der Hand (den Händen) gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ce9756-4644-4e5c-b18f-afec6ac2024f",
                                "sense_id": "cdc59d77-96c7-3e34-b981-0fc949edd7af",
                                "text": "Unwillkürliche Handbewegungen können auf eine Erkrankung hindeuten."
                            },
                            {
                                "example_id": "7f17e2bb-9034-4bee-bd89-4baa6208a9bf",
                                "sense_id": "cdc59d77-96c7-3e34-b981-0fc949edd7af",
                                "text": "„Atemlos hatte sie die feinen konzentrierten Handbewegungen beobachtet, mit denen er seine Puppe unter dem Bambusvorhang hindurch in Bewegung brachte.“"
                            },
                            {
                                "example_id": "e636f09f-c9c3-410b-a12c-82f04da1619d",
                                "sense_id": "cdc59d77-96c7-3e34-b981-0fc949edd7af",
                                "text": "„Die Mutter arretiert mit einer flinken Handbewegung den Rollator und sieht uns neugierig an.“"
                            },
                            {
                                "example_id": "15c9bef8-5bd2-4208-960a-044811df64a9",
                                "sense_id": "cdc59d77-96c7-3e34-b981-0fc949edd7af",
                                "text": "„Amalia stürmte dann nach draußen und warf ihren Schal mit einer dramatischen Handbwegung hinter sich, setzte ihre Sonnenbrille auf und machte sich auf einen Spaziergang durch die Weinstöcke, während Jean ihr hinterherlief und verzweifelt auf sie einredete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                        "entry_id": "09289e68-0d50-3ba8-9f43-1f0ec47c40a2",
                        "glosses": [
                            "übertragen von [1]: als Zeichen gedachte Bewegung der Hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ddb9b86-d582-415a-93cc-7e127ef5a935",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "Bitte, machen Sie eine Handbewegung! (Eine oft geäußerte Bitte im Quiz Wikipedia-Artikel „Was bin ich?“ von und mit Wikipedia-Artikel „Robert Lembke“)"
                            },
                            {
                                "example_id": "5a35a483-eaf8-4792-bf74-ade0ce24b10c",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "Eine Handbewegung genügt und schon spuren alle."
                            },
                            {
                                "example_id": "0ea055e8-06b7-4b9f-97cb-4a64ae9a7248",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "„Mit einer Handbewegung schickt er den Küster fort, nachdem dieser die knarrende Falltür geöffnet hat.“"
                            },
                            {
                                "example_id": "dac73d78-5d3a-4eae-aa46-fe7aedcd32b6",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "„Hallows entließ ihn mit einer kurzen Handbewegung und beugte sich wieder über die Karte.“"
                            },
                            {
                                "example_id": "e88ee597-fd23-4263-88d1-7403dd332e64",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "„Sie gab ihm durch eine Handbewegung zu verstehen, daß sie erst einmal Luft holen müsse.“"
                            },
                            {
                                "example_id": "b7ce49ec-3e94-40ab-98e5-15aa532fa96f",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "„Der Adjutant machte eine Handbewegung, und der andere Melder ging ebenfalls.“"
                            },
                            {
                                "example_id": "411ef885-8461-4c33-bb18-83b15e189d94",
                                "sense_id": "df795c7b-1ce4-358e-afac-a77a6a99286c",
                                "text": "„Lucie Wiegand macht eine abwehrende Handbewegung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
