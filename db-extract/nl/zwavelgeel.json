                                "sense_id": "cb125504-826d-3580-8eef-d7d9f9004d1a",
                                "text": "De zijkant was een egaal zwavelgeel vlak."
                            },
                            {
                                "example_id": "2fa152ab-3d20-4866-b923-1401b7f612de",
                                "sense_id": "cb125504-826d-3580-8eef-d7d9f9004d1a",
                                "text": "Hij rijdt in een zwavelgele auto."
                            }
                        ]
