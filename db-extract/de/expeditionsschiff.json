                        "glosses": [
                            "Schiff, das für wissenschaftliche oder touristische Expeditionen/Erkundungsfahrten eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "857d6257-7d3d-4853-b33b-9c6f9a4dfb95",
                                "sense_id": "c44dc5b4-b7f8-3c19-9ee6-d5d5e6bcaf2b",
                                "text": "„Von einem der Expeditionsschiffe fiel ein zu verladendes Geschütz tief ins Wasser und war durch den umgebenden Schlamm kaum mehr auffindbar.“"
                            },
                            {
                                "example_id": "2f982b6c-7dc3-4d6a-a074-a0b670aba009",
                                "sense_id": "c44dc5b4-b7f8-3c19-9ee6-d5d5e6bcaf2b",
                                "text": "„Sein Expeditionsschiff kreuzte weiter in Richtung Westen und segelte durch ein Labyrinth von Buchten, Landzungen und Fjorden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
