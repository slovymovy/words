                    {
                        "form_id": "f94d8ad6-ccf8-427d-b3da-fda00d0ded43",
                        "entry_id": "62c66a89-2576-3b80-812e-8c64685cbcbb",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Chromosphären"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d054d37d-4bf2-3a6b-b2a7-0c190647a292",
                        "entry_id": "62c66a89-2576-3b80-812e-8c64685cbcbb",
                        "glosses": [
                            "Gasschicht in der Atmosphäre der Sonne zwischen Photosphäre und Korona. Sie leuchtet in tiefem Rot (656,3 nm), wird aber nur während einer totalen Sonnenfinsternis für das Auge sichtbar, da sie sonst von der Photosphäre überstrahlt wird."
                        ],
                        "tags": [
                            "Astrophysik"
                        ],
                        "examples": [
                            {
                                "example_id": "e828a5c7-cbdd-4abe-b6fc-c90678e14dfa",
                                "sense_id": "d054d37d-4bf2-3a6b-b2a7-0c190647a292",
                                "text": "„In den unteren Teil der Sonnenkorona werden von der Chromosphäre und von eruptiven Flares andauernd kleine Spikulen und weit aufsteigende Protuberanzen emporgeschleudert, die oft erst nach mehreren Tagen wieder zur Photosphäre herunter sinken.“"
                            },
                            {
                                "example_id": "71846f1a-4075-4f30-8492-4c552a76fb9b",
                                "sense_id": "d054d37d-4bf2-3a6b-b2a7-0c190647a292",
                                "text": "Chromosphären anderer Sterne konnten noch nicht nachgewiesen werden, folgen aber aus theoretischen Modellen des Sternaufbaus."
                            },
                            {
                                "example_id": "ac1b686d-7895-48d2-9c03-92489bc37a75",
                                "sense_id": "d054d37d-4bf2-3a6b-b2a7-0c190647a292",
                                "text": "„Dies lässt hoffen, dass bei zukünftigen Simulationen mit realistischen Strömungsfeldern und einer verbesserten Berechnung der sich räumlich ausbreitenden Schallwellen eine noch präzisere Übereinstimmung gefunden wird, die den exakten Zusammenhang der Chromosphären mit dem Sterninneren liefert.“"
                            },
                            {
                                "example_id": "2ff229e7-2d5d-4a26-90b6-ad8f7da1ca7b",
                                "sense_id": "d054d37d-4bf2-3a6b-b2a7-0c190647a292",
                                "text": "„Über der Photosphäre erstrecken sich die Chromosphäre (Dicke: 5000 km; Temperatur: bis 20000 °C) und die Korona (Temperatur: bis 2 Mio. °C), die die Sonnenatmosphäre bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
