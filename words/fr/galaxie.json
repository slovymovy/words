{
    "word_family": [
        "galactique",
        "intergalactique",
        "extragalactique"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee75e7f3-6f83-305a-b73d-e2c17d8a143c",
                    "sense_definition": "Vaste ensemble d'étoiles, de poussières et de gaz interstellaires isolé dans l'espace et maintenu par la gravité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les astronomes ont découvert une nouvelle <w>galaxie</w> spirale située à des millions d'années-lumière."
                        },
                        {
                            "text": "Chaque <w>galaxie</w> contient des milliards d'étoiles maintenues ensemble par la force gravitationnelle."
                        }
                    ],
                    "synonyms": [
                        "univers-île"
                    ],
                    "common_phrases": [
                        "galaxie spirale",
                        "galaxie naine"
                    ]
                },
                {
                    "sense_id": "c71045fe-7cab-3db2-a9ef-5ac1ef4bccf7",
                    "sense_definition": "Ensemble vaste et complexe d'organisations, de personnes ou d'éléments gravitant autour d'un centre commun.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "societe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce dirigeant politique s'appuie sur une <w>galaxie</w> d'associations pour diffuser ses idées."
                        },
                        {
                            "text": "Le groupe industriel a créé une véritable <w>galaxie</w> médiatique en rachetant plusieurs journaux."
                        }
                    ],
                    "common_phrases": [
                        "galaxie politique",
                        "galaxie médiatique"
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5124797e-2793-3bf7-b482-f8c9b48aa834",
                    "sense_definition": "Nom donné à notre propre galaxie, qui contient le système solaire et correspond à la Voie lactée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomie",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Le Soleil se situe dans un des bras spiraux de la <w>Galaxie</w>."
                        },
                        {
                            "text": "Toutes les étoiles visibles la nuit dans notre ciel appartiennent à la <w>Galaxie</w>."
                        }
                    ],
                    "synonyms": [
                        "Voie lactée"
                    ]
                }
            ]
        }
    ]
}