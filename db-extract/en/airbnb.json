                                        "sense_id": "f42ac958-17d9-322e-9b9e-ebb14b6c77f3",
                                        "entry_id": "79b97bb0-2f7e-339b-a7be-731f0ca0d043",
                                        "glosses": [
                                            "Société exploitant des services de location temporaire de biens immobiliers, notamment d'appartements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "551fd6a9-99ee-4495-b2bd-c7955925c4ec",
                                                "sense_id": "f42ac958-17d9-322e-9b9e-ebb14b6c77f3",
                                                "text": "Elon Musk a décrit une stratégie similaire à celle d’ Uber ou d’ Airbnb, où les propriétaires de Tesla pourront ajouter leurs véhicules à l’application de covoiturage de Tesla pour gagner des revenus supplémentaire lorsque les voitures ne sont pas utilisées, et Tesla prendra 25 à 30 % des revenus (similaire au taux de prise en charge de l’App Store d’Apple)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f4c392-322b-3d34-9855-31d189df36d3",
                                        "entry_id": "79b97bb0-2f7e-339b-a7be-731f0ca0d043",
                                        "glosses": [
                                            "Société exploitant des services de location temporaire de biens immobiliers, notamment d'appartements.",
                                            "(En particulier) Site internet intermédiaire entre particuliers pour la location temporaire d'appartements et servant aussi à de petites entreprises commerciales dans le même but."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c37f2c73-c936-38bf-b23f-35b5e2d97531",
                                        "entry_id": "79b97bb0-2f7e-339b-a7be-731f0ca0d043",
                                        "glosses": [
                                            "Société exploitant des services de location temporaire de biens immobiliers, notamment d'appartements.",
                                            "(En particulier) Logis ainsi loué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d3e86c-9b24-4841-8cc6-d443f991361a",
                                                "sense_id": "c37f2c73-c936-38bf-b23f-35b5e2d97531",
                                                "text": "Puis je marchais jusqu'à la 8ᵉ Avenue pour rentrer dans mon Airbnb."
                                            }
                                        ]
