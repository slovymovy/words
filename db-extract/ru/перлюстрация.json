                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98abb33c-b331-360b-b70a-eab2ca2b315b",
                                        "entry_id": "32624223-8ddd-3702-ba08-15e62c1ee7ee",
                                        "glosses": [
                                            "thorough examination of a document or of correspondence"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa0050dc-afb6-465f-bfce-fd0bf75ac846",
                                                "sense_id": "98abb33c-b331-360b-b70a-eab2ca2b315b",
                                                "text": "Yes, after a thorough perlustration of the loot that Andron and Niagarushka had obtained from the Queen's rosewood writing desk (mostly bills, and treasured snapshots, and those silly medals) a letter from the King did turn up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd3cf18a-efca-4fb5-9f7a-d3b8e26c942c",
                        "source_entry_id": "cd66357d-a14a-3aa6-9023-894e8e7f1507",
                        "source_sense_id": "9befa6a3-ed35-3c16-b145-db5aa10ecfc0",
