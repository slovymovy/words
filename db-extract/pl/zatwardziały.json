                                    },
                                    {
                                        "sense_id": "4764326a-14fb-3c9e-9490-66dc3181598e",
                                        "entry_id": "38d311b6-b8d3-3df8-bb69-e3302e3b2e48",
                                        "glosses": [
                                            "Rigid or uncompromising in principles, especially in religion or politics."
                                        ],
                                        "tags": [
