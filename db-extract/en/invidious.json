    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                "word": "invidious",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "75493e9f-df8a-4b1d-a989-df442bcaf3ca",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more invidious"
                    },
                    {
                        "form_id": "d3067768-e588-448b-8aff-f3ce64eb6e19",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most invidious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "glosses": [
                            "Causing ill will, envy, or offense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044a51b8-e5b3-455a-b588-a7e9da89a349",
                                "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                                "text": "To think highly of ourselves in comparison with others, to assume by our own authority that precedence which none is willing to grant, must be always invidious and offensive; […]"
                            },
                            {
                                "example_id": "2d002e99-c109-400a-8463-ec3046ed1290",
                                "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                                "text": "‘I didn’t make use of the word in any invidious sense, ma’am,’ replied Mr. Benjamin Allen, growing somewhat uneasy on his own account."
                            },
                            {
                                "example_id": "66c15dc5-1eb2-4270-b022-14854d0414f6",
                                "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                                "text": "[…] when the interposing barriers of earth and time, and a sense that the events had been somewhat shut into oblivion, would deaden the sting that revelation and invidious remark would have for Bathsheba just now."
                            },
                            {
                                "example_id": "490be5d3-74ef-44f1-94a6-d0669a9eb3c2",
                                "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                                "text": "He lingered on the bridges at sunset, and knew that the light was enchanting and the mountains divine, but there seemed to be something horribly invidious and unwelcome in the fact."
                            },
                            {
                                "example_id": "2722f620-1f6a-4378-b147-e513a922cf9d",
                                "sense_id": "7293a950-0f24-3856-af1b-347931e39304",
                                "text": "I should be very reluctant, as head of His Majesty's Government, to place such an invidious responsibility upon a British officer."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cd887d6-9693-34d9-ad2f-f7b787b42d41",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "glosses": [
                            "Offensively or unfairly discriminating."
                        ],
                        "tags": [
                            "of a distinction"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc25363-0453-4628-8718-c2877bf98201",
                                "sense_id": "7cd887d6-9693-34d9-ad2f-f7b787b42d41",
                                "text": "But the rich man—not to make any invidious comparison—is always sold to the institution which makes him rich."
                            },
                            {
                                "example_id": "3d53e4e1-249a-4371-88d7-a5ecb5bb3121",
                                "sense_id": "7cd887d6-9693-34d9-ad2f-f7b787b42d41",
                                "text": "There were so many drinks to be drunk, and as the warm magic poured through our veins and mellowed our voices and affections we knew it was no time to make invidious distinctions—to drink with this shipmate and to decline to drink with that shipmate."
                            }
                        ]
                    },
                    {
                        "sense_id": "01dbb101-6e7c-3c57-bc11-e06a2231496b",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "glosses": [
                            "Envious, jealous."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f2c2a66-0c83-3aa3-b081-98bc752ab8a6",
                        "entry_id": "4b53e4cb-1728-38b2-b39f-a5aa1558244e",
                        "glosses": [
                            "Detestable, hateful, or odious. (Often used in cases of perceived unfairness, or when facing a difficult situation or choice — especially in the phrase invidious position.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aea62036-dd5e-4d7b-81ba-1443af1e4b7a",
                                "sense_id": "3f2c2a66-0c83-3aa3-b081-98bc752ab8a6",
                                "text": "The sales representative was in an invidious position: she could either get to the meeting on time but with nothing to show the client, or pick up the product samples while the client was kept waiting. Neither one would make a favourable impression!"
                            }
                        ]
                    }
                ],
