                    {
                        "translation_id": "a15fe1f6-f1ba-4ffb-897d-3573b67b80fb",
                        "source_entry_id": "ff777b9d-6f10-31c7-98df-d9a0832d3653",
                        "source_sense_id": "f3758678-505a-324d-96d0-c626f25ca187",
                        "source_sense_description": "het filosofisch discours over het wezen van kunst of het wezen van schoonheid",
                        "target_lang_word": "esthétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esthétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Relatif au sentiment du beau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec7626a-ff4f-400e-b75e-ca3b73f5ff89",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "La stylique ou design est la valorisation esthétique d'un produit. Elle allie fonctionnalité et beauté. C'est un aspect fondamental lors de la mise en marché du produit."
                                            },
                                            {
                                                "example_id": "fabd3415-a6ed-4e00-a006-20811fb189a9",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "L'analyse plus approfondie de la notion de distance esthétique permet de revenir sur le rôle primordial du suspense et de l'angoisse dans le processus narratif d'un récit."
                                            },
                                            {
                                                "example_id": "0d431e4a-a8d8-4538-a0ba-b6505d0e75cf",
                                                "sense_id": "adfdba66-5987-3697-abdc-0cbad96f7247",
                                                "text": "«On vient en quelque sorte reconnaître l’impact psychologique d’éléments qui peuvent sembler uniquement esthétiques, mais qui ne le sont pas, car il y a des conséquences graves sur la santé mentale de ces personnes», conclut l’avocat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b894eb35-ddeb-3641-ae1e-557eea90ac06",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Qualifie le sentiment particulier produit par le beau."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098b34e9-5380-4253-ad1d-d8bcec428ca2",
                                                "sense_id": "b894eb35-ddeb-3641-ae1e-557eea90ac06",
                                                "text": "Émotion esthétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "371fb5cc-c4e6-3c97-aeec-2508df268f5d",
                                        "entry_id": "df273ae1-f0d0-3df4-a91e-ff3a4ecb8063",
                                        "glosses": [
                                            "Qui a un certain caractère de beauté."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a80cdc33-680d-436d-8368-095949024f07",
                                                "sense_id": "371fb5cc-c4e6-3c97-aeec-2508df268f5d",
                                                "text": "Attitudes, gestes esthétiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esthétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                        "entry_id": "f2d64d70-b3b8-341a-ae98-721af29264f3",
                                        "glosses": [
                                            "Science s’intéressant aux règles du beau dans la nature ou dans l’art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1385a61-dfc1-4a6f-8b55-51057ff056c5",
                                                "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                                "text": "Il convient de le répéter une fois encore : l’esthétique de Flaubert est une esthétique du refus."
                                            },
                                            {
                                                "example_id": "ead3c903-f533-41f7-9341-415a3e68116d",
                                                "sense_id": "75205d84-c4c8-3d13-96c9-3cd8f6666e75",
                                                "text": "On a vu qu’un lien intime rattachait, pour nous, l’esthétique à la religion, dont elle subit l’influence directe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "391d7577-da7d-32b1-85a9-13e3f04f0574",
                                        "entry_id": "f2d64d70-b3b8-341a-ae98-721af29264f3",
                                        "glosses": [
                                            "Style et forme d'une œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53eba70e-e8ad-4eea-988d-7452dea30b40",
                                                "sense_id": "391d7577-da7d-32b1-85a9-13e3f04f0574",
                                                "text": "Chaque auteur possède donc une esthétique propre."
                                            },
                                            {
                                                "example_id": "2c77ba15-6231-4898-8ec9-89a3c0b50373",
                                                "sense_id": "391d7577-da7d-32b1-85a9-13e3f04f0574",
                                                "text": "C’est avec une musique qualifiée « d’afro-disco feel good et contagieuse » que les six musiciens nantais évoluent sur scène avec une énergie solaire, une façon de passer d’une esthétique ou d’une ambiance à une autre sans complexe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
