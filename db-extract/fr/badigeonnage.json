                    {
                        "sense_id": "f24f343d-e340-34a2-b4e1-28aead8985c1",
                        "entry_id": "05be5a86-6407-3bda-8d56-44f5bf6a4b4f",
                        "glosses": [
                            "Action de badigeonner ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6415e9d4-61bb-4dfa-b2e7-c4c95970af2a",
                                "sense_id": "f24f343d-e340-34a2-b4e1-28aead8985c1",
                                "text": "Et que dirait un sous-chantre du seizième siècle, en voyant le beau badigeonnage jaune dont nos vandales archevêques ont barbouillé leur cathédrale ?"
                            },
                            {
                                "example_id": "b26f66e8-88a0-40c8-a5d8-3972b2f9c031",
                                "sense_id": "f24f343d-e340-34a2-b4e1-28aead8985c1",
                                "text": "— Entendant le sens et la portée de la désignation dont il fut l'objet comprenant que ce que l'opinion républicaine attendait de lui ce n'était pas un badigeonnage, un récrépissage du vieil édifice militaire, c'était une reconstruction, il se résolut à la tâche."
                            }
                        ]
                    }
                ],
