                    {
                        "sense_id": "90678049-8323-38b7-8ac9-983155851d83",
                        "entry_id": "f8d43925-1793-32ce-9a23-7c8b915002a0",
                        "glosses": [
                            "Handel mit dem Ausland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bafb73a3-d6d7-4c77-a4ff-710f0361c875",
                                "sense_id": "90678049-8323-38b7-8ac9-983155851d83",
                                "text": "Für Deutschland ist der Außenhandel besonders wichtig."
                            },
                            {
                                "example_id": "f8f540e7-fabc-4441-ac14-47b49cc18aff",
                                "sense_id": "90678049-8323-38b7-8ac9-983155851d83",
                                "text": "„Der Handel des Deutschen Reiches mit seinen pazifischen Gebieten betrug 1909 weniger als 0,15 Prozent des gesamten Außenhandels.“"
                            },
                            {
                                "example_id": "7d52dd11-2e7e-42f7-82c9-354fd5c1b611",
                                "sense_id": "90678049-8323-38b7-8ac9-983155851d83",
                                "text": "„Gleichzeitig litt der Außenhandel weiterhin unter dem internationalen Protektionismus, der sich im Verlauf der Krise verstärkte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
