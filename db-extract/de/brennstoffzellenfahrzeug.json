                "senses": [
                    {
                        "sense_id": "4b44a20a-b6bd-34a6-a23c-58ea26d6a6d8",
                        "entry_id": "82636ab2-936a-3851-8db1-d9b80562ddbc",
                        "glosses": [
                            "Fahrzeug mit Elektromotor, bei dem die für den Antrieb benötigte elektrische Energie von einer Brennstoffzelle erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24016538-cd8f-4667-8d80-1d74daee43df",
                                "sense_id": "4b44a20a-b6bd-34a6-a23c-58ea26d6a6d8",
                                "text": "„\"Nur 25 Prozent der ursprünglichen Energie führen in einem Brennstoffzellenfahrzeug zu Fortbewegung, der Rest geht verloren. Bei batteriebetriebenen Elektroautos liegt der Wert etwa bei 70 Prozent\", sagte Florian Hacker vom deutschen Öko-Institut dem \"Spiegel\".“"
                            },
                            {
                                "example_id": "8e256ba5-0804-4937-a64f-98564d7b1d89",
                                "sense_id": "4b44a20a-b6bd-34a6-a23c-58ea26d6a6d8",
                                "text": "„Wenn man in das Brennstoffzellenfahrzeug von Mercedes steigt, fällt zuerst auf: Man hört nichts.“"
                            },
                            {
                                "example_id": "75541eb2-1678-4d53-bf43-0b7a4999b01b",
                                "sense_id": "4b44a20a-b6bd-34a6-a23c-58ea26d6a6d8",
                                "text": "„Das Batterieauto hat bis dahin mit dem derzeitigen deutschen Strommix 42.416 Kilogramm CO2 ausgestoßen - und das mit ausschließlich aus Erdgas gewonnenem Wasserstoff betriebene Brennstoffzellenfahrzeug 39.128 Kilogramm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
