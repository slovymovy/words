                    {
                        "sense_id": "5c93c5f6-ae43-3db2-9a72-9b33634337bf",
                        "entry_id": "40781821-75c2-3523-bfa0-1a6bbc2b1252",
                        "glosses": [
                            "Relatif à la Beauce (autant la Beauce française que la québecoise), ou à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6547d9ec-fde1-4b1c-975a-4edead9c3d12",
                                "sense_id": "5c93c5f6-ae43-3db2-9a72-9b33634337bf",
                                "text": "Ainsi moi, je suis petit-fils d’un paysan beauceron, j’ai grandi chez mon père, venu à Paris pour s’établir marbrier, en haut de la rue de la Roquette."
                            },
                            {
                                "example_id": "74d19574-bc72-460b-8d77-1a6b4d5ab69e",
                                "sense_id": "5c93c5f6-ae43-3db2-9a72-9b33634337bf",
                                "text": "Pourtant, les projections actuelles ont de quoi fouetter les troupes beauceronnes."
                            }
                        ]
                    }
                ],
