                        "target_lang_word": "fehlerfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fehlerfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                        "entry_id": "51a93ec3-f795-307e-9683-46763b4959fa",
                                        "glosses": [
                                            "ohne Fehler; frei von Fehlern oder Mängeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04f4aa8a-7c6c-4c8c-9911-fb417ba966b3",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "An fehlerfreie Sätze macht der Lehrer einen Haken. Sind alle Sätze fehlerfrei, kommt unter das Diktat ein Smiley."
                                            },
                                            {
                                                "example_id": "c4f0c84a-28c9-4cff-ad08-f1d398ac185c",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Wir müssen ein fehlerfreies Produkt liefern, sonst zahlt der Kunde nicht."
                                            },
                                            {
                                                "example_id": "c0017630-c0e4-45f7-a199-8db4e35c3e4e",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Eine Geige fehlerfrei zu spielen, das ist nicht leicht."
                                            },
                                            {
                                                "example_id": "08fd651d-e7d1-4aeb-a26d-9431ea18547a",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Als [der Student] Bartek zum ersten Mal nach Deutschland kam, hatte er Angst, dass niemand ihn verstehen würde. Sein größter Wunsch ist, Deutsch fehlerfrei sprechen zu können."
                                            },
                                            {
                                                "example_id": "25ce868c-435e-48ce-9091-1ab2b97a5424",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Wer schafft fehlerfrei zu sagen: „Blaukraut bleibt Blaukraut und Brautkleid bleibt Brautkleid“ und „Fischers Fritze fischt frische Fische, frische Fische fischt Fischers Fritze“?"
                                            },
                                            {
                                                "example_id": "da538497-6128-4bbe-aa99-bfcc33676f97",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Tobias Wendl und Tobias Arlt gewinnen den Rodelweltcup in Lillehammer. Trotz eines nicht fehlerfreien Laufs haben sie sich damit die kleine Chance auf den erneuten Gesamtweltcuptriumph erhalten."
                                            },
                                            {
                                                "example_id": "acdbc0d4-4ab2-4a3d-809f-ee1e443be800",
                                                "sense_id": "735039d3-ef89-311d-88dd-2dedbeedc95f",
                                                "text": "Sie arbeiten konzentriert und fehlerfrei, ohne zu ermüden. Trotz zum Teil massiver Kommunikationschwierigkeiten können Autisten ideale IT-Spezialisten sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
