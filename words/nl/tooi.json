                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>tooien</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>tooi</w> de feestzaal met bloemen voor de bruiloft van mijn zus.",
                            "target_lang_translations": {
