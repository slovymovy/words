    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                "word": "myopia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ffd3d895-8205-45cb-ae7d-a4956f324526",
                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "tags": [
                            "plural"
                        ],
                        "form": "myopias"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "glosses": [
                            "A disorder of the vision where distant objects appear blurred because the eye focuses their images in front of the retina instead of on it."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "691d5e84-a8b4-469a-b71e-b01f587d1266",
                                "sense_id": "fcc0803d-bc94-31fa-aaa4-8f847b25e107",
                                "text": "The modern rise in myopia mirrored a trend for children in many countries to spend more time engaged in reading, studying or — more recently — glued to computer and smartphone screens."
                            }
                        ]
                    },
                    {
                        "sense_id": "c49264d8-22c2-320f-bd7b-a796f7570bef",
                        "entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "glosses": [
                            "A lack of imagination, discernment or long-range perspective in thinking or planning."
                        ],
                        "tags": [
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c90c3b2-59e3-4597-a336-5e7e726b7c0b",
                        "source_entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "source_sense_description": "lack of imagination, discernment or long-range perspective in thinking or planning",
                        "target_lang_word": "kortzichtigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kortzichtigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c996f70a-a7bf-3f73-9b1e-b8aeda7636c8",
                                        "entry_id": "f5fbf04a-a8f0-3104-9d17-6fe698724500",
                                        "glosses": [
                                            "het alleen maar rekening houden met de korte termijn als karaktereigenschap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d925c5ef-172d-4cab-9399-5ab37db5f304",
                                                "sense_id": "c996f70a-a7bf-3f73-9b1e-b8aeda7636c8",
                                                "text": "Hoe langer freule Marja leefde en hoe meer ze van het leven ervoer en waarnam, des te meer verbaasde ze zich over de kortzichtigheid van mensen die hier, op aarde, genot en geluk zochten en die om dit onmogelijke, denkbeeldige en zondige geluk te bereiken ploeterden, leden, streden en elkaar kwaad berokkenden."
                                            },
                                            {
                                                "example_id": "599e276d-8c93-4665-bf2b-b34945905596",
                                                "sense_id": "c996f70a-a7bf-3f73-9b1e-b8aeda7636c8",
                                                "text": "De onderzoekers waarschuwen wel voor de risico's van individuele regelingen. Mensen zouden \"vanwege kortzichtigheid uit zichzelf te weinig premie inleggen voor een adequaat pensioen\". En dat doet pijn nadat ze gepensioneerd zijn. Daarom suggereren de onderzoekers om de keuzevrijheid beperkt uit te breiden met \"goede standaardopties\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbe1e0dd-027a-3c44-bbec-8efc57490e6a",
                                        "entry_id": "f5fbf04a-a8f0-3104-9d17-6fe698724500",
                                        "glosses": [
                                            "het alleen maar zien wat in de directe omgeving speelt"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cea00e6d-c618-381b-98ff-9dca209f469f",
                                        "entry_id": "f5fbf04a-a8f0-3104-9d17-6fe698724500",
                                        "glosses": [
                                            "bijziendheid als eigenschap"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383f08cb-202e-4b18-86f6-3661bc9f0cda",
                        "source_entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "source_sense_description": "lack of imagination, discernment or long-range perspective in thinking or planning",
                        "target_lang_word": "myope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                        "entry_id": "7abf80ee-3751-3beb-b2dc-c8ed84506e47",
                                        "glosses": [
                                            "Qui a la vue fort courte et qui ne peut voir clairement les objets éloignés sans le secours d’un verre concave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8319f1a2-3b7b-4a3c-8c04-c7925fe4ac00",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "La myiodopsie que le malade éprouve depuis quelques années a probablement été causée par l'action de trop rapprocher les objets pendant le travail, lorsque déjà la presbytie commençait à se développer, tandis que notre confrère se croyait encore myope."
                                            },
                                            {
                                                "example_id": "0dbd8fd5-8a0d-4173-820a-a18be756cd4b",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Ainsi, par exemple, l’œil myope d’une dyoptrie se trouve adapté à l’état de repos pour un objet placé à un mètre ; c’est à cette distance que se trouve son remotum."
                                            },
                                            {
                                                "example_id": "1f016bd0-628a-4f13-b3bb-14d54af1e93f",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Avec un mouvement fébrile de la tête, comme en ont les myopes dans leurs instants d’émotion, sans doute pour secouer le brouillard qui obscurcit leurs yeux, M. Hyacinthe se lève."
                                            },
                                            {
                                                "example_id": "d83670c0-ea7f-4582-9be1-f85f3dc64f49",
                                                "sense_id": "c73ae5f5-1dcb-3ea6-a98a-7071d9843250",
                                                "text": "Cependant, une vaste étude rapportée par la BBC suggère que la proportion d'enfants myopes aurait largement augmenté depuis la pandémie de Covid-19, notamment en raison de l'augmentation du temps d'écran induit par les confinements. Aujourd'hui, plus d'un enfant sur trois serait myope dans le monde, avec des différences massives entre les régions. La recherche, publiée dans le British Journal of Ophtalmology, est plutôt alarmante: la myopie ne cesse d'augmenter et devrait affecter encore des millions d'enfants supplémentaires d'ici à 2050, pour atteindre un enfant sur deux. Pour l'instant, les taux les plus élevés se trouvent tous en Asie, avec 85% d'enfants myopes au Japon, 73% en Corée du Sud et plus de 40% en Russie ou en Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                        "entry_id": "7abf80ee-3751-3beb-b2dc-c8ed84506e47",
                                        "glosses": [
                                            "Étroit d’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "327c1395-7bd6-4f9b-971e-80dc5a5736d8",
                                                "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                                "text": "Ainsi, rien de plus myope que le point de vue de Plékhanov, repris par tous les opportunistes, et selon lequel il ne fallait pas pas entreprendre cette grève inopportune, « il ne fallait pas prendre les armes ». Au contraire, il fallait prendre les armes de façon plus résolue, plus énergique et dans un esprit plus offensif ; […]."
                                            },
                                            {
                                                "example_id": "b77b016a-4631-4e0a-b634-e95e934f1b89",
                                                "sense_id": "21cd40c5-3180-333f-b74b-24ebead53c8a",
                                                "text": "Vous êtes myope des yeux, myope du cœur et myope du cul !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "myope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                        "entry_id": "587d392a-7f58-39b8-8573-ca1b78f02988",
                                        "glosses": [
                                            "Celui, celle qui a la vue fort courte et qui ne peut voir les objets éloignés sans le secours d’un verre concave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8d7bcd-6f6c-4870-9aaa-e63621a477f2",
                                                "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                                "text": "Un lorgnon, des lunettes de myope."
                                            },
                                            {
                                                "example_id": "c3db59a6-1313-45c9-97de-d2709eca7b25",
                                                "sense_id": "58ae7495-ac8d-312d-b860-e32ee75368f2",
                                                "text": "L’homme sursauta, se frotta les yeux ; instinctivement, d’un geste de myope, il prit dans son gilet de grosses lunettes rondes cerclées d’or."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79286156-cfab-423f-8666-5cc13f2d32df",
                        "source_entry_id": "708a1db5-51b9-388d-b9ce-e3ed94c10a01",
                        "source_sense_description": "lack of imagination, discernment or long-range perspective in thinking or planning",
                        "target_lang_word": "Kurzsichtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurzsichtigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "häufiger Sehfehler, bei dem nur Objekte in der Nähe scharf gesehen werden können, weiter entfernte Objekte werden verschwommen wahrgenommen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17681ed6-b287-440c-9895-e04636b77dce",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "Kurzsichtigkeit lässt sich durch eine Brille leicht ausgleichen."
                                            },
                                            {
                                                "example_id": "9e47feaa-ca50-42e7-bb77-92be78ede5d9",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Emma Bertini ließ sich dank ihrer Kurzsichtigkeit durch die wilde Bewegung nicht stören.“"
                                            },
                                            {
                                                "example_id": "257080f3-30da-4dc0-aa41-a9ea104afc5a",
                                                "sense_id": "d1c79737-f3b3-3dd3-9c62-e4138400a3fe",
                                                "text": "„Wegen starker Kurzsichtigkeit von der Bundeswehr befreit, hatte er die Hälfte seines Chemiestudiums schon hinter sich und war seinen Studienkollegen weit voraus, eben weil er seine Freizeit kaum anders als in der Universität verbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                        "entry_id": "748ccaef-ebe3-3d9d-b29e-d764050a98ac",
                                        "glosses": [
                                            "Mangel an Weitblick, Unfähigkeit spätere Konsequenzen seines Handelns abschätzen zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4b4692-62ec-4da8-aa2a-3417fb08d4a1",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "Die Beschlüsse der Regierung sind an Kurzsichtigkeit nicht zu überbieten."
                                            },
                                            {
                                                "example_id": "3d38d3e5-453f-4a72-9473-0bb137db4eee",
                                                "sense_id": "ed142a89-a531-3a4f-849d-d74a76d307e9",
                                                "text": "„Dieser Fehler spiegelt nicht nur die Kurzsichtigkeit des Literaturkritikers wider, mit der er sich selbst zum Gespött der französischen Literaturwelt machte, sondern auch, wie mühelos sich das Buch ohne diesen Buchstaben liest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
