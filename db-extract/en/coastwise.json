                                "sense_id": "3ec37598-638e-3597-9762-7f346479a61c",
                                "text": "coastwise shipping"
                            },
                            {
                                "example_id": "b2a71777-965e-49d7-ace6-17c44c5f94cd",
                                "sense_id": "3ec37598-638e-3597-9762-7f346479a61c",
                                "text": "Because of the drastic reduction in the use of petrol and tyres the railway is now called on to effect practically all the island's transport, with the exception of a small amount handled by one coastwise steamer."
                            },
                            {
                                "example_id": "6fca4088-9959-4ce9-b8ab-6f2dbedcb69c",
                                "sense_id": "3ec37598-638e-3597-9762-7f346479a61c",
                                "text": "Until the war of 1914-18 the largest proportion of coal was shipped for export or coastwise movement to U.K. ports, and even with the decline of the industry between the wars this trend continued until the Second World War."
                            }
                        ]
                    }
