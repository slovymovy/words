                                "target_senses": [
                                    {
                                        "sense_id": "d383c427-b651-3e9e-b1df-d7b19922b15c",
                                        "entry_id": "3aff42dc-4621-3379-bf48-c05991085f85",
                                        "glosses": [
                                            "Vedette incontestée et adulée."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a5db9f1-1425-4b9f-b2c6-d5cd55196c4d",
                                                "sense_id": "d383c427-b651-3e9e-b1df-d7b19922b15c",
                                                "text": "Panafieu superstar au meeting de l’UMP."
                                            },
                                            {
                                                "example_id": "832ac2eb-3a8d-43c5-9a63-c88846dea33f",
                                                "sense_id": "d383c427-b651-3e9e-b1df-d7b19922b15c",
                                                "text": "ManU avait officialisé son départ le 1ᵉʳ juin, mettant un point final à un passage mitigé chez les Red Devils où il était arrivé en superstar en 2016 au terme d’un contrat astronomique de quelque 105 millions d’euros ficelé par son agent Mino Raiola, décédé en avril."
                                            },
                                            {
                                                "example_id": "69acf074-946d-4dac-919a-629aff37b070",
                                                "sense_id": "d383c427-b651-3e9e-b1df-d7b19922b15c",
                                                "text": "Au moment où le Kremlin réprime toute critique, la superstar de la chanson russe Alla Pougatcheva a dénoncé, dimanche, le conflit en Ukraine, évoquant la mort de soldats « pour des objectifs illusoires »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e7feff6-9e47-45b3-a50a-dabc415908e3",
                        "source_entry_id": "a5b13d45-5f9a-3a8f-b1fe-716fc896e635",
                        "source_sense_description": "very famous person",
                        "target_lang_word": "Superstar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Superstar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                        "entry_id": "9bb640b4-93b2-34dc-ae29-e14286c5d1fd",
                                        "glosses": [
                                            "Person, die alle anderen Stars an Berühmtheit überragt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e21a93-03b3-453a-b34d-0a90f4863dc8",
                                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                                "text": "„Damals schien er von Chomsky Superstar fasziniert gewesen zu sein.“"
                                            },
                                            {
                                                "example_id": "4001c977-d88c-4e8e-a4c7-1a5478284d7d",
                                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                                "text": "„Aber er ist so etwas wie ein Superstar unter den Wunderheilern.“"
                                            },
                                            {
                                                "example_id": "e5dd9061-8471-478b-8dc9-b27dc9a89d8f",
                                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                                "text": "„Nur Monate nach den Dreharbeiten stieg sie zu einem der Superstars im deutschsprachigen Raum auf: Kino, TV, Theater.“"
                                            },
                                            {
                                                "example_id": "e355aed1-8262-4057-abf6-2d9577c75340",
                                                "sense_id": "cfe4164d-1db7-3196-947e-9dceb8a07cbe",
                                                "text": "„Das deutsche Publikum liebt Jesse Owens, den farbigen Superstar der Spiele, wenn Hitler das anders sieht, ist das sein Problem – für kurze Zeit scheint alles möglich und die Welt ein friedlicher, großzügiger Ort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
