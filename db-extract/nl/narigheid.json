                        "entry_id": "d2efe0a1-9c20-3a33-a750-eab0a7bc7452",
                        "glosses": [
                            "ellende, verdriet, penarie, troosteloosheid, sores, malheur, pijn, rottigheid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4ed2b8b-6309-4622-bf21-64d7fff274c6",
                                "sense_id": "15844d98-3e99-36b5-bf05-1af2951e10bf",
                                "text": "Hij vertelt Job niet waarom hem de narigheid is overkomen."
                            }
