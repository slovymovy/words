                    {
                        "translation_id": "aa726361-709b-4def-88fe-d69da07124b3",
                        "source_entry_id": "b9c09590-76c2-3285-9fa6-d18343a7e0ed",
                        "source_sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                        "target_lang_word": "inaspettatamente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inaspettatamente",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "2fdd7d60-6e9b-3b38-bb53-70dfa948650a",
                                        "entry_id": "4808b869-3e02-3354-8136-076cada6fca9",
                                        "glosses": [
                                            "in modo inaspettato"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d04ed4c-57c8-4080-b7ea-8e90ecc8831c",
                                                "sense_id": "2fdd7d60-6e9b-3b38-bb53-70dfa948650a",
                                                "text": "nel 1997 venne annunciato che, inaspettatamente, aveva avuto successo l'estrazione di Dna da un campione di osso fossile dell' uomo di Neanderthal"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "505101cd-5234-41fa-9163-ee2b3041b902",
                        "source_entry_id": "b9c09590-76c2-3285-9fa6-d18343a7e0ed",
                        "source_sense_id": "5bc4763d-c8cc-3ce5-9c51-27ae9366b097",
                        "target_lang_word": "onverwacht",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onverwacht",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                        "entry_id": "bda0f2e0-0502-326d-834a-94f4f7d50bf7",
                                        "glosses": [
                                            "niet van tevoren in zicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a7ca6f-d22a-491b-9a29-fc027c63bfc5",
                                                "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                                "text": "Door een onverwacht overlijden van mijn moeder kon ik niet naar de voetbalwedstrijd."
                                            },
                                            {
                                                "example_id": "457cc72b-c61e-4560-8515-268574756776",
                                                "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                                "text": "Hij verliest zijn evenwicht, rent als vanzelf nog een paar meter door en stuit dan op het lichaam van de oude Grisonnier, wiens onverwachte dood het vertreksein was geweest voor deze laatste slachtpartij."
                                            },
                                            {
                                                "example_id": "5e403af9-d42e-42df-9185-e3600fe25f42",
                                                "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                                "text": "Oortman die de afgelopen jaren acht keer in Sri Lanka geweest en er een petekind heeft, kent het land en de katholieke gemeenschap heel goed. „Ik heb vanmorgen nog contact gehad met de katholieke familie van mijn petekind. Zij zijn niet direct getroffen, maar leven in grote angst. De aanslag, uitgerekend op het Paasfeest, kwam voor hen totaal onverwacht. Ik leef met deze mensen mee. Het zijn mijn vrienden.”"
                                            },
                                            {
                                                "example_id": "6a55974f-c339-41bd-8bf2-c1306487ba8b",
                                                "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                                "text": "Deze indrukwekkende demonstratie van betrokkenheid van de kant van de majordomus had een onverwachte uitwerking op de gevleide dichteres. Ze begon te schateren, waarbij zichtbaar werd hoe haar tanden verankerd waren in de met roze tandvlees overtrokken mandibula van haar schedel. Het was bijna angstaanjagend hoe grappig zij de goedbedoelde declamatie van haar eigen meesterwerk achtte."
                                            },
                                            {
                                                "example_id": "bc08f101-27c7-400c-8e52-5828e70bff88",
                                                "sense_id": "6daf7bd9-0abe-31a5-8fc4-25421db4d6fd",
                                                "text": "'Het leven kan op de meest onverwachte plekken met verrassingen komen,'zei de vrouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
