                    {
                        "sense_id": "b2d3714a-c0ab-36ce-aaee-42405e6aab3e",
                        "entry_id": "3250d737-c2f6-3335-b1fc-ef48e8163ba7",
                        "glosses": [
                            "Bureau de vote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f600000c-8df4-4c82-905f-b54347f78889",
                                "sense_id": "b2d3714a-c0ab-36ce-aaee-42405e6aab3e",
                                "text": "Niemand darf gehindert werden, das Wahllokal zu betreten und die Wahlhandlung zu beobachten.",
                                "translation": "Nul ne peut être empêché de pénétrer dans le bureau de vote et d’observer les opérations électorales."
                            },
                            {
                                "example_id": "d51f2760-c202-4176-a5b4-3f479ab1b621",
                                "sense_id": "b2d3714a-c0ab-36ce-aaee-42405e6aab3e",
                                "text": "Nach der Schließung der Wahllokale beginnen die Wahlhelfer, die Stimmen auszuzählen.",
                                "translation": "Après la fermeture des bureaux de vote, les scrutateurs commencent à dépouiller les voix."
                            }
                        ]
                    }
                ],
