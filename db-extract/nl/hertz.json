                                    {
                                        "sense_id": "a6e2bc99-88d2-3564-bf87-157d1056013e",
                                        "entry_id": "99d046e7-6bf8-3162-8eb4-b69fd8f46a05",
                                        "glosses": [
                                            "In the International System of Units, the derived unit of frequency; one (period or cycle of any periodic event) per second. Symbol: Hz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12dab783-d897-4c1b-aef8-f8f0b318894e",
                                                "sense_id": "a6e2bc99-88d2-3564-bf87-157d1056013e",
                                                "text": "Each turbogenerator consisted of a steam turbine, powered by 900 psi of superheated steam, that was coupled by a set of reduction gears to a General Electric marine alternating-current generator operating at 1,800 rpm. Each generator had a capacity of 2,000 kilowatts of three-phase power at 450 volts and 60 hertz. The main 450-volt switchboard was energized by the two turbogenerators. The emergency switchboard, in the emergency generator room, was fed from the main switchboard through an electrical tie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "701b4c08-60f2-46eb-8a6a-4e0efcffd9ce",
                        "source_entry_id": "6b42322d-7d45-3258-9f65-ebdc11bb2663",
                        "source_sense_id": "fdf4049d-e5fb-3379-b43c-d43f86fa3620",
                        "source_sense_description": "de eenheid voor frequentie van trillingen",
                        "target_lang_word": "hertz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hertz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                        "entry_id": "0eff94ec-2363-387f-9071-4fa9b1fb3675",
                                        "glosses": [
                                            "Unité de fréquence permettant de mesurer le nombre de fois où un événement cyclique survient par seconde et dont le symbole est Hz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea831b6d-5c71-4522-999a-5bf6f0097709",
                                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                                "text": "Le courant alternatif standard en France a une fréquence de 50 hertz."
                                            },
                                            {
                                                "example_id": "01b82c36-7f07-41a6-9b12-cacc488f45db",
                                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                                "text": "Le son musical le plus grave que nous percevions est de 16 hertz (celui d'un des tuyaux de l'orgue) et notre oreille ne peut aller au-delà d'une fréquence aiguë de 20 000 hertz."
                                            },
                                            {
                                                "example_id": "f9db14fb-428f-4e22-90ef-280c055b203d",
                                                "sense_id": "4b9751fa-edc4-3e73-99de-b886508d6e5f",
                                                "text": "À Malte, dans la grotte d’Hypogeum, est creusée de main d’homme une cavité résonatrice. Sa fréquence est de quatre-vingt-dix hertz dont l’amplification se révèle terrifiante dès l’instant où les voix émises sont basses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
