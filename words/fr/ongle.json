                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle applique soigneusement du vernis coloré sur ses <w>ongles</w> chaque dimanche soir."
                        },
                        {
                            "text": "Il a souvent tendance à se ronger les <w>ongles</w> avant un examen important."
                        }
                    ],
                    "common_phrases": [
                        "se ronger les ongles",
                        "vernis à ongles",
                        "se couper les ongles"
                    ]
                },
                {
                    "sense_id": "4a486715-f03e-3277-88c4-34029f9eca11",
                    "sense_definition": "Griffe acérée ou serre cornée de certains animaux et oiseaux de proie.",
