                "senses": [
                    {
                        "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                        "entry_id": "b7c9ad8a-339c-3113-a666-48a8c7a4baac",
                        "glosses": [
                            "To tidy up using the methods advocated by Marie Kondo, especially keeping only those things that tokimeku (spark joy)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0f2ba828-74c3-498e-a233-0e749b724b8a",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "Waiting for kettle to boil … So I Kondoed my recipe books"
                            },
                            {
                                "example_id": "cc1cf2b5-e930-4a66-b3c6-df130e96143a",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "The Psychological Benefits Of 'Kondoing' Your House"
                            },
                            {
                                "example_id": "d8ee7df4-b2e7-4181-991d-8ee81c5005dd",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "'Kondoed fridge before shopping delivery' and 'It seems mundane but I’ve Kondo’d some deodorant that I didn’t like the smell of.'"
                            },
                            {
                                "example_id": "8ccb182f-0f0e-4e1f-b559-0b2f4ee61103",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "'How \"Kondo-ing\" my closet brought joy to my life', 'I Kondo’d my refrigerator last night', 'Dawson’s closet before and after Kondo-ing', and 'The first thing I Kondo’d was my books'"
                            },
                            {
                                "example_id": "06c51beb-e99c-4a19-b2bb-cad878f924ef",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "Kondoing requires clothing to be folded in a particular way and certain corners of Pinterest overflow with images of diligently arranged underwear drawers."
                            },
                            {
                                "example_id": "184be8b3-3f6e-4637-9059-e16756e9118a",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "Many people have heard of the movement that has folks asking if items in their closets “spark joy” or not. Begun by Marie “KonMari” Kondo, the “Kondoing” method of sparking joy has inspired people to go through their closets and discard or donate those items that don’t spark a sense of joy in their lives."
                            },
                            {
                                "example_id": "05552cd0-56d9-442f-a4c1-aca738fcfb7a",
                                "sense_id": "a9aacedb-6907-394f-867c-91f35d48ef48",
                                "text": "The spelling has not quite settled down. Because the name ends in a vowel, we see both “Kondo-ing” and “Kondoing,” as well as “Kondo-ed,” “Kondoed” and “Kondo’d.”"
                            }
                        ]
                    }
