                        "target_lang_word": "Marker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "durchsichtig breit schreibender farbiger Stift, mit dem man Text hervorhebt"
                                        ],
                                        "tags": [
                                            "kurz für Textmarker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae90a49-43ef-48b2-9604-e5145e1da6ef",
                                                "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                                "text": "Aktiv lesen können Sie zum Beispiel, indem Sie die wichtigsten Textstellen unterstreichen oder mit einem Marker kennzeichnen."
                                            },
                                            {
                                                "example_id": "056108c2-e63e-46f9-8500-544deea3c51b",
                                                "sense_id": "48a5f899-fa15-3ad6-bf5e-67186fb89e98",
                                                "text": "„Übertragen Sie die Kontur des Motivs mit einem Marker auf das Transparentpapier, drehen Sie das Papier dann um, legen Sie es auf den Stoff und ziehen Sie die Konturlinien mit etwas Druck nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b58df0ad-b4f4-35ea-a2ae-f227dac64468",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "Protein/Hormon, das ein Kennzeichen bedeutet, etwas markiert, auf etwas hinweist/verweist"
                                        ],
                                        "tags": [
                                            "kurz für Biomarker"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938bc0a6-aca2-4c36-b881-a3477de17f5b",
                                                "sense_id": "b58df0ad-b4f4-35ea-a2ae-f227dac64468",
                                                "text": "Für einige der häufigsten Krebserkrankungen gibt es aussagekräftige Marker. CEA ist solch ein Marker. Ein erhöhter CEA-Wert im Blut deutet auf einen Tumor hin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bfd067f8-2ec8-35c7-a76b-4c04b1307403",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "Mittel zum Ausdruck einer grammatischen Bedeutung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "727c5f81-7136-49ef-bd12-1f7d1f39116c",
                                                "sense_id": "bfd067f8-2ec8-35c7-a76b-4c04b1307403",
                                                "text": "„Diese somatischen Marker erlauben es, die Informationsmenge, die zur Entscheidungsfindung durchforstet werden muss, sofort emotional zu bewerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "c4553d42-3b2e-3399-8a3b-335e62157434",
                                        "entry_id": "73743991-7407-391f-a98f-438df7c73d74",
                                        "glosses": [
                                            "genetisches Merkmal eines Virus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e37577c-426f-425a-a52e-7d208d35a723",
                                                "sense_id": "c4553d42-3b2e-3399-8a3b-335e62157434",
                                                "text": "„Die verschiedenen Marker des Virus sind im dynamischen Wechsel und reflektieren die virale Replikation und die Immunantwort des Patienten (Abb. 3).“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
