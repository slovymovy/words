                "senses": [
                    {
                        "sense_id": "d4eaee59-7a4d-3b5f-85aa-7be901a39463",
                        "entry_id": "62ba90e9-e4b4-358a-aa14-169d7d73606f",
                        "glosses": [
                            "spezialisierter Arzt, Facharzt im Bereich der Rechtsmedizin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92d69c64-615f-48eb-a57f-ebe4ce14a3a0",
                                "sense_id": "d4eaee59-7a4d-3b5f-85aa-7be901a39463",
                                "text": "„Seit es Serien wie ‚CSI‘ gibt, müssen sich die Rechtsmediziner an den Universitäten über fehlenden Nachwuchs keine Sorgen mehr machen. Vor allem Frauen entscheiden sich für diesen Studiengang.“"
                            },
                            {
                                "example_id": "977581b6-f05b-414f-9f85-dc7f9a8260ed",
                                "sense_id": "d4eaee59-7a4d-3b5f-85aa-7be901a39463",
                                "text": "„Außer dem Bericht des Rechtsmediziners hatten sie nichts in den Händen, und im Prinzip gab es auch noch keine Verdächtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
