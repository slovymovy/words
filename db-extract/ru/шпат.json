                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                                        "entry_id": "24cef81f-a1c7-3985-8db2-ddd6d7069474",
                                        "glosses": [
                                            "A friend, a mate, a pal."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401f749b-07d2-4398-9ca7-66bd219827ac",
                                                "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                                                "text": "KLASHNEKOFF: I take two glass then pass the spliff to my spars."
                                            },
                                            {
                                                "example_id": "25e91f7e-7dfc-4652-8488-98bc7fa32ec4",
                                                "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                                                "text": "'Ello clart! How are you doin' spar? Let's have a look at your mobile phone there, that's fuckin' posh, innit?[…]that's fuckin' safe, spar!"
                                            },
                                            {
                                                "example_id": "bd2fa543-1640-4567-b248-e0fb614636a9",
                                                "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                                                "text": "I don't care if you got friends in your car. Light up your whip and all of your spars."
                                            },
                                            {
                                                "example_id": "7ed42f8c-2cda-436e-a565-4f9054769200",
                                                "sense_id": "f1ccf35f-ffa3-3f82-a30f-6351acd3df54",
                                                "text": "Trying to explain to my spars how it is over a spliff. Arguing, cause the media got 'em locked under their lids."
                                            }
                                        ]
                                    }
                                ]
                            },
