                        "glosses": [
                            "Supprimer les veines ou les vaisseaux sanguins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c10fa092-9139-4a45-9f29-13a1d061eab0",
                                "sense_id": "872cfa14-8f76-3ce5-9bfb-c1676c51753c",
                                "text": "Il faut bien prendre soin de ne pas casser un foie gras en l'éveinant."
                            },
                            {
                                "example_id": "164ca143-89f3-4564-8eb4-55ccbb63ef6f",
                                "sense_id": "872cfa14-8f76-3ce5-9bfb-c1676c51753c",
                                "text": "Des jambes variqueuses peuvent être éveinées si le patient souffre de douleurs importantes, par exemple en cas de phlébite récurrente (thrombophlébite)."
                            }
                        ]
