                        "cross_references": [
                            {
                                "target_word": "adjectival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1373c223-b9c6-3433-9b3a-aceb17106d8b",
                                        "entry_id": "ec183d43-08d0-31d3-959c-8453e7fe4b86",
                                        "glosses": [
                                            "Of or relating to or functioning as an adjective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9addddac-5c97-438c-8eb5-b687c410d514",
                                                "sense_id": "1373c223-b9c6-3433-9b3a-aceb17106d8b",
                                                "text": "adjectival syntax"
                                            },
                                            {
                                                "example_id": "9678e043-7a3c-4381-9c32-2f6c38175837",
                                                "sense_id": "1373c223-b9c6-3433-9b3a-aceb17106d8b",
                                                "text": "adjectival noun"
                                            },
                                            {
                                                "example_id": "066d0610-6eb1-4509-9107-2d4ee3f4c9bd",
                                                "sense_id": "1373c223-b9c6-3433-9b3a-aceb17106d8b",
                                                "text": "As we can have the adjectival forms bright, brighter, brightest, so we can have the adverbial forms brightly, brightlier, brightliest, but degree is alike inconceivable in the adjective ‘round,’ and the A. ‘here.’"
                                            },
                                            {
                                                "example_id": "cd92c5bb-63ee-4a63-a6ff-811784ce17c6",
                                                "sense_id": "1373c223-b9c6-3433-9b3a-aceb17106d8b",
                                                "text": "Almost all of these names are adjectival in form, derived from some other personal or place-name, usually by the addition of the suffix -ius, -aeus, -eius, or -eus; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986f4dc7-9882-3b83-b268-84e892b124e8",
                                        "entry_id": "ec183d43-08d0-31d3-959c-8453e7fe4b86",
                                        "glosses": [
                                            "Of or relating to procedure, especially to technicalities thereof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "adjectival",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "486a1297-0f66-3c43-84d8-5aa4280f123b",
                                        "entry_id": "17227f22-e652-3d29-9836-a1da842f9f7f",
                                        "glosses": [
                                            "An adjectival phrase or clause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d45033-139a-4240-b2ac-e469d14d5ccc",
                                                "sense_id": "486a1297-0f66-3c43-84d8-5aa4280f123b",
                                                "text": "Within this line of reasoning, then, Tagalog is classified as a language in which adjectivals are essentially neutral between a nouny and a verby interpretation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
