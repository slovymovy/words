                        "glosses": [
                            "A person or machine that sears food."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b427c8e-a69b-4f4a-8864-cbbe1bb4d9a8",
                                "sense_id": "a935fb13-afd8-36a4-bc18-757a57601976",
                                "text": "Apart from searers and pans, this section of the kitchen requires two important items of subsidiary equipment, both concerned with sieving or straining, the one for use with the tilting pan and the other with the fixed pan."
                            },
                            {
                                "example_id": "07c0f2c6-aa9f-4145-8da9-23d81399171b",
                                "sense_id": "a935fb13-afd8-36a4-bc18-757a57601976",
                                "text": "Searers insist that a roast develops a rich crust when seared (it does) and that this crust seals in meat juices (it doesn't). After a lifetime of dutifully cooking roasts in a moderate oven, I've defected to the searers' camp."
                            }
                        ]
                    }
