                        "sense_id": "2f0294c6-3426-399c-ac72-24920d1194d7",
                        "entry_id": "136a16a6-b3bc-3d5f-bb61-14999259019c",
                        "glosses": [
                            "Schachvariante, bei der mindestens einer der Spieler die Partie vollständig im Kopf spielt – ohne Ansicht der Figuren und des Schachbretts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce050d7e-238b-450f-a2cc-50e6ed35167f",
                                "sense_id": "2f0294c6-3426-399c-ac72-24920d1194d7",
                                "text": "Beim alljährlichen Melody-Amber-Turnier in Monte Carlo messen sich Schachgroßmeister in einem Turnier mit kombinierter Wertung in Blindschach und Schnellschach."
                            },
                            {
                                "example_id": "38ff28af-9600-49b4-a41c-33ec3a461f3b",
                                "sense_id": "2f0294c6-3426-399c-ac72-24920d1194d7",
                                "text": "„Schon früh entbrannte eine Diskussion darum, ob Blindschach schädlich für den Geist des Menschen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
