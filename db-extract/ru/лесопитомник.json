                ],
                "senses": [
                    {
                        "sense_id": "68df4a8f-b08f-3e69-8002-f79e23dd1566",
                        "entry_id": "0270fbac-d5e2-3d8f-8e3f-b5d44f986682",
                        "glosses": [
                            "питомник, в котором выращиваются саженцы или сеянцы лесных древесных и кустарниковых пород"
                        ],
                        "tags": [],
