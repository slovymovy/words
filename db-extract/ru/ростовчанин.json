                                        "entry_id": "726fdf7a-c91c-3d73-ab1c-36b8f54e22f9",
                                        "glosses": [
                                            "Bewohner von Rostock, jemand, der aus Rostock stammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1e2a01-a76c-44eb-aea0-7c66a1a52532",
                                                "sense_id": "b57e8913-e09a-316c-baf5-49381e11f96f",
                                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Rostocker."
                                            },
                                            {
                                                "example_id": "005f1190-2d28-4bb3-9198-0697e4779e05",
                                                "sense_id": "b57e8913-e09a-316c-baf5-49381e11f96f",
                                                "text": "„Das Schiff wurde in der Nacht zu Samstag in den Rostocker Hafen geschleppt, wo es um 1.00 Uhr festmachte.“"
                                            }
                                        ],
