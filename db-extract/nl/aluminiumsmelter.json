                        "examples": [
                            {
                                "example_id": "19f36e50-83a3-4b88-b9dd-e60304904164",
                                "sense_id": "182f0e18-2ec5-3066-83d6-54381197edd3",
                                "text": "In de provincie Groningen wordt geprotesteerd tegen het faillissement van aluminiumsmelter Aldel en de gevolgen van de gaswinning in de provincie."
                            },
                            {
                                "example_id": "e5a3c67c-0fff-41d3-8396-d3a344e41681",
                                "sense_id": "182f0e18-2ec5-3066-83d6-54381197edd3",
                                "text": "De productie bij aluminiumsmelter Aldel uit Delfzijl wordt herstart. Dat heeft de investeerder, de Klesch Group, bekendgemaakt. De fabriek ging eind vorig jaar failliet. Klesch verwacht begin 2015 de fabriek weer te kunnen opstarten. Aan het eind van dat jaar verwacht het bedrijf ruim 200 mensen in dienst te hebben."
                            },
                            {
                                "example_id": "3b6c82ed-dc26-47d8-a209-e8402d8c3272",
                                "sense_id": "182f0e18-2ec5-3066-83d6-54381197edd3",
                                "text": "Er kunnen naar verwachting weer 200 mensen aan het werk bij de aluminiumsmelter."
                            }
                        ]
                    }
