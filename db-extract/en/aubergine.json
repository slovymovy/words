                    {
                        "translation_id": "a9d474bb-a470-4321-81a8-76581efcac9f",
                        "source_entry_id": "aa6401f8-1e27-3c58-bb9c-f79f3b161e00",
                        "source_sense_id": "df59a45f-3a08-33cd-9f5e-8fb58d1bc3c7",
                        "source_sense_description": "Farbe der Aubergine",
                        "target_lang_word": "Aubergine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aubergine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d36c7624-9e2f-39ab-bc52-5b887a4ae88f",
                                        "entry_id": "d0c4eb48-3827-30aa-9211-bff93bed61ea",
                                        "glosses": [
                                            "Pflanze (Solanum melongena) aus der Familie der Nachtschattengewächse (Solanaceae)"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f54899-3758-446a-a34d-d6ca5fee63a1",
                                                "sense_id": "d36c7624-9e2f-39ab-bc52-5b887a4ae88f",
                                                "text": "Auberginen müssen kräftig gedüngt werden."
                                            },
                                            {
                                                "example_id": "027378a1-8ef7-4a4b-a1de-7664458a9884",
                                                "sense_id": "d36c7624-9e2f-39ab-bc52-5b887a4ae88f",
                                                "text": "„Die Einführung der genetisch veränderten Aubergine wurde in Indien als ein von außen durchgeführter Angriff auf die Souveränität der Nahrungsmittelversorgung und das ‚genetische Erbe‘ des Landes wahrgenommen.“"
                                            },
                                            {
                                                "example_id": "44cb73ef-a965-4432-a20b-f851fa96d12e",
                                                "sense_id": "d36c7624-9e2f-39ab-bc52-5b887a4ae88f",
                                                "text": "„Desgleichen mißlang ihm der Rosenkohl, ebenso die Auberginen, die Kohlrüben und die Brunnenkresse, die er in einem Kübel hatte ziehen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c1d35e46-c29c-3b03-b9a1-641fe814acf0",
                                        "entry_id": "d0c4eb48-3827-30aa-9211-bff93bed61ea",
                                        "glosses": [
                                            "essbare, ei- bis keulenförmige, zumeist – je nach Sorte – dunkelviolette bis weißliche Frucht der unter [1] beschriebenen Pflanze"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d663516-f7f7-4416-93f9-cdb6774b26b5",
                                                "sense_id": "c1d35e46-c29c-3b03-b9a1-641fe814acf0",
                                                "text": "Die Aubergine ist in der italienischen Küche oft anzutreffen."
                                            },
                                            {
                                                "example_id": "3e4169f1-9f74-4d2b-9db2-bbdcce0217fe",
                                                "sense_id": "c1d35e46-c29c-3b03-b9a1-641fe814acf0",
                                                "text": "„Erst mit Öl, gegrillt oder gebraten, entfaltet die Aubergine jenes nussartige Aroma, das sie so verführerisch macht.“"
                                            },
                                            {
                                                "example_id": "2e66572f-1b12-440f-a998-5f76e4905385",
                                                "sense_id": "c1d35e46-c29c-3b03-b9a1-641fe814acf0",
                                                "text": "„Eine halbe Stunde später erklärte Thomas dem Mädchen Nanette, wie man Auberginen zubereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c4fc90bb-2f44-32c6-a4ea-941fbb1392cf",
                                        "entry_id": "d0c4eb48-3827-30aa-9211-bff93bed61ea",
                                        "glosses": [
                                            "Glasur von blauroter Farbe, die in bestimmten chinesischen Porzellanen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67456af4-de6d-4f0e-b464-ff705a71962d",
                                                "sense_id": "c4fc90bb-2f44-32c6-a4ea-941fbb1392cf",
                                                "text": "Diese blaurote Glasur und das Porzellan überhaupt nennt man Aubergine."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0753ca6e-8915-347d-b4e0-f9a4dcac465a",
                                        "entry_id": "d0c4eb48-3827-30aa-9211-bff93bed61ea",
                                        "glosses": [
                                            "chinesisches Porzellan mit der unter [3] beschriebenen Glasur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68669f2e-f9c1-49d2-a3ae-287bb2077530",
                                                "sense_id": "0753ca6e-8915-347d-b4e0-f9a4dcac465a",
                                                "text": "Diese blaurote Glasur und das Porzellan überhaupt nennt man Aubergine."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
