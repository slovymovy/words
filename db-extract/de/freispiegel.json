                ],
                "senses": [
                    {
                        "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                        "entry_id": "d6539d72-c5e5-3369-9aad-0cfa7b4d6116",
                        "glosses": [
                            "der sich einstellende freie Wasserspiegel in einer Rohrleitung oder offenem Gerinne"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "d5375ea9-53d4-40b8-aa70-4fa8753ef505",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Freispiegel bedeutet, dass das ablaufende Wasser eine Wasseroberfläche, den Spiegel, im Rohr hat.“"
                            },
                            {
                                "example_id": "1565af06-aa68-49a4-a86e-c69ce028afa5",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Sie können für die Ableitung von Kommunalen- und Industrieabwässer und Regenwasser mit einer Bodenunterkante von -6,0 m bei unterirdischen Rohrleitungen mit Freispiegel eingebaut werden.“"
                            },
                            {
                                "example_id": "51717e11-4aab-40e0-90fe-c0b4fafa13db",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Mit der Kompaktmessstelle Perma-Dik der Zangenberg GmbH, Schlingen, lassen sich Abwasser im Freispiegel messen.“"
                            },
                            {
                                "example_id": "04da7e29-5587-47df-aff8-33c84308699d",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Im Freispiegel fliesst das Abwasser der Gebiete Ettishüsere, Weierhus und Rüttmatt ins öffentliche Pumpwerk PW1 bei der Liegenschaft Baumgartner am Weierhusbach.“"
                            },
                            {
                                "example_id": "29165d7c-6824-47e2-8ab0-513aa6735f66",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Die Überlaufleitungen im Freispiegel bestehen aus Edelstahl.“"
                            },
                            {
                                "example_id": "0a5f463d-3c1f-468d-8870-d62c4fba5cac",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Abhängig ob die abgehende Haltung Freispiegel oder Druckrohrleitung ist wird der angegebene Wert als maximaler Drosselabfluss oder konstanter Pumpenabfluss gerechnet.“"
                            },
                            {
                                "example_id": "98e7ece5-bda6-4d27-a357-4f3d08e84225",
                                "sense_id": "180165dc-2b11-3d65-954c-322a3a626241",
                                "text": "„Beim Einlauf aus großen Behältern mit Freispiegel startet die Energielinie auf der Höhe des Freispiegels minus dem Einzelverlust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
