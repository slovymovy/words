                "translations": [
                    {
                        "translation_id": "a7b0a099-83ec-417c-a6ce-1ac6fc86373d",
                        "source_entry_id": "cb7f202a-796f-3094-8e2d-85e423bed6f0",
                        "target_lang_word": "lolicon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lolicon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea616631-cd29-3eb6-9bf1-1fab9dbac937",
                                        "entry_id": "5ebeff97-ab3b-3db4-80e9-32bed30943cd",
                                        "glosses": [
                                            "Attraction (often erotic) to young, typically prepubescent girls, or the fictional depictions thereof."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d074ba-8838-49ad-aff2-6683b9cba46e",
                                                "sense_id": "ea616631-cd29-3eb6-9bf1-1fab9dbac937",
                                                "text": "Innocence’s story—about female sex androids that kill their owners—is possible only in a Lolicon country like Japan. The androids are modeled after little girls[.]"
                                            },
                                            {
                                                "example_id": "0728ec2f-305a-4f21-8050-ed14c0977bc6",
                                                "sense_id": "ea616631-cd29-3eb6-9bf1-1fab9dbac937",
                                                "text": "A Japanese term derived from the English phrase “Lolita complex,” lolicon describes a fascination with cartoons of very young-looking girls engaged in varying degrees of erotic behavior."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                        "entry_id": "5ebeff97-ab3b-3db4-80e9-32bed30943cd",
                                        "glosses": [
                                            "An individual who is attracted to young, typically prepubescent, girls."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0cf14d1-28cd-44b5-99f8-44df604b3f8b",
                                                "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                                "text": "Hey, don't take me for a lolicon: I'm not! It is just that I find that kind of anime... fun, refreshing."
                                            },
                                            {
                                                "example_id": "b824446f-4c0f-4bb8-8289-bdb1ba93cb65",
                                                "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                                "text": "I don't need to hear you are becoming a lolicon."
                                            },
                                            {
                                                "example_id": "0fe3440d-bf60-48d1-b050-9352cbd011e4",
                                                "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                                "text": "Ken's a lolicon (pedophile)."
                                            },
                                            {
                                                "example_id": "82d5c90a-5009-4bc3-b57b-65fe522778ce",
                                                "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                                "text": "I like lolis, I consider myself a lolicon, but I'm not attracted to real children. Your argument fails immediately there since most lolicons are not attracted to real children. Am I a pedophile?"
                                            },
                                            {
                                                "example_id": "1abed037-1bdf-475e-b7d2-dd6d90dad8c8",
                                                "sense_id": "59c35bcc-66a3-3ac6-9641-a8d92299b517",
                                                "text": "Let me say it again, lolicon and pedo are a different thing. japanese people are just saying it lolicon because in their mind, they already implanted the word of lolicon as pedo, but in anime community, pedo and lolicon are a different thing. why make it different ? so that we can see the difference from people who likes \"fictional\" little girl and from people who likes \"real\" little girl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                        "entry_id": "5ebeff97-ab3b-3db4-80e9-32bed30943cd",
                                        "glosses": [
                                            "Erotic or suggestive artwork depicting young, typically prepubescent, girls."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57d82f76-ea98-463f-a011-12c862420ae2",
                                                "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                                "text": "If you are into bishojo, loli-con, or bishonen materials, be advised that customs *does* frown on what might be considered pornography."
                                            },
                                            {
                                                "example_id": "cce0cbf4-c4ce-462a-a1c0-c3569debb9dd",
                                                "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                                "text": "the whole gamut of lolicon and girls-with-guns genres"
                                            },
                                            {
                                                "example_id": "ee5e79cb-54f3-4605-9aee-f02133521eef",
                                                "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                                "text": "Some critics of lolicon claim that those who enjoy it also necessarily enjoy real child porn […]"
                                            },
                                            {
                                                "example_id": "3040e5e8-b721-47c7-b767-3771f2c817c3",
                                                "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                                "text": "Bizarrely, viewing and collecting lolicon seems to have become a subcultural norm, especially in Japan, […]"
                                            },
                                            {
                                                "example_id": "e0f390f1-4bcf-49f6-bb2e-bf2e55466be0",
                                                "sense_id": "3ebbca8a-d975-32d0-b45b-76de87165f7f",
                                                "text": "Most importantly, because German child pornography and child abuse laws forbid representation of children as sexual objects, there is a complete ban on shota or lolicon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d0816e-2bfc-34ae-a0ae-fa3aff5782c2",
                                        "entry_id": "5ebeff97-ab3b-3db4-80e9-32bed30943cd",
                                        "glosses": [
                                            "Sexual attraction to or fascination with young girls in general."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4134fec8-5f86-4fc7-a7bc-3d4da7fcdb3e",
                                                "sense_id": "55d0816e-2bfc-34ae-a0ae-fa3aff5782c2",
                                                "text": "I got many flames for denoucing Nacchan's Lolicon ways a few months back!"
                                            },
                                            {
                                                "example_id": "81508ea2-dc53-4b24-b627-6100431de2ee",
                                                "sense_id": "55d0816e-2bfc-34ae-a0ae-fa3aff5782c2",
                                                "text": "This work can be considered a commentary on Japan's sexual fetishisms, inclusive of BDSM and lolicon, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
