                    {
                        "sense_id": "22ec79ac-588d-3929-b508-d218bf50974c",
                        "entry_id": "9746e7e0-91f0-3a23-860d-c39444da2302",
                        "glosses": [
                            "размывая текущей водой землю, грунт, образовывать углубление, овраг и т. п"
                        ],
                        "tags": [],
