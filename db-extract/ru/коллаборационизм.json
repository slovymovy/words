                "senses": [
                    {
                        "sense_id": "1127868b-a334-3b9b-93be-1b0ff0503442",
                        "entry_id": "78027526-cdee-36cc-87cd-e06d87ad3d56",
                        "glosses": [
                            "полит. осознанное, добровольное и умышленное сотрудничество с врагом, в его интересах и в ущерб своему государству"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e553fba1-dda0-4cf7-999d-d126cbaeff90",
                                "sense_id": "1127868b-a334-3b9b-93be-1b0ff0503442",
                                "text": "Во время фашистской оккупации коллаборационизм среди латгальцев был не таким массовым и идеологически обусловленным, как в Западной Латвии: здесь было не так много зажиточных хозяйств, не так остро стоял вопрос о национализированной большевиками собственности ― многие латгальцы при Ульманисе ездили наниматься батраками в Западную Латвию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a27b883f-109b-48e5-809d-bf0c6d9bc1a5",
                        "source_entry_id": "78027526-cdee-36cc-87cd-e06d87ad3d56",
                        "source_sense_id": "1127868b-a334-3b9b-93be-1b0ff0503442",
                        "target_lang_word": "collaboration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collaboration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "The act of collaborating."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1b3895-92aa-4c79-9fa1-646eefe4b226",
                                                "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                                "text": "Collaboration can be a useful part of the creative process."
                                            },
                                            {
                                                "example_id": "cc7cdbc5-ad46-4904-98aa-068e4a360c51",
                                                "sense_id": "8b2a07b4-598f-3edb-b3b9-f6e784acc2a6",
                                                "text": "During the interwar period, fascists proposed class collaboration as a response to communist class struggle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a7d3fd-b92b-3e8b-852a-32a46687e0a6",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "A production or creation made by collaborating."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e025e4-9df8-4745-9136-748c4cdf2e98",
                                                "sense_id": "d0a7d3fd-b92b-3e8b-852a-32a46687e0a6",
                                                "text": "The husband-and-wife artists will release their new collaboration in June this year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5918d34a-74e4-367a-8f30-53a2a4ba81d5",
                                        "entry_id": "d7f3aa65-355f-39b6-baf0-dbacf7dcfdfd",
                                        "glosses": [
                                            "Treasonous cooperation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712e3b28-f0be-48a5-a323-0bfec00ea69b",
                                                "sense_id": "5918d34a-74e4-367a-8f30-53a2a4ba81d5",
                                                "text": "He has been charged with collaboration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
