    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "807eacd0-5a6e-327f-91fd-dcf4151eac31",
                    "sense_definition": "Simple past and past participle of <w>feel</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>felt</w> tired after working in the garden all day.",
                            "target_lang_translations": {
                                "ru": "Она <w>чувствовала</w> усталость после работы в саду весь день.",
                                "pl": "Po całodziennej pracy w ogrodzie <w>czuła</w> się zmęczona."
                            }
                        },
                        {
                            "text": "I have never <w>felt</w> this happy before.",
                            "target_lang_translations": {
                                "ru": "Я никогда раньше не <w>чувствовал</w> себя таким счастливым.",
                                "pl": "Nigdy wcześniej nie <w>czułem</w> się tak szczęśliwy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "felt like",
                        "felt better",
                        "felt sorry",
                        "felt sure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола <w>feel</w> (чувствовать).",
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika feel (czuć)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чувствовал",
                                "target_lang_sense_clarification": "прошедшее время, несовершенный вид"
                            },
                            {
                                "target_lang_word": "почувствовал",
                                "target_lang_sense_clarification": "прошедшее время, совершенный вид"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "czuł",
                                "target_lang_sense_clarification": "czas przeszły, rodzaj męski"
                            },
                            {
                                "target_lang_word": "poczuł",
                                "target_lang_sense_clarification": "czas przeszły, dokonany"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c70fc75-bbec-3692-8571-f86c95bf9abb",
                    "sense_definition": "A thick, soft fabric made by pressing wool or other fibers together rather than weaving them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The billiard table was covered in smooth green <w>felt</w>.",
                            "target_lang_translations": {
                                "ru": "Бильярдный стол был покрыт гладким зеленым <w>фетром</w>.",
                                "pl": "Stół bilardowy był pokryty gładkim, zielonym <w>filcem</w>."
                            }
                        },
                        {
                            "text": "We used red <w>felt</w> to make decorations for the holiday.",
                            "target_lang_translations": {
                                "ru": "Мы использовали красный <w>фетр</w> для изготовления праздничных украшений.",
                                "pl": "Użyliśmy czerwonego <w>filcu</w> do zrobienia świątecznych dekoracji."
                            }
                        }
                    ],
                    "common_phrases": [
                        "green felt",
                        "roofing felt",
                        "wool felt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотный мягкий материал, получаемый путем спрессовывания шерсти или других волокон, а не ткачества.",
                        "pl": "Gruby, miękki materiał wytwarzany przez sprasowanie wełny lub innych włókien, zamiast tkania."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фетр",
                                "target_lang_sense_clarification": "тонкий, мягкий сорт для шляп и поделок"
                            },
                            {
                                "target_lang_word": "войлок",
                                "target_lang_sense_clarification": "плотный, грубый материал"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "filc",
                                "target_lang_sense_clarification": "materiał ze zbitej wełny"
                            },
                            {
                                "target_lang_word": "pilśń",
                                "target_lang_sense_clarification": "zwarty materiał z włókien wełny lub sierści"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00c7c079-dbd9-3734-9233-6224c5f4d520",
                    "sense_definition": "A pen with a writing tip made of porous material; a felt-tip pen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tool_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used black <w>felts</w> to outline the drawing.",
                            "target_lang_translations": {
                                "ru": "Художник использовал черные <w>фломастеры</w>, чтобы обвести рисунок.",
                                "pl": "Artysta użył czarnych <w>flamastrów</w>, aby obrysować rysunek."
                            }
                        },
                        {
                            "text": "Please bring a set of colored <w>felts</w> to the art class.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, принесите набор цветных <w>фломастеров</w> на урок рисования.",
                                "pl": "Proszę przynieść zestaw kolorowych <w>flamastrów</w> na zajęcia plastyczne."
                            }
                        }
                    ],
                    "synonyms": [
                        "marker",
                        "felt-tip"
                    ],
                    "common_phrases": [
                        "felt pen",
                        "felt tip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often referred to as a felt-tip or marker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ручка с пишущим наконечником из пористого материала; фломастер.",
                        "pl": "Pisak z końcówką wykonaną z porowatego materiału; flamaster."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фломастер",
                                "target_lang_sense_clarification": "инструмент для рисования"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "flamaster",
                                "target_lang_sense_clarification": "narzędzie do pisania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2155daaf-2872-3aee-8177-6071fd941a6d",
                    "sense_definition": "A hat made of felt material.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tipped his old brown <w>felt</w> as he walked by.",
                            "target_lang_translations": {
                                "ru": "Проходя мимо, он приподнял свою старую коричневую <w>фетровую шляпу</w>.",
                                "pl": "Przechodząc obok, uchylił swój stary brązowy <w>filcowy kapelusz</w>."
                            }
                        },
                        {
                            "text": "She wore a stylish grey <w>felt</w> to the winter event.",
                            "target_lang_translations": {
                                "ru": "Она надела стильную серую <w>фетровую шляпу</w> на зимнее мероприятие.",
                                "pl": "Na zimowe wydarzenie założyła stylowy szary <w>filcowy kapelusz</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "referring to the hat simply as 'a felt' is less common in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шляпа, изготовленная из фетра.",
                        "pl": "Kapelusz wykonany z filcu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фетровая шляпа",
                                "target_lang_sense_clarification": "головной убор"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "filcowy kapelusz",
                                "target_lang_sense_clarification": "nakrycie głowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10b1df6f-8045-30ff-8e22-2aaffd4d5a4d",
                    "sense_definition": "Acronym for fast-evolving luminous transient, a specific type of supernova.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers recently observed a <w>FELT</w> in a distant galaxy.",
                            "target_lang_translations": {
                                "ru": "Астрономы недавно наблюдали <w>FELT</w> в далекой галактике.",
                                "pl": "Astronomowie zaobserwowali niedawno <w>FELT</w> w odległej galaktyce."
                            }
                        },
                        {
                            "text": "The study of <w>FELTs</w> helps scientists understand stellar explosions.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>FELT</w> помогает ученым понять звездные взрывы.",
                                "pl": "Badanie <w>FELT</w> pomaga naukowcom zrozumieć wybuchy gwiazd."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical acronym used in astronomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним для \"fast-evolving luminous transient\" (быстро эволюционирующий светящийся транзиент), специфического типа сверхновой.",
                        "pl": "Akronim dla \"fast-evolving luminous transient\" (szybko ewoluujący świetlny tranzyent), specyficzny typ supernowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "FELT",
                                "target_lang_sense_clarification": "тип астрономического явления"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "FELT",
                                "target_lang_sense_clarification": "zjawisko astronomiczne"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "014ca6bb-0ec9-36bf-aaab-56b8336b1d2d",
                    "sense_definition": "That has been experienced or perceived intensely or emotionally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please accept my deeply <w>felt</w> apologies for the mistake.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, примите мои глубокие и <w>искренние</w> извинения за ошибку.",
                                "pl": "Proszę przyjąć moje głębokie i <w>szczere</w> przeprosiny za ten błąd."
                            }
                        },
                        {
                            "text": "There is a <w>felt</w> need for better communication in the team.",
                            "target_lang_translations": {
                                "ru": "В команде существует <w>ощутимая</w> потребность в лучшей коммуникации.",
                                "pl": "W zespole istnieje <w>odczuwalna</w> potrzeba lepszej komunikacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "perceived",
                        "experienced"
                    ],
                    "common_phrases": [
                        "deeply felt",
                        "felt need"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что интенсивно переживается или воспринимается; глубокий, осознанный.",
                        "pl": "Coś, co jest intensywnie przeżywane lub postrzegane; głęboki, odczuwalny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ощутимый",
                                "target_lang_sense_clarification": "явно воспринимаемый"
                            },
                            {
                                "target_lang_word": "искренний",
                                "target_lang_sense_clarification": "глубоко переживаемый (об эмоциях)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odczuwalny",
                                "target_lang_sense_clarification": "wyraźnie zauważalny"
                            },
                            {
                                "target_lang_word": "szczery",
                                "target_lang_sense_clarification": "głęboko przeżywany (o emocjach)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7aa6462d-9ed5-34c8-9706-a167a1fbffd6",
                    "sense_definition": "To make fibers into felt by matting and pressing them together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manufacturing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>felted</w> the wool layers to create a dense fabric.",
                            "target_lang_translations": {
                                "ru": "Она <w>сваляла</w> слои шерсти, чтобы создать плотную ткань.",
                                "pl": "<w>Spiłowała</w> warstwy wełny, aby stworzyć gęstą tkaninę."
                            }
                        },
                        {
                            "text": "The artisan <w>felts</w> the material by hand using hot water.",
                            "target_lang_translations": {
                                "ru": "Ремесленник <w>валяет</w> материал вручную, используя горячую воду.",
                                "pl": "Rzemieślnik <w>filcuje</w> materiał ręcznie przy użyciu gorącej wody."
                            }
                        }
                    ],
                    "synonyms": [
                        "mat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать волокна в войлок или фетр путем сваливания и прессования.",
                        "pl": "Przekształcać włókna w filc poprzez ich spilśnianie i prasowanie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "валять",
                                "target_lang_sense_clarification": "изготавливать войлок/фетр"
                            },
                            {
                                "target_lang_word": "сваливать",
                                "target_lang_sense_clarification": "шерсть"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "filcować",
                                "target_lang_sense_clarification": "proces wytwarzania filcu"
                            },
                            {
                                "target_lang_word": "spilśniać",
                                "target_lang_sense_clarification": "techniczny proces obróbki wełny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e4ea017-306a-31d7-a5ca-6219aeb1bce9",
                    "sense_definition": "To cover an object with felt material.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manufacturing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>felted</w> the roof to make it waterproof.",
                            "target_lang_translations": {
                                "ru": "Они <w>покрыли войлоком</w> крышу, чтобы сделать ее водонепроницаемой.",
                                "pl": "<w>Obili</w> dach papą, aby uczynić go wodoodpornym."
                            }
                        },
                        {
                            "text": "The cylinder was <w>felted</w> to provide insulation.",
                            "target_lang_translations": {
                                "ru": "Цилиндр был <w>обшит войлоком</w> для обеспечения изоляции.",
                                "pl": "Cylinder został <w>obity filcem</w> w celu zapewnienia izolacji."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или обивать предмет слоем войлока или фетра.",
                        "pl": "Pokrywać przedmiot warstwą filcu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обивать войлоком",
                                "target_lang_sense_clarification": "покрывать материалом"
                            },
                            {
                                "target_lang_word": "покрывать фетром",
                                "target_lang_sense_clarification": "изолировать или декорировать"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obijać filcem",
                                "target_lang_sense_clarification": "pokrywanie materiałem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69dd8101-21f8-3485-b279-22578433ddad",
                    "sense_definition": "To cause a player to lose all their chips in a gambling game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>felted</w> after going all-in on a bad hand.",
                            "target_lang_translations": {
                                "ru": "Он <w>остался без фишек</w> после того, как пошел ва-банк с плохой картой.",
                                "pl": "Został <w>ograny do zera</w> po tym, jak wszedł za wszystko z kiepską ręką."
                            }
                        },
                        {
                            "text": "The professional player <w>felted</w> his opponent in just three rounds.",
                            "target_lang_translations": {
                                "ru": "Профессиональный игрок <w>обыграл</w> своего противника всего за три раунда.",
                                "pl": "Profesjonalny gracz <w>ograł</w> swojego przeciwnika w zaledwie trzy rundy."
                            }
                        }
                    ],
                    "synonyms": [
                        "bankrupt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used in poker contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить игрока проиграть все свои фишки в азартной игре.",
                        "pl": "Sprawić, by gracz stracił wszystkie żetony w grze hazardowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обыграть",
                                "target_lang_sense_clarification": "лишить всех фишек"
                            },
                            {
                                "target_lang_word": "оставить без фишек",
                                "target_lang_sense_clarification": "слэнг в покере"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ograć",
                                "target_lang_sense_clarification": "pozbawić wszystkich żetonów"
                            }
                        ]
                    }
                }
            ]
        },
