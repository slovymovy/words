                                        "sense_id": "06ae7039-a078-3980-a6f8-ab9993eec0f3",
                                        "entry_id": "c8878b30-9135-3172-9955-c72735d6924a",
                                        "glosses": [
                                            "A thermometer designed to measure high temperatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "917b8f85-eb7a-4699-b9f8-56030cbcc2de",
                                                "sense_id": "06ae7039-a078-3980-a6f8-ab9993eec0f3",
                                                "text": "I was working with full regulator and about 40 per cent cut-off and we were going quite hard when André called my attention to the pyrometer. This was showing a comparatively low temperature (about 250 deg C.) which meant that unless I eased up, the boiler might start to prime. So we eased her a shade, let the water come down to a third of a glass and then we were away again in perfect order with the pyrometer showing about 375 deg C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d760ce1b-1766-3fd0-a586-2dcc1a292056",
                                        "entry_id": "c8878b30-9135-3172-9955-c72735d6924a",
                                        "glosses": [
                                            "An instrument for measuring the thermal expansion of solids."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
