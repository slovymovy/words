                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56c2a349-c443-40bf-9d7e-e374c6355d1d",
                                "sense_id": "e2160f5a-7ca5-3cc1-9792-b4875d1a64ac",
                                "text": "L’apparition d’une hépatotoxicité pour des molécules récemment commercialisées, comme l’oméprazole, la fluoxétine, la terbinafine, l’acarbose et le nimésulide souligne l’importance de la pharmacovigilance."
                            },
                            {
                                "example_id": "c1ddd6bb-2b02-4bc5-bb3d-525a9bba932b",
                                "sense_id": "e2160f5a-7ca5-3cc1-9792-b4875d1a64ac",
                                "text": "Consommée à haute dose, la cannelle cassia présenterait des risques d’hépatotoxicité."
                            }
                        ]
                    }
                ],
