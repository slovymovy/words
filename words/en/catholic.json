                            },
                            {
                                "target_lang_word": "包罗万象的",
                                "target_lang_sense_clarification": "指内容极其丰富全面"
                            },
                            {
                                "target_lang_word": "兼容并蓄的",
                                "target_lang_sense_clarification": "指能够容纳各种不同事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
