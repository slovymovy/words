                                                "example_id": "dcca6662-0a12-4b51-9e73-050aec2cec2c",
                                                "sense_id": "64112416-c963-3aaf-b63e-f754190ebc21",
                                                "text": "Du betüterst die Kinder immer viel zu sehr."
                                            },
