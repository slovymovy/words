{
    "word_family": [
        "molder",
        "molding",
        "moldy",
        "moldable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed8b699f-4130-3ba7-b46f-0caa403250c7",
                    "sense_definition": "To shape a material into a particular form using a container or by hand.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist began to <w>mold</w> the wet clay into a beautiful vase.",
                            "target_lang_translations": {
                                "ru": "Художник начал <w>лепить</w> из влажной глины красивую вазу."
                            }
                        },
                        {
                            "text": "You can <w>mold</w> clay into any shape you desire.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>придать</w> глине любую форму, какую пожелаете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mold clay"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать материалу определенную форму с помощью емкости или вручную."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепить",
                                "target_lang_sense_clarification": "из мягкого материала"
                            },
                            {
                                "target_lang_word": "формовать",
                                "target_lang_sense_clarification": "придавать форму"
                            },
                            {
                                "target_lang_word": "отливать",
                                "target_lang_sense_clarification": "с помощью формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8779f12a-9076-3188-955a-abd613d97d4d",
                    "sense_definition": "To influence or guide the development of someone's character or ideas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teachers have a unique opportunity to <w>mold</w> young minds for the future.",
                            "target_lang_translations": {
                                "ru": "У учителей есть уникальная возможность <w>формировать</w> умы молодежи для будущего."
                            }
                        },
                        {
                            "text": "Early childhood experiences often <w>mold</w> the character of an adult.",
                            "target_lang_translations": {
                                "ru": "Опыт раннего детства часто <w>формирует</w> характер взрослого человека."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mold young minds",
                        "mold the character"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на развитие чьего-либо характера или идей или направлять их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формировать",
                                "target_lang_sense_clarification": "личность или взгляды"
                            },
                            {
                                "target_lang_word": "лепить",
                                "target_lang_sense_clarification": "воспитывать черты характера"
                            },
                            {
                                "target_lang_word": "закладывать",
                                "target_lang_sense_clarification": "основы характера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0743f6cf-8cc8-3e22-991f-21cdfd0ec9c2",
                    "sense_definition": "To change shape so as to fit the surface of something else closely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These leather boots will eventually <w>mold</w> to your feet after a few weeks.",
                            "target_lang_translations": {
                                "ru": "Эти кожаные ботинки со временем, через несколько недель, <w>примут форму</w> ваших ног."
                            }
                        },
                        {
                            "text": "The memory foam mattress is designed to <w>mold</w> to your body shape.",
                            "target_lang_translations": {
                                "ru": "Матрас с эффектом памяти разработан так, чтобы <w>подстраиваться</w> под форму вашего тела."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mold to your feet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять форму так, чтобы она плотно прилегала к поверхности чего-либо другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принимать форму",
                                "target_lang_sense_clarification": "подстраиваться под контуры"
                            },
                            {
                                "target_lang_word": "ложиться по фигуре",
                                "target_lang_sense_clarification": "об одежде или материале"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0e988de-694a-3d2e-b2af-bf1d32c656c4",
                    "sense_definition": "To become covered with a furry growth of fungi due to dampness or age.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you leave the bread in the damp cellar, it will quickly start to <w>mold</w>.",
                            "target_lang_translations": {
                                "ru": "Если оставить хлеб в сыром подвале, он быстро начнет <w>плесневеть</w>."
                            }
                        },
                        {
                            "text": "The old books began to <w>mold</w> in the humid library.",
                            "target_lang_translations": {
                                "ru": "Старые книги начали <w>покрываться плесенью</w> во влажной библиотеке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться пушистым налетом грибка из-за сырости или старости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плесневеть",
                                "target_lang_sense_clarification": "покрываться плесенью"
                            },
                            {
                                "target_lang_word": "заплесневеть",
                                "target_lang_sense_clarification": "окончательное действие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eeabaab8-0390-33ea-89cf-4f2a7c713063",
                    "sense_definition": "A furry growth of tiny fungi that forms on organic matter in moist conditions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fungus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to throw away the cheese because it was covered in green <w>mold</w>.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось выбросить сыр, потому что он был покрыт зеленой <w>плесенью</w>."
                            }
                        },
                        {
                            "text": "The bathroom walls were damp and showed signs of black <w>mold</w>.",
                            "target_lang_translations": {
                                "ru": "Стены в ванной были сырыми, и на них появились признаки черной <w>плесени</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "black mold",
                        "covered in mold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пушистый налет из крошечных грибков, образующийся на органических веществах во влажных условиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плесень",
                                "target_lang_sense_clarification": "грибковый налет"
                            },
                            {
                                "target_lang_word": "грибок",
                                "target_lang_sense_clarification": "в бытовом смысле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94a13c8e-aaa5-3df6-a8e3-7b982024292d",
                    "sense_definition": "A hollow container used to give shape to a liquid or soft substance as it hardens.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour the melted chocolate into the heart-shaped <w>mold</w> and let it cool.",
                            "target_lang_translations": {
                                "ru": "Налейте растопленный шоколад в <w>форму</w> в виде сердца и дайте ему остыть."
                            }
                        },
                        {
                            "text": "The jelly was set in a decorative <w>mold</w> for the party.",
                            "target_lang_translations": {
                                "ru": "Желе для вечеринки застывало в декоративной <w>форме</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "jelly mold",
                        "silicone mold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полая емкость, используемая для придания формы жидкой или мягкой субстанции при ее затвердевании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "форма",
                                "target_lang_sense_clarification": "для отливки или выпечки"
                            },
                            {
                                "target_lang_word": "формочка",
                                "target_lang_sense_clarification": "небольшая емкость"
                            },
                            {
                                "target_lang_word": "литейная форма",
                                "target_lang_sense_clarification": "промышленная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17d509bf-c626-347d-8f41-501c077b8826",
                    "sense_definition": "A distinctive style, type, or character.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new CEO is a leader in the <w>mold</w> of her successful predecessor.",
                            "target_lang_translations": {
                                "ru": "Новый генеральный директор — руководитель того же <w>типа</w>, что и ее успешный предшественник."
                            }
                        },
                        {
                            "text": "He doesn't fit the typical <w>mold</w> of a professional athlete.",
                            "target_lang_translations": {
                                "ru": "Он не вписывается в типичный <w>образ</w> профессионального спортсмена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fit the mold",
                        "in the mold of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличительный стиль, тип или характер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тип",
                                "target_lang_sense_clarification": "характерный образец"
                            },
                            {
                                "target_lang_word": "склад",
                                "target_lang_sense_clarification": "о характере или уме"
                            },
                            {
                                "target_lang_word": "образец",
                                "target_lang_sense_clarification": "модель поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a83dad5-2c27-37c9-b546-baf2b54267cb",
                    "sense_definition": "A fixed or restrictive pattern or convention.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her innovative approach to music helped her break the <w>mold</w> of pop stardom.",
                            "target_lang_translations": {
                                "ru": "Ее инновационный подход к музыке помог ей сломать <w>шаблоны</w> поп-звездности."
                            }
                        },
                        {
                            "text": "It is difficult to escape the social <w>mold</w> created by one's upbringing.",
                            "target_lang_translations": {
                                "ru": "Трудно вырваться из социальных <w>рамок</w>, созданных воспитанием."
                            }
                        }
                    ],
                    "common_phrases": [
                        "break the mold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фиксированный или ограничивающий шаблон или условность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаблон",
                                "target_lang_sense_clarification": "стереотип"
                            },
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "ограничения"
                            },
                            {
                                "target_lang_word": "стереотип",
                                "target_lang_sense_clarification": "привычный образ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d90019bd-c4af-3977-a77b-c2e8c93f8a07",
                    "sense_definition": "Loose, dark soil that is rich in organic matter and good for plants.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "earth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener mixed some leaf <w>mold</w> into the flower beds to improve the soil.",
                            "target_lang_translations": {
                                "ru": "Садовник подмешал немного листового <w>перегноя</w> в клумбы, чтобы улучшить почву."
                            }
                        },
                        {
                            "text": "The forest floor was covered in a thick layer of rich <w>mold</w>.",
                            "target_lang_translations": {
                                "ru": "Лесная подстилка была покрыта толстым слоем богатого <w>гумуса</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leaf mold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыхлая темная почва, богатая органическими веществами и полезная для растений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегной",
                                "target_lang_sense_clarification": "органическое удобрение"
                            },
                            {
                                "target_lang_word": "гумус",
                                "target_lang_sense_clarification": "плодородный слой"
                            },
                            {
                                "target_lang_word": "листовая земля",
                                "target_lang_sense_clarification": "из прелых листьев"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "70d31d97-5676-323e-b2e4-ddcaea68533a",
                    "sense_definition": "A town in Flintshire, Wales.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The historic market town of <w>Mold</w> is located in North Wales.",
                            "target_lang_translations": {
                                "ru": "Исторический рыночный город <w>Молд</w> расположен в Северном Уэльсе."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в Флинтшире, Уэльс."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Молд",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4936f6c-9d87-3022-8c04-9607d156ec1c",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor's last name was <w>Mold</w>.",
                            "target_lang_translations": {
                                "ru": "Фамилия профессора была <w>Молд</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Молд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}