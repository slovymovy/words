{
    "word_family": [
        "deuken",
        "indeuken",
        "uitdeuken"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "598db531-06f6-3d1c-b990-f989a35c8b82",
                    "sense_definition": "Een ongewenste vervorming of uitholling in een oppervlak, meestal veroorzaakt door een botsing of stoot.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_beschadiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een lelijke <w>deuk</w> in de deur van mijn nieuwe auto.",
                            "target_lang_translations": {
                                "en": "There is an ugly <w>dent</w> in the door of my new car."
                            }
                        },
                        {
                            "text": "Dat auto-ongeluk veroorzaakte gelukkig alleen een paar kleine <w>deukjes</w>.",
                            "target_lang_translations": {
                                "en": "Fortunately, that car accident only caused a few small <w>dents</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bluts"
                    ],
                    "common_phrases": [
                        "een deuk in de auto"
                    ],
                    "target_lang_definitions": {
                        "en": "An unwanted deformation or hollow in a surface, usually caused by a collision or impact."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dent",
                                "target_lang_sense_clarification": "a hollow in a surface"
                            },
                            {
                                "target_lang_word": "ding",
                                "target_lang_sense_clarification": "a small dent or damage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf351e45-be9a-36cc-b7dc-b93c948d59c2",
                    "sense_definition": "Psychologische schade of een vermindering van iemands zelfvertrouwen of reputatie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijke_schade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door die pijnlijke nederlaag liep zijn grote ego een flinke <w>deuk</w> op.",
                            "target_lang_translations": {
                                "en": "Because of that painful defeat, his big ego suffered a major <w>blow</w>."
                            }
                        },
                        {
                            "text": "Dit zware weer had voor een flinke <w>deuk</w> in mijn zelfvertrouwen gezorgd.",
                            "target_lang_translations": {
                                "en": "This severe weather had put a major <w>dent</w> in my self-confidence."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een deuk oplopen",
                        "deuk in het zelfvertrouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "Psychological damage or a reduction in someone's self-confidence or reputation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dent",
                                "target_lang_sense_clarification": "a reduction or blow to confidence or reputation"
                            },
                            {
                                "target_lang_word": "blow",
                                "target_lang_sense_clarification": "a setback or shock to one's ego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc2fc31c-232d-39e5-acbe-6904a9bd8156",
                    "sense_definition": "Een onbeheersbare lachbui; de slappe lach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen ik die grappige video zag, lag ik helemaal in een <w>deuk</w>.",
                            "target_lang_translations": {
                                "en": "When I saw that funny video, I was completely in <w>stitches</w>."
                            }
                        },
                        {
                            "text": "We lagen gisteravond constant in een <w>deuk</w> om zijn grappen.",
                            "target_lang_translations": {
                                "en": "We were constantly in <w>stitches</w> last night over his jokes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in een deuk liggen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in informal spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An uncontrollable fit of laughter; the giggles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stitches",
                                "target_lang_sense_clarification": "laughing uncontrollably (in stitches)"
                            },
                            {
                                "target_lang_word": "crack up",
                                "target_lang_sense_clarification": "to burst out laughing"
                            }
                        ]
                    }
                }
            ]
        },
        {
