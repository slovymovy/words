                        "examples": [
                            {
                                "example_id": "6050a986-b7bc-4c2a-b4c4-af2fae55535b",
                                "sense_id": "13c20381-cdcb-3c90-b724-296299725818",
                                "text": "Maanden van volksprotest zijn aan Keïta’s gedwongen aftreden voorafgegaan, net als bij de staatsgreep in 1991."
                            },
                            {
                                "example_id": "e71e2928-5450-474b-b033-0e6c0fb194bd",
                                "sense_id": "13c20381-cdcb-3c90-b724-296299725818",
                                "text": "Binnen worden we voorafgegaan naar de bar, nog helemaal leeg, net als trouwens het grootste deel van het restaurant."
                            },
                            {
                                "example_id": "44e4d793-ab00-401e-a6f7-1c3aa1ba3052",
                                "sense_id": "13c20381-cdcb-3c90-b724-296299725818",
                                "text": "Bij X. ging het dus om de vraag of tbs ‘met voorwaarden’ voorafgegaan door celstraf voldoende beveiliging, preventie en vergelding zou bieden."
                            }
                        ]
                    }
