        "nl-extract.jsonl": [
            {
                "entry_id": "006d9098-c365-33e6-898f-c792dbaeade7",
                "word": "verzengend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5dbe2ecd-59f3-39b7-a931-7ff308c31970",
                        "entry_id": "006d9098-c365-33e6-898f-c792dbaeade7",
                        "glosses": [
                            "te heet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c08a708f-0145-4098-9ce8-a13bd26d9180",
                                "sense_id": "5dbe2ecd-59f3-39b7-a931-7ff308c31970",
                                "text": "Meer dan anderhalf uur stond hij in de verzengende hitte op het veld, net zo lang als zijn nieuwe ploeggenoten."
                            },
                            {
                                "example_id": "58bacda8-cc1d-438a-8ba9-890fdaa95c94",
                                "sense_id": "5dbe2ecd-59f3-39b7-a931-7ff308c31970",
                                "text": "Maar de oefenmeester is nu om: vanwege de verzengende hitte voert hij de komende dagen alsnog een verandering door."
                            },
                            {
                                "example_id": "1d805ff9-dbfb-447e-a6e9-eafa811099a5",
                                "sense_id": "5dbe2ecd-59f3-39b7-a931-7ff308c31970",
                                "text": "Bassie en Adriaan deden het ooit in de verzengende hitte van Death Valley in Amerika. Nu het kwik in Twente ook bijna de 40 graden aantikt, proberen wij het ook: kun je een eitje bakken op de auto?"
                            },
                            {
                                "example_id": "cca52a13-3129-4ccf-ac1e-8164faf373ab",
                                "sense_id": "5dbe2ecd-59f3-39b7-a931-7ff308c31970",
                                "text": "In Nederland is het warm, maar in Frankrijk en Spanje is het warmer, warmst. De hittegolven slaan toe in Zuid-Europa en toeristen puffen en zweten erop los. Hoe wapen je je onderweg naar je vakantiebestemming tegen de verzengende hitte? En hoe zorg je ervoor dat je koel blijft op de camping? NU.nl vroeg het enkele deskundigen."
                            }
                        ]
                    }
                ],
