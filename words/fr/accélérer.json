            "senses": [
                {
                    "sense_id": "90532104-0527-309d-810b-c0a067d63735",
                    "sense_definition": "Augmenter sa vitesse de déplacement, aller plus vite.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur décide d'<w>accélérer</w> sur l'autoroute pour doubler le camion."
                        },
                        {
                            "text": "Quand elle a vu le bus arriver, elle a <w>accéléré</w> pour ne pas le rater."
                        }
                    ],
                    "synonyms": [
                        "prendre de la vitesse"
                    ],
                    "antonyms": [
                        "décélérer",
                        "freiner",
                        "ralentir"
                    ],
                    "common_phrases": [
                        "accélérer pour doubler",
                        "accélérer dans la ligne droite"
                    ]
                },
                {
                    "sense_id": "6e6ef702-7a39-387b-b85b-91a1443e101f",
                    "sense_definition": "Rendre quelque chose plus rapide, en hâter l'exécution ou le déroulement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous devons <w>accélérer</w> le pas si nous voulons arriver avant la fermeture du magasin."
                        },
                        {
                            "text": "Le directeur souhaite <w>accélérer</w> la cadence des travaux pour respecter les délais fixés."
                        }
                    ],
                    "antonyms": [
                        "freiner",
                        "ralentir"
                    ],
                    "common_phrases": [
                        "accélérer le pas",
                        "accélérer la cadence",
                        "accélérer le rythme"
                    ]
                },
                {
                    "sense_id": "381e0822-028a-315e-8c72-2773fc284d70",
                    "sense_definition": "Devenir plus rapide ou plus fréquent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cet effort intense, les battements de son cœur s'<w>accélèrent</w> nettement."
                        },
                        {
                            "text": "Avec l'approche de la date limite, les réunions de travail s'<w>accélèrent</w> cette semaine."
                        }
                    ],
                    "antonyms": [
                        "décélérer",
                        "ralentir"
                    ],
                    "common_phrases": [
                        "rythme qui s'accélère"
                    ]
                },
                {
                    "sense_id": "f547d43b-0f1f-3553-a97a-908c9ef2377d",
                    "sense_definition": "Donner une nouvelle impulsion à un projet ou à une situation, relancer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "developpement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle aide financière va <w>accélérer</w> la transition écologique dans toute la région."
                        },
                        {
                            "text": "L'entreprise met en place une stratégie innovante pour <w>accélérer</w> son développement international."
                        }
                    ],
                    "antonyms": [
                        "freiner",
                        "ralentir"
                    ],
                    "common_phrases": [
                        "accélérer la transition",
                        "accélérer le développement"
                    ]
                }
            ]
        }
    ]
