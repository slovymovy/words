                {
                    "sense_id": "0e8e3aa8-f6c4-3b7d-8847-216cbed5fc68",
                    "sense_definition": "The swim bladder of a fish, used as food in some cuisines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared the dried fish <w>maw</w> for the soup.",
