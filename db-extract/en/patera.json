                            {
                                "example_id": "2022e3b1-d318-4f75-b44b-4bcc0e21243f",
                                "sense_id": "60c30774-649c-3bb5-a140-58d47451378a",
                                "text": "That day, the migrants were on a small boat, a patera, full of people."
                            },
                            {
                                "example_id": "70c62b94-65c4-42e4-8361-89a31998430a",
                                "sense_id": "60c30774-649c-3bb5-a140-58d47451378a",
                                "text": "“We calculated how much the children would earn tending goats and we gave the families more,” Mr Quiros said. “If you are in the field herding goats all day, all you think about is fleeing in a patera.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f55dd74-afd9-313b-bb84-8efd28250008",
                        "entry_id": "5061688a-ff70-3485-8b5e-00f13ba1d830",
                        "glosses": [
                            "patera, patère"
                        ],
                        "tags": [],
                        "examples": [
