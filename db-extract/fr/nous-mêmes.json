                "forms": [
                    {
                        "form_id": "03e7f71d-b514-4d03-8535-7892db8f1090",
                        "entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "tags": [],
                        "form": "nous-même"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4be830c-7445-3bbd-8c1b-9f025b6adb4d",
                        "entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "glosses": [
                            "Nous comme le sujet naturellement ou directement responsable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e65b2d-4cd9-4498-8b4a-bca993c45543",
                                "sense_id": "e4be830c-7445-3bbd-8c1b-9f025b6adb4d",
                                "text": "Euphrasie. Je conçois parfaitement... en votre qualité d'avocat de M. le comte, vous cherchez à m'effrayer... vous voudriez que nous nous privassions nous-mêmes de l'appui d'une personne qui nous est dévouée."
                            },
                            {
                                "example_id": "debdf556-8faf-410c-b290-80782ca930f3",
                                "sense_id": "e4be830c-7445-3bbd-8c1b-9f025b6adb4d",
                                "text": "Nous le faisons nous-mêmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4c387fb-7f65-3f49-a8dc-dfcae68c8cfd",
                        "entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "glosses": [
                            "Nous comme l’objet, et aussi comme soit le sujet, le possesseur ou le créateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c8c09f-c337-4e0a-972f-5743173eebf7",
                                "sense_id": "d4c387fb-7f65-3f49-a8dc-dfcae68c8cfd",
                                "text": "Nous avons conscience – et ce n’est pas anormal – d’avoir du mal à nous accepter nous-mêmes dans la dualité de notre corps et de notre âme. Nous percevons cette désunité comme un drame et nous nous en accusons nous-mêmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e865664-496c-4e7e-ba3a-cd64601659c8",
                        "source_entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "target_lang_word": "wir selbst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4dbeea4e-95be-4e96-8655-c069bac4fd19",
                        "source_entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "target_lang_word": "wir selber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d0a513a7-53a3-4580-bf5a-2ab9e2cb507c",
                        "source_entry_id": "5b82b32e-e041-359c-bead-cd2f5b820f3d",
                        "target_lang_word": "ourselves",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ourselves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f9e37c-38cd-309c-856c-59dea56cc602",
                                        "entry_id": "1d7b99cc-47be-3fb9-8f3d-47232bffacfe",
                                        "glosses": [
                                            "Us; the group including the speaker as the object of a verb or preposition when that group also is the subject."
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4a86ac-c314-4569-8564-0efbe2cadf9d",
                                                "sense_id": "32f9e37c-38cd-309c-856c-59dea56cc602",
                                                "text": "We should keep this for ourselves."
                                            },
                                            {
                                                "example_id": "30e6a069-bc13-44ae-9b9f-7cd446d514b5",
                                                "sense_id": "32f9e37c-38cd-309c-856c-59dea56cc602",
                                                "text": "Let's not beat ourselves up over this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf46140-f527-3eec-b80d-4627a0a570c0",
                                        "entry_id": "1d7b99cc-47be-3fb9-8f3d-47232bffacfe",
                                        "glosses": [
                                            "Intensifies the subject as the group including the speaker, especially to indicate that no one else satisfies the predicate or needs to be included."
                                        ],
                                        "tags": [
                                            "emphatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf20174f-6dfa-4b91-b39e-6a0da747e64e",
                                                "sense_id": "5cf46140-f527-3eec-b80d-4627a0a570c0",
                                                "text": "We did it ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0a64fc3-667a-3c90-a304-60693a771cf8",
                                        "entry_id": "1d7b99cc-47be-3fb9-8f3d-47232bffacfe",
                                        "glosses": [
                                            "Referring to everyone being addressed."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ac54f06-daca-4a12-9a01-bc8b5164c4be",
                                                "sense_id": "f0a64fc3-667a-3c90-a304-60693a771cf8",
                                                "text": "Come on everyone! Let's get ourselves up and out of bed, please."
                                            },
                                            {
                                                "example_id": "58cef3ba-12d5-428a-a928-326f7644e919",
                                                "sense_id": "f0a64fc3-667a-3c90-a304-60693a771cf8",
                                                "text": "Now then children, I'm not going to help you with the next problem. We should be able to work this one out ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0df1147-9368-3942-9837-e79bb060ac0d",
                                        "entry_id": "1d7b99cc-47be-3fb9-8f3d-47232bffacfe",
                                        "glosses": [
                                            "Referring to an individual person being addressed, especially a person in the speaker's care; also ourself."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93f01c81-cccc-41b3-a063-9158f7985957",
                                                "sense_id": "b0df1147-9368-3942-9837-e79bb060ac0d",
                                                "text": "Coordinate term: nurse's we"
                                            },
                                            {
                                                "example_id": "1f583f69-d516-4906-8ff4-986d87bf4d7b",
                                                "sense_id": "b0df1147-9368-3942-9837-e79bb060ac0d",
                                                "text": "Hello Mrs Miggins. Did we manage to wash ourselves this morning?"
                                            },
                                            {
                                                "example_id": "b839eab3-f554-4039-81ca-41b77cb2f8f5",
                                                "sense_id": "b0df1147-9368-3942-9837-e79bb060ac0d",
                                                "text": "Well done Timmy! Did we make that model ourselves?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
