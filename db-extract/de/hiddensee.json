                ],
                "senses": [
                    {
                        "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                        "entry_id": "ae121d53-24b9-3f66-a499-b6c16f5b8b1b",
                        "glosses": [
                            "deutsche Ostseeinsel westlich von Rügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfce6383-eea3-4814-949f-3712396d5d5f",
                                "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                                "text": "Unseren letzten Urlaub verbrachten wir auf Hiddensee."
                            },
                            {
                                "example_id": "b1f90f1d-672d-4539-a981-61113ecfc453",
                                "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                                "text": "Hiddensee liegt in der Ostsee."
                            },
                            {
                                "example_id": "4a800ed4-c8af-444a-a01b-dddbec192d56",
                                "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                                "text": "Das Lagerfeuer auf Hiddensee erlosch erst am frühen Morgen."
                            },
                            {
                                "example_id": "984a3046-097d-46f0-9d4d-99a2c9deb609",
                                "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                                "text": "„Darß und Zingst sind Brutheimat des Seeadlers; zahlreiche See- und Küstenvögel brüten auf den Inseln Oie und Kirr, auf den Bülten, den Wiesen und großen Vogelschutzgebieten Hiddensees.“"
                            },
                            {
                                "example_id": "8fb2e91b-396b-47bc-8f9e-b962f4ff6ef3",
                                "sense_id": "cf3b4dc5-81aa-3caf-a055-8003ef11a4ad",
                                "text": "„Wäre es am Abend vorher bei Hiddensee nicht zu einer Verspätung gekommen, hätte er jetzt bereits Ystadt in Sichtweite gehabt und den Kurs ein paar Grad in östliche Richtung drehen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
