                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He claims he won the lottery, but I say, <w>bender</w>!",
                            "target_lang_translations": {
                                "it": "Sostiene di aver vinto alla lotteria, ma io dico: <w>balle</w>!"
