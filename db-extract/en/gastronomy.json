                    {
                        "translation_id": "374836ef-05b9-4c94-b548-3fb3e9a94fcc",
                        "source_entry_id": "2888bae9-9639-37f0-b4fd-574bd8a83556",
                        "source_sense_description": "study of the relationship between food and culture",
