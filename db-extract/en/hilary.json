                                            {
                                                "example_id": "f4ffb9d7-3b09-4dbb-a8b8-d3b555e2830a",
                                                "sense_id": "91e4b171-af87-3098-8581-fdfbe3a89de6",
                                                "text": "Mój dziadek ze strony ojca ma na imię Hilary."
                                            },
                                            {
                                                "example_id": "eef33ac9-760e-4312-9d7f-fe0ca22790fd",
                                                "sense_id": "91e4b171-af87-3098-8581-fdfbe3a89de6",
                                                "text": "Biega, krzyczy pan Hilary: „Gdzie są moje okulary?”"
                                            },
                                            {
                                                "example_id": "fbeb6157-979e-41db-8c6f-8374fbfe3285",
                                                "sense_id": "91e4b171-af87-3098-8581-fdfbe3a89de6",
                                                "text": "W Kościele katolickim na 13 stycznia przypada wspomnienie św. Hilarego z Poitiers, biskupa i doktora Kościoła, zaś na 28 lutego – św. Hilarego, papieża i wielkiego czciciela Jana Ewangelisty."
                                            },
                                            {
                                                "example_id": "1fe10c45-c99b-4a13-a9be-852e9f7dad11",
                                                "sense_id": "91e4b171-af87-3098-8581-fdfbe3a89de6",
                                                "text": "Hilarowie dzień swego patrona, czyli imieniny, obchodzą 13 stycznia, a także 14 stycznia, 28 lutego, 16 marca i 5 maja."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
