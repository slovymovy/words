{
    "word_family": [
        "joviality",
        "jovially"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                    "sense_definition": "Cheerful and good-humoured; jolly and full of high spirits.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cheerful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host welcomed everyone with a <w>jovial</w> smile and offered them drinks.",
                            "target_lang_translations": {
                                "ru": "Хозяин встретил всех <w>радушной</w> улыбкой и предложил напитки."
                            }
                        },
                        {
                            "text": "A sudden burst of <w>jovial</w> laughter broke the awkward silence in the meeting room.",
                            "target_lang_translations": {
                                "ru": "Внезапный взрыв <w>весёлого</w> смеха нарушил неловкую тишину в переговорной."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "convivial",
                        "hearty",
                        "merry"
                    ],
                    "antonyms": [
                        "saturnine"
                    ],
                    "common_phrases": [
                        "jovial mood",
                        "jovial laugh",
                        "jovial host"
                    ],
                    "target_lang_definitions": {
                        "ru": "Весёлый, добродушный, жизнерадостный и общительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весёлый",
                                "target_lang_sense_clarification": "жизнерадостный, пребывающий в хорошем настроении"
                            },
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "полный оптимизма и бодрости"
                            },
                            {
                                "target_lang_word": "добродушно-весёлый",
                                "target_lang_sense_clarification": "приветливый и смешливый"
                            },
                            {
                                "target_lang_word": "жовиальный",
                                "target_lang_sense_clarification": "книжное обозначение бодрого, жизнелюбивого человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007bf4f0-d10c-3e90-b00c-87f835c788d4",
                    "sense_definition": "Pertaining to the astrological influence of the planet Jupiter, believed to produce a happy or benevolent disposition.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astrological",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient astrologer claimed that a <w>jovial</w> influence would bring good fortune to the native.",
                            "target_lang_translations": {
                                "ru": "Древний астролог утверждал, что <w>юпитерианское</w> влияние принесёт человеку удачу."
                            }
                        },
                        {
                            "text": "In traditional horoscopes, <w>jovial</w> aspects were considered among the most favorable omens.",
                            "target_lang_translations": {
                                "ru": "В традиционных гороскопах аспекты <w>Юпитера</w> считались одними из самых благоприятных предзнаменований."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used chiefly in historical astrology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с астрологическим влиянием планеты Юпитер, сулящим счастье или благосклонный нрав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юпитерианский",
                                "target_lang_sense_clarification": "в астрологии: связанный с влиянием Юпитера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab04247e-be86-3788-9859-79c156703cb1",
                    "sense_definition": "Pertaining to the planet Jupiter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jupiter_planet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early astronomers documented several <w>jovial</w> phenomena observed through primitive telescopes.",
                            "target_lang_translations": {
                                "ru": "Ранние астрономы задокументировали несколько <w>юпитерианских</w> явлений, наблюдавшихся через примитивные телескопы."
                            }
                        },
                        {
                            "text": "The scientist tracked the motion of the <w>jovial</w> satellites over many weeks.",
                            "target_lang_translations": {
                                "ru": "Учёный на протяжении многих недель отслеживал движение спутников <w>Юпитера</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly Jovian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к планете Юпитер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юпитерианский",
                                "target_lang_sense_clarification": "относящийся к планете Юпитер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c463740-19a0-3fb2-8e98-83259db1ef97",
                    "sense_definition": "Pertaining to the Roman god Jove or Jupiter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jove_myth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The statue displayed the proud and <w>jovial</w> countenance of the sky god.",
                            "target_lang_translations": {
                                "ru": "Статуя запечатлела гордый и <w>величественный</w> лик бога неба."
                            }
                        },
                        {
                            "text": "Poets often invoked the thunderous power of the <w>jovial</w> deity during battles.",
                            "target_lang_translations": {
                                "ru": "Поэты часто взывали к громоподобной мощи <w>Юпитера</w> во время битв."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Chiefly literary or classical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к римскому богу Юпитеру (Юпитеру/Юпитеру-Громовержцу)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юпитеров",
                                "target_lang_sense_clarification": "принадлежащий богу Юпитеру"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b34c01c0-51f2-3563-bcda-91fd75887986",
                    "sense_definition": "An inhabitant of the planet Jupiter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "Old science fiction stories frequently imagined encounters between humans and a giant <w>jovial</w>.",
                            "target_lang_translations": {
                                "ru": "В старой научной фантастике часто описывались встречи людей с гигантским <w>юпитерианином</w>."
                            }
                        },
                        {
                            "text": "The novel depicted the strange atmosphere where a native <w>jovial</w> might survive.",
                            "target_lang_translations": {
                                "ru": "В романе была описана странная атмосфера, в которой мог бы выжить коренной <w>житель Юпитера</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in early science fiction; more commonly Jovian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Житель или обитатель планеты Юпитер (в фантастике)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "юпитерианин",
                                "target_lang_sense_clarification": "гипотетический житель Юпитера"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}