                    {
                        "translation_id": "a05fd66d-0e8c-4bea-aee2-a02addc0ef61",
                        "source_entry_id": "b81a1ae9-1a96-32e5-91c3-f9abc0d76adf",
                        "source_sense_id": "ae50dcaa-734a-350b-b693-aba3fd360b17",
                        "target_lang_word": "aggravation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggravation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b6b2c6c-77ff-33d2-88f5-e24e2a1a94f2",
                                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                                        "glosses": [
                                            "The act of aggravating, or making worse; used of evils, natural or moral; the act of increasing in severity or heinousness; something additional to a crime or wrong and enhancing its guilt or injurious consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3ec346d-30a3-4980-82f1-75db9b0c4f9e",
                                                "sense_id": "7b6b2c6c-77ff-33d2-88f5-e24e2a1a94f2",
                                                "text": "Adrian, whose health had always been weak, now suffered considerable aggravation of suffering from the effects of his wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b0e7721-eaad-395f-89d5-3d76584dd2d4",
                                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                                        "glosses": [
                                            "Exaggerated representation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a534918a-b52e-32d7-b571-a66b4693e8d1",
                                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                                        "glosses": [
                                            "An extrinsic circumstance or accident which increases the guilt of a crime or the misery of a calamity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00855844-13d4-3913-b0bb-0f82e61ce9de",
                                        "entry_id": "edc6ee02-7ac3-3bd6-940f-ef6b42b3a7b6",
                                        "glosses": [
                                            "Provocation, irritation, annoyance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63551626-5b10-40fe-98a6-5641c5ebf29b",
                                                "sense_id": "00855844-13d4-3913-b0bb-0f82e61ce9de",
                                                "text": "A little less conversation, a little more action please / All this aggravation ain't satisfactioning me"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaf2da03-04d9-4541-b4cb-474e5deb4b2c",
                        "source_entry_id": "b81a1ae9-1a96-32e5-91c3-f9abc0d76adf",
                        "source_sense_id": "ae50dcaa-734a-350b-b693-aba3fd360b17",
                        "target_lang_word": "aggravation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggravation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                                        "glosses": [
                                            "Action d’aggraver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0a0462-507e-461c-85a9-3228b6a201d3",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "Aggravation de peine. Ce qu’on ajoute à une condamnation, à un châtiment."
                                            },
                                            {
                                                "example_id": "f11c8891-9b2c-4380-a8bb-266a19dac42a",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "— En vérité, ce serait peut-être un bonheur pour moi, répondait Lucien ; ou, pour parler avec l’exactitude mathématique que nous aimons, rien ne peut être pour moi aggravation de peine ; je crois, sans trop présumer, être parvenu au comble de l’ennui."
                                            },
                                            {
                                                "example_id": "37310b61-e222-4463-a7e8-408d6b56de32",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": ". L’aggravation du mal."
                                            },
                                            {
                                                "example_id": "7b35d838-33a7-4f0d-803e-52bb74e3df76",
                                                "sense_id": "6586fe5a-57c4-3104-8822-fc64e90bfbb7",
                                                "text": "Sur vingt schizophrènes, on comptabilisa dix améliorations dont quatre sorties et dix échecs dont une aggravation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727f7af5-20dd-39e3-ad03-052a6a5bffb0",
                                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                                        "glosses": [
                                            "Dommage corporel supplémentaire survenu depuis la consolidation. Imputable au fait générateur du dommage et témoignant de l’évolution des séquelles traumatiques temporaires ou définitifs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af3c5124-3942-3aa1-a68e-9c1cab911bf7",
                                        "entry_id": "a538ce66-da43-379a-a855-ac5bac30a317",
                                        "glosses": [
                                            "Seconde fulmination solennelle d’un monitoire."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bec900d2-4234-4da7-8aa8-0be3a395d344",
                        "source_entry_id": "b81a1ae9-1a96-32e5-91c3-f9abc0d76adf",
                        "source_sense_id": "ae50dcaa-734a-350b-b693-aba3fd360b17",
                        "target_lang_word": "dégradation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégradation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Destitution, privation infamante du grade, de la dignité que l’on a."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abb27cf6-2540-4ea2-a5d5-6c3132b61186",
                                                "sense_id": "9d9f6a50-ba3a-3b96-b7c9-bc26b6353e09",
                                                "text": "Je ne veux pas encourir la sentence de la dégradation, ni même perdre mon office pour l’amour d’une poupée juive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Avilissement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7eb989d-d02c-4715-bae8-0affb6c5dfca",
                                                "sense_id": "fb30e469-fa49-385d-9c84-3a008fbfc29d",
                                                "text": "La dégradation des âmes est une suite de la servitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dégât, détérioration plus ou moins considérable qu’on fait dans une propriété publique ou privée, dans une maison, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aad5447-ffd5-4d24-ad9e-0d0ef9ad8b67",
                                                "sense_id": "c8beeb7e-cb20-3746-b7f1-7bf9701bb3d4",
                                                "text": "Il fit faire un procès-verbal des dégradations qui avaient été commises dans son domaine. - Le locataire de cet appartement y a fait beaucoup de dégradations. - La dégradation des monuments publics est punie par la loi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Dépérissement où est une chose, dommage qu’elle a éprouvé par l’effet de la vétusté ou d'un accident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29995ef-778f-48a5-9e8f-556274915bb1",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Parmi les facteurs locaux, nous citerons d'abord la dégradation des pâturages causée par les abus de la transhumance, d'immenses troupeaux ayant été amenés des pays du Sud por y trouver, pendant l'été, leur pâture."
                                            },
                                            {
                                                "example_id": "9a90541d-8d9e-4fed-ae08-f9bed7c2c0f4",
                                                "sense_id": "2a5d43f9-a7c4-3c5a-914d-bdaab90a026e",
                                                "text": "Les relations entre écoulement et surface des bassins dépendent largement de l'état de dégradation des réseaux hydrographiques et des endoréismes locaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                        "entry_id": "3e687fa2-f991-327a-a6af-bd01075d41c8",
                                        "glosses": [
                                            "Affaiblissement graduel de la lumière, des ombres, des couleurs dans un dégradé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63cf3378-488c-4628-9a42-e6b9b3bae09f",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "Elle portait à la main une petite lampe de la forme de celles qu’on met dans les tombeaux, dont la lueur donnait à ses doigts effilés une transparence rose qui se prolongeait par une dégradation insensible jusque dans la blancheur opaque et laiteuse de son bras nu."
                                            },
                                            {
                                                "example_id": "c5dc8adf-f190-4ac5-bc4c-98dcf67c9300",
                                                "sense_id": "bd0af06c-9c08-3a65-887b-685844b47491",
                                                "text": "En ce moment de la journée, les lentes dégradations de la lumière semblent réveiller les sentiments doux ; …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
