    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "48b74561-9749-3e8a-9941-32c375ce82c1",
                    "sense_definition": "Used to say that something usually happens in a certain way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum is <w>typically</w> closed on Mondays for maintenance.",
                            "target_lang_translations": {
                                "ru": "Музей <w>обычно</w> закрыт по понедельникам на техническое обслуживание.",
                                "tr": "Müze bakım nedeniyle <w>genellikle</w> pazartesi günleri kapalıdır."
                            }
                        },
                        {
                            "text": "These meetings <w>typically</w> last for about an hour.",
                            "target_lang_translations": {
                                "ru": "Эти встречи <w>как правило</w> длятся около часа.",
                                "tr": "Bu toplantılar <w>genellikle</w> yaklaşık bir saat sürer."
                            }
                        }
                    ],
                    "synonyms": [
                        "usually",
                        "normally",
                        "commonly",
                        "most of the time",
                        "routinely",
                        "generally"
                    ],
                    "antonyms": [
                        "atypically"
                    ],
                    "common_phrases": [
                        "typically include",
                        "typically involve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется, чтобы сказать, что что-то обычно происходит определенным образом.",
                        "tr": "Bir şeyin genellikle belirli bir şekilde gerçekleştiğini belirtmek için kullanılır."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обычно",
                                "target_lang_sense_clarification": "в большинстве случаев"
                            },
                            {
                                "target_lang_word": "как правило",
                                "target_lang_sense_clarification": "в большинстве случаев"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "genellikle",
                                "target_lang_sense_clarification": "çoğu zaman, normalde"
                            },
                            {
                                "target_lang_word": "genel olarak",
                                "target_lang_sense_clarification": "çoğunlukla"
                            },
                            {
                                "target_lang_word": "kural olarak",
                                "target_lang_sense_clarification": "genellikle olan durum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac8294e-e18a-3565-ba2a-ccf66de6e46c",
                    "sense_definition": "In a way that shows the usual qualities or features of a particular person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He answered the difficult question with a <w>typically</w> witty remark.",
                            "target_lang_translations": {
                                "ru": "Он ответил на сложный вопрос <w>типично</w> остроумным замечанием.",
                                "tr": "Zor soruya <w>tipik bir şekilde</w> esprili bir yorumla cevap verdi."
                            }
                        },
                        {
                            "text": "The weather was <w>typically</w> unpredictable for this time of year.",
                            "target_lang_translations": {
                                "ru": "Погода была <w>типично</w> непредсказуемой для этого времени года.",
                                "tr": "Hava, yılın bu zamanı için <w>tipik bir şekilde</w> tahmin edilemezdi."
                            }
                        }
                    ],
                    "antonyms": [
                        "atypically"
                    ],
                    "common_phrases": [
                        "typically American",
                        "typically English"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, который демонстрирует обычные качества или черты конкретного человека или вещи.",
                        "tr": "Belirli bir kişinin veya şeyin alışılagelmiş özelliklerini veya niteliklerini gösteren bir şekilde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "типично",
                                "target_lang_sense_clarification": "характерно для кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "характерно",
                                "target_lang_sense_clarification": "свойственно кому-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tipik olarak",
                                "target_lang_sense_clarification": "kendine özgü bir biçimde"
                            },
                            {
                                "target_lang_word": "tam da ...-e özgü bir şekilde",
                                "target_lang_sense_clarification": "karakteristik olarak"
                            }
                        ]
                    }
                }
            ]
        }
