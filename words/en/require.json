{
    "word_family": [
        "requirement",
        "requisite",
        "prerequisite",
        "requisition"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15f7cf85-62ab-308e-84e1-549b1d2b8fa8",
                    "sense_definition": "To need something because it is necessary or indispensable for a particular purpose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "necessity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plants <w>require</w> adequate sunlight and water to grow healthy and strong.",
                            "target_lang_translations": {
                                "ru": "Растениям <w>требуется</w> достаточное количество солнечного света и воды, чтобы расти здоровыми и крепкими."
                            }
                        },
                        {
                            "text": "This complex project will <w>require</w> more time than we originally planned.",
                            "target_lang_translations": {
                                "ru": "Этот сложный проект <w>потребует</w> больше времени, чем мы планировали изначально."
                            }
                        }
                    ],
                    "synonyms": [
                        "call for"
                    ],
                    "common_phrases": [
                        "require more time",
                        "require assistance",
                        "require attention"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нуждаться в чем-либо, так как это необходимо или обязательно для определенной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "вызывать необходимость в чем-либо"
                            },
                            {
                                "target_lang_word": "нуждаться",
                                "target_lang_sense_clarification": "иметь потребность в чем-либо"
                            },
                            {
                                "target_lang_word": "потребоваться",
                                "target_lang_sense_clarification": "стать необходимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d1888a-8110-30b7-b883-f0bab2dbe55f",
                    "sense_definition": "To officially demand that someone do something because of a rule or law.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law will <w>require</w> all citizens to carry identification at all times.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>обяжет</w> всех граждан всегда иметь при себе удостоверение личности."
                            }
                        },
                        {
                            "text": "Most universities <w>require</w> students to complete a thesis before they can graduate.",
                            "target_lang_translations": {
                                "ru": "Большинство университетов <w>требуют</w> от студентов написания дипломной работы для получения диплома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "require by law",
                        "require to wear",
                        "require to sit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально требовать выполнения чего-либо в соответствии с правилом или законом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "согласно правилам или закону"
                            },
                            {
                                "target_lang_word": "обязывать",
                                "target_lang_sense_clarification": "налагать официальное обязательство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8d0b4e6-453f-31f7-a0ce-820fad6896ba",
                    "sense_definition": "To demand or insist upon having something in an authoritative way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>requires</w> a high standard of service from every employee.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>требует</w> высокого уровня обслуживания от каждого сотрудника."
                            }
                        },
                        {
                            "text": "I <w>require</w> to be shown to my room immediately as I am very tired.",
                            "target_lang_translations": {
                                "ru": "Я <w>требую</w>, чтобы меня немедленно проводили в мой номер, так как я очень устал."
                            }
                        }
                    ],
                    "synonyms": [
                        "exact"
                    ],
                    "antonyms": [
                        "provide"
                    ],
                    "common_phrases": [
                        "require of myself",
                        "require immediate action"
                    ],
                    "target_lang_definitions": {
                        "ru": "Властно требовать или настаивать на наличии чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требовать",
                                "target_lang_sense_clarification": "настаивать в категорической форме"
                            },
                            {
                                "target_lang_word": "потребовать",
                                "target_lang_sense_clarification": "предъявить требование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e3dd9eb-b164-306d-b474-828f9265b8b0",
                    "sense_definition": "To ask someone for something or to make a request.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "request",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>require</w> you in the name of God that you do not torment me.",
                            "target_lang_translations": {
                                "ru": "Именем Бога <w>прошу</w> тебя, не мучай меня."
                            }
                        },
                        {
                            "text": "The knight <w>required</w> his companion to swear an oath of loyalty.",
                            "target_lang_translations": {
                                "ru": "Рыцарь <w>потребовал</w>, чтобы его спутник принес клятву верности."
                            }
                        }
                    ],
                    "synonyms": [
                        "ask"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature or formal religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить кого-либо о чем-либо или обращаться с просьбой (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "обращаться с просьбой"
                            },
                            {
                                "target_lang_word": "заклинать",
                                "target_lang_sense_clarification": "торжественно просить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}