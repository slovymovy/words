                "senses": [
                    {
                        "sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                        "entry_id": "d7347309-19df-3950-98e7-538c065e2ea4",
                        "glosses": [
                            "letztes Erzeugnis einer Produktion, welches nicht weiterverarbeitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2a2695-3f4a-47da-a3ec-fa8d1a3f5448",
                                "sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                                "text": "„Lactat ist das Endprodukt der Milchsäuregärung, die in Geweben (z. B. im arbeitenden Muskel) bei ungenügender Sauerstoffversorgung stattfindet.“"
                            },
                            {
                                "example_id": "f645e908-f3c5-40ee-b4ac-c285a4b69115",
                                "sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                                "text": "„Als Endprodukt des Proteinstoffwechsels wird Harnstoff gebildet und anschließend ausgeschieden.“"
                            },
                            {
                                "example_id": "caa38cd8-994f-441d-81f8-9f0ab1a24d5a",
                                "sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                                "text": "„Das wichtigste Endprodukt der Kohlendioxidfixierung ist Stärke, die sich mikroskopisch in Form von Stärkekörnern in den Chloroplasten nachweisen lässt.“"
                            },
                            {
                                "example_id": "81263d96-115f-441f-883b-5db512cb522b",
                                "sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                                "text": "„Das Gelb des Zitronenfalters entsteht durch Xanthopterine, Endprodukten des Stickstoffhaushalts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d28403db-1c2b-474a-bd6d-57ca7f0b5685",
                        "source_entry_id": "d7347309-19df-3950-98e7-538c065e2ea4",
                        "source_sense_id": "abec4b7b-9efa-3466-a74f-e87523ee0132",
                        "source_sense_description": "letztes Erzeugnis einer Produktion, welches nicht weiterverarbeitet wird",
                        "target_lang_word": "end product",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "end product",
