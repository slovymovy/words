                },
                {
                    "sense_id": "123cfa96-b30f-3bed-ac1c-f65c80c97124",
                    "sense_definition": "Promoting health or healing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted the <w>laudable</w> state of the patient's recovery after the surgery.",
                            "target_lang_translations": {
                                "zh": "医生注意到病人术后的恢复状况<w>有益</w>于健康。"
                            }
