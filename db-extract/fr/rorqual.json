                                        "glosses": [
                                            "Any whale of family Balaenopteridae, with longitudinal skin folds running from below the mouth to the navel, allowing the capacity of the mouth to expand greatly when feeding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177708ef-7fa7-449b-b5dd-b26f1f3ef2fc",
                                                "sense_id": "0d0c8926-e848-3838-b175-fd7f3079e1af",
                                                "text": "Now then, the biggest whales, those rorqual whales that frequent the waterways of the Aleutian Islands, have never exceeded a length of 56 meters--if they reach even that."
                                            }
                                        ]
                                    }
                                ]
                            }
