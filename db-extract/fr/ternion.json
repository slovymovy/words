                        "sense_id": "78fdd1b6-1548-3458-9d2c-fa98d7dee0d0",
                        "entry_id": "102092ad-7ef7-3ae2-bd63-8d1b733c0b89",
                        "glosses": [
                            "(Codicologie) Dans un codex, cahier composé de trois feuilles doubles (bifeuillets), soit 6 folios et 12 pages."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b44f79ec-8ad3-4774-a386-a3bb7ab483df",
                                "sense_id": "78fdd1b6-1548-3458-9d2c-fa98d7dee0d0",
                                "text": "Un ternion est constitué de trois bifeuillets."
                            },
                            {
                                "example_id": "2eaa2160-7aab-41ef-b18a-1540fe2da6e1",
                                "sense_id": "78fdd1b6-1548-3458-9d2c-fa98d7dee0d0",
                                "text": "Les cahiers 2 à 8 sont des quaternions. Le cahier nᵒ 9 est un ternion. Le cahier nᵒ 10 est un quaternion."
                            },
                            {
                                "example_id": "b791929c-e618-4673-ac58-cbc4c10f105e",
                                "sense_id": "78fdd1b6-1548-3458-9d2c-fa98d7dee0d0",
                                "text": "On voit, par exemple, qu’un ternion de 40 lignes/page peut être transposé soit en un quaternion de 30 lignes/page, soit en un sénion de 20 lignes/page, le total restant de 480 lignes dans chaque cas."
                            }
                        ]
                    }
