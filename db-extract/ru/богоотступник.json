                    {
                        "translation_id": "b83714de-9885-447b-8d6b-a323cc7c35bf",
                        "source_entry_id": "57dce655-3918-3e79-a865-02659bf0db50",
                        "source_sense_id": "3779204e-0994-3a88-ba6a-f0b8838c28e0",
