                "senses": [
                    {
                        "sense_id": "297317ea-61f2-355e-a98c-0386f5a21654",
                        "entry_id": "b503ed85-6cd2-3e20-8bd1-bfc370b062cc",
                        "glosses": [
                            "met veel water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "094001a2-85b0-4ed4-9cc5-646329d53b91",
                                "sense_id": "297317ea-61f2-355e-a98c-0386f5a21654",
                                "text": "Met De nieuwe wildernis (2013) en Holland: Natuur in de delta (2015) liet regisseur Mark Verkerk al zien hoe prachtig de Oostvaardersplassen en onze waterrijke gebieden zijn. Voor Wild was het natuurfilmer Luc Enting die zich tweeënhalf jaar verschool op de Veluwe om daar met highspeed camera’s, lange telelenzen en drones het wisselen van de seizoenen vast te leggen."
                            },
                            {
                                "example_id": "38f73a2b-7887-4445-ac5b-4746b95fb991",
                                "sense_id": "297317ea-61f2-355e-a98c-0386f5a21654",
                                "text": "Zwembond wil zwemles voor asielzoekers na dood Syrische jongen. Er verdrinken mensen in waterrijk Nederland, met warm weer vinden miljoenen mensen verkoeling in en aan het water en dan kan er wel eens iets gebeuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c82967a0-2ec7-4ff6-bd5a-d25d5f9ce4d6",
                        "source_entry_id": "b503ed85-6cd2-3e20-8bd1-bfc370b062cc",
                        "source_sense_id": "297317ea-61f2-355e-a98c-0386f5a21654",
                        "target_lang_word": "watery",
