                                        "examples": [
                                            {
                                                "example_id": "34031047-805d-4121-a2f2-533f33288f58",
                                                "sense_id": "9128d587-5c96-34c9-b0b6-67b06e5ac214",
                                                "text": "And in the stone a new name written, which no man knoweth saving he that receiveth it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c88e14a-39cc-3630-a1cd-7f7947836fc8",
                                        "entry_id": "8496b816-9faa-30d8-848a-5d7e753eded5",
