                ],
                "translations": [
                    {
                        "translation_id": "8b672257-ffb5-4441-9c90-30d1562a636f",
                        "source_entry_id": "d9358963-c39c-3295-a44d-d06113d288b0",
                        "source_sense_description": "негромко сыграть (на музыкальном инструменте), аккомпанируя кому-либо",
                        "target_lang_word": "accompagner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accompagner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Aller de compagnie avec quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "595af3b7-a49b-477e-9ae0-f0f1d26a169e",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Après deux jours d’absence, nous revenions à Rockall ramenant une nuée de mouettes qui avaient quitté leur îlot pour nous accompagner ; […]."
                                            },
                                            {
                                                "example_id": "27a72e2b-2081-4214-a67b-ce3c0035fc9c",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Le bateau s’enfonce dans l'obscurité. Le projecteur fixé au-dessus du chalut éclaire les eaux vertes et écumantes qu’accompagne le cortège des mouettes."
                                            },
                                            {
                                                "example_id": "4cf9881d-d8a4-4a01-a188-e4e9408670f2",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Le temps s’était gâté tout à fait, […]. Les rafales, accompagnées de grêle et de tonnerre, se succédaient, accourant du sud sud-est, […]."
                                            },
                                            {
                                                "example_id": "d9a5809b-dcac-4861-a1e6-0dbe114ad918",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Le développement de cette espèce est de type hétérométabole : l’accroissement de la taille se fait progressivement au cours de quatre mues juvéniles et d’une mue imaginale et s’accompagne de changements dans les proportions du corps."
                                            },
                                            {
                                                "example_id": "ba51b220-f6c8-4546-b5a0-ee9eec68c493",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Rinri me tenait la main, ainsi que chaque amoureux du parcours tenait la main de celle qui l’accompagnait."
                                            },
                                            {
                                                "example_id": "90b5d16c-16c6-41cc-b44e-e2853a2e4273",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Je ne pense jamais au Siam sans évoquer le déjeuner que fit au Palais Royal le gouverneur de l’Indochine d’alors, M. Violette, accompagné de sa très digne épouse."
                                            },
                                            {
                                                "example_id": "1dc888db-3de2-46eb-a56e-957662a343a5",
                                                "sense_id": "99c1d8ca-1de2-3745-9f57-33893ae26046",
                                                "text": "Le bonheur, la fortune l’accompagne ; il est heureux. — Les humiliations qui accompagnent la défaite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bad368b-3095-3e0a-a6fc-5b03fdc44167",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Suivre par honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb51c170-31d9-4791-823f-139c83cc3a26",
                                                "sense_id": "9bad368b-3095-3e0a-a6fc-5b03fdc44167",
                                                "text": "La plus grande partie de la noblesse accompagnait le gouverneur de la province."
                                            },
                                            {
                                                "example_id": "997c7097-4b5c-4034-a39c-bc238200b872",
                                                "sense_id": "9bad368b-3095-3e0a-a6fc-5b03fdc44167",
                                                "text": "Ce prince est toujours accompagné d’une suite nombreuse."
                                            },
                                            {
                                                "example_id": "753b5127-1daf-4573-a75e-7aac2ae96b64",
                                                "sense_id": "9bad368b-3095-3e0a-a6fc-5b03fdc44167",
                                                "text": "Il fut accompagné par plusieurs de ses amis."
                                            },
                                            {
                                                "example_id": "02ad955a-8cec-4691-910d-80e01e96438e",
                                                "sense_id": "9bad368b-3095-3e0a-a6fc-5b03fdc44167",
                                                "text": "Tous ceux qui se trouvèrent là accompagnèrent le Saint Sacrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b4ab082-b986-3c15-90d1-47794e0c8648",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Conduire en cérémonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f00aa42b-04f9-46ff-8917-6e7e595168d1",
                                                "sense_id": "0b4ab082-b986-3c15-90d1-47794e0c8648",
                                                "text": "C’est lui qui a la charge d’accompagner l’ambassadeur à l’audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69068de5-9309-34db-ac37-0ad07b6a667e",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Reconduire par honneur une personne dont on a reçu visite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d6df923-29df-4f7a-b60e-d64bc80889e1",
                                                "sense_id": "69068de5-9309-34db-ac37-0ad07b6a667e",
                                                "text": "Je vous accompagne à deux pas, déclara Jacques, en échangeant pour ses sabots les pantoufles brodées par les soins de son épouse ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ffe23c8-157d-3d38-a4be-8cb2370992ed",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Escorter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a86b82e-2ebf-4cd7-96da-9d68b75e5b22",
                                                "sense_id": "4ffe23c8-157d-3d38-a4be-8cb2370992ed",
                                                "text": "C’est José, un Marseillais pure laine, plein de chaleur, d’une quarantaine d'années, qui nous a accompagné pendant notre séjour."
                                            },
                                            {
                                                "example_id": "13310e84-9df5-4437-8089-4d090bbe705b",
                                                "sense_id": "4ffe23c8-157d-3d38-a4be-8cb2370992ed",
                                                "text": "Il se fait toujours bien accompagner, parce qu’il a des ennemis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Assortir ; convenir à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9efcfd6-d0fb-476c-8e2d-03c211fec325",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "Nous avons renoncé, ma femme et moi, au frometon : nous sommes rassasiés de protides. Puis, pour l’accompagner, le vin manque, […]."
                                            },
                                            {
                                                "example_id": "f9a2e6b9-c6ec-4d91-b4ee-000d5dd3a53c",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "En réalité, ce vin du Caucase, quelque peu aigrelet, accompagne convenablement la poule bouillie, disons le « pilau », – ce qui permet de lui trouver une saveur spéciale."
                                            },
                                            {
                                                "example_id": "5bfe72b7-9e79-40f9-9116-c8f393ae3f0d",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "Accompagner une chose d’une autre, — Joindre, ajouter une chose à une autre."
                                            },
                                            {
                                                "example_id": "597a4ed9-f2ea-4f58-ab1a-08d091542c85",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "Il accompagna son présent d’une lettre fort polie."
                                            },
                                            {
                                                "example_id": "b1b34d95-b9d0-41cd-b84c-35fc2748d7f0",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "Il accompagna ses remontrances de menaces."
                                            },
                                            {
                                                "example_id": "83228b91-0af6-4521-9540-fa76ea2bb52a",
                                                "sense_id": "b569c769-e77d-3630-8de3-10560b73b230",
                                                "text": "Tout ce qu’il fait, tout ce qu’il dit, il l’accompagne de beaucoup de grâce, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Exécuter un accompagnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23af219e-791d-433c-b63e-bce110c1c91a",
                                                "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                                "text": "Les spectateurs les accompagnaient en battant rythmiquement des mains et en chantant des airs tahitiens plus mélodieux que la dure langue mangarevienne."
                                            },
                                            {
                                                "example_id": "98fdaa3e-4078-44df-9030-38396196b921",
                                                "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                                "text": "Cette voix, qui tenait de la basse-taille par son volume, se veloutait comme celle des barytons, et prenait, dans le rire par lequel Philéas accompagnait ses fins de phrases, quelque chose d’argentin."
                                            },
                                            {
                                                "example_id": "59f4c6c2-062c-491d-836a-ab235a230db8",
                                                "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                                "text": "Un soir, attendant l'heure du dîner, Claire et Marcelle, cédant je suppose à une prière générale, jouèrent quelques morceaux ensemble, la pianiste accompagnant sa sœur violoniste."
                                            },
                                            {
                                                "example_id": "78f9b209-0cb3-481c-b6dc-0e15e2277272",
                                                "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                                "text": "— Il y avait un chanteur qui s’accompagnait d’un accordéon, un joueur de guitare et un mandoliniste le secondaient. Les airs que le trio interprétait étaient tantôt gais et entraînants, tantôt plus langoureux […]."
                                            },
                                            {
                                                "example_id": "d5a1f6c1-4d6a-4938-af35-b0a49c47caf7",
                                                "sense_id": "79f0f901-46f4-3568-895b-577989cf4b58",
                                                "text": "S'accompagnant de son gimbri, il nous chante, d'une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d01ad4-30fb-37d8-9792-1e69ed921aba",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Suivre et soutenir la progression d’une personne dans une démarche."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1fc97a2-1a98-4068-85c2-61bcd22cb288",
                                                "sense_id": "e0d01ad4-30fb-37d8-9792-1e69ed921aba",
                                                "text": "Accompagner le sujet psychotraumatisé, c’est reconnaître la gravité de ce que la personne a vécu et l’aider à mobiliser ses ressources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6dfe75f-9282-3f1e-be27-05d749befb8d",
                                        "entry_id": "85e294a6-be14-3da9-b4b4-824ee3b38740",
                                        "glosses": [
                                            "Mener quelques gens avec soi pour quelque dessein ; et il se prend souvent en mauvaise part."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ec91768-d30e-4ae3-80f2-c307f72bff26",
                                                "sense_id": "f6dfe75f-9282-3f1e-be27-05d749befb8d",
                                                "text": "Il s’accompagne toujours de méchants garnements."
                                            },
                                            {
                                                "example_id": "c00b7d82-879a-49d9-af28-e69520aa4b0a",
                                                "sense_id": "f6dfe75f-9282-3f1e-be27-05d749befb8d",
                                                "text": "Il s’accompagna de gens de main pour faire ce coup."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
