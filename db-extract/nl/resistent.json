                                    },
                                    {
                                        "sense_id": "2c55a86c-bf2d-344a-8016-6dfefd5d823f",
                                        "entry_id": "4a9e062d-1aa9-38f9-952a-a15b8c88c110",
                                        "glosses": [
                                            "Which is not affected or overcome by a disease, drug, chemical or atmospheric agent, extreme of temperature, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6172db-b273-4716-b48c-cfb138af1e15",
                                                "sense_id": "2c55a86c-bf2d-344a-8016-6dfefd5d823f",
                                                "text": "The infection is resistant to antibiotics."
                                            },
                                            {
                                                "example_id": "5a3565a7-cd3c-4fbc-8792-e94aead97d9f",
                                                "sense_id": "2c55a86c-bf2d-344a-8016-6dfefd5d823f",
                                                "text": "[…] suggests the dauerlarva is resistant because of non-feeding and a more resistant cuticle. Examination of the dauerlarva cuticle by thin sectioning and electron micro[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4ae55d-73ed-3bb0-82a9-cfd2d73e94b2",
                                        "entry_id": "4a9e062d-1aa9-38f9-952a-a15b8c88c110",
                                        "glosses": [
                                            "Not greatly influenced by individual members of a sample."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c2e90b7-811d-4d88-88e9-59aa358fa1b4",
                        "source_entry_id": "a73cd4fb-6223-36f6-9040-f0447a96992d",
                        "source_sense_id": "95e93ca5-0cfe-3bb1-98c9-fb20dc0c1847",
