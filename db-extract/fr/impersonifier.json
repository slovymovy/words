                "senses": [
                    {
                        "sense_id": "5a5ac2e1-0d10-3c34-a8b3-4448d7e7abb7",
                        "entry_id": "440c544d-682f-381c-91fd-7c4f567d1d65",
                        "glosses": [
                            "Représenter quelqu’un d’autre, l’imiter ou se faire passer pour lui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abeda272-3ddf-4a12-a10f-8fa76907ad0f",
                                "sense_id": "5a5ac2e1-0d10-3c34-a8b3-4448d7e7abb7",
                                "text": "Il est fréquent d'impersonifier l'identité du l'utilisateur dans une application ASP.Net MVC."
                            },
                            {
                                "example_id": "7533f89d-6739-47a5-a651-a268c0f50035",
                                "sense_id": "5a5ac2e1-0d10-3c34-a8b3-4448d7e7abb7",
                                "text": "User To Impersonate (FQDN) : le nom de l'utilisateur à impersonifier (login de la personne dont on veut afficher la liste de tâches)."
                            },
                            {
                                "example_id": "452e9c6c-7620-4f21-b02d-fe7795d924c1",
                                "sense_id": "5a5ac2e1-0d10-3c34-a8b3-4448d7e7abb7",
                                "text": "Donc rien n'a changé et le domaine COMMUNICATION-PAYPAL.COM est toujours à vendre au premier gogo qui veut impersonifier Paypal."
                            }
                        ]
                    }
