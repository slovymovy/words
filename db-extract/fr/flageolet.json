            {
                "entry_id": "d4a84783-a45c-321e-9d57-371539b8af51",
                "word": "flageolet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "69242c06-73ea-4f03-bcde-8a2362216b09",
                        "entry_id": "d4a84783-a45c-321e-9d57-371539b8af51",
                        "tags": [
                            "plural"
