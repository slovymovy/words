                {
                    "sense_id": "b08e9460-1859-31bf-8c0c-c6697033b825",
                    "sense_definition": "Перемещение на новое место жительства, работы или нахождения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "moving_house",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <переезд> в новую квартиру запланирован на следующие выходные.",
                            "target_lang_translations": {
                                "en": "Our <w>move</w> to the new apartment is scheduled for next weekend.",
                                "de": "Unser <w>Umzug</w> in die neue Wohnung ist für das nächste Wochenende geplant."
                            }
                        },
                        {
                            "text": "Организация помогает сотрудникам оплатить <переезд> в другой город.",
                            "target_lang_translations": {
                                "en": "The organization helps employees pay for <w>relocation</w> to another city.",
                                "de": "Die Organisation hilft den Mitarbeitern, den <w>Umzug</w> in eine andere Stadt zu bezahlen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "переезд на квартиру",
                        "готовиться к переезду",
                        "вещи для переезда"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving to a new place of residence, work, or location.",
                        "de": "Umzug an einen neuen Wohn- oder Arbeitsort."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "change of residence"
                            },
                            {
                                "target_lang_word": "relocation",
                                "target_lang_sense_clarification": "formal, often work-related"
                            },
                            {
                                "target_lang_word": "moving",
                                "target_lang_sense_clarification": "process of changing homes"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Umzug",
                                "target_lang_sense_clarification": "Wechsel des Wohnsitzes"
                            },
                            {
                                "target_lang_word": "Wohnungswechsel",
                                "target_lang_sense_clarification": "formeller Begriff für den Umzug"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2fec7a2-673b-35f2-adb3-19699e96f10d",
                    "sense_definition": "Специально оборудованное место пересечения автомобильной дороги с железнодорожными путями.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Водитель остановился перед закрытым шлагбаумом на железнодорожном <переезде>.",
                            "target_lang_translations": {
                                "en": "The driver stopped in front of the closed barrier at the railway <w>crossing</w>.",
                                "de": "Der Fahrer hielt vor der geschlossenen Schranke am <w>Bahnübergang</w>."
                            }
                        },
                        {
                            "text": "Этот <переезд> оборудован автоматической сигнализацией для безопасности.",
                            "target_lang_translations": {
                                "en": "This <w>level crossing</w> is equipped with an automatic alarm for safety.",
                                "de": "Dieser <w>Bahnübergang</w> ist zur Sicherheit mit einer automatischen Signalanlage ausgestattet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "железнодорожный переезд",
                        "охраняемый переезд",
                        "закрытый переезд"
                    ],
                    "target_lang_definitions": {
                        "en": "A specially equipped intersection of a road and railway tracks.",
                        "de": "Eine speziell ausgestattete Kreuzung einer Straße mit Bahngleisen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "level crossing",
