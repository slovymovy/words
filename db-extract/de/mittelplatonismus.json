                        "sense_id": "113b41e1-ac77-3cee-88fa-0fe36f652c28",
                        "entry_id": "447ca560-d020-3567-b465-0e446fb5f266",
                        "glosses": [
                            "die Bezeichnung für diejenige Entwicklungsstufe des Platonismus, die von der zweiten Hälfte des 1. Jahrhunderts v. Chr. bis zur Entstehung des Neuplatonismus im 3. Jahrhundert n. Chr. reicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8909e01-6679-4444-b890-579b4b6a4d22",
                                "sense_id": "113b41e1-ac77-3cee-88fa-0fe36f652c28",
                                "text": "Der Mittelplatonismus lieferte den Hintergrund für die frühen christlichen Apologeten des zweiten Jahrhunderts wie Clemens von Alexandrien […]."
                            },
                            {
                                "example_id": "6c32a406-bb8a-4c58-bc0c-38f86881dc95",
                                "sense_id": "113b41e1-ac77-3cee-88fa-0fe36f652c28",
                                "text": "Dem Mittelplatonismus gehören unter anderem Celsus und Plutarch an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
