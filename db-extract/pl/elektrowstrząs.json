                "senses": [
                    {
                        "sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                        "entry_id": "4a8b939f-09c3-30d8-8446-dab83a8fae84",
                        "glosses": [
                            "zabieg polegający na przepuszczeniu prądu elektrycznego przez ciało pacjenta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "702ce43d-be69-4148-9406-8063d61988c0",
                                "sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                                "text": "Po drugim elektrowstrząsie serce naszego dziecka ożyło"
                            },
                            {
                                "example_id": "30b42a25-8009-40a4-adaf-f0f4c54a06cb",
                                "sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                                "text": "Wbrew powszechnym opiniom, elektrowstrząsy to bardzo skuteczna i bardzo bezpieczna metoda leczenia zaburzeń afektywnych zarówno jednobiegunowych (depresja), jak i dwubiegunowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46b18778-a0a1-4def-aed9-b340890c6af5",
                        "source_entry_id": "4a8b939f-09c3-30d8-8446-dab83a8fae84",
                        "source_sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                        "target_lang_word": "electroshock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electroshock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f17bbf3-17dd-3b53-b58b-f437f6e91d84",
                                        "entry_id": "eaeabd9a-4961-30cf-90b5-ab3da587d934",
                                        "glosses": [
                                            "electric shock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "429e0ad0-2bfc-4a11-a93a-a9c84da143ed",
                                                "sense_id": "6f17bbf3-17dd-3b53-b58b-f437f6e91d84",
                                                "text": "The injection of the relaxant myocaine (glycerol ester of guaiacol) before an electroshock prevents the dysfunction of carbohydrate metabolism, restricts the splitting of phosphocreatine after cardiazol and picrotoxin, and after electroshock and amidopyrine it facilitates phosphocreatine synthesis (Mison-Crighel, 1957). Similarly, alkaline phosphatases no longer decrease after an electroshock if myocaine has previously been injected (Appel et al., 1957)."
                                            },
                                            {
                                                "example_id": "50079474-2b42-415b-9976-dedeface4316",
                                                "sense_id": "6f17bbf3-17dd-3b53-b58b-f437f6e91d84",
                                                "text": "The associations between valence feature codes and tactile codes are assumed, reflecting that the model already 'knows' that an electroshock is inherently experienced as unpleasant. The associations between word shapes and valence codes are also assumed, reflecting prior knowledge of the valence of certain words. In contrast to these fixed associations, the model has to learn the associations between valence codes and motor codes during the training phase."
                                            },
                                            {
                                                "example_id": "ea4afc2d-eab3-4c84-a277-ea2c723ae3e1",
                                                "sense_id": "6f17bbf3-17dd-3b53-b58b-f437f6e91d84",
                                                "text": "Supramaximal Electroshock Test (Mouse and Rat)\nAfter drug administration, each animal received an electroshock [...] through corneal electrodes to initiate a hindlimb tonic extension convulsion; anticonvulsant activity occurred when the above convulsion was blocked."
                                            },
                                            {
                                                "example_id": "f471039e-e5bd-466e-943f-6e0f07f1c325",
                                                "sense_id": "6f17bbf3-17dd-3b53-b58b-f437f6e91d84",
                                                "text": "Test mice were injected i.vt. with 95 mM taurine in a volume of 2 μ1,3 min prior to an electroshock (50 mA for 0.2 sec). The dose of taurine was chosen from our previous data on the suppressive action of the sulfur amino acid [...]. Control animals were injected with [...] phosphate buffered saline solution in an identical volume and 3 min later received the electroshock. All solutions injected i.vt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e85ebb4-91c3-3152-bde9-c510f39f92bc",
                                        "entry_id": "eaeabd9a-4961-30cf-90b5-ab3da587d934",
                                        "glosses": [
                                            "Electroconvulsive therapy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54eb5d28-61ec-47ff-89de-c5d95180df58",
                                                "sense_id": "4e85ebb4-91c3-3152-bde9-c510f39f92bc",
                                                "text": "As he awaited the third series of electroshocks in late October 1943, Artaud recalled the accident to Ferdière: 'The electroshock therapy has caused me to suffer terribly, and I beg you to spare me another suffering.'"
                                            },
                                            {
                                                "example_id": "05868f9d-64e5-49f1-998e-478780e30035",
                                                "sense_id": "4e85ebb4-91c3-3152-bde9-c510f39f92bc",
                                                "text": "Although California has the toughest laws in the country regulating electroshock and requiring patient consent, due to the pressures from the medical lobby these have never been enforced. The procedure is extremely lucrative for the doctors who use it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "electroshock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73f9ea20-8abe-3b7a-be45-0426f4aaff54",
                                        "entry_id": "e7f315fd-ffab-3dd1-a47e-02475fc699b6",
                                        "glosses": [
                                            "To administer electroconvulsive therapy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9ff0c86-0116-4808-a0dd-13565305f514",
                        "source_entry_id": "4a8b939f-09c3-30d8-8446-dab83a8fae84",
                        "source_sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                        "target_lang_word": "Elektroschock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektroschock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea6bb4d5-5a0c-3b0a-8747-905e726d457a",
                                        "entry_id": "96d1f5ff-4504-3ead-b0ac-be0ead36a16d",
                                        "glosses": [
                                            "durch elektrische Stromstöße erzeugter künstlicher Schock zur Behandlung bestimmter Psychosen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72cac60e-a860-4346-b94e-915e7cc11b7e",
                                                "sense_id": "ea6bb4d5-5a0c-3b0a-8747-905e726d457a",
                                                "text": "„Schonungslos beschreibt Kacem die jahrelangen unfreiwilligen Aufenthalte des revolutionären Theatertheoretikers in Krankenhäusern und Psychiatrien, die Elektroschocks, das Aushungern und Vergiften – zusammengenommen eine unbeschreibliche Folter, die uns alle, davon ist der Autor überzeugt, in einem ähnlich verheerenden Zustand hinterlassen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa05cfc-bb1c-416d-a6a1-6e9052564ff9",
                        "source_entry_id": "4a8b939f-09c3-30d8-8446-dab83a8fae84",
                        "source_sense_id": "7ec195e4-4920-34cc-b280-d477ac2b14a4",
                        "target_lang_word": "электрошок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "электрошок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0528c242-f026-354d-a0f7-0e2942905c23",
                                        "entry_id": "cd453fb4-03f5-3360-b294-3c4cab5b340f",
                                        "glosses": [
                                            "шок от электрического разряда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d0c6e9-697e-46db-a3ba-27bdc586c3e0",
                                                "sense_id": "0528c242-f026-354d-a0f7-0e2942905c23",
                                                "text": "Пемолин магния оказывает антагонистическое действие у кроликов и крыс как на ретроградный, так и на антероградный амнезический эффект электрошока."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
