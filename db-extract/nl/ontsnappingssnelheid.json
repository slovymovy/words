                    {
                        "sense_id": "dd1c572e-c618-3c9e-bd60-c4379e8bc27f",
                        "entry_id": "4c6fc177-4810-3b93-a513-de2b000f444d",
                        "glosses": [
                            "de snelheid die nodig is om zich aan het zwaartekrachtsveld van een hemellichaam te onttrekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a5b6fe4-fe39-4963-88be-f4d3c5f26ea8",
                                "sense_id": "dd1c572e-c618-3c9e-bd60-c4379e8bc27f",
                                "text": "U hebt het gezien: een boel rotsachtige materie vloog op tot de ontsnappingssnelheid, wat uw verwachtingen misschien nog overtrof."
                            },
                            {
                                "example_id": "e943145e-49d6-4088-826c-8452c9cb0adf",
                                "sense_id": "dd1c572e-c618-3c9e-bd60-c4379e8bc27f",
                                "text": "De Natural Selection doorkruiste de banen van zestien manen en bereikte de ontsnappingssnelheid ter hoogte van Callisto."
                            },
                            {
                                "example_id": "5dda79ac-469c-42e0-8a24-ff52cdca3c49",
                                "sense_id": "dd1c572e-c618-3c9e-bd60-c4379e8bc27f",
                                "text": "Met de massa van de Melkweg bij de hand kon het team de ontsnappingssnelheid berekenen voor een object nabij ons sterrenstelsel. Om uit de zwaartekrachtsgreep van de Melkweg te ontsnappen, moet een ruimteschip de 537 kilometer per seconde halen. Ter vergelijking: een raket hoeft ‘slechts’ een snelheid van 11,2 kilometer per seconde te bereiken om aan de zwaartekracht van de aarde te ontsnappen."
                            }
                        ]
                    }
