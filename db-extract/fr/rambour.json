                        "examples": [
                            {
                                "example_id": "50d0db29-803b-425a-9549-6e62b303fffd",
                                "sense_id": "f6e7d141-5393-3785-b4dc-1560a5b1b1e3",
                                "text": "- Alors, reprend Antoine, en retombant à l’argot pour son récit de Théramène, avant d’aller au rambour, je tube, c’est la consigne."
                            },
                            {
                                "example_id": "31594e76-e607-4e87-acf1-cb14d68d4927",
                                "sense_id": "f6e7d141-5393-3785-b4dc-1560a5b1b1e3",
                                "text": "Martine dessert la table et je lui file rambour pour un avenir très immédiat dans sa carrée."
                            },
                            {
                                "example_id": "31a4cf3b-9fcc-4e68-9402-ffca5d67418c",
                                "sense_id": "f6e7d141-5393-3785-b4dc-1560a5b1b1e3",
                                "text": "J’adopte un moyen de transport ancestral et tonifiant pour me rendre à mon rambour : mes gambettes !"
                            }
                        ]
                    }
