                                    {
                                        "sense_id": "8eeb2816-1a6b-30d2-bec7-01f39fe78e21",
                                        "entry_id": "ed2ce2fc-c3d1-3ead-9cda-71f28875f8e9",
                                        "glosses": [
                                            "Gruppe von zwei Personen, die etwas gemeinsam tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3f980a-46eb-4715-ab00-7eeab2fa4f3e",
                                                "sense_id": "8eeb2816-1a6b-30d2-bec7-01f39fe78e21",
