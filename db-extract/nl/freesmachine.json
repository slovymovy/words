                        "source_entry_id": "c6c8d3e0-62bd-367e-bf5d-dc476aa74cbf",
                        "source_sense_id": "f6ac8d6e-2dda-320a-b2d4-d503db8242e7",
                        "target_lang_word": "фрезерный станок",
                        "target_lang_code": "ru",
