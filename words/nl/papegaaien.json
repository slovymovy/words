            "senses": [
                {
                    "sense_id": "b4c08732-99fd-3737-9cff-0f27e0b1e212",
                    "sense_definition": "Iets klakkeloos herhalen zonder het echt te begrijpen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet nuttig om alleen maar de mening van anderen te <w>papegaaien</w>.",
                            "target_lang_translations": {
                                "fr": "Il n'est pas utile de simplement <w>perroquetter</w> l'opinion des autres."
                            }
                        },
                        {
                            "text": "De student bleef de tekst uit het boek <w>papegaaien</w> zonder de inhoud te snappen.",
                            "target_lang_translations": {
                                "fr": "L'étudiant continuait à <w>perroquetter</w> le texte du livre sans en comprendre le contenu."
                            }
                        }
                    ],
                    "synonyms": [
                        "nazeggen",
                        "nabauwen"
                    ],
                    "target_lang_definitions": {
