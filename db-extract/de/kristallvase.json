                "senses": [
                    {
                        "sense_id": "140ee8a9-d14a-3511-b608-1d16a0247311",
                        "entry_id": "db9585eb-ba2e-307b-8592-4749ccd4c805",
                        "glosses": [
                            "aus (geschliffenem) Kristallglas gefertigte Vase"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c02863-1c59-4545-99a5-583511d57722",
                                "sense_id": "140ee8a9-d14a-3511-b608-1d16a0247311",
                                "text": "„Manchmal passiert es, dass eine schöne Kristallvase zu Bruch geht.“"
                            },
                            {
                                "example_id": "cedb42aa-1b4b-4b4e-892c-387848dfef93",
                                "sense_id": "140ee8a9-d14a-3511-b608-1d16a0247311",
                                "text": "„Sie sagte, sie habe die Kontrolle verloren und sich den nächsten Gegenstand gegriffen, eine Kristallvase, die Unnur zur Konfirmation bekommen hatte, und sei damit über Bjarki hergefallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
