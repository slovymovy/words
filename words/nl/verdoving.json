                    "frequency": "High",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij de tandarts kreeg hij een <w>verdoving</w> voordat de behandeling begon.",
                            "target_lang_translations": {
                                "en": "At the dentist, he received an <w>anesthetic</w> before the treatment began."
                            }
                        },
                        {
                            "text": "De arts zei dat de <w>plaatselijke</w> <w>verdoving</w> snel zou gaan werken.",
                            "target_lang_translations": {
                                "en": "The doctor said the <w>local</w> <w>anesthesia</w> would start working quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "anesthesie"
                    ],
                    "common_phrases": [
                        "plaatselijke verdoving",
                        "onder verdoving",
                        "een verdoving krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "the administration of a substance to temporarily remove pain or consciousness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anesthesia",
                                "target_lang_sense_clarification": "medical procedure or state"
                            },
                            {
                                "target_lang_word": "anesthetic",
                                "target_lang_sense_clarification": "the substance used to numb pain"
                            },
                            {
                                "target_lang_word": "numbing",
                                "target_lang_sense_clarification": "the act of making a body part lose sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87562b92-7243-3aa9-bb5a-85ce3416f413",
                    "sense_definition": "een toestand van mentale verslagenheid of verbijstering",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mentale toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het horen van het slechte nieuws verkeerde zij in een diepe <w>verdoving</w>.",
                            "target_lang_translations": {
                                "en": "After hearing the bad news, she was in a deep <w>daze</w>."
                            }
                        },
                        {
                            "text": "De plotselinge klap bracht een <w>verdoving</w> teweeg bij alle aanwezigen.",
                            "target_lang_translations": {
                                "en": "The sudden blow caused a <w>stupor</w> among all those present."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geestelijke verdoving"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figuurlijk gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a state of mental defeat, bewilderment, or emotional numbness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "daze",
                                "target_lang_sense_clarification": "a state of stunned confusion"
                            },
                            {
                                "target_lang_word": "stupor",
                                "target_lang_sense_clarification": "a state of near-unconsciousness or insensibility"
                            },
                            {
                                "target_lang_word": "numbness",
                                "target_lang_sense_clarification": "emotional or mental lack of feeling"
                            }
                        ]
                    }
                }
            ]
