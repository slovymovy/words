                                        "glosses": [
                                            "The Wimbledon Championships, a prestigious tennis tournament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd883a1-4588-45a3-9a25-9a4a56c226c7",
                                                "sense_id": "9c867243-9b90-3c07-9f42-8639f09dfdbb",
                                                "text": "Norman Brookes was the first Australian to win the men's singles at Wimbledon in 1907 - making him the first male outside Britain to win the Championships and the first of 12 Australian men to take the title."
                                            },
                                            {
                                                "example_id": "2bb41b2e-8549-43eb-b961-c815c43b7e05",
                                                "sense_id": "9c867243-9b90-3c07-9f42-8639f09dfdbb",
                                                "text": "In the 1991 Wimbledon semifinal between Michael Stich and Stefan Edberg, there was just one service break in the entire match, and the guy whose serve was broken, Stich, ended up winning the match!"
                                            },
                                            {
                                                "example_id": "dd9d0d05-e99d-46be-a984-3cd6b8a9efea",
                                                "sense_id": "9c867243-9b90-3c07-9f42-8639f09dfdbb",
                                                "text": "An incredible 28 thousand kilograms of strawberries are eaten at Wimbledon every year..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
