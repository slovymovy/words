                "senses": [
                    {
                        "sense_id": "c15bd164-3536-3603-9c65-8a2c80d37fee",
                        "entry_id": "23b8f291-8e5d-3cc1-adc4-9d4924233b73",
                        "glosses": [
                            "Réduire à l’état de SDF."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf9cee4-cecd-4a43-a293-e2267f94f9f1",
                                "sense_id": "c15bd164-3536-3603-9c65-8a2c80d37fee",
                                "text": "Je ne suis pas Florence Aubenas qui s’immerge dans une entreprise de nettoyage durant six mois pour raconter les misères et les vicissitudes d’une classe ouvrière SDFisée."
                            },
                            {
                                "example_id": "331b0546-855e-4386-860b-dc173235b775",
                                "sense_id": "c15bd164-3536-3603-9c65-8a2c80d37fee",
                                "text": "Le truc c'est que paupériser et SDF-iser les jeunes au profit des retraités, c'est la garantie d'une conjoncture qui va devenir structurelle ."
                            },
                            {
                                "example_id": "08fac72a-94f9-47f8-9d2e-a36960a690b8",
                                "sense_id": "c15bd164-3536-3603-9c65-8a2c80d37fee",
                                "text": "Ou alors, je me SDF-ise."
                            }
                        ]
                    }
