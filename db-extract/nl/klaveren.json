                                        "sense_id": "11f8eb57-26f5-3bdd-9043-02410b2e543f",
                                        "entry_id": "61a23376-70c2-3572-88c9-0018db779a19",
                                        "glosses": [
                                            "Ornement imité de la feuille de trèfle représentant la Trinité."
