                "senses": [
                    {
                        "sense_id": "d1d99e1e-08e9-3fb9-990e-c07d122fec0f",
                        "entry_id": "4e44bae0-f82c-3150-8c4b-7db6b5c82b40",
                        "glosses": [
                            "aus Längs- und Querstreben bestehende Vorrichtung, die eine Gefahr abwehren soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b883a32a-5176-470a-b442-c2bf3c582f25",
                                "sense_id": "d1d99e1e-08e9-3fb9-990e-c07d122fec0f",
                                "text": "Vor die Sägemaschine wurde ein Schutzgitter gebaut, damit sich niemand schwer verletzt."
                            },
                            {
                                "example_id": "aa6c7e9e-9b06-4309-9e4a-b891a7cc3728",
                                "sense_id": "d1d99e1e-08e9-3fb9-990e-c07d122fec0f",
                                "text": "Die Straße wurde mit Schutzgittern abgesperrt, damit der Präsident sie ohne Zwischenfälle passieren kann."
                            },
                            {
                                "example_id": "57247b95-7f54-40b2-b5f8-b6b23730b44f",
                                "sense_id": "d1d99e1e-08e9-3fb9-990e-c07d122fec0f",
                                "text": "Frau Dr. Müller kaufte sich ein Bett mit Schutzgittern, damit ihr Kind nicht aus dem Bett fallen kann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
