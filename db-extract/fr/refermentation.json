                        "entry_id": "eb6cb67e-546b-3a7d-9b26-46ff642ad3cb",
                        "glosses": [
                            "Action de fermenter à nouveau. Fermentation de quelque chose qui a déjà été fermenté au moins une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a723f6a-1da8-4478-ab3c-48cff76afb16",
                                "sense_id": "a9eaf47c-f226-39a3-bf85-24bd5497b710",
                                "text": "La refermentation en bouteille est possible grâce à l’ajout de levure, et parfois de sucre, à la bière au moment de la mise en bouteille."
                            },
                            {
                                "example_id": "06af6a70-2c97-4a2d-8fc5-b9f14f2433ee",
                                "sense_id": "a9eaf47c-f226-39a3-bf85-24bd5497b710",
                                "text": "La refermentation du vin peut être due à la présence de sucre résiduel ou de bactérie lactique subsistante et plus généralement avec un vin mal stabilisé."
                            }
                        ]
                    }
                ],
