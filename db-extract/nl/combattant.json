                                        "sense_id": "2aaa9b96-6c04-36bd-88ee-748dbb533489",
                                        "entry_id": "7b956903-d19f-3bfa-a723-9e6261a86003",
                                        "glosses": [
                                            "Person, die zusammen mit anderen an einem Kampf teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efab48a4-52cd-4558-b33f-6c7151dd472b",
                                                "sense_id": "2aaa9b96-6c04-36bd-88ee-748dbb533489",
                                                "text": "Auf dem Schlachtfeld die Kombattanten Seite an Seite."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "41f69418-49a9-38b6-8a39-d3e69cd296db",
                                        "entry_id": "7b956903-d19f-3bfa-a723-9e6261a86003",
                                        "glosses": [
                                            "nach dem Völkerrecht zu Kampfhandlungen berechtigte Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a98e30b-2991-491a-a2d7-958ce3df6ba4",
                                                "sense_id": "41f69418-49a9-38b6-8a39-d3e69cd296db",
                                                "text": "„Zivile Hacker sollen im Krieg als Kombattanten eingestuft werden und dürften demnach auch physisch angegriffen und sogar getötet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f07e2650-1d1b-44a8-be6e-ff3eaede0f11",
                        "source_entry_id": "8ade2f1b-b042-3d16-98a1-bb93973d4582",
                        "source_sense_id": "5d02987d-9008-31a6-a62c-bc7256b711e1",
                        "source_sense_description": "militair, bestemd om aan de strijd deel te nemen",
                        "target_lang_word": "Kämpfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kämpfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "jemand, der kämpft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa03399b-d716-4905-a565-354de87d3ac1",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "Wer sich nicht ohne Gegenwehr unterkriegen lässt, ist ein Kämpfer."
                                            },
                                            {
                                                "example_id": "2ac29ff5-70a4-42d0-8964-3ac0881c3192",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            },
                                            {
                                                "example_id": "45f1ea3c-ec93-4e53-b009-29823f2ddd81",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Doch auch diesmal kann Wladimir seine Kämpfer nicht bezahlen, wieder muss er die nun lästigen Krieger loswerden.“"
                                            },
                                            {
                                                "example_id": "ac588b5f-7d4e-44a5-ab63-7f15dcb47487",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Die Kämpfer attackieren jeden, den sie für einen Verräter halten.“"
                                            },
                                            {
                                                "example_id": "42aadb53-fc78-494f-b9d3-eb426dc174b4",
                                                "sense_id": "5babfdcc-2da8-327d-99c8-c01655928964",
                                                "text": "„Unter den Bäumen war ein Ring aufgebaut, in dem die Kämpfer bei gutem Wetter trainierten, und im Tanzsaal gab es einen großen und einen kleinen Sandsack und eine Matte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "die obere vorspringende Platte eines Pfeilers oder einer Säule"
                                        ],
                                        "tags": [
                                            "Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eec3d97-31e8-4f22-91ab-d3141df0b2bd",
                                                "sense_id": "38bc7dad-4254-3618-b28f-ed629ca43332",
                                                "text": "\"Über einem Kapitell kann der Kämpfer auch als Block ausgebildet sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                        "entry_id": "1f746489-3a18-3308-82f6-067593c5e30c",
                                        "glosses": [
                                            "das waagerechte Trennungsteil eines mehrflügeligen Fensters"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58440fde-0bb8-490f-8cfb-4f911d99ae28",
                                                "sense_id": "6b633c08-2883-322b-8fd6-ce9a8d085cfa",
                                                "text": "„Rund um Fenster und Türen gibt es zahlreiche Begriffe, die sicher nicht jedem geläufig sind wie Kämpfer, Gangflügel, Gehflügel oder Stulpfenster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00bf24ff-eab5-4aee-9b87-2fd8ca4c3e75",
                        "source_entry_id": "8ade2f1b-b042-3d16-98a1-bb93973d4582",
                        "source_sense_id": "5d02987d-9008-31a6-a62c-bc7256b711e1",
                        "source_sense_description": "militair, bestemd om aan de strijd deel te nemen",
                        "target_lang_word": "Krieger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                        "entry_id": "daa7f63e-0bc9-3ac0-8c40-e6f22c28c946",
                                        "glosses": [
                                            "Person, die im Krieg kämpft"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50df60d-1649-4b34-9291-ce166345692e",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "Das Kämpfen ist die Aufgabe der Krieger."
                                            },
                                            {
                                                "example_id": "98eed2e3-dfe0-4318-aeca-f40834a9d233",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Die berittenen Krieger der Kelten wurden jeweils von zwei Dienern in den Kampf begleitet.“"
                                            },
                                            {
                                                "example_id": "731f80a5-c03a-403b-bdd5-d0a6cf8c9aa8",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Aber nicht nur die Knochen geopferter Krieger liegen hier, sondern auch über 15000 Teile ihrer Waffen, Schilde und persönliche Gegenstände.“"
                                            },
                                            {
                                                "example_id": "29ed2137-60ae-4476-a6bd-c79965f016a5",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Dort tauchen die Wikingerschiffe unerwartet auf und laufen bis an den Strand, von wo aus die Krieger oft nur noch wenige Schritte zurücklegen müssen.“"
                                            },
                                            {
                                                "example_id": "4d83c48e-e215-4629-a84e-ebdecefa9656",
                                                "sense_id": "30e2e7f6-1e63-3da2-9f3f-25e7531cc08c",
                                                "text": "„Neben den Soldaten zu Fuß und der Reiterei spielten die Krieger auf den Streitwagen in der Schlacht eine wichtige Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Krieger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                        "entry_id": "98f21846-0e3c-3f41-970c-3b78df74c556",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c85013c-4649-4928-9d59-83f955a09990",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Frau Krieger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "f9e0f942-b935-4361-b3d4-0c985787bc96",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Herr Krieger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "b441d681-03c9-4860-afc1-f676893e2293",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Die Kriegers fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "04003066-194b-4c41-b363-fd660547d290",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Der Krieger trägt nie die Schals, die die Krieger ihm strickt."
                                            },
                                            {
                                                "example_id": "bc184ae2-05ff-4d6d-bcec-11341c94a475",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krieger kommt, geht der Herr Krieger.“"
                                            },
                                            {
                                                "example_id": "ef769a81-a3ed-46ce-aa13-047c2c6910a3",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Krieger kommt und geht."
                                            },
                                            {
                                                "example_id": "6a0f8b13-432d-4e8a-85db-6450f8452e50",
                                                "sense_id": "c0a6acb1-3afb-3d92-9c8d-6c0e0b328dd0",
                                                "text": "Kriegers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
