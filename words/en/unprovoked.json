{
    "word_family": [
        "provoke",
        "provocation",
        "provocative",
        "unprovoke"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4329614b-0a50-3bfd-932c-a5a08b1c4f9f",
                    "sense_definition": "Occurring without any apparent cause, instigation, or provocation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police confirmed that the victim had suffered an <w>unprovoked</w> assault on the street.",
                            "target_lang_translations": {
                                "zh": "警方证实受害者在街上遭受了<w>无端</w>袭击。"
                            }
                        },
                        {
                            "text": "The government strongly condemned the <w>unprovoked</w> military aggression against its neighbor.",
                            "target_lang_translations": {
                                "zh": "政府强烈谴责了对其邻国发动的<w>未受挑衅的</w>军事侵略。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unmotivated",
                        "wanton",
                        "gratuitous"
                    ],
                    "antonyms": [
                        "provoked"
                    ],
                    "common_phrases": [
                        "unprovoked attack",
                        "unprovoked aggression",
                        "unprovoked violence",
                        "unprovoked assault"
                    ],
                    "target_lang_definitions": {
                        "zh": "（袭击、侵犯等）无缘无故的，未经挑衅的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无端的",
                                "target_lang_sense_clarification": "指没有理由或根据的（攻击、指责等）"
                            },
                            {
                                "target_lang_word": "无缘无故的",
                                "target_lang_sense_clarification": "强调没有由头或原因"
                            },
                            {
                                "target_lang_word": "未受挑衅的",
                                "target_lang_sense_clarification": "字面意思，对方并未招惹或挑衅"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "34fb2004-e127-3c6b-aedd-637a726c1c5e",
                    "sense_definition": "Without provocation, cause, or motivation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog suddenly lashed out and bit the visitor <w>unprovoked</w>.",
                            "target_lang_translations": {
                                "zh": "那条狗突然猛扑过去，<w>无缘无故地</w>咬了访客一口。"
                            }
                        },
                        {
                            "text": "She began shouting at her colleagues entirely <w>unprovoked</w> during the meeting.",
                            "target_lang_translations": {
                                "zh": "她在会议中完全<w>平白无故</w>地开始对同事大喊大叫。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "attack unprovoked"
                    ],
                    "target_lang_definitions": {
                        "zh": "无端地，无缘无故地，在未受挑衅的情况下"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无端",
                                "target_lang_sense_clarification": "没有理由地"
                            },
                            {
                                "target_lang_word": "无缘无故地",
                                "target_lang_sense_clarification": "平白无故地"
                            },
                            {
                                "target_lang_word": "平白无故",
                                "target_lang_sense_clarification": "没有原因地"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22f879e6-dd55-383f-8ffe-b0d3cda180bc",
                    "sense_definition": "simple past and past participle of <w>unprovoke</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His kind gesture had completely <w>unprovoked</w> the anger in the room.",
                            "target_lang_translations": {
                                "zh": "他友善的举动完全<w>平息</w>了屋里的怒气。"
                            }
                        },
                        {
                            "text": "She smiled gently and gradually <w>unprovoked</w> his hostility.",
                            "target_lang_translations": {
                                "zh": "她温柔地微笑，渐渐<w>化解</w>了他的敌意。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete verbal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 unprovoke 的过去式和过去分词；消除（挑衅、愤怒、敌意等）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "消除怒火或敌意"
                            },
                            {
                                "target_lang_word": "消除",
                                "target_lang_sense_clarification": "使敌对情绪消退"
                            },
                            {
                                "target_lang_word": "化解",
                                "target_lang_sense_clarification": "消解怒气或敌意"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}