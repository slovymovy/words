                "senses": [
                    {
                        "sense_id": "78342d11-386a-3672-85fc-345b679d9830",
                        "entry_id": "4d416ac9-94a0-313a-bd9e-11709e45b444",
                        "glosses": [
                            "etwas (insbesondere einen Gottesdienst) zelebrierende weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1d0b3b-d45a-44c0-8608-8e341a3a5b17",
                                "sense_id": "78342d11-386a-3672-85fc-345b679d9830",
                                "text": "„So ungemein ansprechend hatte die Zelebrantin der Messe vorgestanden, dass ich recherchierte, wer sie wohl war.“"
                            },
                            {
                                "example_id": "a17d476c-73b8-486f-826d-080e637cb129",
                                "sense_id": "78342d11-386a-3672-85fc-345b679d9830",
                                "text": "„Nicht so bei den Schwestern von Grandchamps; vorzugsweise ist es auch keine eigene Schwester, die als Zelebrantin fungiert, sondern Pfarrpersonen entweder aus der Gästegruppe oder aus der Umgebung.“"
                            },
                            {
                                "example_id": "e59b20b2-e3c3-4450-a144-fb2ffbc8e5bf",
                                "sense_id": "78342d11-386a-3672-85fc-345b679d9830",
                                "text": "„Sie trugen Blumen im Knopfloch und Anstecksträußchen, die zu Vals Bouquet passten, und zückten ihre Kameras. Als sie den Bräutigam mit seinen Begleitern und die Zelebrantin erreichten, war der Regen ohrenbetäubend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
