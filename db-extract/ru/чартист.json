                        "target_lang_word": "Chartist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "24d8aa53-8924-42c8-abac-fd6d95afc9cf",
                        "source_entry_id": "10d73e7f-05b9-34c5-b53c-5d89a6ed89c1",
                        "source_sense_id": "626556be-20a4-3517-b7f6-c15856da0f0d",
