{
    "word_family": [
        "luxurious",
        "luxuriously",
        "luxuriate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a500cc81-9382-3f03-b5f2-3727c41dc2cd",
                    "sense_definition": "Very wealthy and comfortable surroundings; the state of being that they create.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_of_comfort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After winning the lottery, the family lived in <w>luxury</w> for the rest of their lives.",
                            "target_lang_translations": {
                                "ru": "Выиграв в лотерею, семья жила в <w>роскоши</w> до конца своих дней.",
                                "zh": "中彩票后，这家人余生都过着<w>奢华</w>的生活。"
                            }
                        },
                        {
                            "text": "The hotel offers a level of <w>luxury</w> and service that is rarely seen in this city.",
                            "target_lang_translations": {
                                "ru": "Отель предлагает уровень <w>роскоши</w> и обслуживания, который редко встретишь в этом городе.",
                                "zh": "这家酒店提供的<w>豪华</w>程度和服务水平在城中罕见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "luxuriousness",
                        "luxe",
                        "opulence",
                        "affluence"
                    ],
                    "antonyms": [
                        "poverty",
                        "austerity",
                        "spartanness",
                        "penury"
                    ],
                    "common_phrases": [
                        "live in luxury",
                        "lap of luxury",
                        "pure luxury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень богатая и комфортная обстановка; состояние, которое она создает.",
                        "zh": "非常富有且舒适的环境；由这种环境所创造的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошь",
                                "target_lang_sense_clarification": "богатство и великолепие"
                            },
                            {
                                "target_lang_word": "богатство",
                                "target_lang_sense_clarification": "изобилие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奢华",
                                "target_lang_sense_clarification": "指生活环境的富裕与舒适"
                            },
                            {
                                "target_lang_word": "豪华",
                                "target_lang_sense_clarification": "指物质上的富足与排场"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93c0441f-c151-36a1-a18b-efa5a6660d89",
                    "sense_definition": "Something desirable but expensive and that one can live without.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_essential_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Owning a second car is a <w>luxury</w> that we simply cannot afford right now.",
                            "target_lang_translations": {
                                "ru": "Владение второй машиной — это <w>роскошь</w>, которую мы просто не можем себе сейчас позволить.",
                                "zh": "拥有一辆备用车是我们目前无法负担的<w>奢侈</w>。"
                            }
                        },
                        {
                            "text": "She considers buying fresh flowers every week a small <w>luxury</w>.",
                            "target_lang_translations": {
                                "ru": "Она считает покупку свежих цветов каждую неделю маленькой <w>роскошью</w>.",
                                "zh": "她认为每周买束鲜花是一种小小的<w>奢侈</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "necessity",
                        "essential",
                        "basics"
                    ],
                    "common_phrases": [
                        "afford the luxury",
                        "small luxury",
                        "expensive luxury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то желанное, но дорогое, без чего можно обойтись.",
                        "zh": "令人向往但昂贵且并非生活必需的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошь",
                                "target_lang_sense_clarification": "излишество"
                            },
                            {
                                "target_lang_word": "предмет роскоши",
                                "target_lang_sense_clarification": "дорогая вещь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奢侈品",
                                "target_lang_sense_clarification": "指昂贵的非必需品"
                            },
                            {
                                "target_lang_word": "奢侈",
                                "target_lang_sense_clarification": "指超出必要范围的消费或享受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b97152-5baa-366d-af9f-05656efa62ab",
                    "sense_definition": "Something that is pleasant and desirable but not necessary in life (whether expensive or not).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "non_essential_item",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We do not have the <w>luxury</w> of waiting for the weather to improve before we leave.",
                            "target_lang_translations": {
                                "ru": "Мы не можем позволить себе такую <w>роскошь</w>, как ждать улучшения погоды перед отъездом.",
                                "zh": "我们没有<w>奢侈</w>到可以等天气好转再出发。"
                            }
                        },
                        {
                            "text": "In his busy schedule, a full night of sleep is a rare <w>luxury</w>.",
                            "target_lang_translations": {
                                "ru": "В его плотном графике полноценный ночной сон — редкая <w>роскошь</w>.",
                                "zh": "在他繁忙的日程中，睡个整觉是一种难得的<w>奢侈</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "necessity"
                    ],
                    "common_phrases": [
                        "luxury of time",
                        "rare luxury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то приятное и желанное, но не являющееся жизненно необходимым (независимо от цены).",
                        "zh": "令人愉悦且向往，但并非生活中必须的事物（无论价格高低）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошь",
                                "target_lang_sense_clarification": "редкая возможность или удовольствие"
                            },
                            {
                                "target_lang_word": "позволить себе",
                                "target_lang_sense_clarification": "глагольная конструкция (afford the luxury)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奢侈",
                                "target_lang_sense_clarification": "指难得的享受或机会"
                            },
                            {
                                "target_lang_word": "难得的享受",
                                "target_lang_sense_clarification": "指某种珍贵的体验"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f985cb51-82db-3d8e-b4e6-04861e80a506",
                    "sense_definition": "Lustfulness; sexual desire or attraction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text warns against the sins of pride and <w>luxury</w>.",
                            "target_lang_translations": {
                                "ru": "Древний текст предостерегает от грехов гордыни и <w>сладострастия</w>.",
                                "zh": "古籍告诫人们要警惕傲慢与<w>淫欲</w>之罪。"
                            }
                        },
                        {
                            "text": "He preached that <w>luxury</w> and greed would lead to the downfall of the kingdom.",
                            "target_lang_translations": {
                                "ru": "Он проповедовал, что <w>сладострастие</w> и алчность приведут к падению королевства.",
                                "zh": "他宣扬说，<w>荒淫</w>与贪婪会导致王国的覆灭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Похоть; сексуальное желание или влечение.",
                        "zh": "淫欲；性欲或性吸引力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сладострастие",
                                "target_lang_sense_clarification": "устаревшее значение"
                            },
                            {
                                "target_lang_word": "похоть",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淫欲",
                                "target_lang_sense_clarification": "古语，指过度的性欲望"
                            },
                            {
                                "target_lang_word": "荒淫",
                                "target_lang_sense_clarification": "古语，指放纵情欲"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c0d87ed9-9885-3e7a-94b3-66494eb60810",
                    "sense_definition": "Very expensive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "expensive_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They stayed at a <w>luxury</w> hotel near the beach for their honeymoon.",
                            "target_lang_translations": {
                                "ru": "Они остановились в <w>роскошном</w> отеле недалеко от пляжа во время медового месяца.",
                                "zh": "他们度蜜月时住在海边的一家<w>豪华</w>酒店。"
                            }
                        },
                        {
                            "text": "The company is known for manufacturing <w>luxury</w> cars for the international market.",
                            "target_lang_translations": {
                                "ru": "Компания известна производством <w>роскошных</w> автомобилей для международного рынка.",
                                "zh": "该公司以生产面向国际市场的<w>豪华</w>汽车而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "luxurious",
                        "expensive"
                    ],
                    "common_phrases": [
                        "luxury car",
                        "luxury hotel",
                        "luxury brand",
                        "luxury apartment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень дорогой.",
                        "zh": "非常昂贵的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "дорогой и красивый"
                            },
                            {
                                "target_lang_word": "люкс",
                                "target_lang_sense_clarification": "высшего качества (неизменяемое)"
                            },
                            {
                                "target_lang_word": "элитный",
                                "target_lang_sense_clarification": "для избранных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "豪华",
                                "target_lang_sense_clarification": "形容设施或服务高档"
                            },
                            {
                                "target_lang_word": "奢侈",
                                "target_lang_sense_clarification": "形容价格昂贵且非必需"
                            },
                            {
                                "target_lang_word": "高端",
                                "target_lang_sense_clarification": "形容产品档次高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d56bc8ad-b0a7-3210-a60d-c1fc2185e609",
                    "sense_definition": "Not essential but desirable and enjoyable and indulgent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indulgent_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The store specializes in <w>luxury</w> goods that make perfect gifts for special occasions.",
                            "target_lang_translations": {
                                "ru": "Магазин специализируется на товарах класса <w>люкс</w>, которые станут идеальными подарками для особых случаев.",
                                "zh": "这家店专门经营<w>奢侈</w>品，是特殊场合的完美礼物。"
                            }
                        },
                        {
                            "text": "Consumers are spending less on <w>luxury</w> items during the economic downturn.",
                            "target_lang_translations": {
                                "ru": "Потребители тратят меньше на предметы <w>роскоши</w> во время экономического спада.",
                                "zh": "经济低迷时期，消费者在<w>奢侈</w>品上的支出减少了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "luxury goods",
                        "luxury item",
                        "luxury market"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся необходимым, но желанный и доставляющий удовольствие.",
                        "zh": "非必需但令人向往、享受且放纵的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "люкс",
                                "target_lang_sense_clarification": "о категории товаров"
                            },
                            {
                                "target_lang_word": "роскошный",
                                "target_lang_sense_clarification": "о качестве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奢侈",
                                "target_lang_sense_clarification": "指非必需的享受"
                            },
                            {
                                "target_lang_word": "高档",
                                "target_lang_sense_clarification": "指商品品质优良"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}