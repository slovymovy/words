                            },
                            {
                                "target_lang_word": "odtrącenie",
                                "target_lang_sense_clarification": "odrzucenie kogoś lub czegoś"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "versmading",
                                "target_lang_sense_clarification": "minachtende afwijzing"
                            },
                            {
                                "target_lang_word": "afwijzing",
                                "target_lang_sense_clarification": "het afwijzen van iets of iemand"
                            },
                            {
                                "target_lang_word": "hoon",
                                "target_lang_sense_clarification": "spottende of minachtende bejegening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fc3faf5-1cfb-392e-999a-dbc149656397",
                    "sense_definition": "A kick or a blow delivered with the foot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard delivered a sharp <w>spurn</w> to the prisoner.",
                            "target_lang_translations": {
                                "pl": "Strażnik wymierzył więźniowi ostre <w>kopnięcie</w>.",
                                "nl": "De bewaker gaf de gevangene een harde <w>schop</w>."
                            }
                        },
                        {
                            "text": "He felt the <w>spurn</w> of the boot against his side.",
                            "target_lang_translations": {
                                "pl": "Poczuł <w>kopnięcie</w> buta w swój bok.",
                                "nl": "Hij voelde de <w>trap</w> van de laars tegen zijn zij."
                            }
                        }
                    ],
                    "synonyms": [
                        "kick"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This noun usage is archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Kopnięcie lub cios zadany stopą (użycie przestarzałe).",
                        "nl": "Een trap of schop met de voet (verouderd)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kopnięcie",
                                "target_lang_sense_clarification": "uderzenie nogą"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "schop",
                                "target_lang_sense_clarification": "stoot met de voet"
                            },
                            {
                                "target_lang_word": "trap",
                                "target_lang_sense_clarification": "slag met de voet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fa2861b-363f-3280-ac21-875b992b12bb",
                    "sense_definition": "A mass of coal left in a mine to support an overhanging section.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners left a <w>spurn</w> to ensure the roof remained stable.",
                            "target_lang_translations": {
                                "pl": "Górnicy zostawili <w>filar</w>, aby zapewnić stabilność stropu.",
                                "nl": "De mijnwerkers lieten een <w>steunpilaar</w> staan om ervoor te zorgen dat het dak stabiel bleef."
                            }
                        },
                        {
                            "text": "The structural <w>spurn</w> prevented the tunnel from collapsing.",
                            "target_lang_translations": {
                                "pl": "Konstrukcyjny <w>filar</w> zapobiegł zawaleniu się tunelu.",
                                "nl": "De dragende <w>koolpijler</w> voorkwam dat de tunnel instortte."
                            }
