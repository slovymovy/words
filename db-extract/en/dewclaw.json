                        "target_lang_word": "ergot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ergot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f5a7a83-31e3-306b-b2b3-b01383ea0c2d",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Petit éperon pointu osseux et corné de la patte des oiseaux galliformes mâles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c031832-9498-43aa-95b6-fe4bff4c0a2b",
                                                "sense_id": "7f5a7a83-31e3-306b-b2b3-b01383ea0c2d",
                                                "text": "Les ergots d’un coq"
                                            },
                                            {
                                                "example_id": "c144a8e5-60b4-40e4-8175-19ac2723cce2",
                                                "sense_id": "7f5a7a83-31e3-306b-b2b3-b01383ea0c2d",
                                                "text": "Se dresser sur ses ergots, se tenir sur ses ergots, monter sur ses ergots, prendre une attitude hautaine et agressive."
                                            },
                                            {
                                                "example_id": "0f9d857e-1c5f-4f20-8690-41fb350e5fb4",
                                                "sense_id": "7f5a7a83-31e3-306b-b2b3-b01383ea0c2d",
                                                "text": "Nicole se haussa sur ses petits pieds comme un jeune coq sur ses ergots."
                                            },
                                            {
                                                "example_id": "916050fa-77ad-442b-8864-a465eaf294db",
                                                "sense_id": "7f5a7a83-31e3-306b-b2b3-b01383ea0c2d",
                                                "text": "Mais son fils est un vaniteux, qui aime mieux paraître qu’être (cela se conçoit, il n’est rien), et qui monte sur ses ergots dès que l’on fait cocorico. Pourtant, il faut qu’un Français chante et qu’il se moque de ses maîtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1444ad8-ad70-3969-a491-0cbddf73559b",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Doigt supplémentaire chez certaines races de chiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c30e53-a381-4e77-a232-2affe652c93e",
                                                "sense_id": "c1444ad8-ad70-3969-a491-0cbddf73559b",
                                                "text": "On lui coupe l'ergot, a dit Maman, pour pas qu'elle se l'accroche quelque part quand elle court, — (Jamey Bradvury, Sauvage, traduction de Jacques Mailhos)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec9575d4-e751-3865-bac3-5b64b8c9e3d4",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Petite pièce servant de butée ou de clavette sur une pièce plus massive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a181abce-f0be-344e-87c4-1f6b0d7b0ed5",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Petite pièce mobile placée à droite et à gauche sous un clavier d'ordinateur permettant d'incliner celui-ci lorsqu'il est posé sur un bureau."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "22e56a3e-c05b-3c96-8ade-de8ec74a10bc",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Petite branche morte d’un arbre fruitier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46c3cb58-18bc-3125-a316-4fc04e1bbdcd",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Maladie cryptogamique qui attaque le blé, le seigle et qui rend dangereux le pain qu’on fait de ce grain ainsi gâté→ voir ergot de seigle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "169a048b-e84d-40ee-ab5f-6bfbb094aa82",
                                                "sense_id": "46c3cb58-18bc-3125-a316-4fc04e1bbdcd",
                                                "text": "La rouille et le charbon ou nielle ne se montrent guère que dans les années pluvieuses et sur les récoltes ensemencées trop tard ; l’ergot du seigle est très-rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec0e677-8c68-3a8e-9b21-0b4305dd5113",
                                        "entry_id": "8ce992db-a4ff-3773-947c-936d3afe35ac",
                                        "glosses": [
                                            "Petit trait horizontal rattaché le plus souvent à gauche du fut de la lettre minuscule s long, de la lettre minuscule eszett, ou de la lettre minuscule l dans certaines polices de caractères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa7998a-e7d1-4864-8d37-6cb089a2b5a0",
                                                "sense_id": "fec0e677-8c68-3a8e-9b21-0b4305dd5113",
                                                "text": "Cet ergot sur le l minuscule devint, par la suite, une caractéristique des caractères exclusifs de l’Imprimerie royale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
