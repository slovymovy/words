                "senses": [
                    {
                        "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                        "entry_id": "260c915d-3032-3647-a0d4-d556f4b4e4df",
                        "glosses": [
                            "ehemalige, mit Grundwasser gefüllte Schottergrube; künstlich angelegtes Bade- oder Angelgewässer"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "2d25c09f-ae78-470a-8db7-78b05933066a",
                                "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                                "text": "„Dieser Schotterteich erstreckt sich auf einer Fläche von 14,3 Hektar und hat eine maximale Tiefe von 7 Metern.“"
                            },
                            {
                                "example_id": "71357f5e-bf1f-4242-840f-b8ab2af95deb",
                                "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                                "text": "„Das Löschwasser wurde vom nahen Hydranten und mittels einer rund 500 Meter langen Schlauchleitung vom Schotterteich in Eizendorf entnommen.“"
                            },
                            {
                                "example_id": "e18a5e38-8bdc-4692-8b8d-e4ed065f43f0",
                                "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                                "text": "„Emma schrieb in ihren Projektvorschlag, man sollte versuchen, den Schotterteich zu erwerben.“"
                            },
                            {
                                "example_id": "9f1d1750-c796-487b-bc0e-02cb666b8eb9",
                                "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                                "text": "„Das kleinste der bis zu fünf besiedelten Gewässer ist ein 1,5 ha großer Schotterteich.“"
                            },
                            {
                                "example_id": "0107d320-b82e-4377-8ac8-576c788d8006",
                                "sense_id": "dc9fc5bb-7939-3b78-8b7f-63c5c44066bd",
                                "text": "Kingstontown am Schotterteich, Fernsehserie 1986"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
