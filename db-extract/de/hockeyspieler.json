                                "target_senses": [
                                    {
                                        "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                        "entry_id": "401dfa21-ccdd-3b16-82e7-368e85d18151",
                                        "glosses": [
                                            "Joueur de hockey, sport de glisse."
                                        ],
                                        "tags": [
                                            "Hockey sur glace"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "845e1828-fc64-4e64-ad91-1aa6cb0462bd",
                                                "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                                "text": "À la suite de leur match héroïque contre Caen, les excellents hockeyeurs bordelais Dupuy, Morand et Cloarec ont été sélectionnés pour aller à Paris dimanche jouer un match de sélection."
                                            },
                                            {
                                                "example_id": "6ee9cf58-3246-4d94-925f-8ee416e96dda",
                                                "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                                "text": "Ce soir, les Amis des Sports fêteront le hockeyeur Prieur, au cours d’un banquet qui aura lieu au restaurant Bernard, place de la Madeleine."
                                            },
                                            {
                                                "example_id": "793753b1-918e-4755-9def-e4bfd724ff0d",
                                                "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                                "text": "Grimonprez (Félix). Hockeyeur, né à Lille le 30 juin 1910. Le meilleur hockeyeur français de tous les temps. 52 fois international, il fut tué pendant la guerre 39-40."
                                            },
                                            {
                                                "example_id": "b5337f3e-33e1-4982-a207-8c0b70996afb",
                                                "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                                "text": "Samedi, sous les yeux du président Vladimir Poutine, les hockeyeurs russes se sont inclinés aux tirs au but face aux États-Unis."
                                            },
                                            {
                                                "example_id": "2ecfbd1f-6676-40d5-b1a2-e52317650faa",
                                                "sense_id": "67433c7b-f95f-3d1c-974e-34c8c9e04515",
                                                "text": "Aussi, Lafrenière n'est pas le premier hockeyeur choisi d'entrée de jeu du repêchage, ayant éprouvé des problèmes à ses premiers pas dans le circuits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
