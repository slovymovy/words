                        "entry_id": "8250df6a-5fbe-37b6-9ec0-59cbbf2961b8",
                        "glosses": [
                            "The state or characteristic of being finite; limitedness."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b33e2aaf-d261-4d4e-b987-b87aa6c11410",
                                "sense_id": "eecd137a-a122-31b5-addc-567c0deda89b",
                                "text": "Matter expresses the finitude of time-space; in this world of limitation a new way of knowing becomes possible, and this way is language."
                            },
                            {
                                "example_id": "276822e8-cf20-4792-aadd-6d149f92e84b",
                                "sense_id": "eecd137a-a122-31b5-addc-567c0deda89b",
                                "text": "A one-car life is one of finitude and limitations."
                            }
                        ]
                    }
                ],
