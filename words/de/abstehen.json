            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1afdada9-8a16-3638-9aca-2f89dd387dce",
                    "sense_definition": "Nicht eng am Körper oder Untergrund anliegen, sondern nach außen wegragen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine Haare <w>stehen</w> nach dem Schlafen wild in alle Richtungen <w>ab</w>."
                        },
                        {
                            "text": "Die neue Jacke gefällt mir nicht besonders, weil die Taschen unschön <w>abstehen</w>."
                        }
                    ],
                    "synonyms": [
                        "hervorstehen",
                        "abragen"
                    ],
                    "antonyms": [
                        "anliegen"
                    ],
                    "common_phrases": [
                        "weit abstehen",
                        "vom Kopf abstehen"
                    ]
                },
                {
                    "sense_id": "bc1145be-5d26-3998-8eef-5a5f4921ff7b",
                    "sense_definition": "Auf ein Vorhaben verzichten oder von einer Absicht Abstand nehmen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach gründlicher Überlegung <w>stand</w> die Firma schließlich von der geplanten Klage <w>ab</w>."
                        },
                        {
                            "text": "Wenn du von deinem Vorhaben <w>abstehst</w>, können wir eine friedliche Einigung erzielen."
                        }
                    ],
                    "synonyms": [
                        "absehen",
                        "verzichten"
                    ],
                    "antonyms": [
                        "durchführen",
                        "realisieren"
                    ],
                    "common_phrases": [
                        "von einer Klage abstehen",
                        "von einem Plan abstehen"
                    ]
                },
                {
                    "sense_id": "5163a675-f638-3a06-9e93-1307f07e048e",
                    "sense_definition": "Über längere Zeit unbewegt stehen und dadurch an Frische oder Kohlensäure verlieren.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn man das Mineralwasser offen stehen lässt, <w>steht</w> es schnell <w>ab</w>."
                        },
                        {
                            "text": "Für empfindliche Zimmerpflanzen sollte man das Leitungswasser erst einige Stunden <w>abstehen</w> lassen."
                        }
                    ],
                    "common_phrases": [
                        "Wasser abstehen lassen"
                    ]
                },
                {
                    "sense_id": "7e43a6b0-a4a7-39cc-89d1-18cd997c8757",
                    "sense_definition": "Von Pflanzen oder Pflanzenteilen: welken, vertrocknen oder absterben.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen der langanhaltenden Dürre <w>standen</w> die jungen Triebe der Bäume vorzeitig <w>ab</w>."
                        },
                        {
                            "text": "Wenn die Wurzeln faulen, beginnt die gesamte Pflanze allmählich <w>abzustehen</w>."
                        }
                    ],
                    "synonyms": [
                        "absterben",
                        "eingehen",
                        "verdorren"
                    ],
                    "antonyms": [
                        "gedeihen"
                    ]
                }
            ]
        }
