                    },
                    {
                        "translation_id": "d509c497-9aaf-4ffc-a85d-ac3d06eda291",
                        "source_entry_id": "fb9d339e-e038-36b4-b008-84bcade3c95d",
                        "source_sense_id": "62f3c14b-897b-3727-8364-89917c9bbceb",
                        "target_lang_word": "quick-and-dirty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quick-and-dirty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ebe35d0-74b0-3c60-b14b-82f6c65ad275",
                                        "entry_id": "757ed918-a3b8-3e6e-bfff-28e9c2828096",
                                        "glosses": [
                                            "Done or constructed in a hasty, approximate, temporarily adequate manner, but not exact, fully formed, or reliable for a long period of time."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9536eed-5b41-4d5b-8083-8f7a48f10686",
                                                "sense_id": "9ebe35d0-74b0-3c60-b14b-82f6c65ad275",
                                                "text": "I can do a quick-and-dirty market analysis in time for the meeting tomorrow."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quick-and-dirty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "962082ae-3b79-366d-afcb-e4a5c2d2524a",
                                        "entry_id": "59ec85f3-7178-3c50-b6f8-0cce7d15be59",
                                        "glosses": [
                                            "An inexpensive, inelegant eatery; a greasy spoon."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "547bd984-1f04-3002-834d-944eec757dcd",
                                        "entry_id": "59ec85f3-7178-3c50-b6f8-0cce7d15be59",
                                        "glosses": [
                                            "A quick, temporary fix, estimate, or the like."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31aa270-7f5f-4511-a16a-060702571962",
                                                "sense_id": "547bd984-1f04-3002-834d-944eec757dcd",
                                                "text": "The car broke down but we managed to do a quick-and-dirty and were back on the road in fifteen minutes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0319609-1ee7-428d-b54c-21e41c4f3347",
                        "source_entry_id": "fb9d339e-e038-36b4-b008-84bcade3c95d",
                        "source_sense_id": "62f3c14b-897b-3727-8364-89917c9bbceb",
                        "target_lang_word": "greasy spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greasy spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                        "entry_id": "7beb017f-3e17-3e84-8e37-8c572acc1e81",
                                        "glosses": [
                                            "An inexpensive diner or other informal restaurant, especially one specializing in frying or grilling."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb7ae2cf-1e0a-4df7-86dc-e8a761770c58",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "We found a good little greasy spoon down a side street."
                                            },
                                            {
                                                "example_id": "b082dc55-8cc0-4bd0-b6ff-219492cf3e35",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "I find that most gay men love to cook for others but would rather visit any greasy spoon than eat by themselves."
                                            },
                                            {
                                                "example_id": "e1ba1e59-dcae-4a61-8784-eac82e4098f0",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "From the highway, Phil's looked like any other greasy spoon inviting the weary traveler off the road for a little indigestion and a cup of coffee — the same red booths patched with black electrical tape and faded formica counters lined with chrome-sided stools, a glass pie pin near the cash register, and coffee served in thick white mugs."
                                            },
                                            {
                                                "example_id": "77f396d5-1300-404e-87f8-f14f8f82b7f9",
                                                "sense_id": "acfa32d5-6139-34b5-835b-c416d099e7e9",
                                                "text": "Reward yourself for a week of healthful eating with breakfast at a greasy spoon. Nutritionists say an occasional cheat meal can make it easier to stick with a healthy diet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
