                        "entry_id": "8188e860-a000-3876-9199-172812bf5ed8",
                        "glosses": [
                            "Vengeful; angry, furious."
                        ],
                        "tags": [
                            "obsolete",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "930b04b1-5a9c-4d58-b8af-c4f68730e865",
                                "sense_id": "9ff25f36-2ba9-339d-b6b2-0d595e5b0ff5",
                                "text": "Ne any liv'd on ground that durst withstand / His dreadfull heast, much lesse him match in fight, / Or bide the horror of his wreakfull hand […]."
                            },
                            {
                                "example_id": "d7031f9c-e042-4ea2-bd73-82ac5f5c0ba4",
                                "sense_id": "9ff25f36-2ba9-339d-b6b2-0d595e5b0ff5",
                                "text": "He sinks, to every wreakful fiend a prey; / His bosom shut to each affection kind; …"
                            },
                            {
                                "example_id": "2dbc6648-76d4-43ab-900c-5018aea9ef9b",
                                "sense_id": "9ff25f36-2ba9-339d-b6b2-0d595e5b0ff5",
                                "text": "Unpropp'd, unsuccoured by stake or tree, / From wreakful storms' impetuous tyranny, [...]"
                            }
                        ]
                    }
                ],
