                        "form": "зауря́де"
                    },
                    {
                        "form_id": "16ef8e03-5f8f-4711-8ba7-40c00eb954e8",
                        "entry_id": "37d5e48e-ca03-3e74-9c9f-af38c3353f16",
                        "tags": [
                            "plural",
