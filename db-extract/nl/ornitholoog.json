                "entry_id": "f04b6973-8f4c-3c6e-b576-d16ff0678aad",
                "word": "ornitholoog",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "cd35c60a-a9cf-443d-9dbe-018d2ade0bf5",
