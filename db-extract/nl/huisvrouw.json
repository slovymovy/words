                    {
                        "sense_id": "411f100b-8395-3603-aec5-2d0edbc0cd4a",
                        "entry_id": "c7455282-6342-3361-b20c-3234b6724c9e",
                        "glosses": [
                            "een vrouw die thuisblijft om het huishouden te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ffc79f-0cc8-4ea6-8286-1bbdac69c91d",
                                "sense_id": "411f100b-8395-3603-aec5-2d0edbc0cd4a",
                                "text": "Sinds een week bestaat-ie: de club van slechte huisvrouwen."
                            }
                        ]
