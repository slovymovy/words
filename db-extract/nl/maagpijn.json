                                                "sense_id": "651dd544-7890-37e4-88a0-1739b6208bf0",
                                                "text": "Er musste nach Hause gehen, weil er Magenschmerzen hatte."
                                            },
                                            {
                                                "example_id": "45518258-99c5-4f09-982e-2ce9ec149f29",
                                                "sense_id": "651dd544-7890-37e4-88a0-1739b6208bf0",
                                                "text": "„Der Infekt war zwar verschwunden, aber Magenschmerzen entstanden, die von Tag zu Tag immer heftiger wurden.“"
                                            },
                                            {
                                                "example_id": "4a070cbc-4e07-4b03-b243-7daae31079a1",
                                                "sense_id": "651dd544-7890-37e4-88a0-1739b6208bf0",
                                                "text": "„Jeden Tag stehe ich mit Magenschmerzen auf und gehe mit Magenschmerzen ins Bett.«“"
                                            },
                                            {
                                                "example_id": "c6481cae-d7ab-4d03-95cb-544b7603387c",
                                                "sense_id": "651dd544-7890-37e4-88a0-1739b6208bf0",
                                                "text": "„Die grässlichen Magenschmerzen und das Sodbrennen ließen schon vier Wochen später nach.“"
                                            }
