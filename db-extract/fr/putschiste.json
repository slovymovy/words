                                    {
                                        "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                        "entry_id": "fff6c776-fef1-38a3-9e93-f19e4e02f69e",
                                        "glosses": [
                                            "iemand die een staatsgreep pleegt of wil plegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0437929-e1ef-4324-8eee-61a69500626a",
                                                "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                                "text": "Volgens officiële cijfers zijn sinds de poging tot staatsgreep tweeënhalf jaar geleden in totaal ongeveer 218.000 mensen gearresteerd wegens vermeende connecties met de putschisten. Ongeveer 31.000 van hen zijn veroordeeld of zitten nog steeds in hechtenis."
                                            },
                                            {
                                                "example_id": "df97e549-538d-49c1-be11-d54809f2948b",
                                                "sense_id": "cd61c512-3424-3dae-bb39-a9ee106ee537",
                                                "text": "‘De Bolivaarse strijdkrachten staan voor een historische taak’, verklaarde president Maduro donderdag voor duizenden soldaten in Fort Tiuna in Caracas. ‘Soldaten van het vaderland, het uur van de strijd is aangebroken. We moeten het heilige vuur van de militaire waarden ontsteken om het imperialisme, de verraders en de putschisten op de knieën te dwingen’."
                                            }
                                        ]
                                    }
                                ]
                            }
