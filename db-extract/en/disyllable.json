                        "entry_id": "10dfdf73-55db-3bcc-95a1-3c22b9c37b0e",
                        "glosses": [
                            "A word comprising two syllables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7fea98c-a318-4003-b9c5-d2aedc80af00",
                                "sense_id": "335c8b83-da64-3e13-a35b-c76c04a00b42",
                                "text": "He felt as if the play itself penetrated him with the naked elbow of his neighbour, a great stripped, handsome, red-haired lady, who conversed with a gentleman on her other side in stray dissyllables which had for his ear, in the oddest way in the world, so much sound that he wondered they hadn't more sense; and he recognised by the same law, beyond the footlights, what he was pleased to take for the very flush of English life."
                            }
                        ]
                    }
                ],
