                            {
                                "example_id": "eb4f5ad8-a62e-49dd-8402-ac6da651c11c",
                                "sense_id": "48bb4db5-0bf7-33f3-8c1d-92327e5b45b9",
                                "text": "„Die Betonkästen sind voller vertrockneter Zweige und weggeworfener Medikamentenfläschchen, an einigen Stellen ragen auch Spritzen hervor.“"
                            },
                            {
                                "example_id": "2c537d34-145a-4d6b-98cd-8e81396a17e2",
                                "sense_id": "48bb4db5-0bf7-33f3-8c1d-92327e5b45b9",
                                "text": "„Vor ihm standen eine kleine, lauwarme und halb leere Champagnerflasche aus der Minibar sowie ein Medikamentenfläschchen mit Adderall.“"
                            }
                        ],
