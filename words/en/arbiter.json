                },
                {
                    "sense_id": "d59bd6d7-e00f-354c-a1d7-5df165a977ae",
                    "sense_definition": "A hardware component that manages access to shared resources in a computer system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus <w>arbiter</w> ensures that only one device communicates at a time."
                        },
                        {
                            "text": "A memory <w>arbiter</w> prevents conflicts when multiple processors request data simultaneously."
                        }
                    ]
                }
            ]
        },
        {
