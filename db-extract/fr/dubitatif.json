                        "source_entry_id": "088fe09a-7ce2-37af-9e8d-c5032859820a",
                        "target_lang_word": "skeptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skeptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "801a806a-0257-3bb0-9fb2-3bda1e992811",
                                        "entry_id": "42232f26-7b9a-3b42-87a8-131a11cbbfcc",
                                        "glosses": [
                                            "zum Zweifel geneigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6e2639-704b-486f-bad9-4af178b43145",
                                                "sense_id": "801a806a-0257-3bb0-9fb2-3bda1e992811",
                                                "text": "Der Vater war von Natur aus ein skeptischer Mensch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80e8aded-80a8-4478-9c3e-ecca47a3549d",
                        "source_entry_id": "088fe09a-7ce2-37af-9e8d-c5032859820a",
                        "target_lang_word": "dubious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dubious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                        "entry_id": "e58239b2-9a6a-31a8-a0f0-d9b042c946a2",
                                        "glosses": [
                                            "Arousing doubt; questionable; open to suspicion."
                                        ],
                                        "tags": [
                                            "of a statement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c99dae4-0823-4c4d-bbc1-6934093628a0",
                                                "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                                "text": "After he made some dubious claims about the company, fewer people trusted him."
                                            },
                                            {
                                                "example_id": "33cd62c6-fd7c-44ec-b643-9b72be91fd05",
                                                "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                                "text": "They were renowned as people of dubious morals."
                                            },
                                            {
                                                "example_id": "c1e4d6de-71ad-4b66-bf3d-b05b9477365d",
                                                "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                                "text": "There are several reasons why the line's future is now dubious. With the exception of Horsmonden, the stations are most inconveniently sited. This is largely because the Wealden villages were built on ridges, and in fact most Wealden stations are badly placed."
                                            },
                                            {
                                                "example_id": "b8c7effd-c8ef-489f-9d78-989c130e1bee",
                                                "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                                "text": "Evasive, womanising, boastful, malicious, untrustworthy, an inveterate gambler who combined his mediocre military career with running a high-class brothel, permanently cash strapped and viciously quarrelsome, his character is as dubious as his unsavoury appearance."
                                            },
                                            {
                                                "example_id": "6f136e20-7ff0-4300-bb41-7fcca7de49e4",
                                                "sense_id": "31af8b8b-80e9-3e2c-939c-449b0356c33a",
                                                "text": "Urban Dictionary records at least 66 of the terms found by the present research, but as this dictionary liberally accepts words, definitions, and sample sentences based solely on the say-so of contributors, in the absence of corroboration from other sources the authenticity of some entries must remain dubious."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a8c05f5-d6db-3d02-bebf-6d4ba0381f80",
                                        "entry_id": "e58239b2-9a6a-31a8-a0f0-d9b042c946a2",
                                        "glosses": [
                                            "In disbelief; wavering, uncertain, or hesitating in opinion; inclined to doubt; undecided."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae7b904-f193-4b6c-8c52-7e1c5f057189",
                                                "sense_id": "5a8c05f5-d6db-3d02-bebf-6d4ba0381f80",
                                                "text": "She was dubious about my plan at first, but later I managed to persuade her to cooperate."
                                            },
                                            {
                                                "example_id": "9646550a-e440-4aef-a10f-79b85ae1a99b",
                                                "sense_id": "5a8c05f5-d6db-3d02-bebf-6d4ba0381f80",
                                                "text": "Last year, President Obama had large majorities in Congress and hopes of passing a comprehensive climate and energy bill. Next year, he faces a new Congress much more dubious about the reality of climate change and considerably more hostile to international efforts to deal with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2f6615-f841-3351-99a9-6863ee8e2aec",
                                        "entry_id": "e58239b2-9a6a-31a8-a0f0-d9b042c946a2",
                                        "glosses": [
                                            "Generally considered imprecise or wrong, but not totally unplayable."
                                        ],
                                        "tags": [
                                            "of an opening move"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63ccc921-664d-4e70-bdb0-7958b2db19ec",
                        "source_entry_id": "088fe09a-7ce2-37af-9e8d-c5032859820a",
                        "target_lang_word": "sceptical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sceptical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d39149a2-9191-3b09-a2d4-22b2591f37b5",
                                        "entry_id": "9934267b-8e6c-3ef7-bd0f-6977be3db581",
                                        "glosses": [
                                            "Commonwealth standard spelling of skeptical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42b79e3c-3245-47d7-946f-aedfc8a57517",
                                                "sense_id": "d39149a2-9191-3b09-a2d4-22b2591f37b5",
                                                "text": "But regardless of what they made of phrenology, those who saw craniometry as a means of measuring the relative weight of intelligence and emotion in psychological makeup were generally sceptical as to whether, as Blumenbach and Camper believed, humanity had branched from one ancestral pair into varietal types as a result of colonising different continents."
                                            },
                                            {
                                                "example_id": "e77be4bc-1005-4810-b6f7-22375b25375d",
                                                "sense_id": "d39149a2-9191-3b09-a2d4-22b2591f37b5",
                                                "text": "And according to Hughes, HM Treasury is still sceptical about rail electrification. \"It's not because they don't see electrification as a good thing, but I think when you look at it from the UK-wide perspective, if you have £x billion to spend on decarbonisation, you don't necessarily start with rail. Rail's not where you get the biggest bang for the buck in terms of decarbonisation.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e51ba3f5-dd37-4196-92c9-1a5594834973",
                        "source_entry_id": "088fe09a-7ce2-37af-9e8d-c5032859820a",
                        "target_lang_word": "skeptical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skeptical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffc08d4-b577-3294-90ed-696235d049f6",
                                        "entry_id": "22a7a7c5-8f93-371b-9041-80954cb2f4ac",
                                        "glosses": [
                                            "Having, or expressing doubt; questioning."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfabf504-ae63-4c1c-a93d-0e02b8305068",
                                                "sense_id": "0ffc08d4-b577-3294-90ed-696235d049f6",
                                                "text": "My teacher was skeptical when I told her my dog ate my homework."
                                            },
                                            {
                                                "example_id": "eb010ed7-5677-4dc6-a6a3-6c9fff07a0ed",
                                                "sense_id": "0ffc08d4-b577-3294-90ed-696235d049f6",
                                                "text": "Tom was skeptical when Paul told him that he saw Bigfoot."
                                            },
                                            {
                                                "example_id": "55f9f6da-eb7c-4ed1-a935-62d71fe0e436",
                                                "sense_id": "0ffc08d4-b577-3294-90ed-696235d049f6",
                                                "text": "I can see why people are so skeptical [sic] about him, but I think he's on to something here."
                                            },
                                            {
                                                "example_id": "5646bfcd-39b0-4fac-8ccb-b4bf20f1e153",
                                                "sense_id": "0ffc08d4-b577-3294-90ed-696235d049f6",
                                                "text": "Numerous experimental tests and other observations have been offered in favor of animal mind reading, and although many scientists are skeptical, others assert that humans are not the only species capable of representing what others do and don’t perceive and know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8427559d-f023-3b40-ab57-c5c058b38f4f",
                                        "entry_id": "22a7a7c5-8f93-371b-9041-80954cb2f4ac",
                                        "glosses": [
                                            "Of or relating to philosophical skepticism or the skeptics."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
