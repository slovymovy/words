                        "glosses": [
                            "Ensemble des branches d’un arbre."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "09ee5cb4-5541-422d-96fc-62cf5e8bdedb",
                                "sense_id": "b7b16a0f-b4b6-3ccf-8367-c2f20c327a47",
                                "text": "Les ténèbres étaient profondes. Je ne voyais rien devant moi, ni autour de moi, et toute la branchure des arbres entre-choqués emplissait la nuit d'une rumeur incessante."
                            },
                            {
                                "example_id": "72171270-bb07-4096-8a57-7f07ee960fd5",
                                "sense_id": "b7b16a0f-b4b6-3ccf-8367-c2f20c327a47",
                                "text": "La branchure du chêne couvre une grande place herbue et il y faisait si noir que je ne voyais point mes pieds."
                            }
                        ]
                    }
