                        "cross_references": [
                            {
                                "target_word": "deinonychus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d538310b-47dd-3aef-b312-4e8d718673be",
                                        "entry_id": "4e5abc5e-34e9-32ff-aff6-32855447d6d6",
                                        "glosses": [
                                            "A medium agile dinosaur, of the genus Deinonychus, of the Cretaceous period, characterized by having a large, curved claw on each hind foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcd23178-4812-4e3f-b5e5-5b5ff59a8b5f",
                                                "sense_id": "d538310b-47dd-3aef-b312-4e8d718673be",
                                                "text": "The first attempts were made on the remains of duckbill dinosaurs found in the Coleville River dig, but the real success was made when the University located the remains of three deinonychi at an Amoco drill site on the Alaskan North Slope."
                                            },
                                            {
                                                "example_id": "07909b17-d237-43df-9417-c6228ffe190d",
                                                "sense_id": "d538310b-47dd-3aef-b312-4e8d718673be",
                                                "text": "Bella kept half an eye out for the deinonychi. The deinonychus dinosaurs with the teeth and raking claws were big solid humans in the real."
                                            },
                                            {
                                                "example_id": "cdca6491-3460-4f13-9503-2208b2931928",
                                                "sense_id": "d538310b-47dd-3aef-b312-4e8d718673be",
                                                "text": "In that chamber, lying curled, or sitting hunched, were five saurians: two deinonychi and three smaller ones that looked like some kind of miniature tyrannosaur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
