                                        "entry_id": "5f2e10db-6b5f-3845-961f-3b5d80cff3e1",
                                        "glosses": [
                                            "künstlerisches Genre, das sich mit utopischen, dystopischen und futuristischen Ereignissen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b176c73-de3c-4b12-9da4-523808abdae4",
                                                "sense_id": "e4cc0474-811b-39fd-9692-a0b6e3132ef8",
                                                "text": "Ich liebe Science-Fiction."
                                            },
                                            {
                                                "example_id": "975a8594-48aa-4794-9807-d771eb1941ce",
                                                "sense_id": "e4cc0474-811b-39fd-9692-a0b6e3132ef8",
                                                "text": "„Ben hatte unzählige Krimis gesammelt und bunte Paperbacks mit Covern, die nach Fantasy und Science-Fiction aussahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8337cf4-644d-448b-9382-6727994ef9cf",
