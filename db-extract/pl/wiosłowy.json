                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b564f0d-0773-4353-8a0b-f203f77dd6d0",
                                                "sense_id": "85c975cb-6c50-3503-904d-b8a1cad21a70",
                                                "text": "She and Ricketts — that's his father — just disgraced the neighbourhood with their rowings and their sprees […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0e2e33a-c3f2-4e47-94ec-2bdc451b2834",
                        "source_entry_id": "88f0adf2-dd30-3eea-b4df-0e8439e9b374",
                        "source_sense_id": "7cf12b62-919e-3d76-a885-cc2bd0406b02",
                        "target_lang_word": "Ruder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f34c948-e5b8-3813-8b6d-effeb9ef1455",
                                        "entry_id": "04e24138-691b-35d8-866a-b2efcc76e585",
                                        "glosses": [
                                            "unten blattförmig erweiterte Stange zum Fortbewegen eines Bootes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2451b76-61ac-48cd-b2f6-b8e36c912c63",
                                                "sense_id": "3f34c948-e5b8-3813-8b6d-effeb9ef1455",
                                                "text": "Leider hatten sie ein Ruder verloren und waren daher nicht mehr konkurrenzfähig."
                                            },
                                            {
                                                "example_id": "9b2e66a0-c9f8-41f3-8913-2b810cd8b298",
                                                "sense_id": "3f34c948-e5b8-3813-8b6d-effeb9ef1455",
                                                "text": "„Ich verließ Korfu bei Einbruch der Nacht und kam am frühen Morgen in Otranto an, ohne daß meine Ruderer auch nur einmal ihre Ruder eintauchten.“"
                                            },
                                            {
                                                "example_id": "ddb8913c-771a-462c-aba1-9559631680a7",
                                                "sense_id": "3f34c948-e5b8-3813-8b6d-effeb9ef1455",
                                                "text": "„Nichts konnte der Geschicklichkeit und Grazie gleichkommen, mit der die Mädchen ihre Ruder handhabten.“"
                                            },
                                            {
                                                "example_id": "d881b5fd-904d-449d-b030-343fad08fdf8",
                                                "sense_id": "3f34c948-e5b8-3813-8b6d-effeb9ef1455",
                                                "text": "„Während der Stock für die Wanderschaft zu Lande bestimmt ist, dient das Ruder bei Fahrten auf dem Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b16f762-1e55-3dd7-9a9f-3d5574aca54f",
                                        "entry_id": "04e24138-691b-35d8-866a-b2efcc76e585",
                                        "glosses": [
                                            "Vorrichtung, um ein Schiff oder Flugzeug zu steuern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ec8d428-bcb2-4d48-9a54-c52b218ef2d5",
                                                "sense_id": "8b16f762-1e55-3dd7-9a9f-3d5574aca54f",
                                                "text": "„Manövriert werden die Boote mit einem Ruder, das am rechten Rumpfende befestigt ist - bis heute nennen Seeleute diese Seite deshalb »Steuerbord«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "14068cd1-36f0-3420-ba45-86873141ae11",
                                        "entry_id": "04e24138-691b-35d8-866a-b2efcc76e585",
                                        "glosses": [
                                            "die Füße der Schwimmvögel"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d28ee526-24b0-38a3-aa0f-902e94bd9ae5",
                                        "entry_id": "04e24138-691b-35d8-866a-b2efcc76e585",
                                        "glosses": [
                                            "bestimmende Einflussmöglichkeit"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
