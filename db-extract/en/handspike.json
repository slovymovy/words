                "entry_id": "21a176ac-08c8-31c1-8ba0-c69f4cb34e70",
                "word": "handspike",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4e11dfec-ec81-4761-967f-306514270611",
                        "entry_id": "21a176ac-08c8-31c1-8ba0-c69f4cb34e70",
