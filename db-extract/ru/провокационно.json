                                                "example_id": "51162d0d-9be9-4826-8e02-469cd9e3c77f",
                                                "sense_id": "11bad75b-1bdf-3599-a1a5-5143190f64e0",
                                                "text": "Scottie, a precocious 10-year old,^([sic]) wears provocatively sloganed T-shirts and harasses her peers by text message."
                                            }
