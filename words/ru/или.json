{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "3488b161-2bc9-3678-9bdd-9bf9787a16fd",
                    "sense_definition": "Союз, выражающий необходимость выбора между двумя или несколькими возможностями, предметами или действиями.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты хочешь выпить чай <w>или</w> кофе?",
                            "target_lang_translations": {
                                "en": "Do you want to drink tea <w>or</w> coffee?",
                                "zh": "你想喝茶<w>还是</w>咖啡？"
                            }
                        },
                        {
                            "text": "Мы можем пойти в кино <w>или</w> остаться дома.",
                            "target_lang_translations": {
                                "en": "We can go to the cinema <w>or</w> stay home.",
                                "zh": "我们可以去看电影，<w>或者</w>待在家里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "либо"
                    ],
                    "antonyms": [
                        "и"
                    ],
                    "common_phrases": [
                        "да или нет",
                        "сейчас или никогда",
                        "сегодня или завтра",
                        "чай или кофе"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction expressing the necessity of choosing between two or more possibilities, items, or actions.",
                        "zh": "用于连接两个或多个选项，表示选择关系。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "or",
                                "target_lang_sense_clarification": "conjunction for alternatives"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "或者",
                                "target_lang_sense_clarification": "用于陈述句中的选择"
                            },
                            {
                                "target_lang_word": "还是",
                                "target_lang_sense_clarification": "用于疑问句中的选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ae805da-dded-3a8e-951a-ed4e6bc2652b",
                    "sense_definition": "Употребляется как повторяющийся союз (или ... или) для подчеркивания взаимоисключающего выбора.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам нужно решить: <w>или</w> мы едем сейчас, <w>или</w> остаёмся здесь.",
                            "target_lang_translations": {
                                "en": "We need to decide: <w>either</w> we go now, or we stay here.",
                                "zh": "我们需要决定：<w>要么</w>现在就走，<w>要么</w>留在这里。"
                            }
                        },
                        {
                            "text": "В магазине были <w>или</w> очень дорогие, <w>или</w> совсем плохие вещи.",
                            "target_lang_translations": {
                                "en": "The shop had <w>either</w> very expensive or very bad things.",
                                "zh": "店里的东西<w>要么</w>非常贵，<w>要么</w>质量很差。"
                            }
                        }
                    ],
                    "synonyms": [
                        "либо"
                    ],
                    "common_phrases": [
                        "или пан или пропал",
                        "или то или это",
                        "или я или он"
                    ],
                    "target_lang_definitions": {
                        "en": "Used as a repeating conjunction (either ... or) to emphasize a mutually exclusive choice.",
                        "zh": "重复使用，强调在两者中必须做出排他性选择。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "either ... or",
                                "target_lang_sense_clarification": "correlative conjunction"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "要么……要么……",
                                "target_lang_sense_clarification": "表示非此即彼的选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "509523d8-2b50-3f7e-af0a-e295dc8bf088",
                    "sense_definition": "Союз, указывающий на угрозу или негативные последствия в случае невыполнения условия (в значении «иначе», «а то»).",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "consequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Надень тёплую шапку, <w>или</w> ты простудишься.",
                            "target_lang_translations": {
                                "en": "Put on a warm hat, <w>or</w> you will catch a cold.",
                                "zh": "戴上暖和的帽子，<w>不然</w>你会感冒的。"
                            }
                        },
                        {
                            "text": "Поторапливайся, <w>или</w> мы опоздаем на автобус.",
                            "target_lang_translations": {
                                "en": "Hurry up, <w>or</w> we will be late for the bus.",
                                "zh": "快点，<w>否则</w>我们要赶不上公交车了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "иначе",
                        "а то"
                    ],
                    "common_phrases": [
                        "кошелёк или жизнь",
                        "руки вверх или стреляю"
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction indicating a threat or negative consequences if a condition is not met (meaning 'otherwise', 'or else').",
                        "zh": "表示如果不采取某种行动，就会产生负面后果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "or",
                                "target_lang_sense_clarification": "indicating negative consequence"
                            },
                            {
                                "target_lang_word": "otherwise",
                                "target_lang_sense_clarification": "if not"
                            },
                            {
                                "target_lang_word": "or else",
                                "target_lang_sense_clarification": "indicating threat"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不然",
                                "target_lang_sense_clarification": "表示否则"
                            },
                            {
                                "target_lang_word": "否则",
                                "target_lang_sense_clarification": "表示如果不这样"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a715d697-e9dd-3f88-8db3-70ccc27f2824",
                    "sense_definition": "Союз, присоединяющий пояснение или другое название того же понятия (в значении «то есть», «иначе говоря»).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бегемот, <w>или</w> гиппопотам, обитает в Африке.",
                            "target_lang_translations": {
                                "en": "The hippo, <w>or</w> hippopotamus, lives in Africa.",
                                "zh": "河马，<w>即</w>海马，生活在非洲。"
                            }
                        },
                        {
                            "text": "Лингвистика, <w>или</w> языкознание, изучает структуру языков.",
                            "target_lang_translations": {
                                "en": "Linguistics, <w>or</w> language science, studies the structure of languages.",
                                "zh": "语言学，<w>也就是</w>研究语言的科学，探讨语言的结构。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A conjunction joining an explanation or another name for the same concept (meaning 'that is', 'in other words').",
                        "zh": "用于引出同一概念的另一种称呼或解释。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "or",
                                "target_lang_sense_clarification": "introducing an equivalent name"
                            },
                            {
                                "target_lang_word": "aka",
                                "target_lang_sense_clarification": "also known as"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "即",
                                "target_lang_sense_clarification": "用于解释说明"
                            },
                            {
                                "target_lang_word": "也就是",
                                "target_lang_sense_clarification": "用于同义替换"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9b2626b1-c9f0-3ac6-a23f-da820ded954a",
                    "sense_definition": "Частица, используемая в начале вопросительного предложения для выражения удивления, сомнения или неуверенности (в значении «разве», «неужели»).",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Или</w> ты не хочешь пойти с нами в кино?",
                            "target_lang_translations": {
                                "en": "<w>Or</w> do you not want to go to the cinema with us?",
                                "zh": "<w>难道</w>你不想和我们一起去看电影吗？"
                            }
                        },
                        {
                            "text": "<w>Или</w> я не прав в своих рассуждениях?",
                            "target_lang_translations": {
                                "en": "<w>Or</w> am I wrong in my reasoning?",
                                "zh": "<w>难道</w>我的推论不对吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "или ты не знаешь",
                        "или я ошибаюсь"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разг."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A particle used at the beginning of an interrogative sentence to express surprise, doubt, or uncertainty (meaning 'really', 'is it possible that').",
                        "zh": "用于疑问句开头，表示惊讶、怀疑或反问。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "or",
                                "target_lang_sense_clarification": "sentence-initial particle expressing doubt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难道",
                                "target_lang_sense_clarification": "用于反问句表示怀疑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9b8e23bd-7712-38fd-890d-48b297c66146",
                    "sense_definition": "Река, протекающая по территории Китая и Казахстана.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "Река <w>Или</w> впадает в крупное озеро Балхаш.",
                            "target_lang_translations": {
                                "en": "The <w>Ili</w> River flows into the large Lake Balkhash.",
                                "zh": "<w>伊犁河</w>注入大型湖泊巴尔喀什湖。"
                            }
                        },
                        {
                            "text": "Туристы любят сплавляться по реке <w>Или</w> летом.",
                            "target_lang_translations": {
                                "en": "Tourists love rafting on the <w>Ili</w> River in summer.",
                                "zh": "游客们夏天喜欢在<w>伊犁河</w>上漂流。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A river flowing through the territory of China and Kazakhstan.",
                        "zh": "流经中国和哈萨克斯坦的一条河流。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Ili",
                                "target_lang_sense_clarification": "river name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伊犁河",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9917320d-c972-303b-8fca-93b6e16e371c",
                    "sense_definition": "Фамилия.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "В списке приглашённых гостей была фамилия <w>Или</w>.",
                            "target_lang_translations": {
                                "en": "The surname <w>Ili</w> was on the list of invited guests.",
                                "zh": "受邀嘉宾名单里有<w>伊利</w>这个姓氏。"
                            }
                        },
                        {
                            "text": "Господин <w>Или</w> выступил с докладом на конференции.",
                            "target_lang_translations": {
                                "en": "Mr. <w>Ili</w> gave a presentation at the conference.",
                                "zh": "<w>伊利</w>先生在会议上做了报告。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A surname.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Ili",
                                "target_lang_sense_clarification": "surname"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伊利",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}