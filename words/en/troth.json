    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea491da9-ab51-3578-9965-fc353ec75009",
                    "sense_definition": "A solemn promise or pledge, especially to marry someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young knight promised to plight his <w>troth</w> under the ancient oak before leaving for war.",
                            "target_lang_translations": {
                                "es": "El joven caballero prometió empeñar su <w>palabra</w> bajo el viejo roble antes de partir a la guerra."
                            }
                        },
                        {
                            "text": "They exchanged handmade rings to plight their <w>troth</w> in secret.",
                            "target_lang_translations": {
                                "es": "Intercambiaron anillos hechos a mano para sellar sus <w>votos</w> en secreto."
                            }
                        }
                    ],
                    "synonyms": [
                        "pledge",
                        "betrothal",
                        "vow"
                    ],
                    "common_phrases": [
                        "plight one's troth",
                        "pledge troth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Promesa solemne o voto formal, especialmente de matrimonio."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "voto",
                                "target_lang_sense_clarification": "promesa solemne"
                            },
                            {
                                "target_lang_word": "promesa",
                                "target_lang_sense_clarification": "compromiso formal"
                            },
                            {
                                "target_lang_word": "palabra de honor",
                                "target_lang_sense_clarification": "compromiso inquebrantable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13d0c6c2-4065-354b-9b6e-e20e5938d018",
                    "sense_definition": "Faith, fidelity, or an oath of allegiance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By my <w>troth</w>, I have never seen such courage in the face of certain defeat.",
                            "target_lang_translations": {
                                "es": "Por mi <w>fe</w>, nunca he visto tal valentía ante una derrota segura."
                            }
                        },
                        {
                            "text": "The warrior refused to break his <w>troth</w> to the king.",
                            "target_lang_translations": {
                                "es": "El guerrero se negó a romper su <w>lealtad</w> al rey."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidelity",
                        "faithfulness",
                        "oath"
                    ],
                    "antonyms": [
                        "betrayal",
                        "treachery"
                    ],
                    "common_phrases": [
                        "by my troth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Lealtad, fidelidad o juramento de lealtad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fidelidad",
                                "target_lang_sense_clarification": "lealtad constante"
                            },
                            {
                                "target_lang_word": "lealtad",
                                "target_lang_sense_clarification": "compromiso o fidelidad hacia alguien"
                            },
                            {
                                "target_lang_word": "fe",
                                "target_lang_sense_clarification": "palabra dada o juramento"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fca0ed80-c5a7-34c8-90de-c16a9bafb23e",
                    "sense_definition": "The state of being formally pledged to marry; betrothal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose an honorable path and restored the maiden her <w>troth</w>.",
                            "target_lang_translations": {
                                "es": "Eligió un camino honorable y liberó a la doncella de su <w>compromiso</w>."
                            }
                        },
                        {
                            "text": "The broken agreement ended her <w>troth</w> and left her free to marry another.",
                            "target_lang_translations": {
                                "es": "El acuerdo roto puso fin a sus <w>esponsales</w> y la dejó libre para casarse con otro."
                            }
                        }
                    ],
                    "synonyms": [
                        "betrothal",
                        "engagement"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Estado de estar comprometido formalmente para casarse; esponsales o noviazgo formal."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "esponsales",
                                "target_lang_sense_clarification": "compromiso matrimonial formal"
                            },
                            {
                                "target_lang_word": "compromiso",
                                "target_lang_sense_clarification": "acuerdo formal de matrimonio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c193a8d-e3ed-3a72-926b-1dd09b132032",
                    "sense_definition": "Truth or reality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "truth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with such conviction that no one could doubt the <w>troth</w> of his words.",
                            "target_lang_translations": {
                                "es": "Habló con tanta convicción que nadie pudo dudar de la <w>verdad</w> de sus palabras."
                            }
                        },
                        {
                            "text": "In all <w>troth</w>, the travelers did not anticipate the harsh winter storm.",
                            "target_lang_translations": {
                                "es": "A decir <w>verdad</w>, los viajeros no anticiparon la feroz tormenta de invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "truth",
                        "verity"
                    ],
                    "antonyms": [
                        "falsehood",
                        "lie"
                    ],
                    "common_phrases": [
                        "in troth"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Verdad, veracidad o realidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "verdad",
                                "target_lang_sense_clarification": "conformidad con la realidad"
                            },
                            {
                                "target_lang_word": "veracidad",
                                "target_lang_sense_clarification": "cualidad de veraz"
                            }
                        ]
                    }
                }
            ]
        },
        {
