                "senses": [
                    {
                        "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                        "entry_id": "6e32e5c0-5a78-3e04-babd-8ef8d463fa89",
                        "glosses": [
                            "Gressin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7deb7096-db97-45db-a19c-0bc490b6a75f",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "Pouvez-vous me porter des grissini, s’il vous plaît ?"
                            },
                            {
                                "example_id": "bc5bbb83-acd9-4e10-a954-2454e97617e2",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "On y vent du pain, des biscotti (biscuits sablés), des taralli, des grissini, de la focaccia."
                            },
                            {
                                "example_id": "8ab38f0f-ce58-440e-bcbb-0301419cf443",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "Parmi les spécialités : […] du pain rassi ou des grissinis et de la tomme dans un bouillon de poule […]."
                            },
                            {
                                "example_id": "405a2d6e-8988-43b9-9425-8721fd980097",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "Les charcuteries sont irrésistibles, parfumées et coupées finement pour se déguster autour de grissinis."
                            },
                            {
                                "example_id": "760051e3-4f09-4d23-87fc-b682cf4f6a23",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "Boshoff retourne à la cible, pendant que les gars discutent de ses méthodes, se disputent les miettes du grissini et essayent le casse-noix."
                            },
                            {
                                "example_id": "3792182b-0a4d-4af4-a334-ded63278eff5",
                                "sense_id": "9aabf256-61a5-35ae-a969-2d7b16568ccd",
                                "text": "Ils enfournent, c’est-à-dire qu’ils passent au four chaud cette pelle couverte de grissini, les surveillent, et les retirent aussitôt qu’ils ont atteint le degré convenable de cuisson."
                            }
                        ]
                    }
