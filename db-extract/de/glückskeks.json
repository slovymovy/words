                                        "sense_id": "4006bf75-f956-31ef-9043-acd0697b569c",
                                        "entry_id": "8a0216c0-401b-3c34-917b-acf3972f0a8c",
                                        "glosses": [
                                            "A type of hollow snack, common in westernized Chinese cuisine: a crisp sugary wafer containing a message on a narrow strip of paper, generally with a wise or vaguely prophetic message or random numbers usable in a lottery printed on the paper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2d07ed-f9de-470c-9fdd-1950244d3262",
                                                "sense_id": "4006bf75-f956-31ef-9043-acd0697b569c",
                                                "text": "I read my future in a fortune cookie / Without any safety procedure in mind"
                                            },
                                            {
                                                "example_id": "e5935f7b-5b01-4ad0-a6b3-aead79c47b5c",
                                                "sense_id": "4006bf75-f956-31ef-9043-acd0697b569c",
                                                "text": "“The Chinese restaurant code. It states that the fortune cookie is not to be taken lightly. Now what do you mean to be doing with this fortune cookie anyway, lad?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7633dc0b-b869-3fe8-a2dd-cc975bec39ba",
                                        "entry_id": "8a0216c0-401b-3c34-917b-acf3972f0a8c",
                                        "glosses": [
                                            "A quote-of-the-day feature (especially on *nix systems.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31a59d54-6eea-3b30-829b-6b444db54647",
                                        "entry_id": "8a0216c0-401b-3c34-917b-acf3972f0a8c",
                                        "glosses": [
                                            "In the furry fandom, the vulva of canine species. Named so due to its resemblance to the snack."
                                        ],
