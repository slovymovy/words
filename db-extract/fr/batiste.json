        "fr-extract.jsonl": [
            {
                "entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                "word": "batiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9f067856-a56e-40bd-9c2b-9366499cecad",
                        "entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                        "tags": [
                            "plural"
                        ],
                        "form": "batistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                        "entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                        "glosses": [
                            "Espèce de toile de lin ou de chanvre très fine et d’un tissu très serré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e892189-5219-493c-8278-18e245f4ce9a",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Mademoiselle de Langeais ouvrit la boîte, y trouva un mouchoir de batiste très-fine, souillé de sueur."
                            },
                            {
                                "example_id": "25b7c230-26d5-4065-ac5f-f38785bf6e60",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Une des recherches de leur luxe est encore d’avoir un très beau mouchoir de batiste brodé garni de dentelles."
                            },
                            {
                                "example_id": "7464e816-3998-4b88-a106-a8127225dc48",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Il appuya sa tête livide sur l’épaule de la jeune femme, et ses doigts crispés se cramponnèrent, en la déchirant, à la fine batiste brodée qui couvrait d’un flot de gaze le corps de Marguerite."
                            },
                            {
                                "example_id": "3077a50c-123e-40e9-b4e4-31cfbce53251",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Ses doigts passionnés éprouvaient des jouissances physiques à courir sur les satins, à toucher les crêpes, à caresser les velours, à se perdre dans les flots laiteux des fines batistes."
                            },
                            {
                                "example_id": "8f9a6583-5de5-41d1-a792-6745922dc787",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Les nuées se déchirèrent comme un voile de batiste, et les flots joyeux du soleil inondèrent la montagne entièrement repeinte à neuf."
                            },
                            {
                                "example_id": "6ed464ef-dc0b-453e-959b-c22751bd705c",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Elle chiffonne toujours dans sa main un petit mouchoir de batiste…"
                            },
                            {
                                "example_id": "419cdd3d-4afd-4e6a-bcb3-2fb243d5b554",
                                "sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                                "text": "Étendue sur le lit de batiste, vêtue d’une légère combinaison de soie, la señorita Lynch était d’une beauté interminable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83de752a-a6a3-47bd-a1cc-2397fab0555b",
                        "source_entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                        "source_sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                        "target_lang_word": "Batist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Batist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                        "entry_id": "a2f4cc51-14af-3de1-ba22-bf41596c1b65",
                                        "glosses": [
                                            "sehr feinfädiges Gewebe, meist aus Baumwolle oder Leinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15a94e9-f3b2-47c6-b3bb-dc8418be8270",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "Sie trug ein Nachthemd aus Batist."
                                            },
                                            {
                                                "example_id": "af896e69-b716-44b0-9b2d-6a79fcbc36ca",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "„Seine Gattin Väsele Li trug – es war Sommer – ihr Haar aufgebunden und mit silbernen Fäden durchflochten und Ohrringe aus Rosenquarz in Goldfassung, dazu ein taubenfarbenes ungefüttertes Jäckchen und ein Röckchen aus weißem Batist, das mit einer längs gestreiften Borte eingefaßt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc6b2e46-4f2e-41e1-a1d9-cc90855e530c",
                        "source_entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                        "source_sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                        "target_lang_word": "cambric",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cambric",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                        "entry_id": "bd8e89b0-781d-3d1a-972d-7b0032395b48",
                                        "glosses": [
                                            "A finely-woven fabric made originally from linen but often now from cotton."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eebd4cf0-f220-4e17-b4d7-31379ccbaacb",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "Could a Taff'ta ſcarf, a long Eſtridge vvhing, / A ſtiffe Iron Doublet, and a Brazeel Pole / Tempt thee from Cambrick ſheets, fine active Thighs, / From Caudles vvhere the precious Amber ſvvims?"
                                            },
                                            {
                                                "example_id": "2ac48999-ea71-4178-ae0d-e5f0c0fef65d",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "Scotch cambric, now largely manufactured, is a kind of imitation cambric, made from fine hard-twisted cotton."
                                            },
                                            {
                                                "example_id": "20624729-bd1a-4c84-b143-c58cc3f252c7",
                                                "sense_id": "23bff8ad-3dee-38ca-afa3-99626b856140",
                                                "text": "His upper tunic was of white cambric, as fine as a handkerchief, so that the bright red tunic beneath it showed through."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7029c56d-a00e-4324-8194-697860525969",
                        "source_entry_id": "2ef107cd-3360-326c-b8e8-d12395011804",
                        "source_sense_id": "06b6a23c-27c4-387d-8434-c1e3fff74d25",
                        "target_lang_word": "lawn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lawn",
                                "target_lang_code": "en",
