                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c9e1a8-8c5e-48cf-86a0-775c983a4716",
                                "sense_id": "0be38725-304b-312a-a873-61b608a3dd4a",
                                "text": "Un objectif majeur de la rencontre de Bamako est de finaliser le programme de formation en master de paludologie, dans le cadre de l’école ouest-africaine de paludologie."
                            },
                            {
                                "example_id": "b79a0e3a-62f8-43d5-8a78-bcbec39aba32",
                                "sense_id": "0be38725-304b-312a-a873-61b608a3dd4a",
                                "text": "«Il est possible d’éliminer la malaria, première cause de mortalité en RDC», a déclaré le professeur Labana, recteur de l’université de Kinshasa dans l’entretien qu’il a accordé à Radio Okapi à l’occasion des travaux du 1ᵉʳ cours international de paludologie qui se tient à Kinshasa."
                            }
                        ]
