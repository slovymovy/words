                "senses": [
                    {
                        "sense_id": "48d484e2-3cab-3aea-8446-900048bcec3a",
                        "entry_id": "3bd95d68-f22c-3b61-aa70-a2763e748f71",
                        "glosses": [
                            "Gott der Liebe"
                        ],
                        "tags": [
                            "römische Mythologie"
                        ],
                        "examples": [
                            {
                                "example_id": "842b3d61-9234-4d30-b3b2-4a1a565e70af",
                                "sense_id": "48d484e2-3cab-3aea-8446-900048bcec3a",
                                "text": "Amor wird meistens als halbwüchsiger Knabe dargestellt."
                            },
                            {
                                "example_id": "b084ada2-457f-438a-8ac0-3b49ab41c361",
                                "sense_id": "48d484e2-3cab-3aea-8446-900048bcec3a",
                                "text": "„Sie versicherte mir, ich sähe aus wie Amor selbst, und mein Vater würde zweifellos vor Freude außer sich geraten, wenn er mich erblicke.“"
                            },
                            {
                                "example_id": "f256fc96-a8a2-4a10-af75-bc11c338b3ad",
                                "sense_id": "48d484e2-3cab-3aea-8446-900048bcec3a",
                                "text": "„Sie wolle Amor beschwören, um zu erfahren, wie wir diese zusammen verbringen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
