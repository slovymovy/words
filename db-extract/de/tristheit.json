                "senses": [
                    {
                        "sense_id": "8b7d2c8b-f38b-35db-bc38-b47e407a5a60",
                        "entry_id": "39fd7279-b5e2-35e6-a114-db169a20ffb9",
                        "glosses": [
                            "Eigenschaft/Verfassung, traurig oder öde zu sein, zu wirken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48789524-d48a-4f03-be9f-551de2a07039",
                                "sense_id": "8b7d2c8b-f38b-35db-bc38-b47e407a5a60",
                                "text": "„Ihre schlimmste Erfahrung war, dass ihr Leben in Tristheit ertrank, aber das ließ niemanden aufhorchen, so ging es doch unendlich vielen genauso.“"
                            },
                            {
                                "example_id": "c578899a-1fd2-4fa3-bc28-aec8b5402669",
                                "sense_id": "8b7d2c8b-f38b-35db-bc38-b47e407a5a60",
                                "text": "„Sie fuhren durch ein Wohngebiet mit uniform ähnlichen Gebäudefassaden, alle gleich hoch und von gleich trauriger Tristheit.“"
                            },
                            {
                                "example_id": "9dfbb46b-96cd-4efe-a82e-fcb61044d802",
                                "sense_id": "8b7d2c8b-f38b-35db-bc38-b47e407a5a60",
                                "text": "„In all der Tristheit aus Beton, Dreck und müffelndem Kram leuchtet uns die polierte Stahltür geradezu entgegen, die unsere schwach erleuchtete Hologrammfreundin schwammig zu spiegeln versucht.“"
                            },
                            {
                                "example_id": "151f21d8-902a-40e9-8aae-1f473f7e7e5b",
                                "sense_id": "8b7d2c8b-f38b-35db-bc38-b47e407a5a60",
                                "text": "„Die Gegend war einsam und von einer Tristheit, die bei einem sensiblen Menschen Beklemmung hervorrufen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
