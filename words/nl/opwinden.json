{
    "word_family": [
        "opwinding",
        "opwindend",
        "opgewondenheid",
        "windas"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5982fbca-ee33-37d4-9e91-fcd1bac4a458",
                    "sense_definition": "Een mechanisme door draaien onder spanning zetten, zoals bij een klok of speelgoed.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet de oude klok elke ochtend <w>opwinden</w> om hem te laten lopen.",
                            "target_lang_translations": {
                                "en": "You have to <w>wind</w> the old clock every morning to keep it running.",
                                "fr": "Il faut <w>remonter</w> la vieille horloge tous les matins pour la faire fonctionner."
                            }
                        },
                        {
                            "text": "Het kind probeerde de wekker <w>op</w> te <w>winden</w> maar de veer was kapot.",
                            "target_lang_translations": {
                                "en": "The child tried to <w>wind up</w> the alarm clock, but the spring was broken.",
                                "fr": "L'enfant a essayé de <w>remonter</w> le réveil, mais le ressort était cassé."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een klok opwinden",
                        "de wekker opwinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To put a mechanism under tension by turning, such as with a clock or toy.",
                        "fr": "Tendre un mécanisme par rotation, comme pour une pendule, un réveil ou un jouet mécanique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "a clockwork mechanism"
                            },
                            {
                                "target_lang_word": "wind up",
                                "target_lang_sense_clarification": "a spring or toy"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "remonter",
                                "target_lang_sense_clarification": "un mécanisme d'horlogerie ou un jouet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7b3eb5-1446-3529-a373-54bf1ee67cf8",
                    "sense_definition": "Iets rond een as, klos of kern wikkelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij begon de losse draad voorzichtig op een klosje <w>op</w> te <w>winden</w>.",
                            "target_lang_translations": {
                                "en": "She began to carefully <w>wind</w> the loose thread onto a spool.",
                                "fr": "Elle a commencé à <w>enrouler</w> soigneusement le fil lâche sur une bobine."
                            }
                        },
                        {
                            "text": "Na het vissen moet je de lijn weer netjes op de spoel <w>opwinden</w>.",
                            "target_lang_translations": {
                                "en": "After fishing, you must <w>reel</w> the line back onto the spool neatly.",
                                "fr": "Après la pêche, il faut bien <w>réenrouler</w> la ligne sur le moulinet."
                            }
                        }
                    ],
                    "synonyms": [
                        "wikkelen",
                        "oprollen"
                    ],
                    "antonyms": [
                        "ontwinden"
                    ],
                    "common_phrases": [
                        "draad opwinden",
                        "touw opwinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To wrap something around an axis, spool, or core.",
                        "fr": "Enrouler quelque chose autour d'un axe, d'une bobine ou d'un noyau."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "thread or cord around something"
                            },
                            {
                                "target_lang_word": "reel in",
                                "target_lang_sense_clarification": "a fishing line"
                            },
                            {
                                "target_lang_word": "coil",
                                "target_lang_sense_clarification": "rope or wire"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "enrouler",
                                "target_lang_sense_clarification": "du fil, une corde ou un câble"
                            },
                            {
                                "target_lang_word": "bobiner",
                                "target_lang_sense_clarification": "sur une bobine ou un dévidoir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4db61f0e-1506-3159-b9b3-aebede8be594",
                    "sense_definition": "Zichzelf in een staat van emotionele spanning, boosheid of agitatie brengen over iets.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je niet zo <w>opwinden</w> over die kleine foutjes van je collega.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>get</w> so <w>worked up</w> about your colleague's small mistakes.",
                                "fr": "Tu ne devrais pas tant <w>t'énerver</w> pour les petites erreurs de ton collègue."
                            }
                        },
                        {
                            "text": "Hij had zich daarover veel te veel <w>opgewonden</w> en kon niet slapen.",
                            "target_lang_translations": {
                                "en": "He had <w>gotten</w> far too <w>wound up</w> about it and couldn't sleep.",
                                "fr": "Il <w>s'était</w> beaucoup trop <w>énervé</w> à ce sujet et ne parvenait pas à dormir."
                            }
                        }
                    ],
                    "synonyms": [
                        "druk maken",
                        "agiteren"
                    ],
                    "common_phrases": [
                        "zich opwinden over"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring oneself into a state of emotional tension, anger, or agitation about something.",
                        "fr": "Se mettre dans un état d'énervement, d'agitation ou de colère à propos de quelque chose."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get worked up",
                                "target_lang_sense_clarification": "becoming agitated or upset"
                            },
                            {
                                "target_lang_word": "get wound up",
                                "target_lang_sense_clarification": "becoming tense or angry"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "worrying or getting upset"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'énerver",
                                "target_lang_sense_clarification": "se mettre en colère ou s'agiter"
                            },
                            {
                                "target_lang_word": "s'emporter",
                                "target_lang_sense_clarification": "perdre son calme"
                            },
                            {
                                "target_lang_word": "monter sur ses grands chevaux",
                                "target_lang_sense_clarification": "s'emporter de manière excessive"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bd6904e-996a-3445-a7e2-e59a613dab42",
                    "sense_definition": "Iemand anders in een staat van agitatie, enthousiasme of spanning brengen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die onbeschofte opmerking <w>wond</w> hem vreselijk <w>op</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "That rude remark <w>agitated</w> him terribly during the meeting.",
                                "fr": "Cette remarque impolie l'a terriblement <w>énervé</w> pendant la réunion."
                            }
                        },
                        {
                            "text": "De trainer probeerde de spelers voor de wedstrijd extra <w>op</w> te <w>winden</w>.",
                            "target_lang_translations": {
                                "en": "The coach tried to <w>fire up</w> the players even more before the match.",
                                "fr": "L'entraîneur essayait de survolter et de motiver davantage les joueurs avant le match."
                            }
                        }
                    ],
                    "synonyms": [
                        "prikkelen",
                        "ophitsen"
                    ],
                    "common_phrases": [
                        "iemand opwinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To bring someone else into a state of agitation, enthusiasm, or tension.",
                        "fr": "Mettre quelqu'un dans un état d'agitation, d'enthousiasme, d'énervement ou de tension."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excite",
                                "target_lang_sense_clarification": "stirring emotions or enthusiasm"
                            },
                            {
                                "target_lang_word": "wind up",
                                "target_lang_sense_clarification": "provoking or agitating someone"
                            },
                            {
                                "target_lang_word": "arouse",
                                "target_lang_sense_clarification": "stimulating feelings or suspicion"
                            },
                            {
                                "target_lang_word": "agitate",
                                "target_lang_sense_clarification": "making someone troubled or nervous"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "énerver",
                                "target_lang_sense_clarification": "irriter ou agiter quelqu'un"
                            },
                            {
                                "target_lang_word": "chauffer",
                                "target_lang_sense_clarification": "motiver ou stimuler vivement"
                            },
                            {
                                "target_lang_word": "exciter",
                                "target_lang_sense_clarification": "stimuler l'ardeur ou agiter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61bec52e-f215-307c-bcf6-d709bcf50443",
                    "sense_definition": "Iemand seksueel of erotisch stimuleren of prikkelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bepaalde geuren kunnen mensen onbewust heel erg <w>opwinden</w>.",
                            "target_lang_translations": {
                                "en": "Certain scents can <w>arouse</w> people very much subconsciously.",
                                "fr": "Certaines odeurs peuvent inconsciemment beaucoup <w>exciter</w> les gens."
                            }
                        },
                        {
                            "text": "Zij vindt het prettig als haar partner haar zachtjes probeert <w>op</w> te <w>winden</w>.",
                            "target_lang_translations": {
                                "en": "She likes it when her partner tries to gently <w>turn</w> her <w>on</w>.",
                                "fr": "Elle apprécie que son partenaire essaie doucement de l'<w>exciter</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "prikkelen",
                        "stimuleren"
                    ],
                    "common_phrases": [
                        "seksueel opwinden"
                    ],
                    "target_lang_definitions": {
                        "en": "To sexually or erotically stimulate or pique someone.",
                        "fr": "Stimuler ou exciter quelqu'un sur le plan sexuel ou érotique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn on",
                                "target_lang_sense_clarification": "sexual stimulation"
                            },
                            {
                                "target_lang_word": "arouse",
                                "target_lang_sense_clarification": "sexual stimulation"
                            },
                            {
                                "target_lang_word": "excite",
                                "target_lang_sense_clarification": "erotic stimulation"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "exciter",
                                "target_lang_sense_clarification": "au sens sexuel ou érotique"
                            },
                            {
                                "target_lang_word": "allumer",
                                "target_lang_sense_clarification": "attiser le désir sexuel, registre familier"
                            }
                        ]
                    }
                }
            ]
        }
