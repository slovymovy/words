                ],
                "translations": [
                    {
                        "translation_id": "3249c1fa-aa81-4a52-a868-5d50a9e7cdd9",
                        "source_entry_id": "b4da47aa-c062-3dbb-992c-d5d0a651b773",
                        "source_sense_id": "2dfd64f5-2381-3372-8f13-ee1c8016eb4f",
                        "target_lang_word": "redaktionell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redaktionell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd79bd59-cd8d-30a6-8766-6beefec756da",
                                        "entry_id": "8dc00902-bd6a-3633-ac84-ba8ca666c35f",
                                        "glosses": [
                                            "das Überarbeiten von Texten, Filmen, Videos betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bddb6c1-09a0-44ea-97d3-5612b5bbf88a",
                                                "sense_id": "fd79bd59-cd8d-30a6-8766-6beefec756da",
                                                "text": "Wenn sie die Inhalte ihrer Webseite überprüfen oder verbessern wollen biete ich ihnen gerne meine redaktionelle Hilfe an."
                                            },
                                            {
                                                "example_id": "b5ad5aae-f24f-4bd2-a65c-6a9032abb064",
                                                "sense_id": "fd79bd59-cd8d-30a6-8766-6beefec756da",
                                                "text": "Die Schüler wählen die Themen aus, bearbeiten zusammen das Drehbuch und produzieren die Videos. […] Hilfe gibt es von Kolja Brandstedt, der als Teach-First-Fellow an der Hauptschule im Einsatz ist und bei technischen aber auch redaktionellen Fragen hilft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                        "entry_id": "8dc00902-bd6a-3633-ac84-ba8ca666c35f",
                                        "glosses": [
                                            "durch eine Redaktion, beispielsweise in der Zeitungsbranche"
                                        ],
                                        "tags": [
                                            "Medien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10828043-139b-43ad-82af-556ca7155f8d",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "Ich arbeite nur noch freiberuflich, weil ich die redaktionellen Zwänge nicht mag."
                                            },
                                            {
                                                "example_id": "8ce030ed-8616-4c4b-8685-9b799c0e833e",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "Bei Fake News helfen redaktionelle Standards überhaupt nicht, da Gruppen, die gefälschte Nachrichten glauben, lieber die Glaubwürdigkeit der Redaktion in Zweifel ziehen, als ihre Position zu überdenken."
                                            },
                                            {
                                                "example_id": "ddf0467e-d149-4943-ad7f-5c30ac6b5419",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "„Generell ist Frankreichs Wirtschaft weniger (redaktionelle Anmerkung: Audio ist hier unverständlich) als Deutschlands Wirtschaft.“"
                                            },
                                            {
                                                "example_id": "3e9bf552-a21a-4948-865e-70f861a1699c",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "[Anne Renzenbrink von 'Reporter ohne Grenzen':] „[In der Türkei sind in 2018] mehr als 100 Journalisten […] immer noch inhaftiert. Rund 150 Medien wurden geschlossen, hunderte Presseausweise wurden annulliert. Im redaktionellen Alltag hat bei kritisch berichtenden Kollegen die ständige Angst Einzug gehalten.“"
                                            },
                                            {
                                                "example_id": "4837630e-1694-41d7-882a-314cd6c989e2",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "[Verfassungsschutz Präsident Hans-Georg Maaßen:] „Es [Facebook, Twitter] sind riesige Digitalkonzerne, die sich lediglich als Transporteure von Information verstehen, [… die] die redaktionelle Prüfung ihrer Inhalte nicht übernehmen wollen.“"
                                            },
                                            {
                                                "example_id": "0a03cffd-e610-4cdb-b51b-572128e2b3d3",
                                                "sense_id": "f1139d74-6b87-36db-861f-16f3fd3cb334",
                                                "text": "Die Einblendung des [Microsoft-]Logos [bei Sendungen des NDR] führe laut Gericht dazu, den Wettbewerb eines Dritten, nämlich der Firma Microsoft, zu fördern. Die Information habe keinen redaktionellen Gehalt. Der Hinweis auf „Infratest-dimap“, den Urheber der Umfrageergebnisse, sei dagegen zulässig. Mit der Einblendung des Microsoft-Logos wurden laut Landgericht Hamburg die Regelungen des Rundfunkstaatsvertrages verletzt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
