                "senses": [
                    {
                        "sense_id": "ff8f0106-825c-3280-bc6a-0ce7b27714bc",
                        "entry_id": "9f6aca9c-735b-3948-88a6-f337bb11584a",
                        "glosses": [
                            "het vermogen om veel berekeningen uit te voeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edeed5a6-d99a-4356-a64b-5505a396e0d6",
                                "sense_id": "ff8f0106-825c-3280-bc6a-0ce7b27714bc",
                                "text": "De chipgigant verwacht dat de vraag naar computerchips aankomende jaren sterk zal toenemen door de komst van 5G en apparaten die veel rekenkracht nodig hebben. Ook wijst het bedrijf erop dat de coronacrisis de digitalisering in \"elk aspect\" heeft versneld."
                            },
                            {
                                "example_id": "78b110af-3f56-4742-b1c3-b3c257313af2",
                                "sense_id": "ff8f0106-825c-3280-bc6a-0ce7b27714bc",
                                "text": "Het majoranadeeltje werd gezien als belangrijke bouwsteen voor de supercomputers van de toekomst, die op een andere manier werken en daardoor veel meer rekenkracht zullen hebben en dus veel meer zullen kunnen dan de huidige computers. Die nieuwe quantumcomputers draaien op zogenoemde qubits, en daarvoor leek het majoranadeeltje een geschikte kandidaat."
                            }
                        ]
                    }
