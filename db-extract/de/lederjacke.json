                        ],
                        "form": "die Lederjacken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                        "entry_id": "ce89ff97-dff3-3ff7-9c12-88abcc93e27d",
                        "glosses": [
                            "aus Leder bestehende Jacke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8031773a-b1d5-4696-8e12-0c84f7d026f3",
                                "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                                "text": "Piloten tragen oft Lederjacken."
                            },
                            {
                                "example_id": "3d33e227-7b0c-4cd7-b8e2-8e22c956a0f3",
                                "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                                "text": "„Montagfrüh, ein junger Grieche in schwarzer Lederjacke kauert in der S-Bahn Richtung Innenstadt verkrampft auf seinem Fenstersitz, das Mobiltelefon zwischen Ohr und Schulter geklemmt.“"
                            },
                            {
                                "example_id": "875b25a1-eb09-4ae4-9fce-5cae4857bb77",
                                "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                                "text": "„Er trug einen roten Sweater, eine neue Lederjacke, eine Stahlbrille und hatte Pickel und abstehende Ohren.“"
                            },
                            {
                                "example_id": "1202900b-2b36-4a10-98a0-8f5d9ec67f37",
                                "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                                "text": "„Am Steuer stand ein kleiner, verknitterter Portugiese mit Lederjacke und Schildmütze, eine erloschene Stummelpfeife zwischen den Zähnen.“"
                            },
                            {
                                "example_id": "25fc91d1-791d-4d8b-b435-0e4cac5b75c4",
                                "sense_id": "7ae59e3c-f1d9-3055-a473-efd69f68151c",
                                "text": "„Er war ein Klassenschwarm, mit seiner Lederjacke und den Band-Shirts aus den 80ern, seiner Gitarre, die neben ihm auf dem Boden in ihrem Kasten auf die letzte Schulglocke wartete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
