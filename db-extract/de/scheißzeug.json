                            {
                                "example_id": "5e890a2f-0db4-411e-a69a-ea8d35442f63",
                                "sense_id": "ef9347ec-ad3b-3ab3-bc6b-a78ddbfbf75d",
                                "text": "„›Pass auf, das Scheißzeug wird dich noch umbringen‹, sagte er zu ihm, dann sah er in den zweiten Papierbeutel.“"
                            },
                            {
                                "example_id": "d04c4974-e9c5-4dfd-8dc8-9a710c808607",
                                "sense_id": "ef9347ec-ad3b-3ab3-bc6b-a78ddbfbf75d",
                                "text": "„Sag ma’, Suttree, was iss’n das für’n Scheißzeug?“"
                            },
                            {
                                "example_id": "5951f9dc-ff6f-467f-9317-6d6be306f0fb",
                                "sense_id": "ef9347ec-ad3b-3ab3-bc6b-a78ddbfbf75d",
                                "text": "„Carmody sagte: ›Wenn Sie den Kerl erwischen, der Lizzie umgebracht hat, kauf ich Ihnen die ganze Fabrik, die das Scheißzeug herstellt.‹“"
                            }
