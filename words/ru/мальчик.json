                                "target_lang_word": "garçon",
                                "target_lang_sense_clarification": "Fils, souvent dit avec affection."
                            },
                            {
                                "target_lang_word": "fils",
                                "target_lang_sense_clarification": "Enfant de sexe masculin par rapport aux parents."
                            }
                        ]
