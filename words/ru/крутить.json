                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все соседи знали, что она начала <крутить> роман с новым доктором.",
                            "target_lang_translations": {
                                "en": "All the neighbors knew that she had started <having> an affair with the new doctor.",
                                "es": "Todos los vecinos sabían que ella había empezado a <tener> un romance con el nuevo médico.",
                                "fr": "Tous les voisins savaient qu'elle avait commencé à <avoir une aventure> avec le nouveau médecin."
                            }
