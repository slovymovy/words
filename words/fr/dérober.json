{
    "word_family": [
        "dérobade",
        "enrober",
        "enrobage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bf44c54d-01df-3246-8e37-9c2ea6998cf8",
                    "sense_definition": "Prendre secrètement ou frauduleusement un bien qui appartient à autrui.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un voleur adroit a réussi à <w>dérober</w> des bijoux dans cette vitrine."
                        },
                        {
                            "text": "Le cambrioleur <w>dérobe</w> des objets précieux pendant le sommeil des résidents."
                        }
                    ],
                    "synonyms": [
                        "voler",
                        "subtiliser",
                        "chiper",
                        "détourner"
                    ],
                    "antonyms": [
                        "restituer",
                        "rendre"
                    ],
                    "common_phrases": [
                        "dérober des bijoux",
                        "dérober des secrets"
                    ]
                },
                {
                    "sense_id": "2b2645b3-ed46-3758-b3e6-04c9d7144b48",
                    "sense_definition": "Cacher quelque chose ou quelqu'un pour le soustraire aux yeux ou à la connaissance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un épais brouillard est venu <w>dérober</w> les sommets aux randonneurs surpris."
                        },
                        {
                            "text": "Ce rideau sombre <w>dérobe</w> la pièce aux regards indiscrets des passants."
                        }
                    ],
                    "synonyms": [
                        "cacher",
                        "dissimuler",
                        "masquer",
                        "celer"
                    ],
                    "antonyms": [
                        "montrer",
                        "révéler",
                        "exposer"
                    ],
                    "common_phrases": [
                        "dérober aux regards"
                    ]
                },
                {
                    "sense_id": "0c4cb524-c683-3569-bb44-ad65fe8455bd",
                    "sense_definition": "Échapper à une obligation, à un engagement ou refuser de faire face à une difficulté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esquive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre refuse de répondre et choisit de se <w>dérober</w> aux journalistes."
                        },
                        {
                            "text": "Face aux critiques du comité, il ne s'est pas <w>dérobé</w> longtemps."
                        }
                    ],
                    "synonyms": [
                        "esquiver",
                        "éluder",
                        "fuir"
                    ],
                    "antonyms": [
                        "affronter",
                        "assumer"
                    ],
                    "common_phrases": [
                        "se dérober aux devoirs",
                        "se dérober aux questions"
                    ]
                },
                {
                    "sense_id": "8c1f8b7c-95c0-3acb-a2e3-a7f2faad19ae",
                    "sense_definition": "Faiblir brutalement et manquer d'appui sous le poids du corps, en parlant des membres inférieurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "defaillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de la peur, ses jambes se <w>dérobent</w> sous elle sans prévenir."
                        },
                        {
                            "text": "Le sportif épuisé a senti ses genoux se <w>dérober</w> sur la piste."
                        }
                    ],
                    "synonyms": [
                        "fléchir",
                        "vaciller",
                        "faiblir"
                    ],
                    "common_phrases": [
                        "jambes qui se dérobent",
                        "genoux qui se dérobent"
                    ]
                },
                {
                    "sense_id": "4044d4d1-41bc-3c47-9a58-40eb9f958c12",
                    "sense_definition": "Prendre un peu de temps sur ses occupations habituelles ou ses obligations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a réussi à <w>dérober</w> une heure à son emploi du temps chargé."
                        },
                        {
                            "text": "Elle <w>dérobe</w> quelques moments à son travail pour lire ce roman passionnant."
                        }
                    ],
                    "synonyms": [
                        "soustraire"
                    ],
                    "common_phrases": [
                        "dérober quelques instants",
                        "dérober du temps"
                    ]
                },
                {
                    "sense_id": "924feeb2-58b7-3244-8b8f-2011aa9bc94e",
                    "sense_definition": "Enlever la seconde peau ou la membrane opaque qui recouvre certaines graines potagères.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier doit d'abord <w>dérober</w> les graines après les avoir plongées dans l'eau."
                        },
                        {
                            "text": "Pour préparer cette recette délicate, elle <w>dérobe</w> chaque légume avec grand soin."
                        }
                    ],
                    "synonyms": [
                        "peler",
                        "écosser"
                    ],
                    "common_phrases": [
                        "dérober des fèves"
                    ]
                }
            ]
        }
    ]
}