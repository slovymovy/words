                ],
                "senses": [
                    {
                        "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                        "glosses": [
                            "das Roden eines Baumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "583dd275-f8bf-4537-9e1b-1041266b633d",
                                "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                                "text": "„Wenn der Eigentümer einen Antrag zur Fällung des Baumes eingereicht hat, hat der Baum anscheinend keinen Wert für ihn.“"
                            },
                            {
                                "example_id": "f073f4a2-ab02-4006-abee-292333725b10",
                                "sense_id": "db3a6e9f-5112-3bbf-aa62-16796c7ca76d",
                                "text": "„Die Stadt Dresden sagte die geplante Räumung und Fällung des Baumes aus Sicherheitsgründen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                        "glosses": [
                            "verbindliche Festlegung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691d793a-85b1-4fc4-8fe8-a9a18ded7fb4",
                                "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                                "text": "„Nach Fällung der Entscheidungist Widerstand jedoch höchst destruktiv für das weitere Voranschreiten der Reorganisation.“"
                            },
                            {
                                "example_id": "38d137ab-34df-4164-bd98-4222dd9d11ce",
                                "sense_id": "9427df20-53d6-33e4-b786-c7f4b449afd6",
                                "text": "„Vor Fällung des Urteils zeige der Beklagte seinen Ehefortsetzungswillen durch seine Zustimmung zur Klagszurücknahme.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                        "entry_id": "20ad62cf-7b38-3e49-b5bc-9b165de267e9",
                        "glosses": [
                            "Ausscheiden eines gelösten Stoffes aus einer Lösung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c299ce-a07a-4b5b-a94a-84d04f2b9ef1",
                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                "text": "„Die Fällung wird nun 2mal mit je 5 ccm 0,4%iger NaCl-Lösung gewaschen, die Waschflüssigkeit nach dem Zentrifugieren jedesmal sorgfältig abgegossen.“"
                            },
                            {
                                "example_id": "0a4372ed-20cc-4fcc-b7af-43ba78f77a52",
                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                "text": "„Bei der Fällung werden ungelöste Wasserinhaltsstoffe mit Fällmitteln in unlösliche Fällprodukte überführt und anschließend über Sedimentation oder Filtration abgetrennt.“"
                            },
                            {
                                "example_id": "00267f7e-cbe2-4ea0-ab0e-e2ecfc97891f",
                                "sense_id": "b99db755-eca1-32c0-aab9-603748e862d2",
                                "text": "„Infolge der Hinzufügung des Antimonsalzes koagulierte die Fällung der Sulfide und konnte leicht durch Filtration abgetrennt werden; nachher wurde das Präzipitat gut mit destilliertem Wasser gewaschen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
