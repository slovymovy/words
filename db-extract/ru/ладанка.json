        "fr-extract.jsonl": [
            {
                "entry_id": "3aa923a7-61f3-3170-975c-7157b7aea9b2",
                "word": "ладанка",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55f10a8f-a019-31b0-a4f4-5bd7948037f4",
                        "entry_id": "3aa923a7-61f3-3170-975c-7157b7aea9b2",
                        "glosses": [
                            "Petit encensoir, brûle-parfum, le plus souvent placé devant les icônes domestiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a6c0bc7-e696-433c-9c28-6854dc96d66f",
                                "sense_id": "55f10a8f-a019-31b0-a4f4-5bd7948037f4",
                                "text": "Современные ладанки — это курильницы перед киотом или иконой или небольшие сосуды, предназначенные для ароматизированных жидкостей, в которые можно также положить какие-нибудь другие ароматические вещества, например ватку, пропитанную эфирными маслами.",
                                "translation": "Les encensoirs modernes sont des brûle-parfums placés devant un autel à icône ou une icône, ou de petits récipients destinés aux liquides aromatiques, dans lesquels on peut également mettre d'autres substances aromatiques, par exemple du coton imbibé d'huiles essentielles."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfe202aa-3b9c-3d4b-8372-43f5f87333f8",
                        "entry_id": "3aa923a7-61f3-3170-975c-7157b7aea9b2",
                        "glosses": [
                            "Amulette contenant de l’encens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07f6893-1a72-4da1-97c6-6e1381c0ad6e",
                                "sense_id": "cfe202aa-3b9c-3d4b-8372-43f5f87333f8",
                                "text": "На нём крест и ладанка, в руках священные книги.",
                                "translation": "Il porte une croix et une amulette et tient des livres saints."
                            }
                        ]
                    },
                    {
                        "sense_id": "05571792-9542-381f-b95b-962a0f107cfe",
                        "entry_id": "3aa923a7-61f3-3170-975c-7157b7aea9b2",
                        "glosses": [
                            "Sachet contenant une substance protectrice."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "28e5a3ee-8953-4d02-afab-0f9011541bcf",
                                "sense_id": "05571792-9542-381f-b95b-962a0f107cfe",
                                "text": "Ладанка с нафталином.",
                                "translation": "Boule de naphtaline."
                            }
                        ]
                    }
