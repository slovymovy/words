                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ab4d0b4e-83c4-4e34-8466-ba0bb8182b77",
                        "entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "impatients"
                    },
                    {
                        "form_id": "4f0303ff-2d31-4e3b-9ce9-43ffe2392415",
                        "entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "impatiente"
                    },
                    {
                        "form_id": "4518b9be-8466-466e-9350-127ea021056e",
                        "entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "impatientes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "997369fd-552f-319f-b419-72a88228bc53",
                        "entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "glosses": [
                            "Qui manque de patience, soit dans la souffrance de quelque mal, soit dans l’attente de quelque bien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be9b2dc6-ba39-4e8d-9b85-dfb7d71334ca",
                                "sense_id": "997369fd-552f-319f-b419-72a88228bc53",
                                "text": "Il est d’un naturel impatient."
                            },
                            {
                                "example_id": "ec23cde1-2252-4f68-886e-90936dacec7a",
                                "sense_id": "997369fd-552f-319f-b419-72a88228bc53",
                                "text": "Je suis fort impatient de savoir ce qui en arrivera."
                            },
                            {
                                "example_id": "6f9f6c3a-381a-4f21-a5f9-7f3557105ade",
                                "sense_id": "997369fd-552f-319f-b419-72a88228bc53",
                                "text": "Cet enfant est impatient de partir pour la campagne."
                            },
                            {
                                "example_id": "d2b620ce-177b-4229-b80e-df35d4258bb2",
                                "sense_id": "997369fd-552f-319f-b419-72a88228bc53",
                                "text": "Partout l’odeur du sucre, des rangées de sucres d’orge multicolores flottant sur chaque gradin, des enfants impatients, et par-dessus tout ça une drôle de musique, assez triste, avec du violon et des cymbales aigrelettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bf1811b-da40-32f3-a577-73d36c0dfc1f",
                        "entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "glosses": [
                            "Qui ne peut supporter, qui ne peut souffrir."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "843c55e6-fb19-4e68-83df-13e94fcbd52d",
                                "sense_id": "3bf1811b-da40-32f3-a577-73d36c0dfc1f",
                                "text": "Impatient du joug, impatient du frein, etc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9931a2e-7cbb-49f3-b27c-5e0ede5177e0",
                        "source_entry_id": "5fce790a-7696-3a80-99ed-3640f2aa258c",
                        "target_lang_word": "impatient",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impatient",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0c8182-51ff-3430-9314-694ec9901c66",
                                        "entry_id": "d3403407-42e4-3f91-a059-2240962a9e4c",
                                        "glosses": [
                                            "Restless, short of temper, and intolerant of delays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d4dff8-560f-45b6-8a5b-915464207ed3",
                                                "sense_id": "ed0c8182-51ff-3430-9314-694ec9901c66",
                                                "text": "She dances when she becomes impatient."
                                            },
                                            {
                                                "example_id": "e84a3561-f3c6-494b-893d-35ef8a275419",
                                                "sense_id": "ed0c8182-51ff-3430-9314-694ec9901c66",
                                                "text": "The impatient man will not give himself time to be informed of the matter that lies before him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5487c45e-0ceb-353e-acea-970fbbd0a3e3",
                                        "entry_id": "d3403407-42e4-3f91-a059-2240962a9e4c",
                                        "glosses": [
                                            "Anxious and eager, especially to begin or have something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50e3ea15-d3f3-4db1-99b7-2ca94c45fc07",
                                                "sense_id": "5487c45e-0ceb-353e-acea-970fbbd0a3e3",
                                                "text": "For, if (ſaid he) you throw among five Yahoos as much Food as would be ſufficient for fifty, they will, inſtead of eating peaceably, fall together by the ears, each ſingle one impatient to have all to itſelf; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "670a36f2-95a1-3db0-b6fa-583ee6b781ff",
                                        "entry_id": "d3403407-42e4-3f91-a059-2240962a9e4c",
                                        "glosses": [
                                            "Not to be borne; unendurable."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314ff416-c530-444d-ab40-9333d2ddf75f",
                                                "sense_id": "670a36f2-95a1-3db0-b6fa-583ee6b781ff",
                                                "text": "Dismayed with so defperate deadly wound,\nAnd eke impatient of unwonted payne,\nHe lowdly bray'd with beastly yelling sownd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ec5db0-7d7c-35c5-9660-0de1e232acd8",
                                        "entry_id": "d3403407-42e4-3f91-a059-2240962a9e4c",
                                        "glosses": [
                                            "Prompted by, or exhibiting, impatience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a52340f-26a0-497c-b29e-fd579897ace0",
                                                "sense_id": "36ec5db0-7d7c-35c5-9660-0de1e232acd8",
                                                "text": "impatient speeches or replies"
                                            },
                                            {
                                                "example_id": "e3213776-de3c-4789-8a80-305d47ac9f99",
                                                "sense_id": "36ec5db0-7d7c-35c5-9660-0de1e232acd8",
                                                "text": "What, will you tear / Impatient answers from my gentle tongue?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53f29a2e-ad32-4fef-bcd0-b7b9ec88d5a8",
