                                    {
                                        "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                        "entry_id": "b3773082-8727-3420-99b0-84788e2922e6",
                                        "glosses": [
                                            "Forschungsreise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0072614d-7627-4df8-93ba-ed4528e79400",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "Sie machten eine Expedition nach Südamerika."
                                            },
                                            {
                                                "example_id": "0b65b939-6df1-47e2-8f50-7d9d38bfd4aa",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "„Fast alle, die im Höhenbergsteigen Rang und Namen haben, sind an der Lhotse-Südwand gescheitert, insgesamt rund ein Dutzend Expeditionen.“"
                                            },
                                            {
                                                "example_id": "b50596ab-7132-4bb0-a774-b8c2b00dda3b",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "„Um biologische und chemische Parameter im Meeresboden messen zu können, nahmen die Forscher an den elf Stationen ihrer Expedition Bodenproben, sogenannte Sedimentkerne.“"
                                            },
                                            {
                                                "example_id": "e95692f7-21f3-45fb-849f-04c1a4920b3a",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "„Bei den Expeditionen kommen die Einheimischen auf zweifache Weise mit Meyer in Berührung: als seine Bediensteten (Träger, Diener und Führer) oder als Eigentümer von Nahrungsmitteln beziehungsweise von Land, das ihm für die Dauer seines Aufenthalts teilweise überlassen wird.“"
                                            },
                                            {
                                                "example_id": "3a69b826-69b7-4fe1-aae5-33258be72df4",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "„Expeditionen werden ausgeschickt, um den Erdteil zu erforschen und für Großbritannien zu erschließen.“"
                                            },
                                            {
                                                "example_id": "fc10963d-c274-4f5f-9bcd-e5a663c8bddb",
                                                "sense_id": "42f05a7d-2190-31fc-be6f-0aff299f0702",
                                                "text": "„Die Familie hatte für ihre wagemutigen Expeditionen wenig Verständnis, die elfjährige Tochter blieb in einem Internat zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2014b7c5-af63-3eca-9340-eb6cbd19b734",
                                        "entry_id": "b3773082-8727-3420-99b0-84788e2922e6",
                                        "glosses": [
                                            "Kriegszug"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9db5fbd-d1e1-481b-aa7b-e1dd3c74c30e",
                                                "sense_id": "2014b7c5-af63-3eca-9340-eb6cbd19b734",
                                                "text": "„Barretos Expedition entlang des Ufers des Sambesi, von der Küste des heutigen Mosambik in den Norden Simbabwes, ist ein Eroberungszug zum Ruhme Gottes und der portugiesischen Krone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
