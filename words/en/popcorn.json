                },
                {
                    "sense_id": "8cf80f6d-91cb-3fd5-b6e9-87f86a8286b3",
                    "sense_definition": "A serving of popcorn.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Can I please have two sodas and two small <w>popcorns</w>?",
                            "target_lang_translations": {
                                "ru": "Можно мне, пожалуйста, две газировки и два маленьких <w>попкорна</w>?",
                                "zh": "请给我两杯汽水和两<w>份</w>小份爆米花。",
                                "es": "¿Me das dos refrescos y dos <w>palomitas</w> pequeñas, por favor?"
                            }
                        },
                        {
                            "text": "The cinema deal includes two tickets and two free <w>popcorns</w>.",
                            "target_lang_translations": {
                                "ru": "Акция в кинотеатре включает два билета и две бесплатные порции <w>попкорна</w>.",
                                "zh": "电影院的套餐包含两张票和两<w>份</w>免费爆米花。",
                                "es": "La oferta del cine incluye dos entradas y dos <w>palomitas</w> gratis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "two popcorns",
                        "small popcorn",
                        "large popcorn"
                    ],
                    "target_lang_definitions": {
