                    {
                        "translation_id": "6de35793-9b9f-4acd-8061-be129d1e17ed",
                        "source_entry_id": "1b3eb4d1-e496-3301-bf92-fa06d0e05133",
                        "source_sense_id": "2df4b7b6-4985-3007-a7da-c65da6663695",
                        "source_sense_description": "een toestel waarin wafels gebakken worden",
                        "target_lang_word": "waffle iron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waffle iron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc141e8-ef1d-398d-9274-98ec042ab235",
                                        "entry_id": "9ee8f3e0-04dd-3bc8-9307-f893a4949802",
                                        "glosses": [
                                            "A cooking appliance, with hinged, indented metal plates, used to make waffles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f128dca-5a04-45e0-8923-17db32c32de5",
                                                "sense_id": "edc141e8-ef1d-398d-9274-98ec042ab235",
                                                "text": "Such a one is very apt to leave his impress upon his scholars, as the waffle-iron is impressed upon the cake that is baked in it."
                                            },
                                            {
                                                "example_id": "ec85af80-228e-496c-9254-80ec6637e9a3",
                                                "sense_id": "edc141e8-ef1d-398d-9274-98ec042ab235",
                                                "text": "I remember once of buying a waffle-iron of him, and when I tried it and found it did not make a pretty pattern on the waffles, I took it back to him to change it: but having no other pattern, he returned me the money as soon as I asked him."
                                            },
                                            {
                                                "example_id": "91754e6f-22a6-4491-bbd4-9d0644e31488",
                                                "sense_id": "edc141e8-ef1d-398d-9274-98ec042ab235",
                                                "text": "These batter-based flat cakes gained a new form of popularity in America when Thomas Jefferson returned from his stint in France as a diplomat. In 1789 he presented his friends with a long-handled waffle iron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
