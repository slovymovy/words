                        "glosses": [
                            "een medeklinker die geproduceerd wordt met een gedeeltelijke obstructie ergens in het spraakkanaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7076eb2a-d655-40ad-8bdf-5f9f2ae66431",
                                "sense_id": "20b90378-38fe-309f-bb60-1490ff22af9f",
                                "text": "In het Nederlands worden stemhebbende fricatieven, net als stemhebbende plosieven, aan het eind van een lettergreep stemloos gemaakt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19741056-a443-495a-8a6d-653b1e1f60b0",
                        "source_entry_id": "f8c82d76-6838-35a3-9d75-21905ab78224",
                        "source_sense_id": "20b90378-38fe-309f-bb60-1490ff22af9f",
                        "source_sense_description": "een medeklinker die geproduceerd wordt met een gedeeltelijke obstructie ergens in het spraakkanaal",
                        "target_lang_word": "Frikativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
