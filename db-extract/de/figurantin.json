                        "sense_id": "d673fe7b-fe26-3095-bea8-510d2096b956",
                        "entry_id": "0d935c2a-eca5-3da3-aa46-f80c21890307",
                        "glosses": [
                            "weibliche Person, die als Tänzerin nur in der Gruppe beziehungsweise im Schauspiel nur als Statistin auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33774ed9-a57b-49b4-8a73-3ebd7d523c04",
                                "sense_id": "d673fe7b-fe26-3095-bea8-510d2096b956",
                                "text": "„Jetzt bin ich nur noch Figurantin, aber früher war ich einmal Schauspielerin.“"
                            },
                            {
                                "example_id": "a466acce-a945-467d-bad9-21e7fa4d49c1",
                                "sense_id": "d673fe7b-fe26-3095-bea8-510d2096b956",
                                "text": "„Er hatte nach dem Tode seines Vaters dem Theater den Rücken gewandt und eine hübsche Figurantin geheiratet; nun destillierte er Melissenkraut und hoffte, den Stein der Weisen zu finden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
