                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95be7026-42c0-46f4-b080-2e2c2d7badc4",
                                "sense_id": "4f4bd838-e448-3b72-907d-dccd39995876",
                                "text": "Das Marmeladenglas ist schon wieder leer."
                            },
                            {
                                "example_id": "09483a14-a8b4-4912-b1ab-45e9eb816143",
                                "sense_id": "4f4bd838-e448-3b72-907d-dccd39995876",
                                "text": "Wo sind denn die Marmeladengläser?"
                            },
                            {
                                "example_id": "152ad625-94d9-41fc-b21c-4980deae959a",
                                "sense_id": "4f4bd838-e448-3b72-907d-dccd39995876",
                                "text": "„Als der Treck drei Wochen zuvor für die Flucht vorbereitet worden war, hatten die Götzlacker alle Marmeladengläser und -töpfe in große Zinkmilchkannen entleert und sie außen an den Wagen befestigt.“"
                            }
                        ],
