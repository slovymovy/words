                "senses": [
                    {
                        "sense_id": "4e47d114-30dd-3c8a-897f-69ea5bc6fe47",
                        "entry_id": "8f360c27-1f53-3d40-99b3-bd165ed35350",
                        "glosses": [
                            "To toss (aside); to dismiss."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6444cf18-f697-49f3-ac58-a2ad7bf21682",
                                "sense_id": "4e47d114-30dd-3c8a-897f-69ea5bc6fe47",
                                "text": "DON PEDRO. I would she had bestowed this dotage on me; I would have daffed all other respects and made her half myself."
                            },
                            {
                                "example_id": "f9bb3007-9a1d-46af-8f66-84d8dcb9b72a",
                                "sense_id": "4e47d114-30dd-3c8a-897f-69ea5bc6fe47",
                                "text": "Such is the record of Scripture. Nor can you daff it aside by saying that local and temporary conditions condemned women to silence and private life."
                            }
                        ]
                    },
                    {
                        "sense_id": "e804c662-4382-3a04-9fd7-abc8edc16126",
                        "entry_id": "8f360c27-1f53-3d40-99b3-bd165ed35350",
                        "glosses": [
                            "To turn (someone) aside; divert."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
