{
    "word_family": [
        "injure",
        "injurious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca60a8ba-439a-3659-a4ed-b1a6fdebd589",
                    "sense_definition": "Physical harm or damage done to the body of a person or animal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "harm_to_living",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had to leave the game due to a serious leg <w>injury</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмену пришлось покинуть игру из-за серьезной <w>травмы</w> ноги.",
                                "zh": "这位运动员因为严重的腿部<w>受伤</w>不得不退赛。"
                            }
                        },
                        {
                            "text": "It took him several months to fully recover from his back <w>injury</w>.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько месяцев, чтобы полностью восстановиться после <w>травмы</w> спины.",
                                "zh": "他花了几个月的时间才从背部<w>损伤</w>中完全康复。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wound",
                        "lesion",
                        "damage"
                    ],
                    "common_phrases": [
                        "serious injury",
                        "minor injury",
                        "sustain an injury",
                        "internal injury",
                        "recover from an injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический вред или повреждение, нанесенное телу человека или животного.",
                        "zh": "对人或动物身体造成的物理伤害或损伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тра́вма",
                                "target_lang_sense_clarification": "общее название для физического повреждения организма"
                            },
                            {
                                "target_lang_word": "поврежде́ние",
                                "target_lang_sense_clarification": "нарушение целостности тканей, часто в медицинском или официальном контексте"
                            },
                            {
                                "target_lang_word": "ра́на",
                                "target_lang_sense_clarification": "открытое повреждение тканей, часто с кровотечением"
                            },
                            {
                                "target_lang_word": "ране́ние",
                                "target_lang_sense_clarification": "повреждение, нанесенное оружием или в бою"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受伤",
                                "target_lang_sense_clarification": "指身体受到伤害的状态"
                            },
                            {
                                "target_lang_word": "损伤",
                                "target_lang_sense_clarification": "指身体组织或器官的损害"
                            },
                            {
                                "target_lang_word": "伤",
                                "target_lang_sense_clarification": "指身体上的伤口或伤害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e25a621-09c5-370b-9835-34a3c7cf17c6",
                    "sense_definition": "Emotional or psychological harm caused by a traumatic event or stress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harm_to_living",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The harsh criticism caused a deep emotional <w>injury</w> that lasted for years.",
                            "target_lang_translations": {
                                "ru": "Резкая критика нанесла глубокую душевную <w>рану</w>, которая не заживала годами.",
                                "zh": "严厉的批评造成了持续多年的深层<w>心灵创伤</w>。"
                            }
                        },
                        {
                            "text": "Therapy is often required to heal a psychological <w>injury</w> after a traumatic experience.",
                            "target_lang_translations": {
                                "ru": "Терапия часто требуется, чтобы вылечить психологическую <w>травму</w> после пережитого потрясения.",
                                "zh": "经历创伤后，通常需要通过治疗来修复<w>心理创伤</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scathe",
                        "scath",
                        "wound"
                    ],
                    "common_phrases": [
                        "psychological injury",
                        "emotional injury"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоциональный или психологический вред, вызванный травмирующим событием или стрессом.",
                        "zh": "由创伤性事件或压力引起的心理或情感上的伤害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тра́вма",
                                "target_lang_sense_clarification": "психологическое потрясение"
                            },
                            {
                                "target_lang_word": "ра́на",
                                "target_lang_sense_clarification": "перен. глубокая душевная боль или страдание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "心理创伤",
                                "target_lang_sense_clarification": "指精神上受到的严重打击"
                            },
                            {
                                "target_lang_word": "心灵创伤",
                                "target_lang_sense_clarification": "指情感上受到的深层伤害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd78b5b2-f952-37dd-88fa-22ef22ef0b17",
                    "sense_definition": "Harm or damage to a person's rights, reputation, or property, often used in legal contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer specialized in cases involving personal <w>injury</w> and compensation claims.",
                            "target_lang_translations": {
                                "ru": "Адвокат специализировался на делах, связанных с телесными <w>повреждениями</w> и исками о компенсации.",
                                "zh": "这位律师专门处理涉及人身<w>伤害</w>和赔偿要求的案件。"
                            }
                        },
                        {
                            "text": "Libel is considered a serious <w>injury</w> to a person's reputation under the law.",
                            "target_lang_translations": {
                                "ru": "Клевета по закону считается серьезным <w>ущербом</w> репутации человека.",
                                "zh": "在法律上，诽谤被视为对个人名誉的严重<w>损害</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scathe",
                        "scath"
                    ],
                    "common_phrases": [
                        "personal injury",
                        "bodily injury"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вред или ущерб правам, репутации или имуществу человека, часто используется в юридическом контексте.",
                        "zh": "对个人权利、名誉或财产造成的损害，常用于法律语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вред",
                                "target_lang_sense_clarification": "юридический термин, обозначающий умаление благ или прав"
                            },
                            {
                                "target_lang_word": "уще́рб",
                                "target_lang_sense_clarification": "потеря или урон, нанесенный имуществу или репутации"
                            },
                            {
                                "target_lang_word": "поврежде́ние",
                                "target_lang_sense_clarification": "в контексте телесных повреждений (bodily injury)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "指对利益或名誉造成的负面影响"
                            },
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "指对权利或名誉的侵害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9599ebd9-4a04-3c84-b780-4abb8bb03b26",
                    "sense_definition": "To cause harm, wrong, or damage to someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient texts, one might read how a knight did <w>injury</w> his opponent.",
                            "target_lang_translations": {
                                "ru": "В древних текстах можно прочесть, как рыцарь <w>ранил</w> своего противника.",
                                "zh": "在古籍中，人们可能会读到骑士是如何<w>伤害</w>对手的。"
                            }
                        },
                        {
                            "text": "He sought to <w>injury</w> his neighbor through deceitful actions.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>навредить</w> своему соседу обманными действиями.",
                                "zh": "他试图通过欺骗手段来<w>损害</w>邻居的利益。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять вред, зло или ущерб кому-либо или чему-либо.",
                        "zh": "对某人或某物造成伤害、不公或损害。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "навреди́ть",
                                "target_lang_sense_clarification": "причинить вред или зло"
                            },
                            {
                                "target_lang_word": "ра́нить",
                                "target_lang_sense_clarification": "нанести физическую рану"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "伤害",
                                "target_lang_sense_clarification": "指造成身体或心理上的痛苦"
                            },
                            {
                                "target_lang_word": "损害",
                                "target_lang_sense_clarification": "指造成利益或名誉上的损失"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}