                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b025d9c5-1536-3dba-ad7a-410dacb26b17",
                        "entry_id": "ce7aa83b-30b5-314d-bdba-ceca005cbdcc",
                        "glosses": [
                            "Einsetzung von jemandem oder etwas, Realisierung einer Vorgehensweise am Ort der Anwendung"
