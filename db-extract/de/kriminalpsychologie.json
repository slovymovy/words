                "senses": [
                    {
                        "sense_id": "99168314-9817-3361-a16d-7730347eabd5",
                        "entry_id": "7f1069b4-d80c-3ddf-9e55-c970305d5afc",
                        "glosses": [
                            "Teilbereich der Psychologie, der sich mit Psyche und Verhalten von Straftätern beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79166d72-ab49-45d0-818f-9a9a34a3eab9",
                                "sense_id": "99168314-9817-3361-a16d-7730347eabd5",
                                "text": "„Des weiteren besuchte er Übungen des Juristen Prof. Franz Exner (1881–1947) über ‚Grundzüge der Kriminalpsychologie‘ sowie des Mediziners Prof. August Döllken zum selben Thema, ein Gebiet, das ihn in Südafrika weiter beschäftigen sollte, weil es mit seinem ausgeprägten Interesse an den ‚poor whites‘ verbunden war.“"
                            },
                            {
                                "example_id": "c39bb3d5-d128-41ec-987a-2da5c66570da",
                                "sense_id": "99168314-9817-3361-a16d-7730347eabd5",
                                "text": "„In ihren Vorlesungen ging es um eine Einführung in die Kriminalpsychologie, weshalb sie gezwungen war, sperrige Begriffe der Fachterminologie zu verwenden und Theorien unzähliger Psychologen zu erörtern.“"
                            },
                            {
                                "example_id": "f202914a-eb0c-4cd3-b326-bf55bf6f9082",
                                "sense_id": "99168314-9817-3361-a16d-7730347eabd5",
                                "text": "„In Pretoria befand sich die Zentrale für angewandte Kriminalpsychologie.“"
                            },
                            {
                                "example_id": "905a18b6-3e05-439d-8e3e-f9eaaa5f5d1f",
                                "sense_id": "99168314-9817-3361-a16d-7730347eabd5",
                                "text": "„Nachdem sie das Fach drei Jahre lang belegt hatte, schrieb sie sich für Kriminalpsychologie ein und besuchte Cooper Rileys Seminar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
