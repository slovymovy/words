                        "entry_id": "42d7a094-9c80-3f51-ab4c-ac590c775c6c",
                        "glosses": [
                            "празднество, торжество с обильным и роскошным угощением, обычно сопровождаемое различными увеселениями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43270c9d-37f9-486a-9fa2-b1b96cba9457",
                                "sense_id": "145111d1-1e6a-3b50-a61c-98fbb959394f",
                                "text": "Княжеский пир."
                            },
                            {
                                "example_id": "7b0b39eb-8d0b-4ab6-b9e9-b7407e2d4d5d",
                                "sense_id": "145111d1-1e6a-3b50-a61c-98fbb959394f",
                                "text": "Свадебный пир."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f945079-b4b3-3f28-a86d-1f7469fa7526",
                        "entry_id": "42d7a094-9c80-3f51-ab4c-ac590c775c6c",
                        "glosses": [
                            "разг., шутл. обильное угощение; вкусная еда"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c945a699-6bac-46de-9b17-65f9b0e87297",
                                "sense_id": "2f945079-b4b3-3f28-a86d-1f7469fa7526",
                                "text": "Готовить деликатесы для пира."
                            },
                            {
                                "example_id": "850dd458-b861-4ded-abf6-b6e46c651fe3",
                                "sense_id": "2f945079-b4b3-3f28-a86d-1f7469fa7526",
                                "text": "Наготовить целый пир."
                            },
                            {
                                "example_id": "b09309bb-6889-4b36-b1ee-5685fec53171",
                                "sense_id": "2f945079-b4b3-3f28-a86d-1f7469fa7526",
                                "text": "Остатки пира."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6e69aea-b008-3790-80fb-4c2bda8ad984",
                        "entry_id": "42d7a094-9c80-3f51-ab4c-ac590c775c6c",
                        "glosses": [
                            "перен., устар. сражение, война; кровопролитие"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cd747cb-d14b-4c01-bff1-b67a1805abcb",
                        "source_entry_id": "42d7a094-9c80-3f51-ab4c-ac590c775c6c",
                        "source_sense_description": "празднество, торжество с обильным и роскошным угощением, обычно сопровождаемое различными увеселениями",
                        "target_lang_word": "Festessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                        "entry_id": "12712ca6-c24f-3f08-b79f-ffadbda9c2a5",
                                        "glosses": [
                                            "besonders gutes, aufwendiges, festliches Essen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f991a53-2817-4cb3-8515-dc90d2974aa3",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Die Mutter des Hauses hat ein Festessen gekocht."
                                            },
                                            {
                                                "example_id": "041b25e6-027c-4d27-9919-24834fe9cb6c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Einige Tage nach dem Festessen bei den Arkesdens kehrten Lucas und Barbara nach einer Fahrt durch das Marschland zum Haus ihrer Eltern zurück.“"
                                            },
                                            {
                                                "example_id": "ee155fcf-28b5-4f0b-9143-f29658698fe6",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Das Festessen war Vals Idee gewesen, als Dankeschön für Barons Gastfreundschaft.“"
                                            },
                                            {
                                                "example_id": "bea2228d-6610-4332-b5a0-478f4b4ee87c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Ein Fest ohne Festessen verdient seinen Namen nicht, es ist zum Scheitern verurteilt.“"
                                            },
                                            {
                                                "example_id": "81f68588-92b6-4bad-bab4-7ce3febb06ec",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das Ehepaar lädt zum Festessen."
                                            },
                                            {
                                                "example_id": "157bc23e-b12a-4476-a1f4-ce56cf0936f4",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das ist ja ein wahres Festessen!"
                                            },
                                            {
                                                "example_id": "56716240-cfb6-4775-8f75-154e20c18a2b",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Sie hatten die meisten Esswaren herausgeholt und diese, da sie anscheinend ein Festessen vorbereiten wollten, auf einem glatten Stein ausgebreitet.“"
                                            },
                                            {
                                                "example_id": "83f1f15c-95fb-41a2-be3a-2c0df497b6de",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Alles war für das Festessen vorbereitet, das Tier getötet, ausgenommen und bratfertig, als wir feststellten, dass der Backofen zu klein war für den imposanten Fisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed4655e2-a540-424c-a661-3243456058fd",
                        "source_entry_id": "42d7a094-9c80-3f51-ab4c-ac590c775c6c",
                        "source_sense_description": "празднество, торжество с обильным и роскошным угощением, обычно сопровождаемое различными увеселениями",
                        "target_lang_word": "Fest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                        "entry_id": "d409651f-8cfc-3bdc-a6ca-24575bb837c3",
                                        "glosses": [
                                            "größere Feier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6decffe8-7489-4977-982c-de3c4e009812",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "Wir feiern heute ein Fest."
                                            },
                                            {
                                                "example_id": "3ce9a780-8229-4029-a9f3-ced04effc536",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Weihnachten ist das Fest der Familie.“"
                                            },
                                            {
                                                "example_id": "6a9c41a5-717b-405b-9c73-a0910b3ddd3a",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Deshalb ist dieses Fest das vielleicht wichtigste überhaupt.“"
                                            },
                                            {
                                                "example_id": "681e6c94-1e39-45f2-bcdb-cfdfbff1d7f9",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Ein Fest ohne Festessen verdient seinen Namen nicht, es ist zum Scheitern verurteilt.“"
                                            },
                                            {
                                                "example_id": "f2f70d30-1f3e-48af-9510-10b0127a146a",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Erst die Reformation machte dem Fest ein Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
