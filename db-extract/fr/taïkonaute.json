                                        "entry_id": "9c5dcf7f-bfd8-31d1-8257-9ee831f23a9c",
                                        "glosses": [
                                            "A person who travels in space for the Chinese space program; a Chinese astronaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8653e3d5-1c59-4018-991e-02ca98e24b6d",
                                                "sense_id": "56ec0979-7c67-31be-a2c4-5cae10b03602",
                                                "text": "The past decade has seen remarkable events and changes: […] The Columbia disaster and a Chinese taikonaut in orbit"
                                            }
                                        ]
                                    }
                                ]
                            }
