                                        "sense_id": "66da0748-b50d-34f3-8ae7-401e95c70438",
                                        "entry_id": "14db38fd-5e42-32b5-93c9-1396495a525b",
                                        "glosses": [
                                            "een denkbeeldige lijn van pool naar pool die geldt als scheidslijn tussen twee opeenvolgende data in de kalender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e7b323-bb40-44b1-9286-79a70888f74b",
                                                "sense_id": "66da0748-b50d-34f3-8ae7-401e95c70438",
                                                "text": "Hij vliegt de ochtend binnen, passeert de internationale datumgrens en als hij murw en uitgeput op lax naar de gate zoekt waar het vliegtuig van American Airlines klaarstaat dat hem het laatste stuk over Amerika zal vervoeren, is het op de klok vier uur vroeger dan toen hij Melbourne verliet."
                                            },
                                            {
                                                "example_id": "d6f0a1f6-d331-4104-9e49-1ec833e237b9",
                                                "sense_id": "66da0748-b50d-34f3-8ae7-401e95c70438",
                                                "text": "Amerikaans-Samoa ligt op een steenworp afstand van Kiribati, aan de andere kant van de datumgrens. Daar is inmiddels 2 januari al weer aangebroken."
                                            }
                                        ]
                                    }
                                ]
                            }
