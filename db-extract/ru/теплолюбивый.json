                    },
                    {
                        "translation_id": "f26eef46-a678-4584-aa0d-c7a51e6c7ee1",
                        "source_entry_id": "2e9c95b8-b0ee-332d-93ba-3d5b6d4eeb26",
                        "source_sense_id": "26ff474c-9267-35c9-851e-671a4595ec98",
                        "target_lang_word": "wärmebedürftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wärmebedürftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                        "entry_id": "b239b533-eaba-375c-884e-1c829fa80cd7",
                                        "glosses": [
                                            "warme Temperaturen benötigend"
                                        ],
                                        "tags": [
                                            "meist von Pflanzen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0009a6df-4ee0-4510-8614-cad23dbf93f6",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„Basilikum ist eine sehr wärmebedürftige Pflanze. Temperaturen unter zehn Grad Celsius mag sie nicht, die Pflanze wirft die Blätter ab.“"
                                            },
                                            {
                                                "example_id": "c9397473-b4bc-4d68-8f63-ae40fed35fc7",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "Mais kann als wärmebedürftige Pflanze erst spät gesät werden."
                                            },
                                            {
                                                "example_id": "78c837aa-08d0-47ec-ac3e-9592edbc0734",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„Helmbohnen sind wärmebedürftiger als Gartenbohnen und benötigen einen vollsonnigen Platz.“"
                                            },
                                            {
                                                "example_id": "6bb4d16f-3659-403c-b756-a466f4eb578c",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„Lassen Sie die Pflanzen am besten so lange wie möglich draußen: Für die meisten wärmebedürftigen Kübelpflanzen ist das Winterquartier nicht mehr als eine Notlösung.“"
                                            },
                                            {
                                                "example_id": "2022d180-ca5b-470d-aa87-e287a5d0dd4b",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„Zum frostfreien Überwintern wärmebedürftiger Pflanzen eignen sich am besten Wintergärten, die die Wärme des Hauses verwerten können.“"
                                            },
                                            {
                                                "example_id": "a77f3295-8ccb-497a-9cce-f9fa98ff0e56",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„April – Was sie jetzt tun können – Alle Gemüsearten können nun ins Freie gesät werden, außer den wärmebedürftigen Bohnen, Gurken, Melonen, Kürbissen, Paprika, Auberginen, Okra oder Zuckermais – alles Arten, die ursprünglich aus den subtropischen Ländern stammen.“"
                                            },
                                            {
                                                "example_id": "1707bf3c-5767-4fa1-8d1c-3915de8cac28",
                                                "sense_id": "109d6017-0914-3e44-b784-402069f2fc64",
                                                "text": "„Nur dort, wo sich wärmebedürftige Gottesdienstbesucher aufhalten, schaltet der Pfarrer die Heizkissen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ad6d05a-3b36-448f-81ee-be56a518375f",
                        "source_entry_id": "2e9c95b8-b0ee-332d-93ba-3d5b6d4eeb26",
                        "source_sense_id": "26ff474c-9267-35c9-851e-671a4595ec98",
