                        ]
                    },
                    {
                        "translation_id": "79234b64-d158-4f19-9f09-ee3d5c7d55c9",
                        "source_entry_id": "4f66e97f-0f96-37b2-9115-87bf916b8d96",
                        "source_sense_id": "993b7297-3a59-388d-8f35-c5b5f22c1f7c",
                        "target_lang_word": "répulsif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répulsif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf24d99-f8b3-386e-ae90-474201ef6d98",
                                        "entry_id": "90239fbe-dc96-3b83-acbe-e21980ef56dd",
                                        "glosses": [
                                            "Qui repousse."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885e3297-729d-4470-8c2e-7e4aa0026725",
                                                "sense_id": "6bf24d99-f8b3-386e-ae90-474201ef6d98",
                                                "text": "Force répulsive."
                                            },
                                            {
                                                "example_id": "772b4b7c-12ac-48a9-9b45-c8cdaab7c5cc",
                                                "sense_id": "6bf24d99-f8b3-386e-ae90-474201ef6d98",
                                                "text": "Une difformité, ou une infirmité, si peu choquante qu’elle soit, est plus répulsive aux paysans qu’une laideur amère jointe à un corps bien constitué."
                                            },
                                            {
                                                "example_id": "869e0d18-c63b-4f94-b654-88054ce3717f",
                                                "sense_id": "6bf24d99-f8b3-386e-ae90-474201ef6d98",
                                                "text": "L’idée de la mort, qui obsède les gens âgés et la leur montre partout, tout près, alors même qu’elle reste loin encore, est si répulsive pour les jeunes, qu’ils se refusent à la voir, même quand elle est là menaçante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "répulsif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b40ace0d-0a82-3946-bc7c-4891427c65fe",
                                        "entry_id": "6deb3c8d-717a-3c2b-a913-5b73ae5152bf",
                                        "glosses": [
                                            "Substance ou appareil destiné à repousser des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d03f8c4-4bf4-4bf8-a04f-cbcfcd655992",
                                                "sense_id": "b40ace0d-0a82-3946-bc7c-4891427c65fe",
                                                "text": "Toutes sortes de raisons peuvent vous pousser à utiliser un répulsif pour chien ou chat : il gratte dans vos platebandes, il mordille vos plantations, il urine sur les murs ou les écorche, etc."
                                            },
                                            {
                                                "example_id": "ad3f0ce3-525a-4a1a-8d3a-9984807dc78b",
                                                "sense_id": "b40ace0d-0a82-3946-bc7c-4891427c65fe",
                                                "text": "Quelques années plus tard, deux autres répulsifs pour corbeaux sont découverts : la diphénylguanidine et le triacétate de guazatine. Ces produits sont assez strictement limités aux corvidés."
                                            },
                                            {
                                                "example_id": "6ce84fd5-763b-43d0-ae31-a2402e594c83",
                                                "sense_id": "b40ace0d-0a82-3946-bc7c-4891427c65fe",
                                                "text": "Le géraniol est un répulsif chassant les moustiques, mouches, cancrelats, fourmis et tiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
