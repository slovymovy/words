                    {
                        "translation_id": "e1498990-a735-4185-86fb-1997f65867d4",
                        "source_entry_id": "b126a02a-780c-3fee-9e2a-df6646b229e2",
                        "source_sense_id": "bcb1fa84-10c1-389a-b751-3509fad8ed8a",
                        "target_lang_word": "Paronym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae18ce3-5860-3638-b85d-ce3d3930f87e",
                                        "entry_id": "506b3183-def9-3dc7-b30b-3777256f7c54",
                                        "glosses": [
                                            "ein Wort einer Sprache, das einem Wort einer anderen Sprache lautlich (phonetisch) ähnlich ist und die gleiche Bedeutung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdec0a1-91e3-41c8-a362-1c4189b4da8f",
                                                "sense_id": "2ae18ce3-5860-3638-b85d-ce3d3930f87e",
                                                "text": "In der Literatur wird als Beispiel für Wörter, die Paronyme sind, auf deutsch „Sommer“ und englisch „summer“ verwiesen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                        "entry_id": "506b3183-def9-3dc7-b30b-3777256f7c54",
                                        "glosses": [
                                            "ein Wort, das morphologisch teilweise mit einem anderen übereinstimmt, aber eine andere Bedeutung hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef5ef48-25c1-4e26-95af-630929a0d26d",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "Bußmann verweist als Beispiele für Paronyme auf die Wörter der Wortfamilie, die aus dem Stamm „les-“ (zum Verb lesen) abgeleitet werden können."
                                            },
                                            {
                                                "example_id": "931aee66-3ba6-4ec8-80fd-99d5c5e15a7e",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "Duden. Das große Fremdwörterbuch nennt als Beispiele für Paronyme die Wortfamilie mit dem Stamm „red-“: „Rede- reden - Redner - redlich - beredt“."
                                            },
                                            {
                                                "example_id": "52244403-1495-4e8c-b822-28a4ae9a51cc",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "„Paronyme können bedingt sein durch fehlerhaften Gebrauch oder durch spielerischen Umgang mit der Sprache.“"
                                            },
                                            {
                                                "example_id": "94a104ad-ed5e-4aad-8fa6-8332a19bee31",
                                                "sense_id": "2abdbc42-a01d-3e99-b0df-047e4562c7fe",
                                                "text": "„Paronyme werden in der Regel nicht als Synonyme betrachtet, sondern es handelt sich um Ausdrücke mit einem erhöhten Grad an »ausdrucksgebundener Verwechslungsmöglichkeit« (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c740213-0f7d-4550-bf9e-5ccfe0fcf0ce",
                        "source_entry_id": "b126a02a-780c-3fee-9e2a-df6646b229e2",
                        "source_sense_id": "bcb1fa84-10c1-389a-b751-3509fad8ed8a",
                        "target_lang_word": "пароним",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пароним",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3655f4-8839-3c38-8ac0-20848dc1bb4d",
                                        "entry_id": "0ea5fb04-d2a3-391a-9d55-7f261df6eee4",
                                        "glosses": [
                                            "лингв. слово с частичным звуковым сходством (с данным словом), но отличающееся по смыслу (полностью или частично)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebfafdf9-cf63-4b55-8ad1-af05e48503c8",
                                                "sense_id": "9d3655f4-8839-3c38-8ac0-20848dc1bb4d",
                                                "text": "Также термином паронимия принято называть такое явление в речи, когда два слова, в какой-то мере сходно звучащие, но имеющие разное значение, ошибочно употребляются одно вместо другого. Например, употребление слова адресат вместо адресанта; боцман вместо лоцман; кремень вместо кремний является паронимией, а слова, составляющие такие пары, называются паронимами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
