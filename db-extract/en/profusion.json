                    },
                    {
                        "translation_id": "7ab6e6c9-7d9d-41bf-bd0a-8fe20e0fe842",
                        "source_entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "source_sense_description": "lavish or imprudent expenditure",
                        "target_lang_word": "Verschwendung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschwendung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                        "entry_id": "d2f5cc18-a4b0-3c1a-a312-55527038eebb",
                                        "glosses": [
                                            "unnötiger oder sinnloser Verbrauch von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443ceb17-3659-4f62-ab6c-7a120eb67b2c",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Geiz ist Grausamkeit gegen die Dürftigen und die Verschwendung ist es nicht weniger."
                                            },
                                            {
                                                "example_id": "ba7e0206-ffd4-40bd-b1d2-3106aff2f6a7",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Wo die Barmherzigkeit und Klugheit ist, da ist nicht Verschwendung noch Täuschung."
                                            },
                                            {
                                                "example_id": "54e79c73-1db1-4cbc-a4a9-bd0aa4011e4a",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "Du kannst doch nicht den halben Salat wegwerfen, nur weil er nicht so hübsch gekräuselt ist! Was für eine Verschwendung!"
                                            },
                                            {
                                                "example_id": "23a7838e-dbe0-4839-af79-415d650d4e50",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Die Ausbildung war die reinste Verschwendung von Zeit, Geld und Einsatz gewesen.“"
                                            },
                                            {
                                                "example_id": "dd8c0ea6-dd19-4219-a1d2-265769de949f",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Ich kann nicht behaupten, dass diese Verschwendung meiner Geldmittel mir irgendeine wesentliche Befriedigung verschaffte.“"
                                            },
                                            {
                                                "example_id": "ca48e427-ee5e-4440-9af9-acd28c338ce5",
                                                "sense_id": "aaa6d95d-972b-37de-8575-60243a6d9dbf",
                                                "text": "„Es herrschte dort der Überfluß, oder vielmehr die Verschwendung, die man in Paris bei allen Leuten dieser Klasse findet: große Gesellschaft, hohes Kartenspiel, prachtvolles Essen und ungezwungene Heiterkeit bei Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
