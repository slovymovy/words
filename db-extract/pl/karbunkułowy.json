                "translations": [
                    {
                        "translation_id": "69a5f4b5-0fa2-4d4d-9623-3eb41e554d41",
                        "source_entry_id": "f7f6d9b7-f0b5-3389-b37f-e1d8f81b13cf",
                        "source_sense_id": "ea8dd34a-2f97-3c65-b3b7-12a15f953adf",
                        "target_lang_word": "carbuncular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbuncular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ebe664d-4a7b-315b-a470-53528dfee5d8",
                                        "entry_id": "db623ed7-fa31-3031-8117-f139a4a4c3e0",
                                        "glosses": [
                                            "Of, pertaining to, or resembling a carbuncle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb88a22-b1dd-4024-94d3-d24ff2fc1887",
                                                "sense_id": "7ebe664d-4a7b-315b-a470-53528dfee5d8",
                                                "text": "Such a mass of carbuncular disease I have rarely seen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddd9ee25-c8fd-48da-b471-3036341d5184",
                        "source_entry_id": "f7f6d9b7-f0b5-3389-b37f-e1d8f81b13cf",
                        "source_sense_id": "ea8dd34a-2f97-3c65-b3b7-12a15f953adf",
                        "target_lang_word": "carbuncled",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carbuncled",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7aa018-b832-3b70-b6d6-8730347f9f32",
                                        "entry_id": "2c5c1f03-e596-3584-95cd-775def8a1300",
                                        "glosses": [
                                            "Set with carbuncles (red precious stones)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b23b104-5e0d-464a-b6ad-2c291cfd67f4",
                                                "sense_id": "0b7aa018-b832-3b70-b6d6-8730347f9f32",
                                                "text": "He has deserved it [armour], were it carbuncled / Like holy Phoebus' car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb58d22-2c98-3fdd-b273-325c2837d33d",
                                        "entry_id": "2c5c1f03-e596-3584-95cd-775def8a1300",
                                        "glosses": [
                                            "Affected with a carbuncle or carbuncles (red sores, pimples or blotches)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79568610-1df0-4c86-9302-a5c470c808c1",
                                                "sense_id": "cdb58d22-2c98-3fdd-b273-325c2837d33d",
                                                "text": "a carbuncled face"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69352669-78f3-49b9-8ed7-55fba0836e60",
                        "source_entry_id": "f7f6d9b7-f0b5-3389-b37f-e1d8f81b13cf",
                        "source_sense_id": "ea8dd34a-2f97-3c65-b3b7-12a15f953adf",
                        "target_lang_word": "charbonneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charbonneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4311a59b-02e1-3fd7-8e08-3be4bd9d562e",
                                        "entry_id": "f21ce276-7492-36f1-be5e-f6ddefd2ebac",
                                        "glosses": [
                                            "Qui tient du charbon."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1d60f6-da29-47df-b8e7-605693fe31db",
                                                "sense_id": "4311a59b-02e1-3fd7-8e08-3be4bd9d562e",
                                                "text": "La fusion de l'acier pour qu'il ait les qualités qu’on recherche ne peut se faire avec un flux où il entre des matières charbonneuses; celles-ci dans la fusion le rendent intraitable."
                                            },
                                            {
                                                "example_id": "58a32831-e368-4d42-82d9-d1b4c8f59bab",
                                                "sense_id": "4311a59b-02e1-3fd7-8e08-3be4bd9d562e",
                                                "text": "En Islande, toutes les empreintes tertiaires proviennent du surturbrand, formation locale également d’eau douce qui consiste en un mélange de menus lits charbonneux alternant avec une roche tufacée à la constitution de laquelle les détritus basaltiques remaniés par les eaux ont certainement contribué."
                                            },
                                            {
                                                "example_id": "a3906bbd-ff60-4e89-8ef8-41de2695ce5c",
                                                "sense_id": "4311a59b-02e1-3fd7-8e08-3be4bd9d562e",
                                                "text": "Si quelque matière charbonneuse devait être trouvée à Feuguerolles, ce serait plutôt le graphite, dont la valeur est nulle comme combustible, mais considérable à d’autres points de vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec180a7-20e3-32c1-b7b6-a039b7c9ca64",
                                        "entry_id": "f21ce276-7492-36f1-be5e-f6ddefd2ebac",
                                        "glosses": [
                                            "Qui est transformé en charbon ; qui a l’aspect du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3b2ccc-278b-4ec7-a24c-18f771fe8bd7",
                                                "sense_id": "7ec180a7-20e3-32c1-b7b6-a039b7c9ca64",
                                                "text": "Mèche charbonneuse, résidus charbonneux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85339b90-6544-3696-8bc1-6a1598c4d9be",
                                        "entry_id": "f21ce276-7492-36f1-be5e-f6ddefd2ebac",
                                        "glosses": [
                                            "Qui est d’une couleur très foncée qui se rapproche de celle du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859fbe11-2c22-4e36-b2c5-a626f3f06d83",
                                                "sense_id": "85339b90-6544-3696-8bc1-6a1598c4d9be",
                                                "text": "Visage, yeux charbonneux."
                                            },
                                            {
                                                "example_id": "fb806f46-5b35-4a54-9c84-f2efb10cff31",
                                                "sense_id": "85339b90-6544-3696-8bc1-6a1598c4d9be",
                                                "text": "Il y avait même une amie de ma mère qui avait la figure tout enfarinée comme une sardine crue, avec la bouche peinte, et les paupières charbonneuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc78f843-70ac-38ab-8197-abe9dcf5fe47",
                                        "entry_id": "f21ce276-7492-36f1-be5e-f6ddefd2ebac",
                                        "glosses": [
                                            "Qui se rapporte à la maladie du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c04e0a4-c8a3-41b0-8bd7-f747ce35cbde",
                                                "sense_id": "dc78f843-70ac-38ab-8197-abe9dcf5fe47",
                                                "text": "Dans un grand nombre de localités, les corps des animaux morts, abandonnés au milieu des champs, deviennent une source de dangers pour le voisinage, tant par les émanations infectes qu’ils dégagent, que par la production de mouches qui se nourrissent de cette chair putréfiée et dont les piqûres peuvent occasionner des affections charbonneuses."
                                            },
                                            {
                                                "example_id": "8e688a35-98bf-486e-afae-549c0117435f",
                                                "sense_id": "dc78f843-70ac-38ab-8197-abe9dcf5fe47",
                                                "text": "Son activité professionnelle ne souffrait pas de ces inquiétudes de maniaque, et au contraire. Enfiévré de travail, il était sans cesse par les routes à courir de vache vêlante en cochon charbonneux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e02d3d7-163b-43a7-a24d-dce095dab6f0",
                        "source_entry_id": "f7f6d9b7-f0b5-3389-b37f-e1d8f81b13cf",
                        "source_sense_id": "ea8dd34a-2f97-3c65-b3b7-12a15f953adf",
