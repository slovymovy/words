        "fr-extract.jsonl": [
            {
                "entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                "word": "galimafrée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6be40a6b-c3f6-4c11-b568-ee4524e45867",
                        "entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                        "tags": [
                            "plural"
                        ],
                        "form": "galimafrées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b34c3c58-d96b-30dd-87d1-62ef0202abe0",
                        "entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                        "glosses": [
                            "Sorte de fricassée composée de restes de viande."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "210fc58d-0849-458c-899e-227b4fd11f01",
                                "sense_id": "b34c3c58-d96b-30dd-87d1-62ef0202abe0",
                                "text": "[…] une tourbe de riboteurs qui venaient se repaître de galimafrées d’andouillettes et de tripes à la mode de Caen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d59537bd-d107-37cc-9c5b-1da53aa2b870",
                        "entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                        "glosses": [
                            "Mets mal préparé, déplaisant, et abondant."
                        ],
                        "tags": [
                            "broadly",
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3ec15f74-7012-422f-b277-898aefd6a528",
                                "sense_id": "d59537bd-d107-37cc-9c5b-1da53aa2b870",
                                "text": "Tronchin l’a condamné à ne manger que des légumes, des carottes, des fèves cuites à l’eau, « Monsieur, a dit M. le duc de Lorges, je ne peux digérer votre galimafrée ; elle me fait enfler le devant et le derrière. »."
                            },
                            {
                                "example_id": "e372ef66-0ef6-4fa0-9786-fc360b9ae279",
                                "sense_id": "d59537bd-d107-37cc-9c5b-1da53aa2b870",
                                "text": "Au prix de cette merveille, les \"plats cuisinés\" des concurrents n'étaient que de la galimafrée."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb47c8dc-33ed-34b2-bbf1-30ceb2f76224",
                        "entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                        "glosses": [
                            "Mélange absurde, vulgaire, informe, sans cohérence."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5a97d2dd-9366-4e8f-9893-bae7aa77e2cd",
                                "sense_id": "fb47c8dc-33ed-34b2-bbf1-30ceb2f76224",
                                "text": "Le peuple et même la bourgeoisie parlaient un patois dit « vache espagnole », vraie galimafrée composée du résidu de toutes les langues imaginables."
                            },
                            {
                                "example_id": "7d078ec6-a588-4866-a7d3-46e1f9cf76a4",
                                "sense_id": "fb47c8dc-33ed-34b2-bbf1-30ceb2f76224",
                                "text": "Le portail de la Chartreuse, de marbre blanc, est une magnifique galimafrée de tous les ornements imaginables ; statues, bas-reliefs, feuillages, bronzes, médailles, colonnes, clochers, etc. ; le tout distribué sans choix et sans goût : on ne pourroit du haut en bas, placer le doigt sur une place vide d’ornement ; cela ne laisse pas de faire un coup d’œil qui amuse la vue, car il y a, par-ci par-là, de bons morceaux ; mais c’est toujours du gothique. Je ne sais si je me trompe, mais qui dit gothique dit presque infailliblement un mauvais ouvrage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f714d87-2eec-46bd-b050-034157c214ea",
                        "source_entry_id": "3c58a905-f709-3982-a964-fb9db39f967c",
                        "source_sense_id": "fb47c8dc-33ed-34b2-bbf1-30ceb2f76224",
                        "source_sense_description": "Mélange sans cohérence",
                        "target_lang_word": "gallimaufry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallimaufry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a715d4c7-9953-3043-8f63-dd52fb920371",
                                        "entry_id": "96e830e8-2ed2-3b2b-89c5-aeca24137a4f",
                                        "glosses": [
                                            "A hash of various kinds of meats, a ragout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d8e9aa-fea2-4cf5-bdb2-7b30847bb39e",
                                                "sense_id": "a715d4c7-9953-3043-8f63-dd52fb920371",
                                                "text": "At length, having discussed in turn pilaus, keebaubs, ollas, and a legion of gallimaufrys not mentioned in the classic pages of Kitchener and Ude, the cook's brain became completely addled by the elaborate and conflicting directions bestowed upon him; […]"
                                            },
                                            {
                                                "example_id": "178c04a2-2f7d-43d1-932e-9c562cac907b",
                                                "sense_id": "a715d4c7-9953-3043-8f63-dd52fb920371",
                                                "text": "I have tried many times, but always without success, to ascertain the average daily ration consumed by the Chinese railroad laborer, as a means of comparing their value with that of Americans. The reason this cannot be obtained is because they eat so many oily gallimaufries, alliaceous stews and indescribable vegetable hotchpotches, of which the ingredients are principally brought from China and have Chinese names."
                                            },
                                            {
                                                "example_id": "f190f9b7-fc9b-44aa-a60c-66b6990a6653",
                                                "sense_id": "a715d4c7-9953-3043-8f63-dd52fb920371",
                                                "text": "For gallimaufrey, roast poultry or capons, and cut into pieces. After fry with lard or goose lard. When they are fried, put in wine and verjuice. For spices, put some ginger powder and, to thicken, cameline, and a moderate amount of salt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                        "entry_id": "96e830e8-2ed2-3b2b-89c5-aeca24137a4f",
                                        "glosses": [
                                            "Any absurd medley, an elaborate mishmash"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5f0a05f-8338-40bc-8ee2-4b34334470e1",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "[O]ur mother tongue, which truly of it ſelfe is both ful enough for proſe, and ſtately enough for verſe, hath long time beene counted moſt bare and barren of both. Which default, when as ſome endeuoured to ſalue and recure, they patched vp the holes with peeces and ragges of other languages; borrowing here of the French, there of the Italian, euery where of the Latine, not weighing how ill thoſe tongues accord with themſelues, but much worſe with ours: So how they haue made our Engliſh tongue a gallimaufrey or hodgepodge of all other ſpeeches."
                                            },
                                            {
                                                "example_id": "e535af72-816f-418d-a4ea-df16ec3f709f",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "Reader, Gentle or ungentle, I write to all, knowing that all have now got almoſt an equall ſhare and intereſt in this Gallimaufry or Hotchpot which our Grandee Pſeudo-Politicians with their negative and demoliſhing Councils have made, both of Church and Commonwealth: […]"
                                            },
                                            {
                                                "example_id": "a530319e-8ace-4ab2-aa8f-f1f35e429243",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "We frankly confeſs, that a different ſpecies of ſolicitude is, in the preſent inſtance, excited in us, as Britiſh Critics; a ſolicitude for the credit of the compiler, a ſolicitude for the honour of his countrymen, on account of this crude, incongruous, farrago; this gallimaufry of Scottiſh antiquarianiſm."
                                            },
                                            {
                                                "example_id": "48cdf563-b8e4-4e81-aba0-71ab1f12e142",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "[William] Shakespeare's early comedies are a gallimaufry of experiments, but each plays its part in the gradual conquest of the medium, the increasing mastery of its complex expressive capacities."
                                            },
                                            {
                                                "example_id": "eb3a3e38-e080-43ec-be64-c43fbafcb736",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "The language of writers who are safely dead, and can be studied without fear of their exerting a subversive influence, bears the respectable label 'old Scots dialect'; the same tongue spoken by the living compatriots of these writers is 'bad grammar'. […] This attitude is of course not new; though perhaps seldom expressed so blatantly. I call it the Pinkerton syndrome, after one of the many memorable figures in out national gallimaufray of scholarly eccentrics. John Pinkerton (1758–1826), poet, critic, historian, dramatist and Celtophobe, in 1786 produced a book, entitled Ancient Scotish Poems, never before in print: […]"
                                            },
                                            {
                                                "example_id": "2ba97074-7e01-4d18-8d05-5473567cd46e",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "A gallimaufry of minimal action and maximal thought, this is a creditable stab at writing the Great American novel."
                                            },
                                            {
                                                "example_id": "ffadb2cc-6aaa-418a-a2d7-965013f28f75",
                                                "sense_id": "cfa3885c-22d7-3d86-8137-715420f03170",
                                                "text": "[…] what students are taught instead is a gallimaufry of \"texts\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
