        "fr-extract.jsonl": [
            {
                "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                "word": "tintouin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4047e3c9-a2a0-452a-92f0-dd23d6ed830f",
                        "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                        "tags": [
                            "plural"
                        ],
                        "form": "tintouins"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8740659-3db2-3d93-ab6e-33ecb5b59ab0",
                        "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                        "glosses": [
                            "Bourdonnement, bruit dans les oreilles."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4dbe746d-06f1-455d-a1a8-54e8e9958abf",
                                "sense_id": "f8740659-3db2-3d93-ab6e-33ecb5b59ab0",
                                "text": "Avoir un tintouin continuel dans les oreilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "92b1187f-5a73-3501-8183-29a1d6491e29",
                        "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                        "glosses": [
                            "Inquiétude qu’on a du succès de quelque chose."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "86381caa-7f40-4224-aede-e1f9df4c0c43",
                                "sense_id": "92b1187f-5a73-3501-8183-29a1d6491e29",
                                "text": "Bigre, j’en ai eu, du tintouin, avec la moto ! se dit Bert en songeant aux coups de coussin éventré et à sa lutte impuissante contre les flammes qui renaissaient sans cesse."
                            },
                            {
                                "example_id": "5b68e22e-8d50-40ad-b71a-041c0a49f6c7",
                                "sense_id": "92b1187f-5a73-3501-8183-29a1d6491e29",
                                "text": "« Eh bien, avoir encore du tintouin comme ça à mon âge, non, mais dis ! Est-ce que c’est une vie ? »"
                            }
                        ]
                    },
                    {
                        "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                        "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                        "glosses": [
                            "Embarras que cause une affaire ou une personne."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "18e9474b-30d8-4325-b1fc-28f214e652e7",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "On juge maintenant son procès, il doit avoir du tintouin. — Cette affaire lui donnera beaucoup de tintouin."
                            },
                            {
                                "example_id": "61fcd292-6d6b-4e76-a405-c57d93eae336",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "Il va à la table et se verse un grand verre de curaçao.\nLenglumé.– Qu’est-ce que tu fais là ?\nMistingue, buvant.– Je ne sais pas, mais, quand j’ai du tintouin, je m’étourdis !…"
                            },
                            {
                                "example_id": "66f86bef-9686-4d71-a68d-0fdbd7875aa3",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "Parmi les clientes dont on m’avait plus spécialement confié la garde, les plus baveuses me donnaient un foutu tintouin."
                            },
                            {
                                "example_id": "639a4cca-9efd-44be-b82c-68fc1effd1b3",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "Tu t’intéresses donc à moi ? Je croyais que tu avais d’autres tintouins."
                            },
                            {
                                "example_id": "2c508283-42cb-458b-8bee-d3ba6f323131",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "Mais je m’attends à être obligé de traverser des jardins potagers. À pied c’est facile s’il faut enjamber des clôtures, mais vous, avec votre mulet, vous aurez du tintouin."
                            },
                            {
                                "example_id": "862370ea-c2f6-46d8-b368-f1154bc63ee0",
                                "sense_id": "aa5edf52-c8d3-3bb1-809a-bad79ba35873",
                                "text": "Le maître des lieux est connu pour le luxe de ses équipages de chasses : il ne se considérerait pas comme un homme bien né si des hécatombes ne se perpétraient en automne sur ses terres : l'élevage des couvées, le choix des gardes-chasse et leur connivence avec les braconniers lui donnent du tintouin."
                            }
                        ]
                    },
                    {
                        "sense_id": "c263be73-24c8-3073-9dbd-0380dd82f00a",
                        "entry_id": "f0bb445d-0982-3f53-87db-eaa563a6314a",
                        "glosses": [
                            "Bruit, désordre, chahut …"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6cd634f7-424c-4d39-89e9-cce3ad938045",
                                "sense_id": "c263be73-24c8-3073-9dbd-0380dd82f00a",
                                "text": "Bon, les enfants ça suffit ! Vous avez fait assez de tintouin comme ça. Il faudrait vous calmer."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
