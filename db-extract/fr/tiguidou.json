                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86684e54-bd61-4c97-8893-786e83736c10",
                                                "sense_id": "e6f8e295-6fe5-3018-a88a-7bf3d1212663",
                                                "text": "„Alles paletti also? Ganz und gar nicht! Der deutsch-mallorquinische Zeitungsmarkt ist hart umkämpft.“"
                                            },
                                            {
                                                "example_id": "74ade560-d268-4ea7-96e2-99b032971d96",
                                                "sense_id": "e6f8e295-6fe5-3018-a88a-7bf3d1212663",
