    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d90c0e72-71bc-3d60-8e65-e0bcdbf063c3",
                    "sense_definition": "Qui est guidé par un idéal noble, qui privilégie des valeurs morales ou utopiques plutôt que les réalités concrètes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idealisme_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré les difficultés quotidiennes, il garde une vision <w>idéaliste</w> de la société et de l'avenir."
                        },
                        {
                            "text": "Cette jeunesse <w>idéaliste</w> s'engage activement pour défendre la justice et protéger la planète."
                        }
                    ],
                    "synonyms": [
                        "utopiste",
                        "rêveur"
                    ],
                    "antonyms": [
                        "réaliste",
                        "pragmatique"
                    ],
                    "common_phrases": [
                        "vision idéaliste",
                        "jeunesse idéaliste"
                    ]
                },
                {
                    "sense_id": "89d32845-4dcc-3834-bf3f-d3fedbeb5497",
                    "sense_definition": "Qui appartient ou se rapporte à la doctrine philosophique de l'idéalisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur consacre son cours d'histoire à la tradition de la philosophie <w>idéaliste</w> allemande."
                        },
                        {
                            "text": "Cette approche <w>idéaliste</w> affirme que la pensée détermine la réalité plutôt que la matière."
                        }
                    ],
                    "antonyms": [
                        "matérialiste"
                    ],
                    "common_phrases": [
                        "philosophie idéaliste"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ebaa39f-02b5-3363-9c2c-1090862e5525",
                    "sense_definition": "Personne guidée par de nobles principes ou des rêves utopiques, sans toujours tenir compte des contraintes réelles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "idealisme_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup le considèrent comme un grand <w>idéaliste</w>, mais ses propositions inspirent de nombreux citoyens."
                        },
                        {
                            "text": "C'est un incorrigible <w>idéaliste</w> qui refuse d'abandonner ses projets humanitaires malgré les échecs."
                        }
                    ],
                    "synonyms": [
                        "utopiste",
                        "rêveur"
                    ],
                    "antonyms": [
                        "réaliste",
                        "pragmatique"
                    ],
                    "common_phrases": [
                        "grand idéaliste",
                        "incorrigible idéaliste"
                    ]
                },
                {
                    "sense_id": "59e51f5a-d8ff-38a3-b16f-1f7ae3261a9b",
                    "sense_definition": "Partisan ou théoricien de la doctrine philosophique de l'idéalisme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En soutenant la primauté absolue de l'esprit, ce penseur s'est affirmé comme un véritable <w>idéaliste</w>."
                        },
                        {
                            "text": "Les débats de l'époque opposaient régulièrement les partisans de la matière aux <w>idéalistes</w> convaincus."
                        }
                    ],
                    "antonyms": [
                        "matérialiste"
                    ]
                }
            ]
        }
    ]
