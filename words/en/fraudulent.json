{
    "word_family": [
        "fraud",
        "defraud"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f5fdc919-c0a0-3639-8c01-eeabff1c29d8",
                    "sense_definition": "Dishonest; based on fraud or deception.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was accused of <w>fraudulent</w> business practices to hide their massive financial losses.",
                            "target_lang_translations": {
                                "de": "Dem Unternehmen wurden <w>betrügerische</w> Geschäftspraktiken vorgeworfen, um seine massiven finanziellen Verluste zu verschleiern."
                            }
                        },
                        {
                            "text": "He used <w>fraudulent</w> documents to obtain a loan under a false identity.",
                            "target_lang_translations": {
                                "de": "Er verwendete <w>gefälschte</w> Dokumente, um unter einer falschen Identität einen Kredit zu erhalten."
                            }
                        }
                    ],
                    "synonyms": [
                        "deceitful",
                        "dishonest",
                        "corrupt"
                    ],
                    "antonyms": [
                        "honest",
                        "genuine"
                    ],
                    "common_phrases": [
                        "fraudulent activity",
                        "fraudulent scheme",
                        "fraudulent claim"
                    ],
                    "target_lang_definitions": {
                        "de": "Unehrlich; auf Betrug oder Täuschung beruhend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "betrügerisch",
                                "target_lang_sense_clarification": "auf Betrug beruhend, arglistig"
                            },
                            {
                                "target_lang_word": "unlauter",
                                "target_lang_sense_clarification": "nicht den Regeln oder der Ehrlichkeit entsprechend"
                            },
                            {
                                "target_lang_word": "schwindlerisch",
                                "target_lang_sense_clarification": "täuschend, unredlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "950c1386-e049-364e-b091-4d9aac959125",
                    "sense_definition": "False or phony, especially regarding documents or currency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank teller immediately identified the <w>fraudulent</w> check as a forgery.",
                            "target_lang_translations": {
                                "de": "Der Bankangestellte erkannte den <w>gefälschten</w> Scheck sofort als Fälschung."
                            }
                        },
                        {
                            "text": "Police discovered a <w>fraudulent</w> passport hidden inside the suspect's luggage.",
                            "target_lang_translations": {
                                "de": "Die Polizei entdeckte einen <w>gefälschten</w> Reisepass, der im Gepäck des Verdächtigen versteckt war."
                            }
                        }
                    ],
                    "synonyms": [
                        "fake",
                        "counterfeit",
                        "forged"
                    ],
                    "antonyms": [
                        "authentic",
                        "real"
                    ],
                    "common_phrases": [
                        "fraudulent check",
                        "fraudulent document"
                    ],
                    "target_lang_definitions": {
                        "de": "Gefälscht oder unecht, insbesondere in Bezug auf Dokumente oder Geldmittel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gefälscht",
                                "target_lang_sense_clarification": "nicht echt, imitiert"
                            },
                            {
                                "target_lang_word": "betrügerisch",
                                "target_lang_sense_clarification": "erschlichen oder zur Täuschung verwendet"
                            },
                            {
                                "target_lang_word": "unecht",
                                "target_lang_sense_clarification": "nicht original"
                            }
                        ]
                    }
                }
            ]
        }
    ]
