                                            {
                                                "example_id": "f3e75c43-c55f-446f-9159-485e8fe5970e",
                                                "sense_id": "dbf9a59b-40c4-3479-8a4c-3eb50e61f6dc",
                                                "text": "Diese Abhandlung ist tendenziös, weil ein politisch voreingenommener Journalist seine eigene Tendenz (seine subjektive Meinung) zu erkennen gibt."
                                            },
                                            {
                                                "example_id": "ce43b7c3-34ea-466b-abfa-ca22a37a1d05",
                                                "sense_id": "dbf9a59b-40c4-3479-8a4c-3eb50e61f6dc",
                                                "text": "Dieser Fernsehkommentar ist politisch gefärbt und deshalb tendenziös."
                                            },
                                            {
                                                "example_id": "e950958e-e92d-4ec1-90a8-ecd316a3398f",
                                                "sense_id": "dbf9a59b-40c4-3479-8a4c-3eb50e61f6dc",
                                                "text": "„Religiöser Extremismus basiert in der Regel auf einer engen und tendenziösen Auslegung religiöser Inhalte.“"
                                            }
