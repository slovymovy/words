                ],
                "senses": [
                    {
                        "sense_id": "d6dc622d-d3b1-3383-8a31-278770cace4e",
                        "entry_id": "7b84a998-ce78-30bb-b09f-eba4c216d617",
                        "glosses": [
                            "mit dünnen Platten/Plättchen aus Silber (zum Beispiel zur Verzierung) versehen seiend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf16aefa-ea49-4605-8142-35e50737a338",
                                "sense_id": "d6dc622d-d3b1-3383-8a31-278770cace4e",
                                "text": "„Hochaufgerichtet sitzen Reiter in silberbeschlagenen Sätteln auf grünen Hügelkuppen vor schneebedeckten Fünf- und Sechstausender, bewachen einige hundert Schafe, eine Handvoll Pferde.“"
                            },
                            {
                                "example_id": "9a1f02c6-d637-436e-82c9-33d84d21eed1",
                                "sense_id": "d6dc622d-d3b1-3383-8a31-278770cace4e",
                                "text": "„Eine lange goldene Halskette mit einem Kreuz von Rubinen, ein kunstvoll silberbeschlagener Gürtel mit Ledertasche und Dolch in silbergetriebener Scheide und spitze Samtschuhe vollendeten den kleidsamen Anzug.“"
                            },
                            {
                                "example_id": "91260843-eb0b-4501-a276-bf87a4f1ec49",
                                "sense_id": "d6dc622d-d3b1-3383-8a31-278770cace4e",
                                "text": "„Vier in silberbeschlagenes Zaumzeug geschirrte Rappen hatten den Wagen mit dem Leichnam durch die Straßen und Gassen und schließlich über die von uralten Eichen gesäumte Allee gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74a9abb2-678c-4055-a00c-396c63d74742",
