            {
                "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                "word": "vertex",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b9ee14e-3428-399d-9d4c-a2fda13f9377",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Sommet du crâne, de la tête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9730209b-3fef-470f-9e30-35371e8b9690",
                                "sense_id": "8b9ee14e-3428-399d-9d4c-a2fda13f9377",
                                "text": "Dans l’épreuve de Weber, on met le diapason sur le vertex."
                            }
                        ]
                    },
                    {
                        "sense_id": "5490f33b-45aa-38ea-9239-3d3b75844f29",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Partie supérieure de la tête de l’oiseau, ou calotte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f0c3b8-6bf7-42e4-8ca2-5ceb8f2fd617",
                                "sense_id": "5490f33b-45aa-38ea-9239-3d3b75844f29",
                                "text": "Le vertex de la fauvette à tête noire est brun lorsque c'est une femelle"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ff5c1fa-5bad-303d-b593-89735037818d",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Portion horizontale de la face des insectes, qui touche le front et située derrière les yeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3551d14c-46ff-41b6-b4e2-b06474afa9aa",
                                "sense_id": "2ff5c1fa-5bad-303d-b593-89735037818d",
                                "text": "Les insectes ont parfois deux ou trois ocelles placés sur le front ou sur le vertex."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dcd5de2-5144-3f98-a886-6a8f51312d41",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Point de latitude maximale ou minimale d'une orthodromie tracée sur une surface de révolution. En ce point, et en projection sphérique, l'orthodromie croise à angles droits le méridien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f22b1f9c-a3bc-455f-8e8c-823504c59d71",
                                "sense_id": "2dcd5de2-5144-3f98-a886-6a8f51312d41",
                                "text": "L'orthodromie joignant Paris à Montréal a son vertex situé juste en dessous du 54ᵉ parallèle nord et à proximité du 31ᵉ méridien ouest."
                            },
                            {
                                "example_id": "66760da1-e066-4043-9d60-d2c73acba9e2",
                                "sense_id": "2dcd5de2-5144-3f98-a886-6a8f51312d41",
                                "text": "Les pôles sont les vertex des méridiens."
                            }
                        ]
                    },
                    {
                        "sense_id": "61ea4a92-f1e8-354f-b64b-f3fd3b93b3ca",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Point de la sphère céleste vers lequel semble se diriger un ensemble d’étoiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7983e99-43f8-466e-9e66-3bfdf92f528f",
                                "sense_id": "61ea4a92-f1e8-354f-b64b-f3fd3b93b3ca",
                                "text": "L’amas des Hyades s’éloigne de nous à 32 km/s et semble se diriger vers un vertex situé à l’est de l’étoile Bételgeuse d’Orion."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c9b30f4-1eee-3926-b62c-2ac4ea54b70c",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Point virtuel présent sur les diagrammes de Feynman où a lieu l’émission ou l’absorption d’une particule."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "20790efc-7f6a-49a3-bec7-5288545e41dd",
                                "sense_id": "8c9b30f4-1eee-3926-b62c-2ac4ea54b70c",
                                "text": "Les particules y étaient représentées par des lignes (qui pouvaient être dessinées de plusieurs façons en fonction du type de particule désigné) et leurs interactions par des vertex."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd71780b-5694-37d6-90d3-2b18834caece",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Hauteur du point le plus élevé de la trajectoire d’un projectile."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c5eee1bf-3804-3be3-b001-3a18dc3b1465",
                        "entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "glosses": [
                            "Point d’intersection entre deux ou plusieurs segments dans une construction 3D."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab3593f5-dae5-4cc8-9961-701f87761366",
                        "source_entry_id": "a2ebd02c-cae9-3135-9c9b-69fe08c0c3d7",
                        "source_sense_id": "8b9ee14e-3428-399d-9d4c-a2fda13f9377",
                        "source_sense_description": "Sommet du crâne",
                        "target_lang_word": "Scheitel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheitel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3844e444-1728-3b83-b5cc-3f9b1ec39524",
                                        "entry_id": "be485a98-1517-3e3e-b085-19ffafe63adb",
                                        "glosses": [
                                            "Linie in der Frisur, entlang derer sich die Haare in unterschiedliche Richtung legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5660184-0312-4a0a-945d-085ccb4ef285",
                                                "sense_id": "3844e444-1728-3b83-b5cc-3f9b1ec39524",
                                                "text": "Ich trage den Scheitel rechts."
                                            },
                                            {
                                                "example_id": "d4b4f554-51a3-4b97-b78f-d5fef23aa75f",
                                                "sense_id": "3844e444-1728-3b83-b5cc-3f9b1ec39524",
                                                "text": "„Er fing wieder von vorne an, sich einen Scheitel zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ce13e0f-580b-3c92-989b-d509470aad7f",
                                        "entry_id": "be485a98-1517-3e3e-b085-19ffafe63adb",
                                        "glosses": [
                                            "oberster Teil des Kopfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32fd6bd-f288-4d28-93e0-546d3779bb21",
                                                "sense_id": "7ce13e0f-580b-3c92-989b-d509470aad7f",
                                                "text": "Die Körpergröße wird vom Scheitel bis zur Sohle gemessen."
                                            },
                                            {
                                                "example_id": "0b8d2c75-180a-43ef-9af5-9683dca1ac52",
                                                "sense_id": "7ce13e0f-580b-3c92-989b-d509470aad7f",
                                                "text": "„Er reichte seinem Vater mit dem Scheitel fast bis an die Schultern: mit dem staubig weißen Haar, das ihm meistens ins Gesicht fiel.“"
                                            },
                                            {
                                                "example_id": "f1355e47-b790-4f04-a1c7-05072838ac4b",
                                                "sense_id": "7ce13e0f-580b-3c92-989b-d509470aad7f",
                                                "text": "„Simen Tjing ergriff eine Schere und schnitt ihr vom Scheitel aus der erfaßten Haarfülle eine dicke Strähne heraus, wickelte sie in Papier ein und steckte sie in die Tasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a304b2a9-a8f3-32ee-8154-16a7fa07e455",
                                        "entry_id": "be485a98-1517-3e3e-b085-19ffafe63adb",
                                        "glosses": [
                                            "höchster Punkt von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a0c01c-927f-4fe6-a2fe-1eca73965247",
                                                "sense_id": "a304b2a9-a8f3-32ee-8154-16a7fa07e455",
                                                "text": "Wir standen auf dem Scheitel des Hügels."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8f45cc19-94ba-3f95-b65b-0ac2f0111564",
                                        "entry_id": "be485a98-1517-3e3e-b085-19ffafe63adb",
                                        "glosses": [
                                            "Treffpunkt der Schenkel eines Winkels und Punkte größter oder kleinster Krümmung von Kegelschnitten"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dd72411-98ad-4394-b2c9-d311b9709122",
                                                "sense_id": "8f45cc19-94ba-3f95-b65b-0ac2f0111564",
                                                "text": "Um mit dem Geodreieck einen Winkel auszumessen, muss man den Nullpunkt am Scheitel anlegen."
                                            },
                                            {
                                                "example_id": "9d50712b-caec-4df7-b11c-35679d283a48",
                                                "sense_id": "8f45cc19-94ba-3f95-b65b-0ac2f0111564",
                                                "text": "„Aus der Scheitelform lässt sich, wie man am Namen schon erkennt, direkt der Scheitel der Parabel ablesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
