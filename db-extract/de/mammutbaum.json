                        "cross_references": [
                            {
                                "target_word": "wellingtonia",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab05bc13-0dd6-3c84-a148-720900bd9926",
                                        "entry_id": "621c4b07-830e-3448-b516-e4b6406bf850",
                                        "glosses": [
                                            "Espèce de grand arbre (sequoiadendron giganteum), appelé aussi séquoia géant, dont la taille varie entre 50 et 85 mètres pour un diamètre de 6 à 8 mètres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfa2d4a7-bf2d-49b7-bae9-b0ea9be0d12c",
                                                "sense_id": "ab05bc13-0dd6-3c84-a148-720900bd9926",
                                                "text": "Cèdres, wellingtonias, hêtres pourpres, arbres nains du Japon, saules pleureurs, magnolias, araucarias, feuilles persistantes et feuilles caduques, massifs, buissons, fourrés : le parc, entouré de barrières blanches, n’était pas grand, mais si divers que je n’avais jamais fini de l’explorer."
                                            },
                                            {
                                                "example_id": "a4f949ff-8fd5-49d8-bec0-99c0b0e845b0",
                                                "sense_id": "ab05bc13-0dd6-3c84-a148-720900bd9926",
                                                "text": "Un wellingtonia, des saules, des bouleaux entourent l’étonnante maison à colombages, coiffée d’un toit de chaume comme d’une perruque fabuleuse, tressée de beige et de gris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
