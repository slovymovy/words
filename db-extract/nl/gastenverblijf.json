                    {
                        "translation_id": "44a16812-cce2-4267-9ec2-bdcb772b38c3",
                        "source_entry_id": "ffd5745b-f0a3-3abd-b0c9-87a64b7cd440",
                        "source_sense_id": "d8068b90-3b3a-3fb0-aba1-05415fb7c893",
                        "target_lang_word": "guesthouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guesthouse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "644cd5da-7307-3ce0-8a8f-dfea91bb0550",
                                        "entry_id": "2830ad9a-ab4a-3532-9a05-ce105c5a0ea7",
                                        "glosses": [
                                            "A small house near a main house, for lodging visitors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd02aa64-467d-4c2b-911d-c564ced5de04",
                                                "sense_id": "644cd5da-7307-3ce0-8a8f-dfea91bb0550",
                                                "text": "The wine house and the guest house were hung with curtains shining bright against the wooden walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                        "entry_id": "2830ad9a-ab4a-3532-9a05-ce105c5a0ea7",
                                        "glosses": [
                                            "A private house offering accommodation to paying guests; a boarding house; a bed and breakfast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7fdad0-f264-41d7-8966-26bb16cb74c6",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "Low-season competition between the several backpackers and many guesthouses in town keeps prices down, but in high season expect steep price hikes (except at the backpackers) and book ahead."
                                            },
                                            {
                                                "example_id": "0e42bece-627c-46ab-81e1-5aee91a0bdaa",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "For me, in any case, Ladakh seemed a beautifully unfallen place next to the blue-glass shopping malls of modern Lhasa, the global village of pizza joints and guesthouses that is urban Nepal, or long-isolated Bhutan with its chic new hotels."
                                            },
                                            {
                                                "example_id": "cc224131-a2bd-4d70-be29-f4d5e90c4f0f",
                                                "sense_id": "0d1f3cea-fbd7-31f8-a7ae-d45e27965a2a",
                                                "text": "And Ms. Davies’s 7,000-square-foot guesthouse, the only building from the original estate to survive, is already a favorite among card-playing foursomes and others who want to lounge on the second-story deck and watch dolphins bob in the whitecapped waves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
