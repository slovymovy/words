                        "source_entry_id": "d7c34fd8-23c6-38a2-aa2b-6b2946c7c94a",
                        "source_sense_id": "c0bd474a-50af-32e4-b760-ee36f1d15ce7",
                        "source_sense_description": "Portfolio",
