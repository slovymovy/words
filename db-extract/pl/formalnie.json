                                                "example_id": "7c94f87a-28f0-4012-bbba-0732b078120e",
                                                "sense_id": "508b9415-ebb5-31d9-b569-4a72ec925c11",
                                                "text": "He was dressed too formally for the occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c53bc83-3cc3-315c-a7f2-b7ed9d081108",
                                        "entry_id": "b0a3ab5d-2611-30af-9e08-d04fcf517a71",
                                        "glosses": [
                                            "In accordance with official procedure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "627a98aa-d58a-4ba5-b73b-28d6f4f888b5",
                                                "sense_id": "9c53bc83-3cc3-315c-a7f2-b7ed9d081108",
                                                "text": "He formally filed a complaint, which involved much paperwork."
                                            },
                                            {
                                                "example_id": "07317b4e-811c-4470-9762-f6bd848cd3fb",
                                                "sense_id": "9c53bc83-3cc3-315c-a7f2-b7ed9d081108",
                                                "text": "Dans told CNN he will formally launch his campaign with a prayer breakfast Wednesday in Charleston."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31697c0-741d-3efd-ae81-69035fe0be37",
                                        "entry_id": "b0a3ab5d-2611-30af-9e08-d04fcf517a71",
                                        "glosses": [
                                            "In accordance with rigorous rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55771e77-16e3-458d-8aca-72523914ec61",
                                                "sense_id": "e31697c0-741d-3efd-ae81-69035fe0be37",
                                                "text": "He proved it formally but gave his students no intuitive feel for the matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "457ab168-7c9d-4698-bc70-af78e55caa34",
