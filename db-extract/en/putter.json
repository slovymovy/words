                    {
                        "translation_id": "f76b7a99-ac08-459c-b2ee-8c8e0b8290e1",
                        "source_entry_id": "0701b731-c373-35d7-810f-94da563fb427",
                        "source_sense_id": "60bba3e4-d26c-336e-a585-c7e0622963e4",
                        "source_sense_description": "to be active",
                        "target_lang_word": "возиться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "возиться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5cdcf6-62d8-3c17-8f72-c0af1f0c6714",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "беспокойно, суетливо, с напряжением двигаться"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e52a281d-024b-3ed4-b31b-b8bf70e3dc84",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "шуршать, копошиться с шумом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4a1ad4f-0506-41b9-a0c3-b3aa456e423a",
                                                "sense_id": "e52a281d-024b-3ed4-b31b-b8bf70e3dc84",
                                                "text": "Там двое каких-то водопроводчиков возились с гармоникой парового отопления."
                                            },
                                            {
                                                "example_id": "0b98ee9c-5002-4ce3-8b0f-89d1158b0282",
                                                "sense_id": "e52a281d-024b-3ed4-b31b-b8bf70e3dc84",
                                                "text": "Ладно, лишь бы сидел тихо. Только бы перестал возиться и напевать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a590497-2aae-39c8-93a7-38e3eebbb791",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "разг. действовать неуклюже и медлительно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c442d0b2-cefc-4dc6-a917-2dd25a42a5fa",
                                                "sense_id": "9a590497-2aae-39c8-93a7-38e3eebbb791",
                                                "text": "Ну что вы там возитесь?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7102fca3-76d4-36ea-a88b-a077dc9053d7",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "разг. заниматься чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c39aa9f-cf9c-4410-ae29-59cc756e5dfd",
                                                "sense_id": "7102fca3-76d4-36ea-a88b-a077dc9053d7",
                                                "text": "Если вы любите возиться с глиной, знаете, чем кучинская отличается от ленточной, а обе они от дружковской, если у вас дома случайно есть гончарный круг и вы на досуге балуетесь изготовлением керамики, — эта книга для вас."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9902a7f-f4f9-3a81-8ae7-3d77130cc483",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "страд. к возить"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdf693ae-2c0e-4f99-8f54-662d307b8c81",
                                                "sense_id": "a9902a7f-f4f9-3a81-8ae7-3d77130cc483",
                                                "text": "Эти товары возятся сюда издалека."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76d54a30-4e05-340d-abfb-a1e751a8002d",
                                        "entry_id": "ec0c02f6-7cc9-30dd-a435-08efb02838a8",
                                        "glosses": [
                                            "шутливо, игриво бороться,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96107034-f4e4-4e46-a0bf-88fd4b963121",
                                                "sense_id": "76d54a30-4e05-340d-abfb-a1e751a8002d",
                                                "text": "А иногда они начинают возиться, дерутся, хохочут, и от этого на душе не веселей, а ужас охватывает."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f8815c4-97ce-4918-90c1-6064bf351829",
                        "source_entry_id": "0701b731-c373-35d7-810f-94da563fb427",
                        "source_sense_id": "60bba3e4-d26c-336e-a585-c7e0622963e4",
                        "source_sense_description": "to be active",
                        "target_lang_word": "копошиться",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "копошиться",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "64faa68a-86cf-3430-aa8e-d482d8f1fdfa",
                                        "entry_id": "4ca5b626-33a2-3160-9317-db3db21304f2",
                                        "glosses": [
                                            "шевелиться, суетиться, двигаться (часто — медленно, в разных направлениях и на каком-либо ограниченном пространстве)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e565f8b7-b5ec-4afb-8159-6f33d2fdd409",
                                                "sense_id": "64faa68a-86cf-3430-aa8e-d482d8f1fdfa",
                                                "text": "В углу чулана, привязанный верёвкой к крюку, копошился в груде тряпья крупный серый гусь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08936f02-cce8-3cce-bc79-86a171854edb",
                                        "entry_id": "4ca5b626-33a2-3160-9317-db3db21304f2",
                                        "glosses": [
                                            "разг. шевелиться в душе, в сознании, постоянно беспокоить (о мыслях, чувствах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b9071c-d1c6-4333-9144-2afa5082f488",
                                                "sense_id": "08936f02-cce8-3cce-bc79-86a171854edb",
                                                "text": "Мысли эти копошились, пока я валялся в номере, пытаясь поспать хотя бы часок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc43d0da-9bf3-3509-976d-891946b23905",
                                        "entry_id": "4ca5b626-33a2-3160-9317-db3db21304f2",
                                        "glosses": [
                                            "разг. возиться с чем-либо, хлопотать, заниматься чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3de0e49-013d-4b00-b32e-0b1c07c71eba",
                                                "sense_id": "cc43d0da-9bf3-3509-976d-891946b23905",
                                                "text": "Золушка опять копошилась в кухне, с тоской вспоминая о первом бале ― взлёте своей судьбы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
