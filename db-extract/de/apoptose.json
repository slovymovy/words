                "senses": [
                    {
                        "sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                        "entry_id": "ef0d5c02-ecbd-3b0d-b04c-dfa9193ed740",
                        "glosses": [
                            "programmierter Zelltod"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785418fe-3cb8-4f51-a5ae-499346e07308",
                                "sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                                "text": "Die betroffenen Zellen gehen durch Apoptose zugrunde."
                            },
                            {
                                "example_id": "4508dcbb-f7ce-4635-a8b7-ae9ecb96c3bf",
                                "sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                                "text": "Die Apoptose ist eine genetisch vorprogrammierte Abfolge von Ereignissen, die zum Tod einer Zelle führen."
                            },
                            {
                                "example_id": "0199edd0-f114-4015-8bd0-c8a0ce91d061",
                                "sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                                "text": "Apoptose ist für die normale Entwicklung aller Tiere von entscheidender Bedeutung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d3e3d97-6c0a-4c1c-a409-764dcba7857a",
                        "source_entry_id": "ef0d5c02-ecbd-3b0d-b04c-dfa9193ed740",
                        "source_sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                        "source_sense_description": "Biologie: programmierter Zelltod",
                        "target_lang_word": "apoptosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apoptosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                                        "entry_id": "03c07c4c-458f-368a-80b1-6b4006316b64",
                                        "glosses": [
                                            "A process of programmed cell death by which cells undergo an ordered sequence of events which leads to death of the cell, as occurs during growth and development of the organism, as a part of normal cell aging, or as a response to cellular injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c1aa1e-947e-4e94-8299-862177c5058e",
                                                "sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                                                "text": "The term apoptosis is proposed for a hitherto little recognized mechanism of controlled cell deletion, which appears to play a complementary but opposite role to mitosis in the regulation of animal cell populations."
                                            },
                                            {
                                                "example_id": "ff56cd2c-76a4-46ec-9db8-1c0df72db70e",
                                                "sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                                                "text": "Indeed, so important is apoptosis that it is gradually becoming clear that almost all therapeutic cancer treatment works only because it induces apoptosis by alerting p53 and its colleagues."
                                            },
                                            {
                                                "example_id": "037ebad0-736a-4cca-afff-b0b65ff2fe43",
                                                "sense_id": "4efd7963-9c77-3ccb-aa93-ec81045c22d5",
                                                "text": "Apoptosis is routine in developmental processes such as the removal of webbing between fingers in humans, the loss of tadpole tails in amphibians, and insect metamorphosis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e87b86e9-081e-48b8-a960-01fde1d2f273",
                        "source_entry_id": "ef0d5c02-ecbd-3b0d-b04c-dfa9193ed740",
                        "source_sense_id": "c79f4cdc-f144-3ca5-aad3-133ba2d39e06",
                        "source_sense_description": "Biologie: programmierter Zelltod",
                        "target_lang_word": "apoptose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apoptose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                        "entry_id": "0965d126-a0fd-3618-9750-2d7f90d4a635",
                                        "glosses": [
                                            "Mort cellulaire programmée."
                                        ],
                                        "tags": [
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fe808b-d8eb-43e8-a822-0c8cea74b104",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "Dans certaines espèces, la mort de l’individu est quasi programmée, ou du moins prédéterminée (apoptose des feuilles d’un arbre)."
                                            },
                                            {
                                                "example_id": "3ad9bbbc-bf14-4b6d-a4a8-3d6518e24a52",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "En tout cas, c’est bien l’environnement de la cellule qui détermine sa forme, la forme même des êtres visibles et, à l’image d'une statue qui prend sa forme sous les coups de burin du sculpteur, l’embryon est sculpté par la destruction des cellules par un phénomène qui s’appelle l’apoptose, ou mort programmée des cellules."
                                            },
                                            {
                                                "example_id": "c1bc843e-bf3c-44af-a290-d65cd89c8276",
                                                "sense_id": "023d7a86-4ec1-34d2-978c-9e4a4faf9b27",
                                                "text": "La recherche d’inhibiteurs de protéines anti-apoptotiques afin de rétablir l’apoptose constitue une piste sérieuse pour le traitement de certains cancers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
