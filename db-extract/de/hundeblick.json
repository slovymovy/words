                "senses": [
                    {
                        "sense_id": "c3330c95-8a2c-35cd-8bc3-ee84c78ec19e",
                        "entry_id": "3106ef03-b1f8-3c05-92e3-0057cbc60534",
                        "glosses": [
                            "a facial expression showing innocence and meekness, often in a charming way, arousing pity and affection in those who see it; puppy dog eyes (but possibly with a more positive undertone)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ac2f7492-2398-43f8-8dbd-e8a93ce9bacc",
                                "sense_id": "c3330c95-8a2c-35cd-8bc3-ee84c78ec19e",
                                "text": "Du weißt ja, dass ich nicht nein sagen kann, wenn du mich mit diesem Hundeblick ankuckst.",
                                "translation": "You know I can’t say no when you look at me with these puppy dog eyes.",
                                "english": "You know I can’t say no when you look at me with these puppy dog eyes."
                            }
                        ]
                    }
