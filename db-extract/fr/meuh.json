                                    {
                                        "sense_id": "15e314a9-8fba-31e1-9ea0-65bb55ffe2a8",
                                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                                        "glosses": [
                                            "uitroep om iemand aan het schrikken te maken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d153d3d-28d5-4902-b95c-1c1417b4a423",
                                                "sense_id": "15e314a9-8fba-31e1-9ea0-65bb55ffe2a8",
                                                "text": "Eén keer hadden we de moed bij hem naar binnen te gluren. Hij deed het gordijn opzij, lachte en riep: Boe! Vanaf die dag wisten we het zeker: als je niet uitkeek, at hij je op."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60276685-ee38-3ae1-b614-2256099c1196",
                                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                                        "glosses": [
                                            "uitroep waarmee men zijn afkeuring uit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c828d784-0520-45d6-8ff5-4c427ea07a6b",
                                                "sense_id": "60276685-ee38-3ae1-b614-2256099c1196",
                                                "text": "‘Let u allen goed op, het is een leerzaam stuk.’ ‘Boe! Boe!’ klonk het uit het publiek. ‘Wij willen niet leren, wij willen lachen!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b9998a-883c-3952-ad38-0f43b4ad5578",
                                        "entry_id": "d2a0211e-d889-32aa-b00d-4f932863da3d",
                                        "glosses": [
                                            "loeidend geluid van een koe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c23f7bf2-211c-48d6-9c57-08c037f27f9a",
                                                "sense_id": "10b9998a-883c-3952-ad38-0f43b4ad5578",
                                                "text": "Ik stapte af en zei: ‘Stomme koe, je bent een smeerlap.’ Hij spitste zijn oren draaide zijn kop, keek me aan en zei: ‘Boe!’ ‘Ja, je bent een stommeling.’ ‘Boe!’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boe",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f776eb7-891d-358f-b45c-8594b5eb6ab1",
                                        "entry_id": "a911f50c-655d-347f-a7b1-b35bd8e9cab0",
                                        "glosses": [
                                            "schuur, eenvoudig gebouwtje, vooral geschikt als bergplaats"
