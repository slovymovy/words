                                        "sense_id": "abc79144-0606-38b8-9f3e-02906406b87c",
                                        "entry_id": "3299812c-9257-3013-bfae-919daba8e898",
                                        "glosses": [
                                            "Présence d'individus, d'un sous-groupe dans un groupe donné, supérieure à la population moyenne étudiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d29dfb-71e0-4911-a18f-6ab61557b894",
                                                "sense_id": "abc79144-0606-38b8-9f3e-02906406b87c",
                                                "text": "« On a une surreprésentation des cibles institutionnelles, qui témoigne de la dimension politique de cette révolte », estime Julien Talpin, chercheur au CNRS."
                                            },
                                            {
                                                "example_id": "48e5d506-b7c7-4f1b-b683-8b0e5140beb9",
                                                "sense_id": "abc79144-0606-38b8-9f3e-02906406b87c",
                                                "text": "La surreprésentation des chefs d’entreprise dans ce groupe ne veut évidemment pas dire que tous les chefs d’entreprise appartiennent à la catégorie des hauts salaires (Evain, 2007)."
                                            },
                                            {
                                                "example_id": "27fd27d9-0b4f-4bf9-bdb7-816d48ecb85b",
                                                "sense_id": "abc79144-0606-38b8-9f3e-02906406b87c",
                                                "text": "Cela favorise très nettement la surreprésentation d’hommes violents en politique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539e5713-662b-355b-be0b-74f0883e7a1e",
                                        "entry_id": "3299812c-9257-3013-bfae-919daba8e898",
                                        "glosses": [
                                            "Représentation excessive de représentants élus relativement à l'importance démographique ou géographique de leur électorat."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "956ea60a-6763-4228-a7ef-ac4ea6d6aaab",
                                                "sense_id": "539e5713-662b-355b-be0b-74f0883e7a1e",
                                                "text": "Un conservatisme que ses détracteurs mettent en partie sur le compte de la surreprésentation de la Grande-Bretagne, inventrice du football et considérée pour cette raison comme opposée à de trop grands changements de règles."
                                            },
                                            {
                                                "example_id": "d634f98a-3c69-44bc-8498-702fb301e100",
                                                "sense_id": "539e5713-662b-355b-be0b-74f0883e7a1e",
                                                "text": "Le Monténégro a obtenu une surreprésentation par rapport à son poids démographique dans ce nouvel État, par ailleurs une clause de revoyure prévoit que cette union fédérale pourra être remise en cause par référendum […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1948ee7b-7278-3992-a4fa-42c49f256823",
                                        "entry_id": "3299812c-9257-3013-bfae-919daba8e898",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3093420d-fb7c-4321-8c4f-66815e90f354",
                                                "sense_id": "1948ee7b-7278-3992-a4fa-42c49f256823",
                                                "text": "Les déformations aux latitudes élevées de la projection de Mercator entraînent une surreprésentation des pôles."
                                            }
                                        ]
