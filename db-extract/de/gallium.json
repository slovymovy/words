                                    {
                                        "sense_id": "5efcf5db-39b5-318f-aaa1-a2ec388b982a",
                                        "entry_id": "40b8a07e-e2aa-3724-a8aa-26d6a6d52d1c",
                                        "glosses": [
                                            "Élément chimique métallique, de symbole Ga et de numéro atomique 31."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d112d457-6faa-474f-a6dd-50f18408c0b5",
                                                "sense_id": "5efcf5db-39b5-318f-aaa1-a2ec388b982a",
                                                "text": "Arséniure de gallium."
                                            },
                                            {
                                                "example_id": "31bcd232-f8e9-4130-b1e8-5f4346c6833c",
                                                "sense_id": "5efcf5db-39b5-318f-aaa1-a2ec388b982a",
                                                "text": "Le gallium, qui est plus abondant que le lithium, le bore, le plomb et que beaucoup d’autres éléments familiers, est un élément cher parce qu’il est extrêmement dispersé dans les minéraux qui contiennent de l’aluminium et du fer."
                                            },
                                            {
                                                "example_id": "4020d6a5-3d9f-439d-b761-10c6d9ede1eb",
                                                "sense_id": "5efcf5db-39b5-318f-aaa1-a2ec388b982a",
                                                "text": "C’est ainsi que le sol contient 2 650 fois moins de gallium que de fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fa87193-d570-37bd-b754-761f781e2d97",
                                        "entry_id": "40b8a07e-e2aa-3724-a8aa-26d6a6d52d1c",
                                        "glosses": [
                                            "Corps simple élémentaire ; métal argenté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c281fd-abff-4679-ad89-4d86a926a3ea",
                                                "sense_id": "3fa87193-d570-37bd-b754-761f781e2d97",
                                                "text": "Le gallium et certains de ses alliages sont des métaux qui restent à l’état liquide à température ambiante, comme le mercure."
                                            },
                                            {
                                                "example_id": "af4a229c-a55e-4962-bf14-52f36821904c",
                                                "sense_id": "3fa87193-d570-37bd-b754-761f781e2d97",
                                                "text": "Quand on fait passer un courant élevé dans un capillaire rempli de gallium liquide composé de deux isotopes (deux atomes qui ont le même nombre de protons et d’électrons, mais pas le même nombre de neutrons, de sorte que leur masse diffère), l’isotope léger se concentre du côté de l’anode au bout de plusieurs jours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
