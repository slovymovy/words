                                "target_senses": [
                                    {
                                        "sense_id": "835f145e-cdd9-3a17-a679-13f4e83b531a",
                                        "entry_id": "a8b0d460-e589-347f-9ac4-11dcdbb7b24c",
                                        "glosses": [
                                            "A map of a world; a cartographic representation, a projection done to scale, representative of a planet's surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012a9806-e3ea-48ef-815c-ede48c5db62c",
                                                "sense_id": "835f145e-cdd9-3a17-a679-13f4e83b531a",
