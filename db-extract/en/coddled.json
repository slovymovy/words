        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8028ccbf-4106-3c9c-995f-ea07ffab18d9",
                "word": "coddled",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d105b0e6-30a3-3b5c-bc73-08d9d6368a7b",
                        "entry_id": "8028ccbf-4106-3c9c-995f-ea07ffab18d9",
                        "glosses": [
                            "Pampered; overprotected and/or overindulged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "668c731b-ff05-40b2-a95f-84dd470d0147",
                                "sense_id": "d105b0e6-30a3-3b5c-bc73-08d9d6368a7b",
                                "text": "The \"coddled\" prisoner has been the subject of more newspaper editorials, and more discussion by the general public than almost any other phase of our criminal problem."
                            },
                            {
                                "example_id": "e4aebb89-c6ef-4833-a3a9-b93bc26ff377",
                                "sense_id": "d105b0e6-30a3-3b5c-bc73-08d9d6368a7b",
                                "text": "As the most coddled subgroup (white males) of what might well be the most coddled generation in human history, Homer and his peers have had their every whim catered to since birth by a society geared almost exclusively to their priorities."
                            },
                            {
                                "example_id": "0416473b-4717-4056-9401-c770a5353d2d",
                                "sense_id": "d105b0e6-30a3-3b5c-bc73-08d9d6368a7b",
                                "text": "I don't think any of us did at that point ... nurses and doctors were very, very coddled at that point. They needed us so much that they didn't make us do a lot of things."
                            }
                        ]
                    },
                    {
                        "sense_id": "15b5bd55-6743-3110-87ac-39a421e5ccaf",
                        "entry_id": "8028ccbf-4106-3c9c-995f-ea07ffab18d9",
                        "glosses": [
                            "Stewed or simmered."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ba14f6-5912-4c7b-9942-24826af7756a",
                                "sense_id": "15b5bd55-6743-3110-87ac-39a421e5ccaf",
                                "text": "In the first menu the veal needs about an hour and a half's cooking; the potatoes an hour's; the coddled pears two hours'; the sponge caked twenty minutes' and the oysters ten minutes'."
                            },
                            {
                                "example_id": "57596a4b-8ef8-4373-a811-bd2ce57ac8c1",
                                "sense_id": "15b5bd55-6743-3110-87ac-39a421e5ccaf",
                                "text": "For a perfect product for apple sauce the score is 100; for baked apple, 48; and for coddled apple, 44 as indicated on grading sheets."
                            },
                            {
                                "example_id": "63aaf7fa-ac8d-46fe-9912-90d6fca5ecd9",
                                "sense_id": "15b5bd55-6743-3110-87ac-39a421e5ccaf",
                                "text": "Whatever its beginnings, the original salad of romaine lettuce mixed with grated cheese, coddled eggs and bread cubes fried in olive oil started a no-end-in-sight trend."
                            }
                        ]
                    }
