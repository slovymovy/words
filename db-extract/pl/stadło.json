                        "source_entry_id": "a44c657f-be6a-3782-b7f3-1ebf4ca06bce",
                        "source_sense_id": "5f5d90e8-6839-3360-bfc2-a0f381b45f98",
                        "target_lang_word": "Ehepaar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehepaar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                        "entry_id": "e86f88f9-f6de-3252-9a64-bd8b2c94f84a",
                                        "glosses": [
                                            "verheiratetes Paar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f224dac-d3f5-4eb2-9298-ff9910509643",
                                                "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                                "text": "Sie sind seit 24 Jahren ein Ehepaar."
                                            },
                                            {
                                                "example_id": "7d62ff92-8a18-47ff-b042-3880916d031c",
                                                "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                                "text": "„Wie ein Ehepaar gingen sie langsam und schweigend weiter.“"
                                            },
                                            {
                                                "example_id": "d66a0aff-bf84-4a77-9965-7999479d7d47",
                                                "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                                "text": "„Ich wurde von einem fröhlichen älteren Ehepaar aufgenommen, das Obst anbaut und an die Marmeladenfabrik liefert.“"
                                            },
                                            {
                                                "example_id": "84af5c15-8ea6-4f22-b649-f542c09c2c50",
                                                "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                                "text": "„Einmal allerdings gelang es mir, dieses junge Ehepaar Müller glänzend in die Schranken zu verweisen.“"
                                            },
                                            {
                                                "example_id": "766a309b-01c9-4f9b-82f9-ef6b2a8a9dd8",
                                                "sense_id": "3158833c-2fb6-346f-beec-4f29f2de70ef",
                                                "text": "„Zum Schlafen hatte das Ehepaar feuchte Strohsäcke statt eines Bettes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
