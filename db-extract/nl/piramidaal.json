                ],
                "senses": [
                    {
                        "sense_id": "5a4fe1ab-7e9f-36d9-b8f5-39260f5920fc",
                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                        "glosses": [
                            "met een vorm die van een breed, wat hoekig grondvlak uitloopt in een punt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0dba6f6-8728-45ca-b907-dc5495e0cd3c",
                                "sense_id": "5a4fe1ab-7e9f-36d9-b8f5-39260f5920fc",
                                "text": "Piramidale zeeën hebben golven met puntige, spitse koppen, zoals die in het centrum van tropische orkanen en van sterk ontwikkelde stormcentra op hoge breedte voorkomen."
                            }
                        ]
                    },
                    {
                        "sense_id": "02962c10-587e-30b7-b0f2-6ee03c1bd223",
                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                        "glosses": [
                            "behorend tot de getallen die aangeven hoeveel bollen er in een stapel passen als die een veelhoek van een bepaalde omvang als grondvlak heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499656f6-6013-416e-8720-6592b33932a8",
                                "sense_id": "02962c10-587e-30b7-b0f2-6ee03c1bd223",
                                "text": "Een driehoekige piramide met een grondvlak van 6 bollen heeft daarop nog twee lagen met 3 en 1 bol: daarom is de som van die getallen, 10 een piramidaal getal."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe1cd336-2783-3a10-b76b-0e7204ec407b",
                        "entry_id": "e9302922-1eb3-3e0e-9b74-97d801bed919",
                        "glosses": [
                            "van een zeer groot formaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ded3e4f-7682-46db-abf6-9d8135466235",
                                "sense_id": "fe1cd336-2783-3a10-b76b-0e7204ec407b",
                                "text": "De begroting heeft een piramidaal tekort."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "9e9b73b1-e56c-38fd-9954-8cefad0eb275",
                "word": "piramidaal",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aec9a084-e871-38be-ab75-fb7e43c38cd7",
                        "entry_id": "9e9b73b1-e56c-38fd-9954-8cefad0eb275",
                        "glosses": [
                            "benaming voor een bepaald soort plant, Campanula pyramidalis, uit de Klokjesfamilie"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d91c69a3-6b6d-46cd-b5a4-aca449b288e6",
                        "source_entry_id": "9e9b73b1-e56c-38fd-9954-8cefad0eb275",
                        "source_sense_id": "aec9a084-e871-38be-ab75-fb7e43c38cd7",
                        "source_sense_description": "met een vorm die van een breed, wat hoekig grondvlak uitloopt in een punt",
                        "target_lang_word": "pyramidal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pyramidal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "058bb657-378d-3c9c-ace7-c746fcc3c85a",
                                        "entry_id": "320a4327-dd76-34e6-966a-a330d0a50677",
                                        "glosses": [
                                            "Qui est en forme de pyramide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31155738-8acf-4437-a9e1-e6ae2fbbe1ad",
                                                "sense_id": "058bb657-378d-3c9c-ace7-c746fcc3c85a",
                                                "text": "Ces entraits, en se croisant à mi-bois entre chaque pièce, moisent aussi le poinçon qui monte dans la lanterne et s'élève jusque dans la flèche pyramidale qui la surmonte; […]."
                                            },
                                            {
                                                "example_id": "f4addaad-71ab-4d8d-b162-2648647ca0fe",
                                                "sense_id": "058bb657-378d-3c9c-ace7-c746fcc3c85a",
                                                "text": "Le village indien de Sticoë, avec ses tombes pyramidales et ses huttes en ruines, se montrait à notre gauche, au détour d’un promontoire ; […]."
                                            },
                                            {
                                                "example_id": "d2897768-6498-40d1-817a-fa6f0310d2b2",
                                                "sense_id": "058bb657-378d-3c9c-ace7-c746fcc3c85a",
                                                "text": "Dix-sept îles, tufs et basaltes en amas pyramidaux ou étrangement déchiquetés, surgissent de la mer ; piliers immenses, elles supportent les brumes hautes, à moins que, monolithes gigantesques, leurs sommets ne les dominent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "463e05a9-3b4e-3b5b-be6e-f65dbc64b990",
                                        "entry_id": "320a4327-dd76-34e6-966a-a330d0a50677",
                                        "glosses": [
                                            "Structuré d’une façon verticale et hiérarchisée, qui rappelle une pyramide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5536c315-dc54-4931-a2c2-783786ace55d",
                                                "sense_id": "463e05a9-3b4e-3b5b-be6e-f65dbc64b990",
                                                "text": "Dès que l’on passe du raisonnement pyramidal classique à une logique de réseaux, on est amené à rencontrer les bonnes personnes qui correspondent à chaque idée."
                                            },
                                            {
                                                "example_id": "68ad1e35-2bbe-4765-b1b6-a908fcab66fd",
                                                "sense_id": "463e05a9-3b4e-3b5b-be6e-f65dbc64b990",
                                                "text": "La transformation des victimes des inégalités sociales en coupables contribue ainsi à occulter le développement d’une société pyramidale."
                                            },
                                            {
                                                "example_id": "31f5cb50-6c5c-4b9e-98b2-a1ba94e129f9",
                                                "sense_id": "463e05a9-3b4e-3b5b-be6e-f65dbc64b990",
                                                "text": "S’ils détestent les organisations pyramidales, les silos, les chefs control freak, ils veulent des manageurs qui fédèrent le collectif, en étant constructifs et attentifs à chacun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7402b451-45c7-3da7-8eba-03adba3f378f",
                                        "entry_id": "320a4327-dd76-34e6-966a-a330d0a50677",
                                        "glosses": [
                                            "Au sens d'un schéma de Ponzi; vente pyramidale."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d029014-9be9-4aec-8c27-7aa6ba48287d",
                                                "sense_id": "7402b451-45c7-3da7-8eba-03adba3f378f",
                                                "text": "Un cryptoactif recommandé par un président, de surcroît économiste : des milliers de personnes investissent, le cours de la cryptomonnaie s’envole, avant de s’effondrer au bout de quelques heures. « Résultat ? Seules neuf personnes ont gagné 87 millions de dollars (83 millions d’euros), tandis que 44 000 autres ont perdu tout ce qu’elles ont misé (…). Une arnaque pyramidale en bonne et due forme, promue par Javier Milei », analyse, sur X, l’économiste espagnol Eduardo Garzon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bab42918-04c5-3bdd-a664-0f9b66e1633b",
                                        "entry_id": "320a4327-dd76-34e6-966a-a330d0a50677",
                                        "glosses": [
                                            "Énorme."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22098ae8-df22-49ed-a6a4-64417112139e",
                                                "sense_id": "bab42918-04c5-3bdd-a664-0f9b66e1633b",
                                                "text": "Une bêtise pyramidale."
                                            }
                                        ]
                                    }
                                ]
