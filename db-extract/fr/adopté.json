                                "target_senses": [
                                    {
                                        "sense_id": "1a1b84e1-062b-35ef-bddd-9664ca665187",
                                        "entry_id": "70dcde7e-70d0-30f1-9c30-7fb45058f5e5",
                                        "glosses": [
                                            "страд. прич. прош. вр. от принять"
                                        ],
                                        "tags": [
                                            "participle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b01856e0-1c13-46a6-b693-ef8bdceb6918",
                                                "sense_id": "1a1b84e1-062b-35ef-bddd-9664ca665187",
                                                "text": "Гость был принят на парадной половине Катерины Александровны."
                                            },
                                            {
                                                "example_id": "ccabe2f9-236f-499a-9b36-55873f54013c",
                                                "sense_id": "1a1b84e1-062b-35ef-bddd-9664ca665187",
                                                "text": "Зато Кириллов был совершенно спокоен и безразличен, очень точен в подробностях принятой на себя обязанности, но без малейшей суетливости и почти без любопытства к роковому и столь близкому исходу дела."
                                            },
                                            {
                                                "example_id": "9a934824-0399-46d4-9e25-6922794d2342",
                                                "sense_id": "1a1b84e1-062b-35ef-bddd-9664ca665187",
                                                "text": "Этот порядок принят издавна в отношении ко всем иностранным судам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
