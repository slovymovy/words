                ],
                "senses": [
                    {
                        "sense_id": "5211b34b-d5db-3f59-811c-984c6d33cc4c",
                        "entry_id": "a0af0bfc-54d1-3706-a2d4-852aaa96dc36",
                        "glosses": [
                            "Qualité de ce qui est distinguable, qui peut être distingué, considéré distinct."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc3c70e-f2d1-4a16-8eb2-c0a83916a893",
                                "sense_id": "5211b34b-d5db-3f59-811c-984c6d33cc4c",
                                "text": "En pratique la perfection est irréaliste, mais on ne perd pas grand chose à la remplacer par la notion de distinguabilité : une copie indistinguable d’une photo lambda est la photo lambda ; une simulation d’un calcul est exactement ce calcul si on ne peut les distinguer ; et la simulation d’une intelligence est la même intelligence si on ne peut les distinguer (ce qui est l’essence du test de Turing)."
                            },
                            {
                                "example_id": "2d3d00c8-3f89-437c-9d6c-d3ae158ca8ba",
                                "sense_id": "5211b34b-d5db-3f59-811c-984c6d33cc4c",
                                "text": "L’impact de ces derniers concerne surtout la tendance à préserver la distinguabilité du groupe d’appartenance et à défendre sa spécificité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a164f9d0-041a-4423-bc85-bbbf6750619d",
                        "source_entry_id": "a0af0bfc-54d1-3706-a2d4-852aaa96dc36",
                        "source_sense_id": "5211b34b-d5db-3f59-811c-984c6d33cc4c",
                        "target_lang_word": "distinguishability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "distinguishability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "409171fd-e359-3f63-8b54-d42b0d6d73b5",
                                        "entry_id": "2b3f6d0d-fda2-3f0e-911a-dc226daf3dda",
                                        "glosses": [
                                            "The state of being distinguishable."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eea96e6-e009-4043-b492-34eaea3cd341",
                                                "sense_id": "409171fd-e359-3f63-8b54-d42b0d6d73b5",
                                                "text": "The problem is separated into two parts: proof of distinguishability of codewords by receiver, and that of indistinguishability of codewords by environment (privacy)."
                                            },
                                            {
                                                "example_id": "ed110b13-6a89-4d1c-a675-0e749ab92a25",
                                                "sense_id": "409171fd-e359-3f63-8b54-d42b0d6d73b5",
                                                "text": "This visual characteristic is called kernel visual distinguishability, or KVD, and it is presently one of the requirements that must be met if a wheat variety is to be registered by the Canadian Food Inspection Agency (CFIA) for unrestricted registration, production and handling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
