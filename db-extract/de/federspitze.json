                                        "glosses": [
                                            "The tip of a pen or tool that touches the surface, transferring ink to paper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab40e514-a7d6-49f7-8fa9-d88be1de517d",
                                                "sense_id": "79231a05-a0c2-3b62-a6b6-b056a619ea1f",
                                                "text": "Slowly welling from the point of her gold nib, pale blue ink dissolved the full stop; for there her pen stuck; her eyes fixed, and tears slowly filled them."
                                            },
                                            {
                                                "example_id": "6599f4a5-2cef-4702-9e49-ac7188ca9931",
                                                "sense_id": "79231a05-a0c2-3b62-a6b6-b056a619ea1f",
                                                "text": "Ford, whose often acid nib belied a deep love of all things Iberian, is one of 20 British authors profiled in a new Spanish book[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38c5a0f-93a4-3fcb-a761-995c2b48c65f",
