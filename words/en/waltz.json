                {
                    "sense_id": "3553bb36-e57e-3126-a689-acdca78adcb2",
                    "sense_definition": "An unincorporated community in Huron Township, Wayne County, Michigan, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "us_places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many residents of <w>Waltz</w> commute to nearby Detroit for work.",
                            "target_lang_translations": {
