                ],
                "senses": [
                    {
                        "sense_id": "c747ecc2-db3c-35f7-80f7-50e09a3f4633",
                        "entry_id": "8d75e96d-cf2f-3477-97b0-6005009923d9",
                        "glosses": [
                            "aus Metall bestehendes Gitter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a54791-725f-43b1-a783-9f3064b60b85",
                                "sense_id": "c747ecc2-db3c-35f7-80f7-50e09a3f4633",
                                "text": "„Die Fluchtwege waren von Metallgittern im Treppenhaus und an Fenstern blockiert.“"
                            },
                            {
                                "example_id": "0055bcf7-8367-4381-b83e-76855592439d",
                                "sense_id": "c747ecc2-db3c-35f7-80f7-50e09a3f4633",
                                "text": "„Eine Ministeriumssprecherin erklärte, eines der Treppenhäuser sei vom Feuer versperrt gewesen, das andere von einem Metallgitter.“"
                            },
                            {
                                "example_id": "bc060a16-80de-47d6-a884-f0e53ef4ba5e",
                                "sense_id": "c747ecc2-db3c-35f7-80f7-50e09a3f4633",
                                "text": "„Ein Vorbestrafter aus dem sardischen Ort Orgosolo mit Wohnsitz Parma hatte bereits mit Komplizen den Friedhof von San Cataldo in Modena aufgesucht, wo der Sarg in einer Kapelle hinter einer Marmorplatte in einer Gruft aufbewahrt wird, die mit einem schweren Metallgitter verschlossen ist.“"
                            },
                            {
                                "example_id": "d3b40576-a0ba-45c4-a2b0-d821dbd65115",
                                "sense_id": "c747ecc2-db3c-35f7-80f7-50e09a3f4633",
                                "text": "„Sie hatten die Glastüren zerstört und in den Fluren Barrikaden aus Metallgittern aufgebaut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
