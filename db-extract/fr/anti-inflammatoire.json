                    {
                        "form_id": "40148fb6-dbc7-4d1d-bd2c-c983227aa1d1",
                        "entry_id": "60cb237e-08fd-36bc-9edf-e809e885b510",
                        "tags": [
                            "Moins courant",
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "antiinflammatoire"
