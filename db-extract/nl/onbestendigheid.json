                "senses": [
                    {
                        "sense_id": "32a3753a-84ad-30b1-a1ba-1165fb19d5e5",
                        "entry_id": "61b6dcf8-a92b-3df9-9505-039a6dab9a79",
                        "glosses": [
                            "de mate waarin iets tijdelijk of veranderlijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2122de1-3fe3-4215-95c5-4cbfb0520476",
                                "sense_id": "32a3753a-84ad-30b1-a1ba-1165fb19d5e5",
                                "text": "Wat weerhoudt me ervan te werken, te genezen en te schrijven? Ik denk niet dat het de ontberingen en omzwervingen zijn, niet de onbestendigheid en de vele veranderingen, maar de heersende geest van ronkende frasen die dezer dagen zo'n opgeld doet, zoals daar zijn: het ochtendgloren van de toekomst, de bouw van een nieuwe wereld, fakkeldragers der mensheid."
                            },
                            {
                                "example_id": "3a1b7913-697b-4fd6-ab0a-ab88d1582244",
                                "sense_id": "32a3753a-84ad-30b1-a1ba-1165fb19d5e5",
                                "text": "Volgens vice-president Donner volgen wijzingen elkaar snel op en zijn die soms tegengesteld aan elkaar. Hij vindt dat de \"onbestendigheid van wetgeving\" gevolgen heeft voor de doeltreffendheid ervan."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c36ce48-bee5-3272-b81e-b653fcae6939",
                        "entry_id": "61b6dcf8-a92b-3df9-9505-039a6dab9a79",
                        "glosses": [
                            "iets dat heel snel veranderd; iets dat niet lang blijft bestaan"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3680f352-a9c1-4d00-96f6-a46b734ba7db",
