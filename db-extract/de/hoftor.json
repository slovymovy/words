                "senses": [
                    {
                        "sense_id": "2358af70-a046-34e1-be9c-bdf381e73b24",
                        "entry_id": "707dbd2b-b7ea-32ac-9475-2c9603cd4b6c",
                        "glosses": [
                            "Tor, das einen Hof abschließt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e507bae8-30a3-4b6d-a482-ca7097398f45",
                                "sense_id": "2358af70-a046-34e1-be9c-bdf381e73b24",
                                "text": "„Als des Dorfes gewaltige Klatschtante das Hoftor ins Schloß fallen ließ, blieb im Altenteil nichts als Lähmung zurück.“"
                            },
                            {
                                "example_id": "c0b51e32-5f63-4eec-b466-ace39da3dfe4",
                                "sense_id": "2358af70-a046-34e1-be9c-bdf381e73b24",
                                "text": "„Als er am Hoftor vorbeiging, stiegen ihm typische Backstubengerüche in die Nase.“"
                            },
                            {
                                "example_id": "78aa74c6-571e-4f3f-878a-9c7005ef2546",
                                "sense_id": "2358af70-a046-34e1-be9c-bdf381e73b24",
                                "text": "„Das Hoftor öffnet sich unter einem Fausthieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
