                "senses": [
                    {
                        "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                        "entry_id": "d99f3a7f-029b-33da-bcdb-dca6d136c582",
                        "glosses": [
                            "Stücke für Rohrleitungen, die zur Krümmung oder Verzweigung des Rohrsystems dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03062b85-0b09-47b6-95b2-ee41bd353326",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Rohrformstücke unterschiedlicher Geometrie (u.a. T-Stück, Kreuzstück, Bogen, Endkappen, Flanschadapter, Reduzierstücke) und Nennweite können als eine Bauteilserie behandelt werden, wenn alle Formstücke aus demselben Material bestehen und innerhalb einer Nennweite gleichwertige Wandstärken aufweisen.“"
                            },
                            {
                                "example_id": "cd2d2e0a-15f5-4eed-a330-3a130cdbe645",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Bei ungekürztem Rohrformstück ist dies der fünfte Stein, bei der Variante mit Fertigfuß der zweite Stein oberhalb des Fertigfußes (insgesamt also der sechste Stein).“"
                            },
                            {
                                "example_id": "30c8ead4-28bc-496e-ae74-93011ee45e47",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Der Einbau erfolgt in den Rohrformstücken oder Sinkkasteneinläufen.“"
                            },
                            {
                                "example_id": "2a6aa46a-f6b0-4f98-b5d1-9864308d5277",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Hinter Kondensatregelventilen wird deshalb immer die Rohrleitung durch ein Rohrformstück erweitert.“"
                            },
                            {
                                "example_id": "4a29b522-6986-40b3-8ece-66b6ca166fba",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Es handelt sich zolltariflich um ein anderes Rohrformstück bzw. Rohrverbindungsstück aus anderem als nichtrostendem Stahl.“"
                            },
                            {
                                "example_id": "46b8f5ab-7457-4f40-b67e-2378438248e1",
                                "sense_id": "90ccfc14-c5b8-32b9-8db3-7234ecd7314f",
                                "text": "„Bei Unterdruck- und N2-Betrieb wird der Ansaugfilter durch einen Ansaugschalldämpfer bzw. Rohrformstück ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
