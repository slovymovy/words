                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb6e981d-e4b5-3932-a32d-8aa2424ecacb",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "A pedestrianized and uncovered shopping area."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0c3fafa-3cdf-3d0b-b2de-c2b78502f108",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "A subdivision of a city under the jurisdiction of a specific group of police; the police station situated in that district."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ef13756-c43b-347d-9163-fc6dbefea296",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "A subdivision of a city or other locality for the purposes of voting and representation in local government. In cities, precincts may be grouped into wards."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19101c81-87d4-3b04-abb8-20ac43dfd1a3",
                                        "entry_id": "a6236e22-6906-31ea-8f07-5dbc3d7f8162",
                                        "glosses": [
                                            "A district over which someone or some body of people has control in general; province, sphere of control."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1cb9cb0-40ec-4ef9-9c1a-2d2c8176c37f",
                                                "sense_id": "19101c81-87d4-3b04-abb8-20ac43dfd1a3",
                                                "text": "But ſince I loue to liue at libertie,\nAs eaſily may you get the Souldans crowne,\nAs any prizes out of my precinct."
                                            }
