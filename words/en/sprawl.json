{
    "word_family": [
        "sprawler",
        "sprawling",
        "sprawly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d2b7724-2ca2-30b4-9ba9-36a25b1f56e2",
                    "sense_definition": "To sit or lie with one's limbs spread out in an ungainly or relaxed manner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long hike, the tired students <w>sprawled</w> on the grass to rest.",
                            "target_lang_translations": {
                                "ru": "После долгого похода усталые студенты <w>развалились</w> на траве, чтобы отдохнуть."
                            }
                        },
                        {
                            "text": "He would often <w>sprawl</w> on the sofa while watching his favorite movies.",
                            "target_lang_translations": {
                                "ru": "Он часто любил <w>раскинуться</w> на диване за просмотром любимых фильмов."
                            }
                        }
                    ],
                    "synonyms": [
                        "splay"
                    ],
                    "common_phrases": [
                        "sprawl on the sofa",
                        "sprawl across the bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сидеть или лежать, небрежно или расслабленно раскинув руки и ноги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалиться",
                                "target_lang_sense_clarification": "сесть или лечь в небрежной позе"
                            },
                            {
                                "target_lang_word": "раскинуться",
                                "target_lang_sense_clarification": "широко раскинуть руки и ноги"
                            },
                            {
                                "target_lang_word": "растянуться",
                                "target_lang_sense_clarification": "лечь, вытянувшись во всю длину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54cb6210-3fbb-3d64-8695-73dfc7115fd4",
                    "sense_definition": "To spread out over a large area in an untidy or irregular way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expansion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suburbs <w>sprawl</w> for miles across the valley floor.",
                            "target_lang_translations": {
                                "ru": "Пригороды <w>разрастаются</w> на многие мили по всей долине."
                            }
                        },
                        {
                            "text": "Vines began to <w>sprawl</w> across the garden wall in a disorderly fashion.",
                            "target_lang_translations": {
                                "ru": "Виноградные лозы начали беспорядочно <w>расползаться</w> по садовой стене."
                            }
