                "translations": [
                    {
                        "translation_id": "adb708a7-5602-45a1-8a50-a118a7164e45",
                        "source_entry_id": "ebdd4877-bf72-3dd9-a375-c860ccd6bbfa",
                        "target_lang_word": "Pendeluhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pendeluhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                        "entry_id": "69ca6f26-2eab-3be5-9729-c728fa3bf713",
                                        "glosses": [
                                            "Uhr, deren Zeitnormal ein mechanisches Pendel ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6392e419-dcb6-48f8-bcb2-e72c43f6b364",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "An der Wand hängt eine Pendeluhr."
                                            },
                                            {
                                                "example_id": "64bf2934-52cf-4ec8-aa6c-15702f24e068",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Jedes Teil einer Pendeluhr muss eigenhändig geschliffen, gesägt und gefräst werden.“"
                                            },
                                            {
                                                "example_id": "dc16cb48-e2eb-4b19-8da9-60ac4ea710a2",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Sein fehlerhaftes Thermometer, seine nicht zustande gekommene Pendeluhr, sein unausgegorener Atomismus, sein korrekter Nachweis des Gewichts der Luft - alles fast vergessen.“"
                                            },
                                            {
                                                "example_id": "2fd71099-d8e9-4b16-a87c-363d6303e84f",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„In einem der Flure gab es eine alte Pendeluhr, ich glaube im ersten Stock; die Uhr stand immer; eine echte Standuhr also.“"
                                            },
                                            {
                                                "example_id": "63ca12e6-1bd7-485e-95db-e037a7df3b22",
                                                "sense_id": "2e257a90-f3ae-316f-ae62-6d0fe3f273a0",
                                                "text": "„Schließlich hörten wir die Pendeluhr halb drei Uhr schlagen, und zwei oder drei Minuten später erschien lächelnd und gemessenen Schritts die schöne Undine, ging geradewegs auf Seramis zu, beugte ein Knie zur Erde und übergab ihr das Blatt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecdfe458-92d1-469e-9e0d-fc972fbdc821",
                        "source_entry_id": "ebdd4877-bf72-3dd9-a375-c860ccd6bbfa",
