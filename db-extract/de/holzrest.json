                    {
                        "sense_id": "f83b3c18-8205-32c3-9389-70e694a49ba0",
                        "entry_id": "b3cca787-1c54-3e41-ace5-50373ef7fa10",
                        "glosses": [
                            "übriggebliebener Teil eines Holzgegenstands"
