                                        "glosses": [
                                            "przerwanie jakiejś działalności; rezygnacja z tworzonego wcześniej związku (lub relacji, grupy)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.6\""
                                    },
                                    {
                                        "sense_id": "73a060d4-d738-3cd1-b28b-1e91589fea0b",
                                        "entry_id": "e6ddca86-3416-3463-8aea-55ed53348cd1",
                                        "glosses": [
