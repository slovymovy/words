{
    "word_family": [
        "emptiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1dbd8141-1bc0-358c-ba48-45ca898e3b4c",
                    "sense_definition": "Devoid of content; containing nothing or nobody; vacant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large box was completely <w>empty</w> after we removed all the toys.",
                            "target_lang_translations": {
                                "ru": "Большая коробка была совершенно <w>пустой</w> после того, как мы убрали все игрушки.",
                                "zh": "我们把玩具都拿走后，那个大箱子就完全<w>空</w>了。"
                            }
                        },
                        {
                            "text": "I cannot think clearly or work well on an <w>empty</w> stomach.",
                            "target_lang_translations": {
                                "ru": "Я не могу ясно мыслить или хорошо работать на <w>пустой</w> желудок.",
                                "zh": "我不能在<w>空</w>腹的情况下清晰思考或高效工作。"
                            }
                        },
                        {
                            "text": "The classroom was <w>empty</w> because all the students had gone home for the day.",
                            "target_lang_translations": {
                                "ru": "Класс был <w>пуст</w>, потому что все ученики ушли домой.",
                                "zh": "教室里<w>空</w>无一人，因为学生们都已经回家了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vacant",
                        "unoccupied",
                        "unfilled"
                    ],
                    "antonyms": [
                        "full",
                        "packed",
                        "stuffed",
                        "loaded",
                        "cramful"
                    ],
                    "common_phrases": [
                        "empty room",
                        "empty stomach",
                        "empty bottle",
                        "empty space",
                        "completely empty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий ничего внутри; свободный от людей или предметов.",
                        "zh": "内部没有任何东西；没有人在里面或被占用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "порожний",
                                "target_lang_sense_clarification": "о контейнерах, сосудах или транспорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空",
                                "target_lang_sense_clarification": "形容词，表示没有内容或人"
                            },
                            {
                                "target_lang_word": "空荡荡",
                                "target_lang_sense_clarification": "形容空间非常空旷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "929fbf5d-f2b3-35fc-94c7-6d8cef47ddf4",
                    "sense_definition": "Lacking sincerity, meaning, or value; having no real effect.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "figurative_lack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made <w>empty</w> promises that he never intended to keep.",
                            "target_lang_translations": {
                                "ru": "Политик давал <w>пустые</w> обещания, которые никогда не собирался выполнять.",
                                "zh": "那位政客做出了他从未打算兑现的<w>空洞</w>承诺。"
                            }
                        },
                        {
                            "text": "His apology felt like <w>empty</w> words because he did not change his behavior.",
                            "target_lang_translations": {
                                "ru": "Его извинение казалось <w>пустыми</w> словами, потому что он не изменил своего поведения.",
                                "zh": "他的道歉听起来像是<w>空洞</w>的言辞，因为他并没有改变自己的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow",
                        "vacuous"
                    ],
                    "common_phrases": [
                        "empty promises",
                        "empty words",
                        "empty threat",
                        "empty gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный искренности, смысла или ценности; не имеющий реального значения.",
                        "zh": "缺乏诚意、意义或价值；没有实际效果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "переносное значение (слова, обещания)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空洞",
                                "target_lang_sense_clarification": "指言语或承诺缺乏实质内容"
                            },
                            {
                                "target_lang_word": "虚假",
                                "target_lang_sense_clarification": "指缺乏诚意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89b7bc28-a659-361f-8b92-975fe42ab1cf",
                    "sense_definition": "Lacking purpose, satisfaction, or emotion; feeling hollow inside.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_lack",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite his great wealth, he lived a lonely and <w>empty</w> life.",
                            "target_lang_translations": {
                                "ru": "Несмотря на огромное богатство, он жил одинокой и <w>пустой</w> жизнью.",
                                "zh": "尽管他非常富有，但他过着孤独而<w>空虚</w>的生活。"
                            }
                        },
                        {
                            "text": "She felt <w>empty</w> and sad after her children moved away to college.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала себя <w>опустошённой</w> и грустной после того, как дети уехали в колледж.",
                                "zh": "孩子们搬走去上大学后，她感到内心<w>空虚</w>且悲伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow"
                    ],
                    "common_phrases": [
                        "feel empty",
                        "empty life",
                        "empty inside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный цели, удовлетворения или эмоций; чувствующий внутреннюю пустоту.",
                        "zh": "缺乏目标、满足感或情感；内心感到空虚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "о жизни или существовании"
                            },
                            {
                                "target_lang_word": "опустошённый",
                                "target_lang_sense_clarification": "о внутреннем состоянии человека"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空虚",
                                "target_lang_sense_clarification": "指内心或生活状态缺乏意义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb1927f7-3220-3ed8-b62d-fea9211dd372",
                    "sense_definition": "Carrying nothing; having nothing in one's hands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He returned from the hunting trip <w>empty</w> and disappointed.",
                            "target_lang_translations": {
                                "ru": "Он вернулся с охоты <w>с пустыми руками</w> и разочарованным.",
                                "zh": "他从狩猎之旅中<w>空手</w>而归，感到很失望。"
                            }
                        },
                        {
                            "text": "I hate to arrive <w>empty</w> at a party, so I usually bring a gift.",
                            "target_lang_translations": {
                                "ru": "Я не люблю приходить на вечеринку <w>с пустыми руками</w>, поэтому обычно приношу подарок.",
                                "zh": "我不喜欢<w>空手</w>去参加聚会，所以我通常会带一份礼物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "come home empty",
                        "return empty"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ничего не несущий; не имеющий ничего в руках.",
                        "zh": "什么也没带；手里没有东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с пустыми руками",
                                "target_lang_sense_clarification": "устойчивое выражение"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空手",
                                "target_lang_sense_clarification": "指手里什么也没拿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "256a4ce8-15ee-346f-b392-e07fa658b3ba",
                    "sense_definition": "Containing no elements or members (used in mathematics and computing).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technical_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The search results returned an <w>empty</w> list because no files matched the criteria.",
                            "target_lang_translations": {
                                "ru": "Результаты поиска вернули <w>пустой</w> список, так как ни один файл не соответствовал критериям.",
                                "zh": "由于没有文件符合条件，搜索结果返回了一个<w>空</w>列表。"
                            }
                        },
                        {
                            "text": "In set theory, an <w>empty</w> set is a set that contains no elements.",
                            "target_lang_translations": {
                                "ru": "В теории множеств <w>пустое</w> множество — это множество, не содержащее элементов.",
                                "zh": "在集合论中，<w>空</w>集是指不包含任何元素的集合。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-empty"
                    ],
                    "common_phrases": [
                        "empty set",
                        "empty string",
                        "empty array"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий элементов или членов (в математике и информатике).",
                        "zh": "不包含任何元素或成员（用于数学和计算机科学）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "термин (множество, список)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空",
                                "target_lang_sense_clarification": "技术术语，如空集、空列表"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc906226-e80b-33f4-acd6-6c9be80f8017",
                    "sense_definition": "To remove the contents of something; to make something contain nothing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_absence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>empty</w> the dishwasher before you leave the house this morning.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разгрузи</w> посудомоечную машину перед выходом из дома сегодня утром.",
                                "zh": "今天早上出门前，请把洗碗机<w>清空</w>。"
                            }
                        },
                        {
                            "text": "The theater began to <w>empty</w> quickly as soon as the movie ended.",
                            "target_lang_translations": {
                                "ru": "Театр начал быстро <w>пустеть</w>, как только закончился фильм.",
                                "zh": "电影一结束，剧院里的人就开始迅速<w>散去</w>。"
                            }
                        },
                        {
                            "text": "The police officer asked the suspect to <w>empty</w> his pockets onto the table.",
                            "target_lang_translations": {
                                "ru": "Полицейский попросил подозреваемого <w>опустошить</w> карманы на стол.",
                                "zh": "警察要求嫌疑人把口袋里的东西都<w>倒空</w>在桌子上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "evacuate"
                    ],
                    "antonyms": [
                        "fill"
                    ],
                    "common_phrases": [
                        "empty the trash",
                        "empty out",
                        "empty the pockets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалять содержимое чего-либо; делать пустым.",
                        "zh": "移除某物的内容；使某物变空。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "опорожнять",
                                "target_lang_sense_clarification": "выливать или высыпать содержимое"
                            },
                            {
                                "target_lang_word": "разгружать",
                                "target_lang_sense_clarification": "освобождать от груза или предметов (напр. посудомойку)"
                            },
                            {
                                "target_lang_word": "пустеть",
                                "target_lang_sense_clarification": "становиться пустым (непереходный глагол)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清空",
                                "target_lang_sense_clarification": "移除所有内容"
                            },
                            {
                                "target_lang_word": "倒空",
                                "target_lang_sense_clarification": "把容器里的东西倒出来"
                            },
                            {
                                "target_lang_word": "腾空",
                                "target_lang_sense_clarification": "把空间腾出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55702c6c-04e7-3aec-860d-f165d182d746",
                    "sense_definition": "To flow into another body of water (used of a river or stream).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "river_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Amazon River <w>empties</w> into the Atlantic Ocean on the coast of Brazil.",
                            "target_lang_translations": {
                                "ru": "Река Амазонка <w>впадает</w> в Атлантический океан на побережье Бразилии.",
                                "zh": "亚马逊河在巴西海岸<w>注入</w>大西洋。"
                            }
                        },
                        {
                            "text": "Several small streams <w>empty</w> into the main lake during the rainy season.",
                            "target_lang_translations": {
                                "ru": "Несколько небольших ручьев <w>впадают</w> в главное озеро в сезон дождей.",
                                "zh": "雨季期间，几条小溪会<w>流入</w>主湖。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "empty into the sea",
                        "river empties into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вливаться в другой водоем (о реке или ручье).",
                        "zh": "流入另一个水体（指河流或溪流）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впадать",
                                "target_lang_sense_clarification": "о реках и течениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注入",
                                "target_lang_sense_clarification": "河流流入海洋或湖泊"
                            },
                            {
                                "target_lang_word": "流入",
                                "target_lang_sense_clarification": "河流汇入"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bceb230-1593-3426-a881-142237667d27",
                    "sense_definition": "A container, especially a bottle, whose contents have been consumed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We collected all the <w>empties</w> after the party to take them to the recycling center.",
                            "target_lang_translations": {
                                "ru": "Мы собрали все <w>пустые бутылки</w> после вечеринки, чтобы отвезти их в центр переработки.",
                                "zh": "聚会结束后，我们收集了所有的<w>空瓶</w>，准备送到回收中心。"
                            }
                        },
                        {
                            "text": "You can return the <w>empties</w> to the store to get your deposit back.",
                            "target_lang_translations": {
                                "ru": "Вы можете сдать <w>пустую тару</w> в магазин, чтобы вернуть залог.",
                                "zh": "你可以把<w>空瓶</w>退还给商店以取回押金。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "return the empties",
                        "stack of empties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер, особенно бутылка, содержимое которого было употреблено.",
                        "zh": "容器，特别是瓶子，其内容物已被消耗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустая тара",
                                "target_lang_sense_clarification": "собирательное значение"
                            },
                            {
                                "target_lang_word": "пустая бутылка",
                                "target_lang_sense_clarification": "конкретный предмет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空瓶",
                                "target_lang_sense_clarification": "指喝完的瓶子"
                            },
                            {
                                "target_lang_word": "空容器",
                                "target_lang_sense_clarification": "指用过的空包装"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}