                ],
                "senses": [
                    {
                        "sense_id": "955840f1-a598-35ac-ac8f-2f8f7532f82e",
                        "entry_id": "105bb6c8-aee7-35ba-8197-71ed5ff4c13e",
                        "glosses": [
                            "bedreiging met geweld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3950168f-61d9-4954-a2b6-ae0b7e883d13",
                                "sense_id": "955840f1-a598-35ac-ac8f-2f8f7532f82e",
                                "text": "De agressie die uit zijn ogen sprak was zeer bedreigend."
                            },
                            {
                                "example_id": "a4f84d69-fb91-44fd-9b8d-f863d3d96466",
                                "sense_id": "955840f1-a598-35ac-ac8f-2f8f7532f82e",
                                "text": "Wat ik wel wist, was dat er agressie in de ruimte hing, want de vele lippen trokken alsmaar fanatieker aan de vele sigaretten."
                            },
                            {
                                "example_id": "08a2f433-bbfa-464d-ba25-18474c54d71b",
                                "sense_id": "955840f1-a598-35ac-ac8f-2f8f7532f82e",
                                "text": "De agressie was verdwenen en had plaatsgemaakt voor een soort ontspanning; zijn onderlip hing iets omlaag."
                            }
                        ]
                    },
                    {
                        "sense_id": "f74ae9fa-af07-37b2-8c81-ab34bc1a477e",
                        "entry_id": "105bb6c8-aee7-35ba-8197-71ed5ff4c13e",
                        "glosses": [
                            "een vijandelijke aanval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f050b3b-f15e-4519-8b0d-b123298249f2",
                                "sense_id": "f74ae9fa-af07-37b2-8c81-ab34bc1a477e",
                                "text": "De agressie van de vijand werd direct door ons leger beantwoord."
                            },
                            {
                                "example_id": "05c87096-834d-4d53-9e64-5a3832fffcbe",
                                "sense_id": "f74ae9fa-af07-37b2-8c81-ab34bc1a477e",
                                "text": "In hun idealisme ontkennen de pacifisten het gevaar van de autoritaire agressie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
