                "forms": [
                    {
                        "form_id": "5a3f99e3-ddf4-4439-b31c-65e15009a8d1",
                        "entry_id": "bfa2ccf2-4c1c-3a43-9839-670a246d679b",
                        "tags": [
                            "plural"
                        ],
                        "form": "elaiosomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b4fbd16-39eb-39c6-be4c-ee1729452460",
                        "entry_id": "bfa2ccf2-4c1c-3a43-9839-670a246d679b",
                        "glosses": [
                            "A fleshy structure rich in lipids attached to the seeds of many plant species, usually to attract ants that disperse the seeds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa93d273-1213-40e2-a1f1-cfa36b10c69f",
                                "sense_id": "7b4fbd16-39eb-39c6-be4c-ee1729452460",
                                "text": "Ants collect the diaspores for the edible elaiosome, carry them to their nests and consume the elaiosomes. Sometimes, the elaiosome content is sucked from the diaspores, or the elaiosome is loosened on the way to the nest."
                            },
                            {
                                "example_id": "2c8a4cbc-3758-4713-bed7-799eed090932",
                                "sense_id": "7b4fbd16-39eb-39c6-be4c-ee1729452460",
                                "text": "Experiments with removal of C.^([Corydalis]) cava seeds with elaiosomes ablated, and with paper balls, infiltrated with juices of seed bodies and elaiosomes, showed the crucial role of elaiosome content in the ant attraction."
                            },
                            {
                                "example_id": "a62c06d9-a9de-4410-8650-98e40a6051a9",
                                "sense_id": "7b4fbd16-39eb-39c6-be4c-ee1729452460",
                                "text": "Elaiosomes also vary in size, and ants in many instances preferentially disperse diaspores with the greatest elaiosome/diaspore mass ratio, although plants produce seeds of different sizes, allowing for a variety of ants to effect their dispersal"
                            }
                        ]
                    }
                ],
