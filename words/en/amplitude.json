    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "84358922-2348-3b9d-a7b6-46fa9b4823bf",
                    "sense_definition": "great size, width, breadth, or extent",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "size_extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old hall impressed visitors with its <w>amplitude</w> and bright open space.",
                            "target_lang_translations": {
                                "tr": "Eski salon, <w>genişliği</w> ve aydınlık açık alanıyla ziyaretçileri etkiledi."
                            }
                        },
                        {
                            "text": "Writers of that period praised the <w>amplitude</w> of the king's generosity.",
                            "target_lang_translations": {
                                "tr": "O dönemin yazarları, kralın cömertliğinin <w>enginliğini</w> övdü."
                            }
                        }
                    ],
                    "synonyms": [
                        "largeness",
                        "breadth",
                        "magnitude"
                    ],
                    "antonyms": [
                        "smallness",
                        "narrowness"
                    ],
                    "common_phrases": [
                        "amplitude of space",
                        "amplitude of design"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük boyut, genişlik, enginlik veya kapsam"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genişlik",
                                "target_lang_sense_clarification": "boyut veya kapsam açısından"
                            },
                            {
                                "target_lang_word": "büyüklük",
                                "target_lang_sense_clarification": "hacim veya boyut açısından"
                            },
                            {
                                "target_lang_word": "enginlik",
                                "target_lang_sense_clarification": "kapsam veya cömertlik açısından"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2fefb6e-75b8-3e4e-bb3f-7a9cd971f113",
                    "sense_definition": "the greatest amount reached by a changing quantity, measured from its central or normal value",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wave_peak_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The graph shows the <w>amplitude</w> of the wave very clearly.",
                            "target_lang_translations": {
                                "tr": "Grafik, dalganın <w>genliğini</w> çok net bir şekilde gösteriyor."
                            }
                        },
                        {
                            "text": "In class, we measured the <w>amplitude</w> of the signal on the screen.",
                            "target_lang_translations": {
                                "tr": "Derste, ekrandaki sinyalin <w>genliğini</w> ölçtük."
                            }
                        }
                    ],
                    "common_phrases": [
                        "signal amplitude",
                        "wave amplitude"
                    ],
                    "target_lang_definitions": {
                        "tr": "Fizikte, değişen bir büyüklüğün merkez veya normal değerinden ölçülen en büyük değeri"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genlik",
                                "target_lang_sense_clarification": "fizik ve sinyallerde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb0368c9-9687-3e8b-a02c-f81c4c6ee058",
                    "sense_definition": "the greatest absolute value of a periodic curve or function, especially the height of the wave from its middle line to a peak",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "wave_peak_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This function has a small <w>amplitude</w>, so its peaks stay close to zero.",
                            "target_lang_translations": {
                                "tr": "Bu fonksiyon küçük bir <w>genliğe</w> sahiptir, bu yüzden tepe noktaları sıfıra yakın kalır."
                            }
                        },
                        {
                            "text": "Students compared the <w>amplitude</w> of two periodic curves in the exercise.",
                            "target_lang_translations": {
                                "tr": "Öğrenciler alıştırmada iki periyodik eğrinin <w>genliğini</w> karşılaştırdı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "maximum amplitude",
                        "amplitude of a wave"
                    ],
                    "target_lang_definitions": {
                        "tr": "Matematik ve elektronikte, periyodik bir eğrinin veya dalganın merkez çizgisinden tepe noktasına olan yüksekliği"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genlik",
                                "target_lang_sense_clarification": "matematiksel veya dalga yüksekliği"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e532a27-a9b8-3652-9d1c-3f23ca1623a4",
                    "sense_definition": "in astronomy, the arc on the horizon between true east or west and the point below a star or other object",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomical_angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navigator calculated the star's <w>amplitude</w> at rising before dawn.",
                            "target_lang_translations": {
                                "tr": "Seyir subayı, şafaktan önce doğarken yıldızın <w>genliğini</w> hesapladı."
                            }
                        },
                        {
                            "text": "In astronomy, the <w>amplitude</w> can be measured from true east or west.",
                            "target_lang_translations": {
                                "tr": "Gök biliminde <w>genlik</w>, gerçek doğu veya batıdan ölçülebilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "eastern amplitude",
                        "western amplitude"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gök biliminde, ufukta gerçek doğu veya batı ile bir gök cisminin altındaki nokta arasındaki yay"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genlik",
                                "target_lang_sense_clarification": "gök bilimsel açı ölçümü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcd2e41c-1bad-3359-9acd-87577f9cec33",
                    "sense_definition": "in astronomy, the arc on the horizon between true east or west and the position of the sun or a star when it rises or sets",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomical_angle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At sunset, the sun's <w>amplitude</w> was noted in the old observing record.",
                            "target_lang_translations": {
                                "tr": "Güneş batarken, Güneş'in <w>genliği</w> eski gözlem kaydına not edildi."
                            }
                        },
                        {
                            "text": "The manual explains how to find the <w>amplitude</w> of a star at rising.",
                            "target_lang_translations": {
                                "tr": "Kılavuz, bir yıldızın doğuş anındaki <w>genliğinin</w> nasıl bulunacağını açıklıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solar amplitude",
                        "stellar amplitude"
                    ],
                    "target_lang_definitions": {
                        "tr": "Gök biliminde, doğuş veya batış anında Güneş'in veya bir yıldızın doğu/batı noktasından olan açısal uzaklığı"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genlik",
                                "target_lang_sense_clarification": "doğuş ve batış anındaki astronomik yay"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce51ef38-5e69-3816-babf-649d2f4f33b4",
                    "sense_definition": "the horizontal distance traveled by a projectile; range",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old texts used <w>amplitude</w> for the distance a projectile traveled.",
                            "target_lang_translations": {
                                "tr": "Eski metinler, fırlatılan bir cismin katettiği mesafe için <w>menzil</w> sözcüğünü kullanırdı."
                            }
                        },
                        {
                            "text": "The report gave the cannon's <w>amplitude</w> as its total range.",
                            "target_lang_translations": {
                                "tr": "Rapor, topun <w>menzilini</w> toplam erişim mesafesi olarak belirtti."
                            }
                        }
                    ],
                    "synonyms": [
                        "range"
                    ],
                    "common_phrases": [
                        "projectile amplitude",
                        "amplitude of flight"
                    ],
                    "target_lang_definitions": {
                        "tr": "Atılan bir cismin katettiği yatay mesafe; menzil"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "menzil",
                                "target_lang_sense_clarification": "atış mesafesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "810edb73-41fe-3302-baa3-bcbc013c894d",
                    "sense_definition": "the range of motion of a gymnast's body while performing a movement or skill",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "range_of_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach praised the gymnast's <w>amplitude</w> on the balance beam.",
                            "target_lang_translations": {
                                "tr": "Antrenör, cimnastikçinin denge tahtasındaki <w>hareket açıklığını</w> övdü."
                            }
                        },
                        {
                            "text": "Better flexibility often gives a routine more <w>amplitude</w> and style.",
                            "target_lang_translations": {
                                "tr": "Daha iyi esneklik, seriye genellikle daha fazla <w>açıklık</w> ve tarz kazandırır."
                            }
                        }
                    ],
                    "synonyms": [
                        "range of motion"
                    ],
                    "common_phrases": [
                        "good amplitude",
                        "body amplitude"
                    ],
                    "target_lang_definitions": {
                        "tr": "Jimnastikte bir hareket yapılırken vücudun ulaştığı hareket açıklığı veya açıklık derecesi"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genişlik",
                                "target_lang_sense_clarification": "hareket açıklığı"
                            },
                            {
                                "target_lang_word": "açıklık",
                                "target_lang_sense_clarification": "jimnastik hareketlerindeki açı genişliği"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fae844db-066d-3763-892b-be85ae37513a",
                    "sense_definition": "the range of environmental conditions in which an organism can survive",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "survival_range",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The species has a wide <w>amplitude</w> and survives in many climates.",
                            "target_lang_translations": {
                                "tr": "Bu tür geniş bir <w>tolerans aralığına</w> sahiptir ve birçok iklimde hayatta kalır."
                            }
                        },
                        {
                            "text": "Scientists studied the plant's <w>amplitude</w> in dry and wet soils.",
                            "target_lang_translations": {
                                "tr": "Bilim insanları, bitkinin kuru ve sulak topraklardaki <w>ekolojik genişliğini</w> inceledi."
                            }
                        }
                    ],
                    "synonyms": [
                        "tolerance range"
                    ],
                    "common_phrases": [
                        "ecological amplitude",
                        "wide amplitude"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir canlı türünün hayatta kalabileceği çevresel koşulların aralığı veya toleransı"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tolerans aralığı",
                                "target_lang_sense_clarification": "ekolojik uyum genişliği"
                            },
                            {
                                "target_lang_word": "genişlik",
                                "target_lang_sense_clarification": "ekolojik yaşama aralığı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}