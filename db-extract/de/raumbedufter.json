                "senses": [
                    {
                        "sense_id": "90b0d013-888a-3d46-a336-9c18f94ef63e",
                        "entry_id": "5ff2e867-d7b2-3aa6-8743-7b6f5742f5c4",
                        "glosses": [
                            "Duftstoff zur Verbesserung der Luft von Innenräumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32916bd9-6bd9-4f81-a970-ad78dae7570a",
                                "sense_id": "90b0d013-888a-3d46-a336-9c18f94ef63e",
                                "text": "„Sie sind vielseitig einsetzbar, als Raumbedufter, zur Inhalation, als Badezusatz, zur Mundspülung und auch zum Einnehmen gibt es Rezepturen.“"
                            },
                            {
                                "example_id": "b3e3bc85-987c-4363-a16a-a7df9ecaa4c8",
                                "sense_id": "90b0d013-888a-3d46-a336-9c18f94ef63e",
                                "text": "„Gerade auf spezielle Raumbedufter sollte verzichtet werden, weil es sich hier noch nicht einmal um natürliche Duftstoffe handelt.“"
                            },
                            {
                                "example_id": "cf39b581-b132-4ac7-b2c4-6bdb21eae4a3",
                                "sense_id": "90b0d013-888a-3d46-a336-9c18f94ef63e",
                                "text": "„Und obwohl sie überall Raumbedufter aufgestellt hatte, wurde sie das Gefühl nicht los, dass es immer noch nach halb verdauter roter Beete und voller Windel roch.“"
                            },
                            {
                                "example_id": "5c6a09c3-d008-4a5c-ace4-3e31da0655a0",
                                "sense_id": "90b0d013-888a-3d46-a336-9c18f94ef63e",
                                "text": "„Geben Sie maximal drei bis fünf Tropfen Öl in die Duftlampe oder in den elektrischen Raumbedufter (Diffusor).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
