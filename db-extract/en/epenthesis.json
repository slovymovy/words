                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "05a89229-d6ff-4f28-b789-a9de793913c8",
                        "source_entry_id": "48e24c86-dd4d-3bc6-aab9-65800c22b113",
                        "source_sense_id": "60a1ef98-153b-3ef7-ae85-78295dc5d889",
                        "source_sense_description": "insertion of a phoneme or letter into a word",
                        "target_lang_word": "Fugenlaut",
                        "target_lang_code": "de",
                        "note": "in case of compounds",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fugenlaut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06deacbe-d56e-3cce-9ab3-b1a1be65b9bc",
                                        "entry_id": "6798124d-3e6c-3fbc-97a1-13c3b147e52d",
                                        "glosses": [
                                            "nicht fachliche Bezeichnung für das eingeschobene Element zwischen den Bestandteilen (Gliedern) einer Zusammensetzung (Kompositums) (zum Beispiel das „s“ in „hilfsbereit“), wobei der Status als Morphem oder kein Morphem offengelassen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f08925-367d-4000-9b47-91eee2a94a2c",
                                                "sense_id": "06deacbe-d56e-3cce-9ab3-b1a1be65b9bc",
                                                "text": "Der Ausdruck Fugenlaut ist in der Linguistik nicht üblich: Er fehlt in den derzeit wichtigsten Fachwörterbüchern. Er impliziert, dass Fugenlaute nur Laute seien ohne weitere sprachliche Funktion, was zumindest in dieser extremen Form nicht richtig ist. Statt Fugenlaut kann man Fugenelement verwenden, wenn man sich hinsichtlich der strukturellen Bedeutung dieser Elemente nicht sicher ist. Da die Fugenlaute in vielen Fällen eindeutig Bedeutungen unterscheiden („Arbeit-s-organisation“ – „Arbeit-er-organisation“ und viele andere mehr), ist auch Fugenmorphem vertretbar und zumindest in diesen speziellen Fällen notwendig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
