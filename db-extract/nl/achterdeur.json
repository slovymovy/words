                        ],
                        "examples": [
                            {
                                "example_id": "51bf7c2c-ad21-43bf-ba6a-e0ebaa9b4297",
                                "sense_id": "3a0a4158-8e7f-3677-9a35-a5ca66853f1a",
                                "text": "Ze gingen het huis binnen via de achterdeur.",
                                "translation": "They entered the house through the back door.",
                                "english": "They entered the house through the back door."
                            },
                            {
                                "example_id": "3c62acda-5d02-4c74-af33-60132c5d2120",
                                "sense_id": "3a0a4158-8e7f-3677-9a35-a5ca66853f1a",
                                "text": "De achterdeur was op slot, dus moesten we rondlopen naar de voorkant.",
                                "translation": "The back door was locked, so we had to walk around to the front.",
                                "english": "The back door was locked, so we had to walk around to the front."
                            },
                            {
                                "example_id": "40870f16-3296-4e0f-ae49-667ae5af5aaa",
                                "sense_id": "3a0a4158-8e7f-3677-9a35-a5ca66853f1a",
                                "text": "Hij schilderde de achterdeur groen.",
                                "translation": "He painted the back door green.",
                                "english": "He painted the back door green."
                            }
                        ]
                    }
