                "senses": [
                    {
                        "sense_id": "789976df-9687-3be2-9d07-ea7526b31271",
                        "entry_id": "59c1a2d3-92cf-3505-9ec9-c657560127bb",
                        "glosses": [
                            "Donner un caractère rappelant Shakespeare à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f51300d5-a56f-4c7d-9adc-39124f1a31b5",
                                "sense_id": "789976df-9687-3be2-9d07-ea7526b31271",
                                "text": "Louis a une prodigieuse faculté de shakespeariser tout, selon le verbe inventé par Marx, verbe auquel il opposait le schillériser de l’Allemagne."
                            },
                            {
                                "example_id": "48ff5104-cd84-4676-9794-40486b9d097c",
                                "sense_id": "789976df-9687-3be2-9d07-ea7526b31271",
                                "text": "Il se pénètrera plus profondément du sombre génie qu’il a su regarder en face et s’il veut détacher ses regards de l’azur pour les plonger dans le brouillard, se déméridionaliser un peu et se shakespeariser beaucoup, il atteindra sans doute un jour l’équation qu’il poursuit !"
                            }
                        ]
                    }
