                                "sense_id": "904892af-e49a-3995-9962-66face35d9c9",
                                "text": "Józef Piłsudski miał ważny socjalistyczny epizod w swoim życiorysie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "eec30244-675c-36ef-a04e-77c862617a70",
