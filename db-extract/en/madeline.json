                    {
                        "translation_id": "6541276c-e089-4dc1-9ec2-718bb7b6ddef",
                        "source_entry_id": "1d59f417-9fa6-30ce-b4c8-a7a7448ba8b0",
                        "source_sense_id": "109dc207-0c9f-3310-a5b1-1c4708e45149",
