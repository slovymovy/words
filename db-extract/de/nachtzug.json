                "senses": [
                    {
                        "sense_id": "e0c1cfec-f358-3106-9a8e-8dc0974745dd",
                        "entry_id": "32bd565f-9ff5-301e-aa1a-cc2005be4252",
                        "glosses": [
                            "Train de nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8462583-4569-449a-ae86-38ecda0f0947",
                                "sense_id": "e0c1cfec-f358-3106-9a8e-8dc0974745dd",
                                "text": "Ich ziehe es vor, mit dem Nachtzug zu reisen.",
                                "translation": "Je préfère voyager avec le train de nuit."
                            },
                            {
                                "example_id": "bd917c5a-ed16-47c2-8eea-640b4e9b79af",
                                "sense_id": "e0c1cfec-f358-3106-9a8e-8dc0974745dd",
                                "text": "Für (Herrn) Bohun jedenfalls steht fest: \"Wenn man mit dem Zug reist, sollte man, wo immer möglich, Nachtzüge in Betracht ziehen.\"",
                                "translation": "En tout cas, pour (Monsieur) Bohun, une chose est sûre : \"Si l’on voyage en train, il faut, dans la mesure du possible, considérer des trains de nuit\"."
                            }
                        ]
                    }
                ],
