                ],
                "senses": [
                    {
                        "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                        "entry_id": "db70dbe0-4ef7-3e99-a458-574356cd2c9a",
                        "glosses": [
                            "Something or someone that restores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76bbe14d-338d-45a0-b13c-d035297d5ee6",
                                "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                                "text": "Slightly mesmerized by this accomplishment, Rita asked, \"Are you a chair mender?\" \"I'm the best carver, joiner, and expert furniture restorer in this country. So what about it?\" \"If you really are a good restorer - you'll have to wait a minute, though. I'm only looking after the place for the owner at present. I'll have to consult her.\""
                            },
                            {
                                "example_id": "18a92356-e311-4634-845c-662a43a1f9d8",
                                "sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nInside its exhibit hall, behind panes of glass, in a white-lit lab, a team of restorers works on an ancient Byzantine floor: 44 square yards of stone shards rescued from Lot’s Cave Monastery."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65110e2a-4874-4641-973c-36db4a2f3ab3",
                        "source_entry_id": "db70dbe0-4ef7-3e99-a458-574356cd2c9a",
                        "source_sense_id": "b5e21d31-7844-3e74-9836-6edb57b6796d",
                        "source_sense_description": "one who restores",
                        "target_lang_word": "Restaurator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Restaurator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                        "entry_id": "be51b1f8-6741-38db-8844-6c188075bb07",
                                        "glosses": [
                                            "Person, die aufgrund ihrer Ausbildung dazu in der Lage ist Restaurierungsarbeiten fachgerecht durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd2720da-f900-4ba7-85dc-0e519c4897ec",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„In der Werkstätte von Restaurator Thomas Frankl geht es nun darum, die Holzsärge von Schimmel zu reinigen, die Substanz zu erhalten und die Bemalungen und Beschläge zu konservieren.“"
                                            },
                                            {
                                                "example_id": "bab2b25a-9ed3-4e74-8a4d-27d8c1f1b379",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Ihr Verkauf brachte dem Restaurator aus Niederbayern mehr als eine halbe Million Euro - bis ihm ein Kunsthistoriker auf die Spur kam.“"
                                            },
                                            {
                                                "example_id": "6fe2e874-9bab-4f4d-b1e5-f8565dbede4f",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Museumsrundgang, Obergeschoss, der Restaurator geleitet durch die hohen Hallen wie ein Fremdenführer.“"
                                            },
                                            {
                                                "example_id": "38ac797e-6670-4dbb-b5bc-3aeb001f8ae0",
                                                "sense_id": "ce5c00dd-d092-31f0-8204-593948771aa0",
                                                "text": "„Als Restaurator von Orgeln verdiente er sein täglich Brot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
