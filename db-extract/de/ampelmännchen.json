                "senses": [
                    {
                        "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                        "entry_id": "ef826d8d-69ee-3e28-b54c-86f2478c9ded",
                        "glosses": [
                            "für Fußgänger bestimmtes Lichtsignal an Verkehrsampeln, das symbolisch einen Mann darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f14b7fa3-9e0d-4ec1-bcf4-95f13325868a",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Fast wäre das DDR-Ampelmännchen ein Opfer der Wende geworden.“"
                            },
                            {
                                "example_id": "eb0d7458-fd4d-46a5-b385-c77c09a69cbf",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Nach der Wiedervereinigung wurden die Ampelmännchen der DDR in Westdeutschland hip.“"
                            },
                            {
                                "example_id": "d59c51cb-7078-4f73-8aa4-8e4b4b653702",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„»Das Ampelmännchen steht wie kaum eine andere Figur für die Annäherung von Ost- und Westdeutschland. […]«“"
                            },
                            {
                                "example_id": "66604e15-dd35-476c-8bac-d6ce15a4d3a3",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Seit Januar 2005 werden in Berlin auch in den Westbezirken Ost-Ampelmännchen an Lichtzeichenanlagen eingesetzt.“"
                            },
                            {
                                "example_id": "11ca0282-aed9-4924-a19b-ce63c37d4337",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Am Ende blieb nicht viel übrig aus Ostdeutschland: geöffnete Stasi-Akten, eine gelockerte Fristenregelung bei Schwangerschaftsabbrüchen, das Ampelmännchen.“"
                            },
                            {
                                "example_id": "57af65c7-e1f1-431f-845e-6c213ecc9489",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Was noch an die DDR erinnerte, wurde zurückgedrängt – Ampelmännchen und einige Straßennamen ausgenommen.“"
                            },
                            {
                                "example_id": "60d847cb-c980-4089-820d-066a0c0e1bb3",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Ich habe gehört, dass sich die Gleichstellungsbeauftragten mehrerer deutscher Städte in einen neuen Kampf gestürzt haben: Die Ampelmännchen sollen durch Ampelfrauen ersetzt werden.“"
                            },
                            {
                                "example_id": "32a4f672-d6c3-45e3-9651-118f02ca2bd7",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„Am 5. Mai jährt sich der Geburtstag des geistigen Vaters des Kommunismus zum 200. Mal. Karl Marx' Heimatstadt Trier weiß die Berühmtheit ihres Sohnes zu vermarkten - und hat ihn nun zu einem Ampelmännchen gemacht.“"
                            },
                            {
                                "example_id": "339b4c6f-4ae6-45e9-8bb0-457cfe767d98",
                                "sense_id": "9ca452be-139e-31ca-b3b6-fb410f031b1d",
                                "text": "„»Das ist ganz interessant, dass aus so einer Debatte über Ost und West eine im Grunde genommen selbstironische Spielerei wird, und mit diesen vielen Varianten ist natürlich die Ost-West-Front beim Ampelmännchen auch etwas aufgebrochen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
