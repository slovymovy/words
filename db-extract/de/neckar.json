                    {
                        "sense_id": "76e69300-24f1-34a7-ae01-89fd8fcd86ea",
                        "entry_id": "a3c73a32-0a47-3eae-9306-a3343e8d3119",
                        "glosses": [
                            "rechter Nebenfluss des Rheins, entspringt im Schwenninger Moos bei Villingen-Schwenningen auf der Baar und mündet nach 367 km Flusslauf bei Mannheim in den Rhein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e58433c6-dcc0-4d39-96e9-3b1b029c12b9",
                                "sense_id": "76e69300-24f1-34a7-ae01-89fd8fcd86ea",
                                "text": "Der Neckar ist von Plochingen bis zur Mündung mittels 26 Staustufen kanalisiert und schiffbar gemacht."
                            },
                            {
                                "example_id": "d5350996-0475-4f28-82ba-8d41fc3fa5fe",
                                "sense_id": "76e69300-24f1-34a7-ae01-89fd8fcd86ea",
                                "text": "„Bald gras' ich am Neckar, bald gras' ich am Rhein, bald hab' ich ein Schätzel, bald bin ich allein.“ (Deutsches Volkslied, Worte aus des Knaben Wunderhorn, 1808)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
