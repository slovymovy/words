                        "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                        "entry_id": "f5fc173a-a99f-3247-9106-f6b455f07fc2",
                        "glosses": [
                            "That smiles or has a smile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f571bb-dbed-401e-9e83-d266cbbb94ce",
                                "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                                "text": "smiling children"
                            },
                            {
                                "example_id": "f168a540-10bb-4034-a48e-54ea8c8d9add",
                                "sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                                "text": "Serene, smiling, enigmatic, she faced him with no fear whatever showing in her dark eyes. The clear light of the bright autumn morning had no terrors for youth and health like hers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "069461da-9fca-4563-b4ed-62cd12dbf9fc",
                        "source_entry_id": "f5fc173a-a99f-3247-9106-f6b455f07fc2",
                        "source_sense_id": "a562342b-1c54-3da7-a1a5-ed942d4725ec",
                        "source_sense_description": "that smiles or has a smile",
                        "target_lang_word": "souriant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "souriant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                        "entry_id": "60d64cfa-589b-3a38-9102-f43938861eff",
                                        "glosses": [
                                            "Qui sourit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e8a798-afe6-4952-9974-b3311daa874c",
                                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                                "text": "La porte était à peine fermée derrière le prince que le roi de Navarre, […], apparut souriant sur le seuil de la chambre."
                                            },
                                            {
                                                "example_id": "929234f7-bef1-469c-8e13-c7d9cdeb197c",
                                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                                "text": "Lorsqu'au bout de quelques semaines Elhamy la remercia, avec une cordialité souriante, du bien qu'elle avait fait à son fils, une émotion sourde étreignit sa gorge."
                                            },
                                            {
                                                "example_id": "b2024c62-ac34-4750-8e58-9b5a0095918b",
                                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                                "text": "Cela intéressait vivement notre maître d’hôtel pourtant, car le voici ceint de son blanc tablier, la mine souriante, la bouche en cœur, le visage jambonné par la chaleur des fourneaux et venant connaître notre opinion sur sa cuisine."
                                            },
                                            {
                                                "example_id": "0bf4c678-304d-4f91-aa7a-8373acb1f09f",
                                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                                "text": "[…], la directrice du casino, souriante, vient nous saluer."
                                            },
                                            {
                                                "example_id": "748b7137-6a87-45a3-a3b9-3827bf81bdc7",
                                                "sense_id": "f4ced439-0ab1-39e5-bc09-bb52313da2dc",
                                                "text": "Le libraire avait les bras chargés de quatre lourds in-octavo qu'il déposa sur une tablette. Tout souriant, le client s'approcha, posa une série de questions, nota sur un carnet la date de l'édition, le prix des volumes […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "souriant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31df5d5d-f480-386b-a1b5-67a155020e42",
                                        "entry_id": "b2c6d7e4-6e5a-3280-95af-1bc182d26dde",
                                        "glosses": [
                                            "Participe présent de sourire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "071897a5-292f-4ba6-823f-54b5703c441d",
                                                "sense_id": "31df5d5d-f480-386b-a1b5-67a155020e42",
                                                "text": "Truitelles et ris d’agneau ? demanda-t-il en souriant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
