                            {
                                "example_id": "a2a61907-50d5-4610-afd3-c67f89e0594d",
                                "sense_id": "43e53171-2b7d-30e6-b0d9-aa99a69a018a",
                                "text": "Dieses Rennmotorrad ist meine jüngste Neuanschaffung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "99c69a26-5419-37a5-9d5b-221cea6217c0",
