            {
                "entry_id": "eca212b6-095a-3373-bd1c-b5a1b8f6c99d",
                "word": "négus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f6dc7777-d6f3-3cf5-be14-3acb3085db6e",
                        "entry_id": "eca212b6-095a-3373-bd1c-b5a1b8f6c99d",
                        "glosses": [
                            "Limonade au vin en usage en Angleterre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f4b342-70a0-4652-9bc8-735bea2e0c97",
                                "sense_id": "f6dc7777-d6f3-3cf5-be14-3acb3085db6e",
                                "text": "M. Linton lui a préparé un grand verre de négus et Isabella lui a mis dans le pan de sa robe tous les gâteaux qu’elle avait sur une assiette, pendant qu’Edgar restait à distance, bouche béante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a117bf4-92f2-49a1-8427-c4c5852261b4",
                        "source_entry_id": "eca212b6-095a-3373-bd1c-b5a1b8f6c99d",
                        "source_sense_id": "f6dc7777-d6f3-3cf5-be14-3acb3085db6e",
                        "target_lang_word": "negus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ad8881-30c8-3f90-ac0f-681ed74a72d9",
                                        "entry_id": "ef23d6d8-fc45-3cdf-9878-d914d47a1706",
                                        "glosses": [
                                            "A drink made of wine, often port, mixed with hot water, oranges or lemons, spices and sugar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b2493ed-dbe8-45b2-bb9c-dd0a860c77bb",
                                                "sense_id": "f2ad8881-30c8-3f90-ac0f-681ed74a72d9",
                                                "text": "And when he got home he had a glass of hot negus in his wife's sitting-room, and read the last number of the “Little Dorrit” of the day with great inward satisfaction."
                                            },
                                            {
                                                "example_id": "37a88651-a8cd-440f-b692-a9ed9b121f77",
                                                "sense_id": "f2ad8881-30c8-3f90-ac0f-681ed74a72d9",
                                                "text": "Esther began […] to cry. But when the fire had been lit specially to warm her chilled limbs and Adela had plied her with hot negus she began to feel rather a heroine."
                                            },
                                            {
                                                "example_id": "eae5b4a9-86cf-40c2-b466-de989c43e2ab",
                                                "sense_id": "f2ad8881-30c8-3f90-ac0f-681ed74a72d9",
                                                "text": "‘I could sure use a cup of negus and maybe some hot soup,’ he sniffs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "negus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "212f3e36-aaa6-3faf-93d7-905972362b39",
                                        "entry_id": "fe1f08c1-799d-3ec6-8f14-db7af05bc4a7",
                                        "glosses": [
                                            "A ruler of Abyssinia (Ethiopia), or of a province of Ethiopia; specifically, the king of Ethiopia before 1974."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209f141f-a66f-461c-8a40-61f657a49453",
                                                "sense_id": "212f3e36-aaa6-3faf-93d7-905972362b39",
                                                "text": "Sir, the Negus of Ethiopia is here in person; and this is the day of our death, doe what you can to saue your selfe, for my part I meane here to die"
                                            },
                                            {
                                                "example_id": "359ee6da-6245-4002-913b-bf552d873e53",
                                                "sense_id": "212f3e36-aaa6-3faf-93d7-905972362b39",
                                                "text": "In the Abyssinian Language a King is call'd Negus. Their Monarch they stile Negus Negasta, which is as much as to say, King of Kings."
                                            },
                                            {
                                                "example_id": "91bbdc6b-2d0a-4427-89fc-f535b1d0c7c3",
                                                "sense_id": "212f3e36-aaa6-3faf-93d7-905972362b39",
                                                "text": "It was a Syrian merchant, Frumentius, who is credited with converting Ezana, the Negus (king or emperor) of the powerful northern Ethiopian state of Aksum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
