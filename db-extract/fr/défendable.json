                ],
                "senses": [
                    {
                        "sense_id": "cad0d805-1219-3f4d-b7ca-d958cbd3643a",
                        "entry_id": "ae0634e6-f961-3e9c-85d2-15170f7fe6d7",
                        "glosses": [
                            "Qui peut être défendu contre une agression."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14e332bf-22b0-4c69-ae6c-29e45f2589d6",
                                "sense_id": "cad0d805-1219-3f4d-b7ca-d958cbd3643a",
                                "text": "L’Empire romain, qui s’étendait des sables d'Arabie jusqu'aux neiges d'Écosse, fut constamment à la recherche de frontières défendables."
                            }
                        ]
                    },
                    {
                        "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                        "entry_id": "ae0634e6-f961-3e9c-85d2-15170f7fe6d7",
                        "glosses": [
                            "Qui peut être soutenu, justifiable, soutenable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f601fcd-4699-4fbd-8277-bd1d59e5699c",
                                "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                                "text": "L'opinion, la thèse que vous soutenez est défendable."
                            },
                            {
                                "example_id": "28344ee0-4ff7-4012-a0d0-b654b8dabff7",
                                "sense_id": "8730c47c-f6ba-3b0c-a8c9-06a563d040b5",
                                "text": "Il y a dix-huit mois, un jeune physicien américain, M. David Bohm, a repris, d'ailleurs avec talent, mes anciennes idées sous la forme tronquée et peu défendable de l'onde-pilote."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "737c5255-7b14-485b-ad9a-a9d83433a9ce",
                        "source_entry_id": "ae0634e6-f961-3e9c-85d2-15170f7fe6d7",
                        "target_lang_word": "defensible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defensible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4d891e-fa2d-37bd-87ca-33ed5c53eee7",
                                        "entry_id": "89681770-7988-3e3d-a21f-c5455daa8e04",
                                        "glosses": [
                                            "Capable of being defended against armed attack."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c3b67e6-3c5d-4c00-afd9-b4a8b7e76105",
                                                "sense_id": "6a4d891e-fa2d-37bd-87ca-33ed5c53eee7",
                                                "text": "Not only were those cities fortified, but their architects based their whole system on the strategical possibilities of the site, and closely followed its defensible contours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb922f7f-bbd6-39d4-ac14-ba6e3a885cff",
                                        "entry_id": "89681770-7988-3e3d-a21f-c5455daa8e04",
                                        "glosses": [
                                            "Capable of being justified."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0afc8a4-4b60-4cd3-9247-52348f6aa693",
                                                "sense_id": "bb922f7f-bbd6-39d4-ac14-ba6e3a885cff",
                                                "text": "Those who are most familiar with the working of the present society are also usually interested in the preservation of particular features of that society which may not be defensible on general principle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
