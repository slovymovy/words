                "senses": [
                    {
                        "sense_id": "08666c77-8c5b-3f30-9ad8-3008e3d0985e",
                        "entry_id": "1b0d8ec4-7dba-3b40-b562-0541d2215db3",
                        "glosses": [
                            "Provoquer la génération automatique de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2494dc6-cc3a-4516-9838-ee74ddb709c5",
                                "sense_id": "08666c77-8c5b-3f30-9ad8-3008e3d0985e",
                                "text": "De manière similaire, si cmp est surchargé, il peut servir pour autogénérer les comportements des opérateurs suivants : lt, le, gt, ge, eq, and ne."
                            },
                            {
                                "example_id": "eabfb30a-48d3-4552-8f2c-aa84331f227e",
                                "sense_id": "08666c77-8c5b-3f30-9ad8-3008e3d0985e",
                                "text": "Je soupçonne ce forum d'autogénérer des fautes d'orthographe..."
                            }
                        ]
                    },
                    {
                        "sense_id": "399a0881-9f6c-3a96-8786-2b3edae6850e",
                        "entry_id": "1b0d8ec4-7dba-3b40-b562-0541d2215db3",
                        "glosses": [
                            "Se générer sans intervention extérieure."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "0634756b-18b9-4cfe-a608-fdb261e6b26f",
                                "sense_id": "399a0881-9f6c-3a96-8786-2b3edae6850e",
                                "text": "Quelqu'un qui doit s'autogénérer, naître lui-même, naître seul, qui doit se fabriquer l'organe qui ne lui a pas poussé."
                            }
                        ]
