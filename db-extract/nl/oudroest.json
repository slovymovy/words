                        "examples": [
                            {
                                "example_id": "469d92df-ceac-4880-b81c-cfe233147075",
                                "sense_id": "f2546e8a-6db7-3ff8-b657-59169bca5f16",
                                "text": "Met een jaarlijkse productie van één miljoen ton schroot vindt het vuur een makkelijke prooi om snel uit te breiden. De bergen oudroest langs de kaai zijn te zien van op het zuidelijke puntje van het Deurganckdok. Het bedrijf, op kaai 1201 van de Waaslandhaven, telt vijftig werknemers."
                            },
                            {
                                "example_id": "d96912a9-6bf3-40c9-bd7e-6f15524c1449",
                                "sense_id": "f2546e8a-6db7-3ff8-b657-59169bca5f16",
                                "text": "De Electrodynamic Debris Eliminator (EDDE) is vooral bedoeld om de lagere banen rond de aarde op te ruimen. Daar zouden de satellieten alle objecten zwaarder dan 2 kilogram opscheppen. De EDDE moet het oudroest in de dampkring dumpen of naar een werkplaats in de ruimte brengen, waar ze worden gerecycled tot capsules voor bemanningen of apparatuur"
                            }
                        ]
                    }
