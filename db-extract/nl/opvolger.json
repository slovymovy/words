                    }
                ],
                "senses": [
                    {
                        "sense_id": "16eb23d7-660b-393d-88f6-240ed4984931",
                        "entry_id": "528f386a-9a84-354a-a32e-3326f8c5e551",
                        "glosses": [
                            "iemand die een ambt bekleedt na iemand anders."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad309cb3-6038-40f2-a527-130b0803ed9a",
                                "sense_id": "16eb23d7-660b-393d-88f6-240ed4984931",
                                "text": "Vier jaar lang moet Barack Obama zich verbeten hebben, maar hij slaagde erin te zwijgen over het beleid van zijn opvolger Donald Trump."
                            },
                            {
                                "example_id": "d8cc2885-e646-420d-93b9-9f0c59754cc9",
                                "sense_id": "16eb23d7-660b-393d-88f6-240ed4984931",
                                "text": "De Britse premier Boris Johnson heeft donderdag aangekondigd op te stappen. Hij blijft voorlopig de taken van premier uitvoeren, totdat er een opvolger bekend is. Johnson lag al geruime tijd onder vuur vanwege een reeks schandalen, zoals het bijwonen van feestjes in coronalockdowns. Het vertrek van een aantal prominente ministers de afgelopen dagen blijkt de druppel te zijn geweest."
                            }
                        ]
                    },
                    {
                        "sense_id": "680da5f3-4528-3cc8-999a-467e77ad76c8",
                        "entry_id": "528f386a-9a84-354a-a32e-3326f8c5e551",
                        "glosses": [
                            "iets of iemand wat komt na een eerdere."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04647002-a8ee-4286-a3ed-a5b5135ad599",
                                "sense_id": "680da5f3-4528-3cc8-999a-467e77ad76c8",
                                "text": "Die versneller moet de opvolger worden van de Large Hadron Collider (LHC), die na aanpassingen overigens nog tot 2040 metingen kan verrichten. De LHC is het pronkstuk van de huidige deeltjesfysica, de natuurkundetak die het tot zijn missie maakt om de allerkleinste bouwsteentjes te vinden waarvan alles om ons heen is gemaakt."
                            },
                            {
                                "example_id": "25e89169-335f-4b41-a75a-77a83b5564de",
                                "sense_id": "680da5f3-4528-3cc8-999a-467e77ad76c8",
                                "text": "Een historische prestatie! Duncan Laurence heeft voor Nederland voor het eerst in 44 jaar het Eurovisie Songfestival gewonnen. Met Arcade won hij door een grote overwinning bij de publiekstemmen van Zweden en Italië. Laurence is de opvolger van Teach-in, dat in 1975 won met Ding-a-Dong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d533de2-9608-42b0-b5b5-6cb6e2058150",
                        "source_entry_id": "528f386a-9a84-354a-a32e-3326f8c5e551",
                        "source_sense_id": "16eb23d7-660b-393d-88f6-240ed4984931",
                        "source_sense_description": "iemand die een ambt bekleedt na iemand anders",
                        "target_lang_word": "Nachfolger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachfolger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                        "entry_id": "d0948a13-1fdb-3ecb-aa67-2bc0be8c5020",
                                        "glosses": [
                                            "jemand, der künftig die Position einer bestimmten Person einnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df9872dc-9e7a-4bbc-9eaa-6e2ce906cf04",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "Er begrüßte seinen Nachfolger mit herzlichen Worten."
                                            },
                                            {
                                                "example_id": "4d55de98-71f4-4ea5-9dfe-7ae63c550e5a",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„Bouteflika versuche offenbar, seinen rund 20 Jahre jüngeren Bruder Said als Nachfolger in Stellung zu bringen.“"
                                            },
                                            {
                                                "example_id": "5aae3ac7-ee10-49d2-9b3c-7d608687e795",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "Die Suche nach einem Nachfolger gestaltete sich schwieriger als gedacht."
                                            },
                                            {
                                                "example_id": "1edd3a9e-20be-4e45-9b44-468b19ba7a7c",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "Der junge Graf wurde schon früh als Nachfolger des Vaters in der Geschäftsführung der Brennerei aufgebaut."
                                            },
                                            {
                                                "example_id": "12c0806c-7a4a-4c2b-9fc0-270c16fc32bb",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„In München ist der Vorsitzende des Zentralrats zurückgetreten, ich werde zu seinem Nachfolger bestimmt.“"
                                            },
                                            {
                                                "example_id": "983df513-3f8b-4802-b299-e3508dd5a9f7",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„Ich gab mir vergeblich Mühe, den Kopf Hannibls und die Inschrift zu Ehren des Cäsar Claudius, des Nachfolgers des Gallienus, zu finden; aber ich sah die Überreste des Amphitheaters.“"
                                            },
                                            {
                                                "example_id": "adde7f39-efe8-4dfe-a382-cc4867589ace",
                                                "sense_id": "8e3f828f-2fe6-3c84-977a-80d6377de1fa",
                                                "text": "„Der Nachfolger Heinrichs VIII., König Eduard VI., ist gestorben, Heinrichs Testament verfügt, auf Eduard solle im Todesfalle Maria, die Katholische, folgen, aber Eduard, so sagt man, habe auf dem Totenbett seine Schwester Johanna zur Nachfolgerin bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                        "entry_id": "d0948a13-1fdb-3ecb-aa67-2bc0be8c5020",
                                        "glosses": [
                                            "ein Produkt, das ein bestimmtes älteres Produkt ablöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf1920c-3b86-4509-8850-a9ef3c1ff4ca",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Der Passat war der Nachfolger des VW 1600."
                                            },
                                            {
                                                "example_id": "6ac45434-c7db-45d4-b971-faf5857606f5",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Der Nachfolger der X-Box ist jetzt auf dem Markt erhältlich."
                                            },
                                            {
                                                "example_id": "4f7a02eb-7ff6-4d8c-ae82-4dab19f8a365",
                                                "sense_id": "45bd5b93-e0de-3ddb-981a-771275d74880",
                                                "text": "Ericsson arbeitet fieberhaft an einem Nachfolger für das Erfolgsmodell YM."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ce4c9cc-86f9-3524-9bdf-989d10e08695",
                                        "entry_id": "d0948a13-1fdb-3ecb-aa67-2bc0be8c5020",
                                        "glosses": [
                                            "die nächsthöhere Zahl in einer gegebenen Menge (meist der ganzen Zahlen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5778935d-516d-47bc-bb9d-bf3ac3bccb49",
                                                "sense_id": "7ce4c9cc-86f9-3524-9bdf-989d10e08695",
                                                "text": "0 ist der Nachfolger von -1."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
