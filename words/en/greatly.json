{
    "word_family": [
        "great",
        "greatness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                    "sense_definition": "To a great extent or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "extent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy will <w>greatly</w> improve the quality of life for many citizens.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>значительно</w> улучшит качество жизни многих граждан."
                            }
                        },
                        {
                            "text": "Expenses <w>greatly</w> exceeded revenues this year, much to nobody's surprise.",
                            "target_lang_translations": {
                                "ru": "Расходы в этом году <w>сильно</w> превысили доходы, что никого не удивило."
                            }
                        }
                    ],
                    "synonyms": [
                        "very",
                        "drastically",
                        "considerably",
                        "a lot"
                    ],
                    "antonyms": [
                        "slightly"
                    ],
                    "common_phrases": [
                        "greatly improve",
                        "greatly exceed",
                        "greatly exaggerated"
                    ],
                    "target_lang_definitions": {
                        "ru": "В значительной степени или мере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значительно",
                                "target_lang_sense_clarification": "в большой степени, намного"
                            },
                            {
                                "target_lang_word": "сильно",
                                "target_lang_sense_clarification": "интенсивно или в значительной мере"
                            },
                            {
                                "target_lang_word": "существенно",
                                "target_lang_sense_clarification": "заметно, в большой степени"
                            },
                            {
                                "target_lang_word": "весьма",
                                "target_lang_sense_clarification": "очень, в высокой степени (книжн.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                    "sense_definition": "In a noble or magnanimous manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He faced his final challenges <w>greatly</w>, showing a spirit of honor and virtue.",
                            "target_lang_translations": {
                                "ru": "Он встретил свои последние испытания <w>благородно</w>, проявив дух чести и добродетели."
                            }
                        },
                        {
                            "text": "The hero acted <w>greatly</w> when he forgave those who had wronged him.",
                            "target_lang_translations": {
                                "ru": "Герой поступил <w>великодушно</w>, когда простил тех, кто причинил ему зло."
                            }
                        }
                    ],
                    "common_phrases": [
                        "greatly minded"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to describe noble character"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Благородным или великодушным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "великодушно",
                                "target_lang_sense_clarification": "проявляя благородство и доброту"
                            },
                            {
                                "target_lang_word": "благородно",
                                "target_lang_sense_clarification": "с достоинством и честью"
                            },
                            {
                                "target_lang_word": "величественно",
                                "target_lang_sense_clarification": "с величием духа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
