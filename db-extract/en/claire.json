                        "entry_id": "c3ce4d17-406b-3895-a49b-1f34980e35d7",
                        "glosses": [
                            "A small enclosed pond used for gathering and greening oysters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5c5a30-44b4-4a25-b39d-dd7e03172cad",
                                "sense_id": "2aebcc96-95af-33d0-8e35-b93775982b51",
                                "text": "In order to prepare the ground of the claire for the reception of oysters, it must first be cleared of stones and all vegetation which may cover it, then the necessary slope from the center towards the sides may be given it."
                            },
                            {
                                "example_id": "6d062b51-3510-4c77-823e-4cc6d3af7822",
                                "sense_id": "2aebcc96-95af-33d0-8e35-b93775982b51",
                                "text": "A barrel of lime was spread around the edge of the claire, so as to be gradually washed into the water and furnish the material required by oysters in the fabrication of the shell. Until October the oysters in the claire remained exceedingly poor, […]"
                            }
                        ]
                    }
