                        "entry_id": "5bb9d05b-bbed-33ce-93f7-3bc8264870a5",
                        "glosses": [
                            "A small ship's boat, usually rowed by four or six oars."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "26b9cbd6-0219-3bcb-92f5-1df16d7395ea",
                        "entry_id": "5bb9d05b-bbed-33ce-93f7-3bc8264870a5",
                        "glosses": [
                            "A fore-and-aft rigged sailing vessel with two masts, main and mizzen, the mizzen stepped abaft the rudder post."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c35fe2-50b1-4604-b060-d920f78b744f",
                                "sense_id": "26b9cbd6-0219-3bcb-92f5-1df16d7395ea",
                                "text": "The “Nellie,” a cruising yawl, swung to her anchor without a flutter of the sails, and was at rest."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ae4b8b3-8bdf-4b28-9250-f1ccd620ac3a",
