        "nl-extract.jsonl": [
            {
                "entry_id": "5bf6774e-b563-3f32-8f31-806ea998a491",
                "word": "welzijn",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a813b374-ffc5-3334-a8da-be213de13e65",
                        "entry_id": "5bf6774e-b563-3f32-8f31-806ea998a491",
                        "glosses": [
                            "wanneer een individu of maatschappij zich in een goede toestand bevindt op het gebied van gezondheid, geluk en/of voorspoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0ca053-dc5d-4f95-ab3a-b5d69e3416bc",
                                "sense_id": "a813b374-ffc5-3334-a8da-be213de13e65",
                                "text": "In België is er een veel groter sociaal welzijn dan in Zuid-Amerika."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eba4c75-bb7b-4834-8e86-17e877e2cc00",
                        "source_entry_id": "5bf6774e-b563-3f32-8f31-806ea998a491",
                        "source_sense_id": "a813b374-ffc5-3334-a8da-be213de13e65",
                        "source_sense_description": "wanneer een individu of maatschappij zich in een goede toestand bevindt ...",
                        "target_lang_word": "Wohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                        "entry_id": "fdb52d29-ebaf-370f-b363-2e1845db8e49",
                                        "glosses": [
                                            "Zustand des Gutgehens, körperlich und geistig, auch Gesundheit und Glück"
                                        ],
                                        "tags": [
                                            "auf den Einzelnen bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ac190f-cc77-4e00-b5a7-4a38ae0921b1",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Die Kneipengänger riefen alle aus voller Brust: zum Wohl!"
                                            },
                                            {
                                                "example_id": "1a6bb134-aa62-4cd7-920b-a0a63bd9c5c5",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Der Hirte kümmert sich nach dem unheilvollen Gewitter um das Wohl der Tiere."
                                            },
                                            {
                                                "example_id": "84488701-8d16-4204-8c3f-5875f15e7a2e",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Vernachlässigung, psychische und körperliche Misshandlung: Immer mehr Kinder sind nach Einschätzung von Jugendämtern in ihrem Wohl gefährdet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                        "entry_id": "fdb52d29-ebaf-370f-b363-2e1845db8e49",
                                        "glosses": [
                                            "das Gute im Interesse der Masse, zum Beispiel Reichtum und (soziale) Stabilität"
                                        ],
                                        "tags": [
                                            "auf mehrere bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99909768-a07f-4abf-a06a-36034764b5cc",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Amtseid des Bundespräsidenten, der Kanzlerin, auch vor Antritt eines Ministeramtes (Grundgesetz, Artikel 56 und 64): Ich schwöre, daß ich meine Kraft zum Wohle des deutschen Volkes widmen, seinen Nutzen mehren, Schaden von ihm wenden, das Grundgesetz und die Gesetze des Bundes wahren und verteidigen, meine Pflichten gewissenhaft erfüllen und Gerechtigkeit gegen jedermann und -frau üben werde."
                                            },
                                            {
                                                "example_id": "31fb4a2a-ef90-4ae0-ad8c-3ae6eae14696",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Der Mörder meinte: er habe den Mord zum Wohl der Gesellschaft begangen."
                                            },
                                            {
                                                "example_id": "15f614b1-3ad7-47d6-99c1-eace305a357a",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Erneut gab es dort eine Zusammenkunft, bei der es um das Wohl und Wehe der sozialen Einrichtung ging."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ef6ca81-9b09-430e-9dea-171dd9303d2e",
                        "source_entry_id": "5bf6774e-b563-3f32-8f31-806ea998a491",
                        "source_sense_id": "a813b374-ffc5-3334-a8da-be213de13e65",
                        "source_sense_description": "wanneer een individu of maatschappij zich in een goede toestand bevindt ...",
                        "target_lang_word": "Wohlbefinden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlbefinden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03c61b44-787d-3161-ac30-0eb063af6650",
                                        "entry_id": "835925ab-833b-3eba-8ebd-46fffa2fd297",
                                        "glosses": [
                                            "Gefühl des Wohlseins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f290a72-66d0-4c54-b7cc-43a65d5e7993",
                                                "sense_id": "03c61b44-787d-3161-ac30-0eb063af6650",
                                                "text": "„Firmen aus den unterschiedlichsten Branchen bezahlen Fürstenberg dafür, dass sich ihre Mitarbeiter dort anonym Hilfe holen können, wenn ihr seelisches Wohlbefinden gefährdet ist.“"
                                            },
                                            {
                                                "example_id": "2bc3deb2-4151-4b22-86c5-b316fe1d6e3b",
                                                "sense_id": "03c61b44-787d-3161-ac30-0eb063af6650",
                                                "text": "„Die deutsche Kanzlerin dagegen kümmert sich um das Wohlbefinden ihrer Besucher an ihrem Tag der offenen Tür.“"
                                            },
                                            {
                                                "example_id": "40dad1b1-077d-4b69-b30f-4ea374866282",
                                                "sense_id": "03c61b44-787d-3161-ac30-0eb063af6650",
                                                "text": "„Sie waren sich kürzlich mit den führenden Köpfen der Weltraumforschung darüber einig, dass der Mensch bedauerlicherweise eine Fehlkonstruktion sei, da man ihn nicht einmal ein paar Millionen Kilometer durch das Universum schießen und aus dieser Höhe wieder auf die Erde zurückprallen lassen könne, ohne sein Wohlbefinden zu gefährden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50166bfa-98dc-41d7-9abe-de1e87b3a1c1",
                        "source_entry_id": "5bf6774e-b563-3f32-8f31-806ea998a491",
                        "source_sense_id": "a813b374-ffc5-3334-a8da-be213de13e65",
                        "source_sense_description": "wanneer een individu of maatschappij zich in een goede toestand bevindt ...",
                        "target_lang_word": "Wohlergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                        "entry_id": "71761296-f902-307c-8863-27992b6114cf",
                                        "glosses": [
                                            "Zustand, in dem sich jemand gut fühlt und sich in guter Verfassung befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e79acf-9022-4c48-a4db-ace12f00f52c",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "Ich sorge mich sehr um Marthas Wohlergehen."
                                            },
                                            {
                                                "example_id": "8d4fc293-05d5-4c2b-9b34-683f4eb2bc50",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Das Wohlergehen der Juden in der ‚Diaspora‘, wie man in Israel unser selbstgewähltes ‚Exil‘ nennt, interessiert Politiker vom seinem Schlage nur, wenn sie innenpolitisch damit punkten können.“"
                                            },
                                            {
                                                "example_id": "ac8f565c-2f2b-4a4b-b18d-5cf1973a97ab",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Meine Mutter wachte über das Wohlergehen der Zither strenger als über das Wohlergehen ihrer Nähmaschine.“"
                                            },
                                            {
                                                "example_id": "83332e8e-ce12-4e85-b1f9-9777235ccb94",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "[Coronapandemie 2021:] „Seit einem Jahr werden Kinder und Jugendliche als Pandemietreiber verunglimpft. Ihr Wohlergehen spielt keine Rolle.“"
                                            },
                                            {
                                                "example_id": "a10c1f54-263c-45c7-a5de-45330c5b687f",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Immer geht es dabei um Fragen nach dem Streben nach Glück, das, wenn es zum Streben nach Erfolg, Anerkennung, materiellem Wohlergehen missrät, mit Unglück, Depression, Ennui entgolten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
