                "senses": [
                    {
                        "sense_id": "9c3fee9c-ebed-3155-ba5f-b463c71fa7c8",
                        "entry_id": "e3ee7798-667d-3c89-a9be-86173a25974d",
                        "glosses": [
                            "A pilot specialized for high-altitude flights and missions"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae8fbb65-0b7f-37bd-bb7c-23c2b2982451",
                        "entry_id": "e3ee7798-667d-3c89-a9be-86173a25974d",
                        "glosses": [
                            "An installer specialized in the construction of high-rise structures"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7f98ee-17a0-41f7-ba96-905cb8970d21",
                                "sense_id": "ae8fbb65-0b7f-37bd-bb7c-23c2b2982451",
                                "text": "Не кочегары мы, не плотники,\nНо сожалений горьких нет - как нет!\nА мы монтажники - высотники, да!\nИ с высоты вам шлём привет.",
                                "translation": "We are neither stokers nor carpenters;\nYet bitter regrets [we have] none - just none!\nStill, we are installers - steeplejacks - aye!\nAnd from on high we send you greetings.",
                                "english": "We are neither stokers nor carpenters;\nYet bitter regrets [we have] none - just none!\nStill, we are installers - steeplejacks - aye!\nAnd from on high we send you greetings."
                            }
                        ]
                    }
                ],
