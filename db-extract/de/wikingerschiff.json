                    {
                        "sense_id": "f87015e9-684e-3d0d-a491-e8a47c44a9c2",
                        "entry_id": "d6da2e9d-a713-3ccb-8392-bee4ba882bd5",
                        "glosses": [
                            "Schiffstyp, der von den Wikingern verwendet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68396ff-b2fe-4cbe-83b7-ac6907c60688",
                                "sense_id": "f87015e9-684e-3d0d-a491-e8a47c44a9c2",
                                "text": "„Roland hatte mir zugeflüstert, auf den Färöern wohnten jene, die die Wikingerschiffe wegen Seekrankheit verlassen mussten, als sie auf dem Weg nach Island waren.“"
                            },
                            {
                                "example_id": "705ee604-fc11-465f-ab54-b53ab4d6f037",
                                "sense_id": "f87015e9-684e-3d0d-a491-e8a47c44a9c2",
                                "text": "„Dort tauchen die Wikingerschiffe unerwartet auf und laufen bis an den Strand, von wo aus die Krieger oft nur noch wenige Schritte zurücklegen müssen.“"
                            }
                        ],
