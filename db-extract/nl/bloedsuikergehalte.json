                        "target_lang_word": "Blutzuckerspiegel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutzuckerspiegel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53f602eb-5f87-3bc9-9cb5-da2c8c9e9d00",
                                        "entry_id": "2400c23c-af63-3530-b95d-fa49767124e7",
                                        "glosses": [
                                            "Maß für die Menge an Zucker, die sich im Blut befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "552e3791-3e2d-43a8-a72a-f080a37b5faa",
                                                "sense_id": "53f602eb-5f87-3bc9-9cb5-da2c8c9e9d00",
                                                "text": "„Bei Diabetikern ist der Blutzuckerspiegel dauerhaft erhöht.“"
                                            },
                                            {
                                                "example_id": "83282404-1551-436a-b57d-5ca6102010ab",
                                                "sense_id": "53f602eb-5f87-3bc9-9cb5-da2c8c9e9d00",
                                                "text": "„Aber intensives Denken senkt bei mir den Blutzuckerspiegel so sehr, dass ich Schokolade, Börek, Käsekuchen und Knoblauchwurst essen muss.“"
                                            },
                                            {
                                                "example_id": "3b5bc7fe-bd76-4a94-82d5-d0ccd57eeca5",
                                                "sense_id": "53f602eb-5f87-3bc9-9cb5-da2c8c9e9d00",
                                                "text": "„Da ihr Blutzuckerspiegel ungewöhnlich rasch sinke, werde sie oft schlagartig von heftigen Hungerattacken überfallen; häufig stehe sie sogar nachts auf, um ihren Kühlschrank zu plündern.“"
                                            },
                                            {
                                                "example_id": "7ec6b184-f192-4f5a-9911-0a48c6c9eaee",
                                                "sense_id": "53f602eb-5f87-3bc9-9cb5-da2c8c9e9d00",
                                                "text": "„Sinkt der Blutzuckerspiegel nach starker körperlicher Anstrengung, so kann von außen zugeführte Glucose als schnell verfügbarer Energielieferant dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
