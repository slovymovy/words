                "senses": [
                    {
                        "sense_id": "c578f9da-f576-3447-9c3f-87a6b0155d31",
                        "entry_id": "4c960cb0-24ff-37fe-b82d-7b10e00643f3",
                        "glosses": [
                            "etwas, das man tut, weil man keine bessere Möglichkeit sieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bcb204-55bd-45c2-8234-1d14745e17c6",
                                "sense_id": "c578f9da-f576-3447-9c3f-87a6b0155d31",
                                "text": "„Damit mochte zusammenhängen, daß man nirgends Anstalten zu einer gründlichen Wiederherstellung traf, sondern mit jedem Notbehelf vorlieb nahm.“"
                            },
                            {
                                "example_id": "3f401448-c745-4614-8bc0-b591ecd2623c",
                                "sense_id": "c578f9da-f576-3447-9c3f-87a6b0155d31",
                                "text": "„Die Bevölkerung wurde grosso modo mit hilflosen Ratschlägen und finanziellen Zuschüssen für Privatbunker unter dem Eigenheim abgespeist, zudem entstand hier und da ein Notbehelf in Bahnhöfen und Parkhäusern, U-Bahnschächten und Schulen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
