                "senses": [
                    {
                        "sense_id": "1be07903-9cc4-3d29-a00d-482146cd2d84",
                        "entry_id": "e84130aa-f696-39bd-848c-cc436283f7e3",
                        "glosses": [
                            "Wasser, das durch einzellige Algen oder Plankton verfärbt wird"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "a1ba0bc0-39d4-4d6d-83b8-55baf8ff99c4",
                                "sense_id": "1be07903-9cc4-3d29-a00d-482146cd2d84",
                                "text": "Wenn sich im Gartenteich zu viele Grünalgen bilden, so wird das Wasser zum Grünwasser."
                            },
                            {
                                "example_id": "1bc0ce12-8b19-4304-aa8b-b544851ae9c2",
                                "sense_id": "1be07903-9cc4-3d29-a00d-482146cd2d84",
                                "text": "„… und überhaupt, den Bernd das erste Mal im Grünwasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b618c01a-caff-3755-b417-6fa3c414a511",
                        "entry_id": "e84130aa-f696-39bd-848c-cc436283f7e3",
                        "glosses": [
                            "luftundurchsetzte „Unterströmung“"
                        ],
                        "tags": [
                            "Wasserport"
                        ],
                        "examples": [
                            {
                                "example_id": "53a68310-cc09-4d6f-872b-efa929ad787b",
                                "sense_id": "b618c01a-caff-3755-b417-6fa3c414a511",
                                "text": "„Boot aktiv mit Paddel im Grünwasser vor und zurück bewegen.“"
                            },
                            {
                                "example_id": "8d47c11c-a30c-4cfd-91ce-b9205f014e2d",
                                "sense_id": "b618c01a-caff-3755-b417-6fa3c414a511",
                                "text": "„Den Rest der Zeit brachen die Wellen am gesamten Strand mehr oder weniger auf einer Linie und waren für jemanden, der auf lang laufendes Grünwasser steht, unsurfbar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
