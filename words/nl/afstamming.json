            "senses": [
                {
                    "sense_id": "d5375f2b-6859-34f5-8695-d0e62bbad158",
                    "sense_definition": "De afkomst of genealogische lijn waaruit iemand voortkomt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "herkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar familie heeft een lange en trotse <w>afstamming</w> die teruggaat tot de middeleeuwen.",
                            "target_lang_translations": {
                                "en": "Her family has a long and proud <w>lineage</w> dating back to the Middle Ages."
                            }
                        },
                        {
                            "text": "Zij is erg trots op haar koninklijke <w>afstamming</w>.",
                            "target_lang_translations": {
                                "en": "She is very proud of her royal <w>descent</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkomst",
                        "lineage",
                        "herkomst",
                        "afstammingslijn"
                    ],
                    "common_phrases": [
                        "koninklijke afstamming",
                        "van adellijke afstamming"
                    ],
                    "target_lang_definitions": {
                        "en": "The ancestry, lineage, or genealogical line from which someone originates."
                    },
                    "translations": {
                        "en": [
                            {
