                    {
                        "sense_id": "c58a3054-a1ae-341c-9363-4da19de04a4d",
                        "entry_id": "911c925e-dc5f-3fce-9d68-b610e14ecb75",
                        "glosses": [
                            "in ongunstige zin tegenvallend, bedriegelijk"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2f60a6cd-3553-3750-ba2e-6d48efcd7170",
                        "entry_id": "911c925e-dc5f-3fce-9d68-b610e14ecb75",
                        "glosses": [
                            "niet te vertrouwen en daardoor gevaarlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf5efda-83c1-479b-bffd-58ff9d410d2f",
                                "sense_id": "2f60a6cd-3553-3750-ba2e-6d48efcd7170",
                                "text": "`Onze gasten kunnen gerust slapen in de wetenschap dat hun vertrekken duchtig worden bewaakt; zei Montebello. `Om zich toegang te verschaffen tot de bovenverdiepingen dient men te passeren tussen de hybride verschijningsvorm van de angst en het verraderlijk spinnende poesje dat voor raadselen stelt, die respectievelijk staan voor het weinig realistische zelfbeeld van de man en het wezen van de vrouw, als u het mij toestaat u te amuseren met mijn dilettantisme op het gebied van de symboliek."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d801176-a8fc-4a6c-a54f-77bd282053a9",
                        "source_entry_id": "911c925e-dc5f-3fce-9d68-b610e14ecb75",
                        "target_lang_word": "treacherous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "treacherous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Exhibiting treachery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14bff02a-5054-4091-b7b5-4a1bc8e0cb78",
                                                "sense_id": "9cf3ed98-3e79-3fe3-b818-012e3aeedb84",
                                                "text": "I see the wife misused by her husband, I see the treacherous seducer of young women, / I mark the ranklings of jealousy and unrequited love attempted to be hid […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d7078-2940-3be0-a69a-5f9a1ff7cce5",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Deceitful; inclined to betray."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                        "entry_id": "42d2b377-1f8b-35f1-bbf1-872be0e4a27a",
                                        "glosses": [
                                            "Unreliable; dangerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a46e4ff0-53cc-4afa-9c3b-67d98f4acbfb",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "a treacherous mountain trail"
                                            },
                                            {
                                                "example_id": "9753a164-d60b-49ad-aa95-00b326142e3c",
                                                "sense_id": "6c01d855-ead5-3aa9-9cb5-fe2b57e498db",
                                                "text": "[…] they stood in the region of perpetual snow, amidst the glittering, treacherous glaciers and crevasses, with vast slippery-pathed precipices yawning round."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41106a14-4102-4bc9-b46d-11193261dbfd",
                        "source_entry_id": "911c925e-dc5f-3fce-9d68-b610e14ecb75",
                        "target_lang_word": "pérfido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pérfido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                        "entry_id": "82e739d3-b2e5-3da2-82ac-b416c066932d",
                                        "glosses": [
                                            "Que falta a la fidelidad o lealtad que debe; traidor."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54c282c8-897a-4399-97fb-35328b39a7df",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "¿Pues qué diremos aun, vitoriosísimo Príncipe, sino que Dios es con vos, y en virtud vuestra e de la serenísima princesa Doña Isabel, Reina e Señora nuestra, quiere destruir e desolar la pérfida mahomética seta?"
                                            },
                                            {
                                                "example_id": "95bdfe49-fbaa-4871-bb0b-0ef4ad04ed49",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "y después viene a matarle\nla espada infiel de la maldad autora,\nal Rey y amigos pérfida y traidora."
                                            },
                                            {
                                                "example_id": "afb17fd3-246e-4d2d-9989-ff4da51042a0",
                                                "sense_id": "ca68dbd1-f4a4-3a46-98ec-ec5fe113775a",
                                                "text": "Se trataba de dar satisfacción a los judíos, pero sin soliviantar la ira de los árabes, aunque tampoco lord Balfour debía conceder demasiada importancia a los árabes, y así transparecen en el documento los pérfidos burladeros diplomáticos para escapar, llegado el caso, del compromiso."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a126a4d-34bf-435a-b2d5-4d73048becff",
                        "source_entry_id": "911c925e-dc5f-3fce-9d68-b610e14ecb75",
                        "target_lang_word": "traidor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traidor",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7a8ded11-fab8-39ef-80d2-dad30f95daf4",
                                        "entry_id": "d4f0aa82-5389-36d3-99c0-a0b22d615ac5",
                                        "glosses": [
                                            "Que traiciona o incumple con la confianza depositada en él."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b0f5eee-14f5-33ea-b249-e4ffa53f7364",
                                        "entry_id": "d4f0aa82-5389-36d3-99c0-a0b22d615ac5",
                                        "glosses": [
                                            "Que tiene reacciones o consecuencias impredecibles, inesperadas; en que no se puede confiar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d89e73e9-1315-4249-9cf7-4e0184c4de25",
                                                "sense_id": "8b0f5eee-14f5-33ea-b249-e4ffa53f7364",
                                                "text": "Cuídate de ese resfriado, que hay por ahí un virus muy traidor que termina en pulmonía."
                                            },
                                            {
                                                "example_id": "60c7d520-df10-416f-a8a8-4da73ca3e460",
                                                "sense_id": "8b0f5eee-14f5-33ea-b249-e4ffa53f7364",
                                                "text": "Cuidado, es un caballlo traidor y nunca se sabe si te va a patear."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
