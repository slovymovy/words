                        "glosses": [
                            "cecha tego, co niefrasobliwe; cecha tych, którzy są niefrasobliwi"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "5956d9d4-fd3f-45a6-9173-dde01f599ac2",
                                "sense_id": "b4e06a6e-c1cf-3234-9c17-a9a4ec6f99db",
                                "text": "Jako ekonomista jestem przeciwny nawet oddłużaniu, gdyż sprzyja to niefrasobliwości w polityce finansowej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
