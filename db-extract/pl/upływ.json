                                                "text": "memory lapse"
                                            },
                                            {
                                                "example_id": "cadadaa1-d759-43ce-b429-da7a4c7cf7ce",
                                                "sense_id": "7b406e5c-09f2-3a2b-b8c5-b7382c3f3d0d",
