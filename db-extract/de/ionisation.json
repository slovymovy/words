                        ],
                        "form": "die Ionisation"
                    },
                    {
                        "form_id": "36fb8e60-83e5-40e2-9963-dd79488db80f",
                        "entry_id": "1369bba9-041d-3287-aa69-e02e4313e91e",
                        "tags": [
                            "accusative",
