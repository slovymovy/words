                            {
                                "example_id": "cf473b00-3687-4cff-a10f-f22a01b39809",
                                "sense_id": "ea38d462-71be-368d-bf28-9b181120741a",
                                "text": "„Ersten Erkenntnissen der Polizei zufolge handelt es sich bei dem Unfallwagen um einen Ford Focus.“"
                            },
                            {
                                "example_id": "86b4d20d-8df6-428c-8b1c-bf949613a51a",
                                "sense_id": "ea38d462-71be-368d-bf28-9b181120741a",
                                "text": "„Hinter Simmern stand ein ausgebrannter Unfallwagen am Straßenrand.“"
                            },
                            {
                                "example_id": "0206faa9-7205-4d8a-908b-9e6f8f9913e6",
                                "sense_id": "ea38d462-71be-368d-bf28-9b181120741a",
                                "text": "„Die beiden Unfallwagen waren reif für die Schrottpresse.“"
                            }
                        ],
