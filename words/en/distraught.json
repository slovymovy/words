{
    "word_family": [
        "distraughtly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a163c601-6cc3-3253-b621-53c20848fefc",
                    "sense_definition": "Deeply hurt, saddened, or worried; incapacitated by extreme distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>distraught</w> mother searched everywhere for her missing child.",
                            "target_lang_translations": {
                                "nl": "De <w>radeloze</w> moeder zocht overal naar haar vermiste kind."
                            }
                        },
                        {
                            "text": "He felt <w>distraught</w> after hearing the terrible news about his job.",
                            "target_lang_translations": {
                                "nl": "Hij was <w>volledig overstuur</w> na het horen van het vreselijke nieuws over zijn baan."
                            }
                        }
                    ],
                    "synonyms": [
                        "distressed",
                        "pained",
                        "agonised"
                    ],
                    "common_phrases": [
                        "visibly distraught",
                        "utterly distraught"
                    ],
                    "target_lang_definitions": {
                        "nl": "Diep van streek, overmand door verdriet, angst of grote zorgen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "vertwijfeld",
                                "target_lang_sense_clarification": "wanhopig en radeloos"
                            },
                            {
                                "target_lang_word": "overstuur",
                                "target_lang_sense_clarification": "erg emotioneel en van streek"
                            },
                            {
                                "target_lang_word": "radeloos",
                                "target_lang_sense_clarification": "buiten zichzelf van zorgen of verdriet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68f20fb6-ca48-3c32-be25-469e6ae36c98",
                    "sense_definition": "Mentally ill or insane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old legends described the king as becoming <w>distraught</w> after the long war.",
                            "target_lang_translations": {
                                "nl": "De oude legenden beschreven dat de koning na de lange oorlog <w>krankzinnig</w> werd."
                            }
                        },
                        {
                            "text": "In the past, people often used the word <w>distraught</w> to describe someone who had lost their sanity.",
                            "target_lang_translations": {
                                "nl": "In het verleden gebruikten mensen vaak het woord <w>distraught</w> om iemand te beschrijven die het verstand had verloren."
                            }
                        }
                    ],
                    "synonyms": [
                        "insane",
                        "deranged"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Geestesziek, waanzinnig of buiten zinnen (verouderd)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krankzinnig",
                                "target_lang_sense_clarification": "het verstand kwijt"
                            },
                            {
                                "target_lang_word": "waanzinnig",
                                "target_lang_sense_clarification": "buiten zinnen, verdwaasd"
                            }
                        ]
                    }
                }
            ]
        }
