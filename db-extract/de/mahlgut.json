                "senses": [
                    {
                        "sense_id": "966b6771-401b-375a-9533-5b7ffa3eea01",
                        "entry_id": "0ef5235a-7ef2-362e-9ee4-8982745361ce",
                        "glosses": [
                            "Material, das in einer Mühle zerkleinert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c1a7040-7829-4702-9aa8-383f67e6da84",
                                "sense_id": "966b6771-401b-375a-9533-5b7ffa3eea01",
                                "text": "„Die ursprüngliche Form besteht aus zwei Mühlsteinen, die das Mahlgut zerkleinern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "605d9f79-50b7-4731-baae-02d298499f64",
                        "source_entry_id": "0ef5235a-7ef2-362e-9ee4-8982745361ce",
                        "source_sense_id": "966b6771-401b-375a-9533-5b7ffa3eea01",
                        "source_sense_description": "Material, das in einer Mühle zerkleinert wird",
                        "target_lang_word": "grist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c5bac9-7d1a-3ed4-a853-d7731701736f",
                                        "entry_id": "07ee0873-e180-31ba-a548-049247a28150",
                                        "glosses": [
                                            "Grain that is to be ground in a mill."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861bb3e9-fb69-4db3-8703-6fa62fa3c987",
                                                "sense_id": "a6c5bac9-7d1a-3ed4-a853-d7731701736f",
                                                "text": "That it will, however, cause the subscribers to wish, in their minds, for many oaths to fly about, which is a heinous crime, and to lay stratagems to try the patience of men of all sorts; to put them upon the swearing strain, in order to bring grist to their own mill, which is a crime still more enormous; and that therefore, for fear of these evil consequences, the passing of such an act is not consistent with the really extraordinary and tender conscience of a true modern politician."
                                            },
                                            {
                                                "example_id": "66a33dff-41b5-46c0-aa48-1479f1862f38",
                                                "sense_id": "a6c5bac9-7d1a-3ed4-a853-d7731701736f",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0b2290-2ed5-3c63-9ff8-59b7c860eae1",
                                        "entry_id": "07ee0873-e180-31ba-a548-049247a28150",
                                        "glosses": [
                                            "A group of bees."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30de8dba-4d36-376d-b3e6-89f0b1c910ab",
                                        "entry_id": "07ee0873-e180-31ba-a548-049247a28150",
                                        "glosses": [
                                            "Supply; provision."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6afbbee7-8eb8-444a-9358-bdc6e037546f",
                                                "sense_id": "30de8dba-4d36-376d-b3e6-89f0b1c910ab",
                                                "text": "Matter, as wise logicians say, / Cannot without a form subsist; / And form, say I, as well as they, / Must fail if matter brings no grist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a37941bc-3fd6-3918-8374-f56002c3ad68",
                                        "entry_id": "07ee0873-e180-31ba-a548-049247a28150",
                                        "glosses": [
                                            "A given size of rope, common grist being a rope three inches in circumference, with twenty yarns in each of the three strands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aa66af0-5c4b-3105-8e5c-6849a89962b6",
                                        "entry_id": "07ee0873-e180-31ba-a548-049247a28150",
                                        "glosses": [
                                            "Ellipsis of grist for the mill."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92e6e482-9f81-4c14-a2ca-9fadc3b8fcf2",
                                                "sense_id": "5aa66af0-5c4b-3105-8e5c-6849a89962b6",
                                                "text": "The judge needed a case with the potential for great emotional impact to gain media coverage for his political career. He was running for judgeship on the Nevada Supreme Court. Nicky and I were in the wrong place at the wrong time. We were available, vulnerable, and expendable for political grist."
                                            },
                                            {
                                                "example_id": "909daaf7-8063-4b78-b0a2-e47c8727839d",
                                                "sense_id": "5aa66af0-5c4b-3105-8e5c-6849a89962b6",
                                                "text": "True stories are embellished, the casts of fictional dramas stuffed with unlikely non-actors. All is grist to what [Werner] Herzog calls “ecstatic truth”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7098d4d-bb73-304f-8926-85f90942e3fe",
                                        "entry_id": "59d83307-cebe-3919-b5d8-602c53778e68",
                                        "glosses": [
                                            "To grind in a mill."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f0e3b9-c123-4a82-b50c-4567866b0c69",
                                                "sense_id": "b7098d4d-bb73-304f-8926-85f90942e3fe",
                                                "text": "[…] and another mill is erecting on the same stream near Sparrow Lake, to which a run of stones for gristing will be added."
                                            },
                                            {
                                                "example_id": "f89f0954-6d61-4832-9320-87c32a0be4cf",
                                                "sense_id": "b7098d4d-bb73-304f-8926-85f90942e3fe",
                                                "text": "[…] it cleaned out two hundred and ten bushels called screenings; the balance was sold, gristed and used for seed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
