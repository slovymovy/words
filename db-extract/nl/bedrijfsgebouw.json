                        "sense_id": "62b620a1-d319-36e4-be59-0f14ca901325",
                        "entry_id": "60815226-2de7-3515-902e-187080232b14",
                        "glosses": [
                            "gebouw waarin een bedrijf gevestigd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc43973f-536e-4f5f-a942-fedb81386198",
                                "sense_id": "62b620a1-d319-36e4-be59-0f14ca901325",
                                "text": "De opmerking van de NOS dat het niet wil dat het bedrijfsgebouw een soort Fort Knox wordt, begrijpt hij wel, maar volgens hem zit er nog wel wat tussen gastvrij zijn en je gebouw omtoveren tot een vesting."
                            },
                            {
                                "example_id": "9ef7d7fb-f47b-4039-8125-aab7c2c33d0b",
                                "sense_id": "62b620a1-d319-36e4-be59-0f14ca901325",
                                "text": "Bathily wordt in Frankrijk een held genoemd, net als de medewerker van de drukkerij waarin gisteren de twee broers Kouachi zich verschansten. Die medewerker had zich op de eerste verdieping verborgen onder een gootsteen en hield vandaar via de telefoon contact met de politie, totdat die het bedrijfsgebouw bestormde."
                            }
                        ]
                    }
