                                "target_senses": [
                                    {
                                        "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                        "entry_id": "232b2558-46c3-3e8a-9232-2008ae628309",
                                        "glosses": [
                                            "A weapon that causes fire; an incendiary weapon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1772299-ee65-441e-8c3d-d42fca5ebe99",
                                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                                "text": "A Molotov cocktail is a simple firebomb."
                                            },
                                            {
                                                "example_id": "481e4caa-a0f8-48aa-a2be-9ed75bdd39b6",
                                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                                "text": "The firebombs were small, and burst into flames when they hit the ground."
                                            },
                                            {
                                                "example_id": "0be66c70-e81f-4e4e-9d7f-e6251ae7b33d",
                                                "sense_id": "17ab56c4-bd30-3a91-98ca-a60996eb3929",
                                                "text": "As many as 100,000 Japanese people were killed and another million injured, most of them civilians, when more than 300 American B-29 bombers dropped 1,500 tons of firebombs on the Japanese capital that night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "firebomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                        "entry_id": "4e5b41d2-8704-3196-980f-2a5762a5a8f0",
                                        "glosses": [
                                            "To attack with a firebomb."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca300963-82f1-4737-a0f7-10e7386b34fd",
                                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                                "text": "The rioters firebombed the parked car."
                                            },
                                            {
                                                "example_id": "01ac98be-79f0-4b8c-b352-8f3fcf8f154a",
                                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                                "text": "A GOP office in Hillsborough, North Carolina, was firebombed over the weekend, with a swastika and the words “Nazi Republicans leave town or else” spray painted on an adjacent building, according to local officials."
                                            },
                                            {
                                                "example_id": "8ad04018-5a38-4bb1-ab86-ae91e052e24b",
                                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                                "text": "The next week when they firebombed the Satin Room, one of Chink Montagueʼs after-hours joints, Carney assumed the mobsters were embroiled in another war."
                                            },
                                            {
                                                "example_id": "46f4f5f9-36df-41eb-bd59-39dad696b402",
                                                "sense_id": "fb5965f2-c831-302c-bbed-903346cb551d",
                                                "text": "On Tuesday, a masked man used molotov cocktails to firebomb a Tesla dealership in Las Vegas before firing rounds into the burning vehicles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
