                "senses": [
                    {
                        "sense_id": "696b28fa-b089-36a8-8ce4-ea4cdb6e7ef8",
                        "entry_id": "c2583244-5b0b-3d55-89ca-81a2add2f496",
                        "glosses": [
                            "A thousand million, proposed as an alternative to the (now little used) British milliard and the (ambiguous, in the UK) US billion."
                        ],
                        "tags": [
                            "British",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3f262805-5111-48cc-8064-635baf31debb",
                                "sense_id": "696b28fa-b089-36a8-8ce4-ea4cdb6e7ef8",
                                "text": "The internationally agreed symbol for 10^6 is M and this is the initial letter of million. Would it not be logical and convenient to turn this happy accident into a principle and use G, the internationally agreed symbol for 10^9, as the initial letter of the word for 1,000,000,000? That number would thus be called a gillion. Whether the g should be hard or soft is a matter of opinion. I incline to hard because of the derivation from giga."
                            }
                        ]
                    }
                ],
