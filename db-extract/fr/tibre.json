        "fr-extract.jsonl": [
            {
                "entry_id": "acb34b5e-81f3-38d6-b3ed-b706b1cc2619",
                "word": "Tibre",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b6c7010-55d8-3690-bebf-bfe6061a6a37",
                        "entry_id": "acb34b5e-81f3-38d6-b3ed-b706b1cc2619",
                        "glosses": [
                            "Fleuve qui traverse Rome et qui se jette dans la mer Tyrrhénienne."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "4e22b43e-0682-4589-aeba-7fa549f7d55a",
                                "sense_id": "0b6c7010-55d8-3690-bebf-bfe6061a6a37",
                                "text": "En arrivant on a bien dit : Nous allons désempester les marais Pontins, rendre la campagne à l’agriculture, refréner les débordements du Tibre, lui imposer des quais, réprimer le brigandage, expulser les mendiants, etc."
                            },
                            {
                                "example_id": "b179172b-43f9-4888-aca7-806a59f29083",
                                "sense_id": "0b6c7010-55d8-3690-bebf-bfe6061a6a37",
                                "text": "Sidoine Apollinaire rapporte que les navires espagnols remontaient le Tibre et allaient porter à Rome la céraunia ou pierre à feu qui faisait alors l’objet d’un trafic important."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb939949-ce4c-3339-a8f4-f840f1f5b2a4",
                        "entry_id": "acb34b5e-81f3-38d6-b3ed-b706b1cc2619",
                        "glosses": [
                            "Dieu-fleuve de la mythologie gréco-romaine, associé à ce fleuve."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38556401-a424-4ad7-a419-86a3e4d18c50",
                        "source_entry_id": "acb34b5e-81f3-38d6-b3ed-b706b1cc2619",
                        "target_lang_word": "Tiber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07ded470-d8a4-3979-87da-d5cf742db29e",
                                        "entry_id": "8e96570c-c26b-39bc-a6e1-9fb921fe609c",
                                        "glosses": [
                                            "Fluss in Mittelitalien, der durch Rom fließt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b78d998-b88a-4244-89e2-26f58ba1c907",
                                                "sense_id": "07ded470-d8a4-3979-87da-d5cf742db29e",
                                                "text": "„Rom war als Siedlungsplatz wohl deshalb besonders attraktiv, weil es an einer Furt des Tiber lag, die wichtig war für die Verbindungen zwischen dem nördlich gelegenen Etrurien und dem südlich gelegenen Kampanien, und weil hier die Salzstraße vorbeiführte, auf der dieses schon in der Frühgeschichte wichtige Mineral von den Salzbuchten an der Tibermündung ins Landesinnere geschafft wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98ce1d20-289c-4b94-89bf-c7a02e3e8e1d",
                        "source_entry_id": "acb34b5e-81f3-38d6-b3ed-b706b1cc2619",
                        "target_lang_word": "Tiber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tiber",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d698d11c-c42c-3492-b38c-a6ba828205a7",
                                        "entry_id": "b2668d54-c43c-34a2-a664-520bd3a9254b",
                                        "glosses": [
                                            "The river that flows through Rome in Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ad5121-940a-408f-89c6-bf285701ff37",
                                                "sense_id": "d698d11c-c42c-3492-b38c-a6ba828205a7",
                                                "text": "They traversed the Tiber without remarking it; they arrived at Rome by the gate of the people, which conducts immediately to the Corso, to the largest street of the modern city; […]"
                                            }
                                        ]
                                    }
                                ]
