                "senses": [
                    {
                        "sense_id": "3988e1da-d4f4-3128-adb3-82b9da680fce",
                        "entry_id": "e3941d3e-d806-3998-a23e-7404d1fc34ae",
                        "glosses": [
                            "Aufsuchen einer Person (Klient, Kunde oder Patient) in den Räumlichkeiten, die sie bewohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "469597c2-7e18-4696-900e-936808dda99b",
                                "sense_id": "3988e1da-d4f4-3128-adb3-82b9da680fce",
                                "text": "„Es sind vor allem Allgemeinmediziner, die Hausbesuche machen, und das verstärkt in ländlicher Gegend.“"
                            },
                            {
                                "example_id": "359f3cea-ff08-4df1-8035-298d356e106e",
                                "sense_id": "3988e1da-d4f4-3128-adb3-82b9da680fce",
                                "text": "„Zwei Tage nach meinen Untersuchungen im Hospital kam Doktor Diabaté zu einem Hausbesuch ins Hotel.“"
                            },
                            {
                                "example_id": "866297ce-aeb6-4915-985b-df7ed24a5eed",
                                "sense_id": "3988e1da-d4f4-3128-adb3-82b9da680fce",
                                "text": "„Früher war er oft mit dem Auto zu Hausbesuchen zu seinen kleinen Patienten gefahren, hatte die Mutter erzählt.“"
                            },
                            {
                                "example_id": "1354e292-ce73-413b-9a4b-080b6db1db2f",
                                "sense_id": "3988e1da-d4f4-3128-adb3-82b9da680fce",
                                "text": "„Aber komm doch rein, Ólafur ist bei einem Hausbesuch und dürfte bald zurück sein, schätze ich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
