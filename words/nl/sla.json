                        },
                        {
                            "text": "Zij bestelde een <w>sla</w> met geitenkaas en walnoten als lunch.",
                            "target_lang_translations": {
                                "en": "She ordered a <w>salad</w> with goat cheese and walnuts for lunch.",
                                "ru": "Она заказала <w>салат</w> с козьим сыром и грецкими орехами на обед.",
                                "pl": "Na obiad zamówiła <w>sałatkę</w> z kozim serem i orzechami włoskimi.",
                                "de": "Sie bestellte einen <w>Salat</w> mit Ziegenkäse und Walnüssen zum Mittagessen.",
                                "fr": "Elle a commandé une <w>salade</w> au fromage de chèvre et aux noix pour le déjeuner.",
                                "it": "Ha ordinato un'<w>insalata</w> con formaggio di capra e noci per pranzo.",
                                "cs": "K obědu si objednala <w>salát</w> s kozím sýrem a vlašskými ořechy.",
                                "tr": "Öğle yemeği için keçi peynirli ve cevizli bir <w>salata</w> sipariş etti.",
                                "es": "Ella pidió una <w>ensalada</w> con queso de cabra y nueces para el almuerzo."
