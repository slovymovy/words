                ],
                "senses": [
                    {
                        "sense_id": "c93d7695-5e09-39d7-8a35-c1a9d99a0d8f",
                        "entry_id": "dd6ecb9a-a259-3393-a2c0-85189bc320af",
                        "glosses": [
                            "To illustrate (a book) with material such as images taken from other published sources, such as by clipping them out for one's own use."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cc4d91d8-2fe8-3086-be96-05979c09a780",
                        "entry_id": "dd6ecb9a-a259-3393-a2c0-85189bc320af",
                        "glosses": [
                            "To illustrate with material taken from published sources."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0b51ac5b-879a-432b-b331-df38f47f93f5",
                                "sense_id": "cc4d91d8-2fe8-3086-be96-05979c09a780",
                                "text": "He was a large, loose, fattish man with unintelligent brown eyes magnified by spectacles; he wore an ill-fitting frock-coat and a paper collar, and he showed me, as his great treasure and interest, a large Bible which he had grangerised with photographs of pictures."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a93f149-53f9-3260-b287-28923bb5bf4c",
                        "entry_id": "dd6ecb9a-a259-3393-a2c0-85189bc320af",
                        "glosses": [
                            "To remove material, especially images, from a publication."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad5d1eb9-ddc3-4040-9380-9f1da719c045",
                                "sense_id": "7a93f149-53f9-3260-b287-28923bb5bf4c",
                                "text": "In fifty cases out of a hundred, booksellers who make grangerizing a speciality find it pays far better to break up an illustrated book than to sell it intact."
                            },
                            {
                                "example_id": "f84654c4-ea7b-4ae7-9e96-0450a892646d",
                                "sense_id": "7a93f149-53f9-3260-b287-28923bb5bf4c",
                                "text": "In more recent years many finely illustrated books (such as Audubon's The Birds of America and Bartolozzi's fine engravings of Holbein's portraits), together with books of many modern artists, have been grangerized for their individual prints."
                            }
                        ]
                    }
