                "senses": [
                    {
                        "sense_id": "927f1727-111e-3a4a-b43b-28a029a8a521",
                        "entry_id": "afbf0d7d-a0ba-3849-8437-0e9944ee2742",
                        "glosses": [
                            "Engager quelque chose qu’on a soi-même reçu en gage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28af5c31-bec6-4fd6-bd1a-03a1e4e7cbc8",
                                "sense_id": "927f1727-111e-3a4a-b43b-28a029a8a521",
                                "text": "Le créancier hypothécaire peut sous-engager le gage en faisant transcrire le sous-engagement sur les registres publics."
                            },
                            {
                                "example_id": "146aa26f-12d3-4248-8a38-da63b43efa66",
                                "sense_id": "927f1727-111e-3a4a-b43b-28a029a8a521",
                                "text": "Le gagiste peut sous-engager la chose, sous sa responsabilité et sans excéder la durée de son propre droit."
                            }
                        ]
                    },
                    {
                        "sense_id": "bb969422-6c1f-3158-8676-8f57fbd12e74",
                        "entry_id": "afbf0d7d-a0ba-3849-8437-0e9944ee2742",
                        "glosses": [
                            "Engager moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "446ba576-dcac-49b0-8cb1-c01999aaac9c",
                                "sense_id": "bb969422-6c1f-3158-8676-8f57fbd12e74",
                                "text": "Ainsi, quelqu'un de très véloce pourra par exemple, sur-engager sa cale de quelques millimètres et à l'inverse, quelqu'un qui pédale en force, pourra prévenir les tendinites en sous-engageant quelque peu la cale."
                            }
                        ]
                    }
                ],
