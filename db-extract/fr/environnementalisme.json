        "fr-extract.jsonl": [
            {
                "entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                "word": "environnementalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d91258be-315b-4864-a0ad-75685770b58f",
                        "entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "tags": [
                            "plural"
                        ],
                        "form": "environnementalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32d5abeb-97ef-3051-823f-d2d80a1b1c17",
                        "entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "glosses": [
                            "Courant d’idées politique qui vise à préserver la nature de l’action humaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e78f533-a3a1-432c-a339-d4e7012179dd",
                                "sense_id": "32d5abeb-97ef-3051-823f-d2d80a1b1c17",
                                "text": "Les scientifiques explorateurs et les administrateurs des colonies — qui ont joué un rôle actif dans la naissance d’un environnementalisme moderne — étaient également les observateurs attentifs des conséquences sociales de la colonisation et des formes que prenaient l’occidentalisation du monde biologique."
                            },
                            {
                                "example_id": "b1fb89ef-4539-4566-a440-0ed059fec275",
                                "sense_id": "32d5abeb-97ef-3051-823f-d2d80a1b1c17",
                                "text": "L’environnementalisme procède ainsi d’une généalogie apolitique de l’écologie comportant ses figures telles celles du promeneur sollitaire et son panthéon de penseurs dont Jean-Jacques Rousseau, Pierre Poivre, John Muir, Henry David Thoreau, Aldo Leopold ou Arne Næss."
                            }
                        ]
                    },
                    {
                        "sense_id": "37790f6d-6d7f-3d9f-9532-4787d5ec0d10",
                        "entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "glosses": [
                            "Étude des interrelations entre l’individu et son environnement physique et social."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09a4d6da-166c-43a5-9433-11c472f0d83e",
                        "source_entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "source_sense_description": "Courant d'idées politique visant à préserver la nature",
                        "target_lang_word": "Umweltschutz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umweltschutz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f620154-f8cd-3823-b22d-77720d7b3ae4",
                                        "entry_id": "d5d4dfa7-f70f-313c-977f-d46b8c0169ee",
                                        "glosses": [
                                            "alle Maßnahmen, die dem Schutz und Erhalt des Ökosystems und Klimas der Erde dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b27ffc-9aea-443e-b38e-b287c8822665",
                                                "sense_id": "5f620154-f8cd-3823-b22d-77720d7b3ae4",
                                                "text": "Da die hochentwickelten Nationen die meisten Schadstoffe erzeugen, tragen sie auch die Hauptverantwortung für den Umweltschutz."
                                            },
                                            {
                                                "example_id": "cb70455c-21f8-4dc4-9a8e-5eb22c976526",
                                                "sense_id": "5f620154-f8cd-3823-b22d-77720d7b3ae4",
                                                "text": "„Gewiß, der Umweltschutz ist inzwischen zum Thema geworden, in Deutschland zumal, und viel geschieht, um ihm zu dienen.“"
                                            },
                                            {
                                                "example_id": "c9321718-b764-41f3-bf8b-ba55dd44de8f",
                                                "sense_id": "5f620154-f8cd-3823-b22d-77720d7b3ae4",
                                                "text": "„Umweltschutz war in der DDR kein Thema.“"
                                            },
                                            {
                                                "example_id": "8262e185-7343-48e1-a03d-259c2cca9e8e",
                                                "sense_id": "5f620154-f8cd-3823-b22d-77720d7b3ae4",
                                                "text": "„Wir alle sind Ende der achtziger Jahre für den Umweltschutz auf die Straße gegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e4a4a7-8b80-43d8-83fa-6458ff089c21",
                        "source_entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "source_sense_description": "Courant d'idées politique visant à préserver la nature",
                        "target_lang_word": "environmentalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "environmentalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5f6adb-42eb-380d-9d8a-e252abb9b8ef",
                                        "entry_id": "136bd225-6b58-3884-abe8-bbbd4017218a",
                                        "glosses": [
                                            "A theory that views environment, rather than heredity or culture, as the important factor in the development of an individual or group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "107d0919-663b-4073-87a8-02248983d0a5",
                                                "sense_id": "4d5f6adb-42eb-380d-9d8a-e252abb9b8ef",
                                                "text": "The first is that the present work in no sense represents a relapse toward the old environmentalism which believed it could find the causes of culture in environment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387bc1b8-104e-36c5-86ed-9cd4f5935051",
                                        "entry_id": "136bd225-6b58-3884-abe8-bbbd4017218a",
                                        "glosses": [
                                            "A political and social ideology that seeks to prevent the environment from degradation by human activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce004a0-6902-4355-8793-c7ac1a2c6760",
                                                "sense_id": "387bc1b8-104e-36c5-86ed-9cd4f5935051",
                                                "text": "The need for environmentalisms engaged with the commons rather than relegated to the individual consumer or tied to the middle-class principles of private property."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2292e834-dc11-41b2-95b6-85047f7df7d7",
                        "source_entry_id": "92bff753-6c79-326b-a397-f994db3bedcb",
                        "source_sense_description": "Courant d'idées politique visant à préserver la nature",
                        "target_lang_word": "ambientalismo",
