    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39df3200-a9d1-3e13-8176-d10e4b1a5346",
                    "sense_definition": "een of meer lappen in of op iets zetten om het te repareren, met name bij kleding",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repareren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je die oude broek voor me <w>lappen</w>?",
                            "target_lang_translations": {
                                "en": "Can you <w>patch</w> those old trousers for me?",
                                "ru": "Ты можешь <w>залатать</w> мне эти старые штаны?",
                                "zh": "你能帮我把那条旧裤子<w>打个补丁</w>吗？"
                            }
                        },
                        {
                            "text": "Zij <w>lapte</w> de gaten in zijn ellebogen met stukjes leer.",
                            "target_lang_translations": {
                                "en": "She <w>patched</w> the holes in his elbows with pieces of leather.",
                                "ru": "Она <w>залатала</w> дыры на его локтях кусочками кожи.",
                                "zh": "她用皮块把肘部的破洞<w>补</w>上了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kleding lappen"
                    ],
                    "target_lang_definitions": {
                        "en": "To repair something, especially clothing, by putting one or more patches on it.",
                        "ru": "Чинить что-либо, особенно одежду, накладывая одну или несколько заплат.",
                        "zh": "通过缝补布料来修复衣物或物品。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to patch",
                                "target_lang_sense_clarification": "repairing fabric with patches"
                            },
                            {
                                "target_lang_word": "to mend",
                                "target_lang_sense_clarification": "general repair of clothing"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "латать",
                                "target_lang_sense_clarification": "чинить одежду заплатами"
                            },
                            {
                                "target_lang_word": "ставить заплатки",
                                "target_lang_sense_clarification": "пришивать куски ткани для ремонта"
                            },
                            {
                                "target_lang_word": "штопать",
                                "target_lang_sense_clarification": "чинить дыры на ткани"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打补丁",
                                "target_lang_sense_clarification": "用布块修补衣物"
                            },
                            {
                                "target_lang_word": "缝补",
                                "target_lang_sense_clarification": "修补破损的衣物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b665c79-860e-34ad-a21d-6dbcb08e2122",
                    "sense_definition": "iets moeilijks voor elkaar krijgen of presteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindelijk, we hebben het dan toch <w>gelapt</w>!",
                            "target_lang_translations": {
                                "en": "Finally, we <w>pulled it off</w> after all!",
                                "ru": "Наконец-то, мы всё-таки это <w>провернули</w>!",
                                "zh": "太好了，我们终于<w>搞定</w>了！"
                            }
                        },
                        {
                            "text": "Ik wist niet of het zou lukken, maar hij heeft het weer <w>gelapt</w>.",
                            "target_lang_translations": {
                                "en": "I didn't know if it would work, but he <w>managed it</w> again.",
                                "ru": "Я не знал, получится ли, но он снова это <w>сделал</w>.",
                                "zh": "我不知道能不能行，但他又一次<w>成功</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flikken"
                    ],
                    "common_phrases": [
                        "het weer lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt met 'het'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To manage to achieve or perform something difficult, often used with 'it'.",
                        "ru": "Суметь добиться чего-то сложного или выполнить трудную задачу, часто используется с местоимением 'это'.",
                        "zh": "成功完成某项困难的任务或达成目标。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pull off",
                                "target_lang_sense_clarification": "succeeding in something difficult"
                            },
                            {
                                "target_lang_word": "to manage",
                                "target_lang_sense_clarification": "to succeed in doing something"
                            },
                            {
                                "target_lang_word": "to do it",
                                "target_lang_sense_clarification": "informal achievement"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "провернуть",
                                "target_lang_sense_clarification": "успешно сделать что-то сложное или хитрое"
                            },
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "удачно завершить дело"
                            },
                            {
                                "target_lang_word": "выкинуть номер",
                                "target_lang_sense_clarification": "сделать что-то неожиданное (разговорное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搞定",
                                "target_lang_sense_clarification": "成功处理或完成某事"
                            },
                            {
                                "target_lang_word": "成功",
                                "target_lang_sense_clarification": "达成预期的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6333a625-50ab-3625-a466-93b844ff43f8",
                    "sense_definition": "iemand een gemene streek of een poets bakken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft hun een ellendige streek <w>gelapt</w>.",
                            "target_lang_translations": {
                                "en": "He <w>played</w> a miserable trick on them.",
                                "ru": "Он <w>подстроил</w> им скверную шутку.",
                                "zh": "他<w>捉弄</w>了他们一番，真是太坏了。"
                            }
                        },
                        {
                            "text": "<w>Lap</w> me dat niet nog een keer, want dan word ik echt boos.",
                            "target_lang_translations": {
                                "en": "Don't <w>pull</w> that on me again, because then I'll get really angry.",
                                "ru": "Не <w>выкидывай</w> со мной такое больше, а то я правда разозлюсь.",
                                "zh": "别再那样<w>捉弄</w>我了，否则我会真的生气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flikken"
                    ],
                    "common_phrases": [
                        "een streek lappen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak in negatieve context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To play a mean trick or a practical joke on someone.",
                        "ru": "Сыграть с кем-то злую шутку или совершить подлый поступок.",
                        "zh": "对某人进行恶作剧或耍手段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to pull",
                                "target_lang_sense_clarification": "as in 'to pull a trick'"
                            },
                            {
                                "target_lang_word": "to play",
                                "target_lang_sense_clarification": "as in 'to play a trick'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "подстроить",
                                "target_lang_sense_clarification": "организовать неприятную ситуацию"
                            },
                            {
                                "target_lang_word": "выкинуть",
                                "target_lang_sense_clarification": "совершить (злую шутку или трюк)"
                            },
                            {
                                "target_lang_word": "отчебучить",
                                "target_lang_sense_clarification": "сделать что-то дерзкое или неприятное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捉弄",
                                "target_lang_sense_clarification": "戏弄或开玩笑"
                            },
                            {
                                "target_lang_word": "耍手段",
                                "target_lang_sense_clarification": "使用卑劣的计谋"
                            }
                        ]
                    }
