                "senses": [
                    {
                        "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                        "entry_id": "5cd4ad81-a096-3bb9-b0f0-876a35c01bbf",
                        "glosses": [
                            "Of a character: to perform a soliloquy, to talk to oneself."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e096bac3-cc7c-430c-90df-6df37700bc83",
                                "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                                "text": "\"Now, I am quite sure that our beautiful hostess has been making an assignation,\" soliloquised Charles, who, for want of something better to do, had been watching the various actions of the group in the principal chamber in the castle, […]"
                            },
                            {
                                "example_id": "df90e9ee-7e4d-44bb-9626-be16cc3ea05a",
                                "sense_id": "0b48c709-7e7e-3151-9573-9eafb081b6a6",
                                "text": "I rubbed my hands with delight over my happy notion, and soliloquised aloud, \"What a joy there is in going about doing good actions.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "89165c27-3653-3d9d-bd8a-b523f7741438",
                        "entry_id": "5cd4ad81-a096-3bb9-b0f0-876a35c01bbf",
                        "glosses": [
                            "To think to oneself."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "157f5678-907b-451b-b5c9-5189991ad8cb",
                                "sense_id": "89165c27-3653-3d9d-bd8a-b523f7741438",
                                "text": "Far up in the mountains he heard a lion roar. How much safer one was, he soliloquized, in the haunts of wild beasts than in the haunts of men."
                            }
                        ]
                    }
                ],
                "translations": [
