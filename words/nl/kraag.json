            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3444b722-32d3-3308-b980-1d0e72e96e82",
                    "sense_definition": "een omgeslagen of opstaande rand van een kledingstuk rond de halsopening",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kraag</w> van dit witte overhemd is helaas een beetje versleten.",
                            "target_lang_translations": {
                                "en": "The <w>collar</w> of this white shirt is unfortunately a bit worn out."
                            }
                        },
                        {
                            "text": "Hij zette zijn <w>kraag</w> omhoog om zijn nek tegen de koude wind te beschermen.",
                            "target_lang_translations": {
                                "en": "He turned up his <w>collar</w> to protect his neck from the cold wind."
                            }
                        }
                    ],
                    "synonyms": [
                        "boord"
                    ],
                    "common_phrases": [
                        "iemand bij de kraag vatten",
                        "de kraag omhoog zetten"
                    ],
                    "target_lang_definitions": {
                        "en": "a folded or upright edge of a garment around the neck opening"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "part of a shirt or jacket"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd43137a-0d07-36d9-977f-c3753d43fb9e",
                    "sense_definition": "een witte laag schuim bovenop een glas vers getapt bier",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vlak na het inschenken bestaat de <w>kraag</w> voor een groot deel uit gas.",
                            "target_lang_translations": {
                                "en": "Just after pouring, the <w>head</w> consists largely of gas."
                            }
                        },
                        {
                            "text": "Een goed getapt biertje moet een stevige witte <w>kraag</w> hebben.",
                            "target_lang_translations": {
                                "en": "A well-poured beer should have a firm white <w>head</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een mooie kraag"
                    ],
                    "target_lang_definitions": {
                        "en": "a white layer of foam on top of a glass of freshly poured beer"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "foam on beer"
                            },
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "layer of foam"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d13198-50b3-3319-b328-5b4e7f6d9224",
                    "sense_definition": "een opvallende rand van veren of huid rond de nek van een dier",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De mannetjesvogel heeft een prachtige <w>kraag</w> van veren om vrouwtjes te lokken.",
                            "target_lang_translations": {
                                "en": "The male bird has a beautiful <w>ruff</w> of feathers to attract females."
                            }
                        },
                        {
                            "text": "De hagedis zette zijn <w>kraag</w> op om de vijand bang te maken.",
                            "target_lang_translations": {
                                "en": "The lizard flared its <w>frill</w> to scare the enemy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a striking edge of feathers or skin around the neck of an animal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ruff",
                                "target_lang_sense_clarification": "feathers or fur around an animal's neck"
                            },
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "colored ring or skin around an animal's neck"
                            },
                            {
                                "target_lang_word": "frill",
                                "target_lang_sense_clarification": "skin around a lizard's neck"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c825f76c-b24a-36b2-8c46-e4f81c567a56",
                    "sense_definition": "een rand van ijs die zich langs de oevers van een wateroppervlak vormt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "natuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Langs de rand van de molenvijver was een dunne <w>kraag</w> van ijs ontstaan.",
                            "target_lang_translations": {
                                "en": "A thin <w>rim</w> of ice had formed along the edge of the mill pond."
                            }
                        },
                        {
                            "text": "Door de strenge vorst lag er een brede <w>kraag</w> langs de hele sloot.",
                            "target_lang_translations": {
                                "en": "Due to the severe frost, there was a wide <w>collar</w> of ice along the entire ditch."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kraag van ijs"
                    ],
                    "target_lang_definitions": {
                        "en": "an edge of ice that forms along the banks of a body of water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ice foot",
                                "target_lang_sense_clarification": "ice along a shore"
                            },
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "encircling edge of ice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbd4f8b1-958c-3deb-8a99-e8a22c2877a4",
                    "sense_definition": "een historisch, los kledingstuk dat als een brede cirkel rond de hals werd gedragen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op het oude schilderij draagt de man een grote witte <w>kraag</w> van kant.",
                            "target_lang_translations": {
                                "en": "In the old painting, the man is wearing a large white lace <w>ruff</w>."
                            }
                        },
                        {
                            "text": "In de zeventiende eeuw was een stijve <w>kraag</w> een teken van rijkdom.",
                            "target_lang_translations": {
                                "en": "In the seventeenth century, a stiff <w>collar</w> was a sign of wealth."
                            }
                        }
                    ],
                    "synonyms": [
