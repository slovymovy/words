                                        "glosses": [
                                            "kleine papegaaiachtige vogel"
                                        ],
                                        "tags": [
                                            "papegaaiachtigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f410c23e-e887-4df8-b28e-148e7c2f5225",
                                                "sense_id": "e59b8dd8-b89a-3d6e-90ff-fb400c1be4d1",
                                                "text": "De kooi van haar parkiet hangt bij het openstaande fornuis, en de laatste gloed van de kooltjes beschijnt de metalen spijlen."
                                            },
                                            {
                                                "example_id": "3e3d07d1-e754-4f12-b9f7-4bb2425ba111",
                                                "sense_id": "e59b8dd8-b89a-3d6e-90ff-fb400c1be4d1",
                                                "text": "Ze had zelf haar hutkoffer ingepakt en haar parkiet voor het eerst in een kooi gestopt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d51ba76a-9c08-4c06-8bd9-273861bdab87",
                        "source_entry_id": "e5bcbeb3-dd5f-3b56-ad39-d1aed526033f",
