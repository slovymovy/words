                    "sense_definition": "To recover health and strength gradually after sickness or weakness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient <w>convalesced</w> for six months after his stroke.",
