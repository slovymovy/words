                                            {
                                                "example_id": "4c54dd7c-68d9-46af-86c7-d5a4bd8a02be",
                                                "sense_id": "550c4952-66eb-363d-9ece-0c9005dcedf2",
                                                "text": "\"Toen gingen er wel wat alarmbelletjes rinkelen. Mijn acupuncturist, die net die week daarvoor een cursus over bloedziekten had gevolgd, raadde aan om naar de huisarts te gaan. Ze had verder niks benoemd, maar ik wist meteen: 'Dit is leukemie'. Ik wist niet veel over de ziekte en voor mij stond leukemie gelijk aan dood. Ik was ervan overtuigd dat hij hieraan zou overlijden.\""
                                            },
                                            {
                                                "example_id": "7c491f01-6311-40a1-bd3b-83fc06aac5ea",
                                                "sense_id": "550c4952-66eb-363d-9ece-0c9005dcedf2",
                                                "text": "Ongeveer 6 procent van de Nederlanders bezoekt minstens een keer per jaar een alternatief genezer, zoals een acupuncturist of homeopaat."
                                            },
                                            {
                                                "example_id": "26cb8f51-1969-4ec5-b353-07ea964af441",
                                                "sense_id": "550c4952-66eb-363d-9ece-0c9005dcedf2",
                                                "text": "De zorgverzekeraars VGZ, ONVZ, Achmea, Menzis en CZ verdienen de prijs omdat zij het publiek misleiden, zegt de vereniging. Volgens de vereniging stellen deze verzekeraars eigen opleidingsnormen op voor bijvoorbeeld acupuncturisten en homeopaten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
