                "senses": [
                    {
                        "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                        "entry_id": "96da1746-9d84-34f3-88fb-707fa8bd5276",
                        "glosses": [
                            "Aise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0fce93b-0b77-4294-8405-1e21d19fe232",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "op zijn gemakjes",
                                "translation": "à l’aise"
                            },
                            {
                                "example_id": "5cac0cab-bcbc-4ff8-8171-b450d2dffc55",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "zijn gemak (ervan) nemen",
                                "translation": "se mettre à l’aise, prendre ses aises"
                            },
                            {
                                "example_id": "8c41d571-e19f-4e05-9404-5cc4573d53df",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "met gemak",
                                "translation": "facilement"
                            },
                            {
                                "example_id": "dbaba776-8ce4-45f5-baed-06901983f326",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "op zijn gemak gaan zitten",
                                "translation": "s’installer confortablement"
                            },
                            {
                                "example_id": "a3257798-11e8-4702-8c67-caa5bafe9799",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "zich op zijn gemak voelen",
                                "translation": "se sentir à l’aise"
                            },
                            {
                                "example_id": "d7d1c99a-cd95-4ff0-a7d6-fa6fcd544d95",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "iemand op zijn gemak stellen",
                                "translation": "mettre quelqu’un à l’aise"
                            },
                            {
                                "example_id": "7402a575-625e-42b3-b389-08f25fce9370",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "op zijn (dooie) gemak",
                                "translation": "à l’aise, sans se fouler"
                            },
                            {
                                "example_id": "c15a4734-2bce-4b7a-9d10-628a9c2c3320",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "houd je gemak!",
                                "translation": "ne t’emballe pas!"
                            },
                            {
                                "example_id": "49611a11-3a78-4faf-b129-780295f01888",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "het gemak dient de mens",
                                "translation": "pourquoi se compliquer la vie?"
                            },
                            {
                                "example_id": "eec26a1f-2283-4330-a343-ac4c21a21fa9",
                                "sense_id": "e55d2c65-d2dc-3726-9bb9-3b510fc491aa",
                                "text": "hij heeft op zijn dooie gemak gewonnen",
                                "translation": "il a gagné les doigts dans le nez"
                            }
                        ]
                    }
