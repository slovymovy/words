                                        "entry_id": "71e6be28-c4d4-3973-a974-d63200e6ae1e",
                                        "glosses": [
                                            "(männliche^☆) Person, die Cello spielt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "417f2fe8-46d3-46dc-a045-062489a47ed6",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Bis Celli, Cellisten, Koffer, Kisten, Taschen in den zugeteilten Stockwerken sind, ist die Zeit gekommen, bis zu der wieder alles unten sein muss, um die Proben pünktlich zu erreichen.“"
                                            },
                                            {
                                                "example_id": "cb6356ef-9643-41a4-a8dd-e4d7b4b5bbfc",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Er war nach den mir überlieferten Berichten der Cellist im Bunde.“"
                                            },
                                            {
                                                "example_id": "c50f51d1-7d18-484e-bea4-ecd76f97b03a",
                                                "sense_id": "113dc0d0-9843-38d3-9e2c-785c3ee4f8d1",
                                                "text": "„Bei einem Straßenfest stand ich mit zwei jungen Germanistikstudentinnen und einem Cellisten aus der Nachbarschaft herum.“"
                                            }
                                        ],
