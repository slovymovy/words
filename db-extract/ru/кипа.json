                "senses": [
                    {
                        "sense_id": "584e129f-c5ab-39a1-9b5c-74c8d5c2416f",
                        "entry_id": "5b431a83-e660-3a4d-9e4f-ff0ca4bb6989",
                        "glosses": [
                            "пачка или связка предметов, сложенных один на другой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d80d50-a3da-4716-b2f1-46e22e8309ad",
                                "sense_id": "584e129f-c5ab-39a1-9b5c-74c8d5c2416f",
                                "text": "Кипа книг."
                            }
                        ]
                    },
                    {
                        "sense_id": "800b0c08-2c26-3d37-865d-19f8d0b307c4",
                        "entry_id": "5b431a83-e660-3a4d-9e4f-ff0ca4bb6989",
                        "glosses": [
                            "разг. множество (о большом количестве книг, бумаг, вещей и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ebc0077-883e-4667-9fd3-77f0c3477276",
                                "sense_id": "800b0c08-2c26-3d37-865d-19f8d0b307c4",
                                "text": "Один морпех запечатлел его на фото: кипы трупов, сгоревшие дома."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a1719bc-8750-3abc-b93e-a165636876c0",
                        "entry_id": "5b431a83-e660-3a4d-9e4f-ff0ca4bb6989",
                        "glosses": [
                            "крупная упаковочная мера товара"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "495c4849-4c60-46b1-8532-b2faa0e1bb35",
                                "sense_id": "3a1719bc-8750-3abc-b93e-a165636876c0",
                                "text": "Кипа хлопка."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e31ff97-9544-34d0-b6fb-ab502a55e36c",
                        "entry_id": "5b431a83-e660-3a4d-9e4f-ff0ca4bb6989",
                        "glosses": [
                            "устар. мера бумаги"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f51e66fd-94c2-4836-8cdb-2cf37754151c",
                                "sense_id": "3e31ff97-9544-34d0-b6fb-ab502a55e36c",
                                "text": "Кипа должна обертываться в два слоя оберточной бумаги массой бумаги площадью 1 кв.м не менее 100 г по ГОСТ 8273 или марок А и Б по ГОСТ 8273 массой бумаги площадью 1 кв.м не менее 80 г."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b40687e-c3fd-4975-99ca-8737301a1bbd",
                        "source_entry_id": "5b431a83-e660-3a4d-9e4f-ff0ca4bb6989",
                        "target_lang_word": "heap",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1d4212-0ed2-346d-a2c5-795f9d3f0c84",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A crowd; a throng; a multitude or great number of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a571ccc-cd75-48d7-994c-429445d37d93",
                                                "sense_id": "5d1d4212-0ed2-346d-a2c5-795f9d3f0c84",
                                                "text": "A Heap of Vassals, and Slaues: […] A People that is without Naturall Affection, […] A Nation without Morality, without Letters, Arts, or Sciences"
                                            },
                                            {
                                                "example_id": "0a0cfc76-b4b5-489e-9835-bcdd7058a560",
                                                "sense_id": "5d1d4212-0ed2-346d-a2c5-795f9d3f0c84",
                                                "text": "He had plenty of friends, heaps of friends in the parliamentary sense"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae31a8a-ef0f-34cd-8253-22d5e5d5da77",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A pile or mass; a collection of things laid in a body, or thrown together so as to form an elevation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855949da-7303-408e-9ec0-126097988cde",
                                                "sense_id": "0ae31a8a-ef0f-34cd-8253-22d5e5d5da77",
                                                "text": "a heap of earth; a heap of stones"
                                            },
                                            {
                                                "example_id": "6b0c1624-02e5-45c2-b36f-67fe4710c1c3",
                                                "sense_id": "0ae31a8a-ef0f-34cd-8253-22d5e5d5da77",
                                                "text": "Huge heaps of slain around the body rise."
                                            },
                                            {
                                                "example_id": "db392585-199e-45af-a4ba-165d8778c0d2",
                                                "sense_id": "0ae31a8a-ef0f-34cd-8253-22d5e5d5da77",
                                                "text": "Every break seemed dangerous and Falcao clearly had the beating of Amorebieta. Others, being forced to stretch a foot behind them to control Arda Turan's 34th-minute cross, might simply have lashed a shot on the turn; Falcao, though, twisted back on to his left foot, leaving Amorebieta in a heap, and thumped in an inevitable finish – his 12th goal in 15 European matches this season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc6a626-1f04-3c04-87ec-734d39b9778c",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A great number or large quantity of things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e958ed7-b9cb-4d68-9a6b-0c427789c6b9",
                                                "sense_id": "8cc6a626-1f04-3c04-87ec-734d39b9778c",
                                                "text": "a vast heap, both of places of scripture and quotations"
                                            },
                                            {
                                                "example_id": "9c881400-3615-4eef-9c67-870e1ed97068",
                                                "sense_id": "8cc6a626-1f04-3c04-87ec-734d39b9778c",
                                                "text": "I have noticed a heap of things in my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc7b8398-a08b-3911-8d9b-7033ea791595",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A data structure consisting of trees in which each node is greater than all its children."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ffec63-8ad8-3880-9cb1-84836eb8376b",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "Memory that is dynamically allocated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a3297c-b8e3-4329-89f4-a5ee2a730fd5",
                                                "sense_id": "10ffec63-8ad8-3880-9cb1-84836eb8376b",
                                                "text": "You should move these structures from the stack to the heap to avoid a potential stack overflow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2fb8c8a-d8d8-3f08-85f7-09a5e6a74bdd",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A dilapidated place or vehicle."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "479da8d8-58e5-423b-8899-3819c7945289",
                                                "sense_id": "a2fb8c8a-d8d8-3f08-85f7-09a5e6a74bdd",
                                                "text": "My first car was an old heap."
                                            },
                                            {
                                                "example_id": "414fa23d-8ee6-48f7-9c57-ff4faf783c71",
                                                "sense_id": "a2fb8c8a-d8d8-3f08-85f7-09a5e6a74bdd",
                                                "text": "Chuffy: It's on a knife edge at the moment, Bertie. If he can get planning permission, old Stoker's going to take this heap off my hands in return for vast amounts of oof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c85a6d8-b0ac-3256-8532-e32e7e90284c",
                                        "entry_id": "566d8bf2-691c-3715-b1ef-af7ff3eafcca",
                                        "glosses": [
                                            "A lot, a large amount"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84df7932-7e81-4959-bcf8-616b3317d9c2",
                                                "sense_id": "1c85a6d8-b0ac-3256-8532-e32e7e90284c",
                                                "text": "Thanks a heap!"
                                            },
                                            {
                                                "example_id": "7afaaa4d-f241-4ff7-bda5-1aa3b6357dc6",
                                                "sense_id": "1c85a6d8-b0ac-3256-8532-e32e7e90284c",
                                                "text": "[W]e went to the play, and Pen was struck all of a heap with Miss Fotheringay … And he’s fallen in love with her—and I’m blessed if he hasn’t proposed to her […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff9cf85-50c2-3376-a85e-828f6732e84f",
