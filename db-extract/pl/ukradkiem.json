        "pl-extract.jsonl": [
            {
                "entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                "word": "ukradkiem",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                        "entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                        "glosses": [
                            "tak, żeby nie zwrócić niczyjej uwagi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa4bc10e-6c07-442e-9d42-a7e9b7c489b5",
                                "sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                                "text": "Uczniowie ukradkiem spoglądali na zegarki."
                            },
                            {
                                "example_id": "559ab90b-41d0-4827-a13c-0956530ca829",
                                "sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                                "text": "Jego stukanie ukradkiem w telefon pod torbą było przezabawne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc3f97bb-6ad0-40ee-8be0-caadef3d5279",
                        "source_entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                        "source_sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                        "target_lang_word": "furtively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furtively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                                        "entry_id": "2a45fd33-56a9-3219-9032-6665bbd29f8a",
                                        "glosses": [
                                            "In a furtive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556c893d-16d1-416a-b3ab-8913b7f7eecd",
                                                "sense_id": "fba0a30c-8ef1-3f03-b113-65b1c69a3f5c",
                                                "text": "And furtively Time looked him in the face and edged towards him fingering with his dripping fingers the hilt of his nimble sword."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f3c1853-31c2-4de0-8e0b-6d1318ac1a5f",
                        "source_entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                        "source_sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                        "target_lang_word": "stealthily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stealthily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                        "entry_id": "78bb9ecb-388d-3e6e-8715-e6e77961026e",
                                        "glosses": [
                                            "In a stealthy manner, furtively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796ff500-915d-4a3d-be6e-a0bba09abe23",
                                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                                "text": "The dog obeyed the significant beck of his finger, and they drew off, stealthily, together."
                                            },
                                            {
                                                "example_id": "52d5ac8f-3791-483f-8436-773568419032",
                                                "sense_id": "06807067-8591-3619-a031-483a788f954b",
                                                "text": "So intent was he upon this personal appraisement of his features that he did not hear the parting of the tall grass behind him as a great body pushed itself stealthily through the jungle; nor did his companion, the ape, hear either, for he was drinking and the noise of his sucking lips and gurgles of satisfaction drowned the quiet approach of the intruder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0281f97-0fa4-40e9-84da-ff5d18a46613",
                        "source_entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                        "source_sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                        "target_lang_word": "украдкой",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "украдкой",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df88e4c7-9620-3358-8ab8-8a3a64355662",
                                        "entry_id": "231b8d7f-2802-3d0d-bfc6-09ac750246c3",
                                        "glosses": [
                                            "скрытно, стараясь не привлечь ничьего внимания"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "682ec7d0-e796-49f3-bad5-9eaf1aa5e392",
                                                "sense_id": "df88e4c7-9620-3358-8ab8-8a3a64355662",
                                                "text": "Я слушал его со вниманием и украдкой наблюдал за Ольгой."
                                            },
                                            {
                                                "example_id": "7ea68e60-8619-43e0-ab7c-aeb1d1eb135c",
                                                "sense_id": "df88e4c7-9620-3358-8ab8-8a3a64355662",
                                                "text": "Я заметил только несколько взглядов её, брошенных на меня вскользь, как бы украдкой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a96499cc-9946-44d0-bbd8-bf0dbfe97578",
                        "source_entry_id": "7355ed59-e168-39f1-99a7-d7996cd03115",
                        "source_sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                        "target_lang_word": "исподтишка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "исподтишка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d5cdbef3-fc5e-3373-8b1f-388b86ddb6ba",
                                        "entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                                        "glosses": [
                                            "разг. скрытно, незаметно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62c4fa15-b02c-4e90-9b76-d99ae6983071",
                                                "sense_id": "d5cdbef3-fc5e-3373-8b1f-388b86ddb6ba",
                                                "text": "Результат этих поступков и мыслей Эльвиры был тот, что она стала подозревать, что все знают об их совместных с Денисом Ивановичем планах и все исподтишка строят козни, чтобы не допустить воплощения этих планов в жизнь."
                                            },
                                            {
                                                "example_id": "158fd874-7cae-40c9-a910-15b721ffbbff",
                                                "sense_id": "d5cdbef3-fc5e-3373-8b1f-388b86ddb6ba",
                                                "text": "Обыкновенно Вернер исподтишка насмехался над своими больными; но я раз видел, как он плакал над умирающим солдатом…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca477406-ad8e-3ab3-b832-918d579db9ae",
                                        "entry_id": "b5208e24-ce8f-3e9f-a4d6-9fe6e71df761",
                                        "glosses": [
                                            "разг. внезапно, неожиданно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b37af5e7-33c8-4595-a3ff-a41c99ce4031",
                                                "sense_id": "ca477406-ad8e-3ab3-b832-918d579db9ae",
                                                "text": "Важно было то, что сосредоточившаяся в этих лесах, чтобы нанести удар исподтишка по советским войскам, отборная дивизия с грозным именем «Викинг» обречена на гибель."
                                            },
                                            {
                                                "example_id": "7e81b515-b1bb-4e26-91dc-a559bcb09a0f",
                                                "sense_id": "ca477406-ad8e-3ab3-b832-918d579db9ae",
                                                "text": "Такой тип может подать сигнал к отступлению и побежать первым, если жертва успешно защищается, а может и напасть исподтишка, пока Вы разбираетесь с «бойцами»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
