                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c6e170-d0de-47a0-a808-04d289df2e43",
                                                "sense_id": "7f8786c9-83c6-381a-af6f-198007633514",
                                                "text": "Shy. You that did voide your rume vpon my beard, / And foote me as you ſpurne a ſtranger curre / Ouer your threſhold, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ffc54bf-53ff-3087-a815-60b3f8a37e10",
                                        "entry_id": "14c958de-0966-353b-ad4b-7abab6f24e20",
                                        "glosses": [
                                            "Any end or boundary."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6710230f-6d77-3340-b54a-cf35eead32b8",
                                        "entry_id": "14c958de-0966-353b-ad4b-7abab6f24e20",
                                        "glosses": [
                                            "The outset of something; the point of entry, or the beginning of an action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0df73371-edbc-4046-9be8-5cfc43863cba",
                                                "sense_id": "6710230f-6d77-3340-b54a-cf35eead32b8",
                                                "text": "I arrived at last, did obeisance to my uncle, and told him everything. He thought it over and said: ' […] At the threshold of death, how dare I give you permission to go to England, to cross the seas? But I will not stand in your way. It is your mother's permission which really matters. If she permit you, then godspeed! Tell her I will not interfere. You will go with my blessings.'"
                                            },
                                            {
                                                "example_id": "b467caac-1457-4f61-beac-7ffb51243222",
                                                "sense_id": "6710230f-6d77-3340-b54a-cf35eead32b8",
                                                "text": "The first half of this century has been referred to as the golden age of medicine. To me it seems more probable that we are on the threshold of a much greater age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b7ff9e-f597-3f41-b4b7-995ef847f782",
                                        "entry_id": "14c958de-0966-353b-ad4b-7abab6f24e20",
                                        "glosses": [
                                            "The start of the landing area of a runway."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
