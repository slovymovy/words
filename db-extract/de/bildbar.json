                        "examples": [
                            {
                                "example_id": "55f0debe-960a-470b-afd5-26a5f269f5cd",
                                "sense_id": "68a6fbd1-4767-3bda-aca3-8ae59d35b9d7",
                                "text": "Diese Tonerde besitzt die erforderlichen Eigenschaften: schön weiß, leicht bildbar und im Feuer nicht flüssig."
                            },
                            {
                                "example_id": "eafc7467-fd5c-422c-b4b0-7024270777c9",
                                "sense_id": "68a6fbd1-4767-3bda-aca3-8ae59d35b9d7",
                                "text": "„Nach Ansicht Fröbels ist der Mensch ein bildbares Wesen, das zu Bewusstsein und Vernunft strebt.“"
                            }
