                ],
                "senses": [
                    {
                        "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                        "entry_id": "3be4c474-e31f-303b-a28e-cb3405448a1d",
                        "glosses": [
                            "Ort, an dem der Fluss Elbe in die Nordsee fließt"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "cbf5ce10-45fc-4ee0-a185-996b2b444f85",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Die Elbmündung besitzt eine hohe Bedeutung für die Seeschifffahrt:“ […]."
                            },
                            {
                                "example_id": "5a93bb28-0879-4582-a200-9d3e9f4fecb9",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Die Elbmündung war von offener See her früher durch fünf bis zu 45 m hohe Feuerschiffe markiert, die inzwischen durch feste Seezeichen ersetzt sind.“"
                            },
                            {
                                "example_id": "2f64e46c-2ef9-4d9e-8f1a-7236b3cfd68b",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Von der Elbmündung bis zur dänischen Grenze erstreckt sich die Nordseeküste Schleswig-Holsteins.“"
                            },
                            {
                                "example_id": "e0fd7e6b-9d99-4120-a813-1080d9264086",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "[Leuchtturm Alte Baljer:] „Trotz seiner geringen Höhe von lediglich 16 Metern bietet er einen weiten Blick über die Elbmündung.“"
                            },
                            {
                                "example_id": "42851af4-419e-489f-b428-cae0f9ad2d33",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "In der Elbmündung liegt die Insel Neuwerk, die ein Naturparadies ist."
                            },
                            {
                                "example_id": "a06f7f37-57bb-44ef-980a-68f5f7fe7c02",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Das Schiff \"Coastal Liberty\" verkehrt regelmäßig zwischen Cuxhaven und der Bohrinsel Mittelplate in der Elbmündung.“"
                            },
                            {
                                "example_id": "145b5654-e6f7-4c46-b25d-2162e80e33ba",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Beispiele für Havarien, in denen die Schiffe nicht befreit werden konnten, sind die Fides und die Ondo im Großen Vogelsand in der Elbmündung.“"
                            },
                            {
                                "example_id": "329537da-b210-4089-bff4-34e8a04eeee3",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Ein Rettungshubschrauber hat an der Elbmündung bei Neufeld in Schleswig-Holstein drei Männer vor dem Ertrinken gerettet.“"
                            },
                            {
                                "example_id": "d291b8bc-4231-4203-83e0-e2fbb3b54937",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "„Niedersachsens Pläne für ein Naturschutzgebiet an der südlichen Elbmündung“ […] „wirbeln immer mehr Staub auf.“"
                            },
                            {
                                "example_id": "ffe2c19d-b699-4881-86ec-a6e8ad942ef5",
                                "sense_id": "08772430-2f5f-35c9-ba96-97db5cccef68",
                                "text": "[Elbe:] „Mit Fortschreiten der Industrialisierung nahm aber die Wassergüte immer weiter ab und der Fischbestand ging stark zurück. Noch verbliebene Fische wurden ungenießbar, so dass, mit Ausnahme der Elbmündung, fast überall die gewerbliche Fischerei eingestellt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
