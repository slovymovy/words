                "senses": [
                    {
                        "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                        "entry_id": "41c5b1d2-5a5a-3b03-a6e6-64fc7e57d87c",
                        "glosses": [
                            "weibliche Person, die Objekte oder andere Personen verschiedenen Gruppen oder Aufgaben zuweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eaff4a6-409d-4a0a-bc1f-86cba9ee8c33",
                                "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                                "text": "„Sie ist eigentlich meistens mehr meine Betreuerin, meine Pflegerin, meine Antreiberin, meine Einteilerin.“"
                            },
                            {
                                "example_id": "39fef259-d9e2-46f5-bcaf-4cbd59b3799c",
                                "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                                "text": "„Die aktuellen Einteilerinnen und Einteiler für die einzelnen Spielklassen finden sich unter: […]“"
                            },
                            {
                                "example_id": "cf9d27d8-1ef4-49d9-ab71-ba1226fdf60c",
                                "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                                "text": "„Meine Hoffnung wird allerdings zerschmettert, als unsere Einteilerin bereits den nächsten Namen aufruft: […]“"
                            },
                            {
                                "example_id": "cffaaaf5-8dcb-4b04-987a-1dd10f514998",
                                "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                                "text": "„‚Aber die kommen doch nicht wirklich, ich wollte nur wieder einmal einigermaßen gepflegte Aquarien zu sehen bekommen!‘, sprach die Einteilerin meiner Freizeit.“"
                            },
                            {
                                "example_id": "0f3ce90b-9b8b-4b1b-a996-55ee908b9584",
                                "sense_id": "9b0ba21c-7d1a-3775-92b9-55080934394a",
                                "text": "„Als Organisatorin und Einteilerin des Reitunterrichts ist ‚Oma Ella‘ auch die Ansprechpartnerin für 70 bis 80 Kinder, die von ihren Eltern gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
