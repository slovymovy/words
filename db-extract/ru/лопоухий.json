                "senses": [
                    {
                        "sense_id": "63eb9a1b-bd11-31bd-9862-d57fe477d587",
                        "entry_id": "8d5586a9-eb40-3732-afbd-b9fb8b2bc5a7",
                        "glosses": [
                            "разг. имеющий большие и оттопыренные уши"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44440182-2a63-47b4-90dd-efef81449838",
                                "sense_id": "63eb9a1b-bd11-31bd-9862-d57fe477d587",
                                "text": "Это был человек с нелепой бородой, с копной нечесаных волос, лопоухий."
                            },
                            {
                                "example_id": "ce8312d8-85e4-4b94-ba2e-ff48e1de5f71",
                                "sense_id": "63eb9a1b-bd11-31bd-9862-d57fe477d587",
                                "text": "Неизвестно откуда возник на манеже огромный лопоухий африканский слон с веселыми, хитрыми глазками"
                            }
                        ]
                    },
