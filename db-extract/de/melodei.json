                        "sense_id": "796b6cdb-22ce-3f82-9674-e41796ea291d",
                        "entry_id": "499c2849-bd40-3cb6-b4ee-6cb2ad98fc89",
                        "glosses": [
                            "archaic form of Melodie"
                        ],
                        "tags": [
                            "alt-of",
