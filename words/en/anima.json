{
    "word_family": [
        "animate",
        "animation",
        "animator",
        "animism",
        "animist",
        "animus"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c7897b8-d86d-3170-b27a-4969d6c3abe9",
                    "sense_definition": "The soul or life force that gives life to a living being.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "soul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient philosophers often debated the nature of the <w>anima</w> within all living creatures.",
                            "target_lang_translations": {
                                "zh": "古代哲学家经常探讨所有生物体内<w>灵魂</w>的本质。"
                            }
                        },
                        {
                            "text": "The poem explores the mysterious <w>anima</w> that drives the natural world forward.",
                            "target_lang_translations": {
                                "zh": "这首诗探索了推动自然界前进的神秘<w>生命力</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soul",
                        "spirit",
                        "life force"
                    ],
                    "target_lang_definitions": {
                        "zh": "赋予生物生命的灵魂或生命力。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "灵魂",
                                "target_lang_sense_clarification": "指赋予生命的精神本质。"
                            },
                            {
                                "target_lang_word": "生命力",
                                "target_lang_sense_clarification": "指维持生命活动的内在力量。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d280413e-e9c1-3e74-90de-b9e0a4420500",
                    "sense_definition": "The inner personality or true self that is connected to the unconscious mind.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jung believed that understanding one's <w>anima</w> is essential for achieving psychological balance.",
                            "target_lang_translations": {
                                "zh": "荣格认为，理解个人的<w>内在自我</w>对于实现心理平衡至关重要。"
                            }
                        },
                        {
                            "text": "The character's journey represents a deep exploration of his own hidden <w>anima</w>.",
                            "target_lang_translations": {
                                "zh": "这个角色的旅程代表了他对自己隐藏的<w>心灵</w>的深度探索。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inner self",
                        "psyche"
                    ],
                    "antonyms": [
                        "persona"
                    ],
                    "target_lang_definitions": {
                        "zh": "与潜意识相连的内在人格或真实自我。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "内在自我",
                                "target_lang_sense_clarification": "指深层的心理自我。"
                            },
                            {
                                "target_lang_word": "心灵",
                                "target_lang_sense_clarification": "指人的精神世界或潜意识层面。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "741d5016-ca35-386b-b785-1b154830109a",
                    "sense_definition": "The unconscious feminine aspect of a person's personality in Jungian psychology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his analytical work, he described the <w>anima</w> as the feminine side of the male psyche.",
                            "target_lang_translations": {
                                "zh": "在他的分析著作中，他将<w>阿尼玛</w>描述为男性心理中女性化的一面。"
                            }
                        },
                        {
                            "text": "The artist projected his <w>anima</w> onto the figures in his paintings to express his emotions.",
                            "target_lang_translations": {
                                "zh": "这位艺术家将他的<w>阿尼玛</w>投射到画作中的人物身上，以表达他的情感。"
                            }
                        }
                    ],
                    "antonyms": [
                        "animus"
                    ],
                    "target_lang_definitions": {
                        "zh": "荣格心理学中，男性人格中潜意识的女性侧面。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阿尼玛",
                                "target_lang_sense_clarification": "荣格心理学中的专用术语，指男性潜意识中的女性原型。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}