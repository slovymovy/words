                "senses": [
                    {
                        "sense_id": "2bcb1574-7170-3784-b0c9-bc1674b8e9c3",
                        "entry_id": "f5eb7616-94d4-3e34-8988-51ad6ba45246",
                        "glosses": [
                            "to present, to make a present"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff67cdcb-9789-4019-90eb-693f765f3766",
                                "sense_id": "2bcb1574-7170-3784-b0c9-bc1674b8e9c3",
                                "text": "Он преподнёс ей кни́гу.",
                                "translation": "He presented a book to her. / He presented her with a book.",
                                "english": "He presented a book to her. / He presented her with a book."
                            },
                            {
                                "example_id": "5935cba0-721a-42fb-8f11-1a3149c0d1d9",
                                "sense_id": "2bcb1574-7170-3784-b0c9-bc1674b8e9c3",
                                "text": "преподнести́ в гото́вом ви́де что́-либо кому́-либо",
                                "translation": "to hand something to someone on a plate",
                                "english": "to hand something to someone on a plate"
                            },
                            {
                                "example_id": "440c67d7-0437-4a32-aca4-40af51b60683",
                                "sense_id": "2bcb1574-7170-3784-b0c9-bc1674b8e9c3",
                                "text": "преподнести́ сюрпри́з кому́-либо",
                                "translation": "to give someone a surprise",
                                "english": "to give someone a surprise"
                            }
                        ]
                    },
                    {
                        "sense_id": "a580927d-87f1-33ec-a609-45ffd2658c40",
                        "entry_id": "f5eb7616-94d4-3e34-8988-51ad6ba45246",
                        "glosses": [
                            "to communicate"
                        ],
                        "tags": [],
                        "examples": [
                            {
