                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45dac0d1-2eda-480a-97e2-1f1fd28dd033",
                                "sense_id": "e2e0ebca-83bb-3487-b9f9-0e7552ed9627",
                                "text": "К счастию, княгине было некогда, но она уходя говорила: «Постой, постой — я ему выпою всё добрым порядком, вымою ему голову, так, что и в бане никто ему этак не мывал!»"
                            }
                        ]
                    },
