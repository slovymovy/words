                "senses": [
                    {
                        "sense_id": "53d5bef7-203f-31f3-962c-675549975e83",
                        "entry_id": "4f271e66-24a1-347e-9759-aa2b016e71d1",
                        "glosses": [
                            "Zustand von etwas, der vom allgemeinen Typ, von der Norm abweicht, nicht charakteristisch ist"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13b5e8e2-a5c5-4ef7-ab96-091c9df942bb",
                                "sense_id": "53d5bef7-203f-31f3-962c-675549975e83",
                                "text": "„Gewöhnlich zeigt es akuten Verlauf, starke Atypie des Blutbildes, erheblich infiltrative Wucherung, meist auch Vorliebe für subperiosteale Ausbreitung.“"
                            },
                            {
                                "example_id": "2068fad0-2db4-4525-a32b-2badfe22022a",
                                "sense_id": "53d5bef7-203f-31f3-962c-675549975e83",
                                "text": "„Die Progression von der Hyperplasie bis zum Endometriumkarzinom ist vom Vorhandensein von Atypien abhängig.“"
                            },
                            {
                                "example_id": "4744126b-46af-46ae-930f-a124c3ebdfc4",
                                "sense_id": "53d5bef7-203f-31f3-962c-675549975e83",
                                "text": "„Die Atypie ist am besten am Verlust der typischen Epidermisschichtung zu erkennen.“"
                            },
                            {
                                "example_id": "bae1f0dc-0517-46bf-8eb5-4147aeed3b12",
                                "sense_id": "53d5bef7-203f-31f3-962c-675549975e83",
                                "text": "„So haben sich in einer restrospektiven Studie in 14,4% zusätzlich urotheliale Atypien gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
