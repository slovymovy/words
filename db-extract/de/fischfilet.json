                ],
                "senses": [
                    {
                        "sense_id": "a228090f-ddd5-3db2-8fcc-ce06c90ebfa2",
                        "entry_id": "c51b24aa-58ce-388a-a2a8-1a556498d384",
                        "glosses": [
                            "Filet vom Fisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664a098f-c8da-41f1-b40c-bbe5ed53a9ae",
                                "sense_id": "a228090f-ddd5-3db2-8fcc-ce06c90ebfa2",
                                "text": "Die beiden Fischfilets von einem Fisch werden, beginnend von der Rückflosse an, aus den fleischigen Seiten des Fisches herausgeschnitten."
                            },
                            {
                                "example_id": "c03fee06-10d0-4478-82a6-39df528e2b27",
                                "sense_id": "a228090f-ddd5-3db2-8fcc-ce06c90ebfa2",
                                "text": "Fachgerecht heraus geschnittene Fischfilets haben keine Gräten und wurden bereits von der Fischhaut geschnitten."
                            },
                            {
                                "example_id": "faaf8411-f550-41af-8e16-8d8c08e9f5f3",
                                "sense_id": "a228090f-ddd5-3db2-8fcc-ce06c90ebfa2",
                                "text": "„Als Fischfilet werden die ausgelösten Seitenteile von festfleischigen Fischen bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
