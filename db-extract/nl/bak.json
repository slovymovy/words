                                "sense_id": "a198b69e-3e9b-38d5-9731-da4bd37400e5",
                                "text": "Wil jij een lekkere bak koffie van me."
                            }
                        ]
                    },
                    {
                        "sense_id": "39bd0f40-1bf2-36cd-9274-153621d2a5b6",
                        "entry_id": "c405cf6a-7c0d-3e7d-b81d-2c909546c91a",
