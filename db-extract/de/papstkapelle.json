                "senses": [
                    {
                        "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                        "entry_id": "eaf352f4-fdab-3bca-9105-cd3ef059c3c1",
                        "glosses": [
                            "einzelne Kapelle oder Separee in einem Gebäude, das dem Papst geweiht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e4ded0c-7425-4dde-8273-3bf5ac6edd3b",
                                "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                                "text": "„Sancta Sanctorum (\"die Allerheiligste\") ist die Papstkapelle und ein sehr alter Rest des mittlerweile in großen Teilen zerstören antik-mittelalterlichen Papstpalastes. “"
                            },
                            {
                                "example_id": "2d005528-ad03-466e-bf2a-1d6995058fb9",
                                "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                                "text": "„Heute ist die Sixtinische Kapelle die Papstkapelle des Vatikans.“"
                            },
                            {
                                "example_id": "755828b4-9bd4-4215-8c33-6fec62033aa2",
                                "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                                "text": "„Sixtus IV. ließ die Kapelle, deren Maße von 41 mal 13 mal 21 Meter angeblich dem Tempel Salomos entsprechen, als seine Palastkapelle herrichten: Die Papstkapelle als \"neue Halle Salomos\".“"
                            },
                            {
                                "example_id": "f8ad72f1-5ec3-4800-b47b-82c5c50bf48c",
                                "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                                "text": "„Am Weg zwischen Jedenspeigen und Sierndorf liegt inmitten der Weinberge die nach Südosten ausgerichtete Papstkapelle als Mahnmal der Freien Kirche in Westeuropa.“"
                            },
                            {
                                "example_id": "89c61b6d-2cec-4330-842c-85e13af3a033",
                                "sense_id": "36e3d2eb-0e17-3e0b-841e-a8b01a152156",
                                "text": "„So ist es vor Jahren auch Dr. Ralf Lützelschwab ergangen, der in der Papstkapelle von Avignon sein Interesse an Clemens VI. entdeckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
