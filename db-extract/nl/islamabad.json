                    {
                        "translation_id": "a31e6153-21ae-428d-9e4d-809e6295e4bf",
                        "source_entry_id": "429aa8bf-408a-35a5-8e0a-0c31c99fc391",
                        "source_sense_id": "b02d068f-ec56-3963-8dff-16aaa939f030",
