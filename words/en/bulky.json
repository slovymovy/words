{
    "word_family": [
        "bulk",
        "bulkiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3e10b00e-f339-3e5b-8cd5-52aa0dfd2b82",
                    "sense_definition": "Large in size, mass, or volume, often taking up a lot of space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size_and_volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled to carry the <w>bulky</w> package up the narrow flight of stairs.",
                            "target_lang_translations": {
                                "tr": "O <w>hacimli</w> paketi dar merdivenlerden yukarı taşırken oldukça zorlandı."
                            }
                        },
                        {
                            "text": "During winter, people often wear <w>bulky</w> clothing to stay warm in the freezing temperatures.",
                            "target_lang_translations": {
                                "tr": "Kışın dondurucu havalarda ısınmak için insanlar genellikle <w>kalın ve hacimli</w> giysiler giyerler."
                            }
                        }
                    ],
                    "synonyms": [
                        "large",
                        "massive",
                        "sizeable"
                    ],
                    "antonyms": [
                        "compact",
                        "small"
                    ],
                    "common_phrases": [
                        "bulky items",
                        "bulky clothing",
                        "bulky package"
                    ],
                    "target_lang_definitions": {
                        "tr": "Boyut, kütle veya hacim bakımından büyük olan, genellikle çok yer kaplayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hacimli",
                                "target_lang_sense_clarification": "çok yer kaplayan nesneler veya giysiler için"
                            },
                            {
                                "target_lang_word": "büyük",
                                "target_lang_sense_clarification": "genel boyut olarak yer kaplayan"
                            },
                            {
                                "target_lang_word": "iri",
                                "target_lang_sense_clarification": "büyük ve yer tutan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaef20d9-c097-33c5-8c81-474b79707727",
                    "sense_definition": "Awkward to carry or manage due to its size, shape, or weight; unwieldy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size_and_volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old television was so <w>bulky</w> and awkward that it required two people to move it.",
                            "target_lang_translations": {
                                "tr": "Eski televizyon o kadar <w>hantal</w> ve biçimsizdi ki taşımak için iki kişi gerekiyordu."
                            }
                        },
                        {
                            "text": "We decided to sell the piano because it was too <w>bulky</w> for our small apartment.",
                            "target_lang_translations": {
                                "tr": "Küçük dairemiz için fazlasıyla <w>hantal</w> olduğundan piyanoyu satmaya karar verdik."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwieldy",
                        "cumbersome",
                        "clumsy"
                    ],
                    "antonyms": [
                        "manageable",
                        "handy"
                    ],
                    "common_phrases": [
                        "bulky equipment",
                        "bulky luggage"
                    ],
                    "target_lang_definitions": {
                        "tr": "Boyutu, şekli veya ağırlığı nedeniyle taşınması veya idare edilmesi zor olan; hantal."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "hantal",
                                "target_lang_sense_clarification": "taşınması veya idare edilmesi güç ve kullanışsız eşyalar için"
                            },
                            {
                                "target_lang_word": "kaba",
                                "target_lang_sense_clarification": "kullanışsız derecede büyük veya biçimsiz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5c884a8-7b57-372d-8b31-5e39f1dfa235",
                    "sense_definition": "Having a heavily built, muscular, or thick physical frame.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard had a <w>bulky</w> build that made him look very intimidating.",
                            "target_lang_translations": {
                                "tr": "Güvenlik görevlisinin, onu oldukça korkutucu gösteren <w>iri yarı</w> bir yapısı vardı."
                            }
                        },
                        {
                            "text": "After months of heavy weightlifting, his frame became noticeably more <w>bulky</w>.",
                            "target_lang_translations": {
                                "tr": "Aylar süren ağır halter antrenmanlarından sonra vücudu gözle görülür biçimde daha <w>kalıplı</w> hale geldi."
                            }
                        }
                    ],
                    "synonyms": [
                        "muscular",
                        "heavyset",
                        "burly"
                    ],
                    "antonyms": [
                        "slender",
                        "slim"
                    ],
                    "common_phrases": [
                        "bulky build",
                        "bulky frame"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ağır yapılı, kaslı veya kalın bir vücut yapısına sahip olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iri yarı",
                                "target_lang_sense_clarification": "fiziksel yapı ve cüsse için"
                            },
                            {
                                "target_lang_word": "kalıplı",
                                "target_lang_sense_clarification": "kaslı ve geniş yapılı vücutlar için"
                            },
                            {
                                "target_lang_word": "yapılı",
                                "target_lang_sense_clarification": "fiziken cüsseli ve güçlü vücut tipi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}