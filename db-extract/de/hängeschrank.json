                        "entry_id": "8b07d445-d2e3-34cf-89c0-65d32f89d865",
                        "glosses": [
                            "meist kleinerer Schrank, der dafür gedacht ist, ihn an die Wand zu hängen, statt ihn auf den Boden zu stellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bfc58ac-cd0e-41d1-8a95-747f06c401a0",
                                "sense_id": "896f8511-8144-336d-b10e-92eaa6a56e41",
                                "text": "In Hängeschränken sollte man kleinere, leichte Dinge lagern, da man sonst die schweren oder großen Sachen von oben herunter wuchten muss."
                            },
                            {
                                "example_id": "d04a478d-09cb-4dfa-8d26-875cc990934b",
                                "sense_id": "896f8511-8144-336d-b10e-92eaa6a56e41",
                                "text": "„Sie holte zwei Tassen aus dem Hängeschrank, bevor sie sich mir gegenübersetzte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
