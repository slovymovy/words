                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7da56824-b56e-48b0-b7c8-5d13ec085038",
                        "entry_id": "df9cf778-8eb0-3bb2-877a-da2dfdeb6dd8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "infranchissables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f07fb41f-68a9-379a-9b52-686f81bb9338",
                        "entry_id": "df9cf778-8eb0-3bb2-877a-da2dfdeb6dd8",
                        "glosses": [
                            "Qu’on ne peut pas franchir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1096e7f-a587-420a-8381-05628a6474c6",
                                "sense_id": "f07fb41f-68a9-379a-9b52-686f81bb9338",
                                "text": "Il fallait ne point se heurter à des obstacles naturels, tels que montagnes infranchissables, vastes étendues d’eau, qui eussent arrêté la marche des observateurs."
                            },
                            {
                                "example_id": "093b952f-9b7b-4f98-86fb-b9eb01fbc5eb",
                                "sense_id": "f07fb41f-68a9-379a-9b52-686f81bb9338",
                                "text": "L'aspect de muraille qui présente la banquise du Nord cesse à l'origine du « Nordbugt » ; […], on rencontre d'abord du brash-ice (très petits glaçons plus ou moins disséminés), puis de la glace de dérive et enfin le pack franchissable ou infranchissable."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ead5db5-4738-36d5-89fc-6b01f9369017",
                        "entry_id": "df9cf778-8eb0-3bb2-877a-da2dfdeb6dd8",
                        "glosses": [
                            "Que l'on ne doit pas franchir."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "726ac934-104e-4a8d-84f8-ade0bf329c15",
                                "sense_id": "3ead5db5-4738-36d5-89fc-6b01f9369017",
                                "text": "Le lieu des morts est un endroit dont les abornements sont rigoureux et infranchissables. […] A Frénouville, l'enclos des morts a une surface à peine inférieure à l'hectare."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ef1ac73-847e-47e5-9ae6-20a45ff960e4",
                        "source_entry_id": "df9cf778-8eb0-3bb2-877a-da2dfdeb6dd8",
                        "target_lang_word": "insurmountable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurmountable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5523255a-5cd7-3d8c-87de-13b7a83ff89b",
                                        "entry_id": "a2d409fc-e0d4-3587-8c66-6672dce00944",
                                        "glosses": [
                                            "Incapable of being passed over, surmounted, or overcome; insuperable"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5278d0ce-84d0-490d-928c-ee088515addf",
                                                "sense_id": "5523255a-5cd7-3d8c-87de-13b7a83ff89b",
                                                "text": "Getting everybody to agree proved to be an insurmountable difficulty."
                                            },
                                            {
                                                "example_id": "3f231fcb-09c8-4978-a51c-238ab9475859",
                                                "sense_id": "5523255a-5cd7-3d8c-87de-13b7a83ff89b",
                                                "text": "Overcoming Japan’s demographic crisis has proved insurmountable for occupants of the Kantei – the prime minister’s office – long before Kishida moved in last autumn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
