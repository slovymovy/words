                "senses": [
                    {
                        "sense_id": "5d610f6c-8eab-3460-8362-4211481a0467",
                        "entry_id": "2900641d-6e2c-3346-9484-f4a721284815",
                        "glosses": [
                            "Any song with French words, but more specifically a classic, lyric-driven French song."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fb6dea22-a57f-3c84-b010-11864b116965",
                        "entry_id": "2900641d-6e2c-3346-9484-f4a721284815",
