                                        "entry_id": "2d847552-a521-3b90-b843-efffa88382e4",
                                        "glosses": [
                                            "Constituting a whole together with other parts or factors; not omittable or removable"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81216383-d053-468c-afcd-16e8b346dad8",
                                                "sense_id": "72b779ba-24d5-39a0-b880-bdc7f27b60b6",
                                                "text": "Ceasing to do evil, and doing good, are the two great integral parts that complete this duty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612117be-ff5f-370d-ad2e-463cbbd81e2a",
