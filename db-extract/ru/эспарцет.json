                                "target_senses": [
                                    {
                                        "sense_id": "7c2884a7-b765-3ae7-b30c-ffda89065c3f",
                                        "entry_id": "62c1888a-90a9-3239-a0a6-51a914db9157",
                                        "glosses": [
                                            "Sainfoin."
                                        ],
                                        "tags": [
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "226120a3-9472-41ea-8080-1c71912db189",
                                                "sense_id": "7c2884a7-b765-3ae7-b30c-ffda89065c3f",
                                                "text": "Là encore, c’est en spécialiste qu’il intervient, comme en témoigne son article fort documenté sur la culture de l’esparcette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
