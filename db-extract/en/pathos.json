                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a093f6c0-62aa-41ee-9f0b-1e1105f04523",
                                                "sense_id": "5bab627e-6591-39a4-b00f-01a54e64c752",
