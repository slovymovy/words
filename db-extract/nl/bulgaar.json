                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a222282-3d3d-3335-8496-57a2842822b7",
                                        "entry_id": "1f1c4fec-c914-3b5a-8719-314e57024204",
                                        "glosses": [
                                            "A historical group of Turkic dialects, the only extant member of which is Chuvash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f4249c9-44f0-3f18-b112-3531168d5ef4",
                                        "entry_id": "1f1c4fec-c914-3b5a-8719-314e57024204",
                                        "glosses": [
                                            "Bulgarian, the South Slavic language spoken in Bulgaria."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "339852d2-a020-4010-8f6c-64e9353d703a",
                                                "sense_id": "5f4249c9-44f0-3f18-b112-3531168d5ef4",
                                                "text": "Prince Alexander of Battenberg […] was erect, gallant, and a man of good will; but he lacked tact, was unable to speak Bulgar, and was soon lost in a maze of intrigue."
                                            },
                                            {
                                                "example_id": "fbd54841-31be-4106-a747-6dbbd5da8f1f",
                                                "sense_id": "5f4249c9-44f0-3f18-b112-3531168d5ef4",
                                                "text": "In 1879 they elected as king Alexander of Battenberg, a nephew of the Tsarina and a gallant, well-meaning young man who, if he did not speak Bulgar, was sufficiently German by birth and training to be hostile to Russia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5077aac1-6370-4e00-be08-4744dc382278",
                        "source_entry_id": "8fb8560d-ee25-347e-a10d-a2055bab84b8",
                        "source_sense_id": "b3ef7ed9-151f-3564-a28c-b3270400a969",
                        "target_lang_word": "Bulgarian",
                        "target_lang_code": "en",
