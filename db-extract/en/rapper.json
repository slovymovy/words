                                    {
                                        "sense_id": "8632266b-545b-32f4-8e32-aac866810e6b",
                                        "entry_id": "f0abbbc5-e926-3fbd-b8e7-14654f1646c2",
                                        "glosses": [
                                            "onverbogen vorm van de vergrotende trap van rap"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12623ab5-6238-4298-afdf-c65273c926b0",
                                                "sense_id": "8632266b-545b-32f4-8e32-aac866810e6b",
                                                "text": "Het gaat daar wat rapper bergop dan hier in de hei, en soms wat rapper bergaf ook."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rapper",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "482f543c-ea70-34e8-b913-cfae688db67c",
                                        "entry_id": "cb63d787-55e2-3b2a-8ce0-122d12288314",
                                        "glosses": [
                                            "iemand die ritmisch teksten voordraagt op muziek, meestal hiphop"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95b53ff-95b5-42b7-8cc7-6b33f2fe7757",
                                                "sense_id": "482f543c-ea70-34e8-b913-cfae688db67c",
                                                "text": "Op het feest zijn verschillende dj's, bandjes en rappers."
                                            },
                                            {
                                                "example_id": "ff23f4f1-1fb2-4708-b75f-b8c881191d9c",
                                                "sense_id": "482f543c-ea70-34e8-b913-cfae688db67c",
                                                "text": "Het bezoek van Kanye West, ook wel bekend als Ye, aan het Witte Huis wordt hem in Hollywoodkringen niet in dank afgenomen. Verschillende sterren hebben honend gereageerd op de actie van de rapper, die een tien minuten durende speech hield in de Oval Office."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc10c20-da05-44b5-87da-d0d5535a7169",
                        "source_entry_id": "7e0593ec-20b1-3d10-b74b-36a99ddcb7b6",
                        "source_sense_description": "performer of rap music, or one who raps",
                        "target_lang_word": "rappeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rappeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                        "entry_id": "dc68923f-6907-3609-97ed-3abfda0bc201",
                                        "glosses": [
                                            "Personne qui compose, écrit ou interprète du rap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d3b911d-bfdd-4a3b-ae66-6c83ff9d29ab",
                                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                                "text": "Ils étaient dans la lignée de beaucoup de rappeurs et rappeuses qui véhiculaient des textes engagés. Parmi eux, il y avait la pionnière du rap féminin, Queen Latifah, qui créa une véritable révolution dans le monde machiste du hip-hop."
                                            },
                                            {
                                                "example_id": "d36bfe41-676c-419e-99f0-23ac983cbe0b",
                                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                                "text": "Le rappeur Kanye West est aussi un homme d’affaires avisé."
                                            },
                                            {
                                                "example_id": "0beeb5a2-1e7c-417d-821e-2711dc33135a",
                                                "sense_id": "2f3e19d5-4782-3300-950d-72db76e17c2d",
                                                "text": "— Le look rappeur, avec ses panoplies fashion, les étiquettes de marques qui dépassent et le cliquetis des bijoux autour du cou, ça fait marcher flouze et bizness. C'est pour ça qu'on préfère les rebeus habillés en dollars aux rebeues fagotées en foulard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "406e8290-f576-491b-b757-f0bf3ea002b5",
                        "source_entry_id": "7e0593ec-20b1-3d10-b74b-36a99ddcb7b6",
                        "source_sense_description": "performer of rap music, or one who raps",
                        "target_lang_word": "rappeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rappeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68c48d4f-a436-3a52-a67a-8ec797704771",
                                        "entry_id": "f15f5198-3461-3b0f-8f46-329fad41883a",
                                        "glosses": [
                                            "Celle qui s’adonne au rap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d1779e-e73d-48e0-b08b-0e37ee3ad4cb",
                                                "sense_id": "68c48d4f-a436-3a52-a67a-8ec797704771",
                                                "text": "Les seins nus, peints aux couleurs de l’Irlande, Eve, juchée sur un tonneau, entonne Let’s Play Fucking Loud, « jouons très fort » (ce qui est effectivement le cas). On dirait une rappeuse freestyle. La poétesse verte m’attire comme un aimant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7f0c9a5-c88f-4c5d-95cb-09d20bc6c948",
                        "source_entry_id": "7e0593ec-20b1-3d10-b74b-36a99ddcb7b6",
                        "source_sense_description": "performer of rap music, or one who raps",
                        "target_lang_word": "Rapper",
                        "target_lang_code": "de",
