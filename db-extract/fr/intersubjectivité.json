            {
                "entry_id": "befd865b-7f26-36d9-9f72-eba3e9d409f8",
                "word": "intersubjectivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "af18fb88-4a7b-4e85-baee-387ce94e0037",
                        "entry_id": "befd865b-7f26-36d9-9f72-eba3e9d409f8",
                        "tags": [
                            "plural"
                        ],
                        "form": "intersubjectivités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "58fcdcbf-d5d7-301e-b8db-fc4e5ae120ad",
                        "entry_id": "befd865b-7f26-36d9-9f72-eba3e9d409f8",
                        "glosses": [
                            "Reconnaissance que soi et l’autre sont des personnes distinctes avec des subjectivités distinctes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f76bda36-1ef2-4e0b-b313-3eb7ae31f9d0",
                                "sense_id": "58fcdcbf-d5d7-301e-b8db-fc4e5ae120ad",
                                "text": "Cette notion d’intersubjectivité est développée ultérieurement lors de l'étude du développement émotionnel ou affectif."
                            },
                            {
                                "example_id": "cd395b58-58b3-477a-b4a1-3e849b510c1e",
                                "sense_id": "58fcdcbf-d5d7-301e-b8db-fc4e5ae120ad",
                                "text": "Positionner l’intersubjectivité (donc la relation) comme fondement anthropologique, privilégier la coexistence, permet de repolitiser l’acte éducatif et de le « dés-économiser » (pour l’ordonner à l’avènement de sociétés postcroissance)."
                            },
                            {
                                "example_id": "abb26848-4466-47a1-b1a6-b2360ecdee74",
                                "sense_id": "58fcdcbf-d5d7-301e-b8db-fc4e5ae120ad",
                                "text": "L’intersubjectivité fonde donc l’autobiographie – l’on écrit sur soi et pour soi afin d’être lu par quelques autres – et lie intrinsèquement le récit sur soi à une demande de reconnaissance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba71ca04-9f46-49ec-a8b0-aba7c215eaa6",
                        "source_entry_id": "befd865b-7f26-36d9-9f72-eba3e9d409f8",
                        "source_sense_id": "58fcdcbf-d5d7-301e-b8db-fc4e5ae120ad",
                        "target_lang_word": "Intersubjektivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intersubjektivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                        "entry_id": "48ccb9a5-c8b4-30ee-9171-0e38e85fa08c",
                                        "glosses": [
                                            "die Eigenschaft, intersubjektiv zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59c1c8e4-52b9-48d1-8c61-b52831a636fe",
                                                "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                                "text": "„Der Begriff Intersubjektivität wird allerdings, wie auch die Begriffe Subjektivität und Objektivität, in vielen Theorien unterschiedlich verwendet und präzisiert.“"
                                            },
                                            {
                                                "example_id": "976dcd6d-d915-4e19-bd61-03c9222ac73c",
                                                "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                                "text": "Intersubjektivität bedeutet, dass Sachverhalt nicht das Werturteil eines Einzelnen ist (Subjektivität), sondern für einen allgemeinen Beobachter gleichermaßen erkennbar ist, und dennoch keine allgemeine, unbestreitbare und formal beweisbare Aussage (Objektivität) ist."
                                            },
                                            {
                                                "example_id": "0c166f58-b004-4681-b2c3-b900ba55f809",
                                                "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                                "text": "Die These, dass das Internet die Welt deutlich verändert hat, ist eine Intersubjektivität."
                                            },
                                            {
                                                "example_id": "375e62e5-265d-4cf9-aab6-0ca2b5aac6ab",
                                                "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                                "text": "„In einem damit wurde auffällig, daß die Intersubjektivität, die im Begriff der Geltung in Anspruch genommen war, ihrerseits der skeptischen Unterminierung ausgesetzt war.“"
                                            },
                                            {
                                                "example_id": "aa3e7f39-4d77-49d5-9fbb-c7747422cccf",
                                                "sense_id": "a34007cb-c8a5-34ee-80a9-ff7e909a523e",
                                                "text": "„Intersubjektivität ist der neue Schlüsselbegriff in der Psychoanalyse. Intersubjektivität, das bedeutet verknappt gesagt, dass der Mensch sich von Geburt an mit anderen Menschen verbunden fühlt und dass sich diese Verbundenheit in seiner psychischen Struktur niederschlägt. Niemand ist eine Insel. Innere und äußere Wirklichkeit sind eng miteinander verschränkt. Die Psyche selbst ist intersubjektiv verfasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
