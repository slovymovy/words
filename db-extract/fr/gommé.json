                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76fc20c9-9741-49ed-8bfb-dd480cb1d0c7",
                                "sense_id": "3ef30ab2-c046-3b25-85ca-8cb5044c4c72",
                                "text": "Réunis autour d’un alambic, ces deux héros de 17 ans, joués par Pierre Gommé et Nina Poletto, gagnent vite le cœur du spectateur dans cette comédie dont la naturel fait penser aux Beaux Gosses de Riad Sattouf."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "67a2a043-f518-3c65-af31-28e929089f00",
                "word": "gommé",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf178c49-0861-359d-9cd1-2bd6a1143344",
                        "entry_id": "67a2a043-f518-3c65-af31-28e929089f00",
                        "glosses": [
                            "Participe passé masculin singulier de gommer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "40e4a4f5-7e30-4514-a9c6-5365959fe116",
                                "sense_id": "bf178c49-0861-359d-9cd1-2bd6a1143344",
                                "text": "Le cheval tire péniblement votre famille ; hélas ! vous n’avez plus aucun amour-propre, en lui voyant les flancs rentrés, et deux os saillants aux deux côtés du ventre ; son poil est moutonné par la sueur sortie et séchée à plusieurs reprises, qui, non moins que la poussière, a gommé, collé, hirsuté le poil de sa robe."
                            }
                        ]
                    }
                ],
