                        "entry_id": "6ac1be07-b8d6-3c91-b903-abbd1d75ce01",
                        "glosses": [
                            "een geslacht Ulmus van loofbomen, met veernervige bladeren en een gezaagde of dubbelgezaagde bladrand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bf6f871-8c2a-4b04-b02c-c9f5f51a6100",
                                "sense_id": "e2c275e3-e7ff-3bb9-8870-5befcbcb95c3",
                                "text": "De Hollandse iep gedijt goed in de zeelucht van de kuststreken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfa3bc80-2ce9-4b05-b05a-350dd39d52c4",
                        "source_entry_id": "6ac1be07-b8d6-3c91-b903-abbd1d75ce01",
                        "source_sense_id": "e2c275e3-e7ff-3bb9-8870-5befcbcb95c3",
                        "source_sense_description": "een loofboomsoort uit het geslacht Ulmus ...",
                        "target_lang_word": "elm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                        "entry_id": "f2a41c35-6c00-3870-a979-6cfef1796f46",
                                        "glosses": [
                                            "A tree of the genus Ulmus of the family Ulmaceae, large deciduous trees with alternate stipulate leaves and small apetalous flowers."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b08e83c5-bb63-4dba-8256-322447ee2a84",
                                                "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                                "text": "It was not far from the house; but the ground sank into a depression there, and the ridge of it behind shut out everything except just the roof of the tallest hayrick. As one sat on the sward behind the elm, with the back turned on the rick and nothing in front but the tall elms and the oaks in the other hedge, it was quite easy to fancy it the verge of the prairie with the backwoods close by."
                                            },
                                            {
                                                "example_id": "96b41080-a69f-4f9a-bb5c-5443a92a840f",
                                                "sense_id": "c92fe955-63f2-323d-9e20-537e54690343",
                                                "text": "The village is a dignified place of thatch, half-timbering, box hedges and neat farms, set among elms (though not as many as formerly, since Dutch elm disease took its toll) on the level plain of the Pewsey Vale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b660adc1-489f-3de9-9465-c279ab907ec6",
                                        "entry_id": "f2a41c35-6c00-3870-a979-6cfef1796f46",
                                        "glosses": [
                                            "Wood from an elm tree."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11729f30-0c3d-4760-a34f-44b55cb7ed00",
                        "source_entry_id": "6ac1be07-b8d6-3c91-b903-abbd1d75ce01",
                        "source_sense_id": "e2c275e3-e7ff-3bb9-8870-5befcbcb95c3",
