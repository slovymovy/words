                ],
                "senses": [
                    {
                        "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                        "entry_id": "37fba0a2-e733-35c1-9be9-064ff36c0676",
                        "glosses": [
                            "Criard, tapageur, trop voyant."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5f89aa1d-4daa-4761-8a09-f527ca96bd0a",
                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                "text": "Un décor tape-à-l’œil."
                            },
                            {
                                "example_id": "a6c45b41-d32c-4474-b760-01bdc62b608b",
                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                "text": "C’est un peu trop tape-à-l’œil comme couleur, tu ne trouves pas ?"
                            },
                            {
                                "example_id": "b2e24481-3348-481f-ac70-24cfaab9898d",
                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                "text": "Ils s’étaient rencontrés, la plupart du temps, dans les bureaux tape-à-l’œil ou pseudo-fonctionnels des directeurs d’agence."
                            },
                            {
                                "example_id": "28b7db18-3e05-4300-85aa-908a8bb751a7",
                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                "text": "J’y vais le matin, avant la ruée des touristes qui viennent voir les bateaux tape-à-l’oeil en plastique, portant des noms idiots affichés sur la poupe en vilaines lettres d’or souvent sur fond violet qui la nuit s’illuminent aux néons."
                            },
                            {
                                "example_id": "8bfceae5-a7fb-4850-b43d-7bf439b2fdfb",
                                "sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                                "text": "Au lieu de mets tape-à-l’œil, caviar ou foie gras, les Cléry proposaient des classiques d’une simplicité déconcertante : un jambon de Parme tranché à la demande, une immense mozzarella dont on pouvait prélever une part que l’on arrosait soi-même d’huile d’olive, des artichauts à la romaine. Dominique admira cet art exemplaire du naturel et du chic."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf63ae78-1c58-4bc9-9da8-54d9676d21fe",
                        "source_entry_id": "37fba0a2-e733-35c1-9be9-064ff36c0676",
                        "source_sense_id": "be8838e5-77d0-3e9c-9a28-b9bc8a7db8f9",
                        "target_lang_word": "auffällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auffällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                        "entry_id": "a8f0374e-c422-3466-85b4-d7a05e92065d",
                                        "glosses": [
                                            "die Aufmerksamkeit auf sich ziehend; Interesse erweckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28821eb-9e7c-4db8-b699-8ae75b659039",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Die Frau war sehr auffällig und schrill gekleidet."
                                            },
                                            {
                                                "example_id": "ce774f61-ba04-44c5-ba7e-4f61e18f4112",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "Auffällig finde ich vor allem sein merkwürdiges Verhalten."
                                            },
                                            {
                                                "example_id": "3ec8342c-11a6-44bf-b134-1678ef25baab",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Bekleidet war er mit einer Baseballkappe mit auffälligem X-Emblem, einem schwarzen T-Shirt und einer schwarzen Hose, er trug einen roten Aktenkoffer.“"
                                            },
                                            {
                                                "example_id": "d87ad73a-a31a-4d93-a122-56e20aabf66d",
                                                "sense_id": "f7f26d56-1d1b-3ffb-bfa8-dad59c0fa2b7",
                                                "text": "„Während die Meeresspiegel fast unmerklich um etwa 3,4 Millimeter pro Jahr steigen, sind andere Klimakatastrophen weit aufälliger. Vor allem Hitze und Dürren nehmen zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e16593db-543a-4ac9-b827-b9473a371ca8",
                        "source_entry_id": "37fba0a2-e733-35c1-9be9-064ff36c0676",
