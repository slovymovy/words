                        "examples": [
                            {
                                "example_id": "e102a391-22b5-467d-bb71-97442dc5af76",
                                "sense_id": "2e8caf22-1d18-3a43-aa76-40e8816979a0",
                                "text": "Het belangrijkste onderdeel van de campagne was een naam vinden voor het nieuwe jeansmerk."
                            },
                            {
                                "example_id": "4dacbc04-800f-40de-8f0b-9b92818c2132",
                                "sense_id": "2e8caf22-1d18-3a43-aa76-40e8816979a0",
                                "text": "Jeansmerk Levi's heeft besloten om haar nieuwste campagne in Groot-Brittannië voorlopig niet uit te zenden. In de reclamespotjes, die al maanden geleden gemaakt zijn, zijn onder meer beelden van rellende jongeren te zien. En dat is nu even niet het beeld dat het merk wil uitdragen."
                            },
                            {
                                "example_id": "1736406a-3db9-4ad8-9938-1a85a3735862",
                                "sense_id": "2e8caf22-1d18-3a43-aa76-40e8816979a0",
                                "text": "Pharrell Williams kondigde vandaag op zijn Twitteraccount aan dat hij mede-eigenaar van het Nederlandse jeansmerk G-Star Raw is geworden. G-Star bevestigt de samenwerking en zegt dat Pharrells imago goed bij het merk past."
                            }
                        ]
