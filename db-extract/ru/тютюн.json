                "translations": [
                    {
                        "translation_id": "6e71e4de-09ab-4c2b-97b9-1b2c372f56b8",
                        "source_entry_id": "2012407b-e31b-31d5-b813-9c3fbd1ea66f",
                        "source_sense_id": "2246c6e9-8f01-3ac2-aff0-1937a08ab548",
                        "source_sense_description": "umgangssprachlich abwertend; selten: Tabak, vor allem minderer Güte; Knaster",
                        "target_lang_word": "Tabak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tabak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf46aa7-a97f-3952-ad50-9f0c8dc5153f",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "nikotinhaltige Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "a10a95c9-a930-3f09-b06a-874aa4e036a1",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "Blätter der unter [1a] beschriebenen Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "f52adb85-3961-3062-a34a-7ad292e1d343",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "Produkt zum Rauchen, das aus den getrockneten und durch Fermentieren geschmacklich veredelten unter [1b] beschriebenen Blättern hergestellt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba56d82-51a8-4b3c-a1ae-60848e53b52c",
                                                "sense_id": "f52adb85-3961-3062-a34a-7ad292e1d343",
                                                "text": "Ich brauche etwas Tabak, um meine Tabakpfeife neu zu stopfen."
                                            },
                                            {
                                                "example_id": "7e0beb7d-c2b1-4fea-8ee3-b370c56bc05f",
                                                "sense_id": "f52adb85-3961-3062-a34a-7ad292e1d343",
                                                "text": "„Das Dorf ist völlig ausgestorben, bis auf eine alte Frau, die Kingsley um Tabak bittet.“"
                                            },
                                            {
                                                "example_id": "8770bcdc-22bf-43ba-8658-bcfc4fdd4e4e",
                                                "sense_id": "f52adb85-3961-3062-a34a-7ad292e1d343",
                                                "text": "„Daraufhin ruderte ein großes Boot zu uns hinaus, und wir beluden es am selben Abend mit Tabak.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "dfecb1c9-093f-3d98-97c1-c109a3ebd2c6",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "Kurzwort für Kautabak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8db4cb2d-f9a5-48a5-9751-d8d02291a264",
                                                "sense_id": "dfecb1c9-093f-3d98-97c1-c109a3ebd2c6",
                                                "text": "Den Tabak zum Kauen, legt man sich in die Wangentasche bis er Saft lässt; gelegentlich kaut und lutscht man daran rum."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "eb8d646a-6cfa-3801-a743-238f75a7194f",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "Kurzwort für Schnupftabak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12765a62-bdf0-4cb8-973e-47df9b854c17",
                                                "sense_id": "eb8d646a-6cfa-3801-a743-238f75a7194f",
                                                "text": "Den Tabak zum Schnupfen gibt es in kleinen Dosen."
                                            },
                                            {
                                                "example_id": "e41b9432-252d-4a1c-8ac3-121c3af0ead0",
                                                "sense_id": "eb8d646a-6cfa-3801-a743-238f75a7194f",
                                                "text": "„Bei diesen Worten reichte sie mir eine Prise Tabak, nachdem sie selbst eine genommen hatte; aber es war kein Tabak.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2c\""
                                    },
                                    {
                                        "sense_id": "9934c518-e88b-3a15-9cbe-a6ce62b6c0bf",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "der den ätherischen Ölen der unter [1a] beschriebenen Pflanze charakteristische, herbe Duft"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ddb52830-f5c4-3a9f-9fe3-bd9d697a0c03",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "798d2ed6-461c-4f1e-8688-7988c622fd86",
                                                "sense_id": "ddb52830-f5c4-3a9f-9fe3-bd9d697a0c03",
                                                "text": "„Hier wollen wir Ihnen zeigen, wie Sie selbst daheim im Garten Tabak anbauen und auch ernten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e4089fc4-9cfc-3221-b925-5fb6f50db5cb",
                                        "entry_id": "88f34c1b-5d4d-32ce-871b-1971ab062f52",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "893a4618-1c49-409a-8778-8ebaf8288898",
                                                "sense_id": "e4089fc4-9cfc-3221-b925-5fb6f50db5cb",
                                                "text": "„Die Herstellung von individuellem Tabak kann der erste Schritt zu einem völlig neuen Rauchgenuss sein, denn der eigene Tabak ist frei von Zusatzstoffen, der Anbau und die Behandlung der Tabakblätter macht Spaß und der Tabakgenuss wird nicht durch hohe Steuern beeinträchtigt.“"
                                            },
                                            {
                                                "example_id": "803f34bd-bea4-4f59-9975-b6cc717770f1",
                                                "sense_id": "e4089fc4-9cfc-3221-b925-5fb6f50db5cb",
                                                "text": "„Heute zählen diese eher zu den Exoten, doch etwa zwischen 1880 und 1920 waren Tabake aus Ägypten in Europa und Amerika sehr gefragt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04fdef32-1548-4aba-a181-30d885897e84",
                        "source_entry_id": "2012407b-e31b-31d5-b813-9c3fbd1ea66f",
                        "source_sense_id": "2246c6e9-8f01-3ac2-aff0-1937a08ab548",
                        "source_sense_description": "umgangssprachlich abwertend; selten: Tabak, vor allem minderer Güte; Knaster",
                        "target_lang_word": "Knaster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knaster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af0d874d-d757-3b7e-b07b-5dbc3def0516",
                                        "entry_id": "b644ada5-30d3-3e19-bfd5-df2a9ba0c035",
                                        "glosses": [
                                            "rauchbares Produkt von geringer Qualität, das aus den getrockneten und durch Fermentieren geschmacklich veredelten nikotinhaltigen Blättern hergestellt wurde"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdbe59d8-0de7-4279-aa6f-ad0166ccd542",
                                                "sense_id": "af0d874d-d757-3b7e-b07b-5dbc3def0516",
                                                "text": "Heute habe ich vom örtlichen Tabakladen Knaster bekommen."
                                            },
                                            {
                                                "example_id": "4084e91d-15c4-492e-a857-7fb896b56396",
                                                "sense_id": "af0d874d-d757-3b7e-b07b-5dbc3def0516",
                                                "text": "„Ein Soldat, wohl ein Urlauber, saß mit ihr im Abteil und rauchte stinkenden Knaster.“"
                                            },
                                            {
                                                "example_id": "8bfc5b25-7202-40cd-8e01-91d64670034b",
                                                "sense_id": "af0d874d-d757-3b7e-b07b-5dbc3def0516",
                                                "text": "„Der würzige Geruch des billigen Knasters trifft mich und zaubert ein Bild hervor: ein einfaches Leben, ohne Probleme, mit einem braven Beruf, einer braven Frau, braven Kindern, einem braven Abdienen der Existenz und einem braven Tod – alles als selbstverständlich hingenommen, Tag, Feierabend und Nacht, ohne Frage, was dahinter sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1dd0865-33b9-3f56-8cfb-ec289bd8375e",
                                        "entry_id": "b644ada5-30d3-3e19-bfd5-df2a9ba0c035",
                                        "glosses": [
                                            "verdrießlicher Mann"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c21ae1-c105-4230-9437-52ef2063c316",
                                                "sense_id": "d1dd0865-33b9-3f56-8cfb-ec289bd8375e",
                                                "text": "Unser Nachbar ist ein richtiger Knaster."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
