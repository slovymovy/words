                                    {
                                        "sense_id": "89064c98-76b2-3dec-9456-db0416f4a157",
                                        "entry_id": "4fbedc7f-525d-3a71-bac7-2a5b194ddc5c",
                                        "glosses": [
                                            "Qui a la forme d’un cylindre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b89b6f35-f4e7-42fd-aaf3-5df7d8859f66",
                                                "sense_id": "89064c98-76b2-3dec-9456-db0416f4a157",
                                                "text": "Il est évident que les hautes pressions énervent plus le chiffon, amènent un plus fort déchet au moment du vidage de la lessive, et occasionnent des détériorations parfois graves dans les lessiveurs cylindriques."
                                            },
                                            {
                                                "example_id": "6d57830f-07a8-4034-9baf-13978f286434",
                                                "sense_id": "89064c98-76b2-3dec-9456-db0416f4a157",
                                                "text": "Le calorifère consiste en un fourneau cylindrique a en fonte ayant 3m,30 de hauteur et 0m,50 de diamètre."
                                            },
                                            {
                                                "example_id": "57f7c2e1-bab7-4376-b6d1-64329494c645",
                                                "sense_id": "89064c98-76b2-3dec-9456-db0416f4a157",
                                                "text": "On en conclut que les vitesses des divers grains de plomb ont été plus différentes avec le canon choke qu'avec le canon cylindrique."
                                            },
                                            {
                                                "example_id": "74fde90c-d31e-4ec7-9b3c-6d93035e6de6",
                                                "sense_id": "89064c98-76b2-3dec-9456-db0416f4a157",
                                                "text": "Nous sommes auprès du gigantesque anneau du synchrophasotron de l’Institut unifié des recherches nucléaires à Doubno. L’électroaimant de ce géant, qui occupe un immense édifice cylindrique rappelant un cirque, pèse 36.000 tonnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
