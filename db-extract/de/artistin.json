                                        "sense_id": "60aa5413-e593-327f-a3f8-3f7b9ddc3563",
                                        "entry_id": "c5e46f72-4e66-3820-950e-ecf46f4e63a6",
                                        "glosses": [
                                            "A public performer, especially of song or dance."
                                        ],
                                        "tags": [],
