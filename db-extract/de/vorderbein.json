                "senses": [
                    {
                        "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                        "entry_id": "6b02b299-c58d-3544-8f91-11407f0d9222",
                        "glosses": [
                            "bei Tieren mit vier oder mehr Beinen eine der vorderen Gliedmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "004d2097-b443-4bdc-9192-2895a769028a",
                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                "text": "Der Hund hat eine Verletzung am Hinterbein."
                            },
                            {
                                "example_id": "275bdb20-8d7f-4144-8582-913a6c0d2946",
                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                "text": "„Der Wolf warf ihr nur einen flüchtigen Seitenblick zu, und statt zuzufassen, wie sie es sonst immer tat, hob Milka plötzlich die Rute in die Höhe und stemmte die Vorderbeine gegen den Boden.“"
                            },
                            {
                                "example_id": "2bb2d265-3273-4984-a203-b2dd4ee60600",
                                "sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                                "text": "„Darauf löste er das Tau von den Vorderbeinen des Pferdes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf4d5f78-d5de-44aa-aa3e-1385ebcd9b1a",
                        "source_entry_id": "6b02b299-c58d-3544-8f91-11407f0d9222",
                        "source_sense_id": "360a57d7-815a-3d49-a2b4-67fa32dc9c87",
                        "source_sense_description": "bei Tieren mit vier oder mehr Beinen eine der vorderen Gliedmaßen",
                        "target_lang_word": "antérieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antérieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2a27ed16-42ee-3fd5-ba69-34f2f88da45e",
                                        "entry_id": "c5357428-58a2-3d9d-8f05-915b01a9f95b",
                                        "glosses": [
                                            "Patte avant d'un animal."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7319e463-3f18-4a76-b697-9835cf277e24",
                                                "sense_id": "2a27ed16-42ee-3fd5-ba69-34f2f88da45e",
                                                "text": "À peine les deux antérieurs avaient-ils quitté la terre, que le poney, allégé d’autant, accentuait son effort. Déséquilibré, le rouan retombait gauchement sur ses quatre membres, et se laissait traîner quelques pas en titubant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antérieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21e76d6b-3f23-331d-a0fe-304523ab2775",
                                        "entry_id": "3074883d-0d06-369c-8ca6-29db935062ec",
                                        "glosses": [
                                            "Qui est avant, qui précède dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd4c1866-7d28-4bba-b9eb-94b7b39b7a50",
                                                "sense_id": "21e76d6b-3f23-331d-a0fe-304523ab2775",
                                                "text": "Une époque antérieure. Un fait antérieur. Une découverte antérieure. Ce contrat est antérieur à l’autre. Ma dette est antérieure à la sienne."
                                            },
                                            {
                                                "example_id": "72c9a634-b8d3-4782-9c6c-e15af6b5ef2a",
                                                "sense_id": "21e76d6b-3f23-331d-a0fe-304523ab2775",
                                                "text": "Je dois être colloqué le premier en ordre, car je suis antérieur en hypothèque."
                                            },
                                            {
                                                "example_id": "6e197337-97a7-4186-91a5-8e589f360eb8",
                                                "sense_id": "21e76d6b-3f23-331d-a0fe-304523ab2775",
                                                "text": "L’événement dont je parle est antérieur à celui dont vous parlez ; il lui est antérieur de plus de six mois, d’un an, de plus d’une année."
                                            },
                                            {
                                                "example_id": "10f86406-bb50-4a86-8d74-92d633d745b3",
                                                "sense_id": "21e76d6b-3f23-331d-a0fe-304523ab2775",
                                                "text": "Comme d’autres publications antérieures, celle-ci indique que les garçons ayant été exposés in utero à des taux élevés de bisphénol A ont un risque accru de développer un syndrome autistique, mais les chercheurs sont cette fois parvenus à mettre en lumière un mécanisme biologique susceptible d’élucider l’un des modes d’action du BPA sur le cerveau en développement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ad2f79-c0f4-3ceb-a482-121ba8c0f3d4",
                                        "entry_id": "3074883d-0d06-369c-8ca6-29db935062ec",
                                        "glosses": [
                                            "Qui est avant, qui précède, par rapport au lieu, dans l’espace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588fcad2-4ba1-4261-a5f5-daab3320ead7",
                                                "sense_id": "a8ad2f79-c0f4-3ceb-a482-121ba8c0f3d4",
                                                "text": "Mrs. Paulina Barnett causait de ces choses dans sa propre chambre, dont la fenêtre s’ouvrait sur la partie antérieure de l’enceinte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57de7c86-571e-3a96-81de-e921d921bded",
                                        "entry_id": "3074883d-0d06-369c-8ca6-29db935062ec",
                                        "glosses": [
                                            "Prononcé avec la langue avancée dans la bouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39d694f-b367-4407-aafa-d3e1621d9c7b",
                                                "sense_id": "57de7c86-571e-3a96-81de-e921d921bded",
                                                "text": "Le a antérieur se prononce \\a\\ comme dans « rate » \\ʁat\\."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
