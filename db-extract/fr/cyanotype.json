                        "source_entry_id": "aeedddcf-0309-3249-919a-02842c259762",
                        "target_lang_word": "blueprint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blueprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59e6ba49-f360-3dfe-9e7e-fb080ac13638",
                                        "entry_id": "6b2e18eb-b968-3e1d-a731-38d2508668ab",
                                        "glosses": [
                                            "A type of paper-based reproduction process producing white-on-blue images by means of a photosensitive ferric compound, used primarily for technical and architecture's drawings, now largely replaced by other technologies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4b62046-e4bd-3954-ae2b-65509e115542",
                                        "entry_id": "6b2e18eb-b968-3e1d-a731-38d2508668ab",
                                        "glosses": [
                                            "A print produced with this process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe551fc0-5e59-3790-bf84-35ace69fcf1b",
                                        "entry_id": "6b2e18eb-b968-3e1d-a731-38d2508668ab",
                                        "glosses": [
                                            "A detailed technical drawing (now often in some electronically storable and transmissible form)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "692064fb-9bb2-3a23-89aa-98b102496c3e",
                                        "entry_id": "6b2e18eb-b968-3e1d-a731-38d2508668ab",
                                        "glosses": [
                                            "Any detailed plan, whether literal or figurative."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42bd2301-e90d-4a26-838e-0df2eb3e20e4",
                                                "sense_id": "692064fb-9bb2-3a23-89aa-98b102496c3e",
                                                "text": "Ain't got no blueprint, just a purpose and a wrecking ball!"
                                            },
                                            {
                                                "example_id": "748d35a6-6bfe-457a-b208-604de00a6951",
                                                "sense_id": "692064fb-9bb2-3a23-89aa-98b102496c3e",
                                                "text": "This demonstrated serious intent, and the result is a report that should be a blueprint for subsequent assessments when road schemes are being put forward."
                                            },
                                            {
                                                "example_id": "1dec7639-88c2-4e8b-bd54-dba72ed0ea5a",
                                                "sense_id": "692064fb-9bb2-3a23-89aa-98b102496c3e",
                                                "text": "As a member of Black Sabbath, he helped draft the blueprints for heavy metal, but in conversation, he was always humble about his contributions to music."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blueprint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88dae20b-a5c2-3026-9bb6-52fb8de5f24a",
                                        "entry_id": "40d80122-cf17-38e2-b213-dc9b3a224fe6",
                                        "glosses": [
                                            "To make a blueprint for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f1fec3-f51c-4499-97d3-c0ab55c6a602",
                                                "sense_id": "88dae20b-a5c2-3026-9bb6-52fb8de5f24a",
                                                "text": "The architect blueprinted the renovation plan once the client had signed off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d922989b-c90a-3d17-99ff-ca7c010c9340",
                                        "entry_id": "40d80122-cf17-38e2-b213-dc9b3a224fe6",
                                        "glosses": [
                                            "To make a detailed operational plan for; to design or plan out."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ecdabfc-91cf-469a-92f2-2c234d42cd49",
                                                "sense_id": "d922989b-c90a-3d17-99ff-ca7c010c9340",
                                                "text": "They blueprinted every aspect of the first phase of the operation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
