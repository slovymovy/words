                "senses": [
                    {
                        "sense_id": "12886657-fcd1-311c-976f-bca24473fd34",
                        "entry_id": "7bd09dc3-6277-3c29-ac85-1ace4cf08a44",
                        "glosses": [
                            "abgeteilter Bereich in einem größeren Gotteshaus oder sonstigen Gebäude, der für Gottesdienste an Werktagen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27afa8ce-bda7-4cb9-a7a4-c1fd9b7c630a",
                                "sense_id": "12886657-fcd1-311c-976f-bca24473fd34",
                                "text": "„Die rechte mittlere Kapelle dient als Werktagskapelle.“"
                            },
                            {
                                "example_id": "1f78d8be-2120-4ffd-9cf5-ea505dc9cb40",
                                "sense_id": "12886657-fcd1-311c-976f-bca24473fd34",
                                "text": "„Auch in Hachen sind die Gottesdienstbesuche rückläufig, vor allem an den Werktagen. Im Zuge der Kirchenrenovierung 2006 ist im hinteren Bereich links vom Turm eine Werktagskapelle geschaffen worden.“"
                            },
                            {
                                "example_id": "c8726885-dc43-4af3-90ca-e868d0fb6b46",
                                "sense_id": "12886657-fcd1-311c-976f-bca24473fd34",
                                "text": "„Zu Ehren des Hl. Papstes Johannes Paul II. konnten wir gestern (29.4.2014) die neue Werktagskapelle in der Hl. Kreuzkirche, GLA-Butendorf segnen und Ihrer Bestimmung übergeben.“"
                            },
                            {
                                "example_id": "38969799-dfa9-43b3-a858-484a5775d4cb",
                                "sense_id": "12886657-fcd1-311c-976f-bca24473fd34",
                                "text": "„Die Nutzung der heutigen Werktagkapelle ist seit ihrer Erbauung im 19.Jhdt. mehrfach den sich ändernden Anforderungen angepaßt worden. So diente sie als ‚Taufkapelle‘; aus dem Erleben der Weltkriege als ‚Kriegerkapelle‘ und nach der letzten Renovierung als ‚Werktagskapelle‘ für den Gottesdienst in der Woche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9852f1e-6666-3211-84f1-0a50ea618cab",
                        "entry_id": "7bd09dc3-6277-3c29-ac85-1ace4cf08a44",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das zur werktäglichen Andacht bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9fd649-3669-48f6-bd5a-7c1f92218a88",
                                "sense_id": "f9852f1e-6666-3211-84f1-0a50ea618cab",
                                "text": "„Die Nutzung der heutigen Werktagkapelle ist seit ihrer Erbauung im 19.Jhdt. mehrfach den sich ändernden Anforderungen angepaßt worden. So diente sie als ‚Taufkapelle‘; aus dem Erleben der Weltkriege als ‚Kriegerkapelle‘ und nach der letzten Renovierung als ‚Werktagskapelle‘ für den Gottesdienst in der Woche.“"
                            },
                            {
                                "example_id": "37a9fdb1-0a26-4bbe-8a7d-615b209026c3",
                                "sense_id": "f9852f1e-6666-3211-84f1-0a50ea618cab",
                                "text": "„Gottesdienste mit kleineren Gruppen werden heute noch im Chor der alten Kirche (jetzt Werktagskapelle) gefeiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
