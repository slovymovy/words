                                    {
                                        "sense_id": "d28caffd-b6ac-39f8-9f73-37f94382dcd6",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "One who, or that which, shifts or changes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cd448a4-153c-3a06-8b5e-f6c862f22145",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A word whose meaning changes depending on the situation, as by deixis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9876d733-5fbb-41a9-9a38-75ed6ff86a5f",
                                                "sense_id": "9cd448a4-153c-3a06-8b5e-f6c862f22145",
                                                "text": "The cigarette is analogous to what linguists call a shifter, like the word I ; this device for expressing the irreducible particularity of my innermost self is universally available to every speaker and is thus the least particular thing in the world. The smoker manipulates the cigarette, like the word I, to tell stories to him/herself about him/herself — or to an other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "871472a7-f843-39e0-940f-0e1a91981a71",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "Someone who plays tricks; a trickster."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ca90011-afd6-4280-81ed-13373f6f038d",
                                                "sense_id": "871472a7-f843-39e0-940f-0e1a91981a71",
                                                "text": "'Twas ſuch a ſhifter, that if truth were known, / Death was half glad when he had got him down;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44f2b6d0-a526-3dea-a5de-91bc94ffeb89",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "An assistant to the ship's cook in washing, soaking, and shifting the salt provisions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aa1cd70-b19f-33ae-a6d4-4fc3abbb384e",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A control device (usually a lever or button) for shifting gears in a gearbox, or an arrangement for shifting a belt sidewise from one pulley to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70e932a9-6928-35b3-98da-094764edf5d7",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A wire for changing a loop from one needle to another, as in narrowing, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d7ff052-a45c-30e3-ba84-fe2181c76dfc",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A component used by the rider to control the gearing mechanisms and select the desired gear ratio, usually connected to the derailleur by a mechanical actuation cable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f8f2b08-f828-317e-827f-81603ab4a102",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A spanner with an adjustable jaw size."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c90f1def-ef7d-3b06-9566-b54c82f32727",
                                        "entry_id": "617d9da2-eaec-3bb5-8373-3aa97540047b",
                                        "glosses": [
                                            "A person employed to repair the horseways and other passages, and keep them unobstructed."
