                                "target_lang_word": "运气",
                                "target_lang_sense_clarification": "指好运"
                            },
                            {
                                "target_lang_word": "妙招",
                                "target_lang_sense_clarification": "指天才的举动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77ccc473-b55b-3a3a-a152-63fb49432bc6",
                    "sense_definition": "The sound made by a clock striking the hour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They arrived on the <w>stroke</w> of midnight.",
                            "target_lang_translations": {
                                "ru": "Они прибыли с <w>боем</w> часов в полночь.",
                                "zh": "他们在午夜十二点整<w>钟声</w>敲响时到达。"
                            }
                        },
                        {
                            "text": "At the first <w>stroke</w>, the celebration began.",
                            "target_lang_translations": {
                                "ru": "С первым <w>ударом</w> началось празднование.",
                                "zh": "随着第一声<w>钟响</w>，庆祝活动开始了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "on the stroke of",
                        "at the stroke of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук, издаваемый часами, когда они отбивают время.",
                        "zh": "钟表报时发出的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "одиночный звук"
