{
    "word_family": [
        "practice",
        "practitioner",
        "practicable",
        "practical",
        "practically",
        "practicum"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "627b9368-c37e-364f-a93e-f8d68b15c0c2",
                    "sense_definition": "A person who actively works in a specific profession or art, particularly in fields like law or medicine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local medical <w>practitioner</w> has been serving this small community for over thirty years.",
                            "target_lang_translations": {
                                "ru": "Местный медицинский <w>практик</w> обслуживает это небольшое сообщество уже более тридцати лет."
                            }
                        },
                        {
                            "text": "As a legal <w>practitioner</w>, she must stay updated on all changes to the current tax laws.",
                            "target_lang_translations": {
                                "ru": "Как практикующий <w>юрист</w>, она должна быть в курсе всех изменений в действующем налоговом законодательстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "practician"
                    ],
                    "common_phrases": [
                        "medical practitioner",
                        "legal practitioner",
                        "general practitioner",
                        "nurse practitioner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, активно работающий в определенной профессии или искусстве, особенно в таких областях, как право или медицина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "практикующий специалист",
                                "target_lang_sense_clarification": "в профессиональной сфере"
                            },
                            {
                                "target_lang_word": "врач",
                                "target_lang_sense_clarification": "в медицине"
                            },
                            {
                                "target_lang_word": "юрист",
                                "target_lang_sense_clarification": "в юриспруденции"
                            },
                            {
                                "target_lang_word": "практик",
                                "target_lang_sense_clarification": "человек дела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b8d136b-225e-35bd-9db9-ee03a7053e7a",
                    "sense_definition": "Someone who regularly performs or follows a particular activity, belief, or habit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "follower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many a dedicated <w>practitioner</w> of yoga finds that the discipline improves both physical and mental health.",
                            "target_lang_translations": {
                                "ru": "Многие преданные <w>адепты</w> йоги обнаруживают, что эта дисциплина улучшает как физическое, так и психическое здоровье."
                            }
                        },
                        {
                            "text": "The <w>practitioner</w> of this ancient craft uses tools that have remained unchanged for centuries.",
                            "target_lang_translations": {
                                "ru": "<w>Мастер</w> этого древнего ремесла использует инструменты, которые оставались неизменными на протяжении веков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skilled practitioner",
                        "experienced practitioner",
                        "dedicated practitioner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто регулярно занимается какой-либо деятельностью, следует убеждению или привычке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адепт",
                                "target_lang_sense_clarification": "последователь учения или метода"
                            },
                            {
                                "target_lang_word": "практик",
                                "target_lang_sense_clarification": "занимающийся чем-либо регулярно"
                            },
                            {
                                "target_lang_word": "последователь",
                                "target_lang_sense_clarification": "приверженец идеи или системы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cd5037a-7998-3973-8b59-ea5ccf3e36ea",
                    "sense_definition": "A person who is notably clever, sly, or artful in their actions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old politician was a cunning <w>practitioner</w> of the art of persuasion and backroom deals.",
                            "target_lang_translations": {
                                "ru": "Старый политик был хитрым <w>знатоком</w> искусства убеждения и закулисных сделок."
                            }
                        },
                        {
                            "text": "He proved to be a master <w>practitioner</w> of deception, fooling even his closest allies.",
                            "target_lang_translations": {
                                "ru": "Он оказался великим <w>мастером</w> обмана, одурачив даже своих ближайших союзников."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cunning practitioner"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, отличающийся особой хитростью, ловкостью или искусностью в своих действиях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастер",
                                "target_lang_sense_clarification": "в контексте умелого манипулирования"
                            },
                            {
                                "target_lang_word": "искусник",
                                "target_lang_sense_clarification": "в делах или интригах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}