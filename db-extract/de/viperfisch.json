                "senses": [
                    {
                        "sense_id": "bc15f77c-f472-3fe6-bc9c-bc823da09235",
                        "entry_id": "82612f52-052b-315b-bebf-479aa6ef4364",
                        "glosses": [
                            "in der Tiefsee lebender Fisch der Gattung Stomiidae; Chauliodus"
                        ],
                        "tags": [
                            "wissenschaftlicher Name"
                        ],
                        "examples": [
                            {
                                "example_id": "ac2d8e7f-4a3f-4635-acf1-7a44ff86c044",
                                "sense_id": "bc15f77c-f472-3fe6-bc9c-bc823da09235",
                                "text": "„Der Viperfisch hat scharfe Zähne wie Dolche, die aus seinem vorgeschobenen Unterkiefer herausragen und nach hinten, seinem Kopf zu, gebogen sind.“"
                            },
                            {
                                "example_id": "0731fe56-f66f-4aa8-9a58-51744d75b8cb",
                                "sense_id": "bc15f77c-f472-3fe6-bc9c-bc823da09235",
                                "text": "„Herrscher der Tiefsee ist dagegen der bizarre, leuchtende Viperfisch, Chauliodus sloani - mit bis zu 35 Zentimetern Länge und den riesigen krummen Fangzähnen eine überaus auffällige Erscheinung.“"
                            },
                            {
                                "example_id": "46674b5d-13e3-40b1-907f-00404bca5eb8",
                                "sense_id": "bc15f77c-f472-3fe6-bc9c-bc823da09235",
                                "text": "„Dass aber etwa der bedrohlich dreinschauende Viperfisch in 25 Prozent aller Ozeane vorkommt, ist neu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
