                "senses": [
                    {
                        "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                        "entry_id": "12187c75-7e82-3bb1-8fc3-091c3a072a52",
                        "glosses": [
                            "Sportart beziehungsweise Tätigkeit in den höchsten Gebirgsregionen unter schwersten technischen Bedingungen und äußersten physischen wie psychischen Leistungsanforderungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5b8f03-a5c2-4c33-96b8-e4b1ad718937",
                                "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                                "text": "„Beim Extrembergsteigen vertraut der Kletterer den Kameraden seiner Seilschaft, die ihn sichern.“"
                            },
                            {
                                "example_id": "58680ac0-878f-4c75-af02-8f40fb33b89e",
                                "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                                "text": "„Es liegt nahe, sich zu fragen, ob man als Nichtbeteiligter in Bezug auf Extrembergsteigen überhaupt eine Meinung entwickeln kann, die relevant ist, als nie annähernd in diese Situationen Hineinversetzter.“"
                            },
                            {
                                "example_id": "4056b97d-efa0-4b09-bec3-3e6b7592b825",
                                "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                                "text": "„Seine sportlichen Aktivitäten wie Extrembergsteigen und Gleitschirmfliegen legen nahe, dass er gern an seine Grenzen ging.“"
                            },
                            {
                                "example_id": "19737bd7-3f02-4649-8739-0fd8a6ec61bf",
                                "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                                "text": "„Auch eine Unfallversicherung kann sinnvoll sein, für extravagante Hobbys wie Fallschirmspringen oder Extrembergsteigen sind allerdings Zusatzdeckungen erforderlich.“"
                            },
                            {
                                "example_id": "74842450-d824-4b03-bc6f-ebe12896b930",
                                "sense_id": "28b78554-6f45-32c2-adb3-5323c4038668",
                                "text": "„Seit ich das Extrembergsteigen hinter mir gelassen habe, träume ich nur noch angenehme Träume, auch vom Gehen und Klettern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
