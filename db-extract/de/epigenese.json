                "senses": [
                    {
                        "sense_id": "0386de63-71bf-384a-9777-b9c44eabfce2",
                        "entry_id": "b7050d92-5317-3acc-a97e-744a4ef08022",
                        "glosses": [
                            "die von Caspar Friedrich Wolff (1738–1794) in seiner „Theoria generationis“ begründete und von Karl Ernst von Baer (1792–1876) ausgearbeitete Theorie, dass – entgegen der Präformationstheorie – alle Organismen in ihrer Embryogenese eine materielle Differentiation von einfachen zu komplexen Gebilden durchlaufen"
                        ],
                        "tags": [
                            "Entwicklungsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "33393695-b550-439d-94f2-b0aa353e9f08",
                                "sense_id": "0386de63-71bf-384a-9777-b9c44eabfce2",
                                "text": "Das Konzept der Epigenese richtete sich im Wesentlichen gegen das ans Ende seiner Erklärungsmöglichkeiten gekommene mechanistische Konzept der Präformation, das besagt, die embryonale Entwicklung bestehe in einem bloßen Größenwachstum des vorgeformten Miniaturlebewesens."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "523267da-e370-3b61-aff7-b1445aee1d5f",
                        "entry_id": "b7050d92-5317-3acc-a97e-744a4ef08022",
                        "glosses": [
                            "Vorgang in der Natur, der bestehende Strukturen nachträglich überformt oder überlagert (wie beispielsweise die Neuanlage eines Flusstales durch Laufverlegung des ursprünglichen Flusses oder die spätere Entstehung von geologischen Lagerstätten)"
                        ],
                        "tags": [
                            "Geowissenschaften"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acac6be8-9815-4bda-b2b5-9ece382fbbae",
                        "source_entry_id": "b7050d92-5317-3acc-a97e-744a4ef08022",
