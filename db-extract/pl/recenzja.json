                                        ]
                                    },
                                    {
                                        "sense_id": "6aaaae73-4662-3dd1-a741-af629a2fa21a",
                                        "entry_id": "f1599b06-691f-3fe6-beb1-a95c00ce4208",
                                        "glosses": [
                                            "A military inspection or display for the benefit of superiors or VIPs."
                                        ],
