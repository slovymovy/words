                    {
                        "sense_id": "fe66884d-c9ce-33df-9a02-be0537e70236",
                        "entry_id": "9de7caf7-cb9b-337b-bf8f-1c52aefd2603",
                        "glosses": [
                            "vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzte Brötchen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "58847751-868e-4573-9711-703817913ff5",
                                "sense_id": "fe66884d-c9ce-33df-9a02-be0537e70236",
                                "text": "Bringe bitte vom Bäcker ein paar Laugenwecke mit."
                            },
                            {
                                "example_id": "cd1f4738-c50c-4e9e-88b2-3dbeb774bccd",
                                "sense_id": "fe66884d-c9ce-33df-9a02-be0537e70236",
                                "text": "„Ich ernährte mich hauptsächlich von Laugenwecken aus der angrenzenden Bäckerei, und die Abende verbrachte ich am See, dessen zartes Gekräusel im Gold der untergehenden Sonne tänzelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
