                ],
                "senses": [
                    {
                        "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                        "entry_id": "d566b09d-f66d-3369-99f2-b3079c4f5479",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "361ec7ed-0e53-4ef8-a9e2-1e402c87927b",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Der Völzke trägt nie die Schals, die die Völzke ihm strickt."
                            },
                            {
                                "example_id": "2dddb960-3ba7-4d76-b98a-9f1e000e40a0",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Völzke kommt, geht der Herr Völzke.“"
                            },
                            {
                                "example_id": "540f563e-36ac-46f1-839e-fabc6f648b6c",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Völzke kommt und geht."
                            },
                            {
                                "example_id": "0d2897ef-d70d-49f6-a5d1-f6f750492e17",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Völzkes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "a235247e-5454-4f8a-9284-7d50146b8074",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Frau Völzke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "53eb729e-378e-4b22-bff0-c10517d7b449",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Herr Völzke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "51b20f28-72f5-484b-935e-613dfc44c012",
                                "sense_id": "7e9ebb9d-fcb2-3cce-89fb-3da328e9d870",
                                "text": "Die Völzkes fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
