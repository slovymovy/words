                "senses": [
                    {
                        "sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                        "entry_id": "1c89d46d-dbee-380b-a423-f9fee23247d0",
                        "glosses": [
                            "Gebäude oder Anlage, in dem Personen, die vom Gericht zu einer unbedingten Haftstrafe verurteilt wurden, unter Verschluss gehalten werden"
                        ],
                        "tags": [
                            "casual"
                        ],
                        "examples": [
                            {
                                "example_id": "d54691d4-a985-4c1e-90d6-74b26cc718c9",
                                "sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                                "text": "Leicht hätte ihm somit passieren können, was einst Sofia Loren widerfuhr. Sie war auf dem römischen Flughafen verhaftet worden und saß dann einen Monat im Kittchen."
                            },
                            {
                                "example_id": "e2cb78ed-56f2-4a7c-b6d5-776a05740ea5",
                                "sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                                "text": "In meinen Kindheitsträumen besaß so ein Staatsmann unendlich viel Macht, durfte also seine unartigen Eltern ins Kittchen stecken und ungeheure Mengen Eis verputzen."
                            },
                            {
                                "example_id": "d711e5da-96da-4295-bf4f-8f3b724c1e14",
                                "sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                                "text": "„Unsern Bruder Reimers haben sie uns genommen und heute auch den Rohwer weggeführt ins Kittchen.“"
                            },
                            {
                                "example_id": "e8099eab-4898-4a73-9c86-904ce9fba4c3",
                                "sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                                "text": "„So als habe man sie gerade aus dem Kittchen oder dem Armenhaus entlassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61bff97a-fd2f-452f-ac87-594d291abcb2",
                        "source_entry_id": "1c89d46d-dbee-380b-a423-f9fee23247d0",
                        "source_sense_id": "cad30820-6918-3d0c-8484-5e44133a690a",
                        "target_lang_word": "clink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cfbfe0b-6bcf-3b43-ad00-d2cbcc398950",
                                        "entry_id": "87b12ff8-9497-3e1e-aa28-03ec95c42afc",
                                        "glosses": [
                                            "The sound of metal on metal, or glass on glass."
                                        ],
                                        "tags": [
                                            "onomatopoeic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f073a33d-c6f3-4b9e-b929-9b0a56eb5f02",
                                                "sense_id": "4cfbfe0b-6bcf-3b43-ad00-d2cbcc398950",
                                                "text": "You could hear the clink of the glasses from the next room."
                                            },
                                            {
                                                "example_id": "f8cd7f65-a5cb-4602-aa7f-fa73482c61ab",
                                                "sense_id": "4cfbfe0b-6bcf-3b43-ad00-d2cbcc398950",
                                                "text": "1874, Marcus Clarke, For the Term of His Natural Life Chapter V\nWhen Frere had come down, an hour before, the prisoners were all snugly between their blankets. They were not so now; though, at the first clink of the bolts, they would be back again in their old positions, to all appearances sound asleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdfeb423-d0fc-30e4-83a0-049bc369cd1d",
                                        "entry_id": "87b12ff8-9497-3e1e-aa28-03ec95c42afc",
                                        "glosses": [
                                            "Stress cracks produced in metal ingots as they cool after being cast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b40e428e-9059-3000-a3d2-c3d8774eb848",
                                        "entry_id": "9112f6cc-afad-379a-826c-3f25c0cc41cc",
                                        "glosses": [
                                            "To make a clinking sound; to make a sound of metal on metal or glass on glass; to strike materials such as metal or glass against one another."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baab2b12-7de4-4b07-8655-250525cd3e71",
                                                "sense_id": "b40e428e-9059-3000-a3d2-c3d8774eb848",
                                                "text": "The hammers clinked on the stone all night."
                                            },
                                            {
                                                "example_id": "53d0fbad-d94e-4c34-b3fd-9f05a1654bcb",
                                                "sense_id": "b40e428e-9059-3000-a3d2-c3d8774eb848",
                                                "text": "The broken sheds look'd sad and strange, / Unlifted was the clinking latch, / Weeded and worn the ancient thatch / upon the lonely moated grange."
                                            },
                                            {
                                                "example_id": "9b211a82-2252-45ed-8efd-ad725bdbcd4c",
                                                "sense_id": "b40e428e-9059-3000-a3d2-c3d8774eb848",
                                                "text": "On the other side: the rich, beautiful tapestry of WASP culture that constituted Levis's life—friends playing horseshoes at backyard cocktail parties, where girls swanned in chaise longues, clinking their gin and tonics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f2da27-9c34-3878-b845-ec6bac230b30",
                                        "entry_id": "9112f6cc-afad-379a-826c-3f25c0cc41cc",
                                        "glosses": [
                                            "To rhyme."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d414c56-281f-3b5c-823a-031e7e381507",
                                        "entry_id": "fcf30b1d-6964-3c3a-a089-258aa633a066",
                                        "glosses": [
                                            "A prison."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8988df6c-7be6-4480-b3cf-9744fa61268c",
                                                "sense_id": "5d414c56-281f-3b5c-823a-031e7e381507",
                                                "text": "If he keeps doing things like that, he’s sure to end up in the clink."
                                            }
                                        ]
                                    }
                                ]
                            },
