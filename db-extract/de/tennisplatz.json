                "senses": [
                    {
                        "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                        "entry_id": "2b30f564-a1d2-3681-a327-f601492fd91d",
                        "glosses": [
                            "das Spielfeld für ein Tennisspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6924a3-2235-43ed-8d94-1cd8fd4fcc3b",
                                "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                                "text": "Vor dem Turnier wurde der Belag des Tennisplatzes erneuert."
                            },
                            {
                                "example_id": "41d6b3d8-c127-465a-b7f4-550a49eca387",
                                "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                                "text": "„Zwei Rehe hatten sich auf einen komplett umzäunten und schneebedeckten Tennisplatz verirrt und fanden keinen Weg ins Freie.“"
                            },
                            {
                                "example_id": "b1da8e2d-3e6d-4efd-a820-e6a21c6f6788",
                                "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                                "text": "„Der letzte nennenswerte Impuls, der von einem Tennisplatz kam, waren die T-Shirts der Russin Anna Kurnikowa. Aus pastellfarbenem Stretchstoff und bauchfrei.“"
                            },
                            {
                                "example_id": "c133e32a-d7da-415d-b312-659fe9738b2d",
                                "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                                "text": "„Die Tennisplätze lagen im hinteren Teil des Parks, man musste ihn diagonal durchqueren.“"
                            },
                            {
                                "example_id": "04001137-7b5d-4102-8b88-c430dfe58da3",
                                "sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                                "text": "„Den Rückweg nahm sie vermutlich durch den Park, vorbei am Tennisplatz, denn dahinter lagen die Pferdeställe und die Wagenremisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "899fa205-7b8a-4b20-b85c-dda8c11f4714",
