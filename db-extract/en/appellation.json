                            "plural"
                        ],
                        "form": "appellations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a5030fc-3637-32b3-b915-89143c4dbc22",
                        "entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "glosses": [
                            "A name or title by which someone is addressed or identified; a designation."
                        ],
                        "tags": [
                            "dated",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "77ce4cb0-9c6f-41fe-9332-18d6c35fc8d5",
                                "sense_id": "9a5030fc-3637-32b3-b915-89143c4dbc22",
                                "text": "\"I'll not,\" retorted \"Teeter\" Nelson, whose first name was Harry, but who had gained his appellation because of a habit he had of \"teetering\" on his tiptoes when reciting in class. \"I've got Peaches all right,\" and there was a struggle between the two lads, one trying to throw a snowball, and the other trying to prevent him."
                            },
                            {
                                "example_id": "f430edab-ca69-43fb-921e-8189fe47c2e1",
                                "sense_id": "9a5030fc-3637-32b3-b915-89143c4dbc22",
                                "text": "Russian River flows through a country of hill ridges, which in many places are dignifiable with the appellation of mountains."
                            },
                            {
                                "example_id": "4cb8c17d-dc6e-4a28-bc0b-dacfa91ce4b8",
                                "sense_id": "9a5030fc-3637-32b3-b915-89143c4dbc22",
                                "text": "Gentlemen of the jury, what is a father, a real father, what does this great word mean, what terribly great idea is contained in this appellation?"
                            },
                            {
                                "example_id": "900470c2-52d0-45d5-bfdb-b1dc701318ba",
                                "sense_id": "9a5030fc-3637-32b3-b915-89143c4dbc22",
                                "text": "The first, and (spoiler alert) last, voyage of the Russian 2nd Pacific Squadron is about as close a candidate to the appellation \"voyage of the damned\" as you're ever likely to get. But quite how did this floating disaster, which literally drove some of the men involved insane, and would ultimately find its end at the Battle of Tsushima, actually come about?"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe38f0d6-5153-3b46-ba65-2f46de5e9cac",
                        "entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "glosses": [
                            "A geographical indication for wine that describes its geographic origin."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18923ccb-06fd-4892-9506-959932ae8581",
                        "source_entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "source_sense_description": "name; designation",
                        "target_lang_word": "benaming",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benaming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e961dce4-9ec0-34ac-82e7-595150ed4606",
                                        "entry_id": "68b2d367-763c-3d73-948c-816ec9717e3f",
                                        "glosses": [
                                            "een naam die aan iets of iemand gegeven wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97509aba-dcdf-479b-a736-236e180cebd2",
                                                "sense_id": "e961dce4-9ec0-34ac-82e7-595150ed4606",
                                                "text": "Deze benaming is niet erg goed gekozen."
                                            },
                                            {
                                                "example_id": "b5912cae-b828-4cfe-88a0-4183b9a789fe",
                                                "sense_id": "e961dce4-9ec0-34ac-82e7-595150ed4606",
                                                "text": "Ook zal je onderbewustzijn jou op een gegeven moment andere benamingen voor ‘ongevallen’ influisteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f0faa0c-ee1c-4ea3-87e9-96e8e60bd201",
                        "source_entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "source_sense_description": "name; designation",
                        "target_lang_word": "aanduiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aanduiding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e8137125-05d3-340e-b31c-54ef2549880c",
                                        "entry_id": "f421fedd-3d84-3482-991d-7002870f7ddb",
                                        "glosses": [
                                            "waardoor iets duidelijk wordt, aanwijzing, vingerwijzing, teken, wenk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "710ab1d1-9e5b-419b-ba08-c74698a522b5",
                                                "sense_id": "e8137125-05d3-340e-b31c-54ef2549880c",
                                                "text": "Op het etiket van een artikel kan men aanduidingen vinden waar de verschillende bestanddelen vandaan komen."
                                            },
                                            {
                                                "example_id": "c7646321-207b-4e41-addb-807a9c391907",
                                                "sense_id": "e8137125-05d3-340e-b31c-54ef2549880c",
                                                "text": "Op de bruine deklaag stond in het wit in twee talen een aanduiding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8dbbeb-ef51-419f-8278-4a4e74490226",
                        "source_entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "source_sense_description": "name; designation",
                        "target_lang_word": "Benennung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Benennung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                                        "glosses": [
                                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6280da4-a8d1-4786-872a-a15879b2bd74",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Dies führt oft zur Verwendung movierter und unmovierter Benennungen für das gleiche Denotat […].“"
                                            },
                                            {
                                                "example_id": "eea57daf-ea05-43de-8bb9-6ed0462cd57d",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Manchmal geraten nämlich auch Personen in Benennungen.“"
                                            },
                                            {
                                                "example_id": "894b4c99-49fa-4594-bb74-7088f30ffd00",
                                                "sense_id": "a625401e-094f-33f1-825f-e3d0a175b65e",
                                                "text": "„Bedenkt man aber, daß diese und andere Sippen, wie etwa der Rhabarber und der Spinat, ja gar nicht in den Gebieten des arabischen Reiches heimisch sein konnten, so stellt sich für den Etymologen die extrem schwierige Frage, woher denn diese arabischen Benennungen bezogen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                        "entry_id": "cb0d31e5-621f-3788-b9c4-bcb9c89c3b21",
                                        "glosses": [
                                            "das Benennen, die öffentliche Nennung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ddb3f32-196b-4251-a6e0-25a8e1c03b01",
                                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                                "text": "„Dass die genaue Benennung eines echten Gründungsjahres so schwierig ist, liegt vor allem daran, dass es keine anerkannte Interpretation gibt, was eine Liga denn eigentlich ausmacht.“"
                                            },
                                            {
                                                "example_id": "11e3b1c7-f754-41c4-8204-dbcd3599a585",
                                                "sense_id": "cb22828c-a875-3fe5-bbcd-992847a3e9a4",
                                                "text": "Die Benennung der Kandidaten erfolgt durch den Vorstand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8de510f2-bb00-4342-906b-7e603797a78b",
                        "source_entry_id": "a0db5d2e-5421-37f5-a54f-e8300a8718a5",
                        "source_sense_description": "name; designation",
                        "target_lang_word": "Bezeichnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bezeichnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Code aus Zeichen und Symbolen, der auf einen Gegenstand oder Begriff verweist"
                                        ],
                                        "tags": [
                                            "Semiotik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54ceac54-fb57-44dc-90fd-ea3789e41f58",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Eine einheitliche Bezeichnung der Waren erleichtert die Suche."
                                            },
                                            {
                                                "example_id": "76805492-8a32-4b4b-9422-4c6491d7509c",
                                                "sense_id": "4c297b3b-2b3c-3128-aea6-7457bddcf52e",
                                                "text": "Die Europäische Artikelnummer (EAN) ist ein Strichcode, der auf jeder Ware sein sollte und so die eindeutige Bezeichnung des Artikels ermöglicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                        "entry_id": "3b172792-541c-3379-b807-5e3b59ea2141",
                                        "glosses": [
                                            "Wort, sprachlicher Ausdruck für etwas Gemeintes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d652fd4d-78d2-44af-ad27-184e6ba9d266",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "In manchen Regionen Norddeutschlands verwendet man für „Samstag“ die Bezeichnung „Sonnabend“."
                                            },
                                            {
                                                "example_id": "2bdf1dd1-d885-47b7-b689-0ff00f9bf64e",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Nur die Richtung der Fragestellung - die Richtung vom Sachverhalt zur Sprache, vom zu Bezeichnenden zur Bezeichnung - verbindet unterschiedliche Vorgehensweisen.“"
                                            },
                                            {
                                                "example_id": "f2c20618-777d-4a98-b1ad-df5173558bdc",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Damit gehen Entdeckungen und Erfindungen einher, die genaue und immer differenziertere Bezeichnungen (Nominationen) verlangen.“"
                                            },
                                            {
                                                "example_id": "2fce1ef0-867d-46ac-8d48-d236c257b47f",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Wenn wir überdies auch für die frühen Zeiträume das Wort »Computer« benutzen, dann ist dieses als unsere Bezeichnung für das Gerät beziehungsweise die Technologie der jeweiligen Entwicklungsstufe zu verstehen und keineswegs als Zitat aus den damaligen (oft anderslautenden) Sprachgebräuchen.“"
                                            },
                                            {
                                                "example_id": "6de29c6a-4766-41ce-83c6-a44439a8d5ec",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Erst später gingen über das Warenangebot der Geschäfte die überregionalen Bezeichnungen allmählich in den Sprachgebrauch der Käufer aller Schichten und Sprachlandschaften über.“"
                                            },
                                            {
                                                "example_id": "1a4440b0-10b9-40c9-983e-3ac159d34e02",
                                                "sense_id": "5b4d2bf9-5e93-3074-9b74-9321a7757da9",
                                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
