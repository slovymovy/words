    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60ef20bf-d10d-32df-aab0-6f9c2da90759",
                    "sense_definition": "Obtenir la connaissance d'une information ou trouver une valeur par la recherche, le calcul ou l'observation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques cherchent à <w>déterminer</w> l'origine précise de ce phénomène naturel."
                        },
                        {
                            "text": "Une analyse sanguine permet de <w>déterminer</w> la présence éventuelle d'un virus."
                        }
                    ],
                    "synonyms": [
                        "calculer",
                        "établir",
                        "trouver"
                    ],
                    "common_phrases": [
                        "déterminer la cause",
                        "déterminer l'origine"
                    ]
                },
                {
                    "sense_id": "fca584d0-1d3e-3d9c-a354-4fca592d3797",
                    "sense_definition": "Fixer, préciser ou régler formellement à l'avance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le contrat de travail <w>détermine</w> les horaires et les missions du salarié."
                        },
                        {
                            "text": "La commission va bientôt <w>déterminer</w> les nouvelles règles du concours."
                        }
                    ],
                    "synonyms": [
                        "définir",
                        "fixer",
                        "préciser"
                    ],
                    "common_phrases": [
                        "déterminer les conditions",
                        "déterminer les règles"
                    ]
                },
                {
                    "sense_id": "23b00388-d5a8-3829-abb2-f54f9e0e697a",
                    "sense_definition": "Être la cause directe de quelque chose, le provoquer ou le produire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision politique soudaine a <w>déterminé</w> de vives réactions au sein du parlement."
                        },
                        {
                            "text": "Le courage des soldats a largement <w>déterminé</w> l'issue victorieuse du combat."
                        }
                    ],
                    "synonyms": [
                        "causer",
                        "déclencher",
                        "entraîner",
                        "provoquer"
                    ],
                    "common_phrases": [
                        "déterminer le succès",
                        "déterminer une réaction"
                    ]
                },
                {
                    "sense_id": "02370dbd-d30e-3a6b-8418-cb99834016b9",
                    "sense_definition": "Inciter quelqu'un à prendre un parti ou une décision, le pousser à agir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prise_de_decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette baisse de salaire l'a enfin <w>déterminé</w> à chercher un autre emploi."
                        },
                        {
                            "text": "La promesse d'une prime substantielle a <w>déterminé</w> l'équipe à redoubler d'efforts."
                        }
                    ],
                    "synonyms": [
                        "décider",
                        "inciter",
                        "pousser"
                    ],
                    "antonyms": [
                        "dissuader"
                    ],
                    "common_phrases": [
                        "déterminer à agir",
                        "déterminer à partir"
                    ]
                },
                {
                    "sense_id": "55a0907e-d8ab-36ac-8cd7-0e0f94409e97",
                    "sense_definition": "Fixer les limites géographiques ou matérielles de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les experts ont utilisé un plan cadastral pour <w>déterminer</w> les limites exactes de la parcelle."
                        },
                        {
                            "text": "Ce traité de paix venait enfin <w>déterminer</w> la frontière séparant les deux pays voisins."
                        }
                    ],
                    "synonyms": [
                        "borner",
                        "délimiter"
                    ],
                    "common_phrases": [
                        "déterminer les frontières",
                        "déterminer les limites"
                    ]
                },
                {
                    "sense_id": "3978cf77-a39e-390b-8188-82f92ef64ca5",
                    "sense_definition": "Prendre une décision ferme, s'arrêter à un choix après réflexion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prise_de_decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues discussions, nous avons fini par nous <w>déterminer</w> pour la seconde option."
                        },
                        {
                            "text": "Le candidat hésite encore beaucoup, mais il devra bientôt se <w>déterminer</w> clairement."
                        }
                    ],
                    "synonyms": [
                        "choisir",
                        "opter",
                        "se décider",
                        "se résoudre"
                    ],
                    "antonyms": [
                        "hésiter"
                    ],
                    "common_phrases": [
                        "se déterminer enfin",
                        "se déterminer pour"
                    ]
                },
                {
                    "sense_id": "7dacf4b5-e20d-3d23-ba20-265fcbde966e",
                    "sense_definition": "Préciser ou restreindre l'extension ou la signification d'un mot dans un énoncé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette proposition relative, la subordonnée sert à <w>déterminer</w> plus précisément l'antécédent."
                        },
                        {
                            "text": "Le complément du nom vient souvent <w>déterminer</w> le mot qui le précède dans la phrase."
                        }
                    ],
                    "synonyms": [
                        "préciser",
                        "restreindre"
                    ],
                    "common_phrases": [
                        "déterminer le nom",
                        "déterminer le sens"
                    ]
                }
            ]
        }
    ]
}