                ],
                "senses": [
                    {
                        "sense_id": "4ccdf52d-d914-3e23-9bf9-4ce96efb013b",
                        "entry_id": "558ab9ca-ddfe-34d1-a2b2-0a93753c46eb",
                        "glosses": [
                            "Qui est étendu en long."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "98e1908a-2477-4a63-81c7-a35c78a37064",
                                "sense_id": "4ccdf52d-d914-3e23-9bf9-4ce96efb013b",
                                "text": "Corselet transversal, arrondi et bordé latéralement, très-fortement ponctué sur les bords, plus lisse et finement ponctué au milieu, où il est marqué d'une ligne longitudinale."
                            },
                            {
                                "example_id": "63aa9e6b-edb1-41ae-bbdb-6606286aff35",
                                "sense_id": "4ccdf52d-d914-3e23-9bf9-4ce96efb013b",
                                "text": "Quant aux anthères réellement unilobées, il est évident qu'elles s'ouvrent par une seule fente, qui, bien que longitudinale, paraît transversale, si cette anthère est, comme cela arrive fréquemment dans ce cas, renversée sur le dos à l'extrémité du filet."
                            },
                            {
                                "example_id": "3e5ff213-3313-4afa-8d5a-bcc23ae14330",
                                "sense_id": "4ccdf52d-d914-3e23-9bf9-4ce96efb013b",
                                "text": "Les éléments longitudinaux sont également continus; les quilles, contre-quilles et lisses sont en acajou; les élongis très largement dimensionnés sont en polyester renforcé de structure mixte mat-roving."
                            },
                            {
                                "example_id": "92e785a6-da42-4312-8a81-6ecfc7d2cde6",
                                "sense_id": "4ccdf52d-d914-3e23-9bf9-4ce96efb013b",
                                "text": "Les veines superficielles (qui drainent la majorité du cortex cérébral) se jettent essentiellement dans le sinus longitudinal supérieur, qui communique avec les sinus latéraux."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf89506b-7cd3-373b-b98f-32a2f9267a56",
                        "entry_id": "558ab9ca-ddfe-34d1-a2b2-0a93753c46eb",
                        "glosses": [
                            "Relatif à la longitude."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17e05393-2a8d-4c35-857d-4e53889539e2",
