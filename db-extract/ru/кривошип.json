                                    },
                                    {
                                        "sense_id": "b71f735e-edc1-34a1-8670-191f70bd2c44",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Strange; weird; odd."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f7b067f-92e9-3314-8c6a-a3f0d2c19404",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Bent; twisted; crooked; distorted; out of repair."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c40cef17-6610-35fc-bf8f-504b3e10ce18",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Sick; unwell."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "102c20cd-c5f0-3420-8018-4b780b173a9a",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Liable to capsize because of poorly stowed cargo or insufficient ballast."
                                        ],
                                        "tags": [
                                            "of a ship"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01690c3b-e2d1-41c5-9609-f3822bc0616d",
                                                "sense_id": "102c20cd-c5f0-3420-8018-4b780b173a9a",
                                                "text": "This ship is so crank and walty\nI fear our grave she will be!"
                                            },
                                            {
                                                "example_id": "fb553a8d-cc5c-4429-bfe4-1496d12bdb3b",
                                                "sense_id": "102c20cd-c5f0-3420-8018-4b780b173a9a",
                                                "text": "The stowage was clumsily done, and the vessel consequently crank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbff5179-71f9-3952-b98a-809e90f75941",
                                        "entry_id": "f10230a0-e144-3048-9e38-ad7ebceff9f7",
                                        "glosses": [
                                            "Full of spirit; brisk; lively; sprightly; overconfident; opinionated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd7d0bba-0e4c-4236-afc3-91dab486b456",
                                                "sense_id": "fbff5179-71f9-3952-b98a-809e90f75941",
                                                "text": "He who was a little before bedred[…]was now cranke and lustie."
                                            },
                                            {
                                                "example_id": "e8a40e90-d791-4318-aa7a-428ef8aba1a6",
                                                "sense_id": "fbff5179-71f9-3952-b98a-809e90f75941",
                                                "text": "If you strong electioners did not think you were among the elect, you would not be so crank about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f43f87-9d04-3c4e-b45e-ce894da619a2",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "An ailment, ache."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af7a3194-beca-3225-ac48-30b13e5ae1c6",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "An ill-tempered or nasty person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7872d38-2388-4707-93ce-267321584145",
                                                "sense_id": "af7a3194-beca-3225-ac48-30b13e5ae1c6",
                                                "text": "Billy-Bob is a nasty old crank! He chased my cat away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c882f8d-4a00-3f06-bd3d-dca3353aff21",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "A twist or turn of the mind; caprice; whim;"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a77f240-3003-3c9e-a4d3-bd153d659142",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "A fit of temper or passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958258b1-db7c-4107-8f0a-aba60c313e26",
                                                "sense_id": "7a77f240-3003-3c9e-a4d3-bd153d659142",
                                                "text": "Violent of temper; subject to sudden cranks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "A person who is considered strange or odd by others, and may behave in unconventional ways."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495194f3-afc8-4be0-91ea-ebb8e083686d",
                                                "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                                                "text": "John is a crank because he talks to himself."
                                            },
                                            {
                                                "example_id": "d974a735-57c5-4cc2-bc8c-bb94b44b1fc8",
                                                "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                                                "text": "Persons whom the Americans since Guiteau’s trial have begun to designate as ‘cranks’—that is to say, persons of disordered mind, in whom the itch of notoriety supplies the lack of any higher ambition."
                                            },
                                            {
                                                "example_id": "0bbb7540-e608-43e9-88c8-5206b495924e",
                                                "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                                                "text": "The raw meat cranks are in dead earnest. They think that raw food is the manna of heaven."
                                            },
                                            {
                                                "example_id": "079fc88d-4412-46ef-bbb4-aea68c168133",
                                                "sense_id": "5a204e42-85c6-3c67-ac23-0e98428bc046",
                                                "text": "But do you know what isn't in the school books? That old Rossum was mad. Seriously, Miss Glory, you must keep this to yourself. The old crank wanted to actually make people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edcccbf6-248b-35e7-9c32-489284461230",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "An amateur in science or other technical subjects who persistently advocates flawed theories."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7137f71c-323b-4b33-9d80-619cabc2f8a4",
                                                "sense_id": "edcccbf6-248b-35e7-9c32-489284461230",
                                                "text": "That crank next door thinks he’s created cold fusion in his garage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6504e871-2e24-3a11-bbd8-08f4e5cfecea",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "A baseball fan."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "392fc0e6-492d-32c7-90a8-93abad44de6b",
                                        "entry_id": "349cd30d-8cb1-3af4-a641-0c65004b3600",
                                        "glosses": [
                                            "A sick person; an invalid."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433dbf97-7262-483a-91f6-8c69676369ce",
                                                "sense_id": "392fc0e6-492d-32c7-90a8-93abad44de6b",
                                                "text": "Thou art a counterfeit crank, a cheater."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crank",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "403252cb-c401-3d26-8e73-973b2d694da3",
                                        "entry_id": "b1ed5eb3-2797-399c-88f9-2be927e69f32",
                                        "glosses": [
                                            "A bent piece of an axle or shaft, or an attached arm perpendicular, or nearly so, to the end of a shaft or wheel, used to impart a rotation to a wheel or other mechanical device; also used to change circular into reciprocating motion, or reciprocating into circular motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6e015c5-ca62-4c4a-8ce0-1c3ba3de8be3",
                                                "sense_id": "403252cb-c401-3d26-8e73-973b2d694da3",
                                                "text": "I grind my coffee by hand with a coffee grinder with a crank handle."
                                            }
