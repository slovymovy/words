                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7a7a401-c88c-3744-862e-5573896df375",
                        "entry_id": "365dc452-1fcc-3866-acb0-ef2c87049da5",
                        "glosses": [
                            "The quantum of light and other electromagnetic energy, regarded as a discrete particle having zero rest mass, no electric charge, and an indefinitely long lifetime. It is a gauge boson."
                        ],
                        "tags": [
                            "particle"
                        ],
                        "examples": [
                            {
                                "example_id": "63ac3f6a-93a5-47a8-b71f-b77d84978d83",
                                "sense_id": "d7a7a401-c88c-3744-862e-5573896df375",
                                "text": "The single-imaging optic of the mammalian eye offers some distinct visual advantages. Such lenses can take in photons from a wide range of angles, increasing light sensitivity. They also have high spatial resolution, resolving incoming images in minute detail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a32e3323-dea5-458a-9e9f-779464f2147b",
                        "source_entry_id": "365dc452-1fcc-3866-acb0-ef2c87049da5",
                        "source_sense_id": "d7a7a401-c88c-3744-862e-5573896df375",
                        "source_sense_description": "quantum of light",
                        "target_lang_word": "foton",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foton",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "ced2ea57-7fc7-36cf-966c-39bd68e2dfe1",
                                        "entry_id": "3641ea76-2a97-3b70-b15e-9ef3bb6cbd80",
                                        "glosses": [
                                            "elementární částice reprezentující kvantum elektromagnetické energie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8404c623-82e8-4fe2-9017-cf5b7a93674a",
                                                "sense_id": "ced2ea57-7fc7-36cf-966c-39bd68e2dfe1",
                                                "text": "Je to s nimi stejné jako s vjemy barev; žádné teoretické vědění o fotonech či světelných vlnách nemůže vysvětlit subjektivní prožitky různých barev, neřkuli nahradit je."
                                            },
                                            {
                                                "example_id": "d8a12d55-4b1c-481b-9336-c7a4bb0f3a02",
                                                "sense_id": "ced2ea57-7fc7-36cf-966c-39bd68e2dfe1",
                                                "text": "Touha zvolna zvedá krovky, potom vzlétá jako foton - a jste v koncích, filozofky, všechno je to vo tom!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cd72dc6-6c46-487e-9341-cbe07d20ae94",
