            {
                "entry_id": "3649dfcd-e5e4-3197-b888-01b1ad628369",
                "word": "liminal",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7276e2c8-db38-46e2-b86e-2bb04e591070",
                        "entry_id": "3649dfcd-e5e4-3197-b888-01b1ad628369",
