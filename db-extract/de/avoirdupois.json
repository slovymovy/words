                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abca1b74-c69e-3a42-ab1a-5a433d19d689",
                                        "entry_id": "f49bf27d-6ebc-3967-95ee-4ff1f37aa6ed",
                                        "glosses": [
                                            "Weight; heaviness."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "386a05f4-00e7-4711-9c15-c4895cbd5e93",
                                                "sense_id": "abca1b74-c69e-3a42-ab1a-5a433d19d689",
                                                "text": "It seems humanly reasonable that the three of us can woman-handle a mere man of your elderly and insulting avoirdupois."
                                            },
                                            {
                                                "example_id": "3b225dd4-8508-4a2a-816f-a8e5a23d864a",
                                                "sense_id": "abca1b74-c69e-3a42-ab1a-5a433d19d689",
                                                "text": "The detective sergeant, who was called Munro, more than made up for Cullen's advance in the avoirdupois department. Lean to the point of emaciation, Munro was also a paragon of contemporary fashion. He was clad in a hideous brown suit […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45c4b0f1-63a3-3b56-90f5-6f021fc2ee5c",
                                        "entry_id": "f49bf27d-6ebc-3967-95ee-4ff1f37aa6ed",
                                        "glosses": [
                                            "Merchandise."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46dd5ea-2a2c-47ed-b2ee-2699d00ded1c",
                                                "sense_id": "45c4b0f1-63a3-3b56-90f5-6f021fc2ee5c",
                                                "text": "From that mountain go men to the city of Thauriso that was wont to be clept Taxis, that is a full fair city and a great, and one of the best that is in the world for merchandise; thither come all merchants for to buy avoirdupois, and it is in the land of the Emperor of Persia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
