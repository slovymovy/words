                "senses": [
                    {
                        "sense_id": "1bde8337-b0b4-39de-abee-b5e3bd64bab9",
                        "entry_id": "b6fc694b-8990-31b7-afaf-6cb520c79105",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von Wein stammt; veränderlicher natürlicher Eigengeruch von vergorenen Weintrauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2035e56-6c91-4445-83fb-78612870c15a",
                                "sense_id": "1bde8337-b0b4-39de-abee-b5e3bd64bab9",
                                "text": "Wein aus der Flasche sollte man dem Entkorken etwas gehen lassen, damit dieser erst einmal atmen kann; und später, bei Zimmertemperatur, seinen ureigenen Weingeruch entfalten kann."
                            },
                            {
                                "example_id": "1338f75e-712d-4ac6-81d1-ddf147aeb2b5",
                                "sense_id": "1bde8337-b0b4-39de-abee-b5e3bd64bab9",
                                "text": "„Der Weingeruch der Jahrhunderte schien bis jetzt immer wieder über den Angstgeruch der Bombennächte gesiegt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1f1cf295-1705-3aac-a66a-453567df515d",
                        "entry_id": "b6fc694b-8990-31b7-afaf-6cb520c79105",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von Weintrauben stammt; veränderlicher natürlicher Eigengeruch der Weinrebe und deren Frucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1b258d-9768-4ecf-832e-aba4a2985a02",
                                "sense_id": "1f1cf295-1705-3aac-a66a-453567df515d",
                                "text": "Der Wein, direkt von der Rebe gepflügt, schmeckt im Weinberg am besten und bieten nicht nur den wahren Weintraubengenuss; sondern gar den wahren Weingeruch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
