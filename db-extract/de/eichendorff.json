                ],
                "senses": [
                    {
                        "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                        "entry_id": "40b48d0a-74f8-314f-91a9-f2afbf0481d7",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ec218f-bed8-4b3a-92b0-f44a7937a7cf",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Frau Eichendorff ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a90e66b3-a8db-48e9-9553-6d205e3f3084",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Herr Eichendorff wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ae0d4016-3168-4fcb-87d4-9bdaf639fda9",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Die Eichendorffs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "49205196-9937-425e-8ea4-799fca595b2e",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Der Eichendorff trägt nie die Schals, die die Eichendorff ihm strickt."
                            },
                            {
                                "example_id": "cabc0b4b-81ae-4877-9038-e76585d6193d",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eichendorff kommt, geht der Herr Eichendorff.“"
                            },
                            {
                                "example_id": "f176a862-05cc-4047-be8c-b8d0871f0fc3",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Eichendorff kommt und geht."
                            },
                            {
                                "example_id": "968a91ff-d43e-4b1b-b463-9c963c421394",
                                "sense_id": "be949883-ea65-39ef-837b-03ff404471cc",
                                "text": "Eichendorffs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
