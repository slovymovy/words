                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Onthutst</w> hen niet met zulke zware verwijten tijdens de vergadering!",
                            "target_lang_translations": {
                                "fr": "Ne les <w>accablez</w> point de reproches aussi lourds pendant la réunion !"
                            }
