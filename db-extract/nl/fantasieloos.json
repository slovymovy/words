                        "tags": [],
                        "examples": [
                            {
                                "example_id": "622c0c02-b891-428f-adc7-821ef3b3c035",
                                "sense_id": "9a4d52b6-0b7f-3270-8298-4477687be3d4",
                                "text": "De fantasieloze boekhouder deed niet aan creatief boekhouden."
                            },
                            {
                                "example_id": "93b073e1-2870-42bf-bca1-f133caf4c7d9",
                                "sense_id": "9a4d52b6-0b7f-3270-8298-4477687be3d4",
                                "text": "De fantasieloze ouders kunnen hun fantasievolle kind niet begrijpen."
                            },
                            {
                                "example_id": "541359a5-d970-4688-955f-a5aee3aefefd",
                                "sense_id": "9a4d52b6-0b7f-3270-8298-4477687be3d4",
                                "text": "Maar het was fantasieloos, geestdodend en weinig ondernemend, een soort intellectuele dwerggroei. Met een heel klein beetje zelfrespect zou je grotere visioenen moeten hebben dan dat."
                            }
                        ]
                    }
