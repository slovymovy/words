                        "entry_id": "d5f9ff48-a458-3624-bd5f-040d1ad14419",
                        "glosses": [
                            "Qualifie une personne privée de l’ouïe, mais pas de la parole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fb1f206-f302-4fce-ad98-1e593e150f75",
                                "sense_id": "10b93177-8ec7-3c04-baf9-bed8a1075f15",
                                "text": "On raconte à ce sujet qu’une jeune femme sourde-parlante, dont on nous permettra de taire le nom, causait un jour avec une personne qui ignorait l’infirmité de cette jeune femme"
                            },
                            {
                                "example_id": "47e47d21-07f0-4cb7-b9b3-8e4d9103503c",
                                "sense_id": "10b93177-8ec7-3c04-baf9-bed8a1075f15",
                                "text": "Les relations entre élèves sourds-muets et sourds-parlants a toutefois beaucoup varié selon les établissements, et selon l’époque."
                            }
                        ]
                    }
