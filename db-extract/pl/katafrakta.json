                "senses": [
                    {
                        "sense_id": "92d16483-84cc-3cae-a662-bde63991c6b0",
                        "entry_id": "78dfb119-c8f3-3604-a74d-4afbf5fa7d5d",
                        "glosses": [
                            "ciężkozbrojny jeździec, zwykle dosiadający opancerzonego wierzchowca, walczący w szeregach armii starożytnych i średniowiecznych państw od wybrzeży Morza Śródziemnego po Persję"
                        ],
                        "tags": [],
