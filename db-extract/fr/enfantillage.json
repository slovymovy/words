        "fr-extract.jsonl": [
            {
                "entry_id": "752ecb6e-7fab-3e75-8034-05c3f17d7215",
                "word": "enfantillage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec6ce440-9522-4a09-a139-c3537fc465c8",
                        "entry_id": "752ecb6e-7fab-3e75-8034-05c3f17d7215",
                        "tags": [
                            "plural"
                        ],
                        "form": "enfantillages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                        "entry_id": "752ecb6e-7fab-3e75-8034-05c3f17d7215",
                        "glosses": [
                            "Manière d’agir ou de parler qui ne convient qu’à un enfant, en parlant des personnes qui ont passé l’enfance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3135c0d6-78ba-46ee-8e78-3e2819aaaa10",
                                "sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                                "text": "À vingt-deux ans, les jeunes gens sont encore assez voisins de l’enfance pour se laisser aller à des enfantillages."
                            },
                            {
                                "example_id": "8405743a-73e3-4294-a4b9-b300e63cb4e6",
                                "sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                                "text": "Je vous en prie, rompez là. C’est un enfantillage, et il faut que cela finisse au plus vite, sinon, nous serions profondément ridicules."
                            },
                            {
                                "example_id": "7ed525bb-8cac-492a-8d7c-eb72110b1f77",
                                "sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                                "text": "On lira pour la première fois, chez un poète du VIIᵉ siècle, cet enfantillage charmant et qui semble du XIXᵉ :\n J’aime le nom de Leila. J’aime les noms qui ressemblent au sien."
                            },
                            {
                                "example_id": "3ce31eb9-33c5-43e3-9ea5-c9653fad5ac8",
                                "sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                                "text": "L’entêtement de Donald Trump à refuser d’admettre sa défaite confirme la thèse selon laquelle il se comporte comme un enfant de deux ans. Ce n’est pas de l’enfantillage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20af91d2-4133-465f-9c6f-96eb8aae91d8",
                        "source_entry_id": "752ecb6e-7fab-3e75-8034-05c3f17d7215",
                        "source_sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                        "target_lang_word": "Kinderei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b6e687b2-522f-4df1-9a15-1027a194785f",
                        "source_entry_id": "752ecb6e-7fab-3e75-8034-05c3f17d7215",
                        "source_sense_id": "fcc89828-f6aa-3ecc-aeb1-d7666324e942",
                        "target_lang_word": "Quatsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quatsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "unkluge, ungereimte Aussage oder Aussagen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b29e4fb3-1a68-41d4-9271-632aa0837b04",
                                                "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                                "text": "Red nicht solchen Quatsch, natürlich kommt er wieder nach Hause!"
                                            },
                                            {
                                                "example_id": "3c73a0b2-c92f-4e6d-a132-838ceafcbeb2",
                                                "sense_id": "05a069cf-f1b5-3e1b-b6a2-be9b9bebfde5",
                                                "text": "Das ist doch Quatsch, so kann es gar nicht gewesen sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "Torheit; falsche, unüberlegte, unkluge Handlung"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d3c53ea-85ab-4678-809b-f21b99f0f55c",
                                                "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                                "text": "Was hast du jetzt wieder für einen Quatsch verzapft? Das kriegt doch keiner wieder richtig zusammengebaut!"
                                            },
                                            {
                                                "example_id": "088c0c4c-564f-4c14-94b6-cd894ff41e1f",
                                                "sense_id": "2b9dab70-8b4f-3d7b-846b-c17a40ba49e0",
                                                "text": "„Jeder Quatsch, den man mit einem Manne erlebte, erklärte sich dadurch, daß er verheiratet war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7d89bdf9-36a7-3412-8c25-03723657a78b",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "Alberei; kindisches Benehmen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e3530d5-1674-4acd-8299-5fc4f1c19665",
                                                "sense_id": "7d89bdf9-36a7-3412-8c25-03723657a78b",
                                                "text": "Lasst den Quatsch, jetzt wird aufgeräumt und Abendbrot gegessen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "etwas Unsinniges"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e92066a-8a3e-4890-a4d8-81cb0eb33742",
                                                "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                                "text": "Reiserücktrittsversicherungen sind Quatsch, im Ernstfall zahlen sie sowieso nicht."
                                            },
                                            {
                                                "example_id": "2689ed1f-690c-4b89-a585-faa1df18b16d",
                                                "sense_id": "8e2f215a-63e7-3a38-b9df-6662b26f2dd2",
                                                "text": "Es ist Quatsch, jetzt noch etwas an dem Entwurf ändern zu wollen; in einer Stunde ist Abgabetermin."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "44cef6b0-e08a-3b33-bb8b-20fd2eb734b9",
                                        "entry_id": "eccb0114-f101-35b5-8be4-a2ea59a2dbd9",
                                        "glosses": [
                                            "breiiger Matsch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "regional"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
