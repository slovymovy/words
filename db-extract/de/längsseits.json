                                "sense_id": "0b74541b-90b8-31e8-985f-745ee0a03a93",
                                "text": "„Die Viecher sind nun längsseits angekommen.“"
                            },
                            {
                                "example_id": "65d25b22-6f8d-4d96-9653-d467064a14ed",
                                "sense_id": "0b74541b-90b8-31e8-985f-745ee0a03a93",
                                "text": "„Die Rettungsschwimmer gingen mit ihrem Boot längsseits und nahmen die Hilflosen an Bord.“"
                            },
                            {
                                "example_id": "6e70f86d-16cb-46f7-9db3-3d0f5e737777",
                                "sense_id": "0b74541b-90b8-31e8-985f-745ee0a03a93",
                                "text": "„Einfach einen Toaster längsseits unter den Fernseher legen – deine Freunde werden keinen Unterschied feststellen.“"
                            },
                            {
                                "example_id": "957083cf-5fc7-4503-a55d-101b3d0c44e7",
                                "sense_id": "0b74541b-90b8-31e8-985f-745ee0a03a93",
                                "text": "„Gewöhnlicherweise hat ein Kamara-Haus die Ausmaße von zirka 8 mal 5 Metern und ist längsseits durch einen gemauerten Bogen geteilt, καμάρα (kamára) genannt.“"
                            },
                            {
                                "example_id": "8e160307-bcf6-4746-be92-bf62f353ec78",
                                "sense_id": "0b74541b-90b8-31e8-985f-745ee0a03a93",
                                "text": "„Als Durands Beiboot längsseits ging, ließ man von der Pontchartrain eine Strickleiter herab, sodass er an Deck klettern konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
