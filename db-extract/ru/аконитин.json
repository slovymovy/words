                                            {
                                                "example_id": "5f2d3055-6d69-4faf-97ca-da17c182ab4b",
                                                "sense_id": "f563b265-3c8f-383d-af9d-bf081cd7b9db",
                                                "text": "Nie istnieje swoiste antidotum na zatrucie akonityną, ale przy natychmiastowej opiece przedszpitalnej można próbować ratować pacjenta"
