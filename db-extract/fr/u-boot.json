                "translations": [
                    {
                        "translation_id": "e4f903d3-592a-41bc-8165-b3455649668c",
                        "source_entry_id": "72efe2d6-bdb9-36f4-b84c-798504979e31",
                        "target_lang_word": "U-Boot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "U-Boot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1ce78c-8763-3a44-9118-617c7f5b5d55",
                                        "entry_id": "3ce2e95f-9779-328c-bb4e-1d9b89254dc1",
                                        "glosses": [
                                            "Kurzform für Unterseeboot"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939fa216-ef06-433e-8ee1-4bf783f5e6a1",
                                                "sense_id": "ad1ce78c-8763-3a44-9118-617c7f5b5d55",
                                                "text": "„Auch die großen Schiffe empfingen das U-Boot mit Hurras und Musik…“"
                                            },
                                            {
                                                "example_id": "5545378c-9176-4234-af08-18cfb4608d36",
                                                "sense_id": "ad1ce78c-8763-3a44-9118-617c7f5b5d55",
                                                "text": "„Hier im Nordatlantik sollten wir mit einigen anderen deutschen U-Booten zusammentreffen.“"
                                            },
                                            {
                                                "example_id": "90dd2a0b-3057-4e9d-95f6-d1b7c8940faf",
                                                "sense_id": "ad1ce78c-8763-3a44-9118-617c7f5b5d55",
                                                "text": "„Er betrachtete das U-Boot als revolutionär; so revolutionär, daß es eines Tages Überwasserstreitkräfte überflüssig und unnütz machen würde.“"
                                            },
                                            {
                                                "example_id": "cd806d96-5693-48eb-84b3-d9e486dc0c24",
                                                "sense_id": "ad1ce78c-8763-3a44-9118-617c7f5b5d55",
                                                "text": "„Immer weniger U-Boote kehrten von Feindfahrten zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fde269a-d8aa-33a1-8325-ca0473b9c6de",
                                        "entry_id": "3ce2e95f-9779-328c-bb4e-1d9b89254dc1",
                                        "glosses": [
                                            "eine absichtliche, falsche und freie erfundene Fußnote in wissenschaftlichen Arbeiten und damit eine Wissenschaftsfälschung."
                                        ],
                                        "tags": [
                                            "Wissenschaft"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a06bf201-7ed1-3426-9e34-c2ac0e1348a6",
                                        "entry_id": "3ce2e95f-9779-328c-bb4e-1d9b89254dc1",
                                        "glosses": [
                                            "eine oft humoristische, frei erfundene Bemerkung oder Passage in wissenschaftlichen Werken oder Lexikonartikeln (neuerdings auch im Quellcode von Softwaresystemen), die dem Autor beim Schreiben wie dem Leser - so er sie entdeckt - viel Freude bereitet. Solche U-Boote können, den Umfang eines eigenständigen Artikels, ja eines gesamten Werkes einnehmen."
                                        ],
                                        "tags": [
                                            "Lexikografie",
                                            "Wissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bf5c126-0823-46d6-a6f4-c35b28b01d26",
                                                "sense_id": "a06bf201-7ed1-3426-9e34-c2ac0e1348a6",
                                                "text": "Auch in der 19. Auflage hat die Redaktion des Brockhaus wieder ein U-Boot versenkt."
                                            },
                                            {
                                                "example_id": "cfa4bb6c-fec4-4e6d-80aa-a6162fbfa450",
                                                "sense_id": "a06bf201-7ed1-3426-9e34-c2ac0e1348a6",
                                                "text": "Bau und Leben der Rhinogradentia (dt.: Nasenschreitlinge) - inspiriert von Christian Morgensterns Gedicht \"Das Nasobēm\" und verfasst von Prof. Dr. Harald Stümpke (sic) - ist das wohl bekannteste U-Boot der biologischen Fachliteratur. Wikipedia klassifiziert das Werk korrekterweise als \"wissenschaftlichen Witz\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bca66156-043c-35a5-80a3-1cb7113a45cd",
                                        "entry_id": "3ce2e95f-9779-328c-bb4e-1d9b89254dc1",
                                        "glosses": [
                                            "ein (Entwicklungs-)Projekt, das ohne Genehmigung und ohne extra Budget in einer Firma durch Eigeninitiative der Mitarbeiter entsteht. Gelegentlich wird daraus ein marktreifes Produkt weiterentwickelt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e16d674-c159-49eb-89ef-0cc2c55f8138",
                                                "sense_id": "bca66156-043c-35a5-80a3-1cb7113a45cd",
                                                "text": "Open Source fördert \"U-Boot Projekte\" in Konzernen"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
