                "senses": [
                    {
                        "sense_id": "9747771f-0c3b-34f0-b082-2a77c80d46b4",
                        "entry_id": "65905c25-7b32-30fe-8d6f-7bedd3cbd260",
                        "glosses": [
                            "luidsprekers die in een auto gemonteerd zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1df4691-ed90-4088-948f-73aa63106f88",
                                "sense_id": "9747771f-0c3b-34f0-b082-2a77c80d46b4",
                                "text": "„Ze zijn bang”, zegt hij als we weer in het autootje stappen. Het martelaarslied schalt uit de autoboxen. Zulqarnain slaat zich op de borst en zingt hard mee."
                            },
                            {
                                "example_id": "d25d446f-6d5c-475c-b8b3-3d8e9063c68e",
                                "sense_id": "9747771f-0c3b-34f0-b082-2a77c80d46b4",
                                "text": "De bewoners van de Moretuslei klagen over lawaai, vandalisme en het dealen van drugs aan de nachtwinkel. Er klinkt regelmatig luide muziek uit de autoboxen van de klanten en ze nemen het niet nauw met de parkeerregels."
                            }
                        ]
                    },
                    {
                        "sense_id": "91c56649-2f2a-3f6b-a4cc-2530cf568997",
                        "entry_id": "65905c25-7b32-30fe-8d6f-7bedd3cbd260",
                        "glosses": [
                            "ruimte waarin een auto geparkeerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5f4ebe1-3f57-45b2-97d1-ea668d6931b1",
                                "sense_id": "91c56649-2f2a-3f6b-a4cc-2530cf568997",
                                "text": "In de Schoolstraat brachten onbekenden diepe krassen aan op een auto. In de Geraardsbergsestraat werd schade aangericht aan verschillende autoboxen."
                            },
                            {
                                "example_id": "2253a915-e083-4d3b-a23d-fdd880333fd1",
                                "sense_id": "91c56649-2f2a-3f6b-a4cc-2530cf568997",
                                "text": "'De vandalen die inbraken in de autoboxen aan de Korte Magerstraat, zijn bijzonder gewelddadig tewerk gegaan', zegt lezer Xavier Roels."
                            }
                        ]
                    }
                ],
