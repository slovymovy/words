                    {
                        "translation_id": "881947c8-2766-4f26-af9b-09452c290ee1",
                        "source_entry_id": "adde3f4f-3f48-329a-9b71-79e0a136f369",
                        "source_sense_id": "dae4e8d8-d8ab-35c5-8280-2267ad1371af",
