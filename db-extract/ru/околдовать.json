                "senses": [
                    {
                        "sense_id": "d623c626-1039-3305-8405-e2ae8ca9a2ea",
                        "entry_id": "c8bbcec3-f0b0-30a2-9944-2b68f718488b",
                        "glosses": [
                            "to bewitch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6fb4434-f701-4bce-a4de-0ebc44bf1375",
                                "sense_id": "d623c626-1039-3305-8405-e2ae8ca9a2ea",
                                "text": "— Я бу́ду спать, а ты колдова́ть на ка́ртах ста́нешь. Подава́й сюда́ ка́рты, а то околду́ешь меня́.",
                                "translation": "\" If I go to sleep you'll bewitch me with the cards. Give me the cards, or you'll bewitch me.\"",
                                "english": "\" If I go to sleep you'll bewitch me with the cards. Give me the cards, or you'll bewitch me.\""
                            }
                        ]
                    }
                ],
