                                                "sense_id": "93ed9624-e7f7-352c-8251-730fa891d689",
                                                "text": "Pus was seeping out of the wound."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pus",
                                "target_lang_code": "en",
