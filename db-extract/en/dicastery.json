                                        "sense_id": "41f5f257-390f-3d4c-985c-62fe32ca64dd",
                                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                                        "glosses": [
                                            "ein vom Staat autorisiertes Kollegium von Rechtskundigen, das nicht eine Gerichtsbarkeit über einen bestimmten Bezirk ausübt, sondern im Auftrag und auf Ersuchen anderer Gerichte oder auch von Privatpersonen rechtliche Entscheidungen fällt"
                                        ],
                                        "tags": [
                                            "Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e8eb59-8b92-4a13-b737-49c665bcdb12",
                                                "sense_id": "41f5f257-390f-3d4c-985c-62fe32ca64dd",
                                                "text": "In Deutschland haben im Mittelalter viele juristische Fakultäten als „Dikasterium“ fungiert."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de48d728-097e-3a23-b39f-016943059661",
                                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                                        "glosses": [
                                            "jede höhere Ortsbehörde"
                                        ],
                                        "tags": [
                                            "Mittelalter",
                                            "frühe Neuzeit"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6554ee14-fde3-3443-92c7-ad219d1f2055",
                                        "entry_id": "2dd2e9bd-9224-3145-8916-b0b9475db619",
                                        "glosses": [
                                            "eine Behörde der römischen Kurie"
                                        ],
                                        "tags": [
                                            "Katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3481735d-a30d-457d-bc49-53b0223acf4a",
                                                "sense_id": "6554ee14-fde3-3443-92c7-ad219d1f2055",
                                                "text": "„Die Römische Kurie besteht aus den Behörden (Dikasterien) des Staatsekretariats, der Kongregationen, der Gerichte, der Räte und Ämter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
