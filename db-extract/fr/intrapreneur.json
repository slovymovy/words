                        "entry_id": "5c68e421-e054-3c6b-9c73-73ad97df11ff",
                        "glosses": [
                            "Employé qui entreprend un projet innovant à l’intérieur d’une grande société."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "88f22ba8-6120-4819-823c-93f3b3ba599f",
                                "sense_id": "13fc7ed2-1f02-3232-b8d5-2a35ebc6de61",
                                "text": "L’enjeu est extrême : un intrapreneur qui a investi toutes ses forces dans la bataille peut avoir perdu jusqu’à la volonté de se désencastrer de l’organisation qui l’accueille."
                            },
                            {
                                "example_id": "f7c8a79f-2dcf-434b-9645-e9c86cce829e",
                                "sense_id": "13fc7ed2-1f02-3232-b8d5-2a35ebc6de61",
                                "text": "Grâce au programme, Élodie se sent à présent mieux outillée pour continuer à avancer et si elle en doutait au début, elle sait désormais qu’elle est une intrapreneur accomplie."
                            }
                        ]
                    }
