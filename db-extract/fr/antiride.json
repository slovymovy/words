                    {
                        "sense_id": "559e97a5-ad22-33d8-816a-9a89612f4237",
                        "entry_id": "236923cc-9f90-3de3-9553-c81f73a1def4",
                        "glosses": [
                            "Qui réduit ou atténue les rides."
                        ],
                        "tags": [
                            "Cosmétologie"
                        ],
                        "examples": [
                            {
                                "example_id": "daa7bc20-bdb5-475e-abfb-bbac2dc5225f",
                                "sense_id": "559e97a5-ad22-33d8-816a-9a89612f4237",
                                "text": "Cette composition, préparée comme l’eau antiride avec le suc des plantes balsamiques orientales, détruit les rides et redonne au visage toute sa fraîcheur et sa beauté."
                            },
                            {
                                "example_id": "80450703-cc41-488a-9426-73e7e9e791e5",
                                "sense_id": "559e97a5-ad22-33d8-816a-9a89612f4237",
                                "text": "L’huile essentielle de géranium rosat est antioxydante et antiride, c’est l’alliée des peaux grasses et elle prévient la chute des cheveux."
                            },
                            {
                                "example_id": "65cc4cbf-e9e1-45f8-8a7d-106745f6da1e",
                                "sense_id": "559e97a5-ad22-33d8-816a-9a89612f4237",
                                "text": "Cela reste toutefois un traitement préventif antiride, ou une excellente préparation à tout traitement antiride quand celles-ci sont bien installées."
                            }
                        ]
                    }
                ],
