                        "cross_references": [
                            {
                                "target_word": "quokka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd1e7bf-5518-3881-9964-d7349d7a852b",
                                        "entry_id": "928a32e5-bdf9-3d12-96b8-0282f301ab8b",
                                        "glosses": [
                                            "A cat-sized wallaby, Setonix brachyurus, of southwestern Australia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4984096b-ed11-4255-9bce-3c919a208d77",
                                                "sense_id": "7dd1e7bf-5518-3881-9964-d7349d7a852b",
                                                "text": "At least 673 quokkas were re-introduced from Rottnest Island to the Marsupial Research Station of the University of Western Australia (254 ha) at Jandakot from 1972 to 1988."
                                            },
                                            {
                                                "example_id": "bda01a40-dfba-444d-9c44-211ae6120772",
                                                "sense_id": "7dd1e7bf-5518-3881-9964-d7349d7a852b",
                                                "text": "Tammars, quokkas and black-footed rock wallabies inhabit islands in the southwest, while three species of hare wallaby, the burrowing bettong and five species of rock wallaby inhabit various islands in the northwest."
                                            },
                                            {
                                                "example_id": "b6bb56db-0e0b-472c-98d9-436a146753de",
                                                "sense_id": "7dd1e7bf-5518-3881-9964-d7349d7a852b",
                                                "text": "Older unburnt areas (more than 25 years) on their own appear unable to sustain a quokka population.\nThe largest number of quokkas occurs on Rottnest Island near Perth, where the population estimates vary from 8000 to 12,000 individuals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
