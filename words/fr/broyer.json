    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e8ea680-6633-35f5-9ed5-51bfba661696",
                    "sense_definition": "Réduire une matière solide en petites parcelles, en poudre ou en pâte par une forte pression.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ecraser_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette machine permet de <w>broyer</w> les grains de café très finement en quelques secondes."
                        },
                        {
                            "text": "Le robot culinaire sert à <w>broyer</w> des noisettes et des amandes pour préparer le gâteau."
                        }
                    ],
                    "synonyms": [
                        "émietter",
                        "moudre",
                        "piler",
                        "pulvériser",
                        "triturer"
                    ],
                    "common_phrases": [
                        "broyer des graines",
                        "broyer du grain"
                    ]
                },
                {
                    "sense_id": "fb2d6322-4ee3-3925-8109-1baf9b0d64ec",
                    "sense_definition": "Détruire, anéantir ou briser complètement par la force, au sens propre comme au sens figuré.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detruire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux mur a été entièrement <w>broyé</w> par la chute du grand arbre pendant la tempête."
                        },
                        {
                            "text": "Cette succession d'échecs a fini par <w>broyer</w> tout son enthousiasme et sa confiance."
                        }
                    ]
                },
                {
                    "sense_id": "e0852a68-16e2-3c9b-9a7c-bbbfd77843b1",
                    "sense_definition": "Presser ou serrer très fortement une partie du corps jusqu'à faire mal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ecraser_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il possède une telle poigne qu'il donne l'impression de vous <w>broyer</w> la main en vous saluant."
                        },
                        {
                            "text": "Le mécanisme défectueux s'est refermé brutalement et a failli lui <w>broyer</w> les doigts."
                        }
                    ],
                    "common_phrases": [
                        "broyer la main",
                        "broyer les doigts"
                    ]
                },
                {
                    "sense_id": "1da63cd7-0c75-3a3c-823b-dbd4f6c62f78",
                    "sense_definition": "Pulvériser des pigments colorants tout en les mélangeant à un liant pour confectionner de la peinture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "peinture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste préfère <w>broyer</w> lui-même ses pigments minéraux avec de l'huile de lin."
                        },
                        {
                            "text": "Dans son atelier d'art, elle <w>broie</w> les couleurs naturelles sur une plaque de marbre."
                        }
                    ],
                    "synonyms": [
                        "pulvériser",
                        "triturer"
                    ],
                    "common_phrases": [
