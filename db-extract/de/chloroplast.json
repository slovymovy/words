                "senses": [
                    {
                        "sense_id": "52b01bc6-5767-32a4-8b84-268f9c493dae",
                        "entry_id": "af75dde5-e267-3a61-9708-6d36baa66a09",
                        "glosses": [
                            "ein Organell der Zellen von Grünalgen und höheren Pflanzen, das Photosynthese betreibt"
                        ],
                        "tags": [
                            "Zytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "863f11bc-0f6d-416d-8e4e-0579bd6b7758",
                                "sense_id": "52b01bc6-5767-32a4-8b84-268f9c493dae",
                                "text": "„In den Zellen grüner Pflanzen sind stets Plastiden vorhanden. […] Sie treten in folgenden Formen auf: als Proplastiden in jungen Zellen; als ebenfalls farblose Leukoplasten in unterirdischen Organen; als chlorophyllhaltige Chloroplasten in Laubblättern und Sprossen, wo sie als Organell der Photosynthese fungieren; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f86d684e-2665-46f3-976f-f21175528ea0",
                        "source_entry_id": "af75dde5-e267-3a61-9708-6d36baa66a09",
                        "source_sense_id": "52b01bc6-5767-32a4-8b84-268f9c493dae",
                        "source_sense_description": "Zytologie: ein Organell der Zellen von Grünalgen und höheren Pflanzen, das Photosynthese betreibt",
                        "target_lang_word": "chloroplast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloroplast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc99ec6d-f4d4-317f-ac31-a0e7f6f64512",
                                        "entry_id": "a8ed7bcc-11ce-3c2c-9c53-0c2c515a86bc",
                                        "glosses": [
                                            "An organelle, found in the cells of green plants and in photosynthetic algae, where photosynthesis takes place, characterized by a high concentration of chlorophyll and two membranes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "456cbcf2-75f7-4d79-9590-0806397d7ee4",
                        "source_entry_id": "af75dde5-e267-3a61-9708-6d36baa66a09",
                        "source_sense_id": "52b01bc6-5767-32a4-8b84-268f9c493dae",
                        "source_sense_description": "Zytologie: ein Organell der Zellen von Grünalgen und höheren Pflanzen, das Photosynthese betreibt",
                        "target_lang_word": "chloroplaste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloroplaste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                        "entry_id": "cfce3b1c-98e3-3ee5-884b-5249b477798e",
                                        "glosses": [
                                            "Organite des cellules eucaryotes photosynthétiques (comme celles des plantes et des algues), contenant de la chlorophylle et d’autres pigments, où se déroule la photosynthèse ainsi que diverses synthèses métaboliques (sucres, lipides, acides aminés)."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Biologie cellulaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd669cd9-8f7b-4447-a485-6049cd2f0ba7",
                                                "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                                "text": "Le mode vie autotrophique des plantes repose entièrement sur l'intégrité du chloroplaste et notamment l'étape de la biogénèse"
                                            },
                                            {
                                                "example_id": "11218e2d-8364-4666-96fd-49f07316bbc8",
                                                "sense_id": "3b4a1cb1-c96a-3ecb-b8c3-e954575df85a",
                                                "text": "Au sein des cellules vertes de la feuille, la photosynthèse se déroule à l'intérieur de nombreux petits grains qui concentrent ce vert, les chloroplastes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
