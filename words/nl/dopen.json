{
    "word_family": [
        "doop",
        "doopsel",
        "doper",
        "doopvont",
        "herdoop",
        "vuurdoop"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80f45bf4-040c-35de-a563-8c32f745a406",
                    "sense_definition": "iemand ritueel met water besprenkelen of erin onderdompelen en zodoende tot een geloof toelaten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ouders lieten hun kind in de kerk <w>dopen</w> door de priester.",
                            "target_lang_translations": {
                                "en": "The parents had their child <w>baptized</w> in the church by the priest.",
                                "pl": "Rodzice pozwolili księdzu <w>ochrzcić</w> swoje dziecko w kościele."
                            }
                        },
                        {
                            "text": "Zij werd op volwassen leeftijd <w>gedoopt</w> na een lange voorbereiding.",
                            "target_lang_translations": {
                                "en": "She was <w>baptized</w> as an adult after a long preparation.",
                                "pl": "Została <w>ochrzczona</w> w wieku dorosłym po długim przygotowaniu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de kerk dopen",
                        "met water dopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to ritually sprinkle someone with water or immerse them in it and thereby admit them to a faith",
                        "pl": "rytualne polanie kogoś wodą lub zanurzenie w niej w celu przyjęcia do wspólnoty religijnej"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baptize",
                                "target_lang_sense_clarification": "religious ritual"
                            },
                            {
                                "target_lang_word": "baptise",
                                "target_lang_sense_clarification": "religious ritual (British spelling)"
                            },
                            {
                                "target_lang_word": "christen",
                                "target_lang_sense_clarification": "specifically in a Christian context"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chrzcić",
                                "target_lang_sense_clarification": "udzielać sakramentu chrztu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90e03fb2-2e39-33c6-a464-7dfbfa236e4f",
                    "sense_definition": "iets kortstondig in een vloeistof onderdompelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vloeistof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vind het heerlijk om mijn koekje in de thee te <w>dopen</w>.",
                            "target_lang_translations": {
                                "en": "I love <w>dipping</w> my cookie in the tea.",
                                "pl": "Uwielbiam <w>maczać</w> ciastko w herbacie."
                            }
                        },
                        {
                            "text": "Je moet de kwast eerst in de verf <w>dopen</w> voordat je begint.",
                            "target_lang_translations": {
                                "en": "You must first <w>dip</w> the brush into the paint before you start.",
                                "pl": "Zanim zaczniesz, musisz najpierw <w>zanurzyć</w> pędzel w farbie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de saus dopen",
                        "in de verf dopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to briefly submerge something in a liquid",
                        "pl": "krótkotrwałe zanurzenie czegoś w cieczy"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dip",
                                "target_lang_sense_clarification": "briefly submerge"
                            },
                            {
                                "target_lang_word": "dunk",
                                "target_lang_sense_clarification": "informal, often with food"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "maczać",
                                "target_lang_sense_clarification": "zanurzać na chwilę w płynie"
                            },
                            {
                                "target_lang_word": "zanurzać",
                                "target_lang_sense_clarification": "umieszczać w cieczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e11dcaba-f7b7-3b0e-8023-c30ff62197a0",
                    "sense_definition": "een officiële naam geven aan een object of persoon, vaak tijdens een ceremonie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naamgeving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het nieuwe schip werd plechtig <w>gedoopt</w> met de naam de Volharding.",
                            "target_lang_translations": {
                                "en": "The new ship was solemnly <w>christened</w> with the name 'de Volharding'.",
                                "pl": "Nowy statek został uroczyście <w>ochrzczony</w> imieniem Volharding."
                            }
                        },
                        {
                            "text": "Zij besloten hun pasgeboren dochter naar haar grootmoeder te <w>dopen</w>.",
                            "target_lang_translations": {
                                "en": "They decided to <w>name</w> their newborn daughter after her grandmother.",
                                "pl": "Postanowili <w>nazwać</w> swoją nowo narodzoną córkę imieniem babci."
                            }
                        }
                    ],
                    "synonyms": [
                        "noemen"
                    ],
                    "common_phrases": [
                        "een schip dopen",
                        "naar iemand dopen"
                    ],
                    "target_lang_definitions": {
                        "en": "to give an official name to an object or person, often during a ceremony",
                        "pl": "nadanie oficjalnej nazwy obiektowi lub osobie, często podczas ceremonii"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "christen",
                                "target_lang_sense_clarification": "naming a ship or baby"
                            },
                            {
                                "target_lang_word": "name",
                                "target_lang_sense_clarification": "to give a name to"
                            },
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to refer to by a name"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chrzcić",
                                "target_lang_sense_clarification": "nadawać imię (np. statkowi)"
                            },
                            {
                                "target_lang_word": "nazywać",
                                "target_lang_sense_clarification": "nadawać imię osobie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f76b1324-97b7-38f8-bfc9-8737c0b8228f",
                    "sense_definition": "een vaak onaangenaam inwijdingsritueel uitvoeren bij nieuwe leden van een vereniging",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ritueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De studentenvereniging gaat de nieuwe eerstejaars volgende week <w>dopen</w>.",
                            "target_lang_translations": {
                                "en": "The student association is going to <w>haze</w> the new freshmen next week.",
                                "pl": "Stowarzyszenie studenckie zamierza w przyszłym tygodniu przeprowadzić <w>otrzęsiny</w> dla nowych studentów pierwszego roku."
                            }
                        },
                        {
                            "text": "Tijdens de ontgroening werden de schachten op een harde manier <w>gedoopt</w>.",
                            "target_lang_translations": {
                                "en": "During the hazing, the pledges were <w>initiated</w> in a harsh manner.",
                                "pl": "Podczas otrzęsin nowi studenci byli w surowy sposób <w>inicjowani</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nieuwe leden dopen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "voornamelijk gebruikt in de context van studentenverenigingen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to perform an often unpleasant initiation ritual for new members of an association",
                        "pl": "przeprowadzenie często nieprzyjemnego rytuału inicjacyjnego dla nowych członków stowarzyszenia"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "haze",
                                "target_lang_sense_clarification": "unpleasant initiation ritual"
                            },
                            {
                                "target_lang_word": "initiate",
                                "target_lang_sense_clarification": "general term for joining a group"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "otrzęsiny",
                                "target_lang_sense_clarification": "rytuał przyjęcia nowych członków"
                            },
                            {
                                "target_lang_word": "inicjować",
                                "target_lang_sense_clarification": "przyjmować do grupy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "104061a0-690f-334d-839e-5a5a63feb6c4",
                    "sense_definition": "meervoud van <w>doop</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er vonden die zondag drie verschillende <w>dopen</w> plaats in de kathedraal.",
                            "target_lang_translations": {
                                "en": "Three different <w>baptisms</w> took place in the cathedral that Sunday.",
                                "pl": "W tamtą niedzielę w katedrze odbyły się trzy różne <w>chrzty</w>."
                            }
                        },
                        {
                            "text": "De administratie van alle <w>dopen</w> wordt nauwkeurig bijgehouden in het register.",
                            "target_lang_translations": {
                                "en": "The records of all <w>baptisms</w> are accurately kept in the register.",
                                "pl": "Ewidencja wszystkich <w>chrztów</w> jest dokładnie prowadzona w rejestrze."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pluralis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of baptism",
                        "pl": "liczba mnoga od słowa chrzest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baptisms",
                                "target_lang_sense_clarification": "plural of the religious ceremony"
                            },
                            {
                                "target_lang_word": "christenings",
                                "target_lang_sense_clarification": "plural of naming ceremonies"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "chrzty",
                                "target_lang_sense_clarification": "liczba mnoga sakramentu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}