                        "meanderen"
                    ],
                    "common_phrases": [
                        "zich door het landschap slingeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "reflexive use"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To move or extend in a series of curves or bends."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wind",
                                "target_lang_sense_clarification": "following a path with many curves"
                            },
                            {
                                "target_lang_word": "meander",
                                "target_lang_sense_clarification": "of a river or path following a winding course"
                            },
                            {
                                "target_lang_word": "twist",
                                "target_lang_sense_clarification": "turning and curving"
                            }
                        ]
