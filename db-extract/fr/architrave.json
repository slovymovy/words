        "fr-extract.jsonl": [
            {
                "entry_id": "8e81c4d0-90cf-367e-8ab9-c17de016f54f",
                "word": "architrave",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "355c6d14-ac36-4299-ab72-de685b90b948",
                        "entry_id": "8e81c4d0-90cf-367e-8ab9-c17de016f54f",
                        "tags": [
                            "plural"
                        ],
                        "form": "architraves"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                        "entry_id": "8e81c4d0-90cf-367e-8ab9-c17de016f54f",
                        "glosses": [
                            "Partie de l’entablement posée immédiatement sur les colonnes et portant la frise et la corniche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5954da7-80dd-4f71-98f2-9ed2bd6b8175",
                                "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                                "text": "Dans la plupart des temples anciens, les architraves étaient d’un seul bloc de pierre ou de marbre, de l’axe d’une colonne à l’autre."
                            },
                            {
                                "example_id": "9e582f64-08f2-43dc-b211-952b322bd0d1",
                                "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                                "text": "Trois colonnes avaient succombé, emportant dans leur chute une partie de l’architrave…"
                            },
                            {
                                "example_id": "def9c3b4-ac44-4bf7-a344-aee630f27e3f",
                                "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                                "text": "Ô Archégète, idéal que l’homme de génie incarne en ses chefs-d’œuvre, j’aime mieux être le dernier dans ta maison que le premier ailleurs. Oui, je m’attacherai au stylobate de ton temple ; j’oublierai toute discipline hormis la tienne, je me ferai stylite sur tes colonnes, ma cellule sera sur ton architrave."
                            },
                            {
                                "example_id": "722c4b48-f372-40db-9404-9224ae4642c6",
                                "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                                "text": "Le peuple de Corinthe lui éleva un monument de son vivant avec ces mots gravés sur l’architrave: « À Laïs bienfaisante, le peuple de Corinthe reconnaissant »."
                            },
                            {
                                "example_id": "645150b5-3055-4bb0-a4fd-d94bd555646c",
                                "sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                                "text": "… et le troupeau mongol suit son chef de file vers un bel arc de triomphe de granit dont les architraves relèvent leurs extrémités arquées vers le ciel avec une grâce chinoise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5971a6f8-f241-47bf-81b8-fd9df73e20de",
                        "source_entry_id": "8e81c4d0-90cf-367e-8ab9-c17de016f54f",
                        "source_sense_id": "24b00d2b-39c9-30d8-be9e-95ebe487fc92",
                        "source_sense_description": "Partie de l’entablement",
                        "target_lang_word": "Architrav",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Architrav",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8cf7b1-2958-3723-b587-382d5942d4b6",
                                        "entry_id": "d52946bd-671c-31df-9728-4ad2b80d3652",
                                        "glosses": [
                                            "in der antiken Baukunst ein Querbalken, der die Säulen im Unterbau verbindet und den Oberbau trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "153f34bc-0ac7-41cf-a2e9-d2c4448b9f37",
                                                "sense_id": "9d8cf7b1-2958-3723-b587-382d5942d4b6",
                                                "text": "„Dieses Ufer von fremdartiger Schönheit besteht aus einer langen Reihe fast 10 m hoher Basaltsäulen, über denen basaltene Architrave liegen, die zum Wasser hin leicht vorspringen.“"
                                            },
                                            {
                                                "example_id": "edecef31-bc04-4204-801b-f20e1e1ad43f",
                                                "sense_id": "9d8cf7b1-2958-3723-b587-382d5942d4b6",
                                                "text": "„Wände, Säulen und Architrave aus lebendigem Feuer flammten strahlend um die Stelle, wo ich in der Luft zu schweben schien, und wuchsen zu einem unendlich hohen Dom von unbeschreiblicher Pracht empor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b09f374-3b5e-4158-815a-199cc727be12",
                        "source_entry_id": "8e81c4d0-90cf-367e-8ab9-c17de016f54f",
