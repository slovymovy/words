                                        "entry_id": "f0146859-7118-3f7c-be02-00a43a05294b",
                                        "glosses": [
                                            "Piedra caliza, muy porosa y ligera, que las aguas de ciertos manantiales depositan en el suelo o sobre las plantas u otras cosas que hallan a su paso."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9380926-cd2b-49f7-a028-43ab548851ae",
                                                "sense_id": "26503f17-ab65-38cb-867d-40fb2911adae",
                                                "text": "Habían bajado unos veinte pies y se encontraban dentro de una cámara cuadrada, excavada en la blanda toba."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
