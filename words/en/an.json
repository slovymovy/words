        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "213a319d-0128-33b8-b003-d659df0cfb11",
                    "sense_definition": "In each; to or for each; per.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car was traveling at sixty miles <w>an</w> hour.",
                            "target_lang_translations": {
                                "ru": "Машина ехала со скоростью шестьдесят миль <w>в</w> час.",
                                "nl": "De auto reed met een snelheid van zestig mijl <w>per</w> uur.",
                                "pl": "Samochód jechał z prędkością sześćdziesięciu mil <w>na</w> godzinę.",
                                "de": "Das Auto fuhr mit sechzig Meilen <w>pro</w> Stunde.",
                                "fr": "La voiture roulait à soixante miles <w>par</w> heure.",
                                "it": "L'auto viaggiava a sessanta miglia <w>all'</w>ora.",
                                "cs": "Auto jelo rychlostí šedesát mil <w>za</w> hodinu.",
                                "tr": "Araba saatte <w>altmış</w> mil hızla gidiyordu.",
                                "es": "El coche viajaba a sesenta millas <w>por</w> hora.",
                                "zh": "那辆车正以<w>每</w>小时六十英里的速度行驶。"
                            }
                        },
                        {
                            "text": "These specialized herbs cost five dollars <w>an</w> ounce.",
                            "target_lang_translations": {
                                "ru": "Эти особые травы стоят пять долларов <w>за</w> унцию.",
                                "nl": "Deze speciale kruiden kosten vijf dollar <w>per</w> ounce.",
                                "pl": "Te specjalistyczne zioła kosztują pięć dolarów <w>za</w> uncję.",
                                "de": "Diese speziellen Kräuter kosten fünf Dollar <w>pro</w> Unze.",
                                "fr": "Ces herbes spécialisées coûtent cinq dollars <w>l'</w>once.",
                                "it": "Queste erbe speciali costano cinque dollari <w>all'</w>oncia.",
                                "cs": "Tyto speciální bylinky stojí pět dolarů <w>za</w> unci.",
                                "tr": "Bu özel otların onsu <w>beş</w> dolar.",
                                "es": "Estas hierbas especializadas cuestan cinco dólares <w>la</w> onza.",
                                "zh": "这些特种草药<w>按</w>盎司计价，每盎司五美元。"
                            }
                        }
                    ],
