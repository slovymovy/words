                        "sense_id": "2366424f-19ea-3637-a05c-c475972e6667",
                        "entry_id": "ac09e444-67fe-37f0-979c-6dcf71c153d9",
                        "glosses": [
                            "Manque de courtoisie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd6d4af1-a0c6-475c-a717-8feea6c0b27d",
                                "sense_id": "2366424f-19ea-3637-a05c-c475972e6667",
                                "text": "Alors la discourtoisie du contrôleur s’exhala en propos blasphématoires, où le nom de Notre-Seigneur se trouvait fâcheusement mêlé"
                            },
                            {
                                "example_id": "d632761c-d6b8-460d-b173-4b91dd27743b",
                                "sense_id": "2366424f-19ea-3637-a05c-c475972e6667",
                                "text": "Quand un collectionneur désire vous montrer sa dernière acquisition, il y aurait de la discourtoisie et même un peu d’irrévérence à ne pas marquer d’empressement."
                            },
                            {
                                "example_id": "917bc7de-ed7b-4bf5-bebd-50c3027156d0",
                                "sense_id": "2366424f-19ea-3637-a05c-c475972e6667",
                                "text": "Au-delà de la discourtoisie que cela dénote, c'est d'un grand mépris pour les 350 000 habitants que je représente."
                            }
                        ]
                    }
