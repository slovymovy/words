                                "example_id": "194ed45e-6bba-42e3-a682-cfedab926afe",
                                "sense_id": "af061794-627e-3063-a9d7-a13966f1941e",
                                "text": "„So bedeutet ‚tabu‘ auf Fidschi ungesetzlich, heilig und überragend gut; ‚tabaka‘ auf Malagassi meint profaniert, verunreinigt […]“"
                            }
