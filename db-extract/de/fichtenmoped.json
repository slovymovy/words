                "senses": [
                    {
                        "sense_id": "3db88056-1f36-399b-9fbf-010a851acd7e",
                        "entry_id": "7031c654-a6c2-39d6-84f3-440afb3802e5",
                        "glosses": [
                            "tragbare Motorsäge mit umlaufender Kette, die kleine Metallzähne als Glieder hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bf2f7fee-20da-4c41-966e-058e29f731e0",
                                "sense_id": "3db88056-1f36-399b-9fbf-010a851acd7e",
                                "text": "„Danach folgten die Bewerbe mit der Motorsäge. Beginnend mit dem Kettenwechsel bewiesen die Teilnehmer wie gut sie mit dem ‚Fichtenmoped‘ umgehen können.“"
                            },
                            {
                                "example_id": "4d84a5e2-05a8-4f87-a880-12bb941a5acf",
                                "sense_id": "3db88056-1f36-399b-9fbf-010a851acd7e",
                                "text": "„Als sie spüren, dass vor lauter Raummeter die Muskelkraft zu erschlaffen droht, schaffen sie mit eigenem Geld dann doch ein ‚Fichtenmoped‘ an, eine Motorsäge.“"
                            },
                            {
                                "example_id": "370484e6-b1ec-4f5d-b345-95177cd31995",
                                "sense_id": "3db88056-1f36-399b-9fbf-010a851acd7e",
                                "text": "„Doch auch in jedem Holzbalken steckt – fossile – Energie – vom Fichtenmoped über den Transport bis zu Holztrocknung und Sägewerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
