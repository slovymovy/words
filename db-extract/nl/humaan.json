                    },
                    {
                        "sense_id": "2846c691-802f-3f44-b197-9475efb61579",
                        "entry_id": "8075a023-06bd-36cc-83e7-4ab734c70c04",
                        "glosses": [
                            "voorzien van de meest positieve eigenschappen van bovengenoemde diersoort"
                        ],
                        "tags": [],
