{
    "word_family": [
        "derogation",
        "derogatory",
        "derogatorily"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "11c55eac-2da5-343f-8957-cb29485a9a9f",
                    "sense_definition": "To express a low opinion of someone or something; to belittle or disparage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is unfair to <w>derogate</w> the hard work of others just because you disagree with their methods."
                        },
                        {
                            "text": "The manager was warned not to <w>derogate</w> his colleagues during the team meeting."
                        }
                    ],
                    "synonyms": [
                        "vilify",
                        "depreciate",
                        "decry"
                    ],
                    "antonyms": [
                        "praise#Verb",
                        "laud#Verb",
                        "glorify"
                    ]
                },
                {
                    "sense_id": "38e3cb10-3273-340e-af16-ac70601458bf",
                    "sense_definition": "To reduce the value, authority, or quality of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disparage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such unprofessional behavior <w>derogates</w> from the reputation of the entire organization."
                        },
                        {
                            "text": "The new policy <w>derogates</w> from the authority previously held by the local council."
                        }
                    ],
                    "common_phrases": [
                        "derogate from"
                    ]
                },
                {
                    "sense_id": "f6a93817-403f-33cc-bfe0-bfd0dacade42",
                    "sense_definition": "To behave in a way that is unworthy of one's status or character.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that accepting such a menial task would <w>derogate</w> from his noble standing."
                        },
                        {
                            "text": "A true leader should never <w>derogate</w> by engaging in petty public arguments."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in formal or literary contexts regarding social status."
                        }
                    ]
                },
                {
                    "sense_id": "2cc1bc80-79c8-3b50-b975-c46f21a11db6",
                    "sense_definition": "To partially repeal or modify a law or formal agreement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new amendment <w>derogates</w> the previous statute regarding property rights."
                        },
                        {
                            "text": "The treaty was <w>derogated</w> by the subsequent signing of the emergency protocol."
                        }
                    ]
                }
            ]
        }
    ]
}