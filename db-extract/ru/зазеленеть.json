                                                "example_id": "0c68b4ee-dfff-4920-9b43-a6ff8b883ee0",
                                                "sense_id": "5ad6e9eb-d195-3db9-9029-9095dcbcc333",
                                                "text": "„Zum Vergleich wurde die stark verfärbte Fichte, von der die Pfropfreiser stammten, und eine nach Düngung mit Patentkali (12) ergrünte Fichte untersucht.“"
                                            },
                                            {
                                                "example_id": "d415cb91-f261-443e-b576-ac02f60ce862",
                                                "sense_id": "5ad6e9eb-d195-3db9-9029-9095dcbcc333",
                                                "text": "„Halt! Was machst du da? Chorführerin: Ich netz’ dich, daß du frisch ergrünst!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
