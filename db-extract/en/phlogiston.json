    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a75a431d-d884-3da7-be78-ed87bc8a55b9",
                "word": "phlogiston",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "990d4d1a-8c75-46f5-bd81-c1c77b141f86",
                        "entry_id": "a75a431d-d884-3da7-be78-ed87bc8a55b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "phlogistons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f4e5476-b9f5-37d2-a9c1-1cf0b0f744ec",
                        "entry_id": "a75a431d-d884-3da7-be78-ed87bc8a55b9",
                        "glosses": [
                            "The hypothetical fiery principle formerly assumed to be a necessary constituent of combustible bodies and to be given up by them in burning."
                        ],
                        "tags": [
                            "historical",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1579390a-bcf4-42ae-913e-0d3e82bbc90a",
                                "sense_id": "4f4e5476-b9f5-37d2-a9c1-1cf0b0f744ec",
                                "text": "[…] air was universally reputed to be a simple or elementary body. It was liable, according to the phlogistians, to vitiation, by the addition to it of phlogiston[…] being more or less phlogisticated, according to the degree of its power to support respiration and combustion."
                            },
                            {
                                "example_id": "bd2d3b41-7919-4d79-a5fe-e337c1db79ae",
                                "sense_id": "4f4e5476-b9f5-37d2-a9c1-1cf0b0f744ec",
                                "text": "Stahl argued that phlogiston could explain combustion, a central concern of eighteenth-century chemistry."
                            }
                        ]
                    }
                ],
