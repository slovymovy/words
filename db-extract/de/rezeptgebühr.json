                        "examples": [
                            {
                                "example_id": "ab621653-f690-43cd-8f6a-bef32b36875b",
                                "sense_id": "271e5abc-c8be-3eb0-8d35-2d19bb6d5c9b",
                                "text": "„Für jedes auf einem Rezept verordnete und auf Rechnung des Versicherungsträgers bezogene Heilmittel ist als Kostenbeteiligung eine Rezeptgebühr in der Höhe von 5,30 € zu zahlen“"
                            },
                            {
                                "example_id": "8a119d70-5e61-476f-aaca-c53c6690c69a",
                                "sense_id": "271e5abc-c8be-3eb0-8d35-2d19bb6d5c9b",
                                "text": "„Bei Überschreiten einer monatlichen Belastungsgrenze können auch Versicherte, die nicht von der Rezeptgebühr befreit sind, Beträge zurückgezahlt oder nachgesehen bekommen.“"
                            },
                            {
                                "example_id": "5f2c0106-f33a-4bda-80d9-d37b577643a2",
                                "sense_id": "271e5abc-c8be-3eb0-8d35-2d19bb6d5c9b",
                                "text": "„Das fängt bei Rezeptgebühren an und hört bei dem Tagegeld für Krankenhausaufenthalte noch lange nicht auf.“"
                            }
                        ],
