                            {
                                "example_id": "62028906-faff-4083-bb2b-f8feff12c1b3",
                                "sense_id": "36b11774-d27f-3b29-ad6d-5955d7fbebf4",
                                "text": "J'en ai ras-le-bol !",
                                "translation": "I've had enough (of this)!",
                                "english": "I've had enough (of this)!"
                            },
                            {
                                "example_id": "898876cb-3081-4aba-871a-5f6d89d6cf3c",
                                "sense_id": "36b11774-d27f-3b29-ad6d-5955d7fbebf4",
                                "text": "Comme tu veux, vas-y, vas-y comme tu veux ! Fais jaillir le ras-l'-bol à ras-bord qui prend feu.",
                                "translation": "Like you want to, go on, go on, like you want to! Let the brimming, burning frustration burst out!",
                                "english": "Like you want to, go on, go on, like you want to! Let the brimming, burning frustration burst out!"
                            }
                        ]
                    }
