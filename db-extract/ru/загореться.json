                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "292d026f-8da9-42a4-9828-a08da02ef111",
                                "sense_id": "5acbd3d8-516a-302b-b997-42153db41181",
                                "text": "на прибо́рной пане́ли загоре́лась кра́сная ла́мпочка",
                                "translation": "a red light lit up on the instrument panel",
                                "english": "a red light lit up on the instrument panel"
