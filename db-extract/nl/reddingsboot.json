                        "entry_id": "c060ad88-7800-317b-8435-f8c3dcdc8bbc",
                        "glosses": [
                            "a lifeboat, a boat to save people at sea or in deep internal waters"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "e95345eb-329c-49ed-89eb-123d6356377b",
                                "sense_id": "26571f23-6048-3bc0-8bfa-a0cff08382af",
                                "text": "De reddingsboot werd snel gelanceerd om de drenkelingen te redden.",
                                "translation": "The lifeboat was quickly launched to rescue the drowning people.",
                                "english": "The lifeboat was quickly launched to rescue the drowning people."
                            },
                            {
                                "example_id": "1e27d226-7186-4ea3-95c7-601f3202dc0c",
                                "sense_id": "26571f23-6048-3bc0-8bfa-a0cff08382af",
                                "text": "De bemanning van de reddingsboot riskeerde hun leven om de schipbreukelingen te redden.",
                                "translation": "The crew of the rescue boat risked their lives to save the shipwreck survivors.",
                                "english": "The crew of the rescue boat risked their lives to save the shipwreck survivors."
                            },
                            {
                                "example_id": "6e8fe6d8-5a5d-4950-81f2-a00e2e88bc0b",
                                "sense_id": "26571f23-6048-3bc0-8bfa-a0cff08382af",
                                "text": "De kustwacht ontving een noodoproep en stuurde onmiddellijk een reddingsboot naar de locatie.",
                                "translation": "The coast guard received a distress call and immediately sent a lifeboat to the location.",
                                "english": "The coast guard received a distress call and immediately sent a lifeboat to the location."
                            }
                        ]
                    }
