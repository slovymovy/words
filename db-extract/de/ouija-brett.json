                        "sense_id": "fb58542a-30cb-3e03-aa3c-d1c6d145a593",
                        "entry_id": "d493b965-167b-3243-b73a-829585a219fa",
                        "glosses": [
                            "mit Buchstaben beschriebenes Brett, das angeblich das Kommunizieren mit Toten ermöglicht"
                        ],
                        "tags": [
                            "Esoterik"
                        ],
                        "examples": [
                            {
                                "example_id": "4620fbbb-3df2-4a88-83f7-12b12c272dba",
                                "sense_id": "fb58542a-30cb-3e03-aa3c-d1c6d145a593",
                                "text": "„Die Ehefrau des U-Boot-Kommandanten und der Vater eines der Besatzungsmitglieder kamen zu Klausner, und sie rief die Mannschaft in einer Séance herbei. Sie saß mit ihren Gästen in einem abgedunkelten Raum und bediente sich eines Ouija-Bretts, um verschiedene technische Aspekte des vermissten U-Boots zu beschreiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7dd76299-e6c3-4e66-b452-6e8a576ecdac",
                        "source_entry_id": "d493b965-167b-3243-b73a-829585a219fa",
