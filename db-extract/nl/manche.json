                "senses": [
                    {
                        "sense_id": "67a9a93f-c6fd-359a-9e17-2c0bd99aed25",
                        "entry_id": "6a12f058-7c0f-33f3-87d1-dd34450d5ed0",
                        "glosses": [
                            "deel van een wedstrijdreeks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14f846b6-8330-45cc-bef4-b72c5ea58d62",
                                "sense_id": "67a9a93f-c6fd-359a-9e17-2c0bd99aed25",
                                "text": "Herzog leidde vanaf de eerste manche zaterdag op de 500 meter."
                            },
                            {
                                "example_id": "a21e5d26-3b30-4eb5-bd73-d2db5f37a2f3",
                                "sense_id": "67a9a93f-c6fd-359a-9e17-2c0bd99aed25",
                                "text": "Sajati won in 2'6\", Soekessi 2de, twee paardenlengten achter, Keno 3de, Sangket 4de. Toen de tweede \"manche\" van dezen robber gespeeld werd scheen het dat Keno betere kaarten gekregen had. Zij was onmiddellijk vóór met Soekessi achter zich en Sajati en Sanket, naast elkander, weder daarachter."
                            },
                            {
                                "example_id": "8e822b9d-b533-4b16-ad32-4178060bfced",
                                "sense_id": "67a9a93f-c6fd-359a-9e17-2c0bd99aed25",
                                "text": "Het Whist-concours zal plaats hebben op Woensdag 9 en Maandag 14 November. Er wordt gespeeld \"whist par préférence\" met den \"blinde\". Honneurs worden gerekend, zonder den trek is men echter noch in de eerste noch in de tweede manche uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "8843c33e-e1f1-3ae9-be2c-8aec1cd14f51",
                        "entry_id": "6a12f058-7c0f-33f3-87d1-dd34450d5ed0",
                        "glosses": [
                            "ronde die met een bepaald hoog puntental wordt afgesloten en daarom een extra waardering oplevert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb4819a-df25-472d-8fbd-df5acfb02fea",
                                "sense_id": "8843c33e-e1f1-3ae9-be2c-8aec1cd14f51",
                                "text": "Toen maakten wij drie klaveren maar onmiddellijk daarop maakten de anderen de manche in schoppen. De volgende manche maakten wij met vijf klaveren."
                            }
                        ]
                    }
