                                        "sense_id": "09f69b56-5c3c-3924-8783-42980d9c49ee",
                                        "entry_id": "4c746850-af74-3b73-83ab-d542c8574f25",
                                        "glosses": [
                                            "Société gérant les droits en matière de musique, en Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38691282-b651-47b4-8bb0-b5ece1aeab52",
                                                "sense_id": "09f69b56-5c3c-3924-8783-42980d9c49ee",
                                                "text": "Une majorité (71 %) des créateurs pense que l’intelligence artificielle les privera de leurs revenus et menace leur avenir, selon une étude dévoilée mardi par la Sacem et son pendant allemand, la GEMA."
                                            },
                                            {
                                                "example_id": "6b9826d9-71ab-42a8-95eb-fc77c0e171a4",
                                                "sense_id": "09f69b56-5c3c-3924-8783-42980d9c49ee",
                                                "text": "Avec des dépenses de fonctionnement d’un montant de 152,4 millions d’euros, la GEMA a pu maintenir le taux de frais à 14,7 % et nettement en dessous des prévisions."
                                            },
                                            {
                                                "example_id": "0187213e-3400-4928-a01e-1cd3a8b4cd22",
                                                "sense_id": "09f69b56-5c3c-3924-8783-42980d9c49ee",
                                                "text": "La société musicale GEMA s’est associée à la CISAC pour rédiger le site et aider les créateurs de musique germanophones à mieux comprendre les options dont ils disposent lorsqu’ils sont confrontés à des demandes de buyout de la part des utilisateurs de leurs œuvres."
                                            }
                                        ]
                                    }
