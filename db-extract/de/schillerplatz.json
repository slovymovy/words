                "senses": [
                    {
                        "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                        "entry_id": "01401135-3792-31a4-aa33-a0fc3dbedbaf",
                        "glosses": [
                            "Eigenname von Plätzen, häufiger Straßenname (Deutschland in 84 Orten, Österreich in 10 Orten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b93d72f0-8000-465e-ba4b-c13b54387d41",
                                "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                                "text": "Auf dem Schillerplatz findet zweimal wöchentlich ein Wochenmarkt statt. Viele Veranstaltungen, die primär auf dem Stuttgarter Marktplatz stattfinden, werden auf den Schillerplatz ausgedehnt, so beispielsweise der Stuttgarter Weihnachtsmarkt oder das Stuttgarter Weindorf."
                            },
                            {
                                "example_id": "9aaa9f00-c896-4724-85c7-e9f1ffd55de6",
                                "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                                "text": "Der Schillerplatz ist eines der Wahrzeichen der Stadt Cottbus. Anlässlich der 800-Jahrfeier der Stadt im Jahre 1956 wurde der Schillerplatz neu gestaltet und bis in die heutige Zeit hinein so unverändert erhalten."
                            },
                            {
                                "example_id": "b8e6a353-7aaa-4263-82b3-c88e0ef792b3",
                                "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                                "text": "Seit dem 1. April 1877 befindet sich die Akademie im Akademiegebäude am Schillerplatz im 1. Bezirk Wiens."
                            },
                            {
                                "example_id": "c6bdb6df-5fb2-4415-a45d-441e588f1334",
                                "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                                "text": "Ausgehend von Schillerstraße und Schillerplatz führt der nächste Rundgang durch das Gebiet der westlichen Altstadt. Der Schillerplatz ist neben dem Markt der zentrale Platz in der Innenstadt und führt auch auf die Lu."
                            },
                            {
                                "example_id": "8cd9162b-8bd9-430a-87c4-20deb9ce3aed",
                                "sense_id": "a78fe928-b34a-3b37-817e-30ef5820a59a",
                                "text": "Wir betreiben zwei Krippen in Schriesheim: am Schillerplatz und im Rindweg."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
