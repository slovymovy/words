                "senses": [
                    {
                        "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                        "entry_id": "6048a499-44b0-3777-906a-ccf501079704",
                        "glosses": [
                            "unkontrollierte Lufterneuerung im Raum oder Gebäude durch Undichtigkeiten oder Öffnungen"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "7cbb22a3-2858-49b5-9c12-0ad863bf94d3",
                                "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                                "text": "Die Querlüftung ist der Oberbegriff für die freie Lüftung von Räumen und Gebäuden durch die Fugenlüftung, die Fensterlüftung und die Schachtlüftung, ohne Ventilator."
                            },
                            {
                                "example_id": "cfc31afb-cf8f-42fd-a950-e8f7f9366a42",
                                "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                                "text": "„Bei Querlüftung durch mehrere Zimmer reichen maximal drei Minuten zum kompletten Luftaustausch.“"
                            },
                            {
                                "example_id": "37c7c262-14b9-4867-b792-507020e0484f",
                                "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                                "text": "„Die notwendige natürliche Lüftung wird als Querlüftung(Nord/Süd) dargestellt.“"
                            },
                            {
                                "example_id": "fc2fdfca-cdf7-4342-84dc-b4d9adcdd8fa",
                                "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                                "text": "„Im Sommer hängt die Wirksamkeit der Fensterlüftung zum größten Teil vom Windanfall ab, zu einem geringen Teil aber auch vom Temperaturunterschied zwischen den verschiedenen Seiten eines Hauses, der durch die Sonneneinstrahlung bewirkt wird (Querlüftung).“"
                            },
                            {
                                "example_id": "d3dd3f37-330b-426b-82f7-6a9d0147054f",
                                "sense_id": "eccc8e40-bf90-306e-9f06-5d20d990e9b0",
                                "text": "„Jedoch ist, wenn möglich, die Querlüftung der Einzelraumlüftung vorzuziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
