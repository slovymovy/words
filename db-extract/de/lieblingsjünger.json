                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f603d46e-6afe-4b81-962a-b56dfdabcd2a",
                        "source_entry_id": "4cad8b55-e11a-3081-809b-7f6df0b4b083",
                        "source_sense_id": "0fb18c5c-5453-3133-b3cf-caede73aeb7d",
                        "target_lang_word": "Beloved Disciple",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beloved Disciple",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da36953d-ed02-38c3-af1d-9d1052ffbe5e",
                                        "entry_id": "ea7919c8-ea15-38bf-9de2-35df3e807c9e",
                                        "glosses": [
                                            "A figure in the Gospel of John whose identity is left implicit within the text; traditionally, John the Evangelist himself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b19381fa-f2b6-4f65-a743-b97877af0598",
                                                "sense_id": "da36953d-ed02-38c3-af1d-9d1052ffbe5e",
                                                "text": "And the beloved''' Disciple fell down as dead at the appearance of Christ in his Glory."
                                            },
                                            {
                                                "example_id": "ffcc4ae0-a4f0-448a-97aa-b053baf05d20",
                                                "sense_id": "da36953d-ed02-38c3-af1d-9d1052ffbe5e",
                                                "text": "The idea of the almost immediate return of Christ to judgment still so far retains its force that the Beloved Disciple is represented as probably living to see it […]"
                                            },
                                            {
                                                "example_id": "b314172b-9f69-46db-ade8-940fde0ed2bd",
                                                "sense_id": "da36953d-ed02-38c3-af1d-9d1052ffbe5e",
                                                "text": "The question of the identification of the Beloved Disciple and that of the discovery of the author of the Gospel are not necessarily identical, for it is quite possible to argue, as we found Schmiedel doing just now, that the two were separate and distinct persons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
