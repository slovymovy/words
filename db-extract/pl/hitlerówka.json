                        "entry_id": "2b8bcb48-01bc-3106-b218-2430edbb3a5b",
                        "glosses": [
                            "droga wybudowana w czasach Hitlera charakteryzująca się nawierzchnią z betonowych płyt"
                        ],
                        "tags": [
