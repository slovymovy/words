    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a68a840e-4d23-3e8b-9ddf-87e9284394a3",
                "word": "grav",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "22f614fe-159d-4a5c-b0ee-a8186edd4079",
                        "entry_id": "a68a840e-4d23-3e8b-9ddf-87e9284394a3",
                        "tags": [
                            "plural"
                        ],
                        "form": "gravs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45c52054-cfcf-3f96-9d51-fe81cf2c4f42",
                        "entry_id": "a68a840e-4d23-3e8b-9ddf-87e9284394a3",
                        "glosses": [
                            "A unit of force or acceleration equal to the standard acceleration of free fall."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "179de240-a769-4efe-a4ac-1a2541cfb736",
                                "sense_id": "45c52054-cfcf-3f96-9d51-fe81cf2c4f42",
                                "text": "My heart was pounding as it pumped blood to my brain — no small job, considering my height and the gravs."
                            },
                            {
                                "example_id": "9b6aa0ef-9e5e-4025-b54e-2387b94dec3e",
                                "sense_id": "45c52054-cfcf-3f96-9d51-fe81cf2c4f42",
                                "text": "Proceed at a speed of four light years after accelerating thirteen gravs per millisecond.”"
                            },
                            {
                                "example_id": "5aff4fff-1014-4f77-a333-c3f8fc93375e",
                                "sense_id": "45c52054-cfcf-3f96-9d51-fe81cf2c4f42",
                                "text": ". “They're small, can maneuver faster than we can,”Clare said. “Accelerating at three gravs, too.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "38449456-1400-301f-840a-e6fbc104bdb4",
                        "entry_id": "a68a840e-4d23-3e8b-9ddf-87e9284394a3",
                        "glosses": [
                            "An artificial gravity generator."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2572b64-7980-4392-9d30-104043887491",
                                "sense_id": "38449456-1400-301f-840a-e6fbc104bdb4",
                                "text": "Since there is no such thing as top or bottom in space, the ship's artificial gravs hold you to the floor no matter which end of the vessel points which way."
                            },
                            {
                                "example_id": "a2f5e2f0-4f28-4a73-8c6a-9517c2e4c791",
                                "sense_id": "38449456-1400-301f-840a-e6fbc104bdb4",
                                "text": "... We will be going to low-gravity just before jump. Passengers should be firmly strapped in at this time.\" \"Good,\" murmured Muerotte. \"Cutting gravs...brace yourself."
                            },
                            {
                                "example_id": "c92afad8-b598-4ed1-a32f-5471af754e9a",
                                "sense_id": "38449456-1400-301f-840a-e6fbc104bdb4",
                                "text": "Trystin shut down the ventilation system and shifted the last of the power for gravs into the thrusters."
                            }
                        ]
                    },
                    {
                        "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                        "entry_id": "a68a840e-4d23-3e8b-9ddf-87e9284394a3",
                        "glosses": [
                            "An anti-gravity device."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63c3c2bc-f40f-4f9e-9023-08799ce55c3d",
                                "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                                "text": "A starship thundered invisibly close overhead, its gravs at full lift-off power."
                            },
                            {
                                "example_id": "2eb7d80c-f068-41c2-bc5d-9851f8564a63",
                                "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                                "text": "The orbot was a speck, a clot, a ball, a toy. It was gliding silently in on gravs, directly overhead."
                            },
                            {
                                "example_id": "c4099648-7de1-4a50-839d-f95d52230f51",
                                "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                                "text": "Air cars include any vehicle which are grav powered and are capable of flying, but unlike aeroplanes they handle similar to normal ground cars."
                            },
                            {
                                "example_id": "4561594b-91d6-438f-a720-5a4cfcffd5d4",
                                "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                                "text": "I set things up for the grav sled support and the Averonian operation."
                            },
                            {
                                "example_id": "a7ffd182-1b22-4386-afb0-21928efcaa4a",
                                "sense_id": "af8e4c52-cf99-3f14-b34d-877cd8ef73d9",
                                "text": "With the gravs, I can land in ten seconds and be cutting a door for you at the same time."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
