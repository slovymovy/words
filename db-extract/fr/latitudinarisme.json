                "senses": [
                    {
                        "sense_id": "82d7951d-176a-3662-bddb-0ef47f76c9e0",
                        "entry_id": "b8b21130-02cb-32ce-b8bb-da85c14447c7",
                        "glosses": [
                            "Œcuménisme, largesse d’esprit en matière d’opinions religieuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea38947-8a9b-4c1d-9a2b-0b9162362a4f",
                                "sense_id": "82d7951d-176a-3662-bddb-0ef47f76c9e0",
                                "text": "Le latitudinarisme, c’est le système d’après lequel chacun est libre de choisir la religion qui lui plaît."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87fc45a9-e33b-4cea-be75-17d88b0f7167",
                        "source_entry_id": "b8b21130-02cb-32ce-b8bb-da85c14447c7",
                        "source_sense_id": "82d7951d-176a-3662-bddb-0ef47f76c9e0",
                        "target_lang_word": "latitudinarianism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latitudinarianism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "362de3d2-e196-3798-bab6-3e8536a905f5",
                                        "entry_id": "4c982989-38bf-3afd-a6ac-a42b757e8f47",
                                        "glosses": [
                                            "Tolerance of other people's views, particularly in religious context."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "064ad623-c98d-489d-b157-a2a42a14cb30",
                                                "sense_id": "362de3d2-e196-3798-bab6-3e8536a905f5",
                                                "text": "It is for want of sufficiently investigating and allowing for this moral and political latitudinarianism of our enemies, that we are apt to be too precipitate in censuring the conduct of the war; and, in our estimation of what has been done, we pay too little regard to the principles by which we have been directed."
                                            },
                                            {
                                                "example_id": "4f88e413-bd9e-4843-b57f-986de65db620",
                                                "sense_id": "362de3d2-e196-3798-bab6-3e8536a905f5",
                                                "text": "Meanwhile, however, refugee Flemings and Brabantines had sought an asylum in the city, and being, as usual, of the strictest sect of the Calvinists were shocked at the latitudinarianism which prevailed."
                                            },
                                            {
                                                "example_id": "fe51f3fe-a1f4-4751-b7a6-ad0dcdb07027",
                                                "sense_id": "362de3d2-e196-3798-bab6-3e8536a905f5",
                                                "text": "Indolence and timidity have united to popularise among us a flaccid latitudinarianism, which thinks itself a benign tolerance for the opinions of others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437fed40-d0dd-35ee-9408-f59b11523361",
                                        "entry_id": "4c982989-38bf-3afd-a6ac-a42b757e8f47",
                                        "glosses": [
                                            "The latitudinarian position, that de re attitudes are merely a special case of de dicto attitudes"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88606b0-b4b5-4307-9672-8aaf9abcced2",
                                                "sense_id": "437fed40-d0dd-35ee-9408-f59b11523361",
                                                "text": "The implication is that latitudinarianism permits ascription of de re belief too freely, and that the more robust classical conception of de re attitudes is needed to accommodate the explanatory func- tion of belief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
