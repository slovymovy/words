                "senses": [
                    {
                        "sense_id": "ddd841b6-fbaa-3d0d-8a66-a066e611b903",
                        "entry_id": "9350481c-ba7c-392c-ac63-f1e9dd3b9115",
                        "glosses": [
                            "ein sehr großes Vergnügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e48cfe2-b305-4990-ab7c-437e09285de2",
                                "sense_id": "ddd841b6-fbaa-3d0d-8a66-a066e611b903",
                                "text": "Die Kinder hatten einen Heidenspaß daran, die Erwachsenen zu bemalen."
                            },
                            {
                                "example_id": "46e9baa0-d6a9-47a7-a547-9ab86ab994ef",
                                "sense_id": "ddd841b6-fbaa-3d0d-8a66-a066e611b903",
                                "text": "„Dann lacht er, als sei ihm mit dieser Aufklärung ein Heidenspaß geglückt.“"
                            },
                            {
                                "example_id": "432eb53b-4c47-47ad-8f46-7c37e00c9462",
                                "sense_id": "ddd841b6-fbaa-3d0d-8a66-a066e611b903",
                                "text": "„Skúli und Hafrún wussten, dass es für ihn bloß ein Heidenspaß war, es ließ ihn sich selbst vergessen und konnte eine hervorragende Therapie sein, hilfreicher als viele Sitzungen beim Therapeuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
