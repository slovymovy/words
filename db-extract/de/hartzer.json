                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b7f3675b-bac8-4c47-b7e5-6b647056b1a9",
                                "sense_id": "51cce316-b8ab-3fcd-b094-4abde4bdd1f0",
                                "text": "Es waren einmal ein Holzfäller und seine Frau, die zwar derbe am Hustlen waren, aber trotzdem so broke, dass jeder Hartzer dagegen der übelste Gönnjamin gewesen wäre. Die Frau wusste irgendwann nicht mehr weiter mit ihrem Life, und sie so: »Habibi, setz mal die Kinder im Wald aus, wir können die echt nicht auch noch mit durchfüttern.«"
                            }
                        ]
                    }
