                        "glosses": [
                            "Something indigested; a crude mass, or disordered state of affairs."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "30603cc7-812f-4dc1-b6bd-997c251d838e",
                                "sense_id": "93943510-fade-3263-9490-cfbe518e9287",
                                "text": "Be of good comfort (Prince) for you are borne\nTo ſet a forme vpon that indigeſt"
                            },
                            {
                                "example_id": "77895be1-7ac1-48ec-b36f-fe2e333c352f",
                                "sense_id": "93943510-fade-3263-9490-cfbe518e9287",
                                "text": "The other, more compendious as well as mischievous class of errors, are those indigests of grammar, […]"
                            },
                            {
                                "example_id": "28b321d5-fa23-4aae-a1fd-9d088fa52490",
                                "sense_id": "93943510-fade-3263-9490-cfbe518e9287",
                                "text": "Begotten from greedy indigests of pride\nwhich rotted inside"
                            }
                        ]
                    }
