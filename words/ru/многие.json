{
    "word_family": [
        "много",
        "многий",
        "многое",
        "множество",
        "немногие"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "51c2b953-400e-392b-a7d1-b6155155210e",
                    "sense_definition": "Форма множественного числа прилагательного <w>многий</w>, обозначающая большое количество кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Многие</w> студенты начинают готовиться к экзаменам заранее.",
                            "target_lang_translations": {
                                "en": "<w>Many</w> students start preparing for exams in advance.",
                                "zh": "<w>许多</w>学生提前开始准备考试。"
                            }
                        },
                        {
                            "text": "За <w>многие</w> годы работы он стал настоящим профессионалом.",
                            "target_lang_translations": {
                                "en": "Over <w>many</w> years of work, he became a true professional.",
                                "zh": "经过<w>许多</w>年的工作，他已成为一名真正的专业人士。"
                            }
                        }
                    ],
                    "antonyms": [
                        "немногие"
                    ],
                    "common_phrases": [
                        "многие годы",
                        "многие другие",
                        "во многих случаях"
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the adjective denoting a large quantity of someone or something.",
                        "zh": "形容词“многий”的复数形式，表示某人或某物数量众多。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "many",
                                "target_lang_sense_clarification": "used with countable nouns"
                            },
                            {
                                "target_lang_word": "numerous",
                                "target_lang_sense_clarification": "formal, large in number"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许多",
                                "target_lang_sense_clarification": "用于可数名词前，表示数量多"
                            },
                            {
                                "target_lang_word": "很多",
                                "target_lang_sense_clarification": "最常用的表示数量多的词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "ad0fa37b-9544-35a4-9705-88fb681cc03a",
                    "sense_definition": "Большое количество людей.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Многие</w> считают, что изучение языков полезно для мозга.",
                            "target_lang_translations": {
                                "en": "<w>Many</w> believe that learning languages is beneficial for the brain.",
                                "zh": "<w>很多人</w>认为学习语言对大脑有益。"
                            }
                        },
                        {
                            "text": "На собрание пришли очень <w>многие</w>, и в зале не хватало мест.",
                            "target_lang_translations": {
                                "en": "Very <w>many</w> came to the meeting, and there were not enough seats in the hall.",
                                "zh": "<w>很多人</w>参加了会议，大厅里座位不够。"
                            }
                        }
                    ],
                    "antonyms": [
                        "немногие"
                    ],
                    "common_phrases": [
                        "очень многие",
                        "многие из нас",
                        "как и многие"
                    ],
                    "target_lang_definitions": {
                        "en": "A large number of people.",
                        "zh": "指代大量的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "many",
                                "target_lang_sense_clarification": "referring to people"
                            },
                            {
                                "target_lang_word": "many people",
                                "target_lang_sense_clarification": "explicit group reference"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "许多人",
                                "target_lang_sense_clarification": "明确指代人群"
                            },
                            {
                                "target_lang_word": "很多人",
                                "target_lang_sense_clarification": "口语中常用的指代人群的表达"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}