                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Tijdens onze fietstocht door Drenthe kwamen we door het kleine dorpje <w>Donderen</w>.",
                            "target_lang_translations": {
                                "en": "During our bike ride through Drenthe, we passed through the small village of <w>Donderen</w>."
                            }
                        },
                        {
                            "text": "De weg van <w>Donderen</w> naar Vries is erg mooi in de herfst.",
                            "target_lang_translations": {
                                "en": "The road from <w>Donderen</w> to Vries is very beautiful in the autumn."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a village in the municipality of Tynaarlo in the Dutch province of Drenthe"
                    },
                    "translations": {
