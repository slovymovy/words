                        "examples": [
                            {
                                "example_id": "5803da0d-ae18-43f0-862c-3b6ecf92210c",
                                "sense_id": "bf8a7cb9-a4c7-3a94-a025-d1bc0a227464",
                                "text": "Z. E. Híd hat in der mehrern^([sic]) Zahl Hídak, dieses zeigt schon an, daß der Gebefall in ein nak ausgehen muß."
                            },
                            {
                                "example_id": "cd56c647-e013-46ab-b458-f6256a30b266",
                                "sense_id": "bf8a7cb9-a4c7-3a94-a025-d1bc0a227464",
                                "text": "[…] der Unterlage nicht ausreichte, so dass er die Stadt der Unwissenheit verdächtigte durch die in der Schreibung liegende Ungewissheit, ob sie das letzte Wort im Nennfalle oder im Gebefalle nahm; denn Manche schreiben die Gebefälle ohne Iota, dessen Gebrauch sie schlechthin verwerfen, […]"
                            }
                        ]
                    }
