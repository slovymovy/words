                                                "example_id": "901bbb18-3935-4688-854c-039bc0270ac4",
                                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                                "text": "Propriété fictive."
                                            },
                                            {
                                                "example_id": "21a9032d-32dc-4ce1-8bc5-cd8132cf0d34",
                                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                                "text": "Une histoire fictive."
                                            },
                                            {
                                                "example_id": "3d287768-8f66-4fc5-9870-7e65b2bed538",
                                                "sense_id": "b2a61dcb-eb6e-379e-ab13-68e4ad4965b1",
                                                "text": "Et sais-tu ce qu’il m’a proposé ? Une vente fictive de toute sa propriété, de sorte que tu serais en fait son héritier, l’héritier de la petite…"
