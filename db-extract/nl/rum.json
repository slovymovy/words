                    {
                        "sense_id": "3ed1bb73-2d3a-3c04-9857-dd4ec7c61b3f",
                        "entry_id": "30c397a0-c27c-3b38-96dd-cdcdf41b5dc1",
                        "glosses": [
                            "een sterkedrank die bereid wordt uit het sap van suikerriet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c9f1c1-a92b-4be9-8fea-37aeb40289a9",
                                "sense_id": "3ed1bb73-2d3a-3c04-9857-dd4ec7c61b3f",
                                "text": "Hij dronk gezellig een glaasje rum mee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0d70227-bc8e-4d79-ba33-c967c118aec6",
                        "source_entry_id": "30c397a0-c27c-3b38-96dd-cdcdf41b5dc1",
                        "source_sense_id": "3ed1bb73-2d3a-3c04-9857-dd4ec7c61b3f",
                        "source_sense_description": "een sterkedrank die bereid wordt uit het sap van suikerriet",
                        "target_lang_word": "Rum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae9bca2c-0190-3d03-93e4-37f5afd15607",
                                        "entry_id": "c4dfe8cd-a3f3-3b03-9b76-98b833282bcc",
                                        "glosses": [
                                            "aus Zuckerrohr, Melasse oder Saft durch Vergärung und Destillation gewonnener hochprozentiger Branntwein, der teilweise mit Karamellzucker gefärbt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a02d698-5c48-4e5f-90e2-b3989f63b6f2",
                                                "sense_id": "ae9bca2c-0190-3d03-93e4-37f5afd15607",
                                                "text": "„Der junge Mann trank langsam den Thee, ass Gingerbreads und fünfzehn Marons glaçés. Die Damen lächelten. Er sagte: »Ein heller goldgelber Thee, meine Damen, mit feinem Rum, ist das anregendste Getränk von der Welt. Es führt uns Wärme in seiner goldenen Flüssigkeit zu und übt einen sanften Reiz auf unsere Geschmacksnerven aus, der sich über den Gesammtorganismus verbreitet wie ein süsser Dunst.“"
                                            },
                                            {
                                                "example_id": "f4d0e19a-a1bd-452f-9e70-c926f4aaa032",
                                                "sense_id": "ae9bca2c-0190-3d03-93e4-37f5afd15607",
                                                "text": "„Murphy und William würden um ihren Rum kämpfen.“"
                                            },
                                            {
                                                "example_id": "faca2f9a-f66d-4aa6-b8f4-2a714c6070b0",
                                                "sense_id": "ae9bca2c-0190-3d03-93e4-37f5afd15607",
                                                "text": "„Cachaça ist ein Rum aus Zuckerrohr.“"
                                            },
                                            {
                                                "example_id": "5ef66154-3a00-4534-861b-c016ecf8f45c",
                                                "sense_id": "ae9bca2c-0190-3d03-93e4-37f5afd15607",
                                                "text": "„Wir waren alle so gerührt, dass wohl auch wir drei trotz des Rums Tränen vergossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5058739d-f1c8-3e95-ae80-573a2c1d3da7",
                                        "entry_id": "75d2e984-a5c1-3868-9c02-db83bcfcd1d5",
                                        "glosses": [
