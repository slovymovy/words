                "senses": [
                    {
                        "sense_id": "2ac0d538-a403-389f-a1e0-0283ff97047e",
                        "entry_id": "ae2e7b8e-a921-3312-8d1e-71dd37260049",
                        "glosses": [
                            "Qui fait trop de phrases."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "919df191-9751-4486-9458-5c07303ddfea",
                                "sense_id": "2ac0d538-a403-389f-a1e0-0283ff97047e",
                                "text": "Camille Desmoulins, qui avait été averti tout de suite par le tour de sentimentalité phraseuse du prône royal, écrivait dans le no 12 des Révolutions de France et de Brabant :"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8cf48fac-a461-375b-98de-7fcc80228e97",
                "word": "phraseur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bf102e21-0f3d-4605-abf9-7e1ddbfd2cc9",
                        "entry_id": "8cf48fac-a461-375b-98de-7fcc80228e97",
                        "tags": [
                            "plural"
                        ],
                        "form": "phraseurs"
                    },
                    {
                        "form_id": "e481ded7-ba7a-4926-a3cb-10f00bf0dda5",
                        "entry_id": "8cf48fac-a461-375b-98de-7fcc80228e97",
                        "tags": [
                            "feminine"
                        ],
                        "form": "phraseuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                        "entry_id": "8cf48fac-a461-375b-98de-7fcc80228e97",
                        "glosses": [
                            "Faiseur de phrases, celui qui parle ou qui écrit d’une manière affectée, ampoulée, verbeuse et vide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3092f29d-6b05-4b8c-8a9d-e61373691203",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "Cet écrivain, cet homme n’est qu’un phraseur."
                            },
                            {
                                "example_id": "d4fd0a20-407a-4ead-b9fc-811be0c20352",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "Quel ennuyeux phraseur !"
                            },
                            {
                                "example_id": "0a03f3b2-7673-4a97-927d-516f68af6758",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "Au moral, c’est u monstre de vertu ennuyeuse, un phraseur sentencieux et larmoyant."
                            },
                            {
                                "example_id": "84fcd1f2-e27d-408b-9749-d1e269fa331b",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "– Vous parlez fort bien, mon cher prince. D’ailleurs, les Français sont tous un peu phraseurs… Ils ont dû inventer la salive…"
                            },
                            {
                                "example_id": "8bea14a3-cb2f-4634-a6b4-d7bb344b454d",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "Si Staline sermonne les abandonneurs, les « gâcheurs » de droite, il secoue aussi les « phraseurs » de gauche, et aussi les dirigeants qui se laissent gagner de vitesse par les faits."
                            },
                            {
                                "example_id": "04ab3d1e-1053-4c78-9862-69ccb80efc3c",
                                "sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                                "text": "Nous avons du mal à le croire, nous autres Français qui nous voyons rationalistes, organisés et pour tout dire très intelligents, mais aux yeux de beaucoup de nos voisins nous sommes des passionnels, des idéologues, des phraseurs, des agités, des individualistes, enfin des gens peu sûrs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34e391fd-84a9-41b8-8845-75dbed6bd768",
                        "source_entry_id": "8cf48fac-a461-375b-98de-7fcc80228e97",
                        "source_sense_id": "91682799-7a8d-37f5-9b05-5723a40edbcc",
                        "target_lang_word": "talker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c073fa33-3be6-3ede-9d7f-2242b1185d74",
                                        "entry_id": "67555ce9-9dad-3e45-8c54-ad4b829a5486",
                                        "glosses": [
                                            "A person who talks, especially one who gives a speech, or is loquacious or garrulous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb23b04-36c3-45da-8642-2c48435b8115",
                                                "sense_id": "c073fa33-3be6-3ede-9d7f-2242b1185d74",
                                                "text": "What this country needs is a smooth talker."
                                            },
                                            {
                                                "example_id": "9cc2a2f4-188c-4359-80f9-a0fa90ae8c02",
                                                "sense_id": "c073fa33-3be6-3ede-9d7f-2242b1185d74",
                                                "text": "That guy's a real talker."
                                            },
                                            {
                                                "example_id": "03bcb323-0f26-4332-be35-c67eb252432a",
                                                "sense_id": "c073fa33-3be6-3ede-9d7f-2242b1185d74",
                                                "text": "Returning TED talker Sherry Turkle, an author and academic, says that giving lectures about how lonely the Internet is making people has made her and her audiences even lonelier."
                                            },
                                            {
                                                "example_id": "9133e26d-b271-4dc2-b4fc-e646cd792b73",
                                                "sense_id": "c073fa33-3be6-3ede-9d7f-2242b1185d74",
                                                "text": "At Iwo Jima, code talkers passed over 800 error-free messages in a 48-hour period, according to the Congressional law honoring the program."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfd57106-ae30-3996-95ba-63bbe96b5db3",
                                        "entry_id": "67555ce9-9dad-3e45-8c54-ad4b829a5486",
                                        "glosses": [
                                            "Any creature or machine that talks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1c2b852-bc0c-4d7d-b73e-4563daaaa495",
                                                "sense_id": "bfd57106-ae30-3996-95ba-63bbe96b5db3",
                                                "text": "Some parrots are vociferous talkers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c07e0a17-607d-3ae4-bee9-57a14daa0292",
                                        "entry_id": "67555ce9-9dad-3e45-8c54-ad4b829a5486",
                                        "glosses": [
                                            "A talk show"
                                        ],
