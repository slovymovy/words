                ],
                "senses": [
                    {
                        "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                        "entry_id": "252bcda6-dc52-34c8-8201-a11f4164823f",
                        "glosses": [
                            "Lücke in den Wolken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "227eb4ad-e1ac-4d6b-b93a-a46dba046001",
                                "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                                "text": "„Und die Fahnen flatterten lustig im Wind und reckten sich der Sonne entgegen, die müde und abgekämpft hinter den Wolkenluken hervorlugte.“"
                            },
                            {
                                "example_id": "e70a124b-4010-4342-b48f-abd08608043f",
                                "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                                "text": "„Manchmal blinkt die Leuchtenzeile einer Autostraße, das Sternbild einer Ortschaft durch eine Wolkenluke herauf.“"
                            },
                            {
                                "example_id": "9d582433-80b8-46cb-abfb-87bcf70ebda0",
                                "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                                "text": "„Als er das Fenster öffnete, stach die Sonne durch eine Wolkenluke einen scharfen Strahl, ein regennasses Gehölz wurde von silbernem Licht durchwirkt, und der Abbé streckte den Arm über das Tal: …“"
                            },
                            {
                                "example_id": "c0a2ddf6-224e-4e91-a7de-d6d580450854",
                                "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                                "text": "„Wolken beherrschten den ganzen Horizont; aber hier und dort durchbrach sie ein Lichtblick, öffnete sich durch Wolkenluken eine Aussicht in die Ferne.“"
                            },
                            {
                                "example_id": "dfc7c26d-ba12-4eb4-9768-c31281d9756c",
                                "sense_id": "ae5190f4-4f19-3cd3-b05a-1d6794c1c327",
                                "text": "„Licht aus dem Grenzenlosen rauscht durch goldgeräderte Wolkenluken wie ein silberner Regen, hängt den dunkelvioletten Pfeilern purpurne Mäntel um, setzt der Hirschkuppe, der westlichen Stirn, ein funkelndes Häubchen auf, legt leuchtende Bänder um die Mittelklippen, schenkt dem Grünen Altar, den sie in den Dörfern die ‚Teufelskanzel‘ nennen, eine goldene Krone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
