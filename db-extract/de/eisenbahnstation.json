                "senses": [
                    {
                        "sense_id": "e1cbd801-2d35-30bc-8763-cf69a997d025",
                        "entry_id": "2b0e9b88-95c3-3a93-9db7-873672a93c46",
                        "glosses": [
                            "Ort (Gebäude), an dem ein Zug hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93c8ef2-c87c-47a3-895e-353e6d00ce7d",
                                "sense_id": "e1cbd801-2d35-30bc-8763-cf69a997d025",
                                "text": "„Wilhelmshaven, seit seinen Anfängen (1852, aus einem Dorf von 335 Fischern und Ackerbürgern mit Bremen als nächster Eisenbahnstation) von seiner Atmosphäre her daran gewöhnt, mit 70 Prozent seiner Menschen an einem Strom von Berliner Geld zu leben, kann noch nicht dazu erwachen, in den Maßen des entlegenen Standorts zu denken, den zu bedienen zwei D-Zug-Paare und ein Eilzugpaar laut Bundesbahn genug sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d3141b5-42e7-4083-85f3-6cd876d9c681",
                        "source_entry_id": "2b0e9b88-95c3-3a93-9db7-873672a93c46",
                        "source_sense_id": "e1cbd801-2d35-30bc-8763-cf69a997d025",
                        "source_sense_description": "Ort (Gebäude), an dem ein Zug hält",
                        "target_lang_word": "railroad station",
