{
    "word_family": [
        "aristocrate",
        "aristocratie",
        "aristocratiquement",
        "aristocratisme"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fe5db3e-1efd-343c-aa5d-60ad2424e132",
                    "sense_definition": "Qui appartient à la noblesse ou à l'aristocratie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille <w>aristocratique</w> possédait un immense château dans le sud du pays."
                        },
                        {
                            "text": "Il a grandi au sein d'un milieu <w>aristocratique</w> très attaché aux anciennes traditions."
                        }
                    ],
                    "common_phrases": [
                        "famille aristocratique",
                        "milieu aristocratique"
                    ]
                },
                {
                    "sense_id": "117a2f02-ccfa-3d67-9d77-fb7a0e8bde98",
                    "sense_definition": "Qui manifeste de la distinction, du raffinement ou une grande élégance de manières.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manieres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme conservait une allure <w>aristocratique</w> malgré ses vêtements modestes et usés."
                        },
                        {
                            "text": "Ses manières raffinées et son maintien <w>aristocratique</w> impressionnaient tous ses collègues."
                        }
                    ],
                    "synonyms": [
                        "distingué",
                        "élégant",
                        "raffiné"
                    ],
                    "common_phrases": [
                        "allure aristocratique"
                    ]
                },
                {
                    "sense_id": "ddc04b4d-91ca-3f91-beda-e20d6ec738f0",
                    "sense_definition": "Relatif à un régime politique ou à un ordre social gouverné par une minorité privilégiée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les philosophes de cette époque critiquaient vivement le gouvernement <w>aristocratique</w> de la cité."
                        },
                        {
                            "text": "Une république peut parfois adopter une constitution <w>aristocratique</w> pour préserver les privilèges de ses élites."
                        }
                    ],
                    "common_phrases": [
                        "constitution aristocratique",
                        "gouvernement aristocratique"
                    ]
                },
                {
                    "sense_id": "04b96c28-c0bd-3975-b66a-608d32561b74",
                    "sense_definition": "Qualifie une composition ou un problème d'échecs ne comportant aucun pion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "echecs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce problème <w>aristocratique</w> a surpris les joueurs car aucune case n'était occupée par des pions."
                        },
                        {
                            "text": "Le maître a composé une étude <w>aristocratique</w> particulièrement difficile à résoudre en cinq coups."
                        }
                    ],
                    "common_phrases": [
                        "problème aristocratique"
                    ]
                }
            ]
        }
    ]
}