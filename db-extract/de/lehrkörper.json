                ],
                "senses": [
                    {
                        "sense_id": "74c1f510-0901-3578-bc3e-36a1fa0b390c",
                        "entry_id": "ae228fee-64b0-383a-a8ed-57a1f2b4b0a7",
                        "glosses": [
                            "Gesamtheit aller Lehrer an einer Schule oder Universität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bdf5aab-0fab-4e2c-a67a-d9bbd63e4e3f",
                                "sense_id": "74c1f510-0901-3578-bc3e-36a1fa0b390c",
                                "text": "„Danke Gott, daß du zum Lehrkörper eines Städtischen Gymnasiums gehörst und daß du also ohne große wirtschaftliche Sorgen alt und blöd werden darfst!“"
                            },
                            {
                                "example_id": "90c9746f-4114-4ae4-94a0-314997fd482e",
                                "sense_id": "74c1f510-0901-3578-bc3e-36a1fa0b390c",
                                "text": "„Vielfach wurden somit empfindliche Lücken in die Lehrkörper gerissen, die durch unbezahlte Mehrarbeit der Kollegen gefüllt werden sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04905e02-d0c8-4ddb-96e8-96f2843bd595",
                        "source_entry_id": "ae228fee-64b0-383a-a8ed-57a1f2b4b0a7",
                        "source_sense_id": "74c1f510-0901-3578-bc3e-36a1fa0b390c",
                        "source_sense_description": "Gesamtheit aller Lehrer an einer Schule oder Universität",
                        "target_lang_word": "faculty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faculty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "393eac80-e047-33f8-8543-6689dbccb993",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "The academic staff at schools, colleges, universities or not-for-profit research institutes, as opposed to the students or support staff."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Philippines",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10501437-f50d-3b97-bc2b-64743e392362",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "A division of a university."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ecada25-2f7d-4b82-8b0c-0ae24420567c",
                                                "sense_id": "10501437-f50d-3b97-bc2b-64743e392362",
                                                "text": "She transferred from the Faculty of Science to the Faculty of Medicine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "An ability, power, or skill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574683d9-5b09-428e-923d-22041fa0b863",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "He lived until he reached the age of 90 with most of his faculties intact."
                                            },
                                            {
                                                "example_id": "d559bdd6-72be-4acf-9b79-d4d7c6303b32",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "What a piece of work is a man! how noble in reason!\nhow infinite in faculty!"
                                            },
                                            {
                                                "example_id": "947f8672-d1ca-43d7-a3c2-d4d4a2dabd12",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "If I will aske meere Philosophers, what the soule is, I shall finde amongst them, that will tell me, it is nothing, but the temperament and harmony, and just and equall composition of the Elements in the body, which produces all those faculties which we ascribe to the soule […]"
                                            },
                                            {
                                                "example_id": "c4ce45cb-352c-43b7-9ea6-8fa9c431a908",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "The preſent Argument is the moſt abſtracted that ever I engaged in, it ſtrains my Faculties to their higheſt Stretch; and I deſire the Reader to attend with utmoſt perpenſity; For, I now proceed to unravel this knotty Point."
                                            },
                                            {
                                                "example_id": "cf7db8d5-3ab5-4156-af44-647b23e5d940",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "It was some time before Johnstone recovered the full use of his faculties; his eyes unclosed but to stare fixedly upon the bank, which, however, was now unoccupied."
                                            },
                                            {
                                                "example_id": "4ac393c8-00a0-49e2-8658-73ba613b12b0",
                                                "sense_id": "d31acff6-b612-3e8a-9cb1-b5ad978f72e6",
                                                "text": "I have used the notion of games so far as if it were familiar to most people. I think this is justified as everyone knows how to play some games. Accordingly, games serve admirably as models for the clarification of other, less well-understood, social-psychological phenomena. Yet the ability to follow rules, play games, and construct new games is a faculty not equally shared by all persons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0411d50d-9a6f-3a6b-84c6-d637eb4c11dd",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "An authority, power, or privilege conferred by a higher authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e0190e-7468-4631-9e66-8cb03054f6d5",
                                                "sense_id": "0411d50d-9a6f-3a6b-84c6-d637eb4c11dd",
                                                "text": "Unless he has bi-ritual faculties, the Latin priest must baptize and confirm the Eastern rite person, whether infant or adult, according to the liturgical books of the Latin church ( canon 846 , §2 )."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da1e4900-09e0-3163-a85b-7ac6767421f8",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "A licence to make alterations to a church."
                                        ],
                                        "tags": [
                                            "Church-of-England"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96f16148-e602-3aff-909d-ac625d7ccdde",
                                        "entry_id": "ea48b4fd-068b-30d0-b6a2-30f5973ad40a",
                                        "glosses": [
                                            "The members of a profession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
