            {
                "entry_id": "ff7c0faa-6780-3986-869a-2d8c8417ae5e",
                "word": "terracotta",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "be41dfff-de43-396b-afbb-7c497ce77ac3",
                        "entry_id": "ff7c0faa-6780-3986-869a-2d8c8417ae5e",
                        "glosses": [
                            "Terre cuite."
                        ],
                        "tags": [
                            "Céramique"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab54244-7808-4951-be8e-970a1d8260b7",
                                "sense_id": "be41dfff-de43-396b-afbb-7c497ce77ac3",
                                "text": "À 30 km à l’ouest de bishnupur, le charmant village de bankura où presque tous les habitants sont des artisans d’objets en terracotta."
                            }
                        ]
                    },
                    {
                        "sense_id": "14e5aa2b-35e1-3a09-82c8-4ccbfd52b396",
                        "entry_id": "ff7c0faa-6780-3986-869a-2d8c8417ae5e",
                        "glosses": [
                            "Couleur de terre cuite, de brun-jaune à brun-rouge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5f325cd-507f-457d-9c3c-1971d759a1ff",
                                "sense_id": "14e5aa2b-35e1-3a09-82c8-4ccbfd52b396",
                                "text": "Se rajoutent les verts foncés et le kaki, les orangés avec la terracotta et le rouge brique, bref, toutes ces teintes qui nous fondent dans la nature comme si nous ne faisions qu’un avec tout ce qui la compose, pour ne pas déranger ce tableau si reposant qu’est la campagne au sortir de l’hiver."
                            },
                            {
                                "example_id": "199ab1cf-6fb0-48d8-a375-1c9ea5be617a",
                                "sense_id": "14e5aa2b-35e1-3a09-82c8-4ccbfd52b396",
                                "text": "L'eau qui sort du tuyau (la pomme de douche figure dans la même catégorie que l'eau et le papier-toilettes) est rouge terracotta."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc7d4ae4-8511-43c2-9320-73e89aacf04c",
                        "source_entry_id": "ff7c0faa-6780-3986-869a-2d8c8417ae5e",
                        "source_sense_description": "Céramique",
                        "target_lang_word": "terracotta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terracotta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7de57d8-1377-3a25-9305-6ef5ccea0663",
                                        "entry_id": "f4d8745f-ea59-330b-9a3b-a9cce70b1130",
                                        "glosses": [
                                            "A hard red-brown unglazed earthenware, used for pottery and building construction."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae6994ef-7dfd-3cdd-b88c-9a01c40c803e",
                                        "entry_id": "f4d8745f-ea59-330b-9a3b-a9cce70b1130",
                                        "glosses": [
                                            "A reddish brown colour, like that of terra cotta."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "terracotta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                        "entry_id": "1075e260-0c33-3c30-84d3-e42ab3194704",
                                        "glosses": [
                                            "Of the colour of terracotta."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e9db05d-4308-4e16-87fb-2cf2982f0919",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "A dull red or terracotta brown is far better, and sets off the foliage of Palms or Ferns to greater advantage."
                                            },
                                            {
                                                "example_id": "b5f80a31-e108-4581-8219-1d62d680b30e",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "She looked cool in a grey tailored cotton dress with a terracotta scarf and shoes and her hair a black silk helmet."
                                            },
                                            {
                                                "example_id": "b7c52074-9edb-44ec-b8de-e450359e0f8a",
                                                "sense_id": "7be199e7-22a2-3328-9f34-b6521611409f",
                                                "text": "But let's not judge them by the content of their character. Let's judge them by the colour of their skin, which is terracotta."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
