                                            {
                                                "example_id": "2c87fcac-0146-45ad-87c4-5cb222cad380",
                                                "sense_id": "472016aa-a055-3d15-8928-0138fd0906bd",
                                                "text": "― Здорово, корова, где твой бык, ― сказал сторож."
                                            },
                                            {
                                                "example_id": "bf35f13c-adc5-4612-9c10-4915950c989b",
                                                "sense_id": "472016aa-a055-3d15-8928-0138fd0906bd",
                                                "text": "Повернулся к берёзке, погладил её ладонью. ― Здорово! Ишь ты какая…"
                                            }
                                        ]
                                    }
                                ]
                            },
