                    },
                    {
                        "sense_id": "d71f329a-c77e-3f10-9182-169ed8af9ce7",
                        "entry_id": "04c9ef7b-9292-3c54-afb5-48a6abcdfb08",
                        "glosses": [
                            "benaming voor planten en struiken uit het geslacht Salvia",
                            "benaming voor de echte salie, Salvia officinalis, gebruikt als geneesmiddel en om voedsel te kruiden"
                        ],
                        "tags": [
                            "wikidata: salie"
                        ],
                        "examples": [
                            {
                                "example_id": "c0165b52-4938-4b1b-91cc-9eb340e33f03",
                                "sense_id": "d71f329a-c77e-3f10-9182-169ed8af9ce7",
                                "text": "Er bestaan verschillende soorten salie. De meest robuuste soorten hiervan zijn de gewone, de breedbladige en de geelgroene salie."
                            },
                            {
                                "example_id": "a0c3ab0f-a7f1-43ca-a9aa-5b514bb92911",
                                "sense_id": "d71f329a-c77e-3f10-9182-169ed8af9ce7",
                                "text": "Achter zijn huis zaait hij onder andere sterrekers en salie."
                            }
                        ]
                    },
                    {
                        "sense_id": "bde82cf1-5986-3c5b-ba7f-45d4a3399d1f",
                        "entry_id": "04c9ef7b-9292-3c54-afb5-48a6abcdfb08",
                        "glosses": [
                            "gedroogde stukjes van de echte salie, gebruikt om voedsel te kruiden"
                        ],
                        "tags": [
                            "kruid"
                        ],
                        "examples": [
                            {
                                "example_id": "7013c067-1560-47d3-9167-5b45909109f2",
                                "sense_id": "bde82cf1-5986-3c5b-ba7f-45d4a3399d1f",
                                "text": "Veel Toscaanse producten maken deel uit van het dagelijkse menu in veel Vlaamse huishoudens door het gebruik van olijfolie, verse kruiden als koningskruid, salie en bernagie, witte truffel, pecorinokaas en pasta."
                            }
                        ]
                    },
                    {
                        "sense_id": "a544e18d-0e85-355c-bc95-1be9c057d5f4",
                        "entry_id": "04c9ef7b-9292-3c54-afb5-48a6abcdfb08",
                        "glosses": [
                            "preparaat van de echte salie, onder meer gebruikt tegen ontstekingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb4083e-e482-4b77-879c-9c39042be000",
                                "sense_id": "a544e18d-0e85-355c-bc95-1be9c057d5f4",
                                "text": "Al maanden sliep ik met een hand op mijn maag, maar dat had hoegenaamd geen effect. Zodra ik wakker werd was de pijn er weer. (…) Alle huismiddelen had ik geprobeerd. Warme melk met anijs, met salie, een glas lauw water op de nuchtere maag en het eindeloos kauwen van het voedsel."
                            }
                        ]
                    }
                ],
