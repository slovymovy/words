                "senses": [
                    {
                        "sense_id": "28ea86de-5aa1-3d17-9e9c-4a4ec29e04e4",
                        "entry_id": "03f03af4-67c1-31cc-95f7-51eed4c860cc",
                        "glosses": [
                            "die Fischfamilie der Muraenidae (deutsch: Muränen), ein zur Ordnung der Aalartigen Fische gehörender Knochenfisch"
                        ],
                        "tags": [
                            "Biologische Taxonomie",
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ee0412e9-748b-4ded-a8e1-97e63414b3b3",
                                "sense_id": "28ea86de-5aa1-3d17-9e9c-4a4ec29e04e4",
                                "text": "„Besonders häufig sind Muränen in den tropischen Korallenriffen.“"
                            },
                            {
                                "example_id": "71579dad-fd6f-4b69-8d92-0670154e0862",
                                "sense_id": "28ea86de-5aa1-3d17-9e9c-4a4ec29e04e4",
                                "text": "„Ich schloss abermals die Augen, aber die Angst schoss heraus wie eine Muräne und schnappte mich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0da94e2a-4aae-3a71-8bff-ed54f7dc924b",
                        "entry_id": "03f03af4-67c1-31cc-95f7-51eed4c860cc",
                        "glosses": [
                            "ein Vertreter der Muränen"
                        ],
                        "tags": [
                            "im Singular"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "beb16f5a-af39-4a63-8f91-1a7fcd3d05d5",
                        "source_entry_id": "03f03af4-67c1-31cc-95f7-51eed4c860cc",
                        "source_sense_id": "28ea86de-5aa1-3d17-9e9c-4a4ec29e04e4",
                        "target_lang_word": "мурена",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мурена",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "de1bf152-870e-3e23-b017-0bb9af0269ef",
                                        "entry_id": "2f046704-9b6f-36b9-9c5b-01b32eb5843c",
                                        "glosses": [
                                            "ихтиол. рыба из отряда угреобразных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ce50d3-f5b1-466a-9887-7eea16931580",
                                                "sense_id": "de1bf152-870e-3e23-b017-0bb9af0269ef",
                                                "text": "Мурены обитают, в основном, в прибрежных водах, обычно скрываясь в расщелинах подводных скал. Они нападают на людей, не только плавающих в воде, но даже находящихся в небольших шлюпках."
                                            },
                                            {
                                                "example_id": "c0557575-af64-4afc-8515-c9ad507d28fd",
                                                "sense_id": "de1bf152-870e-3e23-b017-0bb9af0269ef",
                                                "text": "Замерев, огляделся и в одной из расщелин увидел бутылкообразную голову с огромной пастью и круглыми свиными глазками. Глазки злобно и неподвижно буравили меня насквозь, а их обладатель тяжело дышал, раз за разом открывая пасть и показывая острые зубы… «Огромная мурена! — мелькнула мысль. — Неужели нападёт?»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07e5dd1d-6456-4277-b5a8-685187b4a7bb",
                        "source_entry_id": "03f03af4-67c1-31cc-95f7-51eed4c860cc",
                        "source_sense_id": "0da94e2a-4aae-3a71-8bff-ed54f7dc924b",
