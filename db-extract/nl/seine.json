                    {
                        "sense_id": "9a95129f-362f-3ea2-a110-dd68940fb82b",
                        "entry_id": "2b10e51f-7472-390f-8720-8a4c7b0c175d",
                        "glosses": [
                            "een rivier in Frankrijk. Zij heeft een lengte van 776 km en een stroomgebied van 79.000 km², en ligt geheel binnen Frans grondgebied"
                        ],
                        "tags": [
                            "toponiem: rivier"
                        ],
