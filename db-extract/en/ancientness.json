{
    "word": "ancientness",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                "word": "ancientness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4eae092c-16c0-4ee2-a46f-5621f6665fcc",
                        "entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                        "tags": [
                            "plural"
                        ],
                        "form": "ancientnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd5da975-5f1e-35c6-af23-983e1adf965d",
                        "entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                        "glosses": [
                            "The state or quality of being ancient."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "1b219d7e-5ab2-4ef4-8532-dab3464035b3",
                                "sense_id": "fd5da975-5f1e-35c6-af23-983e1adf965d",
                                "text": "Here we are in this wonderful town, where, if you can't see everything you want to see, you can generally see a sample of it, even if your fad happens to be the ancientnesses of Egypt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fa1c39b-5189-4ab6-b686-01c7a5fb14a2",
                        "source_entry_id": "788d76b7-7ffd-3cfc-9c2a-ecbb7e1e5868",
                        "source_sense_id": "fd5da975-5f1e-35c6-af23-983e1adf965d",
                        "source_sense_description": "State or quality of being ancient",
                        "target_lang_word": "ancienneté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ancienneté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e049668f-9d03-3d77-9948-80cab7433912",
                                        "entry_id": "ca340c57-4b5d-316b-8fa1-b0a59e1ab949",
                                        "glosses": [
                                            "Qualité de ce qui est ancien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ab7fbe3-390a-4f17-a1e7-f4f3f06e3bc6",
                                                "sense_id": "e049668f-9d03-3d77-9948-80cab7433912",
                                                "text": "Des choses vénérables par leur ancienneté."
                                            },
                                            {
                                                "example_id": "22068341-f931-4e76-ab82-f1c760019510",
                                                "sense_id": "e049668f-9d03-3d77-9948-80cab7433912",
                                                "text": "Le salarié a droit à une indemnité fonction de son ancienneté dans l’entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3ac1b8c-6cee-3134-9dd8-501721014dca",
                                        "entry_id": "ca340c57-4b5d-316b-8fa1-b0a59e1ab949",
                                        "glosses": [
                                            "Antiquité plus ou moins reculée de son origine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2586fb-1d5f-4d53-aaf6-6d000673de92",
                                                "sense_id": "a3ac1b8c-6cee-3134-9dd8-501721014dca",
                                                "text": "L’ancienneté d’une loi, d’une coutume, d’un titre."
                                            },
                                            {
                                                "example_id": "a0f5420a-a41e-4974-84ac-50e96fb3f65e",
                                                "sense_id": "a3ac1b8c-6cee-3134-9dd8-501721014dca",
                                                "text": "L’ancienneté d’une maison, d’une famille,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                        "entry_id": "ca340c57-4b5d-316b-8fa1-b0a59e1ab949",
                                        "glosses": [
                                            "Priorité de réception dans une compagnie, dans un corps ou de nomination à un grade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e28dafe6-8005-43f4-9e20-c0a2888a2c4f",
                                                "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                                "text": "Ils marchent par rang d’ancienneté."
                                            },
                                            {
                                                "example_id": "d199d30f-8db8-4bf8-a4ee-5b9c28af7929",
                                                "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                                "text": "Ils ont rang selon leur ancienneté, selon l’ancienneté."
                                            },
                                            {
                                                "example_id": "2e33578e-f34c-44bf-bdb4-e5ad18daa5a1",
                                                "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                                "text": "Il doit son avancement à l’ancienneté et non point à des services exceptionnels."
                                            },
                                            {
                                                "example_id": "e2607a64-3fc7-4aed-9e02-cb4f9331689c",
                                                "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                                "text": "On avance dans l’armée à l’ancienneté ou au choix."
                                            },
                                            {
                                                "example_id": "f3cee172-dfb5-4b32-9391-8e5ab814817e",
                                                "sense_id": "03c60c08-34dc-35ce-862d-748722083f7c",
                                                "text": "C’est tout juste s’il a gagné son galon d’adjudant à l’ancienneté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
