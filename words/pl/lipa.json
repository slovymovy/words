                },
                {
                    "sense_id": "66f06d5c-e464-3b9c-8c74-e783d1d8232f",
                    "sense_definition": "Przedmiot wykonany niestarannie, z materiałów niskiej jakości; rzecz bezwartościowa.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "colloquial_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kupiłem tani telefon na aukcji, ale okazało się, że to kompletna <w>lipa</w>.",
                            "target_lang_translations": {
                                "ru": "Я купил дешевый телефон на аукционе, но оказалось, что это полная <w>липа</w>.",
                                "en": "I bought a cheap phone at an auction, but it turned out to be complete <w>junk</w>."
                            }
                        },
                        {
                            "text": "Ten nowy sprzęt to jakaś <w>lipa</w>, zepsuł się już po dwóch dniach używania.",
                            "target_lang_translations": {
                                "ru": "Эта новая техника — какая-то <w>липа</w>, сломалась уже через два дня использования.",
                                "en": "This new equipment is <w>shoddy</w>; it broke after only two days of use."
                            }
                        }
                    ],
                    "synonyms": [
                        "tandeta",
                        "chłam",
                        "bubel",
                        "badziewie"
