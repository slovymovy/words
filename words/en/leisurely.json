{
    "word_family": [
        "leisure",
        "leisured"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "36b68ed9-f602-35bc-9565-f5a31f3fff33",
                    "sense_definition": "Characterized by leisure; taking plenty of time; unhurried.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a <w>leisurely</w> breakfast on Sunday morning while reading the newspaper.",
                            "target_lang_translations": {
                                "de": "Wir genossen am Sonntagmorgen ein <w>gemütliches</w> Frühstück, während wir die Zeitung lasen.",
                                "pl": "W niedzielny poranek zjedliśmy <w>niespieszne</w> śniadanie, czytając gazetę.",
                                "es": "Disfrutamos de un desayuno <w>tranquilo</w> el domingo por la mañana mientras leíamos el periódico.",
                                "fr": "Nous avons savouré un petit-déjeuner <w>tranquille</w> le dimanche matin en lisant le journal."
                            }
                        },
                        {
                            "text": "They took a <w>leisurely</w> stroll through the park to enjoy the autumn leaves.",
                            "target_lang_translations": {
                                "de": "Sie machten einen <w>gemächlichen</w> Spaziergang durch den Park, um das Herbstlaub zu genießen.",
                                "pl": "Wybrali się na <w>niespieszny</w> spacer po parku, aby podziwiać jesienne liście.",
                                "es": "Dieron un paseo <w>pausado</w> por el parque para disfrutar de las hojas de otoño.",
                                "fr": "Ils ont fait une promenade <w>paisible</w> dans le parc pour admirer les feuilles d'automne."
                            }
                        }
                    ],
                    "synonyms": [
                        "leisured"
                    ],
                    "antonyms": [
                        "hurried",
                        "rushed"
                    ],
                    "common_phrases": [
                        "leisurely stroll",
                        "leisurely pace",
                        "leisurely breakfast"
                    ],
                    "target_lang_definitions": {
                        "de": "Geprägt von Muße; sich viel Zeit lassend; ohne Eile oder Hektik.",
                        "pl": "Charakteryzujący się spokojem, brakiem pośpiechu; niespieszny.",
                        "es": "Caracterizado por la calma o la falta de prisa; que se toma con tiempo y sin apuro.",
                        "fr": "Qui se fait sans hâte, en prenant tout son temps et de façon détendue."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gemächlich",
                                "target_lang_sense_clarification": "langsam und ohne Eile"
                            },
                            {
                                "target_lang_word": "entspannt",
                                "target_lang_sense_clarification": "ruhig und stressfrei"
                            },
                            {
                                "target_lang_word": "geruhsam",
                                "target_lang_sense_clarification": "voll von Ruhe und Muße"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niespieszny",
                                "target_lang_sense_clarification": "taki, który nie wymaga pośpiechu"
                            },
                            {
                                "target_lang_word": "spokojny",
                                "target_lang_sense_clarification": "odbywający się bez pośpiechu i stresu"
                            },
                            {
                                "target_lang_word": "powolny",
                                "target_lang_sense_clarification": "odbywający się w wolnym tempie"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "tranquilo",
                                "target_lang_sense_clarification": "sin prisa ni estrés"
                            },
                            {
                                "target_lang_word": "pausado",
                                "target_lang_sense_clarification": "que se realiza con lentitud y calma"
                            },
                            {
                                "target_lang_word": "despreocupado",
                                "target_lang_sense_clarification": "relajado y sin agobios"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tranquille",
                                "target_lang_sense_clarification": "calme et sans précipitation"
                            },
                            {
                                "target_lang_word": "paisible",
                                "target_lang_sense_clarification": "doux et serein"
                            },
                            {
                                "target_lang_word": "sans hâte",
                                "target_lang_sense_clarification": "fait en prenant son temps"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "dee019c4-0c99-347a-bd12-9c47229dfd62",
                    "sense_definition": "In an unhurried or relaxed manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked <w>leisurely</w> down the street, stopping to look in every shop window.",
                            "target_lang_translations": {
                                "de": "Sie ging <w>gemächlich</w> die Straße hinunter und hielt an, um in jedes Schaufenster zu schauen.",
                                "pl": "Słała <w>niespiesznie</w> ulicą, zatrzymując się, by zajrzeć do każdej witryny sklepowej.",
                                "es": "Caminó <w>sin prisa</w> por la calle, deteniéndose a mirar cada escaparate.",
                                "fr": "Elle descendait la rue <w>tranquillement</w>, s'arrêtant pour regarder chaque vitrine."
                            }
                        },
                        {
                            "text": "The river flowed <w>leisurely</w> through the quiet valley.",
                            "target_lang_translations": {
                                "de": "Der Fluss floss <w>träge</w> durch das ruhige Tal.",
                                "pl": "Rzeka płynęła <w>powoli</w> przez cichą dolinę.",
                                "es": "El río fluía <w>con calma</w> a través del tranquilo valle.",
                                "fr": "La rivière s'écoulait <w>lentement</w> à travers la vallée paisible."
                            }
                        }
                    ],
                    "antonyms": [
                        "hurriedly",
                        "hastily"
                    ],
                    "common_phrases": [
                        "walk leisurely",
                        "stroll leisurely"
                    ],
                    "target_lang_definitions": {
                        "de": "In einer entspannten, ruhigen Art und Weise, ohne sich zu beeilen.",
                        "pl": "W sposób niespieszny, zrelaksowany, bez pośpiechu.",
                        "es": "De manera relajada, pausada y sin prisas.",
                        "fr": "D'une manière détendue, sans se presser."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gemächlich",
                                "target_lang_sense_clarification": "langsam und in aller Ruhe"
                            },
                            {
                                "target_lang_word": "ohne Eile",
                                "target_lang_sense_clarification": "ohne Hektik oder Zeitdruck"
                            },
                            {
                                "target_lang_word": "gemütlich",
                                "target_lang_sense_clarification": "in einer behaglichen, entspannten Weise"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niespiesznie",
                                "target_lang_sense_clarification": "w sposób niewymagający pośpiechu"
                            },
                            {
                                "target_lang_word": "powoli",
                                "target_lang_sense_clarification": "w wolnym tempie"
                            },
                            {
                                "target_lang_word": "bez pośpiechu",
                                "target_lang_sense_clarification": "spokojnie, bez presji czasu"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "con calma",
                                "target_lang_sense_clarification": "sin prisa"
                            },
                            {
                                "target_lang_word": "sin prisa",
                                "target_lang_sense_clarification": "tomándose el tiempo necesario"
                            },
                            {
                                "target_lang_word": "pausadamente",
                                "target_lang_sense_clarification": "de forma lenta y sosegada"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "tranquillement",
                                "target_lang_sense_clarification": "sans se presser, avec sérénité"
                            },
                            {
                                "target_lang_word": "sans se presser",
                                "target_lang_sense_clarification": "en prenant son temps, sans hâte"
                            },
                            {
                                "target_lang_word": "paisiblement",
                                "target_lang_sense_clarification": "dans le calme et la quiétude"
                            },
                            {
                                "target_lang_word": "lentement",
                                "target_lang_sense_clarification": "à un rythme peu rapide"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}