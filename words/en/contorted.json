{
    "word_family": [
        "contort",
        "contortion",
        "contortionist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "797840b1-6a93-396e-acfc-f2aa7a0dc6db",
                    "sense_definition": "Twisted or bent out of the normal shape.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twisted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gymnast's body was <w>contorted</w> into an impossible position during the performance.",
                            "target_lang_translations": {
                                "nl": "Het lichaam van de gymnast was tijdens de uitvoering in een onmogelijke houding <w>verwrongen</w>."
                            }
                        },
                        {
                            "text": "His face was <w>contorted</w> with pain after he fell from the ladder.",
                            "target_lang_translations": {
                                "nl": "Zijn gezicht was <w>vertrokken</w> van pijn nadat hij van de ladder was gevallen."
                            }
                        }
                    ],
                    "synonyms": [
                        "twisted",
                        "distorted",
                        "bent"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "contorted face",
                        "contorted body"
                    ],
                    "target_lang_definitions": {
                        "nl": "Verwrongen of uit de normale vorm gebogen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verwrongen",
                                "target_lang_sense_clarification": "algemeen gebruikt voor objecten of lichaamsdelen die uit vorm zijn"
                            },
                            {
                                "target_lang_word": "vertrokken",
                                "target_lang_sense_clarification": "specifiek gebruikt voor een gezicht dat door emotie of pijn uit zijn normale plooi is getrokken"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9105b001-8caf-37fb-a822-ac1d4aabdf9a",
                    "sense_definition": "Simple past and past participle of <w>contort</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "twisted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident <w>contorted</w> the metal frame of the car beyond recognition.",
                            "target_lang_translations": {
                                "nl": "Het ongeluk heeft het metalen frame van de auto onherkenbaar <w>vervormd</w>."
                            }
                        },
                        {
                            "text": "She has <w>contorted</w> her limbs to fit inside the small box.",
                            "target_lang_translations": {
                                "nl": "Ze heeft haar ledematen <w>verwrongen</w> om in de kleine doos te passen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "De verleden tijd en voltooid deelwoord van verwrongen of vervormen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verwrong",
                                "target_lang_sense_clarification": "verleden tijd van verwringen"
                            },
                            {
                                "target_lang_word": "vervormd",
                                "target_lang_sense_clarification": "voltooid deelwoord van vervormen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}