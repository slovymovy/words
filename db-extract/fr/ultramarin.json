                "senses": [
                    {
                        "sense_id": "10914ac3-5046-3884-99ac-b1188e1bb809",
                        "entry_id": "295a2c31-225a-3915-9e67-8f07997ad0ef",
                        "glosses": [
                            "Relatif à l’outre-mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "035636fa-7a77-4093-8858-b5f39308c87d",
                                "sense_id": "10914ac3-5046-3884-99ac-b1188e1bb809",
                                "text": "Avec, par-dessus les toits, par-dessus les amours miteuses au ras du quotidien le plus fade, un grand rêve ultramarin vers l'Argentine − qui bien sûr ne se réalise jamais."
                            },
                            {
                                "example_id": "000c39ca-3f08-40d2-a566-240e54e16dcc",
                                "sense_id": "10914ac3-5046-3884-99ac-b1188e1bb809",
                                "text": "La douceur et la beauté des territoires ultramarins français, captés par le photographe Charly Triballeau."
                            },
                            {
                                "example_id": "dc9ec545-2b23-494c-8b31-f417e7671de1",
                                "sense_id": "10914ac3-5046-3884-99ac-b1188e1bb809",
                                "text": "Car, malgré l’obligation de scolarisation à 3 ans, certains enfants ultramarins restent à la porte de l’école de la République."
                            },
                            {
                                "example_id": "2a1f8884-519e-4fc9-8835-38e6d213647a",
                                "sense_id": "10914ac3-5046-3884-99ac-b1188e1bb809",
                                "text": "C’est aussi la première fois qu’un député ultramarin, et en particulier de l’île de la Réunion, accède au poste de vice-président du Parlement européen, une « immense fierté pour les citoyens des départements et territoires français d’outre-mer »."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fd3a8f7-097a-3ca2-8771-920159479d2f",
                        "entry_id": "295a2c31-225a-3915-9e67-8f07997ad0ef",
                        "glosses": [
                            "De couleur bleu outremer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "807ea36c-8abc-47cd-af88-ce8c8980dc9d",
                                "sense_id": "8fd3a8f7-097a-3ca2-8771-920159479d2f",
                                "text": "Quand les juillets faisaient crouler à coups de triques\nLes cieux ultramarins aux ardents entonnoirs."
                            }
                        ]
                    }
                ],
