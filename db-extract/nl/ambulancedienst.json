                            {
                                "example_id": "89daa85c-1f51-4444-8fc4-d182932b79c5",
                                "sense_id": "6da307ce-b718-3cf6-9ec4-7acddedb3ecc",
                                "text": "Er is ook een ambulancedienst die per motor patiënten kan ophalen."
