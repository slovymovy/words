                "senses": [
                    {
                        "sense_id": "d3933904-3d26-34c6-a452-7a5c8bbae2cd",
                        "entry_id": "813042c7-5b9e-3c5a-a634-1dcfc9aec8b7",
                        "glosses": [
                            "A doctor, usually practicing traditional medicine."
                        ],
                        "tags": [
                            "South-Asia"
                        ],
                        "examples": [
                            {
                                "example_id": "b8bf063e-83b7-4a0d-8692-a79c829e76cf",
                                "sense_id": "d3933904-3d26-34c6-a452-7a5c8bbae2cd",
                                "text": "The second speaks of naturall Philosophy or Physick, and is studyed by the Hackeams or Physitians […]"
                            },
                            {
                                "example_id": "00fe5de2-8780-4da0-92c3-8ca3686c35d1",
                                "sense_id": "d3933904-3d26-34c6-a452-7a5c8bbae2cd",
                                "text": "I went up to them, and they said, ‘We hear that you are a hakim, who has done great things.’"
                            },
                            {
                                "example_id": "b2ccbfb2-5813-4678-822b-9c3e6c212a64",
                                "sense_id": "d3933904-3d26-34c6-a452-7a5c8bbae2cd",
                                "text": "‘It was his duty to report suspicious characters, and conceivably it was some disreputable hakim who had prowled up from the bazaar.’"
                            },
                            {
                                "example_id": "23481afc-47a9-423b-8d27-e8da92124bc6",
                                "sense_id": "d3933904-3d26-34c6-a452-7a5c8bbae2cd",
                                "text": "The Englishman was to remain there for three weeks, this time posing as a hakeem, secretly observing and noting down everything of significance."
                            }
                        ]
                    }
                ],
