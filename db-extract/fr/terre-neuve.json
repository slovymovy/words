                "forms": [],
                "senses": [
                    {
                        "sense_id": "9293fbac-b0a0-32c4-ae4a-d91f7b14d81f",
                        "entry_id": "8edc9e81-8ab6-3413-ac41-fdf2e038a026",
                        "glosses": [
                            "Race de chien molossoïde type chien de montagne originaire de l’île de Terre-Neuve, Canada, à forte taille et présentant généralement une épaisse fourrure noire, marron ou noire et blanche."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a6ae4d1a-3913-4b0b-b819-460689b93b9e",
                                "sense_id": "9293fbac-b0a0-32c4-ae4a-d91f7b14d81f",
                                "text": "Des terre-neuve."
                            },
                            {
                                "example_id": "9f25e73a-4c7d-4b09-9a6b-80fa8e54ede3",
                                "sense_id": "9293fbac-b0a0-32c4-ae4a-d91f7b14d81f",
                                "text": "Vous avez dû me prendre pour un terre-neuve. Je n’ai pas pu me retenir…"
                            },
                            {
                                "example_id": "eca3e850-d90b-4548-92f3-95cfd91a4238",
                                "sense_id": "9293fbac-b0a0-32c4-ae4a-d91f7b14d81f",
                                "text": "Voilà un petit chien bousculé, qui hurle et hurle…, étrangement fort, comme s’il était l’âme d’un Terre-Neuve gigantesque écrasé plus loin."
                            }
                        ]
                    }
                ],
