                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Empire",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c837416b-6d7b-38e4-847e-35405bb3a672",
                                        "entry_id": "5ead6b1c-debb-3760-a7f4-9d521d82f2da",
                                        "glosses": [
                                            "Britisches Weltreich, das während des Kolonialismus existierte und zu dem alle unter der Herrschaft Großbritanniens stehenden Gebiete gehörten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3604bf1-7414-48a9-8f42-6db713f6df45",
                                                "sense_id": "c837416b-6d7b-38e4-847e-35405bb3a672",
                                                "text": "„Selbst im Falle eines deutschen Sieges wäre das Empire schließlich nicht existentiell bedroht worden.“"
                                            },
                                            {
                                                "example_id": "9b630fbb-0bc2-4c71-8fd1-8c5db42ee323",
                                                "sense_id": "c837416b-6d7b-38e4-847e-35405bb3a672",
                                                "text": "„Dass das Empire noch nicht vorbei war, das war ja schon sein Eindruck im Reform Club gewesen.“"
                                            },
                                            {
                                                "example_id": "be2b0e7d-9eae-4534-bbef-303cd79f5891",
                                                "sense_id": "c837416b-6d7b-38e4-847e-35405bb3a672",
                                                "text": "„Auch militärisch zog das Empire Konsequenzen: In der Bengalen-Armee verdreifachte es den Anteil britischer Soldaten gegenüber den Einheimischen.“"
                                            },
                                            {
                                                "example_id": "d215be57-fa06-4f06-8784-b459629f3dde",
                                                "sense_id": "c837416b-6d7b-38e4-847e-35405bb3a672",
                                                "text": "„In vielen Städten des britischen Empires bis hin nach Südafrika kam es derweil zu Plünderungen in Läden mit deutsch klingenden Namen.“"
                                            }
                                        ],
