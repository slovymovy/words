    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7378c497-c236-3f72-8daf-be6ecf457880",
                    "sense_definition": "Сравнительная степень наречия <w>далеко</w>; на более значительном расстоянии.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_comp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отойди немного <w>дальше</w> от края платформы.",
                            "target_lang_translations": {
                                "en": "Step a little <w>further</w> back from the edge of the platform.",
                                "zh": "请离站台边缘<w>远</w>一点。"
                            }
                        },
                        {
                            "text": "Мой дом находится <w>дальше</w>, чем я думал.",
                            "target_lang_translations": {
                                "en": "My house is <w>further</w> away than I thought.",
                                "zh": "我家比我想象的要<w>远</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ближе"
                    ],
                    "common_phrases": [
                        "как можно дальше",
                        "не дальше чем",
                        "чуть дальше"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative degree"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At a greater distance; further away (comparative of 'far').",
                        "zh": "在更远的距离；更远（“远”的比较级）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "further",
                                "target_lang_sense_clarification": "comparative of far; general distance"
                            },
                            {
                                "target_lang_word": "farther",
                                "target_lang_sense_clarification": "specifically physical distance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更远",
                                "target_lang_sense_clarification": "表示空间距离上的比较"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1977341-aa53-31bc-b53d-ce3029c69012",
                    "sense_definition": "Затем, после этого; в следующий момент времени.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temporal_seq",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рассказывай, что было <w>дальше</w>.",
                            "target_lang_translations": {
                                "en": "Tell me what happened <w>next</w>.",
                                "zh": "继续讲，<w>接下来</w>发生了什么？"
                            }
                        },
                        {
                            "text": "Сначала мы пообедали, а <w>дальше</w> пошли гулять в парк.",
                            "target_lang_translations": {
                                "en": "First we had lunch, and <w>then</w> we went for a walk in the park.",
                                "zh": "我们先吃了午饭，<w>然后</w>去公园散步了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "затем",
                        "потом",
                        "после этого"
                    ],
                    "antonyms": [
                        "раньше"
                    ],
                    "common_phrases": [
                        "что дальше",
                        "а дальше",
                        "и так дальше"
                    ],
                    "target_lang_definitions": {
                        "en": "Then; subsequently; what happens next.",
                        "zh": "然后；随后；接下来发生的事。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "next",
                                "target_lang_sense_clarification": "following in time or order"
                            },
                            {
                                "target_lang_word": "then",
                                "target_lang_sense_clarification": "at that time; subsequently"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "接下来",
                                "target_lang_sense_clarification": "表示时间或顺序上的紧接着"
                            },
                            {
                                "target_lang_word": "然后",
                                "target_lang_sense_clarification": "表示动作的先后顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3785d833-bafc-39f3-b246-ddc0dfab053a",
                    "sense_definition": "Продолжая начатое действие или состояние; впредь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "continuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы будем и <w>дальше</w> работать над этим сложным проектом.",
                            "target_lang_translations": {
                                "en": "We will work <w>further</w> on this complex project.",
                                "zh": "我们将<w>继续</w>致力于这个复杂的项目。"
                            }
                        },
                        {
                            "text": "Не останавливайся, читай <w>дальше</w>.",
                            "target_lang_translations": {
                                "en": "Don't stop, read <w>on</w>.",
                                "zh": "别停下，<w>继续</w>读。"
                            }
                        }
                    ],
                    "synonyms": [
                        "далее"
                    ],
                    "common_phrases": [
                        "жить дальше",
                        "идти дальше"
                    ],
                    "target_lang_definitions": {
                        "en": "Continuing an action or state; further on; in the future.",
                        "zh": "继续某种动作或状态；往后；将来。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "further",
                                "target_lang_sense_clarification": "continuing to a greater extent"
                            },
                            {
                                "target_lang_word": "on",
                                "target_lang_sense_clarification": "continuing an action (e.g., read on)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继续",
                                "target_lang_sense_clarification": "表示动作的持续"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
