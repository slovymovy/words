                                "target_senses": [
                                    {
                                        "sense_id": "ad030c1d-23c0-3bbb-92ee-8b0850358006",
                                        "entry_id": "d133f348-78d6-3851-b24d-b34afc27fd3a",
                                        "glosses": [
                                            "анат. образование из соединительной ткани, концевая структура поперечно-полосатых мышц, с помощью которой они прикрепляются к костям скелета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82853f69-a80a-4da9-a252-20a826dd429f",
                                                "sense_id": "ad030c1d-23c0-3bbb-92ee-8b0850358006",
                                                "text": "Коллаген — наиболее распространенный белок у млекопитающих — образует основу сухожилий, костей, кожи и хрящей."
                                            },
                                            {
                                                "example_id": "37adc2bf-04ba-4c29-8c15-e6a07645a636",
                                                "sense_id": "ad030c1d-23c0-3bbb-92ee-8b0850358006",
                                                "text": "Гиппократ не отличал нервы от сухожилий и вены от артерий."
