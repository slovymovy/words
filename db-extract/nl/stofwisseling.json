                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Metabolismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "075a5f33-4134-3946-a496-1bee42bb19a3",
                                        "entry_id": "90d4e811-c2f0-31e3-bdba-599c38543af2",
                                        "glosses": [
                                            "Stoffwechsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5729f76a-be2d-4edc-9e66-e8fe0706ddc9",
                                                "sense_id": "075a5f33-4134-3946-a496-1bee42bb19a3",
                                                "text": "Der gesamte Metabolismus ist in Unordnung geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e9b04aa-c692-3d40-ac65-9a3dde6af03a",
                                        "entry_id": "90d4e811-c2f0-31e3-bdba-599c38543af2",
                                        "glosses": [
                                            "Konzept der (japanischen) Metabolisten (der Nachkriegzeit) von einer flexiblen, erweiterbaren Architektur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399fcd1a-d94c-4735-ba9b-e5eadf24789a",
                                                "sense_id": "7e9b04aa-c692-3d40-ac65-9a3dde6af03a",
                                                "text": "Metabolismus bedeutet nichts anderes, als dass Architektur nicht als Festgefügtes gesehen wird, sondern als etwas, das ständigem Wandel unterliegt."
                                            },
                                            {
                                                "example_id": "f2c1642c-d52d-423d-b326-808a40f148ff",
                                                "sense_id": "7e9b04aa-c692-3d40-ac65-9a3dde6af03a",
                                                "text": "„Jene Deutung, die vom medizinischen Begriff Metabolismus, also dem Stoffwechsel, ausgeht, ist zwar nicht ganz falsch, mit organischen Vorstellungen hat der architektonische Metabolismus aber nur wenig zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9702e9d-db7b-364e-a7e1-401952b2eba1",
                                        "entry_id": "90d4e811-c2f0-31e3-bdba-599c38543af2",
                                        "glosses": [
                                            "Veränderung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "273e1da8-6f8a-4cb5-a57a-32de81525193",
                                                "sense_id": "f9702e9d-db7b-364e-a7e1-401952b2eba1",
                                                "text": "„Insofern ist der, wie Ryder es nannte, demografische Metabolismus der kohortenbezogenen Wechselwirkung von Mikro- und Makobedingungen immer »einmalig« […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d89f8146-73f5-4192-8478-d7b9d38f66a7",
                        "source_entry_id": "e123319f-46dc-3918-b7d3-1fceb84203cd",
                        "source_sense_id": "26ac1ad2-5982-3006-997c-a4edf79d7abe",
