                    {
                        "sense_id": "40a83c91-456f-32cb-b727-fc8ced15ab1d",
                        "entry_id": "b291a8f9-b4b9-3e5a-b9da-619f3b0381e6",
                        "glosses": [
                            "Sentier servant généralement aux piétons."
                        ],
                        "tags": [
                            "Berry"
                        ],
                        "examples": [
                            {
                                "example_id": "27a83c95-618c-41d1-ac94-f6419c9105f0",
                                "sense_id": "40a83c91-456f-32cb-b727-fc8ced15ab1d",
                                "text": "Nous étions restés en arrière tous les deux je ne sais plus pourquoi, et, pour rattraper les autres, l’idée nous vint de prendre une traquette à peine frayée dans les ravines."
                            },
                            {
                                "example_id": "87209408-d14e-4830-8e6b-6d6793dc0595",
                                "sense_id": "40a83c91-456f-32cb-b727-fc8ced15ab1d",
                                "text": "Et le soleil lui bat les tempes, tandis qu’elle tortille sa course légère dans l’étroite traquette privée d’herbe au milieu du chemin."
                            }
                        ]
                    }
