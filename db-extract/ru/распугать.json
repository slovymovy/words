                        "glosses": [
                            "to scare away"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1e06b25-132d-4997-89ff-b86d4fce15a1",
                                "sense_id": "32195309-6f4a-3636-8511-79190cf27d1b",
                                "text": "— И́менно фу́ги, — подда́кнул он, — пусть она́ же́нщина, мо́жет быть, гениа́льная, литерату́рная, но — воробьёв она́ распуга́ет.",
                                "translation": "\"Fougue, precisely,\" he agreed. \"Granted she may be a genius, a literary woman, but—she'll scare the sparrows away.…\"",
                                "english": "\"Fougue, precisely,\" he agreed. \"Granted she may be a genius, a literary woman, but—she'll scare the sparrows away.…\""
                            },
                            {
                                "example_id": "9f27e23e-8d8e-4367-837e-49e73dd657a2",
                                "sense_id": "32195309-6f4a-3636-8511-79190cf27d1b",
                                "text": "Гром! Прогреме́л по кры́шам, распуга́л всех ко́шек гром...",
                                "translation": "DDT",
                                "english": "DDT"
                            }
                        ]
                    }
