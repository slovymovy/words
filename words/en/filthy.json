                            {
                                "target_lang_word": "detestable",
                                "target_lang_sense_clarification": "que es muy desagradable o digno de rechazo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e300eab-2f40-328d-9d8b-6e30925b8fd3",
                    "sense_definition": "Angry; upset; severely annoyed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My dad was absolutely <w>filthy</w> when he found out I scratched his car.",
                            "target_lang_translations": {
                                "ru": "Мой папа был просто <w>в бешенстве</w>, когда узнал, что я поцарапал его машину.",
                                "zh": "我爸发现我刮了他的车后简直<w>暴怒</w>。",
                                "es": "Mi papá estaba <w>furioso</w> cuando se enteró de que rayé su coche."
                            }
                        },
                        {
                            "text": "She gave me a <w>filthy</w> look when I interrupted her speech.",
                            "target_lang_translations": {
                                "ru": "Она бросила на меня <w>злобный</w> взгляд, когда я прервал её речь.",
                                "zh": "当我打断她的演讲时，她给了我一个<w>凶狠</w>的眼神。",
                                "es": "Me lanzó una mirada <w>llena de odio</w> cuando interrumpí su discurso."
                            }
                        }
                    ],
                    "common_phrases": [
                        "filthy look"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British or Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злой; рассерженный; крайне раздраженный.",
                        "zh": "愤怒的；心烦意乱的；极度恼火的。",
                        "es": "Muy enfadado, furioso o molesto."
