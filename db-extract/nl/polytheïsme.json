        "nl-extract.jsonl": [
            {
                "entry_id": "469f9633-87bb-3131-b5eb-653c4ae4ad5a",
                "word": "polytheïsme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                        "entry_id": "469f9633-87bb-3131-b5eb-653c4ae4ad5a",
                        "glosses": [
                            "godsdienst met meer dan één god"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "748d628a-f433-4ad6-bb5c-5fcd7d47e433",
                                "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                                "text": "Het polytheïsme van de oudheid is genereus en tolerant. Lokale goden krijgen hun plaats naast die van de overheerser; ze worden ermee geassocieerd, zelfs geïdentificeerd. In Palmyra was alles hybride. Niet dat ik IS verdenk van veel historisch inzicht, maar hun ideologie die monolithische zekerheid en van elke nuance losgezongen zuiverheid nastreeft, kon niet anders dan Palmyra afwijzen en vernietigen."
                            },
                            {
                                "example_id": "9cb687f6-0188-4f36-bfa7-4026fc0b5438",
                                "sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                                "text": "In dat opzicht valt er iets te zeggen over algemene factoren die gewelddadigheid eerder bevorderen dan wel afremmen. Monotheïsme is gevaarlijker dan polytheïsme - voor de God van de ander is geen plaats. Het leidt snel tot rechtlijnige almacht, terwijl een Olympus vol goden veeleer in een verdeling der machten, en dus een machtsevenwicht resulteert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68abf06-a580-4b78-8af7-74711005765b",
                        "source_entry_id": "469f9633-87bb-3131-b5eb-653c4ae4ad5a",
                        "source_sense_id": "40b72e52-b897-334a-aedb-4a607afa189f",
                        "source_sense_description": "godsdienst met meer dan één god",
                        "target_lang_word": "polytheism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polytheism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bd4404-49f0-3007-876d-21ac729134e4",
                                        "entry_id": "95fcb960-118a-31ae-8783-b023babbfe93",
                                        "glosses": [
                                            "The belief in the existence of multiple gods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44922397-30dc-4ecc-9449-2798ef43e4d5",
                                                "sense_id": "b5bd4404-49f0-3007-876d-21ac729134e4",
                                                "text": "And remember when Lokmân said unto his son, as he admonished him, Oh my son, give not a partner unto GOD; for polytheism is a great impiety."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0587acab-47f5-32a4-a0d2-2447753f4542",
                                        "entry_id": "95fcb960-118a-31ae-8783-b023babbfe93",
                                        "glosses": [
                                            "A religion or belief system with multiple gods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722da660-5358-4325-9fa4-0cffb1b8b9e3",
                                                "sense_id": "0587acab-47f5-32a4-a0d2-2447753f4542",
                                                "text": "The Chaldeans worshipped the seven planets. These seven planets were the \"Seven Great Gods\" of the ancients, and constituted a polytheism, the component members of which varied in importance, with the moon occupying the premier position."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
