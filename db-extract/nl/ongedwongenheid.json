                                    {
                                        "sense_id": "312c35b9-f724-3b3d-a768-e091e21a1b92",
                                        "entry_id": "f709f7d3-00bb-396f-8f90-e3533bd1b38e",
                                        "glosses": [
                                            "The condition of being informal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef39fdf1-9941-4a5e-8a83-7388b4d3cbac",
                                                "sense_id": "312c35b9-f724-3b3d-a768-e091e21a1b92",
                                                "text": "These people, drawn from many different places and with many different backgrounds, gave the whole life of the County an informality that was new to Ellen, an informality to which she never quite accustomed herself."
                                            },
                                            {
                                                "example_id": "59397846-175f-40e5-86bd-669157c09a4b",
                                                "sense_id": "312c35b9-f724-3b3d-a768-e091e21a1b92",
                                                "text": "More importantly and closer to life, slangs help build an instant intimacy and informality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "098f4cc2-5b8e-3e5c-b148-c64bed535346",
                                        "entry_id": "f709f7d3-00bb-396f-8f90-e3533bd1b38e",
                                        "glosses": [
                                            "An informal term or usage; a colloquialism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1d8f04f-e23c-47c2-9710-6ced2cc94a0f",
                                                "sense_id": "098f4cc2-5b8e-3e5c-b148-c64bed535346",
                                                "text": "One long riff without a beginning and without an end :Template:.., only portions of which […] may be served up to us here, punctuated — the word hardly seems appropriate to a piecemeal poetry in which, except for the ubiquitous slash, there is precious little punctuation — momentarily halted, then, by an affirmative informality (\"yeah\"), by a labored repetition (\"he was/ he was/ i swear he was\"), or by a barbarous appeal for final comprehension: \"know what i mean/ dontyah dontyah dontyah know what i mean.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "662db784-575c-4ab1-87fa-e3e7f5c0ed7a",
                        "source_entry_id": "4bd78a24-bfbf-33ca-a23c-3e3d6ef3c03b",
                        "source_sense_id": "a2050969-6d24-3c6a-a23f-c6a9a601ca7c",
