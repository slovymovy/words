                        "glosses": [
                            "een menselijke vorm gevend (aan iets abstracts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72965554-891c-4160-9e95-75312babdbba",
                                "sense_id": "5257ea9f-569d-3dde-8234-33f71339e418",
                                "text": "De extravagante rockzanger is de vleesgeworden nachtmerrie van bezorgde ouders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d9db6de-ef5a-4f85-8761-01260d9ed952",
                        "source_entry_id": "ab46fcd7-294c-3bb0-ae2d-17cef261b037",
                        "source_sense_id": "5257ea9f-569d-3dde-8234-33f71339e418",
                        "source_sense_description": "een menselijke vorm gevend (aan iets abstracts)",
                        "target_lang_word": "incarnate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incarnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fec19c9-b934-3d26-a7b9-c18baf01a0f6",
                                        "entry_id": "94f578fe-6648-3afa-863a-8dd0569d68e0",
                                        "glosses": [
                                            "Embodied in flesh; given a bodily, especially a human, form; personified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29738dc4-bc04-4f31-9952-3150de83e08e",
                                                "sense_id": "5fec19c9-b934-3d26-a7b9-c18baf01a0f6",
                                                "text": "Here shalt thou sit incarnate."
                                            },
                                            {
                                                "example_id": "d7f21a84-9552-42c1-9b5d-93ae1d327305",
                                                "sense_id": "5fec19c9-b934-3d26-a7b9-c18baf01a0f6",
                                                "text": "1751-1753, John Jortin, Remarks on Ecclesiastical History\nHe […] represents the emperor and his wife as two devils incarnate, sent into the world for the destruction of mankind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ac0b1f-d9d8-3c51-98eb-ce012da558f7",
                                        "entry_id": "94f578fe-6648-3afa-863a-8dd0569d68e0",
                                        "glosses": [
                                            "Flesh-colored; crimson."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd381e9f-afab-40c1-b3f9-ba73a42980c8",
                                                "sense_id": "f7ac0b1f-d9d8-3c51-98eb-ce012da558f7",
                                                "text": "Yards of Turkey silk incarnate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incarnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca5dedf-78f5-39c5-835a-ae790ff7b861",
                                        "entry_id": "fd226649-a017-3afc-b280-37662244c729",
                                        "glosses": [
                                            "To embody in flesh; to invest with a bodily, especially a human, form."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eac0ba46-d0d9-4b92-b3f7-28658ff2e4cc",
                                                "sense_id": "1ca5dedf-78f5-39c5-835a-ae790ff7b861",
                                                "text": "For one thing, we virtually decided that these morbidities and the hellish Himalayan Mi-Go were one and the same order of incarnated nightmare."
                                            },
                                            {
                                                "example_id": "59845ed6-b4df-44a3-ae5c-d1c99980bfb3",
                                                "sense_id": "1ca5dedf-78f5-39c5-835a-ae790ff7b861",
                                                "text": "Not all of the soul can incarnate into a body; the part which is left above is the psyche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb589e92-1169-38be-b752-84d5613319e2",
                                        "entry_id": "fd226649-a017-3afc-b280-37662244c729",
                                        "glosses": [
                                            "To gain full existence (bodily or otherwise)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a3c4e09-0536-46ba-9823-5037f2a547be",
                                                "sense_id": "bb589e92-1169-38be-b752-84d5613319e2",
                                                "text": "SCP-3125 incarnated the following winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4651a3b3-4c7a-3bf5-a5d0-b6fc48bc78e7",
                                        "entry_id": "fd226649-a017-3afc-b280-37662244c729",
                                        "glosses": [
                                            "To incarn; to become covered with flesh; to heal over."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "276e17cc-012b-45aa-bc84-a60c401f2b57",
                                                "sense_id": "4651a3b3-4c7a-3bf5-a5d0-b6fc48bc78e7",
                                                "text": "My uncle Toby’s wound was near well, and as soon as the surgeon recovered his surprize, and could get leave to say as much—he told him, 'twas just beginning to incarnate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8996a02-00fb-3bd4-9145-fd75d9368baf",
                                        "entry_id": "fd226649-a017-3afc-b280-37662244c729",
                                        "glosses": [
                                            "To make carnal; to reduce the spiritual nature of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdd5ddc0-b94c-4114-9c84-024dbe8aa4e7",
                                                "sense_id": "b8996a02-00fb-3bd4-9145-fd75d9368baf",
                                                "text": "This essence to incarnate and imbrute, / That to the height of deity aspired."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9434e247-aa11-3bfc-8a72-dfbfa4b233f5",
                                        "entry_id": "fd226649-a017-3afc-b280-37662244c729",
                                        "glosses": [
                                            "To put into or represent in a concrete form, as an idea."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1213143-34ab-4e88-834d-2836431bc4f4",
                                                "sense_id": "9434e247-aa11-3bfc-8a72-dfbfa4b233f5",
                                                "text": "Truly, that special world presented itself to me as the arena of my perceptual activity and therefore as the world of my first reading. The texts, the words, the letters of that context were incarnated in a series of things, objects, and signs."
                                            },
                                            {
                                                "example_id": "825725f8-1ffc-4e78-94af-1a90190f8298",
                                                "sense_id": "9434e247-aa11-3bfc-8a72-dfbfa4b233f5",
                                                "text": "Responding to this in confusion, perhaps you construct an Idea, a structure, a multiplicity, a system of multiple, nonlocalisable ideal connections which is then incarnated. It is incarnated in real (not ideal) relations and actual (physical) terms, each of which exists in relation to each other, reciprocally determining each other."
                                            },
                                            {
                                                "example_id": "2052b830-d6ea-455c-84d7-52111bd0c148",
                                                "sense_id": "9434e247-aa11-3bfc-8a72-dfbfa4b233f5",
                                                "text": "The two are fused together in a single act and single product, precisely as an idea incarnated in an image, i.e., the expression of an embodied-spirit, grasped all at once as a meaning shining through a manifold of images and held as one in the unity of human consciousness which is simultaneously intellectual and sensible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "incarnate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7df4295f-4d7a-37e9-b031-8b1937fbb6b8",
                                        "entry_id": "8ce4e353-d3bf-366f-96e4-94a0d11798f9",
                                        "glosses": [
                                            "Not in the flesh; spiritual."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea240050-e0a0-4d72-92bf-ae9d5ef62e50",
                                                "sense_id": "7df4295f-4d7a-37e9-b031-8b1937fbb6b8",
                                                "text": "I fear nothing […] that devil carnate or incarnate can fairly do."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
