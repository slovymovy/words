                        "sense_id": "e4f00898-7dfa-35d1-a2b6-a393ff90eb73",
                        "entry_id": "dd8d2852-20d9-38be-9976-175e423577e3",
                        "glosses": [
                            "Mediziner, der sich mit den Erkrankungen der Nieren beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba83e3ed-fe82-4727-9c2f-e3ddc56fdfb3",
                                "sense_id": "e4f00898-7dfa-35d1-a2b6-a393ff90eb73",
                                "text": "Der Urologe schickte ihn zur genauen Abklärung des Befunds zum Nephrologen."
                            },
                            {
                                "example_id": "20b1f8d9-d97c-48ad-b234-ceccb742a00a",
                                "sense_id": "e4f00898-7dfa-35d1-a2b6-a393ff90eb73",
                                "text": "„Als Internist und Nephrologe an der Berliner Charité wurde er vielfach beratend hinzugezogen, wenn bei einer Frau während der Schwangerschaft gesundheitliche Probleme auftraten.“"
                            }
                        ],
