                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c67344a-8318-3082-87dc-a2005c2e9547",
                        "entry_id": "ddec77bb-4b33-3c30-b848-facb441d06a3",
                        "glosses": [
                            "Mot italien qui veut dire « moyen » et qui s’emploie dans les expressions suivantes :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a7720b-5d9f-4f78-bc56-7e7df2cfdaea",
                                "sense_id": "9c67344a-8318-3082-87dc-a2005c2e9547",
                                "text": "Mezza voce, à demi-voix."
                            },
                            {
                                "example_id": "262a37fb-56f6-4434-825a-7475e9c2c26d",
                                "sense_id": "9c67344a-8318-3082-87dc-a2005c2e9547",
                                "text": "Mezzo forte, modérément, en tenant le milieu entre le forte et le piano."
                            },
                            {
                                "example_id": "3f1b38ce-8b41-49aa-9e08-3bc2c4256cda",
                                "sense_id": "9c67344a-8318-3082-87dc-a2005c2e9547",
                                "text": "Mezzo soprano, voix plus aiguë que le contralto et plus grave que le soprano."
                            },
                            {
                                "example_id": "d724fc5e-3b90-4004-b7b1-0ec7fc6d7ffd",
                                "sense_id": "9c67344a-8318-3082-87dc-a2005c2e9547",
                                "text": "Mezza orchestra, à demi-orchestre ; il s'écrit pour indiquer les passages qui ne doivent être exécutés que par la moitié des instruments."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
