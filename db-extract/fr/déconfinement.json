                "senses": [
                    {
                        "sense_id": "f5caedb2-c87c-3396-83fc-39b962d59de8",
                        "entry_id": "76b0c706-fd8e-3c87-8df0-21a45eea9922",
                        "glosses": [
                            "Arrêt d’un confinement."
                        ],
                        "tags": [
                            "Sûreté nucléaire"
                        ],
                        "examples": [
                            {
                                "example_id": "fde91e9a-e5ed-4dcb-9f1c-bb48e5201c26",
                                "sense_id": "f5caedb2-c87c-3396-83fc-39b962d59de8",
                                "text": "Un réacteur thermonucléaire à confinement magnétique doit fonctionner à l’équilibre. Les gains d’énergie dus à la réaction compensent exactement les pertes par rayonnement et déconfinement."
                            },
                            {
                                "example_id": "7a322bcd-2f43-403d-874c-3336972023dc",
                                "sense_id": "f5caedb2-c87c-3396-83fc-39b962d59de8",
                                "text": "Cet état est appelé plasma quark-gluon. il est associé à des températures très élevées : la température de déconfinement est d’environ 10¹⁰ K."
                            },
                            {
                                "example_id": "f9f9f6fc-10d0-4b99-b3e3-21b60c0394e2",
                                "sense_id": "f5caedb2-c87c-3396-83fc-39b962d59de8",
                                "text": "Ce phénomène est appelé déconfinement, car le terrain autour de la galerie passe progressivement d’un état confiné (avant creusement) à un état déconfiné (après creusement s’il n’y a pas de soutènement)."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0330b5b-3cc4-3ed0-8ed5-17311a94b70d",
                        "entry_id": "76b0c706-fd8e-3c87-8df0-21a45eea9922",
                        "glosses": [
                            "Fin d’une mesure de confinement imposée à une population sur un territoire."
                        ],
                        "tags": [
                            "Santé publique"
                        ],
                        "examples": [
                            {
                                "example_id": "20c13a8a-5adf-43de-b6e4-1130e7160563",
                                "sense_id": "b0330b5b-3cc4-3ed0-8ed5-17311a94b70d",
                                "text": "Auditionné mercredi par une mission d’information, le premier ministre a notamment annoncé que le « déconfinement » pourrait être progressif."
                            }
                        ]
                    }
                ],
