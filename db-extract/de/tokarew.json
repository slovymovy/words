                "senses": [
                    {
                        "sense_id": "9457de4b-44a8-34ef-8202-6f42f60434e7",
                        "entry_id": "e940d90d-8127-3553-bbd6-4c647d308f77",
                        "glosses": [
                            "von Fjodor Wassiljewitsch Tokarew entworfene Waffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bbdfef7-0ee6-4e9b-b1c9-3e566db514b4",
                                "sense_id": "9457de4b-44a8-34ef-8202-6f42f60434e7",
                                "text": "„Mit meinem übernatürlichen Blick durch meine nicht entmenschlichten Augen beobachtete ich von oben, wie mir mein Freund die Pistole in die Hand legte. Eine Tokarew, die die Sowjets nach dem Vorbild des amerikanischen Colts gebaut hatten.“"
                            },
                            {
                                "example_id": "50bd3739-9197-4974-aa9d-f5cd1c7789fc",
                                "sense_id": "9457de4b-44a8-34ef-8202-6f42f60434e7",
                                "text": "„Ein Neunzehnjähriger wühlt unter seinem Kissen eine Tokarew hervor, entsichert sie, rennt auf die Straße und schwört lauthals, die Mütter aller Paschtunen im ganzen Land zu vergewaltigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
