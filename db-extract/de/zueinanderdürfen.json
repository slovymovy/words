                        "examples": [
                            {
                                "example_id": "628b970b-da1b-4630-bc58-d87e672645ee",
                                "sense_id": "a87297e4-9d4e-30a3-8409-f478df49ce70",
                                "text": "Wie viele Familien es sind, die nicht zueinanderdürfen, wird nirgends erhoben. Sicher ist nur: Taleb al-Farres ist keine Ausnahme."
                            },
                            {
                                "example_id": "82312a10-7120-4869-bb2b-4058e0ab121e",
                                "sense_id": "a87297e4-9d4e-30a3-8409-f478df49ce70",
                                "text": "Die Arbeit fühlte sich während jener Zeit wie etwas an, das wir zu von zu erledigen hatten, bevor wir wieder zueinanderdurften."
                            }
