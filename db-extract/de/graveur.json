                        ],
                        "examples": [
                            {
                                "example_id": "c808be98-bb5f-430c-8567-daecf10b2fd1",
                                "sense_id": "8cf45558-f2b2-3f59-9db4-05796db13c4f",
                                "text": "„In dieser Situation meldete sich der Bäckergehilfe Matias Pipet und erklärte, dass er bei einem italienischen Graveur in die Lehre gegangen sei.“"
