                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b41b07-8c44-4782-bae2-79304ac0f7d6",
                                "sense_id": "9e66ceb9-83de-34a7-9c19-9133a1c4d5ea",
                                "text": "Pró­bo­wała swo­ich sił jako prawniczka, dziennikarka, didżejka, a także – ze szczególnie kiepskimi efektami – kelnerka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d7e7fba-6603-4ce9-a2a0-8a9318ba33e1",
                        "source_entry_id": "b9fb058d-12ac-33c6-89b8-863fcd80dbbf",
                        "source_sense_id": "9e66ceb9-83de-34a7-9c19-9133a1c4d5ea",
                        "target_lang_word": "Rechtsanwältin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechtsanwältin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6787f9dd-00c5-3c3c-a418-0f52a832aea7",
                                        "entry_id": "253c9478-d56e-37b3-a4da-5b7690d3f997",
                                        "glosses": [
                                            "staatlich geprüfte und zur Rechtsberatung zugelassene Juristin, die freiberuflich tätig ist und die ihre Auftraggeber bei Gericht sowie außergerichtlich vertritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c6cfd0-c169-4193-94fe-60326680f88e",
                                                "sense_id": "6787f9dd-00c5-3c3c-a418-0f52a832aea7",
                                                "text": "„Eine Rechtsanwältin hat der Gegenpartei ein Geheimnis verraten. Dafür stand sie nun selbst vor Gericht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ceb77e6-4200-4f18-affd-bb5b64046b53",
                        "source_entry_id": "b9fb058d-12ac-33c6-89b8-863fcd80dbbf",
                        "source_sense_id": "9e66ceb9-83de-34a7-9c19-9133a1c4d5ea",
                        "target_lang_word": "Juristin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juristin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                        "entry_id": "0f07dfe0-49c3-31b2-bf6f-e03925baa512",
                                        "glosses": [
                                            "weibliche Person, die Jura studiert hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c55217-1442-4ea2-b5de-aaaa05729417",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Das Jurastudium war die Erfüllung ihres Vaters gewesen. Andrew hatte ebenfalls Ambitionen in dieser Richtung gehabt, sie selbst hatte jedoch nie in Erwägung gezogen, Juristin zu werden.“"
                                            },
                                            {
                                                "example_id": "83992708-0acc-4848-8ec5-f095f5cafcfe",
                                                "sense_id": "2406df03-a082-3d7b-a158-c31d72d9df5b",
                                                "text": "„Sie begann ein Studium der Kunstgeschichte, wechselte dann und wurde Juristin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1de8cb6-6a57-4f7f-a98c-fd9ab0b3ade3",
                        "source_entry_id": "b9fb058d-12ac-33c6-89b8-863fcd80dbbf",
                        "source_sense_id": "9e66ceb9-83de-34a7-9c19-9133a1c4d5ea",
                        "target_lang_word": "юристка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "юристка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
