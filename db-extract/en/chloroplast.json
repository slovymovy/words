                                        "glosses": [
                                            "organellum komórkowe występujące u roślin i glonów eukariotycznych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a97c65d-9a3c-4992-8638-a989668a5e10",
                                                "sense_id": "0b81763d-b73e-3016-bfdc-c7ab583b0bff",
                                                "text": "Wewnątrz chloroplastu następuje przekazanie łańcucha białka kolejnym białkom opiekuńczym i odcięcie peptydu tranzytowego"
                                            }
                                        ],
