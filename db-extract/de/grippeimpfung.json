                "senses": [
                    {
                        "sense_id": "f2c9c318-44a3-365c-be99-9dd218b4036f",
                        "entry_id": "24f3aa1d-aced-38b4-8264-20b2aca8eb81",
                        "glosses": [
                            "Impfung, um eine Grippeerkrankung zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18790a4f-d85c-4f81-8829-5ddba5f2d8ac",
                                "sense_id": "f2c9c318-44a3-365c-be99-9dd218b4036f",
                                "text": "Die Grippeimpfung ist bei uns kostenlos."
                            },
                            {
                                "example_id": "05542aef-0d31-43f6-840f-6cc715df677d",
                                "sense_id": "f2c9c318-44a3-365c-be99-9dd218b4036f",
                                "text": "„Womöglich ist nicht die Grippeimpfung an sich dafür verantwortlich, dass die Geimpften weniger an Covid-19 erkranken, sondern dass diese Menschen insgesamt mehr Wert auf ihre Gesundheit legen, also generell fitter sind oder die Hygiene- und Abstandsregeln konsequenter befolgen.“"
                            }
                        ],
