                        "examples": [
                            {
                                "example_id": "3c3888ee-d45c-4898-af11-1808c4687209",
                                "sense_id": "bb92e2ee-68c1-31ca-acbc-7ae2b55e54fd",
                                "text": "auf Kriegsfuß stehen/sein",
                                "translation": "to be on a war footing",
                                "english": "to be on a war footing"
                            },
                            {
                                "example_id": "8e519fb1-20e0-41e9-a1df-0976b910f094",
                                "sense_id": "bb92e2ee-68c1-31ca-acbc-7ae2b55e54fd",
                                "text": "„Das sind Leute, die nicht nur mit dem Autoverkehr auf dem Kriegsfuß sind“, behauptete er, „sondern eigentlich mit der gesamten Gesellschaft.“"
                            },
                            {
                                "example_id": "eab5fa55-e352-4ff6-b2d4-11f531b7b5fc",
                                "sense_id": "bb92e2ee-68c1-31ca-acbc-7ae2b55e54fd",
                                "text": "Der extrem rechte AfD-Flügel rund um Höcke steht mittlerweile auf Kriegsfuß mit Beatrix von Storch, die dem Lager des zurückgetretenen ehemaligen AfD-Vorsitzenden Jörg Meuthen zugerechnet wird."
                            }
                        ]
                    }
