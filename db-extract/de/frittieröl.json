                "senses": [
                    {
                        "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                        "entry_id": "b7799d2b-2cf4-3f1f-b532-dc6cb3a5d8d2",
                        "glosses": [
                            "Pflanzenöl, das zum Frittieren von Speisen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ec2c7c-7f96-4e1c-a118-28593e355986",
                                "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                                "text": "„Das Frittieröl in einem Topf erhitzen.“"
                            },
                            {
                                "example_id": "964c853c-925f-4b81-a1a5-42f877655783",
                                "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                                "text": "„Das Frittieröl erneut erhitzen und die Blumenkohlröschen goldbraun frittieren.“"
                            },
                            {
                                "example_id": "81cfc093-2e7d-4071-90ba-4fb4c57d746c",
                                "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                                "text": "„Etwa 200 ml Frittieröl in einem Topf auf 170°C erhitzen.“"
                            },
                            {
                                "example_id": "95fb9110-6157-493e-8e56-558c2b70a138",
                                "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                                "text": "„Nicht nur ihr Haar, sondern jede einzelne ihrer Körperzellen duftete nach Frittieröl.“"
                            },
                            {
                                "example_id": "5ed17516-8cd8-48d4-9172-6f437021e10b",
                                "sense_id": "8c6b61e7-d426-38ab-adc8-019e8b230133",
                                "text": "„Der Parkplatz war voll, Bus an Bus, in der Luft Schwaden von Frittieröl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
