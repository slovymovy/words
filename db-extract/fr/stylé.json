                    {
                        "sense_id": "6db5112d-e775-371f-a17f-b1ffde727031",
                        "entry_id": "f8c4d5ba-da45-35ae-895d-99e346963197",
                        "glosses": [
                            "Élégant, classe, cool."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "38f902cf-9feb-4281-b42a-6f15833e5cb0",
                                "sense_id": "6db5112d-e775-371f-a17f-b1ffde727031",
                                "text": "— Pourquoi tu n’utilises pas la spatule pour retourner les crêpes ? C’est tout de même plus simple !\n— Oui, mais les faire sauter, avoue que c’est plus stylé."
                            },
                            {
                                "example_id": "d1c7ae9e-0eca-4320-bb0e-f939b66863f9",
                                "sense_id": "6db5112d-e775-371f-a17f-b1ffde727031",
                                "text": "Maintenant hélas que j’ai dîné, je n’ai plus de raison de vivre, car le soleil stylé comme un valet de chambre ne s’annoncera qu’à minuit… et j’erre de nouveau sans but."
                            }
                        ]
                    }
                ],
