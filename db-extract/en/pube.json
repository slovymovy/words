                                    {
                                        "sense_id": "c80bb0e0-e964-3b39-91ca-bb63c9447b15",
                                        "entry_id": "39c16189-76e0-35bc-9fd9-73f1fd8ac1eb",
                                        "glosses": [
                                            "Poil situé dans la région du pubis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc209881-4dd5-4def-9ec5-80d6bcf4eeba",
                                                "sense_id": "c80bb0e0-e964-3b39-91ca-bb63c9447b15",
                                                "text": "Les poils pubiens ont une importante fonction de protection des parties intimes."
                                            },
                                            {
                                                "example_id": "7acbfcb5-5588-46fb-9f21-d6b2c596eedc",
                                                "sense_id": "c80bb0e0-e964-3b39-91ca-bb63c9447b15",
                                                "text": "L’épilation intégrale rend la vulve plus vulnérable. Les poils pubiens protègent non seulement des frottements avec les sous-vêtements et lors des rapports sexuels, mais ils constituent aussi une barrière contre les microbes."
                                            },
                                            {
                                                "example_id": "e257406a-6887-406b-9bd5-7f90b58470eb",
                                                "sense_id": "c80bb0e0-e964-3b39-91ca-bb63c9447b15",
                                                "text": "Là, il avait rincé à l’eau claire la glu translucide qui amidonnait ses poils pubiens."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d19be82b-da31-47f8-b1f5-c56f7a0d34f2",
                        "source_entry_id": "b76a33e1-7786-315f-ae67-456e00c1208a",
                        "source_sense_id": "71089472-2fd3-3d4a-8558-3b0e8ea98768",
                        "source_sense_description": "a single pubic hair",
                        "target_lang_word": "Schamhaar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schamhaar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c18b661c-40fe-3ab9-a549-0c7b88aae7b1",
                                        "entry_id": "fc4636e7-5d8c-3d3a-baff-f892701541fe",
                                        "glosses": [
                                            "Gesamtheit der Haare an den männlichen oder weiblichen Geschlechtsorganen und der angrenzenden Region"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a62e5837-aaf5-483c-a7c1-a5cbb22858ba",
                                                "sense_id": "c18b661c-40fe-3ab9-a549-0c7b88aae7b1",
                                                "text": "Beim Menschen ist ab der Pubertät das Skrotum im natürlichen Zustand mit Schamhaar bewachsen."
                                            },
                                            {
                                                "example_id": "2d525d23-64dc-4631-b268-aeae83d0a173",
                                                "sense_id": "c18b661c-40fe-3ab9-a549-0c7b88aae7b1",
                                                "text": "„Das zweite war, dass sie glattes Schamhaar hatte.“"
                                            },
                                            {
                                                "example_id": "91246850-29a1-43c4-9e52-ac293e6038c6",
                                                "sense_id": "c18b661c-40fe-3ab9-a549-0c7b88aae7b1",
                                                "text": "„Unter der Haut, den Ranken des Schamhaars, den Kerben und Tälern des Fleisches floß die Lava, und wo sie brannte, wurde aus den Stimmen des Blues ein Wildnis-Schrei, der unbändige tierische Schrei der Lust, auch Schrei der Gefahr, der Angst, der Geburt und Schrei des Schmerzes aus den Urgründen der Natur.“"
                                            },
                                            {
                                                "example_id": "5e9f4cb1-58c4-42be-b8d8-13242c79effe",
                                                "sense_id": "c18b661c-40fe-3ab9-a549-0c7b88aae7b1",
                                                "text": "„Es sieht aus, als wüchse sein Penis direkt aus der Schreibtischplatte – ein Bonsaistämmchen mit den dunkelblonden Schamhaaren als dichter Krone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a03fa1b-ed3d-3f3c-80f4-199163ddcaa1",
                                        "entry_id": "fc4636e7-5d8c-3d3a-baff-f892701541fe",
                                        "glosses": [
                                            "ein einzelnes Haar an den männlichen oder weiblichen Geschlechtsorganen und der angrenzenden Region"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7fb19ac-88aa-45d8-a644-c9fc30061976",
                                                "sense_id": "9a03fa1b-ed3d-3f3c-80f4-199163ddcaa1",
                                                "text": "Die Schamhaare bilden sich zu Beginn der Pubertät."
                                            },
                                            {
                                                "example_id": "4f7051fa-2494-40d6-9c47-cc654b7413e5",
                                                "sense_id": "9a03fa1b-ed3d-3f3c-80f4-199163ddcaa1",
                                                "text": "Viele Menschen entscheiden, sich die Schamhaare zu rasieren."
                                            },
                                            {
                                                "example_id": "e999aeab-39e4-4498-b14c-db7d1b691ca1",
                                                "sense_id": "9a03fa1b-ed3d-3f3c-80f4-199163ddcaa1",
                                                "text": "„Vielleicht ist er behaart wie ein Affe und ich habe nachher wieder büschelweise Schamhaare zwischen den Zähnen.“"
                                            },
                                            {
                                                "example_id": "4ce5b39c-a9db-43e9-9f52-1ad7e12e60e1",
                                                "sense_id": "9a03fa1b-ed3d-3f3c-80f4-199163ddcaa1",
                                                "text": "„Der Mama wuchern die Schamhaare aus dem Badeanzug auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
