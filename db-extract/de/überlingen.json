                "senses": [
                    {
                        "sense_id": "cc0f175e-af7c-3084-ae2b-48c388277dd2",
                        "entry_id": "16fa1964-c988-3932-bd63-d01ff7bfddb2",
                        "glosses": [
                            "eine Stadt in Baden-Württemberg, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d1b128-7c13-4198-b9b5-b3f0a44d3991",
                                "sense_id": "cc0f175e-af7c-3084-ae2b-48c388277dd2",
                                "text": "Ich ging in Überlingen zur Schule."
                            },
                            {
                                "example_id": "82a3a4be-53aa-4613-be1b-ba767fdeb3b3",
                                "sense_id": "cc0f175e-af7c-3084-ae2b-48c388277dd2",
                                "text": "„In Überlingen war die Existenz des Außenlagers bekannt: Bewacht von der SS und Hunden marschierten die Häftlinge zum Schichtwechsel durch die Straßen der Stadt.“"
                            },
                            {
                                "example_id": "6d1f65f9-3d88-4495-b57f-c5c2a6ec3b4e",
                                "sense_id": "cc0f175e-af7c-3084-ae2b-48c388277dd2",
                                "text": "„Wie viele Häftlinge in Überlingen starben, ist nicht bekannt.“"
                            },
                            {
                                "example_id": "753f0710-297e-480b-b73f-9cc5aaeb3e31",
                                "sense_id": "cc0f175e-af7c-3084-ae2b-48c388277dd2",
                                "text": "„Die Stadt Überlingen errichtete 1984 eine Gedenkstätte am Eingang des Stollens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
