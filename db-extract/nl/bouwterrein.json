                "translations": [
                    {
                        "translation_id": "2e128831-a8a6-4121-b598-c5147ef0d790",
                        "source_entry_id": "126d24cb-2fa7-3ac5-8776-3ccfdeb502ff",
                        "source_sense_id": "a0d495b7-0797-3fa8-9d43-ef475b4ecd14",
                        "source_sense_description": "een terrein waarop gebouwd wordt of kan worden",
                        "target_lang_word": "Baustelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baustelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                        "entry_id": "2a4f8cfd-52c2-34ba-b9ad-42a77052cd97",
                                        "glosses": [
                                            "Ort, an dem ein ortsfester Gegenstand errichtet oder verändert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2f1cf13-fb7f-4e7b-9f08-9341166e9ae7",
                                                "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                                "text": "Auf der Baustelle wurde noch bis zuletzt gearbeitet."
                                            },
                                            {
                                                "example_id": "310c47bf-5c63-45d7-99ce-7f1cb2d8b719",
                                                "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                                "text": "„Ab hier kannte ich eine noch bessere Abkürzung durch ein Loch im Zaun einer Baustelle.“"
                                            },
                                            {
                                                "example_id": "c0d31b0d-d544-47ce-9fac-cf8dd84eec2f",
                                                "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                                "text": "„An den Wänden seines Büros hingen Fotos von Baustellen neben literarischen Preisen und einem ägyptischen Papyrus.“"
                                            },
                                            {
                                                "example_id": "dc105347-8f53-42ac-9194-2e30477abb98",
                                                "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                                "text": "„Seine Einnahmen von der Baustelle gingen zur Hälfte für die Miete drauf, ein Großteil für die Verpflegung, und den Rest sparte er in einem Lederbeutel, den er immer bei sich trug und gut versteckte.“"
                                            },
                                            {
                                                "example_id": "66973825-a12b-433e-bd95-563c0f7f9df3",
                                                "sense_id": "31d66e96-d5d0-3c11-913f-ba17d8099ef6",
                                                "text": "„Nach endlosen Anrufen und Autofahrten von Baustelle zu Baustelle findet ihn eine tollgewordene Kundin im überschwemmten Keller eines Neubaues.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28f7050c-ae3d-3afe-8a2d-62c0d56ddbdc",
                                        "entry_id": "2a4f8cfd-52c2-34ba-b9ad-42a77052cd97",
                                        "glosses": [
                                            "Betätigungsfeld, Zuständigkeit, eine in Umbau befindliche Sache"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30635abb-e578-422b-8552-e4b24a3e2e54",
                                                "sense_id": "28f7050c-ae3d-3afe-8a2d-62c0d56ddbdc",
                                                "text": "Ewige Baustelle Bildungspolitik — drei Länder, ein Problem — Nicht nur in Hamburg, auch in den Bundesländern Schleswig-Holstein und Niedersachsen wird heftig über Schulstrukturen gestritten."
                                            },
                                            {
                                                "example_id": "0f3cd197-2142-4893-874b-2461f210e110",
                                                "sense_id": "28f7050c-ae3d-3afe-8a2d-62c0d56ddbdc",
                                                "text": "„Drinnen sah das Haus deutlich besser aus als von außen, es gab zwar noch einige Baustellen, aber die waren schon weit gediehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
