                    },
                    {
                        "translation_id": "8678ae34-034b-4128-be6a-9f63f4af6a07",
                        "source_entry_id": "129ae7b5-c292-3158-b4cc-df10a621e2d1",
                        "source_sense_id": "379c65e8-fa69-3a01-9557-fbbcbc0c8a29",
                        "target_lang_word": "telegrafieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telegrafieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a680aca2-c206-33be-9223-d910dea6b8f8",
                                        "entry_id": "02ac80df-0e63-35ec-8759-4fc4c785b868",
                                        "glosses": [
                                            "eine Nachricht telegrafisch senden, ein Telegramm senden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a1787a-565f-44cb-83af-12f1773aca6b",
                                                "sense_id": "a680aca2-c206-33be-9223-d910dea6b8f8",
                                                "text": "„Wir können ihm nicht schreiben, wir können nicht telegrafieren und ihn nicht anrufen - wir wissen überhaupt keine Adresse von ihm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee2c0616-09a3-4d3d-b966-b02ad62dada0",
                        "source_entry_id": "129ae7b5-c292-3158-b4cc-df10a621e2d1",
                        "source_sense_id": "379c65e8-fa69-3a01-9557-fbbcbc0c8a29",
                        "target_lang_word": "telegraphieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telegraphieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e61ba81b-a50a-38d9-933f-3222e1329911",
                                        "entry_id": "8f92fa14-9c93-33e0-a6ef-02ff98ebf910",
                                        "glosses": [
                                            "eine Nachricht telegraphisch senden, ein Telegramm senden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b193cd1-fd8b-4a5e-9430-9f95d9d5afb0",
                                                "sense_id": "e61ba81b-a50a-38d9-933f-3222e1329911",
                                                "text": "Werner von Siemens berichtete 1847 in einem Brief seinem Bruder Wilhelm: „Mein Telegraph gebraucht nur einen Draht, kann dabei mit Tasten wie ein Klavier gespielt werden und verbindet mit der größten Sicherheit eine solche Schnelligkeit, dass man fast so schnell telegraphieren kann, wie die Tasten nacheinander gedrückt werden."
                                            },
                                            {
                                                "example_id": "a7fc5a38-6d25-4bf9-b14c-35794430c4b1",
                                                "sense_id": "e61ba81b-a50a-38d9-933f-3222e1329911",
                                                "text": "Die seit der Entdeckung der elektrischen Wellen durch den verstorbenen deutschen Physiker Hertz schon öfter angestellten Versuche ohne eine Drahtleitung zu telegraphieren, haben neuerdings durch eine weitere Entdeckung des Italieners Marconi großes Aufsehen erregt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
