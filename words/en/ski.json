{
    "word_family": [
        "skier",
        "skiing",
        "skiable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16b6e0c4-603d-39ba-b33d-ddd9f7c66233",
                    "sense_definition": "One of a pair of long flat runners designed for gliding over snow or water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a new pair of <w>skis</w> for the upcoming winter season.",
                            "target_lang_translations": {
                                "ru": "Она купила новую пару <w>лыж</w> к предстоящему зимнему сезону.",
                                "zh": "她为即将到来的冬季买了一副新<w>滑雪板</w>。"
                            }
                        },
                        {
                            "text": "You must wax your <w>skis</w> to make them glide faster on the snow.",
                            "target_lang_translations": {
                                "ru": "Ты должен навощить свои <w>лыжи</w>, чтобы они быстрее скользили по снегу.",
                                "zh": "你必须给<w>滑雪板</w>打蜡，这样它们在雪地上滑得更快。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of skis",
                        "water ski",
                        "jet ski",
                        "put on skis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары длинных плоских полозьев, предназначенных для скольжения по снегу или воде.",
                        "zh": "一种用于在雪地或水面上滑行的长条形运动器材。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лыжа",
                                "target_lang_sense_clarification": "предмет, единственное число"
                            },
                            {
                                "target_lang_word": "лыжи",
                                "target_lang_sense_clarification": "пара, спортивный инвентарь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑雪板",
                                "target_lang_sense_clarification": "用于雪上运动的器材"
                            },
                            {
                                "target_lang_word": "滑水板",
                                "target_lang_sense_clarification": "用于水上运动的器材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81d86d03-fb33-3d37-9a77-fccd22498a8e",
                    "sense_definition": "A trip made by skiing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a quick <w>ski</w> before lunch to enjoy the fresh powder.",
                            "target_lang_translations": {
                                "ru": "Мы вышли на короткую <w>лыжную прогулку</w> перед обедом, чтобы насладиться свежим снегом.",
                                "zh": "午饭前我们去<w>滑雪</w>了一会儿，享受新鲜的粉雪。"
                            }
                        },
                        {
                            "text": "The morning <w>ski</w> was refreshing and left us feeling energized.",
                            "target_lang_translations": {
                                "ru": "Утреннее <w>катание на лыжах</w> освежило нас и зарядило энергией.",
                                "zh": "早上的<w>滑雪</w>让人神清气爽，让我们感到精力充沛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a ski",
                        "morning ski"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поездка или прогулка, совершаемая на лыжах.",
                        "zh": "一次滑雪活动或行程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лыжная прогулка",
                                "target_lang_sense_clarification": "короткое путешествие"
                            },
                            {
                                "target_lang_word": "катание на лыжах",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑雪",
                                "target_lang_sense_clarification": "指代滑雪这项活动或过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aae2b46-aaa1-3d35-b2a7-9146f6e92362",
                    "sense_definition": "One of a pair of long flat runners under some flying machines, used for landing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot lowered the <w>skis</w> to land safely on the frozen lake.",
                            "target_lang_translations": {
                                "ru": "Пилот выпустил <w>лыжи</w>, чтобы безопасно приземлиться на замерзшее озеро.",
                                "zh": "飞行员放下了<w>滑橇</w>，以便在冰封的湖面上安全着陆。"
                            }
                        },
                        {
                            "text": "This helicopter is equipped with a <w>ski</w> on each side for snow operations.",
                            "target_lang_translations": {
                                "ru": "Этот вертолет оборудован <w>лыжей</w> с каждой стороны для работы на снегу.",
                                "zh": "这架直升机两侧各装有一个<w>滑橇</w>，用于在雪地执行任务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "landing ski"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из пары длинных плоских полозьев под некоторыми летательными аппаратами, используемый для посадки.",
                        "zh": "某些飞行器底部用于着陆的长条形支撑装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лыжа",
                                "target_lang_sense_clarification": "часть шасси самолета или вертолета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑橇",
                                "target_lang_sense_clarification": "飞机或直升机起落架的部件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82e54ebf-d851-3dbb-9034-bb284f2c8135",
                    "sense_definition": "To move on skis.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My family likes to <w>ski</w> in the Alps every winter holiday.",
                            "target_lang_translations": {
                                "ru": "Моя семья любит <w>кататься на лыжах</w> в Альпах каждые зимние каникулы.",
                                "zh": "我的家人喜欢在每个寒假去阿尔卑斯山<w>滑雪</w>。"
                            }
                        },
                        {
                            "text": "It took him a few days to learn to <w>ski</w> without falling over.",
                            "target_lang_translations": {
                                "ru": "Ему потребовалось несколько дней, чтобы научиться <w>кататься на лыжах</w>, не падая.",
                                "zh": "他花了几天时间才学会不摔倒地<w>滑雪</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "learn to ski",
                        "ski down",
                        "ski fast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться на лыжах.",
                        "zh": "穿着滑雪板在雪地上移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на лыжах",
                                "target_lang_sense_clarification": "активный отдых, спорт"
                            },
                            {
                                "target_lang_word": "ходить на лыжах",
                                "target_lang_sense_clarification": "передвижение (обычно беговые лыжи)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑雪",
                                "target_lang_sense_clarification": "进行滑雪运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44b3aec4-060d-3cd7-b73b-e49bf89d85ed",
                    "sense_definition": "To travel over a slope or specific place on skis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wants to <w>ski</w> the most difficult run on the mountain today.",
                            "target_lang_translations": {
                                "ru": "Сегодня она хочет <w>спуститься на лыжах</w> по самой сложной трассе на горе.",
                                "zh": "她今天想<w>滑下</w>山上最难的那条雪道。"
                            }
                        },
                        {
                            "text": "We <w>skied</w> the backcountry trails all afternoon until the sun went down.",
                            "target_lang_translations": {
                                "ru": "Мы <w>катались</w> по диким трассам весь день, пока не село солнце.",
                                "zh": "我们整个下午都在<w>滑过</w>野外雪道，直到太阳落山。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ski the slope",
                        "ski a run"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проходить определенный склон или место на лыжах.",
                        "zh": "在特定的斜坡或路线上进行滑雪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спускаться на лыжах",
                                "target_lang_sense_clarification": "съезжать со склона"
                            },
                            {
                                "target_lang_word": "проходить на лыжах",
                                "target_lang_sense_clarification": "преодолевать дистанцию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑下",
                                "target_lang_sense_clarification": "指从斜坡上滑行而下"
                            },
                            {
                                "target_lang_word": "滑过",
                                "target_lang_sense_clarification": "指穿越某段路线"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}