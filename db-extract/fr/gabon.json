                                                "example_id": "63afd7c7-5dbb-42a5-99ea-a9919056b517",
                                                "sense_id": "4f4d5407-db07-30b7-b494-9f38c47fdd0f",
                                                "text": "Libreville ist die Hauptstadt von Gabun."
