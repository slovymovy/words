{
    "word_family": [
        "bandy-legged"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a10e800-36cb-3bae-894c-6ecb8439f262",
                    "sense_definition": "To mention, discuss, or pass around casually or without much care.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several names were <w>bandied</w> about as potential candidates for the open position.",
                            "target_lang_translations": {
                                "nl": "Er werden verschillende namen <w>rondgestrooid</w> als mogelijke kandidaten voor de vacature."
                            }
                        },
                        {
                            "text": "The media continues to <w>bandy</w> rumors about their secret marriage.",
                            "target_lang_translations": {
                                "nl": "De media blijven geruchten over hun geheime huwelijk <w>verspreiden</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bandy about",
                        "bandy around"
                    ],
                    "target_lang_definitions": {
                        "nl": "Losjes of achteloos ter sprake brengen, verspreiden of rondstrooien."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rondstrooien",
                                "target_lang_sense_clarification": "van geruchten of namen"
                            },
                            {
                                "target_lang_word": "rondbazuinen",
                                "target_lang_sense_clarification": "verbreiden"
                            },
                            {
                                "target_lang_word": "rondgaan",
                                "target_lang_sense_clarification": "van namen of geruchten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b9c727-3395-33ff-a957-127f1d7e7a91",
                    "sense_definition": "To exchange words, insults, or arguments back and forth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exchange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I refused to <w>bandy</w> words with someone who was clearly looking for an argument.",
                            "target_lang_translations": {
                                "nl": "Ik weigerde <w>woorden te wisselen</w> met iemand die duidelijk op ruzie uit was."
                            }
                        },
                        {
                            "text": "The two politicians continued to <w>bandy</w> insults throughout the heated debate.",
                            "target_lang_translations": {
                                "nl": "De twee politici bleven elkaar tijdens het verhitte debat beledigingen <w>naar het hoofd slingeren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "exchange"
                    ],
                    "common_phrases": [
                        "bandy words"
                    ],
                    "target_lang_definitions": {
                        "nl": "Woorden, beledigingen of argumenten over en weer uitwisselen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitwisselen",
                                "target_lang_sense_clarification": "van woorden of beledigingen"
                            },
                            {
                                "target_lang_word": "bekvechten",
                                "target_lang_sense_clarification": "woordenwisseling hebben"
                            },
                            {
                                "target_lang_word": "heen en weer slingeren",
                                "target_lang_sense_clarification": "van verwijten of beledigingen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "000fa31e-364b-3b91-8698-62e85caf860a",
                    "sense_definition": "To strike or throw back and forth, as a ball in a game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players would <w>bandy</w> the small ball back and forth across the icy field.",
                            "target_lang_translations": {
                                "nl": "De spelers <w>sloegen</w> de kleine bal heen en weer over het ijzige veld."
                            }
                        },
                        {
                            "text": "They spent hours in the garden, watching the children <w>bandy</w> the shuttlecock over the net.",
                            "target_lang_translations": {
                                "nl": "Ze brachten uren door in de tuin en keken hoe de kinderen de shuttle over het net <w>heen en weer sloegen</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Heen en weer slaan of gooien, zoals een bal bij een spel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "heen en weer slaan",
                                "target_lang_sense_clarification": "van een bal"
                            },
                            {
                                "target_lang_word": "toespelen",
                                "target_lang_sense_clarification": "elkaar de bal toespelen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "924fb328-c5d0-3cb7-8da6-55da07088179",
                    "sense_definition": "To contend, strive, or fight with or against someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noble decided to <w>bandy</w> against the court rather than submit to the king.",
                            "target_lang_translations": {
                                "nl": "De edelman besloot <w>de strijd aan te binden</w> met het hof in plaats van zich te onderwerpen aan de koning."
                            }
                        },
                        {
                            "text": "The prince commanded the rival factions to cease trying to <w>bandy</w> in public squares.",
                            "target_lang_translations": {
                                "nl": "De prins beval de rivaliserende facties te stoppen met <w>vechten</w> op openbare pleinen."
                            }
                        }
                    ],
                    "synonyms": [
                        "contend",
                        "fight"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Strijden, twisten of vechten met of tegen iemand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "strijden",
                                "target_lang_sense_clarification": "kampen, twisten"
                            },
                            {
                                "target_lang_word": "twisten",
                                "target_lang_sense_clarification": "in conflict zijn"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddac55a1-ef17-3a35-858e-f10d8cd460ca",
                    "sense_definition": "A team winter sport played on ice with sticks and a small ball, similar to ice hockey.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many northern European countries have professional leagues dedicated to the sport of <w>bandy</w>.",
                            "target_lang_translations": {
                                "nl": "Veel Noord-Europese landen hebben professionele competities gewijd aan de sport <w>bandy</w>."
                            }
                        },
                        {
                            "text": "He grew up playing <w>bandy</w> on the frozen lake during the winter months.",
                            "target_lang_translations": {
                                "nl": "Hij groeide op met het spelen van <w>bandy</w> op het bevroren meer tijdens de wintermaanden."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een teamsport op ijs gespeeld met sticks en een kleine bal, vergelijkbaar met ijshockey."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bandy",
                                "target_lang_sense_clarification": "ijssport"
