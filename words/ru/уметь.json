    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "579a3c07-d549-3c8b-9401-42f9989e7867",
                    "sense_definition": "Обладать навыками или знаниями, необходимыми для выполнения какого-либо действия.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "навык",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>умею</w> готовить вкусный шашлык.",
                            "target_lang_translations": {
                                "de": "Ich <w>kann</w> leckeres Schaschlik zubereiten."
                            }
                        },
                        {
                            "text": "Мы все <w>умеем</w> быстро читать.",
                            "target_lang_translations": {
                                "de": "Wir alle <w>können</w> schnell lesen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уметь читать",
                        "уметь писать",
                        "уметь готовить"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Fertigkeiten oder das Wissen besitzen, um eine bestimmte Handlung auszuführen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "eine Fähigkeit oder Fertigkeit besitzen"
                            },
                            {
                                "target_lang_word": "beherrschen",
                                "target_lang_sense_clarification": "eine Fertigkeit oder Kenntnis beherrschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "887bde69-e2db-3a25-b736-6885a4c879e4",
                    "sense_definition": "Быть в состоянии сделать что-либо хорошо, качественно или так, как требуется.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "навык",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Важно <w>уметь</w> выступать перед большой публикой.",
                            "target_lang_translations": {
                                "de": "Es ist wichtig, vor großem Publikum auftreten zu <w>können</w>."
                            }
                        },
                        {
                            "text": "Надо <w>уметь</w> слушать собеседника внимательно.",
                            "target_lang_translations": {
                                "de": "Man muss seinem Gesprächspartner aufmerksam zuhören <w>können</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уметь слушать",
                        "уметь работать"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи для оценки мастерства"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In der Lage sein, etwas gut, gekonnt oder den Anforderungen entsprechend zu tun."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "etwas gut oder gekonnt machen"
                            },
                            {
                                "target_lang_word": "verstehen",
                                "target_lang_sense_clarification": "etwas zu tun verstehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b21fd8a1-9488-3fa3-bb4c-5b5dfd9b851a",
                    "sense_definition": "Иметь возможность или способность совершить какое-либо действие.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "способность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Человек должен <w>уметь</w> признавать свои ошибки.",
                            "target_lang_translations": {
                                "de": "Ein Mensch muss seine Fehler zugeben <w>können</w>."
                            }
                        },
                        {
                            "text": "Нужно <w>уметь</w> находить выход из сложных ситуаций.",
                            "target_lang_translations": {
                                "de": "Man muss aus schwierigen Situationen einen Ausweg finden <w>können</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "мочь"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Fähigkeit, Reife oder Möglichkeit haben, eine bestimmte Handlung auszuführen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "können",
                                "target_lang_sense_clarification": "in der Lage sein, etwas zu tun"
                            },
                            {
                                "target_lang_word": "in der Lage sein",
                                "target_lang_sense_clarification": "die geistige oder situative Fähigkeit haben"
                            },
                            {
                                "target_lang_word": "vermögen",
                                "target_lang_sense_clarification": "gehoben für: fähig sein"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}