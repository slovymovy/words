                        "entry_id": "b0d41a09-3465-3fa7-8813-0ac2c4091465",
                        "glosses": [
                            "To translate something into the Latin language; or make a word similar in appearance or form to a Latin word."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ff9b6528-675e-429a-8fc0-b7b9589d3fb4",
                                "sense_id": "32897957-b745-35b3-b909-7470b1b78c36",
                                "text": "Guglielmus is a Latinized form of William."
                            }
                        ]
                    },
                    {
