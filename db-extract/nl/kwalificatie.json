                                "target_senses": [
                                    {
                                        "sense_id": "ee876b2f-7a4d-318c-84c6-778710f72a2d",
                                        "entry_id": "845e4ee2-8584-3e86-b09a-4d0e866b8efb",
                                        "glosses": [
                                            "Action de qualifier ; attribution d’une qualité, d’un titre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ec25bf-06de-4d67-9bb8-baf5639cce0c",
                                                "sense_id": "ee876b2f-7a4d-318c-84c6-778710f72a2d",
                                                "text": "Pour retenir la qualification pénale d’escroquerie, il fallait d'une part établir qu'il existait des manœuvres frauduleuses et d'autre part que ces manœuvres concourrassent à un but unique ; la remise de fonds au titre du dédit ou la vente forcée."
                                            },
                                            {
                                                "example_id": "23770a5e-3bf3-4e44-8406-f2f363c96945",
                                                "sense_id": "ee876b2f-7a4d-318c-84c6-778710f72a2d",
                                                "text": "Cette proposition a été qualifiée de téméraire, de scandaleuse : il faut voir si cette qualification est juste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809f8b96-b8c1-3737-8a26-3518097b3f17",
                                        "entry_id": "845e4ee2-8584-3e86-b09a-4d0e866b8efb",
                                        "glosses": [
                                            "Action de se qualifier, dans une compétition éliminatoire, pour un tour supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3fd464d-57e1-48fd-a4b7-11ada360402a",
                                                "sense_id": "809f8b96-b8c1-3737-8a26-3518097b3f17",
                                                "text": "Sans oublier l’expérimenté Boris Neveu, qui s’est classé 13ᵉ en qualification."
                                            },
                                            {
                                                "example_id": "e84a7cd4-7e51-4c3e-afc9-dce638acc3c0",
                                                "sense_id": "809f8b96-b8c1-3737-8a26-3518097b3f17",
                                                "text": "Parmi les Bretons en lice, la Rennaise Camille Prigent est la seule à se sortir des pièges de la qualification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0e1b989-a06c-3f93-9a95-d19032b0e3fe",
                                        "entry_id": "845e4ee2-8584-3e86-b09a-4d0e866b8efb",
                                        "glosses": [
                                            "Titularisation, certification, établissement d'une qualité, d'un titre scolaire, nobiliaire ou autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0642dec4-1d09-4da2-90df-d0a278abb76e",
                                                "sense_id": "d0e1b989-a06c-3f93-9a95-d19032b0e3fe",
                                                "text": "La qualification de marquis."
                                            },
                                            {
                                                "example_id": "825cb3b0-da9a-43c3-823b-fa658b0cf3d5",
                                                "sense_id": "d0e1b989-a06c-3f93-9a95-d19032b0e3fe",
                                                "text": "Les jeunes sans diplôme et sans qualification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "884cbeac-97f6-374b-8fb1-c9524862185b",
                                        "entry_id": "845e4ee2-8584-3e86-b09a-4d0e866b8efb",
                                        "glosses": [
                                            "Épreuve de sélection des chevaux de course de trot leur permettant de participer à des courses hippiques s'ils parviennent à courir 2000 mètres en un temps donné, fixé en fonction de leur âge."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b9e5cc6-14fc-30ef-a02b-8fb21ea7fc24",
                                        "entry_id": "845e4ee2-8584-3e86-b09a-4d0e866b8efb",
                                        "glosses": [
                                            "Phase de croissance d’un arbre ou d’un peuplement, pendant laquelle l’objectif du sylviculteur est la formation d’une grume de qualité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bfb977e-7b1b-4e0c-b828-c743b41f5ad3",
                                                "sense_id": "3b9e5cc6-14fc-30ef-a02b-8fb21ea7fc24",
                                                "text": "La qualification correspond à la formation de la bille de pied recherchée, un fût net de nœuds, et précède la phase d’expansion durant laquelle le forestier favorise le développement des houppiers des tiges sélectionnées (arbres objectif)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
