                        "examples": [
                            {
                                "example_id": "dfefc9c0-73d1-4f36-8aa9-2c3084ff2505",
                                "sense_id": "3f500179-e3cb-39c3-aba6-564731e6975c",
                                "text": "Venez, boucs méchants,\nPsylles aux corps grêles,\nAspioles frêles,\nComme un flot de grêles,\nFondre dans ces champs."
                            },
                            {
                                "example_id": "af47074b-3383-485e-a3c4-57b387d786a2",
                                "sense_id": "3f500179-e3cb-39c3-aba6-564731e6975c",
                                "text": "Balzac… grommelait des injures à l’endroit de la vieille : strige, harpie, magicienne, empuse, larve, lamie, lémure, goule, psylle, aspiole, et tout ce que l’habitude des litanies de Rabelais pouvait lui suggérer de termes bizarres."
                            },
                            {
                                "example_id": "a125ff51-6b38-4ba2-a089-a643ba9dd16d",
                                "sense_id": "3f500179-e3cb-39c3-aba6-564731e6975c",
                                "text": "On eût dit ces animaux chimériques que chevauchent les Aspioles ou les Goules aux cavalcades du Sabbat."
                            }
                        ]
                    }
