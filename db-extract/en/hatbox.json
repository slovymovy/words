                        "glosses": [
                            "A piece of luggage for a hat; a case or box for a hat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5622ae-c260-4127-b114-319c87c448f6",
                                "sense_id": "b4389d12-1bcf-3124-84a0-447c21b002f9",
                                "text": "A green and pink plaid hat box contains eight more hatboxes that can be stacked like a set of Russian nesting dolls."
                            },
                            {
                                "example_id": "a9aaea0c-163b-4887-be67-4fd2c79a173c",
                                "sense_id": "b4389d12-1bcf-3124-84a0-447c21b002f9",
                                "text": "Get a whiff of the models that served our grandfathers well: They now combine the must of a midcentury hatbox with the musk of 21st-­century body spray."
                            }
                        ]
                    }
                ],
                "translations": [
