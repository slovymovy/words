                    {
                        "sense_id": "57369c65-a1b0-3f9e-9eec-527c9628daf3",
                        "entry_id": "6dc759bc-f71e-3da2-ac84-bf104121f6f1",
                        "glosses": [
                            "Qui impatiente."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3fbc52f8-7ece-422c-b1ff-3dd288d39194",
                                "sense_id": "57369c65-a1b0-3f9e-9eec-527c9628daf3",
                                "text": "Notre maîtresse parait-elle disposée à l'inconstance ? nous devenons auprès d'elle de l'empressement le plus exact ; notre fidélité veut être scrupuleuse ; et nous ne songeons pas que cette conduite impatientante précipite son inconstance, au lieu de l'arrêter."
                            },
                            {
                                "example_id": "2d76460d-514e-4fef-9d12-0aba8bd84d23",
                                "sense_id": "57369c65-a1b0-3f9e-9eec-527c9628daf3",
                                "text": "Il n'y a rien d'impatientant comme un homme qui vous répète toujours la même chose."
                            },
                            {
                                "example_id": "8605facf-ffbf-48f4-8ea9-a5c58ccd3789",
                                "sense_id": "57369c65-a1b0-3f9e-9eec-527c9628daf3",
                                "text": "Je n’ai jamais vu regards plus impatientants que ces longs regards tranquilles qui tombaient sur vous comme sur une chose."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
