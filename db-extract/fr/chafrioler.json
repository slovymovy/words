                ],
                "senses": [
                    {
                        "sense_id": "561f4521-8c70-3a57-874e-cdea0f600758",
                        "entry_id": "2fff7ef4-710a-38c8-9a9c-1181109c5548",
                        "glosses": [
                            "Montrer son plaisir."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8e71c501-935a-4708-abb8-cc17e0a5caa5",
                                "sense_id": "561f4521-8c70-3a57-874e-cdea0f600758",
                                "text": "Vous êtes le plus compromettant et le plus indiscret des hommes, mon cher chevalier, dit le petit abbé Fleury en chafriolant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a866f763-bf8f-3df6-9979-58f7c4be2862",
                        "entry_id": "2fff7ef4-710a-38c8-9a9c-1181109c5548",
                        "glosses": [
                            "Se délecter."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "73e559e3-2ce6-46da-833a-524a9e1188d0",
                                "sense_id": "a866f763-bf8f-3df6-9979-58f7c4be2862",
                                "text": "L’idée du suicide lui passa par la tête, non pas à cause du déficit qu’on allait reconnaître dans sa caisse, mais à cause de l’impossibilité de vivre avec Mariette et dans l’atmosphère de plaisirs où il se chafriolait depuis un an."
                            },
                            {
                                "example_id": "f6e8101f-23dc-4311-b361-c107d01395c3",
                                "sense_id": "a866f763-bf8f-3df6-9979-58f7c4be2862",
                                "text": "Le cochon est chambré sous son toit avec des pommes de terre, et les autres se chafriolent dans les billets de banque."
                            },
                            {
                                "example_id": "9392e88f-849c-4aed-8073-f0147614c86b",
                                "sense_id": "a866f763-bf8f-3df6-9979-58f7c4be2862",
                                "text": "Cela n’empêche pas qu’elle se retrouve étendue sous ses subreptices caresses et qu’elle se chafriole des baisers qu’il éparpille sur son corps."
                            }
                        ]
                    }
                ],
