        "fr-extract.jsonl": [
            {
                "entry_id": "d4d9029b-2015-3fcb-9c1d-4fbb7a9e0f51",
                "word": "paluche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "912a9bff-bb3d-4256-9a2d-7e091c31848d",
                        "entry_id": "d4d9029b-2015-3fcb-9c1d-4fbb7a9e0f51",
                        "tags": [
                            "plural"
                        ],
                        "form": "paluches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "613bd025-e5ef-3c98-bbc8-ee00f01d08fd",
                        "entry_id": "d4d9029b-2015-3fcb-9c1d-4fbb7a9e0f51",
                        "glosses": [
                            "Main."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5050a2b7-ca41-4856-8081-0f08db747c14",
                                "sense_id": "613bd025-e5ef-3c98-bbc8-ee00f01d08fd",
                                "text": "« Allez on met les adjas. Donne ta paluche.\n— Ma quoi ?\n— Tes crayons. Tes torcheculs. Oh, ta pogne, quoi. »"
                            },
                            {
                                "example_id": "ef9428f5-a4ae-417a-bc72-f30485c22d4d",
                                "sense_id": "613bd025-e5ef-3c98-bbc8-ee00f01d08fd",
                                "text": "— Eh, connard, tire tes sales paluches de là ou je me fâche !"
                            },
                            {
                                "example_id": "cbb4fd16-d973-4f15-9f82-7cf44019c92c",
                                "sense_id": "613bd025-e5ef-3c98-bbc8-ee00f01d08fd",
                                "text": "Je me retournai vivement, prêt à toiser le malotru du haut de mon mètre quatre-vingt-dix, et me retrouvai nez à nez avec un colosse hilare qui me tendit une paluche grosse comme une escalope"
                            }
                        ]
                    },
                    {
                        "sense_id": "24cda4a0-ae38-3e0d-a035-6c8dbb063d7d",
                        "entry_id": "d4d9029b-2015-3fcb-9c1d-4fbb7a9e0f51",
                        "glosses": [
                            "Empreintes."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "5a97aa25-f645-4a73-bd42-270282da11d2",
                                "sense_id": "24cda4a0-ae38-3e0d-a035-6c8dbb063d7d",
                                "text": "Et j'entends la police arriver, mais j'ai tout pris ganté, j'ai laissé zéro paluche."
                            },
                            {
                                "example_id": "bcfd6b8d-6bc2-4215-8f25-18e00454fd3c",
                                "sense_id": "24cda4a0-ae38-3e0d-a035-6c8dbb063d7d",
                                "text": "On peut pas gérer l'ADN comme on gère les paluches."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "3173e8ed-4b8b-39d1-a530-34d6f5b52821",
                "word": "paluche",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57340650-555f-4d1d-ba10-b451fc0a6df1",
                        "entry_id": "3173e8ed-4b8b-39d1-a530-34d6f5b52821",
                        "tags": [
                            "plural"
                        ],
                        "form": "paluches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5538ae39-f290-3f9e-88ec-0e76a2b35b83",
                        "entry_id": "3173e8ed-4b8b-39d1-a530-34d6f5b52821",
                        "glosses": [
                            "Caméra vidéo miniature, de la taille d’un micro."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "911341f8-1546-4195-92db-ebb241c489e9",
                                "sense_id": "5538ae39-f290-3f9e-88ec-0e76a2b35b83",
                                "text": "La « paluche » était une caméra cylindrique, d’une trentaine de centimètres de long, d’un faible diamètre, qui pouvait se tenir à la main (d’où son nom), sans qu’il fût nécessaire d’avoir un œil dans le viseur."
                            },
                            {
                                "example_id": "7e4e5701-82aa-404d-9b00-5854e2c8e831",
                                "sense_id": "5538ae39-f290-3f9e-88ec-0e76a2b35b83",
                                "text": "À Amiens, j’aurais pu corriger l’erreur que je fis un jour en y faisant naître Jules Verne, né à Nantes (mais qui s’installa en effet à Amiens, la ville de sa femme Honorine, à partir de 1872), et cela dans un texte intitulé Route nationale 1, une commande du Centre régional de la photographie Nord-Pas-de-Calais, où il accompagnait des photographies prises par Bernard Plossu, merveilleusement glissées (je me souviens du voyage en voiture de Paris à Dunkerque, avec Pierre Devin au volant et cet art qu’avait Bernard Plossu de photographier sans qu’on s’en aperçoive - il me faisait penser à Jean-Pierre Beauviala, l’inventeur de la paluche, expliquant dans les Cahiers du cinéma qu’une caméra ne devait pas peser plus lourd qu’un chat sur l’épaule)."
                            },
                            {
                                "example_id": "a2254ffc-bd00-4efa-b791-0be3d21ed1bb",
                                "sense_id": "5538ae39-f290-3f9e-88ec-0e76a2b35b83",
                                "text": "De plus en plus de caméras, jusque dans les buts avec la fameuse paluche, des images de plus en plus précises avec la caméra loupe acquise en 1992 alors qu’elle n’était encore qu’un prototype et que dire du traveling le long du terrain pour suivre comme si on y était les déboulés de David Ginola au Parc des Princes, ou de Chris Waddle au Stade Vélodrome."
                            },
                            {
                                "example_id": "4d6504cd-9f41-42f3-9c0c-e850b4ba4ec7",
                                "sense_id": "5538ae39-f290-3f9e-88ec-0e76a2b35b83",
                                "text": "Pour la réalisation, nous avons 12 caméras et 7 paluches ainsi que 5 GoPro, auxquelles s’ajoutent une grue sur rail et une autre sur une voiture travelling."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
