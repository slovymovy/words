                "senses": [
                    {
                        "sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
                        "entry_id": "3233f718-81ee-3423-b357-d7f279cce4b1",
                        "glosses": [
                            "studie van de niet-geschreven overblijfselen van het verleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a23f4ef-4a10-4324-badd-a773a5b647a2",
                                "sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
                                "text": "De archeologie maakt veel gebruik van uiterst zorgvuldige opgravingen."
                            },
                            {
                                "example_id": "806ff0ba-fee1-4714-8615-7e6995aba7bb",
                                "sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
                                "text": "Casper Reuvens, die rechten en klassieke talen had gestudeerd, zag de in 1818 nog jonge archeologie als een vak dat „naast sterrenkunde en geologie, nieuwe bronnen van kennis” bood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68cbce3e-6185-4c66-a691-3eabb6c28bfa",
                        "source_entry_id": "3233f718-81ee-3423-b357-d7f279cce4b1",
                        "source_sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
                        "source_sense_description": "studie van de niet-geschreven overblijfselen van het verleden",
                        "target_lang_word": "Archäologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archäologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14b48d9f-a48f-398a-a4f4-c6684bb47fdb",
                                        "entry_id": "918271ae-189a-34b6-b704-27e1e9e420fd",
                                        "glosses": [
                                            "Geisteswissenschaft, in der durch Auffindung, Dokumentation und Analyse materieller Hinterlassenschaften der kulturellen Entwicklung der Menschheit nachgegangen wird"
                                        ],
                                        "tags": [
                                            "Geisteswissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa106c1-857c-4de6-ac2b-8070ca42c5be",
                                                "sense_id": "14b48d9f-a48f-398a-a4f4-c6684bb47fdb",
                                                "text": "Ausgrabungen sind oftmals nötig, um in der Archäologie neue Erkenntnisse zu gewinnen."
                                            },
                                            {
                                                "example_id": "1d99eec4-2549-4cec-8170-09db889628a4",
                                                "sense_id": "14b48d9f-a48f-398a-a4f4-c6684bb47fdb",
                                                "text": "„Raphael, Max, deutscher Kunsthistoriker, Kunstwissenschaftler, Philosoph, * 27.8. 1889 Schönlanke (Trzcianka, Polen), Freitod 14.7. 1952 New York (USA); 1907 Stud. der Rechte in München, ab 1909 in Berlin Stud. der Kunstgeschichte (bei H. Wölfflin, W. Weisbach), der Archäologie und Philosophie (bei G. Simmel), in Paris Vorlesungen bei E. Mâle und H. Bergson.“"
                                            },
                                            {
                                                "example_id": "3574558c-dd7a-4092-9c14-871413eaae43",
                                                "sense_id": "14b48d9f-a48f-398a-a4f4-c6684bb47fdb",
                                                "text": "„Die Archäologie spricht allgemein von Fürsten, denkt sich dabei aber jedes Mal Gänsefüßchen hinzu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1f8bf69-e085-43ca-a04f-d475f4dc72fa",
                        "source_entry_id": "3233f718-81ee-3423-b357-d7f279cce4b1",
                        "source_sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
                        "source_sense_description": "studie van de niet-geschreven overblijfselen van het verleden",
                        "target_lang_word": "archaeology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archaeology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65a1d689-0b8b-3573-93d7-3e11d7c38773",
                                        "entry_id": "d039c481-cd2e-39b1-997b-4fe88e696a12",
                                        "glosses": [
                                            "The study of the past by excavation and analysis of its material remains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644c8cae-2cc0-48b3-a2ee-b4836f9474cf",
                                                "sense_id": "65a1d689-0b8b-3573-93d7-3e11d7c38773",
                                                "text": "^({1}) He first presented a complementary thesis on the Enlightenment philosopher Immanuel Kant (1724–1804), in which he used the term “archaeology” for the first time, and which indicated the period of history to which he was constantly to return.\n^({2}) The latent grid of knowledge which organizes every scientific discourse and defines what can or cannot be thought scientifically — the process of uncovering these levels Foucault calls 'archaeology'.\n^({3}) “Archaeology”, as the investigation of that which renders necessary a certain form of thought, implies an excavation of unconsciously organized sediments of thought. Unlike a history of ideas, it doesn’t assume that knowledge accumulates towards any historical conclusion. Archaeology ignores individuals and their histories. It prefers to excavate impersonal structures of knowledge.\nArchaeology is a task that doesn’t consist of treating discourse as signs referring to a real content like madness. It treats discourses, such as medicine, as practices that form the objects of which they speak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2fb1156-a535-325d-a142-f8dad578714a",
                                        "entry_id": "d039c481-cd2e-39b1-997b-4fe88e696a12",
                                        "glosses": [
                                            "The study of the past by excavation and analysis of its material remains.",
                                            "The actual excavation, examination, analysis, and interpretation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e547cb17-45e0-462b-943f-c67c0e7e5537",
                                                "sense_id": "d2fb1156-a535-325d-a142-f8dad578714a",
                                                "text": "The building's developers have asked for some archaeology to be undertaken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063122bf-e1fe-3277-9164-bb5b49045ccc",
                                        "entry_id": "d039c481-cd2e-39b1-997b-4fe88e696a12",
                                        "glosses": [
                                            "The study of the past by excavation and analysis of its material remains.",
                                            "The actual remains together with their location in the stratigraphy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2629524d-ff17-4ed7-b0b4-7009a88bfe08",
                                                "sense_id": "063122bf-e1fe-3277-9164-bb5b49045ccc",
                                                "text": "The archaeology will tell us which methods of burial were used by the Ancient Greeks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f645d7c8-c1d9-3c69-b3ab-18df1f911173",
                                        "entry_id": "d039c481-cd2e-39b1-997b-4fe88e696a12",
                                        "glosses": [
                                            "The study of the past by excavation and analysis of its material remains.",
                                            "The academic subject; in the USA: one of the four sub-disciplines of anthropology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0967677a-11f7-4b52-bece-e21c6a5bd611",
                                                "sense_id": "f645d7c8-c1d9-3c69-b3ab-18df1f911173",
                                                "text": "She studied archaeology at Edinburgh University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6c80e96-87cf-4597-9616-06b9d93fa5a7",
                        "source_entry_id": "3233f718-81ee-3423-b357-d7f279cce4b1",
                        "source_sense_id": "607ceafc-5941-351e-a12f-7b936fc35652",
