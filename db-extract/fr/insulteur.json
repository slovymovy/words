                    {
                        "form_id": "c4d160aa-74e1-4a6c-acf2-821af2dae61e",
                        "entry_id": "f3cc12b6-5590-3895-bfc7-194b8f16d370",
                        "tags": [
                            "feminine"
                        ],
                        "form": "insulteuse"
