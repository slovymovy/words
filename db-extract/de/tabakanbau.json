                "senses": [
                    {
                        "sense_id": "4f1dd54c-ead5-3039-b050-f9d7132a55a4",
                        "entry_id": "1d527748-05f1-3a8e-aa46-6269fea05221",
                        "glosses": [
                            "Kultivierung von Tabakpflanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a49d2ba-fb69-4c21-9a89-b86171e1311f",
                                "sense_id": "4f1dd54c-ead5-3039-b050-f9d7132a55a4",
                                "text": "„Der Tabakanbau wurde in manchen Ländern verboten, andererseits aber – auch hier zeigt sich die Zwiespältigkeit – wurde der Tabakhandel erlaubt, so in England durch König Jacob zu Beginn des 17. Jahrhunderts, hauptsächlich der Zölle und Abgaben wegen."
                            },
                            {
                                "example_id": "cbacdd65-cbb3-4b29-972f-049f98178ba5",
                                "sense_id": "4f1dd54c-ead5-3039-b050-f9d7132a55a4",
                                "text": "„Deswegen wird der Tabakanbau von der EU kräftig subventioniert.“"
                            },
                            {
                                "example_id": "edde2645-a03b-4465-b937-3c1dac7e03c5",
                                "sense_id": "4f1dd54c-ead5-3039-b050-f9d7132a55a4",
                                "text": "„Dadurch verschob sich das wirtschaftliche Schwergewicht vom Südwesten um Bulawayo in die nördlichen und östlichen, für den Tabakanbau geeigneten Teile des Landes, wovon Salisbury profitierte.“"
                            },
                            {
                                "example_id": "95a3410a-2356-48a5-887b-5e2a3c9924ae",
                                "sense_id": "4f1dd54c-ead5-3039-b050-f9d7132a55a4",
                                "text": "„Doch im Mai 1924 ergriff plötzlich ein neuer Zukunftstraum von ihnen Besitz — ein Traum, der überall in Palästina große Hoffnungen weckte: der Tabakanbau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
