{
    "word_family": [
        "forsaken",
        "forsaker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aeff4631-b123-3622-a45b-cc7bccb89661",
                    "sense_definition": "To abandon, give up, or leave someone or something permanently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abandonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man decided to <w>forsake</w> his life in the city to live in the quiet mountains.",
                            "target_lang_translations": {
                                "ru": "Молодой человек решил <w>оставить</w> свою городскую жизнь, чтобы жить в тихих горах."
                            }
                        },
                        {
                            "text": "In his hour of greatest need, he felt that all his friends had <w>forsaken</w> him.",
                            "target_lang_translations": {
                                "ru": "В час величайшей нужды он почувствовал, что все друзья <w>покинули</w> его."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandon",
                        "desert",
                        "renounce",
                        "quit"
                    ],
                    "antonyms": [
                        "maintain",
                        "keep",
                        "stay"
                    ],
                    "common_phrases": [
                        "forsake all others",
                        "forsake worldly pleasures"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Навсегда оставить, бросить или отказаться от кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оставить",
                                "target_lang_sense_clarification": "навсегда уйти или прекратить отношения"
                            },
                            {
                                "target_lang_word": "покинуть",
                                "target_lang_sense_clarification": "уйти от кого-то или из какого-то места"
                            },
                            {
                                "target_lang_word": "отречься",
                                "target_lang_sense_clarification": "официально или публично отказаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa11641a-cbbf-32d9-b5d8-5bf29d323cd1",
                    "sense_definition": "To decline or refuse something, such as food or an offer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "refusal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sick animal began to <w>forsake</w> its food and grew weaker every day.",
                            "target_lang_translations": {
                                "ru": "Больное животное начало <w>отказываться</w> от еды и слабело с каждым днем."
                            }
                        },
                        {
                            "text": "He chose to <w>forsake</w> his rest in order to finish the urgent project on time.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>пожертвовать</w> отдыхом, чтобы вовремя закончить срочный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "refuse",
                        "decline",
                        "reject"
                    ],
                    "antonyms": [
                        "accept",
                        "consume"
                    ],
                    "common_phrases": [
                        "forsake food"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "less common in modern usage for physical objects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонить или отказаться от чего-либо, например, от еды или предложения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отказаться",
                                "target_lang_sense_clarification": "не принять предложенное"
                            },
                            {
                                "target_lang_word": "отвергнуть",
                                "target_lang_sense_clarification": "решительно отклонить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b55eba84-3956-3389-bd59-cd1106a946cd",
                    "sense_definition": "To fail or be insufficient for someone, especially regarding a quality or resource.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the crisis deepened, his usual courage <w>forsook</w> him and he panicked.",
                            "target_lang_translations": {
                                "ru": "Когда кризис обострился, обычное мужество <w>изменило</w> ему, и он поддался панике."
                            }
                        },
                        {
                            "text": "The explorer feared his strength would <w>forsake</w> him before he reached the camp.",
                            "target_lang_translations": {
                                "ru": "Исследователь боялся, что силы <w>покинут</w> его прежде, чем он доберется до лагеря."
                            }
                        }
                    ],
                    "synonyms": [
                        "fail",
                        "desert"
                    ],
                    "antonyms": [
                        "sustain",
                        "support"
                    ],
                    "common_phrases": [
                        "courage forsook him"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with abstract qualities like courage or luck"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвести или оказаться недостаточным, особенно в отношении качеств или ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покинуть",
                                "target_lang_sense_clarification": "об абстрактных чувствах или силах"
                            },
                            {
                                "target_lang_word": "изменить",
                                "target_lang_sense_clarification": "о мужестве, удаче или памяти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f428731-878a-36ff-a4e5-0e37ed0dbaf0",
                    "sense_definition": "To avoid or shun someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "avoidance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would <w>forsake</w> no shame to achieve his goals, no matter the cost.",
                            "target_lang_translations": {
                                "ru": "Он не <w>погнушался</w> бы никаким позором ради достижения своих целей, любой ценой."
                            }
                        },
                        {
                            "text": "The hermit sought to <w>forsake</w> the company of men entirely.",
                            "target_lang_translations": {
                                "ru": "Отшельник стремился полностью <w>избегать</w> человеческого общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "shun",
                        "avoid",
                        "eschew"
                    ],
                    "antonyms": [
                        "seek",
                        "embrace"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "primarily found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избегать или сторониться кого-либо или чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чуждаться",
                                "target_lang_sense_clarification": "избегать общения или общества"
                            },
                            {
                                "target_lang_word": "избегать",
                                "target_lang_sense_clarification": "стараться не сталкиваться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}