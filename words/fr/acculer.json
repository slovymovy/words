            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0c1be022-e040-3257-ac76-c677723b7baf",
                    "sense_definition": "Réduire une personne à une situation difficile en ne lui laissant aucun moyen d'échapper ou de reculer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nombreuses dettes accumulées ont fini par <w>acculer</w> l'entreprise à la faillite."
                        },
                        {
                            "text": "Face aux révélations des journalistes, le ministre a été <w>acculé</w> à la démission."
                        }
                    ],
                    "synonyms": [
                        "contraindre",
                        "forcer",
                        "pousser",
                        "réduire"
                    ],
                    "common_phrases": [
                        "acculer à la démission",
                        "acculer à la faillite",
                        "être acculé"
                    ]
                },
                {
                    "sense_id": "aa9a3cd5-e4e6-3392-9706-d11a2a78a205",
                    "sense_definition": "Pousser quelqu'un ou un animal dans un lieu clos ou contre un obstacle d'où il ne peut plus fuir.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "impasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chasseurs ont réussi à <w>acculer</w> le loup au fond de la gorge rocheuse."
                        },
                        {
                            "text": "Le garde du corps a <w>acculé</w> l'agresseur dans un coin pour l'immobiliser."
                        }
                    ],
                    "synonyms": [
                        "coincer",
                        "bloquer",
                        "enfermer"
                    ],
                    "antonyms": [
                        "libérer"
                    ],
                    "common_phrases": [
                        "acculer dans un coin",
                        "acculer au pied du mur"
                    ]
                }
            ]
        }
    ]
