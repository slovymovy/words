            {
                "entry_id": "1771983a-1c2b-39ad-bb6d-9d7babda5131",
                "word": "d’hiver",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                        "entry_id": "1771983a-1c2b-39ad-bb6d-9d7babda5131",
                        "glosses": [
                            "Qualifie une culture que l’on sème avant l’hiver et qui doit subir une certaine vernalisation pour continuer son cycle biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa580fed-3e21-4eae-9fd6-31da127aa121",
                                "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                                "text": "Lors de leur inscription sur le catalogue officiel des semences, les variétés de blé tendre d’hiver sont évaluées selon des méthodes bien codifiées par le CTPS."
                            },
                            {
                                "example_id": "45d262c3-71bb-4803-bd85-4e37d9d0fafb",
                                "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                                "text": "Le colza d’hiver est la culture annuelle qui a la plus forte capacité à absorber, et donc à valoriser, l’azote minéral issu des effluents organiques."
                            },
                            {
                                "example_id": "988447bf-7624-44f9-a4ff-9dec0ec28999",
                                "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                                "text": "Les toutes premières bennes d’orge d’hiver commencent ainsi à rejoindre les silos. « Pour le moment, les résultats sont loin d'être représentatifs », insiste-t-on sur le terrain."
                            },
                            {
                                "example_id": "76a280dd-0b8b-402c-9ae0-40a565e77fef",
                                "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                                "text": "Les herbicides racinaires (LEGURAME PM 3 kg/ha ou KERB FLO 1,875 l/ha) peuvent être appliqués sur féveroles d’hiver."
                            },
                            {
                                "example_id": "bc999bb0-d699-4840-b8e4-4353d6e59452",
                                "sense_id": "a6bd37e1-3064-327d-9b22-d40e989cd0f6",
                                "text": "Les géniteurs de résistance au froid : « Champagne » et « Austria Winter » renferment le plus grand nombre de gènes récessifs. Les pois d’hiver actuels en possèdent moins et les pois de printemps en sont pratiquement dépourvus."
                            }
                        ]
                    }
