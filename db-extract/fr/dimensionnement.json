                                    {
                                        "sense_id": "c554f7ec-9130-31ef-97e6-7d03dfb2c97a",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "A physical base or foundation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d863db-a1a1-4fa8-8afb-7fc0d215c61e",
                                                "sense_id": "c554f7ec-9130-31ef-97e6-7d03dfb2c97a",
                                                "text": "1695, William Congreve, To the King, on the taking of Namur, 1810, Samuel Johnson, Alexander Chalmers (biographies), The Works of the English Poets from Chaucer to Cowper, Volume 10, page 271,\nBeholding rocks from their firm basis rent;\nMountain on mountain thrown,\nWith threatening hurl, that shook th' aerial firmament!"
                                            },
                                            {
                                                "example_id": "53683598-7ff9-4923-b5f2-8664401fabc9",
                                                "sense_id": "c554f7ec-9130-31ef-97e6-7d03dfb2c97a",
                                                "text": "We see here the ground-plan of masses of houses, with their upper walls of fire-baked brick on a basis of stone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7cff90-41a7-353d-9c32-9d0ca2df78b7",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "A starting point, base or foundation for an argument or hypothesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f9c1273-6590-4bab-8e3e-4f35eafa7fab",
                                                "sense_id": "bf7cff90-41a7-353d-9c32-9d0ca2df78b7",
                                                "text": "I wonder if the South Korean side has any basis that its smog is from China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8abca3e7-71ab-3c16-8301-53cccb5bf9e8",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "An underlying condition or circumstance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4542ecd-aea4-4422-95c6-068bd5311cd5",
                                                "sense_id": "8abca3e7-71ab-3c16-8301-53cccb5bf9e8",
                                                "text": "Hodgson may now have to bring in James Milner on the left and, on that basis, a certain amount of gloss was taken off a night on which Welbeck scored twice but barely celebrated either before leaving the pitch angrily complaining to the Slovakian referee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4051c9-65a0-3aef-bdc0-0d4d6e2edab4",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "A regular frequency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "544d1360-a631-48ae-b8bb-5cd7b9fe7f23",
                                                "sense_id": "9c4051c9-65a0-3aef-bdc0-0d4d6e2edab4",
                                                "text": "You should brush your teeth on a daily basis at minimum."
                                            },
                                            {
                                                "example_id": "8562e085-f1c8-43e7-98ba-7715189138b1",
                                                "sense_id": "9c4051c9-65a0-3aef-bdc0-0d4d6e2edab4",
                                                "text": "The flights to Fiji leave on a weekly basis."
                                            },
                                            {
                                                "example_id": "d46022ed-1e65-45a2-aaac-0f7cfd27375f",
                                                "sense_id": "9c4051c9-65a0-3aef-bdc0-0d4d6e2edab4",
                                                "text": "Cars must be checked on a yearly basis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7fe6fe5-0726-3e1b-82e2-c1902c27eb2a",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "The difference between the cash price a dealer pays to a farmer for his produce and an agreed reference price, which is usually the futures price at which the given crop is trading at a commodity exchange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978d3fc8-0e68-48a8-aa25-6ce32cdf2952",
                                                "sense_id": "c7fe6fe5-0726-3e1b-82e2-c1902c27eb2a",
                                                "text": "Included in the basis could be elevation, cleaning, freight by truck and/or rail, government inspection fees, administration fees, interest and storage charges as well as allowance for risk and profit for the grain dealer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7256e745-470e-3428-85d0-ae2f0cbc71c3",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "In a vector space, a linearly independent set of vectors spanning the whole vector space."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74fb533b-e56b-3234-95a0-fad12fe25fd1",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "Amount paid for an investment, including commissions and other expenses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21c707bb-a3c7-3f20-a37f-caf92277d70c",
                                        "entry_id": "0e92fff5-2aab-3078-a011-3099f651e654",
                                        "glosses": [
                                            "A collection of subsets (\\\"basis elements\\\") of a set, such that this collection covers the set, and for any two basis elements which both contain an element of the set, there is a third basis element contained in the intersection of the first two, which also contains that element."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c880cf27-2b83-4aea-9169-6a3cd8a8c49b",
                                                "sense_id": "21c707bb-a3c7-3f20-a37f-caf92277d70c",
                                                "text": "The collection of all possible unions of basis elements of a basis is said to be the topology generated by that basis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
