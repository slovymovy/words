                    "sense_id": "43344a31-f687-3b99-b09d-58d92d5354ba",
                    "sense_definition": "Charakteristischer Klang oder typisches Klangbild, insbesondere bezogen auf Musikstile, Instrumente oder Bands.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Band arbeitet im Studio an ihrem neuen Album und sucht nach einem modernen <w>Sound</w>."
                        },
                        {
                            "text": "Für einen typischen <w>Sound</w> der Rockmusik muss das Signal der E-Gitarre verzerrt werden."
                        }
                    ],
                    "synonyms": [
                        "Klang",
                        "Klangbild",
                        "Ton"
                    ],
                    "common_phrases": [
