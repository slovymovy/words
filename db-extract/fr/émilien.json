            {
                "entry_id": "37f7b5a3-c47d-32c2-9a4d-7cfbbfcc635f",
                "word": "émilien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33a87fc2-221b-3bb0-ab50-af2a01457889",
                        "entry_id": "37f7b5a3-c47d-32c2-9a4d-7cfbbfcc635f",
                        "glosses": [
                            "Langue utilisée dans la région d’Émilie en Italie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bea5487-6f57-4b97-85f5-348331b6487e",
                                "sense_id": "33a87fc2-221b-3bb0-ab50-af2a01457889",
                                "text": "Commençons notre périple en Italie du Nord. Les dialectes dits « gallo-italiques » se subdivisent en cinq groupes : lombard, piémontais, ligure, émilien et romagnol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91efecfe-24b0-46b2-a2a8-223944f3c8a8",
                        "source_entry_id": "37f7b5a3-c47d-32c2-9a4d-7cfbbfcc635f",
                        "source_sense_id": "33a87fc2-221b-3bb0-ab50-af2a01457889",
                        "target_lang_word": "Emilianisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emilianisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "420a4892-7ae9-3ee8-8bd0-63b8ca62b08a",
                                        "entry_id": "c10f2b97-5f77-32a7-8d5a-3b8ddb5cdb56",
                                        "glosses": [
                                            "eine Gruppe romanischer Dialekte, die in der Region Emilia-Romagna im Norden Italiens gesprochen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b76b3d1-2f5a-43f0-b122-2f50dde3da53",
                                                "sense_id": "420a4892-7ae9-3ee8-8bd0-63b8ca62b08a",
                                                "text": "„Die italienischen Dialekte machen auch die elementarste Verständigung zwischen einem Sizilianisch und einem Emilianisch sprechenden Italiener, zwischen einem piemontesischen Bauer und einem apulischen Maurer, zwischen Jugendlichen aus Friaul und Gleichaltrigen aus Padua äußerst schwierig.“"
                                            },
                                            {
                                                "example_id": "39d4493d-1c0d-4776-b2b0-158a67e94850",
                                                "sense_id": "420a4892-7ae9-3ee8-8bd0-63b8ca62b08a",
                                                "text": "„Das Emilianische zwischen Apennin und Po überschreitet zweimal den Fluss, indem es in Mantua sich zwischen das Venezianische und Lombardische einzwangt, sodann zwischen Lambro und Tessin das Gebiet von Pavia in sich fasst.“"
                                            },
                                            {
                                                "example_id": "79a11a30-e069-46dd-9188-d27a2eb1c9e9",
                                                "sense_id": "420a4892-7ae9-3ee8-8bd0-63b8ca62b08a",
                                                "text": "„Da in der augenblicklichen öffentlichen Diskussion selbst für Dialekte wie das Emilianische ein Regionalsprachenstatus diskutiert wird, ist der politische Kontrast zwischen regionaler sprachlicher Selbstbestimmung und Roms zentralistischem Anspruch weniger prägnant.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
