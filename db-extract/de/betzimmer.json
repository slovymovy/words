                            {
                                "example_id": "7c4adb74-2bb9-4687-9b37-9f10fe219ecb",
                                "sense_id": "f405f411-be49-387b-84d8-ac7184970fd7",
                                "text": "„Die Gräfin ging ins Betzimmer, und Sonja fand sie dort kniend vor den Heiligenbildern, die noch vereinzelt an den Wänden hingen, während diejenigen, denen irgendwelche Familientraditionen einen besonderen Wert geben, zum Mitnehmen bestimmt worden waren.“"
                            }
