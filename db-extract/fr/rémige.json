                    {
                        "sense_id": "93e71c56-9a16-395d-9381-9b981bd85f0d",
                        "entry_id": "0d00f8ef-bc72-3209-9963-aa350285e760",
                        "glosses": [
                            "Chacune des grandes plumes rigides de l’aile des oiseaux, qui leur servent à se porter dans l’air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b1d730f-3d59-4918-9afa-36d3527fdeb5",
                                "sense_id": "93e71c56-9a16-395d-9381-9b981bd85f0d",
                                "text": "La jeune femme ramasse la rémige, s’en caresse la joue et la serre ensuite entre les pages de la Bible qui repose sur sa table de nuit."
                            },
                            {
                                "example_id": "e75cef99-3d56-4ad4-8701-0a882fdf54cc",
                                "sense_id": "93e71c56-9a16-395d-9381-9b981bd85f0d",
                                "text": "Examinons par exemple les rémiges d’un oiseau. D’abord nous voyons une tige qui est un tube vide dont le diamètre décroit vers l’extrémité libre, par conséquent une forme d’égale résistance."
                            }
                        ]
                    }
                ],
                "translations": [
