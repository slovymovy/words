                    },
                    {
                        "translation_id": "3a010bcc-0527-4b9b-9b0d-2bf5a3d99c11",
                        "source_entry_id": "7b946efa-d33b-3368-bd8e-a2659f7d1149",
                        "source_sense_id": "fe98ce62-feb0-3e55-84b0-39029ca5dfc2",
                        "target_lang_word": "swindle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swindle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d75f3c-b12d-36ba-b9e7-06afbfbeeed0",
                                        "entry_id": "972d5291-c0fe-396c-b346-cfdffff50095",
                                        "glosses": [
                                            "To defraud."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a8b5809-96c9-4723-a20d-17bee584f1e4",
                                                "sense_id": "a4d75f3c-b12d-36ba-b9e7-06afbfbeeed0",
                                                "text": "The two men swindled the company out of $160,000."
                                            },
                                            {
                                                "example_id": "aaa16aa1-bf81-44b9-95f3-21ac72751fed",
                                                "sense_id": "a4d75f3c-b12d-36ba-b9e7-06afbfbeeed0",
                                                "text": "Such Nations cannot have a King to command them; can only have this or the other scandalous swindling Copper Captain, constitutional Gilt Mountebank, or other the like unsalutary entity by way of King; and the sins of the fathers are visited upon the children in a frightful and tragical manner, little noticed in the Penny Newspapers and Periodical Literatures of this generation."
                                            },
                                            {
                                                "example_id": "827baccc-485b-4f16-a5fd-1a6696523f55",
                                                "sense_id": "a4d75f3c-b12d-36ba-b9e7-06afbfbeeed0",
                                                "text": "That word is bezzle. It describes the period in which an embezzler has stolen a man's money but the victim does not yet realize he's been swindled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1b0f5f-eb51-3d35-abee-30d02a08a77f",
                                        "entry_id": "972d5291-c0fe-396c-b346-cfdffff50095",
                                        "glosses": [
                                            "To obtain (money or property) by fraudulent or deceitful methods."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90bccae6-2e83-4923-9bc2-f0e70469fdec",
                                                "sense_id": "3a1b0f5f-eb51-3d35-abee-30d02a08a77f",
                                                "text": "She swindled more than £200 out of me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb58ad08-0f0c-3891-aadd-4063a26be43b",
                                        "entry_id": "972d5291-c0fe-396c-b346-cfdffff50095",
                                        "glosses": [
                                            "For a player in a losing position to play a clever move that provokes an error from the opponent, thus achieving a win or a draw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swindle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6accb02f-eb8e-3c18-8d5d-a75a6a9990f0",
                                        "entry_id": "624dffc1-24ce-314c-b239-e96c239dcf1b",
                                        "glosses": [
                                            "An instance of swindling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3bbd577-d9bd-448f-b1b6-c85183a05946",
                                                "sense_id": "6accb02f-eb8e-3c18-8d5d-a75a6a9990f0",
                                                "text": "There were men there who had committed merciless robberies, cruel murders, heartless swindles, abominable depravities."
                                            },
                                            {
                                                "example_id": "d776c859-f35c-472f-ba86-1307eb779a8a",
                                                "sense_id": "6accb02f-eb8e-3c18-8d5d-a75a6a9990f0",
                                                "text": "[T]he scandal was the pretty common one of a corrupt agreement between hotel proprietors and a salesman who took and gave secret commissions, so that his business had a monopoly of all the drink sold in the place. It wasn't even an open slavery like an ordinary tied house; it was a swindle at the expense of everybody the manager was supposed to serve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dac4b79e-af76-3876-9bde-e93e55cf94b0",
                                        "entry_id": "624dffc1-24ce-314c-b239-e96c239dcf1b",
                                        "glosses": [
                                            "Anything that is deceptively not what it appears to be."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac5495ae-1f61-39ee-bf8e-7579a66fd95e",
                                        "entry_id": "624dffc1-24ce-314c-b239-e96c239dcf1b",
                                        "glosses": [
                                            "An instance wherein a player in a losing position plays a clever move that provokes an error from the opponent, thus achieving a win or a draw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b560799f-d439-4ffd-9340-2055a35f067b",
                        "source_entry_id": "7b946efa-d33b-3368-bd8e-a2659f7d1149",
                        "source_sense_id": "fe98ce62-feb0-3e55-84b0-39029ca5dfc2",
                        "target_lang_word": "tromperie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tromperie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "13f7fcbe-753d-3383-b045-b128f1911021",
                                        "entry_id": "273a4207-c5ef-3f4f-b0de-d49261a5dc02",
                                        "glosses": [
                                            "Action de tromper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fecb219-d665-44f1-8b79-f26e79ee5351",
                                                "sense_id": "13f7fcbe-753d-3383-b045-b128f1911021",
                                                "text": "Ces sages et prudentes précautions prises pour sa sûreté touchèrent le cœur de Richard et achevèrent de dissiper le léger ressentiment qu’avait fait naître en lui l’innocente tromperie du chef des outlaws."
                                            },
                                            {
                                                "example_id": "2d049302-7b8d-4bdf-b29a-8e7c4165d049",
                                                "sense_id": "13f7fcbe-753d-3383-b045-b128f1911021",
                                                "text": "L’indigne tromperie, à laquelle des ministres et des généraux, abusant de la persistance de mes sympathies pour l’Élu du 10 décembre et de ma bonne foi, m’ont fait servir d’instrument, cette insigne tromperie m’impose, plus qu’à un autre, le devoir, à titre d’expiation, de n’épargner aucun effort, aucun sacrifice pour rendre impossible une restauration impériale […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef9047d-0d10-3f20-bab9-626941df10a8",
                                        "entry_id": "273a4207-c5ef-3f4f-b0de-d49261a5dc02",
                                        "glosses": [
                                            "Fraude sur la nature ou la qualité des produits ou des services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0450f93d-60c9-469e-9c22-5600eb2ee764",
                                                "sense_id": "4ef9047d-0d10-3f20-bab9-626941df10a8",
                                                "text": "[…]; Fourier, au début de l’ère nouvelle, croyait que la tromperie sur la qualité des marchandises était un trait caractéristique des relations entre civilisés ; […]. Marx dira, tout au contraire, que « la tromperie sur la marchandise est injuste dans le système capitaliste de production », parce qu’elle ne correspond plus au système moderne des affaires."
                                            },
                                            {
                                                "example_id": "48cbca15-9305-4302-93d9-ed050b138fa2",
                                                "sense_id": "4ef9047d-0d10-3f20-bab9-626941df10a8",
                                                "text": "La technique de vente percutante « cycle court » ou « one shot », qui fait de plus en plus de victimes parmi les chefs d’entreprise, artisans, commerçants et professions libérales, est utilisée par des sociétés douteuses pour réaliser une tromperie manifeste sur l’objet de la vente en première visite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fc7ec9e-8181-39c7-9861-35e6929c9769",
                                        "entry_id": "273a4207-c5ef-3f4f-b0de-d49261a5dc02",
                                        "glosses": [
                                            "Acte qui a pour but un profit malhonnête ou illégal."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44944ae6-a99f-4c4c-bbae-d232b4a020a3",
                                                "sense_id": "1fc7ec9e-8181-39c7-9861-35e6929c9769",
                                                "text": "Mettez-vous en garde contre ces belles promesses, elles cachent souvent la plus infâme des tromperies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0344cac-4a80-34dd-900e-6666d5604ed1",
                                        "entry_id": "273a4207-c5ef-3f4f-b0de-d49261a5dc02",
                                        "glosses": [
                                            "Infidélité conjugale."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70850b04-5324-4227-8d13-b9cf1e53f7e7",
                                                "sense_id": "b0344cac-4a80-34dd-900e-6666d5604ed1",
                                                "text": "Pour Don Juan, « la féminité tout à fait abstraite est l’essentiel », l’individualité n’existe pas : il n’y a jamais eu à ses yeux ni infidélité ni tromperie, mais seulement répétition et multiplicité."
                                            },
                                            {
                                                "example_id": "46d5eddf-08cb-4611-8e73-1f6b14c1cb73",
                                                "sense_id": "b0344cac-4a80-34dd-900e-6666d5604ed1",
                                                "text": "Sous la description ironique des tromperies conjugales, perce la piètre estime en laquelle son auteur tient les femmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
