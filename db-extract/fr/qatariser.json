                        "glosses": [
                            "Donner un caractère qatari à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2321d036-e45e-411e-ac88-e6adb69ed207",
                                "sense_id": "b6a18fcc-8dce-36f1-94ab-e35ab976226e",
                                "text": "Pourtant, il est question de « qatariser » à terme tous les cadres qui opèrent dans les chantiers pharaoniques du pays."
                            },
                            {
                                "example_id": "76850402-378c-4a52-be7a-1ae2db7aa1a2",
                                "sense_id": "b6a18fcc-8dce-36f1-94ab-e35ab976226e",
                                "text": "Mais les autorités entendent \"qatariser\" les postes à responsabilité."
                            },
                            {
                                "example_id": "3c2e7d89-8078-41d9-8e3e-353d1184ec2d",
                                "sense_id": "b6a18fcc-8dce-36f1-94ab-e35ab976226e",
                                "text": "Investissements dans le sport, les médias, les hôtels... faut-il laisser la France se \"qatariser\" ?"
                            }
                        ]
                    }
