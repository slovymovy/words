                    {
                        "sense_id": "11462c5d-b640-3cb8-9010-56c68c1ef1f0",
                        "entry_id": "9a696422-ca36-32bf-801e-769a938e3471",
                        "glosses": [
                            "gegenseitiges Erfassen zweier Personen mit den Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380c75b3-55c4-4f9c-921a-a22033e41895",
                                "sense_id": "11462c5d-b640-3cb8-9010-56c68c1ef1f0",
                                "text": "„Während die beiden die Hände ineinander legten, unterbrach sie nicht ein einziges Mal den Augenkontakt mit Tom.“"
                            },
                            {
                                "example_id": "819a08c7-6a97-4c6e-9497-4db99316fa6a",
                                "sense_id": "11462c5d-b640-3cb8-9010-56c68c1ef1f0",
                                "text": "„Ramin legt das Besteck zur Seite, sucht Augenkontakt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c03dc28b-d285-4697-942e-397c02eee93c",
                        "source_entry_id": "9a696422-ca36-32bf-801e-769a938e3471",
                        "source_sense_id": "11462c5d-b640-3cb8-9010-56c68c1ef1f0",
