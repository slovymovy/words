                                "example_id": "1da3db85-5c37-4ca0-a5ed-f78576f89898",
                                "sense_id": "3f3db2e6-4105-3b27-848f-679feb04afa3",
                                "text": "Et pourquoi, retrucider ton blog, Kiki?"
