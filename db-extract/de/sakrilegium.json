                ],
                "senses": [
                    {
                        "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                        "entry_id": "cb650cb6-4ce7-39a4-b500-9641ae51a0e3",
                        "glosses": [
                            "Vergehen gegen Heiliges, zum Beispiel die Entweihung heiligen Bodens oder Sachen durch Raub, Schändung oder auch Missbrauch, aber auch Angriffe gegen geweihte Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39bc7184-246d-49bc-b8f1-1a47d0b2f2e9",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„Mit einer Waffe in seine alte Schule zu gehen, das wäre seinem Gefühl nach ein Sakrilegium gewesen.“"
                            },
                            {
                                "example_id": "abf16cce-46b1-4df9-8fcb-60539be718a2",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„In der Ära der Perserkriege haben diese Sakrilegien zweifellos als ein besonders schwerwiegendes, Sühne und Wiedergutmachung erforderndes Vergehen gegolten.“"
                            },
                            {
                                "example_id": "52c2cf22-95c5-47ef-a736-6820afef9721",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„Er stellt zuerst den Satz fest, daß manche Handlungen, wie Ehebruch, Mord, Sakrilegien, an sich, nicht bloß gesetzlich unerlaubt sind.“"
                            },
                            {
                                "example_id": "59c90955-b7cf-42fc-b759-4e131235c6ee",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„Wer ihre experimentierende Verwendung als Sakrileg kritisiert, übersieht, dass sie selbst Sakrilegien ihre Existenz verdankten […].“"
                            },
                            {
                                "example_id": "f1852d66-c1d4-4222-bde1-8bf0bcfe83c8",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„Theokratie, von Gott eingesetzte Gewalt, das Sakrileg aller Sakrilegien.“"
                            },
                            {
                                "example_id": "f4cf8f42-ad20-4329-ad73-2d7c991df60b",
                                "sense_id": "cbd75f55-7d2f-3a7d-aa1a-1c04351bdb40",
                                "text": "„Die große Bandbreite der Vergehen, die unter dem Rechtsbegriff des Sakrilegs gefasst werden, mache es unmöglich, sie hier aufzuzählen. Schon in der Spätantike definieren Theologen wie Augustinus Vergehen gegen Gott als Sakrileg, […]. Da die Sakrilegien in die Kategorie des crimen publicum fallen, unterliegen sie der herrscherlichen Sanktionsgewalt, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
