                                            {
                                                "example_id": "edc25efb-7b8e-4d2d-b5f1-9a274a2a5875",
                                                "sense_id": "371346d7-dbf8-39b2-827e-47936865aa11",
                                                "text": "„Aber die Felsen lagen im Bereich der Möglichkeit, ebenso die zerschmetterten Bäume, die Immortellen und das Moos – und in steigender Begeisterung, nach vielem Herumtasten, bastelten sie sich mit Hilfe eines einzigen Knechts und für eine winzige Summe eine Residenz zusammen, die im ganzen Departement nicht ihresgleichen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "593b7d3c-3185-3426-891b-f9cc32231189",
                                        "entry_id": "79bfe70c-d704-367e-8067-2daf4f940c83",
                                        "glosses": [
                                            "Fachbereich an Universitäten"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "95dbf217-e271-3743-88cd-f22861440c7e",
                                        "entry_id": "79bfe70c-d704-367e-8067-2daf4f940c83",
                                        "glosses": [
                                            "höchster Regierungs- und Verwaltungsbereich (auf Bundesebene), dem ein Bundesrat beziehungsweise eine Bundesrätin als Departementschef(in) vorsteht"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f59a1020-548b-4767-8177-86e7fe97c6a2",
                                                "sense_id": "95dbf217-e271-3743-88cd-f22861440c7e",
                                                "text": "In der Schweiz gibt es die folgenden sieben Departemente: das Eidgenössische Departement für auswärtige Angelegenheiten, das Eidgenössische Departement des Innern, das Eidgenössische Justiz- und Polizeidepartement, das Eidgenössische Departement für Verteidigung, Bevölkerungsschutz und Sport, das Eidgenössische Finanzdepartement, das Eidgenössische Volkswirtschaftsdepartement sowie das Eidgenössische Departement für Umwelt, Verkehr, Energie und Kommunikation."
                                            },
                                            {
                                                "example_id": "df93586a-9332-4b61-b23f-903cd01f6cba",
                                                "sense_id": "95dbf217-e271-3743-88cd-f22861440c7e",
                                                "text": "„Aufgrund der ungewissen Entwicklung der Lage rät das Eidgenössische Departement für auswärtige Angelegenheiten (EDA), geplante Reisen nach Bangkok bis auf weiteres zu verschieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "24e0f95b-eca9-37f7-8ee3-d2c5ee2dbe8c",
                                        "entry_id": "79bfe70c-d704-367e-8067-2daf4f940c83",
                                        "glosses": [
                                            "(einzig in den folgenden Kantonen: Aargau, Appenzell Innerrhoden, Basel-Stadt, Graubünden, Luzern, Obwalden, St. Gallen, Schaffhausen, Solothurn, Schwyz und Thurgau) Regierungs- und Verwaltungsbereich, der einem Mitglied der Regierung untersteht"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "ad61a867-b411-390c-b94d-35e879e06bf7",
                                        "entry_id": "79bfe70c-d704-367e-8067-2daf4f940c83",
                                        "glosses": [
                                            "Abteilung; Geschäftsbereich"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12fe41e4-17ad-4cbf-8a24-16ddf65e21c4",
                                                "sense_id": "ad61a867-b411-390c-b94d-35e879e06bf7",
                                                "text": "„Als kurzsichtig erachtet eine solche Massnahme der Leiter des Departements für Zahnmedizin, der den Abbau nicht hinnehmen will“"
                                            }
                                        ],
