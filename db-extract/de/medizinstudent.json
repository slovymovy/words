                                        "sense_id": "83a59dde-4c06-3570-bb9c-35f39532065a",
                                        "entry_id": "226f5dd9-9e05-373e-b6dd-0c970a2281e7",
                                        "glosses": [
                                            "A student enrolled at a medical school, who is training to become a physician."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
