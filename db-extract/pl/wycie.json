                "translations": [
                    {
                        "translation_id": "02d766a7-b5a1-420b-b689-1f1eb3c326b3",
                        "source_entry_id": "072a47a8-4c60-3d2b-90e5-35cb6eb94b4a",
                        "source_sense_id": "7ded9811-5701-330c-bac7-9a750a033ffb",
                        "target_lang_word": "howl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "howl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e0883d40-2b93-3ba2-b6b8-232378bfe274",
                                        "entry_id": "505e5296-9f8d-380e-aab1-544df10b7eea",
                                        "glosses": [
                                            "The protracted, mournful cry of a dog, wolf or other canid; also of other animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8325ad1-f1c2-4c79-8bf4-536d4d9d47bc",
                                                "sense_id": "e0883d40-2b93-3ba2-b6b8-232378bfe274",
                                                "text": "[T]he fox was out on love-adventures, abused his rivals, and uttered scoffing screams and howls."
                                            },
                                            {
                                                "example_id": "806b6814-e081-4271-b73f-92fe7a577be7",
                                                "sense_id": "e0883d40-2b93-3ba2-b6b8-232378bfe274",
                                                "text": "All at once the cat thrust her paw inside the ring again, but the tailor was quick as lightning and chopped the paw off. The cats set up a terrible howl, and away they rushed through the door as fast as they could."
                                            },
                                            {
                                                "example_id": "e5a7d542-a167-4745-ba8d-ee5af3dd9721",
                                                "sense_id": "e0883d40-2b93-3ba2-b6b8-232378bfe274",
                                                "text": "Dan was beginning to feel very depressed when suddenly the eerie howl of a dingo rang out[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5251f7c6-9187-3f94-8ef4-86553556e3ee",
                                        "entry_id": "505e5296-9f8d-380e-aab1-544df10b7eea",
                                        "glosses": [
                                            "Any similar sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2010ece2-c0ca-4b1e-b601-d1eddf94e049",
                                                "sense_id": "5251f7c6-9187-3f94-8ef4-86553556e3ee",
                                                "text": "The howl of the wind"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ccd25f-7eaf-3674-b241-45796558620e",
                                        "entry_id": "505e5296-9f8d-380e-aab1-544df10b7eea",
                                        "glosses": [
                                            "A prolonged cry of distress or anguish; a wail."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "howl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0482a286-3c5e-3530-a61a-5bba4326f7ea",
                                        "entry_id": "31051a55-1aca-3b55-b541-c7a9f7e9474c",
                                        "glosses": [
                                            "To utter a loud, protracted, mournful sound or cry, as dogs and wolves often do."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467c8834-9f3a-48e8-ac0f-0c526f72118f",
                                                "sense_id": "0482a286-3c5e-3530-a61a-5bba4326f7ea",
                                                "text": "Methought a legion of foul fiends / Environ'd me about, and howled in my ears."
                                            },
                                            {
                                                "example_id": "435ed9aa-3652-4eab-afde-8b455292dd90",
                                                "sense_id": "0482a286-3c5e-3530-a61a-5bba4326f7ea",
                                                "text": "VVhen ominus ſignes to ſhew themſelues began, / That novv at hand this monſtrous birth fore-ran: / About at noone flew the affrighted Ovvle, / And dogs in corners ſet them dovvne to hovvle: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521efdfd-ee74-3355-8d19-7e4b9bec685d",
                                        "entry_id": "31051a55-1aca-3b55-b541-c7a9f7e9474c",
                                        "glosses": [
                                            "To utter a sound expressive of pain or distress; to cry aloud and mournfully; to lament; to wail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28eb281-9e1a-4b52-bc23-50f0f5a4cb8c",
                                                "sense_id": "521efdfd-ee74-3355-8d19-7e4b9bec685d",
                                                "text": "Howl ye, for the day of the Lord is at hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21dfb022-f244-3656-8d2a-a427d4105cb2",
                                        "entry_id": "31051a55-1aca-3b55-b541-c7a9f7e9474c",
                                        "glosses": [
                                            "To make a noise resembling the cry of a wild beast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df928014-b26e-48e1-bbf3-ecc4d72d3122",
                                                "sense_id": "21dfb022-f244-3656-8d2a-a427d4105cb2",
                                                "text": "They howled with laughter at the prank."
                                            },
                                            {
                                                "example_id": "cd1df10a-5593-4814-bbad-de93e006696c",
                                                "sense_id": "21dfb022-f244-3656-8d2a-a427d4105cb2",
                                                "text": "Wild howl'd the wind the forest glades along, / And oft the owl renew'd her dismal song; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5665e0fa-dcfd-3172-9891-0b6dff0a7d18",
                                        "entry_id": "31051a55-1aca-3b55-b541-c7a9f7e9474c",
                                        "glosses": [
                                            "To utter with outcry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d30230-87be-4dd4-999c-e02b74feee00",
                                                "sense_id": "5665e0fa-dcfd-3172-9891-0b6dff0a7d18",
                                                "text": "to howl derision"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1ca5c8b-2851-4b3a-8246-b634edfe22da",
                        "source_entry_id": "072a47a8-4c60-3d2b-90e5-35cb6eb94b4a",
                        "source_sense_id": "7ded9811-5701-330c-bac7-9a750a033ffb",
                        "target_lang_word": "howling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "howling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c09c10a2-be6e-3896-aa94-e856bb90e8d9",
                                        "entry_id": "7c4f5d1a-0e75-32e9-8f0a-7c92250b760b",
                                        "glosses": [
                                            "The act of producing howls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a64ec11-9488-4743-8727-a8237abe6803",
                                                "sense_id": "c09c10a2-be6e-3896-aa94-e856bb90e8d9",
                                                "text": "The howling of wolves is haunting at night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "howling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81478a67-3427-379b-b774-40dd4aed75b7",
                                        "entry_id": "92748fa0-df34-3f73-bc52-147eba011eb4",
                                        "glosses": [
                                            "present participle and gerund of howl"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59af311-12d2-478b-bb92-c6f4418baa45",
                                                "sense_id": "81478a67-3427-379b-b774-40dd4aed75b7",
                                                "text": "\"They have turned a great old English institution into a shameful clip-joint. It's a shuddering, howling tragedy.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "howling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eebdc196-e22e-348b-9c25-ee62fa555875",
                                        "entry_id": "c43e11dd-a6c4-32d4-999e-f5f48cd89105",
                                        "glosses": [
                                            "That howls."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b210467f-e9ae-482e-9cb8-6c7d9e3b65a3",
                                                "sense_id": "eebdc196-e22e-348b-9c25-ee62fa555875",
                                                "text": "A few minutes later a howling mob was at the door."
                                            },
                                            {
                                                "example_id": "7fbdcb32-517f-4bd1-88ac-14b211a85ca7",
                                                "sense_id": "eebdc196-e22e-348b-9c25-ee62fa555875",
                                                "text": "We have already seen in Chapter I how man stepped upwards from the level of a howling brute to the higher level of an articulate being, and thence to the still higher level of a singing creature."
                                            },
                                            {
                                                "example_id": "cbc577c6-511e-4066-a176-5dedbb8a1174",
                                                "sense_id": "eebdc196-e22e-348b-9c25-ee62fa555875",
                                                "text": "It consisted of marching on to College green or St Stephen's green on a day when there was a howling gale and the wind was blowing about us –I am sure hon. Members today are familiar with this –to utter a few, well-chosen platitudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f58794ef-9f93-396b-8f0a-a30be0ab41b9",
                                        "entry_id": "c43e11dd-a6c4-32d4-999e-f5f48cd89105",
                                        "glosses": [
                                            "That causes one to howl or feel like howling; deeply distressing."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77b47e9-5782-4328-a868-e94d45ca022d",
                                                "sense_id": "f58794ef-9f93-396b-8f0a-a30be0ab41b9",
                                                "text": "Ah! the death of the poor, the empty entrails, howling hunger, the animal appetite that leads one with chattering teeth to fill one's stomach with beastly refuse in this great Paris, so bright and golden!"
                                            },
                                            {
                                                "example_id": "fe6eeb90-ed97-4405-b3c0-33317129dd0f",
                                                "sense_id": "f58794ef-9f93-396b-8f0a-a30be0ab41b9",
                                                "text": "Some agency must control the allocation of frequencies or all our airways would be a howling chaos: but there is no rational justification for the kind of regulation that the Federal Communications Commission proposes for our industry."
                                            },
                                            {
                                                "example_id": "7af5e9e0-60ac-470d-8b82-63621e856866",
                                                "sense_id": "f58794ef-9f93-396b-8f0a-a30be0ab41b9",
                                                "text": "A pervasive sense of optimism led settlers in southern New Zealand to transform their properites from a 'howling wilderness' to a humanised rural landscape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54bc95cb-31aa-3d67-af06-6f55c3adfa16",
                                        "entry_id": "c43e11dd-a6c4-32d4-999e-f5f48cd89105",
                                        "glosses": [
                                            "Used as an intensifier"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd3a257-db10-46d9-948f-7011c4345e6f",
                                                "sense_id": "54bc95cb-31aa-3d67-af06-6f55c3adfa16",
                                                "text": "Those were days that I had success, for I could see it, and feel it, and taste it, and my patrons caught the contagion and we had a howling success ."
                                            },
                                            {
                                                "example_id": "7f8b7328-9bbd-45e6-a994-5e0d0013d4d3",
                                                "sense_id": "54bc95cb-31aa-3d67-af06-6f55c3adfa16",
                                                "text": "Boy, what a howling triumph if we should find our way out of here and go walking into Stark House by night !"
                                            },
                                            {
                                                "example_id": "27326293-d82d-4d4d-b3a3-d0056243b9ce",
                                                "sense_id": "54bc95cb-31aa-3d67-af06-6f55c3adfa16",
                                                "text": "The majority of your audience comes to your tale with one hopeful expectation: Tell me a howling good story."
                                            },
                                            {
                                                "example_id": "8c3274ae-99f9-45e5-998b-d9c208e0ac58",
                                                "sense_id": "54bc95cb-31aa-3d67-af06-6f55c3adfa16",
                                                "text": "a howling success"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "7ffac14f-768b-4c22-9d06-afbc5a354375",
                        "source_entry_id": "072a47a8-4c60-3d2b-90e5-35cb6eb94b4a",
