            {
                "entry_id": "694e0928-5673-34ab-92e7-1d31b4dbd2b2",
                "word": "Daffy",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d422234-3844-3381-bc0f-607b0d55fb18",
                        "entry_id": "694e0928-5673-34ab-92e7-1d31b4dbd2b2",
                        "glosses": [
                            "A diminutive of the female given name Daphne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2180a9d3-fc0d-4963-9e9a-d95c6db6dc5d",
                                "sense_id": "9d422234-3844-3381-bc0f-607b0d55fb18",
                                "text": "The name Daffy stuck, and to make it worse, Tony added \"Duck\" as an afterthought. For weeks, he led all the other kids in a chorus of quacks whenever Daphne appeared, but she ignored them."
                            }
                        ]
                    },
                    {
                        "sense_id": "16ba907d-245d-38d2-92e4-d379389b74c8",
                        "entry_id": "694e0928-5673-34ab-92e7-1d31b4dbd2b2",
                        "glosses": [
                            "A diminutive of the female given name Daffodil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8564ec3-6e42-4c89-a7e7-bbef8bf94dc1",
                                "sense_id": "16ba907d-245d-38d2-92e4-d379389b74c8",
                                "text": "\"Call me Daffy,\" Daffodil interrupted with a demure smile."
                            }
                        ]
                    },
