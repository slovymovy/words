                "senses": [
                    {
                        "sense_id": "165a3cdc-ef45-3bbf-9a02-7c28566b8e40",
                        "entry_id": "8e4ffc31-8ad9-3203-a06f-b4ac668cb9dc",
                        "glosses": [
                            "een wit waar blauw doorheen gemengd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e06428-d86a-4e73-8f24-9dee22e71fe4",
                                "sense_id": "165a3cdc-ef45-3bbf-9a02-7c28566b8e40",
                                "text": "De grauwwitte doeken hebben een patroon van kleine vierkantjes, dat te zien is op plaatsen waar de verf dun is. Het zouden theedoeken kunnen zijn uit de keuken van de psychiatrische inrichting in Saint-Rémy, waar de schilder was opgenomen."
                            },
                            {
                                "example_id": "bbeb8174-08f5-4074-ad3b-1d20b890a76f",
                                "sense_id": "165a3cdc-ef45-3bbf-9a02-7c28566b8e40",
                                "text": "De recycling is op zichzelf geen heel ingewikkeld procedé, vindt de salesmanager. Bij de stapels geperste papierpulp -met een grauwwit kleurtje- aan het eind van het verwerkingsproces is de link met poepluiers niet meer te leggen. Bij de balen met kunststofkorrels evenmin."
                            }
                        ]
                    }
