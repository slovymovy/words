                "senses": [
                    {
                        "sense_id": "66b723da-240f-3c71-a5bb-3c3b092ced4f",
                        "entry_id": "cd9ef3e4-258f-33d9-8b9b-9fef2b1fa985",
                        "glosses": [
                            "met grote nauwgezetheid uitgevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386c0ff9-8b75-4015-a183-745b5d392462",
                                "sense_id": "66b723da-240f-3c71-a5bb-3c3b092ced4f",
                                "text": "Dat is geen accurate weergave van de gang van zake."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d30dc4c-f3b8-3071-8e29-aeed576c2889",
                        "entry_id": "cd9ef3e4-258f-33d9-8b9b-9fef2b1fa985",
                        "glosses": [
                            "vrij van systematische fouten"
                        ],
                        "tags": [
                            "in hoge mate"
                        ],
                        "examples": [
                            {
                                "example_id": "e6c07a64-b6e7-499c-96d2-d48aca5c4ab2",
                                "sense_id": "7d30dc4c-f3b8-3071-8e29-aeed576c2889",
                                "text": "Deze meting is weliswaar accuraat, maar niet erg precies omdat de willekeurige fouten vrij groot zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9109251-a901-3f34-8fee-9168efb67650",
                        "entry_id": "cd9ef3e4-258f-33d9-8b9b-9fef2b1fa985",
                        "glosses": [
                            "nauwgezet en precies als karaktereigenschap van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8476cad-d612-4b7c-a4d4-32ffb6e648a6",
                                "sense_id": "e9109251-a901-3f34-8fee-9168efb67650",
                                "text": "De dwangmatige vrouw zou je natuurlijk ook accuraat kunnen noemen."
                            },
                            {
                                "example_id": "f5abc1fd-821d-4435-8a82-ff1a5c6b6b09",
                                "sense_id": "e9109251-a901-3f34-8fee-9168efb67650",
                                "text": "Deze man is én heel accuraat én heel flexibel, want hij weet zich altijd tot de kern van de zaak te beperken."
                            }
                        ]
                    }
                ],
