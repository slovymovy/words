{
    "word_family": [
        "decease",
        "decedent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90acf98d-2163-3cb3-b108-63bbfeb4352a",
                    "sense_definition": "A person who has died, especially in a legal or medical context.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coroner carefully examined the <w>decedent</w> to determine the exact cause of death.",
                            "target_lang_translations": {
                                "zh": "验尸官仔细检查了<w>死者</w>，以确定确切的死因。"
                            }
                        },
                        {
                            "text": "Legal documents were filed to distribute the assets belonging to the <w>decedent</w> among the heirs.",
                            "target_lang_translations": {
                                "zh": "法律文件已提交，旨在将属于<w>死者</w>的资产分配给继承人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deceased",
                        "corpse"
                    ],
                    "common_phrases": [
                        "estate of decedent"
                    ],
                    "target_lang_definitions": {
                        "zh": "指已经去世的人，多用于法律或医学语境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "死者",
                                "target_lang_sense_clarification": "指已经死亡的人，法律和医学上的常用称呼。"
                            },
                            {
                                "target_lang_word": "亡者",
                                "target_lang_sense_clarification": "对死者的正式或书面称呼。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d85601e7-c92a-3c79-b5b1-2e07362ef8e2",
                    "sense_definition": "Relating to a person who has died.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer reviewed the <w>decedent</w> estate records to ensure all debts were paid.",
                            "target_lang_translations": {
                                "zh": "律师审查了<w>死者</w>的遗产记录，以确保所有债务都已清偿。"
                            }
                        },
                        {
                            "text": "The court must verify the <w>decedent</w> wishes before finalizing the distribution of property.",
                            "target_lang_translations": {
                                "zh": "法院必须在最终确定财产分配之前核实<w>死者</w>的遗愿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deceased"
                    ],
                    "common_phrases": [
                        "decedent estate"
                    ],
                    "target_lang_definitions": {
                        "zh": "与已故之人相关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "死者的",
                                "target_lang_sense_clarification": "用于描述属于或关于已故之人的事物。"
                            },
                            {
                                "target_lang_word": "已故的",
                                "target_lang_sense_clarification": "形容词，指已经去世的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}