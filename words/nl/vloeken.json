{
    "word_family": [
        "vloek",
        "vloeker",
        "vloekwoord",
        "vervloeken",
        "vervloeking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b573a3ee-c95a-3b59-b5c0-09bb6ba0078a",
                    "sense_definition": "het gebruiken van grove woorden of godslasterlijke taal om boosheid of frustratie te uiten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schelden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begon hardop te <w>vloeken</w> toen hij zijn sleutels in de put liet vallen.",
                            "target_lang_translations": {
                                "en": "He started <w>swearing</w> out loud when he dropped his keys into the well."
                            }
                        },
                        {
                            "text": "In dit huis mag je niet <w>vloeken</w> of lelijke woorden gebruiken.",
                            "target_lang_translations": {
                                "en": "In this house, you are not allowed to <w>curse</w> or use ugly words."
                            }
                        }
                    ],
                    "synonyms": [
                        "schelden",
                        "tieren"
                    ],
                    "common_phrases": [
                        "vloeken en tieren",
                        "binnensmonds vloeken"
                    ],
                    "target_lang_definitions": {
                        "en": "using coarse words or blasphemous language to express anger or frustration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swear",
                                "target_lang_sense_clarification": "to use offensive or profane language"
                            },
                            {
                                "target_lang_word": "curse",
                                "target_lang_sense_clarification": "to shout vulgar epithets or profanity"
                            },
                            {
                                "target_lang_word": "blaspheme",
                                "target_lang_sense_clarification": "to speak irreverently about sacred things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cb946c1-efce-3d87-9416-76c5e2b2269b",
                    "sense_definition": "het niet bij elkaar passen van kleuren, stijlen of elementen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "esthetiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die felgroene broek en dat paarse shirt <w>vloeken</w> enorm bij elkaar.",
                            "target_lang_translations": {
                                "en": "Those bright green pants and that purple shirt <w>clash</w> terribly."
                            }
                        },
                        {
                            "text": "Ik vind dat moderne meubels vaak <w>vloeken</w> met een klassiek interieur.",
                            "target_lang_translations": {
                                "en": "I think modern furniture often <w>clashes</w> with a classic interior."
                            }
                        }
                    ],
                    "synonyms": [
                        "detoneren",
                        "botsen"
                    ],
                    "antonyms": [
                        "harmoniseren",
                        "matchen"
                    ],
                    "common_phrases": [
                        "vloeken met",
                        "vloeken bij"
                    ],
                    "target_lang_definitions": {
                        "en": "the mismatching of colors, styles, or elements"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clash",
                                "target_lang_sense_clarification": "when colors or styles do not go together"
                            },
                            {
                                "target_lang_word": "conflict",
                                "target_lang_sense_clarification": "to be incompatible or at odds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bd9e70c-fe57-3050-8fd1-61c8b3488c49",
                    "sense_definition": "een magische of religieuze verwensing uitspreken over iemand of iets",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De heks dreigde de koning te <w>vloeken</w> als hij haar niet zou helpen.",
                            "target_lang_translations": {
                                "en": "The witch threatened to <w>curse</w> the king if he wouldn't help her."
                            }
                        },
                        {
                            "text": "In oude verhalen zie je vaak dat mensen hun vijanden <w>vloeken</w>.",
                            "target_lang_translations": {
                                "en": "In old stories, you often see people <w>cursing</w> their enemies."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervloeken",
                        "beheksen"
                    ],
                    "antonyms": [
                        "zegenen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In de zin van een magische bezwering"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to utter a magical or religious imprecation over someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "curse",
                                "target_lang_sense_clarification": "to place a supernatural detriment upon someone"
                            },
                            {
                                "target_lang_word": "hex",
                                "target_lang_sense_clarification": "to cast a spell or bad luck on someone"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a87c1321-c743-387d-b46b-d26d6c82c2a9",
                    "sense_definition": "meervoud van <w>vloek</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er kwamen verschillende <w>vloeken</w> uit zijn mond toen hij zijn teen stootte.",
                            "target_lang_translations": {
                                "en": "Several <w>curses</w> came out of his mouth when he stubbed his toe."
                            }
                        },
                        {
                            "text": "De oude legende spreekt over drie duistere <w>vloeken</w> die op het kasteel rusten.",
                            "target_lang_translations": {
                                "en": "The old legend speaks of three dark <w>curses</w> resting upon the castle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pluralis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of 'vloek' (curse)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "curses",
                                "target_lang_sense_clarification": "plural of curse, referring to both profanities and magical spells"
                            },
                            {
                                "target_lang_word": "swear words",
                                "target_lang_sense_clarification": "plural noun for offensive language"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}