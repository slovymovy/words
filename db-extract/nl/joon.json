                                        "sense_id": "1ee1ab86-7bde-3734-b0d7-376318353c83",
                                        "entry_id": "1129736e-360b-3271-857e-a7251f83aa09",
                                        "glosses": [
                                            "A float moored in water to mark a location, warn of danger, indicate a navigational channel or for other purposes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f46e0c6-dd9b-4c9a-9565-c56e240605d6",
                                                "sense_id": "1ee1ab86-7bde-3734-b0d7-376318353c83",
                                                "text": "While comm buoys allow rapid transmission, there is a finite amount of bandwidth available. Given that trillions of people may be trying to pass a message through a given buoy at any one time, access to the network is parceled out on priority tiers."
                                            }
                                        ]
