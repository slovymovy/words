                                    {
                                        "sense_id": "175137ab-2780-3291-ad46-004ef4c83be9",
                                        "entry_id": "920233fb-b247-361c-b1c7-ac7e2f412581",
                                        "glosses": [
                                            "související s ocasem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da520539-8af2-4d01-83b7-7e1f13c944db",
                                                "sense_id": "175137ab-2780-3291-ad46-004ef4c83be9",
                                                "text": "Dlouhá péra tato nejsou ocasní, nýbrž krycí; vlastní ocasní jsou kratší a slouží za podporu per zdobných, když tato v kruhovitém vějíři se rozevrou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef8ee30e-3b01-42f9-9f18-64f8209fda24",
                        "source_entry_id": "ece2943f-76d8-337e-b57c-4f8ea66c6210",
                        "source_sense_description": "pertaining to the tail",
                        "target_lang_word": "caudal",
