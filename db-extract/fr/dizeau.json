                "senses": [
                    {
                        "sense_id": "a6f3d4cc-21f1-30d9-af8b-7496d78e1dab",
                        "entry_id": "1ff765ae-6e09-3c82-9205-e97f8541c04e",
                        "glosses": [
                            "Ensemble de dix gerbes de céréales ou de dix bottes de foin."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "13e34f60-e852-4bef-9851-409af5ed77e0",
                                "sense_id": "a6f3d4cc-21f1-30d9-af8b-7496d78e1dab",
                                "text": "C’est un certain nombre de gerbes , comme le quatorzieme dizeau du produit de la moisson."
                            },
                            {
                                "example_id": "a2592bba-ed54-4c46-8a78-02a20a353f26",
                                "sense_id": "a6f3d4cc-21f1-30d9-af8b-7496d78e1dab",
                                "text": "Il soulevait les gerbes et les ameulonnait en dizeaux tous les quarante pas. Les épis cariés, atteints de bruine et de charbon laissaient échapper une poudre noire quand il les secouait."
                            },
                            {
                                "example_id": "0d39d8b2-ccf8-4360-93b2-8c1a4f7e83e3",
                                "sense_id": "a6f3d4cc-21f1-30d9-af8b-7496d78e1dab",
                                "text": "Il songea aux centaines de dizeaux que les mains maintenant inertes du vieillard avaient liés en gerbes au cours de sa vie, au nombre de fois où elles avaient caressé la chevelure de sa promise ou pris la main de sa petite fille, et à tous ces menus objets de la vie courante qu’elles avaient réalisé, et qui leur survivraient."
                            },
                            {
                                "example_id": "cb4dabec-1fc8-431c-8f46-4fb2e12c7398",
                                "sense_id": "a6f3d4cc-21f1-30d9-af8b-7496d78e1dab",
                                "text": "Déjà les blés sont à moitié fauchés, et les javelles réunies en dizeaus alignent leurs longues rangées régulières."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6287cf9-c385-321a-94a1-2658fcc48456",
                        "entry_id": "1ff765ae-6e09-3c82-9205-e97f8541c04e",
                        "glosses": [
                            "Meule de gerbes de blé ou de foin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd8689ef-dd7c-41b4-83ae-3d20daaf3d1b",
                                "sense_id": "d6287cf9-c385-321a-94a1-2658fcc48456",
                                "text": "Faute de ficelles, Hélène et les femmes du bourg, nuques ployées, ceinturaient les gerbes d’un lien de seigle, dressaient les dizeaux."
                            }
                        ]
                    }
