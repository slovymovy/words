                "senses": [
                    {
                        "sense_id": "f45a29be-12ce-38d4-95e0-94c6b9e4143e",
                        "entry_id": "dc892619-6279-304c-a223-a7d49d08b965",
                        "glosses": [
                            "etwas, das besonders Frauen betrifft, interessiert, für das Frauen zuständig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2c8aea-7bbd-43bc-8553-8ea6db906d38",
                                "sense_id": "f45a29be-12ce-38d4-95e0-94c6b9e4143e",
                                "text": "„Kindererziehung ist in Deutschland immer noch Frauensache, nur jeder vierte Vater geht in Elternzeit.“"
                            },
                            {
                                "example_id": "3d2a5fb4-e040-4a00-8075-24a0ebb3f1ab",
                                "sense_id": "f45a29be-12ce-38d4-95e0-94c6b9e4143e",
                                "text": "„Sie war dort wegen einer Frauensache operiert worden, der dortige Klinikleiter ein ausgewiesener Spezialist.“"
                            },
                            {
                                "example_id": "021394f4-f126-4a0d-9b1d-75a05f27927f",
                                "sense_id": "f45a29be-12ce-38d4-95e0-94c6b9e4143e",
                                "text": "„Ich bat sie auch, mir doch genau zu erklären, was sie im Krankenhaus mit ihr gemacht hatten, sie sagte, es wäre eine ›Frauensache‹ gewesen, ›harmlos, aber scheußlich‹.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
