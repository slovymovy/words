                        "entry_id": "71810549-1020-3fd7-8404-bb4f291a624f",
                        "glosses": [
                            "veraltet: filmische Zusammenstellung von Nachrichten, die im Kino vor dem Hauptfilm gezeigt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae94a62-fdf9-48c2-ab62-fd5474fe745c",
                                "sense_id": "1fed610d-0c32-3b0f-b43c-c8c9778a79e4",
                                "text": "„Wie das geschah, davon berichten polnische Wochenschauen.“"
                            },
                            {
                                "example_id": "00855146-2a90-4663-9036-cf6588c96e84",
                                "sense_id": "1fed610d-0c32-3b0f-b43c-c8c9778a79e4",
                                "text": "„Durch Generationen Eingeübtes kommt da offenbar ins Spiel, Erinnerungsfetzen laufen sekundenschnell vorüber, Aufnahmen der Wochenschauen vielleicht von den Siegesparaden: Warschau, Paris.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
