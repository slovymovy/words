        "nl-extract.jsonl": [
            {
                "entry_id": "b9ade9a7-af9c-397c-84a7-93f8071edeca",
                "word": "zwavel",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
                        "entry_id": "b9ade9a7-af9c-397c-84a7-93f8071edeca",
                        "glosses": [
                            "scheikundig element met symbool S en atoomnummer 16. Het is een geel niet-metaal"
                        ],
                        "tags": [
                            "element"
                        ],
                        "examples": [
                            {
                                "example_id": "09d7a666-b2db-4cc6-99b0-0733bf50c666",
                                "sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
                                "text": "- Voor het feit dat een deel van de energie die bij deze snelle uitzetting vrijkwam, kon stollen tot deeltjes, die met elkaar de lichte waterstof-, lithium- en heliumatomen vormden, waarna deze uitgroeiden tot clusters die sterren voortbrachten met een gloeiende vloeibare kern, waarin alle elementen tot stand kwamen - koolstof, stikstof, zuurstof, zwavel en fosfor - die nodig waren voor de vorming van de voor het leven onontbeerlijke nucleïnezuren."
                            },
                            {
                                "example_id": "24cc1a90-1e88-4adf-b1b4-33f868a310f5",
                                "sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
                                "text": "Hij rook sterk naar zwavel, en als men het op een kledingstuk liet zitten, zou er een gat in branden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e6325cf-aca4-49e9-b27d-0ede16ca892c",
                        "source_entry_id": "b9ade9a7-af9c-397c-84a7-93f8071edeca",
                        "source_sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
                        "source_sense_description": "scheikundig element met symbool S en atoomnummer 16",
                        "target_lang_word": "Schwefel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwefel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38c03899-36ad-38e7-afc7-48608e2c47e8",
                                        "entry_id": "324790ef-571e-3dfb-9d8d-e8ba9288bc54",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 16, das zu den Nichtmetallen gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cccd74aa-579c-43f6-a79c-6fe71b494ab6",
                                                "sense_id": "38c03899-36ad-38e7-afc7-48608e2c47e8",
                                                "text": "Schwefel kommt in der Natur in Verbindungen und gediegen vor."
                                            },
                                            {
                                                "example_id": "7ecd03b4-2a05-4359-8d9c-1f763e86daaf",
                                                "sense_id": "38c03899-36ad-38e7-afc7-48608e2c47e8",
                                                "text": "„Besonders ein Detail verblüffte die Forscher: Manches Gestein im Bohrkern enthielt weniger als ein Prozent Schwefel, obwohl das Gestein ursprünglich zu 50 Prozent aus dem Stoff bestand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12b172f6-ccc2-48ca-a7d4-ce0f10d2ae43",
                        "source_entry_id": "b9ade9a7-af9c-397c-84a7-93f8071edeca",
                        "source_sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
                        "source_sense_description": "scheikundig element met symbool S en atoomnummer 16",
                        "target_lang_word": "Sulfur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sulfur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60c0ec2e-7f56-35e8-8008-9ba1dcfb66b0",
                                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 16, das zu den Nichtmetallen gehört; Schwefel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1863119-9f2b-434f-9de5-7115ee4c76ea",
                                                "sense_id": "60c0ec2e-7f56-35e8-8008-9ba1dcfb66b0",
                                                "text": "„Das Element Sulfur ist gewöhnlich aus Achtringen S8 aufgebaut und heißt dann systematisch Octasulfur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                                        "glosses": [
                                            "philosophisches Prinzip (neben Sal und Mercurius), das das Spezifische und Einzigartige eines Geschöpfes vermittelt"
                                        ],
                                        "tags": [
                                            "Naturheilkunde",
                                            "Spagyrik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ed8f233-4fc5-4e74-a7c0-663da13de37d",
                                                "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                                                "text": "Paracelsus ordnete die Prinzipien Sulfur und Mercurius und fügt ihnen als drittes Prinzip Sal hinzu. Diese Dreiheit bestimmt dann die Form der Alchemie, aus der sich schrittweise die neuzeitliche Chemie entwickeln sollte."
                                            },
                                            {
                                                "example_id": "eaf6b3b8-ed51-4526-8d00-f427b5855625",
                                                "sense_id": "61a4954c-d66c-3f48-b5d7-fdf11d707023",
                                                "text": "„Sal steht für das materialistische Prinzip, Sulfur für das beseelte (feinstoffliche) und Mercurius für das belebende Prinzip, das ständig zwischen Sal und Sulfur verbindet und vermittelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                                        "entry_id": "d18829f7-d4c4-35ce-8c67-bb852d974b8c",
                                        "glosses": [
                                            "auf dem Element Schwefel basierendes homöopathisches Mittel"
                                        ],
                                        "tags": [
                                            "Naturheilkunde",
                                            "Homöopathie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2183edbc-ca83-4212-825d-319c4f8afc1e",
                                                "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                                                "text": "„Sulfur ist eines der am häufigsten verordneten Mittel der klassischen Homöopathie. Es basiert auf dem Element Schwefel. Sulfur soll bei einem breiten Spektrum an akuten und chronischen Krankheiten helfen. Besonders bei Problemen der Haut, Atemwegserkrankungen und Verdauungsstörungen soll man mit Sulfur oft Behandlungserfolge erzielen.“"
                                            },
                                            {
                                                "example_id": "3a1f9aac-73ed-415b-95a8-e47f8301f30c",
                                                "sense_id": "c50e3b26-06c7-3a7b-b548-dea55cf7ff18",
                                                "text": "„Täglich 2mal 5 Globuli von Sulfur D12 im Mund zergehen lassen. Anmerkung: Sulfur gilt als das größte Lebermittelfunktionsmittel der Homöopathie und sollte immer wieder 2 Wochen lang als Zwischenmittel gegeben werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "085c08a7-2654-4b2f-a4cc-d562e9238794",
                        "source_entry_id": "b9ade9a7-af9c-397c-84a7-93f8071edeca",
                        "source_sense_id": "c848c8eb-b4b3-3b5f-8bff-fad90445eaf6",
