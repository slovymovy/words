                                "sense_id": "1e01a75e-7850-3b58-9271-e747c9d652f3",
                                "text": "Ik ben daar mordicus tegen!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07c026be-9d51-4b42-b022-6593394a79eb",
                        "source_entry_id": "42dde76f-fc9d-3a8c-a09d-3935c96a712b",
                        "source_sense_id": "1e01a75e-7850-3b58-9271-e747c9d652f3",
                        "source_sense_description": "fel",
                        "target_lang_word": "hartnäckig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartnäckig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                        "entry_id": "ad3f2e5c-3176-3747-9843-0fbed7955794",
                                        "glosses": [
                                            "auf etwas eigensinnig, beharrlich, unnachgiebig bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41b67976-a203-4f18-ab1d-7304757482cd",
                                                "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                                "text": "Unser Lehrer bleibt immer so hartnäckig bei seiner Meinung."
                                            },
                                            {
                                                "example_id": "f49135d4-fdac-4c64-85b8-251d300d5313",
                                                "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                                "text": "„Viele verfolgen hartnäckig den Weg, den sie gewählt haben, aber nur wenige das Ziel.“ (Friedrich Nietzsche)"
                                            },
                                            {
                                                "example_id": "ed265c46-14cd-4c60-a74a-845feac64c2c",
                                                "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                                "text": "„In manchen Kreisen hält sich hartnäckig das Gerücht, dies sei die moderne Variante der Inquisition.“"
                                            },
                                            {
                                                "example_id": "16a606f4-edda-4619-81a2-f5ffc3055315",
                                                "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                                "text": "„Die ganze Band stellt sich geschlossen hinter Billie, damit sie nicht unter Diskriminierungen zu leiden hat, und Artie Shaw wird des Öfteren deutlich, wenn er auf hartnäckige Anhänger der Rassentrennung trifft.“"
                                            },
                                            {
                                                "example_id": "3c18a6f6-6436-4b17-a465-db06cc5a0960",
                                                "sense_id": "5c1b521f-85a1-3602-bb60-0032fc2cc6f7",
                                                "text": "„Erschwert wurde dies durch eine hartnäckige Epidemie, die römische Soldaten nach ihrem Sieg über die Parther aus dem Osten eingeschleppt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
