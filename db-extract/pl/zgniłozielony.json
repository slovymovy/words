                "senses": [
                    {
                        "sense_id": "3bce0567-6700-3042-9fd6-019e65d09dca",
                        "entry_id": "78c69028-45eb-3686-9834-fe1f7ca98481",
                        "glosses": [
                            "zielony o brązowym odcieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1239f41e-cc01-447f-8b53-8539751cab5a",
                                "sense_id": "3bce0567-6700-3042-9fd6-019e65d09dca",
                                "text": "Ujrzałem nieruchomość w kształcie ludzkiego tułowia, przykrytego zgniłozielonym wojskowym kocem"
                            },
                            {
                                "example_id": "c9d7aebb-6454-4952-8fa1-306e747f387d",
                                "sense_id": "3bce0567-6700-3042-9fd6-019e65d09dca",
                                "text": "Kucharz w białym fartuchu osłaniającym zgniłozielony mundur i w rozłożystym pierogu na głowie rozdawał z wozu uśmiechy i gulasz, zamaszyście przecinając powietrze mosiężną, połyskliwą chochlą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
