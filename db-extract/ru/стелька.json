                        "source_entry_id": "b9ed76ed-3f80-3a90-8e60-d2322f642680",
                        "target_lang_word": "Einlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "affe1c6c-a089-39eb-8a21-629918056476",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "etwas, das in etwas eingebracht, eingelegt wird"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849c7839-df84-4b72-b1c5-495c1b22d829",
                                                "sense_id": "affe1c6c-a089-39eb-8a21-629918056476",
                                                "text": "Die Einlagen wurden bereits in der letzten Woche zugeschnitten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "624e2eb4-0a5d-3e0d-9ed8-5cd093f9d967",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "Beilage einer Postsendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1797f977-4b59-4cf2-ae60-9dfdc46492e9",
                                                "sense_id": "624e2eb4-0a5d-3e0d-9ed8-5cd093f9d967",
                                                "text": "Die Einlagen waren schon vorbereitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "077894cc-3892-36fd-a2e7-640f9f0984b4",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "zur Versteifung in die Kleidung eingefügtes Material"
                                        ],
                                        "tags": [
                                            "Schneiderei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe4aea5-f78d-4dc4-86f3-ea0d8063f7e6",
                                                "sense_id": "077894cc-3892-36fd-a2e7-640f9f0984b4",
                                                "text": "„An den Außenkanten heften, dann die Einlage mit einigen überwendlichen Stichen über und unter den Taillennähten fixieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0abac490-a569-3a22-99db-20b48849f619",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "eingearbeitete Verzierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8057f359-8486-483e-950c-ae969b83683b",
                                                "sense_id": "0abac490-a569-3a22-99db-20b48849f619",
                                                "text": "„Die Einlage ist eine sehr schmale Intarsie und besteht in der Regel aus einem dünnen weißen Kern, der zwischen zwei noch dünneren schwarz gebeizten Birnholzstreifen liegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "6d566882-95e7-3713-a2b3-fb244798a805",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "feste Zutat in einer Suppe"
                                        ],
                                        "tags": [
                                            "Kochkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03c448e1-db9e-4820-b080-48bee3686ea7",
                                                "sense_id": "6d566882-95e7-3713-a2b3-fb244798a805",
                                                "text": "Die Einlage besteht aus Buchstabennudeln."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "1ba625bb-eca4-3a64-a7f1-52a62f9730ae",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "Sohle, die zur Stützung des Fußes in den Schuh eingelegt wird"
                                        ],
                                        "tags": [
                                            "Orthopädie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f47d009-679d-4569-865c-08a831d7420b",
                                                "sense_id": "1ba625bb-eca4-3a64-a7f1-52a62f9730ae",
                                                "text": "Diese Einlagen müssen ausgewechselt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "839b5dc8-5303-3cf0-b7a1-3cc980eaa606",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "provisorische Füllung eines Zahns"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61963cbe-64a0-49d7-ab84-744d65f1df69",
                                                "sense_id": "839b5dc8-5303-3cf0-b7a1-3cc980eaa606",
                                                "text": "„Es waren vor allen Dingen Zähne, die nach der Trepanation und Aufbereitung nicht sofort zur Ruhe kamen, sondern jedesmal, wenn man eine Einlage gelegt hatte und der Zahn provisorisch verschlossen war, wieder anfingen, Beschwerden zu bereiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "8b29fca1-f4a0-309b-8599-fdda5e5934df",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "Zwischenteil, eingeschobene Zugabe eines Unterhaltungprogramms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b58ae81-0429-4c81-84df-642f282c8fa6",
                                                "sense_id": "8b29fca1-f4a0-309b-8599-fdda5e5934df",
                                                "text": "Und als kleine Einlage haben wir heute Abend den Komiker Olle gebeten, die Preisvergabe zu kommentieren."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "01a2bc59-5b9b-3da1-85c9-e8dc8fcd2219",
                                        "entry_id": "a0b0cbca-ee57-3d4f-ac29-59ff29dfc83b",
                                        "glosses": [
                                            "in ein Unternehmen oder eine Anlageform eingebrachter Geldbestand"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b7524b9-44ef-459f-a367-4c894fcdbdc3",
                                                "sense_id": "01a2bc59-5b9b-3da1-85c9-e8dc8fcd2219",
                                                "text": "Der stille Teilhaber hatte eine Einlage von 100.000 € geleistet."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
                            }
                        ]
