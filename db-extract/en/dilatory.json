                                "example_id": "995141f2-6348-4d8c-bbde-bbcbb20e02aa",
                                "sense_id": "5f16201e-373e-333c-be02-9db4a55cc84d",
                                "text": "a dilatory strategy"
                            },
                            {
                                "example_id": "72e32c96-ce80-4596-b485-4f03a295618d",
                                "sense_id": "5f16201e-373e-333c-be02-9db4a55cc84d",
                                "text": "Alva, as usual, brought his dilatory policy to bear upon his adversary with great effect."
                            }
