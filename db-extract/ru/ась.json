                                "sense_id": "66271715-8bd2-3c67-b8af-627327b859e0",
                                "text": "Ты спал, ась?",
                                "translation": "You were asleep, huh?",
                                "english": "You were asleep, huh?"
                            },
                            {
                                "example_id": "93d294a2-16d9-4b41-9bed-c016a9202534",
                                "sense_id": "66271715-8bd2-3c67-b8af-627327b859e0",
                                "text": "— Дя́-дя! — Ась?",
                                "translation": "— Uncle! — Huh?",
                                "english": "— Uncle! — Huh?"
                            }
                        ]
                    }
                ],
