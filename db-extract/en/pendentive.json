                "senses": [
                    {
                        "sense_id": "d2fe0b25-294e-3aed-957a-06bb546e1470",
                        "entry_id": "d053b3d3-239e-3ffe-a87b-33b6c68a4285",
                        "glosses": [
                            "The concave triangular sections of vaulting that provide the transition between a dome and the square base on which it is set and transfer the weight of the dome."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c04dc23-d84b-4db6-a026-d224e5afc2eb",
                        "source_entry_id": "d053b3d3-239e-3ffe-a87b-33b6c68a4285",
                        "source_sense_id": "d2fe0b25-294e-3aed-957a-06bb546e1470",
                        "source_sense_description": "triangular section of vaulting",
                        "target_lang_word": "pendentif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pendentif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77a892f5-3777-397d-8117-fcfe227c0dff",
                                        "entry_id": "ee1e80e7-4d7d-3a39-8d84-21e792219d60",
                                        "glosses": [
                                            "Portion triangulaire d’une voûte sphérique, placée entre les grands arcs qui supportent une coupole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e11ee5-71c8-48b4-9aaf-b76a1e7ec5cd",
                                                "sense_id": "77a892f5-3777-397d-8117-fcfe227c0dff",
                                                "text": "Les lambris en bois qui forment les faux pendentifs, rongés par le temps, troués par les vers, ayant perdu toute trace de peinture, déchiquetés de vieillesse, tombent par lambeaux comme des linges déchirés."
                                            },
                                            {
                                                "example_id": "75cce9ac-5da7-417e-9974-faed3d531163",
                                                "sense_id": "77a892f5-3777-397d-8117-fcfe227c0dff",
                                                "text": "En levant la tête, on aperçoit une espèce de dôme formé par l’intérieur de la tour dont nous avons déjà parlé ; c’est un gouffre de sculptures, d’arabesques, de statues, de colonnettes, de nervures, de lancettes, de pendentifs à vous donner le vertige."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5db37bb3-1e02-39f5-a9dd-474159af81b7",
                                        "entry_id": "ee1e80e7-4d7d-3a39-8d84-21e792219d60",
                                        "glosses": [
                                            "Bijou qui pend à une chaînette, à un collier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9534386-e7fe-43a6-b3db-be8f38eb6788",
                                                "sense_id": "5db37bb3-1e02-39f5-a9dd-474159af81b7",
                                                "text": "Pendant un long moment, Nazira regarda distraitement les bijoux que lui désignait sa mère. Ces breloques, ces bracelets, ces pendentifs, la laissait froide."
                                            },
                                            {
                                                "example_id": "349c5df2-e2eb-4760-9eba-6e591f004558",
                                                "sense_id": "5db37bb3-1e02-39f5-a9dd-474159af81b7",
                                                "text": "Tout porte à croire qu’un morceau décoré d’ivoire de mammouth daté d’il y a 41500 ans serait un pendentif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6221c1e-6c80-3c32-a99b-02f48bf78a40",
                                        "entry_id": "ee1e80e7-4d7d-3a39-8d84-21e792219d60",
                                        "glosses": [
                                            "Pendant d’oreille."
                                        ],
                                        "tags": [
                                            "Plus rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
