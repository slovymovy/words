                        "entry_id": "3173bf74-084c-394f-bf2f-9e29d56bc5cf",
                        "glosses": [
                            "ранний возраст человека, следующий перед юностью"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4c864e0b-4d3b-3f4b-b6c6-c384e085cc06",
                        "entry_id": "3173bf74-084c-394f-bf2f-9e29d56bc5cf",
                        "glosses": [
                            "период жизни от рождения до юности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe94108-7a52-4db2-8ef6-9c912d516720",
                                "sense_id": "4c864e0b-4d3b-3f4b-b6c6-c384e085cc06",
                                "text": "Не столько разнились между собой оживлённая и полная, в веснушках, с золотистыми локонами и голубыми глазами Ксения и задумчивая, черноволосая и сухощавая Аврора, сколько были несхожи видом и нравом близкие друг другу с детства Илья Тропинин и Базиль Перовский…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd82c70-df18-4d87-b8cb-bff81efbbd81",
                        "source_entry_id": "3173bf74-084c-394f-bf2f-9e29d56bc5cf",
                        "target_lang_word": "childhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "childhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494bbde0-0488-3ddf-9672-55207df48468",
                                        "entry_id": "fbcc2230-fd28-3ab2-b25b-bcee47f22fdc",
                                        "glosses": [
                                            "The state of being a child."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa030e55-1d92-4d26-980f-ad04ae868c0e",
                                                "sense_id": "494bbde0-0488-3ddf-9672-55207df48468",
                                                "text": "To our own surprise, our 40-year study of 1,000 children revealed that childhood self-control strongly predicts adult success, in people of high or low intelligence, in rich or poor, and does so throughout the entire population, with a step change in health, wealth, and social success at every level of self-control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8fb28b6-e25f-3779-b275-81fc678e1df7",
                                        "entry_id": "fbcc2230-fd28-3ab2-b25b-bcee47f22fdc",
                                        "glosses": [
                                            "The time during which one is a child, from between infancy and puberty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99363328-4c79-4af7-a048-74c2b373fcda",
                                                "sense_id": "c8fb28b6-e25f-3779-b275-81fc678e1df7",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c845bba-5bbc-3314-9436-cded28592008",
                                        "entry_id": "fbcc2230-fd28-3ab2-b25b-bcee47f22fdc",
                                        "glosses": [
                                            "The early stages of development of something."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a061ae03-ca03-4b4c-93e7-37d98b76d747",
                                                "sense_id": "5c845bba-5bbc-3314-9436-cded28592008",
                                                "text": "the childhood of our joy"
                                            }
                                        ]
                                    }
                                ]
