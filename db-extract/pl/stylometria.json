                                    },
                                    {
                                        "sense_id": "ef7b7c6c-e034-34c9-a0d6-aaf61541bbb0",
                                        "entry_id": "a316e584-163a-31cb-b0ce-3668052a68f9",
                                        "glosses": [
                                            "Étude statistique du style d’un ou de plusieurs textes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe1cbdf3-4032-41e6-b904-57d18457409a",
                                                "sense_id": "ef7b7c6c-e034-34c9-a0d6-aaf61541bbb0",
                                                "text": "Les deux chartistes Florian Cafiero et Jean-Baptiste Camps, qui ont recours à la stylométrie pour l’authentification de textes littéraires, estiment que l’usage de cette méthode n’est ni révolutionnaire ni infaillible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14e5d76-ab5e-43de-9a0f-56fef62e7823",
                        "source_entry_id": "a91f4f92-2925-3d47-be56-e90dce7f4a24",
