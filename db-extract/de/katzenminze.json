                ],
                "translations": [
                    {
                        "translation_id": "5f196f20-d3fa-4005-bec6-727714a8f468",
                        "source_entry_id": "fd7fb6b9-6903-311d-9d6f-85a638689619",
                        "source_sense_id": "e7f3b588-f30a-3db1-b443-332979a18ca9",
                        "source_sense_description": "Botanik: Pflanze der Gattung Nepeta aus der Familie der Lippenblütler",
                        "target_lang_word": "catnip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catnip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4f13548-7feb-3293-9049-3aebfc32fb6f",
                                        "entry_id": "c35071f0-5a01-31d0-a3a8-fd3fdb433792",
                                        "glosses": [
                                            "Any of the about 250 species of flowering plant of the genus Nepeta, family Lamiaceae, certain of which are said to have medicinal qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c072d0b-7e30-3bf3-ade5-4b08677ea9c3",
                                        "entry_id": "c35071f0-5a01-31d0-a3a8-fd3fdb433792",
                                        "glosses": [
                                            "Nepeta cataria and Nepeta grandiflora (and perhaps other species), which are well-known for causing an apparently harmless pheromone-based intoxication among certain cats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cde9a5-976a-4272-b485-4b8e9b78a51b",
                                                "sense_id": "3c072d0b-7e30-3bf3-ade5-4b08677ea9c3",
                                                "text": "Some cats go bonkers over catnip; others ignore it."
                                            },
                                            {
                                                "example_id": "b88776a3-a99d-4109-a947-7d7be91ffa24",
                                                "sense_id": "3c072d0b-7e30-3bf3-ade5-4b08677ea9c3",
                                                "text": "But exactly how catnip—and a substitute, known as silver vine—produce this feline high has long been a mystery. Now, a study suggests the key intoxicating chemicals in the plants activate cats’ opioid systems much like heroin and morphine do in people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                        "entry_id": "c35071f0-5a01-31d0-a3a8-fd3fdb433792",
                                        "glosses": [
                                            "Something that causes excitement or interest."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898217bd-354b-4e1f-83fa-9ac3ff19e070",
                                                "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                                "text": "The language’s^([OCaml's]) rigor is like catnip to some people, though, giving Jane Street an unusual advantage in the tight hiring market for programmers."
                                            },
                                            {
                                                "example_id": "43519c5e-649c-44f0-9dfc-ad309a413e69",
                                                "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                                "text": "Since Rupert Murdoch famously bet the farm on Premier League football to rescue Sky TV in 1991, it has been the catnip that has underpinned subscriber loyalty and, even in a far more complicated media landscape, is seen as so vital as to be worth almost any price."
                                            },
                                            {
                                                "example_id": "96f8304d-3616-4c3f-b37f-7a65e6fa7077",
                                                "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                                "text": "Unlike IPOs, however, ICOs are catnip for scammers."
                                            },
                                            {
                                                "example_id": "912bc0da-5940-4ffa-83da-dede1d4dee84",
                                                "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                                "text": "This hot new Shoreditch trattoria already is catnip for the style set."
                                            },
                                            {
                                                "example_id": "e57c2bcf-5b08-4572-b2ce-802c210fa9dc",
                                                "sense_id": "adb53249-ce26-3076-870a-ac173c360eb6",
                                                "text": "While some might see xAI’s new anime avatars as a harmless experiment, they’re emotional catnip for vulnerable users."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52074ea2-8e85-4be8-bcfb-28572916cf4e",
                        "source_entry_id": "fd7fb6b9-6903-311d-9d6f-85a638689619",
