                    {
                        "translation_id": "4259462a-94a6-4ca1-ac98-802dc318ed4c",
                        "source_entry_id": "5a7fa93a-183b-332c-8042-3ddf57ca71ad",
                        "source_sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                        "source_sense_description": "field of study concerning the comprehension and production of language",
                        "target_lang_word": "psycholinguistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psycholinguistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07b7bc17-a427-3ec6-8c9b-419499b45c33",
                                        "entry_id": "5a9dadd4-0db8-3235-abaa-69d96ca53ae8",
                                        "glosses": [
                                            "Étude des processus cognitifs mis en œuvre dans le traitement et la production du langage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47af6c38-7853-4f10-8820-97532ccf6cef",
                                                "sense_id": "07b7bc17-a427-3ec6-8c9b-419499b45c33",
                                                "text": "La psycholinguistique de la lecture embrasse l’ensemble de ces traitements cognitifs du mot. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 105)"
                                            },
                                            {
                                                "example_id": "6b5812a0-20dd-43a5-bbe3-a35526dd9d6e",
                                                "sense_id": "07b7bc17-a427-3ec6-8c9b-419499b45c33",
                                                "text": "Une autre étude en psycholinguistique présentée au congrès annuel de l’Association canadienne de linguistique en 2022, comportait un test de lecture portant sur les formes inclusives effectuées à l’aide de l’oculométrie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c6ab3d4-15df-4e41-a986-c2fe5ed456ff",
                        "source_entry_id": "5a7fa93a-183b-332c-8042-3ddf57ca71ad",
                        "source_sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                        "source_sense_description": "field of study concerning the comprehension and production of language",
                        "target_lang_word": "Psycholinguistik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psycholinguistik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7da2ff00-883b-3ae5-94b5-cdfe07cb813d",
                                        "entry_id": "7e15a8c7-7cc7-386d-9c0f-23c2abf0e00f",
                                        "glosses": [
                                            "fächerübergreifendes Forschungsgebiet, in dem Linguisten, Psychologen, Mediziner etc. die Sprachverarbeitung durch Sprecher (Schreiber) und Hörer (Leser) ebenso wie auch den Spracherwerb (Erstspracherwerb/Zweitspracherwerb) erforschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc7d40c-74bd-475e-8028-22db51420d60",
                                                "sense_id": "7da2ff00-883b-3ae5-94b5-cdfe07cb813d",
                                                "text": "Die Erforschung der Prozesse, die im Spracherwerb oder bei der Sprachproduktion und -rezeption ablaufen, ist Gegenstand der Psycholinguistik."
                                            },
                                            {
                                                "example_id": "7879d36c-9ab2-4376-8525-016850c5b018",
                                                "sense_id": "7da2ff00-883b-3ae5-94b5-cdfe07cb813d",
                                                "text": "„So ist abzusehen, daß die Psycholinguistik dann wieder ihr Interesse an der diachronen Semantik entdecken wird, wenn die linguistische Semantik ihr Beschreibungen liefert, die operationalisierbar, das heißt in experimentelle Fragestellungen umdeutbar sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b8b6cbc-81b3-4ac0-bc49-4fadfa9346f7",
                        "source_entry_id": "5a7fa93a-183b-332c-8042-3ddf57ca71ad",
                        "source_sense_id": "d1e22071-37a4-3d94-927c-ea2883c2206b",
                        "source_sense_description": "field of study concerning the comprehension and production of language",
                        "target_lang_word": "Sprachpsychologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachpsychologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                        "entry_id": "86742724-1398-34e8-935c-23a25dfd55fb",
                                        "glosses": [
                                            "Fächerübergreifendes Forschungsgebiet, in dem Linguisten, Psychologen, Mediziner etc. die Sprachverarbeitung durch Sprecher (Schreiber) und Hörer (Leser) ebenso wie auch den Spracherwerb (Erstspracherwerb/Zweitspracherwerb) erforschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd01fab7-e6e4-41e7-95b4-49a1d458787c",
                                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                                "text": "„Die Sprachpsychologie oder Psycholinguistik zielt auf eine wissenschaftliche Beschreibung nicht der Sprache, sondern des Prozesses der Sprachbenutzung.“"
                                            },
                                            {
                                                "example_id": "e9192e34-b01c-4236-893b-af18293c841e",
                                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                                "text": "„In allererster Annäherung formuliert, geht es der Sprachpsychologie bekanntlich um denjenigen Ausschnitt des menschlichen Handelns, den man Sprechen, Schreiben und so fort nennt.“"
                                            },
                                            {
                                                "example_id": "ee5f9cac-b239-4cac-b45d-04fe37e3a0be",
                                                "sense_id": "33b3625d-fc7a-3c1b-a5cd-4d40cb7b9c84",
                                                "text": "Hauptgegenstände der Sprachpsychologie sind Spracherwerb, Sprachproduktion und Sprachrezeption."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
