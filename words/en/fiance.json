{
    "word_family": [
        "fiancee"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "987b9741-94ed-3e95-b605-d1302e991d25",
                    "sense_definition": "Alternative spelling of <w>fiancé</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She introduced her <w>fiance</w> to her parents during dinner last night.",
                            "target_lang_translations": {
                                "tr": "Dün gece akşam yemeğinde <w>nişanlısını</w> ailesiyle tanıştırdı.",
                                "zh": "昨晚晚餐时，她把<w>未婚夫</w>介绍给了她的父母。"
                            }
                        },
                        {
                            "text": "They decided to go shopping with her <w>fiance</w> for their upcoming wedding.",
                            "target_lang_translations": {
                                "tr": "Yaklaşan düğünleri için <w>nişanlısıyla</w> birlikte alışverişe çıkmaya karar verdiler.",
                                "zh": "他们决定和她的<w>未婚夫</w>一起为即将到来的婚礼去购物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fiancé",
                        "betrothed"
                    ],
                    "common_phrases": [
                        "her fiance",
                        "my fiance"
                    ],
                    "target_lang_definitions": {
                        "tr": "<w>Fiancé</w> kelimesinin alternatif yazımı (erkek nişanlı).",
                        "zh": "指已经订婚的男子。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nişanlı",
                                "target_lang_sense_clarification": "erkek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未婚夫",
                                "target_lang_sense_clarification": "指已经订婚的男性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9bc829c-7d04-36a5-a7da-313045d0d3bc",
                    "sense_definition": "To engage or betroth someone in marriage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>fianced</w> to a lady of high noble standing.",
                            "target_lang_translations": {
                                "tr": "Yüksek soylu bir hanımla <w>nişanlanmıştı</w>.",
                                "zh": "他与一位出身高贵的女士<w>订婚</w>了。"
                            }
                        },
                        {
                            "text": "The king had <w>fianced</w> his daughter to the neighboring prince to secure peace.",
                            "target_lang_translations": {
                                "tr": "Kral, barışı sağlamak için kızını komşu prensle <w>nişanlamıştı</w>.",
                                "zh": "为了确保和平，国王将他的女儿与邻国的王子<w>订婚</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "betroth",
                        "affiance",
                        "engage"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used mainly in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini evlilik amacıyla nişanlamak.",
                        "zh": "指与某人订婚，多用于正式或书面语境。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "nişanlamak",
                                "target_lang_sense_clarification": "evliliğe sözlemek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "订婚",
                                "target_lang_sense_clarification": "指双方约定结婚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}