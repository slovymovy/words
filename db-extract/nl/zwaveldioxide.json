                                "target_senses": [
                                    {
                                        "sense_id": "ab930504-7732-34b7-be36-8add948c6348",
                                        "entry_id": "26471d67-d944-3a6c-b982-893917a08f69",
                                        "glosses": [
                                            "farbloses, schleimhautreizendes, stechend riechendes und sauer schmeckendes, giftiges Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa536cd3-0d6a-4ee9-b366-8e9cc445c918",
                                                "sense_id": "ab930504-7732-34b7-be36-8add948c6348",
                                                "text": "„Technisch wird Schwefeldioxid in großen Mengen durch Verbrennen von Schwefel bzw. Schwefelwasserstoff sowie durch Erhitzen schwefelhaltiger Erze wie z. B. Kupfer-, Zink-, Bleisulfid CuS, ZnS, PbS oder Pyrit FeS₂ im Luft- oder Sauerstoffstrom dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5df88706-f7f3-45bb-bdb9-75fb6396f100",
                        "source_entry_id": "92db94e7-1731-3780-8b02-3d6ec5feed2d",
                        "source_sense_id": "87a475ab-f0eb-36dc-ab17-a261b4a3bb34",
                        "target_lang_word": "sulfur dioxide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sulfur dioxide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e97ad2-1388-3ae4-b0fb-9f44975343ab",
                                        "entry_id": "d569a4af-8388-305d-a8ab-229d5980b0bc",
                                        "glosses": [
                                            "A toxic gas, of molecular formula SO₂ that is found in the emissions of volcanos and those of burning coal or petroleum; dissolves in water to form sulfurous acid and, in the presence of oxygen, sulfuric acid, and is thus responsible for acid rain."
                                        ],
                                        "tags": [
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0710d985-6fd8-40e3-a158-13bcffb679aa",
                        "source_entry_id": "92db94e7-1731-3780-8b02-3d6ec5feed2d",
                        "source_sense_id": "87a475ab-f0eb-36dc-ab17-a261b4a3bb34",
                        "target_lang_word": "dioxyde de soufre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dioxyde de soufre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee28deda-00aa-38ee-a490-e405170f55a0",
                                        "entry_id": "6528129a-c886-35b4-99f7-3680444ac1f8",
                                        "glosses": [
                                            "Composé chimique gazeux à l’odeur piquante produit par la combustion du soufre dans le dioxygène de l’air, de formule chimique SO₂, qui réagit spontanément avec l’eau de l’air ambiant pour former de l’acide sulfureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a24a6def-284c-458a-9203-5dd97fa1906b",
                                                "sense_id": "ee28deda-00aa-38ee-a490-e405170f55a0",
                                                "text": "Les chercheurs ont récemment découvert la présence de dioxyde de soufre gazeux (anhydride sulfureux) à haute altitude grâce à la sonde Venus Express de l'Agence spatiale européenne (ESA)."
                                            },
                                            {
                                                "example_id": "576949a4-8695-4abe-9660-796422ce6327",
                                                "sense_id": "ee28deda-00aa-38ee-a490-e405170f55a0",
                                                "text": "Cette découverte pourrait aider les astrophysiciens à mieux comprendre le reste du système jovien, car la moitié du dioxyde de soufre craché par les volcans d’Io finit par dériver autour de la planète."
                                            },
                                            {
                                                "example_id": "201319ab-c2be-4b8f-8d1e-841338342c78",
                                                "sense_id": "ee28deda-00aa-38ee-a490-e405170f55a0",
                                                "text": "Le dioxyde de soufre a dû pénétrer dans la stratosphère et déclencher des réactions chimiques particulières qui ont vu la création de particules d’acide sulfurique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
