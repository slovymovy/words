                                "example_id": "2af04b37-e7a8-460c-acef-5a08bb47b8e2",
                                "sense_id": "dec12da5-eb8d-3d81-aa1e-b2b09a672a21",
                                "text": "„Auch virtuelle Konzerte der Stargeigerin Lindsey Stirling, in denen sich Menschen als ‚Avatare‘ zuschalten können, haben bereits hunderttausende Zuschauer angezogen.“"
                            },
                            {
                                "example_id": "d46c0522-a5a3-429e-9c25-f334bf267f3a",
                                "sense_id": "dec12da5-eb8d-3d81-aa1e-b2b09a672a21",
                                "text": "„Als besondere Attraktion kommt die Stargeigerin Anne-Sophie Mutter mit, die jedoch nicht in allen Belangen überzeugt.“"
                            },
                            {
                                "example_id": "b669420b-03ab-4b7a-9e74-07ae7a7b54de",
                                "sense_id": "dec12da5-eb8d-3d81-aa1e-b2b09a672a21",
                                "text": "„Piste statt Bühne, Skier statt Violine: Stargeigerin Vanessa Mae will bei den Olympischen Spielen im Slalom antreten.“"
                            }
