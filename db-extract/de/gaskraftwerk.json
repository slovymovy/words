                ],
                "senses": [
                    {
                        "sense_id": "7540e13c-2a2f-3417-96c2-92fdcb5d72cc",
                        "entry_id": "e8e61e9f-fe3d-3b40-9fd4-616ab1216f72",
                        "glosses": [
                            "Kraftwerk, das brennbares Gas zur Stromerzeugung nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04a4bec2-dadb-46c5-b034-ac04a15ef17e",
                                "sense_id": "7540e13c-2a2f-3417-96c2-92fdcb5d72cc",
                                "text": "Auch Gaskraftwerke emittieren Kohlendioxid."
                            },
                            {
                                "example_id": "26805dde-40d9-440d-9384-935bff77a0e4",
                                "sense_id": "7540e13c-2a2f-3417-96c2-92fdcb5d72cc",
                                "text": "„Der Erdöl- und Gaskonzern OMV denkt im Zuge seiner Strategieüberprüfung auch über einen Verkauf seines unrentablen türkischen Gaskraftwerks nach.“"
                            },
                            {
                                "example_id": "ddc6ced1-9fe4-40c5-953b-c77d78481857",
                                "sense_id": "7540e13c-2a2f-3417-96c2-92fdcb5d72cc",
                                "text": "„Der Stromversorger Uniper wird in Bayern ein neues Gaskraftwerk bauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
