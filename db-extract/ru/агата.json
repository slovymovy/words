                                "target_senses": [
                                    {
                                        "sense_id": "b7bc72d2-67d4-3e56-bf2e-27c0bd43be65",
                                        "entry_id": "35e62c6b-58fe-3bf2-abb0-633e7509eb7a",
                                        "glosses": [
