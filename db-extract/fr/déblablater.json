                "senses": [
                    {
                        "sense_id": "64de5b74-6a38-334a-baea-8912b50f6783",
                        "entry_id": "c98c39e6-8087-3996-9ebc-abf9d6e09989",
                        "glosses": [
                            "Faire perdre son caractère de blabla à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26265ea7-cdff-4b4f-9fce-9abb1f8dd50c",
                                "sense_id": "64de5b74-6a38-334a-baea-8912b50f6783",
                                "text": "Le principal défaut provenait de ce fait que les « papiers » écrits à l’avance, généralement trop longs, ne répondaient pas à cette nécessité de « déblablater » les interventions."
                            }
                        ]
                    },
                    {
                        "sense_id": "7253fcc4-52dc-35c8-b8b8-ba824df13f8f",
                        "entry_id": "c98c39e6-8087-3996-9ebc-abf9d6e09989",
                        "glosses": [
                            "Dire en blablatant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5634358b-344e-45ee-b803-d5e3656d0435",
                                "sense_id": "7253fcc4-52dc-35c8-b8b8-ba824df13f8f",
                                "text": "Dessus, tu auras beau déblablater les pires insultes, tu ne sauras pas effacer cette conclusion émise par des évolutionnistes eux-mêmes."
                            },
                            {
                                "example_id": "7af0d6ab-95d8-4f5e-b820-b19934b0e373",
                                "sense_id": "7253fcc4-52dc-35c8-b8b8-ba824df13f8f",
                                "text": "Je laisse le rouquin déblablater dans le vide quand un corps féminin se glisse dans mon champ de vision."
                            }
                        ]
                    }
                ],
