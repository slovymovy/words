                                "example_id": "07a275ee-13f6-44fd-8906-588ab0c35084",
                                "sense_id": "6dcfa8c6-65ea-3896-8900-5ee9b86274c2",
                                "text": "Gisteren kwamen vier Italiaanse bergbeklimmers om het leven in het noorden van Italië. Zij waren in een rotsspleet gevallen."
                            }
                        ]
