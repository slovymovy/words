        "de-extract.jsonl": [
            {
                "entry_id": "a2d05126-0d45-32e6-a9cd-5bd757f26a33",
                "word": "foe",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d798d754-3f62-3e7f-82f1-19f4cfe239f5",
                        "entry_id": "a2d05126-0d45-32e6-a9cd-5bd757f26a33",
                        "glosses": [
                            "der Feind, der Gegner"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd4e2a6-631b-4715-ad2c-4877a045080c",
                                "sense_id": "d798d754-3f62-3e7f-82f1-19f4cfe239f5",
                                "text": "\"An enemy or foe is a relativist term for an entity, whether an individual or a group, that is seen as forcefully adverse or threatening.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d63af05-5a63-4f10-ba5f-91e18191b8b6",
                        "source_entry_id": "a2d05126-0d45-32e6-a9cd-5bd757f26a33",
                        "source_sense_id": "d798d754-3f62-3e7f-82f1-19f4cfe239f5",
                        "source_sense_description": "der Feind, der Gegner",
                        "target_lang_word": "Feind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                        "entry_id": "a07b0e31-40ae-3a27-a035-59a809634dd1",
                                        "glosses": [
                                            "Person oder Gruppe mit besonders negativer Beziehung zu einer anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "accb7548-bb3d-40d9-bb82-f8eb12214789",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "Er ist mein schlimmster Feind."
                                            },
                                            {
                                                "example_id": "561a81cc-847b-4deb-9c3f-03d4396ca011",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "Der Feind greift an!"
                                            },
                                            {
                                                "example_id": "aac8f2ac-96bf-4057-abfe-112f6b0d75c3",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "„Die Waräger machen zahlreiche Feinde nieder, schlagen die übrigen in die Flucht und nehmen einen Kommandeur gefangen.“"
                                            },
                                            {
                                                "example_id": "72eec332-12fa-447f-b0af-9b0da7027d9a",
                                                "sense_id": "48ec8ae4-2031-3678-9c11-2ac191b1ab38",
                                                "text": "„Alle Schiffe des Feindes hatten kriegstaugliche Schanzkleider und waren robust gebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b3f43d1-a9aa-462f-876f-67bf84cbe4ef",
                        "source_entry_id": "a2d05126-0d45-32e6-a9cd-5bd757f26a33",
                        "source_sense_id": "d798d754-3f62-3e7f-82f1-19f4cfe239f5",
                        "source_sense_description": "der Feind, der Gegner",
                        "target_lang_word": "Gegner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                        "entry_id": "52366874-c34c-3fda-a884-d52c30d728ca",
                                        "glosses": [
                                            "Person oder Institution/Organisation, die gegenteilige Interessen verfolgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb35f0aa-e4e5-4431-9918-8ca4c93090e6",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "Der Gegner von Hannover 96 war diesmal der 1. FC Köln."
                                            },
                                            {
                                                "example_id": "098461f2-d727-4a52-88a3-0c743e197ce9",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Entgegen den Beteuerungen der romfreundlichen Autoren, die den 2. Römisch-Karthagischen Krieg als ein Ringen zwischen zwei gleich starken Gegnern darstellen, war die Disproportion zwischen den Beteiligten groß.“"
                                            },
                                            {
                                                "example_id": "3ce54634-dab5-4456-a339-9d263b8523ac",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Es ist für viele wahlentscheidend, auf welchen Gegner sich die präferierte Partei einlassen würde.“"
                                            },
                                            {
                                                "example_id": "2d92df93-efc7-46ed-8492-73c6f414ade7",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Seine Idee hatte viele Gegner, vor allem unter den Kongressabgeordneten aus dem landwirtschaftlich geprägten Süden.“"
                                            },
                                            {
                                                "example_id": "5f5ba438-bbd4-45f2-a6bd-3b65e08cf604",
                                                "sense_id": "baf45f65-82e0-3c50-b11c-2e5064049632",
                                                "text": "„Wenn der Analytiker sich seiner gewöhnlichen Hilfsquellen beraubt sieht, denkt er sich in den Geist seines Gegners hinein, identifiziert sich mit ihm, und dann gelingt es ihm nicht selten, auf den ersten Blick eine oft verblüffend einfache Methode zu finden, durch die er den andern irreführen oder zu einem unbesonnenen Zug veranlassen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
