                "senses": [
                    {
                        "sense_id": "9461bf74-8dbb-317f-838d-c13d032b11ea",
                        "entry_id": "5c3c413d-2037-3acb-bca5-607dd3da679e",
                        "glosses": [
                            "Rendre trilingue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0140650-6d94-4f69-9566-029e54321bf2",
                                "sense_id": "9461bf74-8dbb-317f-838d-c13d032b11ea",
                                "text": "Trilinguiser la France avec les deux langues commerciales stratégiques (anglais-chinois)."
                            },
                            {
                                "example_id": "111719f7-d0c4-4734-bac8-c36d81ecc270",
                                "sense_id": "9461bf74-8dbb-317f-838d-c13d032b11ea",
                                "text": "Tout au plus, on pourra bilinguiser ou trilinguiser davantage la population, déjà aux prises avec l'anglais et le créole."
                            },
                            {
                                "example_id": "283dca65-511a-4854-99d2-fab01b3d76cd",
                                "sense_id": "9461bf74-8dbb-317f-838d-c13d032b11ea",
                                "text": "A partir de ce point, un des objectifs que l’UE veut atteindre concernant le multilinguisme est de, au moins, «trilinguiser» ses citoyens."
                            }
                        ]
                    }
