    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc69e44a-2516-3cc7-b2b4-d6ecd7a7d248",
                    "sense_definition": "To anticipate something with great fear or anxiety.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fearful anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>dreading</w> the results of the medical test because it could change my life.",
                            "target_lang_translations": {
                                "ru": "Я <w>с ужасом жду</w> результатов медицинского теста, потому что они могут изменить мою жизнь.",
                                "de": "Ich <w>fürchte</w> mich vor den Ergebnissen des medizinischen Tests, weil sie mein Leben verändern könnten.",
                                "zh": "我非常<w>畏惧</w>体检结果，因为那可能会改变我的一生。"
                            }
                        },
                        {
                            "text": "Many students <w>dread</w> the thought of public speaking in front of a large audience.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>страшатся</w> мысли о публичном выступлении перед большой аудиторией.",
                                "de": "Viele Studenten <w>fürchten</w> sich vor dem Gedanken, vor einem großen Publikum zu sprechen.",
                                "zh": "许多学生一想到要在广大听众面前演讲就感到<w>害怕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fear",
                        "worry about"
                    ],
                    "antonyms": [
                        "anticipate",
                        "welcome"
                    ],
                    "common_phrases": [
                        "dread the thought",
                        "dread to think"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидать чего-либо с большим страхом или тревогой.",
                        "de": "Etwas mit großer Angst oder Sorge erwarten.",
                        "zh": "预感到某事会发生而感到极度恐惧或焦虑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "страшиться",
                                "target_lang_sense_clarification": "ожидать с сильным страхом"
                            },
                            {
                                "target_lang_word": "с ужасом ждать",
                                "target_lang_sense_clarification": "ожидать с содроганием"
                            },
                            {
                                "target_lang_word": "опасаться",
                                "target_lang_sense_clarification": "испытывать тревогу перед событием"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fürchten",
                                "target_lang_sense_clarification": "etwas Unangenehmes erwarten"
                            },
                            {
                                "target_lang_word": "befürchten",
                                "target_lang_sense_clarification": "der Ansicht sein, dass etwas Unangenehmes eintreten könnte"
                            },
                            {
                                "target_lang_word": "grauen",
                                "target_lang_sense_clarification": "impersonal, vor etwas graut es einem"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "畏惧",
                                "target_lang_sense_clarification": "因预感到不好的事而感到害怕"
                            },
                            {
                                "target_lang_word": "担心",
                                "target_lang_sense_clarification": "对未来可能发生的事感到不安"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2aeba2d7-df1f-33d8-b5e8-162cf3d67014",
                    "sense_definition": "To fear something or someone greatly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fearful anticipation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors began to <w>dread</w> the storm as the waves grew taller than the ship.",
                            "target_lang_translations": {
                                "ru": "Моряки начали <w>бояться</w> шторма, когда волны стали выше корабля.",
                                "de": "Die Seeleute begannen, den Sturm zu <w>fürchten</w>, als die Wellen höher als das Schiff wurden.",
                                "zh": "当海浪高过船身时，水手们开始<w>惧怕</w>这场风暴。"
                            }
                        },
                        {
                            "text": "He used to <w>dread</w> his boss, but now they have a much better relationship.",
                            "target_lang_translations": {
                                "ru": "Раньше он <w>трепетал</w> перед своим боссом, но теперь у них гораздо лучшие отношения.",
                                "de": "Früher <w>fürchtete</w> er seinen Chef, aber jetzt haben sie ein viel besseres Verhältnis.",
                                "zh": "他过去很<w>怕</w>他的老板，但现在他们的关系好多了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "revere",
                        "terrorize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно бояться чего-либо или кого-либо.",
                        "de": "Jemanden oder etwas sehr stark fürchten.",
                        "zh": "对某人或某事感到极度恐惧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бояться",
                                "target_lang_sense_clarification": "испытывать страх"
                            },
                            {
                                "target_lang_word": "трепетать",
                                "target_lang_sense_clarification": "сильно бояться, дрожать от страха"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fürchten",
                                "target_lang_sense_clarification": "vor etwas Angst haben"
                            },
                            {
                                "target_lang_word": "sich fürchten",
                                "target_lang_sense_clarification": "reflexiv, Angst vor jemandem haben"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "害怕",
                                "target_lang_sense_clarification": "感到恐惧"
                            },
                            {
                                "target_lang_word": "惧怕",
                                "target_lang_sense_clarification": "非常害怕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45feee9c-ff0a-37c7-9310-dee1aba5f3fa",
                    "sense_definition": "To style hair into dreadlocks.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hair styling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>dread</w> her hair after years of keeping it in a natural afro.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>заплести дреды</w> после того, как много лет носила натуральное афро.",
                                "de": "Sie entschied sich, ihre Haare zu <w>Dreadlocks</w> zu formen, nachdem sie sie jahrelang als natürlichen Afro getragen hatte.",
                                "zh": "在留了多年自然爆炸头后，她决定去<w>编脏辫</w>。"
                            }
                        },
                        {
                            "text": "It takes several hours to properly <w>dread</w> long hair for the first time.",
                            "target_lang_translations": {
                                "ru": "Требуется несколько часов, чтобы правильно <w>заплести</w> длинные волосы в первый раз.",
                                "de": "Es dauert mehrere Stunden, langes Haar zum ersten Mal richtig zu <w>Dreadlocks</w> zu verarbeiten.",
                                "zh": "第一次给长发<w>编脏辫</w>需要好几个小时。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заплетать волосы в дреды.",
                        "de": "Haare zu Dreadlocks formen.",
                        "zh": "将头发编成脏辫。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плести дреды",
                                "target_lang_sense_clarification": "делать прическу"
                            },
                            {
                                "target_lang_word": "заплетать",
                                "target_lang_sense_clarification": "о волосах"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dreadlocks machen",
                                "target_lang_sense_clarification": "eine Frisur erstellen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编脏辫",
                                "target_lang_sense_clarification": "一种发型制作过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e73b8e52-6aa0-3fca-a8ab-040392767267",
                    "sense_definition": "Great fear or anxiety about something that is going to happen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The upcoming exam is filling the entire classroom with a sense of <w>dread</w>.",
                            "target_lang_translations": {
                                "ru": "Предстоящий экзамен наполняет весь класс чувством <w>ужаса</w>.",
                                "de": "Die bevorstehende Prüfung erfüllt das gesamte Klassenzimmer mit einem Gefühl der <w>Angst</w>.",
                                "zh": "即将到来的考试让整个教室都弥漫着一种<w>恐惧</w>感。"
                            }
                        },
                        {
                            "text": "She felt a cold <w>dread</w> in her chest when she realized she had lost her keys.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала холодный <w>трепет</w> в груди, когда поняла, что потеряла ключи.",
                                "de": "Sie spürte eine kalte <w>Angst</w> in ihrer Brust, als sie merkte, dass sie ihre Schlüssel verloren hatte.",
                                "zh": "当意识到钥匙丢了时，她心中感到一阵冰冷的<w>恐惧</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "apprehension",
                        "trepidation",
                        "fear",
                        "worry",
                        "terror"
                    ],
                    "antonyms": [
                        "confidence",
                        "calm"
                    ],
                    "common_phrases": [
                        "sense of dread",
                        "filled with dread",
                        "cold dread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный страх или тревога по поводу того, что должно произойти.",
                        "de": "Große Angst oder Sorge vor einem zukünftigen Ereignis.",
                        "zh": "对即将发生的事情感到极度恐惧或焦虑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужас",
                                "target_lang_sense_clarification": "сильное чувство страха"
                            },
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "сильное волнение и страх"
                            },
                            {
                                "target_lang_word": "боязнь",
                                "target_lang_sense_clarification": "беспокойство"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Angst",
                                "target_lang_sense_clarification": "Gefühl der Furcht oder Sorge"
                            },
                            {
                                "target_lang_word": "Furcht",
                                "target_lang_sense_clarification": "Emotion angesichts drohender Gefahr"
                            },
                            {
                                "target_lang_word": "Grausen",
                                "target_lang_sense_clarification": "starke Angst vor etwas"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恐惧",
                                "target_lang_sense_clarification": "强烈的害怕感"
                            },
                            {
                                "target_lang_word": "忧虑",
                                "target_lang_sense_clarification": "对未来的不安"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d98a57a9-aed5-3783-b0c0-83ad4d4c376e",
                    "sense_definition": "A shortened form of the word <w>dreadlock</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years growing out his <w>dreads</w> until they reached his waist.",
                            "target_lang_translations": {
                                "ru": "Он годами отращивал свои <w>дреды</w>, пока они не достигли талии.",
                                "de": "Er verbrachte Jahre damit, seine <w>Dreads</w> wachsen zu lassen, bis sie seine Taille erreichten.",
                                "zh": "他花了几年时间留长他的<w>脏辫</w>，直到它们垂到腰间。"
                            }
                        },
                        {
                            "text": "She decided to cut off her <w>dreads</w> and try a shorter hairstyle.",
                            "target_lang_translations": {
                                "ru": "Она решила состричь свои <w>дреды</w> и попробовать более короткую прическу.",
                                "de": "Sie entschied sich, ihre <w>Dreads</w> abzuschneiden und eine kürzere Frisur auszuprobieren.",
                                "zh": "她决定剪掉<w>脏辫</w>，尝试一种更短的发型。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dreadlocks",
                        "locks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слова «dreadlock» (дреды).",
                        "de": "Kurzform für Dreadlocks.",
                        "zh": "脏辫（dreadlock）的缩写形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дреды",
                                "target_lang_sense_clarification": "прическа"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Dreads",
                                "target_lang_sense_clarification": "umgangssprachliche Bezeichnung für Dreadlocks"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脏辫",
                                "target_lang_sense_clarification": "一种发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b15d4e4-6264-309b-be9b-ef9e016a339a",
                    "sense_definition": "A feeling of deep respect mixed with fear; awe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient people looked upon the volcano with a mixture of <w>dread</w> and wonder.",
                            "target_lang_translations": {
                                "ru": "Древние люди смотрели на вулкан со смесью <w>трепета</w> и изумления.",
                                "de": "Die Menschen der Antike betrachteten den Vulkan mit einer Mischung aus <w>Ehrfurcht</w> und Staunen.",
                                "zh": "古人怀着一种既<w>敬畏</w>又惊叹的心情注视着火山。"
                            }
                        },
                        {
                            "text": "The king's presence inspired <w>dread</w> among his subjects.",
                            "target_lang_translations": {
                                "ru": "Присутствие короля внушало <w>ужас</w> его подданным.",
                                "de": "Die Anwesenheit des Königs flößte seinen Untertanen <w>Ehrfurcht</w> ein.",
                                "zh": "国王的出现让他的臣民感到<w>敬畏</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "awe",
                        "reverence"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More common in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство глубокого уважения, смешанное со страхом; благоговейный трепет.",
                        "de": "Ein Gefühl von tiefem Respekt, gemischt mit Angst; Ehrfurcht.",
                        "zh": "一种混合了恐惧的深层敬畏感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трепет",
                                "target_lang_sense_clarification": "благоговейный страх"
                            },
                            {
                                "target_lang_word": "священный ужас",
                                "target_lang_sense_clarification": "глубокое почтение и страх"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ehrfurcht",
                                "target_lang_sense_clarification": "auf hoher Achtung beruhende Scheu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敬畏",
                                "target_lang_sense_clarification": "既尊敬又害怕"
                            },
                            {
                                "target_lang_word": "畏惧",
                                "target_lang_sense_clarification": "带有敬意的害怕"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7b2f6428-81c0-3dbe-af43-eedab418025a",
                    "sense_definition": "Causing great fear; extremely terrible or dreaded.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers marched in silence down the <w>dread</w> path toward the enemy camp.",
                            "target_lang_translations": {
                                "ru": "Солдаты молча шли по <w>страшному</w> пути к вражескому лагерю.",
                                "de": "Die Soldaten marschierten schweigend den <w>fürchterlichen</w> Pfad in Richtung des feindlichen Lagers entlang.",
                                "zh": "士兵们沉默地走在通往敌营那条<w>可怕的</w>小路上。"
                            }
                        },
                        {
                            "text": "They spoke in whispers about the <w>dread</w> monster that lived in the cave.",
                            "target_lang_translations": {
                                "ru": "Они шепотом говорили об <w>ужасном</w> монстре, жившем в пещере.",
                                "de": "Sie sprachen flüsternd über das <w>fürchterliche</w> Monster, das in der Höhle lebte.",
                                "zh": "他们低声谈论着住在洞穴里那个<w>恐怖的</w>怪物。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "frightful",
                        "dire"
                    ],
                    "antonyms": [
                        "pleasant",
                        "wonderful"
                    ],
                    "traits": [
