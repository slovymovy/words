                        "entry_id": "46913a63-f55a-374a-a444-dd5aff3e23d7",
                        "glosses": [
                            "Relatif aux personnes et communautés lesbiennes, bisexuelles et gays."
                        ],
                        "tags": [
                            "LGBTQ"
                        ],
                        "examples": [
                            {
                                "example_id": "4ac7f21b-4194-4ccc-821d-9e38cbb38315",
                                "sense_id": "6b30207b-17a7-30dc-aefc-649ef9f1bfa1",
                                "text": "De manière générale, le Centre observe une dimension homophobe dans près de deux tiers de ces dossiers, s’appuyant sur des préjugés, de la haine ou du mépris à l’égard des personnes lesbigays (particulièrement à l’égard des hommes homosexuels)."
                            },
                            {
                                "example_id": "436a16bf-4a47-42ae-8edf-4f30dcdd14a5",
                                "sense_id": "6b30207b-17a7-30dc-aefc-649ef9f1bfa1",
                                "text": "L’attitude adoptée dans le football professionnel belge à l'égard des minorités, et en particulier des minorités ethniques et culturelles et de la communauté lesbigay reste préoccupante."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f6d76f8-6d99-4404-bc82-f9b45c4dc553",
                        "source_entry_id": "46913a63-f55a-374a-a444-dd5aff3e23d7",
                        "source_sense_id": "6b30207b-17a7-30dc-aefc-649ef9f1bfa1",
                        "target_lang_word": "lesbischwul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lesbischwul",
