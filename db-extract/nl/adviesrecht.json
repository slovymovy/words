                        "examples": [
                            {
                                "example_id": "0fcce569-587f-4a6a-b8d1-1f44bafe0ee4",
                                "sense_id": "fb477797-6176-3347-a49a-21dd465791fe",
                                "text": "Door de nieuwe wet krijgen de ondernemingsraden geen instemmings- of adviesrecht over beloningen. Wel worden directies van bedrijven met meer dan honderd man personeel voortaan verplicht de informatie te verschaffen en het mondeling te bespreken."
                            },
                            {
                                "example_id": "193eabff-35f7-4596-904a-3e69b65d3841",
                                "sense_id": "fb477797-6176-3347-a49a-21dd465791fe",
                                "text": "\"In dit geval heeft de OR adviesrecht. Daar moet KPN rekening mee houden\", zegt Evert Verhulp, professor arbeidsrecht aan de Universiteit van Amsterdam. \"De Ondernemingskamer gaat in zo'n geval toetsen of KPN dit goed doet.\""
                            }
                        ]
