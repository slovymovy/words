                                "text": "tiefe Verbitterung",
                                "translation": "deep resentment",
                                "english": "deep resentment"
                            },
                            {
                                "example_id": "cf8427f6-9533-4253-96f9-6ff56c16776b",
                                "sense_id": "e287af2c-de4c-34ec-b845-870a20792e1e",
                                "text": "zu Hass und Verbitterung führen",
                                "translation": "to lead to bitterness and hatred",
                                "english": "to lead to bitterness and hatred"
                            },
                            {
                                "example_id": "86b65edf-d65f-457e-b6c5-2e2b650ab979",
                                "sense_id": "e287af2c-de4c-34ec-b845-870a20792e1e",
                                "text": "Gefühle der Verbitterung und Hilflosigkeit hervorrufen",
                                "translation": "to cause feelings of embitterment and helplessness",
                                "english": "to cause feelings of embitterment and helplessness"
                            },
                            {
