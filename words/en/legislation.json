{
    "word_family": [
        "legislate",
        "legislative",
        "legislator",
        "legislature"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7966f5fc-ca1d-304a-a561-ad834c2692ff",
                    "sense_definition": "A law or a set of laws that has been officially enacted by a governing body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "laws",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government passed new <w>legislation</w> to protect the environment from industrial pollution.",
                            "target_lang_translations": {
                                "ru": "Правительство приняло новый <w>закон</w> для защиты окружающей среды от промышленного загрязнения.",
                                "zh": "政府通过了新的<w>法律</w>，以保护环境免受工业污染。"
                            }
                        },
                        {
                            "text": "Under current <w>legislation</w>, employers must ensure a safe working environment for all staff.",
                            "target_lang_translations": {
                                "ru": "Согласно действующему <w>законодательству</w>, работодатели обязаны обеспечить безопасные условия труда для всех сотрудников.",
                                "zh": "根据现行<w>法规</w>，雇主必须确保所有员工拥有安全的工作环境。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pass legislation",
                        "current legislation",
                        "new legislation",
                        "federal legislation",
                        "introduce legislation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закон или свод законов, официально принятый руководящим органом.",
                        "zh": "由管理机构正式颁布的法律或一套法律。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "законодательство",
                                "target_lang_sense_clarification": "свод законов"
                            },
                            {
                                "target_lang_word": "закон",
                                "target_lang_sense_clarification": "отдельный нормативный акт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法律",
                                "target_lang_sense_clarification": "指具体的法律条文或法规"
                            },
                            {
                                "target_lang_word": "法规",
                                "target_lang_sense_clarification": "指成文的规章制度或法律"
                            },
                            {
                                "target_lang_word": "立法",
                                "target_lang_sense_clarification": "指已通过的法律体系或整体法律规定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6b183c9-ac39-3201-9d18-ea829f34f720",
                    "sense_definition": "The act or process of making and enacting laws.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "law_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>legislation</w> of morality is often a complex and controversial subject in politics.",
                            "target_lang_translations": {
                                "ru": "<w>Законодательное регулирование</w> вопросов морали часто является сложной и спорной темой в политике.",
                                "zh": "道德的<w>立法</w>在政治中往往是一个复杂且充满争议的话题。"
                            }
                        },
                        {
                            "text": "Effective <w>legislation</w> requires thorough debate and consideration of all potential consequences.",
                            "target_lang_translations": {
                                "ru": "Эффективное <w>законотворчество</w> требует тщательного обсуждения и учета всех возможных последствий.",
                                "zh": "有效的<w>立法</w>需要经过充分的辩论并考虑所有潜在的后果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lawmaking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс разработки и принятия законов.",
                        "zh": "制定和颁布法律的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "законотворчество",
                                "target_lang_sense_clarification": "процесс создания законов"
                            },
                            {
                                "target_lang_word": "издание законов",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立法",
                                "target_lang_sense_clarification": "指制定法律的活动"
                            },
                            {
                                "target_lang_word": "立法过程",
                                "target_lang_sense_clarification": "指法律制定的具体程序"
                            }
                        ]
                    }
                }
            ]
        }
    ]
