                "senses": [
                    {
                        "sense_id": "0dbd7e97-f802-3eb6-ada9-de931bb0c41e",
                        "entry_id": "f3b25e38-a5d0-30a3-afb8-ebb00dc435a3",
                        "glosses": [
                            "техн. приводимый в движение воздушным винтом, работающим от газовой турбины"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f820260-4b8b-4295-9d66-cb244e3ef2f1",
                                "sense_id": "0dbd7e97-f802-3eb6-ada9-de931bb0c41e",
                                "text": "Ильюшинцы строили Ил-18, новый, турбовинтовой, в отличие от поршневого самолета 1946 года."
                            },
                            {
                                "example_id": "73bba4db-bffa-4336-ac10-b828c51d13a5",
                                "sense_id": "0dbd7e97-f802-3eb6-ada9-de931bb0c41e",
                                "text": "Например, на пражских заводах Моторлет и Авиа созданы новый турбовинтовой двигатель М-602 мощностью 1360 кВт и более экономичные пятилопастные винты."
                            }
                        ]
                    }
