{
    "word_family": [
        "abide",
        "abiding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "35056928-2646-32d9-8262-dc49aa7ca1f4",
                    "sense_definition": "To wait; to stay or remain in a place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>bide</w> here until the storm passes safely.",
                            "target_lang_translations": {
                                "de": "Du musst hier <w>verweilen</w>, bis das Unwetter sicher vorübergezogen ist."
                            }
                        },
                        {
                            "text": "It is difficult to <w>bide</w> while others make all the decisions.",
                            "target_lang_translations": {
                                "de": "Es ist schwierig, <w>abzuwarten</w>, während andere alle Entscheidungen treffen."
                            }
                        }
                    ],
                    "synonyms": [
                        "stand by"
                    ],
                    "common_phrases": [
                        "bide here"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "An einem Ort warten, verweilen oder bleiben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verweilen",
                                "target_lang_sense_clarification": "An einem Ort bleiben, oft in einem literarischen Kontext."
                            },
                            {
                                "target_lang_word": "warten",
                                "target_lang_sense_clarification": "An einem Ort bleiben, bis etwas geschieht."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a275ff5-c038-3be9-8751-e4d3dca12794",
                    "sense_definition": "To wait for something to happen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must <w>bide</w> our time before making a final move.",
                            "target_lang_translations": {
                                "de": "Wir müssen den richtigen Zeitpunkt <w>abwarten</w>, bevor wir den letzten Schritt machen."
                            }
                        },
                        {
                            "text": "The soldiers <w>bide</w> the signal to begin the operation.",
                            "target_lang_translations": {
                                "de": "Die Soldaten <w>warten</w> auf das Signal, um die Operation zu beginnen."
                            }
                        }
                    ],
                    "synonyms": [
                        "await"
                    ],
                    "common_phrases": [
                        "bide time"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Commonly found in the idiom 'bide one's time'."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Auf ein Ereignis warten oder den richtigen Zeitpunkt abpassen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abwarten",
                                "target_lang_sense_clarification": "Den Eintritt eines Ereignisses abpassen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ab5bd74-6c9c-3e57-8fc4-88807d9af641",
                    "sense_definition": "To dwell or reside in a specific location.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reside",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient tribes used to <w>bide</w> in these deep mountain valleys.",
                            "target_lang_translations": {
                                "de": "Viele alte Stämme pflegten in diesen tiefen Bergtälern zu <w>wohnen</w>."
                            }
                        },
                        {
                            "text": "Those who <w>bide</w> in the city often miss the quiet of the countryside.",
                            "target_lang_translations": {
                                "de": "Diejenigen, die in der Stadt <w>leben</w>, vermissen oft die Ruhe auf dem Land."
                            }
                        }
                    ],
                    "synonyms": [
                        "live"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "An einem bestimmten Ort wohnen oder leben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wohnen",
                                "target_lang_sense_clarification": "An einem Ort ansässig sein."
                            },
                            {
                                "target_lang_word": "leben",
                                "target_lang_sense_clarification": "An einem Ort dauerhaft residieren."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35f9a2df-6974-378a-b6fe-f0824209ca46",
                    "sense_definition": "To bear or tolerate something unpleasant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tolerate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She could hardly <w>bide</w> the constant noise from the construction site.",
                            "target_lang_translations": {
                                "de": "Sie konnte den ständigen Lärm von der Baustelle kaum <w>ertragen</w>."
                            }
                        },
                        {
                            "text": "It is hard to <w>bide</w> such rude behavior from a colleague.",
                            "target_lang_translations": {
                                "de": "Es ist schwer, ein solch unhöfliches Verhalten eines Kollegen zu <w>dulden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "put up with"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Still heard in some regional dialects."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas Unangenehmes ertragen oder dulden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "ertragen",
                                "target_lang_sense_clarification": "Etwas Unangenehmes aushalten."
                            },
                            {
                                "target_lang_word": "dulden",
                                "target_lang_sense_clarification": "Etwas hinnehmen, das man eigentlich nicht mag."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "832e0bad-9cd5-3344-9c82-c0d86f113d95",
                    "sense_definition": "To face a difficult situation with resistance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tolerate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brave knight stood ready to <w>bide</w> the danger of the coming battle.",
                            "target_lang_translations": {
                                "de": "Der tapfere Ritter war bereit, der Gefahr der kommenden Schlacht zu <w>trotzen</w>."
                            }
                        },
                        {
                            "text": "He had to <w>bide</w> the harsh criticism of his peers during the meeting.",
                            "target_lang_translations": {
                                "de": "Er musste der harten Kritik seiner Kollegen während des Treffens <w>standhalten</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einer schwierigen Situation mit Widerstand oder Standhaftigkeit begegnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "standhalten",
                                "target_lang_sense_clarification": "Einer Gefahr oder Belastung widerstehen."
                            },
                            {
                                "target_lang_word": "trotzen",
                                "target_lang_sense_clarification": "Sich einer schwierigen Lage mutig entgegenstellen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e7eef53b-8781-3d7a-a3b2-6e3e34b49995",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the historical study is named Mr. <w>Bide</w>.",
                            "target_lang_translations": {
                                "de": "Der Autor der historischen Studie heißt Herr <w>Bide</w>."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Bide</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "de": "Ich habe gestern auf der Konferenz eine Frau namens Sarah <w>Bide</w> getroffen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bide",
                                "target_lang_sense_clarification": "Eigenname, wird im Deutschen unverändert übernommen."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}