                    },
                    {
                        "translation_id": "8354d221-5ee9-4e75-833c-0e4c42a1a962",
                        "source_entry_id": "9d1e4143-45d6-33c2-bf06-b289d6d27a0a",
                        "source_sense_id": "3676d699-edc5-3664-afc5-b64ebbc75540",
