                        ],
                        "examples": [
                            {
                                "example_id": "e4ce317b-5184-4b31-85b1-a9dacb3a960e",
                                "sense_id": "8d7bd9fa-3436-3adf-b94e-ff373509129d",
                                "text": "Although the Inferno’s toweled men do not appear in bath houses per se, they are surrounded by large numbers of partially clad, often athletic male bodies, just as they would have been in the Everard."
                            },
                            {
                                "example_id": "966c558d-54ce-4577-8502-1c2285da800b",
                                "sense_id": "8d7bd9fa-3436-3adf-b94e-ff373509129d",
                                "text": "The cross section of toweled women in the sauna included well-to-do housewives who were complaining about cleaning companies that were doing a “lousy job” for them and wishing they could find somebody “who did a really good job.”"
                            },
                            {
                                "example_id": "2eb8c03f-5fa5-42a9-8568-a27d40490040",
                                "sense_id": "8d7bd9fa-3436-3adf-b94e-ff373509129d",
                                "text": "She looked up at the back of a strange toweled man, who stood at the sink."
                            }
                        ]
                    }
