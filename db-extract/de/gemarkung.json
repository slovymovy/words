                "senses": [
                    {
                        "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                        "entry_id": "ac676b8c-dd16-3bad-8eae-f49824a10a22",
                        "glosses": [
                            "Gemeindefläche"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "17650a4c-f73e-4b2f-9a43-52d20d62d3cf",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„Der neue Stadtteil südlich der Donau, auf dem einst von Kleingärten geprägten Gebiet der Gemarkung Engerau oder Pozsonyligetfalu, die seit der Unabhängigkeit der Tschechoslowakei den Kunstnamen Petržalka – etwa: Petersilistan – trug, sollte für 100.000 Bewohner konzipiert werden.“"
                            },
                            {
                                "example_id": "ae07fe9f-fe63-47b7-84c5-03053ab90bff",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„Den Brand, der am Samstag auf der Gemarkung von Rove, nordwestlich von Marseille, ausgebrochen war, hatte die Feuerwehr am Sonntag unter Kontrolle.“"
                            },
                            {
                                "example_id": "7f27cbf3-8e15-44d8-af71-cd18ed9cc934",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„1801 gelangten mehrere Gründe und Häuser in der Ortschaft durch Kauf an den damaligen Besitzer der Herrschaft Penzing, Franz Xaver Freiherr von Mayr; dies hatte zur Folge, dass ein Teil der Häuser der Grundobrigkeit Penzing, andere der Nachbargemeinde Sechshaus unterstanden; die in der ursprünglichen Gemarkung gelegene Reindorfer Kirche gehörte nun zum Ortsbereich von Braunhirschen.“"
                            },
                            {
                                "example_id": "9e512f71-1218-4c14-a7a0-23bc7370a2a7",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„Einzigartig im Herzogtum Westfalen war die Ausdehnung der städtischen Gemarkung von Brilon.“"
                            },
                            {
                                "example_id": "c8e90ed2-1dd0-40d8-a5d5-20bacb3c263a",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„Ich möchte in diesem Zusammenhang auf die Beschwerden der Jagdpächter und auf das Verbot von freilaufenden Hunden in der Gemarkung hinweisen.“"
                            },
                            {
                                "example_id": "888a2b52-f75d-4c2c-b468-03f82c384190",
                                "sense_id": "965e344b-5239-30d2-9e83-3b48fbb5aae7",
                                "text": "„Für fünf Millionen Euro erwarb Frankfurt 2012 unter anderem eine 5200 Quadratmeter große Fläche auf Offenbacher Gemarkung, die für die Multifunktionshalle in Frage käme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "05834e64-e3e9-3a3f-af33-3d6c6b1a3fad",
                        "entry_id": "ac676b8c-dd16-3bad-8eae-f49824a10a22",
                        "glosses": [
