        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                "word": "démarche",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0c08fb42-9f95-4001-8f9f-9c6d5f60e189",
                        "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                        "tags": [
                            "plural"
                        ],
                        "form": "démarches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40a2f807-f8fb-32e2-802b-9c7a203fd728",
                        "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                        "glosses": [
                            "A diplomatic maneuver; one handled with finesse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                        "entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                        "glosses": [
                            "A diplomatic note without a personal attribution conveying an official protest or request for support, less formal than a bout de papier or a note verbale but of similar status to an aide-mémoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91a26c4d-096b-48d5-9851-b2856d68e4f4",
                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                "text": "A less formal way of making diplomatic representations or protests is called a démarche. The following from the US Department of State handbook sets out the typical procedures and purposes of a démarche."
                            },
                            {
                                "example_id": "9bb11ecc-43f8-4711-8ae6-8c7422764856",
                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                "text": "He did not question the Communist Party's conformity to Moscow, but he thought that the impact of a démarche would be limited since the Portuguese Communists could not afford to tone down their policies lest they be outflanked from the left."
                            },
                            {
                                "example_id": "4e18afa5-41b5-48a2-996b-21790f0c35be",
                                "sense_id": "624aea99-0588-3187-9a51-e70e5de46c32",
                                "text": "The EU made a démarche on 16 April 2003 calling for the continuation of discussions regarding this so-called “follow-up mechanism”, but beyond the one-off meeting, the mechanism never took off and was soon forgotten due to staff changes within the EU bureaucracy."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbc6ea0a-506a-46c7-8b93-b9d2225894c7",
                        "source_entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
                        "source_sense_description": "a diplomatic maneuver; one handled with finesse",
                        "target_lang_word": "дема́рш",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дема́рш",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4c05cede-4539-3531-b4f0-14b5ba306f1a",
                                        "entry_id": "99693dee-d090-36bf-bfec-63a0c255d2b7",
                                        "glosses": [
                                            "полит., дипл. чрезвычайное выступление (протест, просьба, предостережение), адресованное правительством или ведомством иностранных дел одного государства другому государству"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c1b46bc-a91f-4c89-9b88-1d74d7e5749e",
                                                "sense_id": "4c05cede-4539-3531-b4f0-14b5ba306f1a",
                                                "text": "Измученный сутками без сна и возбужденный тревогами пережитого, Бор был краток, но настоятелен: необходим демарш шведского правительства в Берлине ― нейтральная страна может себе позволить дипломатическую защиту подданных соседнего дружественного государства!"
                                            },
                                            {
                                                "example_id": "d4857e39-7606-445f-8226-8cb531c6e6dd",
                                                "sense_id": "4c05cede-4539-3531-b4f0-14b5ba306f1a",
                                                "text": "Не спасло и запоздалое решение от 17 июня, совпавшее с торжественным выносом тела Патриарха Григория, отозвать русское посольство из Константинополя. Общество расценило царский жест как слабовольный политический демарш, а не как суровый вызов врагу〈…〉"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3942aa72-56d8-3ee6-975e-c61644abae30",
                                        "entry_id": "99693dee-d090-36bf-bfec-63a0c255d2b7",
                                        "glosses": [
                                            "перен. демонстративное выступление против кого-либо, чего-либо; протест"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d45061db-2061-4327-95c4-92b853e2f143",
                                                "sense_id": "3942aa72-56d8-3ee6-975e-c61644abae30",
                                                "text": "Но ясно было, что и он тоже ― заодно с нами, это теперь был наш общий демарш, общее неуважение, общая вина."
                                            },
                                            {
                                                "example_id": "d45ce65f-4603-492e-8eee-899e165888b3",
                                                "sense_id": "3942aa72-56d8-3ee6-975e-c61644abae30",
                                                "text": "Дума ведь заседает, несмотря на демарш меньшинства."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b51c53-6638-42a2-a674-fbdc8b649540",
                        "source_entry_id": "5ac8a3ff-228c-301d-a478-94f25b42cf92",
