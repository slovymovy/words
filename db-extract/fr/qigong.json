                                        "entry_id": "a78df75b-d58a-313e-b42a-c4baa757c07a",
                                        "glosses": [
                                            "Một trong những hệ thống luyện tập vật lý và tâm thần để đạt được sức khỏe, luyện võ, và để tự giác ngộ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c3a0e68-4f29-4a94-a987-a2dd0879106f",
                                                "sense_id": "0583d561-2a21-3001-a651-7a3feea0da54",
                                                "text": "Tập luyện khí công là để rèn luyện thân thể khỏe mạnh."
                                            },
                                            {
                                                "example_id": "21e08526-3b44-4e8e-83c0-8240b3bc01b5",
                                                "sense_id": "0583d561-2a21-3001-a651-7a3feea0da54",
                                                "text": "Khí công thượng thừa."
                                            },
                                            {
                                                "example_id": "a74c7771-2d58-46c8-9fbd-82f3b242b66b",
                                                "sense_id": "0583d561-2a21-3001-a651-7a3feea0da54",
                                                "text": "Anh này có khí công thâm hậu."
                                            },
                                            {
                                                "example_id": "8cb4ad9c-137b-4a59-80ff-a38def259852",
                                                "sense_id": "0583d561-2a21-3001-a651-7a3feea0da54",
                                                "text": "Môn khí công thật là khó luyện."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
