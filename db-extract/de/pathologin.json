                "senses": [
                    {
                        "sense_id": "34ee0a35-cf1b-3a4a-ba90-6f02ae54b266",
                        "entry_id": "411942d2-dc25-3607-a610-7a7e9ec9f4d5",
                        "glosses": [
                            "weibliche Person, die sich wissenschaftlich mit der Pathologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7103268-b5d4-4017-b512-d70de1a50acd",
                                "sense_id": "34ee0a35-cf1b-3a4a-ba90-6f02ae54b266",
                                "text": "„Längst war ihm jene Nacht mit Marie aus dem Gutachten der Pathologin vertrauter als in der Wirklichkeit seiner Erinnerung.“"
                            },
                            {
                                "example_id": "b6b178a4-e8e3-4a1f-943a-f7623bdf985c",
                                "sense_id": "34ee0a35-cf1b-3a4a-ba90-6f02ae54b266",
                                "text": "„Die Geradlinigkeit der attraktiven Pathologin lässt ihren eigentlich makabren Arbeitsplatz zum Ruhepol der R.I.S. werden, von dem aus die Ermittlungen in Gang kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
