                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fecb6ef2-b874-4aca-be2e-3d2b8a51fd97",
                                "sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
                                "text": "Pan Artur ma firmę remontowo-budowlaną w Legnicy."
                            },
                            {
                                "example_id": "49ee20d8-b83b-4a8a-a077-e09efce81f1d",
                                "sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
                                "text": "Arturze, na kiedy przypadają twoje imieniny?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18d54da0-4661-4565-86df-f0affa869c85",
                        "source_entry_id": "ffd6b41e-aea9-3674-bfab-9668bcc54455",
                        "source_sense_id": "a88909d9-9a3a-3bcf-b550-12b77f569241",
                        "target_lang_word": "Arthur",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
