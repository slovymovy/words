                            },
                            {
                                "target_lang_word": "hilekar",
                                "target_lang_sense_clarification": "aldatıcı taktikler kullanan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f1b5482-8623-3e5d-bb7a-82691935b28a",
                    "sense_definition": "Severe, intense, or hard, especially of a physical blow or assault.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer dealt his opponent a <w>shrewd</w> blow to the jaw, ending the match.",
                            "target_lang_translations": {
                                "pl": "Bokser zadał swojemu przeciwnikowi <w>mocny</w> cios w szczękę, kończąc walkę.",
                                "tr": "Boksör, rakibinin çenesine <w>sert</w> bir darbe indirerek maçı bitirdi."
                            }
                        },
                        {
                            "text": "The army suffered a <w>shrewd</w> defeat during the winter campaign.",
                            "target_lang_translations": {
                                "pl": "Armia poniosła <w>dotkliwą</w> klęskę podczas kampanii zimowej.",
                                "tr": "Ordu, kış harekatı sırasında <w>ağır</w> bir yenilgiye uğradı."
                            }
                        }
