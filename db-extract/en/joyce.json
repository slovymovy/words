                "senses": [
                    {
                        "sense_id": "5a05be45-c89d-39ac-b38b-e5823109f492",
                        "entry_id": "5c233c52-4a54-3ce0-af30-a6c50e8d45c2",
                        "glosses": [
                            "An English and Irish surname originating as a patronymic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b323259-f3a5-460b-813d-4436d247042f",
                                "sense_id": "5a05be45-c89d-39ac-b38b-e5823109f492",
                                "text": "The vote was 213-209 along party lines. Republican members of the House Ethics Committee – Michael Guest of Mississippi, Dave Joyce of Ohio, Andrew Garbarino of New York, John Rutherford of Florida and Michelle Fischbach of Minnesota – voted present. GOP Rep. Ken Buck of Colorado also voted present but he is not on the Ethics Committee."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ac99f09-4ff8-346c-992c-f5c20fa2c31b",
                        "entry_id": "5c233c52-4a54-3ce0-af30-a6c50e8d45c2",
                        "glosses": [
                            "A female given name from the Celtic languages, associated by folk etymology with joy and rejoice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f201b6fe-9843-4466-b223-42bfc908a628",
                                "sense_id": "1ac99f09-4ff8-346c-992c-f5c20fa2c31b",
                                "text": "\"It's a curious name,\" remarked Captain Levison. \"Joyce - Joyce! I never heard such a name. Is it a Christian name or a surname?\"\n\"She was baptised Joyce. It is not so very uncommon. Her name is Joyce Hallijohn. She has been with us several years.\""
                            },
                            {
                                "example_id": "e7288c6d-bc80-4b6f-b544-d6732ddf14dc",
                                "sense_id": "1ac99f09-4ff8-346c-992c-f5c20fa2c31b",
                                "text": "You call me mother, and I remember my mother again,\nsomewhere in greater Boston, dying.\nI remember we named you Joyce\nso we could call you Joy."
                            }
                        ]
                    },
                    {
                        "sense_id": "17c3a0a0-ba08-3d12-b4cb-fe96db4b9e57",
                        "entry_id": "5c233c52-4a54-3ce0-af30-a6c50e8d45c2",
                        "glosses": [
                            "An unincorporated community in Clallam County, Washington, United States, named after founder Joseph M. Joyce."
                        ],
                        "tags": [],
                        "examples": []
                    }
