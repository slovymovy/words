                    },
                    {
                        "translation_id": "893daedd-4ed2-4104-80ad-eef6c931c294",
                        "source_entry_id": "a2a2f8ad-49c6-32db-aca8-08c5708a0a70",
                        "source_sense_description": "a supposed universal antidote, distinguished from mithridate",
                        "target_lang_word": "thériaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thériaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "767f53ab-5cbd-30d9-92f4-d094ea163a03",
                                        "entry_id": "22ac3d89-9193-33be-a9b5-e469a2daa884",
                                        "glosses": [
                                            "Ancien médicament composé d’opium et de nombreuses substances végétales et animales, utilisé comme antidote universel et tonique, notamment contre les poisons, les morsures et les affections digestives."
                                        ],
                                        "tags": [
                                            "Médecine historique",
                                            "Pharmacologie traditionnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57742e38-a4f5-4339-8aa5-7fc46d430393",
                                                "sense_id": "767f53ab-5cbd-30d9-92f4-d094ea163a03",
                                                "text": "Nos glaives de théâtre n’ont ni fil ni pointe, car ils ne doivent porter que de feintes blessures dont on se guérit subitement à la fin de la pièce, et cela sans onguent, charpie ou thériaque."
                                            },
                                            {
                                                "example_id": "726d169d-da7c-42ef-9579-bb6a05110843",
                                                "sense_id": "767f53ab-5cbd-30d9-92f4-d094ea163a03",
                                                "text": "C’est ce qui a mis en grand honneur l’anis, le corail rouge, le bouillon de vipère dont parle Mme de Sévigné, l’orviétan, le bézoard, la thériaque, la corne de cerf ou l’œil d’écrevisse réduits en poudre, etc."
                                            },
                                            {
                                                "example_id": "03295412-f9c3-45ba-b4f3-1535648dc7e0",
                                                "sense_id": "767f53ab-5cbd-30d9-92f4-d094ea163a03",
                                                "text": "La « Thériaque » mérite bien son nom de « panacée universelle » pour avoir soigné, ou guéri, des générations de malades pendant plus de deux millénaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96678af-411f-4bcb-8535-ad9272425334",
                        "source_entry_id": "a2a2f8ad-49c6-32db-aca8-08c5708a0a70",
                        "source_sense_description": "a supposed universal antidote, distinguished from mithridate",
                        "target_lang_word": "Theriak",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theriak",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                        "entry_id": "b8caeebb-d105-383f-a003-c125e84d64eb",
                                        "glosses": [
                                            "ein im Mittelalter gegen alle möglichen Krankheiten und Gebrechen verwendetes Universalheilmittel, das heute noch – jedoch mit abgewandelter Rezeptur und Indikation – hergestellt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b21264-4aa6-4005-9b29-6878e30c6fd0",
                                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                                "text": "Da ich durch Lothringen passierte, ging mir meine War aus, und weilen ich die Garnisonen scheuete, hatte ich keine Gelegenheit andere zuzurichten, derhalben mußte ich wohl was anders anfangen, bis ich wieder Theriak machen könnte. (Hans Jakob Christoffel von Grimmelshausen, Simplicius Simplicissimus, 9. Kapitel, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "6f579602-e566-4578-b716-8a32c64cb98f",
                                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                                "text": "Vollends entwaffneten sie ihn,",
                                                "translation": "(Gottfried von Straßburg, Tristan und Isolde, XII. Der Drachenkampf, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "fae8768c-1a4a-4ece-aae2-4583ad796e82",
                                                "sense_id": "7c570a73-39c3-36ea-a324-d7a004fc39e6",
                                                "text": "Man legt' ihm auf den Teppich hin",
                                                "translation": "(Wolfram von Eschenbach: Parzival und Titurel (Kapitel 33), z.n. Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
