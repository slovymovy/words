                "senses": [
                    {
                        "sense_id": "c221281a-d026-393b-b830-efcaf11bbf7c",
                        "entry_id": "23591875-e1aa-34f6-af13-e915bfb4b7ce",
                        "glosses": [
                            "D’une façon qui caractérise, qui détermine, expressément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fddb2164-6a88-4fef-98bc-13e2094291d8",
                                "sense_id": "c221281a-d026-393b-b830-efcaf11bbf7c",
                                "text": "Parler d’une chose déterminément."
                            },
                            {
                                "example_id": "51241ebe-b82e-4c93-a668-fab628dbc161",
                                "sense_id": "c221281a-d026-393b-b830-efcaf11bbf7c",
                                "text": "Si vous me promettez, mais déterminément."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f59f20c-a0e0-3fa6-8736-98489496dd09",
                        "entry_id": "23591875-e1aa-34f6-af13-e915bfb4b7ce",
                        "glosses": [
                            "Avec résolution, détermination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c3e65a-64d8-4a0b-a79e-3621f8b9eec1",
                                "sense_id": "6f59f20c-a0e0-3fa6-8736-98489496dd09",
                                "text": "Il y a des gens qui veulent déterminément une chose."
                            },
                            {
                                "example_id": "b114afdf-45c8-4184-8b80-62fecc589752",
                                "sense_id": "6f59f20c-a0e0-3fa6-8736-98489496dd09",
                                "text": "Le sujet choisi pour le cardinalat par le roi de Pologne refusa la nomination si déterminément qu’il fallut songer à un autre."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba13d824-42e9-39f1-a9a4-11b821ee5501",
                        "entry_id": "23591875-e1aa-34f6-af13-e915bfb4b7ce",
                        "glosses": [
                            "Avec intrépidité."
                        ],
                        "tags": [],
                        "examples": [
                            {
