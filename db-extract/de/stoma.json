                    {
                        "translation_id": "1113253c-4da5-4ee7-9022-cbde38035afa",
                        "source_entry_id": "a97a667c-b5f1-3bd9-888e-7c811dc53953",
                        "source_sense_id": "58e59d0f-6555-36b9-a35b-754df3584647",
                        "source_sense_description": "Botanik: zwei bohnenförmige Zellen für den Gasaustausch einer Pflanze",
                        "target_lang_word": "stomate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stomate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                        "entry_id": "dc0083e0-0a78-38c3-a5b1-295cc2e0e6a7",
                                        "glosses": [
                                            "Pore microscopique situé dans l’épiderme des organes aériens des plantes, bordé par deux cellules de garde, permettant les échanges gazeux entre l’air et les tissus internes."
                                        ],
                                        "tags": [
                                            "Anatomie végétale",
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54fea08-cb91-476b-bd7f-499b77b5da3f",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Des chercheurs de l’Inra et de Montpellier SupAgro ont déjà commencé à sélectionner des cépages dont les stomates (petits trous à la surface des feuilles laissant passer les gaz et l’eau) se referment davantage la nuit, de façon à réduire la perte d’eau sans diminuer la production de raisins."
                                            },
                                            {
                                                "example_id": "e009654d-bb42-461d-b7a2-fcd8d9fbf373",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Ce phénomène conduit à une réduction de l’ouverture des stomates des feuilles et donc à une diminution de la photosynthèse."
                                            },
                                            {
                                                "example_id": "8f24e9a0-9df1-4332-b439-df449129f983",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Avec la sécheresse et le manque de pluies, l’arbre va donc adopter des stratégies pour s’économiser, comme la fermeture de ses stomates (pores à la surface des feuilles qui permettent les échanges gazeux de l’arbre) afin de moins transpirer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
