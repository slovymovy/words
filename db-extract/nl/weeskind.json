                    {
                        "translation_id": "75773fdf-457f-41fb-8084-f7bf7dc8b581",
                        "source_entry_id": "ab3cc0a0-c4f2-3128-a50e-a03554f058a6",
                        "target_lang_word": "Waisenkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waisenkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e181bb16-06d6-3e97-b851-4feeabd7f0a4",
                                        "entry_id": "1020c028-4277-3899-b373-2251a3ee4aa7",
                                        "glosses": [
                                            "ein Kind aus einer Familie, das verwaiste auf Grund dessen, weil die Eltern ums Leben gekommen sind"
                                        ],
                                        "tags": [
                                            "Familie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a0b69c4-9095-44dd-8509-d2cbe4f471f2",
                                                "sense_id": "e181bb16-06d6-3e97-b851-4feeabd7f0a4",
                                                "text": "Weltweit leben viele Waisenkinder ohne Eltern."
                                            },
                                            {
                                                "example_id": "1dadd7e5-d596-4bc3-a52d-a2aa89885aba",
                                                "sense_id": "e181bb16-06d6-3e97-b851-4feeabd7f0a4",
                                                "text": "„Die tatsächlichen Zahlen dürften aber weitaus höher gelegen haben, da die Erfahrungen der meisten Waisenkinder mit den Behörden nicht die besten waren - und es ihnen besser erschien, ihre neue litauische Identität nicht zu enttarnen.“"
                                            },
                                            {
                                                "example_id": "71193d7b-29fe-462f-96ea-31b59615c072",
                                                "sense_id": "e181bb16-06d6-3e97-b851-4feeabd7f0a4",
                                                "text": "„Er fühlt sich mager wie ein Waisenkind.“"
                                            },
                                            {
                                                "example_id": "5de86ed9-805b-40b4-bc1b-30370f51a989",
                                                "sense_id": "e181bb16-06d6-3e97-b851-4feeabd7f0a4",
                                                "text": "„Waisenkinder setzte er dort als Billigarbeitskräfte in seiner Textilfabrik ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5ec8b87-2bd0-3bc9-b6bf-f9773aa085ff",
                                        "entry_id": "1020c028-4277-3899-b373-2251a3ee4aa7",
                                        "glosses": [
                                            "ein Kind aus einem Waisenhaus, das von seinen Eltern oder einem Elternteil als Baby ausgesetzt oder von den Behörden (Familienamt) weggenommen wurde"
                                        ],
                                        "tags": [
                                            "Adoption"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ef08e1c-c52c-42c1-b30e-950fe0cf9055",
                                                "sense_id": "c5ec8b87-2bd0-3bc9-b6bf-f9773aa085ff",
                                                "text": "Manchmal wurde eines der Waisenkinder zur Adoption freigegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7e664d1a-d9ef-3aae-a3ac-2ab09c014f03",
                                        "entry_id": "1020c028-4277-3899-b373-2251a3ee4aa7",
                                        "glosses": [
                                            "fehlerhafter Umbruch am Ende einer Kolumne oder Satzspalte"
                                        ],
                                        "tags": [
                                            "Typografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc09f35b-5c6d-4a37-bea6-bb604bfb2ba8",
                                                "sense_id": "7e664d1a-d9ef-3aae-a3ac-2ab09c014f03",
                                                "text": "Waisenkinder stören erheblich den inhaltlichen und formalen Leserhythmus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
