        "fr-extract.jsonl": [
            {
                "entry_id": "3368507c-6ad3-388f-912d-3c53f1b4698b",
                "word": "personnellement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c3f26f1-e58e-3537-b85a-7165cd2d3d2c",
                        "entry_id": "3368507c-6ad3-388f-912d-3c53f1b4698b",
                        "glosses": [
                            "En la personne de celui dont il s’agit. — Note d’usage : Dans ce sens, il a toujours rapport au régime du verbe qu’il modifie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde2e3e6-768d-4a29-a1bc-83b76e36b566",
                                "sense_id": "3c3f26f1-e58e-3537-b85a-7165cd2d3d2c",
                                "text": "Le seul recours contre le temps est de le mesurer à ce double pas, comme ceux qui ont affaire personnellement à lui, les sentinelles, les officiers de quart."
                            },
                            {
                                "example_id": "7ab5bd1c-a78c-46cd-860a-c68cc6247033",
                                "sense_id": "3c3f26f1-e58e-3537-b85a-7165cd2d3d2c",
                                "text": "Tout dépend de l'attitude à la fois culturelle, ecclésiale et personnelle de ceux qui adoptent une telle posture intellectuelle (nous avons personnellement cessé depuis longtemps de croire que la posture intellectuelle suffisait à rendre compte de l’attitude réelle d'un intellectuel !)."
                            }
                        ]
                    },
                    {
                        "sense_id": "8903e388-60bc-3abd-8d13-eb372353f957",
                        "entry_id": "3368507c-6ad3-388f-912d-3c53f1b4698b",
                        "glosses": [
                            "D’une manière propre à la personne elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efcf8374-b91d-4c0d-89d6-7c00732e2d69",
                                "sense_id": "8903e388-60bc-3abd-8d13-eb372353f957",
                                "text": "Nous avons, aux articles de la capacité des parties contractantes, rapporté un arrêt qui a déclaré un ex-maire personnellement responsable d'un emprunt qu'il avait fait en cette qualité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66a224d9-f1f0-43f0-9fb3-e063d25ee105",
                        "source_entry_id": "3368507c-6ad3-388f-912d-3c53f1b4698b",
                        "target_lang_word": "persönlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persönlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e9eee8b-13c5-338f-9d80-7d062b6887df",
                                        "entry_id": "47d65ecd-3418-311b-bcf9-975913ef7f73",
                                        "glosses": [
                                            "von einer Person (direkt) stammend"
                                        ],
                                        "tags": [
                                            "meist attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0955a92-6a77-4cd0-afc0-43e3ebcfd41f",
                                                "sense_id": "6e9eee8b-13c5-338f-9d80-7d062b6887df",
                                                "text": "Ich habe eine persönliche Einladung vom Direktor bekommen."
                                            },
                                            {
                                                "example_id": "e8aae08b-f193-4f81-a2a8-28533b8a28f6",
                                                "sense_id": "6e9eee8b-13c5-338f-9d80-7d062b6887df",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f6ebb63-7728-3e81-8665-c55da43f6015",
                                        "entry_id": "47d65ecd-3418-311b-bcf9-975913ef7f73",
                                        "glosses": [
                                            "in eigener Person"
                                        ],
                                        "tags": [
                                            "meist als Adverb",
                                            "attributiv",
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba27e497-95b1-4eae-8ddd-8ae422508694",
                                                "sense_id": "4f6ebb63-7728-3e81-8665-c55da43f6015",
                                                "text": "Können Sie persönlich vorbeikommen?"
                                            },
                                            {
                                                "example_id": "6a9b8e6a-4500-4e64-acdb-a1de0fd03edd",
                                                "sense_id": "4f6ebb63-7728-3e81-8665-c55da43f6015",
                                                "text": "Ich werde ihn persönlich bestrafen."
                                            },
                                            {
                                                "example_id": "17c58edc-9cb4-4062-b244-b8784d95deb6",
                                                "sense_id": "4f6ebb63-7728-3e81-8665-c55da43f6015",
                                                "text": "„Die wichtigste Regel für Wikipedia-Autorinnen und Autoren ist: Schreibe keine Artikel über Personen oder Dinge, die dich persönlich betreffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "510f2893-67c3-38f9-909f-6632a25b1c62",
                                        "entry_id": "47d65ecd-3418-311b-bcf9-975913ef7f73",
                                        "glosses": [
                                            "nur die eigene Person betreffend, nicht für Fremde bestimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa0576f-77d0-4b64-b2dd-dccac46a731c",
                                                "sense_id": "510f2893-67c3-38f9-909f-6632a25b1c62",
                                                "text": "Bitte lassen Sie uns alleine. Unser Gespräch ist persönlich."
                                            },
                                            {
                                                "example_id": "f27e3c79-2215-4388-afb1-3aa488f43b52",
                                                "sense_id": "510f2893-67c3-38f9-909f-6632a25b1c62",
                                                "text": "Sie stellten mir noch ein paar persönliche Fragen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9aaf9d9b-fb65-3696-9c1c-8369e303948d",
                                        "entry_id": "47d65ecd-3418-311b-bcf9-975913ef7f73",
                                        "glosses": [
                                            "ein besonderes Merkmal von jemandem kennzeichnend"
                                        ],
                                        "tags": [
                                            "meist attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ff8ca50-0b9f-46fd-ad79-996883c1b606",
                                                "sense_id": "9aaf9d9b-fb65-3696-9c1c-8369e303948d",
                                                "text": "Mit Bertolds persönlicher Art kommt nicht jeder zurecht."
                                            },
                                            {
                                                "example_id": "52c54051-9d69-46c3-895f-a4194c727ff6",
                                                "sense_id": "9aaf9d9b-fb65-3696-9c1c-8369e303948d",
                                                "text": "„Denn wer zivile Tugenden wie persönliche Verantwortung und Zivilcourage für Extremleistungen hält, die man eigentlich nur von Hochleistungsdemokraten erwarten könnte, so merkte der Schriftsteller Peter Schneider unlängst an, der gibt zu erkennen, daß er an dieser Latte nicht gemessen werden möchte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "906c8623-5a2a-30d8-844f-7d400c7cb852",
                                        "entry_id": "47d65ecd-3418-311b-bcf9-975913ef7f73",
                                        "glosses": [
                                            "auf jemanden direkt bezogen, und nicht auf eine Sache oder einen Inhalt"
                                        ],
                                        "tags": [
                                            "meist attributiv; oft auf Kritik bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d13711-2c18-4c53-a4b3-d34c3c5eeacf",
                                                "sense_id": "906c8623-5a2a-30d8-844f-7d400c7cb852",
                                                "text": "Man sollte im Berufsleben nicht persönlich werden."
                                            },
                                            {
                                                "example_id": "19632c87-1e97-4c5f-8cc6-b6b89fae6448",
                                                "sense_id": "906c8623-5a2a-30d8-844f-7d400c7cb852",
                                                "text": "Wenn jemand alles gleich persönlich nimmt, kann man kaum mit ihm konstruktiv zusammenarbeiten."
                                            },
                                            {
                                                "example_id": "ee8b1153-af38-42e5-9ce2-95c3ec77f5a1",
                                                "sense_id": "906c8623-5a2a-30d8-844f-7d400c7cb852",
                                                "text": "„Der Wert der vorgelegten Reiseberichte lag zu Zeiten Goethes und Humboldts in der Originalität der persönlich erlebten, geschilderten und gedeuteten Landschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a365add-22aa-4d80-999a-f192fbfd3e34",
                        "source_entry_id": "3368507c-6ad3-388f-912d-3c53f1b4698b",
                        "target_lang_word": "personally",
