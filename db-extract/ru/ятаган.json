                        "examples": [
                            {
                                "example_id": "a5873582-6873-43fc-ad05-8f4875a52bbf",
                                "sense_id": "c2ff0129-5041-3a17-b68d-bdf1779342c1",
                                "text": "Над нашим районом господствовала металлическая ракета, стоящая на сужающемся столбе титанового дыма, похожем на воткнутый в землю огромный ятаган.",
                                "translation": "Our district was dominated by a metal rocket standing on a tapering column of solid titanium smoke, like some huge scimitar thrust into the ground.",
                                "english": "Our district was dominated by a metal rocket standing on a tapering column of solid titanium smoke, like some huge scimitar thrust into the ground."
                            }
                        ]
                    }
