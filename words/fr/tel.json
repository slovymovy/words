                    "sense_definition": "Introduit une comparaison poétique ou soutenue au début d'une proposition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "similitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tel</w> un oiseau migrateur guidé par l'instinct, le marin retrouva sa route nocturne."
                        },
                        {
                            "text": "<w>Tel</w> un fauve protégeant son territoire, le guerrier repoussa vaillamment ses ennemis."
                        }
                    ]
                },
                {
                    "sense_id": "b5c81529-7e7e-3751-8220-1154535d8788",
                    "sense_definition": "Désigne une personne dans une tournure proverbiale ou paradoxale suivie du pronom qui.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "indetermination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il voulait piéger son associé, mais <w>tel</w> est pris qui croyait prendre."
                        },
                        {
                            "text": "<w>Tel</w> se réjouit au matin qui versera des larmes amères au soir."
                        }
                    ],
                    "common_phrases": [
