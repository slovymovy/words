            "senses": [
                {
                    "sense_id": "570d3122-f63c-3bec-81c2-3bd4f08d12db",
                    "sense_definition": "Surface horizontale en saillie ou extrémité d'un meuble ou d'une ouverture où l'on peut poser des objets ou s'asseoir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "element_architectural_ou_mobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a posé un pot de basilic sur le <w>rebord</w> de la fenêtre pour qu'il reçoive la lumière du soleil."
                        },
                        {
                            "text": "L'enfant s'est assis sagement sur le <w>rebord</w> du lit en attendant la lecture du soir."
                        }
                    ],
                    "synonyms": [
                        "appui",
                        "bord"
                    ],
                    "common_phrases": [
                        "rebord de la fenêtre",
                        "rebord du lit"
                    ]
                },
                {
                    "sense_id": "1fc0c252-f2f6-3df6-871f-b4111b06ea41",
                    "sense_definition": "Bord relevé ou partie supérieure qui délimite un récipient ou une surface creuse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extremite_de_contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le lait chaud a débordé par-dessus le <w>rebord</w> de la casserole pendant la cuisson."
                        },
                        {
                            "text": "Elle a remarqué une légère fissure sur le <w>rebord</w> de sa tasse préférée en la lavant."
                        }
                    ],
                    "synonyms": [
                        "bord",
                        "lèvre",
                        "margelle"
                    ],
                    "common_phrases": [
                        "rebord de la tasse",
                        "rebord de la casserole"
                    ]
                },
                {
                    "sense_id": "d0345963-da42-3011-a92a-bb8553a76249",
                    "sense_definition": "Limite extrême et abrupte d'une élévation de terrain ou d'un précipice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relief_geographique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les promeneurs ont été avertis de ne pas trop s'approcher du <w>rebord</w> de la falaise à cause du vent."
                        },
                        {
                            "text": "Une barrière métallique sécurise le <w>rebord</w> du ravin pour empêcher tout accident."
