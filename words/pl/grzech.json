    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b9a16eb-5a4c-37ac-b66d-730357bd5a7e",
                    "sense_definition": "Celowe przekroczenie norm moralnych uznawanych w danej religii; uczynek niezgodny z przykazaniami.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religious_sin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spowiedź to sakrament, w którym wyznajemy swoje <w>grzechy</w>.",
                            "target_lang_translations": {
                                "ru": "Исповедь — это таинство, в котором мы исповедуем свои <w>грехи</w>.",
                                "en": "Confession is a sacrament in which we confess our <w>sins</w>."
                            }
                        },
                        {
                            "text": "Ksiądz wytłumaczył wiernym, czym jest <w>grzech</w> śmiertelny.",
                            "target_lang_translations": {
                                "ru": "Священник объяснил верующим, что такое смертный <w>грех</w>.",
                                "en": "The priest explained to the faithful what mortal <w>sin</w> is."
                            }
                        }
                    ],
                    "synonyms": [
                        "przewinienie",
                        "wina",
                        "nieprawość"
                    ],
                    "antonyms": [
                        "cnota"
                    ],
                    "common_phrases": [
                        "popełnić grzech",
                        "grzech śmiertelny",
                        "grzech pierworodny",
                        "odpuścić grzechy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умышленное нарушение религиозных и моральных норм; поступок, противоречащий заповедям.",
                        "en": "A deliberate transgression of moral or religious law; an act contrary to divine commandments."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грех",
                                "target_lang_sense_clarification": "религиозное понятие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sin",
                                "target_lang_sense_clarification": "religious violation or transgression"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "437079ed-5c40-34fd-bd33-cfbde8faa2a8",
                    "sense_definition": "Czyn naganny, błąd lub wykroczenie przeciwko jakimś zasadom, niekoniecznie religijnym.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "misdeed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marnowanie jedzenia to w dzisiejszych czasach prawdziwy <w>grzech</w>.",
                            "target_lang_translations": {
                                "ru": "Выбрасывать еду в наше время — настоящий <w>грех</w>.",
                                "en": "Wasting food nowadays is a real <w>sin</w>."
                            }
                        },
                        {
                            "text": "Jej jedynym <w>grzechem</w> była zbytnia ufność wobec obcych ludzi.",
                            "target_lang_translations": {
                                "ru": "Её единственным <w>грехом</w> была чрезмерная доверчивость к незнакомцам.",
                                "en": "Her only <w>sin</w> was being overly trusting of strangers."
                            }
                        }
                    ],
                    "synonyms": [
                        "błąd",
                        "wykroczenie",
                        "występek"
                    ],
                    "common_phrases": [
                        "grzech zaniechania",
                        "wart grzechu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предосудительный поступок, ошибка или нарушение каких-либо правил (в переносном смысле).",
                        "en": "A reprehensible act, error, or offense against certain principles or common sense, not necessarily religious."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грех",
                                "target_lang_sense_clarification": "проступок, ошибка"
                            },
                            {
                                "target_lang_word": "проступок",
                                "target_lang_sense_clarification": "вина, нарушение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "sin",
                                "target_lang_sense_clarification": "figurative, serious wrongdoing or mistake"
                            },
                            {
                                "target_lang_word": "crime",
                                "target_lang_sense_clarification": "figurative, deplorable act or waste"
                            },
                            {
                                "target_lang_word": "misdeed",
                                "target_lang_sense_clarification": "wrongdoing or fault"
                            }
                        ]
                    }
                }
            ]
        },
