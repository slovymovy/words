                ],
                "senses": [
                    {
                        "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                        "entry_id": "1847b951-62ee-3610-98c6-115d1fa21780",
                        "glosses": [
                            "an erster Stelle stehend, am besten/am größten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d113bf-fa12-4d6c-ac06-cddb602e6f57",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Weltführende Meteorologen und Klimaforscher warnen immer drastischer vor dem Treibauseffekt.“"
                            },
                            {
                                "example_id": "25169b48-899c-4af3-92a2-f292c55cbf2c",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "[Kisa Kaltenegger:] „In der Nacht von Montag auf Dienstag stattete die Astrophysikerin und Astronomin der Sternwarte einen Besuch ab. Die Freude darüber war bei den Amateur-Astronomen groß, kommt es doch nicht alle Tage vor, dass eine weltführende Forscherin dort vorbeischaut.“"
                            },
                            {
                                "example_id": "76162031-86d8-4851-8fd4-d85dde99d000",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "Madagaskar ist der weltführende Produzent von Vanille."
                            },
                            {
                                "example_id": "4870446d-7d34-4db2-8f27-903e1f3afcd1",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„»Die USA haben ihre Position als weltführender Waffenlieferant weiter gefestigt«, sagt Sipri-Waffenexpertin Aude Fleurant.“"
                            },
                            {
                                "example_id": "5ccf7547-14d3-4455-9ea8-b0099bdedbfa",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Brother Industries Ltd.“ […] „ist“ […] „einer der weltführenden Hersteller von Druckern, Multifunktions- und Faxgeräten, Schreibmaschinen,“ […]."
                            },
                            {
                                "example_id": "cc89e821-8fc5-426b-9b7d-624bd8533492",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„1913 akquirierte Bethlehem Steel die Fore River Shipbuilding Company aus Quincy, Massachusetts, wodurch Bethlehem Steel die Rolle des weltführenden Schiffbauers übernahm.“"
                            },
                            {
                                "example_id": "5e16efb5-250e-4a69-a30c-39377f709a9e",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "[Machtergreifung durch die Nazis 1933:] „7. April: Durch das Gesetz zur Wiederherstellung des Berufsbeamtentums wird die bis dahin weltführende Physikalische Fakultät in Göttingen bedeutungslos.“"
                            },
                            {
                                "example_id": "d2d65021-132f-46a6-9801-23249ea38dd9",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "[Coronapandemie Februar 2020:] „In der Regierung gibt es derweil Streit darüber, ob Deutschland die weltführende Tourismus-Messe ITB mit tausenden von Besuchern aus aller Welt, die am kommenden Mittwoch in Berlin beginnen soll, nicht lieber absagen sollte.“"
                            },
                            {
                                "example_id": "57af6c7b-9317-4f6d-a9c8-b4b2e8c3ebbb",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Wolfgang Ischinger leitet seit mehr als zehn Jahren die Münchner Sicherheitskonferenz, das mittlerweile weltführende Forum für außen- und sicherheitspolitische Themen.“"
                            },
                            {
                                "example_id": "fa56f893-4822-4c9e-bd30-08cce3b5cf0a",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Portugal besitzt bedeutende Rohstoffvorkommen, darunter Kohle, Kupfer, Zinn, Gold, Eisenerze wie Pyrit und Chalcopyrit, Tonminerale wie Kaolinit sowie Wolframit und Uraninit; es gehört damit zu den weltführenden Nationen in der Wolfram- und Uranproduktion.“"
                            },
                            {
                                "example_id": "94def742-be2f-491b-8e22-5081998edb18",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "Die DDR war, bezogen auf die Bevölkerungszahl, die weltführende Sportnation wegen Talentsichtung und -förderung und Doping."
                            },
                            {
                                "example_id": "3b256f8b-55e9-4316-9a11-12727987e504",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Die USA mit ihrem Hauptanbaugebiet Hawaii, einst weltführend im Ananasanbau, liegen mit 168.284 Tonnen auf Platz 27.“"
                            },
                            {
                                "example_id": "bf0f9e3b-a36a-463a-9bcb-b054527fc937",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„Die Chinesen fühlen sich auf einem Gebiet herausgefordert, in dem sie inzwischen erstmals vor dem Westen weltführend sind.“"
                            },
                            {
                                "example_id": "fa62dae6-a116-4d34-93b9-c8b604fbdbaa",
                                "sense_id": "d5e408b8-2601-35f8-98bc-94fd6bf7d6cc",
                                "text": "„»Die Chinesen sind weltführend bei Solarenergie, und im kommenden Jahr werden sie bei Windenergie Weltmarktführer sein. Wollen wir nur folgen, oder wollen wir selbst Anführer sein?«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
