                                        "sense_id": "5e4ce253-50c0-38e4-99ab-130b66d347f9",
                                        "entry_id": "fe447893-a635-3b0d-8c42-5552ebf376da",
                                        "glosses": [
                                            "etwas durch Gewalt an sich reißen; widerrechtlich (und gewaltsam) Privilegien, Befugnisse oder Besitz aneignen"
                                        ],
                                        "tags": [
