                    "frequency": "Middle",
                    "semantic_group_id": "flower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with bright orange <w>marigold</w> flowers.",
                            "target_lang_translations": {
                                "pl": "Ogród był pełen jasnopomarańczowych kwiatów <w>nagietka</w>."
                            }
                        },
                        {
                            "text": "She planted a row of <w>marigold</w> seeds along the garden path.",
                            "target_lang_translations": {
                                "pl": "Posadziła rząd nasion <w>nagietka</w> wzdłuż ogrodowej ścieżki."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Roślina z rodzaju nagietek, posiadająca pomarańczowe lub żółte kwiaty."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nagietek",
                                "target_lang_sense_clarification": "roślina ozdobna i lecznicza z rodzaju Calendula"
                            }
                        ]
                    }
                },
                {
