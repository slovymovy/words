                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation_figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous son <w>masque</w> de politesse, cet homme cachait une profonde antipathie envers ses collègues."
                        },
                        {
                            "text": "Il a fini par faire tomber le <w>masque</w> et par avouer toute la vérité."
                        }
                    ],
                    "common_phrases": [
                        "tomber le masque",
                        "jeter le masque"
                    ]
                }
            ]
