                                "target_senses": [
                                    {
                                        "sense_id": "59f51d89-a116-32d0-b5de-bff3ae5f1874",
                                        "entry_id": "8391e6b2-9400-3fd1-81f7-475873b68e1e",
                                        "glosses": [
                                            "A transliteration of the Russian or Ukrainian female given name Катюша (Katjuša)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9b3e89e-6719-32ac-80c8-abf83ec7b4ba",
                                        "entry_id": "8391e6b2-9400-3fd1-81f7-475873b68e1e",
                                        "glosses": [
                                            "A type of artillery rocket launcher consisting of an array of rockets mounted on a truck, originated in the Soviet Union."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c6ad698-a7e5-4eb2-b811-38a2a792b542",
                                                "sense_id": "c9b3e89e-6719-32ac-80c8-abf83ec7b4ba",
                                                "text": "The Russian Katyusha is a multiple rocket thrower of which nothing is known except what can be seen on released photographs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "542985db-0e0d-3f70-a703-3a4936bf1599",
                                        "entry_id": "8391e6b2-9400-3fd1-81f7-475873b68e1e",
                                        "glosses": [
                                            "A type of rocket which can be launched from a Katyusha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcca2ccd-04b4-4a98-a3f8-dc05b52a4e26",
                                                "sense_id": "542985db-0e0d-3f70-a703-3a4936bf1599",
                                                "text": "The development of these projectors was spurred During World War II, the Soviet Union fired Katyusha rockets from the ground or truck mounted racks. The standard Katyushas were 6 feet long, weighed 92.5 pounds, and had a range of 3 miles."
                                            },
                                            {
                                                "example_id": "a63f6f62-0c04-46d7-b4ac-98aed099536c",
                                                "sense_id": "542985db-0e0d-3f70-a703-3a4936bf1599",
                                                "text": "A curfew was clamped down on December 21 upon the Arab village of Battir, south of Jerusalem, near where security forces on December 20 found the rocket launchers from which two Katyushas were earlier fired into a Jerusalem residential area."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
