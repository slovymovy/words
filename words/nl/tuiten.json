{
    "word_family": [
        "tuit",
        "tuiting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f27e198c-6ebc-3374-bfa9-388788059147",
                    "sense_definition": "De lippen naar voren steken in een ronde vorm.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>tuitte</w> haar lippen om hem een kus te geven. ",
                            "target_lang_translations": {
                                "en": "She <w>puckered</w> her lips to give him a kiss."
                            }
                        },
                        {
                            "text": "Hij bleef zijn <w>lippen tuiten</w> toen hij nadacht. ",
                            "target_lang_translations": {
                                "en": "He kept <w>pouting</w> his lips while he was thinking."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lippen tuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To push the lips forward into a round, pointed shape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "lips"
                            },
                            {
                                "target_lang_word": "pout",
                                "target_lang_sense_clarification": "lips"
                            },
                            {
                                "target_lang_word": "purse",
                                "target_lang_sense_clarification": "lips"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ac1da39-0ab0-3e33-8b0a-bb3af0e279f8",
                    "sense_definition": "Opbollen of in een tuitvorm omhoogsteken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stof begint lichtjes te <w>tuiten</w> aan de randen. ",
                            "target_lang_translations": {
                                "en": "The fabric is starting to <w>pucker</w> slightly at the edges."
                            }
                        },
                        {
                            "text": "Door de wind zag je het zeil wat <w>tuiten</w>.",
                            "target_lang_translations": {
                                "en": "Because of the wind, you could see the sail <w>bulge</w> a bit."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To bulge or stick up in a spout-like shape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bulge",
                                "target_lang_sense_clarification": "fabric or surface"
                            },
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "fabric"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ca477a8-d5fa-3726-a84f-6a8e76ca8684",
                    "sense_definition": "Voorzien van fijne plooien of rimpeltjes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De naaister ging de kraag zorgvuldig <w>tuiten</w> voor de jurk. ",
                            "target_lang_translations": {
                                "en": "The seamstress was going to carefully <w>gather</w> the collar for the dress."
                            }
                        },
                        {
                            "text": "Het patroon laat zien hoe je de stof moet <w>tuiten</w>.",
                            "target_lang_translations": {
                                "en": "The pattern shows how you should <w>pucker</w> the fabric."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To provide with fine gathers, pleats, or folds."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gather",
                                "target_lang_sense_clarification": "fabric/sewing"
                            },
                            {
                                "target_lang_word": "pucker",
                                "target_lang_sense_clarification": "sewing folds"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "752f90b3-7d19-399e-b73a-5a797ff568fe",
                    "sense_definition": "Een scherp of suizend geluid maken, zoals in de oren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oren <w>tuiten</w> nog steeds van de harde muziek. ",
                            "target_lang_translations": {
                                "en": "My ears are still <w>ringing</w> from the loud music."
                            }
                        },
                        {
                            "text": "Na het concert bleven haar <w>oren tuiten</w>.",
                            "target_lang_translations": {
                                "en": "After the concert, her ears kept <w>ringing</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "toeten"
                    ],
                    "common_phrases": [
                        "oren tuiten"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a sharp, ringing, or buzzing sound, especially in the ears."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "of ears"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e0fe977-03cf-3a1a-86b4-d79875996953",
                    "sense_definition": "meervoud van <w>tuit</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De theepotten hebben allemaal verschillende <w>tuiten</w>.",
                            "target_lang_translations": {
                                "en": "The teapots all have different <w>spouts</w>."
                            }
                        },
                        {
                            "text": "Kijk uit dat er geen water uit de <w>tuiten</w> lekt.",
                            "target_lang_translations": {
                                "en": "Watch out that no water leaks from the <w>spouts</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of tuit (spout, nozzle)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spouts",
                                "target_lang_sense_clarification": "plural of spout"
                            },
                            {
                                "target_lang_word": "nozzles",
                                "target_lang_sense_clarification": "plural of nozzle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}