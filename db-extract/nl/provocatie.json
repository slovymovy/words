                "senses": [
                    {
                        "sense_id": "854eaa9a-47a7-34c9-b1c4-7b17a588caf6",
                        "entry_id": "88f7333f-e13d-3ea1-a8fd-a32175657f8b",
                        "glosses": [
                            "het opzettelijk oproepen van een ongewenste toestand of handeling om daarin het argument te vinden negatief op te kunnen treden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47b69c66-0135-44d7-a2be-459d800cb6e7",
                                "sense_id": "854eaa9a-47a7-34c9-b1c4-7b17a588caf6",
                                "text": "Het is onduidelijk wie de video heeft gemaakt. De tv-zender waarop de video te zien was, schreef op Facebook te zijn gehackt. Zelensky plaatste snel na het verschijnen van de nepvideo een echte video op Instagram. Hij noemt de deepfake daarin een \"kinderachtige Russische provocatie\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d2c7f2a-4add-4d34-bef0-6c01d84431a7",
                        "source_entry_id": "88f7333f-e13d-3ea1-a8fd-a32175657f8b",
                        "source_sense_id": "854eaa9a-47a7-34c9-b1c4-7b17a588caf6",
                        "target_lang_word": "Provokation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Provokation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                        "entry_id": "1e18a2d7-77c1-3535-81df-d8753e09255a",
                                        "glosses": [
                                            "Herausforderung, um bei jemandem (meist unbedachte) Reaktionen auszulösen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ee7f1e6-7830-4aac-a266-120c563a9c6f",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "Er ging nicht auf die Provokationen ein."
                                            },
                                            {
                                                "example_id": "e3e0a99c-5d35-4e70-873c-b648c20bb5b0",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Der Gebrauch von derbem Vokabular und Schimpfwörtern hatte wesentlichen Anteil an der vom Autor beabsichtigten Provokation: […]“"
                                            },
                                            {
                                                "example_id": "fb3af488-8516-4cd9-a6b3-2b6dc94f25c3",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Diese Maximalforderungen waren eine direkte Provokation der Staatsmacht.“"
                                            },
                                            {
                                                "example_id": "0d9b50ff-30b5-4235-9ff1-f182228443ae",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Die größte Provokation war aber sicher das eigentliche Motiv mit den drei Löwen.“"
                                            },
                                            {
                                                "example_id": "4bece735-7457-43cb-984f-067368061c6f",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Die Moderatoren, das waren Dietmar Schönherr und Vivi Bach: Sie mit Angst vor dem Millionenpublikum, er mit einem ordentlichen Schuss Provokation und beide mit überraschenden Ratespielen und Mutproben, zumeist von Kreativmeister André Heller ersonnen und von Michael Pfleghar (Klimbim) inszeniert.“"
                                            },
                                            {
                                                "example_id": "5a1e040c-7067-4062-82a1-cb358ca78e0c",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Es herrschen Oberflächenreize statt Sinnsuche, und dem hohen Ton der moralischen 60er und friedensbewegten 70er begegnet Lottmann mit unbeschwerten Unkorrektheiten und Provokationen.“"
                                            },
                                            {
                                                "example_id": "24f5913f-27e9-47ea-8dc9-4d0ed066f653",
                                                "sense_id": "c1a456ea-de0f-31f3-a464-816326e2e510",
                                                "text": "„Trolle nutzen Provokationen als Köder, um andere online in Gespräche zu verwickeln und so lange zu reizen, bis sie emotional reagieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c63f36f-cf25-3b99-8ddd-2d0de048734c",
                                        "entry_id": "1e18a2d7-77c1-3535-81df-d8753e09255a",
                                        "glosses": [
                                            "Medizin: gezieltes Auslösen von Krankheitssymptomen für diagnostische Zwecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94b0d935-406b-4e6a-88f4-07c0eef4f497",
                                                "sense_id": "6c63f36f-cf25-3b99-8ddd-2d0de048734c",
                                                "text": "Die diagnostische Symptomprovokation hat in der Medizin eine lange Tradition. Die Provokation mit Allergenen hilft bei der Diagnose einer Allergie."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
