                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c1b92ce3-75a8-4fbf-a5ee-c82568ebbe21",
                        "entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "profusions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                        "entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "glosses": [
                            "abundance; the state of being profuse; a cornucopia"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "532e8106-dbfc-463a-bd24-13a0a8298135",
                                "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                                "text": "His hair, in great profusion, streamed down over his shoulders."
                            },
                            {
                                "example_id": "6ba402b1-50fc-419e-b143-c40795488bbe",
                                "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                                "text": "We set the men at work felling trees, selecting for the purpose jarrah, a hard, weather-resisting timber which grew in profusion near by."
                            },
                            {
                                "example_id": "f50d4b98-8854-4c88-bf4f-69ce926316ee",
                                "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                                "text": "Although houses and factories appeared in great profusion in the 1930s, there still remain odd groups of cottages dating from an earlier and more countrified period."
                            },
                            {
                                "example_id": "5f18d392-2f8a-4d6f-9610-1e77e360a290",
                                "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                                "text": "Elegant brick and stone buildings, with iron and glass canopies and decorative wooden scalloping and fencing—all evidencing care on the part of the architect to produce a pleasing, well-planned building—were submerged beneath a profusion of ill-conceived additions and camouflaged by vulgar paint schemes; and the original conception was lost."
                            },
                            {
                                "example_id": "25f15784-d004-4eb9-804d-508f41905fcf",
                                "sense_id": "64c3bfab-6a39-30a3-8201-cb4ae1d3d638",
                                "text": "Elected leaders face a profusion of mega-pressure points these days – inflation, heat waves, high debt, or the pandemic."
                            }
                        ]
                    },
                    {
                        "sense_id": "24859671-6051-3214-833d-764bd2e2bc0d",
                        "entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "glosses": [
                            "lavish or imprudent expenditure; prodigality or extravagance"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8044ac63-2d9d-49a6-8705-52695641018f",
                        "source_entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "source_sense_description": "abundance",
                        "target_lang_word": "overvloed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overvloed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                        "entry_id": "91de9a6e-6fda-3449-a7c0-d17d16bc6758",
                                        "glosses": [
                                            "het voorhanden zijn van meer dan voldoende van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7136de4-062d-42e1-99be-94b85c3246e0",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                                            },
                                            {
                                                "example_id": "d876f1c7-8c33-4ead-867f-b69e0d307e44",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Er was een overvloed van aardbeien dat jaar."
                                            },
                                            {
                                                "example_id": "e4d7f0e0-375a-4480-bebf-e6866abf8120",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8c86562-85c6-497d-a4b4-196a299cdb02",
                        "source_entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
                        "source_sense_description": "abundance",
                        "target_lang_word": "Überfluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überfluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine über den Bedarf vorhandene Menge an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df166c37-ddca-4ef6-a704-f87c3cadb6d8",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Denn hier findet sich der ganze Wahnsinn einer Industriegesellschaft wieder, die glaubt, fossile Energie im Überfluss zu haben."
                                            },
                                            {
                                                "example_id": "dded9fc2-39ea-4bc2-bd2b-b03aa81d904a",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Sonnenenergie ist mit dem Faktor 10.000 im Überfluss vorhanden“, so Hubert Fechner, Geschäftsfeldleiter für Erneuerbare Energietechnologien bei Arsenal Research."
                                            },
                                            {
                                                "example_id": "a94f12c7-d38e-419d-8aae-2067950b546c",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Telekom-Guru George Gilder geht trotzdem davon aus, dass es Bandbreite auf Dauer im Überfluss gibt."
                                            },
                                            {
                                                "example_id": "2d11cd30-9e35-4dec-8076-d21e238b9a27",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Auch Diogenes wurde von Seneca als weiser Mann bezeichnet, weil er dem Überfluss entsagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine Lebenslage, die mehr als das zum Leben Notwendige bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef74b8d4-2d73-4b41-927a-30475726d9ac",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "\"Was krank macht, ist gut; was aus der Fülle, aus dem Überfluss, aus der Macht kommt, ist böse\" so empfindet der Gläubige."
                                            },
                                            {
                                                "example_id": "1b614335-8d16-4bd6-9ccc-02805a2311a8",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Dem zufälligen Mangel in einer einzelnen Provinz wurde sofort durch den Überfluss ihrer begünstigteren Nachbarn abgeholfen."
                                            },
                                            {
                                                "example_id": "fb6912b6-8bf0-474e-a5e9-c5bdc8978c85",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Ein Mann aber trat aus der Menge heraus und sprach voll Bitterkeit und sagte: \"Herr weißt du nicht, dass das Leben der Armen aus dem Überfluss des Reichen strömt? …\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be910ad1-894c-41df-91b2-dd7fb447358a",
                        "source_entry_id": "c1b15a0b-d00f-3976-92a3-822ab1f8d1ec",
