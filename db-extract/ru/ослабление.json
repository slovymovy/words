                                        "sense_id": "b4d8eff8-3f50-3bb1-ab6d-8630402f13a6",
                                        "entry_id": "fea5139a-57ac-38d1-9a3e-20c204fd8688",
                                        "glosses": [
                                            "The act by which something slackens; loss of speed, tautness, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b39fcb-7418-4658-a196-c23862a65887",
                                                "sense_id": "b4d8eff8-3f50-3bb1-ab6d-8630402f13a6",
                                                "text": "If the following guide lose his distance from the one leading (which can only happen by his own fault), he will correct himself by slightly lengthening or shortening a few steps, in order that there may not be sudden quickenings or slackenings in the march of his platoon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f869785d-2720-4e3e-8131-822cad4e24a5",
                        "source_entry_id": "e61ae114-45b3-368e-b1e7-5499971d8d8b",
                        "source_sense_id": "a6a1aeed-f594-362d-85e3-4c340bc88c25",
                        "target_lang_word": "Abschwächung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschwächung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c042161-2289-3c55-b9ea-ff62d64cba01",
                                        "entry_id": "4a56aeeb-16c2-337f-843f-a4e6e71439a8",
                                        "glosses": [
                                            "die Verringerung der Stärke oder Intensität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8181a67-37b8-4c4f-be34-45193c3d8f3e",
                                                "sense_id": "5c042161-2289-3c55-b9ea-ff62d64cba01",
                                                "text": "„Dass ein und dasselbe Element sowohl zur Abschwächung (wohl) wie auch zur Verstärkung (wohl) einer Aussage gebraucht werden kann, mag zunächst verwundern.“"
                                            },
                                            {
                                                "example_id": "2a1b552f-8305-4f04-b4bb-cd28ee96c5f0",
                                                "sense_id": "5c042161-2289-3c55-b9ea-ff62d64cba01",
                                                "text": "„Als der wichtigste Unterschied zwischen dem Althochdeutschen und dem Mittelhochdeutschen erweist sich die Abschwächung der unbetonten Silben und ihre Kennzeichnung in der Schrift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e0e4823-0262-4733-a54b-83329a47255d",
                        "source_entry_id": "e61ae114-45b3-368e-b1e7-5499971d8d8b",
                        "source_sense_id": "a6a1aeed-f594-362d-85e3-4c340bc88c25",
                        "target_lang_word": "affaiblissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affaiblissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "État de ce qui est affaibli."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "041bfe0d-4bd2-432e-800b-bfa776fe482b",
                                                "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                                "text": "Le défaut d'exercice, le confinement dans une atmosphère très-limitée, sont des causes d’affaiblissement de l’organisme, et par suite des causes prédisposantes de la tuberculose."
                                            },
                                            {
                                                "example_id": "e97bd1d8-9d18-488b-a648-066e910eed44",
                                                "sense_id": "1dd8c665-3d35-376d-93d5-aa19d7e194c6",
                                                "text": "Quant au comté de Flandre, sa dépendance politique envers la France l’entraîna, malgré lui et contre ses intérêts traditionnels, dans les conséquences de l’affaiblissement de la monnaie royale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa8295fd-c8c1-34bd-a1be-8c81dfb3259e",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "Diminution d’une puissance électrique, acoustique ou électromagnétique entre deux points."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5c7916c5-4467-33d9-a58b-ecbc0ee6f342",
                                        "entry_id": "78190d47-cfb1-3782-8f69-655c91a55cb2",
                                        "glosses": [
                                            "Expression quantitative de cette diminution par le rapport, généralement en décibels, de la valeur en deux points d’une puissance ou d’une grandeur qui est liée à la puissance par une relation bien définie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ec4e32-3414-4f61-8db2-4c5d9e7681ce",
                                                "sense_id": "5c7916c5-4467-33d9-a58b-ecbc0ee6f342",
                                                "text": "L'ARCEP a dans un premier temps ouvert le Re-ADSL2 aux lignes dont l'affaiblissement est inférieur à 75 dB et a défini un mode de calcul de cette valeur théorique d'affaiblissement de la ligne. En décembre 2005, la valeur maximale d'affaiblissement validant l'éligibilité aux offres commerciales Re-ADSL2 a été repoussée à 78 dB."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
