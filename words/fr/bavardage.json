                    ]
                },
                {
                    "sense_id": "432b6dc8-cd35-3456-9410-f74ccff9930c",
                    "sense_definition": "Cri répété et continu émis par certains oiseaux, en particulier la pie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au lever du jour, le <w>bavardage</w> des pies dans le grand cerisier réveillait toute la maisonnée."
                        },
                        {
                            "text": "Le garde forestier reconnaissait facilement la présence d'un intrus au <w>bavardage</w> alarmé des pies."
