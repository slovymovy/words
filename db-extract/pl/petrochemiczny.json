                                        "entry_id": "7cde6a46-ba12-3945-bb57-e0de12c96f6a",
                                        "glosses": [
                                            "Of or pertaining to the such compounds, or the industry that produces them."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29181f8b-6635-4dec-bd6a-7ec2b910a4a8",
                                                "sense_id": "e807a3d5-90e2-36df-b902-541cb99a27a9",
                                                "text": "In 2006, about 6 percent of the world's crude oil production was used in non-energy applications, primarily as a petrochemical feedstock."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
