                                "target_lang_sense_clarification": "odd or out of the ordinary"
                            },
                            {
                                "target_lang_word": "peculiar",
                                "target_lang_sense_clarification": "distinctive in a strange way"
                            },
                            {
                                "target_lang_word": "odd",
                                "target_lang_sense_clarification": "differing from what is normal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b09fa7-d7a6-30db-ac47-1abe0db653aa",
                    "sense_definition": "de moeite waard om op te merken of aandacht aan te besteden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opvallend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>merkwaardig</w> feit dat deze plant alleen in de winter bloeit.",
                            "target_lang_translations": {
