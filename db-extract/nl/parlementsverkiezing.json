                "senses": [
                    {
                        "sense_id": "0e115855-5254-38a8-9769-054414a90871",
                        "entry_id": "167927d1-b395-3573-8cda-1faddb88efaf",
                        "glosses": [
                            "de volksraadpleging om te bepalen wie de leden van de volksvertegenwoordiging worden in het parlement"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23949477-07e5-4e1b-bd2c-1b7c5c2c82c8",
                                "sense_id": "0e115855-5254-38a8-9769-054414a90871",
                                "text": "De Tweede Kamerverkiezingen in Nederland zijn parlementsverkiezingen"
                            },
                            {
                                "example_id": "617fe2f1-5150-43a9-a234-dd949314f9a1",
                                "sense_id": "0e115855-5254-38a8-9769-054414a90871",
                                "text": "Tijdens de parlementsverkiezing werd hij met voorkeurstemmen verkozen."
                            },
                            {
                                "example_id": "c55f39a4-cb0d-4bfe-9574-bc9f3fecf4ad",
                                "sense_id": "0e115855-5254-38a8-9769-054414a90871",
                                "text": "Volgende maand zijn er parlementsverkiezingen in Frankrijk. Die zijn cruciaal voor Macrons beleidsplannen. Met de ervaren Borne aan zijn zijde hoopt hij meer kiezers te trekken."
                            },
                            {
                                "example_id": "bdd71229-7f01-44fa-bbd2-60b4e690fc6f",
                                "sense_id": "0e115855-5254-38a8-9769-054414a90871",
                                "text": "In het algemeen is het meervoud verkiezingen het gebruikelijkst. Zo kun je verkiezingen uitschrijven of houden, en heb je het meestal over Tweede Kamerverkiezingen, Provinciale Statenverkiezingen en gemeenteraadsverkiezingen. Het enkelvoudige verkiezing hoort vaak bij het kiezen van één persoon."
                            }
                        ]
                    }
