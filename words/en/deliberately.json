{
    "word_family": [
        "deliberate",
        "deliberation",
        "deliberative"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3ff81719-195f-35a4-bea9-171f464aba58",
                    "sense_definition": "In a way that is intentional or planned, rather than by accident.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intentionality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>deliberately</w> broke the vase just to make his sister angry.",
                            "target_lang_translations": {
                                "ru": "Он <w>намеренно</w> разбил вазу, просто чтобы разозлить сестру."
                            }
                        },
                        {
                            "text": "The witness was accused of <w>deliberately</w> misleading the jury during the trial.",
                            "target_lang_translations": {
                                "ru": "Свидетеля обвинили в том, что он <w>умышленно</w> ввел присяжных в заблуждение во время процесса."
                            }
                        }
                    ],
                    "synonyms": [
                        "intentionally",
                        "purposely",
                        "on purpose",
                        "willfully"
                    ],
                    "antonyms": [
                        "accidentally",
                        "unintentionally",
                        "inadvertently"
                    ],
                    "common_phrases": [
                        "deliberately misleading",
                        "deliberately ignore",
                        "deliberately chosen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преднамеренно или спланированно, а не случайно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намеренно",
                                "target_lang_sense_clarification": "сознательно, имея умысел"
                            },
                            {
                                "target_lang_word": "умышленно",
                                "target_lang_sense_clarification": "с заранее обдуманным намерением"
                            },
                            {
                                "target_lang_word": "нарочно",
                                "target_lang_sense_clarification": "с определенной целью, часто назло"
                            },
                            {
                                "target_lang_word": "сознательно",
                                "target_lang_sense_clarification": "осмысленно, понимая последствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9793113-f44f-33ad-a757-951c6e41f58c",
                    "sense_definition": "In a slow, careful, and unhurried manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man walked <w>deliberately</w> across the icy road to avoid falling.",
                            "target_lang_translations": {
                                "ru": "Старик <w>осторожно</w> шел по обледенелой дороге, чтобы не упасть."
                            }
                        },
                        {
                            "text": "She spoke <w>deliberately</w> and slowly to ensure everyone understood her instructions.",
                            "target_lang_translations": {
                                "ru": "Она говорила <w>размеренно</w> и медленно, чтобы все поняли ее инструкции."
                            }
                        }
                    ],
                    "synonyms": [
                        "slowly",
                        "carefully",
                        "cautiously",
                        "unhurriedly"
                    ],
                    "antonyms": [
                        "hastily",
                        "hurriedly",
                        "rashly"
                    ],
                    "common_phrases": [
                        "walk deliberately",
                        "speak deliberately",
                        "move deliberately"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медленно, осторожно и без спешки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неторопливо",
                                "target_lang_sense_clarification": "спокойно и размеренно"
                            },
                            {
                                "target_lang_word": "осторожно",
                                "target_lang_sense_clarification": "с осмотрительностью"
                            },
                            {
                                "target_lang_word": "медленно",
                                "target_lang_sense_clarification": "с малой скоростью"
                            },
                            {
                                "target_lang_word": "размеренно",
                                "target_lang_sense_clarification": "в определенном ритме, без суеты"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}