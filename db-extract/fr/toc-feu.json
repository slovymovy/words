                        "entry_id": "89f05dfe-43d6-3614-b450-a701b891562c",
                        "glosses": [
                            "Grille ou chaudron rempli de charbon allumé et que l’on descend dans le puits des mines pour en faciliter l’aérage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6efe3e2b-69da-4960-83e4-a8f18abfa5ad",
                                "sense_id": "500b6a52-19d1-3aab-b619-49294dc37b61",
                                "text": "Le feu des grilles des bures d'airage , ou toc-feu, lorsqu’il sera reconnu utile à la circulation de l’air, devra être entretenu continuellement, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "de6f13c1-b8b6-3255-9eef-4432084c9faa",
                        "entry_id": "89f05dfe-43d6-3614-b450-a701b891562c",
                        "glosses": [
                            "Fourneau ou chaudière d’une machine à vapeur équipé d’une grande cheminée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4e2f2004-81df-4bbd-8640-8acaea643c01",
                                "sense_id": "de6f13c1-b8b6-3255-9eef-4432084c9faa",
                                "text": "Vers 1853, on installe un autre foyer au dessus du puits N°7, c’est le toc-feu qui est un gros fourneau avec une haute cheminée (15 à 20 mètres)."
                            }
                        ]
                    }
