{
    "word_family": [
        "lessen",
        "lesser",
        "unless"
    ],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "7561f9eb-4894-31be-94d7-076cbd7f4753",
                    "sense_definition": "A smaller amount of; not as much, typically used with uncountable nouns.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I try to drink <w>less</w> coffee in the afternoon so I can sleep better.",
                            "target_lang_translations": {
                                "ru": "Я стараюсь пить <w>меньше</w> кофе во второй половине дня, чтобы лучше спать."
                            }
                        },
                        {
                            "text": "The recipe requires <w>less</w> sugar than the original version.",
                            "target_lang_translations": {
                                "ru": "Для этого рецепта требуется <w>меньше</w> сахара, чем в оригинальной версии."
                            }
                        }
                    ],
                    "antonyms": [
                        "more"
                    ],
                    "common_phrases": [
                        "less sugar",
                        "less time",
                        "less money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меньшее количество чего-либо; не так много (обычно с неисчисляемыми существительными)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньше",
                                "target_lang_sense_clarification": "с неисчисляемыми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de5f6c70-2efd-3a87-a2bf-a6ba0c203064",
                    "sense_definition": "A smaller number of; used as a synonym for 'fewer' in informal contexts with countable nouns.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There are <w>less</w> people at the party than I expected.",
                            "target_lang_translations": {
                                "ru": "На вечеринке <w>меньше</w> людей, чем я ожидал."
                            }
                        },
                        {
                            "text": "If we have <w>less</w> problems to solve, we can finish the project early.",
                            "target_lang_translations": {
                                "ru": "Если у нас будет <w>меньше</w> проблем, которые нужно решить, мы сможем закончить проект раньше."
                            }
                        }
                    ],
                    "antonyms": [
                        "more"
                    ],
                    "common_phrases": [
                        "less people",
                        "less problems",
                        "less things"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used instead of 'fewer' with countable nouns"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Меньшее число чего-либо; используется как синоним 'fewer' в разговорной речи с исчисляемыми существительными."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньше",
                                "target_lang_sense_clarification": "с исчисляемыми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20a28af9-06c2-3bab-a07a-725de7876d28",
                    "sense_definition": "The comparative form of <w>little</w>; of inferior size, degree, or extent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angle of the slope was <w>less</w> than forty-five degrees.",
                            "target_lang_translations": {
                                "ru": "Угол наклона был <w>меньше</w> сорока пяти градусов."
                            }
                        },
                        {
                            "text": "A distance of six miles is <w>less</w> than seven.",
                            "target_lang_translations": {
                                "ru": "Расстояние в шесть миль — это <w>меньше</w>, чем семь."
                            }
                        }
                    ],
                    "antonyms": [
                        "greater"
                    ],
                    "common_phrases": [
                        "less than"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень от 'little'; меньший по размеру, степени или объему."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньше",
                                "target_lang_sense_clarification": "по размеру или степени"
                            },
                            {
                                "target_lang_word": "менее",
                                "target_lang_sense_clarification": "в сравнениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ca7c4c72-7a1f-35c2-94da-4ff0baa2aa29",
                    "sense_definition": "Used for constructing the comparative degree of adjectives and adverbs to indicate a lower degree.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new smartphone is <w>less</w> expensive than the previous model.",
                            "target_lang_translations": {
                                "ru": "Этот новый смартфон <w>менее</w> дорогой, чем предыдущая модель."
                            }
                        },
                        {
                            "text": "The movie was <w>less</w> interesting than the book it was based on.",
                            "target_lang_translations": {
                                "ru": "Фильм был <w>менее</w> интересным, чем книга, на которой он основан."
                            }
                        }
                    ],
                    "antonyms": [
                        "more"
                    ],
                    "common_phrases": [
                        "less expensive",
                        "less important",
                        "less likely"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для образования сравнительной степени прилагательных и наречий для указания на более низкую степень качества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "менее",
                                "target_lang_sense_clarification": "перед прилагательными"
                            },
                            {
                                "target_lang_word": "не так",
                                "target_lang_sense_clarification": "в значении 'не настолько'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf6e1b8-ad4f-3279-b96a-aab85abf264a",
                    "sense_definition": "The comparative degree of <w>little</w>; to a smaller extent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I slept even <w>less</w> last night than I did the night before.",
                            "target_lang_translations": {
                                "ru": "Прошлой ночью я спал еще <w>меньше</w>, чем позапрошлой."
                            }
                        },
                        {
                            "text": "He seems to care <w>less</w> about his grades lately.",
                            "target_lang_translations": {
                                "ru": "В последнее время его, кажется, <w>меньше</w> заботят его оценки."
                            }
                        }
                    ],
                    "antonyms": [
                        "more"
                    ],
                    "common_phrases": [
                        "even less",
                        "much less"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сравнительная степень от 'little'; в меньшей степени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньше",
                                "target_lang_sense_clarification": "в меньшей степени"
                            },
                            {
                                "target_lang_word": "менее",
                                "target_lang_sense_clarification": "более формально"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4f59a745-1518-3db4-82f8-42ab7f704cc6",
                    "sense_definition": "A smaller amount or quantity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sometimes <w>less</w> is more when it comes to interior design.",
                            "target_lang_translations": {
                                "ru": "Иногда <w>меньшее</w> — это больше, когда речь идет о дизайне интерьера."
                            }
                        },
                        {
                            "text": "I have <w>less</w> to do today than I had yesterday.",
                            "target_lang_translations": {
                                "ru": "Сегодня мне нужно сделать <w>меньше</w>, чем вчера."
                            }
                        }
                    ],
                    "antonyms": [
                        "more"
                    ],
                    "common_phrases": [
                        "less is more"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меньшее количество или объем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньшее",
                                "target_lang_sense_clarification": "как существительное"
                            },
                            {
                                "target_lang_word": "меньше",
                                "target_lang_sense_clarification": "в значении 'меньшее количество'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3fd27c65-16ec-33af-bfb2-9d9b4545cfc3",
                    "sense_definition": "Lesser or smaller in size or importance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The issue was resolved to a greater or <w>less</w> extent by the committee.",
                            "target_lang_translations": {
                                "ru": "Вопрос был решен комитетом в большей или <w>меньшей</w> степени."
                            }
                        },
                        {
                            "text": "He was upset by a <w>less</w> matter than his brother's failure.",
                            "target_lang_translations": {
                                "ru": "Он расстроился из-за куда <w>меньшего</w> повода, чем неудача его брата."
                            }
                        }
                    ],
                    "synonyms": [
                        "lesser",
                        "smaller"
                    ],
                    "antonyms": [
                        "greater"
                    ],
                    "common_phrases": [
                        "greater or less"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меньший по размеру или важности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "меньший",
                                "target_lang_sense_clarification": "по значению"
                            },
                            {
                                "target_lang_word": "незначительный",
                                "target_lang_sense_clarification": "о проблеме или деле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "20afd7d0-0540-3939-b469-a6810d5b9c61",
                    "sense_definition": "Minus; not including or after subtracting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total cost will be one hundred dollars <w>less</w> the initial deposit.",
                            "target_lang_translations": {
                                "ru": "Общая стоимость составит сто долларов <w>минус</w> первоначальный взнос."
                            }
                        },
                        {
                            "text": "He earned a high salary <w>less</w> the taxes deducted by the state.",
                            "target_lang_translations": {
                                "ru": "Он получал высокую зарплату <w>за вычетом</w> налогов, удерживаемых государством."
                            }
                        }
                    ],
                    "synonyms": [
                        "minus"
                    ],
                    "antonyms": [
                        "plus"
                    ],
                    "common_phrases": [
                        "less the cost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Минус; не включая или за вычетом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минус",
                                "target_lang_sense_clarification": "при вычитании"
                            },
                            {
                                "target_lang_word": "за вычетом",
                                "target_lang_sense_clarification": "о налогах или депозитах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "151e0d05-a2b5-3e58-a9f1-a66fdfe7ee74",
                    "sense_definition": "To make less; to decrease or diminish.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long illness had not <w>lessed</w> the warmth of his affections.",
                            "target_lang_translations": {
                                "ru": "Долгая болезнь не <w>уменьшила</w> теплоту его привязанностей."
                            }
                        },
                        {
                            "text": "The scattered beauties in the air have <w>lessed</w> the woe of the travelers.",
                            "target_lang_translations": {
                                "ru": "Разлитая в воздухе красота <w>умерила</w> печаль путешественников."
                            }
                        }
                    ],
                    "synonyms": [
                        "lessen",
                        "diminish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшать, делать меньше (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уменьшать",
                                "target_lang_sense_clarification": "делать меньше"
                            },
                            {
                                "target_lang_word": "ослаблять",
                                "target_lang_sense_clarification": "о чувствах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "05fc53bf-46a4-3871-a39e-196c6377b6c4",
                    "sense_definition": "A shortened form of <w>unless</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is too good for you, <w>'less</w> you had the grace to follow it.",
                            "target_lang_translations": {
                                "ru": "Это слишком хорошо для тебя, <w>если только</w> у тебя не хватит благородства последовать этому."
                            }
                        },
                        {
                            "text": "I won't go <w>'less</w> you come with me.",
                            "target_lang_translations": {
                                "ru": "Я не пойду, <w>если</w> ты не пойдешь со мной."
                            }
                        }
                    ],
                    "synonyms": [
                        "unless"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "poetic or dialectal shortening"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма союза 'unless' (если не)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "если не",
                                "target_lang_sense_clarification": "условие"
                            },
                            {
                                "target_lang_word": "разве что",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}