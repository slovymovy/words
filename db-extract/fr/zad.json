        "fr-extract.jsonl": [
            {
                "entry_id": "11c42522-fa42-3341-b181-b8c413fc6bf5",
                "word": "ZAD",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25b91ef6-65c8-3dd7-90cb-418d616f905d",
                        "entry_id": "11c42522-fa42-3341-b181-b8c413fc6bf5",
                        "glosses": [
                            "Zone d’aménagement différé, dotée d’un statut juridique donné à des terrains nécessaires à la réalisation d’un projet d’aménagement public afin d’éviter un renchérissement de leur prix."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "4e9f3461-5151-47c3-9d6f-44e5feb40974",
                                "sense_id": "25b91ef6-65c8-3dd7-90cb-418d616f905d",
                                "text": "Les collectivités publiques disposent, dans les ZUP et les ZAD, d’un droit de préemption."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1d66efd-088f-3dc9-b897-cb38613c48b5",
                        "entry_id": "11c42522-fa42-3341-b181-b8c413fc6bf5",
                        "glosses": [
                            "Zone à défendre (par rétroacronymie)."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "97a57508-bdd2-4e3c-8580-d454d262bb86",
                                "sense_id": "c1d66efd-088f-3dc9-b897-cb38613c48b5",
                                "text": "Une ZAD, c’est étrange. C’est un agrégat ponctuel de gens qui sont plus unis par ce qui les oppose à quelque chose que par ce qui les rassemble."
                            },
                            {
                                "example_id": "7602a9f0-7be9-4d63-8f39-ddca91e8e834",
                                "sense_id": "c1d66efd-088f-3dc9-b897-cb38613c48b5",
                                "text": "Ces dernières années, la France a vu se développer les ZAD (zones à défendre), un pied de nez à l’acronyme officiel (zone d’aménagement différé)."
                            },
                            {
                                "example_id": "b0affae2-b06a-4726-a9b8-bb6efcf7123a",
                                "sense_id": "c1d66efd-088f-3dc9-b897-cb38613c48b5",
                                "text": "À côté de Rochefort (Charente-Maritime), une équipe de jeunes gens se relaie sur un campement installé à l’endroit où devrait être construit un incinérateur de déchets géant. Ils s’opposent au projet et, depuis janvier, l’endroit a été déclaré ZAD – zone à défendre –, comme Notre-Dame-des-Landes ou le barrage de Sivens."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f3308ec-7df3-3aff-a4da-4d7911b68ce3",
                        "entry_id": "11c42522-fa42-3341-b181-b8c413fc6bf5",
                        "glosses": [
                            "Abréviation de zone aéroportuaire de débarquement."
                        ],
                        "tags": [],
                        "examples": []
                    }
