                "senses": [
                    {
                        "sense_id": "0ff4165c-eb0e-3099-8bcd-c9a086eb2f7b",
                        "entry_id": "7e937d29-b09c-3571-b5fb-7c76e2a130cb",
                        "glosses": [
                            "Gesellschaft der heiligen Ursula (Ordo Sanctae Ursulae), ein Frauenorden, der sich auch in Schulen und Internaten um die Mädchenerziehung kümmert"
                        ],
                        "tags": [
                            "Katholizismus",
                            "im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "59426761-c569-42e5-87d8-a037f44bd88d",
                                "sense_id": "0ff4165c-eb0e-3099-8bcd-c9a086eb2f7b",
                                "text": "„Wem diese Gedanken unzulässig modern erscheinen, möge bedenken, daß Angela Merici, die Gründerin der Ursulinen, ihre ersten Schwestern im damals üblichen Kleid an die Arbeit schickte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c8cfb22e-7a6c-3d9b-9553-9d7f0fe6f582",
                        "entry_id": "7e937d29-b09c-3571-b5fb-7c76e2a130cb",
                        "glosses": [
                            "eine Schwester dieses Ordens"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "bf41812d-9461-4edd-8d89-204d61a800d7",
                                "sense_id": "c8cfb22e-7a6c-3d9b-9553-9d7f0fe6f582",
                                "text": "„Xainctonge setzte durch, dass die Ursulinen nicht im Kloster leben mussten und ihre Zeit der Krankenpflege, der Fürsorge der Armen und der Erziehung von Mädchen widmen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
