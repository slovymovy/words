                        "examples": [
                            {
                                "example_id": "ae3e6063-76ef-48d3-b8b2-d82a4a837e37",
                                "sense_id": "4a9d74fb-152d-34dd-b107-d3b4a7188942",
                                "text": "„Das Kokaingeschäft sollte Pablo Escobar und seine kriminellen Kollegen von Antioquia, darunter die Brüder Ochoa, Carlos Lehder und José Rodríguez Gacha, reicher machen, als sie es sich in ihren wildesten Fantasien ausgemalt hatten.“"
                            },
                            {
                                "example_id": "26aeb023-063f-4afb-a6ab-56bef1b30a4a",
                                "sense_id": "4a9d74fb-152d-34dd-b107-d3b4a7188942",
                                "text": "„Für den Paten von Medellín ist das Kokaingeschäft einfach.“"
                            },
                            {
                                "example_id": "5da811cd-3bd9-4806-a3bf-c16431063222",
                                "sense_id": "4a9d74fb-152d-34dd-b107-d3b4a7188942",
                                "text": "„›Malcolm ist hinterher groß ins Kokaingeschäft eingestiegen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
