                    {
                        "sense_id": "1d50366a-b175-3e08-bedd-03959453987d",
                        "entry_id": "f3a829ca-3046-366e-844e-191034a4bd2f",
                        "glosses": [
                            "Landwirt, der die Ernte einer seiner Anbauflächen im Voraus zu einem Pauschalpreis und zu festgelegten Konditionen verkauft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf9f7e3-86ef-43b9-a3ce-b618fe91685c",
                                "sense_id": "1d50366a-b175-3e08-bedd-03959453987d",
                                "text": "„„Wir arbeiten mit rund 700 Vertragslandwirten zusammen“, sagt Heil.“"
                            },
                            {
                                "example_id": "c6c55271-c33a-4aed-8570-b3dd1f0dd40c",
                                "sense_id": "1d50366a-b175-3e08-bedd-03959453987d",
                                "text": "„In den Feuchtwiesenschutzgebieten steht die Pflanzenwelt in einer engen Wechselwirkung mit dem Wasserhaushalt, Nährstoffhaushalt und der Bewirtschaftung durch den Vertragslandwirt.“"
                            },
                            {
                                "example_id": "6950b4ad-3b2e-45f1-8695-874d14eaa80b",
                                "sense_id": "1d50366a-b175-3e08-bedd-03959453987d",
                                "text": "„Über 100 Vertragslandwirte arbeiten für Iglo.“"
                            }
                        ],
