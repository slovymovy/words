                ],
                "senses": [
                    {
                        "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                        "entry_id": "a9ef0a99-5e62-3883-93eb-d4203efdd748",
                        "glosses": [
                            "elektromagnetische Wellen im Bereich von 30 Zentimetern bis zu 1 Millimeter Wellenlänge (1 bis 300 Gigahertz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8feb209-4c89-4cef-b43c-1a684b1dac0f",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Diese Mikrowellenstrahlung ist als kosmische Hintergrundstrahlung bekannt.“"
                            },
                            {
                                "example_id": "8147c5af-df04-40c4-8e9a-b5db85e47005",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„In der Zwischenzeit haben Satelliten die kosmische Mikrowellenstrahlung vielfach bestätigt und immer genauer gemessen.“"
                            },
                            {
                                "example_id": "5a6850b1-dc0e-480a-bdf0-a4c4a58d2ade",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Die Entdeckung der Mikrowellenstrahlung bestätigte die Urknalltheorie auf eindrucksvolle Weise.“"
                            },
                            {
                                "example_id": "83718f61-ec95-4372-b312-33cce3a54faa",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Die roten und blauen Flecke repräsentieren Abweichungen von der mittleren Temperatur der Mikrowellenstrahlung.“"
                            },
                            {
                                "example_id": "9dfe10e7-fc2b-4729-b974-54a55ddcc92e",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Sind die Wirkungen der Mikrowellenstrahlung in der Atmosphäre für unser Leben die gleichen wie für unser Essen in der Mikrowelle zu Hause?“"
                            },
                            {
                                "example_id": "1bca8c15-f34a-48ce-8a09-ad1203e109fe",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Das Wichtigste in Kürze: ESR-Spektrometer bestehen aus einer Quelle für Mikrowellenstrahlung, einem Probenraum, einem Detektor und einem Elektromagneten.“"
                            },
                            {
                                "example_id": "0340b11e-588c-4041-9c89-a7a06d8a897d",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Der Großteil aller Fremdkörper, Mikrowellenstrahlung, elektromagnetische Felder, Ultraschall oder mechanische Traumata weisen demgegenüber keine karzinogene Wirkung auf.“"
                            },
                            {
                                "example_id": "f9acf693-a1d9-4b18-9011-ec3b9b439f63",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Die Stärke der Mikrowellenstrahlung und die benutzten Frequenzen sind viel zu niedrig, um eine merkliche Erwärmung auszulösen.“"
                            },
                            {
                                "example_id": "4db59610-a35f-43ba-a7d4-5aead3544d3c",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Als ‚Thermometer‘ nutzen die EUMETSAT-Forscher die Mikrowellenstrahlung, die schwingende Sauerstoffmoleküle der Atmosphäre aussenden.“"
                            },
                            {
                                "example_id": "f5776efb-9efe-4d56-8aa7-62963ac70f72",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Diese langwellige Mikrowellenstrahlung wurde im Jahre 1964 zufällig von Physikern der Bell-Forschungslaboratorien in Murray Hill entdeckt.“"
                            },
                            {
                                "example_id": "5b7c9c9f-1ce6-45b4-b63f-b8d1e805773e",
                                "sense_id": "b270d7f0-e9f7-3d46-a1f8-e31901b2dbc8",
                                "text": "„Da Photonen wie alle anderen Teilchen durch die Gravitation beeinflusst werden, musste die Bildung dieser Objekte eigentlich zu kleinen Temperaturschwankungen der kosmischen Mikrowellenstrahlung führen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
