                                            {
                                                "example_id": "c5fbc3af-ab6d-447e-8c59-048bfd4a24bc",
                                                "sense_id": "d26190a2-10b2-3e70-8fca-4f71a7c07a0f",
                                                "text": "Pardon me, but that is not true."
                                            }
