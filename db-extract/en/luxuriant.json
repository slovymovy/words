                    {
                        "translation_id": "132bb664-2eec-46a6-9d54-0308eef91667",
                        "source_entry_id": "71bdc147-8872-38bd-804f-a5d779945ba3",
                        "source_sense_id": "8044ba56-26c5-3d32-bf2c-f0ec1e870a04",
