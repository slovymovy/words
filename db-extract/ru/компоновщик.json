                    {
                        "translation_id": "3ad289a3-4296-4047-90da-81da183fe285",
                        "source_entry_id": "99131fe1-ecda-3b79-b06c-7458ac337228",
                        "source_sense_id": "0f6c9527-c1b7-322a-b192-2aef65f7fbc6",
                        "target_lang_word": "Binder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Binder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9af486bc-1a90-3e2d-8f58-a1b4a888da45",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "um den Hals gebundenes Kleidungsstück"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a3205b-2a49-4066-8246-089be1131465",
                                                "sense_id": "9af486bc-1a90-3e2d-8f58-a1b4a888da45",
                                                "text": "„Legen Sie den Binder um den Hals und justieren Sie die Länge.“"
                                            },
                                            {
                                                "example_id": "37e2100e-0f4f-431f-af33-7c74bcb82143",
                                                "sense_id": "9af486bc-1a90-3e2d-8f58-a1b4a888da45",
                                                "text": "„Der Papa sprang auf und fasste sich an seinen Binder, als sei er ihm zu eng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5acb5b18-c62d-3a4a-bb59-8c77a4a6cf5a",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "kurz für Mähbinder, eine landwirtschaftliche Maschine zur Ernte von Getreide"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe9d1cf-b3eb-40f7-bc51-c91f0b00a671",
                                                "sense_id": "5acb5b18-c62d-3a4a-bb59-8c77a4a6cf5a",
                                                "text": "„Der Binder mäht, bindet, und befördert das Getreide gleichzeitig zur Seite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58cc5fb8-f788-3d23-aa77-0e183a6a49a4",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "horizontales, tragendes Konstruktionselement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a614f3f7-a4be-4114-bea9-a2d85536c747",
                                                "sense_id": "58cc5fb8-f788-3d23-aa77-0e183a6a49a4",
                                                "text": "„Die Bohlen geben dem Dach nur die Form; der tragende Teil sind in erster Linie die Sparren und dann die Binder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5baee246-7889-3a25-8aa6-3e8548d26931",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Mauerstein, der quer eingemauert ist, so dass die Schmalseite sichtbar ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "653bcde1-3e3b-4597-9647-b8a64f4119ab",
                                                "sense_id": "5baee246-7889-3a25-8aa6-3e8548d26931",
                                                "text": "„Die Quader jeder Mauer haben die gleiche rechteckige Gestalt, so daß die durch die Mauer reichenden Binder von den in der Mitte der Mauer gestoßenen Läufern sich äußerlich nicht unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "087bf5a6-7fe9-3c7e-97e7-134f7585bde9",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Bindemittel, z.B. für Mörtel, Estrich, Farben, sonstige Produkte der Bauchemie, Trag- und Deckschichten im Straßenbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d53cde1-9390-411a-9bfe-3fcb10b1b566",
                                                "sense_id": "087bf5a6-7fe9-3c7e-97e7-134f7585bde9",
                                                "text": "„Infolge ihres hohen Gehaltes an fetten Ölen darf der Binder nur mit Terpentinölersatz verdünnt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "da83abd9-9eed-33eb-8b86-3a44741749ee",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Böttcher"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c5143f8-d77e-421c-85f5-111392d8a7a0",
                                                "sense_id": "da83abd9-9eed-33eb-8b86-3a44741749ee",
                                                "text": "„Das Faß selbst machte der Binder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "5f9a254f-86a6-3c3a-8918-c4aec22e3ef1",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Person, die etwas bindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3678a93b-37db-4065-8589-2862e50f2824",
                                                "sense_id": "5f9a254f-86a6-3c3a-8918-c4aec22e3ef1",
                                                "text": "„Die Disteln bereiteten dem Mäher wenig, dem Binder jedoch viel Probleme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "80302fa1-5977-3ec2-b207-c8a74d8b104c",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Computerprogramm, welches einzelne Module zu einem ausführbaren Programm zusammenstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46038f2f-5a5e-4044-acd6-5a6e6ec04453",
                                                "sense_id": "80302fa1-5977-3ec2-b207-c8a74d8b104c",
                                                "text": "„Die ersten drei Werkzeuge (der Editor, der Übersetzer und der Binder) reichen im Prinzip für die Produktion von Programmen auf einer höheren Programmiersprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                        "entry_id": "5055f0fe-098b-30a0-a6d6-fb37c62ad8f0",
                                        "glosses": [
                                            "Hilfsmittel für Transmänner zum Wegbinden der weiblichen Brüste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "927d6cbd-4313-4181-8846-d4ebf9fed15e",
                                                "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                                "text": "„Ein Binder dient zum Verstecken und ‚Wegbinden‘ der weiblichen Brust.“"
                                            },
                                            {
                                                "example_id": "85966be2-75f0-4460-8d90-ac905e1c719f",
                                                "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                                "text": "„Zu meinem vierundzwanzigsten Geburtstag bekam ich einen Binder geschenkt. Das ist ein spezielles Unterhemd, das unter der Kleidung getragen wird und die Brust flachdrückt, sprich, eine männliche Silhouette macht.“"
                                            },
                                            {
                                                "example_id": "25ec70d4-e036-44e3-b770-498c5df4de34",
                                                "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                                "text": "„In meinem Alltag trage ich nur ganz selten einen Binder. Ich habe das Glück, dass meine Brüste relativ klein sind und ich einen Kleidungsstil gefunden habe, mit dem es mir gelingt, sie halbwegs zu verdecken.“"
                                            },
                                            {
                                                "example_id": "f0929af5-30e8-405d-ae42-89b5f235f27e",
                                                "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                                "text": "„Je nach der Größe der Oberweite kann man mit Hilfe von so genannten Bindern die angeborene weibliche Brust kaschieren.“"
                                            },
                                            {
                                                "example_id": "caa8435e-d940-48cd-a172-bd20a84162f2",
                                                "sense_id": "ee4bf88f-ad70-3e0c-a25d-5e9aacc1acc5",
                                                "text": "„Seinen Binder trug Anton an einigen Tagen zehn Stunden am Stück, viel zu lange eigentlich, ‚aber man muss Prioritäten setzen‘, sagt er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
                                ]
