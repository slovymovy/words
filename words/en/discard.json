{
    "word_family": [
        "discardable",
        "discarder"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3be85f92-d534-3288-9ff5-685f6ed3f767",
                    "sense_definition": "To get rid of something that is no longer useful or wanted",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>discard</w> any old newspapers that are cluttering up the living room.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>выбросьте</w> все старые газеты, которые загромождают гостиную."
                            }
                        },
                        {
                            "text": "The chef decided to <w>discard</w> food scraps into the compost bin after preparing the meal.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>выбросить</w> пищевые отходы в компостный бак после приготовления еды."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispose of",
                        "get rid of",
                        "jettison",
                        "scrap",
                        "throw away"
                    ],
                    "antonyms": [
                        "keep",
                        "retain",
                        "save"
                    ],
                    "common_phrases": [
                        "discard food scraps",
                        "discard old clothes",
                        "discard waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Избавиться от чего-либо, что больше не является полезным или нужным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "избавляться от ненужного"
                            },
                            {
                                "target_lang_word": "выбросить",
                                "target_lang_sense_clarification": "совершить действие избавления от мусора"
                            },
                            {
                                "target_lang_word": "отбрасывать",
                                "target_lang_sense_clarification": "отвергать или убирать в сторону"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7ac04f0-52a3-3a55-b26a-6f8e7d6bff29",
                    "sense_definition": "To play or get rid of a card from one's hand in a card game",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On your turn, you must draw one card and then <w>discard</w> a card to the pile.",
                            "target_lang_translations": {
                                "ru": "В свой ход вы должны взять одну карту, а затем <w>сбросить</w> карту в стопку."
                            }
                        },
                        {
                            "text": "He chose to <w>discard</w> a high card because he didn't want to lose points.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>скинуть</w> высокую карту, потому что не хотел терять очки."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw out"
                    ],
                    "common_phrases": [
                        "discard a card",
                        "discard to the pile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сыграть или избавиться от карты из руки в карточной игре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "карту в колоду или отбой"
                            },
                            {
                                "target_lang_word": "скидывать",
                                "target_lang_sense_clarification": "разговорный вариант для карт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdf2602a-4d94-3c58-b6f9-7f4f309cf7c4",
                    "sense_definition": "To dismiss someone from a position of employment or favor",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dismissal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen decided to <w>discard</w> her advisors after they failed to provide good counsel.",
                            "target_lang_translations": {
                                "ru": "Королева решила <w>отвергнуть</w> своих советников после того, как они не смогли дать хороший совет."
                            }
                        },
                        {
                            "text": "It is cruel to <w>discard</w> loyal employees just to save a small amount of money.",
                            "target_lang_translations": {
                                "ru": "Жестоко <w>увольнять</w> преданных сотрудников только ради экономии небольшой суммы денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "discharge",
                        "dismiss",
                        "fire",
                        "sack"
                    ],
                    "antonyms": [
                        "employ",
                        "hire"
                    ],
                    "common_phrases": [
                        "discard an advisor",
                        "discard from favor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уволить кого-либо с должности или лишить своего расположения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увольнять",
                                "target_lang_sense_clarification": "лишать работы"
                            },
                            {
                                "target_lang_word": "отвергать",
                                "target_lang_sense_clarification": "лишать расположения или доверия"
                            },
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "переносное значение: избавляться от людей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "67f6b9ff-9261-3238-bd57-a378c6a3a0a6",
                    "sense_definition": "An item or person that has been thrown away or rejected",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thrift store is full of other people's <w>discards</w> that are still in good condition.",
                            "target_lang_translations": {
                                "ru": "Комиссионный магазин полон чужих <w>выброшенных вещей</w>, которые все еще в хорошем состоянии."
                            }
                        },
                        {
                            "text": "She sorted through the pile of <w>discards</w> to see if anything could be recycled.",
                            "target_lang_translations": {
                                "ru": "Она перебрала кучу <w>отходов</w>, чтобы посмотреть, можно ли что-то переработать."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "scrap",
                        "waste"
                    ],
                    "common_phrases": [
                        "pile of discards",
                        "household discards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или человек, который был выброшен или отвергнут"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отходы",
                                "target_lang_sense_clarification": "выброшенные материалы"
                            },
                            {
                                "target_lang_word": "брак",
                                "target_lang_sense_clarification": "отвергнутые предметы"
                            },
                            {
                                "target_lang_word": "изгой",
                                "target_lang_sense_clarification": "отвергнутый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27f4b780-833f-33b3-9bd6-c4db379d3d92",
                    "sense_definition": "A playing card that has been removed from a player's hand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "card_games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player picked up a <w>discard</w> from the table to complete her set.",
                            "target_lang_translations": {
                                "ru": "Игрок поднял <w>сброшенную карту</w> со стола, чтобы завершить свой набор."
                            }
                        },
                        {
                            "text": "Keep your <w>discards</w> in a separate pile so they don't get mixed with the deck.",
                            "target_lang_translations": {
                                "ru": "Держите свой <w>сброс</w> в отдельной стопке, чтобы он не смешался с колодой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick up a discard",
                        "pile of discards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная карта, которая была удалена из руки игрока"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сброшенная карта",
                                "target_lang_sense_clarification": "карта в отбое"
                            },
                            {
                                "target_lang_word": "сброс",
                                "target_lang_sense_clarification": "карта или стопка сброшенных карт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9116240e-a715-3ee7-a27a-ac52ebd1bade",
                    "sense_definition": "In programming, a temporary variable used to receive a value that will not be used",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using <w>discards</w> can make your code cleaner by explicitly ignoring return values.",
                            "target_lang_translations": {
                                "ru": "Использование <w>пустых переменных</w> может сделать ваш код чище за счет явного игнорирования возвращаемых значений."
                            }
                        },
                        {
                            "text": "The underscore character is often used as a <w>discard</w> in many modern programming languages.",
                            "target_lang_translations": {
                                "ru": "Символ подчеркивания часто используется как <w>игнорируемая переменная</w> во многих современных языках программирования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "use a discard"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В программировании: временная переменная для получения значения, которое не будет использоваться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустая переменная",
                                "target_lang_sense_clarification": "игнорируемое значение"
                            },
                            {
                                "target_lang_word": "символ подчеркивания",
                                "target_lang_sense_clarification": "часто используемый как discard"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}