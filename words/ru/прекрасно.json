                    "sense_definition": "Очень хорошо, красиво, замечательно; наречие к <w>прекрасный</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она <прекрасно> говорит по-русски и всё понимает.",
                            "target_lang_translations": {
                                "en": "She speaks Russian <beautifully> and understands everything.",
                                "nl": "Zij spreekt <prachtig> Russisch en begrijpt alles.",
                                "pl": "Ona <świetnie> mówi po rosyjsku i wszystko rozumie.",
                                "de": "Sie spricht <w>wunderbar</w> Russisch und versteht alles.",
                                "fr": "Elle parle <w>magnifiquement</w> russe et comprend tout.",
                                "it": "Lei parla <benissimo> il russo e capisce tutto.",
                                "cs": "Mluví rusky <skvěle> a všemu rozumí.",
                                "tr": "O, Rusçayı <harika bir şekilde> konuşuyor ve her şeyi anlıyor.",
                                "es": "Ella habla <maravillosamente> ruso y lo entiende todo.",
                                "zh": "她俄语说得<w>很好</w>，而且什么都听得懂。"
                            }
                        },
                        {
                            "text": "Мы <прекрасно> провели время в отпуске на море.",
                            "target_lang_translations": {
                                "en": "We had a <wonderful> time on vacation by the sea.",
                                "nl": "Wij hebben een <geweldige> tijd gehad tijdens onze vakantie aan zee.",
                                "pl": "My <wspaniale> spędziliśmy czas na wakacjach nad morzem.",
                                "de": "Wir haben eine <w>wunderbare</w> Zeit im Urlaub am Meer verbracht.",
                                "fr": "Nous avons passé un <w>très bon</w> moment en vacances à la mer.",
                                "it": "Abbiamo passato un tempo <meraviglioso> durante la vacanza al mare.",
                                "cs": "Na dovolené u moře jsme se měli <skvěle>.",
                                "tr": "Deniz kenarındaki tatilimizde <harika> vakit geçirdik.",
                                "es": "Pasamos un tiempo <estupendo> durante nuestras vacaciones en el mar.",
                                "zh": "我们在海边度假时过得<w>非常愉快</w>。"
                            }
                        }
                    ],
