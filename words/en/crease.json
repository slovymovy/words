{
    "word_family": [
        "creasy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5abf42d9-db06-3ba6-8a31-b1b50de8ba4c",
                    "sense_definition": "A line or mark made by folding or doubling a material.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His trousers had a sharp <w>crease</w> down the front.",
                            "target_lang_translations": {
                                "cs": "Jeho kalhoty měly vpředu ostrý <w>puk</w>."
                            }
                        },
                        {
                            "text": "The paper had many <w>creases</w> after being kept in his pocket.",
                            "target_lang_translations": {
                                "cs": "Papír byl po nošení v kapse samý <w>záhyb</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumple"
                    ],
                    "common_phrases": [
                        "sharp crease"
                    ],
                    "target_lang_definitions": {
                        "cs": "Čára nebo značka vzniklá přeložením nebo ohnutím materiálu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "puk",
                                "target_lang_sense_clarification": "zejména na kalhotách"
                            },
                            {
                                "target_lang_word": "záhyb",
                                "target_lang_sense_clarification": "obecný výraz pro ohyb materiálu"
                            },
                            {
                                "target_lang_word": "rýha",
                                "target_lang_sense_clarification": "výraznější stopa po ohnutí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54576896-665b-323f-a233-10ac3ebad855",
                    "sense_definition": "The marked area around a goal in sports like hockey or lacrosse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player was penalized for standing inside the <w>crease</w>.",
                            "target_lang_translations": {
                                "cs": "Hráč byl potrestán za to, že stál v <w>brankovišti</w>."
                            }
                        },
                        {
                            "text": "The goalie protected the <w>crease</w> from the opposing team.",
                            "target_lang_translations": {
                                "cs": "Brankář chránil <w>brankoviště</w> před soupeřovým týmem."
                            }
                        }
                    ],
                    "synonyms": [
                        "goal crease",
                        "zone"
                    ],
                    "common_phrases": [
                        "goal crease"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vymezený prostor kolem branky v některých sportech, jako je hokej nebo lakros."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brankoviště",
                                "target_lang_sense_clarification": "vyznačené území před brankou"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c28d30-41c3-326a-82b1-57b8bd354846",
                    "sense_definition": "A line on a cricket pitch marking the area for the batter or bowler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter stayed safely inside the <w>crease</w>.",
                            "target_lang_translations": {
                                "cs": "Pálkař zůstal bezpečně uvnitř <w>brankoviště</w>."
                            }
                        },
                        {
                            "text": "He stepped out of the <w>crease</w> and was quickly run out.",
                            "target_lang_translations": {
                                "cs": "Vykročil z <w>brankoviště</w> a byl rychle vyautován."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Čára na kriketovém hřišti vymezující prostor pro pálkaře nebo nadhazovače."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brankoviště",
                                "target_lang_sense_clarification": "v kriketu označuje čáru vymezující prostor hráče"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fe36405-0d69-3d6e-9262-9a3719ae7d77",
                    "sense_definition": "An <w>archaic</w> form of kris, a type of Southeast Asian dagger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an ancient <w>crease</w> from the Malay archipelago.",
                            "target_lang_translations": {
                                "cs": "Muzeum vystavovalo starobylý <w>kris</w> z malajského souostroví."
                            }
                        },
                        {
                            "text": "The warrior carried his <w>creases</w> into the historical battle.",
                            "target_lang_translations": {
                                "cs": "Válečník si své <w>krisy</w> vzal do historické bitvy."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is an obsolete spelling for a specific weapon."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zastaralá forma slova kris, typ jihovýchodoasijské dýky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kris",
                                "target_lang_sense_clarification": "tradiční asijská dýka"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfe8450f-fd6b-38d1-b639-e8eb6e0ffc2a",
                    "sense_definition": "To make a line or wrinkle in a material by folding or pressing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fold",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>crease</w> the documents when you put them in the envelope.",
                            "target_lang_translations": {
                                "cs": "Při vkládání do obálky dokumenty <w>nezmačkejte</w>."
                            }
                        },
                        {
                            "text": "The fabric will <w>crease</w> easily if you leave it in the dryer.",
                            "target_lang_translations": {
                                "cs": "Látka se snadno <w>zmačká</w>, pokud ji necháte v sušičce."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvořit čáru nebo vrásku v materiálu ohýbáním nebo stlačováním."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zmačkat",
                                "target_lang_sense_clarification": "vytvořit nechtěné záhyby"
                            },
                            {
                                "target_lang_word": "pomačkat",
                                "target_lang_sense_clarification": "způsobit zmačkání povrchu"
                            },
                            {
                                "target_lang_word": "mačkat se",
                                "target_lang_sense_clarification": "o látce, která se snadno krčí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b9dc86e-94a4-3ac0-8421-2be52329c291",
                    "sense_definition": "To graze or lightly wound someone with a projectile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bullet <w>creased</w> his arm but did not cause serious injury.",
                            "target_lang_translations": {
                                "cs": "Kulka ho <w>škrtla</w> o paži, ale nezpůsobila vážné zranění."
                            }
                        },
                        {
                            "text": "A stray stone <w>creased</w> the side of the car.",
                            "target_lang_translations": {
                                "cs": "Zbloudilý kámen <w>škrtl</w> o bok auta."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Lehce někoho zranit nebo škrtnout projektilem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "škrtnout",
                                "target_lang_sense_clarification": "lehce zasáhnout povrch"
                            },
                            {
                                "target_lang_word": "líznout",
                                "target_lang_sense_clarification": "hovorově, lehce zasáhnout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420db909-28d3-3000-8cfa-5de02018fab0",
                    "sense_definition": "To laugh uncontrollably.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone was <w>creasing</w> at his hilarious impression of the teacher.",
                            "target_lang_translations": {
                                "cs": "Všichni se <w>váleli smíchy</w> u jeho vtipné imitace učitele."
                            }
                        },
                        {
                            "text": "I <w>creased</w> when I heard the funny story.",
                            "target_lang_translations": {
                                "cs": "Když jsem slyšel ten vtipný příběh, <w>řehtal jsem se</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used informally to describe laughing hard."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekontrolovaně se smát."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "válet se smíchy",
                                "target_lang_sense_clarification": "idiomatické vyjádření silného smíchu"
                            },
                            {
                                "target_lang_word": "řehtat se",
                                "target_lang_sense_clarification": "hlasitý, nekontrolovaný smích"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}