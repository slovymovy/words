                                    {
                                        "sense_id": "5035dcaf-553d-33dc-9dd8-f3214955b343",
                                        "entry_id": "f6f133e6-84a1-37cf-bebe-26044e6749f5",
                                        "glosses": [
                                            "betrekking hebbend op of gemaakt met holografie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0414bf7-12df-450f-9025-72f2b8b9abc1",
                                                "sense_id": "5035dcaf-553d-33dc-9dd8-f3214955b343",
                                                "text": "Op het toneel zagen we de holografische projectie van een bewegende maar al lang overleden popster."
                                            }
                                        ]
