{
    "word_family": [
        "сладкий",
        "сладко",
        "сластить",
        "подсластить",
        "сладковатый",
        "сластёна"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a8de614-d306-36d9-aee9-cdf6cc366a4a",
                    "sense_definition": "Сладкое кондитерское изделие, лакомство (конфета, печенье, варенье и т. п.), обычно во множественном числе.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "еда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама принесла из магазина вкусные <w>сладости</w> к вечернему чаю.",
                            "target_lang_translations": {
                                "de": "Mama hat aus dem Geschäft leckere <w>Süßigkeiten</w> zum Abendtee mitgebracht."
                            }
                        },
                        {
                            "text": "Детям не разрешают есть много <w>сладостей</w> перед обедом.",
                            "target_lang_translations": {
                                "de": "Den Kindern ist es nicht erlaubt, vor dem Mittagessen viele <w>Süßigkeiten</w> zu essen."
                            }
                        }
                    ],
                    "synonyms": [
                        "сласть"
                    ],
                    "common_phrases": [
                        "восточные сладости"
                    ],
                    "target_lang_definitions": {
                        "de": "Süßware, Leckerei oder Konfekt (meist im Plural gebraucht)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Süßigkeit",
                                "target_lang_sense_clarification": "meist im Plural: Süßigkeiten"
                            },
                            {
                                "target_lang_word": "die Leckerei",
                                "target_lang_sense_clarification": "etwas Feines, Süßes zu essen"
                            },
                            {
                                "target_lang_word": "die Nascherei",
                                "target_lang_sense_clarification": "Süßigkeiten zum Knabbern und Naschen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a518fb8-47f9-3eda-8267-0ed958c12fe8",
                    "sense_definition": "Свойство или вкусовое ощущение по значению прилагательного <w>сладкий</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "вкус",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спелые ягоды порадовали нас особенной <w>сладостью</w>.",
                            "target_lang_translations": {
                                "de": "Die reifen Beeren erfreuten uns mit einer besonderen <w>Süße</w>."
                            }
                        },
                        {
                            "text": "В этом сорте яблок приятная кислинка сочетается с нежной <w>сладостью</w>.",
                            "target_lang_translations": {
                                "de": "Bei dieser Apfelsorte verbindet sich eine angenehme Säure mit einer zarten <w>Süße</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "горечь",
                        "кислота"
                    ],
                    "common_phrases": [
                        "приятная сладость",
                        "ощутить сладость"
                    ],
                    "target_lang_definitions": {
                        "de": "Geschmackseigenschaft oder -empfindung von etwas, das süß schmeckt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Süße",
                                "target_lang_sense_clarification": "Geschmackseigenschaft"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ed82aee-f09b-3d87-8b97-af2262f3fe05",
                    "sense_definition": "Приятное чувство, глубокое душевное удовлетворение; наслаждение, услада.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "чувство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгой и упорной борьбы спортсмен наконец почувствовал всю <w>сладость</w> победы.",
                            "target_lang_translations": {
                                "de": "Nach einem langen und harten Kampf kostete der Sportler endlich die ganze <w>Süße</w> des Sieges aus."
                            }
                        },
                        {
                            "text": "В тот тихий вечер они в полной мере ощутили <w>сладость</w> долгожданного покоя.",
                            "target_lang_translations": {
                                "de": "An jenem ruhigen Abend genossen sie in vollen Zügen die <w>Wonne</w> der lang ersehnten Ruhe."
                            }
                        }
                    ],
                    "synonyms": [
                        "наслаждение",
                        "услада"
                    ],
                    "antonyms": [
                        "горечь",
                        "огорчение"
                    ],
                    "common_phrases": [
                        "сладость победы"
                    ],
                    "target_lang_definitions": {
                        "de": "Angenehmes Gefühl, tiefe seelische Befriedigung; Wonne oder Genuss."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Süße",
                                "target_lang_sense_clarification": "übertragen, z. B. des Erfolgs oder Lebens"
                            },
                            {
                                "target_lang_word": "die Wonne",
                                "target_lang_sense_clarification": "hohes Maß an Freude und Wohlgefühl"
                            },
                            {
                                "target_lang_word": "der Genuss",
                                "target_lang_sense_clarification": "seelische Befriedigung, Wohlbehagen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}