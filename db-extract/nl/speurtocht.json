                "senses": [
                    {
                        "sense_id": "e59e7b9d-552d-3af0-a766-17f5b79c30a6",
                        "entry_id": "5e0f1b76-bbd7-3d05-8bf5-beefb3b80acd",
                        "glosses": [
                            "een vastgelegde afstand die men loopt waarvan men tijdens het lopen de route moet uitvinden door het zoeken van aanwijzingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512a0ec7-ec43-4312-bfef-a56f490d0318",
                                "sense_id": "e59e7b9d-552d-3af0-a766-17f5b79c30a6",
                                "text": "Voor de kinderen was er bij het evenement een speurtocht georganiseerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "c19c3824-f867-315b-82c9-eb7d5a1651f2",
                        "entry_id": "5e0f1b76-bbd7-3d05-8bf5-beefb3b80acd",
                        "glosses": [
                            "zoektocht, het gehele proces dat nodig is om iets te vinden of uit te zoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b6a6d4-83d9-468c-a8c4-d1e803eb4e61",
                                "sense_id": "c19c3824-f867-315b-82c9-eb7d5a1651f2",
                                "text": "De twee journalisten meenden bij twee racefietsen ook een verdachte warmteontwikkeling in de achterassen te hebben gedetecteerd. Zij concluderen dat ook daar een motor heeft gezeten, die zijn stroom betrok van lithium-ion batterijen in de zitbuis. Het concept van de ‘hub motor’, de motor die rechtstreeks de as aandrijft, is al oud. Nieuw zou dan zijn dat de motor zó klein was dat hij verborgen kon blijven achter de tandwielcassette van de racefiets. In hun speurtocht naar zulke motoren vonden de twee inderdaad een minimotortje dat 40 watt leverde. Maar inmiddels betwijfelen experts of de gedetecteerde warmte bij de achteras wel zo verdacht was.(Karel Knip, NRC, 18 april 2016)"
                            }
                        ]
                    }
                ],
