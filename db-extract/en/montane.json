                "senses": [
                    {
                        "sense_id": "665088d9-6b01-3cfe-80c8-c1ccf089c32d",
                        "entry_id": "a8c1e896-c8af-36c2-bd40-84c5fd01b9d6",
                        "glosses": [
                            "An animal or a plant of a montane habitat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f379ae-dbbb-46e2-9265-0a240ad29e4e",
                                "sense_id": "665088d9-6b01-3cfe-80c8-c1ccf089c32d",
                                "text": "The true Montanes comprise those species, of unmistakably Alpine, Scottish, or Highland type, which not merely with us but elsewhere throughout Britain are characteristic of high latitudes and altitudes—of mountain regions only."
                            },
                            {
                                "example_id": "3f58e3cc-ac12-4ec2-844b-54d86a690a96",
                                "sense_id": "665088d9-6b01-3cfe-80c8-c1ccf089c32d",
                                "text": "The wintergreens, and northern montanes such as Linnaea have their stronghold in these pinewoods and some of their rarity may be due to the reduction in the extent of the forest."
                            }
                        ]
                    }
                ],
