{
    "word_family": [
        "выводить",
        "вывод",
        "выведение"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8fb07f9b-c176-39c3-931a-a618cd962bb5",
                    "sense_definition": "Заставить или помочь кому-либо выйти, переместить кого-либо или что-либо изнутри наружу",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Охранник помог <вывести> посетителей из здания во время тревоги.",
                            "target_lang_translations": {
                                "en": "The security guard helped <lead> the visitors <out> of the building during the alarm.",
                                "nl": "De bewaker hielp de bezoekers tijdens het alarm het gebouw <uit te leiden>."
                            }
                        },
                        {
                            "text": "Фермер решил <вывести> лошадей из конюшни на прогулку.",
                            "target_lang_translations": {
                                "en": "The farmer decided to <take> the horses <out> of the stable for a walk.",
                                "nl": "De boer besloot de paarden uit de stal te <halen> voor een wandeling."
                            }
                        }
                    ],
                    "antonyms": [
                        "ввести"
                    ],
                    "common_phrases": [
                        "вывести из дома",
                        "вывести на улицу",
                        "вывести войска"
                    ],
                    "target_lang_definitions": {
                        "en": "To make or help someone leave a place; to move someone or something from inside to outside",
                        "nl": "Iemand helpen of dwingen om een plaats te verlaten; iemand of iets van binnen naar buiten verplaatsen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lead out",
                                "target_lang_sense_clarification": "people or groups"
                            },
                            {
                                "target_lang_word": "take out",
                                "target_lang_sense_clarification": "animals or objects"
                            },
                            {
                                "target_lang_word": "withdraw",
                                "target_lang_sense_clarification": "troops or military units"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "naar buiten leiden",
                                "target_lang_sense_clarification": "mensen of groepen"
                            },
                            {
                                "target_lang_word": "naar buiten brengen",
                                "target_lang_sense_clarification": "dieren of objecten"
                            },
                            {
                                "target_lang_word": "terugtrekken",
                                "target_lang_sense_clarification": "troepen of militaire eenheden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18db4c42-53e5-3e25-b6b6-bd50695ba894",
                    "sense_definition": "Лишить обычного состояния, душевного равновесия или исправности",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "state_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его грубое поведение может легко <вывести> меня из себя.",
                            "target_lang_translations": {
                                "en": "His rude behavior can easily <drive> me crazy.",
                                "nl": "Zijn onbeschofte gedrag kan me gemakkelijk <buiten mezelf brengen>."
                            }
                        },
                        {
                            "text": "Сильный скачок напряжения может <вывести> компьютер из строя.",
                            "target_lang_translations": {
                                "en": "A strong voltage spike can <disable> the computer.",
                                "nl": "Een sterke stroompiek kan de computer <buiten werking stellen>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "вывести из себя",
                        "вывести из строя",
                        "вывести из равновесия",
                        "вывести из терпения"
                    ],
                    "target_lang_definitions": {
                        "en": "To deprive of a normal state, emotional balance, or working order",
                        "nl": "Iemand uit zijn normale doen, emotionele evenwicht of werking halen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drive",
                                "target_lang_sense_clarification": "drive crazy/mad (idiomatic)"
                            },
                            {
                                "target_lang_word": "disable",
                                "target_lang_sense_clarification": "put out of order/action"
                            },
                            {
                                "target_lang_word": "unsettle",
                                "target_lang_sense_clarification": "throw off balance"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "buiten zichzelf brengen",
                                "target_lang_sense_clarification": "iemand boos of gek maken"
                            },
                            {
                                "target_lang_word": "buiten werking stellen",
                                "target_lang_sense_clarification": "apparaten of systemen uitschakelen"
                            },
                            {
                                "target_lang_word": "uit het lood slaan",
                                "target_lang_sense_clarification": "uit het evenwicht brengen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3693b6e3-34a9-3ceb-b965-c644b80854a7",
                    "sense_definition": "Уничтожить вредителей или удалить пятна с поверхности чего-либо",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне удалось <вывести> пятно от кофе с белой рубашки.",
                            "target_lang_translations": {
                                "en": "I managed to <remove> the coffee stain from the white shirt.",
                                "nl": "Het is me gelukt om de koffievlek uit het witte overhemd te <verwijderen>."
                            }
                        },
                        {
                            "text": "Мы вызвали службу, чтобы <вывести> тараканов в квартире.",
                            "target_lang_translations": {
                                "en": "We called a service to <exterminate> the cockroaches in the apartment.",
                                "nl": "We hebben een dienst gebeld om de kakkerlakken in het appartement te <verdelgen>."
                            }
                        }
                    ],
                    "synonyms": [
                        "уничтожить",
                        "искоренить"
                    ],
                    "common_phrases": [
                        "вывести пятно",
                        "вывести тараканов",
                        "вывести клопов"
                    ],
                    "target_lang_definitions": {
                        "en": "To destroy pests or remove stains from a surface",
                        "nl": "Ongedierte verdelgen of vlekken van een oppervlak verwijderen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "stains or spots"
                            },
                            {
                                "target_lang_word": "get out",
                                "target_lang_sense_clarification": "stains (colloquial)"
                            },
                            {
                                "target_lang_word": "exterminate",
                                "target_lang_sense_clarification": "pests or insects"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verwijderen",
                                "target_lang_sense_clarification": "vlekken"
                            },
                            {
                                "target_lang_word": "verdelgen",
                                "target_lang_sense_clarification": "ongedierte of insecten"
                            },
                            {
                                "target_lang_word": "uitroeien",
                                "target_lang_sense_clarification": "ongedierte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3150369-20d1-3792-adb0-d570b45cc634",
                    "sense_definition": "Исключить кого-либо из состава группы, организации или списка",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тренер решил <вывести> травмированного игрока из основного состава.",
                            "target_lang_translations": {
                                "en": "The coach decided to <remove> the injured player from the starting lineup.",
                                "nl": "De coach besloot de geblesseerde speler uit de basisopstelling te <schrappen>."
                            }
                        },
                        {
                            "text": "Акционеры проголосовали за то, чтобы <вывести> его из совета директоров.",
                            "target_lang_translations": {
                                "en": "The shareholders voted to <remove> him from the board of directors.",
                                "nl": "De aandeelhouders stemden om hem uit de raad van bestuur te <verwijderen>."
                            }
                        }
                    ],
                    "antonyms": [
                        "ввести"
                    ],
                    "common_phrases": [
                        "вывести из состава",
                        "вывести из игры"
                    ],
                    "target_lang_definitions": {
                        "en": "To exclude someone from a group, organization, or list",
                        "nl": "Iemand uitsluiten van een groep, organisatie of lijst"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "from a list or position"
                            },
                            {
                                "target_lang_word": "withdraw",
                                "target_lang_sense_clarification": "from a body or organization"
                            },
                            {
                                "target_lang_word": "drop",
                                "target_lang_sense_clarification": "from a team or lineup"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "verwijderen",
                                "target_lang_sense_clarification": "uit een lijst of positie"
                            },
                            {
                                "target_lang_word": "terugtrekken",
                                "target_lang_sense_clarification": "uit een organisatie of orgaan"
                            },
                            {
                                "target_lang_word": "schrappen",
                                "target_lang_sense_clarification": "uit een team of opstelling"
                            }
                        ]
