                "senses": [
                    {
                        "sense_id": "6943ae6b-e8ae-3bfa-bac0-fbb8e18243aa",
                        "entry_id": "51877f2f-b409-3d8f-b51f-f4b1f9c7ec21",
                        "glosses": [
                            "Ruse grossière qui ne peut tromper que des ignorants ou des sots."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "2d1e3b50-6f0d-4d23-b4e8-8ab1ecece6ca",
                                "sense_id": "6943ae6b-e8ae-3bfa-bac0-fbb8e18243aa",
                                "text": "C’est un attrape-couillon."
                            },
                            {
                                "example_id": "978b8bf9-3574-4f51-bdaf-e70c00516b35",
                                "sense_id": "6943ae6b-e8ae-3bfa-bac0-fbb8e18243aa",
                                "text": "C’est un tour de passe-passe puéril ! On s’imagine qu’on pourra prendre les Algériens avec cet attrape-couillons [sic] ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4dc61319-4eb3-38e8-9e3a-687ee957f966",
                        "entry_id": "51877f2f-b409-3d8f-b51f-f4b1f9c7ec21",
                        "glosses": [
                            "Maquillage de séduction."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0aca5788-6067-4076-aace-d17489156e3a",
                                "sense_id": "4dc61319-4eb3-38e8-9e3a-687ee957f966",
                                "text": "Passe-moi ma trousse à attrape-couillon."
                            },
                            {
                                "example_id": "9758373b-338d-48f4-a796-31e264acd860",
                                "sense_id": "4dc61319-4eb3-38e8-9e3a-687ee957f966",
                                "text": "Elle avance sa bouche en cul de poule. On lui remet du rouge. Moi, rien. Ni d’attrape-couillon, ni autre artifice. Je dois passer mieux nature, comme les fauves."
                            }
                        ]
                    }
                ],
