                    {
                        "translation_id": "eefd7763-2dbd-4fb7-bd90-80c706e42505",
                        "source_entry_id": "2dbb03d1-e3a5-3577-9cc5-7595bc1618f4",
                        "source_sense_id": "6f1aff15-4ae4-3842-8949-dc2609b31ee5",
                        "source_sense_description": "Gueux",
                        "target_lang_word": "Bettler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bettler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "bedürftiger Mensch, der von Almosen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aa24032-a9a3-4192-af44-44edcccf1157",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Einen Dritteil der Einwohner machen privilegierte Bettler aus. (Johann Kaspar Riesbeck, Briefe eines reisenden Franzosen über Deutschland, Köln, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "cf0f0235-1bc8-4bc1-9a7f-c2618fc22f32",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "Vor dem Eingang zum Bahnhof saß ein Bettler und reckte den Passanten sein handgeschriebenes Schild entgegen."
                                            },
                                            {
                                                "example_id": "4eaaf31b-752e-4e98-8b45-c432f1701636",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Ein Bettler klingelte bei uns.“"
                                            },
                                            {
                                                "example_id": "331a6c2b-0207-439f-a3f1-02a452b209d9",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im jüdischen Viertel gaben sich die Bettler als fromme Juden aus, ließen sich Bärte wachsen, warfen sich in lange schwarze Mäntel und segneten jeden, der ihnen unterkam.“"
                                            },
                                            {
                                                "example_id": "3e65e3fd-58b8-4b45-96ee-6abbc0288f8e",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Im September 1930 werden die Vorbereitungen hektischer, Maler streichen viele Fassaden neu, alte Hütten verschwinden hinter Zäunen aus Eukalyptusholz, Bettler und Leprakranke müssen die Stadt verlassen.“"
                                            },
                                            {
                                                "example_id": "addd2b6b-5489-4cf3-85f9-53d712185490",
                                                "sense_id": "e3962ed6-04c9-3229-9d7c-d5a3d1969263",
                                                "text": "„Erst jetzt gab es in der antiken Welt Pauperismus in großem Ausmaße: Besitzlose, die als Bettler das Land durchstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                        "entry_id": "d62800d2-9e37-32a2-bd15-1cd5d96e20a2",
                                        "glosses": [
                                            "dringlich Bittender"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e790904a-08eb-4478-9c9e-8ce5edf72d1a",
                                                "sense_id": "aea6a890-859c-3b59-a400-d1d5a10c1d72",
                                                "text": "Ich stehe hier als Bittsteller und Bettler."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
