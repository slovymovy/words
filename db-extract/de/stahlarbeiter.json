                                "example_id": "b1c1c276-0079-450f-b252-3d64259d8365",
                                "sense_id": "6f9e35f5-8890-3276-8378-77ab36227ff3",
                                "text": "„Nach vier Verhandlungsrunden haben sich Arbeitgeber und Gewerkschaft geeinigt: Stahlarbeiter bekommen vier Prozent mehr Lohn.“"
                            },
                            {
                                "example_id": "0df50e10-04c8-4123-bffc-e53017544018",
                                "sense_id": "6f9e35f5-8890-3276-8378-77ab36227ff3",
                                "text": "„Anfang Mai sollen 10000 Stahlarbeiter gegen die Sparpläne auf die Straße gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
