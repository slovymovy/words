                    },
                    {
                        "translation_id": "6e0b2706-d9a6-4094-9765-23ecbad0d99b",
                        "source_entry_id": "7a89077f-535b-3ce3-a634-de57006bf3f5",
                        "source_sense_id": "6c4f1288-8da3-35fc-9287-323c4c485426",
                        "source_sense_description": "toy brick",
                        "target_lang_word": "Legostein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Legostein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d92b425c-4934-3bc0-98c5-0f993896a73f",
                                        "entry_id": "0eeca6dc-cdc4-3f60-9b78-79c085128dff",
                                        "glosses": [
                                            "Baustein aus Kunststoff des Baukastenspiels der Firma Lego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ebcc5b0-2fc4-4ee3-8ba2-adbd0842290b",
                                                "sense_id": "d92b425c-4934-3bc0-98c5-0f993896a73f",
                                                "text": "„Bei unseren Legosteinen gab es welche, die wackelig waren.“"
                                            },
                                            {
                                                "example_id": "9321dbee-db8f-4713-a81c-6900da61a4d5",
                                                "sense_id": "d92b425c-4934-3bc0-98c5-0f993896a73f",
                                                "text": "„Der Legostein als solcher hat zwei natürliche Feinde: den Staubsauger und die Sofaritze.“"
                                            },
                                            {
                                                "example_id": "3bf0008b-1ad1-4f36-bdeb-034d18ea4ab4",
                                                "sense_id": "d92b425c-4934-3bc0-98c5-0f993896a73f",
                                                "text": "„Die Pizzakartons lagen auf dem Küchentisch, Legosteine im Wohnzimmer, und er hatte noch immer nicht die Spülmaschine ausgeräumt, sodass sich in der Spüle das dreckige Geschirr stapelte.“"
                                            },
                                            {
                                                "example_id": "a0ae9f03-d729-4405-8121-6eec76d6a150",
                                                "sense_id": "d92b425c-4934-3bc0-98c5-0f993896a73f",
                                                "text": "„Ich hatte dort meine Barbiepuppen aufbewahrt, die Legosteine, die ich mit Vegard und Thomas teilte, irgendwann hatten wir uns ein Wasserbett und einen Commodore 64 erquenglt, den Onkel Rolf aus den USA mitgebracht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19a8ef24-a364-415b-8e98-53741374647b",
