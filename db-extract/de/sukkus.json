                "senses": [
                    {
                        "sense_id": "9b485248-db58-3eaf-8b9a-6b0deced4cd0",
                        "entry_id": "8cafb205-2579-3497-b633-8a45f7d683e4",
                        "glosses": [
                            "Zusammenfassung des Wesentlichen; Ergebnis"
                        ],
                        "tags": [
                            "Austrian German",
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "bed32215-65e7-40a8-944e-7a938b1fdea1",
                                "sense_id": "9b485248-db58-3eaf-8b9a-6b0deced4cd0",
                                "text": "„Die Aufhebung der im Atomstreit seit 2006 verhängten Sanktionen gegen den Iran auf der einen, die strenge Beschränkung des iranischen Urananreicherungsprogramms auf Jahre hinaus auf der anderen: Das ist der Sukkus des Atomdeals.“"
                            },
                            {
                                "example_id": "7ea0e62e-4f8e-4a2e-a926-94b0027c22e5",
                                "sense_id": "9b485248-db58-3eaf-8b9a-6b0deced4cd0",
                                "text": "„Während sich die Konservativen besprechen, dementiert die FPÖ den Abbruch: Kickl spricht in einem Facebook-Posting von einer ‚Ente‘, also Falschmeldungen. Die ÖVP stimme sich lediglich ‚intern‘ ab, was ‚ganz normal in Verhandlungen‘ sei. Und: ‚Wir stimmen uns auch immer wieder intern ab.‘ Der Sukkus: Gehen Sie weiter, hier gibt es nichts zu sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d662a2c7-b539-40d8-a014-67bc942e1fe8",
                        "source_entry_id": "8cafb205-2579-3497-b633-8a45f7d683e4",
                        "source_sense_id": "9b485248-db58-3eaf-8b9a-6b0deced4cd0",
                        "source_sense_description": "Zusammenfassung des Wesentlichen; Ergebnis",
                        "target_lang_word": "gist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                        "entry_id": "454d266e-f13c-325e-aac3-07c903fb3419",
                                        "glosses": [
                                            "The main idea or substance, or the most essential part, of a longer or more complicated matter; the crux, the heart, the pith."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49b4489b-fbb8-4121-b44d-a5905211b185",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "I don't wanna belabor my point; I'm sure you get the gist."
                                            },
                                            {
                                                "example_id": "06f78986-b854-4f99-b963-3a64142dad08",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "Should they live and build their church in the American wilderness, their worst dangers would rise in and among themselves rather than outside. That was the gist of the lesson from their pastor and \"wellwiller\" John Robinson."
                                            },
                                            {
                                                "example_id": "f7a40222-e519-41d3-a1f5-293c6a6b2f39",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "He was handing her something in an envelope, and she was saying “Oh, Jeeves, you've saved a human life,” and he was saying “Not at all, miss.” The gist, of course, escaped me, but I had no leisure to probe into gists."
                                            },
                                            {
                                                "example_id": "a34b928c-9fe2-49ab-b978-b49afc5faa3d",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "The gists of the reports, however, their logic, their structural coherence, are molded by a concern to reconstruct the past, by antiquarian interest."
                                            },
                                            {
                                                "example_id": "7347c57d-327d-4061-82de-80e4beae8fa5",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "And the work was going very well. I was really just vomiting images like spoiled sushi (that may be an ill-considered metaphor, but you get my gist)."
                                            },
                                            {
                                                "example_id": "7c7114e1-ce02-4cec-baa4-7dc906c0640b",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "I don't remember his exact words, but the gist of it was that he wanted it all for nothing, as quickly as possible, without any effort."
                                            },
                                            {
                                                "example_id": "1efca8ce-da84-4289-89b5-fbae534cd949",
                                                "sense_id": "d63d3256-32cb-37e1-97d5-d4c102823a1c",
                                                "text": "There's evidence that even our unconscious efficiently only stores the gists of memories and that to fill in details our conscious fabricates them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                                        "entry_id": "454d266e-f13c-325e-aac3-07c903fb3419",
                                        "glosses": [
                                            "The essential ground for action in a lawsuit, without which there is no cause of action; the gravamen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e65576e2-c390-448b-80f5-c6afefe4f535",
                                                "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                                                "text": "[T]heſe charges, of a traiterous or felonious intent, are the points and very giſt of the indictment, and muſt be anſvvered directly, by the general negative, not guilty; […]"
                                            },
                                            {
                                                "example_id": "acb5f53f-e46d-4e65-bff3-6763abf4b26a",
                                                "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                                                "text": "[H]e is guilty of a dereliction of opinions that are true and laudable. This is the great giſt of the charge againſt him."
                                            },
                                            {
                                                "example_id": "5681489e-8e08-4229-b21f-b3f6704785e2",
                                                "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                                                "text": "But it is observable that the substance or gist of the action is not always the principal cause of the plaintiff's complaint in point of fact, nor that on which he recovers all or the greatest part of his damages. It frequently happens that upon that part of his declaration which contains the substance or gist of the action he recovers nominal damages, and he gets his principal satisfaction on account of matters altogether collateral thereto."
                                            },
                                            {
                                                "example_id": "fa02d452-c197-4d6d-b3f8-f07978fbd102",
                                                "sense_id": "fc50b46a-9a69-3fdd-97b0-d93f9c8bb432",
                                                "text": "Naturally, therefore, conceiving that the gite of the lawyer's reasoning was to defend the want of resemblance as an admitted fact, which it would be useless to deny, the worthy magistrate closed the pleadings, and gave sentence against Mr Whelp, the plaintiff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06cf77de-d1fa-3c68-a5ee-5ef195fc870b",
                                        "entry_id": "454d266e-f13c-325e-aac3-07c903fb3419",
                                        "glosses": [
                                            "Gossip, rumour; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76a11171-3037-3c1c-b72e-d3ef0a1d503e",
                                        "entry_id": "454d266e-f13c-325e-aac3-07c903fb3419",
                                        "glosses": [
                                            "A sharable snippet of source code, especially on the version controlled pastebin-hosting site GitHub Gist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b313906-3abc-4bd3-bceb-82144e84a6bb",
                                                "sense_id": "76a11171-3037-3c1c-b72e-d3ef0a1d503e",
                                                "text": "For a simple illustration of the issue, take a look at this gist."
                                            },
                                            {
                                                "example_id": "f940da5b-247c-4951-a76a-658a001d83e3",
                                                "sense_id": "76a11171-3037-3c1c-b72e-d3ef0a1d503e",
                                                "text": "Every gist created is a tiny repository. You can update gists and see the history using git log. You can download gists, hack on the repository, […]"
                                            },
                                            {
                                                "example_id": "8b23eeb9-575e-412e-becb-4ae4aa72f7e7",
                                                "sense_id": "76a11171-3037-3c1c-b72e-d3ef0a1d503e",
                                                "text": "For example, findOrCreate can be implemented as a before-hook on the service's get method. See this gist for an example of how to implement this in a before-hook."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97fd2150-2509-39ce-9712-07c5151df190",
                                        "entry_id": "d1779322-3db2-39e5-997c-1b68b8e00084",
                                        "glosses": [
                                            "To extract and present the main ideas or substance, or the most essential parts of (a document, piece of writing, etc.); to abridge, to summarize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ffe125e-00ce-4ad1-bf94-804a4467d49b",
                                                "sense_id": "97fd2150-2509-39ce-9712-07c5151df190",
                                                "text": "There are two general ways of getting information, and these two general ways may be summed up in this: take one branch of study and its principles are all gisted, they have been gisted by the accumulated thought of years gone by. These gisted thoughts are axioms, or received principles, and the pupils of the day take these axioms or principles, and accept them as facts, and apply them to this, that or the other individual case."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21331c5-80d3-3134-8528-87c0db132100",
                                        "entry_id": "d1779322-3db2-39e5-997c-1b68b8e00084",
                                        "glosses": [
                                            "To talk idly; chat; also, to gossip."
                                        ],
                                        "tags": [
                                            "Nigeria",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7aa04e0-000a-3f89-889b-259e8d109c82",
                                        "entry_id": "eaa7445c-819a-3b24-b80c-cd4e5327bf50",
                                        "glosses": [
                                            "A stop for lodging or rest in a journey, or the place where this happens; a rest."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f4c6f17-1ac9-4680-9996-71e952669892",
                                                "sense_id": "c7aa04e0-000a-3f89-889b-259e8d109c82",
                                                "text": "Theſe Quailes have their ſet giſts, to vvit, ordinarie reſting and baiting places."
                                            },
                                            {
                                                "example_id": "c3946fe7-e999-49b1-a3a7-58629ae1d370",
                                                "sense_id": "c7aa04e0-000a-3f89-889b-259e8d109c82",
                                                "text": "But the Conſul after that he had intelligence that Perſeus had croſſed over to Samothracia, departed from Pella, and at the fourth giſt and journey that he made, came to Amphipolis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
