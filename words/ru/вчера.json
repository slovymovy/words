{
    "word_family": [
        "вчерашний",
        "позавчера",
        "позавчерашний"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bfeac21e-bbdb-3ef6-bf58-87297b875fef",
                    "sense_definition": "В день, который был перед сегодняшним.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "literal_yesterday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Вчера</w> мы ходили в кино на новый фильм.",
                            "target_lang_translations": {
                                "en": "<w>Yesterday</w> we went to the cinema to see a new movie.",
                                "zh": "<w>昨天</w>我们去电影院看了部新片。",
                                "de": "<w>Gestern</w> waren wir im Kino und haben einen neuen Film gesehen."
                            }
                        },
                        {
                            "text": "Я видел твоего брата <w>вчера</w> вечером в парке.",
                            "target_lang_translations": {
                                "en": "I saw your brother <w>yesterday</w> evening in the park.",
                                "zh": "我<w>昨天</w>晚上在公园里看见了你哥哥。",
                                "de": "Ich habe deinen Bruder <w>gestern</w> Abend im Park gesehen."
                            }
                        }
                    ],
                    "antonyms": [
                        "завтра"
                    ],
                    "common_phrases": [
                        "вчера утром",
                        "вчера вечером",
                        "вчера днём",
                        "ещё вчера"
                    ],
                    "target_lang_definitions": {
                        "en": "On the day before today.",
                        "zh": "今天之前的那一天。",
                        "de": "Am Tag unmittelbar vor dem heutigen Tag."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yesterday",
                                "target_lang_sense_clarification": "adverb"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昨天",
                                "target_lang_sense_clarification": "副词，指前一日"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gestern",
                                "target_lang_sense_clarification": "Adverb, bezeichnet den Tag vor heute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5bb6336-1f3a-379d-9dfc-48912ac3628f",
                    "sense_definition": "В недавнем прошлом (переносное значение).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "То, что казалось невозможным ещё <w>вчера</w>, сегодня стало реальностью.",
                            "target_lang_translations": {
                                "en": "What seemed impossible just <w>yesterday</w> has become a reality today.",
                                "zh": "那些<w>昨天</w>看起来不可能的事，今天已经变成了现实。",
                                "de": "Was noch <w>gestern</w> unmöglich schien, ist heute Realität geworden."
                            }
                        },
                        {
                            "text": "Эта технология устарела уже <w>вчера</w>.",
                            "target_lang_translations": {
                                "en": "This technology was already outdated <w>yesterday</w>.",
                                "zh": "这项技术在<w>昨天</w>就已经过时了。",
                                "de": "Diese Technologie war schon <w>gestern</w> veraltet."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In the recent past.",
                        "zh": "指代不久前的过去。",
                        "de": "In der jüngeren Vergangenheit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yesterday",
                                "target_lang_sense_clarification": "figurative"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昨天",
                                "target_lang_sense_clarification": "比喻义，指不久前"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gestern",
                                "target_lang_sense_clarification": "im übertragenen Sinne für die jüngste Vergangenheit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "033bed8a-4f0f-3fbc-a5f0-97810eb2f7a9",
                    "sense_definition": "День, непосредственно предшествующий сегодняшнему.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "literal_yesterday",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А потом «сегодня» превратилось во «<w>вчера</w>», и начался новый день.",
                            "target_lang_translations": {
                                "en": "And then 'today' turned into '<w>yesterday</w>', and a new day began.",
                                "zh": "后来“今天”变成了“<w>昨天</w>”，新的一天开始了。",
                                "de": "Und dann wurde aus dem „Heute“ ein „<w>Gestern</w>“ und ein neuer Tag begann."
                            }
                        },
                        {
                            "text": "Не стоит жить одним только <w>вчера</w>.",
                            "target_lang_translations": {
                                "en": "One shouldn't live only in <w>yesterday</w>.",
                                "zh": "人不应该只活在<w>昨天</w>里。",
                                "de": "Man sollte nicht nur im <w>Gestern</w> leben."
                            }
                        }
                    ],
                    "synonyms": [
                        "вчерашний день"
                    ],
                    "antonyms": [
                        "завтра",
                        "сегодня"
                    ],
                    "common_phrases": [
                        "наше вчера"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "несклоняемое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The day immediately before today.",
                        "zh": "紧接在今天之前的那一天。",
                        "de": "Der Tag, der unmittelbar vor dem heutigen liegt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yesterday",
                                "target_lang_sense_clarification": "noun"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昨天",
                                "target_lang_sense_clarification": "名词，指前一日"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gestern",
                                "target_lang_sense_clarification": "Substantiv, der Tag vor heute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66223c00-4157-35ab-9a32-7d78fd8197fa",
                    "sense_definition": "Недавнее прошлое, прошедшие события.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра будет лучше, чем <w>вчера</w>.",
                            "target_lang_translations": {
                                "en": "Tomorrow will be better than <w>yesterday</w>.",
                                "zh": "明天会比<w>过去</w>更好。",
                                "de": "Morgen wird besser sein als das <w>Gestern</w>."
                            }
                        },
                        {
                            "text": "Мы не можем изменить своё <w>вчера</w>, но можем повлиять на будущее.",
                            "target_lang_translations": {
                                "en": "We cannot change our <w>yesterday</w>, but we can influence the future.",
                                "zh": "我们无法改变<w>过去</w>，但可以影响未来。",
                                "de": "Wir können unser <w>Gestern</w> nicht ändern, aber wir können die Zukunft beeinflussen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "несклоняемое"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The recent past; past events.",
                        "zh": "指代过去的时间或经历。",
                        "de": "Die jüngere Vergangenheit oder vergangene Ereignisse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "yesterday",
                                "target_lang_sense_clarification": "the past"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过去",
                                "target_lang_sense_clarification": "名词，指往事"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gestern",
                                "target_lang_sense_clarification": "Substantiv, steht metaphorisch für die Vergangenheit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
