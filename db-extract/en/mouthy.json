                    {
                        "sense_id": "69a0c8c0-2fbc-3dc2-8377-7eb6a8359696",
                        "entry_id": "1f81f1e8-c9d5-369d-9b3c-081541024162",
                        "glosses": [
                            "Of a dog: inclined to bite or nip."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8247766-03d2-4a31-8dd1-b6263610931a",
                                "sense_id": "69a0c8c0-2fbc-3dc2-8377-7eb6a8359696",
                                "text": "An excellent way to redirect a “mouthy” dog's teeth to an appropriate object. Great exercise and the perfect outlet for family members who want to play roughly."
                            },
                            {
                                "example_id": "3b5981e5-a72a-4570-aa3f-71d2cec0c3d7",
                                "sense_id": "69a0c8c0-2fbc-3dc2-8377-7eb6a8359696",
                                "text": "The separation and isolation will send a clear message to your overly mouthy dog. After a couple of minutes, you can try again. It may take a few repetitions before your dog connects the nipping behavior with losing you, […]"
                            }
                        ]
