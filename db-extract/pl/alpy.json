                    },
                    {
                        "translation_id": "f571bab6-aeaf-406a-b68a-1b0e8e1d9c75",
                        "source_entry_id": "5809e75d-e602-3fb6-81f4-08cd672d93ab",
                        "source_sense_id": "40af1d97-1811-39f3-ab0c-1a721b98c4df",
                        "target_lang_word": "Alpen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alpen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dbe056e-c70e-3fee-af1d-f3bd1085c466",
                                        "entry_id": "0ec8e764-5c5a-33ab-8ff6-0051be5aed93",
                                        "glosses": [
                                            "ein mitteleuropäisches Gebirge, an dem Deutschland, Österreich, die Schweiz, Liechtenstein, Slowenien, Italien und Frankreich Anteil haben; das höchste und nach Ausdehnung größte Gebirge Europas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dc3bb2-7edc-4dfa-b377-51ce1d2e22e4",
                                                "sense_id": "0dbe056e-c70e-3fee-af1d-f3bd1085c466",
                                                "text": "„Sechs deutsche Segelflieger, unter ihnen Hanna Reitsch, überqueren von Salzburg aus die Alpen und landen bei Udine.“"
                                            },
                                            {
                                                "example_id": "29e62a7e-a721-4653-a68c-9ac75fadf5a3",
                                                "sense_id": "0dbe056e-c70e-3fee-af1d-f3bd1085c466",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            },
                                            {
                                                "example_id": "043a27e1-8d0c-4ebb-93a9-113df0a50b1c",
                                                "sense_id": "0dbe056e-c70e-3fee-af1d-f3bd1085c466",
                                                "text": "„Die Primeln unserer Alpen, das Entzücken des Bergwanderers, sind fast alle für den Tieflandgarten ungeeignet.“"
                                            },
                                            {
                                                "example_id": "ad2031cc-63a2-4381-b9e2-716b44c2f4bf",
                                                "sense_id": "0dbe056e-c70e-3fee-af1d-f3bd1085c466",
                                                "text": "Hannibal überquerte die Alpen mit Elefanten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                        "entry_id": "0ec8e764-5c5a-33ab-8ff6-0051be5aed93",
                                        "glosses": [
                                            "eine Bezeichnung für andere relativ lange und hohe Gebirgszüge"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bd93198-cd2d-43b7-ac2f-f3bc121a09e9",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Läßt sich, durch ihre dichte Belaubung, leicht von der Species unterscheiden und ist gleichfalls auf den Alpen von Nepal und Cassimir [Kaschmir] zu Hause.“"
                                            },
                                            {
                                                "example_id": "a0584fab-9186-443f-9e3a-3b03d42c6572",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Während am Fuß der Alpen von Südamerika z. B. Palmen und Gewürze wachsen, findet sich einige hundert Fuß höher in ihrer Umgebung noch der Chinarindebaum, […]“"
                                            },
                                            {
                                                "example_id": "b722a57c-7f93-4195-9192-469268459db4",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Das Wort Gurbi, womit man die Tunkinischen Alpen bezeichnet, bedeutet nach Hrn. Schmidt eigentlich nur Plateau (Hochthal) in den mongol. Dialekten.“"
                                            },
                                            {
                                                "example_id": "baad1979-0e0e-401d-abfd-01f72b7a30bf",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„[…] Calceolaria und Mimulus, wie sie bei uns im bunten Gemisch in den Glashäusern und vor den Fenstern prangen, erblühen dort auf den Alpenhöhen; vor allem aber fallen die Cactus-Arten der mexikanischen und chilenischen Alpen auf.“"
                                            },
                                            {
                                                "example_id": "99517ed3-443d-415f-bd99-14e3f6253dd3",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Wie er dort darauf hinweist, dass man in den Beschreibungen der europäischen und amerikanischen Alpen gerne über die Wahrheit hinausgehe, und er dabei eine Kritik der Schönheit der Alpen entwirft, so führt er hier diesen Gedanken stark ins Persönliche.“"
                                            },
                                            {
                                                "example_id": "447019bd-9cd0-42a4-a41e-d3b161cd3196",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Ein wenig später kommen Berge zum Vorschein. Majestätische, erhabene Berge. Der 6830 Meter hohe Topungato-Vulkan, dann der höchste Riese Südamerikas, der 7010 Meter hohe Aconcagua in den Argentinischen Alpen.“"
                                            },
                                            {
                                                "example_id": "8b623ec0-4aae-4af4-bcdc-f34a2beecd88",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Ähnlich geht’s uns mit den 89 ›wunderbaren Meilen‹, die vom Cascade-Nationalpark als ›Amerikanische Alpen‹ gepriesen werden. Ob sie den Alpen-Namen verdienen, läßt sich nicht nachprüfen.“"
                                            },
                                            {
                                                "example_id": "19f53793-558d-42cb-9237-10cf46e580b4",
                                                "sense_id": "56d56d70-7118-3cb3-8e84-7abec27c94e0",
                                                "text": "„Die nördlichen Kaskaden mit ihren schneebedeckten Bergen, die steil über dicht bewaldeten Tälern aufragen, werden oft als ›Amerikanische Alpen‹ bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Alpen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf9a0f1b-7ed7-35c1-8eda-b6a6fbf02550",
                                        "entry_id": "60230120-f20c-3313-8ebc-8dab9292c93e",
                                        "glosses": [
                                            "eine Stadt in Nordrhein-Westfalen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b85ce1b5-bfec-4c2f-b51e-3b6e6fcbd4cf",
                                                "sense_id": "cf9a0f1b-7ed7-35c1-8eda-b6a6fbf02550",
                                                "text": "Wenn ich Leuten sage, dass ich aus Alpen komme, denken sie, ich würde die Alpen meinen."
                                            }
