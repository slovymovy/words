                "senses": [
                    {
                        "sense_id": "cc81669c-3d4e-347a-950d-ba02e806fe59",
                        "entry_id": "660e2653-308c-3116-9b89-4ef60a614da1",
                        "glosses": [
                            "Fossé, cavité, excavation, gouffre où se déverse un cours d’eau."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "f252db08-912a-4d8f-9e93-0d6e0853844a",
                                "sense_id": "cc81669c-3d4e-347a-950d-ba02e806fe59",
                                "text": "Ces gouffres de disparition on les nomme « chantoir » peut-être à cause de la monotone chanson que murmure le ruisseau en pénétrant dans le domaine de la nuit. Le chantoir, c'est la fissure que creusa, qu'agrandit, que prolongea cet incomparable et tout puissant mineur qu'est l'eau. Dans le vallon de Sècheval on compte plus de 200 chantoirs."
                            },
                            {
                                "example_id": "5eba8887-bfe7-4ec0-aa5d-2ee2b270cb70",
                                "sense_id": "cc81669c-3d4e-347a-950d-ba02e806fe59",
                                "text": "Cette fois, la Lesse, fait assez rare, se déversa pendant plus de trente six heures dans ce chantoir."
                            },
                            {
                                "example_id": "89408c78-1233-4307-94fc-75a13a924151",
                                "sense_id": "cc81669c-3d4e-347a-950d-ba02e806fe59",
                                "text": "Le chantoir, dans l’est de la Wallonie, désigne l’excavation où s’engouffre un cours d’eau dans un sol calcaire."
                            },
                            {
                                "example_id": "26eb4f0c-954e-47f9-a30e-609e8494e847",
                                "sense_id": "cc81669c-3d4e-347a-950d-ba02e806fe59",
                                "text": "Le Vallon des Chantoirs."
                            }
                        ]
                    }
                ],
