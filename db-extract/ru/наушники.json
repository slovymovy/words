                    },
                    {
                        "translation_id": "1749c9aa-e06c-474d-afa3-1707c4cb48cc",
                        "source_entry_id": "1178c23a-1085-3e4c-be71-bb1d99fb423c",
                        "source_sense_description": "прикладываемый к ушам или надеваемый на уши прибор для слушания, соединенный со звукопередающим аппаратом",
                        "target_lang_word": "headset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f308fbb9-3c56-3b3d-8dce-8da2d2646fdd",
                                        "entry_id": "f001ceb4-6b53-3070-b710-5030b3b5e460",
                                        "glosses": [
                                            "A pair of headphones or earphones, or a singular headphone or earphone, typically with an attached microphone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19496639-0c7e-34b6-867d-ff579e4b049a",
                                        "entry_id": "f001ceb4-6b53-3070-b710-5030b3b5e460",
                                        "glosses": [
                                            "Any electronic device worn on the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59bad37d-2186-4914-822b-0ad1d46ae928",
                                                "sense_id": "19496639-0c7e-34b6-867d-ff579e4b049a",
                                                "text": "If you've just acquired a Google Glass headset for £1,000, don't show it off at the movies. UK cinemas are to ban the headsets over fears that the gadgets can be used to make pirate copies of Hollywood blockbusters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad1e30aa-71db-3b18-87f2-4a3a3e59fb3a",
                                        "entry_id": "f001ceb4-6b53-3070-b710-5030b3b5e460",
                                        "glosses": [
                                            "On a bicycle, the system of bearings that connects the fork to the frame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51c4f483-7c76-305c-b82d-cf78ffc612c6",
                                        "entry_id": "f001ceb4-6b53-3070-b710-5030b3b5e460",
                                        "glosses": [
                                            "A mindset."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068a2411-1206-4217-bc5a-46267aa51bfe",
                                                "sense_id": "51c4f483-7c76-305c-b82d-cf78ffc612c6",
                                                "text": "One member has this whole collection of 50s rockabilly by women. Like the blues, the lyrics reflect the headset of the time, so of course it's not all \"non-sexist.\" But it's a great record, really connected to the roots of rock 'n roll."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40b6ba6e-f570-4d12-b8a7-1d26b07826ae",
                        "source_entry_id": "1178c23a-1085-3e4c-be71-bb1d99fb423c",
                        "source_sense_description": "прикладываемый к ушам или надеваемый на уши прибор для слушания, соединенный со звукопередающим аппаратом",
                        "target_lang_word": "headphones",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headphones",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbf403f-b818-3d01-a0ae-c2df3fea7c95",
                                        "entry_id": "aa75e7ee-570b-3fe9-90fb-8c99a423b0b0",
                                        "glosses": [
                                            "A pair of cushioned speakers worn over or in the ears so only the wearer can hear the sound."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34b0823-2342-4848-8bce-66025b886e99",
                                                "sense_id": "bbbf403f-b818-3d01-a0ae-c2df3fea7c95",
                                                "text": "Circumaural headphones enclose the ear, supra-aural headphones rest on the ear's surface, and earbuds are placed inside the ear."
                                            },
                                            {
                                                "example_id": "70b3674e-834c-43c2-9460-c6691f514470",
                                                "sense_id": "bbbf403f-b818-3d01-a0ae-c2df3fea7c95",
                                                "text": "My headphones / They saved my life / Your tape / It lulled me to sleep"
                                            },
                                            {
                                                "example_id": "851df32d-54a5-4e28-b038-3561a3390e00",
                                                "sense_id": "bbbf403f-b818-3d01-a0ae-c2df3fea7c95",
                                                "text": "Toward the end of the film Nazu rushes into her bedroom, clamps on headphones and listens to the technopoppy \"I Wanna Be Free.\" The picturization shows her moving convulsively, desperately to the funky beat, turning ever more agitated, until we wonder what she wants to be free from: free from her domestic vise, or free from life?"
                                            },
                                            {
                                                "example_id": "ab1a2199-d0f0-405d-b13b-36bf95147901",
                                                "sense_id": "bbbf403f-b818-3d01-a0ae-c2df3fea7c95",
                                                "text": "Detectorists may also carry headphones, a metal detecting shovel, hand tools such as a hori-hori (a serrated, steel hand shovel), a “finds pouch,” and a hand-held precision detector called a pinpointer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
