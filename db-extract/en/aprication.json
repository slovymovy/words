                        "glosses": [
                            "The act of apricating, or basking in the sun."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a2c7f7ab-e8f6-4b4d-b1fb-7d511dbe6ca9",
                                "sense_id": "8e91c08e-3a31-38b9-88d9-9929f009b1d4",
                                "text": "Aprication, a beaking in the sunne.\""
                            },
                            {
                                "example_id": "f4d82a57-609a-4467-a8b4-6363a2059ac5",
                                "sense_id": "8e91c08e-3a31-38b9-88d9-9929f009b1d4",
                                "text": "Very few persons seem to have a due sense of the luxury and benefit of aprication, or immersion in the sunshine bath, which every fair day will furnish gratuitously to all applicants."
                            },
                            {
                                "example_id": "5b22ad7d-78ba-4d23-96d0-72a4fe7b8225",
                                "sense_id": "8e91c08e-3a31-38b9-88d9-9929f009b1d4",
                                "text": "We would tease him about the countless hours he would spend soaking in suntan lotion as he lay on the same exact spot along the pool. \"How long were you in heaven this morning?\" my mother would ask. \"Two straight hours. But I plan to return early this afternoon for a much longer aprication.\""
                            }
                        ]
                    }
