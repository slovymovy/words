                    "frequency": "Middle",
                    "semantic_group_id": "comportement_humain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué par son travail, il a répondu <w>automatiquement</w> sans écouter la question posée."
                        },
                        {
                            "text": "Chaque matin, elle prépare son café <w>automatiquement</w> sans même y penser."
                        }
                    ],
                    "common_phrases": [
