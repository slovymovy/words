                        "form": "die Umstrukturierung"
                    },
                    {
                        "form_id": "e2730d17-18db-440d-89bc-5ce710040a71",
                        "entry_id": "e5dfc3f5-2bd2-382d-8344-a31c132762a0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Umstrukturierungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                        "entry_id": "e5dfc3f5-2bd2-382d-8344-a31c132762a0",
                        "glosses": [
                            "erhebliche/tiefgreifende Veränderung, beispielsweise einer Organisation, damit diese effektiver funktioniert; besonders im Bereich von Firmen/der Wirtschaft verwendet, dort auch euphemistisch für Arbeitsplatzabbau gebraucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd28ce0-90d3-4116-8030-6bf3d1fac864",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Die Umstrukturierung der angeschlagenen Neckar Odenwald-Kliniken wird weiter voran getrieben.“ [Anmerkung: Das Verb vorantreiben wird zusammen geschrieben, damit auch seine Flexion vorangetrieben.]"
                            },
                            {
                                "example_id": "33b9e0b0-0f13-4b14-8923-3d52936650c8",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„J. führte das Unternehmen nach kompletter Umstrukturierung wieder auf Erfolgskurs mit Produkten wie dem iPod, iPhone, und dem iPad.“"
                            },
                            {
                                "example_id": "d78e06f2-5c5d-4611-acba-c9ecd6023036",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Bundesweit sollen durch die Umstrukturierung 13.000 Jobs wegfallen beziehungsweise dem Bedarf angepasst werden, weltweit betrifft das rund 30.000 Stellen.“"
                            },
                            {
                                "example_id": "a465950e-9663-4445-a91d-5d3f42ba762a",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Die beiden Unternehmen beschäftigen zusammen rund 5.000 Mitarbeiter. Ob es im Rahmen des Zusammenschlusses zu einer Umstrukturierung und einem Stellenabbau kommt, wollte ein Sprecher der Provinzial Nordwest nicht sagen.“"
                            },
                            {
                                "example_id": "bc41f01c-cc08-49a6-b40f-904d6769c5c3",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Im Investmentbanking, das im Zuge der Umstrukturierung deutlich verkleinert wurde, legten die Erträge um 46 Prozent auf 2,7 Milliarden Euro zu.“"
                            },
                            {
                                "example_id": "2caa35c7-5b21-45dc-9e09-60f405db42b8",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Im Zuge einer Umstrukturierung schließt die Sparkasse Vorderpfalz zehn Standorte zwischen Ludwigshafen und Speyer.“"
                            },
                            {
                                "example_id": "adf5b6b2-1033-442e-9302-baa858a8c18f",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Bei einer anstehenden Umstrukturierung sei es normal, dass man Personen nicht mehr mit den gesamten Aufgaben der neuen Organisation betraut, sagte der [Anmerkung: Armeesprecher Daniel] Reist weiter.“"
                            },
                            {
                                "example_id": "334e5894-d638-4584-b1b5-0189620cceae",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "[Mit dem ] „Übergang zur Elektromobilität […] müssen große Umstrukturierungen in den Werken umgesetzt werden […].“"
                            },
                            {
                                "example_id": "1ef1f48e-eb54-4509-adae-4ccbb6766482",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "[Der regierungsnahe Medienmanager Miklós Vaszil] „präsentierte einen Plan zur Umstrukturierung der Redaktion.“"
                            },
                            {
                                "example_id": "6f93819b-8a3a-490e-a34d-ea963bf94d74",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Nach der Gründung der Treuhand wurde ein Gesetz verabschiedet, das die Aufgaben der Treuhandanstalt umreißen sollte: Die Umstrukturierung der ostdeutschen Wirtschaft im Rahmen der Wiedervereinigung.“"
                            },
                            {
                                "example_id": "9707f90e-9d23-466a-9d07-3594ea36b3f4",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Seit der ersten Arbeitsgruppe zur Umstrukturierung sind inzwischen acht Jahre vergangen.“"
                            },
                            {
                                "example_id": "0a2df200-edd5-4176-aa8a-c5a5dfc71508",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„Fanny Wright musste einsehen, dass nur eine langsame, allmähliche Umstrukturierung zum Erfolg führen konnte.“"
                            },
                            {
                                "example_id": "bcd3db35-9765-445a-a8bd-5ced1e948e1b",
                                "sense_id": "0febd97f-54cf-3a4d-91d6-7cc00b05aa5a",
                                "text": "„[…] im Gespräch mit Experten erfahren Michael und Nina, warum Pubertierende oft wirklich nicht wissen, was sie tun und welche Rolle dabei Umstrukturierungen im Gehirn spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
