                                    },
                                    {
                                        "sense_id": "9a8cb6dc-cfdd-3a39-9082-91dfd4cde305",
                                        "entry_id": "2c79fb3a-ce2c-33ad-a808-4189edb9e23c",
                                        "glosses": [
                                            "ständig oder immer wieder vorkommend"
