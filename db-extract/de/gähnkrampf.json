                "senses": [
                    {
                        "sense_id": "917e7777-1aa1-35fa-b117-d83d9ade6581",
                        "entry_id": "e902b8ab-e8ab-30ec-b50f-8b083de44fa3",
                        "glosses": [
                            "kaum beherrschbares, krampfartig auftretendes Gähnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b3a139e-19f2-4672-bb92-856e9ce53f25",
                                "sense_id": "917e7777-1aa1-35fa-b117-d83d9ade6581",
                                "text": "„Manche wurden wie nach ausgestandener Mühe von einem Gähnkrampf befallen.“"
                            },
                            {
                                "example_id": "337bfa65-b417-4cdc-b5fd-69bbdb976529",
                                "sense_id": "917e7777-1aa1-35fa-b117-d83d9ade6581",
                                "text": "„Katharina kriegt einen Gähnkrampf und steckt Mandy damit an.“"
                            },
                            {
                                "example_id": "09861fd1-87c9-4766-8690-8df10220e2ca",
                                "sense_id": "917e7777-1aa1-35fa-b117-d83d9ade6581",
                                "text": "„Das Gähnen wurde zu einem Gähnkrampf, als wirke sich das Ausbleiben von Nervosität und Sauerstoffmangel aus. Nach dem Gähnkrampf fühlte Plath sich noch besser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
