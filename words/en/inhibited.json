{
    "word_family": [
        "inhibit",
        "inhibition",
        "inhibitor",
        "inhibitory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2cd999b3-0c49-3a94-a965-218ddf1e610e",
                    "sense_definition": "Reserved or repressed, prone to quiet, inexpressive behavior.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt too <w>inhibited</w> to dance in front of the large crowd.",
                            "target_lang_translations": {
                                "nl": "Hij voelde zich te <w>geremd</w> om voor de grote menigte te dansen."
                            }
                        },
                        {
                            "text": "She became less <w>inhibited</w> after she started taking acting classes.",
                            "target_lang_translations": {
                                "nl": "Ze werd minder <w>geremd</w> nadat ze begon met acteerlessen."
                            }
                        }
                    ],
                    "synonyms": [
                        "reserved",
                        "shy",
                        "withdrawn",
                        "repressed"
                    ],
                    "antonyms": [
                        "uninhibited",
                        "outgoing",
                        "extroverted"
                    ],
                    "common_phrases": [
                        "feel inhibited"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gereserveerd of onderdrukt, geneigd tot stil en inexpressief gedrag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geremd",
                                "target_lang_sense_clarification": "gevoel van sociale terughoudendheid of onvermogen om jezelf te uiten"
                            },
                            {
                                "target_lang_word": "verlegen",
                                "target_lang_sense_clarification": "terughoudend in sociale situaties"
                            },
                            {
                                "target_lang_word": "terughoudend",
                                "target_lang_sense_clarification": "afwachtend en niet geneigd om jezelf te laten zien"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20aaaaf8-8342-3936-a3f1-f383c0516564",
                    "sense_definition": "Simple past and past participle of <w>inhibit</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law <w>inhibited</w> the growth of small businesses in the area.",
                            "target_lang_translations": {
                                "nl": "De nieuwe wet <w>belemmerde</w> de groei van kleine bedrijven in het gebied."
                            }
                        },
                        {
                            "text": "Fear of failure has <w>inhibited</w> his progress for many years.",
                            "target_lang_translations": {
                                "nl": "Faalangst heeft zijn vooruitgang jarenlang <w>geremd</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'inhibit' (belemmeren, remmen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "belemmerde",
                                "target_lang_sense_clarification": "iets in de weg staan of de voortgang vertragen"
                            },
                            {
                                "target_lang_word": "geremd",
                                "target_lang_sense_clarification": "de ontwikkeling of groei van iets tegenhouden"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}