                                "example_id": "78fe78b3-7d90-4944-babc-de3a13499101",
                                "sense_id": "74cb0f70-e6a5-31c6-854d-6d649ef714e4",
                                "text": "Im Winter 1942 scheiterte der Entsatz für die in Stalingrad eingeschlossene 6. Armee durch die Panzergruppe Hoth."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "300afbbe-b04c-37c3-8ab5-ccf6a00b0d61",
