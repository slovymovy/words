                "senses": [
                    {
                        "sense_id": "b803b9d7-aa2e-3756-bcef-79e95742ef40",
                        "entry_id": "95972980-6dde-3f00-899c-bd65e6d38651",
                        "glosses": [
                            "Se montrer hypocondriaque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b24fb2b-35f2-486f-8a4e-53c0da39c34a",
                                "sense_id": "b803b9d7-aa2e-3756-bcef-79e95742ef40",
                                "text": "Quand je vois les symptômes d'autisme, j'hypocondriaquise …"
                            },
                            {
                                "example_id": "7a7ba11b-e414-4051-9151-15fb20ccbf64",
                                "sense_id": "b803b9d7-aa2e-3756-bcef-79e95742ef40",
                                "text": "Je ne crois pas vraiment qu'on puisse corréler une augmentation perçue de la température de l'ordinateur avec une mort imminente du disque dur, mais je te laisse hypocondriaquiser : si ça te pousse à faire des sauvegardes régulières (via Time Machine par exemple) sur un disque externe, c'est une bonne paranoïa"
                            }
                        ]
                    }
