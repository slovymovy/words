                    ]
                },
                {
                    "sense_id": "47938f38-fe02-362b-a889-8cb187743290",
                    "sense_definition": "inicjować powstanie organizacji, stowarzyszenia lub relacji między ludźmi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inicjowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mieszkańcy postanowili <w>zawiązać</w> komitet w obronie lokalnego parku.",
                            "target_lang_translations": {
                                "ru": "Жители решили <w>создать</w> комитет в защиту местного парка."
                            }
                        },
                        {
                            "text": "Warto <w>zawiązywać</w> nowe znajomości podczas konferencji branżowych.",
                            "target_lang_translations": {
                                "ru": "Стоит <w>завязывать</w> новые знакомства во время отраслевых конференций."
                            }
                        }
                    ],
                    "synonyms": [
                        "zakładać",
                        "organizować",
                        "inicjować"
                    ],
                    "common_phrases": [
                        "zawiązywać znajomości",
                        "zawiązywać komitet"
                    ],
                    "target_lang_definitions": {
                        "ru": "инициировать создание организации, объединения или установление отношений между людьми"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завязывать",
                                "target_lang_sense_clarification": "используется в контексте отношений (знакомства)"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "для организаций или комитетов"
                            },
                            {
                                "target_lang_word": "учреждать",
                                "target_lang_sense_clarification": "официальное создание организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6790162-94c0-3b74-a63f-2d34462a34ee",
                    "sense_definition": "tworzyć początkową formę kwiatu, liścia lub owocu na roślinie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drzewa owocowe zaczynają <w>zawiązywać</w> pąki wczesną wiosną.",
                            "target_lang_translations": {
                                "ru": "Фруктовые деревья начинают <w>завязывать</w> почки ранней весной."
                            }
