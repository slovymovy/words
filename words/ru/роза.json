{
    "word_family": [
        "розовый",
        "розочка",
        "розарий"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddeff922-8f3b-38c5-b1c2-c9f662f98ed2",
                    "sense_definition": "декоративное кустарниковое растение с шипами и красивыми ароматными цветами, а также сам этот цветок",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он подарил ей красивый букет красных <w>роз</w> на день рождения.",
                            "target_lang_translations": {
                                "en": "He gave her a beautiful bouquet of red <w>roses</w> for her birthday."
                            }
                        },
                        {
                            "text": "В нашем саду растёт высокий куст белой <w>розы</w>.",
                            "target_lang_translations": {
                                "en": "A tall white <w>rose</w> bush grows in our garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "розочка"
                    ],
                    "common_phrases": [
                        "букет роз",
                        "лепестки роз",
                        "куст роз"
                    ],
                    "target_lang_definitions": {
                        "en": "a decorative thorny shrub with fragrant flowers, or the flower itself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rose",
                                "target_lang_sense_clarification": "flower or shrub"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a38a5053-1679-392f-bd71-9ff09366631a",
                    "sense_definition": "растение других видов с крупными яркими цветами, напоминающими цветок шиповника",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "растение",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На подоконнике в кабинете пышно цвела китайская <w>роза</w>.",
                            "target_lang_translations": {
                                "en": "A China <w>rose</w> was blooming lavishly on the windowsill in the study."
                            }
                        },
                        {
                            "text": "Этот ароматный чай заваривают из лепестков суданской <w>розы</w>.",
                            "target_lang_translations": {
                                "en": "This aromatic tea is brewed from the petals of the Sudan <w>rose</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "китайская роза",
                        "суданская роза"
                    ],
                    "target_lang_definitions": {
                        "en": "a plant of other species bearing large, bright flowers resembling a wild rose"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rose",
                                "target_lang_sense_clarification": "in compound names of other flowering plants"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83ae94bd-fd7a-3805-a082-5b9eaef246f6",
                    "sense_definition": "большое круглое окно с радиальным переплётом в романской и готической архитектуре",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы долго любовались витражами огромной готической <w>розы</w> старинного собора.",
                            "target_lang_translations": {
                                "en": "The tourists spent a long time admiring the stained glass of the ancient cathedral's huge Gothic <w>rose window</w>."
                            }
                        },
                        {
                            "text": "Через центральную <w>розу</w> храма внутрь лился мягкий разноцветный свет.",
                            "target_lang_translations": {
                                "en": "Soft, multicolored light poured inside through the church's central <w>rose window</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "готическая роза"
                    ],
                    "target_lang_definitions": {
                        "en": "a large circular window with radial tracery in Romanesque and Gothic architecture"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rose window",
                                "target_lang_sense_clarification": "architectural feature"
                            },
                            {
                                "target_lang_word": "rose",
                                "target_lang_sense_clarification": "circular Gothic window"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d02ba1b8-a80e-380a-884c-30ddecb7717a",
                    "sense_definition": "клубный шарф с символикой спортивной команды у болельщиков",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед началом матча каждый преданный фанат поднял над головой свою <w>розу</w>.",
                            "target_lang_translations": {
                                "en": "Before the match began, every devoted fan held their <w>club scarf</w> above their head."
                            }
                        },
                        {
                            "text": "Вся фанатская трибуна сегодня пестрела красно-белыми <w>розами</w>.",
                            "target_lang_translations": {
                                "en": "The entire supporters' stand was awash with red-and-white <w>scarves</w> today."
                            }
                        }
                    ],
                    "common_phrases": [
                        "фанатская роза"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "жаргон спортивных болельщиков"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a sports team scarf worn by supporters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "supporter scarf",
                                "target_lang_sense_clarification": "football fan accessory"
                            },
                            {
                                "target_lang_word": "football scarf",
                                "target_lang_sense_clarification": "club scarf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d34edb47-7367-3ea5-b7c0-460ed60658cc",
                    "sense_definition": "красивая, цветущая здоровьем и молодостью девушка или женщина",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "человек",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В деревне все удивлялись её красоте и говорили, что она цветёт как настоящая <w>роза</w>.",
                            "target_lang_translations": {
                                "en": "In the village, everyone was amazed by her beauty, saying she blossomed like a true <w>rose</w>."
                            }
                        },
                        {
                            "text": "Молодая хозяйка дома была свежа и прекрасна, словно распустившаяся майская <w>роза</w>.",
                            "target_lang_translations": {
                                "en": "The young mistress of the house was fresh and lovely, like a blooming May <w>rose</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорно-переносное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a beautiful girl or woman radiating health and youth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rose",
                                "target_lang_sense_clarification": "figuratively, of a beautiful woman"
                            },
                            {
                                "target_lang_word": "beauty",
                                "target_lang_sense_clarification": "attractive woman"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b39bd4de-7452-312b-b8e1-f48305944c1a",
                    "sense_definition": "свежий румянец или здоровый яркий цвет щёк",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "внешность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С годами прежние <w>розы</w> на её щеках начали медленно уступать место бледности.",
                            "target_lang_translations": {
                                "en": "Over the years, the former <w>roses</w> on her cheeks began to slowly give way to paleness."
                            }
                        },
                        {
                            "text": "Поэт в своих стихах часто воспевал нежные <w>розы</w> на ланитах юной возлюбленной.",
                            "target_lang_translations": {
                                "en": "In his verses, the poet often praised the delicate <w>roses</w> on the cheeks of his youthful beloved."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее поэтическое значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a fresh blush or healthy rosy color on one's cheeks"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "roses",
                                "target_lang_sense_clarification": "rosy color or blush on cheeks"
                            },
                            {
                                "target_lang_word": "rosiness",
                                "target_lang_sense_clarification": "blush on cheeks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0325891-fd54-357f-b3d6-beaa150e4c51",
                    "sense_definition": "плоская кривая линия, графически напоминающая лепестки цветка",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На лекции по геометрии студенты подробно изучали свойства математической <w>розы</w>.",
                            "target_lang_translations": {
                                "en": "In the geometry lecture, students studied the properties of the mathematical <w>rose curve</w> in detail."
                            }
                        },
                        {
                            "text": "Уравнение в полярных координатах задавало красивую правильную трёхлепестковую <w>розу</w>.",
                            "target_lang_translations": {
                                "en": "The equation in polar coordinates produced a beautiful, regular three-petaled <w>rose</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a plane curve shaped like the petals of a flower"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rose",
                                "target_lang_sense_clarification": "mathematical curve"
                            },
                            {
                                "target_lang_word": "rhodonea",
                                "target_lang_sense_clarification": "mathematical rose curve"
                            }
                        ]
                    }
                }
            ]
        },
        {
