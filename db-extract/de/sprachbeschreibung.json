                "senses": [
                    {
                        "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                        "entry_id": "986b0486-6d98-33aa-9479-41bdfec6fe55",
                        "glosses": [
                            "Vorgang und Ergebnis der Darstellung der Einheiten und Regeln einer oder mehrerer Sprachen (Sprachsystem) sowie ihrer Entwicklung (Sprachwandel) und Verwendung (Sprachverwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c445eb8c-9eb0-4ce6-9b6e-4e3825ca9522",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "„Die Sprachbeschreibung ist auch in der Wissenschaft kein Selbstzweck, sondern soll unser Verständnis vom Gebrauch der Sprache und von den sprachlichen Zeichen (…) weiterbringen.“"
                            },
                            {
                                "example_id": "c34ae0b1-0755-4a6f-9e33-fd94b31139e4",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "Die Sprachbeschreibung ist ein vorrangiges Ziel der Linguistik, wie zum Beispiel Buchtitel wie „Einführung in die deskriptive Linguistik“ anzeigen."
                            },
                            {
                                "example_id": "f942dfa5-81ac-4c1d-a10e-d65cb957f6fb",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "Kummer gibt in „Theorie der Sprachbeschreibung“ einen Überblick über die vielfältigen Aufgaben, die damit verbunden sind."
                            },
                            {
                                "example_id": "ecfed105-3943-400b-891d-39711833c53e",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "„Wenn wir ein Inventar dieser Mittel aufnehmen und die Art ihres Zusammenwirkens feststellen wollen, stehen wir vor der Aufgabe der Sprachbeschreibung, zum Schrecken des Laien auch »deskriptive Grammatik« genannt (…).“"
                            },
                            {
                                "example_id": "ff0b5ff0-e20a-4666-b3fd-b84dcf473d76",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "„Diese Formulierungen zeigen die Abwendung von einer eher präskriptiven Sprachbeschreibung zugunsten einer eher deskriptiven Orientierung.“"
                            },
                            {
                                "example_id": "4ae1592b-dc4d-41b1-b5ae-df67d87e035b",
                                "sense_id": "a2ff373a-8e6a-341b-a445-ba8f3d1ccce2",
                                "text": "Wesentliche Ergebnisse der Sprachbeschreibung sind Grammatiken und Lexika."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
