                ],
                "senses": [
                    {
                        "sense_id": "0062cda5-d882-3c3b-b8c5-d0c05c190b08",
                        "entry_id": "d518eac9-d12e-36bb-816c-5d884c7f57d1",
                        "glosses": [
                            "to come into sight/view, to loom, to appear, to come into the picture"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1486c930-adaa-4e1c-ad01-0671b999554e",
                                "sense_id": "0062cda5-d882-3c3b-b8c5-d0c05c190b08",
                                "text": "вырисо́вываться на фо́не",
                                "translation": "to stand out (against); stand out in relief (against)",
                                "english": "to stand out (against); stand out in relief (against)"
                            },
                            {
                                "example_id": "b0fed4fd-6f34-4af3-a50e-0b6a3d276de1",
                                "sense_id": "0062cda5-d882-3c3b-b8c5-d0c05c190b08",
                                "text": "На горизо́нте вырисо́вывалась го́рная цепь.",
                                "translation": "A mountain chain was visible on [stood out against] the horizon.",
                                "english": "A mountain chain was visible on [stood out against] the horizon."
                            },
                            {
                                "example_id": "fc10714b-41b3-411c-86a2-b25fd852c8fd",
                                "sense_id": "0062cda5-d882-3c3b-b8c5-d0c05c190b08",
                                "text": "Вдали́ на́чал вырисо́вываться кора́бль.",
                                "translation": "A ship loomed in the distance.",
                                "english": "A ship loomed in the distance."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b9fc650-3602-39a0-b88a-c23799ac6edd",
                        "entry_id": "d518eac9-d12e-36bb-816c-5d884c7f57d1",
                        "glosses": [
                            "to become clearer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ccd5ec5-8c43-4cb8-a163-804651510a26",
                                "sense_id": "5b9fc650-3602-39a0-b88a-c23799ac6edd",
                                "text": "Сейча́с вырисо́вывается карти́на происше́дшего.",
                                "translation": "The detailed picture of the incident is being completed now.",
                                "english": "The detailed picture of the incident is being completed now."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c532500-dd49-3617-8d47-81a5fc14a809",
                        "entry_id": "d518eac9-d12e-36bb-816c-5d884c7f57d1",
                        "glosses": [
                            "to take shape, to emerge, to develop"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1af5dcb5-7753-4cea-a09b-e589979f1278",
                                "sense_id": "0c532500-dd49-3617-8d47-81a5fc14a809",
                                "text": "У нас вырисо́вывается оди́н план.",
                                "translation": "We are making/developing a certain plan.",
                                "english": "We are making/developing a certain plan."
                            },
                            {
                                "example_id": "5b40563b-f8ad-45ea-a467-9d65c4abd530",
                                "sense_id": "0c532500-dd49-3617-8d47-81a5fc14a809",
                                "text": "Что там вырисо́вывается на за́втра?",
                                "translation": "What plans do we have for tomorrow?",
                                "english": "What plans do we have for tomorrow?"
                            }
                        ]
                    },
