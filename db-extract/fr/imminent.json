                        ]
                    },
                    {
                        "translation_id": "3e016308-281a-4acd-b2e0-fa61242380b1",
                        "source_entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "target_lang_word": "imminent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imminent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73c3fc7d-290a-3fd8-b3f0-ec4e7a18dec1",
                                        "entry_id": "e02212b6-e15a-37cd-9f7e-95151f5f29ff",
                                        "glosses": [
                                            "About to happen, occur, or take place very soon, especially of something which won't last long."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3eb4d799-ec11-47da-8fef-5d090e380b9e",
                                                "sense_id": "73c3fc7d-290a-3fd8-b3f0-ec4e7a18dec1",
                                                "text": "To courageous, self-reliant men, with confidence in the power of free and fearless reasoning applied through the processes of popular government, no danger flowing from speech can be deemed clear and present unless the incidence of the evil apprehended is so imminent that it may befall before there is opportunity for full discussion."
                                            },
                                            {
                                                "example_id": "cd3bb1e0-8e34-40f0-9c5d-1a1084f68678",
                                                "sense_id": "73c3fc7d-290a-3fd8-b3f0-ec4e7a18dec1",
                                                "text": "The Second World War was reaching fever pitch, with the entire Allied effort in top gear for the imminent invasion of Europe, while later that month buzz bombs would start falling on London."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef4eb32a-febb-40f4-9c5a-519340f6ecf6",
                        "source_entry_id": "92242382-93a6-34c2-822a-6fafe5b84dec",
                        "target_lang_word": "impending",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impending",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cb63f4-b772-3ef5-9766-32967bbbf249",
                                        "entry_id": "eacc2397-d365-350b-93eb-f287307629c1",
                                        "glosses": [
                                            "Approaching; drawing near; about to happen or expected to happen."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91fe230e-c1b5-4a1b-9517-6f5e7e1ccbfb",
                                                "sense_id": "d4cb63f4-b772-3ef5-9766-32967bbbf249",
                                                "text": "I have no time right now because of an impending paper submission deadline."
                                            },
                                            {
                                                "example_id": "c66eabdd-778a-40e0-abfa-d52dbaa377dc",
                                                "sense_id": "d4cb63f4-b772-3ef5-9766-32967bbbf249",
                                                "text": "\"Keep off Conductor Rails\" said red-painted notices at the platform ends, for third-rails were laid in many places even where electric trains never normally ran, and there had been many rumours of impending electrification of the Wirral, as a natural extension of the Mersey system, a quarter of a century before the change was actually made."
                                            },
                                            {
                                                "example_id": "5daf32bd-72da-4656-9618-8df6d63bcc8c",
                                                "sense_id": "d4cb63f4-b772-3ef5-9766-32967bbbf249",
                                                "text": "Randall and Kate aren’t satirical characters. They’re rational thinkers who unwittingly stumble into a Dr. Strangelove type of situation when they discover mankind’s impending doom, and team up with Dr. Teddy Oglethorpe (Rob Morgan) to report their findings to President Orlean (Meryl Streep)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impending",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0da87d5-0ab0-30f2-afa6-63a9b20ee1d9",
                                        "entry_id": "ca0b83d9-4586-3acc-987f-df87fd7abeb1",
                                        "glosses": [
                                            "present participle and gerund of impend"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5482b708-b57a-46d7-8735-f366e3f3e0de",
                                                "sense_id": "c0da87d5-0ab0-30f2-afa6-63a9b20ee1d9",
                                                "text": "The hurricane is impending."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impending",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c543c930-b565-3556-bf6c-8a94dbe49c8e",
                                        "entry_id": "35f8ad0e-f205-3db4-89be-6ba526d53aaf",
                                        "glosses": [
                                            "Something that impends or threatens; an expected event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fadac783-022f-4606-9364-db2120a68de7",
                                                "sense_id": "c543c930-b565-3556-bf6c-8a94dbe49c8e",
                                                "text": "Speed of locomotion and staying power in horse and others; the sense of smell in dog and in most other creatures (a far subtler and more analytical faculty than is man's mere perception of odour). Even an uncanny supra-natural sense of natural impendings, catastrophe, earthquake and flood, lacking in man, is found in simpler creatures."
                                            },
                                            {
                                                "example_id": "0dbaa323-9171-4e1e-af99-82f3546c688e",
                                                "sense_id": "c543c930-b565-3556-bf6c-8a94dbe49c8e",
                                                "text": "Although I do think about death quite regularly, my intense fear of lesser impendings has taught me that the only way I will survive it is to remain objective […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
