                                        "glosses": [
                                            "Chauffer à l’excès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490dbd39-bc96-4cca-ba7a-0a22a344f5b5",
                                                "sense_id": "3e0d5a5f-2a33-3024-ade2-841eebf4e889",
                                                "text": "La suppression presque complète de l’oxyde de carbone dans la fabrication du gaz à l’eau, au moyen de la vapeur surchauffée est un fait expérimental qui a donné lieu à diverses interprétations sur lesquelles nous appuierons d'une manière spéciale."
                                            },
                                            {
                                                "example_id": "cbad6e2f-fcae-486e-b135-0ff450d441f7",
                                                "sense_id": "3e0d5a5f-2a33-3024-ade2-841eebf4e889",
                                                "text": "Et, surtout, conduire à une connexion au sol surchauffée entraînant un risque d’incendie."
                                            }
                                        ]
                                    }
