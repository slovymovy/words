                        "glosses": [
                            "het betrekken van de belanghebbenden bij een bepaalde fase in de besluitvorming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26d0afcf-3915-4360-9cf5-99e3aaa4241c",
                                "sense_id": "7e030f02-156a-370c-bb52-648f6689e4bf",
                                "text": "De actiegroep Gas(t)vrij Terschelling is van plan bij iedere inspraakronde bezwaar te maken tegen de voorgenomen boringen."
                            },
                            {
                                "example_id": "8ff55673-36b2-4cef-9b02-6089c8c2c446",
                                "sense_id": "7e030f02-156a-370c-bb52-648f6689e4bf",
                                "text": "De lokale autoriteiten hebben de beslissing voor zich uitgeschoven. Er komt in ieder geval een inspraakronde voor het besluit valt, zo is beloofd."
                            },
                            {
                                "example_id": "4437afd1-f07f-4ed3-8c06-4cc9c0b1b64a",
                                "sense_id": "7e030f02-156a-370c-bb52-648f6689e4bf",
                                "text": "Staatsbosbeheer schat dat de eerste dieren over ongeveer een jaar de provinciegrenzen kunnen oversteken. Eerst volgt onder meer nog een inspraakronde voor inwoners van de provincie. Bovendien moet het Rijk nog toestemming geven."
                            }
                        ]
                    }
