                                "target_senses": [
                                    {
                                        "sense_id": "963affdc-712c-3fa8-85d4-93f15bc9624b",
                                        "entry_id": "a5fdfc4a-4bec-3da4-9525-42c9f0f09517",
                                        "glosses": [
                                            "Château médiéval fortifié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6170ec1-abdb-4943-9a78-a3efd89ad1c0",
                                                "sense_id": "963affdc-712c-3fa8-85d4-93f15bc9624b",
                                                "text": "Nous laissâmes sur notre droite un village au centre duquel s’élevait une espèce de château fort."
                                            },
                                            {
                                                "example_id": "6c90d220-2399-4807-86b7-07da6018bacb",
                                                "sense_id": "963affdc-712c-3fa8-85d4-93f15bc9624b",
                                                "text": "Soudain, devant nous, au seuil des montagnes, apparaît une ville. […]. Au-dessus d'elle, un château-fort, les tours encore presque intactes, mais renversées horizontalement, comme dans les mirages qui n’ont pu tourner tout-à-fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060ff37d-1172-310a-b50a-308b108f8df4",
                                        "entry_id": "a5fdfc4a-4bec-3da4-9525-42c9f0f09517",
                                        "glosses": [
                                            "Circonscription électorale traditionnellement acquise à un parti politique en particulier."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9eca91f8-9218-4712-a79d-27d6ec33627d",
                                                "sense_id": "060ff37d-1172-310a-b50a-308b108f8df4",
                                                "text": "Je vis dans Hochelaga-Maisonneuve, château-fort péquiste s’il en est. Ce n’est donc pas très périlleux de voter Québec solidaire dans mon comté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb68e4c-2e37-3cb8-a233-bb88612319d0",
                                        "entry_id": "a5fdfc4a-4bec-3da4-9525-42c9f0f09517",
                                        "glosses": [
                                            "Meuble représentant le bâtiment du même nom dans les armoiries. Il se blasonne comme le château."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18d47b8f-b2e8-4adf-a1ac-da44337b535c",
                                                "sense_id": "8cb68e4c-2e37-3cb8-a233-bb88612319d0",
                                                "text": "D’argent au château-fort de gueules, au chef d’azur chargé de trois fleurs de lys d’or, qui est de la commune de Hautefort de Dordogne → voir illustration « armoiries avec un château-fort »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc515610-2626-4237-b201-1e71e3d1bae4",
                        "source_entry_id": "7c623a4c-05ee-3d47-b668-ff377b6af592",
