                "senses": [
                    {
                        "sense_id": "b187243e-585b-3da9-b1b8-20474e836338",
                        "entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
                        "glosses": [
                            "наречие к скучный; испытывая скуку, отсутствие интереса; скучая"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "29ecb3c8-2e3d-3007-a3f6-bc7a82e0ae5d",
                        "entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
                        "glosses": [
                            "наречие к скучный; вызывая скуку, неинтересно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "825409b1-ff5d-4aa8-9f20-30891a1df114",
                                "sense_id": "29ecb3c8-2e3d-3007-a3f6-bc7a82e0ae5d",
                                "text": "Он долго и скучно рассказывал о новых методах обработки стали."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4cb60a1-69d4-3bbf-a8f4-b6e6f4b3c650",
                        "entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
                        "glosses": [
                            "наречие к скучный; испытывая грусть, тоску"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "349b3891-26f0-4047-ac99-d8d46d2ed9f4",
                                "sense_id": "a4cb60a1-69d4-3bbf-a8f4-b6e6f4b3c650",
                                "text": "Не воротился Кокованя. Скучненько стало Дарёнке, а не плачет."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac2c3362-1930-32ab-b191-7927252831e7",
                        "entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
                        "glosses": [
                            "предик. о чувстве скуки, тоски, испытываемом кем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17384ee7-df5f-4e4b-93f9-271b0e1b5216",
                                "sense_id": "ac2c3362-1930-32ab-b191-7927252831e7",
                                "text": "Мне скучно, надо бы пойти прогуляться."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd4fab40-2b6d-332f-b2e4-2b139574b6e9",
                        "entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
                        "glosses": [
                            "предик. о состоянии скуки, царящей где-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b89a17-b37e-4543-89ec-33a3b98249d2",
                                "sense_id": "bd4fab40-2b6d-332f-b2e4-2b139574b6e9",
                                "text": "С наступлением осени скучно стало в этом парке."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4065c28-b19b-4338-9ae2-f9867ea96214",
                        "source_entry_id": "d921b916-0e4b-340d-9538-f2fe88699747",
