                        "sense_id": "d10c8f19-90c9-3c42-a91d-eb2938d3091f",
                        "entry_id": "58c0abad-7afd-3c12-994a-af139657adf5",
                        "glosses": [
                            "Präzisionsmessgerät für die Bestimmung von Innenmaßen bei Werkstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6024122-087d-4aa2-9fdb-ce5c7c7ca332",
                                "sense_id": "d10c8f19-90c9-3c42-a91d-eb2938d3091f",
                                "text": "„Wo der dafür und für die einzelnen Meßköpfe aufzuwendende Anschaffungspreis gerechtfertigt ist, stellt das Passimeter ein sehr gutes Innenmeßgerät dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b7da971-9045-37a4-8d38-1c6d14a9f6aa",
                        "entry_id": "58c0abad-7afd-3c12-994a-af139657adf5",
                        "glosses": [
                            "Fahrkartengeber, der vor abgesperrten Bereichen Fahrkarten ausgibt"
                        ],
                        "tags": [
                            "öffentlicher Personennahverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "103848a9-0c34-4dbd-9165-2321d6a8224a",
                                "sense_id": "3b7da971-9045-37a4-8d38-1c6d14a9f6aa",
                                "text": "„Ein Passimeter, so die Berufsbezeichnung, kontrollierte die Fahrkarten beim Betreten oder Verlassen von abgesperrten Bereichen, mitunter verkaufte er auch Tickets.“"
                            }
