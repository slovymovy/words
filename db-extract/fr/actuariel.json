                        "glosses": [
                            "Qui a un rapport avec les actuaires et leur métier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0756a39-9197-4e97-9caf-5ad60aba8666",
                                "sense_id": "f6b87663-fc88-3951-b89c-b909175c07c0",
                                "text": "Il s’agit des méthodes d’évaluation actuarielles, des outils qui se présentent sous forme d’échelles et s’appuient sur des statistiques issues d’études menées à travers le monde."
                            },
                            {
                                "example_id": "1a8c02c9-f002-4a32-96dc-14ff33b070d4",
                                "sense_id": "f6b87663-fc88-3951-b89c-b909175c07c0",
                                "text": "Il est en effet possible d’accéder aux fonctions de chargé d’études actuarielles avec un master."
                            }
                        ]
                    }
