                                    {
                                        "sense_id": "039c5b72-4969-3867-8658-f005486102c3",
                                        "entry_id": "e70a7935-4b52-3da8-b811-4374ccd532c4",
                                        "glosses": [
                                            "To disparage; to belittle; to put down; to harshly criticize, especially a work (book, movie, etc.)"
