                                "target_lang_sense_clarification": "относящийся к началу процесса"
                            },
                            {
                                "target_lang_word": "исхо́дный",
                                "target_lang_sense_clarification": "отправной, базовый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最初的",
                                "target_lang_sense_clarification": "存在于最开始的"
                            },
                            {
                                "target_lang_word": "初始的",
                                "target_lang_sense_clarification": "属于过程开始阶段的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f7eba16-7ee4-38d5-968a-e12d09537861",
                    "sense_definition": "Placed at the beginning, especially the first letter of a word.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_first",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>initial</w> letter of a proper noun must always be capitalized.",
                            "target_lang_translations": {
                                "ru": "<w>Начальная</w> буква имени собственного всегда должна быть заглавной.",
                                "zh": "专有名词的<w>首</w>字母必须大写。"
                            }
                        },
                        {
                            "text": "He focused on the <w>initial</w> position of the word in the sentence.",
                            "target_lang_translations": {
                                "ru": "Он сосредоточился на <w>начальной</w> позиции слова в предложении.",
                                "zh": "他专注于该词在句子中的<w>首位</w>。"
                            }
