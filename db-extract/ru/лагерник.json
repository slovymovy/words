                    {
                        "translation_id": "c2a872d4-5787-45ce-b234-9a7c4683cdca",
                        "source_entry_id": "c0252523-a767-3dcf-91a7-5a21d64f17ea",
                        "source_sense_id": "14f4cffa-6cf0-3ff9-92ae-524978cfe5a7",
                        "target_lang_word": "détenu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                        "entry_id": "00e52a87-c7d1-3f75-a42c-26cb4133fcf8",
                                        "glosses": [
                                            "Qui est en état de détention, qui est prisonnier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09e6a3be-8ec7-4bd2-abe4-2ffa8999e5c0",
                                                "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                                "text": "Un homme détenu."
                                            },
                                            {
                                                "example_id": "390d1832-5fbd-4532-892b-78adb04ed051",
                                                "sense_id": "53f38ba5-faf7-3809-8ad3-4451961bc6cd",
                                                "text": "Une femme détenue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                        "entry_id": "9fcb6930-bbf6-3a97-a1ad-50f30c7c8433",
                                        "glosses": [
                                            "Personne en détention, emprisonnée."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1c73bd-9ac3-4947-bd06-f3ca758a1837",
                                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                                "text": "— Et elle m’a traité comme un chien, pis que cela, comme un laquais ; je dirai mieux : comme un détenu politique."
                                            },
                                            {
                                                "example_id": "5ec502fb-3e21-43e1-858a-94c554a9d80d",
                                                "sense_id": "bc77b17c-731f-3483-8404-883823bbd6c5",
                                                "text": "Pas un détenu qui ne se retourne le soir sur sa paillasse à l'idée que l'aube peut être sinistre, qui ne s'endort sans souhaiter qu'il ne se passe rien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "005aa4d3-bde2-36d9-bb46-a0830a4d9007",
                                        "entry_id": "25e2e41a-ac08-353a-866d-1eee5893c674",
                                        "glosses": [
                                            "Participe passé masculin singulier de détenir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60756756-4403-469d-90b4-b97630d077d4",
                                                "sense_id": "005aa4d3-bde2-36d9-bb46-a0830a4d9007",
                                                "text": "M. de La Motte-Guerin, qui commandait dans ces îles, du temps que j’y étais détenu, m’assura que ce prisonnier était le duc de Beaufort, qu’on disait avoir été tué au siège de Candie, et dont on ne put trouver le corps suivant toutes les relations de ce temps-là."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1b906ab-62bb-44c1-ac72-9c9e3be08673",
                        "source_entry_id": "c0252523-a767-3dcf-91a7-5a21d64f17ea",
                        "source_sense_id": "14f4cffa-6cf0-3ff9-92ae-524978cfe5a7",
                        "target_lang_word": "prisonnier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prisonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5b12c47-08d4-3024-88a7-585f07b693de",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Personne qui est arrêtée pour être mise en prison, ou qui y est détenue."
                                        ],
                                        "tags": [
                                            "Prison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18136a8c-2f04-4877-8492-037c62b024f8",
                                                "sense_id": "c5b12c47-08d4-3024-88a7-585f07b693de",
                                                "text": "J'ai vu des prisonniers jetés à coups de matraque d'un étage à l'autre et qui, hébétés par la torture et les coups, ne savaient plus que murmurer en arabe les premières paroles d'une ancienne prière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Celui qui a été pris à la guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f8be222-c3ce-4a02-bce3-6000d6b5b7e4",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Faits prisonniers par les dragons prussiens, nous avions été emmenés jusqu’à Vrigne-aux-Bois au grand trot de nos montures."
                                            },
                                            {
                                                "example_id": "281f68b2-2342-4022-8a02-566eceecce2d",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Le lieutenant Souchier a reçu de sa femme la nouvelle qu’il y a quarante prisonniers à Roanne! Pas un enfant, pas une vieille paralytique, sur la route de Charlieu, qui ne les ait déjà vus."
                                            },
                                            {
                                                "example_id": "f782a353-213c-440a-a2f9-62680435eb04",
                                                "sense_id": "f7e805fb-3986-3954-9bf5-62d096a289ee",
                                                "text": "Encore en 1870, une servante prussienne disait à un prisonnier français employé dans la ferme où elle travaillait : « Quand la guerre sera finie, je t’épouserai ; cela t’étonne ce que je te dis là, mais tu sais, pour nous, le patriotisme cela ne veut pas dire grand-chose. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b9d407f-4c72-32e6-887a-18fbf13da633",
                                        "entry_id": "fd974843-f215-3afb-be66-727a3aa3b133",
                                        "glosses": [
                                            "Personne qui a perdu sa liberté d’action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2c9bb09-4ea5-478f-92fa-0df0054679f9",
                                                "sense_id": "5b9d407f-4c72-32e6-887a-18fbf13da633",
                                                "text": "Vous êtes prisonnier de votre parti. — Il est prisonnier de son passé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prisonnier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Qui est emprisonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d0c60f-93a1-4e4f-8447-e89041ee817c",
                                                "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                                "text": "En ce moment, je conçus l’idée de faire prisonnier le prêtre et de le tuer ou d’obtenir ma liberté en échange de la sienne."
                                            },
                                            {
                                                "example_id": "67e57c79-772c-4344-bc94-b547c5a24d21",
                                                "sense_id": "9267dfdf-0d4f-3cf7-ab41-83f030d0b104",
                                                "text": "C'est là aussi que végètent misérablement les bédouines qui ont voulu suivre leurs maris prisonniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "832ab409-d966-376d-96dd-4cc1401943b4",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Qui est pris ; qui est entravé dans ses mouvements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a97dfd91-bc56-45ad-99f2-cb05ed1ba606",
                                                "sense_id": "832ab409-d966-376d-96dd-4cc1401943b4",
                                                "text": "Il pâlit un peu, puis, tentant un effort désespéré, réussit à dégager un pied, tandis que l’autre restait prisonnier de la glu mouvante et fétide des profondeurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebde18bf-c8f8-3fa9-b657-4bc318c4a336",
                                        "entry_id": "47909987-4755-3d73-b8cd-e47dafbf9e30",
                                        "glosses": [
                                            "Captif, assujetti."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6882709e-e586-49e5-847a-a72bdebae841",
                                                "sense_id": "ebde18bf-c8f8-3fa9-b657-4bc318c4a336",
                                                "text": "Or c'est typiquement ce que cherche à favoriser l'algorithme de TikTok, dans la mesure où le but de cet algorithme n'est pas forcément de faire monter Bardella en tant que tel, mais de garder prisonnier l'utilisateur sur la plateforme le plus longtemps possible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
