                        "examples": [
                            {
                                "example_id": "65e53108-905a-4e99-904e-25256b30f1a7",
                                "sense_id": "ce4f8f30-663d-3014-bbcb-5922e2e02a80",
                                "text": "Zondag trok Di Rupo naar de koning, toen zaterdagnacht na tien uur onderhandelen de gesprekken waren vast gelopen. De preformateur wilde zijn opdracht teruggeven, maar de koning accepteerde dat niet. Hij kreeg de vervolgopdracht om het vertrouwen te herstellen tussen de partijen."
                            },
                            {
                                "example_id": "2392c914-1e0b-48a9-a33f-c37217ecac28",
                                "sense_id": "ce4f8f30-663d-3014-bbcb-5922e2e02a80",
                                "text": "De commissie-Oosting heeft formeel de vervolgopdracht gekregen om nader onderzoek te doen naar de Teevendeal. Dat schrijft minister Van der Steur aan de Tweede Kamer."
                            }
                        ]
                    }
