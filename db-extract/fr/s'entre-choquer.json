                    }
                ],
                "senses": [
                    {
                        "sense_id": "1fb75fb2-2371-30f2-9941-c77a5f1327ad",
                        "entry_id": "934fbb1a-64c8-306a-ac84-5821b8c68dde",
                        "glosses": [
                            "Se choquer l’un l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22be3c2c-a2d3-492b-9c49-5e4136f83b46",
                                "sense_id": "1fb75fb2-2371-30f2-9941-c77a5f1327ad",
                                "text": "Nous aurions pu nous croire dans une baratte américaine. Les meubles et les colis s’entre-choquaient, la vaisselle volait en éclats, et de graves personnages interrompaient une sentence commencée pour prendre tout à coup les ébats les plus fantastiques."
                            },
                            {
                                "example_id": "872c7cae-22c9-4af0-b9b2-5e41ec948ed8",
                                "sense_id": "1fb75fb2-2371-30f2-9941-c77a5f1327ad",
                                "text": "Les vagues qui s’entre-choquent dans une tempête"
                            },
                            {
                                "example_id": "d8d1cda3-07b8-40ac-8df2-962c7039b4b6",
                                "sense_id": "1fb75fb2-2371-30f2-9941-c77a5f1327ad",
                                "text": "C’était un grand et terrible spectacle que de voir la mer couverte de trois cents galères prêtes à s’entre-choquer"
                            },
                            {
                                "example_id": "bcc86b5f-13aa-4b9f-b2d6-a3ee00ac0faf",
                                "sense_id": "1fb75fb2-2371-30f2-9941-c77a5f1327ad",
                                "text": "Je sentais mes genoux vaciller, s’entre-choquer ; je priais tout bas !"
                            }
                        ]
                    },
                    {
                        "sense_id": "d6f25078-4bdb-3fcc-9a2a-4bf304097043",
                        "entry_id": "934fbb1a-64c8-306a-ac84-5821b8c68dde",
                        "glosses": [
                            "Se contredire ou s’opposer l’un à l’autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed96eec3-4a9f-47b2-a3a1-18f5e8fe2f07",
                                "sense_id": "d6f25078-4bdb-3fcc-9a2a-4bf304097043",
                                "text": "Ces deux hommes s’entre-choquent sans cesse."
                            },
                            {
                                "example_id": "1c3289f3-a369-4751-aca3-67a763ea6263",
                                "sense_id": "d6f25078-4bdb-3fcc-9a2a-4bf304097043",
                                "text": "Leurs hypothèses fragiles [des philosophes] s’entre-choquent librement ; leurs querelles ne peuvent avoir des conséquences pour l’État (D’HOLBACH, Essai. Préj. ch. 4, dans DUMARSAIS, Œuvres, tome VI)"
                            }
                        ]
                    }
                ],
