                                        "sense_id": "7c32db3f-c366-3d2a-9b42-5d60e10bb879",
                                        "entry_id": "5592179b-1927-3af9-8477-a37e4bb1ca5c",
                                        "glosses": [
                                            "eine einzelne absurde, widersinnige oder sinnlose Handlung oder Begebenheit"
                                        ],
