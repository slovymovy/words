                                                "sense_id": "958e9ba8-f885-3580-8a06-57d72c22e123",
                                                "text": "Oh, shit!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f3eb3aa-1adf-3a84-9198-34cbc5cfe747",
                                        "entry_id": "22586d90-43fb-38b1-b34a-0c4ade78272b",
                                        "glosses": [
                                            "Used to show displeasure or surprise."
                                        ],
                                        "tags": [
