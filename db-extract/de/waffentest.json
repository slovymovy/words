                "senses": [
                    {
                        "sense_id": "3997e026-499a-3abe-8166-8fae442ae0f6",
                        "entry_id": "561e8410-08e7-30bc-b098-ec334fa02bb0",
                        "glosses": [
                            "das Testen einer bestimmten Waffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b66bfa-c9f8-478a-9e18-68f2ce8d9d63",
                                "sense_id": "3997e026-499a-3abe-8166-8fae442ae0f6",
                                "text": "„Ähnliche Waffentests und Übungen werden auch von anderen Staaten seit etwa 100 Jahren durchgeführt. Unter den ersten deutschen Schiffen, die als Zielschiffe dienten, waren die Linienschiffe SMS Baden, die nach einer fehlgeschlagenen Selbstversenkung von der Royal Navy 1921 als Zielschiff versenkt wurde, und die SMS Hessen, die ab 1934 von der Reichsmarine als Zielschiff benutzt wurde.“"
                            },
                            {
                                "example_id": "428ebf6d-39cb-4881-b88c-fad004a0a1a2",
                                "sense_id": "3997e026-499a-3abe-8166-8fae442ae0f6",
                                "text": "„Die Punktzahl steigert sich bis im vierten Kurs zu 310 Punkte sowie zehn Punkte aus dem Waffentest. “"
                            },
                            {
                                "example_id": "f23c1d52-f984-406e-8100-55582094be28",
                                "sense_id": "3997e026-499a-3abe-8166-8fae442ae0f6",
                                "text": "„19. Der erste Abschuss eines Satelliten bei einem Waffentest Chinas mit einer Rakete von der Erde löst weltweit Proteste aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
