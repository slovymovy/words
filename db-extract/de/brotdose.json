                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902ff163-d02e-475a-a296-c0b6df863b06",
                                                "sense_id": "2c7dd7b7-3193-3706-a75a-1587a39413bd",
                                                "text": "The campaign tagline, 'I've got a tiny packet', is written across [Linford] Christie's trademark impressively muscled upper body. 'Tiny packet' makes us remember that Linford is known for his 'lunchbox' from his heyday as a sprinter because of the bulge apparent in his lycra shorts. His lunchbox and now his tiny packet allude to the diminishing of black men to just their genitals[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc18c23e-fd25-378b-ba09-596821bdc129",
                                        "entry_id": "6125b5a0-3267-3425-b86a-98227243921e",
                                        "glosses": [
                                            "A lunch packaged in a disposable box to be taken away to eat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57db971-9a43-4163-bfeb-cfda42d2ed25",
                                                "sense_id": "cc18c23e-fd25-378b-ba09-596821bdc129",
                                                "text": "Jack was carrying his lunchbox with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c735517-0a7d-308e-8c4a-d1a3e00ddf5f",
                                        "entry_id": "6125b5a0-3267-3425-b86a-98227243921e",
                                        "glosses": [
                                            "A luggable; an early laptop computer, usually a unit with a handle and a fold-out keyboard."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdfad7b0-40c6-447c-ba71-88857b514ee8",
                                                "sense_id": "8c735517-0a7d-308e-8c4a-d1a3e00ddf5f",
                                                "text": "You'll find a mix among clamshell laptops for strong laps, lunchboxes, and sewing-machine configurations; the latter two designs typically have detachable keyboards."
                                            },
                                            {
                                                "example_id": "093fd062-e862-46b1-81be-753ec546c578",
                                                "sense_id": "8c735517-0a7d-308e-8c4a-d1a3e00ddf5f",
                                                "text": "The performance difference between desktops and lunchboxes was practically nil."
                                            }
                                        ]
