                "senses": [
                    {
                        "sense_id": "2c1afd76-e654-35b5-a732-67264ef3addc",
                        "entry_id": "464c73a9-f1ef-304e-9263-06cd4d2f4148",
                        "glosses": [
                            "osoba zajmująca odpowiednią pozycję w hierarchii jakiejś służby mundurowej; w Polsce: posiadająca stopień co najmniej kaprala, a niższy niż podporucznika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "534c6b2d-d4e2-4a8f-a857-3ce43e9aaaab",
                                "sense_id": "2c1afd76-e654-35b5-a732-67264ef3addc",
                                "text": "Spędził w nim przecież sporo czasu jako młody podoficer przysłany tu na kursy zawodowe przede wszystkim z zakresu kryminalistyki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
