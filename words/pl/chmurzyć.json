                {
                    "sense_id": "68bc26a2-a9fa-3acf-87a9-03a1c681608b",
                    "sense_definition": "stawać się smutnym, ponurym lub przygnębionym",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego twarz zaczęła się <w>chmurzyć</w>, gdy usłyszał złe wieści.",
                            "target_lang_translations": {
                                "en": "His face began to <w>darken</w> when he heard the bad news.",
                                "ru": "Его лицо стало <w>хмуриться</w>, когда он услышал дурные вести.",
                                "nl": "Zijn gezicht begon te <w>betrekken</w> toen hij het slechte nieuws hoorde.",
                                "de": "Sein Gesicht begann <w>sich zu verfinstern</w>, als er die schlechten Nachrichten hörte.",
                                "fr": "Son visage a commencé à <w>s'assombrir</w> en apprenant la mauvaise nouvelle.",
                                "it": "Il suo viso ha iniziato a <w>incupirsi</w> quando ha sentito le brutte notizie.",
                                "cs": "Jeho tvář se začala <w>chmuřit</w>, když uslyšel špatné zprávy.",
                                "tr": "Kötü haberleri duyunca yüzü <w>asılmaya</w> başladı.",
                                "es": "Su rostro empezó a <w>ensombrecerse</w> cuando escuchó las malas noticias.",
                                "zh": "听到坏消息时，他的脸色开始<w>阴沉下来</w>。"
                            }
                        },
                        {
                            "text": "Nie <w>chmurz</w> się tak, wszystko będzie dobrze.",
                            "target_lang_translations": {
                                "en": "Don't <w>look so gloomy</w>, everything will be fine.",
                                "ru": "Не <w>хмурься</w> так, всё будет хорошо.",
                                "nl": "<w>Kijk niet zo somber</w>, alles komt goed.",
                                "de": "<w>Schau</w> nicht so <w>finster drein</w>, alles wird gut.",
                                "fr": "Ne <w>te renfrogne</w> pas comme ça, tout ira bien.",
                                "it": "Non <w>ti rattristare</w> così, andrà tutto bene.",
                                "cs": "Ne<w>mrač se</w> tak, všechno bude v pořádku.",
                                "tr": "Öyle <w>surat asma</w>, her şey güzel olacak.",
                                "es": "No te <w>ensombrezcas</w> así, todo irá bien.",
                                "zh": "别那么<w>沉着脸</w>，一切都会好起来的。"
                            }
                        }
