                "translations": [
                    {
                        "translation_id": "0348a7d9-f31b-4997-9e4a-eeb266275db2",
                        "source_entry_id": "66360155-0672-3781-9942-3d4b6b1eed12",
                        "source_sense_id": "877e09a2-c253-3fc9-920a-33f2c507a0de",
                        "target_lang_word": "homoscedasticity",
                        "target_lang_code": "en",
