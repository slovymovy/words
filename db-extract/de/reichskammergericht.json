                ],
                "senses": [
                    {
                        "sense_id": "adb437f4-8224-32d7-8ba7-6f5c5baec58b",
                        "entry_id": "5cb85b5c-1249-3328-9ebe-98722cf46102",
                        "glosses": [
                            "das höchste deutsche Gericht (neben dem Reichshofrat)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b0ad9ab6-bb41-48d6-b4e6-88f826ba085b",
                                "sense_id": "adb437f4-8224-32d7-8ba7-6f5c5baec58b",
                                "text": "„Bleibende Ergebnisse der Reichsreform waren: der Ewige Landfriede (1495), das Reichskammergericht (1495), eine allgemeine Reichssteuer (1495), die Gliederung des Reichs in Reichskreise (1500 und 1512); ein fürstliches Reichsregiment, das neben den Kaiser treten sollte, blieb Episode (1500–1502 und 1521–1530).“"
                            },
                            {
                                "example_id": "3baa636f-c651-4cd7-92fe-159a8768970d",
                                "sense_id": "adb437f4-8224-32d7-8ba7-6f5c5baec58b",
                                "text": "„Um die gewalttätigen, halbkriegerischen Auseinandersetzungen zwischen Rittern, Grafen und Städten wenigstens einzudämmen, wurde das Reichskammergericht eingerichtet, jene auf schriftlichen Verhandlungen beruhende Instanz, deren Entscheidungsfindungen von einer geradezu rechtskünstlerischen Umständlichkeit war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
