                                        "examples": [
                                            {
                                                "example_id": "0a7cb0ab-1a49-4c95-9789-665caa44d3da",
                                                "sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                                                "text": "La première question que l’on pose toujours concernant le daltonisme est : « Comment le daltonien voit-il le monde qui l’entoure? »"
                                            },
                                            {
                                                "example_id": "900acc0a-acb7-46e9-91f0-ff406ffb1ba9",
                                                "sense_id": "83225d9a-c073-3fd3-ae28-6fb3a613b0ed",
                                                "text": "Georges déclara à Liane qu’elle était une ravissante petite fée bleue ; elle portait une robe verte. Georges n’était pas daltonien, il savait surprendre les femmes."
                                            }
                                        ]
                                    }
                                ]
