{
    "word_family": [
        "demean",
        "demeanor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e5eba1ca-7aa4-3fb1-a6f6-51e25780232f",
                    "sense_definition": "Causing a loss of respect or dignity; degrading.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degrading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt that the constant criticism from her boss was highly <w>demeaning</w>.",
                            "target_lang_translations": {
                                "it": "Sentiva che le continue critiche del suo capo fossero estremamente <w>degradanti</w>."
                            }
                        },
                        {
                            "text": "It is <w>demeaning</w> to be treated like a child in front of your colleagues.",
                            "target_lang_translations": {
                                "it": "È <w>umiliante</w> essere trattati come bambini davanti ai propri colleghi."
                            }
                        }
                    ],
                    "synonyms": [
                        "degrading",
                        "humiliating",
                        "belittling"
                    ],
                    "antonyms": [
                        "dignifying"
                    ],
                    "common_phrases": [
                        "demeaning experience",
                        "demeaning behavior"
                    ],
                    "target_lang_definitions": {
                        "it": "Che causa una perdita di rispetto o dignità; umiliante."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "degradante",
                                "target_lang_sense_clarification": "Che abbassa la dignità di una persona."
                            },
                            {
                                "target_lang_word": "umiliante",
                                "target_lang_sense_clarification": "Che provoca un senso di umiliazione o vergogna."
                            },
                            {
                                "target_lang_word": "mortificante",
                                "target_lang_sense_clarification": "Che ferisce l'orgoglio o la dignità."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d976798-bcce-3711-9908-908e6ed6bd90",
                    "sense_definition": "The present participle and gerund of <w>demean</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "degrading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>demeaning</w> himself by begging for attention.",
                            "target_lang_translations": {
                                "it": "Si stava <w>umiliando</w> elemosinando attenzioni."
                            }
                        },
                        {
                            "text": "Stop <w>demeaning</w> your teammates with those rude comments.",
                            "target_lang_translations": {
                                "it": "Smettila di <w>umiliare</w> i tuoi compagni di squadra con quei commenti sgarbati."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund of demean"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo 'demean' (umiliare, degradare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "umiliando",
                                "target_lang_sense_clarification": "Gerundio del verbo umiliare."
                            },
                            {
                                "target_lang_word": "degradando",
                                "target_lang_sense_clarification": "Gerundio del verbo degradare."
                            }
                        ]
                    }
                }
            ]
        }
    ]
