                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c5d221a-d104-4215-9471-a020c8d530cd",
                                                "sense_id": "4cc1a561-8c6d-3b3e-b9df-798ed62cd35a",
                                                "text": "Die Askese bekam ihnen nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90268fbf-2230-3f44-a394-bb6d721251e1",
                                        "entry_id": "a6fc3779-9c96-306b-92bc-e0baeec35b6c",
                                        "glosses": [
                                            "streng enthaltsames Leben verbunden mit dem Ziel des Seelenheils"
