                    {
                        "sense_id": "ceb79516-5341-3ef4-95db-0e6692da7d4d",
                        "entry_id": "febe9eb8-7a7b-3c1d-8e60-3d4595932fd7",
                        "glosses": [
                            "eine vor allem im Senegal, aber auch in Gambia und Mauretanien gesprochene Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b8a6fc5-444a-4123-8f8b-37d2acbc0f01",
                                "sense_id": "ceb79516-5341-3ef4-95db-0e6692da7d4d",
                                "text": "„Das in Gambia gesprochene Wolof weist Unterschiede zu der in Senegal gesprochenen Varietät auf.“"
                            },
                            {
                                "example_id": "fefe229f-2be9-453a-8c47-c6207e0d7afe",
                                "sense_id": "ceb79516-5341-3ef4-95db-0e6692da7d4d",
                                "text": "„Im Wolof unterscheidet man Aktionsverben von Zustandsverben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
