                        "glosses": [
                            "dziedzina wiedzy zajmująca się niezidentyfikowanymi obiektami latającymi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b88656b-b4d6-4ae8-a2ad-3e6da6499661",
                                "sense_id": "42e57e13-416f-363d-bd6e-099631d6d2b9",
                                "text": "Po pierwszych seansach „Bliskich spotkań trzeciego stopnia” Spielberga recenzenci pisali nie tylko o nowym impulsie dla ufologii, ale też o rzekomych bliskich spotkaniach reżysera z New Age."
                            }
                        ],
