                        ],
                        "examples": [
                            {
                                "example_id": "ae1944df-6bd3-473e-aa9e-a26a6b810a46",
                                "sense_id": "a56d12a7-f099-3ad9-8ce2-94be3fe7dc5d",
                                "text": "À son appétit de nèfles et de pommes, on l’eût pris pour un loup de prairie; à son pelage foncé, on l’eût pris pour un lycaon, et à son hurlement atténué en aboiement, on l’eût pris pour un culpeu; …."
                            },
                            {
                                "example_id": "619fdb0c-8c3b-40f0-9d84-8fd69d9f801d",
                                "sense_id": "a56d12a7-f099-3ad9-8ce2-94be3fe7dc5d",
                                "text": "Le renard roux, ou culpeu, est un carnassier de taille plus grande et plus massive que le renard européen."
                            }
                        ]
                    }
