                                "target_senses": [
                                    {
                                        "sense_id": "a86f40cc-85c6-3b61-8aee-3a3d2393d71a",
                                        "entry_id": "f657dd92-14a9-327b-989d-4d3215627fa8",
                                        "glosses": [
                                            "een waterdragende laag in de ondergrond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ddac91-f51b-4f0d-b0d7-6cd15191490f",
                                                "sense_id": "a86f40cc-85c6-3b61-8aee-3a3d2393d71a",
                                                "text": "De Ogallalla-aquifer is van uitnemend belang voor de irrigatie van de staten van het midden van de Verenigde Statten."
                                            },
                                            {
                                                "example_id": "4fa5ebfb-05bb-4f2e-aacc-fa8fa356a01b",
                                                "sense_id": "a86f40cc-85c6-3b61-8aee-3a3d2393d71a",
                                                "text": "Het was altijd een feest als ik op een kleine waterbron recht uit de berg stuitte. Dit frisse water uit de ondergrondse meren (aquifers geheten) dronk ik direct uit de berg, zonder het te hoeven filteren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf73053e-852f-4767-9d23-7aedd9c88963",
