                "senses": [
                    {
                        "sense_id": "f9b54f1c-56f3-3ecc-a04c-1cf5e10e786f",
                        "entry_id": "b3ed690c-4675-3744-8f1b-01c6c6d7e367",
                        "glosses": [
                            "zweckbestimmte Handlung, um einen Luftaustausch herzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26343768-a56b-4774-ae87-0bb053fae875",
                                "sense_id": "f9b54f1c-56f3-3ecc-a04c-1cf5e10e786f",
                                "text": "„Der Einsatz konnte nach Abschluss der Lösch- und Lüftungsmaßnahmen beendet werden.“"
                            },
                            {
                                "example_id": "69fa66bc-a584-487f-8b60-3e41dc78b8d3",
                                "sense_id": "f9b54f1c-56f3-3ecc-a04c-1cf5e10e786f",
                                "text": "„Das Gebäude ist trotz der durchgeführten Lüftungsmaßnahmen vorübergehend nicht mehr bewohnbar.“"
                            },
                            {
                                "example_id": "c01e6413-2ef4-4fb5-a936-6c9cb17fe227",
                                "sense_id": "f9b54f1c-56f3-3ecc-a04c-1cf5e10e786f",
                                "text": "„Lüftungsmaßnahmen werden häufig nicht durchdacht und geplant. So werden Fenster und Türen geöffnet, um den Rauch aus dem Gebäude zu entfernen.“"
                            },
                            {
                                "example_id": "e94b5daf-8488-4fa5-b151-d7b368a9ac81",
                                "sense_id": "f9b54f1c-56f3-3ecc-a04c-1cf5e10e786f",
                                "text": "„Es war gegen Mittag, und wie üblich hatte der Schankwirt Karlheinz die Vordertür der Rio Bar geöffnet, um Fuseldunst und Tabakqualm zu vertreiben. Und wie gewöhnlich war diese Lüftungsmaßnahme nur von geringem Erfolg gekrönt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
