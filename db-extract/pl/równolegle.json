                    {
                        "sense_id": "21f1feae-6660-31c6-8663-dc52585b9cbd",
                        "entry_id": "a0aa6b92-31ea-3c74-a20b-d1f3130c714c",
                        "glosses": [
                            "o położeniu w przestrzeni: w sposób równo odległy na całej swojej długości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3913cb0c-c44e-4a24-acfc-13273c56a922",
                                "sense_id": "21f1feae-6660-31c6-8663-dc52585b9cbd",
                                "text": "Dwie główne ulice naszego miasteczka biegną prawie równolegle."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a78afb3c-86be-31e8-a454-749ee7d81309",
                        "entry_id": "a0aa6b92-31ea-3c74-a20b-d1f3130c714c",
                        "glosses": [
                            "o czasie: odbywający się w tym samym odcinku czasu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f3d23d-f834-49c6-b627-acc88caf0bc4",
                                "sense_id": "a78afb3c-86be-31e8-a454-749ee7d81309",
                                "text": "Posiedzenia komisji finansów i oświaty zostaną przeprowadzone równolegle, w sąsiednich salach."
                            },
                            {
                                "example_id": "174f9220-6f86-488f-84f1-4fb6a365083a",
                                "sense_id": "a78afb3c-86be-31e8-a454-749ee7d81309",
                                "text": "Nasz syn Jacek studiuje równolegle dwa kierunki: informatykę i automatykę."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "d9e56d8c-f08a-3bf6-b92d-2ee3edf5810a",
                        "entry_id": "a0aa6b92-31ea-3c74-a20b-d1f3130c714c",
                        "glosses": [
                            "o połączeniu: w taki sposób, aby utworzyć obwód równoległy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d68a331-04b6-4d66-bb6f-98a88cd1026b",
                                "sense_id": "d9e56d8c-f08a-3bf6-b92d-2ee3edf5810a",
                                "text": "Aby uzyskać spadek prądu, należy dodatkowo włączyć równolegle opornik."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
