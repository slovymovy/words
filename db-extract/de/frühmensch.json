                "senses": [
                    {
                        "sense_id": "b1a086f1-4ddd-3a22-a480-69f40accc93c",
                        "entry_id": "19394f12-7b64-3b62-9327-60423e5708d6",
                        "glosses": [
                            "Vertreter einer frühen Entwicklungsstufe des Menschen"
                        ],
                        "tags": [
                            "Anthropologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2dc7d8b3-1ef3-4554-a730-c57607d52de5",
                                "sense_id": "b1a086f1-4ddd-3a22-a480-69f40accc93c",
                                "text": "„Die Wissenschaftler um Yohannes Haile-Selassie vom Naturkundemuseum von Cleveland datierten die Reste des in der Wüstenregion Afar im Osten Äthiopiens gefundenen Fossils auf ein Alter zwischen 3,3 und 3,5 Millionen Jahren. Damit lebte der Frühmensch zur selben Zeit und in der selben Region wie Lucy, die eine zeitlang als ‚Mutter der Menschheit‘ und direkte Vorfahrin der heutigen Menschen galt.“"
                            },
                            {
                                "example_id": "c5fc2ea2-7a8a-4d0e-8fb0-48e633965f09",
                                "sense_id": "b1a086f1-4ddd-3a22-a480-69f40accc93c",
                                "text": "„Im mittleren Pleistozän wirkten sich die klimatischen Bedingungen der Eiszeiten auf die biologische und kulturelle Evolution des Frühmenschen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
