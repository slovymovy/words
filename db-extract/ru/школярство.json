                "senses": [
                    {
                        "sense_id": "93556a1e-cd9b-3d78-b6a2-b69862e774d2",
                        "entry_id": "27a83d01-d197-3ec6-800e-6a128b99c3c6",
                        "glosses": [
                            "устар. положение школяра; также поведение, поступки школяров, школяра;"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5c199be1-0065-34ec-bc64-839481911c0e",
                        "entry_id": "27a83d01-d197-3ec6-800e-6a128b99c3c6",
                        "glosses": [
                            "презр. сухой педантизм, схоластическая мелочность во взглядах, в отношениях к чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "578c82d9-0f2f-4d44-8bb9-425faa5b0829",
                                "sense_id": "5c199be1-0065-34ec-bc64-839481911c0e",
                                "text": "При нём и вследствие его влияния тяжёлый педантизм и школярство сменялись сентиментальностью и светскою лёгкостью, в которых много было странного, но которые были важным шагом вперёд для литературы и общества."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5df93c5a-1489-4c2f-95e1-66111c4a0b97",
                        "source_entry_id": "27a83d01-d197-3ec6-800e-6a128b99c3c6",
                        "source_sense_description": "сухой педантизм, схоластическая мелочность во взглядах, в отношениях к чему-либо",
                        "target_lang_word": "scholasticism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scholasticism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "697ff950-228e-3e39-91c3-e20eb1860233",
                                        "entry_id": "6f05eb25-18a4-37a2-8d25-cc78fa59466f",
                                        "glosses": [
                                            "A tradition or school of philosophy, originating in the Middle Ages, that combines classical philosophy with Catholic theology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b31ad8e-4c7f-4886-9400-c10dcce305d9",
                                                "sense_id": "697ff950-228e-3e39-91c3-e20eb1860233",
                                                "text": "Once more, the work exhibits the characteristics which are typical of scholasticism at its best: the appeal to reason, the logical marshaling of arguments, the relentless exploration of the implications of ideas, and the fundamental conviction that, at its heart, the Christian gospel is rational and can be shown to be rational."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25e792d1-5694-4c65-8e3a-f422d47af39f",
                        "source_entry_id": "27a83d01-d197-3ec6-800e-6a128b99c3c6",
                        "source_sense_description": "сухой педантизм, схоластическая мелочность во взглядах, в отношениях к чему-либо",
                        "target_lang_word": "pedantry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pedantry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An excessive attention to detail or rules."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440fcc26-1bb8-42c1-8f87-1df7780b3b76",
                                                "sense_id": "e664e272-77f7-3945-9b37-6747f0689e31",
                                                "text": "Another point on which Smart insists is the distinction between serf and surf […] A distinction can of course be made, and without much difficulty, by those who think of it, and is made by those who have formed a habit of doing so; but the distinction is so rarely made as to amount almost to pedantry […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An excessive attention to detail or rules.",
                                            "An instance of such behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "648f5406-c109-43db-8ae5-c2403e4d369c",
                                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                                "text": "I don’t want to listen to your pedantries anymore."
                                            },
                                            {
                                                "example_id": "aa0e6c1d-0a40-4725-83f6-7e22d9fa7729",
                                                "sense_id": "1bfb6ecb-234c-3b56-93b3-482db8f2a6d9",
                                                "text": "[T]he southern court of the ballium had become a flower-garden, with quaint terraces, statues, knots of flowers, clipped yews and hollies, and all the pedantries of the topiarian art."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86cdf555-d8f0-3560-a1fb-18c59e3e7b87",
                                        "entry_id": "d2578e1b-26a2-37c4-b7aa-4326cda2f24c",
                                        "glosses": [
                                            "An overly ambitious display of learning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb2defa2-96ba-41db-a5b1-625d8fb2f980",
                        "source_entry_id": "27a83d01-d197-3ec6-800e-6a128b99c3c6",
