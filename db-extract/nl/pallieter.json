                "senses": [
                    {
                        "sense_id": "ca4e936a-a36f-3bc0-828c-5ce6e87cfff3",
                        "entry_id": "5b61e79e-759c-368c-8b5c-13c878f21dec",
                        "glosses": [
                            "iemand die probeert zoveel mogelijk vreugde te beleven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e1535d-2bca-4698-bffb-2c12239b9c5c",
                                "sense_id": "ca4e936a-a36f-3bc0-828c-5ce6e87cfff3",
                                "text": "Koga laat veel onderdelen naar eigen kwaliteitseisen ontwerpen. Ik ben geen zwoeger maar een pallieter. Het mooie is dat een buitenstaander op het eerste gezicht niet ziet dat ik ‘elektrisch’ ga."
                            },
                            {
                                "example_id": "3b5f2e19-371d-43a5-84d5-49ebe5ba9ef2",
                                "sense_id": "ca4e936a-a36f-3bc0-828c-5ce6e87cfff3",
                                "text": "Op weg naar de start in Millau kwam Eric Vanderaerden aanlopen, een telefoon aan zijn oor, zijn gezicht geplooid. We knikten beleefd, als heren. Direct dacht ik aan vroeger, toen alles anders was en Vanderaerden nog ‘ne pallieter van een Vlaamse coureur’. Hij kon zich misdragen als de betere rockster. Hij had zijn beste dagen bij Panasonic, onder Peter Post en daarna bij Buckler en WordPerfect, onder Jan Raas. Hem te beteugelen, het was ondoenlijk."
                            }
                        ]
                    }
