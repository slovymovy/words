                                        "examples": [
                                            {
                                                "example_id": "e5f20520-b688-4df9-b55c-600bd834022e",
                                                "sense_id": "d6d8b825-23d7-3644-8964-0c732bb6fd36",
                                                "text": "Some time passed before I felt tranquil even here: I had a vague dread that wild cattle might be near, or that some sportsman or poacher might discover me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2047fd1-7f67-34d3-9b3f-227d7c9f5a36",
                                        "entry_id": "6edae879-f6d2-39fc-8e64-58f19d8e9caf",
                                        "glosses": [
                                            "Calm; without motion or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a27e394-a56c-4ac8-82fd-d69c28955b75",
                                                "sense_id": "f2047fd1-7f67-34d3-9b3f-227d7c9f5a36",
                                                "text": "[…]that the streams which did form were clear and tranquil because fed by perennial springs from the underground supply; and that in their tranquil waters extensive peat bogs formed."
                                            }
                                        ]
