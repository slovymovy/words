                                    },
                                    {
                                        "sense_id": "f9c9891c-22a5-3f89-8e16-b261559359ba",
                                        "entry_id": "e7a2e0b3-0272-3709-b8b7-7e832f35e49d",
                                        "glosses": [
                                            "Any act of misbehavior."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "729eb565-3c2b-4482-9f73-9b0581d3158d",
                                                "sense_id": "f9c9891c-22a5-3f89-8e16-b261559359ba",
                                                "text": "Because of the mother's lack of affection and the judgments made by everybody around her, the child is in opposition to everybody. Her misdemeanors may be partly the expression of her inner revolt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
