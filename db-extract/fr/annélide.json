                                "target_senses": [
                                    {
                                        "sense_id": "292b028e-d0ca-34d8-bb1a-9b88b42dca91",
                                        "entry_id": "66758928-fcf7-3c5b-984f-4c379dbcb57b",
                                        "glosses": [
                                            "Any of various wormlike animals, of the phylum Annelida, having a segmented body; they include the earthworm and the leech."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5bbaaf8-e3d0-4f75-9514-325d4e96766b",
                                                "sense_id": "292b028e-d0ca-34d8-bb1a-9b88b42dca91",
                                                "text": "Incarcerated in earth-filled boxes, the hapless annelids face execution in the morning. Death by immersion in fishponds, death by cruel hooks."
                                            },
                                            {
                                                "example_id": "47b5770c-198c-4ec3-9ec2-7330fff975a7",
                                                "sense_id": "292b028e-d0ca-34d8-bb1a-9b88b42dca91",
                                                "text": "The polychaetous annelid species complex of Neanthes acuminata has a widespread distribution, with names depending on geographic location."
                                            }
                                        ]
                                    }
                                ]
                            },
