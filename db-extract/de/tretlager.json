                ],
                "senses": [
                    {
                        "sense_id": "1c11fbcf-d0d9-3d3f-904f-3344e59d09e6",
                        "entry_id": "b3d812be-b5d5-3448-9591-2c125e96972b",
                        "glosses": [
                            "Lager am Fahrrad, das über Pedal und Tretkurbel eine kreisförmige Tretbewegung der Füße aufnehmen kann, die über eine Kettenübersetzung auf das Hinterrad gebracht wird"
                        ],
                        "tags": [
                            "Fahrradtechnik",
                            "Fahrradkonstruktion"
                        ],
                        "examples": [
                            {
                                "example_id": "57802259-2bf4-46e4-9366-dd889e1a3fb8",
                                "sense_id": "1c11fbcf-d0d9-3d3f-904f-3344e59d09e6",
                                "text": "„\"Da kann dann jeder so viel strampeln, wie er will und kann\", sagt Vielhaber. Von der Kombination aus Elektromotor und Tretlager erwartet er in den nächsten Jahren einiges: \"Es wird viele neue Konzepte zwischen klassischem Fahrrad und Auto geben, eine Art Mini-Smart mit elektrisch unterstützten Tretlagern.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d530df77-d991-4fcc-9a8d-cf7d10715952",
                        "source_entry_id": "b3d812be-b5d5-3448-9591-2c125e96972b",
                        "source_sense_id": "1c11fbcf-d0d9-3d3f-904f-3344e59d09e6",
                        "target_lang_word": "bottom bracket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottom bracket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2876b4-7dd2-3fc1-9dd0-c8ff8e8bf372",
                                        "entry_id": "590b5578-d186-36a8-80fd-f1eeb16e3a78",
                                        "glosses": [
                                            "A bicycle part that connects the crankset (chainset) to the frame and allows the crankset to rotate freely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c6b40cb-0090-427f-8e8e-054da9c55293",
                                                "sense_id": "5e2876b4-7dd2-3fc1-9dd0-c8ff8e8bf372",
                                                "text": "Crucial to the crankset is the bottom bracket. Of all the bearings on a bike, the bottom bracket is the one that has to bear the heaviest load. Not only does the bottom bracket have to spin while you pedal, but it takes the force of all the twisting and turning that occurs during pedaling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
