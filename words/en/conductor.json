{
    "word_family": [
        "conduct",
        "conduction",
        "conductive",
        "conductivity",
        "conductance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "376de139-a00c-3ce7-8e8a-02d977122045",
                    "sense_definition": "A person who directs the performance of an orchestra or choir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conductor</w> raised his baton to begin the symphony.",
                            "target_lang_translations": {
                                "ru": "<w>Дирижёр</w> поднял палочку, чтобы начать симфонию."
                            }
                        },
                        {
                            "text": "The famous <w>conductor</w> led the orchestra through a beautiful performance.",
                            "target_lang_translations": {
                                "ru": "Знаменитый <w>дирижёр</w> блестяще провёл оркестр через прекрасное выступление."
                            }
                        }
                    ],
                    "synonyms": [
                        "bandmaster",
                        "maestro"
                    ],
                    "common_phrases": [
                        "orchestra conductor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, управляющий исполнением оркестра или хора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дирижёр",
                                "target_lang_sense_clarification": "музыкант, управляющий оркестром или хором"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b92243d-288e-3a96-977a-0578a594c552",
                    "sense_definition": "A person who collects tickets and assists passengers on a train or bus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transportation_staff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>train</w> <w>conductor</w> checked our tickets before we reached the station.",
                            "target_lang_translations": {
                                "ru": "<w>Проводник</w> поезда проверил наши билеты до того, как мы прибыли на станцию."
                            }
                        },
                        {
                            "text": "I asked the <w>conductor</w> if this bus stops at the city center.",
                            "target_lang_translations": {
                                "ru": "Я спросил у <w>кондуктора</w>, останавливается ли этот автобус в центре города."
                            }
                        }
                    ],
                    "common_phrases": [
                        "train conductor",
                        "bus conductor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работник транспорта, который проверяет билеты и помогает пассажирам в поезде или автобусе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кондуктор",
                                "target_lang_sense_clarification": "работник, проверяющий билеты в общественном транспорте"
                            },
                            {
                                "target_lang_word": "проводник",
                                "target_lang_sense_clarification": "работник, обслуживающий пассажиров в поезде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdcb6ee8-ea19-357c-8574-025922039797",
                    "sense_definition": "A material or object that allows electricity or heat to pass through it easily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Copper is an excellent <w>conductor</w> of electricity.",
                            "target_lang_translations": {
                                "ru": "Медь — отличный <w>проводник</w> электричества."
                            }
                        },
                        {
                            "text": "Metal is a good <w>conductor</w> of heat, which is why the pan handle gets hot.",
                            "target_lang_translations": {
                                "ru": "Металл — хороший <w>проводник</w> тепла, поэтому ручка сковороды нагревается."
                            }
                        }
                    ],
                    "antonyms": [
                        "dielectric",
                        "nonconductor",
                        "insulator"
                    ],
                    "common_phrases": [
                        "good conductor",
                        "electrical conductor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Материал или объект, который легко проводит электричество или тепло."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проводник",
                                "target_lang_sense_clarification": "материал, проводящий электрический ток или тепло"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64a7c980-22a7-3d2c-9858-7575e1f58a06",
                    "sense_definition": "A person or thing that leads, guides, or directs others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher acted as a <w>conductor</w> for the students' research project.",
                            "target_lang_translations": {
                                "ru": "Учитель выступил в роли <w>руководителя</w> исследовательского проекта студентов."
                            }
                        },
                        {
                            "text": "He was the <w>conductor</w> of the secret mission.",
                            "target_lang_translations": {
                                "ru": "Он был <w>руководителем</w> секретной миссии."
                            }
                        }
                    ],
                    "synonyms": [
                        "guide",
                        "leader",
                        "director"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или нечто, которое ведет, направляет или руководит другими."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководитель",
                                "target_lang_sense_clarification": "тот, кто направляет деятельность других"
                            },
                            {
                                "target_lang_word": "проводник",
                                "target_lang_sense_clarification": "переносное значение: тот, кто распространяет идеи или методы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "245abbf3-bfde-31a9-b4eb-1d11f76967e6",
                    "sense_definition": "An ideal in a ring that measures how far the ring is from being integrally closed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>conductor</w> of the ring provides information about its singularity.",
                            "target_lang_translations": {
                                "ru": "<w>Кондуктор</w> кольца предоставляет информацию о его сингулярности."
                            }
                        },
                        {
                            "text": "Calculating the <w>conductor</w> is essential for understanding the ring's structure.",
                            "target_lang_translations": {
                                "ru": "Вычисление <w>кондуктора</w> необходимо для понимания структуры кольца."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический термин: идеал в кольце, измеряющий степень его отклонения от целозамкнутости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кондуктор",
                                "target_lang_sense_clarification": "математический термин в теории колец"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}