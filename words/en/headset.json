                },
                {
                    "sense_id": "ad1e30aa-71db-3b18-87f2-4a3a3e59fb3a",
                    "sense_definition": "The system of bearings on a bicycle that connects the front fork to the frame and allows steering.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bicycle_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to tighten the <w>headset</w> because the handlebars felt loose while riding.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось подтянуть <w>рулевую колонку</w>, потому что руль казался расшатанным во время езды."
                            }
                        },
                        {
                            "text": "If your steering feels gritty, it might be time to grease the bearings in the bicycle <w>headset</w>.",
                            "target_lang_translations": {
                                "ru": "Если руль идет с трудом, возможно, пришло время смазать подшипники в велосипедной <w>рулевой колонке</w>."
                            }
