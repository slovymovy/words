                "senses": [
                    {
                        "sense_id": "944a97b9-e71e-3855-9595-81c09632e830",
                        "entry_id": "7e696fe4-2cd1-30b8-9977-78edfda43017",
                        "glosses": [
                            "To enjoy luxury, to indulge."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b61bd7-62c5-430a-b5c5-9424fe063f2a",
                                "sense_id": "944a97b9-e71e-3855-9595-81c09632e830",
                                "text": "But where the stage version luxuriated in the amount of time it could take to tell its story — in three one-act plays — its big-screen counterpart benefits from the need to economize in order to keep things moving."
                            },
                            {
                                "example_id": "132abbfd-8cb8-41aa-ba52-4075daf8b4ca",
                                "sense_id": "944a97b9-e71e-3855-9595-81c09632e830",
                                "text": "Luxuriate in the wonderful service of our five-star hotel."
                            },
                            {
                                "example_id": "19feb99c-1e13-44d5-bda3-4bbef13187ba",
                                "sense_id": "944a97b9-e71e-3855-9595-81c09632e830",
                                "text": "He luxuriated in anger, and he kept accounts."
                            },
                            {
                                "example_id": "d08416fa-5f06-48e8-9948-5964efabd1fd",
                                "sense_id": "944a97b9-e71e-3855-9595-81c09632e830",
                                "text": "But fundamentally I think it’s a sound framework, and it creates the right sense of urgency in that we can kind of luxuriate in a debate over what the right gear might be to do carbon targets, but scientifically the right time to do it was yesterday."
                            }
                        ]
                    },
                    {
                        "sense_id": "fdda3618-805d-3c78-a62c-69abbfd15b99",
                        "entry_id": "7e696fe4-2cd1-30b8-9977-78edfda43017",
                        "glosses": [
                            "To be luxuriant; to grow exuberantly."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    }
