                                        "entry_id": "4f574549-a8dc-37b1-8a66-11d8d677b533",
                                        "glosses": [
                                            "совместное обсуждение чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb4a9975-3abe-4e86-b24e-57feea9eb107",
                                                "sense_id": "aa1cfade-755c-3387-a5fc-8748daf7006a",
                                                "text": "Военный совет."
                                            },
                                            {
                                                "example_id": "03e11708-6783-4da5-b991-667d9ba9369c",
                                                "sense_id": "aa1cfade-755c-3387-a5fc-8748daf7006a",
                                                "text": "Совет в Филях."
                                            },
                                            {
                                                "example_id": "0857298b-40af-414d-84a7-bf0ef6b1310a",
                                                "sense_id": "aa1cfade-755c-3387-a5fc-8748daf7006a",
                                                "text": "Устроили совет по этому вопросу."
                                            },
                                            {
                                                "example_id": "53843e57-1167-46cf-a8e2-dbc47cec2272",
                                                "sense_id": "aa1cfade-755c-3387-a5fc-8748daf7006a",
                                                "text": "Первые голоса на военных советах подаются обыкновенно в пользу движений наступательных .."
