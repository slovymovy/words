                        "entry_id": "d8d171f2-6eea-3ce0-910e-6a72a9612338",
                        "glosses": [
                            "Femelle du lièvre."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "aaf99a4a-8871-4f42-9d75-6d86edcbd288",
                                "sense_id": "b07522f7-498a-3d23-b9fd-3f4e7539f54d",
                                "text": "La hase a deux ou trois portées par an et possède trois paires de mamelles."
                            },
                            {
                                "example_id": "9c21b02b-557f-4a30-abd8-47045d339f7f",
                                "sense_id": "b07522f7-498a-3d23-b9fd-3f4e7539f54d",
                                "text": "J'ai fait élever des lapins avec des hases et des lièvres avec des lapines, mais ces essais n'ont rien produit."
                            }
                        ]
                    },
                    {
                        "sense_id": "1345e9c8-2f62-3a1e-96ec-ac5acf9f5e3f",
                        "entry_id": "d8d171f2-6eea-3ce0-910e-6a72a9612338",
                        "glosses": [
                            "Lapine de garenne, femelle du lapin de garenne."
                        ],
                        "tags": [
                            "Glirologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2e68379b-05f3-4bbe-9637-492937f0ccf3",
                                "sense_id": "1345e9c8-2f62-3a1e-96ec-ac5acf9f5e3f",
                                "text": "On a marqué les hases dans la garenne afin de ne pas les tuer."
                            }
                        ]
                    }
                ],
