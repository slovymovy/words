                        "examples": [
                            {
                                "example_id": "7529961f-d6de-4f5f-9590-3fd920e709cb",
                                "sense_id": "b49a0779-dcc6-3cdb-bcd2-51ca7ada2546",
                                "text": "Bovenaan verschijnt een nieuwsflits van de Tagesschau met als kop 'Dodelijke aanslag op galeriehouder'."
                            },
                            {
                                "example_id": "03d1e31b-a1d5-4592-b0e2-a74ee667c00c",
                                "sense_id": "b49a0779-dcc6-3cdb-bcd2-51ca7ada2546",
                                "text": "Onder 'Uitzendingen' kunnen de laatste NOS Journaals, NOS Sportjournaals, NOS Studio Sport en de laatste uitzending van Nieuwsuur, NOS Jeugdjournaal, NOS op 3, NOS op 3 nieuwsflits en het Nieuws in 60 seconden worden teruggekeken. Ook Journaal 24, Politiek 24 en livestreams kunnen via dit menu-item worden gevolgd."
                            },
                            {
                                "example_id": "b441e76a-a5b8-4935-bab9-bf334cc03c5a",
                                "sense_id": "b49a0779-dcc6-3cdb-bcd2-51ca7ada2546",
                                "text": "Om 17.10 uur mochten ze weer aan de slag toen bleek dat het loos alarm was. De uitzendingen zijn niet onderbroken. De eerste live-uitzending is een nieuwsflits om 17.45 uur. Tot die tijd werden opgenomen programma's uitgezonden."
                            }
                        ]
                    }
