                                                "sense_id": "f9c3f536-0de1-3fc6-b78a-33a8792b4b4b",
                                                "text": "Die eigentlichen Macher blieben lange Zeit im Hintergrund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
