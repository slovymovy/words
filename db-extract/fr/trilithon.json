                ],
                "translations": [
                    {
                        "translation_id": "408717d9-8938-480b-a3fc-e9e5abc89870",
                        "source_entry_id": "db9b5efd-0b9a-3b6a-a03a-df620b1ca3ef",
                        "source_sense_id": "4f798890-2fc1-30ad-92a9-2a0fa7e1f681",
