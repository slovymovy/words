                        "examples": [
                            {
                                "example_id": "2cf5624d-4c0e-472e-9a10-2d8bc14fa569",
                                "sense_id": "b8b2f8eb-7e0e-3573-ba65-bf694ea19c50",
                                "text": "In het derde kwartaal telde het statistiekbureau circa 1 miljoen mensen die hun belangrijkste inkomsten als zzp'er binnenhalen. Ondanks een lichte stijging ten opzichte van het voorafgaande kwartaal waren dat er opnieuw minder dan een jaar geleden. Mensen die naast een vaste hoofdbaan wat zelfstandig bijklussen zijn buiten beschouwing gelaten."
                            }
                        ]
                    },
