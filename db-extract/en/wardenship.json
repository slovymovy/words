                        "glosses": [
                            "The state of being a warden."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "429c4ca9-f5ff-4917-989d-ed1eb8595011",
                                "sense_id": "0e5d1ab2-cfc3-3cc8-a0d6-48732bd5f672",
                                "text": "He was made one of the guardians of the young king James IV. but soon lost influence, being superseded by the Homes and Hepburns, and the wardenship of the marches was given to Alexander Home."
                            },
                            {
                                "example_id": "e7b6c4a9-d1fa-4ea7-a128-aca6e0991e2d",
                                "sense_id": "0e5d1ab2-cfc3-3cc8-a0d6-48732bd5f672",
                                "text": "This, with other applications, led to his being presented with the wardenship of Manchester College, vacant by the removal of Dr William Chaderton to the see of Chester."
                            },
                            {
                                "example_id": "25868fd2-a37f-49e3-9170-079e7dd7c86d",
                                "sense_id": "0e5d1ab2-cfc3-3cc8-a0d6-48732bd5f672",
                                "text": "The King granted a small part, namely, one virgate to \"Herbert the Forester,\" before 1086, and this Herbert is generally supposed to have been the ancestor of those Lyndhursts who for so long held the wardenship of the Forest."
                            }
                        ]
                    }
