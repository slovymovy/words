            "senses": [
                {
                    "sense_id": "088f1b7f-e448-3f62-8368-1b81b2165a86",
                    "sense_definition": "Causing great pain or mental anguish",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "painful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered <w>excruciating</w> pain after the surgery.",
                            "target_lang_translations": {
                                "nl": "De patiënt leed <w>ondraaglijke</w> pijn na de operatie.",
                                "es": "El paciente sufrió un dolor <w>atroz</w> después de la cirugía."
                            }
                        },
                        {
                            "text": "She faced an <w>excruciating</w> decision about her future career.",
                            "target_lang_translations": {
                                "nl": "Ze stond voor een <w>martelende</w> beslissing over haar toekomstige carrière.",
                                "es": "Se enfrentó a una decisión <w>desgarradora</w> sobre su futuro profesional."
                            }
                        }
                    ],
                    "synonyms": [
                        "poignant"
                    ],
                    "common_phrases": [
                        "excruciating pain",
                        "excruciating dilemma"
                    ],
                    "target_lang_definitions": {
                        "nl": "Veroorzaakt grote pijn of geestelijke kwelling",
                        "es": "Que causa un dolor físico o sufrimiento mental extremo y difícil de soportar."
                    },
                    "translations": {
