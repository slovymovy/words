                                "target_senses": [
                                    {
                                        "sense_id": "5074274e-b818-347b-921b-87220d39fa41",
                                        "entry_id": "655843e9-c1e4-31b5-9f4f-6a11ea5d9612",
                                        "glosses": [
                                            "A close friend."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50faf56f-a888-47cf-8bb8-8b77a548ec73",
                                                "sense_id": "5074274e-b818-347b-921b-87220d39fa41",
                                                "text": "Rip now resumed his old walks and habits; he soon found many of his former cronies, though all rather the worse for the wear and tear of time; and preferred making friends among the rising generation, with whom he soon grew into great favour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ae4b96-d17e-364d-83c8-1d218492bd33",
                                        "entry_id": "655843e9-c1e4-31b5-9f4f-6a11ea5d9612",
                                        "glosses": [
                                            "A trusted companion or partner in a criminal organization."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4727dc4-b668-3c23-8d06-e371e998394d",
                                        "entry_id": "82292a28-ff7b-3ba1-a726-22d9597a9827",
                                        "glosses": [
                                            "An old woman; a crone."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7385dd54-31ad-4218-b89c-4d96ee7f6785",
                                                "sense_id": "e4727dc4-b668-3c23-8d06-e371e998394d",
                                                "text": "Marry not an old crony."
                                            }
                                        ]
                                    }
                                ]
