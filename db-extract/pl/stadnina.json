                            {
                                "example_id": "2a5bbc05-8f34-4a60-bb21-c543db530711",
                                "sense_id": "e1562a5f-d2d4-33a3-95ed-2cc94ed4ade3",
                                "text": "Po szkole chodziliśmy do stadniny pomagać przy koniach."
                            }
