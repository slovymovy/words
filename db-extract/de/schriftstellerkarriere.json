                "senses": [
                    {
                        "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                        "entry_id": "f43e8978-367c-36a9-abeb-2577d4635972",
                        "glosses": [
                            "(erfolgreicher) Werdegang einer Person, die Bücher schreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94ca8211-0410-4bcd-8770-e1660df56955",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Austers Schriftstellerkarriere begann allerdings ziemlich holprig.“"
                            },
                            {
                                "example_id": "b513c3ef-bba9-4faf-a907-b3cea9e2662d",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "[Günther Grass 1956 in Paris:] „Kein glänzendes, eher ein bescheidenes Leben führt er dort zusammen mit seiner ersten Frau - aber es ist der Beginn einer großen Schriftstellerkarriere.“"
                            },
                            {
                                "example_id": "e92de6ec-6886-423b-9280-e7ede29e2b10",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Der 79 Jahre alte gebürtige Oberösterreicher startete seine Schriftstellerkarriere erst spät.“"
                            },
                            {
                                "example_id": "b55de7ee-1995-4818-84ff-64b7dfed9183",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Mehr als 30 Auszeichnungen hat Kertész in seiner Schriftstellerkarriere erhalten - der bedeutendste war zweifellos der Literaturnobelpreis im Jahr 2002 für den \"Roman eines Schicksallosen\".“"
                            },
                            {
                                "example_id": "bc843282-a9fe-406e-9ac6-632b6f7ee0d5",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "[John Le Carré:] „Er ist auch nach seinem Tod der unbestrittene Grossmeister des Spionagethrillers und war vor seiner Schriftstellerkarriere für den Britischen Geheimdienst tätig.“"
                            },
                            {
                                "example_id": "300621fc-3cd3-437f-b7be-673500474f0d",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Vor seiner Schriftstellerkarriere schrieb Bradford Lieder und arbeitete unter anderem mit Musikern wie Dave Calhogoun (Ian Brown ‚FEAR’), Iain Archer und Graham Gouldman.“"
                            },
                            {
                                "example_id": "a91e3d69-a405-4c08-ac44-28bf16e7d079",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Langston Hughes arbeitete vor seiner Schriftstellerkarriere als Hilfskellner in einem Hotelrestaurant. (1925)“"
                            },
                            {
                                "example_id": "a36d97a4-48d6-4ea1-a043-b9767d0e95a0",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "[Uwe Tellkamp:] „Nach seinem akademischen Abschluss arbeitete er als Arzt an einer unfallchirurgischen Klinik in München, gab aber den Beruf 2004 zugunsten seiner Schriftstellerkarriere auf.“"
                            },
                            {
                                "example_id": "56fe499c-d71a-45fb-8e29-15c42a0099c5",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Mit urgewaltiger Schaffenskraft schrieb Mailer im Laufe seiner 60 Jahre währenden Schriftstellerkarriere mehr als 40 Romane.“"
                            },
                            {
                                "example_id": "322fb577-3849-47f3-9533-d40a20b70129",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Für seine eigene geplante Schriftstellerkarriere legte er in dieser Zeit eine Liste mit über hundert Titeln und Sujets an (Repertorium C. May), von denen er einige nachweislich umsetzte.“"
                            },
                            {
                                "example_id": "ee73be30-082d-4f18-80d5-21a47d9413d3",
                                "sense_id": "a01d2398-3536-3bb1-9484-5c2b46ee7486",
                                "text": "„Im Laufe ihrer Schriftstellerkarriere hat sich die talentierte Miss Highsmith mehrmals über ihre Schneckenmanie geäußert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
