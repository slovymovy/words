                                "example_id": "ef40bc7f-9f74-409f-ad22-dc9534bf452e",
                                "sense_id": "a3e96596-994d-321b-88bf-75a567d05c69",
                                "text": "For a salad dressing use olive or canola oil with lemon or vinegar and herb seasonings"
                            }
                        ]
