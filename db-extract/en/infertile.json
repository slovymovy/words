                                "target_senses": [
                                    {
                                        "sense_id": "d1c288fb-5ffb-3044-8895-99a855e539b0",
                                        "entry_id": "e52f9fb6-9b96-3c56-a46d-a11efa454804",
                                        "glosses": [
