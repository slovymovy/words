                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d4fcbb2-8f98-497f-ae6e-14adc90793f4",
                                "sense_id": "905d8d31-a7e0-3563-ac65-f2eb16374084",
                                "text": "I have a few books; please borrow whichever interest you."
                            },
                            {
                                "example_id": "167b4177-2e05-4c7f-a2d1-73ff3a191611",
                                "sense_id": "905d8d31-a7e0-3563-ac65-f2eb16374084",
                                "text": "They have lots of shirts, but I'll buy whichever is cheapest."
                            },
                            {
                                "example_id": "472e9813-42ff-4eea-82bb-ccd98fb462f5",
                                "sense_id": "905d8d31-a7e0-3563-ac65-f2eb16374084",
                                "text": "Whichever of you gets here first will get the prize."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c26f9ed-835f-3300-882d-a219184f9986",
                        "entry_id": "28c4a12a-7f7e-3270-a117-bc548c52b869",
                        "glosses": [
                            "Any or either one(s)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "394f9ca1-c549-4266-b70c-8d33a1f79132",
                                "sense_id": "2c26f9ed-835f-3300-882d-a219184f9986",
                                "text": "I don't mind which you have. Take whichever."
                            }
                        ]
                    },
                    {
                        "sense_id": "44401685-d518-3874-9ab3-9f1207616970",
                        "entry_id": "28c4a12a-7f7e-3270-a117-bc548c52b869",
