                        ]
                    },
                    {
                        "translation_id": "d0ce3ac7-40a7-4052-b635-2415331589b7",
                        "source_entry_id": "89f5bede-0548-3199-8fe6-52fa0bc65757",
                        "source_sense_id": "95c18527-9dd2-3e0a-8392-382d8bb0cea7",
