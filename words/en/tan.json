{
    "word_family": [
        "tanner",
        "tannery",
        "suntan"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f6e75a15-0f5a-3e69-b22a-902a96ae4988",
                    "sense_definition": "Having dark skin as a result of exposure to the sun.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skin_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You look very <w>tan</w> after your holiday in Spain.",
                            "target_lang_translations": {
                                "ru": "Ты выглядишь очень <w>загорелым</w> после отпуска в Испании.",
                                "zh": "你在西班牙度假后看起来皮肤晒得很<w>黝黑</w>。"
                            }
                        },
                        {
                            "text": "He is tall and <w>tan</w> from working outdoors all summer.",
                            "target_lang_translations": {
                                "ru": "Он высокий и <w>загорелый</w> от работы на улице всё лето.",
                                "zh": "他个子很高，而且因为整个夏天都在户外工作，皮肤晒得很<w>黝黑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tanned",
                        "suntanned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий темную кожу в результате воздействия солнца.",
                        "zh": "因晒太阳而皮肤变黑的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загорелый",
                                "target_lang_sense_clarification": "о коже или человеке"
                            },
                            {
                                "target_lang_word": "смуглый",
                                "target_lang_sense_clarification": "темный от загара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黝黑",
                                "target_lang_sense_clarification": "因日晒而皮肤变黑的；用于人或肤色"
                            },
                            {
                                "target_lang_word": "晒黑的",
                                "target_lang_sense_clarification": "强调晒太阳后形成的肤色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "059413fd-0d31-3979-ab62-cf846bf130cf",
                    "sense_definition": "Yellowish-brown in colour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "color_brown",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a pair of <w>tan</w> boots that matched her bag.",
                            "target_lang_translations": {
                                "ru": "Она носила пару <w>светло-коричневых</w> ботинок, которые подходили к её сумке.",
                                "zh": "她穿了一双<w>浅褐色</w>的靴子，和她的包很相配。"
                            }
                        },
                        {
                            "text": "The walls of the living room were painted a soft <w>tan</w>.",
                            "target_lang_translations": {
                                "ru": "Стены гостиной были покрашены в мягкий <w>светло-коричневый цвет</w>.",
                                "zh": "客厅的墙被刷成了柔和的<w>浅褐色</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтовато-коричневого цвета.",
                        "zh": "呈黄褐色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светло-коричневый",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "рыжевато-коричневый",
                                "target_lang_sense_clarification": "оттенок загара"
                            },
                            {
                                "target_lang_word": "желтовато-коричневый",
                                "target_lang_sense_clarification": "о цвете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浅褐色",
                                "target_lang_sense_clarification": "形容颜色"
                            },
                            {
                                "target_lang_word": "黄褐色",
                                "target_lang_sense_clarification": "偏黄的褐色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13920b65-7317-362d-98f1-799d72369278",
                    "sense_definition": "A darkening of the skin resulting from exposure to sunlight or similar light sources.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skin_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wants to get a <w>tan</w> before the summer ends.",
                            "target_lang_translations": {
                                "ru": "Она хочет получить <w>загар</w> до конца лета.",
                                "zh": "她想在夏天结束前晒出一点<w>古铜色</w>。"
                            }
                        },
                        {
                            "text": "He came back from the beach with a deep <w>tan</w>.",
                            "target_lang_translations": {
                                "ru": "Он вернулся с пляжа с сильным <w>загаром</w>.",
                                "zh": "他从海滩回来时，带着很深的<w>古铜色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a tan",
                        "fake tan",
                        "suntan lotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Потемнение кожи в результате воздействия солнечного света или подобных источников света.",
                        "zh": "因日光或类似光源照射而形成的皮肤变深现象；晒黑后的肤色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загар",
                                "target_lang_sense_clarification": "результат пребывания на солнце"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "古铜色",
                                "target_lang_sense_clarification": "晒太阳后形成的肤色"
                            },
                            {
                                "target_lang_word": "晒黑的肤色",
                                "target_lang_sense_clarification": "指晒黑后的皮肤颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b32ade-6d90-362c-89ef-1795e1d98c4b",
                    "sense_definition": "A light, yellowish-brown colour.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "color_brown",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used <w>tan</w> for the background of the portrait.",
                            "target_lang_translations": {
                                "ru": "Художник использовал <w>желтовато-коричневый цвет</w> для фона портрета.",
                                "zh": "画家用<w>浅褐色</w>作为肖像的背景色。"
                            }
                        },
                        {
                            "text": "Do you have these shoes in <w>tan</w> or black?",
                            "target_lang_translations": {
                                "ru": "У вас есть эти туфли в <w>рыжевато-коричневом цвете</w> или черном?",
                                "zh": "这款鞋有<w>浅褐色</w>的还是黑色的？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in tan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый, желтовато-коричневый цвет.",
                        "zh": "一种浅浅的黄褐色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желтовато-коричневый цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "рыжевато-коричневый цвет",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浅褐色",
                                "target_lang_sense_clarification": "一种浅黄褐色"
                            },
                            {
                                "target_lang_word": "黄褐色",
                                "target_lang_sense_clarification": "较偏黄的褐色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b315d54d-a60b-386d-a4d7-11ef6d74cd8d",
                    "sense_definition": "The bark of an oak or other tree from which tannic acid is obtained for leather making.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "leather_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tannery ordered a fresh supply of oak <w>tan</w>.",
                            "target_lang_translations": {
                                "ru": "Кожевенный завод заказал свежий запас дубового <w>корья</w>.",
                                "zh": "那家制革厂订购了一批新鲜的橡树<w>鞣料树皮</w>。"
                            }
                        },
                        {
                            "text": "Workers used the <w>tan</w> to process the raw hides.",
                            "target_lang_translations": {
                                "ru": "Рабочие использовали <w>дубильную кору</w> для обработки сырых шкур.",
                                "zh": "工人们用这种<w>鞣料树皮</w>处理生皮。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кора дуба или другого дерева, из которой получают дубильную кислоту для выделки кожи.",
                        "zh": "用于制革、可提取单宁酸的橡树或其他树木的树皮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубильная кора",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "корьё",
                                "target_lang_sense_clarification": "профессиональный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞣料树皮",
                                "target_lang_sense_clarification": "制革用、富含单宁的树皮"
                            },
                            {
                                "target_lang_word": "栲胶树皮",
                                "target_lang_sense_clarification": "较技术性的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2563bf12-1a1f-3289-b378-02f4ccd1aefe",
                    "sense_definition": "An Armenian drink made of yoghurt and water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a cold glass of <w>tan</w> with our lunch.",
                            "target_lang_translations": {
                                "ru": "Мы насладились холодным стаканом <w>тана</w> за обедом.",
                                "zh": "我们午饭时喝了一杯冰镇的<w>咸酸奶饮料</w>。"
                            }
                        },
                        {
                            "text": "She prepared fresh <w>tan</w> by mixing yoghurt, water, and salt.",
                            "target_lang_translations": {
                                "ru": "Она приготовила свежий <w>тан</w>, смешав йогурт, воду и соль.",
                                "zh": "她把酸奶、水和盐混合起来，做了新鲜的<w>咸酸奶饮料</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Armenian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Армянский напиток из йогурта (мацони) и воды.",
                        "zh": "一种由酸奶和水制成的亚美尼亚饮料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тан",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咸酸奶饮料",
                                "target_lang_sense_clarification": "亚美尼亚的一种酸奶类饮料"
                            },
                            {
                                "target_lang_word": "坦",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f0e92e1-8203-3def-84b2-16764c2d19ef",
                    "sense_definition": "Total acid number; a measure of acidity in a lubricant or crude oil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic checked the <w>tan</w> of the engine oil.",
                            "target_lang_translations": {
                                "ru": "Механик проверил <w>кислотное число</w> моторного масла.",
                                "zh": "机械师检查了机油的<w>总酸值</w>。"
                            }
                        },
                        {
                            "text": "A high <w>tan</w> indicates that the lubricant needs to be changed.",
                            "target_lang_translations": {
                                "ru": "Высокое <w>кислотное число</w> указывает на то, что смазку нужно менять.",
                                "zh": "<w>总酸值</w>高表明这种润滑油需要更换了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общее кислотное число; показатель кислотности в смазочных материалах или сырой нефти.",
                        "zh": "总酸值；衡量润滑油或原油酸性的指标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кислотное число",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总酸值",
                                "target_lang_sense_clarification": "润滑油或原油酸性的技术指标"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca71cb52-ea1e-3755-8d52-66eb3fabdca7",
                    "sense_definition": "To become darker in skin colour due to exposure to the sun.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "skin_color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tend to burn first, but then I <w>tan</w> slowly.",
                            "target_lang_translations": {
                                "ru": "Я обычно сначала обгораю, но потом <w>загораю</w> медленно.",
                                "zh": "我通常先被晒伤，但之后会慢慢<w>晒黑</w>。"
                            }
                        },
                        {
                            "text": "She likes to lie by the pool and <w>tan</w> for hours.",
                            "target_lang_translations": {
                                "ru": "Ей нравится лежать у бассейна и <w>загорать</w> часами.",
                                "zh": "她喜欢躺在泳池边一晒就是几个小时，把自己<w>晒黑</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tan easily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться темнее цветом кожи из-за воздействия солнца.",
                        "zh": "因晒太阳而使皮肤颜色变深。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загорать",
                                "target_lang_sense_clarification": "находиться на солнце"
                            },
                            {
                                "target_lang_word": "загореть",
                                "target_lang_sense_clarification": "стать смуглым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晒黑",
                                "target_lang_sense_clarification": "因晒太阳而使皮肤变黑"
                            },
                            {
                                "target_lang_word": "晒成古铜色",
                                "target_lang_sense_clarification": "在阳光下把皮肤晒成古铜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a5ba300-0808-3860-90d9-75f75a39359d",
                    "sense_definition": "To change an animal hide into leather by soaking it in tannic acid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leather_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes time and skill to <w>tan</w> a hide properly.",
                            "target_lang_translations": {
                                "ru": "Требуется время и мастерство, чтобы правильно <w>выдубить</w> шкуру.",
                                "zh": "要把一张兽皮 properly 地<w>鞣制</w>好，需要时间和技术。"
                            }
                        },
                        {
                            "text": "They use natural materials to <w>tan</w> the leather.",
                            "target_lang_translations": {
                                "ru": "Они используют натуральные материалы, чтобы <w>дубить</w> кожу.",
                                "zh": "他们用天然材料来<w>鞣制</w>皮革。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращать шкуру животного в кожу путем вымачивания в дубильной кислоте.",
                        "zh": "用单宁酸等鞣料浸泡兽皮，使其变成皮革。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубить",
                                "target_lang_sense_clarification": "обрабатывать кожу"
                            },
                            {
                                "target_lang_word": "выдубить",
                                "target_lang_sense_clarification": "закончить обработку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞣制",
                                "target_lang_sense_clarification": "加工兽皮使之成为皮革"
                            },
                            {
                                "target_lang_word": "鞣",
                                "target_lang_sense_clarification": "较简洁的动词说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30e5a2b3-3bf6-34b3-b9af-6c2dbfb2e868",
                    "sense_definition": "To spank or beat someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My father threatened to <w>tan</w> my hide if I misbehaved.",
                            "target_lang_translations": {
                                "ru": "Мой отец пригрозил <w>спустить</w> с меня шкуру, если я буду плохо себя вести.",
                                "zh": "我父亲威胁说，如果我不听话，他就要<w>揍</w>我一顿。"
                            }
                        },
                        {
                            "text": "He said he would <w>tan</w> the boy for breaking the window.",
                            "target_lang_translations": {
                                "ru": "Он сказал, что <w>выпорет</w> мальчика за разбитое окно.",
                                "zh": "他说要因为那个男孩打破了窗户而<w>痛打</w>他一顿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tan someone's hide"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шлепать или бить кого-то.",
                        "zh": "打某人；揍某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпороть",
                                "target_lang_sense_clarification": "наказать физически"
                            },
                            {
                                "target_lang_word": "отлупить",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "надрать",
                                "target_lang_sense_clarification": "разговорное, в идиомах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "揍",
                                "target_lang_sense_clarification": "口语，指打人、揍人"
                            },
                            {
                                "target_lang_word": "痛打",
                                "target_lang_sense_clarification": "较重地打"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "61c9d51d-a69b-35ac-92cc-482e8abcd2fb",
                    "sense_definition": "A surname of Vietnamese or Chinese origin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tan</w> will be leading the meeting today.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Тан</w> будет вести собрание сегодня.",
                                "zh": "今天将由<w>谭</w>先生主持会议。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Tan</w> at the clinic.",
                            "target_lang_translations": {
                                "ru": "У меня прием у доктора <w>Тана</w> в клинике.",
                                "zh": "我在诊所约了<w>谭</w>医生看诊。"
                            }
                        }
