                        ]
                    },
                    {
                        "translation_id": "a42b02ed-f9da-45b3-a4f5-f6be33fcea27",
                        "source_entry_id": "3e660a14-9646-38f4-8ccf-e2f98b2e8ffc",
                        "source_sense_id": "40609322-c1a8-3cfc-a3c3-2beff4f29ec3",
                        "source_sense_description": "grasslike marine plants",
                        "target_lang_word": "posidonie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "posidonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b80a9548-6fbb-326a-abff-07db5b8b95a0",
                                        "entry_id": "189e06d7-d8ec-3970-826d-39c2f6471c83",
                                        "glosses": [
                                            "Plante à fleurs angiosperme monocotylédones sous-marines qui vit dans les eaux tempérées ou chaudes en mer Méditerranée et dans les zones tempérées des mers australiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e23206-1bce-4f86-890e-17e1f7ac457b",
                                                "sense_id": "b80a9548-6fbb-326a-abff-07db5b8b95a0",
                                                "text": "Nous avons vu les traces de posidonies sur les plages."
                                            },
                                            {
                                                "example_id": "4fd9ff02-a114-4b6a-aa05-9fc354b6001d",
                                                "sense_id": "b80a9548-6fbb-326a-abff-07db5b8b95a0",
                                                "text": "Il vendit son exploitation, subit un stage de formation accélérée puis, aidé d’un ingénieur agronome, il se lança dans la culture des posidonies. — (Joëlle Wintrebert, Les olympiades truquées, 1998, J'ai Lu, page 48)"
                                            },
                                            {
                                                "example_id": "426f727b-1080-4635-acf0-9b2b10acba7a",
                                                "sense_id": "b80a9548-6fbb-326a-abff-07db5b8b95a0",
                                                "text": "La découverte, qui pourrait provenir d’un naufrage dont l'épave n’a pas été retrouvée, a été faite par un plongeur dans une zone sablonneuse, sous des herbiers de posidonie, près de la côte nord-est de la Sardaigne."
                                            },
                                            {
                                                "example_id": "fd56c8d4-72ed-4895-9a61-56ea7e711c60",
                                                "sense_id": "b80a9548-6fbb-326a-abff-07db5b8b95a0",
                                                "text": "La posidonie n’est pas une algue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "550f14e5-e892-4c79-9837-baa4966f88d7",
                        "source_entry_id": "3e660a14-9646-38f4-8ccf-e2f98b2e8ffc",
                        "source_sense_id": "40609322-c1a8-3cfc-a3c3-2beff4f29ec3",
                        "source_sense_description": "grasslike marine plants",
                        "target_lang_word": "Seegras",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seegras",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                        "entry_id": "5fc3099c-d87a-3f1c-9daf-0aa138c9885c",
                                        "glosses": [
                                            "in Küstennähe auf dem Meeresboden wachsende Samenpflanze, deren lange, grasähnliche Blätter wirtschaftlich genutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05830bd-3de0-42a3-8dc9-f4891c1cb70e",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Zu den wenigen Gewinnern einer Säureschwemme dürfte dagegen das Seegras gehören – je tiefer der pH-Wert, desto mehr wuchert das submarine Grünzeug."
                                            },
                                            {
                                                "example_id": "93d6fcbb-fb1e-4b2d-9c4d-e23b334b8a74",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "An der Nord- und Ostseeküste wurde schon vor Jahrhunderten mit Seegras gedämmt."
                                            },
                                            {
                                                "example_id": "399fb8de-32aa-494c-9366-62c6b59e22e5",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Seegras ist ein zu 100 Prozent natürliches Baumaterial, das als Schüttdämmstoff oder in Form von Faserplatten zur Innen- und Zwischensparrendämmung genutzt werden kann."
                                            },
                                            {
                                                "example_id": "706e3885-2d17-4353-b5db-bd731a136500",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Auch hier pflanzte er Seegras, goss es mit einem Bambussegment voll Meerwasser an und hob seinen Fuß, wobei die Fluten auseinander wichen."
                                            },
                                            {
                                                "example_id": "0e16025e-e999-4561-9202-02e0fafa8379",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Wenn das Seegras nach einigen warmen Tagen trocken geworden, geschieht das Auslesen ohne Schwierigkeit, wenn man eine Handvoll nach der andern hervorzieht, etwas abschüttelt und von fremden Pflanzen trennt."
                                            },
                                            {
                                                "example_id": "98baf5a2-a322-4be7-b200-8860498f09d4",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "„Ein Hektar Seegras nimmt genauso viel CO₂ auf, wie die fünfunddreißigfache Fläche Regenwald.“"
                                            },
                                            {
                                                "example_id": "a7d25834-9ef2-4d22-9167-fab7f5a65264",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "„GEOMAR-Forschende beobachten, dass dort, wo weniger gedüngt wird, das Seegras in der Ostsee besser wächst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
