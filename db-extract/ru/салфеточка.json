                "translations": [
                    {
                        "translation_id": "a13118ab-4b31-49e5-828f-114772c9a46a",
                        "source_entry_id": "483aacc5-c080-3e66-8d89-164be7077608",
                        "source_sense_id": "67a01ada-4595-3ee1-afb4-b3f8e71970d1",
                        "target_lang_word": "doily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea85d3a3-543b-32f4-aa08-668e87240f1a",
                                        "entry_id": "899665b5-91ac-365b-a31b-d14dbe8b41e4",
                                        "glosses": [
                                            "A small ornamental piece of lace or linen or paper used to protect a surface from scratches by hard objects such as vases or bowls; or to decorate a plate of food."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7803904-b87c-4330-af75-81ea71530478",
                                                "sense_id": "ea85d3a3-543b-32f4-aa08-668e87240f1a",
                                                "text": "She looked polite, and observed the oiled floors, hard-wood staircase, unused fireplace with tiles which resembled brown linoleum, cut-glass vases standing upon doilies, and the barred, shut, forbidding unit bookcases that were half filled with swashbuckler novels and unread-looking sets of Dickens, Kipling, O. Henry, and Elbert Hubbard."
                                            },
                                            {
                                                "example_id": "99c3ce74-ad8e-4a39-b3e6-f90ac640d6be",
                                                "sense_id": "ea85d3a3-543b-32f4-aa08-668e87240f1a",
                                                "text": "Beg pardon, I'm soiling the doileys / With afternoon tea-cakes and scones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bafb6ce-1113-35b3-ad22-fe38c4052e99",
                                        "entry_id": "899665b5-91ac-365b-a31b-d14dbe8b41e4",
                                        "glosses": [
                                            "A similar circular piece of lace worn as a head-covering by some married Jewish women."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdd022e-473d-3704-981f-27ca66d7e086",
                                        "entry_id": "899665b5-91ac-365b-a31b-d14dbe8b41e4",
                                        "glosses": [
                                            "An old kind of woollen material."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b26a9c7-38c4-4ea5-9b88-87185b071fad",
                        "source_entry_id": "483aacc5-c080-3e66-8d89-164be7077608",
                        "source_sense_id": "67a01ada-4595-3ee1-afb4-b3f8e71970d1",
                        "target_lang_word": "antimacassar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimacassar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe27087-e8ac-3473-8606-ec137a782068",
                                        "entry_id": "38b6eef4-d3ae-3f8a-bed0-c8434d941e21",
                                        "glosses": [
                                            "A cover for the back or arms of a chair or sofa, originally to prevent them from being soiled by macassar oil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca66bd3-9f7f-41f2-abd3-ab2d42d390ce",
                                                "sense_id": "bbe27087-e8ac-3473-8606-ec137a782068",
                                                "text": "She was particularly fond of animals, and, besides her canary, whose cage hung on a nail in the massive wall of the keep by day, to the great annoyance of prisoners who relished an after-dinner nap, and was shrouded in an antimacassar on the parlour table at night, she kept several piebald mice and a restless revolving squirrel."
                                            },
                                            {
                                                "example_id": "58fcb2b8-6510-4155-b954-b7c4b9ae53ad",
                                                "sense_id": "bbe27087-e8ac-3473-8606-ec137a782068",
                                                "text": "[…] how could anyone on a three-legged stool under the high top of the sofa sleep? Especially if the fringe of an antimacassar lolled over the top and tickled your neck?"
                                            },
                                            {
                                                "example_id": "ee69b58c-1f1b-412c-84b9-0c049b7ae8a0",
                                                "sense_id": "bbe27087-e8ac-3473-8606-ec137a782068",
                                                "text": "The upholstery is of Irish tweed, with antimacassars in Irish linen, and the rugs are hand-woven in Celtic design."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
