                    "frequency": "Middle",
                    "semantic_group_id": "défaut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le magasin a accepté de remplacer cet appareil <w>défectueux</w> sans frais supplémentaires."
                        },
                        {
                            "text": "Cette pièce mécanique est <w>défectueuse</w> et doit être changée immédiatement."
                        }
                    ],
                    "antonyms": [
                        "fonctionnel",
                        "intact"
                    ],
                    "common_phrases": [
