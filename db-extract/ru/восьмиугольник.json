                "senses": [
                    {
                        "sense_id": "db58675a-6a65-3dd8-9953-b173f0acca54",
                        "entry_id": "360b1a8c-5d45-3e19-8049-e6e032df78dd",
                        "glosses": [
                            "геометр. многоугольник с восемью углами"
                        ],
                        "tags": [],
