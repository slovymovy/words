                    {
                        "translation_id": "0689bffc-a629-4148-a22b-916eda6c3d69",
                        "source_entry_id": "3c48f0d4-b300-3598-b098-6551645885ed",
                        "source_sense_description": "act of seducing",
                        "target_lang_word": "verleiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verleiding",
