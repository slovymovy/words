                                                "example_id": "4e9a9cdc-37c3-4845-a8ff-978dcec2ed99",
                                                "sense_id": "2f435d47-e7eb-3802-b694-78bfafe6cd2d",
                                                "text": "„Die älteste Mythologie kennt nur zwei Orakel, das apollinische zu Pytho, und das Orakel des Zeus zu Dodona.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
