                },
                {
                    "sense_id": "f3a077dd-0172-37a1-8079-73041b699bdc",
                    "sense_definition": "A curved club or stick used to strike a ball in games such as bandy or hockey.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed an antique wooden <w>bandy</w> used more than a century ago.",
                            "target_lang_translations": {
                                "nl": "Het museum stelde een antieke houten <w>bandystick</w> tentoon die meer dan een eeuw geleden werd gebruikt."
                            }
                        },
                        {
                            "text": "He carefully wrapped the handle of his <w>bandy</w> with leather tape before the match.",
                            "target_lang_translations": {
                                "nl": "Voor de wedstrijd omwikkelde hij het handvat van zijn <w>slagstok</w> zorgvuldig met leren tape."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kromme slagstok of stick gebruikt bij sporten zoals bandy of hockey."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bandystick",
                                "target_lang_sense_clarification": "stok voor bandy"
                            },
                            {
                                "target_lang_word": "slagstok",
                                "target_lang_sense_clarification": "gebogen stick"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc0088d-4c67-3af0-a82c-a043b01eb1a0",
                    "sense_definition": "A heavy cart or carriage used in India, typically drawn by bullocks.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant loaded his goods onto a wooden <w>bandy</w> to transport them to the market.",
                            "target_lang_translations": {
                                "nl": "De handelaar laadde zijn goederen op een houten <w>kar</w> om ze naar de markt te vervoeren."
                            }
                        },
                        {
                            "text": "A slow-moving bullock <w>bandy</w> blocked the narrow dirt road through the village.",
                            "target_lang_translations": {
                                "nl": "Een langzaam rijdende <w>ossenkar</w> blokkeerde de smalle zandweg door het dorp."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bullock bandy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "India"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een zware kar of wagen in India, meestal getrokken door ossen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ossenkar",
                                "target_lang_sense_clarification": "in India"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f4bc641c-e19a-3a33-8a04-b22db15a8abf",
                    "sense_definition": "Curved outward at the knees; bow-legged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old sailor walked with a comical waddle on his short, <w>bandy</w> legs.",
                            "target_lang_translations": {
                                "nl": "De oude zeeman liep met een komische waggel op zijn korte, <w>kromme</w> benen."
                            }
                        },
                        {
                            "text": "He was quite <w>bandy</w> from spending decades riding horses every single day.",
                            "target_lang_translations": {
                                "nl": "Hij was behoorlijk <w>o-benig</w> doordat hij tientallen jaren elke dag paardreed."
