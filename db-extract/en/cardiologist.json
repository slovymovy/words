                    {
                        "translation_id": "26449076-b004-4fbc-98ab-619e20b117d8",
                        "source_entry_id": "7749d14d-d2b8-3786-af92-ec90ae18cb42",
                        "source_sense_id": "68562821-e581-39fa-b3d5-64a0616fe2b1",
