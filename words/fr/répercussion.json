            "senses": [
                {
                    "sense_id": "abc59479-71fa-3a38-b742-a81394751f08",
                    "sense_definition": "Effet indirect ou suite durable qu'un événement, un acte ou une mesure entraîne sur quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision politique aura de graves <w>répercussions</w> sur le pouvoir d'achat des ménages."
                        },
                        {
                            "text": "La crise sanitaire a provoqué des <w>répercussions</w> économiques imprévues dans presque tous les secteurs d'activité."
                        }
                    ],
                    "synonyms": [
                        "retombée"
                    ],
                    "common_phrases": [
                        "avoir des répercussions",
                        "répercussions économiques"
                    ]
                },
                {
                    "sense_id": "c1769e49-6722-358a-b6a8-63c84d4ace0e",
                    "sense_definition": "Renvoi ou réflexion d'une onde sonore, de la lumière ou de la chaleur par un obstacle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>répercussion</w> de l'écho contre la paroi rocheuse impressionnait les promeneurs dans la vallée."
                        },
                        {
                            "text": "La <w>répercussion</w> des rayons du soleil sur les vitres de l'immeuble éblouissait les conducteurs."
                        }
                    ],
                    "common_phrases": [
