                                "sense_id": "08ca00ca-020b-32f5-9e22-f363687124cb",
                                "text": "Опа́сная ситуа́ция сложи́лась.",
                                "translation": "A dangerous situation took shape.",
                                "english": "A dangerous situation took shape."
                            }
