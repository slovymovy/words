                "senses": [
                    {
                        "sense_id": "4e12940f-503c-353b-acbd-61028f0d206c",
                        "entry_id": "b2d7be76-4fad-3f9d-bb1c-888ccfae37eb",
                        "glosses": [
                            "женск. к разбойник; грабительница; женщина, помышляющая разбоем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca9f2c21-0835-4b68-9923-d3f01bc4ac5f",
                                "sense_id": "4e12940f-503c-353b-acbd-61028f0d206c",
                                "text": "Потому что непослушная разбойница вместо того, чтобы убить ландграфа, влюбилась в него!"
                            }
                        ]
                    },
                    {
                        "sense_id": "fca74d06-ef50-3c35-81c2-9d3fd96d52ad",
                        "entry_id": "b2d7be76-4fad-3f9d-bb1c-888ccfae37eb",
                        "glosses": [
                            "то же, что баловница, шалунья"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e392bed-5259-40da-8541-7e0bd6b090f0",
                                "sense_id": "fca74d06-ef50-3c35-81c2-9d3fd96d52ad",
                                "text": "Навстречу выскочила Муха, радостно визжа и прыгая на грудь. ― Что, разбойница, соскучилась? ― спросил я, наклоняясь к ней."
                            }
                        ]
                    }
                ],
