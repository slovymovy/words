                                        "sense_id": "29e8b822-1a8c-3f5f-afbb-072d66832c71",
                                        "entry_id": "94b90df8-f768-396a-b4cf-4c812fa5c1e0",
                                        "glosses": [
                                            "The electronic process by which any sound's gain is automatically controlled."
