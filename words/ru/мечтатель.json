    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "be8826f9-6fa0-376b-8ddf-86905fa08655",
                    "sense_definition": "Тот, кто любит мечтать, строить светлые планы или предаваться грёзам.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "мечтатель_характер",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой младший брат всегда был большим <w>мечтателем</w> и верил в чудеса.",
                            "target_lang_translations": {
                                "de": "Mein jüngerer Bruder war schon immer ein großer <w>Träumer</w> und glaubte an Wunder."
                            }
                        },
                        {
                            "text": "Как настоящий <w>мечтатель</w>, он часами смотрел на ночное небо и думал о космосе.",
                            "target_lang_translations": {
                                "de": "Wie ein echter <w>Träumer</w> schaute er stundenlang in den Nachthimmel und dachte über den Weltraum nach."
                            }
                        }
                    ],
                    "synonyms": [
                        "фантазёр",
                        "идеалист"
                    ],
                    "antonyms": [
                        "реалист",
                        "прагматик"
                    ],
                    "common_phrases": [
                        "юный мечтатель",
                        "неисправимый мечтатель"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemand, der gerne träumt, schöne Zukunftspläne schmiedet oder sich Tagträumen hingibt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Träumer",
                                "target_lang_sense_clarification": "Person, die gerne träumt und Hoffnungen hegt"
                            },
                            {
                                "target_lang_word": "Schwärmer",
                                "target_lang_sense_clarification": "Person, die sich für Ideale begeistert"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "291ab261-d918-3ac7-b764-5786b0609eab",
                    "sense_definition": "Человек, оторванный от реальной действительности и живущий в мире несбыточных фантазий.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "мечтатель_характер",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Такие наивные <w>мечтатели</w> редко добиваются успеха в суровом мире бизнеса.",
                            "target_lang_translations": {
                                "de": "Solch naive <w>Träumer</w> haben in der harten Geschäftswelt selten Erfolg."
                            }
                        },
                        {
                            "text": "Коллеги считали его пустым <w>мечтателем</w>, чьи идеи никогда не воплотятся в жизнь.",
                            "target_lang_translations": {
                                "de": "Die Kollegen hielten ihn für einen realitätsfernen <w>Phantasten</w>, dessen Ideen niemals Wirklichkeit werden würden."
                            }
                        }
                    ],
                    "synonyms": [
                        "фантазёр",
                        "утопист",
                        "прожектёр",
                        "манилов"
                    ],
                    "antonyms": [
                        "практик"
                    ],
                    "common_phrases": [
                        "пустой мечтатель",
                        "наивный мечтатель"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein weltfremder Mensch, der den Bezug zur Realität verloren hat und in unerfüllbaren Illusionen lebt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Träumer",
                                "target_lang_sense_clarification": "Lebensfremde oder unpraktische Person"
                            },
                            {
                                "target_lang_word": "Phantast",
                                "target_lang_sense_clarification": "Person mit weltfremden, unrealistischen Ideen"
                            },
                            {
                                "target_lang_word": "Utopist",
                                "target_lang_sense_clarification": "Verfechter undurchführbarer Vorstellungen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}