                "word": "cowpox",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aa821504-a70f-4aa4-9c9e-c1b67874e7cc",
                        "entry_id": "aa865b85-9565-3841-8dfd-af2f64e980f0",
                        "tags": [
