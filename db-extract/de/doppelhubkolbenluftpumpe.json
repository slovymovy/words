                "senses": [
                    {
                        "sense_id": "76d5cd80-6844-3da0-98ab-60edb7d34fbf",
                        "entry_id": "e6709792-e132-319e-be33-0ce01412d08c",
                        "glosses": [
                            "Gerät zum manuellen Aufpumpen, das sowohl beim Hochziehen als auch beim Hinunterdrücken des Kolbens Luft abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2b1fff-9dd1-4606-b02b-6f78880195e0",
                                "sense_id": "76d5cd80-6844-3da0-98ab-60edb7d34fbf",
                                "text": "Mit der Doppelhubkolbenluftpumpe bist du doppelt so schnell fertig, wie mit der einfachen Luftpumpe."
                            },
                            {
                                "example_id": "2d126076-4649-44f7-9c35-295e867d8891",
                                "sense_id": "76d5cd80-6844-3da0-98ab-60edb7d34fbf",
                                "text": "„Die TÜV- und Gütesiegel-geprüfte Doppelhubkolbenluftpumpe erzeugt einen Druck von bis zu einem Bar und hat eine Förderhöhe von bis zu vier Metern und eine Leistung von 2. x 3000 Kubikzentimetern.“"
                            },
                            {
                                "example_id": "79bf9546-ed48-4ef2-aca1-a39b234d692f",
                                "sense_id": "76d5cd80-6844-3da0-98ab-60edb7d34fbf",
                                "text": "„Elmar kommt dazu und versenkt die Heringe mit seinem Hammer. Dann besorge ich eine Doppelhubkolbenluftpumpe und blase das Luftbett auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
