                        "examples": [
                            {
                                "example_id": "638440f0-a1ac-40cb-ad3a-c76c6eb475ad",
                                "sense_id": "c5e835d2-cbf5-3631-965b-0f57b883405c",
                                "text": "Я, мо́жет, приду́ сего́дня по́здно.",
                                "translation": "I may come late tonight.",
                                "english": "I may come late tonight."
                            },
                            {
                                "example_id": "536b480a-5233-4dab-b98f-7df7ff2c5124",
                                "sense_id": "c5e835d2-cbf5-3631-965b-0f57b883405c",
                                "text": "Ну, мо́жет, и так.",
                                "translation": "Well, perhaps so.",
                                "english": "Well, perhaps so."
                            },
                            {
                                "example_id": "f1273d0d-89ef-4f7e-bfcb-b21a32b5f3fe",
                                "sense_id": "c5e835d2-cbf5-3631-965b-0f57b883405c",
                                "text": "Мо́жет, ты, наконе́ц, доде́лаешь свою́ рабо́ту?",
                                "translation": "Are you going to finish your work at last?",
                                "english": "Are you going to finish your work at last?"
                            }
                        ]
                    }
                ],
