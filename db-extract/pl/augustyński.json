                "senses": [
                    {
                        "sense_id": "5007ce4c-d1d3-3a1b-91a9-d12ca24c03a6",
                        "entry_id": "f15bcfbb-0c9b-3e4b-8a98-dd70e28e773b",
                        "glosses": [
                            "związany z Augustynem z Hippony lub augustynizmem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0dbd80b-e0a3-4c4e-9771-bcc6594b5fb5",
                                "sense_id": "5007ce4c-d1d3-3a1b-91a9-d12ca24c03a6",
                                "text": "Podczas jego rządów nastąpiła inkorporacja kapituły chełmińskiej do zakonu krzyżackiego oraz zmiana reguły obowiązującej w kapitule z augustyńskiej na krzyżacką"
                            },
                            {
                                "example_id": "5a38fb54-df32-4d85-a2ea-8961e59d4951",
                                "sense_id": "5007ce4c-d1d3-3a1b-91a9-d12ca24c03a6",
                                "text": "Wyposażony w augustyński i bonawenturiański arsenał młody teolog, dzięki przyjaźni z sekretarzem kard. Josepha Fringsa z Kolonii, został doradcą kardynała na Soborze Watykańskim II"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
