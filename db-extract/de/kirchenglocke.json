                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "07175197-4208-4fce-bd53-1a6f7fba9676",
                        "source_entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                        "source_sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                        "source_sense_description": "Glocke, die zum Geläut einer Kirche gehört",
                        "target_lang_word": "campana della chiesa",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8caa65a9-3e5c-4638-9ba3-bdb1e7639beb",
                        "source_entry_id": "bbb25d9b-b4dd-39d1-99ce-80d21c171343",
                        "source_sense_id": "3dc10f9c-b23a-39d2-82c3-2e9d2deacf19",
                        "source_sense_description": "Glocke, die zum Geläut einer Kirche gehört",
                        "target_lang_word": "kerkklok",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kerkklok",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                                        "entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
                                        "glosses": [
                                            "een bel in de toren van een kerk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e822167-47fe-4d15-a264-f23bfd1c30cc",
                                                "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                                                "text": "Je kan de kerkklok zelfs hier helemaal horen."
                                            },
                                            {
                                                "example_id": "28dfe61c-6a62-40f8-aec0-e1780ccfe1b5",
                                                "sense_id": "e660fdae-6b6c-3e7f-ab77-0ebc5e0574a4",
                                                "text": "Op zondagochtend fietste ik richting onbekende kerkklokken om te zien of de gemeente en de sfeer daar iets voor mij was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d76e04d-eff8-3737-9141-5141eae14153",
                                        "entry_id": "d1ad87f3-f7b4-398d-a572-6e0385046342",
                                        "glosses": [
                                            "uurwerk op een klokkentoren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7cad11-de42-48c4-b9d7-5bba4c5807a2",
                                                "sense_id": "3d76e04d-eff8-3737-9141-5141eae14153",
                                                "text": "Door de ramen van de gang kan ik juist op de kerkklok kijken, en tot m'n grote verlichting zie ik dat 't nog maar vijf minuten voor drie meer is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
