                "senses": [
                    {
                        "sense_id": "d15969da-2c82-3fa3-96c6-fd18373f06a1",
                        "entry_id": "7dfd9e18-6516-306f-ab7d-07f7dd0df700",
                        "glosses": [
                            "eine weibliche Person, die mit Abstand als letzte oder sehr spät an einem Treffpunkt erscheint, hinter anderen zurückbleibt (auch im übertragenen Sinne für Gegenstände und Konzepte weiblichen grammatischen Geschlechts benutzt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "719e64d9-0ce5-4968-a13e-42a3dcb7de88",
                                "sense_id": "d15969da-2c82-3fa3-96c6-fd18373f06a1",
                                "text": "„Die vom Gericht durchgeführte Beweisaufnahme konnte nicht klären, ob die beklagte Kreuzungsräumerin eine echte Kreuzungsräumerin oder echte Nachzüglerin war, oder ob es sich bei ihr um eine unechte Kreuzungsräumerin handelte.“"
                            },
                            {
                                "example_id": "fe556b1d-d313-456b-8dd8-0e35cfa1a6c4",
                                "sense_id": "d15969da-2c82-3fa3-96c6-fd18373f06a1",
                                "text": "„Der spanische Hersteller hat Erfolg mit einer Nachzüglerin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5d6d21e-a091-3851-8e8d-088dd7464761",
                        "entry_id": "7dfd9e18-6516-306f-ab7d-07f7dd0df700",
                        "glosses": [
                            "ein in der Geburtenfolge mit Abstand spät gekommenes Mädchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150639f1-b37f-44bd-be4f-bc4e734ee877",
                                "sense_id": "b5d6d21e-a091-3851-8e8d-088dd7464761",
                                "text": "„Mathias und Laura (um die 40), Ron und Nikki (15-16) sowie Nachzüglerin Betty (7) leben in verschiedenen Welten, man kennt einander kaum, obwohl man sich täglich begegnet, und alles Wesentliche kommt zu kurz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6baea92-bafd-4dce-874a-8d802b7f1a29",
                        "source_entry_id": "7dfd9e18-6516-306f-ab7d-07f7dd0df700",
                        "source_sense_id": "d15969da-2c82-3fa3-96c6-fd18373f06a1",
