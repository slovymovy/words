                        "source_sense_id": "fce02aed-ed4e-3ec0-bc26-0bcc1c8c5de0",
                        "source_sense_description": "somebody whose wealth is greater than one million",
                        "target_lang_word": "millionnaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "millionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a59440c5-20f5-395f-8181-9890a1e49894",
                                        "entry_id": "f9839e0d-bf90-34e9-bf5a-2e26d629e572",
                                        "glosses": [
                                            "Celui ou celle qui possède un ou plusieurs millions d'une unité monétaire donnée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1800c6f9-c70b-44b1-8243-cef9d0f89b63",
                                                "sense_id": "a59440c5-20f5-395f-8181-9890a1e49894",
                                                "text": "Ce millionnaire - qui ne l’avait pas toujours été - payait de mine et personne ne l’aurait pris pour un parvenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e1941a9-23c0-3ac3-970b-e626431f3599",
                                        "entry_id": "f9839e0d-bf90-34e9-bf5a-2e26d629e572",
                                        "glosses": [
                                            "Celui ou celle qui est extrêmement riche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f7d02c-1e34-4245-b544-4e33fb789397",
                                                "sense_id": "7e1941a9-23c0-3ac3-970b-e626431f3599",
                                                "text": "[…] ; mais question de sac mise à part, le charme secret du mot millionnaire opère sur les honnêtes gens comme sur les pieds plats. Le millionnaire a la privilège de connaitre la bassesse désintéressée de la contempler toute nue, bien des gens savent qu’ils n’ont rien à attendre de lui et pourtant ils volent à sa rencontre, le saluent, lui sourient, […]."
                                            },
                                            {
                                                "example_id": "cadcc916-4f88-4450-81f7-19c6b5ea4383",
                                                "sense_id": "7e1941a9-23c0-3ac3-970b-e626431f3599",
                                                "text": "Lorsqu'elle a donné à son public ce qu'il attendait d'elle, elle pivote impérieusement, lance un dédaigneux regard dans sa direction avant de regagner de façon tout aussi déterminée le monde à part dans lequel ne vivent que les tops, les créateurs et les millionnaires."
                                            },
                                            {
                                                "example_id": "bb711631-1a53-4360-baab-e75c1ed742cb",
                                                "sense_id": "7e1941a9-23c0-3ac3-970b-e626431f3599",
                                                "text": "Regarde où j'en suis, ça fait des mois que je suis sensée être devenue millionnaire et j'en suis toujours rendue à bouffer des coquillettes au beurre, dans un appartement qui ne contient pas le moindre élément instagramable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "millionnaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89e0a122-2e15-3c6a-bd76-7c6397ea5d7e",
                                        "entry_id": "ff7017b0-ecf7-3b6c-8ceb-c0204e09986c",
                                        "glosses": [
                                            "Qui est extrêmement riche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95702209-77ed-4a49-ae44-9aafe0b2bf8f",
                                                "sense_id": "89e0a122-2e15-3c6a-bd76-7c6397ea5d7e",
                                                "text": "L’industriel millionnaire sent confusément qu’un tel homme place dans son estime une pensée avant un sac de mille francs."
                                            },
                                            {
                                                "example_id": "e9e966d3-4cba-4956-864f-e68dedf2b0cf",
                                                "sense_id": "89e0a122-2e15-3c6a-bd76-7c6397ea5d7e",
                                                "text": "Voici le marguillier millionnaire figé au moment même où il ordonne la hausse du bœuf, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
