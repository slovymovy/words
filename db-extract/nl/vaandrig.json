                    {
                        "sense_id": "fbed2e56-e2f3-329f-8195-412d8f4f317a",
                        "entry_id": "d11292cf-c549-3b42-8d35-fa093c86911c",
                        "glosses": [
                            "een aspirant-reserveofficier bij de luchtmacht of landmacht die voor het examen voor reserveluitenant geslaagd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47a988a-7f23-4559-b436-e9093ed0f224",
                                "sense_id": "fbed2e56-e2f3-329f-8195-412d8f4f317a",
                                "text": "Tegenover het gebouw liep een vaandrig."
                            },
                            {
                                "example_id": "5b84e1aa-6172-4ecd-8ef5-ee48d65031cc",
                                "sense_id": "fbed2e56-e2f3-329f-8195-412d8f4f317a",
                                "text": "'Dat was een vreemde uitbarsting,'zei vaandrig Karl."
                            }
                        ]
                    },
                    {
                        "sense_id": "8437e124-507c-3b2e-97b1-078b767425d4",
                        "entry_id": "d11292cf-c549-3b42-8d35-fa093c86911c",
                        "glosses": [
                            "een assistent-leider bij de scouting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8eb35b7-f5a0-44a0-bb31-05c4879eb2d7",
                                "sense_id": "8437e124-507c-3b2e-97b1-078b767425d4",
                                "text": "Wij werden begeleid door onze vaandrig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7505809-594e-4df5-a837-4ecdbd0929ca",
                        "source_entry_id": "d11292cf-c549-3b42-8d35-fa093c86911c",
                        "source_sense_id": "fbed2e56-e2f3-329f-8195-412d8f4f317a",
                        "source_sense_description": "een aspirant-reserveofficier",
                        "target_lang_word": "ensign",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ensign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2dff11-c2a2-304b-afff-7be75d846ab7",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A badge of office, rank, or power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "777b01b6-23eb-48d1-8b2f-9384257e46bf",
                                                "sense_id": "5c2dff11-c2a2-304b-afff-7be75d846ab7",
                                                "text": "The Ensigns of our Power about we bear; / And every Land pays Tribute to the Fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44848886-f6a9-3b32-a35e-c1f93a09796d",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "The lowest grade of commissioned officer in the United States Navy, junior to a lieutenant junior grade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da88d550-9075-42c5-b72d-12f6b4a12878",
                                                "sense_id": "44848886-f6a9-3b32-a35e-c1f93a09796d",
                                                "text": "The skipper Mr. Cooke had hired at Far Harbor was a God-fearing man with a luke warm interest in his new billet and employer, and had only been prevailed upon to take charge of the yacht after the offer of an emolument equal to half a year's sea pay of an ensign in the navy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c33bc52a-9925-305c-bbac-a525ac609b1a",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A flag or banner carried by military units; a standard or color/colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b185c453-b2c6-43b3-990f-8119956822ac",
                                                "sense_id": "c33bc52a-9925-305c-bbac-a525ac609b1a",
                                                "text": "Hang up your ensigns, let your drums be still,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe5146c5-c92d-34fb-ba4e-63091665ed1a",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "The principal flag or banner flown by a ship (usually at the stern) to indicate nationality."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1f584b1-9209-46bc-9dd4-c7b92619909c",
                                                "sense_id": "fe5146c5-c92d-34fb-ba4e-63091665ed1a",
                                                "text": "But Alcibiades swiftly ran up the Athenian ensign on his flagship and bore down on that part of the Peloponnesian fleet which held the advantage and was pursuing the Athenians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d247f084-f790-3dc9-bf83-e056fc3c77ec",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "Any prominent flag or banner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c86f8e-0790-45c1-8602-6bcb29c30a8b",
                                                "sense_id": "d247f084-f790-3dc9-bf83-e056fc3c77ec",
                                                "text": "Ten thousand thousand ensigns high advanced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "885a0fb2-6531-359b-ad54-3d7a67ac9119",
                                        "entry_id": "6a417bab-04ca-3a4c-b070-014ef99a112e",
                                        "glosses": [
                                            "A junior commissioned officer in the 18th and 19th centuries whose duty was to carry the unit's ensign."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ensign",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad532b4-d578-38cd-9830-08b9b18fd5a4",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To designate as by an ensign."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022819d2-64a1-4cef-97ac-9de9fd2f4701",
                                                "sense_id": "8ad532b4-d578-38cd-9830-08b9b18fd5a4",
                                                "text": "HENRY but ioyn’d the Roses, that ensign’d / Particular families, but this hath ioyn’d / The Rose and Thistle,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7ba62f6-a21d-387e-a427-c338f1d3846e",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To distinguish by a mark or ornament."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                        "entry_id": "1a13befa-aa79-31d9-9968-b709d4771271",
                                        "glosses": [
                                            "To distinguish by an ornament, especially by a crown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce63c4e-133d-4449-ba04-12d3f25970c8",
                                                "sense_id": "58e81534-a74c-3dfe-bb5e-0c2e8823b9ef",
                                                "text": "Any charge which has a crown immediately above or upon it, is said to be ensigned."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d41c4fe-5e5f-4c87-8dc0-6a516fe4e551",
                        "source_entry_id": "d11292cf-c549-3b42-8d35-fa093c86911c",
