                "senses": [
                    {
                        "sense_id": "bcf7e347-3a2b-35a7-a656-08554e49419c",
                        "entry_id": "0a5f02b7-3768-3cc4-aedf-693df5591100",
                        "glosses": [
                            "человек, имеющий белый билет, неспособный нести военную службу"
                        ],
                        "tags": [],
