                "senses": [
                    {
                        "sense_id": "13719e4f-3f40-347b-9339-0fe4c7344827",
                        "entry_id": "d0767d83-8b7b-39a3-a035-35be56b292bd",
                        "glosses": [
                            "Das Mindestmaß an Qualität, das erreicht werden muss, um irgendwo zu bestehen oder zugelassen zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea795f05-72af-4519-ba43-adf1c97f394c",
                                "sense_id": "13719e4f-3f40-347b-9339-0fe4c7344827",
                                "text": "Für Restaurants gibt es in Deutschland im Gegensatz zu Hotels keinen verbindlichen Qualitätsstandard."
                            },
                            {
                                "example_id": "e9ffb5b2-5a34-4f39-8f61-5c9d01e6a202",
                                "sense_id": "13719e4f-3f40-347b-9339-0fe4c7344827",
                                "text": "Die Nutzung der verschiedenen Qualitätsstandards zeigt starke regionale und branchenspezifische Unterschiede."
                            },
                            {
                                "example_id": "228572a5-e8da-4c7e-a819-a71a637e4faf",
                                "sense_id": "13719e4f-3f40-347b-9339-0fe4c7344827",
                                "text": "„Insgesamt zeichnete ein hoher Qualitätsstandard die mykenische Keramikproduktion aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
