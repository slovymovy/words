                "senses": [
                    {
                        "sense_id": "8d0c5647-010f-3508-865d-060ddc319af6",
                        "entry_id": "a8dedaa2-ca26-3f72-833a-3364cee560bd",
                        "glosses": [
                            "Boire à en être ivre ; se murger ; faire la fête."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ae5e7f-1e9f-4406-af5b-d9c5d32e0ff2",
                                "sense_id": "8d0c5647-010f-3508-865d-060ddc319af6",
                                "text": "« A nous deux Vincent, nous allons en « cheûler » du fameux , va ! T’m’en diras des nouvelles !... »"
                            },
                            {
                                "example_id": "6d12e067-019b-400a-a699-c01210170b4e",
                                "sense_id": "8d0c5647-010f-3508-865d-060ddc319af6",
                                "text": "— Mais... t'es complètement rond mon salaud ! J’savais bien qu’j’aurais pas dû t'laisser cheûler toute ma goutte ! Ma parole t'en en jamais bu de ta vie ?"
                            }
                        ]
                    }
                ],
