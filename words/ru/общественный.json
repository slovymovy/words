{
    "word_family": [
        "общество",
        "обобщить",
        "обобщение",
        "общественник"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b544260b-17f7-37be-9fd8-6d256682217f",
                    "sense_definition": "Связанный с жизнью общества, относящийся к <w>общество</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "social_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это важное <w>общественное</w> событие для всего города.",
                            "target_lang_translations": {
                                "en": "This is an important <w>social</w> event for the whole city."
                            }
                        },
                        {
                            "text": "Учёные изучают <w>общественные</w> процессы в современном мире.",
                            "target_lang_translations": {
                                "en": "Scientists are studying <w>social</w> processes in the modern world."
                            }
                        }
                    ],
                    "synonyms": [
                        "социальный"
                    ],
                    "antonyms": [
                        "индивидуальный"
                    ],
                    "common_phrases": [
                        "общественное мнение",
                        "общественное развитие"
                    ],
                    "target_lang_definitions": {
                        "en": "Related to the life of society, pertaining to the public sphere."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "social",
                                "target_lang_sense_clarification": "Relating to society or its organization."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d075f102-eab4-3647-a5f4-49ee27045032",
                    "sense_definition": "Значимый для широкого круга людей, публичный, открытый для всех.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "public_domain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В парке есть много <w>общественных</w> мест для отдыха.",
                            "target_lang_translations": {
                                "en": "There are many <w>public</w> places for recreation in the park."
                            }
                        },
                        {
                            "text": "Он активно участвует в <w>общественной</w> жизни университета.",
                            "target_lang_translations": {
                                "en": "He is actively involved in the <w>public</w> life of the university."
                            }
                        }
                    ],
                    "synonyms": [
                        "социальный"
                    ],
                    "antonyms": [
                        "частный",
                        "личный"
                    ],
                    "common_phrases": [
                        "общественный транспорт",
                        "общественное место"
                    ],
                    "target_lang_definitions": {
                        "en": "Significant for a wide range of people, public, open to everyone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "public",
                                "target_lang_sense_clarification": "Open to or shared by all the people of an area or country."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e50b0f38-7cc0-3acd-8735-f4bc7ac210fa",
                    "sense_definition": "Принадлежащий коллективу, не являющийся частной собственностью.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ownership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта земля является <w>общественной</w> собственностью.",
                            "target_lang_translations": {
                                "en": "This land is <w>public</w> property."
                            }
                        },
                        {
                            "text": "Все ресурсы были переданы в <w>общественное</w> пользование.",
                            "target_lang_translations": {
                                "en": "All resources were transferred for <w>public</w> use."
                            }
                        }
                    ],
                    "synonyms": [
                        "общий",
                        "коллективный"
                    ],
                    "antonyms": [
                        "частный",
                        "личный",
                        "единоличный"
                    ],
                    "common_phrases": [
                        "общественная собственность"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to the community, not private property."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "public",
                                "target_lang_sense_clarification": "Owned or provided by the government or community."
                            },
                            {
                                "target_lang_word": "communal",
                                "target_lang_sense_clarification": "Shared by all members of a community."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7661e984-7ad1-30ff-a877-6338f57a6ef4",
                    "sense_definition": "Выполняемый добровольно, без оплаты, на пользу коллектива.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voluntary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты решили работать на <w>общественных</w> началах.",
                            "target_lang_translations": {
                                "en": "The students decided to work on a <w>voluntary</w> basis."
                            }
                        },
                        {
                            "text": "Организовали <w>общественные</w> работы по уборке территории.",
                            "target_lang_translations": {
                                "en": "They organized <w>voluntary</w> work to clean up the area."
                            }
                        }
                    ],
                    "synonyms": [
                        "коллективный"
                    ],
                    "antonyms": [
                        "наёмный"
                    ],
                    "common_phrases": [
                        "общественные начала"
                    ],
                    "target_lang_definitions": {
                        "en": "Performed voluntarily, without payment, for the benefit of the community."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "voluntary",
                                "target_lang_sense_clarification": "Done or given of one's own free will, often without payment."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e108b0f-e2b8-36e4-8ae6-8592905e6b5f",
                    "sense_definition": "Любящий людей, легко вступающий в контакт с окружающими.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он очень <w>общественный</w> человек и всегда окружен друзьями.",
                            "target_lang_translations": {
                                "en": "He is a very <w>sociable</w> person and is always surrounded by friends."
                            }
                        },
                        {
                            "text": "Её <w>общественный</w> характер помогает ей в работе с клиентами.",
                            "target_lang_translations": {
                                "en": "Her <w>sociable</w> nature helps her in working with clients."
                            }
                        }
                    ],
                    "synonyms": [
                        "общительный",
                        "открытый"
                    ],
                    "antonyms": [
                        "замкнутый"
                    ],
                    "target_lang_definitions": {
                        "en": "Fond of people, easily interacting with others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "social",
                                "target_lang_sense_clarification": "Being extroverted or outgoing."
                            },
                            {
                                "target_lang_word": "sociable",
                                "target_lang_sense_clarification": "Willing to talk and engage with others."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}