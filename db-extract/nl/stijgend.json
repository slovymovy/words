                "senses": [
                    {
                        "sense_id": "46f68697-ee55-3e7b-941e-90ae71eb6b2d",
                        "entry_id": "c45c8e56-e970-3970-94d1-ef2e911e8812",
                        "glosses": [
                            "een steeds hogere stand bereikend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f904cf4-f991-4e7a-9ed0-c64c35699930",
                                "sense_id": "46f68697-ee55-3e7b-941e-90ae71eb6b2d",
                                "text": "Vanwege het stijgend aantal inbraken wordt een voorlichtingsavond gehouden."
                            },
                            {
                                "example_id": "7b5380fd-c2b0-4ea1-b475-78abf4118d09",
                                "sense_id": "46f68697-ee55-3e7b-941e-90ae71eb6b2d",
                                "text": "Met stijgende verbazing keek ik naar het tafereel."
                            },
                            {
                                "example_id": "0ca61852-b9e2-4fbf-b803-d0cfc051750f",
                                "sense_id": "46f68697-ee55-3e7b-941e-90ae71eb6b2d",
                                "text": "Ook staten als Californië en Louisiana die vanwege bosbranden, aardbevingen en overstromingen ook als risicovol zijn aangemerkt, zien het aanbod van verzekeringsmaatschappijen snel afnemen. Dat leidt tot stijgende prijzen en steeds minder keuzevrijheid voor huiseigenaren, die het soms niet meer kunnen opbrengen in een bepaald gebied te wonen en uiteindelijk ook vertrekken."
                            }
                        ]
                    }
