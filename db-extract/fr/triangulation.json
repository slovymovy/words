                ],
                "senses": [
                    {
                        "sense_id": "e72652ea-c63b-39c8-97af-bf3be7364950",
                        "entry_id": "3b10a380-9212-3dfa-9a99-e5c14b7177f9",
                        "glosses": [
                            "Action de faire les opérations trigonométriques nécessaires pour lever le plan d’un terrain ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4809c9f-9c48-4250-bca9-2715498d3dc3",
                                "sense_id": "e72652ea-c63b-39c8-97af-bf3be7364950",
                                "text": "L’opération géodésique qu’allait entreprendre la commission était, on le sait, un travail de triangulation ayant pour but la mesure d’un arc de méridien."
                            },
                            {
                                "example_id": "e3817e0d-d4d0-49bf-bcfa-7c4810cbeee7",
                                "sense_id": "e72652ea-c63b-39c8-97af-bf3be7364950",
                                "text": "Une fois la triangulation, l’arpentage et la levée des plans achevés, chaque propriété est cadastrée, c'est-à-dire que les terres qui la composent sont classées d'après leur qualité, ce qui n'est pas exempt de difficultés sérieuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ef5605e-ac99-437d-9565-1c00bffb6555",
                        "source_entry_id": "3b10a380-9212-3dfa-9a99-e5c14b7177f9",
                        "source_sense_id": "e72652ea-c63b-39c8-97af-bf3be7364950",
