                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                        "entry_id": "6b89f4b8-5d8c-3248-9825-94d025de9a5f",
                                        "glosses": [
                                            "Krankenhaus, Heilstätte mit stationärer Versorgung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d7b363-8a92-46fc-b818-dc3b663a685e",
                                                "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                                "text": "Die Klinik für Chirurgie wurde gerade renoviert."
                                            },
                                            {
                                                "example_id": "8ee680c9-7aa0-45fc-b593-f5710047b283",
                                                "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                                "text": "„Franz wird keinen Tag überflüssig in der Klinik liegen, in einer Woche wird Wischow wiederkommen, Eva logiert inzwischen in Magdeburg.“"
                                            },
                                            {
                                                "example_id": "7541ba94-6bce-4e86-b5c2-68bafc75f94c",
                                                "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                                "text": "„Sobald Friedrich morgens in die Klinik aufbrach, machten wir uns auf in den Garten.“"
                                            },
                                            {
                                                "example_id": "19a53d53-c58e-4e4d-a45b-fd900f00498d",
                                                "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                                "text": "„Nachdem sie die Klinik besichtigt hatten, gingen sie zurück in die Bibliothek.“"
                                            },
                                            {
                                                "example_id": "3ab3e8f8-3f95-4f04-8f8f-6f1085ecfb57",
                                                "sense_id": "5e38c610-6ba3-369f-8db3-2277628fca42",
                                                "text": "„Schließlich rief Dr. Borsch sie in das Untersuchungszimmer, in dem weit mehr Instrumente standen als in der Klinik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e88cd06-2121-3154-be42-b45fce1848b0",
                                        "entry_id": "6b89f4b8-5d8c-3248-9825-94d025de9a5f",
                                        "glosses": [
                                            "das Erscheinungsbild und der Verlauf einer Krankheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42d72259-0c57-453e-9a6a-7e1bd7dc1385",
                                                "sense_id": "2e88cd06-2121-3154-be42-b45fce1848b0",
                                                "text": "Die Klinik der Erkrankung lässt einen Stoffwechseldefekt vermuten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
