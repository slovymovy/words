{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48195b19-2b01-339a-b7ae-85f3ff6233f3",
                    "sense_definition": "A team sport played on ice or a field where players use long curved sticks to hit a ball or puck into a goal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We play <w>hockey</w> every Saturday morning at the local sports center.",
                            "target_lang_translations": {
                                "ru": "Мы играем в <w>хоккей</w> каждое субботнее утро в местном спортивном центре.",
                                "zh": "我们每周六早上都在当地体育中心打<w>曲棍球</w>。"
                            }
                        },
                        {
                            "text": "She bought a new <w>hockey</w> stick for the upcoming season.",
                            "target_lang_translations": {
                                "ru": "Она купила новую <w>хоккейную</w> клюшку к предстоящему сезону.",
                                "zh": "她为即将到来的赛季买了一根新的<w>曲棍球</w>杆。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play hockey",
                        "hockey stick",
                        "hockey puck",
                        "ice hockey",
                        "field hockey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Командный вид спорта, в который играют на льду или на траве, где игроки используют длинные изогнутые клюшки, чтобы забить мяч или шайбу в ворота.",
                        "zh": "一种在冰上或场地上进行的团队运动，球员使用长而弯曲的球杆将球或冰球击入球门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоккей",
                                "target_lang_sense_clarification": "вид спорта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曲棍球",
                                "target_lang_sense_clarification": "指代该项运动"
                            },
                            {
                                "target_lang_word": "冰球",
                                "target_lang_sense_clarification": "指代冰上曲棍球"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75d37299-48a1-3ab6-8c23-6297cc9b820e",
                    "sense_definition": "Excrement or nonsense; often used to express disbelief or annoyance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him, that story is just a load of <w>hockey</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, эта история — полная <w>чушь</w>.",
                                "zh": "别听他的，那故事纯属<w>胡说</w>。"
                            }
                        },
                        {
                            "text": "He accidentally stepped in some <w>hockey</w> while walking through the stable.",
                            "target_lang_translations": {
                                "ru": "Он случайно наступил в <w>навоз</w>, проходя через конюшню.",
                                "zh": "他穿过马厩时，不小心踩到了一些<w>粪便</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "horse hockey"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in the phrase 'horse hockey'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Экскременты или чепуха; часто используется для выражения недоверия или раздражения.",
                        "zh": "排泄物或胡言乱语；常用于表达不信任或厌烦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "бессмыслица"
                            },
                            {
                                "target_lang_word": "навоз",
                                "target_lang_sense_clarification": "экскременты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胡说",
                                "target_lang_sense_clarification": "指代无意义的话"
                            },
                            {
                                "target_lang_word": "粪便",
                                "target_lang_sense_clarification": "指代排泄物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14581727-eaba-3144-9fcb-c48cf431b854",
                    "sense_definition": "A line behind which a player must stand when throwing darts; an alternative spelling of <w>oche</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player carefully positioned his foot behind the <w>hockey</w> before throwing.",
                            "target_lang_translations": {
                                "ru": "Игрок осторожно поставил ногу за <w>линию броска</w> перед броском.",
                                "zh": "选手在投掷前小心地将脚放在<w>投掷线</w>后。"
                            }
                        },
                        {
                            "text": "In this pub, the distance to the <w>hockey</w> is marked clearly on the floor.",
                            "target_lang_translations": {
                                "ru": "В этом пабе расстояние до <w>линии броска</w> четко обозначено на полу.",
                                "zh": "在这家酒吧里，地板上清楚地标出了到<w>投掷线</w>的距离。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling of oche"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия, за которой должен стоять игрок при метании дротиков; альтернативное написание слова oche.",
                        "zh": "投掷飞镖时选手必须站在其后的线；oche的另一种拼写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линия броска",
                                "target_lang_sense_clarification": "в дартсе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投掷线",
                                "target_lang_sense_clarification": "飞镖运动中的起掷线"
                            }
                        ]
                    }
                }
            ]
        },
        {
