                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1c3fddb1-e4d2-4f31-8711-a48f34d5916b",
                        "source_entry_id": "f9929ba1-55d6-3f6e-902b-f581664a4b5e",
                        "source_sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                        "target_lang_word": "Bogenmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bogenmacher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4286f12-9db2-3f48-9943-c4fc016b910e",
                                        "entry_id": "882fdac8-8dbe-39bb-93a3-4cf1b7939a39",
                                        "glosses": [
                                            "Handwerker, der Bogen (und/oder Armbrüste) fertigt"
                                        ],
                                        "tags": [
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "359d8462-ec61-41ba-b226-dc3d7d05129c",
                                                "sense_id": "b4286f12-9db2-3f48-9943-c4fc016b910e",
                                                "text": "„Wie die Bogenmacher seit je wissen, muß die Reißfestigkeit der Sehne sechsmal so groß sein wie die Zugkraft des Bogens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f13b5de6-de19-35fb-9e00-1082e44bb731",
                                        "entry_id": "882fdac8-8dbe-39bb-93a3-4cf1b7939a39",
                                        "glosses": [
                                            "Handwerker, der Bögen für Streichinstrumente fertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3163d955-b4e1-49d0-8b87-5fa60466aef7",
                                                "sense_id": "f13b5de6-de19-35fb-9e00-1082e44bb731",
                                                "text": "„Der Bogenmacher macht den Bogen, womit du die Geige, das Cello, den Kontrabass streichst. Das ist ein Beruf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d816b3f9-543c-4ff3-8bf9-e835eba84762",
                        "source_entry_id": "f9929ba1-55d6-3f6e-902b-f581664a4b5e",
                        "source_sense_id": "79101a14-d147-350f-b0b8-29148e7222ea",
                        "target_lang_word": "archetier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archetier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ffde6b6-62ac-3fce-ac4e-e66e73d1c3af",
                                        "entry_id": "5e4f6df8-e810-3b97-b458-866746ad168c",
                                        "glosses": [
                                            "One who builds, repairs, and restores the bows of instruments in the violin family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b429d77b-f8ee-41f3-bc49-a785592cf354",
                                                "sense_id": "0ffde6b6-62ac-3fce-ac4e-e66e73d1c3af",
                                                "text": "Yielding inexpensive means whereby his preternatural gifts could be awakened, puncheon strips were later put aside for that most desirable of all bow woods—pernambuco. It was about 1775 that fate ordained young Tourte to see what other archetiers had done, and then proceed to do it better."
                                            },
                                            {
                                                "example_id": "95552f22-a6d1-485d-8ddf-4523557fece2",
                                                "sense_id": "0ffde6b6-62ac-3fce-ac4e-e66e73d1c3af",
                                                "text": "Nowadays, the craft of the 'archetier', or bow maker, is entirely separated from that of the 'luthier', or instrument maker."
                                            },
                                            {
                                                "example_id": "35369c1d-832b-4981-9e1c-3f65382fe2c3",
                                                "sense_id": "0ffde6b6-62ac-3fce-ac4e-e66e73d1c3af",
                                                "text": "The following are photographs of a few of the many ancient bows made by the contemporary master archetier Eitan Hoffer who operates a shop in Israel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
