                        ],
                        "examples": [
                            {
                                "example_id": "cc368d56-e858-4ec0-aab4-c35676719cbf",
                                "sense_id": "c8c6b096-052a-33ba-ac22-2a4987c7d2fb",
                                "text": "This is one of the feats of Al-Simiyá = white magic; fascinating the eyes. In Europe it has lately taken the name of \"Electro-biology\"."
                            },
                            {
                                "example_id": "e06520c8-12ba-414c-8366-a48bc72afce2",
                                "sense_id": "c8c6b096-052a-33ba-ac22-2a4987c7d2fb",
                                "text": "“To create life, to use science itself, chemical galvanism, electrobiology, etcetera, etcetera. To reanimate dead tissue, now, whomever unlocks that mystery, is not a man, but a god.” “Like Frankenstein.” “Who?” “Like Dr. Victor Frankenstein.” “Never heard of him.” “Right.”"
                            }
                        ]
                    }
