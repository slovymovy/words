                    },
                    {
                        "sense_id": "f8ece35b-656b-34c6-9e3f-c0868e8c8c1e",
                        "entry_id": "307d6eb8-f99c-3e5b-bb39-14996fd9a5da",
                        "glosses": [
                            "吸入，吞沒，吞噬"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3c7a91b-4781-4331-802b-1c3c0a5d2bb0",
                                "sense_id": "f8ece35b-656b-34c6-9e3f-c0868e8c8c1e",
                                "text": "лошаде́й затяну́ло в боло́то; боло́то затяну́ло лошаде́й",
                                "translation": "馬被沼澤吞沒"
                            }
                        ]
                    },
                    {
                        "sense_id": "db496568-51cc-3443-b54e-e9e1d257b195",
                        "entry_id": "307d6eb8-f99c-3e5b-bb39-14996fd9a5da",
                        "glosses": [
                            "吸引，沉浸"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d57f1c-e9d9-48ac-8f3f-c234cfab05de",
                                "sense_id": "db496568-51cc-3443-b54e-e9e1d257b195",
                                "text": "э́та кни́га про́сто затяну́ла меня́",
                                "translation": "這本書深深吸引著我"
                            }
                        ]
                    },
                    {
                        "sense_id": "8dc65087-e545-3f70-824d-af424eca66b7",
                        "entry_id": "307d6eb8-f99c-3e5b-bb39-14996fd9a5da",
                        "glosses": [
                            "開始唱歌，開始演奏"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "199f99e2-c2dd-48a3-9e4a-bb5edb26e643",
                                "sense_id": "8dc65087-e545-3f70-824d-af424eca66b7",
                                "text": "затяну́ть ста́рую (свою́ обы́чную / люби́мую) пе́сню",
                                "translation": "彈奏自己喜歡的曲子"
                            }
                        ]
                    }
