                    },
                    {
                        "form_id": "2779f558-fc74-4ee0-a4c0-7cff25208d32",
                        "entry_id": "31664a19-7ae8-3eb8-b6cb-302be8d7f9ed",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… але́ть"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "90162205-0b07-366a-9caa-b774cbccf570",
                        "entry_id": "31664a19-7ae8-3eb8-b6cb-302be8d7f9ed",
                        "glosses": [
                            "книжн. становиться алым (более алым)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515fd8fd-4481-4546-a2a3-e0159a41a532",
                                "sense_id": "90162205-0b07-366a-9caa-b774cbccf570",
                                "text": "У многих дам, после рюмки-другой вина, алели щёки и блестели глаза."
                            },
                            {
                                "example_id": "d2063581-9f2c-4f64-afdd-1c5d0d61b957",
                                "sense_id": "90162205-0b07-366a-9caa-b774cbccf570",
                                "text": "Эти зубцы сверху донизу были покрыты снегом, который алел в лучах восходившего солнца."
                            }
                        ]
                    },
                    {
                        "sense_id": "225e2665-3692-31ed-8f4d-57ec01c83a4f",
                        "entry_id": "31664a19-7ae8-3eb8-b6cb-302be8d7f9ed",
                        "glosses": [
                            "выделяться своим алым цветом на фоне остальных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11194204-5e9f-4da2-b964-72aa56a09cce",
                                "sense_id": "225e2665-3692-31ed-8f4d-57ec01c83a4f",
                                "text": "Маленькие солдатские палатки ярко белеют, облитые солнцем; ружейные козлы и разноцветные фигуры солдат пестрят этот белый фон. Преобладают лиловые цвета пестрядинных рубах; затем краснеют кумачовые, желтеют, алеют, зеленеют ситцевые."
                            },
                            {
                                "example_id": "4558926f-6bd7-40ea-ab85-a405add5cc7e",
                                "sense_id": "225e2665-3692-31ed-8f4d-57ec01c83a4f",
                                "text": "Лица почти не было видно: так оно казалось мало и темно, только губы алели да обозначался узкий прямой нос."
                            }
                        ]
                    },
                    {
                        "sense_id": "30e556fc-5bbf-39be-ade9-610e6a25f306",
                        "entry_id": "31664a19-7ae8-3eb8-b6cb-302be8d7f9ed",
                        "glosses": [
                            "переливаться алым цветом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87cb8089-17f7-4c31-bfa1-3d39c213c765",
                                "sense_id": "30e556fc-5bbf-39be-ade9-610e6a25f306",
                                "text": "Оно так хорошо алело в стекле, так хорошо пенилось, что и умеренный друг ваш, не спрашивая о цене, велел подать себе бутылку — du meilleur!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6a818fc-8f08-4d8c-89df-75975c477550",
                        "source_entry_id": "31664a19-7ae8-3eb8-b6cb-302be8d7f9ed",
                        "target_lang_word": "crimson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd74fff9-9156-3e06-ae1b-569f76de1426",
                                        "entry_id": "8ec5d299-3d18-350b-b42d-e546ca5fcbee",
                                        "glosses": [
                                            "A deep, slightly bluish red."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "870ae41a-c086-48cf-bbac-e829bdff81c1",
                                                "sense_id": "cd74fff9-9156-3e06-ae1b-569f76de1426",
                                                "text": "To my horror I perceived that the yellow blossoms were all dabbled with crimson."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                        "entry_id": "e4557118-ecf1-3c50-8318-f365af744a8f",
                                        "glosses": [
                                            "Having a deep red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785e6662-82ed-4434-b1d7-1912688a0ff3",
                                                "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            },
                                            {
                                                "example_id": "ff79e707-e2a1-497c-bb02-6ef54a2c5106",
                                                "sense_id": "71f346d6-5b25-3090-8966-ef888a2da6b1",
                                                "text": "Her crimson dress inflames grey corridors, or flaring in a sunshaft through high branches makes of the deep green shadows a greenness darker yet, and a darkness greener."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2cab433-221c-36ca-b970-a82b6c429ad6",
                                        "entry_id": "e4557118-ecf1-3c50-8318-f365af744a8f",
                                        "glosses": [
                                            "Immodest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crimson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                        "entry_id": "f7630bcb-ada8-3b0b-9b0a-e4ad7f4de56f",
                                        "glosses": [
                                            "To become crimson or deep red; to blush."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6071bac-b5a0-4ddc-a4a5-abba9fe536c0",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "Eugenie's quick apprehensions seized the foul thought. Her eyes flashed—her cheek crimsoned."
                                            },
                                            {
                                                "example_id": "97ad956b-e0fb-4997-a356-1fa2265ecca4",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "1885, Alfred, Lord Tennyson, “The Ring” in The Poetical Works of Alfred, Lord Tennyson, New York and Boston: Thomas Y. Crowell & Co., Volume 2, p. 662,\nFather. Why do you look so gravely at the tower?\nMiram. I never saw it yet so all ablaze\nWith creepers crimsoning to the pinnacles,"
                                            },
                                            {
                                                "example_id": "51b83f7d-87aa-4b0e-ad29-cdd045249f21",
                                                "sense_id": "312f4cd6-0252-3d70-9b76-2e38349d2648",
                                                "text": "Gerty MacDowell bent down her head and crimsoned at the idea of Cissy saying an unladylike thing like that out loud she'd be ashamed of her life to say, flushing a deep rosy red, and Edy Boardman said she was sure the gentleman opposite heard what she said. But not a pin cared Ciss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                        "entry_id": "f7630bcb-ada8-3b0b-9b0a-e4ad7f4de56f",
                                        "glosses": [
                                            "To dye with crimson or deep red; to redden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72b3f133-d0b8-4d5d-ab85-f18c5162dd9e",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "Here didst thou fall; and here thy hunters stand,\nSign’d in thy spoil, and crimson’d in thy lethe."
                                            },
                                            {
                                                "example_id": "27373af2-2091-4610-badf-f4bffbcc4f88",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "Her face was crimsoned over, and she exclaimed, in a voice of the greatest emotion, “Good God! Willoughby, what is the meaning of this? […]”"
                                            },
                                            {
                                                "example_id": "27f5df52-2844-4f3c-a728-22fb5c96ef62",
                                                "sense_id": "66208eef-b4fa-3197-a722-6ddfa0fce0c0",
                                                "text": "[…] that sheetless bed (that nuptial couch of love and grief) with the pale and bloody corpse in its patched and weathered gray crimsoning the bare mattress […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
