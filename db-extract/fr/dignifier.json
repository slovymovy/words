                                        "entry_id": "56bb5f01-e1c6-3433-a652-f3d0fc18ea7c",
                                        "glosses": [
                                            "To treat as worthy or acceptable; to indulge or condone by acknowledging."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
