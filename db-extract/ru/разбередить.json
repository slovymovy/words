                                                "example_id": "107f43e3-566c-4931-852a-b4cb83680653",
                                                "sense_id": "fb3acee8-b52f-308f-8ca1-2936445e2928",
                                                "text": "the troubled Tiber chafing with her shores"
                                            },
                                            {
                                                "example_id": "d76e7101-4171-4b98-a04c-ca9909eb2f09",
                                                "sense_id": "fb3acee8-b52f-308f-8ca1-2936445e2928",
                                                "text": "[Gitche Manito] Breathed upon the neighbouring forest, / Made its great boughs chafe together, / Till in flame they burst and kindled; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b641810b-a516-3d82-b41c-6909e9d0f113",
                                        "entry_id": "d11b4237-41da-3799-8a82-38e696a6e209",
                                        "glosses": [
