                "senses": [
                    {
                        "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                        "glosses": [
                            "Aussonderung aus den Atemwegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e99a9a22-7e77-4221-9619-259a5902757d",
                                "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                                "text": "Tuberkulose geht meist mit blutigem Auswurf einher."
                            },
                            {
                                "example_id": "9f3986bc-547a-40b6-a487-defe7e93801c",
                                "sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                                "text": "„Wenige Jahre zuvor hatte man bei ihr eine chronische Lungenerkrankung mit Husten, Auswurf und Atemnot diagnostiziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f3e4b9e-d389-33ed-a743-1160eeeb3699",
                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                        "glosses": [
                            "Stelle an einem Gerät, an der etwas ausgeworfen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84533d7d-e2d0-441d-893d-8b9d1a0be965",
                                "sense_id": "4f3e4b9e-d389-33ed-a743-1160eeeb3699",
                                "text": "Der Auswurf funktioniert nicht!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c12fa039-b6e0-3efd-bbdf-f7563374ba81",
                        "entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                        "glosses": [
                            "niedere, minderwertige Person(en)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2f1c333e-60fe-45a1-bbc0-aa6d8cd6abbc",
                                "sense_id": "c12fa039-b6e0-3efd-bbdf-f7563374ba81",
                                "text": "Er gehört zum Auswurf der Menschheit."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cea6b816-315f-4478-a19c-be27bf75e71e",
                        "source_entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                        "source_sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                        "source_sense_description": "Aussonderung aus den Atemwegen",
                        "target_lang_word": "sputum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sputum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                        "entry_id": "12882525-26a7-3b06-b6e9-18b31430bfd9",
                                        "glosses": [
                                            "Matter coughed up and expectorated from the mouth, composed of saliva and discharges from the respiratory passages such as mucus, phlegm or pus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dad4bea-9bbe-40ad-9117-b0e45ea4d195",
                                                "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                                "text": "In the early 1890s the work in the laboratory consisted of postmortems, urinalyses, and examination of sputums."
                                            },
                                            {
                                                "example_id": "6dfe0b08-3a58-4960-96a7-531c84beb2c2",
                                                "sense_id": "ac2d20bc-b7c5-3e1a-bd07-4bd9753b876d",
                                                "text": "At the U.S. Centers for Disease Control and Prevention in Atlanta, the boy’s sputum sat for a month, waiting for its turn in a slow process of antibody-matching analysis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5aaabf0-c734-420e-992a-34bdff0de223",
                        "source_entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
                        "source_sense_id": "ac6d6227-c002-3ea2-87a9-8796ee15363b",
                        "source_sense_description": "Aussonderung aus den Atemwegen",
                        "target_lang_word": "crachat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crachat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                        "entry_id": "a968e81d-82b5-3d2a-8b13-1ee80a138690",
                                        "glosses": [
                                            "Salive ou pituite ou toute autre mucosité qu’on projette par la bouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a2b16e-90e9-4fef-988a-b3a6b10bbee8",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Crachats muqueux, sanguinolents, etc."
                                            },
                                            {
                                                "example_id": "36ac0c02-c24f-44da-b7a8-f73a90604fe6",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Il se noierait dans son crachat, dans un crachat, se dit d’un homme qui est embarrassé dans les plus petites choses."
                                            },
                                            {
                                                "example_id": "27849c26-9206-49a1-8563-20648c2d60ca",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Ne pas cracher par terre, le crachat se dessèche et le vent emporte les spores dans les poumons des personnes innocentes (schéma). Utiliser des crachoirs, à sable (figure I) ou portatifs (figure II). Ne pas laisser les enfants jouer avec les crachats des gens qu’ils ne connaissent pas."
                                            },
                                            {
                                                "example_id": "36dd8b90-ff83-48e7-9faf-87416e4e000f",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Sur les cinq heures que je passai là-bas, un temps non quantifiable, mais qui me parut considérable, fut consacré par mon hôte à la cérémonie du crachat : deux grands crachoirs jaune d’or reposaient sur des tablettes à droite et à gauche de son fauteuil et, selon que le tempo de la conversation le faisait s’incliner d’un côté ou de l’autre, il expédiait dans un des récipients, avec une précision extrême, le produit de ses expectorations, forme chinoise de la réflexion."
                                            },
                                            {
                                                "example_id": "0415ed69-8b1b-406d-94c5-b5dd27c5b2ef",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Cette maison n’est faite que de boue et de crachat, elle n’est bâtie que de mauvais matériaux."
                                            },
                                            {
                                                "example_id": "914269e0-0485-4643-90ff-d2c699a4fc06",
                                                "sense_id": "5ce2d383-d5f7-3b05-994d-ccdb8cc03a27",
                                                "text": "Crachat de lune, nostoc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e96f0f7-71e2-3ca0-b593-430a6630e38c",
                                        "entry_id": "a968e81d-82b5-3d2a-8b13-1ee80a138690",
                                        "glosses": [
                                            "Salive ou pituite ou toute autre mucosité qu’on projette par la bouche.",
                                            "Marque de mépris ou d'affront."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ec7877-a8c1-4187-8a6c-3bab38351339",
                                                "sense_id": "3e96f0f7-71e2-3ca0-b593-430a6630e38c",
                                                "text": "Si le mot amour et le mot jouissance sont encore dans ta bouche, crie-les, si tu le veux, une dernière fois ; lance vers nous ces crachats avant le suprême silence. Allons, crache !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43488ea3-0791-37fd-befa-6b29eba36cf1",
                                        "entry_id": "a968e81d-82b5-3d2a-8b13-1ee80a138690",
                                        "glosses": [
                                            "Projection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11de5ed5-c14c-4d50-866c-661bd101d3ab",
                                                "sense_id": "43488ea3-0791-37fd-befa-6b29eba36cf1",
                                                "text": "Il allait et venait sur la Durande branlante (…) la face couverte des crachats de la mer."
                                            },
                                            {
                                                "example_id": "513d01f1-c75e-4e16-8814-117c42b1999e",
                                                "sense_id": "43488ea3-0791-37fd-befa-6b29eba36cf1",
                                                "text": "Les crachats rouges de la mitraille\nSifflent tout le jour par l’infini du ciel bleu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af5c217-9a11-32d9-b51a-9223cabcefbd",
                                        "entry_id": "a968e81d-82b5-3d2a-8b13-1ee80a138690",
                                        "glosses": [
                                            "Plaque qui distingue les grades supérieurs dans les ordres de chevalerie."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "792542f3-6b76-4996-aacc-dde5cc0288de",
                                                "sense_id": "1af5c217-9a11-32d9-b51a-9223cabcefbd",
                                                "text": "Il faut la voir dans un salon magnifique, au milieu de vingt diplomates garnis de leurs crachats, croix, rubans."
                                            },
                                            {
                                                "example_id": "24bb2e02-e368-4b65-8b95-8abb8e2b66ef",
                                                "sense_id": "1af5c217-9a11-32d9-b51a-9223cabcefbd",
                                                "text": "Le drap bleu de son habit d’uniforme disparaissait sous les épaulettes, les crachats et le grand cordon rouge de la Légion d’honneur."
                                            },
                                            {
                                                "example_id": "1b460ab5-7684-4252-8281-202103ec02b1",
                                                "sense_id": "1af5c217-9a11-32d9-b51a-9223cabcefbd",
                                                "text": "Valentine Mikhaïlovna était fille d’un général fort médiocre et obscur, qui avait obtenu un seul crachat et la « boucle »"
                                            },
                                            {
                                                "example_id": "1af294f5-e2e6-49cd-8ee4-59e21787b655",
                                                "sense_id": "1af5c217-9a11-32d9-b51a-9223cabcefbd",
                                                "text": "L’entourage, les hommes étoilés de crachats, les femmes aux doigts couverts de diamants et d’énormes turquoises, les intéressent moins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f8fabac-76f3-4615-818a-cd75f5b8f411",
                        "source_entry_id": "6069de40-b5e0-3933-9e90-b8f3e3eee28f",
