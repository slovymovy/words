        "nl-extract.jsonl": [
            {
                "entry_id": "115d879b-c53e-39b3-9b70-dfdd5faca8c5",
                "word": "drive",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a96cda0f-705f-3168-912f-6e88c5f116e2",
                        "entry_id": "115d879b-c53e-39b3-9b70-dfdd5faca8c5",
                        "glosses": [
                            "een voorziening van een supermarkt, restaurant, waar men een op internet opgegeven bestelling op een afgesproken tijdstip en plaats zelf kan ophalen (al dan niet met de auto)"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "aae91ddf-0cd7-4e6e-8ce6-9fe3f3982e82",
                                "sense_id": "a96cda0f-705f-3168-912f-6e88c5f116e2",
                                "text": "Après le « drive » permettant de faire ses courses en ligne puis de venir les chercher en voiture, voici le « drive piéton ». Situés en plein cœur des centres urbains, ces lieux de collecte sont accessibles… à pied.",
                                "translation": "Na de “drive-in” die het mogelijk maakt om op internet boodschappen te doen en vervolgens ze met de auto op te halen, is hier nu de \"voetgangers-drive-in”. Gelegen midden in de stadscentra, zijn deze ophaalplekken toegankelijk, ... te voet."
                            }
                        ]
                    },
                    {
                        "sense_id": "aca390bd-5062-3e11-b94e-093324c7b2cf",
                        "entry_id": "115d879b-c53e-39b3-9b70-dfdd5faca8c5",
                        "glosses": [
                            "een voorziening van een supermarkt, restaurant, waar men de opgegeven bestelling in de auto kan meenemen zonder de parkeerplaats te hoeven verlaten."
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "4db6ca00-dcb6-4c50-8892-fc3807944f33",
                                "sense_id": "aca390bd-5062-3e11-b94e-093324c7b2cf",
                                "text": "Il existait en mai, selon Nielsen, 5 113 sites de drive en France dont « 3 720 sont des click & drive, espaces dédiés au drive (avec des pistes pour les véhicules et des bornes de retrait) créés par les distributeurs.",
                                "translation": "Er waren in mei, volgens Nielsen, 5113 afhaalplekken in Frankrijk, waarvan er 3720 \"bestellen & afhalen\"-plaatsen, die (met aparte rijstroken en terminals) door de distributeuren gecreëerd zijn."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fa15213-22a6-3199-9d3b-e6bce0e56c14",
                        "entry_id": "115d879b-c53e-39b3-9b70-dfdd5faca8c5",
                        "glosses": [
                            "data-opslag via de cloud."
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": []
                    }
                ],
