                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Joch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a953a679-7234-3da9-89ee-82249a8586a6",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "kurz für Jochbein (Teil des Schädelknochens)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cf454f7-336c-4e50-bdbf-3434d68f7f3e",
                                                "sense_id": "a953a679-7234-3da9-89ee-82249a8586a6",
                                                "text": "Mein Arzt erwähnte, dass mein Joch geschädigt sei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "018e823b-ca88-3dd5-a912-685dc858eeca",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "altes Flächenmaß (gemessen an der Fläche, die man an einem Tag mit einem Joch Ochsen umpflügen kann)"
                                        ],
                                        "tags": [
                                            "Plural unverändert"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de817b9c-0f61-4161-81a0-02ca369f428b",
                                                "sense_id": "018e823b-ca88-3dd5-a912-685dc858eeca",
                                                "text": "Ein Joch entspricht zwischen 0,33 Hektar (Württemberg) und 0,58 Hektar (Österreich)."
                                            },
                                            {
                                                "example_id": "900349ee-7d0c-475d-a6c1-5ff306148c81",
                                                "sense_id": "018e823b-ca88-3dd5-a912-685dc858eeca",
                                                "text": "„Burcuş hatte im ersten Jahr versucht, ein paar hundert Joch zu verpachten, was ihm aber mißlang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "85e91c67-0cc6-3859-8cfb-807bd44959f7",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "durch vier Stützen gebildete räumliche Einheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef541ea-b0d7-4ca0-ba89-18b37abc0432",
                                                "sense_id": "85e91c67-0cc6-3859-8cfb-807bd44959f7",
                                                "text": "Auf Höhe des achten Jochs des Längsschiffes der Kirche liegt im linken Seitenschiff die Barbara-Kapelle, im rechten die Gruft mit den Gebeinen des Stifters."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f432081f-00da-3739-b038-57a10033f9d6",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "Bereich zwischen zwei Brückenpfeilern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdf54c7-a096-432d-b265-0c224728832e",
                                                "sense_id": "f432081f-00da-3739-b038-57a10033f9d6",
                                                "text": "Die Brücke spannt sich in sechs Jochen über den Fluss."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "91f1870e-7149-3d84-b171-753bec8472e5",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "Senke im Gebirgsprofil, die einen Gipfel vom nächsten oder zwei Bergstöcke voneinander trennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dec61de-51be-4fea-8835-974a6bed5aca",
                                                "sense_id": "91f1870e-7149-3d84-b171-753bec8472e5",
                                                "text": "Das Stilfser Joch verbindet das Veltlin mit dem Vinschgau."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "4f20cd6b-e42e-3cb4-a4ed-1699dfd414c5",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "schweres Geschirr-Teil, das man Ochsen, Kühen und anderen Zugtieren auflegt, und mit dem sie die Last ziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "817afcc9-089a-4b57-a993-7f0bcc949db6",
                                                "sense_id": "4f20cd6b-e42e-3cb4-a4ed-1699dfd414c5",
                                                "text": "Wie die beiden Ochsen mühselig den Karren hochzogen, schwankte ihr Joch wie eine Welle auf und ab."
                                            },
                                            {
                                                "example_id": "9eee1d5d-dfe8-455f-939c-1e1a19bd144c",
                                                "sense_id": "4f20cd6b-e42e-3cb4-a4ed-1699dfd414c5",
                                                "text": "„Aber einer der Ochsen hat das Joch zwischen die Hörner bekommen und muß mit verrenktem Halse und seitwärts gebogen gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "bab27f16-b990-3311-8557-458ec7ca73d3",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "schwere Arbeit, Last, Knechtschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e539d9c0-8c17-410a-8f97-da76160f5a78",
                                                "sense_id": "bab27f16-b990-3311-8557-458ec7ca73d3",
                                                "text": "Für dich mag Arbeit Erfüllung sein, mir ist sie ein Joch."
                                            },
                                            {
                                                "example_id": "4f149497-f306-49ff-8f34-d6faf0789902",
                                                "sense_id": "bab27f16-b990-3311-8557-458ec7ca73d3",
                                                "text": "„Schon zweihundert Jahre vor Christi Geburt hatten andere Propheten verkündet, der versprochene Messias werde der Erlöser der ganzen Welt sein. Er werde nicht nur die Israeliten vom fremden Joch befreien, sondern alle Menschen von Sünde und Schuld erlösen — und nicht zuletzt vom Tod.“"
                                            },
                                            {
                                                "example_id": "87d69c9d-9953-4752-b222-28b3fe525453",
                                                "sense_id": "bab27f16-b990-3311-8557-458ec7ca73d3",
                                                "text": "„Er spricht über das Leid der Schwarzen unter dem Joch der belgischen Kolonialherren, spricht von Rassenhass, Zwangsarbeit und Verfolgungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "7056a6b7-adad-32f0-9b90-85df6de3ce02",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "Tragegestell für Eimer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cb8a62-9e24-44f2-b817-b7eacb765645",
                                                "sense_id": "7056a6b7-adad-32f0-9b90-85df6de3ce02",
                                                "text": "Hinten in der Scheune steht doch noch ein altes Joch - oder liegt es etwa?"
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "123aa94d-4a11-3121-8ea4-cdfe06c95ff4",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "Tragbalken (zum Beispiel für Glocken)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e75dd719-f94c-4cf3-b5ad-4da56bf0d8b0",
                                                "sense_id": "123aa94d-4a11-3121-8ea4-cdfe06c95ff4",
                                                "text": "Das Joch muss unbedingt erneuert werden, sonst wird bald die Glocke den Turm hinunter bis in den Chor stürzen."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "8b13ee24-64a4-3eae-8309-0a52e41ccdbe",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "ein Paar Zugtiere, unter einem Joch eingespannt; Zählmaß für die verfügbaren Zugtiere"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5173e2ec-a0fb-4344-8951-600b2f357440",
                                                "sense_id": "8b13ee24-64a4-3eae-8309-0a52e41ccdbe",
                                                "text": "Ein Bauer gilt in dieser Gegend als reich, sobald er drei Joch Ochsen sein eigen nennen kann."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "f7ccf66b-7df0-3a7d-9c34-23134dc842f0",
                                        "entry_id": "d6ff09d1-dfb8-34c2-954e-b6401dfb4e74",
                                        "glosses": [
                                            "Pfeiler einer Jochbrücke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "794dc65a-09a4-4b7c-ae58-291b0bc9c918",
                                                "sense_id": "f7ccf66b-7df0-3a7d-9c34-23134dc842f0",
                                                "text": "Die Brücke führte über sieben eicherne Joche."
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b597921-0d7d-480f-a2ef-2992d954dfe4",
                        "source_entry_id": "2ee60b7f-95d7-3c62-8c12-1a9cbfb2093f",
                        "source_sense_id": "a7346d5b-79f5-3e5c-ba87-81f8dcaf43f7",
                        "target_lang_word": "коромысло",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коромысло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                        "entry_id": "74a80466-3f31-3fd3-a6e2-55d6bf999a97",
                                        "glosses": [
                                            "приспособление для ручного ношения двух вёдер или других грузов в виде опираемого на плечи изогнутого шеста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7796cab-7e2d-4cd7-a515-1ef3b0102b9f",
                                                "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                                "text": "Та ли это Феклуша, которая в набойчатом платье выходила ко мне на огород или изгибалась под коромыслом?"
                                            },
                                            {
                                                "example_id": "faee5c41-e76a-4968-81ea-34abd526a5ca",
                                                "sense_id": "a2bfd771-891a-309a-919a-a91f001d6bdd",
                                                "text": "А я с китайскими коллегами неделю таскал на коромысле корзины с землей, помогая строить близ Пекина Шисаньлинское водохранилище."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5d1f2b-8d5e-334c-b681-d1ff38054b04",
                                        "entry_id": "74a80466-3f31-3fd3-a6e2-55d6bf999a97",
                                        "glosses": [
                                            "техн. деталь рычажного механизма (напр. у весов)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854b2497-aa99-480f-a3eb-43e21d486719",
                                                "sense_id": "6e5d1f2b-8d5e-334c-b681-d1ff38054b04",
                                                "text": "Мы уже заметили, как важно было определить с достаточной точностью положение поршневого стержня относительно коромысла, или, что сводится к тому же, углы параллелограма в его среднем положении."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "коромысло",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11bd94d1-ca1c-3bf5-a30e-5eeaf67e5d86",
                                        "entry_id": "03edc40b-9c1a-395e-9a67-616b94a886f1",
                                        "glosses": [
                                            "зоол., мн. ч. собир. семейство крупных стрекоз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab17783-b057-4bb4-b661-3a30abe34e3b",
                                                "sense_id": "11bd94d1-ca1c-3bf5-a30e-5eeaf67e5d86",
                                                "text": "Совсем иначе выглядят в полёте разнокрылые стрекозы, например крупные коромысла."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cb43d0-d4a8-31e6-a9df-949a61fe9a0e",
                                        "entry_id": "03edc40b-9c1a-395e-9a67-616b94a886f1",
                                        "glosses": [
                                            "представитель одного из видов данного семейства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae26b67f-4b39-4ae8-b48a-a5b73e781554",
                                                "sense_id": "18cb43d0-d4a8-31e6-a9df-949a61fe9a0e",
                                                "text": "Перед моими глазами грозные Коромысла хватали безобидных Толкунчиков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
