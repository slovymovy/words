                        "examples": [
                            {
                                "example_id": "8de47d60-62d4-480e-84f0-e6bc49f0dbd2",
                                "sense_id": "59cfa495-9505-3137-aa69-af99caa78e10",
                                "text": "„Die Steinkohlengruben haben seit Jahren die Vorteile der mechanischen Abbauförderung erkannt und sind zu ihr übergegangen.“"
                            },
                            {
                                "example_id": "d18b71f5-94e9-42f9-a387-70b4e8af6ca2",
                                "sense_id": "59cfa495-9505-3137-aa69-af99caa78e10",
                                "text": "„Auch die Abbauförderung, die Schienenbefestigung bei der Streckenförderung, die Lokomotivförderung, die Abschnitte ‚Fangvorrichtungen‘, ‚Wasserhaltung‘ und ‚Atmungsgeräte‘ sind eingehend durchgearbeitet worden.“"
                            }
