                                        "glosses": [
                                            "A non-sibilant fricative."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b15dcf4f-3eb1-456c-b8e6-04e3d77a7755",
                                                "sense_id": "735ca501-b371-32de-8281-f7629ee3945c",
                                                "text": "Spirant consonants are those in which the mouth passage is simply narrowed without any actual contact."
                                            },
                                            {
                                                "example_id": "4ace6daa-53f5-482e-93ef-ed53369290c7",
                                                "sense_id": "735ca501-b371-32de-8281-f7629ee3945c",
                                                "text": "The raising of the stem indicated the opening of the consonant to a ‘spirant’ […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
