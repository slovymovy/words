    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6103bd9-84f6-3c72-9b6c-2843aabad167",
                    "sense_definition": "Верхняя часть чего-либо, вершина.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ветер сильно качал <w>верхушки</w> высоких сосен.",
                            "target_lang_translations": {
                                "pl": "Wiatr mocno kołysał <w>wierzchołkami</w> wysokich sosen."
                            }
                        },
                        {
                            "text": "Птица села на самую <w>верхушку</w> дерева и начала громко петь.",
                            "target_lang_translations": {
                                "pl": "Ptak usiadł na samym <w>wierzchołku</w> drzewa i zaczął głośno śpiewać."
                            }
                        }
                    ],
                    "synonyms": [
                        "вершина"
                    ],
                    "antonyms": [
                        "низ"
                    ],
                    "common_phrases": [
                        "верхушка дерева",
                        "верхушка сосны"
                    ],
                    "target_lang_definitions": {
                        "pl": "Najwyższa część czegoś, szczyt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wierzchołek",
                                "target_lang_sense_clarification": "najbardziej wysunięty punkt czegoś, np. drzewa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9485b1e2-35c7-3431-aa64-62eab0a6fbd1",
                    "sense_definition": "Группа людей, занимающих высшее, начальственное положение в обществе или организации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Политическая <w>верхушка</w> страны собралась на экстренное совещание в центре города.",
                            "target_lang_translations": {
                                "pl": "Polityczna <w>wierchuszka</w> kraju zebrała się na nadzwyczajną naradę w centrum miasta."
                            }
                        },
                        {
                            "text": "Только самая <w>верхушка</w> общества могла позволить себе такие роскошные дома.",
                            "target_lang_translations": {
                                "pl": "Tylko sama <w>góra</w> społeczeństwa mogła pozwolić sobie na tak luksusowe domy."
                            }
                        }
                    ],
                    "synonyms": [
                        "элита",
                        "верхи"
                    ],
                    "antonyms": [
                        "низы"
                    ],
                    "common_phrases": [
                        "политическая верхушка",
                        "общественная верхушка"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в переносном значении"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Grupa osób sprawujących władzę lub zajmujących najwyższe stanowiska w organizacji lub społeczeństwie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wierchuszka",
                                "target_lang_sense_clarification": "potoczne określenie grupy sprawującej władzę"
                            },
                            {
                                "target_lang_word": "góra",
                                "target_lang_sense_clarification": "potoczne określenie władz instytucji lub firmy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}