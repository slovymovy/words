                                    {
                                        "sense_id": "b85a1e0b-0584-3cae-b8a0-30f3ca656036",
                                        "entry_id": "d1cab62c-d2c2-32b9-89bc-de5607c7afc9",
                                        "glosses": [
                                            "An emptiness in life created by a loss of a person who was close, or of an occupation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c14790-32bb-48b1-a5fe-e73e18590800",
                                                "sense_id": "b85a1e0b-0584-3cae-b8a0-30f3ca656036",
                                                "text": "Henrietta soon found a terrible vacuum left, by the letters in which she used to pour forth every feeling and thought to her uncle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0c8fe3-1582-3688-8d7e-fc512ac1aee1",
                                        "entry_id": "d1cab62c-d2c2-32b9-89bc-de5607c7afc9",
                                        "glosses": [
                                            "An exercise in which one draws their abdomen towards the spine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8864e2f-f6a1-4251-83d0-0920dcb174cc",
                                                "sense_id": "ea0c8fe3-1582-3688-8d7e-fc512ac1aee1",
                                                "text": "Abs show up in a most-muscular shot, a vacuum shot, the hands-behind-head compulsory ab shot, twisting poses, and so on."
                                            },
                                            {
                                                "example_id": "69485a26-c8aa-4d88-b693-b68104987c71",
                                                "sense_id": "ea0c8fe3-1582-3688-8d7e-fc512ac1aee1",
                                                "text": "Right I'm off to practice my vacuum - suck in those stomachs now!"
                                            },
                                            {
                                                "example_id": "3fbbba42-b604-48c6-8bb2-f91fce445bcd",
                                                "sense_id": "ea0c8fe3-1582-3688-8d7e-fc512ac1aee1",
                                                "text": "When I do the 'gut vacuum' exercise the abdominal wall seems to return to normal size, as far as I can tell under the flab."
                                            },
                                            {
                                                "example_id": "680766b4-83ac-447d-8abc-1ebd8f05e006",
                                                "sense_id": "ea0c8fe3-1582-3688-8d7e-fc512ac1aee1",
                                                "text": "Blessed with round muscle bellies and a phenomenal structure, he also performed a vacuum pose on stage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vacuum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d232206-3a2b-33d0-be81-fac62c9cd8dc",
                                        "entry_id": "8cc480bc-f7ea-3bf5-a794-490272225e2d",
                                        "glosses": [
                                            "To clean (something) with a vacuum cleaner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c224125-34e8-46c9-bc0f-3ead83e5f773",
                                                "sense_id": "7d232206-3a2b-33d0-be81-fac62c9cd8dc",
                                                "text": "“Who in the world cleans an attic? That's like vacuuming a shed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "817f9fdd-d8f1-3cad-a802-a2407de7c84a",
                                        "entry_id": "8cc480bc-f7ea-3bf5-a794-490272225e2d",
                                        "glosses": [
                                            "To use a vacuum cleaner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4826056-11b7-3bf1-8a0a-a0f1d25512ca",
                                        "entry_id": "8cc480bc-f7ea-3bf5-a794-490272225e2d",
                                        "glosses": [
                                            "To optimise a database or database table by physically removing deleted tuples."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69ee6eb-9ad1-4b68-8d4e-96df89d79847",
                                                "sense_id": "a4826056-11b7-3bf1-8a0a-a0f1d25512ca",
                                                "text": "But the advantage of an auto-vacuumed database is that when B-tree pages are no longer needed, they are moved to the end of the database file and then the database file is truncated, thus returning the unused pages back to the filesystem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
