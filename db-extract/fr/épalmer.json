                "senses": [
                    {
                        "sense_id": "72ad4825-eb2b-3cb4-9818-a902c9f27495",
                        "entry_id": "23f1f92e-4ebf-3d5d-9680-57fdab86fea8",
                        "glosses": [
                            "Variante de espalmer."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "25bc4824-cd5d-4893-9720-73e0a2b09d3d",
                                "sense_id": "72ad4825-eb2b-3cb4-9818-a902c9f27495",
                                "text": "On dit qu’on épalme les vaisseaux, quand on les enduit de suif ou de gaudron, pour les rendre impénétrables a l'eau."
                            },
                            {
                                "example_id": "613f7436-456b-46f2-9809-e7adcdbb83cb",
                                "sense_id": "72ad4825-eb2b-3cb4-9818-a902c9f27495",
                                "text": "Ce procédé surprit tellement Monsieur le général, joint à ce que l’on s’aperçut qu’il ne faisoit ni épalmer ses galères ni les charger de victuailles, qu’il crut qu’il le vouloit obliger à rester plus longtemps à Standia."
                            }
                        ]
                    }
