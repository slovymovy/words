                "senses": [
                    {
                        "sense_id": "37bff757-8df0-3770-8898-0f0cb4d6610c",
                        "entry_id": "8fe292ca-c6a5-314e-aad4-12fa88fe040b",
                        "glosses": [
                            "Weichgewebskern des Zahnes, der sich im Zahninneren, dem Pulpencavum und den Wurzelkanälen befindet und der aus Bindegewebe mit Blut- und Lymphgefäßen sowie Nervenfasern besteht"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "7f26177b-71b5-4242-ba26-812d9e2bdbe9",
                                "sense_id": "37bff757-8df0-3770-8898-0f0cb4d6610c",
                                "text": "Ist das Zahnmark durch Karies eröffnet, dann verursacht der Zahn Zahnschmerzen."
                            },
                            {
                                "example_id": "8a23e85f-0b3f-463e-9753-f6b63a6019d0",
                                "sense_id": "37bff757-8df0-3770-8898-0f0cb4d6610c",
                                "text": "„Außen liegt der Zahnschmelz, darunter das Zahnbein, im Inneren das Zahnmark, auch Pulpa genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
