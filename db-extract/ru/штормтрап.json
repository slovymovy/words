                    {
                        "translation_id": "b1edece3-19cb-478e-a609-65a531bf6570",
                        "source_entry_id": "57f6cf33-3ac0-38fe-a807-39826a813b85",
                        "source_sense_id": "dd0693c1-7507-3fe5-b609-64ca084737cb",
                        "target_lang_word": "Jakobsleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jakobsleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb3ceb11-30b1-30a2-afcd-886a66427f84",
                                        "entry_id": "85a2fb13-47c6-3371-9edc-aff797853140",
                                        "glosses": [
                                            "die dem alttestamentarischen Patriarchen Jakob im Traum erschienene Himmelsleiter nach Genesis 28.12"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef6e932c-92b9-403c-b6c9-5f5eee44d25a",
                                                "sense_id": "fb3ceb11-30b1-30a2-afcd-886a66427f84",
                                                "text": "„Die Jakobsleiter […] ist als Treppe aus Steinen gedacht […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1520bd0f-8f13-31a6-9c86-4814fca42fc4",
                                        "entry_id": "85a2fb13-47c6-3371-9edc-aff797853140",
                                        "glosses": [
                                            "eine Leiter aus Tauwerk mit hölzernen Sprossen"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc60cb77-bfa2-43b4-935f-9b2d1f0b1c17",
                                                "sense_id": "1520bd0f-8f13-31a6-9c86-4814fca42fc4",
                                                "text": "Der Matrose kletterte die Jakobsleiter hinauf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c7d4f378-0ca4-3667-9b38-577845d0743d",
                                        "entry_id": "85a2fb13-47c6-3371-9edc-aff797853140",
                                        "glosses": [
                                            "eine Gattung (Polemonium) aus der Familie der Sperrkrautgewächse (Polemoniaceae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433231cb-6ff8-49df-93b2-dfde0424c612",
                                                "sense_id": "c7d4f378-0ca4-3667-9b38-577845d0743d",
                                                "text": "Die Blätter der Jakobsleiter sind leiterartig gefiedert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee0ed26e-dff5-4b0e-9dff-626e987524f5",
                        "source_entry_id": "57f6cf33-3ac0-38fe-a807-39826a813b85",
                        "source_sense_id": "dd0693c1-7507-3fe5-b609-64ca084737cb",
                        "target_lang_word": "Strickleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Strickleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                        "entry_id": "6bfa356d-ba59-3d80-96e5-adb83c3271ad",
                                        "glosses": [
                                            "eine Leiter, deren Holme aus Stricken (Seilen) bestehen; sie kann leicht transportiert und platzsparend gelagert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90f45d8-ce4d-4dcf-aee3-6cbf13305932",
                                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                                "text": "Mein Baumhaus ist nur über eine Strickleiter zu erreichen."
                                            },
                                            {
                                                "example_id": "377ff7aa-8606-4440-a939-ac0fb5783c08",
                                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                                "text": "„Sie mussten mit ihren Habseligkeiten eine vier Meter hohe Strickleiter erklimmen, die mittschiffs zu einer Pforte im Schanzkleid führte.“"
                                            },
                                            {
                                                "example_id": "07262e21-764b-44cb-8fd7-dac907f17cb8",
                                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                                "text": "„Als Durands Beiboot längsseits ging, ließ man von der Pontchartrain eine Strickleiter herab, sodass er an Deck klettern konnte.“"
                                            },
                                            {
                                                "example_id": "752c94bc-99dd-43ba-882a-877146c38022",
                                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
                                                "text": "„Er entdeckte eine hinabhängende Strickleiter, die, wie er tastend feststellte, aus geflochtenem Leder bestand, und fand an der Felswand kräftige Mauergriffe.“"
                                            },
                                            {
                                                "example_id": "4c5e91f5-467d-4fa4-893f-b6396e30d5f8",
                                                "sense_id": "f5812d98-e94e-3f09-a6b6-ecc38e25701c",
