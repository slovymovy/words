                                    {
                                        "sense_id": "d4add58d-e27a-31d6-90bc-ddc3170117bd",
                                        "entry_id": "d6e597bc-a582-3650-9d1f-14e4bb52023f",
                                        "glosses": [
                                            "chlév pro ovce"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d7b5b10-6dd4-41ef-9174-e23555171cf5",
                                                "sense_id": "d4add58d-e27a-31d6-90bc-ddc3170117bd",
                                                "text": "V místech, kde se vyskytují přirození predátoři, jako vlci nebo zdivočelí psi, je samozřejmě dobré zbudovat ovčín a ovce do něj na noc zavírat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04bae0e5-b24c-40a8-9c0a-204674055cd9",
                        "source_entry_id": "b9170d56-0901-30c4-a73b-9e2fe58b11eb",
                        "source_sense_description": "enclosure",
                        "target_lang_word": "schapenstal",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schapenstal",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "da7f35a4-a812-3406-9498-0013660e4fbd",
                                        "entry_id": "2745d29a-c1ac-3f1e-b64d-e243b3a4d868",
                                        "glosses": [
                                            "verblijf voor schapen Ovis aries die als kleinvee worden gehouden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6583e452-b507-4325-8740-7d113ec2d430",
                                                "sense_id": "da7f35a4-a812-3406-9498-0013660e4fbd",
                                                "text": "Die heidevelden werden kortgehouden door schapen, die ’s nachts op stal stonden. De schapenstallen werden bedekt met heideplaggen, die met de schapenpoep een vruchtbaar mestmengsel vormden voor op de akkers."
                                            },
                                            {
                                                "example_id": "872b1216-31df-4fa4-bf8e-bfd72c3ad4ba",
                                                "sense_id": "da7f35a4-a812-3406-9498-0013660e4fbd",
                                                "text": "Echt lamsvlees, dat wil zeggen vlees van lammeren die niet ouder zijn dan pakweg acht, negen maanden, is juist erg mager en ruikt in de verste verte niet naar schapenstal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1dcd5d32-9bf0-447d-b082-6f4bef91ccff",
                        "source_entry_id": "b9170d56-0901-30c4-a73b-9e2fe58b11eb",
                        "source_sense_description": "enclosure",
                        "target_lang_word": "schaapskooi",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schaapskooi",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "28d96d6c-ff9b-3dbd-8882-de5b8770662a",
                                        "entry_id": "c93c460f-f0d1-3a9f-9c0d-cf65e1bb3eef",
                                        "glosses": [
                                            "een potstal voor schapen die dient als onderkomen voor de schapen maar ook voor het verzamelen van mest voor het vruchtbaar maken van de heide"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e419bbc-34f4-409d-af78-3fb03fe13fdd",
                                                "sense_id": "28d96d6c-ff9b-3dbd-8882-de5b8770662a",
                                                "text": "Van Alphen was als beginnend schaapherder dertig jaar geleden al aanwezig in Lillo. Ook toen trok hij vaak met zijn kudde en vergezeld van een hond over de dijken. 's Avonds werden de dieren ondergebracht in een schaapskooi. Schapen zijn uitstekende grazers. Zij maaien het gras, maar maken het niet kapot. De dieren vertrappelen ook de molshopen, die anders bij hoog water grote gaten kunnen vormen. Bovendien bemesten ze met hun uitwerpselen de vegetatie."
                                            },
                                            {
                                                "example_id": "b5c3258c-eb3d-4243-aada-593a106000dd",
                                                "sense_id": "28d96d6c-ff9b-3dbd-8882-de5b8770662a",
                                                "text": "Onlangs zette Mark Ros de holle boor in de eiken gebinten van de schaapskooi aan de Zendvelderweg in Buurse. Vermoedelijk achttiende-eeuws."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85fe84c4-ae61-476c-994d-83f855a0653a",
                        "source_entry_id": "b9170d56-0901-30c4-a73b-9e2fe58b11eb",
                        "source_sense_description": "enclosure",
                        "target_lang_word": "bergerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "128bb88d-81c3-3c1a-9faf-953d7428e940",
                                        "entry_id": "96ca4752-1274-31fc-b80e-626b86209998",
                                        "glosses": [
                                            "Lieu où l’on enferme un troupeau de moutons, de brebis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a034ab5-6df7-433c-a80f-eba924e36212",
                                                "sense_id": "128bb88d-81c3-3c1a-9faf-953d7428e940",
                                                "text": "Sous le ciel pâlissant, les bâtiments de la Borderie sommeillaient encore, à demi sombres, trois longs bâtiments aux trois bords de la vaste cour carrée, la bergerie au fond, les granges à droite, la vacherie, l’écurie et la maison d’habitation à gauche."
                                            },
                                            {
                                                "example_id": "ed882f0b-aaae-4b63-9426-15e58158a081",
                                                "sense_id": "128bb88d-81c3-3c1a-9faf-953d7428e940",
                                                "text": "La bergerie était longue, la grange était haute."
                                            },
                                            {
                                                "example_id": "aa1c7189-5acf-43ab-abfb-ac96cbf7f135",
                                                "sense_id": "128bb88d-81c3-3c1a-9faf-953d7428e940",
                                                "text": "D’où le surnom de Jonah Lomu des bergeries, en référence au mythique rugbyman des All Blacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73b398ec-f818-35f9-99f1-05868ea12482",
                                        "entry_id": "96ca4752-1274-31fc-b80e-626b86209998",
                                        "glosses": [
                                            "Poème ou récit bucolique mettant en scène les amours des bergers et des bergères."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097b906b-e88d-4d99-bf60-f178240153df",
                                                "sense_id": "73b398ec-f818-35f9-99f1-05868ea12482",
                                                "text": "[L’auteur] a laissé railler ses bergeries comme il avait laissé railler tout le reste, sans s’inquiéter des arrêts de certaine critique."
                                            },
                                            {
                                                "example_id": "9f145a29-817a-4c3f-8a2f-89ae95ac6ec5",
                                                "sense_id": "73b398ec-f818-35f9-99f1-05868ea12482",
                                                "text": "Au point où l’Île-de-France, le Valois et la Picardie se rencontrent, —divisés par l’Oise et l’Aisne, au cours si lent et si paisible, il est permis de rêver les plus belles bergeries du monde."
                                            },
                                            {
                                                "example_id": "e6b3a6f3-9a43-4349-aafe-0777511ceef4",
                                                "sense_id": "73b398ec-f818-35f9-99f1-05868ea12482",
                                                "text": "Et, rêveuse, câline, elle revenait à ses bergeries, à ses petits sentiers de verdure, au calme de l’existence douce et cachée, avec des fleurs, des bêtes, et de l’amour…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a681b975-0e0f-490c-80de-31e0789a4e3b",
                        "source_entry_id": "b9170d56-0901-30c4-a73b-9e2fe58b11eb",
                        "source_sense_description": "enclosure",
                        "target_lang_word": "Schafstall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schafstall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22dfdfef-2af7-38fe-b52c-cdff3ca6c662",
                                        "entry_id": "4a480e84-67e0-3ccd-b1fb-eeede9122f46",
                                        "glosses": [
                                            "Gebäude, das der Unterbringung von Schafen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45b66259-5051-4f97-a9b1-f1048aa7bdef",
                                                "sense_id": "22dfdfef-2af7-38fe-b52c-cdff3ca6c662",
                                                "text": "Die Schafe verkrochen sich im Schafstall."
                                            },
                                            {
                                                "example_id": "08c5446a-e29b-4052-9a11-eca59f67d0bc",
                                                "sense_id": "22dfdfef-2af7-38fe-b52c-cdff3ca6c662",
                                                "text": "„Unweit des Hauses standen Schafställe, aber die eingezäunte Fläche stand leer.“"
                                            },
                                            {
                                                "example_id": "92ec7a4d-a73f-492b-82e2-c491fae0de7a",
                                                "sense_id": "22dfdfef-2af7-38fe-b52c-cdff3ca6c662",
                                                "text": "„Es kam gar nicht so selten vor, dass ich im Winter nur in den Schafstall gegangen bin, um ihnen beim Wiederkäuen und Stöhnen zuzuhören und dem Rütteln des Windes am Wellblech.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6179731-4425-4efc-bb1a-f54ab7a62ca7",
