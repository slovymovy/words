                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6df4c9e0-9413-3222-8bc8-4fa1f22a180a",
                                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                                        "glosses": [
                                            "A feeling of identity and loyalty to one's tribe."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf28b571-7dbf-355f-8e94-43bbceb342f2",
                                        "entry_id": "745c07bf-9811-36aa-82c8-c81612235a43",
                                        "glosses": [
                                            "The tendency among human beings to form socially cohesive groups within which there exists social pressure upon the individual to conform to either common behaviors, customs, habits, mores and/or norms, and which groups exhibit greater or lesser degrees of exclusivism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67dc74c3-be8b-4859-bf3b-703216f8c687",
                                                "sense_id": "cf28b571-7dbf-355f-8e94-43bbceb342f2",
                                                "text": "If we put an end to regionalism and normalize the flow of great energies in the body of Kyrgyzstan, then there will be a very rapid healing of the whole country and people, who have been vegetating in a semi-paralyzed state for many decades due to the grave illness of tribalism and regionalism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
