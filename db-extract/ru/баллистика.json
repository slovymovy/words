                    {
                        "translation_id": "5f365d65-ff1d-476a-94df-fdcfd0976fd4",
                        "source_entry_id": "fe542608-9953-3e48-a8a4-9f43ee5fc1a0",
                        "source_sense_id": "98ddfa95-e8d6-3211-b20f-7a48773c9db7",
                        "target_lang_word": "balistique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1584b4f8-0b6b-3f9d-a408-08418d6083bf",
                                        "entry_id": "8d70e8f1-d701-32e0-bccb-10860bca94d6",
                                        "glosses": [
                                            "Qui concerne les projectiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcdb4166-b9fc-41ee-9771-9830e24a1fae",
                                                "sense_id": "1584b4f8-0b6b-3f9d-a408-08418d6083bf",
                                                "text": "Les militaires se vantent maintenant d’avoir forgé le moteur de missile balistique « le plus puissant » et, selon Jake Sullivan, le conseiller à la Sécurité nationale du président Biden, leur soutien aux activités terroristes au Moyen-Orient, « loin de s’atténuer, s’est accéléré dans certains domaines »."
                                            },
                                            {
                                                "example_id": "54e8adff-c3be-4cfd-abbf-7bea9beb7c26",
                                                "sense_id": "1584b4f8-0b6b-3f9d-a408-08418d6083bf",
                                                "text": "\"L'opération a été menée avec un missile balistique et 15 drones\", a affirmé le porte-parole des Houthis, Yahya al-Saree, cité par la chaîne rebelle Al-Massirah à Sanaa."
                                            },
                                            {
                                                "example_id": "9662940a-67d7-4d83-94af-5632873cb8e9",
                                                "sense_id": "1584b4f8-0b6b-3f9d-a408-08418d6083bf",
                                                "text": "Pendule balistique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaac1645-ed76-3999-a40f-7c99f4268fc2",
                                        "entry_id": "8d70e8f1-d701-32e0-bccb-10860bca94d6",
                                        "glosses": [
                                            "Qui mesure la vitesse et la force d’expansion des projectiles des fusils, des canons, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc2b7e2-4ac3-4e06-9c8c-5476c776f61c",
                                                "sense_id": "aaac1645-ed76-3999-a40f-7c99f4268fc2",
                                                "text": "Théorie balistique, Science balistique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "balistique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "151bff12-7188-3d87-b16d-e5385406c7f9",
                                        "entry_id": "0046ac2f-6761-3eff-b341-d64b70c64d5a",
                                        "glosses": [
                                            "Science qui s’occupe de la force d’expansion et de la vitesse des projectiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da5969e8-4237-4450-879f-3ae75ea07dc8",
                                                "sense_id": "151bff12-7188-3d87-b16d-e5385406c7f9",
                                                "text": "Traité de balistique."
                                            },
                                            {
                                                "example_id": "511060e3-91ad-4666-9377-8561c9318022",
                                                "sense_id": "151bff12-7188-3d87-b16d-e5385406c7f9",
                                                "text": "Cours de balistique."
                                            },
                                            {
                                                "example_id": "f7570703-71ff-48c5-bf60-f6f1aa5e9d0c",
                                                "sense_id": "151bff12-7188-3d87-b16d-e5385406c7f9",
                                                "text": "— Monsieur le ministre, je me suis empressé d’accourir, dès que j’ai su que vous étiez là… Précisément… je ne dormais pas… j’étais debout… je veillais… Je poursuis des études de balistique…"
                                            },
                                            {
                                                "example_id": "c49c4753-53fc-4dc1-bf46-fc2878aab715",
                                                "sense_id": "151bff12-7188-3d87-b16d-e5385406c7f9",
                                                "text": "Viscéralement opposé, par son vécu, aux totalitarismes, il participe activement au projet Manhattan en appliquant toute sa puissance mathématique à des contributions appliquées portant sur la statistique, l’analyse numérique, l’hydrodynamique, la détonique, les ordinateur, la météorologie, la balistique…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfc955d-da51-34cd-b2d5-5ee52491b3c2",
                                        "entry_id": "0046ac2f-6761-3eff-b341-d64b70c64d5a",
                                        "glosses": [
                                            "Techniques permettant lors d’enquêtes judiciaires, d’identifier l’arme qui a tiré un projectile donné."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "390d4ac3-c889-4975-8abc-2cefbfb8a8a0",
                                                "sense_id": "fdfc955d-da51-34cd-b2d5-5ee52491b3c2",
                                                "text": "Un expert en balistique était également attendu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
