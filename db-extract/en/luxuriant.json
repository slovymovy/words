                                "target_senses": [
                                    {
                                        "sense_id": "f76b924f-1f82-3116-9654-96f5d6323191",
                                        "entry_id": "5670a128-3a06-3cd5-b52e-5b5c9f438320",
                                        "glosses": [
                                            "uitbundig (groeiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3e4c4a6-5a57-44f2-ac0c-a411fb0ebad1",
                                                "sense_id": "f76b924f-1f82-3116-9654-96f5d6323191",
                                                "text": "We zaten een paar minuten zwijgend naast elkaar te roken op de trappen naar de weelderige entree van het ooit grandioze hotel waar ik van plan was mij voorlopig te vestigen, toen hij het woord tot mij richtte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "422bb1f0-3229-3965-b777-6093db607bb5",
                                        "entry_id": "5670a128-3a06-3cd5-b52e-5b5c9f438320",
                                        "glosses": [
                                            "van een persoon dat deze behoorlijk dik is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00057b9a-4320-4d56-a5a6-9f7ef42c9e15",
                                                "sense_id": "422bb1f0-3229-3965-b777-6093db607bb5",
                                                "text": "Het leek alsof de stevige en weelderige serveerster de vraag had begrepen, want ze sloop op haar tenen rond de tafel en ruimde stilletjes de lege bierglazen af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
