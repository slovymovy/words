                "senses": [
                    {
                        "sense_id": "3137f115-4190-3508-9d08-5c7fa4717ee7",
                        "entry_id": "a404d842-c61d-36c4-8f51-a082b7c7e6ec",
                        "glosses": [
                            "Sorte de piano à queue posé verticalement et accompagné d'un mécanisme qui se meut au moyen du pied."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca98d62a-8dc5-46d6-b42b-94f92ebe85b8",
                                "sense_id": "3137f115-4190-3508-9d08-5c7fa4717ee7",
                                "text": "Le célèbre compositeur et pianiste Litolff, en ce moment à Bruxelles, se passionna pour l’harmonicorde, et déclara qu'il le considérait comme destiné à produire dans l'orchestre d'heureux effets qu'aucune combinaison d'instruments ne pouvait réaliser."
                            },
                            {
                                "example_id": "e9cb54a9-f736-4dad-95c4-eefa837ceb16",
                                "sense_id": "3137f115-4190-3508-9d08-5c7fa4717ee7",
                                "text": "L’harmonicorde de Debain, sur lequel Lefébure-Wely excellait, était un harmonium pourvu de cordes tendues qui pouvaient être, ou non, frappées pour donner plus de netteté à l'attaque."
                            }
                        ]
                    }
                ],
