                                        "glosses": [
                                            "Personne à laquelle l’on est particulièrement attaché sentimentalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0560ed8-4375-43b1-8927-52d0f6e04cde",
                                                "sense_id": "659a85a7-14c6-37d7-815b-441c6939dd21",
                                                "text": "Depuis presque un an, ils sont nombreux à être coupés du monde extérieur. Résultat : des familles assistent, impuissantes, à la régression intellectuelle et/ou comportementale de leur être cher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4d12180-f2a2-338a-99a9-9112a380b0cd",
                                        "entry_id": "19d01251-159d-35c9-8c59-4cf68b1422e9",
                                        "glosses": [
                                            "L’autre personne dans un couple."
                                        ],
