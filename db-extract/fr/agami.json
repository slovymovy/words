        "fr-extract.jsonl": [
            {
                "entry_id": "599e5c9b-9850-370b-9b9f-830248e4b4d7",
                "word": "agami",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8a19a6e-95e8-426a-a52f-51525e7a7480",
                        "entry_id": "599e5c9b-9850-370b-9b9f-830248e4b4d7",
                        "tags": [
                            "plural"
                        ],
                        "form": "agamis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                        "entry_id": "599e5c9b-9850-370b-9b9f-830248e4b4d7",
                        "glosses": [
                            "Oiseau de l’Amérique méridionale, de l’ordre des gruiformes, réputé très facile à apprivoiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7c134f-f440-4963-a233-da4fc28f49dd",
                                "sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                                "text": "On apprend aux agamis à faire à peu près ce que font nos chiens"
                            },
                            {
                                "example_id": "495eb3bd-18cb-4c7b-8138-44e94f23e9bf",
                                "sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                                "text": "Tigres ailés, feu mâchant par la bouche,\nLicorne bleue aux ongles smaragdins,\nCocquecigrue, alérion farouche,\nHircocerf plus rapide que les daims,\nIls ont vaincu les animaux soudains :\nAspics, zébus aux flancs tachés de rouille,\nL’aigle de mer avec les agamis."
                            },
                            {
                                "example_id": "5bbe3a8b-2474-4469-b3e5-1e2f00b0cc4b",
                                "sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                                "text": "Les agamis sont aussi fidèles à leur maître que les chiens."
                            },
                            {
                                "example_id": "b25b23e4-fcab-458d-afd7-78eedb8116ca",
                                "sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                                "text": "Il avait vu dans la Nouvelle-Hollande des troupeaux de dindons et d'oies menés et gardés par un chien de berger qui est un oiseau, et que l'on appelle l'agami"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "853a0beb-675f-4339-b50d-a6b6dccc2a31",
                        "source_entry_id": "599e5c9b-9850-370b-9b9f-830248e4b4d7",
                        "source_sense_id": "94507357-dc32-3f3c-acde-9fb964e860f1",
                        "target_lang_word": "Trompetervogel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
