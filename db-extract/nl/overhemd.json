                                    },
                                    {
                                        "sense_id": "f097d032-7fa8-3646-86eb-446c58f4ca26",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Enveloppe d’un aliment pour le cuire ou le présenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c10d39c-4057-45d9-9911-fbb8672bb0dc",
                                                "sense_id": "f097d032-7fa8-3646-86eb-446c58f4ca26",
                                                "text": "Pour accompagner les terrines aux aubergines voici : les Keftas en chemise de brick ! Les invités ont adoré,.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5b0349a-f291-3dea-9905-40f272947621",
                                        "entry_id": "f584163b-a3b5-3423-a146-7cbd2cb0a6ab",
                                        "glosses": [
                                            "Cylindre creux de métal qui, introduit dans une lumière, en ajuste l’alésage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44fe7af-848f-44e6-b4bc-aab33c6bf6e3",
                                                "sense_id": "d5b0349a-f291-3dea-9905-40f272947621",
                                                "text": "La mise en place de la chemise nécessite un tour de mains pas très compliqué :\n- placez le piston au PMB (Point Mort Bas),\n- huilez la chemise sur toute sa surface intérieure et extérieure,\n- alignez vos repères du carter moteur avec celui de la collerette de chemise,\n- puis descendez doucement la chemise dans le carter moteur jusqu’au contact avec le piston."
                                            }
                                        ]
                                    },
