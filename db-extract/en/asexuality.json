                    {
                        "translation_id": "9129081e-4ffd-4fa0-8d77-d324db00f70d",
                        "source_entry_id": "6c684481-48f9-3220-8ae3-05b1b6d0a698",
                        "source_sense_description": "state of not experiencing sexual attraction",
                        "target_lang_word": "asexualité",
