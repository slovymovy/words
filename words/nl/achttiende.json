                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vanaf je <w>achttiende</w> verjaardag word je in Nederland als volwassen beschouwd.",
                            "target_lang_translations": {
                                "en": "From your <w>eighteenth</w> birthday, you are considered an adult in the Netherlands."
                            }
                        },
                        {
                            "text": "Hij kreeg zijn eerste auto cadeau op zijn <w>achttiende</w> verjaardag.",
                            "target_lang_translations": {
