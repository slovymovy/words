                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f8ccb2-a720-40b5-a228-9d98a266560e",
                                "sense_id": "f418f448-4042-323d-975b-edb53765c7ef",
                                "text": "Niedźwiedzie polarne żyją na lodowych obszarach Arktyki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9912a5c-0b66-4b42-b337-abb64068204c",
                        "source_entry_id": "b636ea2c-79bf-3ebd-8434-f04b27261736",
                        "source_sense_id": "f418f448-4042-323d-975b-edb53765c7ef",
                        "target_lang_word": "Arctic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30835d88-665d-391b-9c48-1e92ab585d75",
                                        "entry_id": "c909f523-8c6d-39cf-b7c3-a93563120b91",
                                        "glosses": [
                                            "Pertaining to the celestial north pole, or to the pole star."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                                        "entry_id": "c909f523-8c6d-39cf-b7c3-a93563120b91",
                                        "glosses": [
                                            "Pertaining to the northern polar region of the planet, characterised by extreme cold and an icy landscape."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f31245a5-a440-4d0a-b471-32fdc1bb725a",
                                                "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                                                "text": "What neede the artick people loue star-light,\nTo whom the sunne shines both by day and night."
                                            },
                                            {
                                                "example_id": "847777a6-45dc-45d5-be36-49c9fb3d0420",
                                                "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                                                "text": "[…] on th’ other side\nIncenc’t with indignation Satan stood\nUnterrifi’d, and like a Comet burn’d,\nThat fires the length of Ophiucus huge\nIn th’ Artick Sky, and from his horrid hair\nShakes Pestilence and Warr."
                                            },
                                            {
                                                "example_id": "c7a363f8-bd5e-4ed5-9e07-9af99b9ddd76",
                                                "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                                                "text": "See FREEDOM smiling thro’ the realms of frost,\nAnd glow on Labradore’s inclement coast,\nTho’ darkness sheds deep night thro’ half the year,\nAnd snow invests the clime,—that clime is dear,\nFor there fair LIBERTY resides, and there\nAt large the native breasts the searching air,\nWhere blows the arctic tempests icy gale,\nAnd famine seizes on the spermy whale,"
                                            },
                                            {
                                                "example_id": "2401612f-520c-478b-a51a-064b7a5d5c6e",
                                                "sense_id": "07d3d9a2-3c39-30ee-b7c3-d4f8ac312182",
                                                "text": "A medical examination determined who was to be sent on to Norilsk in the Arctic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "294a0a94-c37f-3f27-9adb-8155c4340948",
                                        "entry_id": "c909f523-8c6d-39cf-b7c3-a93563120b91",
                                        "glosses": [
                                            "Extremely cold, snowy, or having other properties of extreme winter associated with the Arctic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f293bc6c-ba25-4a6a-a7d0-bfcfd2a5547d",
                                                "sense_id": "294a0a94-c37f-3f27-9adb-8155c4340948",
                                                "text": "‘Could you close that window, please!’ Strickland called, dialling again. ‘It's bloody arctic down this end.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bd6351-58fc-3e83-ba90-681d0103858a",
                                        "entry_id": "c909f523-8c6d-39cf-b7c3-a93563120b91",
                                        "glosses": [
                                            "Designed for use in very cold conditions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Arctic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "227e2ab1-1146-3b8f-842f-a156718f85f4",
                                        "entry_id": "2b7593b0-00ac-35bd-a9fa-4f8c7a9c24ad",
                                        "glosses": [
