                "senses": [
                    {
                        "sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "glosses": [
                            "w sposób odbiegający od zwyczajności czy codzienności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6fdb30a-cc61-4be5-a0c2-1b68cebcc67e",
                                "sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                                "text": "I prawdziwek został uroczyście pokrojony na plasterki, podsmażony na złoto na maśle i lekko posolony zgodnie ze wszystkimi zasadami sztuki kulinarnej. Smakował naprawdę królewsko."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "32e28acc-71f9-3f90-9e8f-d41ea5288804",
                        "entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "glosses": [
                            "w nastroju majestatycznym, poważnym"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "157aef85-6f99-474b-8e3b-0b9ff1a58dd2",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "solemnly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solemnly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c29bc2ae-12d9-3b48-b111-242cdd606167",
                                        "entry_id": "3488770f-c680-315c-9b89-57e4abcf4288",
                                        "glosses": [
                                            "In a solemn manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e71bb8-1911-4b18-a567-f01f7fabd78c",
                                                "sense_id": "c29bc2ae-12d9-3b48-b111-242cdd606167",
                                                "text": "And yet, though the happiness may be unenduring, what heart, though seared by time and worldly care, can fail to sympathise with those emotions of early life? In after years there are none such. They are the high noon of earthly joy. After them, life goes on decayingly and solemnly to its shadowy sunset."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "623fd877-4656-48a2-9d43-93765a33c815",
                        "source_entry_id": "19d424ce-f445-3533-a7b8-3f71ea823fc3",
                        "source_sense_id": "50df2397-f55a-3014-b6e1-1710339c2ff5",
                        "target_lang_word": "ceremonially",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceremonially",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c7f6f1f-5754-3085-b82b-b480c648ba84",
                                        "entry_id": "902dfb04-885f-3c4d-b729-56fc522150a0",
                                        "glosses": [
                                            "In a ceremonial manner."
                                        ],
