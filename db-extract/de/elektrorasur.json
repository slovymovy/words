                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4263a977-1f8f-407a-bf23-f0a00973e487",
                                "sense_id": "67d153e7-de69-3551-ab4d-c048a6cff019",
                                "text": "„Vor der Elektrorasur aufgetragen, sollen Preshaves die Barthaare aufrichten und so \"scherfest\" machen.“"
                            },
                            {
                                "example_id": "6b02b61f-04d0-4aa8-ac62-21d311cb459b",
                                "sense_id": "67d153e7-de69-3551-ab4d-c048a6cff019",
                                "text": "„Der 18. März 1931 gilt offiziell als Geburtsstunde der Elektrorasur.“"
                            },
                            {
                                "example_id": "4764e62e-104e-42fa-84c0-b36d83a5c824",
                                "sense_id": "67d153e7-de69-3551-ab4d-c048a6cff019",
                                "text": "„Zusammen mit einem speziellen Pflegemittel lassen sich Irritationen bei der Elektrorasur mittlerweile auf ein Minimum reduzieren.“"
                            }
                        ],
