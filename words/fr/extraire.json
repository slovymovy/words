                {
                    "sense_id": "6304084b-b5f4-331d-b997-6dc91aca94c4",
                    "sense_definition": "Tirer du sol ou d'une mine des substances minérales ou des matières premières.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exploitation_miniere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise minière continue d'<w>extraire</w> du charbon dans cette région isolée.",
                            "target_lang_translations": {
                                "en": "This mining company continues to <w>mine</w> coal in this remote region.",
                                "ru": "Эта горнодобывающая компания продолжает <w>добывать</w> уголь в этом отдалённом регионе.",
                                "de": "Dieses Bergbauunternehmen <w>baut</w> in dieser abgelegenen Region weiter Kohle <w>ab</w>.",
                                "es": "Esta empresa minera sigue <w>extrayendo</w> carbón en esta región remota.",
                                "zh": "这家矿业公司在这个偏远地区继续<w>开采</w>煤炭。"
                            }
                        },
                        {
                            "text": "Les ouvriers <w>extraient</w> chaque jour plusieurs tonnes de minerai de fer.",
                            "target_lang_translations": {
                                "en": "The workers <w>mine</w> several tons of iron ore every day.",
                                "ru": "Рабочие ежедневно <w>добывают</w> несколько тонн железной руды.",
                                "de": "Die Arbeiter <w>fördern</w> jeden Tag mehrere Tonnen Eisenerz.",
                                "es": "Los obreros <w>extraen</w> cada día varias toneladas de mineral de hierro.",
                                "zh": "工人们每天<w>开采</w>好几吨铁矿石。"
                            }
                        }
                    ],
                    "synonyms": [
                        "exploiter"
                    ],
                    "common_phrases": [
                        "extraire du charbon",
                        "extraire du minerai",
                        "extraire du pétrole"
                    ],
                    "target_lang_definitions": {
                        "en": "To dig or take mineral substances or raw materials out of the ground or a mine.",
                        "ru": "Добывать из недр земли или шахты минеральные вещества или сырьё.",
                        "de": "Mineralische Stoffe oder Rohstoffe aus dem Erdboden oder einem Bergwerk gewinnen.",
                        "es": "Obtener del subsuelo o de una mina sustancias minerales o materias primas.",
                        "zh": "从地下或矿井中开采矿物或原材料。"
                    },
