                        "glosses": [
                            "A transliteration of the Bulgarian or Russian female given name Наде́жда (Nadéžda)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a402c1a9-e735-4ca2-9a34-8facaf364072",
                                "sense_id": "5e06bbff-a2cf-3bca-b662-53ff25071480",
                                "text": "Nadezhda and her husband Vitaly found themselves in a similar situation. They moved to Serbia in 2017, received permanent residence and applied for citizenship in 2023. Their cases have been frozen since October of last year, after they gave up their Russian citizenship."
                            }
                        ]
