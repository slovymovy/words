                                            {
                                                "example_id": "ede8ad59-a69a-4d97-9958-f04248632d48",
                                                "sense_id": "67d4a0ff-edb6-3885-b361-3fd5641a7a4d",
                                                "text": "De sulfiden van koper en zilver zijn bijzonder onoplosbaar in water."
