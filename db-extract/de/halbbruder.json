                        "form": "den Halbbruder"
                    },
                    {
                        "form_id": "14852d25-0394-41f2-a863-16691ec2bd73",
                        "entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Halbbrüder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                        "entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                        "glosses": [
                            "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d903934-eff1-40c8-be12-a5b6d4cef3da",
                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                "text": "„Mein älterer Halbbruder nahm die Sache klaglos so, wie sie kam.“"
                            },
                            {
                                "example_id": "9ee54ec9-3cd1-4717-b688-b2fb1595c298",
                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                "text": "„Mit dieser Bemerkung erinnerte er Henriette daran, dass sie einen Halbbruder in Skopun hatte.“"
                            },
                            {
                                "example_id": "42f603a3-899c-4642-8c3a-6ddc44f53f52",
                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                "text": "„Es gibt ein Foto von Annie und ihrem Vater und ihrem Halbbruder, die drei blicken direkt in die Kamera.“"
                            },
                            {
                                "example_id": "ed8a4102-76d3-463e-bb02-ef32ea2d16a8",
                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                "text": "„Doch die ehelichen Kinder erfuhren erst nach dessen Tod von der Existenz ihres Halbbruders.“"
                            },
                            {
                                "example_id": "06dd869d-d0e6-4a58-b3db-aa3d4e0d8fd6",
                                "sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                                "text": "„Vorsitzender des Gewerkschaftsdachverbands ZCTU wurde 1981 Mugabes Halbbruder Albert, der die Arbeiterorganisationen auf Parteilinie bringen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fc6170b-eb6c-481c-82a1-6489d906e19e",
                        "source_entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                        "source_sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                        "source_sense_description": "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter",
                        "target_lang_word": "half brother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half brother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b16813ae-8c47-3e05-9aa4-b370c96fdf56",
                                        "entry_id": "ae560990-aef4-39b9-a606-84a430482da5",
                                        "glosses": [
                                            "A male sibling sharing a single parent, as distinguished from a full brother or brother-german, from a step-brother, or from a brother-like figure such as a blood brother."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1c11c3a-8f01-3088-bbb2-3d6da630c266",
                                        "entry_id": "ae560990-aef4-39b9-a606-84a430482da5",
                                        "glosses": [
                                            "A male half sibling (same dam, different sires)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f384c8e-f982-4efe-a8f1-ab2f18d6dfca",
                        "source_entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                        "source_sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                        "source_sense_description": "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter",
                        "target_lang_word": "demi-frère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-frère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                        "entry_id": "18d6fed6-bd43-3665-b1d4-f896bbfde4e8",
                                        "glosses": [
                                            "Frère n’ayant qu’un seul parent en commun (père ou mère)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60b6b263-9486-44f2-a25b-e1ac11dc8e75",
                                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                                "text": "J’ai un demi-frère depuis que mon père s’est remarié."
                                            },
                                            {
                                                "example_id": "802a066f-7b32-4075-bca4-0648ec303f99",
                                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                                "text": "Ce n’est que mon demi-frère, mais ce n’est pas une raison pour le laisser tomber."
                                            },
                                            {
                                                "example_id": "0c37bd68-22ff-4ecf-893c-d90cae23f06c",
                                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                                "text": "Je ne me propose pas d’évoquer souvent ce demi-frère de dix-huit ans mon aîné, mais ne puis sans amputer mon récit l’en éliminer tout à fait."
                                            },
                                            {
                                                "example_id": "6b3ac2b0-4b26-4856-9704-1ba1de7d7675",
                                                "sense_id": "f5e7c2eb-884e-3b69-adc7-a72aeb758877",
                                                "text": "Il est généralement possible d’éviter les effets environnementaux communs en comparant des individus demi-frères ou demi-sœurs paternels — qui ont le même père mais sont issus de mères différentes, comme par exemple la progéniture d’un taureau reproducteur utilisé pour inséminer un grand nombre de vaches. Les demi-frères ou sœurs ont en commun un quart de leurs gènes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6730d439-693b-4e52-b6e7-41e5f1fe4b2e",
                        "source_entry_id": "25f34ba6-461e-3e39-b363-547d37534d8c",
                        "source_sense_id": "91f01312-c7cf-3ce3-8bd7-2bbe9a4d6e5e",
                        "source_sense_description": "blutsverwandter Bruder anderer Kinder nur von Vater oder Mutter",
                        "target_lang_word": "halfbroer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "halfbroer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                        "entry_id": "c0415754-1924-3d06-b3e9-a1ad2b1dffda",
                                        "glosses": [
                                            "Een halfbroer van een persoon is iemand van het mannelijk geslacht die één ouder, maar niet beide, deelt met die persoon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce91e89d-3bfb-4ac3-ab9a-0e059471f056",
                                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                                "text": "Mijn vader is hertrouwd en mijn halfbroer is het kind van zijn nieuwe vrouw."
                                            },
                                            {
                                                "example_id": "7362f871-994a-4b2b-b359-694840be5377",
                                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                                "text": "Politiek en gokwereld spanden samen om Helmin Wiels te vermoorden. Dat beeld kwam naar voren in de rechtszaak tegen Burney F., gisteren op Curaçao. Ex-minister van Financiën, George Jamaloodin van de partij van Gerrit Schotte, de MFK, zou de grote organisator zijn. Samen met zijn halfbroer en gokbaas op het eiland, Robbie dos S."
                                            },
                                            {
                                                "example_id": "d04a7df4-a644-468a-b169-36290504a9c3",
                                                "sense_id": "ed9f4fe4-65d7-3e6e-b514-e0fba977d6bb",
                                                "text": "En ik had een halfbroer gekregen met de belachelijke naam Axel Edvin Hansson, die in de eerste klas was begonnen en zover ik wist op school ook Lauritzen werd genoemd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
