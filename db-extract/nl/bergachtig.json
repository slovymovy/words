                ],
                "senses": [
                    {
                        "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                        "entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                        "glosses": [
                            "met bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664fd8e5-0ce4-4553-ad26-6854023632a8",
                                "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                                "text": "In Zwitserland zijn veel bergachtige streken"
                            },
                            {
                                "example_id": "7de86b03-1895-479b-a28d-b16f6071283d",
                                "sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                                "text": "Opgelucht trok ik de volgende ochtend de moteldeur achter me dicht, de frisse lucht in, met mijn rugzak vol eten voor de komende zes dagen. Het terrein werd bergachtiger en de trail steeds steiler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "630930c8-9565-4da3-bbbb-fdbf06c9be5d",
                        "source_entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                        "source_sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                        "source_sense_description": "met bergen",
                        "target_lang_word": "bergig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bergig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                        "entry_id": "4658ceae-a60b-3be3-8a2a-85d749de2efd",
                                        "glosses": [
                                            "aus vielen Bergen oder Hügeln bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70198647-0fa6-47e2-8c43-8e6be725c95b",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Gerade waren wir in Zentralchile gestrandet, immerhin die Hauptstadtregion, und bergig dazu."
                                            },
                                            {
                                                "example_id": "8b3987cf-3208-42c4-a55b-2965dd9224b6",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Der Niederösterreicher Bernhard Kohl bot auf den bergigen Etappen eine starke Leistung, für einen Platz ganz vorne reichte es für den ÖRV-Staatsmeister aber nicht."
                                            },
                                            {
                                                "example_id": "2fea899e-5b50-4c97-abed-1a85e424a4e7",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "Den Absturz eines Charterflugzeugs im bergigen Süden Kambodschas vor zwei Tagen hat keiner der 22 Menschen an Bord überlebt."
                                            },
                                            {
                                                "example_id": "64c2aac6-942b-402d-bd97-4457d3e97b7b",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "»Ist die dortige Gegend eben oder bergig?«"
                                            },
                                            {
                                                "example_id": "e3e92510-a1e3-408a-b9f5-00f27948c368",
                                                "sense_id": "3f6b77a0-27cf-3181-9a8d-48b0679e7cda",
                                                "text": "„Von der Scala bis Radicosani ist der Weg bergig und schwierig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72fa67f2-12c1-4b88-b575-9876d5cd79db",
                        "source_entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                        "source_sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                        "source_sense_description": "met bergen",
                        "target_lang_word": "gebirgig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gebirgig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f047d29-790b-3221-8d2a-2335acc09bf7",
                                        "entry_id": "be3948fa-8b51-3d5f-af62-f485317db59b",
                                        "glosses": [
                                            "reich an Bergen, von Bergen geprägt; in der Art eines Gebirges, Gebirgs-"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "537621d6-07c6-448e-9c93-b1933977438b",
                                                "sense_id": "1f047d29-790b-3221-8d2a-2335acc09bf7",
                                                "text": "Belgien ist kein sehr gebirgiges Land."
                                            },
                                            {
                                                "example_id": "1d3907e1-3f86-45ef-8bfc-d6d8c424cb41",
                                                "sense_id": "1f047d29-790b-3221-8d2a-2335acc09bf7",
                                                "text": "„Zwar gab es Aufstände gegen die Fremden, und im gebirgigen Norden und Westen des Landes lebte die keltische Kultur ungebrochen weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "455c7cc0-0d13-4911-838b-09c98ace2262",
                        "source_entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                        "source_sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                        "source_sense_description": "met bergen",
                        "target_lang_word": "mountainous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mountainous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99d9179c-a642-3caa-9f59-a2f193fd7f67",
                                        "entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                                        "glosses": [
                                            "Having many mountains; characterized by mountains; of the nature of a mountain; rough (terrain); rocky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0da10217-31f9-49ac-b241-8fc2ee0dead2",
                                                "sense_id": "99d9179c-a642-3caa-9f59-a2f193fd7f67",
                                                "text": "[Water vapour bubbles] hit againſt the ſides of the more eminent and Mountainous Places, of the Globe, and by this Concuſſion are condenſed, and thus become heavier than the Air they ſvvom in, and ſo gleet dovvn the rocky Caverns of theſe Mountains, […]"
                                            },
                                            {
                                                "example_id": "8780e05d-1430-47f1-a9c6-5fd0144e496b",
                                                "sense_id": "99d9179c-a642-3caa-9f59-a2f193fd7f67",
                                                "text": "The mountainous nature of Norway has always been a serious obstacle to the development of railways, and although some 2,700 route miles are now open for traffic, several schemes have yet to be completed."
                                            },
                                            {
                                                "example_id": "545eb678-06b2-4b5b-bd48-9ec5f8021779",
                                                "sense_id": "99d9179c-a642-3caa-9f59-a2f193fd7f67",
                                                "text": "2024, Simon Montlake, In mountainous North Carolina, residents are the first responders after Hurricane Helene, in: The Christian Science Monitor, October 1 2024, headline\nIn mountainous North Carolina, residents are the first responders after Hurricane Helene[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee23e5e-a902-38d3-baf2-15e4ce2eb88b",
                                        "entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                                        "glosses": [
                                            "Resembling a mountain, especially in size; huge; towering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028a64c6-d9c2-4bf0-b6b0-bc90091d5a66",
                                                "sense_id": "cee23e5e-a902-38d3-baf2-15e4ce2eb88b",
                                                "text": "But the added size did not give them an advantage this time. Not when Kanter and Adams, two mountainous players, could match the Knicks’ girth with their own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "637d8398-c567-3648-9ca3-ee6bd93e351f",
                                        "entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                                        "glosses": [
                                            "Very difficult."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bab8679b-e653-3425-9f05-85aa85940a65",
                                        "entry_id": "0b2d7c4c-ba10-316a-912c-28d4bad4746d",
                                        "glosses": [
                                            "Inhabiting mountains; hence, barbarous."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9616ae2c-b310-4c37-a32f-5bb0c025f7db",
                        "source_entry_id": "c8d37c77-45d2-346a-bc43-1d6294e0d276",
                        "source_sense_id": "f539e770-7ba1-377e-870e-3b9f8d4975ae",
                        "source_sense_description": "met bergen",
                        "target_lang_word": "montagneux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "montagneux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                        "entry_id": "30f232e5-ace3-381d-9c8a-0905633187a6",
                                        "glosses": [
                                            "Où il y a beaucoup de montagnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d643a6c7-dc2f-465e-b887-1f613592a6ff",
                                                "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                                "text": "Les reliefs se dressent en puissants massifs ou encore constituent des systèmes montagneux très digités qui cloisonnent des petites pénéplaines. Aussi le paysage qui s'offre à la vue est-il toujours limité à l'horizon par des reliefs plus ou moins vigoureux."
                                            },
                                            {
                                                "example_id": "bf13c03e-96bd-422c-a8a6-688f8be60f51",
                                                "sense_id": "4cdeecf5-a524-35fc-a1c1-58ebe523a324",
                                                "text": "La structure du relief est bien conservée, les vastes vallées du bassin lacustre se trouvent pour la plupart à une altitude de 4400-4700 m, composant une surface complète de plateau et le niveau de base de l'érosion des régions montagneuses et des collines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0d1bf4-0119-3834-832d-45b0ec95f977",
                                        "entry_id": "30f232e5-ace3-381d-9c8a-0905633187a6",
                                        "glosses": [
                                            "Constitué de montagnes ; qui fait partie de la montagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
