                ],
                "senses": [
                    {
                        "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                        "entry_id": "bff05cc9-e314-302e-a747-6f9d73ff3360",
                        "glosses": [
                            "Repérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8f70e5-1ca6-4b8b-af8b-6368fc581bb2",
                                "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                                "text": "[…], qui était soit recherché par la police... pour bris de probation... fait que là... je trouvais que j’étais beaucoup «spottée» par la police… surtout avec ce cave-là qui a scrappé mon char."
                            },
                            {
                                "example_id": "91a7366d-a8e5-4169-8d2d-63bf959ef569",
                                "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                                "text": "Il a été « spotté » par Marci Klein (un des producteurs de SNL) et il est devenu un « featured player » en mars 1998."
                            },
                            {
                                "example_id": "25bb29b7-b8d7-4e43-b969-fd39780e9de1",
                                "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                                "text": "Bien entendu les copains habituels sont là, mais quelques indicatifs inconnus apparaissent et me passent ‘44’, signe que le FFF a été spotté sur le cluster."
                            },
                            {
                                "example_id": "8695fa49-fbf0-41d8-903a-80a649284594",
                                "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                                "text": "Son mari a été spotté avec une autre !"
                            },
                            {
                                "example_id": "d051116b-26ac-487e-86cf-e31605fddf19",
                                "sense_id": "30b2abba-480f-31dd-950e-af2542fa88fd",
                                "text": "Deux jours plus tôt, il avait \"spotté\" un observateur russe, sa position révélée par la vapeur de son souffle, loin de ses lignes, planqué derrière un monticule de neige."
                            }
                        ]
                    },
                    {
                        "sense_id": "326dc343-0a3f-3156-b784-a8b05a84b47f",
                        "entry_id": "bff05cc9-e314-302e-a747-6f9d73ff3360",
                        "glosses": [
                            "Répertorier des véhicules qui circulent, avec leurs caractéristiques."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7ded7a40-30d8-4d15-8c5e-faf2a1314127",
                                "sense_id": "326dc343-0a3f-3156-b784-a8b05a84b47f",
                                "text": "Conseils pour spotter à Montpellier"
                            },
                            {
                                "example_id": "f5f6b05d-949e-44a6-b54e-8e2dd0f7a34e",
                                "sense_id": "326dc343-0a3f-3156-b784-a8b05a84b47f",
                                "text": "Plusieurs fois par semaine, il enfourche son vélo pour rejoindre une autoroute située à 10 kilomètres de chez lui, et « spotter » (de l’anglais to spot, qui veut dire « repérer ») des camions de marchandises qui traversent les Pays de la Loire."
                            }
                        ]
                    }
                ],
