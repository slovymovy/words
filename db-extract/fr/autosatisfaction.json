                    {
                        "sense_id": "a01d4454-da54-3a59-b9fe-3e28856aeb4d",
                        "entry_id": "1019f862-a268-3d90-900c-2e50075137c2",
                        "glosses": [
                            "Sentiment de contentement au regard de sa situation, de ses propres réalisations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73997adb-dcea-44d2-8072-ddc965ffafc0",
                                "sense_id": "a01d4454-da54-3a59-b9fe-3e28856aeb4d",
                                "text": "Elle fait preuve d’autosatisfaction."
                            },
                            {
                                "example_id": "6810ed85-f248-4644-a2db-97d6c7387109",
                                "sense_id": "a01d4454-da54-3a59-b9fe-3e28856aeb4d",
                                "text": "Et c’est sur le même mode qu’en une heure et demie à la tribune il a alterné autosatisfaction et componction pour tenter d’en finir avec les reproches d’arrogance de plus en plus récurrents qui commencent à lui ternir l’image et les sondages."
                            }
                        ]
                    }
                ],
                "translations": [
