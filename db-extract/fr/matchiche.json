                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b0b0689b-db41-4d2a-b0ff-49662cc60f79",
                                "sense_id": "ab70676e-8a69-37e8-85e8-816bef208c25",
                                "text": "Ensuite quatre girls anglaises, des sisters quelconques, vinrent danser un pas de gigue, compliqué de cake-walk et de matchiche."
                            },
                            {
                                "example_id": "7a843382-173d-45b7-a27f-8f5811f86d6d",
                                "sense_id": "ab70676e-8a69-37e8-85e8-816bef208c25",
                                "text": "C’est la danse nouvelle,\nMademoiselle.\nLa danse qui nous aguiche,\nc’est la matchiche…"
                            },
                            {
                                "example_id": "14be1f5b-d645-492a-a782-44e1d5d0e9ed",
                                "sense_id": "ab70676e-8a69-37e8-85e8-816bef208c25",
                                "text": "Ils étaient allés à l’Alcazar écouter Mayol créer la matchiche."
                            },
                            {
                                "example_id": "8dd0e4a4-16b0-488a-9f1d-24e5d3e9e23d",
                                "sense_id": "ab70676e-8a69-37e8-85e8-816bef208c25",
                                "text": "Des heures durant, ils restèrent enlacés, indifférents à tout ce qui n’était pas eux, et eux seuls, enchaînant tangos, valse musette et matchiches."
                            }
                        ]
                    }
