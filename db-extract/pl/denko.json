                        ],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "60dfcfff-01b0-3658-aaab-3907a0b9cdb2",
                        "entry_id": "3462a1af-cc3a-3d92-b444-fff8cbb75da3",
                        "glosses": [
                            "dno niewielkiego pojemnika"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9e5ec0e3-e713-4189-918e-f756e300f03a",
                                "sense_id": "60dfcfff-01b0-3658-aaab-3907a0b9cdb2",
                                "text": "Renia nosi okulary grube jak denka od butelek."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3592dabc-6e91-34c3-8149-523f1a41ee46",
                        "entry_id": "3462a1af-cc3a-3d92-b444-fff8cbb75da3",
                        "glosses": [
                            "przykrywka czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3459af5-a7bb-4dcc-aa7c-9ec1849d454a",
                                "sense_id": "3592dabc-6e91-34c3-8149-523f1a41ee46",
                                "text": "„Chwalicie mą tabakę mości dobrodzieje, • Obaczcież co się wewnątrz tabakierki dzieje.” • Tu wycierając chustką zabrudzone denko, • Pokazał malowaną armiję maleńką"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "871bbaaa-294d-3aa3-af86-98011510828a",
                        "entry_id": "3462a1af-cc3a-3d92-b444-fff8cbb75da3",
                        "glosses": [
                            "górna część niektórych nakryć głowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb46f01-761b-47fe-851c-bf9952f33320",
                                "sense_id": "871bbaaa-294d-3aa3-af86-98011510828a",
                                "text": "Rogatywka to czapka o główce z kwadratowym denkiem, szczególnie rozpowszechniona w Polsce."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
