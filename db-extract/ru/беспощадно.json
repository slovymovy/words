                "translations": [
                    {
                        "translation_id": "24ef1e8a-72ca-4748-9da2-75af510b01c0",
                        "source_entry_id": "30d6a843-7d29-3d77-90b8-7800417aba34",
                        "target_lang_word": "gnadenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnadenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                        "entry_id": "a3bbf6c4-2d54-30be-a763-33743ea4a83d",
                                        "glosses": [
                                            "ohne Gnade, ohne Wohlwollen gegenüber einem Schwächeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5d193e-2ddc-4554-a13b-eeebb61eff46",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Der König galt als gnadenlos, wenn es um die Verfolgung seiner Feinde ging."
                                            },
                                            {
                                                "example_id": "dd590e49-eb30-432b-8f0c-2ebdb159ee15",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Wir beuten Tiere gnadenlos aus, man denke nur an die Massentierhaltung und unseren Fleischkonsum."
                                            },
                                            {
                                                "example_id": "9c8dbf01-50f7-4326-8d78-b04e6f68a169",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "In Italien, das mit großem Einsatz Migranten aufnimmt, werden dieselben Migranten gnadenlos ausgebeutet. Große Teile der Landwirtschaft leben von diesen Ausgebeuteten."
                                            },
                                            {
                                                "example_id": "347cd810-4213-4a05-8ed7-8d9ab67fd3b5",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Syrische Kampfflugzeuge bombardieren die Rebellengebiete mit gnadenloser Härte."
                                            },
                                            {
                                                "example_id": "8c7cb036-beb9-41f9-95d2-7c5359285158",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Oh, diese Vorstellung war wohl gnadenlos gut!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2688f8f-8d6d-4204-8595-eb8c2b2adc74",
                        "source_entry_id": "30d6a843-7d29-3d77-90b8-7800417aba34",
                        "target_lang_word": "schonungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schonungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                        "entry_id": "8ccbda86-9427-3ed2-befb-e6addf9ac056",
                                        "glosses": [
                                            "ohne Rücksicht, ohne Milde, ohne Schonung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b6c9770-a727-4bf7-bf49-6462a14ec37b",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "Ohne die Erdatmosphäre, die uns schützt, wären wir und alles andere auf der Erde der kosmischen Strahlung und der Sonnenstrahlung schonungslos ausgesetzt."
                                            },
                                            {
                                                "example_id": "7ca36b37-7a22-4037-ab09-1a17219f32ac",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Das Wahlergebnis - 64,9 Prozent für die Bestätigung des Amtsinhabers – legt schonungslos offen, wie schmal [der] Rückhalt [vom Berliner SPD-Chef Michael Müller], wie gespalten die Partei ist.“"
                                            },
                                            {
                                                "example_id": "5c48cb02-5c15-40a6-849e-6dbb498dc902",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Der Bericht der Arbeitsgruppe ist schonungslos. Die Fehler und Versäumnisse werden benannt.“"
                                            },
                                            {
                                                "example_id": "2ab12a3f-53dc-40ed-bf46-9bbcbd4a2221",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Helmut Schleich analysiert das aktuelle Politgeschehen scharfsinnig, schonungslos und auf den Punkt.“"
                                            },
                                            {
                                                "example_id": "d58b7ec7-f34b-4307-a9ed-f6afae5013af",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Die Auseinandersetzungen im Reichstag in Stockholm werden [durch die Wahl der 'Schwedendemokraten'] härter und schonungsloser werden.“"
                                            },
                                            {
                                                "example_id": "491048ef-3e2e-4a2d-9b22-c6ea04aa7693",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "[Hessens Ministerpräsident Volker Bouffier]: „'[Rechtsradikale Vorgänge in der hessischen Polizei müssen] nun schonungslos aufgeklärt werden.'“"
                                            },
                                            {
                                                "example_id": "db721f56-10e1-47e1-af51-d5d63ec70852",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Ernst Barlachs 'Russische Bettlerinnen', Kriegskrüppel, Zwangsprostituierte, Kupplerinnen und Totengräber – schonungslos zeigen die 'Menschenbilder' im Kunsthaus Kaufbeuren die brutale Welt vom Beginn bis zur Mitte des 20. Jahrhunderts […].“"
                                            },
                                            {
                                                "example_id": "c4bddf8e-ac01-4bdc-a0c1-41f72f3eb3fd",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "[FC Zürich : Larnaca 1:2] „Schonungslos fiel auch [Ludovic] Magnins [Fußballtrainer] Analyse aus, der von einer «verdienten Niederlage» sprach“ […]."
                                            },
                                            {
                                                "example_id": "8bb9dda5-38e0-4436-8aa3-25bb41ccf427",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„[Der Fußballer Kerem] Demirbay ist […] in der Spielanalyse schonungslos: »Wenn du auswärts gegen Berlin drei Tore schießt, bei aller Liebe, dann darfst du keine zwei Punkte mehr hergeben.«“"
                                            },
                                            {
                                                "example_id": "fa3a49b0-044e-4675-838f-65662730088b",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "Schonungslos eröffnete sie das Gespräch: »Wir trennen uns. Sofort, du ziehst heute noch aus und ich behalte die Kinder!«"
                                            },
                                            {
                                                "example_id": "1f888c35-1a58-4c6d-8ff7-997585d87140",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„In 'Distant Lovers' […] rechnet Fitzsimmons schonungslos mit seiner Ehe ab und kommt zu der starken, wenn auch schmerzhaften Einsicht: Besser Freunde als entfremdete Geliebte.“"
                                            },
                                            {
                                                "example_id": "53be38c0-2ec7-47a0-8d77-c12559f862d0",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Schonungslos beschreibt [Esther Kinsky in ihrem Roman 'Sommerfrische'] das prekäre Sozialgefüge, in dem Perspektivlosigkeit den Alltag bestimmt.“"
                                            },
                                            {
                                                "example_id": "89163fb0-a20f-4c1a-9c02-b5163db7a452",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Sie stehlen, verkaufen ihre Körper und prügeln sich durch das Berlin der Dreißigerjahre. Ernst Haffners Roman ist ein schonungsloser Blick auf das Leben obdachloser Jugendlicher im Gewühl der Großstadt.“"
                                            },
                                            {
                                                "example_id": "f474519e-2ae7-41c6-8329-200d01030dc2",
                                                "sense_id": "16875e94-fb17-33d3-a2ae-b0ec29625940",
                                                "text": "„Wojciech Smarzowski zeigt [im polnischen kirchenkritischen Film 'Kler' – oder 'Klerus' –] schonungslos die Abgründe in der katholischen Kirche in Polen – preisgekrönt, einer der meist gesehenen Filme seit 1989.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f91c76b-f374-4191-81fa-415492cd1212",
                        "source_entry_id": "30d6a843-7d29-3d77-90b8-7800417aba34",
                        "target_lang_word": "impitoyablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impitoyablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                        "entry_id": "7538385f-f8d6-3da4-8550-1cd332d3a16c",
                                        "glosses": [
                                            "D’une manière impitoyable, sans aucune pitié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "919b110d-1e86-418b-b48b-cddbcda0ce83",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "Il replongea dans ses fleurs, sectionnant impitoyablement les boutons qui lui déplaisaient."
                                            },
                                            {
                                                "example_id": "55f763d2-5bcd-4181-beb0-5dd2767633e0",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "Mais cette fois, il n’attendit pas que son adversaire se relevât ; il se jeta sur ses genoux, l’empoigna à la gorge et serra impitoyablement."
                                            },
                                            {
                                                "example_id": "302f81bc-000e-473d-836f-13e20b1bbee6",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "Il accordait à son frère une grande habileté. Selon lui, ce gros garçon endormi ne sommeillait jamais que d’un œil, comme les chats à l’affût devant un trou de souris. Et voilà qu’Eugène passait les soirées entières dans le salon jaune, écoutant religieusement ces grotesques que lui, Aristide, avait si impitoyablement raillés."
                                            },
                                            {
                                                "example_id": "aacdd1ac-3b99-4069-8a87-fa761afe9570",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "Les patrouilles de surveillance qui, d’abord, avaient impitoyablement fusillé les maraudeurs et les pillards, étaient maintenant dispersées par l’épidémie […]"
                                            },
                                            {
                                                "example_id": "9fb44ef2-a5b9-43a6-900d-53a5bcc285ff",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "Le temps avait passé. Dix heures venaient de sonner à la vieille horloge comtoise dont le nombril de verre laissait voir la lentille de cuivre du balancier passer et repasser impitoyablement."
                                            },
                                            {
                                                "example_id": "70d79b54-176f-4ce2-8c87-89c5c1d869e0",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "— Nous serions également coupables parce que nous aurions, de concert, impitoyablement sabré les demandes de crédits formulées par les services du ministère de la Guerre."
                                            },
                                            {
                                                "example_id": "17db7f9a-ec73-4364-a7b0-6527947eb72f",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "— Le balayage est impitoyablement proscrit, les poussières pouvant être mortelles pour les vers à soie."
                                            },
                                            {
                                                "example_id": "82e04f6a-0971-4597-ba7a-c3fbf2b2d058",
                                                "sense_id": "81974fbf-419f-366b-9e2d-4a54d1250f1d",
                                                "text": "— Le pauvre homme vivotait dans un chaos d’innovations continuelles et acharnées, en un endroit précisément où ces innovations s’effectuaient ostensiblement et impitoyablement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cba34e11-5ec5-4a11-b096-bf9c07a67ea3",
                        "source_entry_id": "30d6a843-7d29-3d77-90b8-7800417aba34",
                        "target_lang_word": "implacablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implacablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "949a7d92-cd71-37f7-858b-cfb43931829a",
                                        "entry_id": "6b5c4258-d153-392a-a5a6-159c8f9f320a",
                                        "glosses": [
                                            "D’une manière implacable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b4f667-5a63-4701-8bcb-8b4664093d31",
                                                "sense_id": "949a7d92-cd71-37f7-858b-cfb43931829a",
                                                "text": "Pour produire un repentir sincère, il faut déraciner les inclinations avec violence, s’indigner implacablement contre les faiblesses, s’arracher de vive force à soi-même."
                                            },
                                            {
                                                "example_id": "12351400-cc30-4334-9b65-e556dd3ee687",
                                                "sense_id": "949a7d92-cd71-37f7-858b-cfb43931829a",
                                                "text": "Jamais aucun oncle n’astreignit aussi implacablement ses petits-neveux à écouter le tic-tac de sa grosse montre."
                                            },
                                            {
                                                "example_id": "da648b3d-6453-41bc-a700-c5dc973a98af",
                                                "sense_id": "949a7d92-cd71-37f7-858b-cfb43931829a",
                                                "text": "Il y a loin des cadences implacablement obsédantes de cette époque aux productions même les plus acérées qu’on entend aujourd’hui ; la qualité était plus médiocre sans doute, à coup sûr plus grossière, et il y avait beaucoup moins d’invention, mais je crois pouvoir affirmer, sans qu’on puisse imputer ce jugement à l’émoussement de mes sensations (c’est-à-dire, en dernière analyse, au fait que depuis lors j’ai vieilli de plus de quinze années), que le jazz se présentait alors avec une frénésie que nous font regretter — quel que soit l’indéniable perfectionnement qu’elles représentent — la plupart des auditions actuelles, si « artistiques » et si guindées sauf dans les cas très rares où s’y donne libre cours le baroque le plus délirant."
                                            },
                                            {
                                                "example_id": "e82fe1bf-7fa8-4eaf-bd24-d2e4a6ac6f97",
                                                "sense_id": "949a7d92-cd71-37f7-858b-cfb43931829a",
                                                "text": "Il s’oignit de gomina, et traqua plaqua implacablement les touquettes qui rebiquaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
