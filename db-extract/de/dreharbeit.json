                ],
                "senses": [
                    {
                        "sense_id": "c5099483-cf08-3b1d-a67a-38be3d37eff2",
                        "entry_id": "9a2919e0-a003-3970-a827-dd92095d270a",
                        "glosses": [
                            "Phase der Filmproduktion, in der die Filmaufnahmen entstehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20531ea5-0a05-4ad4-884f-2130d60ee4c5",
                                "sense_id": "c5099483-cf08-3b1d-a67a-38be3d37eff2",
                                "text": "Im Mai begann die Dreharbeit zum Film."
                            },
                            {
                                "example_id": "5484d28a-acc0-46b8-b35e-e34e1cb1eca0",
                                "sense_id": "c5099483-cf08-3b1d-a67a-38be3d37eff2",
                                "text": "„In ihrer Autobiographie berichtet die Tochter Marlene Dietrichs über die Vorbereitungen ihrer Mutter auf die Rolle der Zigeunerin und über ihre Dreharbeiten.“"
                            },
                            {
                                "example_id": "eaa37ffb-186c-4609-97dd-f88e8f7a8df3",
                                "sense_id": "c5099483-cf08-3b1d-a67a-38be3d37eff2",
                                "text": "„Die anderen Russen, die durch das Casting gekommen waren, hatten schon im Jahr zuvor fast ausschließlich von Dreharbeiten gelebt, die für sie ein Zubrot zur Sozialhilfe geworden waren.“"
                            },
                            {
                                "example_id": "0bb04c41-d4a3-4eca-a17d-f0012515a3e1",
                                "sense_id": "c5099483-cf08-3b1d-a67a-38be3d37eff2",
                                "text": "„Im Juni 1938 sind die Dreharbeiten beendet, und die Kritik äußert sich überwiegend positiv über das neueste Produkt aus der Filmmetropole.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "329027af-7f43-364c-8c52-6f244bbf9384",
                        "entry_id": "9a2919e0-a003-3970-a827-dd92095d270a",
                        "glosses": [
                            "Verarbeiten von Werkstoffen mittels Drehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10d5ea1e-bdbd-48f5-8cf6-b49f1f2880b7",
                                "sense_id": "329027af-7f43-364c-8c52-6f244bbf9384",
                                "text": "Der Lehrling muss auch nachweisen, dass er Dreharbeiten ausführen kann."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
