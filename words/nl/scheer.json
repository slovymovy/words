{
    "word_family": [
        "scheren",
        "scheermes",
        "scheerbeurt",
        "scheerapparaat"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19ea7c60-a1c2-392b-8894-9c6667fe2815",
                    "sense_definition": "Een kleine, nauwelijks uit de zee oprijzende rots of klein eiland.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kust van Zweden is bekend voor zijn vele <w>scheren</w>.",
                            "target_lang_translations": {
                                "fr": "La côte de la Suède est connue pour ses nombreux <w>écueils</w>."
                            }
                        },
                        {
                            "text": "Het schip voer voorzichtig tussen de gevaarlijke <w>scheren</w> door.",
                            "target_lang_translations": {
                                "fr": "Le navire a navigué prudemment entre les <w>écueils</w> dangereux."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Un petit rocher ou îlot qui émerge à peine de la mer."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "écueil",
                                "target_lang_sense_clarification": "Rocher dangereux à fleur d'eau"
                            },
                            {
                                "target_lang_word": "skär",
                                "target_lang_sense_clarification": "Terme géographique spécifique pour les îlots rocheux scandinaves"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b6513c4-a804-3848-a1bb-3d4c79111b91",
                    "sense_definition": "Een lichaamsdeel van een dier, zoals een schaar van een krab.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De krab zwaaide dreigend met zijn grote <w>scheer</w>.",
                            "target_lang_translations": {
                                "fr": "Le crabe agitait menaçamment sa grande <w>pince</w>."
                            }
                        },
                        {
                            "text": "Pas op dat de kreeft je niet grijpt met zijn <w>scheer</w>.",
                            "target_lang_translations": {
                                "fr": "Fais attention à ce que le homard ne t'attrape pas avec sa <w>pince</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schaar"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une partie du corps d'un animal, comme la pince d'un crabe."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pince",
                                "target_lang_sense_clarification": "Organe préhensile des crustacés"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a308bcd6-fdcb-380a-ae2f-dbfb9cb70d88",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>scheren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>scheer</w> me elke ochtend voor het werk.",
                            "target_lang_translations": {
                                "fr": "Je <w>me rase</w> tous les matins avant le travail."
                            }
                        },
                        {
                            "text": "Ik <w>scheer</w> mijn benen voordat ik naar het strand ga.",
                            "target_lang_translations": {
                                "fr": "Je <w>me rase</w> les jambes avant d'aller à la plage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "me scheren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier du présent du verbe raser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "je me rase",
                                "target_lang_sense_clarification": "Action de se couper les poils ou la barbe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44bd78d7-fd24-39d3-bf52-2291cfea1f16",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>scheren</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scheer</w> jij je elke dag met een mesje?",
                            "target_lang_translations": {
                                "fr": "<w>Te rases-tu</w> tous les jours avec un rasoir ?"
                            }
                        },
                        {
                            "text": "Waarom <w>scheer</w> jij je baard niet af?",
                            "target_lang_translations": {
                                "fr": "Pourquoi ne <w>te rases-tu</w> pas la barbe ?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "je scheren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier du présent du verbe raser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tu te rases",
                                "target_lang_sense_clarification": "Action de se couper les poils ou la barbe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "532fc4d7-929d-3800-997b-7e8cf980c38e",
                    "sense_definition": "Gebiedende wijs van <w>scheren</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lichaamsverzorging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Scheer</w> je nu eindelijk eens voor het feest begint.",
                            "target_lang_translations": {
                                "fr": "<w>Rase-toi</w> enfin avant que la fête ne commence."
                            }
                        },
                        {
                            "text": "<w>Scheer</w> die lelijke snor eens af.",
                            "target_lang_translations": {
                                "fr": "<w>Rase-toi</w> cette vilaine moustache."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe raser."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rase-toi",
                                "target_lang_sense_clarification": "Ordre ou conseil de se couper les poils ou la barbe"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}