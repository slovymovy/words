            {
                "entry_id": "367bf37f-88b9-3e24-a70c-cda58988dc03",
                "word": "iconographe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b14c97fe-1762-4fee-a006-3c291c3d75d5",
                        "entry_id": "367bf37f-88b9-3e24-a70c-cda58988dc03",
                        "tags": [
