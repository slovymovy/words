{
    "word_family": [
        "leader",
        "leadership",
        "leading",
        "mislead",
        "leaderless",
        "lead-free",
        "leaden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd445b6e-e07f-3700-96e2-5282e6eb2e17",
                    "sense_definition": "To guide or conduct by means of physical contact or connection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "guiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young boy helped <w>lead</w> the blind man across the busy street.",
                            "target_lang_translations": {
                                "ru": "Мальчик помог <w>перевести</w> слепого через оживленную улицу."
                            }
                        },
                        {
                            "text": "She was <w>leading</w> a horse by its halter toward the stable.",
                            "target_lang_translations": {
                                "ru": "Она <w>вела</w> лошадь за недоуздок к конюшне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead by the hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или направлять кого-либо с помощью физического контакта или связи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "направлять движение"
                            },
                            {
                                "target_lang_word": "водить",
                                "target_lang_sense_clarification": "сопровождать, помогая идти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8472fba-48ba-35b4-80a0-9ad3e12d1e6b",
                    "sense_definition": "To show the way to a destination by going in advance or giving instructions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "guiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced guide will <w>lead</w> the tourists through the dense jungle safely.",
                            "target_lang_translations": {
                                "ru": "Опытный гид благополучно <w>проведет</w> туристов через густые джунгли."
                            }
                        },
                        {
                            "text": "If you <w>lead</w> the way, we will follow you to the restaurant.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>покажете</w> дорогу, мы последуем за вами в ресторан."
                            }
                        }
                    ],
                    "antonyms": [
                        "follow"
                    ],
                    "common_phrases": [
                        "lead the way"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать путь к месту назначения, идя впереди или давая инструкции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "указывать дорогу"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "сопровождать до места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f836d7a-ec37-39e0-ad65-bd9843bf3dcb",
                    "sense_definition": "To be in charge of or command a group, organization, or activity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "leadership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was chosen to <w>lead</w> a political party during the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Ее выбрали <w>возглавить</w> политическую партию на предстоящих выборах."
                            }
                        },
                        {
                            "text": "The captain will <w>lead</w> the team to victory in the final match.",
                            "target_lang_translations": {
                                "ru": "Капитан <w>приведет</w> команду к победе в финальном матче."
                            }
                        }
                    ],
                    "synonyms": [
                        "head"
                    ],
                    "common_phrases": [
                        "lead a team",
                        "lead a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить или командовать группой, организацией или деятельностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руководить",
                                "target_lang_sense_clarification": "быть во главе коллектива"
                            },
                            {
                                "target_lang_word": "возглавлять",
                                "target_lang_sense_clarification": "стоять во главе организации"
                            },
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "командовать командой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18386f9d-47b1-3181-9aab-04e35b228e39",
                    "sense_definition": "To tend or reach in a certain direction or toward a specific place.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This narrow dirt path <w>leads</w> to the old mill by the river.",
                            "target_lang_translations": {
                                "ru": "Эта узкая грунтовая тропинка <w>ведет</w> к старой мельнице у реки."
                            }
                        },
                        {
                            "text": "The stairs <w>lead</w> up to a small attic filled with old books.",
                            "target_lang_translations": {
                                "ru": "Лестница <w>ведет</w> на небольшой чердак, заполненный старыми книгами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead to the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направляться или тянуться в определенную сторону или к конкретному месту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "о дороге или пути"
                            },
                            {
                                "target_lang_word": "проводить",
                                "target_lang_sense_clarification": "пролегать в направлении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1db8034-186b-34d9-85e7-2bc20505065a",
                    "sense_definition": "To result in or be the cause of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigation <w>led</w> to the discovery of several new pieces of evidence.",
                            "target_lang_translations": {
                                "ru": "Расследование <w>привело</w> к обнаружению нескольких новых улик."
                            }
                        },
                        {
                            "text": "Poor communication can often <w>lead</w> to serious misunderstandings between partners.",
                            "target_lang_translations": {
                                "ru": "Плохая коммуникация часто может <w>привести</w> к серьезным недопониманиям между партнерами."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead to"
                    ],
                    "common_phrases": [
                        "lead to success",
                        "lead to trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить к чему-либо или быть причиной чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "служить причиной последствий"
                            },
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "вызывать результат"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5935ef5-53fd-34b6-a955-7e528dafd289",
                    "sense_definition": "To live or experience a particular type of lifestyle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They moved to the countryside to <w>lead</w> a quiet and peaceable life.",
                            "target_lang_translations": {
                                "ru": "Они переехали в сельскую местность, чтобы <w>вести</w> тихую и мирную жизнь."
                            }
                        },
                        {
                            "text": "He has <w>led</w> a very exciting life as a travel photographer.",
                            "target_lang_translations": {
                                "ru": "Он <w>прожил</w> очень интересную жизнь, работая фотографом-путешественником."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead a life",
                        "lead a double life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или проживать определенный образ жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести",
                                "target_lang_sense_clarification": "об образе жизни"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d61d56e-77ab-3b8c-a258-9d83844cbe78",
                    "sense_definition": "To influence, induce, or entice someone to do something or go somewhere.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The promise of high profits <w>led</w> many investors into a risky scheme.",
                            "target_lang_translations": {
                                "ru": "Обещание высокой прибыли <w>втянуло</w> многих инвесторов в рискованную схему."
                            }
                        },
                        {
                            "text": "Do not let your emotions <w>lead</w> you into making a bad decision.",
                            "target_lang_translations": {
                                "ru": "Не позволяйте эмоциям <w>подтолкнуть</w> вас к принятию неверного решения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead someone astray"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влиять на кого-либо, побуждать или склонять к совершению действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонять",
                                "target_lang_sense_clarification": "убеждать или подталкивать"
                            },
                            {
                                "target_lang_word": "приводить",
                                "target_lang_sense_clarification": "вводить в состояние или ситуацию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0eae8e5-c2f4-3468-a0a9-08c76b004e98",
                    "sense_definition": "To play the first card or piece in a game or round.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was his turn to <w>lead</w>, so he played the ace of spades.",
                            "target_lang_translations": {
                                "ru": "Была его очередь <w>ходить</w>, поэтому он сыграл тузом пик."
                            }
                        },
                        {
                            "text": "If you <w>lead</w> trumps now, you might win the entire round.",
                            "target_lang_translations": {
                                "ru": "Если ты сейчас <w>пойдешь</w> с козырей, то сможешь выиграть весь раунд."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lead a card"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сходить первой картой или фигурой в игре или раунде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ходить",
                                "target_lang_sense_clarification": "делать первый ход в картах"
                            },
                            {
                                "target_lang_word": "пойти",
                                "target_lang_sense_clarification": "начать игру с определенной карты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "554919c3-7ecd-36c8-8afc-38a42524cb0e",
                    "sense_definition": "The state of being ahead in a race or competition, or the amount by which one is ahead.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner managed to extend her <w>lead</w> over the second place athlete.",
                            "target_lang_translations": {
                                "ru": "Бегунье удалось увеличить свой <w>отрыв</w> от спортсменки, идущей на втором месте."
                            }
                        },
                        {
                            "text": "Our team is currently in the <w>lead</w> with a score of three to one.",
                            "target_lang_translations": {
                                "ru": "Наша команда в данный момент <w>лидирует</w> со счетом три-один."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the lead",
                        "take the lead",
                        "lose the lead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние первенства в гонке или соревновании, или величина этого преимущества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лидерство",
                                "target_lang_sense_clarification": "ведущая позиция"
                            },
                            {
                                "target_lang_word": "отрыв",
                                "target_lang_sense_clarification": "величина преимущества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e877b68-3e1c-3565-8cdd-f4002885644d",
                    "sense_definition": "The main role in a play, film, or other performance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was thrilled to be picked for the <w>lead</w> in the new movie.",
                            "target_lang_translations": {
                                "ru": "Она была в восторге от того, что ее выбрали на <w>главную роль</w> в новом фильме."
                            }
                        },
                        {
                            "text": "The actor playing the <w>lead</w> gave a very powerful performance tonight.",
                            "target_lang_translations": {
                                "ru": "Актер, исполняющий <w>главную роль</w>, сегодня выступил очень мощно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "female lead",
                        "male lead",
                        "romantic lead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главная роль в пьесе, фильме или другом представлении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "главная роль",
                                "target_lang_sense_clarification": "ведущий персонаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbd69423-284c-34d8-a09b-0c982ad83c8f",
                    "sense_definition": "A piece of information that may help solve a crime or mystery.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "investigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police have a couple of <w>leads</w> they will follow to solve the case.",
                            "target_lang_translations": {
                                "ru": "У полиции есть пара <w>зацепок</w>, по которым они будут работать, чтобы раскрыть дело."
                            }
                        },
                        {
                            "text": "The investigation stalled when all the promising <w>leads</w> turned out to be dead ends.",
                            "target_lang_translations": {
                                "ru": "Расследование зашло в тупик, когда все многообещающие <w>наводки</w> оказались ложными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow a lead",
                        "promising lead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сведения или зацепка, которые могут помочь раскрыть преступление или тайну."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зацепка",
                                "target_lang_sense_clarification": "улика или след"
                            },
                            {
                                "target_lang_word": "наводка",
                                "target_lang_sense_clarification": "подсказка для следствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff671750-215a-37e2-b3f2-80192b5458e6",
                    "sense_definition": "A potential customer or opportunity for a commercial sale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sales team is working hard to convert these new <w>leads</w> into customers.",
                            "target_lang_translations": {
                                "ru": "Отдел продаж усердно работает над тем, чтобы превратить этих новых <w>лидов</w> в клиентов."
                            }
                        },
                        {
                            "text": "He has numerous <w>leads</w> in the paper industry that could result in big contracts.",
                            "target_lang_translations": {
                                "ru": "У него есть многочисленные <w>контакты</w> в бумажной промышленности, которые могут привести к крупным контрактам."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sales lead",
                        "generate leads"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потенциальный клиент или возможность для коммерческой продажи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лид",
                                "target_lang_sense_clarification": "потенциальный клиент"
                            },
                            {
                                "target_lang_word": "наводка",
                                "target_lang_sense_clarification": "информация о возможной сделке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04a90359-079f-30be-8d6e-e7254efab67e",
                    "sense_definition": "A strap or rope used to guide or control an animal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must keep your dog on a <w>lead</w> while walking in the park.",
                            "target_lang_translations": {
                                "ru": "Вы должны держать собаку на <w>поводке</w> во время прогулки в парке."
                            }
                        },
                        {
                            "text": "The horse was guided gently by a leather <w>lead</w> attached to its halter.",
                            "target_lang_translations": {
                                "ru": "Лошадь осторожно вели за кожаный <w>повод</w>, прикрепленный к недоуздку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "on a lead",
                        "dog lead"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремень или веревка, используемые для ведения или контроля животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поводок",
                                "target_lang_sense_clarification": "для выгула собак"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a2776c0-0fa0-369b-940b-5aac6eda5302",
                    "sense_definition": "A heavy, soft, greyish-blue metallic element (symbol Pb).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old pipes were made of <w>lead</w>, which can be toxic to humans.",
                            "target_lang_translations": {
                                "ru": "Старые трубы были сделаны из <w>свинца</w>, который может быть токсичен для человека."
                            }
                        },
                        {
                            "text": "The heavy shield was lined with <w>lead</w> to protect against radiation.",
                            "target_lang_translations": {
                                "ru": "Тяжелый экран был облицован <w>свинцом</w> для защиты от радиации."
                            }
                        }
                    ],
                    "synonyms": [
                        "plumbum"
                    ],
                    "common_phrases": [
                        "lead poisoning",
                        "heavy as lead"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый, мягкий, серовато-голубой металлический элемент (символ Pb)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свинец",
                                "target_lang_sense_clarification": "химический элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ece1014a-76c8-3cfc-b427-28a10fb4b4ed",
                    "sense_definition": "The graphite core used in pencils for writing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "materials",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to buy more <w>lead</w> for my mechanical pencil.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить еще <w>грифелей</w> для механического карандаша."
                            }
                        },
                        {
                            "text": "The <w>lead</w> in this pencil is too soft and breaks easily.",
                            "target_lang_translations": {
                                "ru": "<w>Грифель</w> в этом карандаше слишком мягкий и легко ломается."
                            }
                        }
                    ],
                    "synonyms": [
                        "pencil lead"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Графитовый стержень, используемый в карандашах для письма."
                    },
                    "translations": {
