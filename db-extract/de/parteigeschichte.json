                        "examples": [
                            {
                                "example_id": "e7427425-82e4-4b71-8748-60bc2cdbaa6d",
                                "sense_id": "579f9cb2-1e21-3ec1-a407-334795d6ce00",
                                "text": "„Auf dem Parteitag in Bielefeld im November holt Baerbock mit 97,1 Prozent das beste Ergebnis einer Grünen-Chefin in vier Jahrzehnten Parteigeschichte, deutlich mehr als Habeck.“"
                            },
                            {
                                "example_id": "cf3838d5-1f6b-44e1-9fbb-74c5f2fd20d7",
                                "sense_id": "579f9cb2-1e21-3ec1-a407-334795d6ce00",
                                "text": "„In den Monaten nach der Konferenz in Chimoio entwarf Mugabe zum Zweck der Legitimation und Propaganda ein Bild der Parteigeschichte, aus dem er den Führungsanspruch der ZANU ableiten konnte.“"
                            }
                        ],
