{
    "word_family": [
        "yawningly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6cf356ef-bdfe-36d2-8187-077b3acc04be",
                    "sense_definition": "To open the mouth widely and take a long, deep breath, usually due to tiredness or boredom.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "yawning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could see my students <w>yawning</w>, so I knew the lesson was boring them.",
                            "target_lang_translations": {
                                "ru": "Я видел, что мои студенты <w>зевают</w>, поэтому понял, что урок им скучен.",
                                "zh": "我看到学生们都在<w>打哈欠</w>，就知道这节课让他们觉得很无聊。"
                            }
                        },
                        {
                            "text": "It is hard not to <w>yawn</w> when you are feeling very tired.",
                            "target_lang_translations": {
                                "ru": "Трудно не <w>зевнуть</w>, когда чувствуешь сильную усталость.",
                                "zh": "当你感到非常疲倦时，很难不<w>打哈欠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stifle a yawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рефлекторно открывать рот и делать глубокий вдох из-за усталости или скуки.",
                        "zh": "因疲倦或无聊而张大嘴巴深呼吸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зева́ть",
                                "target_lang_sense_clarification": "основной глагол, обозначающий действие зевания"
                            },
                            {
                                "target_lang_word": "зевну́ть",
                                "target_lang_sense_clarification": "однократное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打哈欠",
                                "target_lang_sense_clarification": "指打哈欠这一动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49fa6ff5-c562-3422-ab2f-2d3c1c3136f5",
                    "sense_definition": "To present a wide, gaping opening.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep canyon <w>yawns</w> before us as we stand at the edge.",
                            "target_lang_translations": {
                                "ru": "Глубокий каньон <w>зияет</w> перед нами, пока мы стоим на краю.",
                                "zh": "当我们站在边缘时，深邃的峡谷在我们面前<w>张开</w>。"
                            }
                        },
                        {
                            "text": "A dark hole <w>yawned</w> in the middle of the old road.",
                            "target_lang_translations": {
                                "ru": "Темная дыра <w>зияла</w> посреди старой дороги.",
                                "zh": "老路中间<w>裂开</w>了一个黑洞。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть широко раскрытым, представлять собой глубокое отверстие или провал.",
                        "zh": "指裂口或洞穴张开，显得深邃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зия́ть",
                                "target_lang_sense_clarification": "быть раскрытым, показывать глубину (о провале, дыре)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "张开",
                                "target_lang_sense_clarification": "指洞穴或裂口呈现出深邃的样子"
                            },
                            {
                                "target_lang_word": "裂开",
                                "target_lang_sense_clarification": "指地表或物体出现深大的裂口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0e35743-ab3d-3897-8766-4375f550f463",
                    "sense_definition": "To speak while in the middle of yawning.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "yawning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am too tired for this, he <w>yawned</w> while rubbing his eyes.",
                            "target_lang_translations": {
                                "ru": "«Я слишком устал для этого», — <w>зевнул</w> он, потирая глаза.",
                                "zh": "“我太累了，不想做这个，”他揉着眼睛<w>打着哈欠</w>说。"
                            }
                        },
                        {
                            "text": "I have no idea what to do, she <w>yawned</w> sleepily.",
                            "target_lang_translations": {
                                "ru": "«Понятия не имею, что делать», — сонно <w>зевнула</w> она.",
                                "zh": "“我不知道该怎么办，”她困倦地<w>打着哈欠</w>说。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить что-либо во время зевания.",
                        "zh": "在打哈欠的同时说话。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зева́ть",
                                "target_lang_sense_clarification": "используется в контексте речи во время зевоты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打着哈欠说",
                                "target_lang_sense_clarification": "描述边打哈欠边说话的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "66676c18-15ca-3a71-9033-67cf3fb7a122",
                    "sense_definition": "To open the mouth in surprise or bewilderment.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd <w>yawned</w> in sheer amazement at the magician's trick.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>разинула рты</w> от изумления при виде фокуса мага.",
                                "zh": "观众被魔术师的戏法惊得<w>目瞪口呆</w>。"
                            }
                        },
                        {
                            "text": "Spectators <w>yawned</w> at the sudden and shocking turn of events.",
                            "target_lang_translations": {
                                "ru": "Зрители <w>разинули рты</w> от внезапного и шокирующего поворота событий.",
                                "zh": "观众们对事态突然而令人震惊的转变感到<w>目瞪口呆</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широко открывать рот от удивления или изумления.",
                        "zh": "因惊讶或困惑而张大嘴巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разинуть рот",
                                "target_lang_sense_clarification": "фразеологизм, означающий крайнее удивление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目瞪口呆",
                                "target_lang_sense_clarification": "形容因吃惊而张大嘴巴的样子"
                            },
                            {
                                "target_lang_word": "张口结舌",
                                "target_lang_sense_clarification": "形容因惊讶而张嘴说不出话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09850ac1-9b48-39ab-a4bd-5682a4fb8fe4",
                    "sense_definition": "To express an eager desire for something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>yawn</w> for wealth and power in their daily lives.",
                            "target_lang_translations": {
                                "ru": "Они <w>жаждут</w> богатства и власти в своей повседневной жизни.",
                                "zh": "他们在日常生活中<w>渴望</w>财富和权力。"
                            }
                        },
                        {
                            "text": "The ambitious politician <w>yawned</w> for a higher position in the government.",
                            "target_lang_translations": {
                                "ru": "Амбициозный политик <w>стремился</w> к более высокой должности в правительстве.",
                                "zh": "这位雄心勃勃的政客<w>渴求</w>在政府中获得更高的职位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crave",
                        "yearn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Страстно желать чего-либо, стремиться к чему-либо.",
                        "zh": "热切地渴望某事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "сильно желать чего-то"
                            },
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "настойчиво добиваться чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "渴望",
                                "target_lang_sense_clarification": "指强烈的愿望"
                            },
                            {
                                "target_lang_word": "渴求",
                                "target_lang_sense_clarification": "指迫切地追求"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96f3118a-937a-339e-9f21-78e5e7e40e60",
                    "sense_definition": "The act of opening the mouth widely and taking a deep breath, often due to tiredness.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "yawning_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to hide a <w>yawn</w> during the long meeting.",
                            "target_lang_translations": {
                                "ru": "Она пыталась скрыть <w>зевок</w> во время долгого совещания.",
                                "zh": "在漫长的会议中，她试图掩饰一个<w>哈欠</w>。"
                            }
                        },
                        {
                            "text": "He let out a big <w>yawn</w> after waking up from his nap.",
                            "target_lang_translations": {
                                "ru": "Он громко <w>зевнул</w>, проснувшись после дневного сна.",
                                "zh": "午睡醒来后，他打了一个大<w>哈欠</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stifle a yawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт глубокого вдоха с широко открытым ртом, обычно от усталости.",
                        "zh": "因疲倦等原因张大嘴巴深呼吸的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зево́та",
                                "target_lang_sense_clarification": "физиологический процесс"
                            },
                            {
                                "target_lang_word": "зево́к",
                                "target_lang_sense_clarification": "однократный акт зевания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哈欠",
                                "target_lang_sense_clarification": "指打哈欠这一生理动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24614793-58a8-3e80-93b3-7bef2a10ae94",
                    "sense_definition": "Something that is extremely boring.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was a total <w>yawn</w> from start to finish.",
                            "target_lang_translations": {
                                "ru": "Фильм был сплошной <w>скукой</w> от начала до конца.",
                                "zh": "这部电影从头到尾都<w>无聊透顶</w>。"
                            }
                        },
                        {
                            "text": "That lecture was such a <w>yawn</w> that I almost fell asleep.",
                            "target_lang_translations": {
                                "ru": "Эта лекция была такой <w>нудятиной</w>, что я чуть не уснул.",
                                "zh": "那场讲座实在太<w>乏味</w>了，我差点睡着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bore"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe something boring."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то крайне скучное и неинтересное.",
                        "zh": "指极其无聊的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скука",
                                "target_lang_sense_clarification": "состояние или предмет, вызывающий скуку"
                            },
                            {
                                "target_lang_word": "нудятина",
                                "target_lang_sense_clarification": "разговорное, о чем-то очень скучном"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无聊透顶",
                                "target_lang_sense_clarification": "形容事物非常乏味"
                            },
                            {
                                "target_lang_word": "乏味",
                                "target_lang_sense_clarification": "形容缺乏趣味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ee90bb6b-9f48-3e7d-bbd8-495e64cbefdb",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Yawns</w> family moved into the neighborhood last week.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Яун</w> переехала в наш район на прошлой неделе.",
                                "zh": "<w>扬</w>一家上周搬到了这个社区。"
                            }
                        },
                        {
                            "text": "Mr. <w>Yawn</w> is a very kind teacher.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Яун</w> — очень добрый учитель.",
                                "zh": "<w>扬</w>先生是一位非常和蔼的老师。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Яун",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扬",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}