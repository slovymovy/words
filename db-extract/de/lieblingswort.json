                "senses": [
                    {
                        "sense_id": "e571c3fd-204c-3ec3-995f-3c0a0543a698",
                        "entry_id": "88a56692-43fb-35db-9900-61a53deb770e",
                        "glosses": [
                            "Wort, das jemand fast allen anderen vorzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f11019e3-3a2f-499c-98c4-61e1b3a64701",
                                "sense_id": "e571c3fd-204c-3ec3-995f-3c0a0543a698",
                                "text": "„Das Wort »Dekadenz« ist just ein Lieblingswort unter amerikanischen Kulturpessimisten, und jeder versteht es anders.“"
                            },
                            {
                                "example_id": "3e358df7-f9b2-4bdd-8136-14e74cc24f2d",
                                "sense_id": "e571c3fd-204c-3ec3-995f-3c0a0543a698",
                                "text": "„Mit den wärmer werdenden Tagen wird es jetzt Zeit für die Lieblingswörter der Deutschen, die uns auch das Herz wärmen.“"
                            },
                            {
                                "example_id": "e8bdd5ac-2e36-4c52-b30f-1f6d31f11d17",
                                "sense_id": "e571c3fd-204c-3ec3-995f-3c0a0543a698",
                                "text": "„Dasselbe gilt für mein jiddisches Lieblingswort, nämlich »stickum« beziehungsweise »stikum«.“"
                            },
                            {
                                "example_id": "c98afa9b-8407-469d-a02a-b0cd2fb75f8f",
                                "sense_id": "e571c3fd-204c-3ec3-995f-3c0a0543a698",
                                "text": "„Es ist kein Zufall, daß Lieblingsworte des Berliners seinen Tatsachensinn widerspiegeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
