                ],
                "translations": [
                    {
                        "translation_id": "5b4c5c73-e759-4c0a-bcf4-8ca782093935",
                        "source_entry_id": "adff77f9-7587-350f-a368-48b4c130bd0c",
                        "target_lang_word": "brider",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brider",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ab784279-f44f-3e78-8b06-a5b7ff7f3399",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Mettre la bride à un cheval, à un mulet, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb55ef0-3212-44f9-9f6a-58263cb96f6c",
                                                "sense_id": "ab784279-f44f-3e78-8b06-a5b7ff7f3399",
                                                "text": "Brider un cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2db3bec7-1ba3-3f2a-b267-c9d8b009e50d",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Ficeler une volaille pour empêcher sa déformation pendant la cuisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab1c245-e639-4e97-8b53-75f9ac2b8c5f",
                                                "sense_id": "2db3bec7-1ba3-3f2a-b267-c9d8b009e50d",
                                                "text": "Ma mère vidait la volaille, la flambait et la bridait avec une longue aiguille recourbée en fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4852ee32-01c9-3766-bf76-7ce189cc46f9",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Trop serrer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "517ca922-d9ac-47e0-b890-c69469e6ccfb",
                                                "sense_id": "4852ee32-01c9-3766-bf76-7ce189cc46f9",
                                                "text": "Ce col me bride le cou."
                                            },
                                            {
                                                "example_id": "e9a97023-3e49-4f39-9d99-2c3f2c04cb4f",
                                                "sense_id": "4852ee32-01c9-3766-bf76-7ce189cc46f9",
                                                "text": "Il y avait quatre jours et quatre nuits qu’une douleur fixe me bridait le cœur et me tenait les yeux aussi secs que si je n’eusse jamais pleuré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c142eb79-8e2f-33c5-ae45-c4fac43be971",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Contenir, empêcher d’agir en toute liberté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e1d890-f0fc-48c4-9c35-fa6e356769e4",
                                                "sense_id": "c142eb79-8e2f-33c5-ae45-c4fac43be971",
                                                "text": "Concevez-vous qu’un de ses fermiers est venu lui dire qu’il avait appris d’un sorcier le secret de brider le renard en prononçant des paroles magiques ? Ce n’est pas cette arme-là que j’emploierai, et je m’engage à vous rapporter une demi-douzaine de belles peaux."
                                            },
                                            {
                                                "example_id": "3e1cf638-2ec5-40f2-b9c4-2a38019ea136",
                                                "sense_id": "c142eb79-8e2f-33c5-ae45-c4fac43be971",
                                                "text": "L'islam radical,[…], peut conduire à une cruelle répression. Des hommes qui refusent de brider leur raison seront taxés de Satans et se verront dénier leurs droits et leur qualité d'hommes."
                                            },
                                            {
                                                "example_id": "3681ebff-47fd-4ea8-84cb-9b2c21c7d708",
                                                "sense_id": "c142eb79-8e2f-33c5-ae45-c4fac43be971",
                                                "text": "Rubin Rabinovich me rappelle que je dois omettre le fait que les séances sont enregistrées, afin de ne pas brider mon propos."
                                            },
                                            {
                                                "example_id": "25529a6e-9165-4870-989d-7645bab7db5c",
                                                "sense_id": "c142eb79-8e2f-33c5-ae45-c4fac43be971",
                                                "text": "Il est bridé par un contrat dont les conditions l’obligent à s'installer dans la région."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd290553-a716-3343-bed8-0e69ab13bf54",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Limiter la puissance d'un moteur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3eef8894-6e20-3b79-bf3e-3890d596a2d4",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Ligaturer un cordage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "33486970-bd72-33d0-a184-13aef6867327",
                                        "entry_id": "0f68eda3-19b0-3507-950c-5a448b659404",
                                        "glosses": [
                                            "Étirer pour former une ouverture des paupières étroite, en parlant des yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c07aee-e4be-47dd-bc05-4c74365fe94c",
                                                "sense_id": "33486970-bd72-33d0-a184-13aef6867327",
                                                "text": "À l’arrivée de son maître, Lirot, couché à l’arrêt, se tut, et ses yeux se bridèrent en coulisse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
