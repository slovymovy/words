                "senses": [
                    {
                        "sense_id": "f33d64bd-7bfb-39c0-bb69-37dc1e65997a",
                        "entry_id": "ed8ad0b9-3fde-3909-bfb6-716cb43443c0",
                        "glosses": [
                            "Teil des Brillengestells, der auf dem Nasenrücken aufliegt und die Entstehung von Druckstellen verhindert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3b182d0-404e-4d27-a088-6fca7485260c",
                                "sense_id": "f33d64bd-7bfb-39c0-bb69-37dc1e65997a",
                                "text": "„Ein bequemes Nasenpolster absorbiert Schweiß und läßt sich der individuellen Gesichtsform anpassen.“"
                            },
                            {
                                "example_id": "c12e86dd-038f-4d91-bba4-1465e9918a7a",
                                "sense_id": "f33d64bd-7bfb-39c0-bb69-37dc1e65997a",
                                "text": "„Schweiß rinnt mir von den Nasenpolstern der riesigen dunklen Sonnenbrille übers Gesicht.“"
                            },
                            {
                                "example_id": "412a8525-1761-4184-8933-7018551d7eea",
                                "sense_id": "f33d64bd-7bfb-39c0-bb69-37dc1e65997a",
                                "text": "„Empfehlenswert sind Sport-Sonnenbrillen mit ergonomisch gestalteten Nasenpolstern und gummierten Bügelspitzen, die gut sitzen und beim Laufen nicht rutschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
