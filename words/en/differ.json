{
    "word_family": [
        "difference",
        "different",
        "differentiate",
        "differentiation",
        "indifferent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b4924cf-579a-34bd-89fb-a90d2119b4a6",
                    "sense_definition": "To be unlike or distinct in nature, quality, or form.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two sisters <w>differ</w> significantly in personality and interests.",
                            "target_lang_translations": {
                                "ru": "Две сестры значительно <w>отличаются</w> характерами и интересами.",
                                "zh": "这对姐妹在性格和兴趣上<w>不同</w>很大。"
                            }
                        },
                        {
                            "text": "These shoes only <w>differ</w> from those ones in having slightly longer laces.",
                            "target_lang_translations": {
                                "ru": "Эти туфли <w>отличаются</w> от тех только тем, что у них шнурки немного длиннее.",
                                "zh": "这两双鞋只是鞋带稍微长一点，除此之外并无<w>区别</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vary",
                        "contrast"
                    ],
                    "antonyms": [
                        "match"
                    ],
                    "common_phrases": [
                        "differ from",
                        "differ in",
                        "differ greatly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть непохожим или отличаться по природе, качеству или форме.",
                        "zh": "在性质、质量或形式上不相同或有区别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отличаться",
                                "target_lang_sense_clarification": "быть непохожим на кого-либо или что-либо"
                            },
                            {
                                "target_lang_word": "различаться",
                                "target_lang_sense_clarification": "иметь различия между собой (о нескольких объектах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不同",
                                "target_lang_sense_clarification": "指事物之间存在差异"
                            },
                            {
                                "target_lang_word": "有区别",
                                "target_lang_sense_clarification": "指在某些方面存在不同之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17678b66-7d52-34ab-a867-5a28ffb4f900",
                    "sense_definition": "To have diverging opinions or to disagree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to <w>differ</w> with you on the conclusion of this report.",
                            "target_lang_translations": {
                                "ru": "Я вынужден <w>не согласиться</w> с вами по поводу выводов этого отчета.",
                                "zh": "关于这份报告的结论，我不得不与你<w>意见不合</w>。"
                            }
                        },
                        {
                            "text": "Experts often <w>differ</w> on the best way to solve economic crises.",
                            "target_lang_translations": {
                                "ru": "Эксперты часто <w>расходятся во мнениях</w> относительно лучшего способа решения экономических кризисов.",
                                "zh": "专家们对于解决经济危机的最佳方法往往<w>意见不合</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dissent"
                    ],
                    "antonyms": [
                        "conform"
                    ],
                    "common_phrases": [
                        "beg to differ",
                        "differ with",
                        "opinions differ"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь расходящиеся мнения или не соглашаться.",
                        "zh": "持有不同的意见或不赞同。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расходиться во мнениях",
                                "target_lang_sense_clarification": "иметь разные точки зрения"
                            },
                            {
                                "target_lang_word": "не соглашаться",
                                "target_lang_sense_clarification": "выражать несогласие, спорить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见不合",
                                "target_lang_sense_clarification": "指双方观点存在分歧"
                            },
                            {
                                "target_lang_word": "不同意",
                                "target_lang_sense_clarification": "指表达不赞同的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4925364-6582-3770-9b47-ac2dc38c0d21",
                    "sense_definition": "To be separated by a specific quantity or value.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The numbers 3 and 21 <w>differ</w> by 18.",
                            "target_lang_translations": {
                                "ru": "Числа 3 и 21 <w>различаются</w> на 18.",
                                "zh": "数字3和21之间<w>相差</w>18。"
                            }
                        },
                        {
                            "text": "The two price estimates <w>differ</w> by only a few dollars.",
                            "target_lang_translations": {
                                "ru": "Две оценки стоимости <w>различаются</w> всего на несколько долларов.",
                                "zh": "这两份价格估算仅<w>相差</w>几美元。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "differ by"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь разницу в определенном количестве или значении.",
                        "zh": "在特定的数量或数值上存在差距。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "различаться",
                                "target_lang_sense_clarification": "иметь количественную разницу"
                            },
                            {
                                "target_lang_word": "отличаться",
                                "target_lang_sense_clarification": "иметь разницу в значении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相差",
                                "target_lang_sense_clarification": "指在数值或数量上存在差额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ea8ab06-c93f-362b-ae4b-8461ff0e74f6",
                    "sense_definition": "A computer program that compares files to identify changes.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should run a <w>differ</w> to see what lines of code have changed.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит запустить <w>программу сравнения</w>, чтобы увидеть, какие строки кода изменились.",
                                "zh": "你应该运行一个<w>差异比较工具</w>来看看哪些代码行发生了变化。"
                            }
                        },
                        {
                            "text": "The <w>differ</w> highlighted several discrepancies between the two documents.",
                            "target_lang_translations": {
                                "ru": "<w>Программа сравнения</w> выделила несколько несоответствий между двумя документами.",
                                "zh": "这个<w>比较程序</w>突显了这两份文档之间的几处不一致。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diff"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерная программа, которая сравнивает файлы для выявления изменений.",
                        "zh": "一种用于比较文件以识别更改的计算机程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "программа сравнения",
                                "target_lang_sense_clarification": "инструмент для поиска различий в файлах"
                            },
                            {
                                "target_lang_word": "дифф",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差异比较工具",
                                "target_lang_sense_clarification": "用于对比文件差异的软件"
                            },
                            {
                                "target_lang_word": "比较程序",
                                "target_lang_sense_clarification": "用于检测文件变动的程序"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}