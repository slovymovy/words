                {
                    "sense_id": "99160d14-b95e-396e-b86d-d7149db8e12c",
                    "sense_definition": "A small remnant, shred, or fragment of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Not a single <w>clout</w> of paper remained after the bonfire burned out.",
                            "target_lang_translations": {
                                "zh": "篝火熄灭后，连一小片纸张的<w>碎屑</w>都没有剩下。"
                            }
