                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4933a18-56ee-4d81-ade9-4e5f34ae62df",
                                "sense_id": "835ed6d4-dc05-3e97-b4f0-be18bf6b5b83",
                                "text": "По обыкновению, он зашёл к Григорью Александровичу, который его всегда кормил лакомствами."
                            },
                            {
                                "example_id": "cab29442-c88b-4940-8f12-603bc6aa834f",
                                "sense_id": "835ed6d4-dc05-3e97-b4f0-be18bf6b5b83",
                                "text": "Частенько к нам наведывался мамин соратник по борьбе с загрязнением окружающей среды Антон Александрович."
                            }
                        ]
                    }
