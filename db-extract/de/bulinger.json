                "senses": [
                    {
                        "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                        "entry_id": "27a79d25-6ba1-3a56-a085-82cb7ec4f1c8",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ebf767-f1ec-47a4-af14-5954e27275d7",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Der Bulinger trägt nie die Schals, die die Bulinger ihm strickt."
                            },
                            {
                                "example_id": "f0c3aaca-a187-4dc4-ba40-005845e63d2d",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bulinger kommt, geht der Herr Bulinger.“"
                            },
                            {
                                "example_id": "76a78050-35e9-40b8-afbd-ab155e3da33c",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Bulinger kommt und geht."
                            },
                            {
                                "example_id": "dd2ab986-3977-437c-aa7c-3702d4afa65c",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Bulingers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f68c046d-8152-45c3-8296-7bfb220eccfd",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Frau Bulinger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f5e4fcde-0fd7-4c21-8715-63d3f004839c",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Herr Bulinger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "3ac666d1-0860-434b-84dd-cc2db289bc9f",
                                "sense_id": "0467a2a8-2811-345f-b513-8c3a26ba7070",
                                "text": "Die Bulingers fliegen heute nach La Paz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
