                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We saw a <w>chuck</w> digging in the garden yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы видели <w>сурка</w>, копавшегося в саду.",
                                "zh": "昨天我们看到一只<w>土拨鼠</w>在花园里挖洞。"
                            }
                        },
                        {
                            "text": "The farmer tried to keep the <w>chucks</w> away from his crops.",
                            "target_lang_translations": {
                                "ru": "Фермер пытался держать <w>сурков</w> подальше от своего урожая.",
                                "zh": "农夫试图让<w>土拨鼠</w>远离他的庄稼。"
