                },
                {
                    "sense_id": "b0c1b5b2-c688-3399-97cc-1f923351d7a1",
                    "sense_definition": "proces wymiany informacji, myśli i uczuć między ludźmi",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interpersonal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dobra <w>komunikacja</w> w zespole jest kluczem do sukcesu każdego projektu.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>коммуникация</w> в команде — это ключ к успеху любого проекта.",
                                "en": "Good <w>communication</w> within a team is the key to the success of any project."
                            }
                        },
                        {
                            "text": "Uczymy się o różnicach między <w>komunikacją</w> werbalną a niewerbalną.",
                            "target_lang_translations": {
                                "ru": "Мы изучаем различия между вербальной и невербальной <w>коммуникацией</w>.",
                                "en": "We are learning about the differences between verbal and non-verbal <w>communication</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "wymiana",
                        "łączność"
                    ],
                    "antonyms": [
                        "izolacja"
                    ],
                    "common_phrases": [
                        "komunikacja werbalna",
                        "komunikacja niewerbalna",
                        "komunikacja interpersonalna",
                        "błąd w komunikacji"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс обмена информацией, мыслями и чувствами между людьми",
                        "en": "The process of exchanging information, thoughts, and feelings between people."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общение",
                                "target_lang_sense_clarification": "взаимодействие людей"
                            },
                            {
                                "target_lang_word": "коммуникация",
                                "target_lang_sense_clarification": "обмен информацией"
                            }
                        ],
                        "en": [
