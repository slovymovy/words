                                        "examples": [
                                            {
                                                "example_id": "bf960e6b-baea-43f8-aeb9-9d86874e0305",
                                                "sense_id": "546097be-f880-3428-bb7e-8c4b59b10987",
                                                "text": "The executives attend meetings in exotic locations while the rank and file stays at headquarters doing the bulk of the work."
                                            },
                                            {
                                                "example_id": "b49b75a7-db47-422e-a52c-0a25721bb9dc",
                                                "sense_id": "546097be-f880-3428-bb7e-8c4b59b10987",
                                                "text": "First, a prominent Tory called the party’s rank and file “swivel-eyed loons.”"
                                            },
                                            {
                                                "example_id": "787de3da-c219-4873-bc53-4a567277b3de",
                                                "sense_id": "546097be-f880-3428-bb7e-8c4b59b10987",
                                                "text": "Overnight, I have joined the rank and file of gym-bound office employees in their sneakers and suits. You know: the ones who walk around trailing sad little bags containing soggy towels and spare shoes and shampoo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "009d92a1-8c82-42de-85d8-b27e6a1f314d",
                        "source_entry_id": "a7c1c399-63ca-3c72-996a-aad272d7183b",
                        "source_sense_id": "5b30cc5d-2b29-32f7-a960-dcbfb603c519",
                        "source_sense_description": "Groupe de personnes de condition modeste, subalterne.",
                        "target_lang_word": "voetvolk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
