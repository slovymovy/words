                "senses": [
                    {
                        "sense_id": "8ba5a106-1d83-3042-befb-50bb62032a45",
                        "entry_id": "a7dabcdc-5225-30f2-8396-dbe073d49db7",
                        "glosses": [
                            "反对党，在野党"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621edbe2-f919-4d2a-98c9-eeaea149a5cf",
                                "sense_id": "8ba5a106-1d83-3042-befb-50bb62032a45",
                                "text": "Wo ist die Oppositionspartei, die nicht von ihren regierenden Gegnern als kommunistisch verschrieen worden wäre, wo die Oppositionspartei, die den fortgeschritteneren Oppositionsleuten sowohl, wie ihren reaktionären Gegnern den brandmarkenden Vorwurf des Kommunismus nicht zurückgeschleudert hätte?",
                                "translation": "有哪一个反对党不被它的当政的敌人骂为共产党呢？又有哪一个反对党不拿共产主义这个罪名去回敬更进步的反对党人和自己的反动敌人呢？"
                            }
                        ]
                    }
