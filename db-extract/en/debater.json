                                    {
                                        "sense_id": "e027fe83-548e-344c-915b-9b006d7ba2f1",
                                        "entry_id": "b0504018-a97a-3287-9d01-0c2567d78dd5",
                                        "glosses": [
                                            "kdo se účastní diskuse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
