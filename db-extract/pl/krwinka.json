                        "target_lang_word": "Blutkörperchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blutkörperchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f154367-2151-390d-b7d6-fef7d3b2cb44",
                                        "entry_id": "6a21f7d6-4be1-36d8-8cfd-b4e8eece4400",
                                        "glosses": [
                                            "im Blut frei bewegliche Zelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1c4cd4b-0143-4ff5-b263-17c99f732d4b",
                                                "sense_id": "7f154367-2151-390d-b7d6-fef7d3b2cb44",
                                                "text": "Die roten Blutkörperchen transportieren Sauerstoff durch den Körper."
                                            },
                                            {
                                                "example_id": "bc3ceae0-f8a7-4f95-849d-f4699b482fe9",
                                                "sense_id": "7f154367-2151-390d-b7d6-fef7d3b2cb44",
                                                "text": "„Kurz vor dem Urlaub (wie auch an den Oster- und Weihnachtsfeiertagen) schikaniert der Papa die Mama regelmäßig mit seinem Mangel an weißen Blutkörperchen und seinem nervösen Reizmagen.“"
                                            },
                                            {
                                                "example_id": "5295042f-5af0-4f13-9dd6-185e1a36c4a3",
                                                "sense_id": "7f154367-2151-390d-b7d6-fef7d3b2cb44",
                                                "text": "„‚Ich habe eine von unseren Xymos-Kameras unter dem Elektronenmikroskop, hier,‘ sie deutete auf den Monitor, ‚damit sie sie im Vergleich zu dem roten Blutkörperchen daneben sehen können.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
