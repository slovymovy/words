                "senses": [
                    {
                        "sense_id": "7d23fd2f-beb3-39dc-ab2d-af5afc3f6b7a",
                        "entry_id": "1edc15c4-e565-3104-81b5-0ae0a147e3d7",
                        "glosses": [
                            "durch planmäßiges Beschneiden zu bestimmten Formen herangezogene Holzgewächse, insbesondere Obstbäume"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142802a5-cfa1-43ab-95f9-215898ffef3f",
                                "sense_id": "7d23fd2f-beb3-39dc-ab2d-af5afc3f6b7a",
                                "text": "„In Tirol war dieser Apfel zwar schon seit langer Zeit bekannt und angebaut, doch wird er erst seit etwa 20 Jahren in grossem Ausmasse besonders als Formbaum gezogen.“"
                            },
                            {
                                "example_id": "fc30d2a3-4c60-4494-b566-e869b99278b9",
                                "sense_id": "7d23fd2f-beb3-39dc-ab2d-af5afc3f6b7a",
                                "text": "„Diese zarte und verwöhnte Sorte findet nur im geschützten Garten einen Platz als niedriger Formbaum.“"
                            },
                            {
                                "example_id": "3284c04d-c70e-429c-bf4c-33c7e142a50a",
                                "sense_id": "7d23fd2f-beb3-39dc-ab2d-af5afc3f6b7a",
                                "text": "„Als Formbaum wird er auf schwachwüchsige Unterlagen, wie Johannis- oder Paradiesstamm und auf Doucin- oder Splittapfel veredelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
