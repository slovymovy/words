                                            {
                                                "example_id": "80c30f1e-0465-4cd6-81c8-976b3205f0c4",
                                                "sense_id": "12b3807a-ab20-3a2e-aedf-f597356f980a",
                                                "text": "Derrière cette ville en miniature s’étendaient quinze cents hectares de plaines, bornées par un immense remblai de laves."
                                            },
                                            {
                                                "example_id": "0f42af2d-851d-4e88-8795-cc7b550df8bb",
                                                "sense_id": "12b3807a-ab20-3a2e-aedf-f597356f980a",
                                                "text": "En cet endroit, le remblai de terre sèche et dure portait des empreintes de pas."
                                            },
                                            {
                                                "example_id": "168863ea-4576-4188-8161-2e986db0358d",
                                                "sense_id": "12b3807a-ab20-3a2e-aedf-f597356f980a",
                                                "text": "Habituellement les terrains mouilleux qu'on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                                            }
                                        ]
