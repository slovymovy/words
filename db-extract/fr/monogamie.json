        "fr-extract.jsonl": [
            {
                "entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                "word": "monogamie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3964f69-6e6f-4ee6-93bb-a3bceb8a130e",
                        "entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                        "tags": [
                            "plural"
                        ],
                        "form": "monogamies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "83cc6320-bd8c-38dd-a8c0-43bb09b5ed31",
                        "entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                        "glosses": [
                            "État de mariage où une personne n’a qu’un·e seul·e partenaire, par opposition à la polygamie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1829aa81-4913-4200-8aac-f1f97a96fe44",
                                "sense_id": "83cc6320-bd8c-38dd-a8c0-43bb09b5ed31",
                                "text": "Et voici comment la Tunisie, qui, dès le XIIᵉ siècle, avait connu l'étonnant \"contrat kairouanais\" instituant une monogamie et des droits renforcés pour la femme, s'est mise à discuter d'une réintroduction de la polygamie dans la Constitution !"
                            },
                            {
                                "example_id": "b05f9104-0994-4490-bbd9-92e162400aa8",
                                "sense_id": "83cc6320-bd8c-38dd-a8c0-43bb09b5ed31",
                                "text": "En décembre, les députés avaient largement adopté un nouveau code civil, dont l’article 281 affirmait que « le mariage peut être conclu soit sous le régime de la monogamie, soit sous le régime de la polygamie limitée à quatre femmes »."
                            }
                        ]
                    },
                    {
                        "sense_id": "aafa03ed-f033-3437-a46b-870018a5f5b7",
                        "entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                        "glosses": [
                            "Forme de lien généralement sexuel impliquant un lien de couple permanent entre deux êtres"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "001ef9a1-960e-3cf0-8ddb-cdd744935b34",
                        "entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                        "glosses": [
                            "Caractère d’une classe du système de Carl von Linné, qui renferme les plantes dont les fleurs sont isolées les unes des autres et n’ont pas d’enveloppe commune."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d2926a3-ba7e-43bc-b13f-6356c3e97ab1",
                        "source_entry_id": "85bd6c50-38b1-3438-a807-3a2f2bd227dd",
                        "source_sense_description": "Unicité du mariage",
                        "target_lang_word": "Monogamie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monogamie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                        "entry_id": "0cf4b167-a657-35d6-8eb6-f6c1f565d1de",
                                        "glosses": [
                                            "Form der ausschließlichen Paarbeziehung zwischen zwei Individuen; das (zeitlich befristete oder permanente) monogame Zusammenleben; die Einehe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cfc8cd-a6d7-42db-a763-f9982cff2e3d",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "Wenn ein Mann und eine Frau nur mit einander verheiratet sind, leben sie in Monogamie."
                                            },
                                            {
                                                "example_id": "7708b462-d3d2-44fa-bc01-0b39f627aaae",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "„Er hatte immer die Meinung vertreten, daß strenge Monogamie nur etwas für Heilige sei.“"
                                            },
                                            {
                                                "example_id": "ff61b073-cb17-4888-912f-911b633f786e",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "„Beim Klang ihrer Stimme wurde ich zum erstenmal schwankend in meiner Monogamie.“"
                                            },
                                            {
                                                "example_id": "93d80c12-65ba-4f44-be39-9a2b7d3e470f",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "„Wird aus dieser befristeten Bindung jedoch eine unauflösliche lebenslange Monogamie, ist das einem verordneten Eheprinzip geschuldet, sprich gesetzlichen oder religiösen Vorschriften.“"
                                            },
                                            {
                                                "example_id": "31172783-2173-452f-8f98-66b034899ac5",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "„Die Römer setzten den Schwan aufgrund seiner Monogamie mit Treue gleich und gaben ihn der Venus als Attribut ihrer Schönheit.“"
                                            },
                                            {
                                                "example_id": "98409fec-9906-4e01-be1c-2ef7b0e16532",
                                                "sense_id": "9eba8fd4-dbf9-3a4b-84ad-dc53d4c284df",
                                                "text": "„Einige Säugethiere leben in Monogamie, andere in Polygamie; im ersteren Falle meist einzeln, nur zur Brunstzeit einander aufsuchend, im letzteren gesellig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a72ab87-1662-49be-83c6-bd14a1ec3ed4",
