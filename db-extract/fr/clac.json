        "fr-extract.jsonl": [
            {
                "entry_id": "e09843a2-d080-3555-b0b8-1a288941562b",
                "word": "clac",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                        "entry_id": "e09843a2-d080-3555-b0b8-1a288941562b",
                        "glosses": [
                            "Onomatopée qui traduit un bruit sec et rapide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db72c943-d02e-4664-a2b2-c5cd130511f6",
                                "sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                                "text": "N’allez pas par là! clacclac… la CHOSE est dans le quartier… clacclacclac…"
                            },
                            {
                                "example_id": "9921bc2f-3b86-4a51-a41a-10a6775a37a3",
                                "sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                                "text": "En bas du chemin Clic clac clic clac\nComme ma poupée dans sa poussette\nPassait par-dessus les fissures\nNous partirons très loin."
                            },
                            {
                                "example_id": "0414fae5-e15a-4040-9308-56378a5aa2c8",
                                "sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                                "text": "Quand j'étais petite, raconte Liliplum, j'ai harcelé ma mère pour qu'elle m'achète des bottines avec des petits talons qui faisaient clac clac."
                            },
                            {
                                "example_id": "d5ef718b-f598-4a8c-830e-a8774611c6a7",
                                "sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                                "text": "Et elle lui aurait décoché des coups, des bien sentis et des directs, elle l'aurait explosée comme un fruit juteux et tendu, clac !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92b2a0e8-3342-4ae3-b31a-cd5603a966a4",
                        "source_entry_id": "e09843a2-d080-3555-b0b8-1a288941562b",
                        "source_sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                        "target_lang_word": "clack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d272fba4-4c75-3dd1-b867-a4a150dbb5b4",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "An abrupt, sharp sound, especially one made by two hard objects colliding repetitively; a sound midway between a click and a clunk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b63830ef-5009-3081-bc9b-b5a3be23c5c5",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "Anything that causes a clacking noise, such as the clapper of a mill, or a clack valve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74348e89-86bf-33fe-8394-21adfedd6674",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "Chatter; prattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c481db19-e5aa-4950-bc12-af196bd8ba51",
                                                "sense_id": "74348e89-86bf-33fe-8394-21adfedd6674",
                                                "text": "whose chief intent is to vaunt his spiritual clack"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdb61267-c36b-3401-bfd9-b997fe128da1",
                                        "entry_id": "4cf03b93-054f-3606-a342-ab9cb0f6d835",
                                        "glosses": [
                                            "The tongue."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To make a sudden, sharp noise, or succession of noises; to click."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1d5d8fc-d3e6-4d4d-9c30-a0e45d50487c",
                                                "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                                "text": "We heard Mr. Hodson's whip clacking on the shoulders of the poor little wretches."
                                            },
                                            {
                                                "example_id": "dee69252-01d6-4e22-909f-3dbed187cb3c",
                                                "sense_id": "2b8d754c-8184-327a-a27b-f7d3ecdb3967",
                                                "text": "[He] walked quite jauntily across the courtyard to the distant door, his sandals clacking against the marble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa03ea1-2e11-364f-912f-4fe43b0c2c30",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To cause to make a sudden, sharp noise, or succession of noises; to click."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To chatter or babble; to utter rapidly without consideration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e332e6e-2629-4a06-9790-fbe890964e34",
                                                "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                                "text": "There is a generation of men, whose unweighed custome makes them clack out any thing their heedleſs fancy ſprings"
                                            },
                                            {
                                                "example_id": "d1f90304-f3aa-4609-813e-cada8d07a094",
                                                "sense_id": "597c8acd-ca6d-30a1-a996-cea594048ee0",
                                                "text": "The women bunched up in little droves and let their tongues clack, and the men herded together and passed a jug around and, to tell the truth, let their tongues clack too."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aea8478c-835f-3b88-844e-5f6e972f720e",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "To cut the sheep's mark off (wool), to make the wool weigh less and thus yield less duty."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                        "entry_id": "4d9dbdeb-0d00-3129-8821-eec22b34424c",
                                        "glosses": [
                                            "Dated form of cluck."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8894293e-1f58-472d-8851-02bf5ba1defe",
                                                "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                                "text": "Only the chickens clacked at the Saturday quiet and fat mouse-minded cats licked whiskers on the empty steps."
                                            },
                                            {
                                                "example_id": "71deaf3b-46df-4a1c-820f-e1e9d5e64384",
                                                "sense_id": "5bc78ead-3c36-349b-a075-278e4be228d5",
                                                "text": "We drive on between meadows of mown grass, through a pergola of vines, and so to an orchard of peaches, apples, and pears and a hen colony housed in neat modern cottages, the chickens clacking and scratching away […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bf228f9-2791-4729-861d-b6f9ab62ec9b",
                        "source_entry_id": "e09843a2-d080-3555-b0b8-1a288941562b",
                        "source_sense_id": "956e0eb5-990a-304a-b2db-7feeffb5494a",
                        "target_lang_word": "clang",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To strike (objects) together so as to produce a clang."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb01b818-2004-43a9-9a62-525372a15fde",
                                                "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                                "text": "Around, the first Curetes (order solemn / To thy foreknowing mother!) trod tumultuous / Their mystic dance, and clanged their sounding arms; [...]"
                                            },
                                            {
                                                "example_id": "ab8e3755-5a76-48be-a7e5-bf5f8ae7f0e1",
                                                "sense_id": "e611a254-1795-3f7a-803c-e18527046e18",
                                                "text": "A dented metal punching bag waiting to be clanged; a solitary object in the rhino's cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To give out a clang; to resound."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10fee94d-2d6e-481d-9a37-fae7fcc189c6",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "Middlesbrough will wonder whether it might have been different if the volley that Jelle Vossen slashed towards John Ruddy’s net after nine minutes had been a couple inches lower rather than clanging off the crossbar. They should not dwell on that moment too long, however."
                                            },
                                            {
                                                "example_id": "638113f4-85fc-4933-9ccf-49fbd4e811ac",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "A cell door clanged metallically and Wentworth was flung inside. He tripped, collapsed upon the concrete floor."
                                            },
                                            {
                                                "example_id": "761714eb-cdca-40c6-bbdb-91037b3d5657",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "The clanging and groaning of the train came nearer, and it staggered slowly into the station like a prey- laden monster into its lair."
                                            },
                                            {
                                                "example_id": "32904c64-6179-408a-9458-274f74a09498",
                                                "sense_id": "c5c9900c-885c-30d5-9a3f-8018da207fb2",
                                                "text": "Then the sparks flew from the anvil while the great hammer clanged on the metal, shaping it, and Henry begged to be allowed to try it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18160406-d0c1-3b62-82f8-5e79b07dde84",
                                        "entry_id": "f9bc46bf-e88d-3afe-8865-4f96bb0ece9c",
                                        "glosses": [
                                            "To utter a word or phrase linked only by sound and not by meaning, characteristic of some mental disorders."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clang",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6a17c-cf59-33b2-8933-b9b9cef42ccb",
                                        "entry_id": "58a02a62-5d83-3e6c-8675-c2fd4825a9e7",
