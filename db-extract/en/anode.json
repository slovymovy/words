                    {
                        "translation_id": "aade2755-fb6b-491b-80e9-8b527674e3f9",
                        "source_entry_id": "f505a42b-832e-382e-9d47-84dbb88b4654",
                        "source_sense_description": "the electrode of an electrochemical cell at which oxidation occurs",
                        "target_lang_word": "anode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
