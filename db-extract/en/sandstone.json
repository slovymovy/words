                        "target_lang_word": "Sandstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sandstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81b2ec36-c8da-3ecd-b4e3-40ddb29a9c34",
                                        "entry_id": "9c971c3a-18a5-3010-8c3d-4e98083ab20d",
                                        "glosses": [
                                            "Gestein aus durch ein Bindemittel verbundenen Sandkörnern"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b05e32-084b-488a-ac08-f670a8365d8f",
                                                "sense_id": "81b2ec36-c8da-3ecd-b4e3-40ddb29a9c34",
                                                "text": "„Ein sogenannter Sandstein besteht fast nur aus Quarz, Quarz ist sehr standhaft gegen Verwitterung und deshalb in sehr vielen Steinsorten anzutreffen.“"
                                            },
                                            {
                                                "example_id": "17aebbaa-a8e3-4219-a84a-a620b3235845",
                                                "sense_id": "81b2ec36-c8da-3ecd-b4e3-40ddb29a9c34",
                                                "text": "„Er kennt den Duft der Kirschbäume im Sommer und den feinen Staub des Sandsteins, der sich auf die Schuhe legt wie Schnee.“"
                                            },
                                            {
                                                "example_id": "7860cf21-579b-48e0-97fe-6e513eec6867",
                                                "sense_id": "81b2ec36-c8da-3ecd-b4e3-40ddb29a9c34",
                                                "text": "„Die hierbei entstandenen Ablagerungen setzen sich an einigen Stellen des Alpenrandes aus groben. stark verkitteten Konglomeraten, der Nagelfluh, an andren aus Sandsteinen und Mergeln zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e3c73743-8684-38df-b440-39dea3f654da",
                                        "entry_id": "9c971c3a-18a5-3010-8c3d-4e98083ab20d",
                                        "glosses": [
                                            "Stein aus Sandstein^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf32a88b-8fee-4411-9b4f-3d4824c39c7b",
                                                "sense_id": "e3c73743-8684-38df-b440-39dea3f654da",
                                                "text": "„Die hierbei entstandenen Ablagerungen setzen sich an einigen Stellen des Alpenrandes aus groben. stark verkitteten Konglomeraten, der Nagelfluh, an andren aus Sandsteinen und Mergeln zusammen.“"
                                            },
                                            {
                                                "example_id": "152bd1e1-e556-4eb5-8284-88ca74891e91",
                                                "sense_id": "e3c73743-8684-38df-b440-39dea3f654da",
                                                "text": "„Vom Fenster aus blickte man auf die schwarzen Eisenzäune, die von hohen Pfeilern aus Sandstein gehalten wurden.“"
                                            },
                                            {
                                                "example_id": "5e3e3fca-88f7-4ddf-bdfc-7c741a2ad0e5",
                                                "sense_id": "e3c73743-8684-38df-b440-39dea3f654da",
                                                "text": "„Blöcke von rotem Sandstein ragten hier und da auf, und größere Felsen bildeten in der Ferne eine Art Klippe, die über die mit reifem Getreide bedeckten Felder hiausragte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
