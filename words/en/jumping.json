                    "sense_definition": "Present participle and gerund of <w>jump</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>jumping</w> on the bed despite the rules.",
                            "target_lang_translations": {
                                "ru": "Дети <w>прыгают</w> на кровати, несмотря на правила.",
                                "zh": "尽管有规定，孩子们还是在床上<w>跳</w>。"
                            }
                        },
                        {
                            "text": "He was <w>jumping</w> up and down with excitement when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Он <w>прыгал</w> от радости, когда услышал новости.",
                                "zh": "他听到这个消息时，兴奋得又<w>跳</w>又叫。"
                            }
                        }
                    ],
                    "common_phrases": [
