                "senses": [
                    {
                        "sense_id": "a96bb63e-7ca2-3de4-9f54-43cd38bc4564",
                        "entry_id": "d0004aa7-6fbc-315b-918a-892c54e5c35d",
                        "glosses": [
                            "Empaqueter (du matériel génétique) à l’intérieur d’une capside virale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83499e1-8f30-45ab-9d7c-dc129af9b28a",
                                "sense_id": "a96bb63e-7ca2-3de4-9f54-43cd38bc4564",
                                "text": "En outre, chaque bout du vecteur comporte les sites cos (bouts collants) nécessaires pour encapsider l'ADN au sein des particules de phage."
                            },
                            {
                                "example_id": "e433d49f-d9c1-4555-9aa8-f44415bbf552",
                                "sense_id": "a96bb63e-7ca2-3de4-9f54-43cd38bc4564",
                                "text": "Ce transfert dépend avant tout de la capacité de certains phages d’encapsider, en plus ou à la place de l’ADN phagique, de l’ADN de l’hôte."
                            }
                        ]
                    }
                ],
