                        "glosses": [
                            "Garde des empereurs byzantins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82a004f-14db-4148-a8e2-a3b0615f8a01",
                                "sense_id": "e863bfa4-4aff-396f-a236-a43029296bd2",
                                "text": "Les bardariotes étaient des soldats de la garde de l’Empereur de Constantinople ; ils étaient armés de bâtons & de baguettes, pour écarter le peuple quand l’Empereur passait, ils portaient à leur ceinture des fouets pour punir ceux qui étoient condamnés. Ils étaient gardes des portes du Palais. Dans les cavalcades que faisait l’Empereur, ils marchaient devant lui, le bâton haut, pour faire ranger le peuple & le tenir dans l’ordre."
                            }
                        ]
                    }
