                        "examples": [
                            {
                                "example_id": "b056f7d8-ef30-4570-9a73-16c8541c56bd",
                                "sense_id": "0d2c1341-58d6-35ce-a05e-1f322d0f04ef",
                                "text": "„Der verschrumpelte Leichnam hing am Querbalken, ein Wesen aus Leder und Knochen, blankgewetzt von den bimssteinhaltigen, vom See heraufwehenden Winden, der Mund eine klaffende schrundige Höhle, hinter den am Brustkorb baumelnden Hautfetzen schimmerte das fahle Rippengerüst hervor.“"
                            }
