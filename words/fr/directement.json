{
    "word_family": [
        "direct",
        "indirect",
        "direction",
        "diriger",
        "directeur",
        "directrice",
        "directive",
        "directif"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3a7062bc-38de-3577-9f18-4b40102295af",
                    "sense_definition": "D'une manière directe, sans faire de détour ni d'arrêt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction_mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'école, les enfants rentrent <w>directement</w> à la maison pour faire leurs devoirs."
                        },
                        {
                            "text": "Ce train va <w>directement</w> à Paris sans faire aucun arrêt."
                        }
                    ],
                    "antonyms": [
                        "indirectement"
                    ],
                    "common_phrases": [
                        "aller directement",
                        "rentrer directement"
                    ]
                },
                {
                    "sense_id": "6a758e49-4f8d-35f0-8cd9-f3191471c4fd",
                    "sense_definition": "Sans passer par un intermédiaire ou une tierce personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relation_intermediaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si vous avez un problème, vous devriez vous adresser <w>directement</w> au directeur."
                        },
                        {
                            "text": "Nous pouvons contacter <w>directement</w> le propriétaire pour négocier le prix de location."
                        }
                    ],
                    "antonyms": [
                        "indirectement"
                    ],
                    "common_phrases": [
                        "contacter directement"
                    ]
                },
                {
                    "sense_id": "563e9979-9594-38cd-aa97-257c192ed59c",
                    "sense_definition": "En ligne droite, tout droit ou exactement vis-à-vis dans l'espace.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "position_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La boulangerie se trouve <w>directement</w> en face de la gare centrale."
                        },
                        {
                            "text": "Le chemin mène <w>directement</w> vers le sommet de la colline."
                        }
                    ],
                    "common_phrases": [
                        "directement en face"
                    ]
                },
                {
                    "sense_id": "f3fd1cc2-be89-3267-a124-20ddcd05158c",
                    "sense_definition": "De façon absolue ou diamétrale, en parlant d'une opposition ou d'une contrariété.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition_degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses propositions sont <w>directement</w> opposées aux principes fondamentaux de notre association."
                        },
                        {
                            "text": "Le résultat de cette étude est <w>directement</w> contraire à nos attentes initiales."
                        }
                    ],
                    "synonyms": [
                        "absolument",
                        "diamétralement",
                        "entièrement",
                        "radicalement"
                    ],
                    "common_phrases": [
                        "directement opposé"
                    ]
                }
            ]
        }
    ]
}