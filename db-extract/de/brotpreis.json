                ],
                "senses": [
                    {
                        "sense_id": "7776084c-4e96-3e4b-b75c-599bcf4c3b8c",
                        "entry_id": "89c436f8-b6e4-3b19-9cb3-f46b7c61819e",
                        "glosses": [
                            "Preis für Brot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9a0c94-f4b6-4eab-acae-e929b3425a76",
                                "sense_id": "7776084c-4e96-3e4b-b75c-599bcf4c3b8c",
                                "text": "„Die Frage hatte die öffentliche Meinung schon lange beschäftigt, als die Berkshirer Friedensrichter bei ihrer Sitzung im Mai 1795 die im Kirchspiele Speenhamland üblichen Arbeiterlöhne im Verhältnisse zu dem Brotpreise viel zu niedrig fanden.“"
                            },
                            {
                                "example_id": "9a78ffa1-61f7-4adb-a6c7-8ae465ec6557",
                                "sense_id": "7776084c-4e96-3e4b-b75c-599bcf4c3b8c",
                                "text": "„Es drängt ihn, diese Stadt zu verlassen, wo eine Masse arbeitsloser Künstler vegetiert, die Theater vor dem Bankrott stehen und der Brotpreis täglich steigt.“"
                            },
                            {
                                "example_id": "1ec8920b-4ef7-423e-a6ce-e05923728018",
                                "sense_id": "7776084c-4e96-3e4b-b75c-599bcf4c3b8c",
                                "text": "„Ich habe in diesen sieben Jahren die Preise zu genau erfahren, um das Wort preiswert noch zu mögen: nichts ist preiswert, und die Brotpreise sind immer um ein weniges zu hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
