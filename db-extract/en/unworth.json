                    {
                        "sense_id": "3d77ffd7-6068-3bbf-a7c1-90328691adf4",
                        "entry_id": "e13a27a5-d1e7-3f11-9b14-7f951bc9143b",
                        "glosses": [
                            "Not worth; not deserving of."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4c364016-f1e9-448e-a792-a44857614917",
                                "sense_id": "3d77ffd7-6068-3bbf-a7c1-90328691adf4",
                                "text": "This was rather pleasant, for she had to give Peter her hand, and so life became less unworth living to Peter."
                            },
                            {
                                "example_id": "47abe30b-67c4-4e8c-ac05-65fed9c7b46e",
                                "sense_id": "3d77ffd7-6068-3bbf-a7c1-90328691adf4",
                                "text": "That would be something not unworth boasting about--that he, a sort of eighteenth-century David, should slay this modern Goliath."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "8b261827-2284-3913-90db-a53e7dfdc112",
                "word": "unworth",
