                        "examples": [
                            {
                                "example_id": "997844c7-edb1-4b65-bbdb-f930ef72d499",
                                "sense_id": "685c451b-53d5-3725-8f8f-6623f1d6dcfa",
                                "text": "Потом сам отправлялся вперёд выбирать позицию для привала, осматривал её, дожидался жолнёров, расставлял их, встречал дивизию, размещал полки."
                            },
                            {
                                "example_id": "a7972eaa-4f78-46c3-b124-24d063b58698",
                                "sense_id": "685c451b-53d5-3725-8f8f-6623f1d6dcfa",
                                "text": "[Суворов] воззрился на Новикова, у которого на штыке желтел жолнёрский флажок, и крикнул, как будто сердито: — Жолнёр, штык выше!"
                            }
                        ]
                    }
