                                        "sense_id": "24684daf-0002-3c26-83c1-7e985cfdc2bb",
                                        "entry_id": "90e31598-a92d-3f2f-9f26-53b3e06f69ec",
                                        "glosses": [
                                            "In comfortable circumstances as regards property; forehanded."
                                        ],
