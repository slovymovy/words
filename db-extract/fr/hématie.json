                "senses": [
                    {
                        "sense_id": "f6cd8db0-c853-3cf5-b020-364a6008db41",
                        "entry_id": "deb0843f-4b8d-38ed-bb65-1fab9e2fb45a",
                        "glosses": [
                            "Cellule présente dans le sang servant à transporter le dioxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ba2a14-ac5e-4ce1-8881-0905bcebe768",
                                "sense_id": "f6cd8db0-c853-3cf5-b020-364a6008db41",
                                "text": "L’hématocrite (volume occupé par les hématies dans le sang) est de 45 % en moyenne, leur diamètre est de 7,4 µm chez l’homme."
                            },
                            {
                                "example_id": "1cab07d8-57b2-4c8a-a293-e787c0a71379",
                                "sense_id": "f6cd8db0-c853-3cf5-b020-364a6008db41",
                                "text": "Le gaz carbonique des tissus passe par diffusion dans le plasma sanguin, puis forme dans les hématies et le plasma, des composés carbonatés."
                            },
                            {
                                "example_id": "11c8fdb2-36be-4354-a661-cdf61cc75985",
                                "sense_id": "f6cd8db0-c853-3cf5-b020-364a6008db41",
                                "text": "L’hématie mature est un disque biconcave ayant un diamètre de 7,8 µm et une épaisseur de 1,7 µm."
                            }
                        ]
                    }
                ],
                "translations": [
