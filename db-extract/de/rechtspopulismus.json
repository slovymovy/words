                        "form": "dem Rechtspopulismus"
                    },
                    {
                        "form_id": "a3cd2e3c-4d7b-4b98-a305-e007a1842d8c",
                        "entry_id": "23336992-2c09-3956-97a9-bc52b4d34525",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rechtspopulismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                        "entry_id": "23336992-2c09-3956-97a9-bc52b4d34525",
                        "glosses": [
                            "eine demagogische sich volksnah gebende Politik, die rechtsextreme Inhalte propagiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48c19188-2ac5-4f2e-9688-e581cb9eb053",
                                "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                                "text": "Der französische Präsident appelliert an die Europäer, die liberale Demokratie gegen \"Autoritarismus\" und Rechtspopulismus zu verteidigen."
                            },
                            {
                                "example_id": "796e7218-517f-4434-a745-951d50d13d55",
                                "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                                "text": "Ich glaube, dass […] der Rechtspopulismus […] seinen Zenit überschritten hat."
                            },
                            {
                                "example_id": "6d034187-0532-4362-b117-22cf1be51f37",
                                "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                                "text": "Der Rechtspopulismus greift reale Probleme in dieser Gesellschaft auf, die von bestimmten Teilen der herrschenden Eliten bisher nicht richtig ernst genommen worden sind, und die jetzt die Quittung dafür bekommen haben."
                            },
                            {
                                "example_id": "487200d0-7731-4116-9d02-181d87d056c2",
                                "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                                "text": "Wir klären auf jeden Fall auch auf über die AfD. Zum Beispiel haben wir vor, jetzt vor der Bundestagswahl in der Innenstadt von Celle über Rechtspopulismus zu informieren."
                            },
                            {
                                "example_id": "e8281c51-8c37-43a3-ba9e-86b609d94746",
                                "sense_id": "a40f3ac4-232a-38dd-9ffe-9e0aa19a0751",
                                "text": "[…] Und auch der Wikipedia-Eintrag von Sachsen änderte sich am Donnerstag. Am Nachmittag war das Kapitel \"Rassismus\" umbenannt in \"Rechtspopulismus und Rechtsextremismus\" – und war gekürzt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
