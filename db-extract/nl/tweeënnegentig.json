                    {
                        "sense_id": "1699defb-cc63-3b60-a570-2d5b74afab99",
                        "entry_id": "04ba83e9-2c8d-3dce-946e-62783270f705",
                        "glosses": [
                            "dat wat in een (rang)ordening met 92 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a6d11a0-a23a-4138-a6d5-9836aadc731c",
                                "sense_id": "1699defb-cc63-3b60-a570-2d5b74afab99",
                                "text": "Het is weer de tweeënnegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "59addd98-3c90-4aad-b802-63bb55343b5c",
                                "sense_id": "1699defb-cc63-3b60-a570-2d5b74afab99",
                                "text": "Haar drieënnegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de tweeënnegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "54886e87-e8bc-39e1-8a7a-e1ac6f32f499",
                        "entry_id": "04ba83e9-2c8d-3dce-946e-62783270f705",
                        "glosses": [
                            "groep van 92 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89abad24-723c-403d-9dd6-e16516667704",
                                "sense_id": "54886e87-e8bc-39e1-8a7a-e1ac6f32f499",
                                "text": "De tweeënnegentig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
