                "senses": [
                    {
                        "sense_id": "cbc6b315-4fa0-32ef-9f70-0cf477622a58",
                        "entry_id": "dba65a52-7428-3bbc-a56e-9dc35238765e",
                        "glosses": [
                            "niet verantwoordelijk te stellen voor zijn daden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dccae171-2237-4a3f-87d5-d0ab4aa9a943",
                                "sense_id": "cbc6b315-4fa0-32ef-9f70-0cf477622a58",
                                "text": "Wat velen er toe beweegt ontoerekenbaar te vervangen door ontoerekeningsvatbaar, een domme, klakkeloze vertaling van het Duitse unzurechnungsfähig, is een raadsel. Iemand is vatbaar voor besmetting of voor indrukken, maar vatbaar voor toerekening is een onmogelijkheid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba37c617-ff43-44a3-8768-965b9cf51d44",
                        "source_entry_id": "dba65a52-7428-3bbc-a56e-9dc35238765e",
                        "source_sense_id": "cbc6b315-4fa0-32ef-9f70-0cf477622a58",
                        "target_lang_word": "unzurechnungsfähig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unzurechnungsfähig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                        "entry_id": "e05c3db0-45f4-3011-86bc-0c5a0376e0f0",
                                        "glosses": [
                                            "nicht (mehr) bei klarem Verstand sein; nicht in der Lage, das Unrecht der eigenen Handlungen zu erkennen und daher nicht schuldfähig"
                                        ],
                                        "tags": [
                                            "Steigerung selten",
                                            "in Bezug auf Personen",
                                            "häufig im juristischen Umfeld/vor Gericht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb65be88-6a68-466e-9050-a31de27eab4a",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„»Etete kann das Geld riechen. Wenn der 70-Jährige bei 1,2 Milliarden die Nase rümpft, ist der Typ doch komplett unzurechnungsfähig.«“"
                                            },
                                            {
                                                "example_id": "85dfd811-5e68-44e4-a429-e581f2d9de48",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "[Saudi-Arabien:] „Für den Fall also, dass der König oder der Kronprinz stirbt, schwer erkrankt oder für unzurechnungsfähig erklärt wird, kann die Kommission einen Nachfolger bestimmen.“"
                                            },
                                            {
                                                "example_id": "0c4fffa7-6d41-4b47-b8fb-7897bea8f36c",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "[Schloss Neuschwanstein:] „Noch waren nicht alle Räume fertig, da wurde der König 1866 von der bayerischen Regierung als unzurechnungsfähig abgesetzt (und ertrank bekanntlich kurz daraus im Starnberger See).“"
                                            },
                                            {
                                                "example_id": "d06b89c4-2938-42aa-b4fc-4c58949aa6e4",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "In Deutschland gilt der strafrechtliche Grundsatz: Keine Strafe ohne Schuld. Es kann demnach derjenige nicht schuldhaft handeln, der unzurechnungsfähig ist, sodass dieser bei einem Prozess straffrei ausgehen muss!"
                                            },
                                            {
                                                "example_id": "e6f8561d-9051-4436-add5-2a3841dba8a7",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Zwei Psychiater haben im Auftrag des Gerichts den Norweger Anders Breivik beurteilt und ihn für unzurechnungsfähig erklärt.“"
                                            },
                                            {
                                                "example_id": "c24372e7-891f-405e-af19-95ada0abd2c7",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Er wurde jedoch wegen einer Psychose infolge von Cannabis- und Alkoholkonsum vor Gericht für unzurechnungsfähig erklärt und sitzt nun für mindestens 20 Jahre in der Psychiatrie.“"
                                            },
                                            {
                                                "example_id": "9fe6912c-54ae-4d5d-97eb-a5b4d5ef53e7",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Becher wurde wegen Tötung auf Verlangen angeklagt, entging jedoch auf Betreiben seines Vaters, eines Richters am Oberlandesgericht München, der Verurteilung, indem er für unzurechnungsfähig erklärt wurde.“"
                                            },
                                            {
                                                "example_id": "a5bca3e9-6eda-4f48-9244-43a9bcb2b893",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Nach der Attacke auf den Bürgermeister von Dimbach (Bezirk Perg) wurde der mutmaßliche Täter in einem Gutachten als unzurechnungsfähig eingestuft. Der Verdächtige wurde in eine psychiatrische Einrichtung gebracht.“"
                                            },
                                            {
                                                "example_id": "ad534c4f-93b6-4bc2-a609-56487bdfa65c",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Brudos gestand die Morde und bekannte sich vor Gericht schuldig, als klar war, dass er nicht für unzurechnungsfähig erklärt werden würde.“"
                                            },
                                            {
                                                "example_id": "c8b95bd5-088a-4ae0-8e0b-851d50ec4906",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Aufgrund seiner öffentlichen Kritik wurde er mehrfach verhaftet, für eine Anklage fehlten den russischen Staatsanwälten bislang ausreichende Gründe. Auch der Versuch, Pawlenski für unzurechnungsfähig erklären zu lassen, scheiterte.“"
                                            },
                                            {
                                                "example_id": "60dabc7f-6496-46e2-ac39-061d6ca7f734",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Im Jahr 2014 hatte der Oberste Gerichtshof der USA darüber zu entscheiden, bis zu welchem IQ ein Täter als unzurechnungsfähig zu gelten habe und daher im Falle eines Todesurteils nicht hingerichtet werden dürfe.“",
                                                "translation": "mit Steigerung:"
                                            },
                                            {
                                                "example_id": "91f073bb-171b-4e51-8fc9-8c8318399b99",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Einen unzurechnungsfähigeren Menschen habe ich nie kennengelernt.“"
                                            },
                                            {
                                                "example_id": "84c7269c-c474-439e-a16a-898a1f1146b5",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Die Schwiegereltern reisten ab, und ich war nun mit dem immer unzurechnungsfähigeren Pavlos allein zu Hause.“"
                                            },
                                            {
                                                "example_id": "8bdf7608-5e34-4169-952c-1ea11a885700",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Ohne im geringsten wegen Injurien belangt werden zu können, erklärt er sie für die albernste, unzurechnungsfähigste Gans, die jemals dem Vogelsang durch ihr Gegacker und Geschnatter die Harmonie gestört habe.“"
                                            },
                                            {
                                                "example_id": "d808c05a-3d2c-446a-a271-880de4f89bc3",
                                                "sense_id": "30aa3ffc-fa85-3634-99e4-54b55d9ea004",
                                                "text": "„Nachdem sie mir glaubhaft versichert hat, dass ich der verrückteste und unzurechnungsfähigste Bruder der Welt sei, machten wir uns auf den Heimweg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6efac94e-ec62-438d-bace-25ebae46ea0f",
                        "source_entry_id": "dba65a52-7428-3bbc-a56e-9dc35238765e",
                        "source_sense_id": "cbc6b315-4fa0-32ef-9f70-0cf477622a58",
                        "target_lang_word": "insane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68b5d894-6d8b-3571-a62a-198dae0d8bbb",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Exhibiting unsoundness or disorder of mind; not sane; utterly mad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b04223ef-b9ce-4efb-9bcb-e4dbceb6246b",
                                                "sense_id": "68b5d894-6d8b-3571-a62a-198dae0d8bbb",
                                                "text": "And you told me not to drive\nBut I made it home alive\nSo you said that only proves that I'm insane"
                                            },
                                            {
                                                "example_id": "94327a85-37a8-42f6-939e-d9fb5549ef0b",
                                                "sense_id": "68b5d894-6d8b-3571-a62a-198dae0d8bbb",
                                                "text": "What is the cause of insanity? Nobody can answer such a sweeping question as that, but we know that certain diseases, such as syphilis, break down and destroy the brain cells and result in insanity. In fact, about one-half of all mental diseases can be attributed to such physical causes as brain lesions, alcohol, toxins, and injuries. But the other half—and this is the appalling part of the story—the other half of the people who go insane apparently have nothing organically wrong with their brain cells. In post-mortem examinations, when their brain tissues are studied under the highest-powered microscopes, they are found to be apparently just as healthy as yours and mine. Why do these people go insane?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e74943b7-697e-3fa5-82e9-6b1ff75a1982",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Used by or relating to insane people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177e9382-c645-4192-aa92-dfc63448cefe",
                                                "sense_id": "e74943b7-697e-3fa5-82e9-6b1ff75a1982",
                                                "text": "an insane hospital"
                                            },
                                            {
                                                "example_id": "d326f07f-47f1-4367-a6d0-accc072adbbb",
                                                "sense_id": "e74943b7-697e-3fa5-82e9-6b1ff75a1982",
                                                "text": "an insane asylum"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8daca822-1c91-3982-b4ff-f421601b3206",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Causing insanity or madness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e64083a1-be49-4d74-a3ec-5ac226cef294",
                                                "sense_id": "8daca822-1c91-3982-b4ff-f421601b3206",
                                                "text": "Were such things here, as we doe speake about? / Or haue we eaten on the insane Root, / That takes the Reason Prisoner?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Characterized by excess or the utmost folly; ridiculous; impractical."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c3e555-f34e-4516-9d70-cf53c7557e86",
                                                "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                                "text": "an insane plan"
                                            },
                                            {
                                                "example_id": "2c77085f-3d10-4606-a700-e9b054461c5b",
                                                "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                                "text": "an insane amount of money"
                                            },
                                            {
                                                "example_id": "3ab8db3e-5a87-4f91-8489-9bcc963afeb6",
                                                "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                                "text": "The preposterous altruism too![…]Resist not evil. It is an insane immolation of self—as bad intrinsically as fakirs stabbing themselves or anchorites warping their spines in caves scarcely large enough for a fair-sized dog."
                                            },
                                            {
                                                "example_id": "60b83ec4-26e7-4114-a9cc-b843b7eb5fe8",
                                                "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                                "text": "Yenshui is a fairly ordinary town situated between Tainan and Chiayi. However, during the Lantern Festival, on the 15th day of the first moon, the whole town goes insane."
                                            },
                                            {
                                                "example_id": "8d5b9d0b-c216-454f-8dec-d200e399a6b2",
                                                "sense_id": "e6dd4ec3-f700-3b99-beef-60044ff529a1",
                                                "text": "And what actinic, mind-wrenching form could the countermeme take? How could human hands assemble something so devastatingly powerful and hold it steady; what human mind could wield it without exploding from the inside out? What would deploying that concept in anger do to human ideatic space? How far out from the solution is modern memetic science, a year, a century? What insane impossibility has Hughes just committed himself to?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f830a332-614f-3d49-ba84-737b7732d93f",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Extremely good; incredibly amazing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "288eab7f-7f9e-4a37-ad6e-c0f0a460ea39",
                                                "sense_id": "f830a332-614f-3d49-ba84-737b7732d93f",
                                                "text": "That guy is insane at FPS games."
                                            },
                                            {
                                                "example_id": "156adfc8-3099-4a12-8d5a-10965a619420",
                                                "sense_id": "f830a332-614f-3d49-ba84-737b7732d93f",
                                                "text": "Cederstrand was all over the ice, whipping his sled around and firing pucks into the net. It's what Straschnitzki is aiming for. \"He's insane. The turns, the shots. It's something I want to do some day.\""
                                            },
                                            {
                                                "example_id": "b84c378e-0d5d-4c07-824b-9aa9f1fd4622",
                                                "sense_id": "f830a332-614f-3d49-ba84-737b7732d93f",
                                                "text": "And fans echoed their responses. \"You nailed it, girl! This movie is so special. Your work is insane! 💗,\" one person wrote. \"Is there ANYTHING you can't do?! I'm impressed,\" said another."
                                            },
                                            {
                                                "example_id": "ca1333fb-aa5d-40f1-9602-bf7da11ac11a",
                                                "sense_id": "f830a332-614f-3d49-ba84-737b7732d93f",
                                                "text": "On getting two quick eliminations, SypherPK cries out ecstatically: This gun is insane, it's the best gun ever! Woohoo!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca56b556-9bdc-3627-b6db-31677d1e0409",
                                        "entry_id": "e12e5852-6ade-3b54-9300-05cb6627bd0c",
                                        "glosses": [
                                            "Enraged; furious."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b0bd076-3754-4087-a81c-e5d612505efb",
                        "source_entry_id": "dba65a52-7428-3bbc-a56e-9dc35238765e",
