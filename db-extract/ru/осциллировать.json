                    {
                        "translation_id": "c51fac1d-2765-42b5-8fa2-8aadf3d222d2",
                        "source_entry_id": "9b28534b-82bc-31ba-b88d-f1dc12fe7f7d",
                        "source_sense_id": "5b219e06-1727-3dd3-b131-692925fb20ae",
