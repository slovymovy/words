                "senses": [
                    {
                        "sense_id": "f0ec827f-9a1f-35f5-9d9e-5a0bf437f775",
                        "entry_id": "7eb0b3b9-b31b-368e-8bbc-12efe5896401",
                        "glosses": [
                            "lijkend op oude, versleten kleding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c09ed3-5f15-4f72-a5c6-77e27406549a",
                                "sense_id": "f0ec827f-9a1f-35f5-9d9e-5a0bf437f775",
                                "text": "Toen Eudia nog niet bestond, bedekte je viezig, vettig haar met een voddig mutsje of een flexe Ali B-pet. Giel Beelen kwam vorig jaar tot het inzicht dat zijn stinkende bosgroene pet redelijk over de datum heen was. De frisse Evelien Smit, de vrouw achter het exclusieve hoedenlabel Eudia, maakt voor altijd korte metten met deze rommel, door met haar stijlvolle hoedjes de trend te verleggen."
                            },
                            {
                                "example_id": "b54305dd-77bf-4a23-ad84-bdc4abecb961",
                                "sense_id": "f0ec827f-9a1f-35f5-9d9e-5a0bf437f775",
                                "text": "Want de vermaarde prof. dr. W. J. Kooiman riep uit dat je van Luther zelfs „een voddig hemd” mocht aantrekken, „als je het Evangelie maar verkondigt.” Het liturgisch gewaad was toen niet meer tegen te houden."
                            }
                        ]
                    }
                ],
