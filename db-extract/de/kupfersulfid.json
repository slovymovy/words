                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca6fc36-28bd-4cd6-b086-2db0da77428c",
                                "sense_id": "73f9399a-645b-3848-a2cc-89315aa7a81c",
                                "text": "„Der neue Stoff Kupfersulfid ist glänzend-schwarz; er ist im Gegensatz zum biegsamen Kupfer spröde.“"
                            },
                            {
                                "example_id": "bfcee65e-ab85-4faa-a147-b22ebbe9a9d1",
                                "sense_id": "73f9399a-645b-3848-a2cc-89315aa7a81c",
                                "text": "„Bei der Synthese von Kupfersulfid ergibt sich bei sehr genauen Versuchen folgendes Massenverhältnis…“"
                            }
                        ],
