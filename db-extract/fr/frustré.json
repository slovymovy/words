                            {
                                "example_id": "9a11168b-0562-4fc0-8d2c-fa9bdc64d0f5",
                                "sense_id": "3916321f-5282-3d82-af3b-2a33afb8de45",
                                "text": "Et qui sait ce qu’aux Grecs, frustrés de leur victime,\nPeut permettre un courroux qu’ils croiront légitime ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "c170c795-86e6-3e15-bb8f-b1a94a1914b4",
                        "entry_id": "e40312f9-7eac-3720-a5ac-d0050d0828ac",
