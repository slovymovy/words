                "senses": [
                    {
                        "sense_id": "52f8d0f1-8473-37ae-8355-cd7a0104b3a2",
                        "entry_id": "e547d329-1b5d-3de9-a070-1e6a5617c040",
                        "glosses": [
                            "pretentiousness"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f412777-0d8e-4a16-be1e-fd41725d46e5",
                                "sense_id": "52f8d0f1-8473-37ae-8355-cd7a0104b3a2",
                                "text": "За свою́ жизнь Ба́бкин перебыва́л во мно́гих нача́льственных кабине́тах. Повсю́ду он ви́дел ту лубо́чную претенцио́зность, по кото́рой безоши́бочно опознаю́тся интерье́ры люде́й, облечённых вла́стью."
                            }
                        ]
                    }
