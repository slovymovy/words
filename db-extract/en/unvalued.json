                        "glosses": [
                            "Not considered to be of worth; deemed valueless."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba180f1-7f08-4772-a0d5-8a175ff905b0",
                                "sense_id": "b5eaeae8-a870-3cb3-aaa2-76fa9f6f69a3",
                                "text": "c. 1601, Shakespeare, Hamlet, I, iii\nFor he himself is subject to his birth; / He may not, as unvalued persons do, / Carve for himself, for on his choice depends / The safety and health of this whole state, / And therefore must his choice be circumscribed / Unto the voice and yielding of that body / Whereof he is the head."
                            }
