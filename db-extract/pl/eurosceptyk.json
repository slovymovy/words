                        "examples": [
                            {
                                "example_id": "d720eda3-bc13-4a27-b1fa-618fbaacd3e7",
                                "sense_id": "025defe5-9eb6-3e2e-8268-fede348532f8",
                                "text": "Wójt wyzwał proboszcza od eurosceptyków."
