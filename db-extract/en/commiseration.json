                                                "sense_id": "8c005f2f-60f3-3707-a90f-c357d0b0bdd1",
                                                "text": "Miałem wielki żal do rodziców za to, że zabronili mi jechać pod namiot."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
