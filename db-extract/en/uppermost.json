                                "target_senses": [
                                    {
                                        "sense_id": "f2334f5e-ed87-3bb1-b52f-5665e54c72da",
                                        "entry_id": "0270562d-060b-3de0-b62f-a029fbc21b34",
                                        "glosses": [
                                            "datgene dat bovenop ligt of staat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8921fb55-9ea3-41e7-b63d-53e82ca4569c",
                                                "sense_id": "f2334f5e-ed87-3bb1-b52f-5665e54c72da",
                                                "text": "⧖ En toen zijn spijsuur was gekomen,\nEn 't korfjen openging, bleek, wat het bovenst lag,\nEen hoen te zijn. 't Vereischte geen ontleden;\nReeds was het, naar de kunst, den eter voorgesneden."
