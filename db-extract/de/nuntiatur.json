                    },
                    {
                        "translation_id": "81ac161d-dacd-4ab8-8124-3a53d95cf762",
                        "source_entry_id": "2f389158-1b49-3e6b-a7c9-c2e1d3ec0a12",
                        "source_sense_id": "3cf848e2-eba7-30c2-b7b6-2dd5048d9c22",
                        "source_sense_description": "Amt eines Nuntius",
                        "target_lang_word": "nuncjatura",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuncjatura",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "c7099443-1c76-31af-8893-66ef2c85d5f6",
                                        "entry_id": "c24d83ee-810c-3767-9403-a4cee769700c",
                                        "glosses": [
                                            "dyplomatyczne przedstawicielstwo papieża"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7938dd3-e486-4f4a-b40b-34ea53162a6f",
                                                "sense_id": "c7099443-1c76-31af-8893-66ef2c85d5f6",
                                                "text": "Nawiązanie stosunków dyplomatycznych niejako wyprzedziło odrodzenie niepodległego państwa polskiego, ponieważ papież Benedykt XV za zgodą władz niemieckich zdecydował otwarcie namiastki nuncjatury w Warszawie już 15 kwietnia 1918 r."
                                            },
                                            {
                                                "example_id": "0295cc1b-bcaa-4ee8-a949-28ec79921597",
                                                "sense_id": "c7099443-1c76-31af-8893-66ef2c85d5f6",
                                                "text": "Wielebni oo. dominikanie wezwali naszych ojców do kurii biskupiej, a nawet do nuncjatury apostolskiej, uważając wspomniany cud za bajeczkę"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
