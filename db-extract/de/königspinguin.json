                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ba5d7f-1a3d-455f-8f44-7939b8b07b91",
                                "sense_id": "334f85bc-4801-3427-b0aa-cedddbe7667b",
                                "text": "Der Königspinguin ist nach dem Kaiserpinguin die zweitgrößte Art der Pinguine."
                            }
                        ],
