                "senses": [
                    {
                        "sense_id": "38af19ea-777a-3620-90dd-7a0b5a8190c5",
                        "entry_id": "c22fa913-71ca-3b1e-ad21-29fd908ec163",
                        "glosses": [
                            "gwiazda neutronowa, wysyłająca regularne impulsy elektromagnetyczne"
                        ],
                        "tags": [],
