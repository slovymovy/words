                        "glosses": [
                            "Any flowering plant of the genus Geranium found throughout the temperate zone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6501983-54e7-43f7-a152-a12729c7167a",
                                "sense_id": "13238d54-afc9-3b3d-8937-f20eae00cc5f",
                                "text": "Sometimes called cranesbills, geraniums make up a large and widely used genus, greatly loved by gardeners from England to the United States to Australia."
                            }
                        ]
