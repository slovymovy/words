                "senses": [
                    {
                        "sense_id": "4760a665-c52d-348e-a7a8-38f7ff015fc3",
                        "entry_id": "f2c5dd27-bc73-33a8-9550-00d6bdcbf7a1",
                        "glosses": [
                            "Membre d’un peuple d’Asie centrale parlant le pachto."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "5329d2b3-efc0-4901-9562-7754aa3a68d7",
                                "sense_id": "4760a665-c52d-348e-a7a8-38f7ff015fc3",
                                "text": "Les Pachtous des passes de l’Est, des châteaux forts en nids d’aigle… Pasteurs et guerriers indomptables. Ils forgeaient dans leurs ateliers secrets sabres, lances, fusils. Ils avaient conquis les plaines jusqu’à l’Amou Daria, réduit les Hazaras en esclavage, soumis les païens du Kafiristan à la vraie foi. Même les soldats des Rois anglais, invincibles ailleurs, ils les avaient chassés de leurs vallées et montagnes, après un siècle de combats. Pachtous, race des maîtres… Clans faiseurs de rois…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61ca3377-e565-4c2b-87ac-bfb1652b6844",
