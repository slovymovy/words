                        "sense_id": "d7753968-fc89-31f7-999c-944b38dbc7da",
                        "entry_id": "7a563732-e547-30ea-a01b-7be1ed08fede",
                        "glosses": [
                            "weiblicher Hund, der für den Polizeieinsatz vorgesehene Aufgaben übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbaee12a-7419-4087-a295-1424b9a1a724",
                                "sense_id": "d7753968-fc89-31f7-999c-944b38dbc7da",
                                "text": "„Polizeihündin Diesel ist bei den Terror-Anschlägen von Paris getötet worden.“"
                            },
                            {
                                "example_id": "c5eee3ef-e2ee-47fb-95d6-1d28d1fe0722",
                                "sense_id": "d7753968-fc89-31f7-999c-944b38dbc7da",
                                "text": "„Ein 81-Jähriger ist am Frankfurter Flughafen dank guter Spürnase von Polizeihündin ‚Zora‘ beim Droggenschmuggeln erwischt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cecf3121-1d1c-4b8d-baa8-a5f7f37b6d9d",
                        "source_entry_id": "7a563732-e547-30ea-a01b-7be1ed08fede",
                        "source_sense_id": "d7753968-fc89-31f7-999c-944b38dbc7da",
                        "source_sense_description": "weiblicher Hund, der für den Polizeieinsatz vorgesehene Aufgaben übernimmt",
                        "target_lang_word": "police dog",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "police dog",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d2e5ce0-6db1-3379-a80b-1ca5a29f5ab5",
                                        "entry_id": "2d2d888d-a806-3b4e-a531-87e9df2af527",
                                        "glosses": [
                                            "A dog trained and employed by the police to pursue suspects or sniff out contraband."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d790f54f-519e-44f4-9dfe-03e6d8b01b76",
                                                "sense_id": "5d2e5ce0-6db1-3379-a80b-1ca5a29f5ab5",
                                                "text": "A man who attacked three police officers and a police dog at Nottingham on April 4 has pleaded guilty to two counts of actual bodily harm, assault with intent to resist arrest, assault of an emergency worker, possession of a bladed article, possession of an offensive weapon, and causing unnecessary suffering to a protected animal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "892cbea8-61e2-363c-b793-f8e0800c0f70",
                                        "entry_id": "2d2d888d-a806-3b4e-a531-87e9df2af527",
                                        "glosses": [
                                            "Synonym of German shepherd."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30fbff48-8ab4-4d91-bc1b-36b0f3f00e38",
                                                "sense_id": "892cbea8-61e2-363c-b793-f8e0800c0f70",
                                                "text": "Finding myself, the other day, in New London, Conn., the thought occurred that it would be a good time to pay a visit to my old friend, Henri I. Baer whose kennel of police dogs (German shepherd dogs) at East Killingly, Conn., was only an hour or so away."
                                            },
                                            {
                                                "example_id": "6a2f6361-bf50-45f6-a2b2-691c7026cff9",
                                                "sense_id": "892cbea8-61e2-363c-b793-f8e0800c0f70",
                                                "text": "For instance, we will take a police dog, and no doubt you are all aware, as I am, of the fact that the police or German shepherd is one of the hardest dogs that we have to treat."
                                            },
                                            {
                                                "example_id": "cec148d0-fda6-4607-b135-079c159d3249",
                                                "sense_id": "892cbea8-61e2-363c-b793-f8e0800c0f70",
                                                "text": "Contrary to popular opintion, the shepherd or police dog has not been crossed with the wolf, and has none of the qualities of such a mongrel."
                                            },
                                            {
                                                "example_id": "e53dad80-7afd-4bd6-bafc-3806fc5d7e34",
                                                "sense_id": "892cbea8-61e2-363c-b793-f8e0800c0f70",
                                                "text": "By the mid-1920s, the annual registrations of German Shepherd Dogs surpassed 21,000 dogs a year in America and the breed had become one of the most well-known in the country. Unfortunately, to meet this demand for “German police dogs” too many puppies were bred indiscriminately and the breed's reputation suffered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
