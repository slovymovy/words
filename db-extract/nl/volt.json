                    {
                        "translation_id": "b32ace3e-71bd-4600-b86e-f55f88dcde11",
                        "source_entry_id": "b31fafcf-83c0-39e0-a404-24470e453d9a",
                        "source_sense_id": "ff4e6594-5560-3be9-9292-d6ff4dd6734c",
                        "target_lang_word": "вольт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вольт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ac5bf969-2064-3129-9934-43e76af49dff",
                                        "entry_id": "146ca768-26e9-334b-9160-78764e14644e",
                                        "glosses": [
                                            "физ. единица измерения электрического напряжения, электрического потенциала и электродвижущей силы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff5ca5b-c867-4af1-b8b8-797395abfbb0",
                                                "sense_id": "ac5bf969-2064-3129-9934-43e76af49dff",
                                                "text": "Адаптер преобразует переменное сетевое напряжение 220 вольт в постоянное 12 вольт."
                                            },
                                            {
                                                "example_id": "96af6bb7-b840-4612-929c-03815ebdb33d",
                                                "sense_id": "ac5bf969-2064-3129-9934-43e76af49dff",
                                                "text": "Шкала прибора проградуирована в вольтах и киловольтах."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "вольт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                        "entry_id": "f9299beb-ef78-3ca8-868d-fd2c42b39c16",
                                        "glosses": [
                                            "цирк. круг, описываемый всадником на манеже; крутой поворот в верховой езде; крутой поворот в акробатике, воздушной гимнастике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c47eba7a-084d-4a66-8501-05adfcfcd5c0",
                                                "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                                "text": "Его забавлял их ужас, и, загородив им выход, он производил перед их носом манежные вольты и пируэты, пятил лошадь задом и медленно, как в цирке, подымал её на дыбы."
                                            },
                                            {
                                                "example_id": "24cdcf8a-c4b3-4063-af8a-ed5f32af3cf5",
                                                "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                                "text": "Берди-Паша был в эти минуты похож на знаменитого балетмейстера, управляющего отлично слаженным кордебалетом, на директора цирка, заставляющего массу нарядных лошадей однообразно делать сложные вольты, лансады и пируэты, на большого мальчишку, играющего своими раздвижными деревянными солдатиками, заставляя всю их сомкнутую группу разом сдвигаться и раздвигаться то сверху вниз, то слева направо."
                                            },
                                            {
                                                "example_id": "8b798ed1-6b2a-40f0-9498-22b35dd394f8",
                                                "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                                "text": "Казак с ближайшего кургана поскакал к нам навстречу, вдруг, не останавливая коня, сделал вольт, выхватил из чехла винтовку, дал выстрел и, на втором вольте подняв с земли какой-то предмет, продолжал скачку."
                                            },
                                            {
                                                "example_id": "ff61275f-e566-45c1-811e-7e014443d185",
                                                "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                                "text": "Метлой управляла юная ведьма, следовательно, полёт проходил на большой скорости, предельной высоте, с неожиданными пике, вольтами, штопорами, мёртвыми петлями и прочей авиационной прелестью."
                                            },
                                            {
                                                "example_id": "a941be7c-9c31-464f-a712-7f2f54569c75",
                                                "sense_id": "cc92b214-a413-357a-a4c5-f5b95e32aa75",
                                                "text": "Сначала разминают лошадь на вольту рысью и галопом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838841ae-637e-3e9e-884d-e3d84ab5fb2f",
                                        "entry_id": "f9299beb-ef78-3ca8-868d-fd2c42b39c16",
                                        "glosses": [
                                            "спорт. стремительное, резкое уклонение от удара противника при фехтовании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f28ea90-295a-4303-8f04-309f522fec3c",
                                                "sense_id": "838841ae-637e-3e9e-884d-e3d84ab5fb2f",
                                                "text": "Доктор делал такие же па, вольты и рипосты — словом, все те же телодвижения, что и они, но только чуть быстрее, чем его противники, буквально — на одно мгновение, цена которого — жизнь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1546d045-2fe8-3b38-9a9c-d6505c127f5a",
                                        "entry_id": "f9299beb-ef78-3ca8-868d-fd2c42b39c16",
                                        "glosses": [
                                            "карт. манипуляционный приём подтасовки карт в игре, заключающийся в перемене местами двух частей колоды карт с целью перевода контролируемой карты наверх или вниз колоды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3339f30-dc8f-422c-bb22-f9f85e8535d4",
                                                "sense_id": "1546d045-2fe8-3b38-9a9c-d6505c127f5a",
                                                "text": "В то время, как один мечет подтасованными картами, другой делает вольты, меняя карты, под которые подложен куш."
                                            },
                                            {
                                                "example_id": "24437f4e-86a5-494f-ad41-b7a5966b9fa0",
                                                "sense_id": "1546d045-2fe8-3b38-9a9c-d6505c127f5a",
                                                "text": "Возьмите, например, хоть последнее наше междоусобие: князю Балаболкину, за неправильно сделанный в карты вольт, вымазали горячей котлеткой лицо."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac3d9d8-952d-37d5-96a2-d3456dcab958",
                                        "entry_id": "f9299beb-ef78-3ca8-868d-fd2c42b39c16",
                                        "glosses": [
                                            "резкий поворот, уход в сторону"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc7fec4-b7d7-4912-af86-f8feaea05ba9",
                                                "sense_id": "aac3d9d8-952d-37d5-96a2-d3456dcab958",
                                                "text": "Он делает вольт в сторону, незаметно пригнувшись, торопливо пробирается в виноградник, огибает большой каменный сарай, выходящий в сад своими глухими стенами, перелезает ограду, отделяющую сад от двора, и наконец благополучно достигает кухни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3640aa83-23b4-38e2-8063-a902def6a314",
                                        "entry_id": "f9299beb-ef78-3ca8-868d-fd2c42b39c16",
                                        "glosses": [
                                            "неожиданный поворот событий; выкрутас, фортель, выходка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "351bda2e-2fe2-487f-afe1-6b53a36bb973",
                                                "sense_id": "3640aa83-23b4-38e2-8063-a902def6a314",
                                                "text": "— М-да. Неожиданный вольт, — сказал он в раздумье. — Вообще Тюльманков матрос тихий…"
                                            },
                                            {
                                                "example_id": "3cdeb85c-b991-4935-8e39-05c0c48265bc",
                                                "sense_id": "3640aa83-23b4-38e2-8063-a902def6a314",
                                                "text": "Ребята, конечно, понимали, что дело нечисто, но снисходительно относились к педагогическим вольтам классной руководительницы."
                                            },
                                            {
                                                "example_id": "3794ec38-97aa-496c-8137-d2a2a1041bd6",
                                                "sense_id": "3640aa83-23b4-38e2-8063-a902def6a314",
                                                "text": "Давайте напрямик: мы опасаемся, что в какой-то весьма ответственный момент Лучников может пойти на совершенно непредвиденный вольт, проявить то, что можно было бы назвать рефлексиями творческой натуры и внести некий абсурд в историческую ситуацию."
                                            },
                                            {
                                                "example_id": "4dceb91e-5f76-4ae8-a021-2d89bdf29838",
                                                "sense_id": "3640aa83-23b4-38e2-8063-a902def6a314",
                                                "text": "Меня осеняет, что, развиваясь от вещи к вещи, Ван Гог предвидел проблемы, которые лишь столетием позже стали перед человечеством, когда природа, будто бы уже покорённая, выкинула новый вольт, доказав, что нельзя быть её господином, а можно — только другом и сотрудником."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
