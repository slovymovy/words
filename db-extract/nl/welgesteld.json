                                "example_id": "bae65a29-c842-4004-8876-628558d093fa",
                                "sense_id": "05e4fefb-82d3-3225-9d4b-be18651c22ed",
                                "text": "Hij kwam uit een welgestelde familie."
                            },
                            {
                                "example_id": "a6dafcb2-96d7-49fe-ada0-45cba8af8486",
                                "sense_id": "05e4fefb-82d3-3225-9d4b-be18651c22ed",
                                "text": "Haar vader de baron verlangde een welgestelde schoonzoon en dat was een onmogelijke eis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
