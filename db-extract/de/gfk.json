                ],
                "senses": [
                    {
                        "sense_id": "aa4497bc-0df4-3de0-a310-3cea058cab6e",
                        "entry_id": "0e0a3fd3-34ef-3bc8-b873-a5f4c6145683",
                        "glosses": [
                            "Glasfaserverstärkter Kunststoff; Glasfaserkunststoff; Fiberglas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd228210-c581-4df4-add4-484c3abe5c3d",
                                "sense_id": "aa4497bc-0df4-3de0-a310-3cea058cab6e",
                                "text": "„Jede Baugröße besteht wahlweise aus einer kombinierten Edelstahl-Vollkunststoffkonstruktion (GFK-Polyester) mit einem begehbaren Flachdach einschließlich GFK-Geländeranlage oder aus einer GFK-Vollkunststoffkonstruktion.“"
                            },
                            {
                                "example_id": "ea552b34-91a9-4e29-9c90-22d7294ab2fe",
                                "sense_id": "aa4497bc-0df4-3de0-a310-3cea058cab6e",
                                "text": "„Der Verein der GFK-Klassiker ist aus einem von Martin Horstbrink und Dirk Kroll initiierten Freundeskreis von Liebhabern klassischer Yachten aus dem unverwüstlichen Werkstoff GFK hervorgegangen.“"
                            },
                            {
                                "example_id": "3ec47edf-6252-4a92-b094-b750ef5f9a93",
                                "sense_id": "aa4497bc-0df4-3de0-a310-3cea058cab6e",
                                "text": "„Im Jahre 1995 nutzten Planer, Ingenieure, Anwender und Betreiber zum ersten Mal die Gelegenheit, sich über den Werkstoff GFK auszutauschen und so ihr Wissen durch Fachvorträge zu erweitern.“"
                            },
                            {
                                "example_id": "957a3582-44a6-492e-9420-182c3b411783",
                                "sense_id": "aa4497bc-0df4-3de0-a310-3cea058cab6e",
                                "text": "„Außer Sand enthält GFK den Kunststoff Polyester, der mit seinem hohen Heizwert viel fossile Primärenergie einspart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a35da97-ffe3-3426-941e-a91e8a7aee44",
                        "entry_id": "0e0a3fd3-34ef-3bc8-b873-a5f4c6145683",
                        "glosses": [
                            "Glasfaserkabel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612c27d7-7a7b-40f2-b469-b42939be8df2",
                                "sense_id": "9a35da97-ffe3-3426-941e-a91e8a7aee44",
                                "text": "Sie können zwischen Glasfaserkabel (GFK) und Kupferkabel (KK) wählen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
