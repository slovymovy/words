                                    {
                                        "sense_id": "753df495-eecf-3e9e-8517-310372b7b43b",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "An attack requiring the suicide of the one carrying it out, especially when done with an aircraft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b94a8d5e-1272-3e45-9373-3de72f09808b",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "One who carries out a suicide attack, especially with an aircraft."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93210411-4fc7-39d9-a5fe-2f80eebc60ff",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "A vehicle used for a suicide attack, especially an aircraft."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae84b663-45fe-4d7b-a871-e98cd372b79c",
                                                "sense_id": "93210411-4fc7-39d9-a5fe-2f80eebc60ff",
                                                "text": "Coupled with this were issues involving actually getting enough torpedoes out there to the fleet in the first place! Whilst they were a munition, a torpedo is far more complex and took far longer to build than a shell for a naval gun, even a battleship shell. Torpedoes, remember, are effectively small self-guiding kamikaze submarines, and, so, unless you have a large factory and an extensive production line going, you're only gonna see handfuls produced each year."
                                            },
                                            {
                                                "example_id": "c5575cdb-36ae-4039-9dc6-3bd2b1dab429",
                                                "sense_id": "93210411-4fc7-39d9-a5fe-2f80eebc60ff",
                                                "text": "The Ukrainians themselves have been using kamikaze drones to strike against Russian targets – and asked their allies to supply them with more of these deadly weapons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48f54bff-4f69-3b88-88c6-6e336a6528f9",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "One who takes excessive risks, as for example in a sporting event."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e11cdcd8-f81b-30ef-a80f-5dfc064b0a6a",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "A cocktail made of equal parts vodka, triple sec and lime juice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44cb46e-b3b1-4200-bd76-7444b19b0a5d",
                                                "sense_id": "e11cdcd8-f81b-30ef-a80f-5dfc064b0a6a",
                                                "text": "Only top-shelf liquor is served, though Sasha refuses to serve drinks he deems fratlike. These include woo woos, kamikazes and shots of any kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d27f4d-6f90-39a0-abec-5c152483b055",
                                        "entry_id": "134e225a-48aa-36ba-a4e9-e6a771527dd6",
                                        "glosses": [
                                            "A deliberate wipeout."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
