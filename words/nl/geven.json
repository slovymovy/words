                                "target_lang_sense_clarification": "вызывать чувство (например, доверие)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f72d9e99-5122-314e-afe8-99e6ab211f7b",
                    "sense_definition": "iets aanbieden als suggestie of les",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "overdracht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>geef</w> jullie een aantal ervaringen die ik heb meegemaakt.",
                            "target_lang_translations": {
                                "en": "I am <w>sharing</w> a number of experiences with you that I have been through.",
                                "ru": "Я <w>поделюсь</w> с вами опытом, через который я прошел."
                            }
                        },
                        {
                            "text": "De leraar <w>gaf</w> adviezen die je als gids kunt gebruiken.",
                            "target_lang_translations": {
                                "en": "The teacher <w>gave</w> advice that you can use as a guide.",
                                "ru": "Учитель <w>давал</w> советы, которые можно использовать как руководство."
                            }
                        }
                    ],
                    "synonyms": [
