                "senses": [
                    {
                        "sense_id": "8cefad7f-97ce-3e87-98aa-bd8a0542ebc3",
                        "entry_id": "60566d66-75bb-3dce-ba83-cf444ed59e73",
                        "glosses": [
                            "Tag, an dem eine oder mehrere Wahlen durchgeführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ec9ce0-3485-4fce-b11c-53edbc35995f",
                                "sense_id": "8cefad7f-97ce-3e87-98aa-bd8a0542ebc3",
                                "text": "„Ausgerechnet er, der einst noch spätnachts zum Pressegespräch bat, gibt zum Wahltag keine Interviews.“"
                            },
                            {
                                "example_id": "e377d44c-3fe8-4508-a0e0-fca2589825a1",
                                "sense_id": "8cefad7f-97ce-3e87-98aa-bd8a0542ebc3",
                                "text": "„Wirklich erreicht hat er aber erst etwas, wenn auch kurz vorm Wahltag noch immer keiner lacht.“"
                            },
                            {
                                "example_id": "547ca68b-8c24-4f5c-883e-25b6145c7e22",
                                "sense_id": "8cefad7f-97ce-3e87-98aa-bd8a0542ebc3",
                                "text": "„In Pettyville war Wahltag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
