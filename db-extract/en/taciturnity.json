                "senses": [
                    {
                        "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                        "glosses": [
                            "The trait of being taciturn."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d49795b9-7b66-4fba-bf90-2322cdff9bff",
                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                "text": "Humphries broke out more freely into speech than he had done before, for his usual characteristic was that of taciturnity."
                            },
                            {
                                "example_id": "62eae02b-1cb7-4f6d-a6b8-ff26b138324c",
                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                "text": "Gernois’ cordiality was short-lived. No sooner had they ridden out of sight of Captain Gerard and his men than he lapsed once more into his accustomed taciturnity."
                            },
                            {
                                "example_id": "8479b40c-3207-470c-87a6-40823abb4ba6",
                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                "text": "\"[…]and as Mr. H., with his long purse and his willingness to receive hints, is no bad card in the game, he has been brought up to Abbotsford for a week; his taciturnity has long ago fled, and he is one of the most loquacious Borderers going. […]\""
                            },
                            {
                                "example_id": "cd12764a-3f55-429b-b110-33c179f185b5",
                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                "text": "Once he is back on the bench, will Justice Thomas revert to his usual taciturnity?"
                            }
                        ]
                    },
                    {
                        "sense_id": "90393d21-25b6-3a0e-a4d1-ff5b8b7232ad",
                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                        "glosses": [
                            "Failure to assert a legal right in a way that implies that it is being given up."
                        ],
