                ],
                "senses": [
                    {
                        "sense_id": "bfdb0635-4f0c-3872-8eca-c246fd035d95",
                        "entry_id": "562b40ef-4410-3b36-b5c6-027d93d363b5",
                        "glosses": [
                            "Rendre transitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23e3c12-ddc4-46cc-9782-fd7ddb04f48b",
                                "sense_id": "bfdb0635-4f0c-3872-8eca-c246fd035d95",
                                "text": "Les bambarophones peuvent être tentés de transitiviser à mauvais escient certains verbes intransitifs sur le modèle du bambara (ex. *Paul a couru son âne)."
                            },
                            {
                                "example_id": "d6ab321c-fa37-4a4d-a77c-813657b0f7e8",
                                "sense_id": "bfdb0635-4f0c-3872-8eca-c246fd035d95",
                                "text": "Pour terminer, en observant les outils qui permettent de transitiviser un verbe d'émotion, on évoquera certaines propriétés de la structure actancielle de ces verbes."
                            },
                            {
                                "example_id": "12792c11-8eaa-4e6a-be70-23b5a5d86818",
                                "sense_id": "bfdb0635-4f0c-3872-8eca-c246fd035d95",
                                "text": "A l'inverse, et on a là une seconde différence, certains membres de la classe du verbe sont aptes à prendre les préfixes actanciels sans avoir à subir aucune modification morphologique, le nom devant, lui, se «transitiviser» par une transformation applicative (cf. LePrédicat, 4)."
                            }
                        ]
                    }
                ],
