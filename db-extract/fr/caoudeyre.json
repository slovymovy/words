                        "entry_id": "fbabfca0-0681-356c-931b-a31780065c34",
                        "glosses": [
                            "Dépression circulaire ou ovale de formation éolienne au sommet d’une dune littorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60e1bf26-79ae-4b1a-a8d4-9f2df0feb4ea",
                                "sense_id": "d611c3de-6f1f-3857-ada3-b47f6bb0626a",
                                "text": "En effet la caoudeyre est une excavation circulaire, une vaste marmite éolienne aux sables nus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "add44da0-fc8a-45d1-80b1-88b043299292",
                        "source_entry_id": "fbabfca0-0681-356c-931b-a31780065c34",
                        "source_sense_id": "d611c3de-6f1f-3857-ada3-b47f6bb0626a",
