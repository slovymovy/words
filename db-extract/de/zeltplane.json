                "senses": [
                    {
                        "sense_id": "81bfb5eb-fa4e-3c79-ada2-63b6250e876e",
                        "entry_id": "b7117751-860e-37eb-9159-c0ff4214d051",
                        "glosses": [
                            "Abdeckung für ein Zelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b5214c-134d-4436-9557-decf77d46fac",
                                "sense_id": "81bfb5eb-fa4e-3c79-ada2-63b6250e876e",
                                "text": "„Geübt schnallte ich die Taschen von meinem Rad, lud den schweren Packsack vom Gepäckträger und breitete die Zeltplane auf dem Boden aus.“"
                            },
                            {
                                "example_id": "191d103e-da34-4335-84ec-e717403621b2",
                                "sense_id": "81bfb5eb-fa4e-3c79-ada2-63b6250e876e",
                                "text": "„Ich wickelte mich in meine Zeltplane und sah an den Stämmen hinauf, die unsere Lichtung umgaben wie eine Palisade.“"
                            },
                            {
                                "example_id": "c999d02c-6310-44da-8f2f-a0ee7b355ce8",
                                "sense_id": "81bfb5eb-fa4e-3c79-ada2-63b6250e876e",
                                "text": "„Was wie ein kurzes Kleidchen ausgesehen hatte, solange sie es noch anhatte, nahm, als sie es endlich abgestreift hatten, die Ausmaße einer Zeltplane an.“"
                            },
                            {
                                "example_id": "69c70ea1-6bad-456f-94db-3bfb2317649a",
                                "sense_id": "81bfb5eb-fa4e-3c79-ada2-63b6250e876e",
                                "text": "„Als er ins Freie sehen wollte, stellte er fest, daß die Zeltplanen über der Ladefläche festgezurrt und dicht geschlossen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
