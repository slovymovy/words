                                "target_senses": [
                                    {
                                        "sense_id": "f47c46e0-08a9-36d9-8cba-e1b925f3ec1d",
                                        "entry_id": "6e5dadf0-3e1d-35b8-ab6a-11e4817df1a2",
                                        "glosses": [
                                            "то, что совершается независимо от сознания, воли, разума"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13569d1d-8225-4a7a-8952-d2173b8fdb11",
                                                "sense_id": "f47c46e0-08a9-36d9-8cba-e1b925f3ec1d",
                                                "text": "Самая молодая сотрудница сделала непроизвольное движение ― развела ладони, словно готовясь ее прихлопнуть."
                                            },
                                            {
                                                "example_id": "96ceba20-38a5-44d0-bec1-a856d295310d",
                                                "sense_id": "f47c46e0-08a9-36d9-8cba-e1b925f3ec1d",
                                                "text": "Вскоре ими охватываются все мышцы тела, выступает пот, происходит непроизвольное мочеиспускание."
                                            },
                                            {
                                                "example_id": "79acd335-5246-4bef-9f59-f90f159d00b7",
                                                "sense_id": "f47c46e0-08a9-36d9-8cba-e1b925f3ec1d",
                                                "text": "У дошкольников центральное место в закреплении ими индивидуального опыта занимает непроизвольная память."
                                            },
                                            {
                                                "example_id": "04047557-81a9-49e4-94d1-db4a3aca47cb",
                                                "sense_id": "f47c46e0-08a9-36d9-8cba-e1b925f3ec1d",
                                                "text": "Раздался оглушительный грохот, и все непроизвольно взглянули на небо."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
