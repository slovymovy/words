                    "sense_id": "893058a2-b6b8-39f8-a805-57f8cfa63dd6",
                    "sense_definition": "posłać lub zapisać kogoś do jakiejś placówki, szkoły lub pracy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rodzice zdecydowali, że od września <w>dadzą</w> syna do szkoły sportowej.",
