                ],
                "senses": [
                    {
                        "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                        "entry_id": "bdd87568-f140-3fb9-a078-23b723318e7a",
                        "glosses": [
                            "besondere Ausprägung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b2e10c-c3c9-46ce-abf0-2b5a97f27156",
                                "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                                "text": "„Von Kulturschock konnte bei mir keine Rede sein, da ich mit der europäischen Kultur, in ihrer französischen Spielart, vertraut war, …“"
                            },
                            {
                                "example_id": "0a8dd725-34e7-4cc4-8589-167bdec92abb",
                                "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                                "text": "„Eine weitere Spielart der berittenen Post ist der legendäre Pony Express durch die noch nicht von der Eisenbahn und Telegrafenlinien erschlossenen Weiten der USA.“"
                            },
                            {
                                "example_id": "319e6af9-cd47-425e-b485-460f1bd14249",
                                "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                                "text": "„Der Philosoph Friedrich Schlegel entwarf kurz nach 1800 das neue Bild vom Rhein und erfand damit die deutsche Spielart der Rheinromantik.“"
                            },
                            {
                                "example_id": "3b67894c-c4a2-42d1-b01f-6ea469e3b9ee",
                                "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                                "text": "„Und was er zu erreichen versuchte, war keinesfalls der Kommunismus oder gar Sozialismus bayerischer Spielart, sondern eine ziemlich einzigartige Form radikaler Demokratie.“"
                            },
                            {
                                "example_id": "617ac92f-b915-4be6-bfcc-9f361bc723b1",
                                "sense_id": "73f8bd92-60bf-36be-981d-ddd8bba70599",
                                "text": "„Er zählte zu den wichtigsten intellektuellen Einflüssen auf Nkrumah und vertrat wie dieser eine vom Marxismus inspirierte Spielart des Panafrikanismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
