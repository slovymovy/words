                ],
                "senses": [
                    {
                        "sense_id": "d11e87f4-3e7e-3f84-ba8b-a57591be6337",
                        "entry_id": "a6024bb3-be70-3b82-a808-60b2aca5dc8b",
                        "glosses": [
                            "vznášedlo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb58fd4-5ffb-4edc-a1cd-0e4733e3d4b7",
                                "sense_id": "d11e87f4-3e7e-3f84-ba8b-a57591be6337",
                                "text": "La réputation de Parker faisait reculer bien de aéroglisseurs, mais le chevalier noir ne manquait visiblement ni de courage ni d'assurance.",
                                "translation": "Parkerova pověst zdatného borce v klání odradila řadu vznášedel, ale černému rytíři zjevně nescházela odvaha ani sebevědomí."
                            },
                            {
                                "example_id": "b63c50ed-26c2-4391-9acd-2152c9257b71",
                                "sense_id": "d11e87f4-3e7e-3f84-ba8b-a57591be6337",
                                "text": "Mon aéroglisseur est plein d'anguilles."
                            },
                            {
                                "example_id": "30588734-7121-41f8-8748-b6c3765c53a9",
                                "sense_id": "d11e87f4-3e7e-3f84-ba8b-a57591be6337",
                                "text": "Les Anglais ont, depuis début 2014, une nouvelle réglementation qui sort les petits aéroglisseurs de la classification des navires rapides et définit trois nouvelles classes pour les aéroglisseurs de longueur inférieure à 24 m.",
                                "translation": "Angličané mají od začátku roku 2014 novou právní úpravu, která vyjímá malá vznášedla z kategorie rychlých plavidel a definuje tři nové třídy pro vznášedla kratší než 24 metrů."
                            },
                            {
                                "example_id": "7fc9cbf7-c943-48e2-96f5-ab7b6877264f",
                                "sense_id": "d11e87f4-3e7e-3f84-ba8b-a57591be6337",
                                "text": "Les aéroglisseurs se déplacent le plus souvent sur la mer, mais aussi sur toute surface terrestre ne présentant pas d'obstacles importants."
                            }
                        ]
                    }
                ],
