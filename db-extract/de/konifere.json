                        "examples": [
                            {
                                "example_id": "81181bac-422f-49eb-a450-38b506b20255",
                                "sense_id": "575d2ca1-f793-35bb-90eb-982e4e91e843",
                                "text": "Die Eibe (Taxus) ist eine Konifere, obwohl sie keine Zapfen trägt."
                            },
                            {
                                "example_id": "0c4f6861-b32c-4c58-b2b2-7205d2e063b7",
                                "sense_id": "575d2ca1-f793-35bb-90eb-982e4e91e843",
                                "text": "„Je tiefer sie in den Wald eindrangen, desto prachtvollere Bäume standen ihnen entgegen: Koniferen, Deodars, Douglas- und andere Tannen von teilweise 50 m Höhe.“"
                            }
                        ],
