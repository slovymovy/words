                        "entry_id": "3bc02799-d293-3d74-8121-a14d7e0f1683",
                        "glosses": [
                            "een voertuig ingericht voor het vervoer van patiënten, gewoonlijk naar een ziekenhuis toe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f2bc82d-e32f-4f60-b06c-cf74c3a601d7",
                                "sense_id": "6ae69813-7c13-3471-8076-12ec17850db2",
                                "text": "Er stond een ziekenwagen voor de deur bij de buren; er zal toch niets gebeurd zijn?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67c0e5cc-8cd2-4731-8d7f-f5ba31c46f63",
                        "source_entry_id": "3bc02799-d293-3d74-8121-a14d7e0f1683",
                        "source_sense_id": "6ae69813-7c13-3471-8076-12ec17850db2",
                        "source_sense_description": "een voertuig ingericht voor het vervoer van patiënten, gewoonlijk naar een ziekenhuis toe",
                        "target_lang_word": "Krankenwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankenwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                        "entry_id": "a38a6c27-556f-34ca-abb3-457828a22455",
                                        "glosses": [
                                            "Fahrzeug, um kranke oder verletzte Menschen zu transportieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10976b0-5464-493c-83a4-a25226d43dd0",
                                                "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                                "text": "Der Krankenwagen fährt dich sofort ins Krankenhaus."
                                            },
                                            {
                                                "example_id": "33210163-94c2-49fa-ab82-4b4d56194567",
                                                "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                                "text": "„Nachmittags bringt mich ein Krankenwagen ins Militärlazarett.“"
                                            },
                                            {
                                                "example_id": "9c8f4d93-ef23-4951-9f33-80b198d37cc9",
                                                "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                                "text": "„Der Krankenwagen wartete vor ihrer Wohnung im Viertel, Sanitäter beugten sich über die bewußtlose Helena, dann brachte man sie mit heulenden Sirenen ins Krankenhaus.“"
                                            },
                                            {
                                                "example_id": "126e2ed4-3500-4b9c-8a24-97446a86d110",
                                                "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                                "text": "„Vom Fenster aus sahen sie, wie Matthias auf einer Trage in den Krankenwagen geschoben wurde.“"
                                            },
                                            {
                                                "example_id": "2d9cb961-792a-40c8-b34e-ca4ee5d9d018",
                                                "sense_id": "6e1f71da-c431-3276-8cb1-997c0d6c788c",
                                                "text": "„Die Klappen des Krankenwagens standen bereits offen, standen eigenartig schräg in der Luft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b55cd216-bb50-4fd0-bf9d-1039f808cc25",
