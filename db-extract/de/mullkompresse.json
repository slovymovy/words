                ],
                "senses": [
                    {
                        "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                        "entry_id": "473c6685-9c21-3686-bd78-58006f09d749",
                        "glosses": [
                            "mehrschichtiger Mull als Unterlage eines Druckverbands"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c82cca-ec93-4e54-ae06-b920e742f742",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "Die Creme wird auf eine Mullkompresse aufgetragen und diese mit einem Verband an der schmerzenden Stelle fixiert."
                            },
                            {
                                "example_id": "d46090f5-2e33-4e5c-afa7-30fa154cabc3",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "„Mullkompressen sind weich, luftdurchlässig, saugstark und können daher unterschiedlich verwendet werden.“"
                            },
                            {
                                "example_id": "977f6828-e740-4c00-9914-b57b625ab474",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "„Die Noba Mullkompresse-steril, nach EN 14079 Typ17, ist 12-lagig, mit eingeschlagener Schnittkante und einzeln steril zu je 60 Kompressen verpackt.“"
                            },
                            {
                                "example_id": "34f60591-e7fe-48ce-8d9d-a45b373edc61",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "„Die aus 100 % Baumwolle bestehende, sterile Mullkompresse wird zur Versorgung äußerer Wunden eingesetzt. Sie verfügt über eingeschlagene Schnittkanten und ist mehrfach aufklappbar.“"
                            },
                            {
                                "example_id": "c5d14d46-4fab-4b90-b02a-b3b570d564c1",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "„Das Sortiment umfasst sterile Mullkompressen ohne sowie unsterile Kompressen mit oder ohne Röntgenkontrastfaden.“"
                            },
                            {
                                "example_id": "15d1044c-876d-4c7d-9a55-a727b1a8d926",
                                "sense_id": "8bb75243-a36f-3032-ae39-688dacefb196",
                                "text": "„Daher findet die Mullkompresse häufig in Ambulanzen und Notaufnahmen Einsatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
