                ],
                "senses": [
                    {
                        "sense_id": "59c39edc-2a0a-3363-bbd5-4de0875c6939",
                        "entry_id": "3fa4da8b-9cbc-39b8-a9df-ad7f9f543b9c",
                        "glosses": [
                            "Computerspeicher, bestehend aus magnetisierbaren Ringkernen, die durch Drähte zu einer Speichermatrix zusammengefügt sind."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7e54a26-7276-48cb-a531-e9eb67740e44",
                                "sense_id": "59c39edc-2a0a-3363-bbd5-4de0875c6939",
                                "text": "„Trommelspeicher wurden später und bis zur Einführung des Halbleiterspeichers durch Kernspeicher ersetzt, der schneller war und ohne bewegte Teile auskam.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0e5f70c-ddbe-4ef3-89a1-04ffe761963a",
                        "source_entry_id": "3fa4da8b-9cbc-39b8-a9df-ad7f9f543b9c",
                        "source_sense_id": "59c39edc-2a0a-3363-bbd5-4de0875c6939",
                        "target_lang_word": "core memory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "core memory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d642b9f0-77a1-359f-9180-35a241c22c63",
                                        "entry_id": "f19ef31c-de06-381c-a34a-798399622aad",
                                        "glosses": [
                                            "A type of non-volatile random-access rewritable electronic memory using ferrite cores to magnetically store binary digits (bits)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6e6d65d-8aa4-4129-a90b-c07a74141212",
                                                "sense_id": "d642b9f0-77a1-359f-9180-35a241c22c63",
                                                "text": "Wilkes, on his visit to America in summer and fall 1950 had witnessed the core memory being implemented on the Whirlwind at MIT—and as in the case of seeing the control matrix in the same machine, this made a strong impression on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                        "entry_id": "f19ef31c-de06-381c-a34a-798399622aad",
                                        "glosses": [
                                            "A memory, especially one formed in childhood, which recalls a deeply significant event in one's life and can be remembered years later."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e95527-527e-4500-abe5-47b7c9b51684",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Grandfather Frahm told young Herbert how his father had been held over a trestle and whipped repeatedly for disobedience, as if serfdom persisted. That had made a lasting imprint on Ludwig Frahm, and the recounting of it made an indelible impression on the grandson, who tells it as one of the core memories of his Lübeck childhood."
                                            },
                                            {
                                                "example_id": "3bd2c063-fcff-4e11-a540-bf399eeefbca",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "My high school graduation is a core memory."
                                            },
                                            {
                                                "example_id": "e3b3d552-faa5-4572-9204-8984eb6dc75a",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "We had shared everything: clothes, childhoods, core memories, tears—but what we were experiencing now was unlike all the years that came before."
                                            },
                                            {
                                                "example_id": "41d79ff0-38c5-471b-aa28-4e41ee8e36c7",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Our real, inner, deep feelings are our own best teachers about who we really are. We may most often find these in our memories of childhood. It is there that many of our most deeply felt, core experiences lie. These and other memories of our most meaningful moments since childhood will be the fuel for the most powerful, moving writing we will ever do. Writing about these core memories takes us right back to those feelings we had then as well as how we are feeling about them now."
                                            },
                                            {
                                                "example_id": "5bb74c8d-7362-4748-9329-9bc48f25e83e",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "My core memories of childhood contain nothing but concrete, brick, cement, steel. Brooklyn is surrounded by the water, jutting into the Atlantic at Coney Island, bordered by the Upper and Lower New York Bays to the west and Jamaica Bay to the east, separated from Manhattan by the East River. Brooklyn had beaches, which had sand, which got tracked into houses laden with vileness. No, for us the borough was so densely urban that the notion of “land” or “sea” never arose. Earth was the name of the planet, not the surface of the world; soil, like dirt, was a bad thing."
                                            },
                                            {
                                                "example_id": "532265bd-30ee-429e-a7f1-0c73ca877ada",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "If life teaches us anything, it’s that we don’t have inexhaustible energy and time. It is perfectly possible to run out of both before we get all our stories written. With this in mind, because you have compiled the Core Memory List, you can identify your most important lifestories—the ones about the prime relationships and events of your life—and concentrate on writing these first. These few core memories serve well as the backbone of your longer lifewriting project. The peripheral stories can be dealt with later—as time and energy permit."
                                            },
                                            {
                                                "example_id": "9fedb081-b5c8-4f09-8c99-86bfba6ece0a",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "One of my core memories is a boat trip with Matt, Simon, Rob & friends on Harrison Lake. Some part of that sunrise shore is still in me."
                                            },
                                            {
                                                "example_id": "275c7aaa-d7a4-4844-9a5e-09e85d7b5d9b",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "@Sleestak @parva_x @heythisisbrian I don't know how it happened or why it happened, but that is like a core memory of my childhood"
                                            },
                                            {
                                                "example_id": "86c8ff25-e5b8-48bc-ab58-beeb72c808d4",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "These are Riley's memories—and they're mostly happy, you'll notice, not to brag. But the really important ones are over here. I don't want to get too technical, but these are called core memories. Each one came from a super important time in Riley's life. Like when she first scored a goal? That was so amazing!"
                                            },
                                            {
                                                "example_id": "6b0e5641-c626-4b4c-b83f-26207e402aa0",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "We all have a journey in life….mine has been a struggle with food. I know when it started. I was in Grade 5, not much older than my eldest son. Unfortunately, for me, it’s one of my ‘core memories’…."
                                            },
                                            {
                                                "example_id": "79812d17-7e18-4a20-aaf9-69c593c11ab3",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Recall the case of Rebecca from Chapter 8 who retained core memories of multiple instances of abuse when she was 3 and 4 years old over a 12-year period."
                                            },
                                            {
                                                "example_id": "abed80fa-9a81-4aeb-b989-1e60f0476d70",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Why was it, then, that no thought of any of the companies I had created crossed my mind in the face of death? Why were they not the core memories and achievements my mind retrieved when scanning the past?"
                                            },
                                            {
                                                "example_id": "b9237fb3-7d43-401e-92fe-20b1aa2f3ac9",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "A few weeks later I glance at my dreamscape, still sitting near my computer and connect my dreamscape experience to a core memory: my 12-year old^([sic]) self stands in front of the class, shamed by the teacher for not knowing the answer."
                                            },
                                            {
                                                "example_id": "ac4606a6-340e-4df8-9210-b69a2e2f29bc",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "In your classroom, students will develop core memories based on past events, current experiences, and relationships."
                                            },
                                            {
                                                "example_id": "b8bdc542-e5f3-416d-8b14-720608f1fc80",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Now and then Ketch almost felt he had a memory of being adrift on the sea. Maybe it was a core memory of the day he was born."
                                            },
                                            {
                                                "example_id": "ad6799e6-61f2-4a1c-b656-86a9fac645cf",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "As I turn to walk out, my face slams right into something firm and hard. I hiss, a string of curses coming out of my mouth, my bag dropping from my shoulder. / “Shit, sorry,” Logan says, picking up the bag from the floor. “You okay?” / No. I’m not okay. At least my nose isn’t bleeding; that’s a core memory right there."
                                            },
                                            {
                                                "example_id": "70958b85-4cb9-4a69-86c0-cb961ba522e7",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "The whole day is morphing into one of those core memories I know will haunt me when I least expect it, years from now, way after I’ve entered a new chapter where working for Sasha Sherman feels like a bad dream."
                                            },
                                            {
                                                "example_id": "37ef5caf-759c-4b6d-9d5b-c8dd9c37fc3c",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "Our brains are intricately created and our consciousness is so incredible that we analyse situations, store core memories and instil a sense of who we are — all in that beautiful thinking and feeling organ."
                                            },
                                            {
                                                "example_id": "f957bb66-c524-46e6-976f-70e7f7da56d4",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "When it comes to ideals, politics and beliefs – even at such a young age core memories have left their mark."
                                            },
                                            {
                                                "example_id": "e891f32b-dbe3-4803-86fe-2408bbfd6130",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "You're about to make some core memories for folks."
                                            },
                                            {
                                                "example_id": "47be7e1e-9a95-482a-983f-0a9e4d244b73",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "What constitutes a \"core memory\" depends on which moments you feel have contributed to creating the person you are today."
                                            },
                                            {
                                                "example_id": "a06074ea-d86a-407a-9624-cdf9db2ed1ea",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "“Scars” revealed a more tempered side of the Papa Roach frontman, seemingly unlocking a core memory for a lot of concert goers because everyone, with as much pain as they could muster, screamed the song-defining lines “Go. Fix. Yourself!”"
                                            },
                                            {
                                                "example_id": "01efa41d-3f52-4bf4-9969-64edad2968ad",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "CLOTHING brand ROXY unlocked a core memory for millennials with their newest collection."
                                            },
                                            {
                                                "example_id": "a51dfce3-a003-46db-9a5a-eee9ed92203c",
                                                "sense_id": "6619d539-4b24-3654-a3f0-2b3a8bf3f908",
                                                "text": "(The brief appearance of the character Zhu Bajie, hilariously translated as “Pigsy,” unlocked a core memory for me.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
