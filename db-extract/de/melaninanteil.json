                "senses": [
                    {
                        "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                        "entry_id": "b981ef6e-6357-31db-9a43-f8be3aca303e",
                        "glosses": [
                            "Gehalt/Menge des Pigments Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "022a36d4-d234-459f-8967-2a72422deaec",
                                "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                                "text": "„Ein hoher Melaninanteil färbt die Iris braun, ein niedrigerer lässt sie grün, blau oder grau erscheinen.“"
                            },
                            {
                                "example_id": "b13ca11b-e720-4f3b-b97f-11efa36738d6",
                                "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                                "text": "„Je nach Melaninanteil der Haut variiert die Hautfarbe zwischen weißlich, gelb und schwarz.“"
                            },
                            {
                                "example_id": "5b04fde9-8fd7-47f4-afaa-7faf7a33ea9e",
                                "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                                "text": "„Augenfarben künstlich zu modifizieren, war für die moderne Medizin eigentlich kein Problem mehr; man passte einfach den Melaninanteil in der Regenbogenhaut des Auges an, um den gewünschten Farbton zu erzielen.“"
                            },
                            {
                                "example_id": "7ab99afc-89f5-44b4-a831-b8eaa807ce1e",
                                "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                                "text": "„Haben Sie ihnen erklärt, dass die Hautfarbe einfach vom Melaninanteil in den Zellen abhängt und einen Menschen in keiner Weise definiert?“"
                            },
                            {
                                "example_id": "123a7c59-55c5-4e01-b9fe-9c9a716b79c8",
                                "sense_id": "4cfe4fc7-af4a-3264-84c7-53fc6b68098e",
                                "text": "„Ich habe mich in den letzten Jahrzehnten größtenteils vor dem Rechner aufgehalten und dadurch den Melaninanteil meiner Haut auf ein Minimum heruntergefahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
