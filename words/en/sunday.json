    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "679aee5a-e3ce-36c0-9ebe-c4949788ffd4",
                    "sense_definition": "The day of the week between Saturday and Monday.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "calendar_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We go to church every <w>Sunday</w> morning.",
                            "target_lang_translations": {
                                "ru": "Мы ходим в церковь каждое <w>воскресенье</w> утром.",
                                "zh": "我们每个<w>周日</w>早上都去教堂。"
                            }
                        },
                        {
                            "text": "The shop is closed on <w>Sunday</w>.",
                            "target_lang_translations": {
                                "ru": "Магазин закрыт в <w>воскресенье</w>.",
                                "zh": "这家店<w>周日</w>不营业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Sun",
                        "Sun.",
                        "the Lord's day"
                    ],
                    "common_phrases": [
                        "on Sunday",
                        "every Sunday",
                        "next Sunday",
                        "last Sunday"
                    ],
                    "target_lang_definitions": {
                        "ru": "День недели между субботой и понедельником.",
                        "zh": "一周中介于星期六和星期一之间的那一天。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воскресенье",
                                "target_lang_sense_clarification": "день недели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "星期日",
                                "target_lang_sense_clarification": "一周的第七天"
                            },
                            {
                                "target_lang_word": "周日",
                                "target_lang_sense_clarification": "星期日的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8acdb6f-fd3a-31bb-ab7b-db97dd27785e",
                    "sense_definition": "Describes someone who does an activity occasionally or without professional skill.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attributive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is just a <w>Sunday</w> painter, but he enjoys it very much.",
                            "target_lang_translations": {
                                "ru": "Он всего лишь <w>художник-любитель</w>, но ему это очень нравится.",
                                "zh": "他只是个<w>业余</w>画家，但他乐在其中。"
                            }
                        },
                        {
                            "text": "Please be patient and do not act like a <w>Sunday</w> driver.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, наберись терпения и не веди себя как <w>неумелый</w> водитель.",
                                "zh": "请耐心点，别像个<w>技术生疏的</w>司机那样开车。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Sunday driver",
                        "Sunday painter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает человека, занимающегося чем-либо время от времени или без профессиональных навыков.",
                        "zh": "形容某人偶尔从事某项活动或缺乏专业技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любительский",
                                "target_lang_sense_clarification": "непрофессиональный"
                            },
                            {
                                "target_lang_word": "воскресный",
                                "target_lang_sense_clarification": "досуговый, нерегулярный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业余的",
                                "target_lang_sense_clarification": "非职业的"
                            },
                            {
                                "target_lang_word": "非专业的",
                                "target_lang_sense_clarification": "技术不熟练的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "750f2cef-9dae-3a57-8b69-f2784abcb164",
                    "sense_definition": "Describes clothing or items that are fine, elegant, and suitable for special occasions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attributive_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were dressed in their <w>Sunday</w> best for the party.",
