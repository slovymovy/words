                        "entry_id": "f9d98bd7-6241-3170-b887-c40ea4cc41c1",
                        "glosses": [
                            "staatliche, finanzielle Unterstützung an einen Elternteil, der sein neugeborenes Kind aufzieht und kaum oder nicht berufstätig ist"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "762aa386-7372-49f7-b753-cc8de103ba15",
                                "sense_id": "f1816627-0073-3443-81dc-82dde36e014e",
                                "text": "„Seit Anfang 2007 ersetzt das einkommensabhängige Elterngeld das Erziehungsgeld.“"
                            },
                            {
                                "example_id": "7a3b4a11-864e-432a-b2ca-27c165964479",
                                "sense_id": "f1816627-0073-3443-81dc-82dde36e014e",
                                "text": "„Für das einkommensabhängige Elterngeld entfällt seit 2007 das bisherige Erziehungsgeld von 300 Euro, das bis zu 24 Monate an einkommensschwache Eltern gezahlt wird.“"
                            }
                        ],
