                ],
                "senses": [
                    {
                        "sense_id": "b116fbb0-82da-34c9-aee4-48b85730e72a",
                        "entry_id": "7b5ff772-924e-367d-96c4-b3eab74b694c",
                        "glosses": [
                            "Methoden, den Personen, die eine Sprache lernen, die Hemmung zu nehmen, in der neuen Sprache zu kommunizieren"
                        ],
                        "tags": [
                            "speziell Sprachdidaktik"
                        ],
                        "examples": [
                            {
                                "example_id": "353d2de0-f30b-442c-a78b-6fe3b875353b",
                                "sense_id": "b116fbb0-82da-34c9-aee4-48b85730e72a",
                                "text": "„Die Sprachanimation nutzt Spiel- und Bewegungselemente, um den Lernenden Hemmungen vor der Fremdsprache zu nehmen.“"
                            },
                            {
                                "example_id": "58537e74-dace-4273-bebc-c16c0d98e48a",
                                "sense_id": "b116fbb0-82da-34c9-aee4-48b85730e72a",
                                "text": "„Die Sprachanimation vermittelt mit Musik und Bewegung erste Kenntnisse der Nachbarsprache, motiviert die Kinder und Erzieherinnen durch Spaß am Sprechen zum weiteren Lernen und weckt Neugier auf das Nachbarland.“"
                            },
                            {
                                "example_id": "cabd4685-5472-4b21-8bb2-8b925de7e7f1",
                                "sense_id": "b116fbb0-82da-34c9-aee4-48b85730e72a",
                                "text": "„Mit den Sprachanimationen erreichte die Euregio im letzten Jahr sowie in den ersten Wochen 2010 an 27 Schulen insgesamt rund 2000 Schülerinnen und Schüler in Oberfranken und in der nördlichen Oberpfalz mit einer Botschaft über Tschechien und die tschechische Sprache.“"
                            },
                            {
                                "example_id": "d5960a0a-fb5e-4360-97b1-d0d5091de6aa",
                                "sense_id": "b116fbb0-82da-34c9-aee4-48b85730e72a",
                                "text": "„Sprachanimation animiert vor allem zu Beginn dazu, die zu lernende Fremdsprache nicht nur passiv zu lernen, sondern auch aktiv zu benutzen. Sie stellt eine Ergänzung zur traditionellen Vermittlung von Fremdsprachen dar. Mit Hilfe der Sprachanimation kann in einem relativ kurzen Zeitraum zumindest der Ansatz einer Sprechfähigkeit hergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
