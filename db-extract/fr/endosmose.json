                "forms": [
                    {
                        "form_id": "b31a8641-e450-4985-bb5f-f754b0ed5c48",
                        "entry_id": "5e35ed78-e381-36a2-87f2-e6ec623d0306",
                        "tags": [
                            "plural"
                        ],
                        "form": "endosmoses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ea1aedd-62d0-3157-8b18-09bc65f7322a",
                        "entry_id": "5e35ed78-e381-36a2-87f2-e6ec623d0306",
                        "glosses": [
                            "Osmose entre deux liquides de densité différente et qui va du dehors en dedans."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "10e2e0a1-394a-4782-a688-1e2be599f3ce",
                                "sense_id": "6ea1aedd-62d0-3157-8b18-09bc65f7322a",
                                "text": "Il s'occupe de la ponte des œufs et entrevoit l’endosmose qui donne la clé de l'inexplicable énigme de leur croissance."
                            }
                        ]
                    },
                    {
                        "sense_id": "bac2ac64-6466-3d1c-ae74-faf06d143121",
                        "entry_id": "5e35ed78-e381-36a2-87f2-e6ec623d0306",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1f38d84a-8a95-460d-806d-e48780669690",
                                "sense_id": "bac2ac64-6466-3d1c-ae74-faf06d143121",
                                "text": "D'accord avec Waldeck-Rousseau, Galliffet avait en effet disposé que les besognes de contre-espionnage seraient dorénavant confiées pour la majeure part à la Sûreté générale. À quiconque n'est pas affligé de l'endosmose militariste, la décision apparaît comme de sagesse."
                            },
                            {
                                "example_id": "968bffdc-b385-4d9a-811b-da55ef5e3fca",
                                "sense_id": "bac2ac64-6466-3d1c-ae74-faf06d143121",
                                "text": "Des endosmoses fulgurantes me permettent d'avoir le pied léger, la main leste et l'œil sûr."
                            }
                        ]
                    }
                ],
