                        "source_sense_id": "8a1c40b6-9d74-33f7-9e57-fd59caff5eda",
                        "target_lang_word": "прямолинейность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прямолинейность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a746e3-3625-3f7b-83c7-dda3b70e6e80",
                                        "entry_id": "f502b5d9-bda2-3353-b630-90148bad3370",
                                        "glosses": [
                                            "свойство по значению прилагательного прямолинейный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6553572-0947-4f76-b9cd-fb49b714fd3c",
                                                "sense_id": "f4a746e3-3625-3f7b-83c7-dda3b70e6e80",
                                                "text": "«Улицы» были расположены с прямолинейностью плана американских городов."
                                            },
                                            {
                                                "example_id": "f0487504-7242-40a1-abcb-8e2979d4e6c1",
                                                "sense_id": "f4a746e3-3625-3f7b-83c7-dda3b70e6e80",
                                                "text": "〈…〉 при всяком прищуривании глаз вследствие наличия ресниц, обнаруживаются такие нарушения прямолинейности света, что известно, и особенно хорошо, детям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6585d03c-8bc3-3c0f-b37c-14423bf36361",
                                        "entry_id": "f502b5d9-bda2-3353-b630-90148bad3370",
                                        "glosses": [
                                            "откровенность и прямота без необходимой гибкости, чуткости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320e88f6-c849-45e5-a283-04ce20efff2e",
                                                "sense_id": "6585d03c-8bc3-3c0f-b37c-14423bf36361",
                                                "text": "Он был неуживчив вследствие своей прямолинейности и гордости."
                                            },
                                            {
                                                "example_id": "fa72872b-5106-43bd-8daf-221b85e3363e",
                                                "sense_id": "6585d03c-8bc3-3c0f-b37c-14423bf36361",
                                                "text": "― Достоевский считал характернейшей особенностью интеллигенции ― и Толстого ― неистовую, исступлённую прямолинейность грузного, тяжёлого русского ума."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
