                    {
                        "form_id": "0621ba60-9b4a-4fbd-b04d-b43e8d09a765",
                        "entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "alcoolisées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bc50e571-9946-3d7d-a3e0-2364b8613864",
                        "entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
                        "glosses": [
                            "Qui contient de l’alcool."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e891491-f61c-46e8-a934-6427023b36ed",
                                "sense_id": "bc50e571-9946-3d7d-a3e0-2364b8613864",
                                "text": "La promesse valait pour l'ensemble des chasseurs, dont la transpiration mêlée aux émanations alcoolisées d’après-rasage emboucanait l'atmosphère d'un suint pimenté."
                            },
                            {
                                "example_id": "feefb301-36d7-45e2-b14b-c7f2cd5bedaa",
                                "sense_id": "bc50e571-9946-3d7d-a3e0-2364b8613864",
                                "text": "Il est interdit de vendre des boissons alcoolisées à des mineurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "10e3f899-b1ea-3025-a94e-c6b542c733ae",
                        "entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
                        "glosses": [
                            "Auquel on a ajouté de l’alcool."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c9d583b5-9e54-3101-8bcf-d2c9f985448a",
                        "entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
                        "glosses": [
                            "Qui consomme beaucoup d’alcool. Synonyme : alcoolique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168a968c-e868-44e2-96e5-d085a69ede84",
                                "sense_id": "c9d583b5-9e54-3101-8bcf-d2c9f985448a",
                                "text": "C’était une Majesté alcoolisée au dernier chef et incessamment imbibée de bière forte, de pombé et surtout d’un certain trois-six, dont Alvez la fournissait à profusion."
                            },
                            {
                                "example_id": "4b6b766c-67eb-4534-a1cf-c1bd4e1676f3",
                                "sense_id": "c9d583b5-9e54-3101-8bcf-d2c9f985448a",
                                "text": "Fils d’une mère alcoolisée, il avait des habitudes alcooliques datant de deux ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "6403d3dd-dc35-3574-82be-4af0c8c75953",
                        "entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
                        "glosses": [
                            "Qui a beaucoup bu, qui est en état d’ébriété."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ab83e3-1ae3-408d-adc0-6d89a073bd22",
                                "sense_id": "6403d3dd-dc35-3574-82be-4af0c8c75953",
                                "text": "Somme: fortement alcoolisé, le tireur a fait feu à trente reprises"
                            },
                            {
                                "example_id": "caf4e75b-816e-4416-94cf-81c690078e8a",
                                "sense_id": "6403d3dd-dc35-3574-82be-4af0c8c75953",
                                "text": "Avec les éthylotests anti-démarrage, on est parti du constat d’un comportement : les gens roulent trop souvent alcoolisés !"
                            },
                            {
                                "example_id": "6e758ad4-b4b9-4862-a257-7e95bc8ce0f6",
                                "sense_id": "6403d3dd-dc35-3574-82be-4af0c8c75953",
                                "text": "Alors, lorsqu'elle se fait percuter à scooter à l'âge de 18 ans par un conducteur alcoolisé, la première interrogation qu'elle formule à ses parents est de savoir si elle pourra surfer à nouveau un jour."
                            },
                            {
                                "example_id": "5dfe3e4b-128f-4e08-8475-624f136770a8",
                                "sense_id": "6403d3dd-dc35-3574-82be-4af0c8c75953",
                                "text": "Chiffre le plus saisissant : 93 % des conducteurs alcoolisés' impliqués dans un accident sont des hommes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3b8a9b3-854d-41f3-990e-793d5b05867a",
                        "source_entry_id": "d79096d2-25d9-3c60-b8d4-912257feaecb",
