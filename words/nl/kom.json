            "senses": [
                {
                    "sense_id": "cf385ab6-aa4c-3e01-8c34-4bc4a6a9f76b",
                    "sense_definition": "een diep, rond voorwerp van aardewerk of glas om uit te eten of te drinken",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vaatwerk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik eet elke ochtend een grote <w>kom</w> yoghurt met vruchten.",
                            "target_lang_translations": {
                                "en": "I eat a large <w>bowl</w> of yogurt with fruit every morning.",
                                "ru": "Каждое утро я съедаю большую <w>миску</w> йогурта с фруктами."
                            }
                        },
                        {
                            "text": "Zou je die <w>kom</w> soep voorzichtig op tafel willen zetten?",
                            "target_lang_translations": {
                                "en": "Would you please carefully put that <w>bowl</w> of soup on the table?",
                                "ru": "Не мог бы ты осторожно поставить эту <w>тарелку</w> супа на стол?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "kom soep",
                        "diepe kom"
                    ],
                    "target_lang_definitions": {
                        "en": "a deep, round object made of earthenware or glass for eating or drinking from",
                        "ru": "глубокий круглый предмет из керамики или стекла для еды или питья"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bowl",
