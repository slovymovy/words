                ],
                "senses": [
                    {
                        "sense_id": "b5e7cfaa-b3cd-343b-a5de-57cd456147af",
                        "entry_id": "c8879b08-0536-3dc9-b1e9-4d90abcf9c96",
                        "glosses": [
                            "Ort – insbesondere auf der Erdoberfläche oder im Körper –, an dem oder unter dem etwas abgebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed108f81-4da9-4d69-b685-4178e4becdf2",
                                "sense_id": "b5e7cfaa-b3cd-343b-a5de-57cd456147af",
                                "text": "„So richtete der 1982 gegründete Förderverein bergbauhistorischer Stätten südliches Ruhrgebiet einen Bergbaurundweg in Witten ein, der inzwischen zahlreiche frühe Abbauorte südlich der Ruhr zugänglich macht.“"
                            },
                            {
                                "example_id": "d5a5c333-68bc-4a42-bb72-1588db1aeea3",
                                "sense_id": "b5e7cfaa-b3cd-343b-a5de-57cd456147af",
                                "text": "„Der Abbauort wäre nur wenige Kilometer von der Altstadt der unter UNESCO-Welterbe stehenden Stadt Caceres gelegen.“"
                            },
                            {
                                "example_id": "aff7742c-ca53-4b7c-80cd-e64fb3bd1725",
                                "sense_id": "b5e7cfaa-b3cd-343b-a5de-57cd456147af",
                                "text": "„Damit lassen sich Einblicke in den Abbauort der Thrombocyten gewinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
