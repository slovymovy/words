                    {
                        "translation_id": "82b0a673-16e2-476b-83dc-e61133d89b06",
                        "source_entry_id": "02804e81-d7a0-3fda-bd70-ad40b87960a9",
                        "source_sense_id": "c35035ac-534b-3eaf-9937-3e3030e2eed9",
