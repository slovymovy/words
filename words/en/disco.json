        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b8d7f56-b047-33c6-962d-4a06f8625b98",
                    "sense_definition": "A genre of dance music popular in the 1970s, characterized by a strong beat and elements of soul.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ played classic <w>disco</w> hits all night long.",
                            "target_lang_translations": {
                                "ru": "Диджей всю ночь играл классические хиты <w>диско</w>.",
                                "zh": "DJ整晚都在播放经典的<w>迪斯科</w>金曲。"
                            }
                        },
                        {
                            "text": "She loves the rhythm and energy of 1970s <w>disco</w> music.",
                            "target_lang_translations": {
                                "ru": "Ей нравятся ритм и энергетика музыки <w>диско</w> 1970-х годов.",
                                "zh": "她热爱20世纪70年代<w>迪斯科</w>音乐的节奏感和活力。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "disco music",
                        "disco ball",
                        "disco era",
                        "disco beat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр танцевальной музыки, популярный в 1970-х годах, характеризующийся сильным битом и элементами соула.",
                        "zh": "一种流行于20世纪70年代的舞曲风格，以强劲的节拍和灵魂乐元素为特征。"
                    },
                    "translations": {
