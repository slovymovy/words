                "senses": [
                    {
                        "sense_id": "2e5f2ea1-d701-3c5e-9956-a4dea2533ddd",
                        "entry_id": "877337f2-e723-3fb1-8803-819c8a615fd5",
                        "glosses": [
                            "Recht der Frauen, sich an Wahlen zu beteiligen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee28c6fd-a641-4921-9299-886f1997bf4f",
                                "sense_id": "2e5f2ea1-d701-3c5e-9956-a4dea2533ddd",
                                "text": "„Das 20. Jahrhundert brachte für Frauen erheblich verbesserte Bildungsmöglichkeiten; außerdem wurde im Jahr 1920 durch einen Zusatzartikel zur Verfassung endlich in allen Bundesstaaten das Frauenwahlrecht eingeführt.“"
                            },
                            {
                                "example_id": "e6379b9d-6086-4e55-a8c2-ff86d0cb2050",
                                "sense_id": "2e5f2ea1-d701-3c5e-9956-a4dea2533ddd",
                                "text": "„In ihr regte sich die junge Feministin, die einst für das Frauenwahlrecht demonstriert und gegen die Ungerechtigkeit aufbegehrt hatte, dass Frauen von allen wichtigen Dingen ferngehalten wurden.“"
                            },
                            {
                                "example_id": "dd2d8141-f1d3-47b6-a9a0-3985d5f3a7b5",
                                "sense_id": "2e5f2ea1-d701-3c5e-9956-a4dea2533ddd",
                                "text": "„Wie der Briefträger bestimmt weiß, ist der Regenwurm zwiegeschlechtlich, weshalb die Frage des Frauenwahlrechts für ihn gar kein Thema ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
