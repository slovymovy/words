                "senses": [
                    {
                        "sense_id": "9de035d7-dd48-3f6f-95b0-b51b6fc7bd4a",
                        "entry_id": "15b04ef5-7e28-3f25-90dd-6fd5496cdac0",
                        "glosses": [
                            "Regel, die laut der Theorie der konversationellen Implikatur die Grundlage jeder sprachlichen Kommunikation bildet"
                        ],
                        "tags": [
                            "Pragmatik"
                        ],
                        "examples": [
                            {
                                "example_id": "240950f3-679a-4841-8874-78147187cbe0",
                                "sense_id": "9de035d7-dd48-3f6f-95b0-b51b6fc7bd4a",
                                "text": "„Was die Grundlegung der Kommunikation im Kooperationsprinzip besagen will, ist, dass wir nicht anders können als uns gegenseitig ein gewisses Mass an Kohärenz, Interpretierbarkeit und damit an Rationalität zuzuschreiben, solange wir überhaupt miteinander sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e1ab89fb-05f3-36ac-aa50-b14db022dc6b",
                        "entry_id": "15b04ef5-7e28-3f25-90dd-6fd5496cdac0",
                        "glosses": [
                            "Grundsatz, umweltpolitische Maßnahmen einvernehmlich mit verschiedenen gesellschaftlichen Gruppen zu erarbeiten"
                        ],
                        "tags": [
                            "Umweltpolitik"
                        ],
                        "examples": [
                            {
                                "example_id": "6cc9d7d2-2d19-4716-9cdf-9d81f7866fe0",
                                "sense_id": "e1ab89fb-05f3-36ac-aa50-b14db022dc6b",
                                "text": "„Der elende Streit ums Dosenpfand weitet sich zu einem schier endlosen Lehrstück in Sachen Umweltpolitik aus – und hat das viel beschworene Kooperationsprinzip bereits schwer beschädigt.“"
                            }
                        ],
