                        "entry_id": "15335855-9e2b-3cc8-ab64-0fad217eaf9a",
                        "glosses": [
                            "genocide door de nazi's op de Joden in de 20e eeuw"
                        ],
                        "tags": [
                            "pregnant"
                        ],
                        "examples": [
                            {
                                "example_id": "9f2ffdca-52c3-4a2c-9344-2e765845c467",
                                "sense_id": "df6db19c-6fb7-3092-a21c-da97c8656472",
                                "text": "De werkkampen waren onderdeel van de Jodenvervolging en zo goed als alle mannen, ruim 35.000, die in de kampen verplicht te werk werden gesteld vonden via Westerbork de dood in concentratie- en vernietigingskampen."
                            }
                        ]
                    }
