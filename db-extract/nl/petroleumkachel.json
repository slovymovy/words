                        "entry_id": "e07cdc13-05a2-35d8-a6cf-e37bb5d46320",
                        "glosses": [
                            "een kachel die warmte geeft door de verbranding van petroleum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32ee69a9-4acb-4f23-8c90-128fabf93d7e",
                                "sense_id": "62a0fa58-9c36-351d-991e-239a3e8d0c85",
                                "text": "De hout- of petroleumkachel van zolder halen om de energiekosten te drukken is niet zonder gevaar. Daarvoor waarschuwt Brandweer Nederland. Koolmonoxidevergiftiging en brandgevaar liggen op de loer als de kachels niet op de juiste manier gebruikt worden."
                            },
                            {
                                "example_id": "32215677-d61a-4a7d-825f-c3a478626b8c",
                                "sense_id": "62a0fa58-9c36-351d-991e-239a3e8d0c85",
                                "text": "De brandweer rukte met groot materieel uit en had het vuur na enkele uren onder controle. Het vuur is vermoedelijk ontstaan toen het slachtoffer in zijn slaapkamer een petroleumkachel wilde bijvullen."
                            }
                        ]
                    }
