                },
                {
                    "sense_id": "9c48ca0b-16d5-330a-b007-3f696f454d09",
                    "sense_definition": "Een stof die wordt toegevoegd om smaak en geur aan voedingsmiddelen te geven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smaakstof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de verpakking van kant-en-klaarmaaltijden kun je lezen welke <w>aroma's</w> gebruikt werden.",
                            "target_lang_translations": {
                                "en": "On the packaging of ready-made meals, you can read which <w>flavorings</w> were used.",
                                "ru": "На упаковке готовых блюд можно прочитать, какие <w>ароматизаторы</w> были использованы."
                            }
                        },
                        {
                            "text": "De fabrikant voegt een natuurlijk <w>aroma</w> toe om de yoghurt naar aardbeien te laten smaken.",
                            "target_lang_translations": {
                                "en": "The manufacturer adds a natural <w>flavoring</w> to make the yogurt taste like strawberries.",
                                "ru": "Производитель добавляет натуральный <w>ароматизатор</w>, чтобы придать йогурту вкус клубники."
                            }
                        }
                    ],
                    "synonyms": [
