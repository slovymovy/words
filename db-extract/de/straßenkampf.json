                ],
                "senses": [
                    {
                        "sense_id": "67b17ad7-cf05-38af-8415-778d27808a29",
                        "entry_id": "f867111c-10cb-3e94-a8fd-1319751d2dd0",
                        "glosses": [
                            "auf Straßen ausgetragene gewalttätige Auseinandersetzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e61b00f-2496-4b74-ac92-c1c7908d9b59",
                                "sense_id": "67b17ad7-cf05-38af-8415-778d27808a29",
                                "text": "„Dann wurden die rauhen, staubaufwirbelnden und zuweilen mehrere Tage andauernden Straßenkämpfe sofort unterbrochen.“"
                            },
                            {
                                "example_id": "67d3f519-791b-435d-a4c0-853471b94004",
                                "sense_id": "67b17ad7-cf05-38af-8415-778d27808a29",
                                "text": "„Was hatte sie sich nicht alles anhören müssen: Frauen gehörten nicht in eine Uniform, seien für den Straßenkampf ungeeignet.“"
                            },
                            {
                                "example_id": "25b5c370-9fd3-49de-bb5b-9d6b282718ba",
                                "sense_id": "67b17ad7-cf05-38af-8415-778d27808a29",
                                "text": "„Wir hatten im vergangenen Jahr von Straßenkämpfen zwischen rechten und linken Studentengruppen gelesen, und im Februar hatte es hier Demonstrationen gegen den Besuch des US-Präsidenten gegeben.“"
                            },
                            {
                                "example_id": "22548b85-aba9-4ca6-a280-e40c9f19fd6f",
                                "sense_id": "67b17ad7-cf05-38af-8415-778d27808a29",
                                "text": "„Dann kam der große Angriff auf Potsdam: Artilleriebeschuß, Straßenkämpfe, die russische Invasion und eine lange Zeit unter furchtbaren Bedingungen, bis sie nach Zehlendorf umziehen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
