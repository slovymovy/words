                    {
                        "translation_id": "bf2a0443-5ce6-46d5-9d29-864c06382462",
                        "source_entry_id": "fa48b822-a13e-3d1e-8c58-231bee7d296e",
                        "source_sense_id": "c3660e0c-48fd-3449-9fc1-6410b6ef7150",
                        "source_sense_description": "an evergreen coniferous tree",
                        "target_lang_word": "кипари́с",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "кипари́с",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a88e1832-92d8-304d-bdef-baa50865cfeb",
                                        "entry_id": "0e37e5ed-4f3b-3ddf-ad51-a8e6488727c6",
                                        "glosses": [
                                            "ботан. род вечнозелёных деревьев и кустарников семейства кипарисовых с пирамидальной или раскидистой кроной; также растение этого рода (Cupressus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98bcce97-2bd6-4019-aa02-9c05d2dc7b2f",
                                                "sense_id": "a88e1832-92d8-304d-bdef-baa50865cfeb",
                                                "text": "Свернув за угол ослепительно контрастирующей улицы, они оказались на точно такой же, только ещё белее и ещё синее, потому что ровно посередине ее рос тёмно-голубой кипарис, а солнце склонилось на запад."
                                            },
                                            {
                                                "example_id": "6d2b7168-2e41-4dd6-8ae8-0f6e7af92141",
                                                "sense_id": "a88e1832-92d8-304d-bdef-baa50865cfeb",
                                                "text": "На вершине холма того стоял кипарис возвышенный; на ветвях его висели доспехи ратные, булава и меч великий."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
