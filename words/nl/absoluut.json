                                "target_lang_word": "absolute",
                                "target_lang_sense_clarification": "complete and unconditional"
                            },
                            {
                                "target_lang_word": "total",
                                "target_lang_sense_clarification": "complete in amount or degree"
                            },
                            {
                                "target_lang_word": "complete",
                                "target_lang_sense_clarification": "having all necessary parts"
                            }
