                        "sense_id": "10cbf29d-e517-3d1b-b5fa-3b2069efd2d5",
                        "entry_id": "b12ed9b4-cc6e-3dde-86b8-278c0f2ac76b",
                        "glosses": [
                            "duševní klid, mysticko-kontemplativní pohroužení jakožto praktika kvietismu"
                        ],
                        "tags": [],
                        "examples": [
