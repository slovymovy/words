                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18da611b-3386-4055-999f-efca87b716d7",
                                "sense_id": "e9e4c6ab-3051-3ead-a9e7-762f2f2e8351",
                                "text": "Stéphanie Lopes d’Azevedo, directrice économie et technique de l’Union des transports publics et ferroviaires (UTP), relève, d’emblée, le coût « non négligeable » de l’opération pour l’État allemand : 2,5 milliards d’euros."
                            },
                            {
                                "example_id": "6f74bb89-2d4b-411f-bb53-0a2dbdfdc920",
                                "sense_id": "e9e4c6ab-3051-3ead-a9e7-762f2f2e8351",
                                "text": "Gratuité dans les transports, versement-mobilité et bus propres : l’UTP se trouve au cœur des débats qui agitent le secteur."
                            },
                            {
                                "example_id": "bd7e4734-01ca-403e-95b2-fda589fb518c",
                                "sense_id": "e9e4c6ab-3051-3ead-a9e7-762f2f2e8351",
                                "text": "L’Union des Transports Publics et ferroviaires (UTP) a choisi Florence Sautejeau pour succéder à Claude Faucher au poste de déléguée générale."
                            }
                        ]
