            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4edd7d40-66ae-37f0-9a42-e74aa5a3df71",
                    "sense_definition": "Pays où l'on est né ou auquel on appartient comme citoyen, pour lequel on éprouve un sentiment d'appartenance collective.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "nation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après de longues années passées à l'étranger, il a décidé de revenir dans sa <w>patrie</w>."
                        },
                        {
                            "text": "Les soldats se sont mobilisés avec courage pour défendre leur chère <w>patrie</w>."
                        }
                    ],
                    "synonyms": [
                        "pays",
                        "matrie"
                    ],
                    "common_phrases": [
                        "défendre sa patrie",
                        "mourir pour la patrie",
                        "amour de la patrie"
                    ]
                },
                {
                    "sense_id": "42a7daea-bd65-3644-a1fb-49a6eb226ce7",
                    "sense_definition": "Lieu emblématique où une idée, une discipline, un art ou une science trouve un terrain particulièrement favorable à son épanouissement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "foyer_symbolique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Grèce antique est reconnue dans le monde entier comme la <w>patrie</w> de la démocratie."
                        },
                        {
                            "text": "Cette magnifique cité d'Italie est considérée par les historiens comme la <w>patrie</w> des arts."
                        }
                    ],
                    "common_phrases": [
                        "patrie des arts",
                        "patrie de la philosophie"
                    ]
                },
                {
                    "sense_id": "45dd0ec5-4301-31d3-a757-a9eddac1a8e0",
                    "sense_definition": "Région ou milieu naturel dont une espèce animale ou végétale est originaire.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "foyer_symbolique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'Australie constitue la <w>patrie</w> naturelle de nombreuses espèces de marsupiaux uniques."
                        },
                        {
                            "text": "Cette plante délicate souffre du gel car elle est très éloignée de sa <w>patrie</w> d'origine."
                        }
                    ],
                    "common_phrases": [
                        "patrie d'origine"
                    ]
                },
                {
                    "sense_id": "c4bea96c-d96c-3809-ad62-d226a48fd3a2",
                    "sense_definition": "Province, région ou ville natale d'une personne, considérée comme son berceau local.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bien qu'il vive désormais dans la capitale, il reste profondément attaché à sa petite <w>patrie</w>."
                        },
                        {
                            "text": "L'auteur consacre son dernier roman aux souvenirs chaleureux de sa douce <w>patrie</w> natale."
                        }
                    ],
                    "common_phrases": [
                        "petite patrie"
                    ]
                }
            ]
        }
    ]
