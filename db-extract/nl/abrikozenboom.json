                                        "examples": [
                                            {
                                                "example_id": "5307ddea-8eed-4cf0-8d0c-5f5271204c55",
                                                "sense_id": "9f538f7c-652e-30b5-86a6-6cb9f233b420",
                                                "text": "L’industrie abricotière."
                                            },
                                            {
                                                "example_id": "70f74831-f25b-4768-b8f1-1a51d56ce213",
                                                "sense_id": "9f538f7c-652e-30b5-86a6-6cb9f233b420",
                                                "text": "En effet, « les modifications climatiques de la vallée du Rhône sont moindres » par rapport aux autres régions abricotières, plus au sud."
                                            }
