                    {
                        "translation_id": "e9e600a8-3626-4d6e-a536-4a3ff5374ca4",
                        "source_entry_id": "12a23626-90d5-3717-86a4-279aa0fb4888",
                        "source_sense_id": "9cbead4e-5320-3d7c-baad-7775b6ea7631",
                        "target_lang_word": "debenture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debenture",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a23692c1-37db-32c2-9cc8-c497a00e7fef",
                                        "entry_id": "a1592465-53ba-3932-a73c-a4d0a5e889dd",
                                        "glosses": [
                                            "A certificate that certifies an amount of money owed to someone; a certificate of indebtedness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc8761bc-ec8c-3df0-b7ce-130fe9485418",
                                        "entry_id": "a1592465-53ba-3932-a73c-a4d0a5e889dd",
                                        "glosses": [
                                            "A certificate of a loan made to the government; a government bond."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19350fc5-65cf-4b17-ab34-be47f5f9abce",
                                                "sense_id": "cc8761bc-ec8c-3df0-b7ce-130fe9485418",
                                                "text": "Madame Corre, who made the important decisions after her plodding husband had spent hours on the ledger, sold the family debentures and put the money into Dutch decurities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c606d5b-4828-375e-ab51-3e5a4f71046a",
                                        "entry_id": "a1592465-53ba-3932-a73c-a4d0a5e889dd",
                                        "glosses": [
                                            "A type of debt instrument secured only by the general credit or promise to pay of the issuer, not involving any physical assets or collateral, now commonly issued by large, well established corporations with adequate credit ratings."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ea6edcb-283c-3ed3-b316-2555b293d480",
                                        "entry_id": "a1592465-53ba-3932-a73c-a4d0a5e889dd",
                                        "glosses": [
                                            "A document granting lenders a charge over a borrower’s physical assets, giving them a means to collect a debt, as part of a secured loan."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cd5da20-fe19-4124-98fc-5f26861ffd40",
                                                "sense_id": "3ea6edcb-283c-3ed3-b316-2555b293d480",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9468197-c49f-4769-870e-8047be39bf47",
                        "source_entry_id": "12a23626-90d5-3717-86a4-279aa0fb4888",
                        "source_sense_id": "9cbead4e-5320-3d7c-baad-7775b6ea7631",
                        "target_lang_word": "obligation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obligation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3c4cbb5a-e2df-37e7-8afb-102a43f09dd6",
                                        "entry_id": "65d658fc-1b5a-3267-9a34-440a174364d9",
                                        "glosses": [
                                            "Lien moral qui impose quelque devoir concernant la religion, la morale ou la vie civile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50da20ba-5a44-42b4-93b7-f8cca50ed0de",
                                                "sense_id": "3c4cbb5a-e2df-37e7-8afb-102a43f09dd6",
                                                "text": "Puisqu’il ne faut jamais mentir, alors il faut mentir de temps en temps : l’obligation d’être véridique à tout prix contraint à mentir quand la vérité elle-même est plus fallacieuse que le mensonge."
                                            },
                                            {
                                                "example_id": "720682be-0d75-4c6e-997b-8e9d5e117009",
                                                "sense_id": "3c4cbb5a-e2df-37e7-8afb-102a43f09dd6",
                                                "text": "Sa générosité n’est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "9bfb458a-3653-4867-ae0b-ce66c8cf621e",
                                                "sense_id": "3c4cbb5a-e2df-37e7-8afb-102a43f09dd6",
                                                "text": "Il peut avoir lieu chez vous, mais aussi hors de votre lieu de vie et de vos habitudes, où il est plus facile de prendre conscience de soi, sans votre quotidien ultrarempli par les distractions et les obligations du foyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                                        "entry_id": "65d658fc-1b5a-3267-9a34-440a174364d9",
                                        "glosses": [
                                            "Lien de droit qui oblige à donner, à faire ou à ne pas faire une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4dd558f-e097-4fe6-a0da-dd5b22de659b",
                                                "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                                                "text": "Si la topographie l’exige, le préfet peut imposer sur certaines voies l’obligation de munir tout véhicule d'un frein ou d'un dispositif d’enrayage."
                                            },
                                            {
                                                "example_id": "4a2218a2-8e5c-495f-af29-9e4482134373",
                                                "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                                                "text": "Les obligations naissent des conventions ou contrats, ou des quasi-contrats, des délits ou des quasi-délits."
                                            },
                                            {
                                                "example_id": "f063d89f-bd4d-4104-9624-8d242e99e1c0",
                                                "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                                                "text": "Obligation solidaire."
                                            },
                                            {
                                                "example_id": "7e85817f-0267-45c6-bb78-79a860682738",
                                                "sense_id": "154f8e2b-4abf-31eb-852d-cb185db121d5",
                                                "text": "obligation éteinte, prescrite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "526db26d-df15-3b72-b395-0a9cdfd5e7b3",
                                        "entry_id": "65d658fc-1b5a-3267-9a34-440a174364d9",
                                        "glosses": [
                                            "Acte, fait par-devant notaire ou sous seing privé, par lequel on s’oblige à payer une certaine somme, à donner ou à faire telle chose dans un temps fixé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f004e981-8980-42dd-8554-1d76e176ba15",
                                                "sense_id": "526db26d-df15-3b72-b395-0a9cdfd5e7b3",
                                                "text": "Les Hulot jeune ont racheté les lettres de change du baron à Vauvinet, ils souscrivent demain une obligation de soixante-douze mille francs à cinq pour cent d’intérêt, remboursables en trois ans, avec hypothèque sur leur maison."
                                            },
                                            {
                                                "example_id": "dd86bb04-7499-4889-966b-0862b0f7e204",
                                                "sense_id": "526db26d-df15-3b72-b395-0a9cdfd5e7b3",
                                                "text": "Pour le surplus, soit un capital de 4 milliards 25 millions de dollars, la France remit aux États-Unis 62 obligations, datées du 15 juin 1925, et payables au gouvernement des États-Unis ou à son ordre, chacune d'entre elles correspondant à l'une des 62 annuités échelonnées de 1926 à 1988."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                                        "entry_id": "65d658fc-1b5a-3267-9a34-440a174364d9",
                                        "glosses": [
                                            "Titres productifs d’intérêt et remboursables dans un temps limité, que le gouvernement, des compagnies, des villes émettent pour se procurer de l’argent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9795b0f6-7251-4e9c-a939-f4559ea8ff32",
                                                "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                                                "text": "La plus grosse partie de l’argent laissé par Léon avait été transformée, comme d’habitude, en obligations des chemins de fer et de la compagnie générale d’électricité."
                                            },
                                            {
                                                "example_id": "3c7d80d7-10da-49ab-9156-66c4b9ffa154",
                                                "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                                                "text": "Une restructuration classique peut prendre différentes formes en pratique : décote sur la valeur faciale des obligations, baisse des taux d'intérêt, allongement de la maturité, conversion en un autre actif."
                                            },
                                            {
                                                "example_id": "ee5953c9-655a-4ff7-ae44-170ec15dbac8",
                                                "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                                                "text": "Obligations nominatives, au porteur."
                                            },
                                            {
                                                "example_id": "f8a4832e-4491-4356-9c29-55a6812eb6b0",
                                                "sense_id": "78f8dc64-e446-3a30-a25b-b1147fb780bc",
                                                "text": "Dans la période actuelle toutefois, les \"spreads\" sur les marchés des obligations d'État - écarts de rendement entre l'emprunt allemand, qui fait référence, et ceux d'autres pays en zone euro - sont \"restés contenus\", a certes rassuré le banquier central."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                                        "entry_id": "65d658fc-1b5a-3267-9a34-440a174364d9",
                                        "glosses": [
                                            "Lien de reconnaissance envers les personnes qui nous ont rendu des services plus ou moins importants."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40e27fcb-4508-46d4-b409-0fb5fa9c6c33",
                                                "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                                                "text": "Il prétend ne vous avoir aucune obligation."
                                            },
                                            {
                                                "example_id": "565ab125-49aa-4492-8a0b-65adf6c1e8ee",
                                                "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                                                "text": "Contracter une obligation envers quelqu’un."
                                            },
                                            {
                                                "example_id": "aee34d9f-c2f0-4a0e-baea-b382d946bda3",
                                                "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                                                "text": "Je lui en ai autant d’obligation que si la chose avait réussi."
                                            },
                                            {
                                                "example_id": "be17ed1a-5489-4027-873e-810b36f1d6a2",
                                                "sense_id": "78e87242-439f-3ced-988c-6001173b9fe0",
                                                "text": "C’est un homme à qui j’ai bien des obligations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80e2b343-71ae-4dc1-89cb-b336fc3ea2d8",
                        "source_entry_id": "12a23626-90d5-3717-86a4-279aa0fb4888",
                        "source_sense_id": "9cbead4e-5320-3d7c-baad-7775b6ea7631",
                        "target_lang_word": "promesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Action de promettre ; ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7cdde-cd1d-4d5b-bb3d-cb608e33acbc",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Mettez-vous en garde contre ces belles promesses, elles cachent souvent la plus infame des tromperies."
                                            },
                                            {
                                                "example_id": "2e4ea110-0aa7-4ea3-bd17-ce3255016b0f",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Et il réfléchissait. Ce qui est inintelligible, se dit-il, c’est la disproportion qui existe entre les promesses que Jésus lui fit et les résultats qu’elles obtinrent."
                                            },
                                            {
                                                "example_id": "24a634ea-4833-44fc-b8a7-0ff03b941ebd",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si Dimitri ne voulait pas épouser Phoebe, il aurait au moins dû avoir le courage de l’avouer et de rompre formellement sa promesse. Au lieu de cela, il avait opté pour le silence et l'hypocrisie, […]."
                                            },
                                            {
                                                "example_id": "fd84f999-8461-44eb-aab2-b3a4802055d5",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Si nous promettons une livraison, nous devons tenir notre promesse."
                                            },
                                            {
                                                "example_id": "e2199848-29a9-4050-8b7c-6a8d2e9fd84b",
                                                "sense_id": "63abfecc-9316-3fd7-9bed-d1b3ec068437",
                                                "text": "Venus en Europe avec la promesse d’un salaire de 1 500 euros mensuels, « voire 2 200 avec les bonus » selon Brighton Jonasi, la plupart ne reçoivent qu’entre 600 et 700 euros, depuis octobre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Ce que l'on espère obtenir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d2bcca-4eb8-4ee7-862b-fa3c9f026cac",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le talent, chez les hommes est donc à peu près, quant au moral, ce qu’est la beauté chez les femmes, une promesse."
                                            },
                                            {
                                                "example_id": "0dbc55fc-1a54-4012-a58b-7450e1b0c595",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Le curé de Melotte […] n’était plus craint. Ses foudres de carton, ses tonnerres lointains, l’évocation des bûchers infernaux, la promesse des félicités paradisiaques dans un éden, somme toute, passablement morne et fort problématique, ne faisaient plus guère frémir que quelques vieilles dévotes et les gosses de neuf à onze ans […]."
                                            },
                                            {
                                                "example_id": "ee961b96-21bf-445e-b7bd-179a285fae5f",
                                                "sense_id": "9066ce1e-9b9b-3a87-ae02-e02d284cd819",
                                                "text": "Parmi les fléaux qui s'abattent sur la vigne, le plus terrible, dans ses effets, est évidemment la grêle. Le vignoble est beau, et plein de promesses, et cinq minutes plus tard il n'en reste rien ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                        "entry_id": "bef878ab-1182-358e-9b8f-9f3bdcd065d7",
                                        "glosses": [
                                            "Engagement à terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5065659e-7cba-4a64-a00b-de7f7fa300a5",
                                                "sense_id": "9c3e0195-28a8-3da1-817d-2195f11767ec",
                                                "text": "Il faudrait, en premier lieu, répandre parmi nous, par le perfectionnement des institutions de crédit, l'usage des billets, des promesses, des reconnaissances. C'est dire que nos banques devraient cesser de vivre sous l'empire d'un monopole aussi absolu qu'injuste et funeste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74aebb66-bb3a-4313-a001-72e3c411c3ca",
                        "source_entry_id": "12a23626-90d5-3717-86a4-279aa0fb4888",
                        "source_sense_id": "9cbead4e-5320-3d7c-baad-7775b6ea7631",
                        "target_lang_word": "Schuldschein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuldschein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c53c0ec3-24ae-37dd-a091-46213c4278fc",
                                        "entry_id": "50b6ed03-7694-34a1-878a-094a27aeb0bf",
                                        "glosses": [
                                            "schriftliche Erklärung eines Schuldners über das Bestehen einer Verbindlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f79e513-913c-44a4-923d-81f56f765ba9",
                                                "sense_id": "c53c0ec3-24ae-37dd-a091-46213c4278fc",
                                                "text": "Eine bestimmte Form für einen Schuldschein ist nicht notwendig. Der Schuldschein muss folgende wesentlichen Bestandteile enthalten: das Datum, die Schuldsumme in Ziffern und in Buchstaben, eine Schulderklärung, ggf. auch eine Erklärung über die Rückzahlung und Verzinslichkeit."
                                            },
                                            {
                                                "example_id": "56c924ce-cf3a-41ac-baaa-5b185b486f48",
                                                "sense_id": "c53c0ec3-24ae-37dd-a091-46213c4278fc",
                                                "text": "„Wu Djän-én zog hastig aus der Brust den Schuldschein hervor und überreichte ihn Simen Tjing.“"
                                            },
                                            {
                                                "example_id": "d2690c88-fc9d-4688-aaeb-b4e0ecb0f30a",
                                                "sense_id": "c53c0ec3-24ae-37dd-a091-46213c4278fc",
                                                "text": "„Dafür nahm ich den Schuldschein an mich, in dem sie sich verpflichtete, mir den Betrag zu Neujahr zurückzuzahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
