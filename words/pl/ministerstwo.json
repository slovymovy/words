                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Protestujący zebrali się pod <w>ministerstwem</w>, aby wyrazić swoje niezadowolenie.",
