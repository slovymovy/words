                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To move (one object) while maintaining contact with another object over some area, with pressure and friction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cbd78e4-c214-47ea-93d6-df395f4ddf58",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "I rubbed the cloth over the glass."
                                            },
                                            {
                                                "example_id": "64be898e-6756-41c7-9482-40acb6c04cdc",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "The cat rubbed itself against my leg."
                                            },
                                            {
                                                "example_id": "ff037d8a-a924-49f8-a1c1-58fb6c4407a8",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "I rubbed my hands together for warmth."
                                            },
                                            {
                                                "example_id": "1b1db0e6-38ec-461e-9c9e-ca5148adfce9",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "You ſhould rub your Teeth and whole Mouth and Gums, the Pallate and Tongue, with a clean courſe cloth, rubbing off the ſlime which groweth upon them in the night."
                                            },
                                            {
                                                "example_id": "d460ff49-def5-4cc6-88fb-5a4e9e42db60",
                                                "sense_id": "e5254461-ba9c-3037-8136-22a2d9b522c2",
                                                "text": "[…] Walden rubbed his hands together and smiled contentedly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3da4dd7-4b26-3e11-85ad-2d30fb033e2c",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To be rubbed against something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee473bb-998b-40ec-a5d2-4895f892b48c",
                                                "sense_id": "e3da4dd7-4b26-3e11-85ad-2d30fb033e2c",
                                                "text": "My shoes are beginning to rub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79577514-b7d0-3cd1-af16-8d7539a3756c",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To spread a substance thinly over; to smear."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcbd1a09-a91e-4e72-8d1e-a385e2855e22",
                                                "sense_id": "79577514-b7d0-3cd1-af16-8d7539a3756c",
                                                "text": "meat rubbed with spices before barbecuing"
                                            },
                                            {
                                                "example_id": "5b293342-cadd-4727-bf7f-7516e6934a1f",
                                                "sense_id": "79577514-b7d0-3cd1-af16-8d7539a3756c",
                                                "text": "The smoothed plank, […] / New rubbed with balm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db729498-4ac4-35d0-9382-70ef603e5c7c",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To move or pass with difficulty."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd647ac5-e36f-4a00-a6e4-2fc1ea104bf4",
                                                "sense_id": "db729498-4ac4-35d0-9382-70ef603e5c7c",
                                                "text": "to rub through woods, as huntsmen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c844c94c-0f77-3902-bb01-b9df2df1d95f",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To scour; to burnish; to polish; to brighten; to cleanse; often with up or over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ebe5764-55bc-4ea8-9769-8f65d4565ba1",
                                                "sense_id": "c844c94c-0f77-3902-bb01-b9df2df1d95f",
                                                "text": "to rub up silver"
                                            },
                                            {
                                                "example_id": "afcc28a7-2725-4bd9-8160-ea302407a951",
                                                "sense_id": "c844c94c-0f77-3902-bb01-b9df2df1d95f",
                                                "text": "The whole business of our redemption is, in short, only to rub over the defaced copy of the creation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4437ca06-d92f-353a-a209-c2b0f2ca6ffc",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To hinder; to cross; to thwart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7d9020d-d6e0-4ad0-811c-1709dc475a38",
                                                "sense_id": "4437ca06-d92f-353a-a209-c2b0f2ca6ffc",
                                                "text": "'Tis the duke's pleasure, / Whose disposition, all the world well knows, / Will not be rubbed nor stopped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09921551-e4ea-3b68-a5ce-b356467a8dc1",
                                        "entry_id": "c7faf9f6-6b5a-3af5-be0e-316314260046",
                                        "glosses": [
                                            "To touch the jack with the bowl."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f035b34-0fb9-406e-ac59-aa5d421efd1f",
                        "source_entry_id": "2e799148-8606-38ac-9942-d775e39bae92",
                        "source_sense_id": "366dae2f-95e3-3ab9-8c21-dce17667edf7",
                        "target_lang_word": "eat away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eat away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3175b7a4-e083-3cfb-b7f0-e4f6a65f6fcd",
                                        "entry_id": "aefe2a76-c2e7-3a87-a886-8bae0b522579",
                                        "glosses": [
                                            "To physically corrode or erode (something) gradually."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90bf25af-ef56-417f-be9f-0723bfe48199",
                                                "sense_id": "3175b7a4-e083-3cfb-b7f0-e4f6a65f6fcd",
                                                "text": "The river bank had been eaten away over the years by the flood water."
                                            },
                                            {
                                                "example_id": "d82cab57-b73e-40ce-addc-bdd615648038",
                                                "sense_id": "3175b7a4-e083-3cfb-b7f0-e4f6a65f6fcd",
                                                "text": "To eate avvay dead fleſh, take Stubbe-vvort, and folde it vp in a red Docke leafe, or red VVort leafe, and ſo roſte it in the hot embers and lay it hot to any ſore, and it vvill fret avvay all the dead fleſh; […]"
                                            },
                                            {
                                                "example_id": "0bd91b29-685c-4b0f-b6b1-a37cc1003a84",
                                                "sense_id": "3175b7a4-e083-3cfb-b7f0-e4f6a65f6fcd",
                                                "text": "The wearing away of rock is the work partly of the atmosphere and partly of water. The action of the atmosphere is chemical, and eats away the rock as rust eats away iron."
                                            },
                                            {
                                                "example_id": "1f6fbc93-8ee5-4c06-9771-d34575484eb8",
                                                "sense_id": "3175b7a4-e083-3cfb-b7f0-e4f6a65f6fcd",
                                                "text": "The zinc electrode has a positive charge because it has lost electrons to the carbon electrode. This positive charge attracts the negative ions (SO₄) from the sulfuric acid. The negative ions combine with the zinc to form zinc sulfate. This action causes the zinc electrode to be eaten away. […] The process of the zinc being eaten away and the sulfuric acid changing to hydrogen and zinc sulfate is the cause of the cell discharging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2981261-3e85-39f9-a42a-9c51dd273574",
                                        "entry_id": "aefe2a76-c2e7-3a87-a886-8bae0b522579",
                                        "glosses": [
                                            "To destroy (something) gradually by an ongoing process."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d05fd26a-2a77-4574-847b-bbe965edf0f6",
                                                "sense_id": "f2981261-3e85-39f9-a42a-9c51dd273574",
                                                "text": "At your Table I vvill proue / If I can eate avvay my loue."
                                            },
                                            {
                                                "example_id": "4980b23a-b240-484e-bb17-90e7f91711bf",
                                                "sense_id": "f2981261-3e85-39f9-a42a-9c51dd273574",
                                                "text": "[T]hus does politeneſs ſport vvith truth, and eating avvay the ſincerity and humanity natural to man, produce the fine gentleman."
                                            },
                                            {
                                                "example_id": "5be6ce6e-a4fb-4cc7-b2cd-a25070ef264b",
                                                "sense_id": "f2981261-3e85-39f9-a42a-9c51dd273574",
                                                "text": "The sun still eats away the shadow inch by inch, beating down with such intensity that finally everybody disappears except a few passers by."
                                            },
                                            {
                                                "example_id": "6ecac1b7-7a54-416c-baee-d352c60984aa",
                                                "sense_id": "f2981261-3e85-39f9-a42a-9c51dd273574",
                                                "text": "During the second year, Magnus's extracurricular activities ate away at his finances. Drugs and women did not come cheap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed18950-fdbc-36cf-9b47-a78fc8267639",
                                        "entry_id": "aefe2a76-c2e7-3a87-a886-8bae0b522579",
                                        "glosses": [
                                            "Chiefly followed by at: of a circumstance, incident, etc.: to cause (someone) to feel guilty, troubled, or worried; to bother (see eat away at)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic",
                                            "specifically",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8c4157-d62b-40e4-a335-fbb6b2eacfe4",
                                                "sense_id": "9ed18950-fdbc-36cf-9b47-a78fc8267639",
                                                "text": "Not confessing that I had stolen the money ate away at me until I could no longer sleep."
                                            },
                                            {
                                                "example_id": "86b3156e-a104-4b30-bc22-5e92038b7b63",
                                                "sense_id": "9ed18950-fdbc-36cf-9b47-a78fc8267639",
                                                "text": "The guilt of having lied was eating away at him."
                                            },
                                            {
                                                "example_id": "d20cd7ca-c8ab-49e6-b55c-d445acdc0304",
                                                "sense_id": "9ed18950-fdbc-36cf-9b47-a78fc8267639",
                                                "text": "Although you didn't want him around at first, the thought of losing him now is eating away at you."
                                            },
                                            {
                                                "example_id": "4ad51b7b-e377-4601-9697-09464ca0a7e0",
                                                "sense_id": "9ed18950-fdbc-36cf-9b47-a78fc8267639",
                                                "text": "If [Tony] Horton had stuck it out for only two more days, his value would have increased. Instead, he buckled at absolutely the worst time. This ate away at him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
