                                    {
                                        "sense_id": "17d61ff7-dd18-3667-a1d6-c0e3801d2662",
                                        "entry_id": "1321c80f-6966-3360-bbd3-20a770fab233",
                                        "glosses": [
                                            "ohne Bedeutung, ohne besonderen Sinn, sich leer fühlend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69681560-2136-4639-ae71-a8420e17cc0b",
                                                "sense_id": "17d61ff7-dd18-3667-a1d6-c0e3801d2662",
                                                "text": "Wie leer und bedeutungslos ist das Leben."
                                            },
                                            {
                                                "example_id": "60284640-0c6a-4586-831e-21271e94ebf1",
                                                "sense_id": "17d61ff7-dd18-3667-a1d6-c0e3801d2662",
                                                "text": "„Jinnah war ein säkularisierter Muslim, außerdem war er seiner Herkunft nach Shiit, deshalb war der Kalif für ihn ohnehin bedeutungslos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aab41c9e-5f89-4c90-8dfc-9cf6a0b4cf28",
                        "source_entry_id": "30e8ff45-8df6-3af1-8110-a763c2182dcd",
                        "source_sense_id": "54cf47b7-8aa6-357b-aeed-bebda18da8a2",
