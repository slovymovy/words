                        "entry_id": "9c12c03f-f3c5-30bb-92fc-6e860549ce99",
                        "glosses": [
                            "разг. испокон веку, испокон веков, с давних пор; издавна, исстари"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64e1488-42a2-4581-aa95-840c588a987a",
                                "sense_id": "9c119850-b8f2-3ef5-a732-555e5c7499fe",
                                "text": "Спокон веку работа народная // Под унылую песню кипит."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7fe2e809-4a14-4fe9-acf3-e910b20fca0e",
