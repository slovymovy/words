                "senses": [
                    {
                        "sense_id": "01d53fdd-f7be-35a6-8069-9c12a5ab60e3",
                        "entry_id": "fa698bb3-77ec-3c7f-a063-dc6e901f6d43",
                        "glosses": [
                            "Zustand, dass gemessen am Bedarf zu wenig Kohlen zur Verfügung stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5ebe91-459a-4fab-858b-15c704fc874d",
                                "sense_id": "01d53fdd-f7be-35a6-8069-9c12a5ab60e3",
                                "text": "„Die Berliner und die meisten Deutschen hatten um den Jahreswechsel 1916/17, mitten in einer zunehmend schlimmeren Hungersnot und massiven Kohlenkrise, das Interesse an dem eher symbolischen Zugeständnis des Monarchen und seiner Regierung verloren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6d289015-9473-3b07-9b55-a8807a7014a1",
                        "entry_id": "fa698bb3-77ec-3c7f-a063-dc6e901f6d43",
                        "glosses": [
                            "Zustand, dass die geförderte Kohle nicht mehr abgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d33d7fd-49c5-45c7-b957-1aeb76929b7a",
                                "sense_id": "6d289015-9473-3b07-9b55-a8807a7014a1",
                                "text": "„Ab dem 6. Februar 1967 muß selbst die förderungsgünstige Schachtanlage Friedrich Thyssen 2/5 in der \"Kohlenkrise\" Feierschichten einlegen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
