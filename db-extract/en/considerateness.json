        "de-extract.jsonl": [
            {
                "entry_id": "8ea798dd-f117-3245-a876-7a5a104cebc7",
                "word": "considerateness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7489183-dbf0-39ba-9d44-c725241eb284",
                        "entry_id": "8ea798dd-f117-3245-a876-7a5a104cebc7",
                        "glosses": [
                            "Rücksichtnahme"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd656b38-45e3-418f-b2d6-ea5b094fca03",
                        "source_entry_id": "8ea798dd-f117-3245-a876-7a5a104cebc7",
                        "source_sense_id": "a7489183-dbf0-39ba-9d44-c725241eb284",
                        "source_sense_description": "Rücksichtnahme",
                        "target_lang_word": "Rücksichtnahme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rücksichtnahme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "190fc9c7-4e48-3602-9f3d-8f527cf11efb",
                                        "entry_id": "c2d3a705-5bfe-331b-9628-2d32b4887ae4",
                                        "glosses": [
                                            "Beachtung der Interessen, Gefühle und Bedürfnisse Dritter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931179f9-8c07-4899-8dda-7194b9367c9b",
                                                "sense_id": "190fc9c7-4e48-3602-9f3d-8f527cf11efb",
                                                "text": "„Wer unsere Universitätsstädte für Kampfstätten der Zweiradfahrer hält, kann nicht in Amsterdam gewesen sein, wo Rücksichtnahme durch Geschicklichkeit ersetzt wird und Helme als Freiheitsberaubung angesehen werden.“"
                                            },
                                            {
                                                "example_id": "89e96e85-c69b-47e4-ad3e-4218d1925790",
                                                "sense_id": "190fc9c7-4e48-3602-9f3d-8f527cf11efb",
                                                "text": "„Da hat die Rücksichtnahme der Regierung auf die Autoindustrie dafür gesorgt, dass die Treibhausgasemissionen gestiegen sind - und zwar von 2010 bis 2013 um über drei Prozent.“"
                                            },
                                            {
                                                "example_id": "488261b0-cb06-454c-bf3a-63fafc42eae9",
                                                "sense_id": "190fc9c7-4e48-3602-9f3d-8f527cf11efb",
                                                "text": "„Politische Unsicherheiten oder Rücksichtnahmen mögen auch ein Grund dafür gewesen sein, dass dieses Ortsverzeichnis erst im fünften Jahr nach Kriegsende und nur für einen eingeschränkten Benutzerkreis erscheinen konnte.“"
                                            },
                                            {
                                                "example_id": "29b15663-2b9a-400b-aefa-2909d05bcc70",
                                                "sense_id": "190fc9c7-4e48-3602-9f3d-8f527cf11efb",
                                                "text": "„Die ausgeprägte Rücksichtnahme, das war so Ben-typisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9479b0ba-d493-4f21-99da-05ec29904a20",
                        "source_entry_id": "8ea798dd-f117-3245-a876-7a5a104cebc7",
                        "source_sense_id": "a7489183-dbf0-39ba-9d44-c725241eb284",
                        "source_sense_description": "Rücksichtnahme",
                        "target_lang_word": "considération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "considération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Action de considérer, d’examiner d’une façon particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00dbbbd3-fd8e-482e-a8f0-565bfc8ebc6c",
                                                "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                                "text": "[…] ; ce ne sont pas des considérations sur l’harmonie de l’Univers (même en personnifiant l’Univers), qui pourront donner aux hommes ce courage que Renan comparait à celui que possède le soldat montant à l’assaut."
                                            },
                                            {
                                                "example_id": "6c0b5abd-db0f-41ce-9d9c-48afb1a252fb",
                                                "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                                "text": "Cette considération le plongea dans une sorte d’hébétude douloureuse."
                                            },
                                            {
                                                "example_id": "de7f1cd6-51ca-4933-a7d0-c10476965a8c",
                                                "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                                "text": "Cela mérite considération, demande une longue considération, beaucoup de considération."
                                            },
                                            {
                                                "example_id": "0381c6a6-1404-4f21-a8e9-55ab00896a24",
                                                "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                                "text": "Cela est de peu de considération, cela est de peu d’importance, n’est guère à considérer."
                                            },
                                            {
                                                "example_id": "55c9791f-9a72-4f86-b3fa-5e500ed6b5d2",
                                                "sense_id": "2d90190d-bd59-37f6-bf7f-f7c7718d5390",
                                                "text": "Cette circonstance doit être de peu de considération pour vous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "225a194e-d7cf-330b-aebd-5bddd6f50466",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Réflexions, observations orales ou écrites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6f8b37-9138-4553-aead-6f7c529885a1",
                                                "sense_id": "225a194e-d7cf-330b-aebd-5bddd6f50466",
                                                "text": "[…], mais l'examen ne se prolonge pas « tant qu'et plus », le maillot trop large et le cuissard qui tombe sur les genoux suscitent vite un commentaire.\n— Vous êtes fagoté comme l’as de pique. C'est la dernière mode à Paris ?\nLes considérations surprennent par leur franchise et plus encore par leur drôlerie, […]."
                                            },
                                            {
                                                "example_id": "61544f4a-cf99-48bd-ad7d-9f6913240ef8",
                                                "sense_id": "225a194e-d7cf-330b-aebd-5bddd6f50466",
                                                "text": "Présenter des considérations à une assemblée, à une commission. — Il est entré dans de longues considérations sur ce sujet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c993b568-2a2f-3b64-9da2-a5c742f54bf7",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Circonspection ; attention dans la conduite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1617560d-370d-4d12-909f-ce185e14720e",
                                                "sense_id": "c993b568-2a2f-3b64-9da2-a5c742f54bf7",
                                                "text": "C’est un homme qui agit sans considération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Résultat de l’action de considérer, les raisons, les motifs qui, après examen, vous portent à agir de telle ou telle manière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafb0739-c2d5-406d-b4e6-713a1de9a2f0",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "Il adapta ses ambitions à des considérations plus terre à terre comme trouver un petit boulot pour se nourrir."
                                            },
                                            {
                                                "example_id": "e60e3d1b-0f92-4be2-bb7b-d3c58c47b2db",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "Diverses considérations l’ont porté à cette démarche."
                                            },
                                            {
                                                "example_id": "b8f07374-4896-4c05-93de-f7eea075906a",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "Pesez bien toutes ces considérations."
                                            },
                                            {
                                                "example_id": "c2599bb6-6fce-497d-bd52-d345a468af3a",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "Aucune considération ne saurait le retenir."
                                            },
                                            {
                                                "example_id": "8b4eb3cb-6c4c-4cf0-9c89-976d089b3fcc",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "Mettre, faire entrer, prendre quelque chose en considération, en tenir compte."
                                            },
                                            {
                                                "example_id": "decdfe43-749a-40ca-b8ba-efdf55f0cb5a",
                                                "sense_id": "9e914832-8c59-31b0-be0e-c4e1d1e269b7",
                                                "text": "On prendra vos services en considération, on fera entrer vos services en considération."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3d1e99-2d1f-34a5-8bfd-0db6ce423a23",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Estime qu’on a pour quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f6b5cf3-6376-451b-8d79-6e563de3ea6f",
                                                "sense_id": "7d3d1e99-2d1f-34a5-8bfd-0db6ce423a23",
                                                "text": "Permettez-moi de vous écrire en allemand. Je ferais encore plus de solécismes, si je vous écrivais en jmoude, et vous perdriez toute considération pour moi."
                                            },
                                            {
                                                "example_id": "3cba347a-add4-4afc-b323-dcd56c0d7bba",
                                                "sense_id": "7d3d1e99-2d1f-34a5-8bfd-0db6ce423a23",
                                                "text": "Si l’Allemagne n’a point conquis encore la place qui devrait lui revenir dans le monde économique […], cela tient à ce que, pendant longtemps, ses fabricants crurent qu'il était habile d’inonder le marché avec de la camelote ; bien que la production allemande se soit fort améliorée depuis quelques années, elle ne jouit point encore d’une très haute considération."
                                            },
                                            {
                                                "example_id": "5eded683-29ab-4fa9-97d8-f8ff613720db",
                                                "sense_id": "7d3d1e99-2d1f-34a5-8bfd-0db6ce423a23",
                                                "text": "Le cryobiologiste se caressa le menton. Il trouvait que son adjoint n'avait aucune considération pour les volontaires. Or, sans volontaires, il n'existerait pas d’expériences."
                                            },
                                            {
                                                "example_id": "067e6649-84fb-4be9-8b32-8bd6cb564ed8",
                                                "sense_id": "7d3d1e99-2d1f-34a5-8bfd-0db6ce423a23",
                                                "text": "Libéré des bracelets infamants, j'écoute peu le réquisitoire du ministère public, dont le Zorro commis d'office m'avait annoncé la sévérité. Le robin, qui n’a aucune considération pour l’assassin, m’achève au cours de son délire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                        "entry_id": "683ba970-5508-372d-9069-e3954034db4c",
                                        "glosses": [
                                            "Marques d’attention particulières qu’obtiennent les talents, les vertus, ou que les dignités et les charges attirent. Elles s'utilisent en particulier dans les formules de politesse par lesquelles on termine les lettres qu’on écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30785e59-afde-461b-97b8-ff2aa8fe7a96",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "Cette personne ne jouit d’aucune considération."
                                            },
                                            {
                                                "example_id": "80579c47-76c2-4c6d-9bee-763576307ea4",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "On n’a nulle considération pour lui."
                                            },
                                            {
                                                "example_id": "acf324f7-7d4b-4e0a-8aa4-78d399d5185e",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "C’est une personne de grande considération, qui s’est acquis une grande considération."
                                            },
                                            {
                                                "example_id": "29f39a49-f54d-457f-94f1-e44643646aed",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "Iel est en haute considération."
                                            },
                                            {
                                                "example_id": "e85b9613-7db4-4fbf-8da8-cdb777fb4ca5",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "C’est une personne de peu de considération, de nulle considération, sans considération dans le monde."
                                            },
                                            {
                                                "example_id": "d2c77187-4ce8-4c60-945e-1b5895594e20",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "Je suis avec considération, avec une parfaite considération, avec une considération distinguée, avec une haute considération, etc."
                                            },
                                            {
                                                "example_id": "f88adaff-ddc7-4d79-93fe-3ebdcf0b985d",
                                                "sense_id": "096b1bb8-161d-3bca-bf9e-28763ebde30a",
                                                "text": "Veuillez agréer l’expression, recevez l’assurance de ma parfaite considération."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
