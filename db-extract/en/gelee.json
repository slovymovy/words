                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "edebf720-fe6b-4390-8602-64750195b897",
                                "sense_id": "ae0665aa-50d6-3ed0-a4f0-c426153d0b11",
                                "text": "While they were puzzling over it, another course arrived: three tiny monkey dishes, each holding two cubes of gelee, set atop glass bowls in which live Siamese fighting fish swam listlessly back and forth."
                            }
