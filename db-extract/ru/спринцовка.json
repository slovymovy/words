                "senses": [
                    {
                        "sense_id": "94a295ff-11dc-3ba3-95ec-944f7c312c67",
                        "entry_id": "13d57691-38df-3489-8fc0-ccf9af58b949",
                        "glosses": [
                            "спец. прибор для спринцевания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ca058d-50ec-4730-a41f-7b4107596e52",
                                "sense_id": "94a295ff-11dc-3ba3-95ec-944f7c312c67",
                                "text": "С той же целью здесь стоят сосуды с купоросом и большие спринцовки для разбрызгивания его во все стороны."
                            },
                            {
                                "example_id": "d9599975-0b84-496b-9ad1-5ca7f0131d01",
                                "sense_id": "94a295ff-11dc-3ba3-95ec-944f7c312c67",
                                "text": "Каждые два часа происходило кормление при помощи стеклянной спринцовки."
                            },
                            {
                                "example_id": "55a9a9c4-a274-4e99-b11d-6fbb45c7bcbf",
                                "sense_id": "94a295ff-11dc-3ba3-95ec-944f7c312c67",
                                "text": "Промыть нос можно с помощью шприца без иглы или небольшой спринцовки."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cfe867e-b42c-3c65-bb37-c0300ce703cd",
                        "entry_id": "13d57691-38df-3489-8fc0-ccf9af58b949",
                        "glosses": [
                            "действие по значению гл. спринцевать"
                        ],
                        "tags": [],
                        "examples": []
                    }
