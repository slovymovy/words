                ],
                "senses": [
                    {
                        "sense_id": "cd8e63a1-595a-3a7f-8745-2075d8195301",
                        "entry_id": "afb12bfd-19d1-3780-a723-e9722dc48280",
                        "glosses": [
                            "mit abschätzbaren Folgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9003e9d-0c08-4529-9dc7-b853c751c87c",
                                "sense_id": "cd8e63a1-595a-3a7f-8745-2075d8195301",
                                "text": "„Um das versicherte Risiko ‚Dürre‘ beschreibbar und kalkulierbar zu machen, ist es sachgerecht, auf einen regional einheitlichen, auf Durchschnittswerten basierenden Beobachtungszeitraum abzustellen.“"
                            },
                            {
                                "example_id": "4cf10a65-3543-41d9-932b-1bc99eec9e69",
                                "sense_id": "cd8e63a1-595a-3a7f-8745-2075d8195301",
                                "text": "„Währungsreformen sind immer mit Verunsicherung und logistischen Herausforderungen verbunden, ihre Folgen sind niemals vollständig kalkulierbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": [
