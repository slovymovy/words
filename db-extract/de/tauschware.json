                "senses": [
                    {
                        "sense_id": "f8a532b5-6a4d-302e-b995-89dc90011053",
                        "entry_id": "36db4ca8-c5d1-3f66-b5ff-7b47fdaa90b3",
                        "glosses": [
                            "Ware, die dafür bestimmt ist, gegen benötigte Dinge eingetauscht zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "250695c0-bc39-4bea-bf98-03609abacd54",
                                "sense_id": "f8a532b5-6a4d-302e-b995-89dc90011053",
                                "text": "„Medikamente, Bücher und Geschenke müssen verstaut, Tauschwaren und Proviant gekauft, verlässliche Helfer angeworben werden.“"
                            },
                            {
                                "example_id": "b14ce130-f44d-419a-84e2-368dc7b866d8",
                                "sense_id": "f8a532b5-6a4d-302e-b995-89dc90011053",
                                "text": "„Er war nun vierzehn Jahre und immer noch nicht länger als die Büchse, mit der er fast täglich in den Wäldern streifte, eigenen Herd und Nachbarn mit Wildbret zu versorgen, Häute zu mancherlei Bedarf und Felle für Taler und Tauschware des fahrenden Händlers zu sammeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85633e09-9d49-4496-b93f-6e47e633d4fb",
                        "source_entry_id": "36db4ca8-c5d1-3f66-b5ff-7b47fdaa90b3",
                        "source_sense_id": "f8a532b5-6a4d-302e-b995-89dc90011053",
                        "source_sense_description": "Ware, die dafür bestimmt ist, gegen benötigte Dinge eingetauscht zu werden",
                        "target_lang_word": "barter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                        "entry_id": "d841f8cf-d017-3f7b-9e25-1f96a53368a7",
                                        "glosses": [
                                            "An exchange of goods or services without the use of money."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800fc13d-1d25-4ec4-b72f-a84c0862980e",
                                                "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                                "text": "We had no money so we had to live by barter."
                                            },
                                            {
                                                "example_id": "84a05336-88e8-4cf4-b36b-1fb235ed3a65",
                                                "sense_id": "50e47a9f-b860-34b0-b7ac-25d29d93e575",
                                                "text": "Speculations in trade are not confined to the counter or to the counting-house. Lady Anne's fair hair and white teeth were as much objects of barter as any of the shawls or ribbons displayed in Bond Street. They were to be had in exchange for a suit of diamonds and an opera-box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44adc3d1-074d-30c6-8bad-dc99a2710b81",
                                        "entry_id": "d841f8cf-d017-3f7b-9e25-1f96a53368a7",
                                        "glosses": [
                                            "The goods or services used in such an exchange."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba930dd8-97b1-43d5-a51b-0528aac79a38",
                                                "sense_id": "44adc3d1-074d-30c6-8bad-dc99a2710b81",
                                                "text": "The man used his watch as barter to pay for his tab."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                        "entry_id": "d0d4484f-caa3-31b9-8962-f3b964f60324",
                                        "glosses": [
                                            "To exchange goods or services without involving money."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b5b0d7-978f-43f2-af3b-8b0f620bcf9c",
                                                "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                                "text": "She bartered a bonsai for one of the rare books in my library."
                                            },
                                            {
                                                "example_id": "21a4e1d6-d49c-473f-8d88-607dbf1b30ff",
                                                "sense_id": "69d9be6c-7579-32d9-896e-3f37de5d018c",
                                                "text": "You may be able to barter for some of the items you need at the local market."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
