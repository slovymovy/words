                    "frequency": "High",
                    "semantic_group_id": "presence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ton nom <w>figure</w> bien sur la liste officielle des participants inscrits à la conférence."
                        },
                        {
                            "text": "Ce plat traditionnel continue de <w>figurer</w> au menu de nombreux restaurants gastronomiques de la région."
                        }
                    ],
                    "synonyms": [
                        "apparaître",
                        "se trouver"
                    ],
                    "common_phrases": [
