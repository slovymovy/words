        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0326d88-156b-3baa-aed4-870f7c5c019c",
                    "sense_definition": "A narrow bed, often one of a pair or series arranged one above the other.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sleeping_furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were excited to sleep in a <w>bunk</w> bed during their vacation.",
                            "target_lang_translations": {
                                "ru": "Дети были в восторге от того, что во время отпуска будут спать на <w>двухъярусной</w> кровати.",
                                "zh": "孩子们很兴奋能在假期里睡<w>双层床</w>。"
                            }
                        },
                        {
                            "text": "He climbed up to the top <w>bunk</w> and quickly fell asleep.",
                            "target_lang_translations": {
                                "ru": "Он забрался на верхнюю <w>полку</w> и быстро уснул.",
                                "zh": "他爬上上<w>铺位</w>，很快就睡着了。"
                            }
