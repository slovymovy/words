                                ]
                            },
                            {
                                "target_word": "cage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                        "entry_id": "f612ab10-25a1-35ac-b8cc-2da48448768f",
                                        "glosses": [
                                            "To confine in a cage; to put into and keep in a cage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "779a1e86-adbe-4158-beb7-4707d65a460c",
                                                "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                                "text": "And the row of human captors, ever leering, They who caged me, Know their power and gloat on my captivity."
                                            },
                                            {
                                                "example_id": "7f2ab429-c60b-4338-a16b-5151a4ad8598",
                                                "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                                "text": "Laying out the zoo on horseback, he went about making plans to combine his scrubby mesas and canyons with moats, and thereby eliminate caging many large animals—a revolutionary advance in American zoo design."
                                            },
                                            {
                                                "example_id": "8968751a-4ccb-4715-84b2-b55e3ff521e1",
                                                "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                                "text": "The industrial practice of caging commercial laying hens has given caged housing a bad narne."
                                            },
                                            {
                                                "example_id": "3f394961-1e6e-4305-9a7d-a8e186a92528",
                                                "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            },
                                            {
                                                "example_id": "67a4678b-1e7e-4b76-bbd1-81e0679cbb4f",
                                                "sense_id": "f4ca57ef-a957-35ed-b6d9-b16ece5d782d",
                                                "text": "By caging chickens, farmers broke the cycle and had to busy themselves with feeding, cleaning and pest control activities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84612bc-4f7a-3c84-853c-af7cda53ff99",
                                        "entry_id": "f612ab10-25a1-35ac-b8cc-2da48448768f",
                                        "glosses": [
                                            "To imprison."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a54100ad-6466-4831-8d42-38f80afeab56",
                                                "sense_id": "f84612bc-4f7a-3c84-853c-af7cda53ff99",
                                                "text": "The serial killer was caged for life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e81d817-e561-342e-a011-8dd6a8355029",
                                        "entry_id": "f612ab10-25a1-35ac-b8cc-2da48448768f",
                                        "glosses": [
                                            "To restrict someone's movement or creativity."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f560df2-4c7b-3ae7-9b47-8fc014c3420f",
                                        "entry_id": "f612ab10-25a1-35ac-b8cc-2da48448768f",
                                        "glosses": [
                                            "To immobilize an artificial horizon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7028b4-c3c7-4780-a38e-3593e9220da7",
                                                "sense_id": "8f560df2-4c7b-3ae7-9b47-8fc014c3420f",
                                                "text": "To prevent damage to its gimbal mountings during extreme aerobatic maneuvers, the navball should be caged before the start of a display sequence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc15683-2691-3bbc-a904-cb2837eb6dac",
                                        "entry_id": "f612ab10-25a1-35ac-b8cc-2da48448768f",
                                        "glosses": [
                                            "To track individual responses to direct mail, either (advertising) to maintain and develop mailing lists or (politics) to identify people who are not eligible to vote because they do not reside at the registered addresses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
