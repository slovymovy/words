                "senses": [
                    {
                        "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                        "entry_id": "4795f061-031c-316e-b1e9-e8a8a5d685a4",
                        "glosses": [
                            "wenn etwas geschieht, für das eine übernatürliche Erklärung zumindest behauptet werden kann, im Sinne von „unsichtbare Kraft“ oder „höhere Macht“"
                        ],
                        "tags": [
                            "zumeist mit ironischem Unterton"
                        ],
                        "examples": [
                            {
                                "example_id": "b69bcca0-41e0-497b-b17e-c6dceb64aca8",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "Ihr war, als habe eine Geisterhand die Gardine bewegt."
                            },
                            {
                                "example_id": "19585268-dba3-47a7-8df1-38392311d8e6",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "Plötzlich schloss sich das Scheunentor wie von Geisterhand."
                            },
                            {
                                "example_id": "670f4e2c-bcf2-4030-9208-3599067e5010",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "„Die Jahre schwanden und ich zog | Als Zitherspieler durch das Land, | Als ich in einer stillen Nacht | Die alte Fabel wieder fand | Vom Sämann, der den Samen warf; | Da ward mir ein Erinnern licht, | Ich spürte jenen Körnerwurf | Wie Geisterhand im Angesicht.“"
                            },
                            {
                                "example_id": "80713432-ea3c-4537-948f-a8b5f4fb9cf6",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "Der Begriff „wie von Geisterhand“ spielt mit dem Gruseleffekt, den das Unerfindliche, Unerklärbare, Unheimliche insbesondere - aber nicht nur - auf Kinder hat."
                            },
                            {
                                "example_id": "62712b2d-bc6f-4f84-98e0-cee979c5a602",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "„Meine Mutter fixierte eine Tür, die sich vor Ewigkeiten wie durch Geisterhand geöffnet und einen Mann mit dichtem Schnurrbart hineingelassen hatte.“"
                            },
                            {
                                "example_id": "05cc4842-cf19-4908-8c47-45217fac140d",
                                "sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                                "text": "„Der Rollstuhl glitt über das Linoleum wie von Geisterhand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6b8e2d2-9489-43cf-8bcb-4c1dcfb9ac94",
                        "source_entry_id": "4795f061-031c-316e-b1e9-e8a8a5d685a4",
                        "source_sense_id": "cfe3d20a-4912-3b69-862c-b00a52c13709",
                        "target_lang_word": "comme par magie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comme par magie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "164a3bb2-d99c-379b-b4f7-d3a998cd52ac",
                                        "entry_id": "57ad7053-b359-3859-af04-f52b72d1a377",
                                        "glosses": [
                                            "De manière tout à fait surprenante, inattendue et inexplicable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325a42ad-22ef-45ba-8acc-58a7cc6814bd",
                                                "sense_id": "164a3bb2-d99c-379b-b4f7-d3a998cd52ac",
                                                "text": "Tout cela était sorti successivement de la mer, et comme par magie, à mesure que nous approchions du rivage ; et cependant nous n’avions pas échangé une parole, tant notre esprit était plein de pensées et notre cœur de joie."
                                            },
                                            {
                                                "example_id": "5fa6336a-6377-447c-b2e0-a98b56b4e041",
                                                "sense_id": "164a3bb2-d99c-379b-b4f7-d3a998cd52ac",
                                                "text": "Au début de la nouvelle année, tous les députés à Ottawa vont dire que ce n’est pas le temps pour des élections jusqu’au jour où, comme par magie, nous serons en campagne."
                                            },
                                            {
                                                "example_id": "a3b2ea24-78b8-479f-ba27-17bd2976619b",
                                                "sense_id": "164a3bb2-d99c-379b-b4f7-d3a998cd52ac",
                                                "text": "— Non, ni aujourd’hui, ni demain. Vous avez peut-être des yeux qui ne voient rien, mais eux ils ont un nez très très long, et ils savent rudement bien s’en servir. Avec ce vent il nous faudra les contourner bien loin d’ici, sinon ils nous sentiront à des lieues et disparaîtront comme par magie…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
