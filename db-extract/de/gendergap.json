                                "sense_id": "95243e49-8187-3814-9a89-4151ceac9dfd",
                                "text": "„Vor der Kontroverse um das Voting des Rolling Pin hat sich [Sophia] Rudolph keine großen Gedanken über den Gendergap in der Spitzengastronomie gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
