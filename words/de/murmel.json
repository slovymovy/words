{
    "word_family": [
        "Murmelbahn",
        "Murmelspiel",
        "murmeln"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "523cecfd-af7b-34eb-87a9-40c3eb8dac8a",
                    "sense_definition": "Kleine Kugel aus Glas, Ton oder Stein, die als Spielzeug verwendet wird",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "spielzeug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Kinder spielen auf der Straße mit einer bunten <w>Murmel</w>.",
                            "target_lang_translations": {
                                "en": "The children are playing on the street with a colorful <w>marble</w>."
                            }
                        },
                        {
                            "text": "Er lässt die kleine gläserne <w>Murmel</w> über den Holzboden rollen.",
                            "target_lang_translations": {
                                "en": "He lets the small glass <w>marble</w> roll across the wooden floor."
                            }
                        }
                    ],
                    "synonyms": [
                        "Klicker",
                        "Knicker",
                        "Kuller",
                        "Schusser",
                        "Spielkugel"
                    ],
                    "antonyms": [
                        "Ball"
                    ],
                    "common_phrases": [
                        "mit Murmeln spielen",
                        "eine gläserne Murmel"
                    ],
                    "target_lang_definitions": {
                        "en": "A small ball made of glass, clay, or stone, used as a toy in children's games"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "marble",
                                "target_lang_sense_clarification": "small glass or stone toy ball"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "571959fe-f42d-3f1c-b627-53a780775f32",
                    "sense_definition": "Ball oder ballähnlicher Gegenstand, insbesondere im Fußball",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "kugelform",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Stürmer schoss die <w>Murmel</w> direkt ins gegnerische Tor.",
                            "target_lang_translations": {
                                "en": "The striker kicked the <w>ball</w> straight into the opponent's goal."
                            }
                        },
                        {
                            "text": "Er hat die <w>Murmel</w> noch rechtzeitig vor der Linie erwischt.",
                            "target_lang_translations": {
                                "en": "He reached the <w>ball</w> just in time before the line."
                            }
                        }
                    ],
                    "synonyms": [
                        "Kirsche",
                        "Pille"
                    ],
                    "common_phrases": [
                        "die Murmel ins Tor schießen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A ball or spherical object, especially used colloquially in football (soccer)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ball",
                                "target_lang_sense_clarification": "colloquial term for a football or soccer ball"
                            },
                            {
                                "target_lang_word": "rock",
                                "target_lang_sense_clarification": "slang for a sports ball"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3b6822b-5e29-3283-bc2b-4924ab222de6",
                    "sense_definition": "Menschlicher Kopf",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Setz eine Mütze auf, damit deine <w>Murmel</w> in der Kälte nicht friert.",
                            "target_lang_translations": {
                                "en": "Put a hat on so your <w>noggin</w> doesn't get cold."
                            }
                        },
                        {
                            "text": "Nach dem langen Arbeitstag rauchte ihm die <w>Murmel</w> gewaltig.",
                            "target_lang_translations": {
                                "en": "After the long workday, his <w>head</w> was absolutely spinning."
                            }
                        }
                    ],
                    "synonyms": [
                        "Birne",
                        "Dez",
                        "Nuss",
                        "Rübe"
                    ],
                    "common_phrases": [
                        "die Murmel anstrengen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Human head, used informally or colloquially"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "noggin",
                                "target_lang_sense_clarification": "colloquial for human head"
                            },
                            {
                                "target_lang_word": "noodle",
                                "target_lang_sense_clarification": "informal term for the head or brain"
                            },
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "the human head"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7555c5d9-8505-3f07-abf7-c5bffde9ec4c",
                    "sense_definition": "Hoden des Mannes",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "koerper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er bekam beim Sport versehentlich einen Tritt gegen seine empfindlichen <w>Murmeln</w>.",
                            "target_lang_translations": {
                                "en": "He accidentally got kicked in his sensitive <w>balls</w> during sports."
                            }
                        },
                        {
                            "text": "Nach dem harten Zusammenstoß hielt er sich vor Schmerzen schützend die <w>Murmeln</w>.",
                            "target_lang_translations": {
                                "en": "After the hard collision, he held his <w>nuts</w> protectively in pain."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ei",
                        "Klöte"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "salopp, derb"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Male testicles (vulgar/slang)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "balls",
                                "target_lang_sense_clarification": "vulgar slang for testicles"
                            },
                            {
                                "target_lang_word": "nuts",
                                "target_lang_sense_clarification": "slang for testicles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a33c4b1f-4c4f-3b44-b998-20cb1e74f50c",
                    "sense_definition": "Kurzform für das <w>Murmeltier</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der sonnigen Almwiese saß ein wachsames <w>Murmel</w> vor seinem Bau.",
                            "target_lang_translations": {
                                "en": "On the sunny alpine meadow, an alert <w>marmot</w> was sitting in front of its burrow."
                            }
                        },
                        {
                            "text": "Plötzlich pfiff das kleine <w>Murmel</w> laut und verschwand unter der Erde.",
                            "target_lang_translations": {
                                "en": "Suddenly, the little <w>marmot</w> whistled loudly and vanished underground."
                            }
                        }
                    ],
                    "synonyms": [
                        "Murmeltier"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "besonders alpenländisch"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form for marmot, an alpine rodent"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "marmot",
                                "target_lang_sense_clarification": "burrowing rodent of the squirrel family"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "72191209-7550-3e14-ab65-f94b04b571e6",
                    "sense_definition": "Undeutliches, leises Sprechen oder Geräusch",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sprache",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Aus dem Nebenraum drang nur ein unverständliches <w>Murmel</w> an ihr Ohr.",
                            "target_lang_translations": {
                                "en": "From the adjoining room, only an indistinct <w>murmur</w> reached her ear."
                            }
                        },
                        {
                            "text": "Sein leises <w>Murmel</w> war im lauten Saal kaum zu verstehen.",
                            "target_lang_translations": {
                                "en": "His quiet <w>muttering</w> could barely be understood in the loud hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "Gemurmel",
                        "Murmeln"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "selten, veraltend"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Indistinct, low speaking or faint sound; a murmur"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "murmur",
                                "target_lang_sense_clarification": "indistinct low speech or continuous quiet sound"
                            },
                            {
                                "target_lang_word": "muttering",
                                "target_lang_sense_clarification": "low, indistinct utterance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}