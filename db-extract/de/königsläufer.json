                "senses": [
                    {
                        "sense_id": "33c4eba4-9f1f-378f-b406-5041d3f9a7af",
                        "entry_id": "483a0ed8-4e16-35ae-845e-798b1238f7d1",
                        "glosses": [
                            "der Läufer, der in der Grundstellung auf der Brettseite des Königs steht"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "3cd67c8e-88f0-46c0-8765-cffccac82472",
                                "sense_id": "33c4eba4-9f1f-378f-b406-5041d3f9a7af",
                                "text": "In der Ausgangsstellung des Schachspiels steht der weiße Königsläufer auf dem Feld f1, der schwarze Königsläufer auf dem Feld f8."
                            },
                            {
                                "example_id": "2af195fe-bc1b-4c4e-a53b-4939ef06cbc9",
                                "sense_id": "33c4eba4-9f1f-378f-b406-5041d3f9a7af",
                                "text": "„Es war keineswegs unbedenklich, die Dame in die Diagonale des schwarzen Königsläufers zu stellen“"
                            },
                            {
                                "example_id": "fdb791d9-b49d-4f4f-bfc2-f15afa518d58",
                                "sense_id": "33c4eba4-9f1f-378f-b406-5041d3f9a7af",
                                "text": "„Dieser Zug ist ungewöhnlich und würde von vielen Schachlehrern getadelt werden, weil er dem eigenen Königsläufer den Weg versperrt. Aber er wirft Genius aus seiner gespeicherten Eröffnungsbibliothek und zwingt ihn zu selbständigem Rechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
