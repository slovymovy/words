{
    "word_family": [],
    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "14ea34af-bc94-35ab-905c-b562896ecf53",
                    "sense_definition": "Relie des mots, des groupes de mots ou des propositions pour exprimer l'addition, la coordination ou l'association.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "coordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pierre <w>et</w> Paul vont au marché ce matin pour acheter des fruits frais."
                        },
                        {
                            "text": "Elle a commandé un café chaud <w>et</w> un croissant au beurre."
                        }
                    ],
                    "synonyms": [
                        "ainsi que"
                    ],
                    "common_phrases": [
                        "jour et nuit",
                        "ici et maintenant"
                    ]
                },
                {
                    "sense_id": "f353d0f2-910d-3557-8844-b0e2700dc2ed",
                    "sense_definition": "Marque la succession temporelle ou la conséquence logique d'un événement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "succession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est entré dans la pièce <w>et</w> a fermé la porte derrière lui."
                        },
                        {
                            "text": "Elle a terminé ses devoirs <w>et</w> elle est partie retrouver ses amis."
                        }
                    ],
                    "synonyms": [
                        "puis"
                    ]
                },
                {
                    "sense_id": "26ec4cea-39de-3ff8-998b-eab34ff1cfcd",
                    "sense_definition": "Employé en tête de phrase pour marquer l'insistance, l'étonnement ou relancer le discours.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emphase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Et</w> que comptez-vous faire pour résoudre ce problème délicat ?"
                        },
                        {
                            "text": "<w>Et</w> pourtant, personne ne semblait surpris par cette décision inattendue."
                        }
                    ],
                    "common_phrases": [
                        "et pourtant"
                    ]
                },
                {
                    "sense_id": "9dce383b-a566-3f51-bdd6-922d551ef5d2",
                    "sense_definition": "Exprime une opposition ou une nuance de restriction, équivalant à mais ou pourtant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vent soufflait fort <w>et</w> le vieux roseau ne rompait point."
                        },
                        {
                            "text": "Il a consacré toute son énergie à ce projet <w>et</w> il a échoué."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4e46393-29fb-3fef-914a-5aaaa78efe5c",
                    "sense_definition": "Opérateur logique qui n'est vrai que si toutes ses composantes sont vraies.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "logique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La table de vérité d'un <w>ET</w> logique s'apprend rapidement en cours d'informatique."
                        },
                        {
                            "text": "Dans ce circuit, la porte <w>ET</w> transmet le signal sous une seule condition."
                        }
                    ],
                    "synonyms": [
                        "AND"
                    ],
                    "common_phrases": [
                        "porte et"
                    ]
                }
            ]
        }
    ]
}