                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "583e42b4-3d1c-3d87-baab-3307dbdec1c4",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Ôter la glace, fondre la glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159c0d34-18b4-4e39-91f7-af1ac52c66f3",
                                                "sense_id": "583e42b4-3d1c-3d87-baab-3307dbdec1c4",
                                                "text": "Lorsque vous déglacez les vitres de la voiture, prenez garde à vos épaules et à votre dos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fed3bcd-ff85-3525-9f28-46385db73b0f",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Mouiller avec un liquide (vin, bouillon…) un récipient ayant servi à une cuisson, pour dissoudre les substances et les sucs restant attachés au fond, afin de constituer un jus qui sera souvent filtré dans un chinois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98c5d6dd-24a4-4020-b45f-6c5afb9a2842",
                                                "sense_id": "7fed3bcd-ff85-3525-9f28-46385db73b0f",
                                                "text": "Au bout de 5 min, déglacez au vinaigre de cidre, puis mouillez votre bouillon en ajoutant un L d’eau (idéalement 1 L de bouillon végétal, réalisé au préalable avec les épluchures des légumes pour avoir un goût plus profond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bd7117-3b08-37ba-b0f1-9819440db836",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Filtrer une marinade pour en ôter les morceaux de fruits, légumes, condiments, herbes et épices, afin d’en garder seulement le jus servant à la préparation d’une sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5bd9dc5-199b-47b5-b5df-d834177ea93f",
                                                "sense_id": "51bd7117-3b08-37ba-b0f1-9819440db836",
                                                "text": "Pour préparer le lièvre au porto, il vaut mieux déglacer la marinade préparée la veille et l’utiliser pour cuire les morceaux et conserver les parfums."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41de4591-42d2-3217-bf94-d3bdd7c91584",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Briser la glace afin de permettre le passage d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bf0f1d8-c966-33e6-8052-8f88768d3f59",
                                        "entry_id": "f47356db-326e-39f9-a380-1a0b4a5e670d",
                                        "glosses": [
                                            "Honer un cylindre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d895c543-7a33-4dc3-b55d-269711fdc7ed",
                        "source_entry_id": "8d9028e8-81a3-36ef-a32b-2ba10f217019",
                        "source_sense_id": "23fa57be-5851-3ee0-9a3e-e9cd9c4e20ca",
                        "source_sense_description": "to detach small pieces of cooked food from a pan",
                        "target_lang_word": "ablöschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablöschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e90d27c0-8265-3fa2-9bef-75d8122a2d28",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "ein Feuer löschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7f4704-7c49-405d-a494-2fd2405cec71",
                                                "sense_id": "e90d27c0-8265-3fa2-9bef-75d8122a2d28",
                                                "text": "„Als er dieser Stadt, die aus Wassermangel die Feuersbrünste mit Wein ablöschte, endlich neue Quellen anwies: so wurden die Glocken geläutet, Kinder badeten, Blinde tauchten in das neue Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee175b23-f75d-3d4f-aab9-c63a8f0ac736",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "Bratensatz durch Zugabe von Flüssigkeit (zum Beispiel Wein) lösen"
                                        ],
                                        "tags": [
                                            "Kochkunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4648fb1-321f-4ead-89ff-aeb826ecfd6f",
                                                "sense_id": "ee175b23-f75d-3d4f-aab9-c63a8f0ac736",
                                                "text": "„Während das Fleisch im Ofen ist, den restlichen Speck anbraten, den Rosenkohl zugeben, würzen und mit dem restlichen Wildfond ablöschen und fünf Minuten ziehen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34d732a8-46d9-3a85-83c7-63016df96f4c",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "Tinte, noch feuchte Schrift mit einem Löschblatt trocknen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6db11961-b00b-433c-b67f-a1d25342b0dc",
                                                "sense_id": "34d732a8-46d9-3a85-83c7-63016df96f4c",
                                                "text": "Neben dem alten Füllfederhalter lag immer ein Blatt Löschpapier auf seinem Schreibtisch bereit, mit dem er seine schwungvolle Unterschrift ablöschen konnte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3e340b64-5155-3504-b8d2-86281d2d2df3",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "Kreideschrift an einer Tafel entfernen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f545a0e6-6500-43e0-bd8d-bf83f1758642",
                                                "sense_id": "3e340b64-5155-3504-b8d2-86281d2d2df3",
                                                "text": "In jeder Woche war ein anderer von uns Schülern an Reihe, nach einer Unterrichtsstunde die Tafel abzulöschen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "8f2402bc-4a71-3ec5-b9d0-bc7a195a2d02",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "heißes Metall schnell abkühlen (zur Härtung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa9e5961-7462-4611-82a1-a18a7b8285d6",
                                                "sense_id": "8f2402bc-4a71-3ec5-b9d0-bc7a195a2d02",
                                                "text": "„Nur wenn sich das Metall an die glattgeraspelte Fläche des Pferdefußes anschmiegt, wird es im Wasser abgelöscht und anschließend mit Nägeln fixiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f32a64dd-ba16-3897-a4ad-fb5ce6581b2d",
                                        "entry_id": "bece217d-0029-323a-b639-e1655fd9e805",
                                        "glosses": [
                                            "Branntkalk durch Zugabe von Wasser zu Löschkalk reagieren lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32463126-b041-43a9-95d3-6b26a4398cd4",
                                                "sense_id": "f32a64dd-ba16-3897-a4ad-fb5ce6581b2d",
                                                "text": "Stall entmisten und besenrein machen; am besten mit Dampfstrahler säubern. 1-2 Tage abtrocknen lassen, dann desinfizieren (Produkte auf Säurebasis über 12 °C gegen Viren, Bakterien und Pilze), gegen Kokzidien Bodenbereich und untere Seitenwände vorsichtig abflammen oder dünn mit Branntkalk bestreuen und mit feinem Wassernebel ablöschen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
