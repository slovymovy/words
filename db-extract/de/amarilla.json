                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ff733d7-ef80-4647-b6b2-c7bdd5ed55ba",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Frau Amarilla ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c47cace7-ab94-4dc3-9a66-3f00ebc1734e",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Herr Amarilla wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c82e496c-8d88-4bfa-8ce3-f4b6df809141",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Die Amarillas fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7ee9cd28-ce60-44a4-934e-d38fe0f0939b",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Der Amarilla trägt nie die Schals, die die Amarilla ihm strickt."
                            },
                            {
                                "example_id": "eac48d2a-c466-4414-9b38-878eece8970b",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Amarilla kommt, geht der Herr Amarilla.“"
                            },
                            {
                                "example_id": "0c5f72dd-0646-42b0-a072-40635d8aee96",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Amarilla kommt und geht."
                            },
                            {
                                "example_id": "49e06512-071b-4e36-a61c-7cd8424d440d",
                                "sense_id": "49310c51-827f-359c-8f2a-17552126233a",
                                "text": "Amarillas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
