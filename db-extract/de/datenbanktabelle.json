                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1121f2e-a843-3da3-83a8-115cb11f8db2",
                                        "entry_id": "04a96dc5-2f91-30e6-9259-ac42d22c500b",
                                        "glosses": [
