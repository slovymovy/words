                "senses": [
                    {
                        "sense_id": "c1927ece-23a2-3d3b-abc9-bf1fb47419c9",
                        "entry_id": "d1160b59-4056-3746-8f05-cf9bbb54ddb9",
                        "glosses": [
                            "größere Anzahl sich wild durcheinander fortbewegender Fliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad2ba5d7-64d7-4997-bfe1-b32f4d023620",
                                "sense_id": "c1927ece-23a2-3d3b-abc9-bf1fb47419c9",
                                "text": "„Es sind Fliegenschwärme, die ihm und anderen Bewohnern der Hochhäuser an der Odenwaldstraße zu schaffen machen.“"
                            },
                            {
                                "example_id": "ab122739-102f-4589-aa0f-788867782b9d",
                                "sense_id": "c1927ece-23a2-3d3b-abc9-bf1fb47419c9",
                                "text": "„Eine Meinung, die auch fünfzig Jahre später vom Reisebuchautor Eric Linklater geteilt wird, der von unglaublichen Fliegenschwärmen schreibt.“"
                            },
                            {
                                "example_id": "90bee236-9a47-4cf5-9f9b-27e501a65084",
                                "sense_id": "c1927ece-23a2-3d3b-abc9-bf1fb47419c9",
                                "text": "„Aufgerissene Mäuler, erschreckte Augen, zerissenes Gedärm, Fliegenschwärme hatten sich auf den Kadavern niedergelassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
