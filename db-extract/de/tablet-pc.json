                "senses": [
                    {
                        "sense_id": "e929faaa-4b3b-3745-a0ae-fe4f42264081",
                        "entry_id": "3380c6ad-9cf1-34fe-bfcb-65c7c033055f",
                        "glosses": [
                            "sehr flacher tragbarer Computer (PC), der durch Berühren des Bildschirmes, der einen Großteil des Gerätes ausmacht, bedient wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70fe4721-0e87-4b14-950e-51d6a63e6a8e",
                                "sense_id": "e929faaa-4b3b-3745-a0ae-fe4f42264081",
                                "text": "„Ein Tablet-PC ist ein flacher, tragbarer Personal Computer von der Größe einer Schreibtafel – so auch die Übersetzug von ‚tablet‘ aus dem Englischen.“"
                            },
                            {
                                "example_id": "7c4ca03b-8b3b-47da-a56c-c4ef34258ab9",
                                "sense_id": "e929faaa-4b3b-3745-a0ae-fe4f42264081",
                                "text": "„Während man auf dem gereichten Tablet-PC die Menükarte studiert, kann man die einzigartige Atmosphäre auf sich wirken lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
