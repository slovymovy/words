                "senses": [
                    {
                        "sense_id": "61fb3e43-b642-3023-b1ec-6e665bbef3d0",
                        "entry_id": "5b1335ed-863d-352c-b7c2-46f82a8014e0",
                        "glosses": [
                            "die Jahre 70 bis 79 des gegenwärtigen oder besagten Jahrhunderts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ebe3d7-ea12-4fc8-9f25-b2842e646642",
                                "sense_id": "61fb3e43-b642-3023-b1ec-6e665bbef3d0",
                                "text": "„Es ist also eine erfolgreiche Sammlung von Witzen, die typisch für die Siebzigerjahre sind.“"
                            },
                            {
                                "example_id": "4c3af3d5-2e62-4d6b-904f-74facef20fc1",
                                "sense_id": "61fb3e43-b642-3023-b1ec-6e665bbef3d0",
                                "text": "„Eli hatte ihm erzählt, dass der alte Mann in den Siebzigerjahren aus dem Mittleren Westen nach Comtosook gezogen war.“"
                            },
                            {
                                "example_id": "02fdc5c1-f325-467f-b6f3-de5d418522a7",
                                "sense_id": "61fb3e43-b642-3023-b1ec-6e665bbef3d0",
                                "text": "„Erste akkurate Darstellungen erschienen bereits in den Siebzigerjahren in der Fachliteratur.“"
                            },
                            {
                                "example_id": "1498e1e6-1017-4faa-a023-62fbad81a366",
                                "sense_id": "61fb3e43-b642-3023-b1ec-6e665bbef3d0",
                                "text": "„Maxine Groffsky war Mitte der Siebzigerjahre aus Paris zurückgekehrt, als sie und Roth sich zum Abendessen trafen – ihr erstes Treffen seit mehr als fünfzehn Jahren.“"
                            }
                        ],
