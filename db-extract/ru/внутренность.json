                                    }
                                ]
                            },
                            {
                                "target_word": "contents",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c32b1748-0cb5-3f90-810f-dc92983d9ee5",
                                        "entry_id": "b152faca-0051-3ff8-929e-2b4abe780916",
                                        "glosses": [
                                            "That which is contained."
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5799a837-4b0b-4568-a070-35375c60c9f4",
                                                "sense_id": "c32b1748-0cb5-3f90-810f-dc92983d9ee5",
                                                "text": "It is not covered in your homeowner's policy. You need contents insurance."
                                            },
                                            {
                                                "example_id": "a6cb223a-73dd-4a5d-b343-2cee0f155649",
                                                "sense_id": "c32b1748-0cb5-3f90-810f-dc92983d9ee5",
                                                "text": "The contents of the cup had a familiar aroma."
                                            },
                                            {
                                                "example_id": "0510cd69-239f-4360-87c3-2b782d939b2a",
                                                "sense_id": "c32b1748-0cb5-3f90-810f-dc92983d9ee5",
                                                "text": "Blast after blast, fiery outbreak after fiery outbreak, like a flaming barrage from within,[…]most of Edison's grounds soon became an inferno. As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef63cfc7-7eae-3a32-98ae-02cbf2ec6f57",
                                        "entry_id": "b152faca-0051-3ff8-929e-2b4abe780916",
                                        "glosses": [
                                            "A table of contents, a list of chapters, etc. in a book, and the page numbers on which they start."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ce168ce-b841-43ba-82d9-084f8bcd4b40",
                                                "sense_id": "ef63cfc7-7eae-3a32-98ae-02cbf2ec6f57",
                                                "text": "I always start a book by reading the dustjacket and the contents before I really dig in to the content itself."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contents",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a36fae-1eb4-33fd-923e-4176c959b576",
                                        "entry_id": "843b9783-5f5a-352a-8f5a-ce9f3626d45a",
