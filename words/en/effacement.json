{
    "word_family": [
        "efface",
        "effaceable",
        "ineffaceable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49c82ee3-b520-340a-b361-7dd68a411dea",
                    "sense_definition": "The act of keeping oneself in the background or behaving in a humble, inconspicuous manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His modest nature and constant <w>effacement</w> prevented him from receiving the recognition he deserved.",
                            "target_lang_translations": {
                                "ru": "Скромный характер и постоянное <w>стремление держаться в тени</w> помешали ему получить заслуженное признание."
                            }
                        },
                        {
                            "text": "She practiced deliberate self-<w>effacement</w> whenever compliments were directed toward her accomplishments.",
                            "target_lang_translations": {
                                "ru": "Она сознательно прибегала к <w>самоуничижению</w>, когда слышала комплименты в адрес своих достижений."
                            }
                        }
                    ],
                    "synonyms": [
                        "modesty",
                        "humility",
                        "unobtrusiveness"
                    ],
                    "antonyms": [
                        "arrogance",
                        "ostentation"
                    ],
                    "common_phrases": [
                        "self effacement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремление держаться в тени, скромное и незаметное поведение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скромность",
                                "target_lang_sense_clarification": "нежелание выделяться или привлекать внимание"
                            },
                            {
                                "target_lang_word": "самоуничижение",
                                "target_lang_sense_clarification": "чрезмерная скромность, принижение собственных заслуг"
                            },
                            {
                                "target_lang_word": "стушевывание",
                                "target_lang_sense_clarification": "уход на второй план, незаметность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a3453f7-036c-31db-92ab-25ad61b0db11",
                    "sense_definition": "The act or process of wiping out, erasing, or completely removing something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gradual <w>effacement</w> of ancient carvings was caused by centuries of wind and rain.",
                            "target_lang_translations": {
                                "ru": "Постепенное <w>стирание</w> древних барельефов было вызвано веками воздействия ветра и дождя."
                            }
                        },
                        {
                            "text": "Historians were alarmed by the systematic <w>effacement</w> of historical records under the new regime.",
                            "target_lang_translations": {
                                "ru": "Историки были встревожены систематическим <w>уничтожением</w> исторических документов при новом режиме."
                            }
                        }
                    ],
                    "synonyms": [
                        "erasure",
                        "obliteration",
                        "deletion",
                        "expungement"
                    ],
                    "antonyms": [
                        "preservation",
                        "creation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стирание, уничтожение или полное удаление чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стирание",
                                "target_lang_sense_clarification": "постепенное или физическое исчезновение следов, надписей и т. д."
                            },
                            {
                                "target_lang_word": "изглаживание",
                                "target_lang_sense_clarification": "устранение следов, памяти или впечатлений"
                            },
                            {
                                "target_lang_word": "уничтожение",
                                "target_lang_sense_clarification": "полная ликвидация записей, свидетельств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0011d374-428e-31f5-aa2a-560ea5d88e69",
                    "sense_definition": "The thinning and shortening of the cervix that occurs before or during early labor.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor checked for cervical <w>effacement</w> to assess how close the patient was to delivery.",
                            "target_lang_translations": {
                                "ru": "Врач проверил <w>сглаживание</w> шейки матки, чтобы оценить, насколько пациентка близка к родам."
                            }
                        },
                        {
                            "text": "Full <w>effacement</w> must occur before the baby can easily pass into the birth canal.",
                            "target_lang_translations": {
                                "ru": "Должно произойти полное <w>сглаживание</w>, прежде чем ребенок сможет легко пройти в родовые пути."
                            }
                        }
                    ],
                    "synonyms": [
                        "thinning"
                    ],
                    "common_phrases": [
                        "cervical effacement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сглаживание и укорочение шейки матки перед родами или в начале родовой деятельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сглаживание",
                                "target_lang_sense_clarification": "в акушерстве: укорочение и истончение шейки матки"
                            },
                            {
                                "target_lang_word": "укорочение",
                                "target_lang_sense_clarification": "уменьшение длины шейки матки перед родами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}