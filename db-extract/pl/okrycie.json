                            {
                                "example_id": "e5774968-28bf-49b8-b64f-2eab14d755a9",
                                "sense_id": "84bba2fc-e4b3-3463-bcc9-d1f5fa0b82a2",
                                "text": "Gdzie jest okrycie do samochodu?"
                            }
