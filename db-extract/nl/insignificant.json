                                "target_senses": [
                                    {
                                        "sense_id": "da07a01b-1494-347c-bf65-9a2751ab12fc",
                                        "entry_id": "43dd7670-427c-3cc3-b63e-0805af20692c",
                                        "glosses": [
                                            "De nula o escasa importancia o relevancia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8607fe2f-5422-4b69-90ed-a733307e84c2",
                                                "sense_id": "da07a01b-1494-347c-bf65-9a2751ab12fc",
                                                "text": "La pequeña, casi insignificante, sombra de María, la madre del Maestro, no tardó en difuminarse en la penumbra"
                                            }
                                        ],
