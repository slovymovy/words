                        "glosses": [
                            "Roche sédimentaire carbonatée composée d’au moins 50% de dolomite CaMg(CO₃)₂."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f31ad7f-451f-4ec4-81ea-60d90b974bf5",
                                "sense_id": "9ae2434b-2a21-3212-9395-e1bf1b3b0f1a",
                                "text": "Un calcul rapide montre qu’une roche doit contenir une partie de quartz pour deux de dolomie, pour se « dédolomitiser » entièrement par métamorphisme."
                            },
                            {
                                "example_id": "ff537cee-78e7-4e0f-88a1-1a3dbecd1c20",
                                "sense_id": "9ae2434b-2a21-3212-9395-e1bf1b3b0f1a",
                                "text": "Sydney Gilchrist Thomas (1850-1885) et Percy Carlyle Gilchrist (1851-1935) utilisèrent, avec de la chaux (oxyde de calcium) comme base, un revêtement de dolomie (carbonate double de calcium et de magnésium) (1878)."
                            }
                        ]
                    }
