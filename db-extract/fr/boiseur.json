                "senses": [
                    {
                        "sense_id": "b2baab9a-0005-3c65-89f9-414db75bebf7",
                        "entry_id": "f8d97094-1f0d-3bda-98d6-966df4f0a49d",
                        "glosses": [
                            "Ouvrier qui consolide les parois des excavations d'une mine au moyen de soutènements en bois, c’est-à-dire qui réalise le boisage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7d72fa-3998-40d4-94f4-a7556c6450ca",
                                "sense_id": "b2baab9a-0005-3c65-89f9-414db75bebf7",
                                "text": "Autrefois, au temps de sa jeunesse, il avait été boiseur, c’est-à-dire charpentier, chargé de poser et d’entretenir les bois qui forment les galeries ; mais dans un éboulement il avait eu trois doigts écrasés ce qui l’avait forcé de renoncer à son métier."
                            },
                            {
                                "example_id": "ebab438b-2405-46d9-a01c-cdee990580ca",
                                "sense_id": "b2baab9a-0005-3c65-89f9-414db75bebf7",
                                "text": "Parfois le boiseur exerce aussi le métier de cureur."
                            },
                            {
                                "example_id": "2fe2ce3c-8e1c-4e10-825f-30b54180bd93",
                                "sense_id": "b2baab9a-0005-3c65-89f9-414db75bebf7",
                                "text": "Il s’est fait embaucher comme boiseur dans une mine de cuivre située en amont de l’Agne, après avoir été sagard, voiturier, charbonnier et même, à un moment creux, marchand de neige dans les grandes villes."
                            }
                        ]
                    }
