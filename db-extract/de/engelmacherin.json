                "senses": [
                    {
                        "sense_id": "ea886b5d-df49-302d-9b83-45b443a14ec3",
                        "entry_id": "ffb4d2f9-e99c-33c3-aadd-2af4d850da0f",
                        "glosses": [
                            "eine Frau, die illegal Abtreibungen durchführt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "84323f9e-1ae9-4633-892b-34d7b048c63b",
                                "sense_id": "ea886b5d-df49-302d-9b83-45b443a14ec3",
                                "text": "„Wenige Jahrzehnte zuvor riskierte eine Frau, die illegal abtrieb, die Todesstrafe: Während des Vichy-Regimes war eine so genannte Engelmacherin unter der Guillotine hingerichtet worden.“"
                            },
                            {
                                "example_id": "ba693680-b23a-4560-9dc0-92a707285f0f",
                                "sense_id": "ea886b5d-df49-302d-9b83-45b443a14ec3",
                                "text": "„Die Engelmacherin Waldrut Mergenin half einer großen Anzahl Schwangeren im Rheinland bei der Lösung ihrer Probleme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2932735-d3c6-3af4-b067-8cdb614fc044",
                        "entry_id": "ffb4d2f9-e99c-33c3-aadd-2af4d850da0f",
                        "glosses": [
                            "eine Frau, die Kinder in Pflege hat und diese so unzureichend versorgt, dass sie bald sterben"
                        ],
                        "tags": [
                            "archaic",
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae5627a-b8f5-4f15-b775-5f7b9f2956ca",
                        "source_entry_id": "ffb4d2f9-e99c-33c3-aadd-2af4d850da0f",
                        "source_sense_id": "ea886b5d-df49-302d-9b83-45b443a14ec3",
                        "source_sense_description": "umgangssprachlich: eine Frau, die illegal Abtreibungen durchführt",
                        "target_lang_word": "faiseuse d’anges",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faiseuse d’anges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2dde8e6-2a96-3c15-86ce-99041f666919",
                                        "entry_id": "60be95f0-15fe-3f60-b32b-1bbd1d682723",
                                        "glosses": [
                                            "Celle qui avorte des femmes, surtout illicitement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd24f2e-3cc1-4faa-b338-2ab77937510a",
                                                "sense_id": "a2dde8e6-2a96-3c15-86ce-99041f666919",
                                                "text": "Un soir, je n’y ai plus tenu, et j’ai décidé de l’amener pendant qu’il en était temps encore chez une faiseuse d’anges de petite ville."
                                            },
                                            {
                                                "example_id": "18d2bef6-9f54-4acc-8274-7db34f0dae9e",
                                                "sense_id": "a2dde8e6-2a96-3c15-86ce-99041f666919",
                                                "text": "Je voulais faire passer l’enfant, j’ai pris rendez-vous avec une faiseuse d’anges..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25ff97fd-cf5d-4709-b0a7-cfeb9ae1bf53",
                        "source_entry_id": "ffb4d2f9-e99c-33c3-aadd-2af4d850da0f",
                        "source_sense_id": "ea886b5d-df49-302d-9b83-45b443a14ec3",
                        "source_sense_description": "umgangssprachlich: eine Frau, die illegal Abtreibungen durchführt",
                        "target_lang_word": "avorteuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avorteuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6145360-03b4-3932-9652-20d2512fc90e",
                                        "entry_id": "844d9815-6fd8-3451-9e50-1e039b8fda07",
                                        "glosses": [
                                            "Personne pratiquant un avortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8539d637-318c-429b-9932-4bd10bda655c",
                                                "sense_id": "a6145360-03b4-3932-9652-20d2512fc90e",
                                                "text": "À l’œuvre donc ! et vous allez voir ce que j’ai dans le ventre, quand la famine n’y rôde pas, comme une main d’avorteuse qui, de ses ongles noirs, cherche à crever les ovaires !"
                                            },
                                            {
                                                "example_id": "d2ab872b-3729-42df-8342-1d3e3be3b958",
                                                "sense_id": "a6145360-03b4-3932-9652-20d2512fc90e",
                                                "text": "Pour faire avouer la mère de Gaby qu’il soupçonne d’avoir accompagné sa fille chez l’avorteuse, il la jette en prison où elle restera deux mois et demi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
