                                                "sense_id": "dac366c2-873a-3eed-90ff-0628e87d5598",
                                                "text": "Le service d’ORL se trouve au troisième étage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ORL",
                                "target_lang_code": "fr",
