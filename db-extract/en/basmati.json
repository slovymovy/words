                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basmatirijst",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "44776afa-df8e-3817-adf9-fbb6336c1d72",
                                        "entry_id": "7fe44134-dc21-3ce8-b645-53f2bdc8ca1a",
                                        "glosses": [
                                            "rijst met een lange korrel die oorspronkelijk uit het grensgebied van India, Pakistan en Nepal komt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fbb15d3-634a-4068-a512-87476d55c488",
                                                "sense_id": "44776afa-df8e-3817-adf9-fbb6336c1d72",
                                                "text": "De kernmachten India en Pakistan hebben een heleboel twistpunten en daar komt er nu een over rijst bij. India heeft bij de Europese Unie basmatirijst als exclusief Indiaas product geclaimd. Dat is bij buurland en aartsvijand Pakistan in het verkeerde keelgat geschoten."
                                            },
                                            {
                                                "example_id": "01b6f29b-0fd0-471e-a99d-a63b59cba7b7",
                                                "sense_id": "44776afa-df8e-3817-adf9-fbb6336c1d72",
                                                "text": "Met een ouverture van olijven en chips van oerwortel, venkel, pastinaak en rode ui gaat dat nog niet lukken, maar als er ‘macaroni met ham en kaas’ als amuse wordt geserveerd, komt de stemming er snel in. Een leuk gerechtje met zeer herkenbare smaken op basis van pasta en bellotaham, dat voorafgaat aan een makreel in perfecte koude garing met basmatirijst op stroken watermeloen en komkommer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
