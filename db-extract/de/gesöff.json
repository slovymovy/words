                "senses": [
                    {
                        "sense_id": "8f73d695-71f8-3017-8bc4-64acbe200553",
                        "entry_id": "e2c1c764-40ba-3f06-8418-bc9f015b8343",
                        "glosses": [
                            "meist alkoholisches Getränk"
                        ],
                        "tags": [
                            "general"
                        ],
