        "fr-extract.jsonl": [
            {
                "entry_id": "813b6303-e06f-3502-b400-917f0797c1da",
                "word": "iridescence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e9d4bb14-d105-4d34-a473-0b2150d0721e",
                        "entry_id": "813b6303-e06f-3502-b400-917f0797c1da",
                        "tags": [
