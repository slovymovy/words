                                        "entry_id": "c9a8ebaa-63a4-3261-8f13-4b26c20e1a7a",
                                        "glosses": [
                                            "A large, defended Iron Age settlement associated with the Celtic La Tène culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0364cff3-7342-4229-a576-888ab4af27d7",
                                                "sense_id": "58fbccf0-c4ff-3880-a30b-10872e9a734a",
                                                "text": "‘Mount Ceasar’ was a major oppidum of the Bellovaci tribe and almost certainly the tribal capital: its geographical relationship to the nearby Roman capital of Beauvais is typical of a post-conquest tribal resettlement."
                                            }
                                        ]
                                    }
