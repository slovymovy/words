                    {
                        "translation_id": "ed40a3cf-0769-4a67-b0b5-89d9caa6b091",
                        "source_entry_id": "df136b38-a69e-3b6b-8029-7ab2ae275f4c",
                        "source_sense_id": "a57d99c1-b5b9-3510-9e16-7dd91a5e05bc",
