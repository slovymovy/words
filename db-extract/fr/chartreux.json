                                                "example_id": "945545db-10be-4599-8fb4-74ea4b7288fd",
                                                "sense_id": "5b2ad18f-2ae5-39af-a6a5-37755299bbb6",
                                                "text": "„Derart lobreiche Formulierungen erwecken den Eindruck, Balduin habe sich schon seit längerem für den Orden der Kartäuser entschieden.“"
                                            }
                                        ],
