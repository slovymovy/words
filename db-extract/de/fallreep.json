                        "sense_id": "603cbbd1-d02a-37bd-a71b-ff24cb46b55e",
                        "entry_id": "193045e9-be05-35f9-b05f-189ea468db2c",
                        "glosses": [
                            "ein außenbords angebrachtes Tau oder eine außenbords angebrachte Leiter beziehungsweise eine herablassbare Schiffstreppe für den Personenverkehr"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "35e71555-63e4-4371-a304-68f694134f81",
                                "sense_id": "603cbbd1-d02a-37bd-a71b-ff24cb46b55e",
                                "text": "Er verließ das Schiff über das Fallreep."
                            },
                            {
                                "example_id": "fd139585-27a6-4a23-83b7-23098d79da0a",
                                "sense_id": "603cbbd1-d02a-37bd-a71b-ff24cb46b55e",
                                "text": "„Hätte nicht Mutter über ein Fallreep den umgekehrten Weg nehmen können?“"
                            },
                            {
                                "example_id": "b5cf7b26-4b9b-4cba-95f6-766be69db0bc",
                                "sense_id": "603cbbd1-d02a-37bd-a71b-ff24cb46b55e",
                                "text": "„Luigis Freunde inszenierten auf der Mole, direkt vor dem Fallreep, eine Schlägerei zwischen drei hübschen Mädchen, von denen eines gellend um Hilfe rief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
