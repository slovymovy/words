                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2688bae-14fc-384f-b206-bb051fd1f054",
                                        "entry_id": "89ae6675-6d1d-3f88-aea5-1200148783c4",
                                        "glosses": [
                                            "An instance of a person or animal drowning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3e57d0-e0b0-4ab6-953a-4aeac847ffff",
                                                "sense_id": "b2688bae-14fc-384f-b206-bb051fd1f054",
                                                "text": "It's dangerous to swim in that river — there were three drownings there last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b641672a-ce6c-3e0b-bce1-ea11127083dc",
                                        "entry_id": "89ae6675-6d1d-3f88-aea5-1200148783c4",
                                        "glosses": [
                                            "An instance of a person or animal being drowned."
                                        ],
                                        "tags": [],
