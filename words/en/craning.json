    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b6fb537c-e884-3f6b-85ae-33765ab8837d",
                    "sense_definition": "present participle and gerund of <w>crane</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>craning</w> her neck to see over the tall crowd.",
                            "target_lang_translations": {
                                "cs": "Zoufale <w>natahovala</w> krk, aby viděla přes ten vysoký dav."
                            }
                        },
                        {
                            "text": "Everyone was <w>craning</w> to get a better view of the stage.",
                            "target_lang_translations": {
                                "cs": "Všichni se <w>natahovali</w>, aby lépe viděli na pódium."
                            }
                        }
                    ],
                    "common_phrases": [
                        "craning one's neck"
                    ],
                    "target_lang_definitions": {
                        "cs": "natahování krku za účelem lepšího výhledu"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "natahovat",
                                "target_lang_sense_clarification": "v kontextu natahování krku"
                            },
                            {
                                "target_lang_word": "vytahovat",
                                "target_lang_sense_clarification": "vytahovat krk pro lepší výhled"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c4cc391-a6c3-3c76-bdfa-a7fa4bc9fa78",
                    "sense_definition": "The act of stretching one's neck to see something better.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>craning</w> of his neck made him look quite uncomfortable.",
                            "target_lang_translations": {
                                "cs": "Kvůli neustálému <w>natahování</w> krku vypadal dost nepohodlně."
                            }
                        },
                        {
                            "text": "After much <w>craning</w>, she finally spotted her friend in the distance.",
                            "target_lang_translations": {
                                "cs": "Po dlouhém <w>natahování</w> konečně v dálce zahlédla svého přítele."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "akt natahování krku, aby člověk lépe viděl"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "natahování",
                                "target_lang_sense_clarification": "natahování krku"
                            },
                            {
                                "target_lang_word": "vytahování",
                                "target_lang_sense_clarification": "vytahování krku"
                            }
                        ]
                    }
                }
            ]
        }
