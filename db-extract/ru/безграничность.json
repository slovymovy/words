                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcf2016f-55c7-4dd9-b428-f317a8919225",
                        "source_entry_id": "b2f9f66b-c906-3817-bf02-cfb08a278008",
                        "source_sense_description": "свойство по значению прил. безграничный; отсутствие видимых границ",
                        "target_lang_word": "infinity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35346cee-45a8-3809-84ea-5facb28689d7",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "endlessness, unlimitedness, absence of a beginning, end or limits to size."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b55a8974-f0b6-3110-8049-8af62fe98786",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "A number that has an infinite numerical value that cannot be counted."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a87599f1-dca0-4bf4-ba55-3b9badec9c76",
                                                "sense_id": "b55a8974-f0b6-3110-8049-8af62fe98786",
                                                "text": "Some of the most beautiful and thus appealing physical theories, including quantum electrodynamics and quantum gravity, have been dogged for decades by infinities that erupt when theorists try to prod their calculations into new domains. Getting rid of these nagging infinities has probably occupied far more effort than was spent in originating the theories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "888bba83-e849-36b6-92b4-92f7dab999a0",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "An idealised point which is said to be approached by sequences of values whose magnitudes increase without bound."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa9389b3-48fe-3bc7-84f2-4b73c9110c0f",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "A number which is very large compared to some characteristic number. For example, in optics, an object which is much further away than the focal length of a lens is said to be \\\"at infinity\\\", as the distance of the image from the lens varies very little as the distance increases further."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08370ffc-07f2-3710-bb51-ffa2126965c4",
                                        "entry_id": "a508fd56-aa87-3c00-b83f-95c4d0f125bf",
                                        "glosses": [
                                            "The symbol ∞."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
