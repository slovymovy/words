                                        "entry_id": "021bb789-d554-3a51-998d-aef009b39299",
                                        "glosses": [
                                            "разг. очень хорошо, великолепно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e63c15df-dc1d-452c-888a-4400f06824ca",
                                                "sense_id": "277de759-9887-3cee-9563-9ad3a0b9ff33",
                                                "text": "Все-таки здорово Нэлка придумала ― всю гоп-компанию притащила из ЦДЛ с собой!"
                                            },
                                            {
                                                "example_id": "00ccb2bb-22a6-4b9e-894f-8d421979232b",
                                                "sense_id": "277de759-9887-3cee-9563-9ad3a0b9ff33",
                                                "text": "Поистине, что русскому здорово, то немцу смерть."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c9d316c-fdd5-33fc-9130-9767850c8895",
                                        "entry_id": "021bb789-d554-3a51-998d-aef009b39299",
                                        "glosses": [
                                            "перен., прост. очень сильно, в крайне значительной степени"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d613d9cb-debf-4afa-a8d9-ef3d5d63e3cc",
                                                "sense_id": "4c9d316c-fdd5-33fc-9130-9767850c8895",
                                                "text": "Было видно, что брат Аба здо́рово рассвирепел, но сдерживается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba070a1-877b-3600-ba46-2645fb7dbc07",
                                        "entry_id": "021bb789-d554-3a51-998d-aef009b39299",
                                        "glosses": [
                                            "прост. оценочная характеристика ситуации, чьих-либо действий как вызывающих восхищение, доставляющих удовлетворение, удовольствие"
                                        ],
                                        "tags": [
                                            "predicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fec1c91f-206b-4267-bf99-898f10a49fdc",
                                                "sense_id": "fba070a1-877b-3600-ba46-2645fb7dbc07",
                                                "text": "Было бы здо́рово, если бы стрела перебила проволоку, и знак упал бы прямо к ногам Анки."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "здорово",
                                "target_lang_code": "ru",
