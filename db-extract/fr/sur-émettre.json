                ],
                "senses": [
                    {
                        "sense_id": "30fcdb25-7e9b-38f8-8d3f-40243c362248",
                        "entry_id": "424394c0-63e1-35d9-8ba5-c56fdcad2d65",
                        "glosses": [
                            "Émettre plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8951bbd2-0fe7-4513-b3b1-46597b29ac5e",
                                "sense_id": "30fcdb25-7e9b-38f8-8d3f-40243c362248",
                                "text": "L’État dans des moments pressants alléché par l’abaissement du titre et le bénéfice qu'il produit pourrait sur-émettre le billon d’or."
                            },
                            {
                                "example_id": "ff26f7ae-6193-4c54-a599-c261ab55eeda",
                                "sense_id": "30fcdb25-7e9b-38f8-8d3f-40243c362248",
                                "text": "On voit ici l’importance de la distinction des monnaies, car si un nouveau producteur pouvait émettre de la monnaie non distincte d’une monnaie déjà existante, la concurrence conduirait à sur-émettre cette monnaie et à détruire sa valeur."
                            }
                        ]
                    }
