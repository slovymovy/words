            "senses": [
                {
                    "sense_id": "118ea57b-3d89-39b8-a28b-31ec096cd201",
                    "sense_definition": "De gezamenlijke inwoners van een land of staat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "natie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het Franse <w>volk</w> steunt zijn president in deze moeilijke tijden.",
                            "target_lang_translations": {
                                "en": "The French <w>people</w> support their president in these difficult times."
                            }
                        },
                        {
                            "text": "De koning sprak het hele <w>volk</w> toe via de nationale televisie.",
                            "target_lang_translations": {
                                "en": "The king addressed the entire <w>nation</w> via national television."
                            }
                        }
                    ],
                    "synonyms": [
                        "natie"
                    ],
                    "common_phrases": [
                        "het Nederlandse volk",
                        "een soeverein volk"
                    ],
                    "target_lang_definitions": {
                        "en": "The collective inhabitants of a country or state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "the citizens of a nation"
                            },
                            {
                                "target_lang_word": "nation",
                                "target_lang_sense_clarification": "a large body of people united by common descent, history, or culture, inhabiting a particular country"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e3b4e52-731b-3bcd-b74e-5f7b09f0f6ca",
                    "sense_definition": "Een onbepaalde, vaak grote hoeveelheid mensen; publiek.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mensenmassa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was veel <w>volk</w> op de been voor de opening van de nieuwe winkel.",
                            "target_lang_translations": {
                                "en": "There were many <w>people</w> out and about for the opening of the new store."
                            }
                        },
                        {
                            "text": "Was er veel <w>volk</w> bij de bijeenkomst gisteravond?",
                            "target_lang_translations": {
                                "en": "Was there a large <w>crowd</w> at the meeting last night?"
                            }
                        }
                    ],
                    "synonyms": [
                        "mensen",
                        "lieden",
                        "lui"
                    ],
                    "common_phrases": [
                        "veel volk",
                        "volk op de been"
                    ],
                    "target_lang_definitions": {
                        "en": "An indefinite, often large number of people; a crowd or audience."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crowd",
                                "target_lang_sense_clarification": "a large number of people gathered together"
                            },
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "individuals in general or a group of persons"
                            },
                            {
                                "target_lang_word": "folks",
                                "target_lang_sense_clarification": "people in general (informal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076fc877-4f05-39d0-84eb-40a7bcec6cc9",
                    "sense_definition": "Een groep mensen met een gemeenschappelijke cultuur, taal, geschiedenis of afstamming.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "etniciteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elk <w>volk</w> heeft zijn eigen unieke tradities en gebruiken.",
                            "target_lang_translations": {
                                "en": "Every <w>people</w> has its own unique traditions and customs."
                            }
                        },
                        {
                            "text": "Door mijn reizen leerde ik dat merkwaardige <w>volk</w> eindelijk echt kennen.",
                            "target_lang_translations": {
                                "en": "Through my travels, I finally really got to know that remarkable <w>tribe</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stam"
                    ],
                    "common_phrases": [
                        "een inheems volk",
                        "het Joodse volk"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people with a common culture, language, history, or descent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "an ethnic group or tribe"
                            },
                            {
                                "target_lang_word": "peoples",
                                "target_lang_sense_clarification": "plural form referring to multiple ethnic groups"
                            },
                            {
                                "target_lang_word": "tribe",
                                "target_lang_sense_clarification": "a social division in a traditional society consisting of families linked by social, economic, religious, or blood ties"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5dca6f5-2bb0-3360-85b5-f657987494b5",
                    "sense_definition": "De gewone mensen in de samenleving, vaak in tegenstelling tot de elite of de hogere klassen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sociale_klasse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jan Schaefer stond bekend als een echte man van het <w>volk</w>.",
                            "target_lang_translations": {
                                "en": "Jan Schaefer was known as a true man of the <w>people</w>."
                            }
                        },
                        {
                            "text": "De politicus probeerde de taal van het <w>volk</w> te spreken om stemmen te winnen.",
                            "target_lang_translations": {
                                "en": "The politician tried to speak the language of the <w>common people</w> to win votes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "man van het volk",
                        "het gewone volk"
                    ],
                    "target_lang_definitions": {
                        "en": "The ordinary people in society, often in contrast to the elite or higher classes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "people",
                                "target_lang_sense_clarification": "the commonalty or populace"
                            },
                            {
                                "target_lang_word": "common people",
                                "target_lang_sense_clarification": "ordinary people as a group"
                            },
                            {
                                "target_lang_word": "populace",
                                "target_lang_sense_clarification": "the people living in a particular country or area"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a6f6794-1002-3fc9-aec0-689b9e89b704",
                    "sense_definition": "Een georganiseerde groep insecten, zoals bijen of mieren, die samen in één nest of korf leven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De imker controleerde of het <w>volk</w> de winter goed had overleefd.",
                            "target_lang_translations": {
                                "en": "The beekeeper checked whether the <w>colony</w> had survived the winter well."
                            }
                        },
                        {
                            "text": "Een gezond bijen<w>volk</w> kan uit tienduizenden werksters bestaan.",
                            "target_lang_translations": {
                                "en": "A healthy bee <w>colony</w> can consist of tens of thousands of workers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een bijen volk",
                        "een sterk volk"
                    ],
                    "target_lang_definitions": {
                        "en": "An organized group of insects, such as bees or ants, living together in one nest or hive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "colony",
                                "target_lang_sense_clarification": "a community of animals or insects living close together"
                            },
                            {
                                "target_lang_word": "swarm",
                                "target_lang_sense_clarification": "a large or dense group of insects"
                            }
                        ]
                    }
                }
            ]
        }
