                                "target_senses": [
                                    {
                                        "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                        "entry_id": "f2150583-2314-3fd8-b8c5-7c121d3759f7",
                                        "glosses": [
                                            "A fan of the U.S. TV series Firefly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0fc9fae-100e-4e51-b7e4-0857308062bc",
                                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                                "text": "(some) Firefly flans call themselves Browncoats (Remember, the hot movie from Universal is out this September! :)"
                                            },
                                            {
                                                "example_id": "11194b9e-6de0-4d35-92ff-c75351719ecd",
                                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                                "text": "For what it's worth, I'm 27 and am a huge Firefly/Serenity flan."
                                            },
                                            {
                                                "example_id": "edb8ea6f-3564-408c-90ad-c14ee96e2f18",
                                                "sense_id": "32be1418-4d54-38ed-913f-9bf598a938b3",
                                                "text": "I'm glad this wasn't the first flan group I came across or I would never have realised the great nature of the majority of browncoasts.^([sic])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02de1ec8-c5ca-4cf1-8df1-ddbcef7d4ed1",
                        "source_entry_id": "c8756a04-4280-3614-acc7-a43d8ae7ebb8",
                        "source_sense_id": "b8f9f326-5b15-3039-8e69-11af315d28eb",
                        "source_sense_description": "ein im Wasserbad gestockter, einem Pudding ähnlicher Nachtisch aus Milch, Eiern und Zucker",
                        "target_lang_word": "flan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31a012f6-3988-3653-94bd-ff000990052a",
                                        "entry_id": "4f946617-adbe-3a8f-8cd5-0e41a47e9b5c",
                                        "glosses": [
                                            "Sorte de tarte faite avec de la crème, des œufs et de la farine."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673ce8ed-a6ce-40e2-806a-27fa84437021",
                                                "sense_id": "31a012f6-3988-3653-94bd-ff000990052a",
                                                "text": "Et la vanille Bourbon, à la puissance aromatique enivrante, d’anoblir flans, macarons, riz au lait, tartes aux pommes, gaufres, crèmes pâtissières et autres vanillades."
                                            },
                                            {
                                                "example_id": "34219695-24d9-45a1-9ea2-3656e3c85387",
                                                "sense_id": "31a012f6-3988-3653-94bd-ff000990052a",
                                                "text": "Démouler dans une petite assiette afin que le sirop de datte se répartisse sur le flan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4df244fa-9b36-3d2a-a92d-04d66decca37",
                                        "entry_id": "4f946617-adbe-3a8f-8cd5-0e41a47e9b5c",
                                        "glosses": [
                                            "Pièce de métal qu’on a taillée et préparée pour recevoir l’empreinte qui en fera une pièce de monnaie, un jeton, une médaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00092c24-6a7d-4087-b6d9-03215c430497",
                                                "sense_id": "4df244fa-9b36-3d2a-a92d-04d66decca37",
                                                "text": "Un flan d’argent."
                                            },
                                            {
                                                "example_id": "2c7e297f-3335-401a-963c-01fa26a86fde",
                                                "sense_id": "4df244fa-9b36-3d2a-a92d-04d66decca37",
                                                "text": "Un flan d’or."
                                            },
                                            {
                                                "example_id": "b95973d2-a6d7-4af6-a640-07cebaa61308",
                                                "sense_id": "4df244fa-9b36-3d2a-a92d-04d66decca37",
                                                "text": "Un flan de cuivre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a3fd952-4c04-3f8f-aca3-1f38841928d8",
                                        "entry_id": "4f946617-adbe-3a8f-8cd5-0e41a47e9b5c",
                                        "glosses": [
                                            "Sorte de carton mou que l’on applique sur les caractères mobiles pour en prendre l’empreinte en vue du tirage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728e4fe5-b23d-4a4c-a8f7-f3b347a380e2",
                                                "sense_id": "9a3fd952-4c04-3f8f-aca3-1f38841928d8",
                                                "text": "Longtemps on prépara le flan par mises en place successives de feuilles de papier de soie mouillées, auxquelles on faisait épouser la forme par battage à la brosse. Actuellement on emploie des flans secs à utiliser tels quels après humidification pour leur donner la plasticité voulue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                        "entry_id": "4f946617-adbe-3a8f-8cd5-0e41a47e9b5c",
                                        "glosses": [
                                            "Mensonge, information inventée de toutes pièces"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "common",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "510932f5-f573-4c95-9544-0c385a55818a",
                                                "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                                "text": "Arthur : Le vieux aussi, c’était du flan ?\nPerceval : Mais c’est tout du flan."
                                            },
                                            {
                                                "example_id": "dbdcc8f3-1a10-40e2-87af-9e9e3fab4411",
                                                "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                                "text": "Fallait que tu grimpes, que tu fasses ton rétablissement sur les piques au risque de t’empaler dix grandes fois et une petite ; et puis, sitôt dans le parc, ils te possédaient avec des trucs à la flan : « L’ennemi a ses grand-gardes au petit Trianon, ses petits postes en direction de l’Orangerie ! »"
                                            },
                                            {
                                                "example_id": "ed5479c3-d9ea-4b13-a8e6-5e00193005c4",
                                                "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                                "text": "J’ai dans l’idée qu’elle va nous jouer la comédie, parce que quand je lui vois cette espèce de vague dans les yeux, c’est qu’elle va parler d’amour ou d’un truc à la flan dans le même genre..."
                                            },
                                            {
                                                "example_id": "f077f23b-59f1-44ac-9ef0-42946e8a2bfa",
                                                "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                                "text": "À vrai dire, on s’en tamponnait le coquillard de son histoire à la flan […]"
                                            },
                                            {
                                                "example_id": "0f85b50b-c049-453e-9b38-f9d9a7f334a0",
                                                "sense_id": "23bbbdf0-9bec-356f-b4d6-d1333ab960f8",
                                                "text": "C’est du flan, les types de la désinsectisation. Il reste autant de cafards qu’avant et ils vous raflent six cents balles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
