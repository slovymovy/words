{
    "word_family": [
        "heinously",
        "heinousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "306a2639-a018-3d9d-a9ab-c05a3a776f48",
                    "sense_definition": "Totally reprehensible.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope they catch the person responsible for that <w>heinous</w> crime.",
                            "target_lang_translations": {
                                "zh": "我希望他们能抓住那起<w>令人发指</w>罪行的肇事者。"
                            }
                        },
                        {
                            "text": "The perpetrators of this <w>heinous</w> act must be brought to justice.",
                            "target_lang_translations": {
                                "zh": "这起<w>令人发指</w>行为的实施者必须被绳之以法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "abominable",
                        "horrible",
                        "odious"
                    ],
                    "antonyms": [
                        "unheinous"
                    ],
                    "common_phrases": [
                        "heinous crime",
                        "heinous act"
                    ],
                    "target_lang_definitions": {
                        "zh": "极其恶劣的，令人发指的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "令人发指",
                                "target_lang_sense_clarification": "形容罪行极其恶劣，使人愤怒到头发竖起来。"
                            },
                            {
                                "target_lang_word": "十恶不赦",
                                "target_lang_sense_clarification": "形容罪大恶极，不可饶恕。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8065c3b-a84e-332c-93f6-5b9d780e6fdc",
                    "sense_definition": "Bad, evil or villainous.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "evil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villain committed a <w>heinous</w> deed against the innocent villagers.",
                            "target_lang_translations": {
                                "zh": "那个恶棍对无辜的村民犯下了<w>卑劣</w>的行径。"
                            }
                        },
                        {
                            "text": "Everyone was shocked by his <w>heinous</w> behavior during the meeting.",
                            "target_lang_translations": {
                                "zh": "他在会议期间的<w>卑劣</w>行径让所有人都感到震惊。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "邪恶的，卑劣的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卑劣",
                                "target_lang_sense_clarification": "形容行为恶劣，品质低下。"
                            },
                            {
                                "target_lang_word": "邪恶",
                                "target_lang_sense_clarification": "指道德败坏，心术不正。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}