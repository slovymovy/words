                        ],
                        "form": "more shelving"
                    },
                    {
                        "form_id": "5e4df64c-c354-49d7-9251-b909996adfeb",
                        "entry_id": "6d51c80b-84fa-350f-ae9e-74dbf442d4f1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most shelving"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                        "entry_id": "6d51c80b-84fa-350f-ae9e-74dbf442d4f1",
                        "glosses": [
                            "Sloping (as opposed to horizontally flat or vertically upright)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7df20d7-246e-44e8-93d5-3ff2deef1fd3",
                                "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                                "text": "Her chamber is aloft, far from the ground, / And built so shelving that one cannot climb it / Without apparent hazard of his life."
                            },
                            {
                                "example_id": "5f847eb2-0793-47cc-a88f-288298294bad",
                                "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                                "text": "We still continued winding round Skiddaw, the sides of which are every where rather shelving, than steep."
                            },
                            {
                                "example_id": "f4a63399-d38b-46be-b680-410717b7c46c",
                                "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                                "text": "1858, George Eliot, Scenes of Clerical Life, Edinburgh: William Blackwood, Volume 2, “Janet’s Repentance,” Chapter 3, p. 87,\nher cheeks, which, on Whitsunday, loomed through a Turnerian haze of net-work, were, on Trinity Sunday, seen reposing in distinct red outline on her shelving bust, like the sun on a fog-bank"
                            },
                            {
                                "example_id": "540a3942-c54e-4425-a9b9-aff12f0dfccf",
                                "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                                "text": "The town of Abda is built upon the top and down the steeply shelving face of an isolated rocky spur,"
                            },
                            {
                                "example_id": "99eb0256-5c23-423b-94d4-c3819e2c4359",
                                "sense_id": "b0fb8b1d-6439-31eb-b6c7-94dc63b942c6",
                                "text": "[…] a gently shelving plain led to a huge forest through which there were tracks that could safely be followed."
                            }
                        ]
                    }
                ],
