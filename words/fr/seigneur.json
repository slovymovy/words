{
    "word_family": [
        "seigneurial",
        "seigneurie",
        "monseigneur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bee6854c-7a60-3ccf-b419-6b75846770a0",
                    "sense_definition": "Nom donné à Dieu ou au Christ dans la religion chrétienne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles prient le <w>Seigneur</w> tous les dimanches matin dans cette église."
                        },
                        {
                            "text": "Ce chant traditionnel rend humblement grâce au <w>Seigneur</w> pour toutes ses bénédictions."
                        }
                    ],
                    "synonyms": [
                        "créateur",
                        "dieu",
                        "divinité"
                    ],
                    "common_phrases": [
                        "Seigneur Dieu",
                        "loué soit le Seigneur",
                        "grâce au Seigneur"
                    ]
                },
                {
                    "sense_id": "4e339452-fb4b-3e01-8119-19fd1bfa9763",
                    "sense_definition": "Possesseur d'une seigneurie ou d'un domaine féodal sur lequel il exerçait son autorité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, les paysans payaient des impôts au <w>seigneur</w> local."
                        },
                        {
                            "text": "Ce puissant <w>seigneur</w> régnait sur une vaste province et possédait trois châteaux forts."
                        }
                    ],
                    "synonyms": [
                        "suzerain",
                        "noble",
                        "sire"
                    ],
                    "common_phrases": [
                        "seigneur féodal",
                        "seigneur du domaine",
                        "château du seigneur"
                    ]
                },
                {
                    "sense_id": "16dfec43-44b8-3c0f-ba10-b2bc4ca9141c",
                    "sense_definition": "Personne noble de rang élevé ou individu qui affecte des manières luxueuses et aristocratiques.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il mène une vie luxueuse et dépense son argent comme un grand <w>seigneur</w>."
                        },
                        {
                            "text": "Malgré ses origines modestes, il aime faire le grand <w>seigneur</w> devant ses collègues."
                        }
                    ],
                    "synonyms": [
                        "noble",
                        "sieur"
                    ],
                    "common_phrases": [
                        "grand seigneur",
                        "faire le grand seigneur",
                        "vivre en grand seigneur"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "80cd3f65-2112-38fc-8e41-41b92949effb",
                    "sense_definition": "Exclamation marquant la surprise, l'effroi, le soulagement ou le découragement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Seigneur</w>, je ne m'attendais vraiment pas à vous voir ici aujourd'hui !"
                        },
                        {
                            "text": "Doux <w>Seigneur</w>, quelle terrible nouvelle venons-nous d'apprendre à la radio !"
                        }
                    ],
                    "common_phrases": [
                        "doux Seigneur",
                        "juste Seigneur",
                        "grand Seigneur"
                    ]
                },
                {
                    "sense_id": "5d780442-218f-3a73-ba1b-b53e15611d0b",
                    "sense_definition": "Juron atténué ou euphémisme utilisé pour remplacer des sacres plus vulgaires.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah <w>seigneur</w>, j'ai encore oublié mes clés sur la table de la cuisine !"
                        },
                        {
                            "text": "<w>Seigneur</w>, que c'est difficile de terminer ce travail avant la fin de la journée !"
                        }
                    ],
                    "synonyms": [
                        "tabarouette",
                        "calvince",
                        "calvâsse"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Québec"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6085321d-8121-3be6-b856-7d4c040f479c",
                    "sense_definition": "Désignation de Jésus-Christ en tant que personne divine dans les Écritures et la liturgie.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divinite",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "Les apôtres ont fidèlement suivi les enseignements du <w>Seigneur</w> jusqu'à la fin de leur vie."
                        },
                        {
                            "text": "L'évangile relate la résurrection glorieuse du <w>Seigneur</w> devant ses disciples réunis."
                        }
                    ],
                    "synonyms": [
                        "dieu",
                        "créateur"
                    ],
                    "common_phrases": [
                        "la Passion du Seigneur",
                        "la parole du Seigneur"
                    ]
                }
            ]
        }
    ]
