                "senses": [
                    {
                        "sense_id": "51ea5292-8e76-3332-bd91-77f072b94660",
                        "entry_id": "80f43b70-37e7-3cea-b7d5-f58545945bc5",
                        "glosses": [
                            "Regarder avec convoitise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd1778fe-b955-4165-9851-32795eae9f24",
                                "sense_id": "51ea5292-8e76-3332-bd91-77f072b94660",
                                "text": "Ne te gêne plus, mon gars ; regarde encore, arrœille-toi bien !"
                            }
                        ]
                    },
                    {
                        "sense_id": "c758144e-ac70-387f-9f95-dc58f174663e",
                        "entry_id": "80f43b70-37e7-3cea-b7d5-f58545945bc5",
                        "glosses": [
                            "Être gai, gaillard, bien éveillé, ouvrir les yeux tout grands."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2d7855e5-2748-45fb-a0db-8fab1489fcbd",
                                "sense_id": "c758144e-ac70-387f-9f95-dc58f174663e",
                                "text": "C’est une fumelle qui s’arœille ben. : C’est-à-dire qui a des yeux égrillards."
                            },
                            {
                                "example_id": "28a3b251-e0b3-4f97-848f-1b19da970d4d",
                                "sense_id": "c758144e-ac70-387f-9f95-dc58f174663e",
                                "text": "Enfant qui s’arœille. : Qui ouvre les yeux, sourit, reconnaît."
                            }
                        ]
                    }
