                    },
                    {
                        "sense_id": "2fa27eb1-bcf3-36aa-9e6c-9de2e45f0f24",
                        "entry_id": "706a29ff-f44b-3988-b755-e46d34f1c100",
                        "glosses": [
                            "Something detested."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f71bdf73-3d37-4a36-a3a3-0d12258430b1",
                                "sense_id": "2fa27eb1-bcf3-36aa-9e6c-9de2e45f0f24",
                                "text": "Neckties are a real detestation for them."
                            },
                            {
                                "example_id": "b8088e9d-8990-4a34-bc98-a20c04a925e9",
                                "sense_id": "2fa27eb1-bcf3-36aa-9e6c-9de2e45f0f24",
                                "text": "“… No rogue e’er felt the halter draw, with a good opinion of the law, and perhaps my own detestation of the law arises from my having frequently broken it. …”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d178484-2a3b-4b64-8e88-92f566259764",
                        "source_entry_id": "706a29ff-f44b-3988-b755-e46d34f1c100",
                        "source_sense_description": "hate coupled with disgust",
                        "target_lang_word": "détestation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détestation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                        "entry_id": "3633adde-6479-3dc6-86e0-fe3932011cac",
                                        "glosses": [
                                            "Horreur qu’on a de quelque chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "440bb11a-bf57-4cb0-a86b-b6d40903b0b0",
                                                "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                                "text": "La pénitence enferme une sincère détestation du péché."
                                            },
                                            {
                                                "example_id": "5bad09cd-06f5-40d9-82d2-5b34d07b3c5e",
                                                "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                                "text": "Comment accorder la tolérance de Sybil à l’égard de King et la détestation qu’elle montrait pour lui un jour plus tôt ?"
                                            },
                                            {
                                                "example_id": "9cf50c87-35b9-4b0c-b465-c0129f0657e5",
                                                "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                                "text": "On n'en veut pas. On ne sait pas pourquoi du tout. La détestation est la dernière chose purement stupide et désintéressée."
                                            },
                                            {
                                                "example_id": "a001ab1d-08af-4c7b-ab44-54ccf5d23e17",
                                                "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                                "text": "J’avais ressenti de façon purement charnelle l’omniprésence du dollar dans notre vie quotidienne, sa nécessité fondamentale. Et comme il m’en manquait toujours un peu plus qu’à la majorité de mes camarades, j’avais développé à son égard un amour mêlé de détestation."
                                            },
                                            {
                                                "example_id": "dfa94cc4-c849-48f8-96dd-5d2d63d61fd5",
                                                "sense_id": "2e935904-2cb0-3c5a-a06b-a6a9d092b364",
                                                "text": "Comme si cet ennemi de l’eau avait une vocation particulière à se voir agresser par ce qu’il a en détestation !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
