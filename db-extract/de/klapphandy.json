                                                "sense_id": "87c9de91-83e2-306b-8c01-516ea4caeb2f",
                                                "text": "Brian (Kyle Secor) tells the salesman they'll be phasing out fridges and freezers for faxes and flip phones."
                                            },
                                            {
                                                "example_id": "302203a0-d641-4293-abb7-4c479012f9c7",
                                                "sense_id": "87c9de91-83e2-306b-8c01-516ea4caeb2f",
                                                "text": "Motorola's new flip phone doubles as a modem for your laptop."
                                            },
