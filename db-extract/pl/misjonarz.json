                    },
                    {
                        "translation_id": "689da074-6adf-4d03-bb7e-d37c068f8b62",
                        "source_entry_id": "9c89840b-4226-3eb6-8aa8-75379a9e162b",
                        "source_sense_id": "a1a19013-069c-3b90-a865-c16e4a09dcd8",
                        "target_lang_word": "Missionar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Missionar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                        "entry_id": "6b3fde4f-90b8-3cac-b025-63d1f3fa5e80",
                                        "glosses": [
                                            "jemand, der in der christlichen Mission (Verkündung/Bekehrung des/zum christlichen Glauben) tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5d10ab-c6da-4452-92f0-7b8b7993d686",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "Nach der politischen Konzeption eines patriotischen Missionars galt die Bekehrung von Nicht-Christen zur katholischen Religion als Dienst am Vaterland."
                                            },
                                            {
                                                "example_id": "6fcca5ff-24c2-4e3a-9300-ffe1a3c64b35",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "„Obwohl Patrick hier nicht der erste christliche Missionar war, verhalf er dem Christentum zum Durchbruch.“"
                                            },
                                            {
                                                "example_id": "f608448f-63af-4a33-9d24-59a038ad4499",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "„Mit den Missionaren brach sich die Überzeugung Bahn, dass man sich tatsächlich bis weit über den Äquator hinaus in Richtung Süden zu wenden habe, um in der Frage der Nilquellen fündig zu werden.“"
                                            },
                                            {
                                                "example_id": "4f0f2f88-f6e4-45a8-8e0a-771b8b34d6c3",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "„Noch erstaunlicher ist, dass es Missionaren gelingt, sie an den Orten ihrer Herkunft zu zivilisieren.“"
                                            },
                                            {
                                                "example_id": "ae326dc6-51e3-4c3e-b247-0f6794dbfcef",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "„Zur Zeit des Ausonius sei das Moselland dann aber auch christlich geworden, und der heilige Castor sei einer der ersten Missionare gewesen, der das Christentum an die Mosel gebracht habe.“"
                                            },
                                            {
                                                "example_id": "7a1ab49b-34b5-4876-8374-5fe808ac87e3",
                                                "sense_id": "5f0db47f-aa9a-3b8d-b9c6-8457a17fe2cd",
                                                "text": "„Das Erzbistum Bamberg […] half dem Priester Dieter Scholz, gegen den zwei Jungen 1963 Missbrauchsvorwürfe erhoben hatten, in Bolivien als Missionar zu arbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b57a4dde-9f4e-4663-8ea4-8098de5c0905",
                        "source_entry_id": "9c89840b-4226-3eb6-8aa8-75379a9e162b",
                        "source_sense_id": "a1a19013-069c-3b90-a865-c16e4a09dcd8",
                        "target_lang_word": "миссионе́р",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "миссионе́р",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                                        "entry_id": "220b1be4-3473-36fa-b1e0-89e0f94b9337",
                                        "glosses": [
                                            "лицо, посылаемое религиозной организацией, церковью для пропаганды своих религиозных взглядов и обращения иноверных в свою веру"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "998329bf-a954-452e-9cb5-5073bd60b550",
                                                "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                                                "text": "Молодым скрытным семинаром он мечтал о многом — думал стать миссионером, городским священником."
                                            },
                                            {
                                                "example_id": "8b63612b-e3a6-48c4-af86-772e689216fb",
                                                "sense_id": "d050e4d5-4fbc-3e40-bfcb-ffd17b403809",
                                                "text": "Разговор шёл о русском христианском миссионерстве: собеседники сравнивали относительно малые успехи наших миссионеров с большим числом приобретений римской церкви и соболезновали об очевидных преимуществах, какие имеют последние."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
