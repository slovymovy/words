{
    "word_family": [
        "excavation",
        "excavator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f8dea04b-e978-35ac-a90c-33cd534557c6",
                    "sense_definition": "To make a hole in something or to hollow it out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers began to <w>excavate</w> the ground to prepare for the new building foundation.",
                            "target_lang_translations": {
                                "pl": "Robotnicy zaczęli <w>kopać</w> grunt, aby przygotować fundamenty pod nowy budynek."
                            }
                        },
                        {
                            "text": "Small animals often <w>excavate</w> tunnels deep beneath the surface of the earth.",
                            "target_lang_translations": {
                                "pl": "Małe zwierzęta często <w>drążą</w> tunele głęboko pod powierzchnią ziemi."
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow",
                        "dig"
                    ],
                    "common_phrases": [
                        "excavate a hole"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wykonywać otwór w czymś lub drążyć."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "drążyć",
                                "target_lang_sense_clarification": "tworzyć otwór lub tunel wewnątrz czegoś"
                            },
                            {
                                "target_lang_word": "kopać",
                                "target_lang_sense_clarification": "wykonywać wykop w ziemi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7dc549c-112b-332e-bc08-0729baccbc98",
                    "sense_definition": "To remove material from a place by scooping or digging it out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They had to <w>excavate</w> tons of dirt to create the basement level.",
                            "target_lang_translations": {
                                "pl": "Musieli <w>wykopać</w> tony ziemi, aby stworzyć poziom piwnicy."
                            }
                        },
                        {
                            "text": "The machine was used to <w>excavate</w> the soil from the construction site.",
                            "target_lang_translations": {
                                "pl": "Maszyna została użyta do <w>wydobycia</w> ziemi z placu budowy."
                            }
                        }
                    ],
                    "synonyms": [
                        "dig out",
                        "scoop"
                    ],
                    "target_lang_definitions": {
                        "pl": "Usuwać materiał z miejsca poprzez jego wybieranie lub wykopywanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wykopywać",
                                "target_lang_sense_clarification": "usuwać ziemię lub materiał z wykopu"
                            },
                            {
                                "target_lang_word": "wydobywać",
                                "target_lang_sense_clarification": "usuwać materiał z głębi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bfb14b4-c92e-32d8-ba19-3c5fcacee098",
                    "sense_definition": "To uncover or reveal something buried by digging.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "digging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Archaeologists hope to <w>excavate</w> the ancient ruins before the rainy season begins.",
                            "target_lang_translations": {
                                "pl": "Archeolodzy mają nadzieję <w>odkopać</w> starożytne ruiny, zanim zacznie się pora deszczowa."
                            }
                        },
                        {
                            "text": "The team managed to <w>excavate</w> several valuable artifacts from the site.",
                            "target_lang_translations": {
                                "pl": "Zespołowi udało się <w>odkopać</w> kilka cennych artefaktów z tego miejsca."
                            }
                        }
                    ],
                    "synonyms": [
                        "unearth",
                        "disinter"
                    ],
                    "common_phrases": [
                        "excavate a site"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odkrywać lub wydobywać coś zakopanego poprzez kopanie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odkopywać",
                                "target_lang_sense_clarification": "odsłaniać coś, co było zakopane"
                            },
                            {
                                "target_lang_word": "prowadzić wykopaliska",
                                "target_lang_sense_clarification": "termin archeologiczny dotyczący odkrywania ruin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4305b0b3-043c-3cfe-9124-bd143d8639d5",
                    "sense_definition": "A member of a major group of unicellular organisms belonging to the clade Excavata.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>excavate</w> is a type of protist often found in aquatic environments.",
                            "target_lang_translations": {
                                "pl": "<w>Ekskawat</w> to rodzaj protista często spotykanego w środowiskach wodnych."
                            }
                        },
                        {
                            "text": "Scientists study the <w>excavate</w> to understand the evolution of early eukaryotes.",
                            "target_lang_translations": {
                                "pl": "Naukowcy badają <w>ekskawaty</w>, aby zrozumieć ewolucję wczesnych eukariontów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Członek grupy jednokomórkowych organizmów należących do kladu Excavata."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ekskawat",
                                "target_lang_sense_clarification": "biologiczne określenie organizmu z grupy Excavata"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08eca720-a5d7-39b4-9328-007fc9f52e03",
                    "sense_definition": "Having a hollowed-out shape.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>excavate</w> surface of the stone was used as a primitive bowl.",
                            "target_lang_translations": {
                                "pl": "<w>Wydrążona</w> powierzchnia kamienia była używana jako prymitywna miska."
                            }
                        },
                        {
                            "text": "He examined the <w>excavate</w> cavity within the old tree trunk.",
                            "target_lang_translations": {
                                "pl": "Zbadał <w>wydrążoną</w> jamę w starym pniu drzewa."
                            }
                        }
                    ],
                    "synonyms": [
                        "hollow"
                    ],
                    "antonyms": [
                        "solid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an adjective in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Posiadający wydrążony kształt."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wydrążony",
                                "target_lang_sense_clarification": "mający pustą przestrzeń w środku"
                            },
                            {
                                "target_lang_word": "wklęsły",
                                "target_lang_sense_clarification": "mający zagłębienie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}