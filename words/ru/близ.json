                {
                    "sense_id": "25ff5d3d-5f03-3862-bfdf-8e2dcbbcd502",
                    "sense_definition": "Указывает на приблизительное время или количество; около, приблизительно.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "temporal_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему было уже <w>близ</w> сорока лет, когда он решил сменить профессию.",
                            "target_lang_translations": {
                                "en": "He was already <w>close to</w> forty years old when he decided to change his profession.",
                                "de": "Er war bereits <w>nahe</w> den vierzig, als er beschloss, den Beruf zu wechseln."
                            }
                        },
                        {
                            "text": "Мы вернулись домой <w>близ</w> полуночи, уставшие, но довольные.",
                            "target_lang_translations": {
                                "en": "We returned home <w>near</w> midnight, tired but happy.",
                                "de": "Wir kehrten <w>gegen</w> Mitternacht nach Hause zurück, müde, aber zufrieden."
                            }
                        }
                    ],
