                                    {
                                        "sense_id": "57c82d7e-fac5-392e-a928-6cd6d363fc7b",
                                        "entry_id": "8b0fe870-40be-3872-b5a9-3fa9444c4c08",
                                        "glosses": [
                                            "An instance of a person being beheaded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d98dd774-397f-4f57-b94a-db69423d4515",
                                                "sense_id": "57c82d7e-fac5-392e-a928-6cd6d363fc7b",
                                                "text": "A large crowd gathered to see the beheading."
                                            },
                                            {
                                                "example_id": "46edde6c-18e6-475e-b340-7d62a7acb0e5",
                                                "sense_id": "57c82d7e-fac5-392e-a928-6cd6d363fc7b",
                                                "text": "The guillotine was meant to humanize beheadings, but allowed the French Revolution to execute people at an industrial rate."
                                            }
                                        ]
