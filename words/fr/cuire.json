{
    "word_family": [
        "cuisson",
        "cuiseur",
        "cuisant",
        "cuite",
        "recuire",
        "surcuire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c236a6eb-540f-38d2-9e2d-be6ef2172244",
                    "sense_definition": "Préparer des aliments par l'action de la chaleur pour les rendre consommables, ou être soumis à cette chaleur.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "alimentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je fais <w>cuire</w> des légumes pour le dîner de ce soir."
                        },
                        {
                            "text": "La soupe <w>cuit</w> lentement dans une grande casserole."
                        }
                    ],
                    "common_phrases": [
                        "faire cuire",
                        "laisser cuire",
                        "cuire au four",
                        "cuire à feu doux"
                    ]
                },
                {
                    "sense_id": "6a458685-1f8c-37be-b236-be0f2749881d",
                    "sense_definition": "Provoquer une sensation vive et douloureuse de brûlure ou de picotement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le savon est entré dans ma blessure et cela me <w>cuit</w> terriblement."
                        },
                        {
                            "text": "Avec toute cette fumée dans la pièce, les yeux me <w>cuisent</w> beaucoup."
                        }
                    ],
                    "synonyms": [
                        "brûler",
                        "piquer"
                    ],
                    "common_phrases": [
                        "ça me cuit",
                        "les yeux me cuisent"
                    ]
                },
                {
                    "sense_id": "6e8bf1ea-5400-341f-9b93-67cd41431855",
                    "sense_definition": "Soumettre une matière minérale à une très forte chaleur pour la durcir ou la transformer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matière",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan doit <w>cuire</w> les briques dans un grand four avant de les utiliser."
                        },
                        {
                            "text": "Le potier a laissé <w>cuire</w> le vase en argile pendant plusieurs heures."
                        }
                    ],
                    "common_phrases": [
                        "terre cuite"
                    ]
                },
                {
                    "sense_id": "e3bec6f1-d44d-310e-8f34-b17d332efa92",
                    "sense_definition": "Causer du tort, des regrets ou des conséquences fâcheuses, principalement dans la tournure impersonnelle « en cuire ».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu continues à désobéir aux consignes du patron, il pourrait bien t'en <w>cuire</w>."
                        },
                        {
                            "text": "Il a voulu tricher à l'examen mais il lui en a <w>cuit</w> dès le lendemain."
                        }
                    ],
                    "common_phrases": [
                        "en cuire"
                    ]
                }
            ]
        }
    ]
}