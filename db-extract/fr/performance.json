        "fr-extract.jsonl": [
            {
                "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                "word": "performance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "00972648-33a5-4c1b-bbc1-4c90c90236d4",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "tags": [
                            "plural"
                        ],
                        "form": "performances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8dbb3e8e-0854-3af2-b213-2c1c7dbcef84",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Manière dont s’est comporté un cheval dans une course."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c772838c-f80d-4a9f-a382-eed414f7b8f8",
                                "sense_id": "8dbb3e8e-0854-3af2-b213-2c1c7dbcef84",
                                "text": "Les parieurs, avant de jouer aux courses, étudient les performances précédentes des chevaux engagés."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ae9b1ec-4d7b-34b5-978b-abcfad9d9a87",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Manière dont s’est comporté un cheval dans une course.",
                            "Résultats chiffrés obtenus par un athlète, une équipe sportive."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e2020938-89c9-4034-bb8b-3011543f5163",
                                "sense_id": "1ae9b1ec-4d7b-34b5-978b-abcfad9d9a87",
                                "text": "En raison des conditions météorologiques, les performances ont été très moyennes."
                            },
                            {
                                "example_id": "83841003-cf0a-40c7-918e-c8ba24945188",
                                "sense_id": "1ae9b1ec-4d7b-34b5-978b-abcfad9d9a87",
                                "text": "Production et performance sont évidemment liés. Ainsi, le poids de la carcasse d’un animal (production) dépend de ses performances de croissance, surtout pour un jeune animal. — (Cirad/Gret/MAE, Mémento de l'Agronome, 1 692 pages, page 1252, 2002, Paris, France, Cirad/Gret/Ministère des Affaires Étrangères)"
                            }
                        ]
                    },
                    {
                        "sense_id": "e65547b3-2a6c-3213-9895-8fec4f6bde2e",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Manière dont s’est comporté un cheval dans une course.",
                            "Exploit, réussite remarquable dans un domaine."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "3adcbfc9-a902-4f10-b7ce-c150125a1386",
                                "sense_id": "e65547b3-2a6c-3213-9895-8fec4f6bde2e",
                                "text": "La performance du réparateur d’électroménager n'en est une qu’au regard du temps qu'il passe pour effectuer sa réparation."
                            },
                            {
                                "example_id": "acbad2f9-10d8-43e9-8139-6367cb2a9b37",
                                "sense_id": "e65547b3-2a6c-3213-9895-8fec4f6bde2e",
                                "text": "On ne joue plus une œuvre du passé, on en fait un exploit. La tragédie du répertoire devient le prétexte de performances presque sportives pour de grands comédiens, pas toujours en forme."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d83d9f6-0b99-3341-913c-40cfdbe88794",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Ensemble évalué, voire chiffré, des potentialités d’un appareil."
                        ],
                        "tags": [
                            "analogy",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "c98716a9-70cc-4575-bcad-0cf744785eba",
                                "sense_id": "9d83d9f6-0b99-3341-913c-40cfdbe88794",
                                "text": "Les performances d'un ordinateur, d'une automobile."
                            }
                        ]
                    },
                    {
                        "sense_id": "b96a59b4-d8a1-30dc-9adc-9c17f6f17147",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Capacité à remplir efficacement sa mission."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ebd21ad8-dd2f-4c21-aff5-c134abeaf736",
                                "sense_id": "b96a59b4-d8a1-30dc-9adc-9c17f6f17147",
                                "text": "La performance de la sphère publique est aujourd’hui une composante essentielle de la compétitivité qu’impose la mondialisation."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0ccd315-9214-3151-8b0f-c0184bc88d76",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Dans l’approche chomskyenne, un exemple d’utilisation du langage par un locuteur en situation, opposée à la compétence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df9d3193-785e-4d0e-8219-1e16f5750e48",
                                "sense_id": "a0ccd315-9214-3151-8b0f-c0184bc88d76",
                                "text": "La langue, comme performance de tout langage, n’est ni réactionnaire ni progressiste ; elle est tout simplement fasciste ; car le fascisme, ce n’est pas d’empêcher de dire, c’est d’obliger à dire."
                            }
                        ]
                    },
                    {
                        "sense_id": "34a23e80-a509-3b49-bf52-dd897b024cff",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Action artistique entreprise par un ou des artistes en présence du public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bcba863-eaec-4a15-a94a-e8a6dbcd3a05",
                                "sense_id": "34a23e80-a509-3b49-bf52-dd897b024cff",
                                "text": "— Il y a un retour à la peinture, en ce moment ?\n— Plus ou moins, enfin c’est une des tendances. Retour à la peinture, ou à la sculpture, enfin retour à l’objet. Mais, à mon avis, c’est surtout pour des raisons commerciales. Un objet, c’est plus facile à stocker et à revendre qu’une installation, ou qu’une performance."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae163d0f-1af4-3843-b19d-7e81f71f4946",
                        "entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "glosses": [
                            "Évènement artistique qui recourt à différents modes d’expression dont l’exécution constitue l’œuvre elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5eb3047-ed61-462b-abf4-75f29b01baf8",
                                "sense_id": "ae163d0f-1af4-3843-b19d-7e81f71f4946",
                                "text": "Le jeune homme a tenu à préciser que sa performance n’a pas pour but d’inciter les gens à ne pas respecter le confinement car c’est « la seule solution, en l’état actuel des choses et au regard de la situation de l’hôpital public, pour sauver des vies », a-t-il conclu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa708e5d-4ebb-4272-9bcd-1722c18bacf2",
                        "source_entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "target_lang_word": "Vorführung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorführung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3583545b-fe6e-3c97-8ab7-c407856b263a",
                                        "entry_id": "9a6ce4d3-b229-30ad-878c-911f3cde1535",
                                        "glosses": [
                                            "künstlerische Aufführung vor Publikum"
                                        ],
                                        "tags": [
                                            "Theater",
                                            "Kino"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae8e422a-a31b-469c-9c40-bcca525a2ce0",
                                                "sense_id": "3583545b-fe6e-3c97-8ab7-c407856b263a",
                                                "text": "Dem Mythos nach führten die ersten Vorführung des Films „Einfahrt eines Zuges in den Bahnhof von La Ciotat“ zu Tumulten im Publikum."
                                            },
                                            {
                                                "example_id": "4fc58d9d-fcef-4aed-b585-1d30bf726e30",
                                                "sense_id": "3583545b-fe6e-3c97-8ab7-c407856b263a",
                                                "text": "„Keuchend hielt er an und dachte an die Vorführung im Filmpalast.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "643b1708-0178-3d90-a8b9-7eb6a697ac58",
                                        "entry_id": "9a6ce4d3-b229-30ad-878c-911f3cde1535",
                                        "glosses": [
                                            "Präsentation der Funktionen eines Gerätes oder eines Dienstes zu Werbezwecken"
                                        ],
                                        "tags": [
                                            "Marketing"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "135ee7b8-ee79-4de9-88f9-73c86d4ef622",
                                                "sense_id": "643b1708-0178-3d90-a8b9-7eb6a697ac58",
                                                "text": "Während der Vorführung des Staubsaugers platzte ein Schlauch und der Dreck verteilte sich im ganzen Wohnzimmer."
                                            },
                                            {
                                                "example_id": "4388d6a5-f80c-4ce1-a4df-f469d1a3a3cd",
                                                "sense_id": "643b1708-0178-3d90-a8b9-7eb6a697ac58",
                                                "text": "„Nach der Vorführung konnten sie nicht gehen, sondern mußten mit Bundschuh in der Wohnküche noch eine Flasche Bier trinken und sich unterhalten.“"
                                            },
                                            {
                                                "example_id": "12610d04-781b-41b5-8319-f85abfec209a",
                                                "sense_id": "643b1708-0178-3d90-a8b9-7eb6a697ac58",
                                                "text": "„Schon drei Tage nach der Vorführung auf dem Glockenturm von San Marco, die von starker Wirkung auf alle Beteiligten war, überreichte Galilei der Signoria von Venedig sein Fernrohr als Geschenk.“"
                                            },
                                            {
                                                "example_id": "084efe84-3631-4cf1-ba63-fb588c219f4e",
                                                "sense_id": "643b1708-0178-3d90-a8b9-7eb6a697ac58",
                                                "text": "„Und er begann mit der Vorführung der Sämaschine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "55dd6dd8-2c57-3cb6-b31b-c0407a77350b",
                                        "entry_id": "9a6ce4d3-b229-30ad-878c-911f3cde1535",
                                        "glosses": [
                                            "das Zuführen einer Person zu einem Gerichtsverfahren (gegen ihren Willen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e29df6a1-1eb0-4ac6-b018-c66f8c56b137",
                                                "sense_id": "55dd6dd8-2c57-3cb6-b31b-c0407a77350b",
                                                "text": "Die Vorführung des Täters vor den Haftrichter verlief ohne größere Zwischenfälle."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7fbc473-884e-4b26-abf9-f7e194a36e82",
                        "source_entry_id": "1248e6d0-d8f6-3aed-89ff-62414bba0a60",
                        "target_lang_word": "performance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "performance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                                        "entry_id": "ceacc6e6-82b2-395e-82b2-f03fa9b15d7a",
                                        "glosses": [
                                            "The act of performing; carrying into execution or action; execution; achievement; accomplishment; representation by action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfe67a2-ac0d-4afb-91f8-a517cba9d207",
                                                "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                                                "text": "the performance of an undertaking or a duty"
                                            },
                                            {
                                                "example_id": "4fabe60d-5b34-4024-9ae4-9e29c74bff9b",
                                                "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                                                "text": "Though the result wasn't what we were hoping for, I have to commend the performance of the team, never giving up until the end."
                                            },
                                            {
                                                "example_id": "bf91e74b-3a0b-4b90-9077-7d0863ee6630",
                                                "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            },
                                            {
                                                "example_id": "237ddb3e-265d-4bb9-95b9-db6e88905bfe",
                                                "sense_id": "b5f2730b-d787-345e-9a75-bfb4e062cc82",
                                                "text": "The outstanding train on the L.M.S. route was the 6.20 p.m. from Birmingham, which reached Euston in two hours after intermediate stops at Coventry, Rugby and Watford Junction, and evoked some sparkling performances from \"Patriot\" and \"Jubilee\" 4-6-0s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ecf25b-d6bd-3213-aa47-af664fe8a78c",
                                        "entry_id": "ceacc6e6-82b2-395e-82b2-f03fa9b15d7a",
                                        "glosses": [
                                            "That which is performed or accomplished; a thing done or carried through; an achievement; a deed; an act; a feat; especially, an action of an elaborate or public character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f95664fc-901c-3894-ad90-66642e02ea91",
                                        "entry_id": "ceacc6e6-82b2-395e-82b2-f03fa9b15d7a",
                                        "glosses": [
                                            "A live show or concert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6120414a-eb6b-41c3-9e59-71a2d91d90f8",
                                                "sense_id": "f95664fc-901c-3894-ad90-66642e02ea91",
                                                "text": "The band played a mix of old and new songs during their 90-minute performance."
                                            },
                                            {
                                                "example_id": "0e556014-e522-4036-8f05-1348c896beac",
                                                "sense_id": "f95664fc-901c-3894-ad90-66642e02ea91",
                                                "text": "We saw the whole ballet performance from the front row."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8eb9f87-e6fa-31f5-be90-c3839c97ca8b",
                                        "entry_id": "ceacc6e6-82b2-395e-82b2-f03fa9b15d7a",
                                        "glosses": [
                                            "The amount of useful work accomplished estimated in terms of time needed, resources used, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99bc71f2-670d-400d-b36d-bbadf8fb5f5c",
                                                "sense_id": "a8eb9f87-e6fa-31f5-be90-c3839c97ca8b",
                                                "text": "Better performance means more work accomplished in shorter time and/or using fewer resources."
