                        "verkeer laten doorstromen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move smoothly and without interruption, typically referring to traffic or crowds."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flow through",
                                "target_lang_sense_clarification": "of traffic or people"
                            },
