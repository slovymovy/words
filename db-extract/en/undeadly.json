                        "glosses": [
                            "Immortally; eternally."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd11eee-45cb-40a0-b6b4-b279f7e80b46",
                                "sense_id": "f659cdd4-dd3b-3d46-9629-b431f62e7d80",
                                "text": "[...] and it had been Sebastian's fault that her husband was no longer living undeadly by her side."
                            },
                            {
                                "example_id": "61ef479d-cb17-46e1-8336-798c854d883e",
                                "sense_id": "f659cdd4-dd3b-3d46-9629-b431f62e7d80",
                                "text": "Today, almost eight months since they'd met, and sharing her house for four of those months now, Wanda was more in love with Heath than she ever thought was humanly, er, undeadly possible."
