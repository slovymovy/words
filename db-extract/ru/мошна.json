                "senses": [
                    {
                        "sense_id": "e94a9731-fc59-30fc-8fbe-78e4e0dad155",
                        "entry_id": "7d3715b4-d30a-3b65-ab94-2dbfd958fdd7",
                        "glosses": [
                            "устар. мешок для хранения денег, кошель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6520b658-243a-4748-be09-3765c2daa56e",
                                "sense_id": "e94a9731-fc59-30fc-8fbe-78e4e0dad155",
                                "text": "Князь взял зашитый предмет и бросил мельнику мошну с золотыми."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6f6424e-5759-35dc-ba21-f11af21f7e59",
                        "entry_id": "7d3715b4-d30a-3b65-ab94-2dbfd958fdd7",
                        "glosses": [
                            "перен., разг., ед. ч. кошелёк как символ богатства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfe22ecd-4777-48b7-ae40-97f9d6ce80cb",
                                "sense_id": "e6f6424e-5759-35dc-ba21-f11af21f7e59",
                                "text": "Выборы превратились в клоунаду: кто больше набрешет и больше обольёт грязью соперника, кто круче тряхнёт мошной, тот и в начальниках оказывается."
                            }
                        ]
                    }
                ],
