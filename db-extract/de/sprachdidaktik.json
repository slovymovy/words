                "senses": [
                    {
                        "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                        "entry_id": "9be3af8a-6028-3e7c-b4d9-c582c974419b",
                        "glosses": [
                            "wissenschaftliche Disziplin, die sich um die Verbesserung des Sprachunterrichts bemüht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c71dc485-e2cd-4999-b9d5-0dfc3e51ed21",
                                "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                                "text": "Die Sprachdidaktik befasst sich mit allen Aspekten, die der Verbesserung des Sprachunterrichts dienen können."
                            },
                            {
                                "example_id": "f305ed25-495e-48ad-93aa-0f4dcb2bba15",
                                "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                                "text": "„Im folgenden versuche ich, in der gebotenen Kürze die Grundlagen von Sprachbewußtsein in der DDR und damit von Sprachdidaktik wiederzugeben.“"
                            },
                            {
                                "example_id": "5edc4429-7a0f-4492-9458-21cbc5e406ec",
                                "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                                "text": "„Vielmehr ist es notwendig, aus der besonderen Zielsetzung pädagogischer Grammatiken heraus eigene Bewertungskriterien zu entwickeln, wobei die Kriterien wissenschaftlicher Grammatiken nur insoweit von Bedeutung sein können, wie der Faktor ‚Wissenschaft‘ im Begründungszusammenhang von Sprachpädagogik oder Sprachdidaktik bedeutsam ist…“"
                            },
                            {
                                "example_id": "71ae85c9-10de-4735-b2b0-94fcf1dae3f0",
                                "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                                "text": "„Die Sprachdidaktik befasst sich mit der Übertragung sprachwissenschaftlicher Erkenntnisse auf den Sprachunterricht…“"
                            },
                            {
                                "example_id": "8bc733e2-0539-44a3-9aa0-d164132dfdcb",
                                "sense_id": "86cbff67-e3ff-3efc-96f3-6fbb90c788f2",
                                "text": "„Noch stärker als bisher müssen Sprachwissenschaft und Sprachdidaktik dazu beitragen, die mit kultureller Diversität und intrakulturellen Sprachdifferenzen verbundenen gesellschaftlichen Herausforderungen zu gestalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
