                        "glosses": [
                            "Qui concerne les nosaïris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ffd1abd-c7fd-45c3-8fcf-77e66f5fff66",
                                "sense_id": "bcb0124c-e9c8-3b97-a9fd-643b010e4db9",
                                "text": "Dans la septième sourate de la liturgie nosaïrie (Bâkourah, p. 22 ; Salisbury, p. 250), on trouve les mêmes mots, rangés absolument dans le même ordre, et le texte ajoute : « Car ce sont là les divers degrés ; puisse le monde de la pureté être sanctifié ! »"
                            }
                        ]
