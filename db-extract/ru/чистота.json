                    {
                        "sense_id": "d4d2e1ba-26c2-33ff-8d17-cba2ca5468da",
                        "entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "glosses": [
                            "перен. ясность очертаний; чёткость (изображения и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f2dae52d-82a4-3b82-9dfc-ede25edfc9c1",
                        "entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "glosses": [
                            "перен. отсутствие искажающих воздействий, чего-либо наносного, постороннего"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae5b2071-2b9e-399b-ba78-d34beff079ec",
                        "entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "glosses": [
                            "перен. чёткость звучания, произношения и т. п.; отсутствие помех, шумов"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "22dbace3-ab90-391e-90c6-767f965b4117",
                        "entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "glosses": [
                            "перен. аккуратность отделки, отсутствие шероховатостей, дефектов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dcbaca9-7e50-4ef3-9ce7-c642a51ed5fb",
                                "sense_id": "22dbace3-ab90-391e-90c6-767f965b4117",
                                "text": "Для сверления неглубоких отверстий с высокой чистотой обработки поверхности применяют свёрла с круговыми или зубчатыми подрезателями (рис. 4, г)."
                            }
                        ]
                    },
                    {
                        "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                        "entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "glosses": [
                            "перен. безгрешность, целомудрие, высокая нравственность; чистое состояние, чистый вид чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d3d10d5-17fd-427b-be85-b95432f20034",
                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                "text": "Соблюдать чистоту."
                            },
                            {
                                "example_id": "40bc54e3-1d7d-486e-aaca-db5e8987b48d",
                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                "text": "Нравственная чистота."
                            },
                            {
                                "example_id": "64d44bf5-5e00-4afe-ab42-a443807580f5",
                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                "text": "Укромный домик твой не златом — чистотой и светлостью пленяет."
                            },
                            {
                                "example_id": "ad025588-b0f9-4203-b42e-cfc7820eb790",
                                "sense_id": "dba75029-8d9a-3793-a5fc-41c9e9602657",
                                "text": "Сознательно мирские наслажденья ты отвергал; ты чистоту хранил."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3788a074-aa68-4440-bea9-5891e19bfb69",
                        "source_entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "source_sense_description": "отсутствие грязи",
                        "target_lang_word": "tidiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tidiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb8443f-1f6e-3977-a5d9-956fea441972",
                                        "entry_id": "f3566dd0-54b3-3d2d-b065-e44dfda70ba6",
                                        "glosses": [
                                            "The quality of being tidy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b59b44-9a87-42ce-aeda-a5eafa5af478",
                                                "sense_id": "5eb8443f-1f6e-3977-a5d9-956fea441972",
                                                "text": "The amount of external pipework is also unusual in a British locomotive, though apparent in the most recent L.M.S.R. designs, such as the Class \"4\" 2-6-0s; but while lacking the tidiness of the old school of British locomotive engineering, this has obvious application for maintenance purposes in present circumstances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa4e2fcb-1715-4140-afee-a2d09bc32003",
                        "source_entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "source_sense_description": "отсутствие грязи",
                        "target_lang_word": "cleanliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleanliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19f44554-4dfa-362e-8bd7-b76b47fe443f",
                                        "entry_id": "85c7d93e-612d-36fe-82b0-4aa47af1bf9f",
                                        "glosses": [
                                            "The property of being cleanly, or habitually clean; good hygiene."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23213fac-0d49-472e-b705-b8631047dacf",
                                                "sense_id": "19f44554-4dfa-362e-8bd7-b76b47fe443f",
                                                "text": "Both engines and carriages were maintained in admirable cleanliness, and a very high standard of neatness characterised the permanent way and lineside buildings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a449835f-d8e6-377d-99f1-59f92f754826",
                                        "entry_id": "85c7d93e-612d-36fe-82b0-4aa47af1bf9f",
                                        "glosses": [
                                            "Ritual purity."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd6f3cb0-09d0-4028-8b1d-a6aa84e0b183",
                        "source_entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "source_sense_description": "отсутствие грязи",
                        "target_lang_word": "cleanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "911baf00-0fa4-33ea-a5b6-f8a3d6db4ea8",
                                        "entry_id": "2494f1f1-ba77-3e56-a1b0-acf4241ca316",
                                        "glosses": [
                                            "Moral purity; innocence."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e1ff92-de6b-4adb-b86c-bada9218fd66",
                                                "sense_id": "911baf00-0fa4-33ea-a5b6-f8a3d6db4ea8",
                                                "text": "Certes sayd the good man that is sothe / for he shalle be the best knyghte of the world and the fairest of alle the felauship / But wete yow wel there shall none atteyne it but by clennes that is pure confession"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "467c687b-0900-3933-85ec-bed0c4ea6820",
                                        "entry_id": "2494f1f1-ba77-3e56-a1b0-acf4241ca316",
                                        "glosses": [
                                            "The state of being physically clean and free of contamination or dirt; cleanliness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1baabbc-e500-40d1-a427-2fb4c5b3aad1",
                                                "sense_id": "467c687b-0900-3933-85ec-bed0c4ea6820",
                                                "text": "\"But if so, why do you see so many young children on steam trains - apart, that is, from being dragged along by their fathers, or grandfathers?\n\"I think they enjoy them because they are simply so different, so mechanical, so hot, oily and clanky, so dirty, so 'analogue' in a digital world. They are everything modern life tries to extirpate in favour of silence, smoothness and cleanness. Kids love that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42b96c69-95d3-42cc-8265-4add7547d52d",
                        "source_entry_id": "df06297c-44d9-3251-b546-dc0d7cde4d28",
                        "source_sense_description": "отсутствие грязи",
                        "target_lang_word": "Sauberkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sauberkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6a88959-e993-3dce-b541-cb52e747286b",
                                        "entry_id": "f4361fda-c757-3a33-b715-6b62ee898d38",
                                        "glosses": [
                                            "hygienischer Zustand einer Sache oder Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0029a46-111c-4b81-be5c-2a3510b3fd87",
                                                "sense_id": "a6a88959-e993-3dce-b541-cb52e747286b",
                                                "text": "Viele Leute pflegen heute die Sauberkeit ihrer Siedlung."
                                            },
                                            {
                                                "example_id": "a996401c-7701-4a52-b41a-1ccffd23beae",
                                                "sense_id": "a6a88959-e993-3dce-b541-cb52e747286b",
                                                "text": "„Wir werden die Sauberkeit der Böden und den Zustand der Tapeten begutachten, wir werden Teppiche hochheben und über die Möbel streichen, ob sie auch ja staubfrei sind.“"
                                            },
                                            {
                                                "example_id": "41670e56-8558-4234-8547-d0d1c7d43e33",
                                                "sense_id": "a6a88959-e993-3dce-b541-cb52e747286b",
                                                "text": "„Zur Zeit der Pharaonen war man in Ägypten stets auf Hygiene und Sauberkeit bedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
