                        "sense_id": "bf3f2106-ffe4-3f5b-8f20-584f77477a4e",
                        "entry_id": "abc86828-ec60-3f5f-b767-00bb98444c2b",
                        "glosses": [
                            "document waarin beschreven staat welke lading een schip bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e847aa9-efa5-4801-8873-67ab148903ea",
                                "sense_id": "bf3f2106-ffe4-3f5b-8f20-584f77477a4e",
                                "text": "Volgens de laadbrief zat in de zeecontainer een partij meubels. Het schip waar de container mee werd vervoerd had eerder in Brazilië aangelegd en is na een tussenstop in Egypte binnengelopen in de haven van Iskendrun. Twee verdachten zijn opgepakt."
                            },
                            {
                                "example_id": "40cb80d3-b463-4884-8722-3c700a5482b7",
                                "sense_id": "bf3f2106-ffe4-3f5b-8f20-584f77477a4e",
                                "text": "De kratten waarin de stukken pijp waren verpakt waren geadresseerd aan het ministerie voor industrie en delfstoffen in Bagdad en bevatten volgens de laadbrief onderdelen bestemd voor de olie-industrie."
                            }
                        ]
                    }
