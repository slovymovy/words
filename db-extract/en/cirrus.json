                                                "sense_id": "fb7961e8-9046-3352-bd3c-d6bb81e629af",
                                                "text": "Fazol obecný keříčkovitý má lodyhu odspodu rozvětvenou s ukončeným růstem ve výšce asi 45 cm nebo s vybíhajícími úponky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4276bc7-4515-344e-b73c-91d9117a05d8",
                                        "entry_id": "d9b8bccf-990a-3390-941d-139034100544",
                                        "glosses": [
                                            "ozdobný motiv v podobě pokrouceného stonku či listu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4618c91-b9be-4eb1-8ec1-9ad00dcc3125",
                                                "sense_id": "b4276bc7-4515-344e-b73c-91d9117a05d8",
                                                "text": "Titulní bordura s motivem rostlinných úponků s květy chrpy a vlčího máku na částečně šrafovaném pozadí, vlevo dole a vpravo nahoře pták"
                                            }
                                        ]
