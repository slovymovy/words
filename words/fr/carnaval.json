            "senses": [
                {
                    "sense_id": "6765a30a-fe3d-3840-a77e-664e7ca5b033",
                    "sense_definition": "Période de réjouissances et fête populaire accompagnée de déguisements, de masques et de défilés, traditionnellement célébrée avant le carême.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque année, les enfants se déguisent avec enthousiasme pour célébrer le <w>carnaval</w> de l'école."
                        },
                        {
                            "text": "Nous avons réservé des billets pour assister au défilé du célèbre <w>carnaval</w> de la ville."
                        }
                    ],
                    "synonyms": [
                        "mardi gras",
                        "carême-prenant"
                    ],
                    "common_phrases": [
                        "carnaval de Rio",
                        "défilé de carnaval"
                    ]
                },
                {
                    "sense_id": "6bbde0ec-c6f3-32f8-9ce8-892ed7a6db0a",
                    "sense_definition": "Divertissement tumultueux, agitation joyeuse ou fête continuelle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis l'arrivée impromptue des invités, la maison est plongée dans un <w>carnaval</w> continuel."
                        },
                        {
                            "text": "Les voisins se plaignent souvent de ce vacarme qui transforme tout le quartier en un <w>carnaval</w> perpétuel."
                        }
                    ],
                    "common_phrases": [
                        "carnaval continuel"
                    ]
                },
                {
                    "sense_id": "bfff86f6-32e8-340a-b8b3-e2f515ffaa2d",
                    "sense_definition": "Personne habillée d'une façon extravagante, ridicule ou grotesque.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regarde comment il s'est habillé pour la soirée, c'est un vrai <w>carnaval</w> !"
                        },
                        {
                            "text": "Elle refuse de sortir avec ces couleurs bariolées de peur de ressembler à un <w>carnaval</w>."
