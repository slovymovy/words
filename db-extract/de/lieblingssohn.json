                "senses": [
                    {
                        "sense_id": "ce46b549-0693-32b8-89b6-5af8e7f607df",
                        "entry_id": "742c3c15-5c2e-3562-9020-db8a3af1bda5",
                        "glosses": [
                            "Sohn, der von einem Elternteil (oder beiden) ganz besonders gemocht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac256b50-3cea-4dd1-b243-85dca3423e91",
                                "sense_id": "ce46b549-0693-32b8-89b6-5af8e7f607df",
                                "text": "„Er ist ihr Lieblingssohn, Klaus der unerwünschte Bastard.“"
                            },
                            {
                                "example_id": "169bbdea-8c51-4c5d-bd14-01b77e7d14bf",
                                "sense_id": "ce46b549-0693-32b8-89b6-5af8e7f607df",
                                "text": "„Erich, der Lieblingssohn, gerät in schlechte Gesellschaft, wird Kriegsgewinnler, die Lieblingstochter Eva Geliebte eines Verbrechers, der sie auf den Strich schickt und auf jede nur erdenkliche Weise demütigt.“"
                            },
                            {
                                "example_id": "67aee39a-1420-41f4-be42-64b62df44c5b",
                                "sense_id": "ce46b549-0693-32b8-89b6-5af8e7f607df",
                                "text": "„Jochen war, so jedenfalls die Familiengeschichte, der Lieblingssohn seines Vaters und deshalb als Erbe Kukehnens vorgesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
