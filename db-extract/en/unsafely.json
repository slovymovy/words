                                                "sense_id": "75178201-a22f-32f8-9aef-60b0abb1cf6c",
                                                "text": "Денисов опасно сыграл против соперника — жёлтой карточки не последовало"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f24d6a2-e214-30c2-8af0-c3c9aee74e46",
                                        "entry_id": "196ac312-2cc5-354e-aeb2-004906bba91b",
                                        "glosses": [
