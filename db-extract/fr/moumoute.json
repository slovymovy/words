        "fr-extract.jsonl": [
            {
                "entry_id": "03aee379-cbd2-3241-88e5-ca84f6866049",
                "word": "moumoute",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5a473b89-e702-4f22-8455-97de253ed9b9",
                        "entry_id": "03aee379-cbd2-3241-88e5-ca84f6866049",
                        "tags": [
                            "plural"
                        ],
                        "form": "moumoutes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "daa1812a-d245-384c-87c1-f3f2a7082e3e",
                        "entry_id": "03aee379-cbd2-3241-88e5-ca84f6866049",
                        "glosses": [
                            "Perruque, en particulier s'il s’agit d’un modèle pour homme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "84d0b5c8-fe84-4f2c-bcc5-1454000621d5",
                                "sense_id": "daa1812a-d245-384c-87c1-f3f2a7082e3e",
                                "text": "Parfois je mettais une moustache, des lunettes, une moumoute."
                            },
                            {
                                "example_id": "eca5ef9a-1541-4956-a87e-2b076e6b793f",
                                "sense_id": "daa1812a-d245-384c-87c1-f3f2a7082e3e",
                                "text": "La nuit, sans sa moumoute, et ses dents à la main\nElle filerait la colique à Frankenstein"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4dd7a88-6457-3893-a595-a0d7063e26f7",
                        "entry_id": "03aee379-cbd2-3241-88e5-ca84f6866049",
                        "glosses": [
                            "Peau de mouton ou son ersatz."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "45491781-e14f-4d32-aaf2-5cec64e6d680",
                                "sense_id": "f4dd7a88-6457-3893-a595-a0d7063e26f7",
                                "text": "Les uns s’étaient installés sur les larges fauteuils recouverts de moumoute à poil doux, les autres s’étaient assis par terre sur la moquette bleue."
                            },
                            {
                                "example_id": "c9ebf30d-e847-43fa-a339-65af3df094cd",
                                "sense_id": "f4dd7a88-6457-3893-a595-a0d7063e26f7",
                                "text": "Quelqu’un frappe à la porte et un lion entre, avec sa crinière énorme, des bottes pointues, une veste en moumoute et une boucle d’oreille dans le nez, […]."
                            },
                            {
                                "example_id": "cf4ca483-a938-4312-93be-2405e77d96d8",
                                "sense_id": "f4dd7a88-6457-3893-a595-a0d7063e26f7",
                                "text": "J’ai attrapé le tapis en moumoute des cabinets."
                            },
                            {
                                "example_id": "64cdb8a8-22dd-4ca4-ac75-24b4e96b2326",
                                "sense_id": "f4dd7a88-6457-3893-a595-a0d7063e26f7",
                                "text": "Là, vous avez un flash : une R25 avec peinture à paillettes, sièges recouverts de moumoute et sapin désodorisant qui pendouille au rétroviseur. Les Deschiens du monde mécanique !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b89a37c1-c002-31da-b246-52af19f7e500",
                        "entry_id": "03aee379-cbd2-3241-88e5-ca84f6866049",
                        "glosses": [
                            "Nom de chatte."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9d4a555b-6055-4d1c-9e6f-cab510835c15",
                                "sense_id": "b89a37c1-c002-31da-b246-52af19f7e500",
                                "text": "— Norine : Moumoute, ma chatte ! que je viens de trouver sans connaissance !\nLenglumé. La chatte ! un chatricide !"
                            },
                            {
                                "example_id": "dac26579-71eb-4da5-97c8-beaeeeb7ab91",
                                "sense_id": "b89a37c1-c002-31da-b246-52af19f7e500",
                                "text": "Ils lui donnaient les noms les plus délirants, la pétrissaient de caresses […] tout comme j’étais capable de faire moi-même, quand par hasard je l’attrapais, cette moumoutte, dans un coin propice et sans témoins indiscrets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
