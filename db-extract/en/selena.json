                                "target_senses": [
                                    {
                                        "sense_id": "926717af-1370-366d-a323-23aa670ec0a3",
                                        "entry_id": "c91066d2-634e-3f98-b2a8-545cc3d136cd",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b48b8b-f4df-4c0f-a739-185c4c865dc3",
                                                "sense_id": "926717af-1370-366d-a323-23aa670ec0a3",
                                                "text": "Ce soir à 20 h 30 : Sélène Saint-Aimé (1 h) ; à 22 h : Bachar Mar-Khalifé (1 h 30)."
                                            },
                                            {
                                                "example_id": "13cedec8-6cb0-4acb-9650-54a1d196707a",
                                                "sense_id": "926717af-1370-366d-a323-23aa670ec0a3",
                                                "text": "Chargé de mission pour des campagnes publicitaires, responsable d'animation, créateur de bandes-son et de spectacles (pour des salons, ou des congrès), il enseigne des langues à travers ses chansons. Il travaille en équipe avec sa fille Sélène. … Pierre et Sélène ont déjà travaillé, entre autres, pour la Foire internationale de Bordeaux, le Conseil général de la Dordogne, la Ville de Boulazac, Ecorismo (le Salon de l'environnement et du développement durable pour le tourisme), et la Communauté de communes de la vallée de la Vézère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45f6dee9-831d-451c-87ed-fbcfe8f7e98b",
