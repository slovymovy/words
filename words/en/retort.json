{
    "word_family": [
        "retortable",
        "retorter",
        "retortion"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40ce7274-7c5b-3cd0-bfc5-a1d7c64d88e7",
                    "sense_definition": "to say something sharp, witty, or angry in answer to a remark or accusation",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When he was accused of being lazy, he quickly <w>retorted</w> that he had finished all his work early.",
                            "target_lang_translations": {
                                "ru": "Когда его обвинили в лени, он быстро <w>парировал</w>, что закончил всю работу раньше срока."
                            }
                        },
                        {
                            "text": "She managed to <w>retort</w> with a clever remark that silenced her critics immediately.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>ответить</w> остроумным замечанием, которое сразу заставило критиков замолчать."
                            }
                        }
                    ],
                    "synonyms": [
                        "rejoinder"
                    ],
                    "common_phrases": [
                        "quickly retort",
                        "retort with a smile",
                        "sharply retort"
                    ],
                    "target_lang_definitions": {
                        "ru": "сказать что-то резкое, остроумное или сердитое в ответ на замечание или обвинение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "отражать нападки или доводы в споре"
                            },
                            {
                                "target_lang_word": "отбрить",
                                "target_lang_sense_clarification": "резко и грубо ответить"
                            },
                            {
                                "target_lang_word": "возразить",
                                "target_lang_sense_clarification": "ответить несогласием"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2bc8bb0-d70a-369e-a9a9-df443b10d26c",
                    "sense_definition": "to return an argument or accusation back onto the person who first made it",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verbal response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer attempted to <w>retort</w> the charge of negligence against the plaintiff instead.",
                            "target_lang_translations": {
                                "ru": "Адвокат попытался <w>обратить</w> обвинение в халатности против самого истца."
                            }
                        },
                        {
                            "text": "It is a common tactic to <w>retort</w> the argument by pointing out the speaker's own inconsistencies.",
                            "target_lang_translations": {
                                "ru": "Это обычная тактика — <w>опровергнуть</w> аргумент, указав на противоречия самого говорящего."
                            }
                        }
                    ],
                    "common_phrases": [
                        "retort the charge",
                        "retort the argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "вернуть аргумент или обвинение тому, кто его выдвинул"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обратить против",
                                "target_lang_sense_clarification": "использовать аргумент оппонента против него самого"
                            },
                            {
                                "target_lang_word": "парировать",
                                "target_lang_sense_clarification": "отразить обвинение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52608053-0259-3665-aedb-094863994256",
                    "sense_definition": "to heat or treat a substance in a specialized industrial or laboratory vessel",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemical processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician had to <w>retort</w> the shale samples to extract the oil trapped inside.",
                            "target_lang_translations": {
                                "ru": "Технику пришлось <w>перегонять</w> образцы сланца, чтобы извлечь содержащуюся в них нефть."
                            }
                        },
                        {
                            "text": "In the old factory, they would <w>retort</w> the coal to produce gas for the city.",
                            "target_lang_translations": {
                                "ru": "На старом заводе уголь <w>прокаливали</w> в ретортах для получения газа для города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "нагревать или обрабатывать вещество в специальном промышленном или лабораторном сосуде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегонять",
                                "target_lang_sense_clarification": "подвергать дистилляции в реторте"
                            },
                            {
                                "target_lang_word": "прокаливать",
                                "target_lang_sense_clarification": "нагревать при высокой температуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1165e809-d855-3c86-8aff-c21ef62dbbd5",
                    "sense_definition": "to bend or curve something backward",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swan would <w>retort</w> its neck to reach the feathers on its back.",
                            "target_lang_translations": {
                                "ru": "Лебедь <w>выгибал</w> шею, чтобы дотянуться до перьев на спине."
                            }
                        },
                        {
                            "text": "The artist chose to <w>retort</w> the lines of the sculpture to create a sense of tension.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>изогнуть</w> линии скульптуры, чтобы создать ощущение напряжения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сгибать или изгибать что-либо назад"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгибать",
                                "target_lang_sense_clarification": "изгибать в обратную сторону"
                            },
                            {
                                "target_lang_word": "загибать",
                                "target_lang_sense_clarification": "отклонять назад"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd559a11-c01b-322a-92d0-085e02326008",
                    "sense_definition": "a quick, sharp, or witty reply that turns an argument back against someone",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verbal response",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His clever <w>retort</w> made everyone in the room laugh at the bully's expense.",
                            "target_lang_translations": {
                                "ru": "Его остроумное <w>парирование</w> заставило всех в комнате посмеяться над задирой."
                            }
                        },
                        {
                            "text": "She had a ready <w>retort</w> for every criticism her boss threw at her.",
                            "target_lang_translations": {
                                "ru": "У неё был готов <w>ответ</w> на любое критическое замечание начальника."
                            }
                        }
                    ],
                    "synonyms": [
                        "comeback",
                        "rejoinder",
                        "back answer"
                    ],
                    "common_phrases": [
                        "ready retort",
                        "witty retort",
                        "sharp retort"
                    ],
                    "target_lang_definitions": {
                        "ru": "быстрый, резкий или остроумный ответ, который обращает аргумент против собеседника"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "парирование",
                                "target_lang_sense_clarification": "остроумный ответный выпад"
                            },
                            {
                                "target_lang_word": "реплика",
                                "target_lang_sense_clarification": "острое возражение"
                            },
                            {
                                "target_lang_word": "отповедь",
                                "target_lang_sense_clarification": "решительный и резкий ответ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8be0a113-b4ef-3db6-95a9-9822b4f3dd4a",
                    "sense_definition": "a glass flask with a long downward-pointing neck used for distillation in a laboratory",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "laboratory equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist carefully poured the liquid into the <w>retort</w> before starting the experiment.",
                            "target_lang_translations": {
                                "ru": "Химик осторожно налил жидкость в <w>реторту</w> перед началом эксперимента."
                            }
                        },
                        {
                            "text": "Vapors traveled through the long neck of the <w>retort</w> and condensed into the beaker.",
                            "target_lang_translations": {
                                "ru": "Пары проходили через длинное горлышко <w>реторты</w> и конденсировались в стакане."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glass retort",
                        "distillation retort"
                    ],
                    "target_lang_definitions": {
                        "ru": "стеклянная колба с длинным, направленным вниз горлышком, используемая для дистилляции в лаборатории"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реторта",
                                "target_lang_sense_clarification": "лабораторный сосуд для перегонки"
                            },
                            {
                                "target_lang_word": "колба",
                                "target_lang_sense_clarification": "стеклянный химический сосуд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86940d79-253c-33fd-9e57-c0ff054c3cd5",
                    "sense_definition": "an airtight industrial vessel used for heating materials at high temperatures, such as for smelting metal",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industrial equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The iron was placed inside a massive steel <w>retort</w> to be heated until it melted.",
                            "target_lang_translations": {
                                "ru": "Железо поместили в массивную стальную <w>реторту</w> для нагрева до полного расплавления."
                            }
                        },
                        {
                            "text": "Workers monitored the pressure inside the industrial <w>retort</w> during the chemical process.",
                            "target_lang_translations": {
                                "ru": "Рабочие следили за давлением внутри промышленной <w>реторты</w> во время химического процесса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "industrial retort",
                        "smelting retort"
                    ],
                    "target_lang_definitions": {
                        "ru": "герметичный промышленный сосуд, используемый для нагрева материалов при высоких температурах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реторта",
                                "target_lang_sense_clarification": "промышленная установка для термической обработки"
                            },
                            {
                                "target_lang_word": "автоклав",
                                "target_lang_sense_clarification": "аппарат для нагрева под давлением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}