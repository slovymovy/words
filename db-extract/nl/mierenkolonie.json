                        "examples": [
                            {
                                "example_id": "3576b1c9-8498-4e76-87b5-ed0eaff79ad1",
                                "sense_id": "5158c752-a794-3e57-91d3-2fb5af7c7b75",
                                "text": "De vele mensen die langs de weg liepen, leken net een lange, gloeiende mierenkolonie in de nacht."
                            },
                            {
                                "example_id": "23ea7c2b-6d70-42dd-a19b-c4688d9c85be",
                                "sense_id": "5158c752-a794-3e57-91d3-2fb5af7c7b75",
                                "text": "Dus wat momenteel in onze steden gebeurt lijkt wellicht op wat zich miljoenen jaren geleden voltrok toen kleine bodemdiertjes het evolutionaire lef hadden om de eerste mierenkolonies binnen te dringen."
                            },
                            {
                                "example_id": "a0eafae3-dcd5-4bca-84c9-2d8831e2a6f9",
                                "sense_id": "5158c752-a794-3e57-91d3-2fb5af7c7b75",
                                "text": "Daarnaast bezorgt het schip ruim 1300 kilo aan voedsel en materiaal voor verschillende experimenten, waaronder 28 kleine satellieten en een mierenkolonie."
                            }
                        ]
                    }
