                                    {
                                        "sense_id": "ae4df402-3be0-3f2e-a7d0-2d93051d0a73",
                                        "entry_id": "5cf22129-b0f7-3278-8a6d-80e79e111be5",
                                        "glosses": [
                                            "The point of a pin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0d21446-7fd0-359e-989a-80e429fe5e2f",
                                        "entry_id": "5cf22129-b0f7-3278-8a6d-80e79e111be5",
                                        "glosses": [
                                            "Something infinitesimal; a tiny point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d831fc-3520-4b60-8d72-7d07134cc89c",
                                                "sense_id": "b0d21446-7fd0-359e-989a-80e429fe5e2f",
                                                "text": "What was once an astonishing, one-off discovery in 2005 may prove to be just a pinpoint in a global distribution of animals of which we previously knew nothing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8810eb9f-df64-3fb0-abfb-d0b87ceb994d",
                                        "entry_id": "647092ed-c080-3079-91ec-6c5dbe19219a",
                                        "glosses": [
                                            "Extremely precise or specific, especially regarding location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56ecb931-3a26-435a-aae3-46f473378154",
                                                "sense_id": "8810eb9f-df64-3fb0-abfb-d0b87ceb994d",
                                                "text": "The machine assembles parts at high speed and with pinpoint accuracy."
                                            },
                                            {
                                                "example_id": "583132f5-137d-4542-85b0-5d148b434116",
                                                "sense_id": "8810eb9f-df64-3fb0-abfb-d0b87ceb994d",
                                                "text": "The 28-year-old not only hassled the visitors' midfield but also delivered pinpoint balls with alarming accuracy as far as the east Londoners were concerned."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04c7af0a-7a4c-3173-9c2a-e5a448dfa1dc",
                                        "entry_id": "c0697c3c-ea85-3d04-b43f-dc16f281d61a",
                                        "glosses": [
                                            "To identify or locate (someone or something) precisely or with great accuracy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c94de7-8570-4a82-a381-d8ca883fa5ab",
                                                "sense_id": "04c7af0a-7a4c-3173-9c2a-e5a448dfa1dc",
                                                "text": "The investigators tried to pinpoint the source of the flames."
                                            },
                                            {
                                                "example_id": "17da3093-264f-4a69-9a81-ee09cc67c6d1",
                                                "sense_id": "04c7af0a-7a4c-3173-9c2a-e5a448dfa1dc",
                                                "text": "It would defeat the purpose of secret surveillance if individuals were able to pinpoint exactly when the police were likely to be listening in on their conversations and adapt their behaviour accordingly, and the [European] Court [of Human Rights] has not interpreted Article 8 to require that this information should be provided to individuals, either before, during, or after they have been the subject of surveillance measures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
