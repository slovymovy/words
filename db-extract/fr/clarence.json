                                        "sense_id": "c6aaabe8-76a1-39f3-9b0f-c9e15a18ff4b",
                                        "entry_id": "de5da933-7696-34c6-af7d-b4926854b568",
                                        "glosses": [
                                            "A ducal title which has been traditionally awarded to junior members of the English and British royal families"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a58869-c081-419c-856e-38e75c21d848",
                                                "sense_id": "c6aaabe8-76a1-39f3-9b0f-c9e15a18ff4b",
                                                "text": "Warwick. Richard, I will create thee Duke of Gloucester;\nAnd George, of Clarence; Warwick, as ourself,\nShall do and undo as him pleaseth best.\nRichard. Let me be Duke of Clarence, George of Gloucester,\nFor Gloucester's dukedom is too ominous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdf39a2e-15bf-3a23-b0e3-c15fa2d4579d",
                                        "entry_id": "de5da933-7696-34c6-af7d-b4926854b568",
                                        "glosses": [
                                            "An English surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e1e8c5a-57dc-357b-a1e1-3e16f6e9293a",
                                        "entry_id": "de5da933-7696-34c6-af7d-b4926854b568",
                                        "glosses": [
                                            "A male given name transferred from the surname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "140ad376-03d5-44fd-b036-55abfa7f0078",
                                                "sense_id": "8e1e8c5a-57dc-357b-a1e1-3e16f6e9293a",
                                                "text": "There is one of the novels of Miss Edgeworth - we forget which - in which a gentleman of the name of Harvey figures as a hero. Harvey! Only fancy John, Peter, or William Harvey as the hero of a novel! But Miss Edgeworth was too well acquaintanced with the philosophy of names to commit such a blunder: she made the individual Clarence Harvey, and the name has never to this day been objected to even among the female teens."
                                            },
                                            {
                                                "example_id": "21dddc5c-0dca-4d5c-b5ff-15260cd49d07",
                                                "sense_id": "8e1e8c5a-57dc-357b-a1e1-3e16f6e9293a",
                                                "text": "Got rather a silly name. Like a hotel. You know, the Royal Clarence. That's his name. Clarence.\""
                                            }
                                        ]
