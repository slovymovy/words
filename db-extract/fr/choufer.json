                ],
                "senses": [
                    {
                        "sense_id": "e8f9bce0-a30a-3d65-81db-6210f5e4baf6",
                        "entry_id": "69d22397-c990-3abe-b403-d4fde389781f",
                        "glosses": [
                            "Regarder."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "787f937a-8703-46cf-b0b6-aebf75e6afc6",
                                "sense_id": "e8f9bce0-a30a-3d65-81db-6210f5e4baf6",
                                "text": "Accroche-moi dans ta chambre que j’puisse choufer ton corps digne de Rubens !"
                            },
                            {
                                "example_id": "8dfcbe37-9b5d-40a1-a297-04bea3ab9338",
                                "sense_id": "e8f9bce0-a30a-3d65-81db-6210f5e4baf6",
                                "text": "Il n'y aura qu’à les choufer encore un peu pour déceler, à partir des points d’éclatement des convois et des amorces de crapahutage, leur idée de manœuvre."
                            },
                            {
                                "example_id": "faf3ea65-87f1-4458-be81-f2084ae32e45",
                                "sense_id": "e8f9bce0-a30a-3d65-81db-6210f5e4baf6",
                                "text": "— Putain de ma race, j'aurais mieux fait d'aller au trou. Là-bas, au moins, on te choufe que trois fois par jour, alors qu'ici, chiennerie, j’peux même pas me taper un petit gars à la bataille..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc39a7de-11d3-4d17-9adc-3f7a3f1258d6",
                        "source_entry_id": "69d22397-c990-3abe-b403-d4fde389781f",
                        "source_sense_id": "e8f9bce0-a30a-3d65-81db-6210f5e4baf6",
                        "target_lang_word": "get a load of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get a load of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb890709-16ce-3297-b98c-c81e1c8f1692",
                                        "entry_id": "6bb0ed49-768b-3abd-9aea-112ed9afb317",
                                        "glosses": [
                                            "To experience someone or something, especially by looking or listening."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d2efcc3-ecba-4547-993d-89d1390e206e",
                                                "sense_id": "bb890709-16ce-3297-b98c-c81e1c8f1692",
                                                "text": "One night Bernette happened to get a load of Peggy doing a rumba with Jackie."
                                            },
                                            {
                                                "example_id": "334223d4-6fac-4b24-8a54-2e4c30b93317",
                                                "sense_id": "bb890709-16ce-3297-b98c-c81e1c8f1692",
                                                "text": "Get a load of the \"eyesome femininity\" at the International Casino, as the Times put it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
