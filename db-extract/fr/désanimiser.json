                "senses": [
                    {
                        "sense_id": "61a28f73-e91c-3e89-b997-872b34dc02fe",
                        "entry_id": "ac76bba8-63c7-30b7-8f77-d263b0f19970",
                        "glosses": [
                            "Faire perdre son caractère animiste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10a15d13-92fe-4bc5-9cce-32fd52699837",
                                "sense_id": "61a28f73-e91c-3e89-b997-872b34dc02fe",
                                "text": "Cette nouvelle théorie, à son tour, tend à rendre compte, à désanimiser une partie de la pratique, à réfléchir autrement ses enjeux et principes."
                            },
                            {
                                "example_id": "e812267b-0a41-48b4-beb3-1d9422046f1b",
                                "sense_id": "61a28f73-e91c-3e89-b997-872b34dc02fe",
                                "text": "Il existait donc, à l’époque hellénistique, une certaine tendance à « désanimiser » la vie (du moins sa partie purement végétative - dans les cas cités, celle des plantes et de l’embryon), et cela au profit d’une « nature » propre aux êtres vivants."
                            }
                        ]
                    }
                ],
