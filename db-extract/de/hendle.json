                ],
                "senses": [
                    {
                        "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                        "entry_id": "72b7afb2-7d99-3b89-9809-049b28924ff1",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d5072e-6348-4d3f-b9f1-563166018580",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Frau Hendle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0d0e4187-dec1-40a2-91dd-39406b213fa7",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Herr Hendle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c0e9ecb2-c0f6-4289-a0ab-3602253ea541",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Die Hendles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "0335c841-fa4a-4bf3-8695-065d599ef1ea",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Der Hendle trägt nie die Schals, die die Hendle ihm strickt."
                            },
                            {
                                "example_id": "fcdee920-1734-45e6-8ef4-675f854b0717",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hendle kommt, geht der Herr Hendle.“"
                            },
                            {
                                "example_id": "e9b2b64a-57d9-428e-b396-de64af045275",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Hendle kommt und geht."
                            },
                            {
                                "example_id": "7928709a-5aad-4ff9-be68-e35ac4de63c9",
                                "sense_id": "814980bc-0a4b-340e-9120-8a2211db6f6e",
                                "text": "Hendles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
