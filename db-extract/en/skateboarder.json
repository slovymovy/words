                                        "entry_id": "bd43bb9b-2f93-37d0-89ac-3c024d3bd84d",
                                        "glosses": [
                                            "Celui qui se livre à l’exercice du skateboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a20d351b-2fa2-44f1-9acb-30b0e6851553",
                                                "sense_id": "89ea2f72-d078-34ae-9b39-af142d680905",
                                                "text": "Surfeur et skateboardeur invétéré, Wendell travaillait uniquement pour financer sa passion de la glisse mais, malgré sa tignasse désordonnée et sa dégaine à la coule, il était brillant, pointilleux et avait un don pour les chiffres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d973448-9405-4134-ac4c-586cb69e19eb",
                        "source_entry_id": "942f55b8-6f52-3965-8d4c-4e34ddf32e57",
                        "source_sense_id": "b9e9da7c-4d9f-38ee-9c4d-1e95237f9a41",
                        "source_sense_description": "someone who skateboards",
