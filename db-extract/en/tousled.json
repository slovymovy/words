                        "target_lang_word": "zerzaust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerzaust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f6fdf46-cacc-3d6d-ba5b-8073517748fd",
                                        "entry_id": "5c1eb8eb-e0bc-30e7-b4f7-11aadfdab64e",
                                        "glosses": [
                                            "meist in Bezug auf Haare oder Gefieder: unordentlich, kreuz und quer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a133bcbd-6036-40ae-8686-017968166a7e",
                                                "sense_id": "5f6fdf46-cacc-3d6d-ba5b-8073517748fd",
                                                "text": "„Im Büro ist sie sonst immer so ordentlich frisiert, aber heute sehen ihre Haare ziemlich zerzaust und durcheinander aus.“"
                                            },
                                            {
                                                "example_id": "974e13a6-9192-4b24-9f09-8500466d341d",
                                                "sense_id": "5f6fdf46-cacc-3d6d-ba5b-8073517748fd",
                                                "text": "46 Jahre alt ist Carola Thimm heute. Sympathisch zerzaust stehen ihr die blonden Locken in alle Richtungen vom Kopf."
                                            },
                                            {
                                                "example_id": "9547ded8-d5b6-4f12-a9a2-bb16a2b9aa78",
                                                "sense_id": "5f6fdf46-cacc-3d6d-ba5b-8073517748fd",
                                                "text": "Die [von der Varoa-Milbe] angefallenen Bienen sehen zunächst zerzaust aus, ihre Bewegungen sind ungelenk, schließlich trocknen sie aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
