                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste refuse toute <w>exhibition</w> publique de ses œuvres inachevées."
                        },
                        {
                            "text": "Cette <w>exhibition</w> de richesse au milieu de la crise a choqué l'opinion publique."
                        }
                    ],
                    "synonyms": [
