                "senses": [
                    {
                        "sense_id": "9716c47e-ec16-32f6-87d3-c20b65e20c0a",
                        "entry_id": "84b04b30-9165-3434-ad65-489afecc9db1",
                        "glosses": [
                            "не являющийся специфическим"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db27273b-9e93-4334-99d5-02a65cca683e",
                                "sense_id": "9716c47e-ec16-32f6-87d3-c20b65e20c0a",
                                "text": "Одним из самых серьезных вариантов колита является неспецифический язвенный колит — заболевание неизвестной этиологии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05aa324e-3c05-474f-9ba5-56f6950a7503",
                        "source_entry_id": "84b04b30-9165-3434-ad65-489afecc9db1",
                        "source_sense_id": "9716c47e-ec16-32f6-87d3-c20b65e20c0a",
                        "target_lang_word": "unspezifisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unspezifisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4dcd7ef-98f7-32e2-b930-da3aa0e4a3b9",
                                        "entry_id": "ab6db36f-3a0c-3d45-b771-1a31005523a7",
                                        "glosses": [
                                            "nicht ausgeprägt typisch für etwas, nicht eindeutig auf etwas verweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b8bc29-7d45-4a82-8217-2ccbc2cccc46",
                                                "sense_id": "d4dcd7ef-98f7-32e2-b930-da3aa0e4a3b9",
                                                "text": "Neben eindeutigen Anzeichen für eine Erkrankung gibt es auch sehr viel unspezifischere Symptome, wie zum Beispiel eine gesteigerte Müdigkeit."
                                            },
                                            {
                                                "example_id": "dd81c389-7de7-4782-a63a-8690f61a276e",
                                                "sense_id": "d4dcd7ef-98f7-32e2-b930-da3aa0e4a3b9",
                                                "text": "„Das unspezifische Immunsystem ist der Teil des körpereigenen Immunsystems, der von Geburt an vorhanden ist. Die unspezifische Immunantwort setzt ein, sobald der Körper auf Pathogene trifft und umfasst physikalische und chemische Barrieren sowie bestimmte Proteine und Immunzellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
