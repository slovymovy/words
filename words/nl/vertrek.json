                    "semantic_group_id": "room_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verliet het <w>vertrek</w> en begaf zich direct naar het balkon.",
                            "target_lang_translations": {
                                "en": "He left the <w>room</w> and went straight to the balcony.",
                                "ru": "Он покинул <w>помещение</w> и сразу направился на балкон.",
                                "pl": "Opuścił <w>pokój</w> i udał się bezpośrednio na balkon.",
                                "de": "Er verließ das <w>Zimmer</w> und begab sich direkt auf den Balkon.",
                                "fr": "Il quitta la <w>pièce</w> et se dirigea directement vers le balcon.",
                                "it": "Lasciò la <w>stanza</w> e si diresse direttamente al balcone.",
                                "cs": "Opustil <w>místnost</w> a vydal se přímo na balkon.",
                                "tr": "<w>Odayı</w> terk etti ve doğrudan balkona yöneldi.",
                                "es": "Salió de la <w>habitación</w> y se dirigió directamente al balcón."
                            }
                        },
                        {
                            "text": "In het grote <w>vertrek</w> stonden alleen een tafel en twee stoelen.",
                            "target_lang_translations": {
                                "en": "In the large <w>room</w> stood only a table and two chairs.",
                                "ru": "В большой <w>комнате</w> стояли только стол и два стула.",
                                "pl": "W dużym <w>pomieszczeniu</w> stały tylko stół i dwa krzesła.",
                                "de": "In dem großen <w>Raum</w> standen nur ein Tisch und zwei Stühle.",
                                "fr": "Dans la grande <w>pièce</w>, il n'y avait qu'une table et deux chaises.",
                                "it": "Nella grande <w>stanza</w> c'erano solo un tavolo e due sedie.",
                                "cs": "Ve velké <w>místnosti</w> stál pouze stůl a dvě židle.",
                                "tr": "Büyük <w>odada</w> sadece bir masa ve iki sandalye vardı.",
                                "es": "En el gran <w>cuarto</w> solo había una mesa y dos sillas."
                            }
                        }
