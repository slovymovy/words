                ],
                "senses": [
                    {
                        "sense_id": "844b445d-e10a-359f-9bcb-19dfc1e5f76f",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Action de fouler ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6449b5-de14-4e27-8303-9daf80e4b7cd",
                                "sense_id": "844b445d-e10a-359f-9bcb-19dfc1e5f76f",
                                "text": "Le foulage des cuirs. Le foulage du grain."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c95351f-336b-3021-89ae-6fefd40d4152",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Action de fouler ou résultat de cette action.",
                            "Opération mécanique pour feutrer les laines."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f6570971-1f81-4a02-97e5-cc979b579800",
                                "sense_id": "0c95351f-336b-3021-89ae-6fefd40d4152",
                                "text": "Il se peut en effet, que le frottement du fil dans le bobinot et le curseur énerve la fibre et que le foulage en soit rendu plus difficile."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e32ec0d-76d1-368c-97ff-dd50aebea0ad",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Piétinement, dans un fouloir, des raisins pour en extraire le jus."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef65fe6-8064-40cd-a83b-a3ef9aef7aae",
                                "sense_id": "2e32ec0d-76d1-368c-97ff-dd50aebea0ad",
                                "text": "Le marc de raisin résidu du foulage peut encore servir à la fabrication du vin. On l'exprime à l'aide d'une presse et le liquide que l'on obtient est souvent mélangé avec celui qui s'est écoulé spontanément."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1576072-b161-3858-aa1d-4c2b719ba478",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Piétinement, dans un fouloir, des raisins pour en extraire le jus.",
                            "Pour la préparation des vins rouges, éclatement des raisins pour intensifier la coloration du moût avant le pressurage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ea686c83-99e0-3b8e-84c6-98fd4cee22c5",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Action de tasser le sol après semis par piétinement, marchage."
                        ],
                        "tags": [
                            "dated",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "0cce98fc-a5c9-4e53-a522-0f550ee5d09c",
                                "sense_id": "ea686c83-99e0-3b8e-84c6-98fd4cee22c5",
                                "text": "Le piétinement des planches par un ouvrier, qui marche à petits pas serrés et courts, est une opération très usitée en jardinage pour opérer le tassement des sols ensemencés, on leur donne le nom de foulage ou de marchage."
                            }
                        ]
                    },
                    {
                        "sense_id": "c131b9ca-f852-37af-9bf6-cfd52e2fc1c8",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Action d'une presse ou du cylindre d'une rotative sur une feuille de papier pour en assurer l'impression."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b492dbf8-3b69-4e09-b029-bf56d8edeb7e",
                                "sense_id": "c131b9ca-f852-37af-9bf6-cfd52e2fc1c8",
                                "text": "La régularité du foulage contribue à la beauté de l’impression."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9893aba-946e-347d-a638-fd0ec53c50a2",
                        "entry_id": "fb6c9292-70d3-311f-9afc-9619b85c717a",
                        "glosses": [
                            "Empreinte en relief, laissée par exemple sur les pages d’un carnet après avoir écrit sur la première page."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
