                                        "entry_id": "35c7a527-120f-3e86-bdf0-3504d7ad7890",
                                        "glosses": [
                                            "Opération de chirurgie, esthétique, plastique ou reconstructrice qui consiste au remodelage ou à la reconstruction de la paupière et/ou de la zone péri-palpébrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "482adb3d-bfe7-4daf-a005-e9e7b95c5899",
                                                "sense_id": "d6285d4c-6a66-3c51-aeca-42e82a86a3e8",
                                                "text": "La blépharoplastie est une opération permettant de réduire les paupières supérieures et les poches des paupières inférieures pour donner un aspect « rajeuni »."
                                            },
                                            {
                                                "example_id": "911b0d64-cce6-4421-9ef1-5dcb1ef91237",
                                                "sense_id": "d6285d4c-6a66-3c51-aeca-42e82a86a3e8",
                                                "text": "La semaine prochaine on part à Palm Desert pour un lifting du front, une réduction nasale, une blépharoplastie, une lipoaspiration des joues, une augmentation mammaire, une plastie abdominale, une liposuccion des cuisses et des mollets…"
                                            }
                                        ]
                                    }
