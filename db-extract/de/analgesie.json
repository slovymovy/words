                                                "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
                                                "text": "She was able to take analgesia orally."
                                            },
                                            {
                                                "example_id": "6b5a14dd-6280-4638-bcd5-ba9fb6da0251",
                                                "sense_id": "ecf8643e-5a69-37f5-9f84-e192a5b29412",
