                "senses": [
                    {
                        "sense_id": "8a6dbe88-61ff-3a27-ad7a-f3917362dfde",
                        "entry_id": "3a60fdba-72eb-3c56-975f-d24bc1234bc8",
                        "glosses": [
                            "das Herstellen von Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd2f23b-0d95-44db-b0d8-a51630a4dee4",
                                "sense_id": "8a6dbe88-61ff-3a27-ad7a-f3917362dfde",
                                "text": "„Vor 600 Jahren begann in Deutschland die Papierherstellung - der Rohstoff war begehrt wie Drogen.“"
                            },
                            {
                                "example_id": "7f2e8e0d-d11f-4dbe-b330-78713fe7647d",
                                "sense_id": "8a6dbe88-61ff-3a27-ad7a-f3917362dfde",
                                "text": "„Herrn Séchard geht's recht gut, es heißt sogar, daß er Millionen hätte haben können, wenn er sich nicht eine Erfindung hätte stehlen lassen, die er in der Papierherstellung gemacht hat, und die jetzt von den Brüdern Cointet ausgebeutet wird …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
