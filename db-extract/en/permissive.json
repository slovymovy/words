                        "sense_id": "4d9131fd-ff0c-3351-b379-d9b6c07f37e1",
                        "entry_id": "051d227d-df10-3dc8-b739-3f4c71ac16eb",
                        "glosses": [
                            "Open to the public by permission of the landowner."
                        ],
                        "tags": [
                            "of a footpath"
                        ],
                        "examples": []
