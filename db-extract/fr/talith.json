                    {
                        "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                        "entry_id": "cca097c1-ef66-3ecf-ae72-d904957b0285",
                        "glosses": [
                            "Châle de prière, dans la culture judaïque."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "f813bee0-9c8b-4e10-9a55-13984782ae74",
                                "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                                "text": "Le fait que toute personne, pour prier, s’enveloppe d’un talith contribue à accentuer l’idée que nous sommes tous égaux devant Dieu."
                            },
                            {
                                "example_id": "791f24f7-b79e-4749-9ed3-5bb137fa6d72",
                                "sense_id": "ab487a2d-317b-3021-9047-7d3e1ca6dda6",
                                "text": "C’est pourquoi le châle de prière, le talith, est garni de franges."
                            }
                        ]
                    }
                ],
