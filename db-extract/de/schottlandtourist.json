                "senses": [
                    {
                        "sense_id": "3ac2e844-6e9b-3f27-898b-bce41c3e2d64",
                        "entry_id": "9041265a-c00f-3303-8fd4-9ad2280d987e",
                        "glosses": [
                            "Person, die zu ihrem Vergnügen nach Schottland reist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e988b869-c264-4d06-a47d-f483c7cbed68",
                                "sense_id": "3ac2e844-6e9b-3f27-898b-bce41c3e2d64",
                                "text": "„Das Dorf ist für Schottlandtouristen sowohl mit dem Auto über die Panoramastraße Road to the Isles als auch mit den Zügen der West Highland Line von Fort William aus einfach zu erreichen.“"
                            },
                            {
                                "example_id": "60505ee1-a2dd-4112-a66e-f6f66368d2c3",
                                "sense_id": "3ac2e844-6e9b-3f27-898b-bce41c3e2d64",
                                "text": "„Scotts Werke finden reißenden Absatz und lassen eine erste Welle von Schottlandtouristen zu den Lochs, Glens und Abbeys pilgern, die ihr Autor so mitreißend zu schildern weiß.“"
                            },
                            {
                                "example_id": "38ea0913-492d-413e-9b17-5369142a53a3",
                                "sense_id": "3ac2e844-6e9b-3f27-898b-bce41c3e2d64",
                                "text": "„Vielen Schottlandtouristen fällt schon kurz nach Ankunft im Norden Großbritanniens das stark regional geprägte Englisch auf.“"
                            },
                            {
                                "example_id": "b678d0d0-85d2-4fae-896d-eb0e9ab59316",
                                "sense_id": "3ac2e844-6e9b-3f27-898b-bce41c3e2d64",
                                "text": "„Der durch folkloristische Massenaufmärsche von Dudelsackbläsern verwöhnte moderne Schottlandtourist muß hier berücksichtigen, daß ursprünglich eine wichtige Aufgabe des Dudelsackblasens darin bestand, bei kriegerischen Auseinandersetzungen die – meist englischen – Feinde psychologisch einzuschüchtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
