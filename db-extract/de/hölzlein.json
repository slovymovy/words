                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52046942-2e14-48c2-a666-faa20e6e936e",
                                "sense_id": "74013c29-aa1b-35bf-ad9a-d5309d3e8039",
                                "text": "Herr Hölzlein ist als Kaninchenzüchter erfolgreich."
                            },
                            {
                                "example_id": "8c01df71-8078-4d6d-9226-0b956ef51b9c",
                                "sense_id": "74013c29-aa1b-35bf-ad9a-d5309d3e8039",
                                "text": "Herr Hölzlein heiratet im September auf Hawaii."
                            },
                            {
                                "example_id": "a28cf620-704f-47a0-a5f3-73b88899ba8a",
                                "sense_id": "74013c29-aa1b-35bf-ad9a-d5309d3e8039",
                                "text": "Frau Hölzlein liebt es, an Weihnachten Plätzchen zu backen."
                            },
                            {
                                "example_id": "79f313fe-aba5-43ad-b464-e15e923b4cb6",
                                "sense_id": "74013c29-aa1b-35bf-ad9a-d5309d3e8039",
                                "text": "Die Hölzleins lieben die Natur und die Tiere."
                            },
                            {
                                "example_id": "da194c91-2ecf-4c4c-8c74-b183f9bbff87",
                                "sense_id": "74013c29-aa1b-35bf-ad9a-d5309d3e8039",
                                "text": "„So etwas hat Manfred Hölzlein noch nicht erlebt.“"
                            }
                        ],
