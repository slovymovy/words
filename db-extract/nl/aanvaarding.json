                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "the acceptance of a gift, office, doctrine, etc."
                                            },
                                            {
                                                "example_id": "6b323343-5e92-4142-bf8b-4e3ed98b6375",
                                                "sense_id": "1bcc075f-13c9-361e-a1b0-6bb12ac041c2",
                                                "text": "All the flockes of Kedar shall be gathered together vnto thee, the rams of Nebaioth shall minister vnto thee: they shall come vp with acceptance on mine altar, and I wil glorifie the house of my glory."
                                            }
