                "senses": [
                    {
                        "sense_id": "05acd85a-5ebf-3530-baca-e38133295217",
                        "entry_id": "7c7f2f40-bfa5-33cf-9079-c3fb7e2dc9c0",
                        "glosses": [
                            "Rendre la surface d’un mur plus régulière en le frottant avec une éponge mouillée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feed8231-5ff3-45d1-9be9-1eedfb49a47e",
                                "sense_id": "05acd85a-5ebf-3530-baca-e38133295217",
                                "text": "Mais ce qui faisait face à la ville était blanchi à la chaux, même frottassé à l'italienne avec assez de coquetterie et comportait, au-dessus de larges portes, un fronton où, sur deux mètres de haut et dix mètres de long, un artiste provençal avait modelé en bas-relief une Charité réjouissant le monde."
                            },
                            {
                                "example_id": "0dadebea-aa6b-4d8e-8b0f-ef5879541d3a",
                                "sense_id": "05acd85a-5ebf-3530-baca-e38133295217",
                                "text": "Pour frottasser, mouillez une éponge et frottez-la sur l’enduit en faisant des mouvements circulaires de faible amplitude."
                            }
                        ]
                    }
                ],
