                "senses": [
                    {
                        "sense_id": "605536e4-3604-34d0-9ecd-58ef689dcdb5",
                        "entry_id": "a71d14d2-0141-3046-b661-cc93491c980c",
                        "glosses": [
                            "Considérer d’un point de vue pédopsychiatrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b6d0f03-e646-4255-ab00-311e27e46508",
                                "sense_id": "605536e4-3604-34d0-9ecd-58ef689dcdb5",
                                "text": "La prévention a frappé, mise en sourdine du rêve : l’institutionnel intervient, conseille, forme, modèle, corrige, surveille, soigne, c’est-à-dire psychologise, psychiatrise ou plus exactement « pédopsychiatrise » ce cher bambin."
                            },
                            {
                                "example_id": "39c5c49b-2353-4291-b968-d57b2ed83ff9",
                                "sense_id": "605536e4-3604-34d0-9ecd-58ef689dcdb5",
                                "text": "Je fais partie de la génération où les parents ont tous divorcé, résultat on a grandi alterné, pédopsychiatrisé, abandonné ou surprotégé, et en fait on est tous devenu insécures, carapacés et carapateurs!"
                            }
                        ]
                    }
