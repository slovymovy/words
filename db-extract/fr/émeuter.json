                "senses": [
                    {
                        "sense_id": "579b7d8f-d0ce-34ba-a79d-3ae729a53f75",
                        "entry_id": "56d08ec0-1f15-3d24-8354-d988f0ee858b",
                        "glosses": [
                            "Mettre en émeute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1cc0e8a-4130-4716-bf05-c8a5856c4e70",
                                "sense_id": "579b7d8f-d0ce-34ba-a79d-3ae729a53f75",
                                "text": "Les propriétaires de ces dernières excitèrent leurs ouvriers et ceux-ci réussirent à émeuter le bas peuple."
                            },
                            {
                                "example_id": "0d07c165-c4eb-4b8f-8505-626209e61ea0",
                                "sense_id": "579b7d8f-d0ce-34ba-a79d-3ae729a53f75",
                                "text": "Ils lancèrent sur un ton autoritaire, à ce qui leur parut être un chef, que les consignes de paix étaient valables depuis plus de douze heures et qu’ils salissaient le nom de la communauté en continuant d’émeuter."
                            }
                        ]
                    }
