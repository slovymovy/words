                        "source_sense_id": "2400200d-b77b-3cf9-a7a7-54dcb0973b49",
                        "source_sense_description": "regional (Kanada), umgangssprachlich: sehr gut, perfekt, alles paletti",
                        "target_lang_word": "perfekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                        "entry_id": "ce8f43d2-d170-3b6b-921c-3ca9b34bb046",
                                        "glosses": [
                                            "sehr gelungen, nicht verbesserbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a62d3d0-2ae0-4e3e-93d2-a8bec01d30ae",
                                                "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                                "text": "Sein Lauf war perfekt. (Er hätte nicht besser laufen können.)"
                                            },
                                            {
                                                "example_id": "0b321e52-4d6c-4123-a860-8caae027c499",
                                                "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                                "text": "„Er war so perfekt wie aus dem Mund einer Germanistin.“"
                                            },
                                            {
                                                "example_id": "bb9d972a-5599-4628-9a9d-c8b94eb1335c",
                                                "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                                "text": "Seine Aussprache des Englischen ist perfekt. (Es gibt daran nichts zu korrigieren)"
                                            },
                                            {
                                                "example_id": "f12734bf-dadf-4b68-98e6-066c860544e7",
                                                "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                                "text": "Das ist ein perfekter Plan. Er kann nicht schiefgehen!"
                                            },
                                            {
                                                "example_id": "29a48f9c-b4d2-428b-831a-fa3d7e6975c6",
                                                "sense_id": "e029e1bf-26e0-3af7-baea-6f40c7fe21dc",
                                                "text": "[…] „mit den richtigen Tricks gelingt auch das perfekte Foto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bce01997-47bf-32e0-b1be-fe4516a935f1",
                                        "entry_id": "ce8f43d2-d170-3b6b-921c-3ca9b34bb046",
                                        "glosses": [
                                            "zum Abschluss gebracht, geschehen"
                                        ],
                                        "tags": [
                                            "prädikativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea275cb5-2a3c-4cec-bb3b-6a4c9bf137df",
                                                "sense_id": "bce01997-47bf-32e0-b1be-fe4516a935f1",
                                                "text": "Nach langen Verhandlungen sind die Vertragsabschlüsse endlich perfekt."
                                            },
                                            {
                                                "example_id": "8efd6e19-4f68-4833-8f84-800c49d107a9",
                                                "sense_id": "bce01997-47bf-32e0-b1be-fe4516a935f1",
                                                "text": "„Es war Freitag, der zweiundzwanzigste November 1963, fünfzehn Uhr, und die Katastrophe war perfekt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c0bc935-1c8a-4aee-b897-21e8a9e9e468",
                        "source_entry_id": "777e029d-8c47-38c1-8fda-e589f9dadbca",
