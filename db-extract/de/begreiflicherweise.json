                                    {
                                        "sense_id": "2835df3b-ab40-3c2e-b837-a5696e63a394",
                                        "entry_id": "075da7e6-71d4-3406-aabd-386f882113e0",
                                        "glosses": [
                                            "vyjadřuje souhlas či kladnou odpověď s podtextem vyloučení jiných možností"
                                        ],
