                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19e309f1-ced6-4d68-a181-43babceea692",
                                "sense_id": "75b3ef1c-dd59-3d38-becd-f5d4d809a6c1",
                                "text": "Het RD op handzamer formaat. Maandag was het grote moment daar: de eerste tabloidkrant kwam van de pers."
                            },
                            {
                                "example_id": "955a6fbf-fe8d-4892-8956-b21d6cee6a9d",
                                "sense_id": "75b3ef1c-dd59-3d38-becd-f5d4d809a6c1",
                                "text": "Een tabloidkrant scoort beter op kwaliteit, betrouwbaarheid, is eigentijds, jong en vernieuwend."
                            }
                        ]
                    },
                    {
                        "sense_id": "586d9177-ab92-3a5d-b521-e32698808424",
                        "entry_id": "cad689d7-bdae-3d58-a3e3-7d4fad41ead3",
                        "glosses": [
                            "niet al te serieus te nemen krant"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6d41899b-be6c-4d7b-9152-45a537a71941",
                                "sense_id": "586d9177-ab92-3a5d-b521-e32698808424",
                                "text": "The Sun meldt verder dat de Nederlander furieus is over zijn ontslag. Mourinho staat klaar in de catacomben en heeft zijn oude vriend Van Gaal een mes in de rug gestoken, schrijft de tabloidkrant."
                            },
                            {
                                "example_id": "4c5be997-05bc-4242-bee3-ac2052fb7e71",
                                "sense_id": "586d9177-ab92-3a5d-b521-e32698808424",
                                "text": "De Britse tabloidkrant Daily Mail mag niet langer worden gezien als een betrouwbare bron op Wikipedia. Dat heeft een groep redacteuren van de online encyclopedie besloten, schrijft The Guardian."
                            },
                            {
                                "example_id": "0a736ebb-686c-4721-b6df-592c28ac8e24",
                                "sense_id": "586d9177-ab92-3a5d-b521-e32698808424",
                                "text": "De Australische acteur Geoffrey Rush heeft een laster-zaak gewonnen die hij had aangespannen tegen de uitgever van een tabloidkrant uit Sydney."
                            }
                        ]
                    }
