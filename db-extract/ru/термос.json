                                            {
                                                "example_id": "d06a2115-5ee8-46bc-b944-8a004ef65c39",
                                                "sense_id": "1804aa17-7a37-3ed1-9a47-57d6f734c181",
                                                "text": "„Was wir besitzen, ist rasch aufgezählt: meine Matratze, Küchenmesser und Teekessel, einen Kochtopf samt Kochlöffel, drei Thermosflaschen und pro Kopf ein Eßbesteck, einen Teller und anderthalb Tassen.“"
                                            },
                                            {
                                                "example_id": "21630c9f-d14b-41ba-822c-1b711d1c7c7c",
                                                "sense_id": "1804aa17-7a37-3ed1-9a47-57d6f734c181",
                                                "text": "„Sie hatten einen Apfelkuchen und eine Thermosflasche Kaffee mitgebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
