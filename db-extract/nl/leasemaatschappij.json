                        "examples": [
                            {
                                "example_id": "7d855c6f-4bb0-40f5-8686-1adcaf6564d9",
                                "sense_id": "7040a3a8-2471-31d5-aef4-e0e263b6f2e4",
                                "text": "De afname van het aantal dieselauto's wordt bij de leasemaatschappij - met een vloot van 44.000 auto's - geheel gecompenseerd door bestellingen van elektrische auto's."
                            },
                            {
                                "example_id": "db5c0b67-f4ee-4f48-ae3d-396b6e65c97a",
                                "sense_id": "7040a3a8-2471-31d5-aef4-e0e263b6f2e4",
                                "text": "Twee miljoen mensen hebben een pechhulpverzekering via de leasemaatschappij of de autodealer afgesloten. Van hen is in de meeste gevallen alleen het kenteken bekend. Alleen van mensen die in de afgelopen vijf jaar een beroep hebben gedaan op pechhulp zijn behalve het kenteken ook de naam- en adresgegevens vermeld. Hoeveel dat er zijn is niet duidelijk."
                            }
