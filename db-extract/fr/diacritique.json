                ],
                "senses": [
                    {
                        "sense_id": "a93f6225-f9d8-3d3b-8da1-ae0a1361dee9",
                        "entry_id": "ce51cd27-9563-3612-8fbd-7d21866ef970",
                        "glosses": [
                            "Qui sert à distinguer plusieurs lettres écrites presque de la même façon, en parlant des signes graphiques qui ont par exemple pour but d’empêcher, pour les yeux, la confusion des mots ayant le même son, comme par exemple l’accent grave placé sur À, sur là et où."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "283ab66c-206f-35a2-bb17-74a62e932953",
                        "entry_id": "ce51cd27-9563-3612-8fbd-7d21866ef970",
                        "glosses": [
                            "Dans les langues à abjad, signes graphiques complémentaires aux consonnes, qui permettent notamment de transcrire les voyelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6fe9c7-67b5-44bf-bf0c-728821e7093f",
                                "sense_id": "283ab66c-206f-35a2-bb17-74a62e932953",
                                "text": "Les signes diacritiques sont d’un grand usage dans les langues sémitiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b654844-7c42-3122-ac0b-5ababd45933d",
                        "entry_id": "ce51cd27-9563-3612-8fbd-7d21866ef970",
                        "glosses": [
                            "En cantillation hébraïque, graphèmes indiquant la prononciation correcte des versets de la Bible hébraïque."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "84ab617f-3c3a-38e1-a578-9742d68c7bbb",
                        "entry_id": "ce51cd27-9563-3612-8fbd-7d21866ef970",
                        "glosses": [
                            "Qualifie les symptômes spéciaux et distinctifs d’une maladie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ca8f291-a950-4c6f-ba73-ecb46857a057",
                                "sense_id": "84ab617f-3c3a-38e1-a578-9742d68c7bbb",
                                "text": "Signes diacritiques de la rubéole."
                            },
                            {
                                "example_id": "e4f4331c-fd3f-4217-9924-28e4b2a69496",
                                "sense_id": "84ab617f-3c3a-38e1-a578-9742d68c7bbb",
                                "text": "Les signes diacritiques permettent de faire un diagnostique différentiel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93a6e430-b13a-4bbe-82ac-5a04e08cd0ac",
                        "source_entry_id": "ce51cd27-9563-3612-8fbd-7d21866ef970",
                        "source_sense_id": "a93f6225-f9d8-3d3b-8da1-ae0a1361dee9",
