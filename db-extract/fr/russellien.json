                                        "glosses": [
                                            "Of or relating to Bertrand Russell (1872–1970), British philosopher, logician, mathematician, historian, social critic and political activist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3b98f3-d7b3-4b04-a21f-22cfea5cd6f8",
                                                "sense_id": "344a3d6c-4485-334f-8673-98a7fbe7f60d",
                                                "text": "It is sometimes supposed that extensional propositions—in particular Russellian propositions, which are adopted in some neo-Millian views about proper names—are incompatible with intensionalism and presuppositionalism."
                                            },
                                            {
                                                "example_id": "7c9ea89c-1771-4158-91ca-ac12d453852c",
                                                "sense_id": "344a3d6c-4485-334f-8673-98a7fbe7f60d",
                                                "text": "As Hermione phrases it, sounding convincingly Kantian or even Russellian about something called the Resurrection Stone: […]"
                                            }
                                        ]
                                    },
