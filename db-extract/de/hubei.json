                    {
                        "translation_id": "503a8bd8-5e1a-4ce5-a1a7-59bcf59de882",
                        "source_entry_id": "8302672c-9ab6-365e-ae49-33fa0ca126ae",
                        "source_sense_id": "71109aee-d755-3d03-83d4-6516156d90d0",
                        "source_sense_description": "chinesische Provinz im Osten der Volksrepublik China",
                        "target_lang_word": "Hubei",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hubei",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                        "entry_id": "d5e931db-7a54-3622-bba3-9ec4d920a164",
                                        "glosses": [
                                            "A province in central China. Capital: Wuhan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8d74e63-4ad0-4ccc-b777-b1f18a7d9fd9",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "In 1965 the People’s Daily published sore figures for Yangxin xian in Hubei Province which showed how important the part-work schools were in raising school attendance figures (SCMP 3475, 1965)."
                                            },
                                            {
                                                "example_id": "8aed8b75-6875-41cc-95cb-09fc840a4a2e",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "The Communists were also very active in Hubei and Hunan; they were involved in strikes in the Wuhan arsenal and steelworks and the strike of the Anyuan coal miners, and in the formation of workers’ clubs and unions among miners, metal-workers, and textile workers. These workers’ organizations were grouped together in provincial union federations of Hunan (with Mao Tsetung as secretary) and of Hubei."
                                            },
                                            {
                                                "example_id": "1bc4de03-5a18-4b9d-9488-8434d84e4d86",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "The Three Gorges Dam in Hubei province is the largest in the country, but is also one of the most controversial hydroelectric plants in the world. An estimated 1.3 million people were forcibly relocated during its construction. Moreover, the reservoir has been polluted by industrial waste."
                                            },
                                            {
                                                "example_id": "f7cfd437-709d-4417-ae61-e0df86732151",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "Cases have been heavily concentrated in Wuhan and surrounding areas of Hubei province, which has been locked down for two weeks in an attempt to contain the virus."
                                            },
                                            {
                                                "example_id": "12c8fb76-1421-46e3-91cc-aa2f493f73db",
                                                "sense_id": "5b529b69-b93c-3aa7-bd5d-101cba6504ed",
                                                "text": "Chinese authorities said Tuesday they will end a two-month lockdown of most of coronavirus-hit Hubei province at midnight, as domestic cases of what has become a global pandemic subside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0328b47-e983-461e-ba18-d35d96d042a8",
                        "source_entry_id": "8302672c-9ab6-365e-ae49-33fa0ca126ae",
                        "source_sense_id": "71109aee-d755-3d03-83d4-6516156d90d0",
                        "source_sense_description": "chinesische Provinz im Osten der Volksrepublik China",
                        "target_lang_word": "Hupeh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hupeh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                        "entry_id": "f5bb6170-ad3c-343a-b342-6047a5a82ecc",
                                        "glosses": [
                                            "Alternative form of Hubei."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "historical",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7414bcc2-7460-4210-b1a6-ce30cfa79c79",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "Recent letters show that Wushan and K'uei-fu, towns on the river below Wan Hsien, were still in the hands of the existing Government on the 8th instant, though Li-ch'uan, west of Shihnan-fu, in the extreme corner of Hupeh, was reported to be in the hands of the revolutionaries."
                                            },
                                            {
                                                "example_id": "ee0e1e49-1b87-40ea-8a82-2ad2a95dda0e",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "The magistrate of Ma-ch'eng in Hupeh engaged Chang to compile a local history for his district."
                                            },
                                            {
                                                "example_id": "68794743-9ccf-4583-b377-b0cff410a733",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "A group of bronzes of the late Western Chou were uncovered in Chingshan County, Hupeh Province, and 25 pieces of stone ching (musical chimes) with a painted design of the State of Chu were found in Chiangling County of the same province."
                                            },
                                            {
                                                "example_id": "571606d0-58a0-4943-83f9-b81943bf072f",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "HSIA-pa-ho Village is a small but rich \"fish and rice\" village located at the confluence of the Pa and the Yangtze rivers outside the Hsi-shui county seat in Hupeh province."
                                            },
                                            {
                                                "example_id": "0f3cdd16-f8a8-4056-bcf8-d15246a00ab8",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "A terrible battle has broken out again in northern Hupeh and western Hunan."
                                            },
                                            {
                                                "example_id": "107556be-e78a-4e3f-a159-4217903abf2f",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "Located in Hupeh Province astride the Yangtze River, Wuhan has always been regarded as one of China's most strategic urban centers."
                                            },
                                            {
                                                "example_id": "736537e3-9bc4-40d7-a6d8-2f1941ec8203",
                                                "sense_id": "277937d9-e848-3633-9164-b0a296905dfe",
                                                "text": "At the age of forty Tao-hsin moved to Shuang-feng Mountain in the district of Huang-mei, present-day Hupeh province. There he attracted a large following; it is said that he had five hundred students studying under him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
