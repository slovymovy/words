                                    {
                                        "sense_id": "76fad163-792c-34c8-afe6-cb6ec90e2467",
                                        "entry_id": "9fa2abfa-5890-35c3-bb7c-b0d3930422e7",
                                        "glosses": [
                                            "een lang, dun, cilindrisch stuk glaswerk met een nauwkeurig geijkte maatverdeling en een kraantje aan de onderzijde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d06c68-a07a-4a9f-b0ed-7fa31598ecaa",
                                                "sense_id": "76fad163-792c-34c8-afe6-cb6ec90e2467",
                                                "text": "De buret is het voornaamste volumetrische instrument gebruikt bij titraties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b497ee1a-4f83-4412-9466-e715e9fc558d",
                        "source_entry_id": "e2468855-fe3f-322a-a011-fba1ed5efa19",
                        "source_sense_description": "glass tube with fine gradations and a stopcock used for titration, etc.",
                        "target_lang_word": "burette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a28b31a3-1fcd-3904-9b97-41e4765f3665",
                                        "entry_id": "28a7437b-147c-39dd-9e1b-83dc685a2eb4",
                                        "glosses": [
                                            "Petit vase à goulot et à anse, propre à contenir du vinaigre, de l’huile, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aca4200-a811-42a0-b628-25b34fa01d82",
                                                "sense_id": "a28b31a3-1fcd-3904-9b97-41e4765f3665",
                                                "text": "Burette de cristal, de porcelaine, de faïence."
                                            },
                                            {
                                                "example_id": "06dc7676-596a-49b7-bbcd-1acf9dc6f7fc",
                                                "sense_id": "a28b31a3-1fcd-3904-9b97-41e4765f3665",
                                                "text": "Brave vieille sacoche bourrée de marteaux, pinces multiprises de force et burette métal aspergeante remplie d’huile de moteur."
                                            },
                                            {
                                                "example_id": "cbfc0c30-d9c3-44e4-a7d1-fbf13254c964",
                                                "sense_id": "a28b31a3-1fcd-3904-9b97-41e4765f3665",
                                                "text": "Sol considéra la burette, la massette."
                                            },
                                            {
                                                "example_id": "76c5a3a0-44b7-42e1-b0b9-3e29e6502cdb",
                                                "sense_id": "a28b31a3-1fcd-3904-9b97-41e4765f3665",
                                                "text": "C'est la fée des machines : à laver, à repasser, à tricoter, à coudre, à mixer, à mouliner, à souffler, à battre, comme à écrire ou à photocopier : elle sait tout des boutons, des recharges, des durées de fonctionnement, des endroits où donner le coup de burette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ec5899-4b67-3068-a8c5-14760ea7119e",
                                        "entry_id": "28a7437b-147c-39dd-9e1b-83dc685a2eb4",
                                        "glosses": [
                                            "Petit vase où l’on met le vin et l’eau qui servent à la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49e5d5ff-acf2-471d-9374-fd643d5cd769",
                                                "sense_id": "76ec5899-4b67-3068-a8c5-14760ea7119e",
                                                "text": "À l’aide d’un de ces instruments, il ouvrit le tabernacle, en tirant d’abord le saint-ciboire, […], puis un ostensoir massif, […], puis enfin deux burettes de vermeil."
                                            },
                                            {
                                                "example_id": "7ed6fc4b-dcab-4738-b05b-2854b4897b55",
                                                "sense_id": "76ec5899-4b67-3068-a8c5-14760ea7119e",
                                                "text": "Pierre, qui avait empli le calice à demi du vin des burettes, se lava les mains et aperçut de nouveau la mère, avec son visage d’ardente supplication."
                                            },
                                            {
                                                "example_id": "343d4569-bec1-488e-82bf-421d3cfc6a8c",
                                                "sense_id": "76ec5899-4b67-3068-a8c5-14760ea7119e",
                                                "text": "Et la messe continuait devant Durtal, émerveillé par l’enfant qui baisait, les yeux presque fermés, dans le petit recul d’un discret émoi, les burettes de vin et d’eau, avant que de les offrir au prêtre."
                                            },
                                            {
                                                "example_id": "59049c20-84b6-4db3-9654-741da85e5a95",
                                                "sense_id": "76ec5899-4b67-3068-a8c5-14760ea7119e",
                                                "text": "C’est une messe. […]. Il achève l’offertoire, et je le vois, debout, qui saisit la patène plaquée contre sa poitrine. Un enfant de chœur lui tend, l’une après l’autre, les burettes, cependant que le prêtre dépose l’hostie sur le corporal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce82d6dd-81a4-309c-bd0b-7f1517db4dac",
                                        "entry_id": "28a7437b-147c-39dd-9e1b-83dc685a2eb4",
                                        "glosses": [
                                            "Instrument de laboratoire permettant d'ajouter au goutte-à-goutte un réactif dont le dosage doit être précis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36729073-5fc8-4a8c-a1f1-fa055b7555a5",
                                                "sense_id": "ce82d6dd-81a4-309c-bd0b-7f1517db4dac",
                                                "text": "La burette est composée d'un tube en verre d'environ 1 cm de diamètre, gradué (généralement en dixième de millilitres), munie à son embouchure d'un robinet permettant de faire varier le débit du liquide, et ouvert à son autre extrémité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a0dee3-ea1c-3770-b1b7-7fd7e221ffb5",
                                        "entry_id": "28a7437b-147c-39dd-9e1b-83dc685a2eb4",
                                        "glosses": [
                                            "Testicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84990276-6dc2-497c-a48a-6a9270374fb8",
                                                "sense_id": "f4a0dee3-ea1c-3770-b1b7-7fd7e221ffb5",
                                                "text": "Je me chauffais les burettes, jambes écartées devant l’âtre ronflant de l’auberge."
                                            },
                                            {
                                                "example_id": "674a1157-e0a9-4ab5-b8f7-fd399376535b",
                                                "sense_id": "f4a0dee3-ea1c-3770-b1b7-7fd7e221ffb5",
                                                "text": "Je ne lisais pas le journal dans les burettes de mon père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
