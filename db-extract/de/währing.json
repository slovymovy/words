                ],
                "senses": [
                    {
                        "sense_id": "39a79ddc-7344-3396-8b05-0d281d60914b",
                        "entry_id": "38abe431-c429-3282-9b57-0ee49457714a",
                        "glosses": [
                            "achtzehnter Bezirk der österreichischen Bundeshauptstadt Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e80b4c3-4ce6-45f7-8c9f-9af8807981c1",
                                "sense_id": "39a79ddc-7344-3396-8b05-0d281d60914b",
                                "text": "In Währing befinden sich mehrere sehenswerte Schlösser und Villen."
                            },
                            {
                                "example_id": "f3967e3d-64c1-4216-b0d5-88d9e1d4abf3",
                                "sense_id": "39a79ddc-7344-3396-8b05-0d281d60914b",
                                "text": "Weitere Sehenswürdigkeiten in Währing sind das Cottageviertel, das Denkmal Kaiser Franz Joseph I., das Guttenberg-Denkmal, das Kálám-Denkmal, die Kálám-Villa, der Lucker Stein, das Malfatti-Haus, die Mosaike, der Pfannenstielhof, Türkischer Brunnen, Wohn- und Sterbehaus von Egon Friedell und noch vieles mehr."
                            },
                            {
                                "example_id": "258dbe5c-fc53-4cc8-9143-958b5614e5fc",
                                "sense_id": "39a79ddc-7344-3396-8b05-0d281d60914b",
                                "text": "Demnach hätte die Gebührenpflicht \"möglichst bis zur Bebauungsgrenze\" - also im verbauten Teil Währings - eingeführt werden sollen."
                            },
                            {
                                "example_id": "9f40779b-1be8-40b9-8c07-8a51f26e7ceb",
                                "sense_id": "39a79ddc-7344-3396-8b05-0d281d60914b",
                                "text": "Als Cottageviertel oder kurz das Cottage wird meistens das Cottageviertel in den Wiener Gemeindebezirken Währing und Döbling bezeichnet, es gibt in Wien aber auch ein Lainzer und ein Hietzinger Cottageviertel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "665751ef-58c2-3a75-b8ce-dd218a02337b",
                        "entry_id": "38abe431-c429-3282-9b57-0ee49457714a",
                        "glosses": [
                            "ehemaliges Dorf, nunmehr Ortsteil des gleichnamigen Bezirkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0db1d1-dc97-4962-aa05-69444d70511c",
                                "sense_id": "665751ef-58c2-3a75-b8ce-dd218a02337b",
                                "text": "In den beiden Türkenbelagerungen Wiens (1529 und 1683) wurde Währing von den Türken dem Erdboden gleichgemacht, und die Weinkulturen wurden völlig zerstört."
                            },
                            {
                                "example_id": "02844e03-a780-46e4-bd00-07f2c63d2281",
                                "sense_id": "665751ef-58c2-3a75-b8ce-dd218a02337b",
                                "text": "Der 18. Wiener Gemeindebezirk Währing wurde am 1.Jänner 1892 aus den ehemaligen selbstständigen niederösterreichischen Orten Währing, Weinhaus, Gersthof, Pötzleinsdorf, Neustift am Walde und Salmannsdorf gebildet."
                            },
                            {
                                "example_id": "dae05eb3-ca1e-48d2-afe9-008ea882a96d",
                                "sense_id": "665751ef-58c2-3a75-b8ce-dd218a02337b",
                                "text": "Nach dem Neubau dieser Kirche errichtete Währing 1769 auf dem Gelände des heutigen Schubertparks einen neuen Friedhof."
                            },
                            {
                                "example_id": "4a3ef249-96fc-46b3-a77b-f87030880d32",
                                "sense_id": "665751ef-58c2-3a75-b8ce-dd218a02337b",
                                "text": "Ja man hat anderswo Überbleibsel türkischer Schanzen auszuweisen, die keineswegs ein solches Aussehen, wie die Hügel zu Währing und Liesing haben."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
