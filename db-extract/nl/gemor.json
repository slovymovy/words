                ],
                "translations": [
                    {
                        "translation_id": "b7a3b439-840d-41c1-9b46-45dbcec36578",
                        "source_entry_id": "aa5d00f4-d780-35fe-a4dd-6fba94ba55c3",
                        "source_sense_id": "bd36c4a9-cfce-33c2-b58f-64863b2ddd36",
