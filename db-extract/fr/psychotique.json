                ],
                "senses": [
                    {
                        "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                        "entry_id": "6ead8d5a-25d2-39b1-bd8d-b2748674c81e",
                        "glosses": [
                            "Personne souffrant de psychose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88b06ae-1a14-48fd-ab81-4722e3f74beb",
                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                "text": "Il survient aussi des moments où un psychotique semble cesser d’être « fou »."
                            },
                            {
                                "example_id": "211e5bbb-0bb0-4119-af7d-ecdbf3b4a129",
                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                "text": "Dans les rituels magiques des psychotiques, nous sommes en présence d'une ritualité d'un autre ordre. Les rituels des psychotiques ont souvent des fonctions de protection contre les hallucinations. L'oreille coupée de Van Gogh est probablement l'effet d'un rituel qui devait le protéger contre des hallucinations auditives."
                            },
                            {
                                "example_id": "e3ce88ba-a9d0-4cf1-90f9-2cdb63ceb042",
                                "sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                                "text": "Ce ne sont pas des psychotiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa127be6-e8bf-443d-b4e7-215250271f14",
                        "source_entry_id": "6ead8d5a-25d2-39b1-bd8d-b2748674c81e",
                        "source_sense_id": "7f80245f-320a-34aa-89bc-345bcd931a1e",
                        "target_lang_word": "Psychotiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychotiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03ef61d0-cec6-391e-bcde-933f722d3d11",
                                        "entry_id": "15e8b066-a690-3b0c-983f-9a1797be189f",
                                        "glosses": [
                                            "Person, die an einer Psychose erkrankt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1899eac-42d6-4845-a080-2fc9db07adcd",
                                                "sense_id": "03ef61d0-cec6-391e-bcde-933f722d3d11",
                                                "text": "Er ist seit der Jugend Psychotiker und war bereits in mehreren Kliniken stationär untergebracht."
                                            },
                                            {
                                                "example_id": "b20dbed8-0dc7-45ea-9473-1167ca6fdeeb",
                                                "sense_id": "03ef61d0-cec6-391e-bcde-933f722d3d11",
                                                "text": "Der Alltag als Psychotiker ist für ihn nicht leicht, die ganzen Zwänge und Ängste machen ihm schwer zu schaffen."
                                            },
                                            {
                                                "example_id": "735d3aac-98eb-41a5-a554-2de3eadd0ca3",
                                                "sense_id": "03ef61d0-cec6-391e-bcde-933f722d3d11",
                                                "text": "Er hört Stimmen in seinem Kopf und sein Psychologe meint, er wäre Psychotiker."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
