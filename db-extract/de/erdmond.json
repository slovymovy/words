                "senses": [
                    {
                        "sense_id": "75b79bd7-7f33-364d-a474-2fcd4733a3bc",
                        "entry_id": "6f560f01-9f39-3ec6-b07a-432253012e97",
                        "glosses": [
                            "Mond der Erde; Mond der die Erde umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c49c7e6d-9442-4227-bbc2-8b6378c6497b",
                                "sense_id": "75b79bd7-7f33-364d-a474-2fcd4733a3bc",
                                "text": "Aufgrund seiner verhältnismäßigen Nähe ist der Erdmond der einzige fremde Himmelskörper, der bisher von Menschen betreten wurde, und somit auch der am besten erforschte."
                            },
                            {
                                "example_id": "c9115394-844a-4e62-abab-6e18f432ea0c",
                                "sense_id": "75b79bd7-7f33-364d-a474-2fcd4733a3bc",
                                "text": "„Er ist der kleinste Planet des Sonnensystems und mit einem Durchmesser von 4.878 Kilometern nur wenig größer als der Erdmond – und kleiner als Jupitermond Ganymed und Saturnmond Titan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
