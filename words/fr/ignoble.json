    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac574a6c-8494-3450-a958-809a10263e92",
                    "sense_definition": "Qui est méprisable, honteux et contraire à toute dignité ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trahir la confiance d'un ami d'enfance pour de l'argent reste un acte profondément <w>ignoble</w>."
                        },
                        {
                            "text": "Tout le village a condamné son comportement <w>ignoble</w> envers cette famille démunie."
                        }
                    ],
                    "synonyms": [
                        "abject",
                        "lâche"
                    ],
                    "common_phrases": [
                        "comportement ignoble",
                        "acte ignoble",
                        "procédé ignoble"
                    ]
                },
                {
                    "sense_id": "2437115a-ed11-3c07-b8cd-1bf6f4d41fb0",
                    "sense_definition": "Qui est particulièrement déplaisant, affreux ou dégoûtant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons dû annuler la sortie en mer à cause d'un temps <w>ignoble</w> et venteux."
                        },
                        {
                            "text": "La soupe servie à la cantine avait une odeur et un goût franchement <w>ignoble</w>."
                        }
                    ],
                    "common_phrases": [
                        "temps ignoble",
                        "goût ignoble"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier pour exprimer un dégoût vif"
                        }
                    ]
                },
                {
                    "sense_id": "5c46e302-7aab-318d-9a2f-aee7cb029e36",
                    "sense_definition": "Qui suscite la répulsion par sa saleté repoussante ou sa laideur sordide.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces marchands de sommeil louaient un logement <w>ignoble</w> dépourvu de fenêtres et d'eau courante."
                        },
                        {
                            "text": "Les enquêteurs ont découvert des animaux enfermés dans des cages d'une saleté tout à fait <w>ignoble</w>."
                        }
                    ],
                    "common_phrases": [
                        "taudis ignoble",
                        "endroit ignoble"
                    ]
                },
                {
                    "sense_id": "d121a9dc-0425-30d3-abae-29fe2bd0575e",
                    "sense_definition": "Qui n'appartient pas à la noblesse ; roturier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'Ancien Régime, une personne de condition <w>ignoble</w> ne jouissait pas des privilèges seigneuriaux."
                        },
                        {
                            "text": "Ce seigneur refusait d'accorder la main de sa fille unique à un prétendant de naissance <w>ignoble</w>."
                        }
                    ],
                    "synonyms": [
                        "gueux",
                        "roturier",
                        "vilain"
                    ],
                    "antonyms": [
                        "noble"
                    ],
                    "common_phrases": [
                        "condition ignoble",
                        "naissance ignoble"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme historique ou juridique ancien"
                        }
                    ]
                }
            ]
        }
    ]
