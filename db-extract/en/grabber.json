                    {
                        "sense_id": "32870dce-f0ad-390d-8a02-e59684855942",
                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                        "glosses": [
                            "One who, or that which, grabs or seizes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f70227-324e-4f56-831a-f0282bf35608",
                                "sense_id": "32870dce-f0ad-390d-8a02-e59684855942",
                                "text": "Another money grabber, according to Ms. Chapman, is the woman who makes $30,000-$40,000 or more a year, but lives as though she makes twice as much."
                            }
                        ]
                    },
                    {
                        "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                        "glosses": [
                            "Something that captures one's attention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ea7339-2f26-4351-ab19-aace58a774e5",
                                "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                                "text": "The one new tune that was a real grabber had a great slow chanting chorus, \"Stand up, you have a right to fight!\""
                            },
                            {
                                "example_id": "bb5d6479-0ebb-4555-8358-e53e96592bb5",
                                "sense_id": "05a80b28-e17a-3b48-b245-27f4b9154821",
                                "text": "Get to the story and make sure that line 6 or 7 is a grabber. TV viewers have attention spans of fifteen seconds, and then they hit the remote."
                            }
                        ]
                    },
                    {
                        "sense_id": "85ea74d4-2710-3af7-96dd-c12f0171f33b",
                        "entry_id": "905865c4-f238-3899-968e-a2d919cba7d9",
                        "glosses": [
                            "A machine in an amusement arcade containing prizes which the player must attempt to pick up with a mechanical grabbing arm."
                        ],
