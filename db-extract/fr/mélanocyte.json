                ],
                "senses": [
                    {
                        "sense_id": "081a0a52-66d8-3712-879d-3b2f97d38030",
                        "entry_id": "2453e4ea-29ba-3bc9-aa44-12a592144ab3",
                        "glosses": [
                            "Cellule qui pigmente la peau, les poils ou les plumes des vertébrés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba42c613-be4f-4829-be93-e58742578be0",
                                "sense_id": "081a0a52-66d8-3712-879d-3b2f97d38030",
                                "text": "Elle se forme grâce aux mélanines à partir du mélanocyte, grosse cellule dendritique située dans la couche basale de l’épiderme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52fb828c-9092-4704-84f1-c594c6f47fd1",
                        "source_entry_id": "2453e4ea-29ba-3bc9-aa44-12a592144ab3",
                        "source_sense_id": "081a0a52-66d8-3712-879d-3b2f97d38030",
                        "target_lang_word": "Melanozyt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melanozyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18f107d3-6c13-3811-8607-d7c8b28fb480",
                                        "entry_id": "438c0808-6a5e-3dc2-98af-b16753359709",
                                        "glosses": [
                                            "Pigmentzelle, in welcher der Farbstoff Melanin produziert wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4df32dd0-cb20-4980-b568-9f40e4948b42",
                                                "sense_id": "18f107d3-6c13-3811-8607-d7c8b28fb480",
                                                "text": "„Melanozyten aus dem Neuroektoderm besiedeln die Epidermis im Verlauf des ersten Trimenons.“"
                                            },
                                            {
                                                "example_id": "885b0155-faa7-4e72-a756-33b94728b459",
                                                "sense_id": "18f107d3-6c13-3811-8607-d7c8b28fb480",
                                                "text": "„Die Farbe unserer Haut bestimmt das Pigment Melanin, welches von einer Zellform namens Melanozyt produziert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1230d2bd-73ea-4edc-a5f0-515c3da47307",
                        "source_entry_id": "2453e4ea-29ba-3bc9-aa44-12a592144ab3",
                        "source_sense_id": "081a0a52-66d8-3712-879d-3b2f97d38030",
                        "target_lang_word": "Melanocyt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Melanocyt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                        "entry_id": "3f368956-d7cc-392a-9897-048a80132aca",
                                        "glosses": [
                                            "Pigmentzelle, in welcher der Farbstoff Melanin produziert wird"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e20b4b2-240b-4aef-8f5e-e5f92b41d3a6",
                                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                                "text": "„Der Melanocyt ist eine Zelle, die durch ihren Gehalt an Tyrosinase befähigt ist, aktiv Melanin zu synthetisieren.“"
                                            },
                                            {
                                                "example_id": "54019028-6bb0-40be-b14c-c9d4f31cbcf0",
                                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                                "text": "„Ist das Netzwerk im Gelzustand, so sind die Melaningranula im Zentrum der Zelle lokalisiert und der Melanocyt ist hell gefärbt.“"
                                            },
                                            {
                                                "example_id": "85cde5b9-7c3a-4e02-a22c-75c2d28ed86a",
                                                "sense_id": "5499a32d-053b-3ad9-9199-f196f031cfaa",
                                                "text": "„Daraus resultiert, daß die Melanoblasten ein eigenes Areal einnehmen, in das kein anderer Melanocyt eindringen kann, und daß sie sich in einem allseits ungefähr gleichen Abstand voneinander halten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dcdbf258-9fdf-4e30-a502-6ab9fdaf6482",
                        "source_entry_id": "2453e4ea-29ba-3bc9-aa44-12a592144ab3",
                        "source_sense_id": "081a0a52-66d8-3712-879d-3b2f97d38030",
