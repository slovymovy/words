                        "examples": [
                            {
                                "example_id": "5649c664-90cc-44ec-b46a-f4913339aa7c",
                                "sense_id": "86f6f493-5739-3076-b8ca-3e49cb65fd75",
                                "text": "Do czarterpartii mogą być dołączane kartki zawierające klauzule ustalone już po zawarciu umowy czarteru, niekiedy są one dopisywane nawet odręcznie."
                            }
                        ],
