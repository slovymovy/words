                    {
                        "translation_id": "05822f18-97a2-47cc-8967-8c2f48cd5b4b",
                        "source_entry_id": "cd36c832-3309-3819-85b6-79821a90e825",
                        "source_sense_id": "9821f341-a4b6-306a-8374-6d747d1c9d87",
