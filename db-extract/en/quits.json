                                                "sense_id": "570d3f72-4978-3e4d-816e-63cfdbffb2ca",
                                                "text": "Ellis, la chienne, est là, qui ne quitte pas des yeux le canard qui fricotte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3750d0d4-a8cb-37de-8031-de212af4466b",
                                        "entry_id": "e558527a-a654-3105-abf8-a18f2c65e77b",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de quitter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc1dfe17-a845-4815-921d-69ef58f2e95f",
                                                "sense_id": "3750d0d4-a8cb-37de-8031-de212af4466b",
                                                "text": "Faut que je quitte mon bénard… vire-moi mes pompes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2539787a-a26d-35a1-8cdb-9d5fe20a2f8b",
