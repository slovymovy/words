                                        "sense_id": "9e72d089-2a90-32a9-90b8-8672800ab98f",
                                        "entry_id": "48ba1800-707f-3a10-9524-a91a70347f66",
                                        "glosses": [
                                            "eenmaal per jaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c35219-5439-48a2-9922-01e2bf4f15f9",
                                                "sense_id": "9e72d089-2a90-32a9-90b8-8672800ab98f",
                                                "text": "Op hun jaarlijkse familiereünie was het meestal bijzonder gezellig."
                                            },
                                            {
                                                "example_id": "46284309-c5cc-45b0-817d-3ca7123ec19e",
                                                "sense_id": "9e72d089-2a90-32a9-90b8-8672800ab98f",
                                                "text": "'Welkom op het tiende jaarlijkse congres van het Australische genootschap van lexicografen,' zegt hij met een kleine hapering in zijn kalme stem."
                                            },
                                            {
                                                "example_id": "742df5a3-c44f-4d31-bc72-b0caabebaa33",
                                                "sense_id": "9e72d089-2a90-32a9-90b8-8672800ab98f",
                                                "text": "Hij vermaakte dit alles aan mij, plus duizend Romeinse daalders aan contant geld, op voorwaarde dat ik jaarlijks een mis voor hem zou laten lezen en dat ik een stamboom inclusief geschiedenis van zijn familiegeslacht zou opstellen, en dat heb ik ook gedaan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jaarlijks",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cc4cea35-45cd-3d41-9906-44c558127506",
                                        "entry_id": "def6903d-e42b-3bc5-8650-0b13fede03a3",
                                        "glosses": [
                                            "eenmaal per jaar, per jaar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad40b03d-85b2-4ca5-a132-9cba61929961",
                                                "sense_id": "cc4cea35-45cd-3d41-9906-44c558127506",
                                                "text": "Zij hadden jaarlijks een familiereünie."
                                            },
                                            {
                                                "example_id": "0610857e-637a-477e-90ea-7c3e4990f2ac",
                                                "sense_id": "cc4cea35-45cd-3d41-9906-44c558127506",
                                                "text": "Studenten en promovendi met veel kennis van onder meer kritieke grondstoffen zijn hard nodig voor de energietransitie, zegt men ook buiten de muren van de VU. De ongeveer tachtig bachelor- en masterstudenten die de studie in Amsterdam jaarlijks trekt, zijn harder nodig dan ooit, klinkt het. Ook bijvoorbeeld voor de opslag van CO2 onder de grond en kustbescherming is hun kennis nodig."
                                            },
                                            {
                                                "example_id": "00bde866-8647-43bc-9dfe-abc2cfb2213a",
                                                "sense_id": "cc4cea35-45cd-3d41-9906-44c558127506",
                                                "text": "Hij had jaarlijks niet meer dan 800 euro aan vaste lasten en rommelde wat aan in de bouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
