    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd1ad3b8-6029-3d1c-8d2c-1cdb25faf221",
                    "sense_definition": "kunst, films of boeken van lage kwaliteit en sensationele aard",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Veel critici noemden het boek pure <w>pulp</w>, maar het werd toch een bestseller.",
                            "target_lang_translations": {
                                "de": "Viele Kritiker nannten das Buch reinen <w>Schund</w>, aber es wurde trotzdem ein Bestseller."
                            }
                        },
                        {
                            "text": "Hij kijkt op vrijdagavond graag naar oude horrorfilms en andere <w>pulp</w>.",
                            "target_lang_translations": {
                                "de": "Er schaut am Freitagabend gerne alte Horrorfilme und anderen <w>Schund</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kitsch",
                        "rommel"
                    ],
                    "common_phrases": [
                        "pure pulp"
                    ],
                    "target_lang_definitions": {
                        "de": "Kunst, Filme oder Bücher von geringer Qualität und oft reißerischem Charakter"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Schund",
                                "target_lang_sense_clarification": "minderwertige Literatur oder Kunst"
                            },
                            {
                                "target_lang_word": "der Pulp",
                                "target_lang_sense_clarification": "Trivialliteratur oder billige Unterhaltung"
                            },
                            {
                                "target_lang_word": "der Schrott",
                                "target_lang_sense_clarification": "umgangssprachlich für schlechte Medienprodukte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "370aefa6-b14f-3be6-a7a9-6bf4b7281227",
                    "sense_definition": "papachtige, zachte massa die ontstaat door het vermalen van plantaardig materiaal",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De fabriek verwerkt hout tot natte <w>pulp</w> om er nieuw papier van te maken.",
                            "target_lang_translations": {
                                "de": "Die Fabrik verarbeitet Holz zu feuchter <w>Pulpe</w>, um daraus neues Papier herzustellen."
                            }
                        },
                        {
                            "text": "Na het persen van het fruit bleef er alleen een dikke <w>pulp</w> over.",
                            "target_lang_translations": {
                                "de": "Nach dem Auspressen der Früchte blieb nur ein dicker <w>Brei</w> übrig."
                            }
                        }
                    ],
                    "synonyms": [
                        "brij",
                        "moes"
                    ],
                    "target_lang_definitions": {
                        "de": "Breiige, weiche Masse, die durch das Zerkleinern von pflanzlichem Material entsteht"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "der Brei",
                                "target_lang_sense_clarification": "weiche, breiige Masse"
                            },
                            {
                                "target_lang_word": "die Pulpe",
                                "target_lang_sense_clarification": "insbesondere Papier- oder Fruchtbrei"
                            },
                            {
                                "target_lang_word": "der Zellstoff",
                                "target_lang_sense_clarification": "Holzbrei zur Papierherstellung"
                            },
                            {
                                "target_lang_word": "das Fruchtfleisch",
                                "target_lang_sense_clarification": "ausgepresste Reste von Früchten"
                            }
                        ]
                    }
                }
            ]
        }
    ]
