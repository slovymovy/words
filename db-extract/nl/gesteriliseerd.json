                "senses": [
                    {
                        "sense_id": "995321aa-89d2-33e3-8d1a-fa620d8cbfc4",
                        "entry_id": "ea37df7d-7e08-3eb1-bc36-b246278faa8b",
                        "glosses": [
                            "zo bewerkt dat alle ziektekiemen zijn gedood"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a842bcc4-6e8e-4081-a0ac-502c4489e17f",
                                "sense_id": "995321aa-89d2-33e3-8d1a-fa620d8cbfc4",
                                "text": "Schil de klitwortel en snij in blokjes van 2 cm dikte. Stoom ze in ongeveer 30 minuten beetgaar. Plaats ze in een gesteriliseerd potje."
                            },
                            {
                                "example_id": "e24ce5bb-9800-46f9-91e5-50575ae564c5",
                                "sense_id": "995321aa-89d2-33e3-8d1a-fa620d8cbfc4",
                                "text": "Vermakelijk zijn ze wel, de anekdotes van Paramount-gids Mike. (…) Over John Travolta die in het kader van de smetvrees bij een waterscène eiste dat alleen gesteriliseerd water werd gebruikt."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f1b4d95-6a55-3027-ae2f-b16ca788f297",
                        "entry_id": "ea37df7d-7e08-3eb1-bc36-b246278faa8b",
                        "glosses": [
                            "zo bewerkt dat er geen leven meer in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8953cf13-aaa6-488e-b3aa-10ceaca0e1ae",
                                "sense_id": "1f1b4d95-6a55-3027-ae2f-b16ca788f297",
                                "text": "Ondergrond uit Reijerscamp werd bedekt met heide- of graslandtransplantaat en daar kwam gesteriliseerd zand op. Dat remt uitgroei van zaden vanuit het transplantaat."
                            }
                        ]
                    },
                    {
                        "sense_id": "daf8f91d-048d-362b-bc38-ccfcf45b6bd7",
                        "entry_id": "ea37df7d-7e08-3eb1-bc36-b246278faa8b",
                        "glosses": [
                            "zo behandeld dat voortbrengen van nageslacht niet meer mogelijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22ff010-8f57-4f8c-a780-e6c9d8215554",
                                "sense_id": "daf8f91d-048d-362b-bc38-ccfcf45b6bd7",
                                "text": "Gesteriliseerde vrouwen, bij wie de eileiders zijn afgesloten of de baarmoeder is verwijderd, hebben veel minder kans op eierstokkanker."
                            },
                            {
                                "example_id": "b761c5af-4881-474d-bae0-bf0b35a53728",
                                "sense_id": "daf8f91d-048d-362b-bc38-ccfcf45b6bd7",
                                "text": "Groepen gesteriliseerde en gecastreerde katten zijn rustiger, veroorzaken minder overlast, voorkomen de komst van een nieuwe zwerfkattengroep en sterven langzaam uit."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb1b77a2-71e5-3fcd-a6f7-43ae782a5d33",
                        "entry_id": "ea37df7d-7e08-3eb1-bc36-b246278faa8b",
                        "glosses": [
                            "ontdaan van alles wat stoort en daardoor levenloos"
                        ],
