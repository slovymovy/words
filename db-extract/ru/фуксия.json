                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f22ba40-4695-41b1-a6be-e10d54ecd4eb",
                                "sense_id": "ab2a8d28-852f-367f-940f-4d84e309bc94",
                                "text": "Если яркий синий – цвет открытия весеннего сезона, то фуксия – цвет осени."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
