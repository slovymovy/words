                                                "example_id": "1e11a917-79a0-4428-98d4-e609db4e0065",
                                                "sense_id": "a1ad3206-db40-3abf-b57b-ebb53bbd768b",
                                                "text": "Notons que, en dépit du score, le manque de réalisme est l’une des rares choses que l’on puisse reprocher aux Bleus, souvent mis en échec par Patrick Pentz."
                                            },
                                            {
                                                "example_id": "e7891be8-087e-4626-a7c5-5d856d56cd30",
                                                "sense_id": "a1ad3206-db40-3abf-b57b-ebb53bbd768b",
                                                "text": "Un sacré défi pour les showrunneurs John D. Payne et Patrick McKay."
                                            }
