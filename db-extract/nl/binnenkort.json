        "nl-extract.jsonl": [
            {
                "entry_id": "2fc5b6b7-d098-3615-997b-cff38c840e57",
                "word": "binnenkort",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                        "entry_id": "2fc5b6b7-d098-3615-997b-cff38c840e57",
                        "glosses": [
                            "binnen afzienbare tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53331885-f7a5-49e0-9e0e-c2fce490c00e",
                                "sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                                "text": "Dat gebouw wordt binnenkort gesloopt."
                            },
                            {
                                "example_id": "46dbf30c-f88d-4ced-a0e4-054ef43ad76d",
                                "sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                                "text": "Ze zouden binnenkort gaan trouwen, maar door de ziekte van de moeder van de bruid hebben ze het feest uitgesteld naar een later tijdstip."
                            },
                            {
                                "example_id": "bafed051-90f0-4e00-ad3f-17655af1c4d0",
                                "sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                                "text": "Mijn lichaam moest zich constant aanpassen aan de lange afstanden en mijn nieuwe levensstijl waardoor ik heel snel steeds weer honger had. Het maakte niet uit wat en hoeveel ik at, het leek nooit genoeg te zijn. Gelukkig zou de trail binnenkort een weg kruisen waarlangs ik het legendarische ‘Paradise Café’ kon bereiken. Daar werden de ‘Best Burgers in the World’ geserveerd, stond in een commentaar in de Guthook App."
                            },
                            {
                                "example_id": "08d6e2c6-f12b-47c0-902a-5d16ee3ba472",
                                "sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                                "text": "De belangstelling voor bloemen en planten die overblijven als de Floriade in Almere binnenkort sluit, is zo groot dat de inschrijving daarvoor per direct is gesloten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8882267e-2f41-4504-8027-7e28ee93dd62",
                        "source_entry_id": "2fc5b6b7-d098-3615-997b-cff38c840e57",
                        "source_sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
                        "source_sense_description": "binnen afzienbare tijd",
                        "target_lang_word": "bald",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bald",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "kurze Zeit danach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c951e3b-7a65-4280-92da-9ea062303ae6",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Bald nun ist Weihnachtszeit."
                                            },
                                            {
                                                "example_id": "cd2019b2-f2f8-4138-b103-c5bd27781503",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Komm bald! Nein, komm eher; komm, sobald es irgendwie geht!"
                                            },
                                            {
                                                "example_id": "e79864bb-c18d-4b1c-a8f7-ef091c2c57f4",
                                                "sense_id": "5a35a3f6-ebde-3d9e-8cb7-d9824f5754d5",
                                                "text": "Er ruft am ehesten an, wenn du ihn nicht drängst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "beinahe, fast"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "656872e5-679d-4795-aa3a-8e92cd4ed938",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Ich hätte bald dazu einen Kommentar abgegeben."
                                            },
                                            {
                                                "example_id": "f15232ac-eca7-4315-a1c1-448f3b1b4c7c",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Das ist bald zwei Jahre her, dass die beiden geheiratet haben."
                                            },
                                            {
                                                "example_id": "2661a03f-307a-4d3a-98bf-ba2a95ce6619",
                                                "sense_id": "59ceafaa-c907-3511-9b14-4685e7c976b7",
                                                "text": "Ach, ich hätt bald vergessen zu fragen: sehen wir uns heute Abend?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                        "entry_id": "ab9ecc1c-19aa-32b2-826d-966fd6fc4d67",
                                        "glosses": [
                                            "ohne große Verzögerung, schnell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f76227e-77f0-4c48-b31a-805c07186077",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Sie hat bald begriffen, was die meisten Männer nicht verstehen."
                                            },
                                            {
                                                "example_id": "8955c635-5fd5-4955-90ed-8624c2e10cf7",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Hoffentlich geht dieser Lockdown bald vorbei."
                                            },
                                            {
                                                "example_id": "b5203fca-8257-4b7c-9371-6da15e7d68dc",
                                                "sense_id": "6780be27-fb24-364e-864f-b5e47bfc64a0",
                                                "text": "Du kriegst eher einen Pudding an die Wand genagelt, als von dem Typen eine Aussage zu eurer Beziehung."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb592ca8-35cf-44c8-8eb8-0a409559e091",
                        "source_entry_id": "2fc5b6b7-d098-3615-997b-cff38c840e57",
                        "source_sense_id": "337f8fd1-7da4-3790-b94a-859ed82b9e81",
