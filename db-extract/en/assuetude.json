                        "examples": [
                            {
                                "example_id": "079b3c6d-6959-4945-8485-a7cd420246ae",
                                "sense_id": "70723176-f9db-3155-bd00-abcd77d07acf",
                                "text": "Assuetude of things hurtful doth make them lose their force to hurt."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c46711d-1e62-33d6-9ae5-7d94d2424008",
                        "entry_id": "af4e8bd6-f88c-3120-a709-cb3c19d35fff",
                        "glosses": [
                            "The condition of an organism that has acquired tolerance of a drug or poison."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e67e3ffd-4b72-4e11-9284-53ed668db755",
                                "sense_id": "2c46711d-1e62-33d6-9ae5-7d94d2424008",
                                "text": "The boy had been his companion for years: and from assuetude had become, as it were, a part of himself."
                            },
                            {
                                "example_id": "094dea48-c65f-4c3b-921f-f647799caf56",
                                "sense_id": "2c46711d-1e62-33d6-9ae5-7d94d2424008",
                                "text": "My flesh writhed like the glutinous flesh of a serpent. Slowly moved, and stopped: -- then was a sweep -- and a swirl -- and a pause! then a swirl -- and a sweep -- and a pause! -- then steady industry of labour on the monstrous brazen axis, as the husbandman plods by the plough; then increase of zest, assuetude of a fledgeling to the wing -- then intensity -- then the last light ecstasy of flight."
                            }
                        ]
                    }
