                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328bcb00-a279-4677-9cac-78539340ac22",
                                "sense_id": "fcbac123-1407-3762-9825-48dc44bb6f48",
                                "text": "Auf den Flachdächern der Betonbauten sieht man Anschlussbewehrungen in die Höhe ragen, die die Möglichkeit der Aufstockung offenlassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
