                            {
                                "example_id": "22adf4f5-175c-46e7-b454-bd5c77e9c5bb",
                                "sense_id": "ca62e213-a02d-3364-b471-9ee689b712f7",
                                "text": "„Der Führer hatte plötzlich unvermittelt den kleinen Fahnenträger, einen fröhlichen, zwölfjährigen Jungen, aufgefordert, die Fahne abzugeben.“"
                            }
                        ],
