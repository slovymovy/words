                "senses": [
                    {
                        "sense_id": "5f28c609-aba3-3a63-8d69-6942e9bd53ba",
                        "entry_id": "de916add-2f42-3f1e-ab2b-6b97755bc73c",
                        "glosses": [
                            "einer von vielen volkstümlichen Namen für Bingelkraut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99060f4a-2144-4613-bffc-dac13ca5471e",
                                "sense_id": "5f28c609-aba3-3a63-8d69-6942e9bd53ba",
                                "text": "Von den Buchenwald-Charakterarten tritt das Büngelkraut (Mercurialis perennis) nur in den tiefsten Lagen, dort aber oft massenhaft auf, über 700 m Meereshöhe wird es in unserer Gegend selten."
                            },
                            {
                                "example_id": "ed690a8f-aa92-4d4b-9573-f4e55519a24d",
                                "sense_id": "5f28c609-aba3-3a63-8d69-6942e9bd53ba",
                                "text": "„Es ist geradezu bezeichnend, daß das Büngelkraut im Tellenwald bei Abtwil auf Tuffboden und in steiler Südlage und an den sehr steilen Südböschungen des Wattbaches bis 800 m hinaufsteigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
