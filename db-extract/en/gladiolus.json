                                        "glosses": [
                                            "Pflanze aus der Gattung Gladiolus, häufige Zierpflanze, stammt aus dem lateinischen Substantiv gladiolus \\\"kleines Schwert\\\", abgewandelt von gladius, was Schwert bedeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26f0b3d7-f179-4ba0-b2bc-1690279076c6",
                                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                                "text": "Gladiolen sind beliebte Schnittblumen."
                                            },
                                            {
                                                "example_id": "d509a404-10c7-4259-83b4-7c5ac1ddca8f",
                                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                                "text": "Siehst du beim Blumenstand an der Straße die schönen Gladiolen?"
                                            },
                                            {
                                                "example_id": "54ff6e2c-9994-4382-b31b-6c5b9fc99d88",
                                                "sense_id": "6ba7e55a-7603-36a7-848b-f9858ad77bc4",
                                                "text": "„Es blühten Malven und Rittersporn, tränende Herzen, Rosen, Gladiolen und vieles mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
