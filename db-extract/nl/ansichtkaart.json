                                "target_senses": [
                                    {
                                        "sense_id": "5a6e268d-b836-39b2-9396-c9f72666616a",
                                        "entry_id": "6ffea960-e5f5-3d37-8d84-602ff6e93668",
                                        "glosses": [
                                            "A postcard bearing a picture."
                                        ],
                                        "tags": [],
