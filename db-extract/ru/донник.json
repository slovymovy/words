                                        "glosses": [
                                            "A fragrant plant of the genus Melilotus, often having small yellow or white flowers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56e4e978-5df9-46c2-8c01-2a21ded49649",
                                                "sense_id": "8ddf8505-a5fd-36fd-b506-9c868e2afb5d",
                                                "text": "Melilot boiled in wine and applied mollifies all hard tumours and inflammations that happen in the eyes or other parts of the body, as the fundament or privy parts of man or woman."
                                            }
                                        ]
