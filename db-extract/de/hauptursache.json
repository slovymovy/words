                ],
                "senses": [
                    {
                        "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                        "entry_id": "410153d8-582c-3126-855d-b5b8485e4b41",
                        "glosses": [
                            "entscheidender/wesentlicher Grund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58423546-e176-430d-9839-b910197751a5",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Laut UNICEF ist Mangelernährung die Hauptursache für Kindersterblichkeit.“"
                            },
                            {
                                "example_id": "ff35d271-b98a-43e7-bec6-ffa21235439d",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Die Hauptursache für Prostitution ist Armut.“"
                            },
                            {
                                "example_id": "4a998cc8-dec5-49a3-b5f6-b8705ed3336a",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Für den Naturschutzbund (NABU) ist die Landwirtschaft die Hauptursache des Insektensterbens.“"
                            },
                            {
                                "example_id": "4192970c-3928-41f5-8c0f-b8ca374e271f",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Der Mensch ist - direkt oder indirekt - die Hauptursache für das schnelle Massensterben der Pflanzen- und Tierarten auf der ganzen Welt.“"
                            },
                            {
                                "example_id": "511830ec-5b1a-4654-9f6e-47be7a3a14f2",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Zu viel UV-Strahlung mit Sonnenbrand in der Kindheit und Jugend gelten als eine Hauptursache für die Entartung der Melanozyten, also für die Krebsentstehung.“"
                            },
                            {
                                "example_id": "ad99a9ae-9159-4c36-9873-aed364e34400",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "Regelmäßiger Zuckerkonsum zusammen mit mangelhafter Zahnpflege gelten als Hauptursache für Karies."
                            },
                            {
                                "example_id": "8478b3e2-b74f-4a6a-9d22-fe84a4c3ee8e",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Wirbelsäulenschäden sind besonders häufig geworden. Unsere vorwiegend sitzende Lebensweise und einseitige Belastungen gelten als die Hauptursachen.“"
                            },
                            {
                                "example_id": "59453754-f91f-487f-a8ea-02b872464030",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Im Londoner Stadtteil Brixton kommt es in der Nacht zum 12. April zu schweren Straßenschlachten zwischen der Polizei und zumeist schwarzen Jugendlichen.“ […] „Als Hauptursache der Unruhen gilt die besonders hohe Arbeitslosenquote in dem Stadtteil.“"
                            },
                            {
                                "example_id": "84defb56-8d95-41ed-96fd-b26170d10e28",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Was sind die Hauptursachen der weit verbreiteten Rückenschmerzen?“"
                            },
                            {
                                "example_id": "0a44b151-4f9e-45f5-9b7f-6c8e547e7f52",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Gingerol ist die Hauptursache des scharfen Geschmacks von Ingwer.“"
                            },
                            {
                                "example_id": "ac765522-e6f9-4994-aa06-1075cb3f3163",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Die Luftverschmutzung tötet in der Schweiz jedes Jahr fast 4000 Menschen vorzeitig. Die Hauptursache dafür ist der Strassenverkehr in den Städten.“"
                            },
                            {
                                "example_id": "6a20ee95-0c98-4861-9166-3e1577737ed2",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "[Desertifikation:] „Klimazyklen spielen bei der Wüstenbildung eine Rolle, doch eine der Hauptursachen für die Ausdehnung auch der Gobi ist der Mensch selbst.“"
                            },
                            {
                                "example_id": "24dfb289-e23c-4ad9-9705-1002710998de",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Eine der Hauptursachen für den Flüchtlingsstrom nach Europa ist der Krieg in Syrien.“"
                            },
                            {
                                "example_id": "b627276d-4ef2-46ea-9521-0d61b1f108f5",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "[Kuba:] „Die Wirtschaftskrise und die Abhängigkeit von den USA sind die Hauptursachen für die politischen Unruhen.“"
                            },
                            {
                                "example_id": "8c574765-64af-43b7-add2-36fe9c12308b",
                                "sense_id": "40bbf7bf-700f-3208-9e36-434e9f10a43b",
                                "text": "„Die Aufrechterhaltung unhaltbar gewordener gesellschaftlicher Strukturen sollte eine der Hauptursachen für die Französische Revolution werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
