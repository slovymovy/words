                                "target_senses": [
                                    {
                                        "sense_id": "c9e2d871-6838-38da-8cc1-25cb875c0aaa",
                                        "entry_id": "cfd5b5aa-7b61-336b-8ad9-026a7658d7cd",
                                        "glosses": [
                                            "Any of the yellow pigmentary particles, or minute corpuscles of yellow coloring matter, found in certain radiolarians."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e4387cb-6dc7-370a-9596-c2b5efda683f",
                                        "entry_id": "cfd5b5aa-7b61-336b-8ad9-026a7658d7cd",
                                        "glosses": [
                                            "Any of various typically yellow-brown dinoflagellates (originally grouped as genus Zooxanthella) now assigned to the genera Symbiodinium and Amphidinium, notably found in coral reefs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36e60569-3781-426d-a0d4-30a15de8f799",
                                                "sense_id": "1e4387cb-6dc7-370a-9596-c2b5efda683f",
                                                "text": "One genus, the zooxanthellae, live in symbiosis with tropical corals and other animals including clams, jellyfish and nudibranchs, providing in some cases as much as 90 per cent of the nutrients the anima needs in return for a safe home."
                                            },
                                            {
                                                "example_id": "54b721c9-59f7-4e4d-8367-84ee53143eba",
                                                "sense_id": "1e4387cb-6dc7-370a-9596-c2b5efda683f",
                                                "text": "The zooxanthellae produce carbohydrates, via photosynthesis, and the polyps harvest these carbohydrates, much as farmers harvest corn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
