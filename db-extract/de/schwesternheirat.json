                            {
                                "example_id": "93e6dfae-948b-4a18-85c9-7682cdb266c6",
                                "sense_id": "ec986960-2480-3a41-a0e4-41034b9ace0a",
                                "text": "„Die Einführung der Schwesternheirat war ein radikaler Bruch mit der Vergangenheit.“"
                            },
                            {
                                "example_id": "3a940644-a885-41ec-9f9e-e649dfb7c265",
                                "sense_id": "ec986960-2480-3a41-a0e4-41034b9ace0a",
                                "text": "„Diese Schwesternheirat bei Herrschern gab es auch bei anderen Völkern in den Anden.“"
                            },
                            {
                                "example_id": "75f271ee-9c01-4b30-adfb-4d071ba426ce",
                                "sense_id": "ec986960-2480-3a41-a0e4-41034b9ace0a",
                                "text": "„Die Folgen von Inzest hätten schließlich zu einem Verbot der Schwesternheirat geführt.“"
                            }
                        ],
