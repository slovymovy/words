    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d9cd974-9755-3c79-aaf8-022216d4a21a",
                    "sense_definition": "Provoquer une sensation d'irritation cutanée qui incite à se gratter.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette piqûre de moustique me <w>démange</w> énormément depuis ce matin."
                        },
                        {
                            "text": "Il applique une crème apaisante car son bras lui <w>démange</w> beaucoup."
                        }
                    ],
                    "synonyms": [
                        "gratter"
                    ]
                },
                {
                    "sense_id": "fc4c6e9c-1393-3122-9eee-6d24c3b3408c",
                    "sense_definition": "Susciter une forte envie, une impulsion irrépressible d'agir ou de parler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'envie de lui répondre franchement me <w>démange</w> depuis le début de la réunion."
                        },
                        {
                            "text": "Il voulait garder le secret, mais la langue lui <w>démangeait</w> tellement qu'il a tout avoué."
                        }
                    ],
                    "common_phrases": [
                        "démanger de faire"
                    ]
                },
                {
                    "sense_id": "49df33b9-ca72-3cec-ba9a-85b6f15e0232",
                    "sense_definition": "Avoir une tentation impatiente de frapper, de se battre ou d'en découdre physiquement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agressivite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Devant tant d'insolence, les mains lui <w>démangent</w> mais il préfère garder son calme."
                        },
                        {
                            "text": "Le boxeur attendait le début du combat et les poings lui <w>démangeaient</w> déjà."
                        }
                    ],
                    "common_phrases": [
                        "mains qui démangent"
                    ]
                }
            ]
        }
    ]
