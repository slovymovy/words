    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ac6ef383-aa57-32f9-9ff3-8d861a2679ff",
                "word": "trailing",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06c410b9-2d29-324f-8d79-ae129a5f78d5",
                        "entry_id": "ac6ef383-aa57-32f9-9ff3-8d861a2679ff",
                        "glosses": [
                            "That converge in the direction of travel."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "823bc457-d4c7-4d70-abab-64910ab9c1c7",
                                "sense_id": "06c410b9-2d29-324f-8d79-ae129a5f78d5",
                                "text": "On the far hillside we are approaching can be descried a bridge on the first section (Ruabon–Llangollen) of the important G.W.R. branch to Dolgelley, which will shortly join our main line by means of a trailing junction."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                        "entry_id": "ac6ef383-aa57-32f9-9ff3-8d861a2679ff",
                        "glosses": [
                            "That follows behind; especially, that is attached and pulled behind."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f522c3f3-4df8-42a4-b27e-4b5ba5523a5b",
                                "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                                "text": "the trailing railcars"
                            },
                            {
                                "example_id": "c093fef8-bbd7-4768-b799-c7987dc49de5",
                                "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                                "text": "the trailing comments"
                            },
                            {
                                "example_id": "09ad3e85-4d6c-483a-87a3-748ece012c9d",
                                "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                                "text": "no trailing whitespace characters"
                            },
                            {
                                "example_id": "18fca8f7-ed13-4723-b0d4-092abf6522d5",
                                "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                                "text": "On the long, continuous downgrades of East Africa dynamic braking is of special value; the traction motors are used as generators and their energy output dissipated in force-ventilated banks of resistors. This facility enables a 700-ton trailing load, for example, to be brought down a 1 in 66 gradient at any selected speed between 14 and 25 m.p.h. without use of the air brakes."
                            },
                            {
                                "example_id": "633605df-80a9-465f-9434-9ec8745073df",
                                "sense_id": "a3e75511-a010-3d4d-9c53-d15789ff6dd8",
                                "text": "Having reversed at Eastbourne, I am in the trailing car, which leaps and fishtails around so much on our way to Bexhill that I have trouble writing coherent notes."
                            }
                        ]
                    }
                ],
                "translations": [
