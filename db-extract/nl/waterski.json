                                        "sense_id": "de2291b2-9c15-3228-a859-a36bdea98847",
                                        "entry_id": "ae2a216a-2418-32cc-9392-1d500d5f8ad5",
                                        "glosses": [
                                            "Ski, der an die Anforderungen des Wasserskifahrens angepasst und daher besonders breit ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0345518-0d6d-4047-8f56-20515fed5486",
                                                "sense_id": "de2291b2-9c15-3228-a859-a36bdea98847",
                                                "text": "Dennis hat sein Zimmer mit alten Wasserski dekoriert."
                                            },
                                            {
                                                "example_id": "95ea25a5-418a-4c78-b04d-f3d2eb0363e7",
                                                "sense_id": "de2291b2-9c15-3228-a859-a36bdea98847",
                                                "text": "Wir arbeiten an der Entwicklung neuer Wasserskier."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wasserski",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                        "entry_id": "643e321b-88a6-3068-b4a3-5109603febb2",
                                        "glosses": [
                                            "Sportart, bei der eine Person sich auf Wasserskiern stehend von einem Boot oder einem Wasserskilift mittels einer Wasserskileine über die Wasseroberfläche ziehen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46205cd3-16d4-4b36-8f76-6c1854073d0d",
                                                "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                                "text": "„Der Leser findet Anregungen für Wandern, Bergsteigen, Radtouren, Malen, Reiten, Golf, Motorfliegen, Segeln, Wasserski, Paddeln, Angeln, Sprachkurse, Kochen und Photographieren.“"
                                            },
                                            {
                                                "example_id": "6bc8f9ba-cd3c-49d9-a1f7-a0235fa2bc09",
                                                "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                                "text": "Ella und Simone haben Spaß beim Wasserski."
                                            },
                                            {
                                                "example_id": "20624490-ca0e-4cb4-9530-1864092867d6",
                                                "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                                "text": "Das Wasserski ist mein neues Hobby."
                                            },
                                            {
                                                "example_id": "1c01ddd6-690c-4a1f-8933-945beed2092c",
                                                "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                                "text": "Im Wasserski ist Herr Schreiber ein Ass."
                                            },
                                            {
                                                "example_id": "f6a27331-893f-4957-b83c-a81d45d363cd",
                                                "sense_id": "4a5accf2-7de5-3bfd-92b3-dd13a9ce94f9",
                                                "text": "„Er mietete ein Motorboot, fuhr Wasserski mit ihr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
