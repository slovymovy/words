                        "examples": [
                            {
                                "example_id": "276ccb59-fc1d-4375-880b-4a43f441364e",
                                "sense_id": "94a9ae0b-6ceb-3c00-bf36-3b3673326435",
                                "text": "„„Nymphomaniac“ ist wie ein Buch dicht erzählt in Kapiteln mit Titeln wie „Delirium“, „Die kleine Orgelschule“ oder „Die östliche und die westliche Kirche“. Acht solcher Abschnitte gibt es, in denen von Trier kunstvoll von der Geschichte seiner Hauptfigur abgleitet und mit einer Collage aus Archivbildern Parallelen zu Fliegenfischen oder Musiktheorie zieht - und Joes Leben damit verknüpft und erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
