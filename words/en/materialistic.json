{
    "word_family": [
        "material",
        "materialism",
        "materialist",
        "materialistically",
        "materialize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9031fac0-1586-34c2-a2f1-7a9185f5492a",
                    "sense_definition": "Believing that money, possessions, and physical comfort are more important than spiritual or emotional values.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possessions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many critics argue that modern society has become far too <w>materialistic</w>.",
                            "target_lang_translations": {
                                "ru": "Многие критики утверждают, что современное общество стало слишком <w>материалистичным</w>."
                            }
                        },
                        {
                            "text": "She rejected that <w>materialistic</w> lifestyle and chose to live simply in the countryside.",
                            "target_lang_translations": {
                                "ru": "Она отвергла такой <w>меркантильный</w> образ жизни и предпочла простую жизнь в деревне."
                            }
                        }
                    ],
                    "synonyms": [
                        "consumerist",
                        "mercenary",
                        "acquisitive"
                    ],
                    "antonyms": [
                        "spiritual",
                        "idealistic"
                    ],
                    "common_phrases": [
                        "materialistic society",
                        "materialistic values",
                        "materialistic lifestyle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Считающий деньги, вещи и физический комфорт важнее духовных или эмоциональных ценностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материалистичный",
                                "target_lang_sense_clarification": "ориентированный на материальные блага"
                            },
                            {
                                "target_lang_word": "меркантильный",
                                "target_lang_sense_clarification": "расчётливый, ищущий материальной выгоды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b400f888-00d6-3393-8207-c6040eb8c53e",
                    "sense_definition": "Relating to or based on philosophical materialism, the theory that only physical matter exists.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor proposed a strictly <w>materialistic</w> view of the mind.",
                            "target_lang_translations": {
                                "ru": "Профессор предложил строго <w>материалистический</w> взгляд на природу разума."
                            }
                        },
                        {
                            "text": "Early scientists often developed a <w>materialistic</w> philosophy that rejected supernatural forces.",
                            "target_lang_translations": {
                                "ru": "Ранние учёные нередко развивали <w>материалистическую</w> философию, отвергавшую сверхъестественные силы."
                            }
                        }
                    ],
                    "synonyms": [
                        "physicalist"
                    ],
                    "antonyms": [
                        "idealist"
                    ],
                    "common_phrases": [
                        "materialistic philosophy",
                        "materialistic view",
                        "materialistic explanation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к философскому материализму или основанный на нём — учении о том, что существует только материя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "материалистический",
                                "target_lang_sense_clarification": "связанный с философией материализма"
                            },
                            {
                                "target_lang_word": "материалистичный",
                                "target_lang_sense_clarification": "основанный на материалистических взглядах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}