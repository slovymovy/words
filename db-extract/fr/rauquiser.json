                ],
                "senses": [
                    {
                        "sense_id": "82036ee2-eba6-3c02-a04a-b9ae9504cfab",
                        "entry_id": "ec8a758e-84da-387e-bd80-6473e5c17b0e",
                        "glosses": [
                            "Chanter ou parler d’une voix rauque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d6e7424-20ad-40c4-a834-8a71f2559818",
                                "sense_id": "82036ee2-eba6-3c02-a04a-b9ae9504cfab",
                                "text": "Dans Bleu les récurrentes sirènes se font à nouveau tentatrices, incarnées par la voix à la Mama Béa de Gaëlle qui « rauquise » et module, sur les battements de Stéphane Mikaelian, et les roulements de piano dignes de Chopin ou de Rachmaninoff."
                            },
                            {
                                "example_id": "898e9f56-3396-4673-a5c5-9e2e0985515d",
                                "sense_id": "82036ee2-eba6-3c02-a04a-b9ae9504cfab",
                                "text": "Mais rendons à son auteur en 1972 Randy Newman ce que, le temps de 9 semaines 1/2, Joe Cocker a « rauquisé » et Kim Basinger incarné, ce fantasme universel (vidéos en cliquant sur les liens bleus)."
                            },
                            {
                                "example_id": "4cbca241-d95c-4512-b212-88e9afb88a89",
                                "sense_id": "82036ee2-eba6-3c02-a04a-b9ae9504cfab",
                                "text": "Les diseurs se balancent en rauquisant."
                            },
                            {
                                "example_id": "8546db71-ca49-403b-b32f-bbd4b986cf4a",
                                "sense_id": "82036ee2-eba6-3c02-a04a-b9ae9504cfab",
                                "text": "Regardons toutes ces voix particulières : je citerais Peter Garett (Midnight Oil), crispant ou génial, Peter Gabriel, rauquisant à la limite mais toujours juste ou l'inimitable Freddy Mercury."
                            }
                        ]
                    }
                ],
