                    {
                        "translation_id": "7147e1c9-ec12-4213-9316-5c636a0556e2",
                        "source_entry_id": "3fd13085-137e-3119-b251-ae3df48dabda",
                        "source_sense_id": "ae023606-b9bb-36d6-83bb-06684708c6e2",
                        "target_lang_word": "regierungsfreundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regierungsfreundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4911d14-e0a8-3c3d-934f-5d7ed36e0f06",
                                        "entry_id": "a2b23831-db38-3e1d-904a-2e781f22ddad",
                                        "glosses": [
                                            "eine positive Einstellung zur Regierung aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c43ce4f3-4c6c-40e9-b2bd-38e1261327a2",
                                                "sense_id": "c4911d14-e0a8-3c3d-934f-5d7ed36e0f06",
                                                "text": "„Danach wurden alle Regionalblätter an Firmen verkauft, deren Eigentümer als regierungsfreundlich gelten.“"
                                            },
                                            {
                                                "example_id": "b4189b52-68f1-49d0-9655-39ee53d3ad0d",
                                                "sense_id": "c4911d14-e0a8-3c3d-934f-5d7ed36e0f06",
                                                "text": "„Die Kundgebungen richten sich auch gegen andere Missstände unter der Orban-Regierung, darunter die als einseitig und regierungsfreundlich kritisierte Berichterstattung des staatlichen Rundfunks, die Einschränkung der Wissenschaftsfreiheit und die Korruption rund um hochrangige Regierungsvertreter und ihre Familien.“"
                                            },
                                            {
                                                "example_id": "2c544c6a-e30c-4881-bf8b-3b2c6d526d88",
                                                "sense_id": "c4911d14-e0a8-3c3d-934f-5d7ed36e0f06",
                                                "text": "„Zwei Teile der türkischen Presse, einer blind regierungsfreundlich, der andere kontrolliert von unterwürfigen Medienmogulen, verbreiten seit Wochen dieselbe stereotype Nachricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
