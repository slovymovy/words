                        "examples": [
                            {
                                "example_id": "4db6ea34-f9bf-450f-93b6-b1583a419c68",
                                "sense_id": "f197b7a4-3d21-39b5-8e7a-a887df797d07",
                                "text": "S'appuyant sur les travaux de Max Knoll et Manfred von Ardenne dans les années 1930, la MEB consiste en un faisceau d’électrons balayant la surface de l’échantillon à analyser qui, en réponse, réémet certaines particules."
                            }
                        ]
