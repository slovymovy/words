                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88eb742-f31d-406e-928b-e7271064eb7b",
                                                "sense_id": "9b16c07e-1842-3c15-b927-95940f228c12",
                                                "text": "L’orthopédiste peut être amené à plâtrer l’enfant quelque temps pour une meilleure immobilisation."
                                            },
                                            {
                                                "example_id": "2b73fb71-7610-4cb7-ac8e-8460c5ca52ff",
                                                "sense_id": "9b16c07e-1842-3c15-b927-95940f228c12",
                                                "text": "Les orthopédistes arrivent très souvent, grâce à ce matériel et à leur compétence, à guérir complètement les séquelles des traumatismes les plus graves."
                                            }
                                        ]
                                    }
                                ]
                            },
