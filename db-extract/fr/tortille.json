                    {
                        "sense_id": "ec06c1dc-2de2-3f40-ade2-5a9e59a4f285",
                        "entry_id": "e97bd37c-8bac-39aa-9959-37a264d94ec1",
                        "glosses": [
                            "Allée étroite et tortueuse d'un parc ou d'un sous-bois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "993cccb0-cf23-4d01-8175-b02ef63bd308",
                                "sense_id": "ec06c1dc-2de2-3f40-ade2-5a9e59a4f285",
                                "text": "Les deux promeneurs s'enfonçaient dans Central Park; un chemin asphalté par ici, une sente pierreuse par là, une tortille boueuse sous les arbres, ils avançaient sans réfléchir, le visage couvert de fines gouttelettes d'eau."
                            }
                        ]
                    }
                ],
