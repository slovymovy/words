                                        "entry_id": "ba6418ad-1f39-361b-9b22-5de9840f1198",
                                        "glosses": [
                                            "птенец лебедя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e7a1ac-bb2b-43a7-9940-3980ecef6341",
                                                "sense_id": "349be78e-e870-3a49-aa65-a883ed3a700c",
                                                "text": "Подрастут лебедята, — отец с матерью выведут их сперва на воду, а потом начнут учить летать."
                                            }
                                        ]
                                    }
                                ]
