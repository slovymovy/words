{
    "word_family": [
        "détail",
        "détaillant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c1fa6fc0-dc6d-32ae-baac-6bb27ea4906b",
                    "sense_definition": "Exposer, raconter ou expliquer quelque chose point par point, avec précision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a pris le temps de <w>détailler</w> son projet de loi devant les journalistes."
                        },
                        {
                            "text": "Dans son rapport, elle <w>détaille</w> les étapes nécessaires pour achever les travaux à temps."
                        }
                    ],
                    "synonyms": [
                        "exposer",
                        "raconter"
                    ],
                    "common_phrases": [
                        "détailler les étapes",
                        "détailler un plan"
                    ]
                },
                {
                    "sense_id": "64f7a0c8-8b8a-3308-8f21-5ee3a9009f27",
                    "sense_definition": "Couper ou découper un aliment ou une matière en petits morceaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de préparer la soupe, il faut <w>détailler</w> les carottes et les courgettes en petits dés."
                        },
                        {
                            "text": "Le chef cuisinier <w>détaille</w> la viande avec un couteau bien aiguisé."
                        }
                    ],
                    "synonyms": [
                        "couper"
                    ],
                    "common_phrases": [
                        "détailler en dés",
                        "détailler la viande"
                    ]
                },
                {
                    "sense_id": "0fdac11d-3bc4-3e1e-88d1-67ab36eecd52",
                    "sense_definition": "Observer attentivement une personne ou une chose dans tous ses aspects.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle entra dans la pièce et le <w>détailla</w> de la tête aux pieds avec curiosité."
                        },
                        {
                            "text": "L'expert <w>détaille</w> le tableau ancien afin d'en vérifier l'authenticité."
                        }
                    ],
                    "common_phrases": [
                        "détailler du regard",
                        "détailler de la tête aux pieds"
                    ]
                },
                {
                    "sense_id": "92caf58c-9aab-3d61-8eb5-2c09426c6de8",
                    "sense_definition": "Vendre des marchandises à la pièce ou en petite quantité, par opposition à la vente en gros.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce commerçant achète les produits en gros pour ensuite les <w>détailler</w> dans sa boutique."
                        },
                        {
                            "text": "Ne pouvant pas écouler tout son stock en une fois, il a décidé de le <w>détailler</w> au marché."
                        }
                    ],
                    "synonyms": [
                        "débiter"
                    ],
                    "common_phrases": [
                        "détailler des marchandises"
                    ]
                }
            ]
        }
    ]
}