                                    {
                                        "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                                        "entry_id": "0dbf126b-8f43-3940-8c55-dbbb77720eeb",
                                        "glosses": [
                                            "Instructions for how to reach a destination or how to do something"
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "872648d9-951c-4edb-8c8d-a8ef9d9bb9e2",
                                                "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                                                "text": "Please follow the attached directions when assembling these shelves."
                                            },
                                            {
                                                "example_id": "8ded1ed2-4881-4ab4-a864-79291089f363",
                                                "sense_id": "ded0c5c5-013b-3cd0-9c1a-9a91529fe267",
                                                "text": "I got so lost on my way downtown I had to ask for directions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74874f13-d05e-4fef-bc1b-30c886a1fddb",
                        "source_entry_id": "238db581-e48c-3f86-9a6f-87d6e39acdf8",
                        "source_sense_id": "d1b4a314-93b5-3e55-a481-1f710b4cf48d",
                        "target_lang_word": "instructions",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instructions",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bbf6bca-4390-3714-8b2c-81429b011b38",
                                        "entry_id": "71c6ed64-9c24-350c-ae86-ea2887a6f033",
