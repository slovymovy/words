                ],
                "senses": [
                    {
                        "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                        "entry_id": "6777514a-fd09-342e-bb72-15d8c10603d4",
                        "glosses": [
                            "Prozess der Bildung und Anreicherung von organischem Material im Boden (meist aus Pflanzenresten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a26b8b-f74b-4fa8-9696-ffaa984daa99",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„[Die ökologische Landwirtschaft] setzt auf Humusaufbau, verzichtet auf synthetische Dünger und Pestizide und vermeidet Importe von Tierfutter aus Übersee.“"
                            },
                            {
                                "example_id": "2ee8dcbc-2f7d-4c9c-a57b-f45967b16800",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "[Carbon Farming:] „Statt auf Bäume im Globalen Süden setzt dieser Ansatz auf den Humusaufbau in der heimischen Landwirtschaft.“"
                            },
                            {
                                "example_id": "d26eb9df-c2c1-4126-bd2d-1847af883537",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Bei einem weltweiten Humusaufbau könnten weitere zwei bis fünf Milliarden Tonnen CO2 pro Jahr gebunden werden, das zeigt eine aktuelle Studie der Stiftung Wissenschaft und Politik (SWP).“"
                            },
                            {
                                "example_id": "c355d4a2-9453-4585-8b42-a0ea99bd681b",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Allein durch Humusaufbau könnten Böden in den nächsten Jahren bis zu 1 t Kohlenstoff pro ha und Jahr auf Dauer festlegen.“"
                            },
                            {
                                "example_id": "cd499817-4db2-40bc-9663-b2dbf04bd1a7",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Humusaufbau ist also ein wirksamer Mechanismus, um das schädliche Treibhausgas CO2 dauerhaft aus der Atmosphäre zu entnehmen und den darin enthaltenen Kohlenstoff im Boden zu binden.“"
                            },
                            {
                                "example_id": "97dc0b89-e436-4def-92b1-0722f8d35352",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„In der Fruchtfolge trägt Ackergras zum Humusaufbau und – vor allem bei mehrjähriger Kultur – zur Unterdrückung von Unkräutern bei.“"
                            },
                            {
                                "example_id": "ff2feccc-e8df-4eef-8923-a01b67cb5c81",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Demnach hat die Biokohle, neben der langfristigen CO₂-Bindung, noch weitere sehr beachtliche Vorteile. Mischt man sie in den Dünger, hilft sie beim Humusaufbau.“"
                            },
                            {
                                "example_id": "69500f4d-95cd-4b6d-a5da-a043f8e55432",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Wird Pflanzenkohle in den Dünger gemischt, kann sie beim Humusaufbau helfen.“"
                            },
                            {
                                "example_id": "37e60ded-8a63-4c19-aa24-5741c0c52297",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Gelingt hingegen der Humusaufbau, können wirtschaftliche und ökologische Erfolge Hand in Hand gehen.“"
                            },
                            {
                                "example_id": "ff985c2c-f4f5-47eb-8dac-7235d59ffce3",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Die gängige Form der Landwirtschaft stehe dem Humusaufbau aber entgegen: »Wir haben im Acker oft Perioden, wo überhaupt keine Pflanze da steht: Im Herbst, im Winter ist alles brach und kahl. […].«“"
                            },
                            {
                                "example_id": "db460f64-a6bb-40d4-95e4-e788f7b6951e",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Humusaufbau mit tierischem Dünger könne zu einer \"Luftbuchung\" werden, da die Tiere ihrerseits Emissionen erzeugen.“"
                            },
                            {
                                "example_id": "f7cc7b17-94fe-4462-8699-9e4ff0cd4324",
                                "sense_id": "4199a005-f041-3aa3-9ac0-978c0deeacf3",
                                "text": "„Den Landwirten wird hier mit wissenschaftlicher Begleitung demonstriert, wie Humusaufbau funktionieren kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
