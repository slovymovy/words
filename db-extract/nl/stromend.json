                "senses": [
                    {
                        "sense_id": "a1e7d7f5-9794-32af-8f11-e72f80555e6e",
                        "entry_id": "ede9e1fa-14ec-3f3b-82d0-929fc3e6dd9f",
                        "glosses": [
                            "van water: voortbewegend, vallend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd8601c-9f31-4ed7-8300-54a835d4364f",
                                "sense_id": "a1e7d7f5-9794-32af-8f11-e72f80555e6e",
                                "text": "Zo werd vanochtend, in de stromende regen, een feesttent opgebouwd waar supporters na afloop een eventuele promotie kunnen vieren."
                            },
                            {
                                "example_id": "41018f2e-0fbb-4835-95d3-1b69afdf226d",
                                "sense_id": "a1e7d7f5-9794-32af-8f11-e72f80555e6e",
                                "text": "Een aantal mensen werd levend uit de sterk stromende en druk bevaren rivier gehaald."
                            }
                        ]
                    }
                ],
