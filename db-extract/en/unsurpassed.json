                    {
                        "translation_id": "aaba9e41-007d-48e0-9165-54268462f869",
                        "source_entry_id": "36728562-fac3-3615-8895-81143e3ad7bc",
                        "source_sense_id": "45804a7a-62cb-3496-b24c-c4254e147284",
