                                        "entry_id": "a65afd3a-d860-31e9-8be7-a145798a6986",
                                        "glosses": [
                                            "The state of being or having a body (being corporal/corporeal); bodily existence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9284c6-b67a-492f-a5a5-f7757ccfa3fb",
                                                "sense_id": "68fb4ad8-4a46-30ec-bf7b-37c0814df6d4",
                                                "text": "there is one Mundane spright / And body, vitall corporality We have from hence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aa431e6-6ef3-3a24-a588-09ab1d66f218",
                                        "entry_id": "a65afd3a-d860-31e9-8be7-a145798a6986",
                                        "glosses": [
                                            "A confraternity; a guild."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e4724d6-ca1a-4067-ab5c-ba7bbdbee63f",
                                                "sense_id": "2aa431e6-6ef3-3a24-a588-09ab1d66f218",
                                                "text": "Whence may be guessed what their function was : was it to go about circled with a band of rooking officials , with cloakbags full of citations , and processes to be served by a corporality of griffonlike promoters and apparitors ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
