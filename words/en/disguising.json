                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval <w>disguising</w> featured grand costumes, lively music, and theatrical dancing.",
                            "target_lang_translations": {
