                "translations": [
                    {
                        "translation_id": "bf012f57-fce5-465a-b2b2-e743bf5a7a09",
                        "source_entry_id": "b670e357-b57b-37e4-88de-884e77bff469",
                        "source_sense_id": "67f0f7f7-d7d2-365f-bbdc-168639d5bc38",
                        "source_sense_description": "weibliche Person, die die Intressen von jemand anderem vertritt",
                        "target_lang_word": "Agentin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agentin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8aa78c-a61c-3344-9f77-cedf9ed1cc79",
                                        "entry_id": "97d5d04e-ddb9-3390-b2a5-8125780ac968",
                                        "glosses": [
                                            "weibliche Person, die Vermittlungsdienstleistungen für ihre Kunden erbringt, insbesondere für Künstler, Schriftsteller, Sportler; allgemein Vermittlerin, Handelsvertreterin"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fe28a70-3e78-454d-9c22-350e2a87ed13",
                                                "sense_id": "4e8aa78c-a61c-3344-9f77-cedf9ed1cc79",
                                                "text": "Hauptberuflich arbeitet sie als Agentin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                        "entry_id": "97d5d04e-ddb9-3390-b2a5-8125780ac968",
                                        "glosses": [
                                            "weibliche Person, die im Staatsauftrag oder im Auftrag einer Organisation im Geheimen tätig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225ca31c-2127-4c40-a071-66b3074b33e4",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "Die Tarnung der Agentin ist aufgeflogen."
                                            },
                                            {
                                                "example_id": "230af63c-f552-4290-bda8-1e3841341396",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "„Möglicherweise war sie eine Agentin, vielleicht auch eine Luxushure – oder auch schlicht ein Flittchen.“"
                                            },
                                            {
                                                "example_id": "76e1158c-7b7d-49c1-a88d-3c68e58ea155",
                                                "sense_id": "3014586b-075e-339c-bbcf-dd7963a9fabf",
                                                "text": "„Hier saßen sie zu Haufen, Agenten und Agentinnen, die in Luxus und Wohlstand ihr ebenso gemeines wie idiotisches Handwerk betrieben –im Namen der jeweiligen Vaterländer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02e782ed-228c-4fde-b1e5-beb66e7054c6",
                        "source_entry_id": "b670e357-b57b-37e4-88de-884e77bff469",
                        "source_sense_id": "67f0f7f7-d7d2-365f-bbdc-168639d5bc38",
                        "source_sense_description": "weibliche Person, die die Intressen von jemand anderem vertritt",
                        "target_lang_word": "Vertreterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vertreterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                                        "glosses": [
                                            "weibliche Person, die für andere in bestimmten Angelegenheiten an deren Stelle handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084b0d20-ec3e-45dd-a304-38b06194cb2f",
                                                "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                                                "text": "„Hainisch gelang die Einbindung des Bunds in den International Council of Women (ICW); sie war als österreichische Vertreterin bei internationalen Frauenkonferenzen des ICW in Berlin und Toronto anwesend.“"
                                            },
                                            {
                                                "example_id": "35d08605-ab9f-43be-8f2c-84d7366412db",
                                                "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                                                "text": "„Österreichs Vertreterin Zoë startet dabei mit Startnummer 24 und somit als Drittletzte in den Bewerb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "211aee60-1160-36c5-a849-8b75db1b8bbe",
                                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                                        "glosses": [
                                            "Verkäuferin"
                                        ],
                                        "tags": [
                                            "von ^([1]) abgeleitet",
                                            "auf den Verkauf beschränkt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c288185e-2cea-405e-9b1f-0f9d1be15fc8",
                                                "sense_id": "211aee60-1160-36c5-a849-8b75db1b8bbe",
                                                "text": "„Einmal im Jahr lädt der Versicherungskonzern unter dem Namen seines ehemaligen Chefs seine erfolgreichsten Vertreterinnen und Vertreter aus Deutschland ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f044bdb6-b7c9-33fb-b99e-173a76819969",
                                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                                        "glosses": [
                                            "weibliche Person, die eine bestimmte (Denk-)Richtung repräsentiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de877bb-7091-43fc-b1cd-5ccfb2054110",
                                                "sense_id": "f044bdb6-b7c9-33fb-b99e-173a76819969",
                                                "text": "„Hildegard Joos, * 7. Mai 1909 Wien, † 17. Jänner 2005 Wien, Künstlerin, Vertreterin des Konstruktivismus, betrieb ab 1959 mit ihrem Mann Harold Joos ein Atelier in Paris.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab7e8837-c28f-472f-bc47-b781b14d4c2b",
                        "source_entry_id": "b670e357-b57b-37e4-88de-884e77bff469",
                        "source_sense_id": "67f0f7f7-d7d2-365f-bbdc-168639d5bc38",
