                "senses": [
                    {
                        "sense_id": "81a73d83-dbf6-36d7-ba9c-af9daa878585",
                        "entry_id": "becf225d-285f-30d6-8c4a-776bb32a4c4b",
                        "glosses": [
                            "Verlieren von Teilen der Historie, die eine Existenz begreiflich und nachvollziehbar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "996e53d3-60a9-49ea-a9b3-194f8da6843e",
                                "sense_id": "81a73d83-dbf6-36d7-ba9c-af9daa878585",
                                "text": "„Einerseits hat er als erster auf den drohenden Geschichtsverlust gerade durch die Historisierung hingewiesen. Andererseits hat er selbst diesem Geschichtsverlust durch seinen Zarathustra - Mythos entgegenarbeiten wollen.“"
                            },
                            {
                                "example_id": "685206c6-c87b-4001-bc55-343b053c003d",
                                "sense_id": "81a73d83-dbf6-36d7-ba9c-af9daa878585",
                                "text": "„Eine andere Gestalt hiervon ist der Geschichtsverlust. Habe ich einen Beruf ergriffen, z. B. den eines Setzers, und verschwindet er im Verlauf der geschichtlichen Entwicklung, so ist das konkreter Geschichtsverlust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
