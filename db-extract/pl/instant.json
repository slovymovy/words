                "translations": [
                    {
                        "translation_id": "d7c54157-e10c-4e99-8129-363dbcf9d51a",
                        "source_entry_id": "ee4bdefc-4531-3ba1-9407-1e3ef11eeadd",
                        "source_sense_id": "45af002e-6b6a-382c-820e-ca3019d19e8e",
