                "senses": [
                    {
                        "sense_id": "fbb9bfc8-2983-398f-b2ea-f9092f239e3f",
                        "entry_id": "b1907c14-0ff3-3852-9136-355bf9c5f2bf",
                        "glosses": [
                            "een duivenhok op een paal of boven een gebouw uitstekend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f785c2-f1c8-4057-84d4-72c7e1600f89",
                                "sense_id": "fbb9bfc8-2983-398f-b2ea-f9092f239e3f",
                                "text": "De duiventil werd bewoond door twee duiven."
                            },
                            {
                                "example_id": "e0824301-1249-4bb7-8812-765cdbbfeb05",
                                "sense_id": "fbb9bfc8-2983-398f-b2ea-f9092f239e3f",
                                "text": "Langs de achtermuur van de manor leidde een kronkelend paadje naar de tuin en een duiventil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53d95bb0-5f31-406b-9941-f89d10b48379",
                        "source_entry_id": "b1907c14-0ff3-3852-9136-355bf9c5f2bf",
                        "source_sense_id": "fbb9bfc8-2983-398f-b2ea-f9092f239e3f",
                        "source_sense_description": "een duivenhok op een paal of boven een gebouw uitstekend",
                        "target_lang_word": "Taubenschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taubenschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                        "entry_id": "5823d365-4104-3c9d-83ff-745a05399f37",
                                        "glosses": [
                                            "Verschlag, der Haustauben Schutz vor Witterungseinflüssen und natürlichen Feinden bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d282d4b6-a3dc-468f-a7b8-756e77ec81d1",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "Auf der Flucht vor einem Habicht konnte sich die Taube in den Taubenschlag retten."
                                            },
                                            {
                                                "example_id": "69e584e9-96a8-4d01-8ab3-d14c3f2cbd37",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Er forderte von der Stadt eine vorübergehende Aufhebung des Fütterungsverbotes und neue Taubenschläge zur kontrollierten Haltung der Vögel, um deren \"Leid\" in den Griff zu bekommen.“"
                                            },
                                            {
                                                "example_id": "e39b3944-6a6c-431e-b908-04699a9a290d",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Kosole erzählt, dass er heute Nachmittag seinen Taubenschlag reparieren will.“"
                                            },
                                            {
                                                "example_id": "c384c44f-17c1-45ea-8945-0401cd51d066",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„In einer Ecke des Hühnerhofs wurde ein Taubenschlag aufgestellt.“"
                                            },
                                            {
                                                "example_id": "2c2ac939-ad5f-479a-a5f6-6e1ff14e3451",
                                                "sense_id": "252f8a45-e619-33e3-a7ec-ff71377957db",
                                                "text": "„Die Welle der Kelter erschien ihnen riesenhaft; dann stiegen sie in den Taubenschlag hinauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a68b364f-8baa-485a-baff-906ccd391cd9",
                        "source_entry_id": "b1907c14-0ff3-3852-9136-355bf9c5f2bf",
