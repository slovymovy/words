                "translations": [
                    {
                        "translation_id": "09027d23-6711-4f6e-a93f-4e9c210bc928",
                        "source_entry_id": "3c6f92bc-802c-3bf4-a5ed-3212c641698a",
                        "source_sense_id": "4228d617-73ce-326f-80ca-be8ad6a9535c",
                        "target_lang_word": "sinigrin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinigrin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5883cd1f-13eb-3b0b-bf23-4d7a2ce79113",
                                        "entry_id": "76487e21-e494-3ff1-b884-c005ac794b68",
                                        "glosses": [
                                            "A glycosinolate glycoside found in many brassicas and related plants which is toxic in large quantities and responsible for the pungent bite of horseradish and hot mustard."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb5ba6b8-c6cf-4fbc-9ad3-07ebefbd9d23",
                                                "sense_id": "5883cd1f-13eb-3b0b-bf23-4d7a2ce79113",
                                                "text": "When these larvae are transferred to an artificial diet lacking sinigrin, they refuse to eat and, in fact prefer to die rather than accept food lacking what has become an essential attractant."
                                            },
                                            {
                                                "example_id": "afd1b304-3e31-4fb6-b23b-5ba80ffc4189",
                                                "sense_id": "5883cd1f-13eb-3b0b-bf23-4d7a2ce79113",
                                                "text": "He also found that pea leaf powder treated with sinigrin gave no significantly different feeding response when compared with the effect of introducing normal leaf powder into the diet."
                                            },
                                            {
                                                "example_id": "3137db7d-c056-4e52-909d-6fb49ab6400a",
                                                "sense_id": "5883cd1f-13eb-3b0b-bf23-4d7a2ce79113",
                                                "text": "In black mustard plants, individuals producing higher levels of the phytochemical sinigrin, a compound that reduces fungal densities in the soil, are good competitors against other species that rely on soil fungi for nutrient acquisition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
