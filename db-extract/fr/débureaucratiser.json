                ],
                "senses": [
                    {
                        "sense_id": "0442f63d-53ba-3b5b-a2a9-4f5ba72040d6",
                        "entry_id": "44be9aaa-21b3-3ec0-b419-8814248e6a6e",
                        "glosses": [
                            "Faire perdre son caractère bureaucratique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d88d8a-0c81-46f6-a32b-9672fc158997",
                                "sense_id": "0442f63d-53ba-3b5b-a2a9-4f5ba72040d6",
                                "text": "L’État devra continuer de se débureaucratiser."
                            },
                            {
                                "example_id": "ca75a839-de01-4875-8842-3dada7a57472",
                                "sense_id": "0442f63d-53ba-3b5b-a2a9-4f5ba72040d6",
                                "text": "Il faut donc désindustrialiser pour débureaucratiser. Il faut déprofessionnaliser l’exercice des fonctions thérapeutiques pour rendre à l’individu son autonomie et son libre choix."
                            },
                            {
                                "example_id": "cf254fa5-af55-4a02-9910-aba4d18ccfc0",
                                "sense_id": "0442f63d-53ba-3b5b-a2a9-4f5ba72040d6",
                                "text": "«Débureaucratiser», c'était un vocable à coucher dehors, mais il permettait d'éviter «déficit zéro» (de Bouchard) ou «réingénierie» (de Charest)."
                            }
                        ]
                    }
                ],
