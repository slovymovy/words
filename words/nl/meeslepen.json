{
    "word_family": [
        "slepen",
        "meeslepend",
        "sleep",
        "gesleep"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de134a52-bf03-3677-95ee-d78b863e3f19",
                    "sense_definition": "iets of iemand over de grond trekkend met zich meenemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek slepen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke stroming van de rivier kon de zware takken gemakkelijk <w>meeslepen</w> naar de zee.",
                            "target_lang_translations": {
                                "en": "The river's strong current could easily <w>drag</w> the heavy branches along to the sea."
                            }
                        },
                        {
                            "text": "Je moet niet al die onnodige spullen <w>meeslepen</w> tijdens onze lange wandeling door het bos.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>lug</w> all those unnecessary things along during our long walk through the forest."
                            }
                        }
                    ],
                    "synonyms": [
                        "meevoeren",
                        "meenemen"
                    ],
                    "common_phrases": [
                        "spullen meeslepen",
                        "bagage meeslepen"
                    ],
                    "target_lang_definitions": {
                        "en": "to take something or someone along by pulling them over the ground"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drag along",
                                "target_lang_sense_clarification": "pulling something heavy or unwilling"
                            },
                            {
                                "target_lang_word": "carry along",
                                "target_lang_sense_clarification": "to take something with you, often with effort"
                            },
                            {
                                "target_lang_word": "lug around",
                                "target_lang_sense_clarification": "carrying heavy things unnecessarily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1afa4c77-bc28-3ff3-8db8-7dc15f6228d0",
                    "sense_definition": "emotioneel of mentaal volledig in beslag genomen worden door iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotionele impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We lieten ons volledig <w>meeslepen</w> door de spannende gebeurtenissen in de film.",
                            "target_lang_translations": {
                                "en": "We let ourselves get completely <w>carried away</w> by the exciting events in the movie."
                            }
                        },
                        {
                            "text": "Het is makkelijk om je te laten <w>meeslepen</w> door emoties wanneer je boos bent.",
                            "target_lang_translations": {
                                "en": "It is easy to let yourself be <w>swept away</w> by emotions when you are angry."
                            }
                        }
                    ],
                    "synonyms": [
                        "meevoeren",
                        "begeesteren",
                        "enthousiasmeren"
                    ],
                    "common_phrases": [
                        "laten meeslepen",
                        "door emoties meeslepen"
                    ],
                    "target_lang_definitions": {
                        "en": "to be completely absorbed or carried away emotionally or mentally by something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get carried away",
                                "target_lang_sense_clarification": "losing self-control due to excitement or emotion"
                            },
                            {
                                "target_lang_word": "sweep away",
                                "target_lang_sense_clarification": "to be overwhelmed by a strong feeling or movement"
                            },
                            {
                                "target_lang_word": "enthrall",
                                "target_lang_sense_clarification": "to capture the fascinated attention of"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}