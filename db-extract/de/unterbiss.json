                "senses": [
                    {
                        "sense_id": "c2dc2eab-dc7e-30af-8ab4-160baa6c2757",
                        "entry_id": "10c5be8a-3b93-3ca3-b71b-c6f5f207233e",
                        "glosses": [
                            "im Vergleich zur oberen vorgeschobene Position der unteren Zahnreihe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e804ad2-16c5-4247-bdb8-391c2038183e",
                                "sense_id": "c2dc2eab-dc7e-30af-8ab4-160baa6c2757",
                                "text": "„Er schob den Unterkiefer ein wenig vor, der Unterbiss ähnelte Hjartvards, und im Dialekt der Suduroy sagte er, Hjartvard solle einfach geradeaus gehen, drei Arschlöcher links wäre das Gamle Danmark.“"
                            },
                            {
                                "example_id": "c2c937f5-89cf-469c-85cc-3a649a68648e",
                                "sense_id": "c2dc2eab-dc7e-30af-8ab4-160baa6c2757",
                                "text": "„Trotz seiner nur 29 Jahre hatte Popper bereits schüttere Haare, die er mit einem gepflegten Vollbart zu kompensieren versuchte, der seinen kräftigen Unterbiss nur teilweise verdeckte.“"
                            },
                            {
                                "example_id": "ae8c65db-675b-4e07-861f-652030235964",
                                "sense_id": "c2dc2eab-dc7e-30af-8ab4-160baa6c2757",
                                "text": "„Über dem blassen Mädchen, das mich mit seinen graublauen Augen und dem eckigen Unterbiss an Astrid aus dem Aufbaugymnasium erinnerte, die unvermeidlichen Plakate.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
