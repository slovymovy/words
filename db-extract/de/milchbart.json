                    {
                        "translation_id": "84505b87-701c-4a8b-903b-28cef62c98c9",
                        "source_entry_id": "6949d714-5822-31d8-8979-435eb747e434",
                        "source_sense_id": "6321688d-cf94-3147-acaf-afea00bb41a7",
