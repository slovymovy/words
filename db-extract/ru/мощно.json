                "translations": [
                    {
                        "translation_id": "c7eff8e6-ff62-4522-b1a7-cdff0c2c6458",
                        "source_entry_id": "7cbdf1a6-a832-385a-813b-b26fc763ee38",
                        "source_sense_id": "6d518047-2cf8-3162-97a5-1b2e542b16e5",
                        "target_lang_word": "potentemente",
                        "target_lang_code": "es",
