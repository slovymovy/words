                        "examples": [
                            {
                                "example_id": "9a4abaaf-e292-4510-8a6a-1a160422e8d9",
                                "sense_id": "b3984429-baeb-3feb-9448-a30c96f25040",
                                "text": "„Marcs Bett wollte ihn nicht loslassen, aber die Freude an der Sonne und dem wunderschönen Augustwetter war stärker.“"
                            },
                            {
                                "example_id": "32ea949a-b0ac-4c5e-9e03-d9535f9e3a67",
                                "sense_id": "b3984429-baeb-3feb-9448-a30c96f25040",
                                "text": "„Das Augustwetter wurde fast uneingeschränkt von Hochdrucklagen beherrscht, die an vielen Orten Höchsttemperaturen brachten.“"
                            },
                            {
                                "example_id": "2d7d00e2-e147-4895-bac9-fc8c275b12c4",
                                "sense_id": "b3984429-baeb-3feb-9448-a30c96f25040",
                                "text": "„Wir hatten herrliches Augustwetter, und ich hatte eine kleine Nische mit dunklem Sand gefunden, keine drei Minuten vom Haus entfernt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
