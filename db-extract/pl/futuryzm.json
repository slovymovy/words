                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c938ffe-390c-43a5-ac37-9a843b36a414",
                        "source_entry_id": "c1a0cbd3-532a-3f5a-a2a5-cf30128cbc47",
                        "source_sense_id": "879723e6-c81b-351f-82a3-ee0f40187360",
                        "target_lang_word": "futurisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futurisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e01c0fbf-51cb-33da-b5ed-e452babbfa64",
                                        "entry_id": "311d14e5-7992-38cb-8b92-6d8918a890e5",
                                        "glosses": [
                                            "Mouvement littéraire et artistique qui rejette la tradition esthétique et exalte le monde moderne, en particulier la civilisation urbaine, les machines et la vitesse."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d123e77e-8d64-4b60-9516-431563b47404",
                                                "sense_id": "e01c0fbf-51cb-33da-b5ed-e452babbfa64",
                                                "text": "Le futurisme est certainement l’un des mouvements d’avant-garde qui a le plus choqué. Il prône en effet l’amour de la vitesse, de la violence, de la machine, le mépris de la femme, la guerre « comme seule hygiène du monde »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c30268a-50c4-32c2-81a5-6d23ef0a9454",
                                        "entry_id": "311d14e5-7992-38cb-8b92-6d8918a890e5",
                                        "glosses": [
                                            "Qui a un caractère futuriste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbc490d-9ada-4c7c-b125-7ff7c91a10c4",
                                                "sense_id": "8c30268a-50c4-32c2-81a5-6d23ef0a9454",
                                                "text": "J’arrivais sans le savoir en plein futurisme. Le monde n’était que vitesse, celle des pas, des trains, des balles, des changements de fortune ou d’alliances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7407951a-9f35-4948-b9ce-765135c2554e",
                        "source_entry_id": "c1a0cbd3-532a-3f5a-a2a5-cf30128cbc47",
