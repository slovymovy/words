                        ],
                        "form": "sparkier"
                    },
                    {
                        "form_id": "46b5dfd7-08d7-4d2a-b309-8269b0b18822",
                        "entry_id": "2cdcf6be-b293-3c13-972f-0bc98c74a73c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "sparkiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                        "entry_id": "2cdcf6be-b293-3c13-972f-0bc98c74a73c",
                        "glosses": [
                            "Lively and animated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3867122f-b6fb-4470-a2d2-4b2edee5748d",
                                "sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                                "text": "1986 July, Texas Monthly, page 103,\nAnthony's certainly hasn′t achieved the consistent level of Tony′s, but the menu is sparkier, more up to the minute."
                            },
                            {
                                "example_id": "619cbe2f-ce1d-481b-a710-d7715ea8ee45",
                                "sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                                "text": "With regular trains running back to Edinburgh as late as 11.30pm, you could consider sampling some of Glasgow′s nightlife, consistently sparkier and more cutting-edge than Edinburgh′s, or taking in some of the city′s innovative and high-quality theatre and live music."
                            },
                            {
                                "example_id": "36a4d0a4-5bb1-45af-bd21-8c0e83e7703b",
                                "sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                                "text": "She was recruited on the spot, completing a highly controversial line-up that would go on to produce some of the sparkiest, sassiest music of the early 80s."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e47d06-43ec-4957-a02f-4ac1502728aa",
                        "source_entry_id": "2cdcf6be-b293-3c13-972f-0bc98c74a73c",
                        "source_sense_id": "065ab9e8-f885-3766-b7cb-ecd109d8460c",
                        "source_sense_description": "Lifely, animated",
                        "target_lang_word": "anregend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anregend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb799322-119c-3a51-b4da-04f578ecf420",
                                        "entry_id": "94e9124a-c5eb-38d3-b5ea-c7fbbc930996",
                                        "glosses": [
                                            "ein motivierendes und ermunterndes Gefühl erzeugend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6b9ea1-2079-47b9-95fd-cc83156a5b33",
                                                "sense_id": "cb799322-119c-3a51-b4da-04f578ecf420",
                                                "text": "Eine gute Unterhaltung kann wirklich anregend sein."
                                            },
                                            {
                                                "example_id": "f447f10c-8bda-4bbf-99b1-d4107945bb17",
                                                "sense_id": "cb799322-119c-3a51-b4da-04f578ecf420",
                                                "text": "Kaffee ist ein angenehm anregendes Getränk."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "anregend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
