                    {
                        "sense_id": "879a3c53-ec5b-3c00-b0e4-28628ab971ae",
                        "entry_id": "f7e21c0e-1672-342e-9dcf-e222db4126da",
                        "glosses": [
                            "in eine Matrix eingebettete, Millimeter große Körner aus Silikat in undifferenzierten Meteoriten, sogenannten Chondriten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5aa21762-3e84-4391-ad64-92d53773d136",
                                "sense_id": "879a3c53-ec5b-3c00-b0e4-28628ab971ae",
                                "text": "Chondrite bestehen bis zu achtzig Prozent aus Chondren."
                            },
                            {
                                "example_id": "cb632561-7700-4916-9e4c-d5070b1246d1",
                                "sense_id": "879a3c53-ec5b-3c00-b0e4-28628ab971ae",
                                "text": "Kleine Chondren sind fast exakt kugelförmig, größere Chondren, besonders wenn sie eng nebeneinander liegen, meist weniger regelmäßig ausgebildet."
                            },
                            {
                                "example_id": "7ec33b33-5288-461e-a841-0e96c1c350b1",
                                "sense_id": "879a3c53-ec5b-3c00-b0e4-28628ab971ae",
                                "text": "Die CAIs könnten in gasarmen sonnennahen Regionen gebildet worden sein, wo energiereiche Ausbrüche der jungen Sonne in ihnen Kernreaktionen hervorgerufen haben könnten, während die Chondren in gasreicheren Regionen in der Mitte der Scheibe von diesen Ausbrüchen abgeschirmt gewesen wären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
