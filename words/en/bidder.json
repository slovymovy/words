{
    "word_family": [
        "bid",
        "bidding",
        "outbid",
        "underbid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                    "sense_definition": "A person or organization that offers a specific amount of money to buy something, especially at an auction or for a business contract.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "auction_and_trade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house was eventually sold to the highest <w>bidder</w> after a long afternoon of competition.",
                            "target_lang_translations": {
                                "ru": "После долгого соревновательного дня дом в итоге был продан тому <w>участнику торгов</w>, который предложил самую высокую цену."
                            }
                        },
                        {
                            "text": "Several companies are expected to act as a potential <w>bidder</w> for the new government construction project.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что несколько компаний выступят в качестве потенциальных <w>претендентов</w> на новый государственный строительный проект."
                            }
                        }
                    ],
                    "synonyms": [
                        "tenderer",
                        "buyer"
                    ],
                    "antonyms": [
                        "seller",
                        "vendor"
                    ],
                    "common_phrases": [
                        "highest bidder",
                        "potential bidder",
                        "successful bidder",
                        "winning bidder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо или организация, предлагающие определенную сумму денег за покупку чего-либо, особенно на аукционе или при заключении контракта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участник торгов",
                                "target_lang_sense_clarification": "общее обозначение для аукционов и тендеров"
                            },
                            {
                                "target_lang_word": "покупатель",
                                "target_lang_sense_clarification": "тот, кто предлагает цену на аукционе"
                            },
                            {
                                "target_lang_word": "претендент",
                                "target_lang_sense_clarification": "на получение контракта или покупку актива"
                            },
                            {
                                "target_lang_word": "оферент",
                                "target_lang_sense_clarification": "лицо, делающее официальное предложение (юр.)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b9db15d-fa47-3b9e-b9db-a95909097368",
                    "sense_definition": "A person who gives a command or an order to someone else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers waited patiently for their <w>bidder</w> to signal the start of the march.",
                            "target_lang_translations": {
                                "ru": "Солдаты терпеливо ждали, когда их <w>командир</w> подаст сигнал к началу марша."
                            }
                        },
                        {
                            "text": "In the old stories, the spirit was bound to serve its <w>bidder</w> for a thousand years.",
                            "target_lang_translations": {
                                "ru": "В старинных преданиях дух был обязан служить своему <w>повелителю</w> тысячу лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "commander",
                        "master"
                    ],
                    "antonyms": [
                        "servant",
                        "follower"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean one who commands"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который отдает приказ или распоряжение кому-либо другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повелитель",
                                "target_lang_sense_clarification": "тот, кто отдает приказы (устар.)"
                            },
                            {
                                "target_lang_word": "командир",
                                "target_lang_sense_clarification": "лицо, отдающее распоряжения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34b50926-e018-31fc-92ad-6f1eda7aaf58",
                    "sense_definition": "A person who invites or asks someone to attend an event or perform an action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "invitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the primary <w>bidder</w> of the feast, he ensured every guest felt welcome.",
                            "target_lang_translations": {
                                "ru": "Как главный <w>устроитель</w> пира, он заботился о том, чтобы каждый гость чувствовал себя желанным."
                            }
                        },
                        {
                            "text": "The <w>bidder</w> requested that all participants arrive exactly at noon.",
                            "target_lang_translations": {
                                "ru": "<w>Приглашающий</w> попросил всех участников прибыть ровно в полдень."
                            }
                        }
                    ],
                    "synonyms": [
                        "inviter",
                        "host"
                    ],
                    "antonyms": [
                        "guest"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean one who invites"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который приглашает или просит кого-либо посетить мероприятие или совершить действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приглашающий",
                                "target_lang_sense_clarification": "тот, кто зовет гостей (устар.)"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "принимающая сторона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aab5a96-515d-327b-98f7-82db39505e6a",
                    "sense_definition": "A person who begs for money, food, or help.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The humble <w>bidder</w> stood by the temple gates hoping for a few coins.",
                            "target_lang_translations": {
                                "ru": "Смиренный <w>проситель</w> стоял у ворот храма в надежде на несколько монет."
                            }
                        },
                        {
                            "text": "He lived his life as a poor <w>bidder</w>, relying entirely on the kindness of strangers.",
                            "target_lang_translations": {
                                "ru": "Он прожил свою жизнь как бедный <w>нищий</w>, полностью полагаясь на доброту незнакомцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "beggar",
                        "mendicant"
                    ],
                    "antonyms": [
                        "benefactor",
                        "donor"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English to mean a beggar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который просит деньги, еду или помощь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проситель",
                                "target_lang_sense_clarification": "тот, кто обращается с просьбой о помощи"
                            },
                            {
                                "target_lang_word": "нищий",
                                "target_lang_sense_clarification": "человек, живущий милостыней (устар.)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1b99c28a-5343-32d9-b99b-ccc5ac005809",
                    "sense_definition": "A <w>surname</w> of English origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Bidder</w> published several influential papers on marine biology in the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Биддер</w> опубликовал несколько влиятельных работ по морской биологии в начале двадцатого века."
                            }
                        },
                        {
                            "text": "The local archives contain many records of the <w>Bidder</w> family living in this village.",
                            "target_lang_translations": {
                                "ru": "В местных архивах сохранилось много записей о семье <w>Биддер</w>, жившей в этой деревне."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "used as a family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия английского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Биддер",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}