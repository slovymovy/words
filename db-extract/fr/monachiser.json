                "senses": [
                    {
                        "sense_id": "5ba4c7cd-73bc-30fa-bb88-14759563b6b0",
                        "entry_id": "320a1c8b-cc33-3f75-8816-0167cf02a62c",
                        "glosses": [
                            "Rendre monacal."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "94e247b3-a64d-4072-8d14-e5d4d9b3e212",
                                "sense_id": "5ba4c7cd-73bc-30fa-bb88-14759563b6b0",
                                "text": "Ils prétendent que l'on veut créer, dans notre joyeux pays, une nouvelle armée du Salut, monachiser (je n'ai pas dit monarchiser) la France, dégauloiser la patrie de François Iᵉʳ et d'Henri IV, excommunier les verts-galants."
                            },
                            {
                                "example_id": "6d8768bd-ad83-46bd-ad71-9fe7f48cf2ee",
                                "sense_id": "5ba4c7cd-73bc-30fa-bb88-14759563b6b0",
                                "text": "L'Église post-grégorienne exploite ce que les Écritures et la Tradition lui offrent-pour \"monachiser\" ses clercs séculiers et les détacher de la femme tentatrice."
                            },
                            {
                                "example_id": "5e322230-ae56-4efc-9b17-cf021f6e3384",
                                "sense_id": "5ba4c7cd-73bc-30fa-bb88-14759563b6b0",
                                "text": "Les grands abbés de ce temps, d'Odilon de Cluny à Didier du Mont-Cassin, étaient assez avisés pour ne pas chercher à « monachiser » le monde qui les entourait."
                            }
                        ]
                    },
                    {
                        "sense_id": "88a89328-d011-32ba-9514-65260a4312ec",
                        "entry_id": "320a1c8b-cc33-3f75-8816-0167cf02a62c",
                        "glosses": [
                            "Se transformer en moine."
                        ],
