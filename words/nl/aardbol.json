                                "target_lang_word": "globe",
                                "target_lang_sense_clarification": "Désigne la planète Terre dans son ensemble."
                            },
                            {
                                "target_lang_word": "Terre",
                                "target_lang_sense_clarification": "Le nom propre de notre planète."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1209ebe-daad-3883-999b-cc58d044a368",
                    "sense_definition": "Een bolvormig model van de aarde.",
