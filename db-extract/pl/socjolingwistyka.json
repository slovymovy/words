                "senses": [
                    {
                        "sense_id": "283226ac-8f0d-34e9-9e14-98619cd66c72",
                        "entry_id": "86ae44bd-3719-310f-9414-c250f3d502b7",
                        "glosses": [
                            "nauka zajmująca się funkcjonowaniem języka w społeczeństwie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a8a2900-5ac2-4e8a-bb41-4e476d6017bf",
                                "sense_id": "283226ac-8f0d-34e9-9e14-98619cd66c72",
                                "text": "Socjolingwistyka narodziła się z powiązania socjologii będącej nauką o społeczeństwie i lingwistyki – nauki o języku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9308e505-47c4-4f1d-a780-79cab637aa21",
                        "source_entry_id": "86ae44bd-3719-310f-9414-c250f3d502b7",
                        "source_sense_id": "283226ac-8f0d-34e9-9e14-98619cd66c72",
                        "target_lang_word": "sociolinguistics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sociolinguistics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bdb8779-09e5-379c-88a8-3af5da144d58",
                                        "entry_id": "aef3f655-3622-3159-b198-ca4cd021cc2a",
                                        "glosses": [
                                            "The study of social and cultural effects on language and vice-versa."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1faaa6b6-8c9b-48f5-bf6a-b388b17cae03",
                                                "sense_id": "2bdb8779-09e5-379c-88a8-3af5da144d58",
                                                "text": "This paper surveys the research methods and approaches used in the multidisciplinary field of applied language studies or language education over the last fourty^([sic]) years. Drawing on insights gained in psycho- and sociolinguistics, educational linguistics and linguistic anthropology with regard to language and culture, it is organized around five major questions that concern language educators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3c62967-e236-4667-8447-80f7d7e064a2",
                        "source_entry_id": "86ae44bd-3719-310f-9414-c250f3d502b7",
                        "source_sense_id": "283226ac-8f0d-34e9-9e14-98619cd66c72",
