                        "entry_id": "166681b6-537c-373d-b48f-c12cef255803",
                        "glosses": [
                            "schwebende Lichtkugel, die plötzlich und auch in geschlossenen Räumen auftreten soll, meist in Zusammenhang mit Gewittern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d7912b2-e538-436a-9ecc-65c65ee03c74",
                                "sense_id": "f5b477b7-bf5c-3e4e-ae19-0401be107996",
                                "text": "Bis heute haben die Naturwissenschaften keine allgemein akzeptierte oder nachgewiesene Erklärung für das Phänomen der Kugelblitze liefern können."
                            },
                            {
                                "example_id": "b4465880-4c78-4123-a496-249332cfe09c",
                                "sense_id": "f5b477b7-bf5c-3e4e-ae19-0401be107996",
                                "text": "Meine Oma erzählt gerne die Geschichte von dem Kugelblitz, der den Schornstein herunterfiel, in der Wohnstube landete, sich quer durchs Zimmer bewegte und auf der gegenüberliegenden Wand unter ohrenbetäubendem Lärm durch die Mauer nach draußen schlug."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
