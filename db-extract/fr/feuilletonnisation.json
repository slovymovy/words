                        "glosses": [
                            "Fait de feuilletonniser ; action de rendre comme un feuilleton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9e4146-ccaa-4091-a1aa-d4deaeb113b9",
                                "sense_id": "304496f9-cd0d-33de-a8dd-f8fe68416a20",
                                "text": "Comme bon nombre de ses consœurs (américaines ou françaises), elle a développé, au fil des années, la «feuilletonnisation» de ses intrigues."
                            },
                            {
                                "example_id": "0519d44f-bb8f-4200-a359-dff8f6929335",
                                "sense_id": "304496f9-cd0d-33de-a8dd-f8fe68416a20",
                                "text": "En commençant à évoquer les nouvelles amours possibles de Karine, Public procède à nouveau à un début de feuilletonnisation, comme c'était le cas pour Julien Doré. Dès lors, le magazine s'ouvre la possibilité de nouveaux récits autour de l'héroïne Karine […]."
                            },
                            {
                                "example_id": "beff3e20-f0e2-4bba-affd-8176eedc618d",
                                "sense_id": "304496f9-cd0d-33de-a8dd-f8fe68416a20",
                                "text": "Cette feuilletonnisation de l’actualité par la droite vise aujourd’hui à tenter de disqualifier les socialistes."
                            }
                        ]
                    }
