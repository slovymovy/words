                "senses": [
                    {
                        "sense_id": "1730163e-5a27-3a33-8c6d-557d4279f102",
                        "entry_id": "039b4029-77cc-343b-8b8f-e2609c506a0a",
                        "glosses": [
                            "werkstuk waardoor de leerling laat blijken het vak te verstaan, meesterproef, kunststuk, chef d'oevre, juweeltje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3454f34-143c-43e5-af92-50741c12ec9c",
                                "sense_id": "1730163e-5a27-3a33-8c6d-557d4279f102",
                                "text": "Na een zeer drukke maandag en dinsdag met de voorronden van het Koningin Elisabeth-concours zijn 48 deelnemers uitgekozen om mee te dingen in de eerste ronde voor publiek. Woensdagavond wijdde de jury zich aan de selectie van de twee proefstukken die zij wenst te horen, naast de opera-aria en het lied die elk van de overblijvende deelnemers zelf mag uitkiezen. Het zijn dus in totaal vier stukken, die vanaf 11 mei ten gehore zullen worden gebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "39beabc6-f600-3829-93fc-4006b96f4ce3",
                        "entry_id": "039b4029-77cc-343b-8b8f-e2609c506a0a",
                        "glosses": [
                            "een voorbeeld, monster, staal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3648329-9fb0-4ae0-a47e-5049a4b54f1e",
                                "sense_id": "39beabc6-f600-3829-93fc-4006b96f4ce3",
                                "text": "En als je met proefstukken uit de betonconstructie de sterkte van het beton en het betonstaal controleert blijken die doorgaans gunstiger uit te vallen dan de minimumeisen van de voorschriften."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e44ea09-c029-3747-8663-6cb8285e2e1e",
                        "entry_id": "039b4029-77cc-343b-8b8f-e2609c506a0a",
                        "glosses": [
                            "een probeersel, prototype"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1a123237-74b7-32ec-9a8d-23b610bedf29",
                        "entry_id": "039b4029-77cc-343b-8b8f-e2609c506a0a",
                        "glosses": [
                            "voorwerp waarop men proeven neemt, sample"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df83306c-7baf-4206-a1c5-74a5845fd93e",
                                "sense_id": "1a123237-74b7-32ec-9a8d-23b610bedf29",
                                "text": "Langs een provinciale weg, de N 675 van Breskens naar Sluis, is bij Nieuwvliet een proefstuk van één kilometer omgevormd tot een hindernisbaan voor hardrijders door het aanleggen van een 'wegprofiel met een in de lengterichting regelmatig veranderende helling'."
                            }
                        ]
                    }
                ],
