                    },
                    {
                        "translation_id": "3e1dd4d4-0493-4d89-9471-80442c5e7b93",
                        "source_entry_id": "215d204b-a332-3d7a-b364-009d453aca9c",
                        "source_sense_id": "ab72c9a6-62a2-3e9b-b73d-5732002830c1",
                        "target_lang_word": "Unterstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb5bf87-a10c-33ed-a7ff-3928dc961f09",
                                        "entry_id": "3f3093e5-dbc1-37da-95e7-1cb871f1e204",
                                        "glosses": [
                                            "Unterordnung einer Sache einer anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cbf2c1-1680-40dc-90a7-f823aaa6ed89",
                                                "sense_id": "4eb5bf87-a10c-33ed-a7ff-3928dc961f09",
                                                "text": "Die Unterstellung der Einheit hat längst stattgefunden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e88929d-c19e-3b92-95eb-405468204491",
                                        "entry_id": "3f3093e5-dbc1-37da-95e7-1cb871f1e204",
                                        "glosses": [
                                            "falsche, meist negative Behauptung über eine Sache/Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b674f3-06ff-4492-a6e1-f53073b3b00d",
                                                "sense_id": "4e88929d-c19e-3b92-95eb-405468204491",
                                                "text": "Diese Unterstellung nimmst du sofort zurück!"
                                            },
                                            {
                                                "example_id": "f808b2f4-9c83-4c44-8f52-0d1ec6a57bbc",
                                                "sense_id": "4e88929d-c19e-3b92-95eb-405468204491",
                                                "text": "„Sie hatten keine widersprüchlichen Aussagen gemacht, und Dávila verwandelte das Kreuzverhör in ein weiteres dümmliches Herumgerede voller Boshaftigkeit dem gehörnten Ehemann und boshafter Unterstellungen dem Liebhaber gegenüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Unterstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9209972-efcf-30a0-8159-c32703438128",
                                        "entry_id": "bf66b2dd-f7b6-3856-a57a-ebba09886689",
                                        "glosses": [
                                            "Handlung, etwas (zum Beispiel ein Fahrzeug) unterzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecd8a169-43a0-426b-837a-70d3b0525c03",
                                                "sense_id": "e9209972-efcf-30a0-8159-c32703438128",
                                                "text": "„Gerade als ich mich anschickte, Postpferde zu bestellen, um zur Nacht in Fréjus zu sein, erschien ein Mann und behauptete, ich schulde ihm zehn Louis für die Unterstellung eines Wagens, den ich vor fast drei Jahren bei ihm gelassen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e0652dd-26b7-40a9-8e31-49791d190dd1",
                        "source_entry_id": "215d204b-a332-3d7a-b364-009d453aca9c",
                        "source_sense_id": "ab72c9a6-62a2-3e9b-b73d-5732002830c1",
                        "target_lang_word": "инсинуация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инсинуация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "77bb3851-6053-3ff2-8c9e-ffb8a044b922",
                                        "entry_id": "4e45f491-59f6-36c2-960c-e71df319418b",
                                        "glosses": [
                                            "книжн. клеветническое измышление, порочащее кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "786b7ca7-e5a3-4f06-aad3-c737ac128b40",
                                                "sense_id": "77bb3851-6053-3ff2-8c9e-ffb8a044b922",
                                                "text": "Начинаются бесконечные разговоры о каком-то знамени, которое следует держать твёрдо и бодро, и не менее бесконечные инсинуации насчет неблагонадежных элементов, наплыв которых якобы не следует допускать…"
                                            },
                                            {
                                                "example_id": "0fa30405-2218-4fd6-affe-bfcac2eeb28d",
                                                "sense_id": "77bb3851-6053-3ff2-8c9e-ffb8a044b922",
                                                "text": "Это ― лживая инсинуация, ― отвечаем мы, ― инсинуация, в пользу которой не приведено ни одного факта."
                                            },
                                            {
                                                "example_id": "e975d3a8-50bd-4f45-8129-22259b18cc3f",
                                                "sense_id": "77bb3851-6053-3ff2-8c9e-ffb8a044b922",
                                                "text": "Но, как правило, всё это были инсинуации личного характера: обиженный муж, неудачливый ухажер…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
