                        "entry_id": "693da7e6-2513-33f1-b848-19faeca7d09a",
                        "glosses": [
                            "planten die ondersteuning nodig hebben om omhoog te groeien omdat de stengels niet stevig genoeg zijn om de plant zelfstandig te dragen"
                        ],
