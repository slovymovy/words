                                        "sense_id": "f0dfa5fb-467b-3b54-b073-8fd21740d588",
                                        "entry_id": "94f0e765-8f68-37c9-8e83-00207ff73c1a",
                                        "glosses": [
                                            "An area of ground on the enemy's side of a river or other obstacle, especially one that needs to be taken and defended in order to secure an advance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea79cb73-2db7-46d5-a421-7217b9a7a377",
                                                "sense_id": "f0dfa5fb-467b-3b54-b073-8fd21740d588",
                                                "text": "He believed the invasion would happen elsewhere and it wasn't until late in the afternoon and long after the Allied forces had established a bridgehead that Hitler was convinced of the need to do something."
                                            }
                                        ]
                                    },
