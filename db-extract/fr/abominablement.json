        "fr-extract.jsonl": [
            {
                "entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                "word": "abominablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                        "entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "glosses": [
                            "D’une manière abominable, atroce, inhumaine, terrible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7d43da-5dd7-4985-9801-37431b25fa65",
                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                "text": "Je n’en ai pas voulu parce qu’outre qu’il louchait abominablement ; il aurait fallu me séparer de ma fille, et, de fait, je ne m’en souciais pas."
                            },
                            {
                                "example_id": "64bd2c69-25c0-4f93-ba71-17db3402c0e8",
                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                "text": "Pibrac y avait déjeuné aussi, quoi qu'il se fût abominablement grisé au Grand-Quinze, mais il ne paraissait pas encore très bien remis des excès de ce souper […]."
                            },
                            {
                                "example_id": "775e1a0b-1c61-4ecb-a04d-0313d616211a",
                                "sense_id": "5c99ab69-1051-312a-8e9c-454941963fb9",
                                "text": "Il se conduit abominablement."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c944477-5966-3eaf-afd6-7c09e3a76fc1",
                        "entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "glosses": [
                            "Il se dit aussi par exagération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1822a832-91d4-4b50-a5e0-05f9089f04e9",
                                "sense_id": "3c944477-5966-3eaf-afd6-7c09e3a76fc1",
                                "text": "Il chante, il écrit abominablement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce7b351d-0578-4ec0-966e-7d49f1310cd0",
                        "source_entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "target_lang_word": "abominably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abominably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4b805a6-93ce-38b4-a40b-69213497c3ca",
                                        "entry_id": "c144c887-252c-3c8f-8423-ca1b19f62267",
                                        "glosses": [
                                            "In an abominable manner; very odiously; detestably."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7de9b7-65a6-47ef-9668-320cf4124958",
                                                "sense_id": "f4b805a6-93ce-38b4-a40b-69213497c3ca",
                                                "text": "He lit a fire in the dining-room, and the chimney was damp and smoked abominably, so that when he had fed full on tinned meats he was fain to let the fire go out and to sit in his fur-lined overcoat by the becindered grate, now fast growing cold, and smoke pipe after pipe of gloomy reflection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ed69d4-0113-4aac-99b6-0768f66e3433",
                        "source_entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "target_lang_word": "horribly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horribly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "In a horrible way; very badly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc9875d8-09f0-407c-bcf3-760b17d2cbfa",
                                                "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                                "text": "The beginning art students displayed their horribly executed paintings with hopeful faces."
                                            },
                                            {
                                                "example_id": "4c855ae6-11eb-4601-9aa4-c2c7067359e1",
                                                "sense_id": "42f7dd5f-89ed-3b46-a432-f98670247ffc",
                                                "text": "Looking back at the 2020s from our vantage point in 2030, the first great event was the complete destruction of Donald Trump’s Republican Party. As the former Republican consultant Mike Murphy had noticed, there were roughly 300 state and federal elections during the Trump years and Republicans did horribly in most of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "To an extreme degree or extent."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cf53b48-b404-4920-8b50-f38976daf77c",
                                                "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                                "text": "Then everything went horribly wrong."
                                            },
                                            {
                                                "example_id": "6281f130-faaa-4dfe-9320-c831272193bb",
                                                "sense_id": "2fa7ede4-665a-3e19-bdbd-f745435c0174",
                                                "text": "The man was horribly nice, yet she still wouldn't marry him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d65d44-af93-34ee-a4d2-8af620006128",
                                        "entry_id": "620dd897-c21f-351b-95c2-943e68d948fa",
                                        "glosses": [
                                            "With a very bad effect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df7e1ff3-323c-41b3-be5a-6db5ea610fe4",
                                                "sense_id": "95d65d44-af93-34ee-a4d2-8af620006128",
                                                "text": "Horribly, as he was dying, his eyes reddened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a072a1d-4353-4e16-a0b9-5170ef1fc61f",
                        "source_entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "target_lang_word": "frightfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "frightfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49946de3-c89c-39c2-a2de-60541dba7239",
                                        "entry_id": "8a9a9e82-38d5-3a8c-8002-e559179889db",
                                        "glosses": [
                                            "In a frightful manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4f8660f-30ea-372d-9a70-e92fc4ed33e2",
                                        "entry_id": "8a9a9e82-38d5-3a8c-8002-e559179889db",
                                        "glosses": [
                                            "Very, extremely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "200ee5c3-e83f-469a-8dcf-1db9cec38a55",
                                                "sense_id": "f4f8660f-30ea-372d-9a70-e92fc4ed33e2",
                                                "text": "It all went frightfully quickly."
                                            },
                                            {
                                                "example_id": "9c0dc347-e1e2-439b-a2ff-8bffab806745",
                                                "sense_id": "f4f8660f-30ea-372d-9a70-e92fc4ed33e2",
                                                "text": "\"Really!\" he said, collapsing into lassitude. \"It's too frightfully hot for singing.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cbb6619b-4d2c-4bfd-b01d-ddc6007dde5d",
                        "source_entry_id": "1ea7e7b1-a9aa-3b4a-aba3-ed020e715933",
                        "target_lang_word": "hideously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hideously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0267182-af9f-38d5-8d96-c52f441ea59a",
                                        "entry_id": "11b7dce5-e7a5-3262-a62a-3f35f1ad574c",
                                        "glosses": [
                                            "In a hideous manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                        "entry_id": "11b7dce5-e7a5-3262-a62a-3f35f1ad574c",
                                        "glosses": [
                                            "To an extreme degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054622e8-1181-419c-a7ee-1efff577fc23",
                                                "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                                "text": "Speaking now as a condemned criminal might speak ere the drop-bolts are drawn, my story, wild and hideously improbable as it may appear, demands at least attention."
                                            },
                                            {
                                                "example_id": "24044636-990c-4db8-91e2-18e5db063ec3",
                                                "sense_id": "7c6e793f-f45c-3976-a720-18e612a7e0f0",
                                                "text": "Pack a larger-than-normal hypochondria kit that includes sunscreen, plastic bandages and allergy pills. Such things are hard to find or hideously expensive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
