                    {
                        "translation_id": "6d66060e-46c6-491f-a36d-3c29423ec790",
                        "source_entry_id": "4aa22f45-37c9-3af0-9bd0-fde7a7a050d2",
                        "source_sense_id": "4aba5e22-4cad-3333-bc3c-b99908e88e9d",
