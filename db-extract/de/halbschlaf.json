                "senses": [
                    {
                        "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                        "entry_id": "d3384b6a-729c-3fef-8d42-25d5c1835db9",
                        "glosses": [
                            "Zustand, bei dem sich der Körper zwischen Schlafen und Wachen befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b951d4d-8ae4-4d33-be3b-f23a242f95d0",
                                "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                                "text": "„Nach einem unruhigen Halbschlaf wache ich auf und sehe mich um.“"
                            },
                            {
                                "example_id": "55e9239a-df3b-462e-946c-077e5198b77a",
                                "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                                "text": "„Demnach sichert der ‚Halbschlaf‘ nicht nur das Luftholen, sondern befähigt die Tiere sogar zu komplexen Verhaltensweisen.“"
                            },
                            {
                                "example_id": "76ae9d3b-6752-4074-971b-0f5d8a9fa4a2",
                                "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                                "text": "„Ich lag die meiste Zeit in einem Halbschlaf.“"
                            },
                            {
                                "example_id": "913ba9c8-0bdb-445f-9e63-6a5a865eb4ab",
                                "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                                "text": "„Irgendwann in jener Nacht hört Günter M. im Halbschlaf ein Geräusch.“"
                            },
                            {
                                "example_id": "64e7485e-9592-404e-af4b-ee0c1443302f",
                                "sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                                "text": "„Im Halbschlaf, klamm vor Kälte, denkt er an die Rückkehr nach Paris.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5f35063-b078-4462-8554-d6a7ef844e4b",
                        "source_entry_id": "d3384b6a-729c-3fef-8d42-25d5c1835db9",
                        "source_sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                        "source_sense_description": "Zustand, bei dem sich der Körper zwischen Schlafen und Wachen befindet",
                        "target_lang_word": "doze",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To sleep lightly or briefly; to nap, snooze."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adf90b28-3e2a-4155-a1b7-135658c6a717",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "I didn’t sleep very well, but I think I may have dozed a bit."
                                            },
                                            {
                                                "example_id": "d65cc87d-3400-4db0-ae79-17f27ea2425f",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "If he Happen'd to Doze a little no and then in a Morning, the Jolly Cobbler Wak'd him."
                                            },
                                            {
                                                "example_id": "b2d3722d-3673-4ce3-aaf3-fe29ca8a07f7",
                                                "sense_id": "0aae20b7-3080-3f10-bfae-4f7eb5b6585c",
                                                "text": "She dozes, too. Lies there for a minute or two, all these thoughts going through her head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                        "entry_id": "45aa7378-ae5a-37e5-9aa1-70d4e17a8006",
                                        "glosses": [
                                            "To make dull; to stupefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b482a1d-1c7e-413a-9e27-267cdda47046",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "I was an hour […] in casting up about twenty sums, being dozed with much work."
                                            },
                                            {
                                                "example_id": "25c0e183-5c1d-4115-a721-b7275aaa33c7",
                                                "sense_id": "beb21dd7-54b0-3ee0-a3b6-af32179512cd",
                                                "text": "October 29, 1693, Robert South, a sermon preached at Christ-church in Oxford before the university\nThey left for a long time (as it were) dozed and benumbed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                        "entry_id": "0a784180-7a02-3e70-b8a5-0a4e8c62f462",
                                        "glosses": [
                                            "A light, short sleep or nap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56111de-2744-4fe8-89ac-020528e190d0",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "I felt much better after a short doze."
                                            },
                                            {
                                                "example_id": "e0dd8747-4d83-4021-b707-4ec1c8e8767c",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "Others who conscientiously attended the Technical College at night often drooped over their desks in a doze, and one does not wonder at it."
                                            },
                                            {
                                                "example_id": "81d0d527-2227-493d-9a5b-9742c0355549",
                                                "sense_id": "a2c9d0e8-aabb-3a3e-ab1a-046ea4ad47a5",
                                                "text": "At the mention of money Mrs Dibble was overcome with great debility, and wheezed, \"I don't feel up to talking about money, matters just now, dearie. I think I better have a bit of a doze.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d6cfb6a-1f6b-3c85-adfc-f04b80306f89",
                                        "entry_id": "ba69aac1-12b7-36d7-a267-e52615075757",
                                        "glosses": [
                                            "To bulldoze."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "doze",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25fed296-eb2d-358e-a713-5164d96ca438",
                                        "entry_id": "f3313767-21d1-398a-b5db-3978199c31b6",
                                        "glosses": [
                                            "Pronunciation spelling of those."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "pronunciation-spelling"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27900e73-a23d-4e8c-a7fc-7ed36d309f53",
                                                "sense_id": "25fed296-eb2d-358e-a713-5164d96ca438",
                                                "text": "Donald Duck: I'll give you $20 for those old license plates on your fence posts!\nOther man: Hah? No chance! I bought dis house 'cause it has dis address! It's me lucky number! […] It was me prison number at Leavenworst and de winning number in de weekly parole lottery! I wudn't never sell doze plates!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "088035de-12fb-423f-aa63-8c684f939597",
                        "source_entry_id": "d3384b6a-729c-3fef-8d42-25d5c1835db9",
                        "source_sense_id": "6c6e58eb-ec78-3e41-a342-44a5825a05f5",
                        "source_sense_description": "Zustand, bei dem sich der Körper zwischen Schlafen und Wachen befindet",
                        "target_lang_word": "demi-sommeil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demi-sommeil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                        "entry_id": "fdd13cd9-d02e-3345-b7d2-b57c9cc6ce4f",
                                        "glosses": [
                                            "État intermédiaire entre la veille et le sommeil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f67a0360-1d60-43f0-a32b-6f326724d87a",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Tout à fait réveillée par la nécessité de se contraindre, elle se trouva moins malheureuse; la raison reprit l’empire que l’état de demi-sommeil lui avait ôté."
                                            },
                                            {
                                                "example_id": "9ce2a6e4-d735-46f2-995c-f927bb34d745",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Nous allions au pas, côte à côte, et souvent il oubliait que j’étais là pour suivre dans une sorte de demi-sommeil un peu vague la monotone allure de son cheval ou son piétinement sur les galets roulants du rivage."
                                            },
                                            {
                                                "example_id": "6907fd32-f7d5-4bfd-99fa-7132e06df519",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "C’était un de ces vieillards dont la mort s’empare dix ans avant que le mouvement cesse tout à fait en eux ; sa vue semblait voilée par un demi-sommeil ; sa bouche béante ruminait quelques paroles vagues et habituelles de piété qui n’avaient aucun sens ; il lui était resté assez d’intelligence pour distinguer le plus fort parmi les hommes et lui obéir, ne songeant même pas un moment à quel prix."
                                            },
                                            {
                                                "example_id": "560e49c2-63e7-4aa4-b34a-b0ae479bc367",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Depuis son retour à Paris, depuis six semaines, Thérèse vivait dans le demi-sommeil ardent du bonheur, et prolongeait délicieusement son rêve sans pensées."
                                            },
                                            {
                                                "example_id": "ea8b9e8c-dd37-47d3-9f6c-856e94d3989b",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Mais cette pendule m’obsédait ; dans le demi-sommeil qui me gagnait, elle prenait des proportions effarantes, elle s’épanouissait aux pieds de l’hercule en maillot rose, qui devenait sur le socle ancien de cette horlogerie de famille une sorte de sujet en bronze animé."
                                            },
                                            {
                                                "example_id": "7ce3bfeb-cb2b-4b65-a2a6-5b8f259d818e",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Dans mon demi-sommeil je pense à ces défectuosités du gréement […] et à tout ce qu'il faudra réparer aux îles Bermudes, avant de continuer ma croisière."
                                            },
                                            {
                                                "example_id": "6dd2e7f0-25d7-4d42-af79-80e8ba6acb85",
                                                "sense_id": "40227159-476f-3f89-b2ee-7165fb04f52b",
                                                "text": "Ça n'était pas un gros shoot, poursuivit Goñi, une petite dose, mais assez pour se mettre à rêver merveilleusement dans un demi-sommeil. Ce qui est vraiment intéressant, c'est qu'il ne semblait pas être un consommateur régulier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
