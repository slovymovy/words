                    "synonyms": [
                        "pleasant",
                        "delightful",
                        "lovely",
                        "good",
                        "great"
                    ],
                    "antonyms": [
                        "horrible",
                        "nasty",
                        "awful",
                        "horrid"
                    ],
                    "common_phrases": [
