                "senses": [
                    {
                        "sense_id": "aefb333e-c3ab-33bc-95af-f43808bfc205",
                        "entry_id": "70486afa-c7e6-3632-97b8-5ae3b409882c",
                        "glosses": [
                            "Investmentfonds, der sein gesamtes Kapital in andere Investmentfonds investiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40a67f4e-ebfb-4cd6-abbe-8cf866de94df",
                                "sense_id": "aefb333e-c3ab-33bc-95af-f43808bfc205",
                                "text": "„Schon früher hätten österreichische Dachfonds stark in ausländische Produkte investiert, erklärt Bernd May, Generalsekretär der Vereinigung ausländischer Investmentgesellschaften in Österreich.“"
                            },
                            {
                                "example_id": "9ed82783-2611-485f-ba0c-26730b108220",
                                "sense_id": "aefb333e-c3ab-33bc-95af-f43808bfc205",
                                "text": "„Der von Arts Asset Management gemanagte Dachfonds C-Quadrat Arts Total Return Balanced kann etwa bis zu 50 Prozent in Aktienfonds und bis zu hundert Prozent in Anleihen- und Geldmarktfonds bzw. geldmarktnahe Fonds investieren.“"
                            },
                            {
                                "example_id": "a3e7f70b-90b8-4eae-aa5e-57dc93e65d3b",
                                "sense_id": "aefb333e-c3ab-33bc-95af-f43808bfc205",
                                "text": "„Dachfonds sind selten ein günstiges Gesschäft für den Anleger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
