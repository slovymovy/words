                                "target_senses": [
                                    {
                                        "sense_id": "a5cbabb0-73ec-352f-a8ef-1bc02a22a35c",
                                        "entry_id": "150cddfb-961f-30b5-bf85-28cd0e75290e",
                                        "glosses": [
