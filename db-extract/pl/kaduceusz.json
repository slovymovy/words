                        "cross_references": [
                            {
                                "target_word": "caduceus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34c8fd50-9e31-3bdf-88a1-bc2e4406b238",
                                        "entry_id": "d4b373e8-5ae7-3682-b2ae-6b93f103ffa5",
                                        "glosses": [
                                            "The official wand carried by a herald in ancient Greece and Rome, specifically the one carried in mythology by Hermes, the messenger of the gods, usually represented with two snakes twined around it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd89731a-b010-45ad-9fa6-5091e360a3a7",
                                                "sense_id": "34c8fd50-9e31-3bdf-88a1-bc2e4406b238",
                                                "text": "Caduceus the rod of Mercury, / With which he wonts the Stygian realmes inuade […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a9b6fd2-96b4-3037-8ee6-ac833323c8f3",
                                        "entry_id": "d4b373e8-5ae7-3682-b2ae-6b93f103ffa5",
                                        "glosses": [
                                            "A symbol (☤) representing a staff with two snakes wrapped around it, used to indicate merchants and messengers. It is also sometimes incorrectly substituted for the rod of Asclepius as a symbol of medicine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db14975f-2e77-4b1f-8e56-5e43e1c3915c",
                                                "sense_id": "4a9b6fd2-96b4-3037-8ee6-ac833323c8f3",
                                                "text": "For quotations using this term, see Citations:caduceus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d73ab7c2-8ba5-419d-b1e3-88119bba5863",
                        "source_entry_id": "dd381a5e-58b8-3edb-882f-83eeda6cb07f",
                        "source_sense_id": "b85624d6-f3f7-33b9-8e1d-43406581fe1c",
