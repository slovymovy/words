                                        "sense_id": "676a08df-c7c8-35e1-968c-21274d9bb108",
                                        "entry_id": "83c35a18-d6c9-3986-b51e-d647c75417bf",
                                        "glosses": [
                                            "A male given name from Ancient Greek, a mostly British and Irish spelling variant of Dennis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb8a5d20-db65-4024-9308-acca6d06d5e4",
                                                "sense_id": "676a08df-c7c8-35e1-968c-21274d9bb108",
                                                "text": "Shall not thou and I, between Saint Denis and Saint George, compound a boy, half French, half English, that shall go to Constantinople and take the Turk by the beard?"
