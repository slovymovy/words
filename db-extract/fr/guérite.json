                        ],
                        "examples": [
                            {
                                "example_id": "117be83f-ed71-4884-a879-4dbdf668f7b6",
                                "sense_id": "cd1997f4-ebfc-355e-9589-ae5a43b9ab95",
                                "text": "Le gardien ferma soigneusement la porte de sa guérite – je n’en vis guère l’utilité – et, avant de partir, se mettant dans la peau d’un étranger, il essaya de l’ouvrir",
                                "translation": "The guard carefully closed the door to his sentry-box - I failed to see the point of it - and, before leaving, pretending to be a stranger, he tried to open it.",
                                "english": "The guard carefully closed the door to his sentry-box - I failed to see the point of it - and, before leaving, pretending to be a stranger, he tried to open it."
                            }
