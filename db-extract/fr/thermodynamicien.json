                "senses": [
                    {
                        "sense_id": "322ef836-d553-3d20-ba27-fd6cfb835faa",
                        "entry_id": "ff2221d7-5073-3b76-a08e-27248faa5458",
                        "glosses": [
                            "Relatif à la thermodynamique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "908de1e4-1ab9-4104-a56e-3499d84482af",
                                "sense_id": "322ef836-d553-3d20-ba27-fd6cfb835faa",
                                "text": "Par contre, ce qui doit être souligné est que l’idée de résistance à la dégradation, qui est une des bases du vitalisme de Bichat, reste présente dans la conception thermodynamicienne du vivant."
                            },
                            {
                                "example_id": "fd94363a-cef3-4845-b4ca-10af8c6a5c21",
                                "sense_id": "322ef836-d553-3d20-ba27-fd6cfb835faa",
                                "text": "En cédant au texte exotérique de Nietzsche et à ses références thermodynamiciennes, on perd la spécificité de sa découverte politique, le pouvoir comme irréductible à de la force simplement (micro -) physique et/ou technique."
                            }
                        ]
                    }
                ],
                "translations": [],
