                                "example_id": "c5dfd04d-7afb-412b-b62b-2d0cc8c2f4c4",
                                "sense_id": "9f47bc59-e82b-3933-b8e7-3f2a918b3a60",
                                "text": "„Aufbruchstimmung liegt ohnehin in der Luft.“"
                            },
                            {
                                "example_id": "dba5e390-d4e2-4f0d-b00a-a24be3c4565f",
                                "sense_id": "9f47bc59-e82b-3933-b8e7-3f2a918b3a60",
                                "text": "„Es herrschte Aufbruchstimmung auf dem Felde der Kultur.“"
