                ],
                "senses": [
                    {
                        "sense_id": "7a07e4ef-57a8-3d9b-82a8-c92f17d9d769",
                        "entry_id": "d2bd9ac4-8af3-3323-b474-2c035bf8f2a4",
                        "glosses": [
                            "gewöhnliche, durchschnittliche Person ohne besondere Fähigkeiten"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "0c0fa270-00a4-4ff9-a6c3-bb9f274b95bf",
                                "sense_id": "7a07e4ef-57a8-3d9b-82a8-c92f17d9d769",
                                "text": "„Wer einen Erlöser braucht, gibt sich nicht mit einem Normalsterblichen zufrieden.“"
                            },
                            {
                                "example_id": "c15ee7c7-3e42-48ac-bb3f-ec7627eac50d",
                                "sense_id": "7a07e4ef-57a8-3d9b-82a8-c92f17d9d769",
                                "text": "„Hurley fühlte einen nagenden Zweifel, für Normalsterbliche ein vertrautes Phänomen, aber bei einem sturen Bock seines Kalibers eine ausgemachte Seltenheit.“"
                            },
                            {
                                "example_id": "4c9da349-e685-482b-95ce-3c201dbd41a6",
                                "sense_id": "7a07e4ef-57a8-3d9b-82a8-c92f17d9d769",
                                "text": "„Für einen Normalsterblichen wie mich war die Vordertür völlig tabu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a6fc17f-4b9e-443e-bf80-04cae8e90e1c",
                        "source_entry_id": "d2bd9ac4-8af3-3323-b474-2c035bf8f2a4",
                        "source_sense_id": "7a07e4ef-57a8-3d9b-82a8-c92f17d9d769",
                        "source_sense_description": "gewöhnliche, durchschnittliche Person ohne besondere Fähigkeiten",
                        "target_lang_word": "commun des mortels",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commun des mortels",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf37a29-93f1-3de1-9f35-56a78fa6f04e",
                                        "entry_id": "5fb4206b-fd86-339c-bdf0-ee55be984525",
                                        "glosses": [
                                            "Tout le monde ; le vulgaire."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc986599-371a-47b0-b4ad-dbaa7532b6ee",
                                                "sense_id": "9cf37a29-93f1-3de1-9f35-56a78fa6f04e",
                                                "text": "Y a-t-il donc deux probités ? Une pour les gouvernements, l’autre pour le commun des mortels ?"
                                            },
                                            {
                                                "example_id": "a8580df5-f444-4b7e-8215-233624f62336",
                                                "sense_id": "9cf37a29-93f1-3de1-9f35-56a78fa6f04e",
                                                "text": "Ce qui n’empêche qu’avec une candeur parfaite, avec une innocence naïve, le commun des mortels se figure comprendre l’univers parce qu’il l’a réduit à sa propre taille, déclare immobile ce qu’il n’a jamais vu changer, immuable ce qu’il n’a pas senti bouger ; car il n’a jamais mis en question la prétendue évidence des sens."
                                            },
                                            {
                                                "example_id": "83ad3b82-dc90-4e0c-8025-b3ec2014f3c2",
                                                "sense_id": "9cf37a29-93f1-3de1-9f35-56a78fa6f04e",
                                                "text": "Jusqu’à l'âge de sept ans (l’âge dit de raison), j’avais étudié à la maison, avec une institutrice, loin du commun des mortels, protégé avec un soin jaloux de toutes les promiscuités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
