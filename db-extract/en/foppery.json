    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e85025e4-1703-3ea5-975b-bbabca019198",
                "word": "foppery",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "dc570794-47bb-49ab-84cf-4597288271fd",
                        "entry_id": "e85025e4-1703-3ea5-975b-bbabca019198",
                        "tags": [
                            "plural"
                        ],
                        "form": "fopperies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2f5de862-2ed7-3833-8856-bab88442cd6a",
                        "entry_id": "e85025e4-1703-3ea5-975b-bbabca019198",
                        "glosses": [
                            "The dress or actions of a fop."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "35dced0c-bcae-44b4-8ff3-8c268e64439c",
                                "sense_id": "2f5de862-2ed7-3833-8856-bab88442cd6a",
                                "text": "And it is by their fopperies and their frivolities that we know that their sinister philosophy is sincere; in their lights and garlands and ribbons we read their indwelling despair."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b46b155-bc7e-33f3-8d18-127bed6d901b",
                        "entry_id": "e85025e4-1703-3ea5-975b-bbabca019198",
                        "glosses": [
                            "Stupidity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0e8690c9-58b1-4e8e-b1ad-7e61defbbe55",
                                "sense_id": "2b46b155-bc7e-33f3-8d18-127bed6d901b",
                                "text": "This is the excellent foppery of the world, that, / when we are sick in fortune,–often the surfeit / of our own behavior,–we make guilty of our / disasters the sun, the moon, and the stars: as / if we were villains by necessity; fools by / heavenly compulsion […]"
                            },
                            {
                                "example_id": "906b53c3-b5f9-4ffb-b5d6-bcc8e539f5e4",
                                "sense_id": "2b46b155-bc7e-33f3-8d18-127bed6d901b",
                                "text": "The energies of his mind led him to despise the fopperies of idolatry; and he found the Christians, in the most unfavourable situation, torn into innumerable parties, by the sectaries of Athanasius, Arius, Eutyches, Nestorius."
                            },
                            {
                                "example_id": "535b09db-3c00-412e-8e62-1f39d205ccf3",
                                "sense_id": "2b46b155-bc7e-33f3-8d18-127bed6d901b",
                                "text": "Still, still the secret presses;\nThe nearing clouds draw down;\nThe crimson morning flames into\nThe fopperies of the town."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b91dfec2-151d-48c8-8808-237d82cf37c5",
                        "source_entry_id": "e85025e4-1703-3ea5-975b-bbabca019198",
