                                    {
                                        "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                        "entry_id": "835e1bb2-dd03-3f0e-91c3-b0831cc78365",
                                        "glosses": [
                                            "denken dat je beter bent dan andere mensen en op die anderen neerkijken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c018778-ac28-4bfd-bf94-6a121054a7cd",
                                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                                "text": "Het hooghartige wicht had dan wel een rijke vader, maar had zelf nog helemaal niets bereikt."
                                            },
                                            {
                                                "example_id": "a4ad4564-e73e-4c73-8a47-8f5a03e06e33",
                                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                                "text": "Uma Thurman is de mooiste venus van allemaal. Vanuit de hoogte kijkt ze vanaf een filmscherm op ons neer, in de eerste zaal van de tentoonstelling Botticelli Reimagined in het Londense V&A Museum. Ze oogt sereen, een tikkeltje hooghartig maar vooral wonderschoon, met haar rossige krullen en haar framboosrode lippen. (Sandra Smallenburg NRC 14 maart 2016)"
                                            },
                                            {
                                                "example_id": "142fbfb8-dc57-4282-be66-3189a8b06eed",
                                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                                "text": "De Fransen, die onverdraaglijk hooghartige kwasten, hadden gekregen wat ze verdienden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
