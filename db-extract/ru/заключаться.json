                "senses": [
                    {
                        "sense_id": "5f4a7f2b-4a1e-3bd1-837b-582bafff0877",
                        "entry_id": "b2342a05-85d4-3749-b6a3-c5f588073283",
                        "glosses": [
                            "лишаться свободы, помещаясь под стражу, под надзор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3975038-c46c-4e7c-83ea-e6809c59ed8f",
                                "sense_id": "5f4a7f2b-4a1e-3bd1-837b-582bafff0877",
                                "text": "Преступники заключаются в тюрьмы."
                            }
                        ]
                    },
                    {
                        "sense_id": "4501c02d-71ea-3cd2-aaa0-c6034e4169b7",
                        "entry_id": "b2342a05-85d4-3749-b6a3-c5f588073283",
                        "glosses": [
                            "официально уславливаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02cc54fb-0522-4386-ad9c-f0049ee8cd95",
                                "sense_id": "4501c02d-71ea-3cd2-aaa0-c6034e4169b7",
                                "text": "Договоры заключаются часто на невыгодных условиях."
                            }
                        ]
                    },
                    {
                        "sense_id": "f4b1f032-4f04-37fb-a64f-05acf1b12790",
                        "entry_id": "b2342a05-85d4-3749-b6a3-c5f588073283",
                        "glosses": [
                            "устар. помещаться, размещаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f77411a-068a-4889-8623-3a6249fbc0c2",
                                "sense_id": "f4b1f032-4f04-37fb-a64f-05acf1b12790",
                                "text": "Заключаться в монастырь."
                            }
                        ]
                    },
                    {
                        "sense_id": "03bd8249-c2a7-31d9-a688-9194ea188afa",
                        "entry_id": "b2342a05-85d4-3749-b6a3-c5f588073283",
                        "glosses": [
                            "содержаться, находиться внутри чего-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949e66c0-eb7d-48fb-904d-c68e18681643",
                                "sense_id": "03bd8249-c2a7-31d9-a688-9194ea188afa",
                                "text": "Никто не понял, какой смысл заключался в его словах. В пакете заключалось 100 рублей."
                            },
                            {
                                "example_id": "01a6f144-f983-4d27-8623-56041e8690f6",
                                "sense_id": "03bd8249-c2a7-31d9-a688-9194ea188afa",
                                "text": "Его суть заключалась в том, что каждой лодке отводился маневренный район, вытянутый перпендикулярно к побережью на 20-30 миль."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e5d119e-62ef-34e8-824b-d23d67218917",
                        "entry_id": "b2342a05-85d4-3749-b6a3-c5f588073283",
                        "glosses": [
                            "состоять в чем-нибудь, сводиться по своему содержанию к чему-нибудь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d6ccbfa-8125-497a-aa0b-56a014331dd5",
                                "sense_id": "9e5d119e-62ef-34e8-824b-d23d67218917",
                                "text": "Всё его имущество заключалось в старом костюме и полке с книгами. Задача заключается в том, чтобы правильно организовать работу. Дело заключается в следующем."
                            }
                        ]
                    },
                    {
                        "sense_id": "9bac8a9f-65b7-3ce8-b145-23a23c1ac12c",
