                        "glosses": [
                            "żołnierz lekkiej kawalerii używający do walki lancę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7654ce4c-6600-4aee-87ae-6686dfbc2490",
                                "sense_id": "93a6b470-beb6-38cb-9522-69a72572ac0f",
                                "text": "Zgłodniały lansjer przystąpił do księdza i zagadnął go ostro, w twardym tonie, czy rozumie po francusku."
                            }
                        ],
