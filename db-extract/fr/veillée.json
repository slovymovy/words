                    },
                    {
                        "translation_id": "c8d0495e-4627-404e-a5ce-6d955ce5e513",
                        "source_entry_id": "937e8a79-e3ff-3bb6-8abd-1eee7b447ed9",
                        "source_sense_description": "manifestation",
                        "target_lang_word": "vigil",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vigil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                                        "entry_id": "68ec1782-b449-317d-8c30-d883d6dd2f0f",
                                        "glosses": [
                                            "An instance of keeping awake during normal sleeping hours, especially to keep watch or pray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff168b28-ebfb-4b9c-9657-7b66bc4c7c52",
                                                "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                                                "text": "I saw her head drooped upon her hand; her whole attitude expressing that profound depression, whose lonely vigil wastes the midnight in a gloomy watch, which yet hopes for nothing at its close."
                                            },
                                            {
                                                "example_id": "00fd9e0e-8294-45cd-90dd-dc200040fc2a",
                                                "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                                                "text": "Eventually the body trade grew so reckless that relatives took to holding graveside vigils, lest their loved ones disappear in the night."
                                            },
                                            {
                                                "example_id": "cff353a2-0659-4024-b4b9-5cb6b9ce0fcf",
                                                "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                                                "text": "A vigil was held for Ms. Cheptegei on Wednesday night, Ms. Indimuli said, with many women praying that she would survive."
                                            },
                                            {
                                                "example_id": "92be1e8b-89a2-427c-a59f-8b43af289bea",
                                                "sense_id": "d622286a-c5bf-30cc-857c-a61731a94181",
                                                "text": "Mortenson, who asked to use a pseudonym for this story, says she has been attending rallies and vigils in her home state to regain her optimism, but she’s finding it tough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6676e05-f59c-3df9-a0de-d84033611ae4",
                                        "entry_id": "68ec1782-b449-317d-8c30-d883d6dd2f0f",
                                        "glosses": [
                                            "A period of observation or surveillance at any hour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bad62f-3c8c-4323-992b-4ea126407111",
                                                "sense_id": "d6676e05-f59c-3df9-a0de-d84033611ae4",
                                                "text": "His dog kept vigil outside the hospital for eight days while he was recovering from an accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f052f292-32e2-3524-b7b2-4c7696686cee",
                                        "entry_id": "68ec1782-b449-317d-8c30-d883d6dd2f0f",
                                        "glosses": [
                                            "The eve of a religious festival in which staying awake is part of the ritual devotions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c2518db-39be-37f0-b1a0-88d503256f68",
                                        "entry_id": "68ec1782-b449-317d-8c30-d883d6dd2f0f",
                                        "glosses": [
                                            "A quiet demonstration in support of a cause."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f25db206-6525-4748-aa84-908089ca26ea",
                                                "sense_id": "2c2518db-39be-37f0-b1a0-88d503256f68",
                                                "text": "The protesters kept vigil outside the conference centre in which the party congress was being held."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vigil",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cd0da9a-4303-3a3e-9089-23d2f266bc12",
                                        "entry_id": "3897abe5-7ad9-36b4-845f-b390aeaadb75",
                                        "glosses": [
                                            "To participate in a vigil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a35710c6-91b8-4da0-a5e6-35f8943effa3",
                                                "sense_id": "2cd0da9a-4303-3a3e-9089-23d2f266bc12",
                                                "text": "As the arrested painters and their supporters waited out their \"day in court,\" other activists distributed Hiroshima information leaflets, vigiled silently with placards and banners, and marched 500-strong through downtown Boston to a rally at City Hall Plaza."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
