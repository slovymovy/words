                                "example_id": "45c432f9-fccc-4b0c-82cf-529e4453c2ca",
                                "sense_id": "11fc6644-7fc9-3f35-a57f-9c03f106bfe4",
                                "text": "Au huitième droite, Marie-Lotte Kettani ferma le dernier bouton de son chemisier simili soie devant le miroir de la salle de bains."
                            },
                            {
                                "example_id": "e42e6a06-313f-4673-842d-46cfec3f0898",
                                "sense_id": "11fc6644-7fc9-3f35-a57f-9c03f106bfe4",
                                "text": "Je déteste ces pantalons en simili peau de serpent."
                            }
                        ]
                    }
