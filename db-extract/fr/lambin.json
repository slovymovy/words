                    {
                        "translation_id": "228d7a7c-824e-4bcf-b299-cd2c4c6313e1",
                        "source_entry_id": "4edbf07c-7232-3d9a-9dcb-c08819687d07",
                        "source_sense_id": "cbdc2c1b-31ec-37d0-a5c8-46b28e6e2672",
