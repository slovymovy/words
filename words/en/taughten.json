{
    "word_family": [
        "tighten",
        "taut"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d1070e2-e105-3a43-ac7e-36f425690cdd",
                    "sense_definition": "To make or become tight or taut; to increase in tension or intensity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tighten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to wait for the low tide so we could <w>taughten</w> the chains again.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось ждать отлива, чтобы мы могли снова <w>натянуть</w> цепи."
                            }
                        },
                        {
                            "text": "You must <w>taughten</w> the rope to secure the heavy load on the boat.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>натянуть</w> веревку, чтобы закрепить тяжелый груз на лодке."
                            }
                        }
                    ],
                    "synonyms": [
                        "tauten",
                        "tighten"
                    ],
                    "antonyms": [
                        "loosen",
                        "slacken"
                    ],
                    "common_phrases": [
                        "taughten the rope",
                        "taughten the chains"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Rare or dialectal variant of tighten/tauten"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать или стать натянутым, тугим; увеличить натяжение или интенсивность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натягивать",
                                "target_lang_sense_clarification": "делать тугим, увеличивать натяжение веревки, цепи"
                            },
                            {
                                "target_lang_word": "натянуться",
                                "target_lang_sense_clarification": "становиться тугим, натянутым"
                            },
                            {
                                "target_lang_word": "подтягивать",
                                "target_lang_sense_clarification": "делать более тугим, подтягивать крепления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ac361f4-bd1d-36e8-ad45-27682197ae7b",
                    "sense_definition": "An archaic or dialectal past participle of <w>teach</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "past_participle_teach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had been <w>taughten</w> by the finest scholars of his time.",
                            "target_lang_translations": {
                                "ru": "Он был <w>обучен</w> лучшими учеными своего времени."
                            }
                        },
                        {
                            "text": "The lessons <w>taughten</w> in his youth were never forgotten.",
                            "target_lang_translations": {
                                "ru": "Уроки, <w>преподанные</w> ему в юности, никогда не были забыты."
                            }
                        }
                    ],
                    "synonyms": [
                        "taught"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Non-standard or archaic past participle of teach"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная или диалектная форма причастия прошедшего времени от глагола teach (обучать, учить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обученный",
                                "target_lang_sense_clarification": "получивший образование или навыки (архаичная форма)"
                            },
                            {
                                "target_lang_word": "преподанный",
                                "target_lang_sense_clarification": "о преподнесенных уроках, знаниях (архаичная форма)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}