                "senses": [
                    {
                        "sense_id": "c9a3e783-2003-353b-a081-0038726c234e",
                        "entry_id": "0168b1e0-f931-341b-976e-9ff4257d9a48",
                        "glosses": [
                            "weniger anspruchsvolle aber robust und leicht handhabbar Technik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2a1fee7-08e5-4346-a840-fc895f860777",
                                "sense_id": "c9a3e783-2003-353b-a081-0038726c234e",
                                "text": "„Da gibt es eine breite Palette von kleinen und mittleren kreativen und innovativen Unternehmen in den Bereichen Hightech und Lowtech, Beratung und Kommunikation, und Design, und Veranstaltungsmanagement.“"
                            },
                            {
                                "example_id": "920e83d6-08b4-4594-aad8-e02d68c328ec",
                                "sense_id": "c9a3e783-2003-353b-a081-0038726c234e",
                                "text": "„Lowtech ist meistens unabhängiger und deshalb vorzuziehen, also aus Gründen der Freiheit.“"
                            },
                            {
                                "example_id": "75eeec11-8c47-4bd0-b9bf-1a90de434e34",
                                "sense_id": "c9a3e783-2003-353b-a081-0038726c234e",
                                "text": "Lowtech ist der Gegenbegriff zu Hightech. Es geht um den bewussten Verzicht auf komplizierte und teure Technik und die Nutzung einfacher Wirkprinzipien. „Das heißt nicht, dass die Low-Tech-Variante eines Werkzeugs, eines Gebrauchsgegenstands oder einer Maschine nicht sehr ausgefuchst bzw. technisch anspruchsvoll sein kann. Aber Low-Tech-Geräte sind meist robuster, besser zu verstehen, einfacher zu warten, leichter zu reparieren, besser auf örtliche Gegebenheiten abzustellen. Sie kommen nicht selten ohne elektrischen Strom aus, enthalten also auch weniger bedenkliche Materialien. Als Low-Tech-Version des Kühlschranks zum Beispiel funktionieren zwei ineinander geschachtelte Tontöpfe, die über Verdunstung und ohne Kühlmittel kühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
