                        ],
                        "form": "sie sind schützbar"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3e6e46a-8a51-3125-8525-d514fe5c627a",
                        "entry_id": "6d47bfae-1c62-3dc5-82de-0fe5776bf8a9",
                        "glosses": [
                            "so geartet, dass es rechtlich geschützt, vor fremder wirtschaftlicher Nutzung oder Missbrauch bewahrt, werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9634f0af-d930-44d3-9905-2de1caab8b5f",
                                "sense_id": "b3e6e46a-8a51-3125-8525-d514fe5c627a",
                                "text": "„Nur technische Erfindungen sind durch Patente schützbar.“"
                            },
                            {
                                "example_id": "ddf44f5d-28b4-4e3b-8d17-b945b3fc4c5e",
                                "sense_id": "b3e6e46a-8a51-3125-8525-d514fe5c627a",
                                "text": "„„CANDY & COMPANY“ ist für Süßwaren und damit im Zusammenhang stehende Dienstleistungen nicht schützbar.“"
                            },
                            {
                                "example_id": "a5b7c3a2-79ee-4a74-98cc-69e63c910a99",
                                "sense_id": "b3e6e46a-8a51-3125-8525-d514fe5c627a",
                                "text": "„Pflanzensorten und Tierarten sind nicht schützbar (5 2Ziff. 2 GebrMG).“"
                            },
                            {
                                "example_id": "cbe727d0-a070-4d37-9712-c0e9f9aa5cc6",
                                "sense_id": "b3e6e46a-8a51-3125-8525-d514fe5c627a",
                                "text": "„Begründet wird dieser Sachverhalt durch die Vorschriften des Warenzeichenrechts, die für gesetzlich schützbare Produktbezeichnungen die „Namensqualität“ vorschreiben.“"
