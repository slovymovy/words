                        "glosses": [
                            "A small figure of a person, especially in toys such as Lego."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436de0e0-2355-4980-a6bd-e1dd570579fd",
                                "sense_id": "47e3a3c7-3125-35e3-998c-ce82fe775c2b",
                                "text": "They are often used as decorations, like in set 9526 Star Wars Palpatine Arrest (2012) were two pearl gold monochrome minifigures represent statues."
                            },
                            {
                                "example_id": "29c429cc-ce5e-41bb-85ca-aab89e324d28",
                                "sense_id": "47e3a3c7-3125-35e3-998c-ce82fe775c2b",
                                "text": "Dismantle all the pieces, and place any with stickers or printing (like minifigure torsos) aside."
                            },
                            {
                                "example_id": "90dca394-47d4-40bf-b587-e9fc4ea6f515",
                                "sense_id": "47e3a3c7-3125-35e3-998c-ce82fe775c2b",
                                "text": "The subjects, which include Gwen Stefani, Jay-Z, Justin Timberlake and Daft Punk, show up rendered as cylinder-headed, block-bodied minifigures, Lego parlance for the people-shaped pieces."
                            }
                        ]
