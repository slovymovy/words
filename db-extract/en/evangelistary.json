                        "glosses": [
                            "A book containing selections from the Gospels, read during worship services."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25825ef0-3b26-468a-8b0e-0a177272ea50",
                                "sense_id": "411cbc0d-15c2-3a01-8b72-37c3d0dc5398",
                                "text": "The Exultet in sources related to southern Italy, in addition to its transmission in twenty-six rolls, is found in twenty-seven other manuscripts: eighteen missals, two evangelistaries, two pontificals, two rituals, two graduals, and one processional."
                            }
                        ]
                    }
