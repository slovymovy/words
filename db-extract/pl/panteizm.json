                                    {
                                        "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                                        "entry_id": "fe5eed8f-fecb-30f6-b0cc-fab4cee7d3da",
                                        "glosses": [
                                            "Glaube beziehungsweise Lehre, dass Gott die Natur oder das Universum ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1913e020-d4ac-441f-86e5-6d19cc7e4786",
                                                "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                                                "text": "„Der Begriff ›Pantheismus‹ wurde 1709 von dem niederländischen Theologen Jacobus de la Faye in einer gegen John Toland gerichteten Streitschrift geprägt.“"
                                            },
                                            {
                                                "example_id": "af6b43a8-310a-473f-ac5f-6de13e1d8959",
                                                "sense_id": "735afcbe-8583-33f4-9efe-f38b4d2addbf",
                                                "text": "„Pantheismus ist die vornehme Form des Atheismus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edb8d05d-0e9b-4328-b11a-f927f942fcdb",
                        "source_entry_id": "cdba6890-e8ed-3021-b4f6-c29e1a762715",
                        "source_sense_id": "dc65a085-df25-3ea3-b8f7-966f02cbb5ef",
