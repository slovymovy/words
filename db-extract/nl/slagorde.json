                "senses": [
                    {
                        "sense_id": "395871e7-7f03-3a64-9d82-099dc83dc523",
                        "entry_id": "14493f68-337e-3bea-b125-9b5e803f3502",
                        "glosses": [
                            "opstelling van een leger voordat er gevochten gaat worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef3d3370-9b84-4f77-84a3-ce0aad126985",
                                "sense_id": "395871e7-7f03-3a64-9d82-099dc83dc523",
                                "text": "In de schemering stelde Ala zijn troepen in slagorde op aan de rand van het dal. Op de rug van elke olifant zaten vier boogschutters, daarachter kwamen de sabeldragende ruiters op kamelen en paarden en helemaal achteraan de voetsoldaten, uitgerust met lansen en kromzwaarden."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a141001-3b41-349f-a751-23ec5cc3bb88",
                        "entry_id": "14493f68-337e-3bea-b125-9b5e803f3502",
                        "glosses": [
                            "opstelling die het mogelijk maakt om aan de slag te gaan"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1347a466-05ec-402f-84c5-0e1bcd4851f1",
                                "sense_id": "6a141001-3b41-349f-a751-23ec5cc3bb88",
                                "text": "Volgens Ivo Belet (CD&V) is glyfosaat niet de toekomst. 'Integendeel, we moeten volop inzetten op duurzame alternatieven.' Hij wil vermijden dat de lidstaten in verspreide slagorde omschakelen en kan zich daarom vinden in een beperkte verlenging van de toelating. Dat 'zorgt voor druk op de ketel om zo in heel Europa tegelijk over te schakelen op duurzame alternatieven'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e84721dc-c61c-4523-8b24-31c1303e6126",
