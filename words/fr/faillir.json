    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2235f79a-eaff-3290-b875-e9f9d797fe5a",
                    "sense_definition": "Être sur le point d'accomplir une action ou d'en subir les conséquences, sans que cela se produise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "imminence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai <w>failli</w> tomber dans l'escalier ce matin en partant au travail."
                        },
                        {
                            "text": "Le conducteur distrait a <w>failli</w> renverser un cycliste au carrefour."
                        }
                    ],
                    "common_phrases": [
                        "faillir tomber",
                        "faillir perdre"
                    ]
                },
                {
                    "sense_id": "ca6a557a-0806-3865-bf05-53ad120eb119",
                    "sense_definition": "Ne pas respecter une obligation, commettre un manquement envers une règle ou une promesse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manquement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a affirmé qu'il ne pouvait pas <w>faillir</w> à son devoir envers les citoyens."
                        },
                        {
                            "text": "Elle a juré de dire la vérité et refuse de <w>faillir</w> à sa promesse."
                        }
                    ],
                    "synonyms": [
                        "échouer"
                    ],
                    "common_phrases": [
                        "faillir à son devoir",
                        "faillir à sa parole",
                        "faillir à sa promesse"
                    ]
                },
                {
                    "sense_id": "22d1ede6-2ba6-3c15-87c4-d234d800320a",
                    "sense_definition": "Cesser ses paiements et faire faillite dans le cadre d'une activité commerciale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la suite de cette crise financière soudaine, le commerçant craignait de <w>faillir</w> d'un mois à l'autre."
                        },
                        {
                            "text": "Plusieurs banques ont refusé d'aider cette entreprise qui était sur le point de <w>faillir</w>."
                        }
                    ],
                    "synonyms": [
                        "faire faillite",
                        "failliter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Au sens commercial, le terme est aujourd'hui vieilli au profit de l'expression faire faillite."
                        }
                    ]
                }
            ]
        }
