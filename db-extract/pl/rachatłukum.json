                                "target_senses": [
                                    {
                                        "sense_id": "cf9fc882-c82b-3215-a7c6-cd0f96dae316",
                                        "entry_id": "e36aad0c-cca7-358d-8cc2-b76a6371d6a7",
                                        "glosses": [
                                            "Bonbon oriental moelleux à base d’amidon gélifié dans l'eau, de sucre, de colorants, d’arômes, de pistache, de sésame, etc.."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84088d00-f45b-4d29-ab44-2ebfc8c57392",
                                                "sense_id": "cf9fc882-c82b-3215-a7c6-cd0f96dae316",
                                                "text": "Elle dévorait les loukoums que le marchand lui avait offerts."
                                            },
                                            {
                                                "example_id": "eeaef6d4-259a-404b-8d47-8ef88a506d91",
                                                "sense_id": "cf9fc882-c82b-3215-a7c6-cd0f96dae316",
                                                "text": "Parfois, on vous offre des loukoums dans une boîte de bois blanc pyrogravée. C’est le loukoum de retour de voyage ou, plus aseptisé encore, le loukoum-cadeau-du-dernier-moment. C’est drôle, mais on n’a jamais envie de ces loukoums-là."
                                            },
                                            {
                                                "example_id": "f5923599-fe3f-4b8a-bfbe-d40abdecc875",
                                                "sense_id": "cf9fc882-c82b-3215-a7c6-cd0f96dae316",
                                                "text": "Au niveau 2, c’est « la semaine orientale », semoule, dattes fourrées de pâte d’amande, citrons confits et loukoums poudrés, irrésistibles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
