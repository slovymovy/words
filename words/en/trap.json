                        "zh": [
                            {
                                "target_lang_word": "陷阱音乐",
                                "target_lang_sense_clarification": "音乐流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45c701f4-bc32-3370-b65f-1e6897e3a9ef",
