                    {
                        "sense_id": "4bc3761a-613c-3cb5-a510-ffbe5c70cd8a",
                        "entry_id": "a5a55ac3-bf56-3988-a7f4-69dc898b1e04",
                        "glosses": [
                            "Relatif à la digisexualité, à l’attirance sexuelle pour les outils technologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92a51f37-dd60-4eec-889b-436c4c290687",
                                "sense_id": "4bc3761a-613c-3cb5-a510-ffbe5c70cd8a",
                                "text": "Mais peut-on réellement considérer une personne préférant la pornographie, du sexe virtuel mais avec de véritables acteurs humains, comme une personne digisexuelle ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30d2f402-f88b-4759-97f5-15e612ab2bb0",
                        "source_entry_id": "a5a55ac3-bf56-3988-a7f4-69dc898b1e04",
                        "source_sense_id": "4bc3761a-613c-3cb5-a510-ffbe5c70cd8a",
                        "source_sense_description": "Relatif à la digisexualité",
                        "target_lang_word": "digisexual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digisexual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d264c761-2125-3888-a9fa-f1396c0097ba",
                                        "entry_id": "ed9abcda-4f1a-3417-a0b6-3369a472c9d9",
                                        "glosses": [
                                            "A person who is sexually attracted to robots or other technologically-mediated forms of sexuality."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f634cb5a-fcfd-4f47-99a3-b94061250a2e",
                                                "sense_id": "d264c761-2125-3888-a9fa-f1396c0097ba",
                                                "text": "No Thanks. I'm a digisexual now."
                                            },
                                            {
                                                "example_id": "b10073d1-11c1-4e67-a3ac-f34e4452dbef",
                                                "sense_id": "d264c761-2125-3888-a9fa-f1396c0097ba",
                                                "text": "“The more we studied the emergence of what we call ‘second wave’ digisexual technologies ... the more we realized that digisexuals are going to emerge as a real community, and they are going to face resistance from the start,” McArthur says."
                                            },
                                            {
                                                "example_id": "d80a5002-4b85-41a2-bad4-3710e651ba0b",
                                                "sense_id": "d264c761-2125-3888-a9fa-f1396c0097ba",
                                                "text": "As these technologies advance, their adoption will grow, and many people may come to identify themselves as “digisexuals”–people whose primary sexual identity comes through the use of technology."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
