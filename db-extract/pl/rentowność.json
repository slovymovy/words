                                            "Wirtschaftlichkeit, Einträglichkeit, das Rentabelsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13aee698-c67b-4838-83a9-2864d8bdfdc9",
                                                "sense_id": "a8b1397e-f6b4-3b96-809c-633a1aa5151c",
                                                "text": "Der Einsatz von Maschinen erhöht die Rentabilität."
                                            },
                                            {
                                                "example_id": "7df1818d-f33e-479e-bc9b-2051310d3824",
                                                "sense_id": "a8b1397e-f6b4-3b96-809c-633a1aa5151c",
                                                "text": "Vor jeder Investition sollte man sich die Frage nach der Rentabilität stellen."
                                            }
