                                                "sense_id": "84edf4cc-5cc4-319a-be29-907944b72f0c",
                                                "text": "Il est d’une vantardise ridicule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3afcab2d-ac5c-3b9e-b5e6-13d173ff6e4c",
                                        "entry_id": "c622da74-c065-3a03-9ef8-d051190be37c",
                                        "glosses": [
                                            "Action de se vanter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01881c4f-5c7b-40ab-9f01-8d7985e813f3",
                                                "sense_id": "3afcab2d-ac5c-3b9e-b5e6-13d173ff6e4c",
                                                "text": "Rapportées —il va de soi— au delà du Rhin, ces vantardises irritaient nos adversaires."
                                            }
                                        ]
                                    }
                                ]
                            },
