                        "glosses": [
                            "A move that threatens the immediate capture of one or more stones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "549867fb-9753-42ca-b5e6-232cd74c3118",
                                "sense_id": "1f759c9d-e4ca-3107-a776-2f687b3fcb6e",
                                "text": "In situations like this, beginners often make the mistake of giving an atari, which strengthens only the opponent."
                            },
                            {
                                "example_id": "b904d1ae-21ca-4014-9a27-096595ac5619",
                                "sense_id": "1f759c9d-e4ca-3107-a776-2f687b3fcb6e",
                                "text": "... White responds with an atari of her own ..."
                            },
                            {
                                "example_id": "766ef129-648d-46fe-ba69-199853e288dd",
                                "sense_id": "1f759c9d-e4ca-3107-a776-2f687b3fcb6e",
                                "text": "The important thing to note is that playing the simple atari first fails ..."
                            }
                        ]
