                "senses": [
                    {
                        "sense_id": "e79103fd-4ba1-34ca-a083-8b3fec797471",
                        "entry_id": "19d442e9-6836-3edf-8d5c-5dd256db675b",
                        "glosses": [
                            "Something that is not a tongue but which does something one associates with a tongue."
                        ],
                        "tags": [
                            "nonce-word"
                        ],
                        "examples": [
                            {
                                "example_id": "5f1f3d0e-ceab-4bbb-9f24-2ab377346c17",
                                "sense_id": "e79103fd-4ba1-34ca-a083-8b3fec797471",
                                "text": "to stay, dying and composing as the untongue licked him toward oblivion and the tenors sang promisisti."
                            },
                            {
                                "example_id": "4c2c6bfa-7d2b-4697-8450-e29e421f8f10",
                                "sense_id": "e79103fd-4ba1-34ca-a083-8b3fec797471",
                                "text": "I see them walking past its world's -end whine knowing this untongue shreds the tender air in perfect meaninglessness."
                            },
                            {
                                "example_id": "9d59344a-1e00-48bf-8c52-0bdbe7981323",
                                "sense_id": "e79103fd-4ba1-34ca-a083-8b3fec797471",
                                "text": "What are you building? she said to him in the same unlanguage, using the same untongue."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
