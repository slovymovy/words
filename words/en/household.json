            "senses": [
                {
                    "sense_id": "dcc481b3-d995-35b5-a2e1-369e34b2a3a5",
                    "sense_definition": "All the people who live together in a single home.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every member of the <w>household</w> helps to keep the kitchen clean.",
                            "target_lang_translations": {
                                "ru": "Каждый член <w>семьи</w> помогает поддерживать чистоту на кухне.",
                                "tr": "<w>Ev halkının</w> her bir üyesi mutfağın temiz kalmasına yardımcı olur.",
                                "zh": "<w>家庭</w>里的每一位成员都帮忙保持厨房清洁。",
                                "it": "Ogni membro del <w>nucleo familiare</w> aiuta a mantenere pulita la cucina."
                            }
                        },
                        {
                            "text": "The survey collects data on the average income of each <w>household</w>.",
                            "target_lang_translations": {
                                "ru": "Опрос собирает данные о среднем доходе каждого <w>домохозяйства</w>.",
                                "tr": "Anket, her bir <w>hanenin</w> ortalama geliri hakkında veri topluyor.",
                                "zh": "这项调查收集了每个<w>住户</w>的平均收入数据。",
                                "it": "Il sondaggio raccoglie dati sul reddito medio di ogni <w>nucleo familiare</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "family",
                        "home",
                        "occupants"
                    ],
                    "common_phrases": [
                        "head of the household",
                        "single-parent household",
                        "low-income household"
                    ],
                    "target_lang_definitions": {
                        "ru": "Все люди, живущие вместе в одном жилище; семья как экономическая единица.",
                        "tr": "Tek bir evde birlikte yaşayan tüm insanlar; ev halkı veya hane.",
                        "zh": "居住在同一屋檐下的所有成员；作为经济或统计单位的家庭。",
                        "it": "Tutte le persone che vivono insieme in una singola abitazione; un nucleo familiare."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домохозяйство",
