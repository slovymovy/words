            "senses": [
                {
                    "sense_id": "a3a3b7b3-d7dd-3624-b8ae-b623fef35302",
                    "sense_definition": "Niet helemaal gezond zijn en vaak last hebben van kleine kwaaltjes",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>kwakkelt</w> al weken met zijn gezondheid en blijft zich maar moe voelen."
                        },
                        {
                            "text": "Sinds de herfst begon, heeft mijn grootmoeder veel <w>gekwakkeld</w> met verkoudheden."
                        }
                    ],
                    "synonyms": [
                        "sukkelen"
                    ],
                    "common_phrases": [
                        "met de gezondheid kwakkelen"
                    ]
                },
                {
                    "sense_id": "e7bb3ed2-e51b-3c34-bc93-c2a85219017d",
                    "sense_definition": "Niet goed lopen of wisselvallig presteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economie van het buurland <w>kwakkelt</w> al geruime tijd door de hoge inflatie."
                        },
                        {
                            "text": "Na de slechte resultaten van vorig jaar <w>kwakkelde</w> het bedrijf nog een tijdje door."
                        }
                    ],
                    "synonyms": [
                        "stagneren",
                        "sukkelen"
                    ],
                    "antonyms": [
                        "bloeien"
                    ],
                    "common_phrases": [
