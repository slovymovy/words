{
    "word_family": [
        "solid",
        "solidity",
        "solidification",
        "solidness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7e842850-c726-30d8-9a15-644df16ed59c",
                    "sense_definition": "To change from a liquid or gas into a solid; to become hard or firm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The melted wax began to cool and <w>solidify</w> on the counter.",
                            "target_lang_translations": {
                                "ru": "Растопленный воск начал остывать и <w>застывать</w> на столешнице."
                            }
                        },
                        {
                            "text": "Allow the mixture to <w>solidify</w> in the refrigerator for two hours before serving.",
                            "target_lang_translations": {
                                "ru": "Дайте смеси <w>затвердеть</w> в холодильнике в течение двух часов перед подачей."
                            }
                        }
                    ],
                    "synonyms": [
                        "set"
                    ],
                    "antonyms": [
                        "melt",
                        "liquefy"
                    ],
                    "common_phrases": [
                        "cool and solidify",
                        "begin to solidify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить из жидкого или газообразного состояния в твёрдое; затвердевать или остывать до твёрдого состояния."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затвердевать",
                                "target_lang_sense_clarification": "становиться твёрдым"
                            },
                            {
                                "target_lang_word": "застывать",
                                "target_lang_sense_clarification": "остывая, становиться густым или твёрдым"
                            },
                            {
                                "target_lang_word": "твердеть",
                                "target_lang_sense_clarification": "становиться более твёрдым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a86dde0-15a0-3e14-9649-dfea3c88f28b",
                    "sense_definition": "To make something solid or firm, turning it from a liquid or gas into a solid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Extreme cold can quickly <w>solidify</w> water into thick ice.",
                            "target_lang_translations": {
                                "ru": "Сильный мороз может быстро <w>превратить</w> воду <w>в</w> толстый лёд."
                            }
                        },
                        {
                            "text": "The industrial process uses chemical agents to <w>solidify</w> liquid waste for safer disposal.",
                            "target_lang_translations": {
                                "ru": "В этом промышленном процессе используются химические реагенты, чтобы <w>отверждать</w> жидкие отходы для более безопасной утилизации."
                            }
                        }
                    ],
                    "antonyms": [
                        "melt",
                        "liquefy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо твёрдым или плотным, переводя из жидкого или газообразного состояния в твёрдое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать твёрдым",
                                "target_lang_sense_clarification": "переводить в твёрдое состояние"
                            },
                            {
                                "target_lang_word": "отверждать",
                                "target_lang_sense_clarification": "спец., вызывать затвердевание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd6c8be4-2834-3132-b8d1-5381ac5af188",
                    "sense_definition": "To make something stronger, firmer, or more certain, such as a plan, relationship, or position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This successful performance helped <w>solidify</w> her position as the leading candidate.",
                            "target_lang_translations": {
                                "ru": "Это успешное выступление помогло <w>укрепить</w> её позицию в качестве ведущего кандидата."
                            }
                        },
                        {
                            "text": "The two countries signed a treaty to <w>solidify</w> their friendship and cooperation.",
                            "target_lang_translations": {
                                "ru": "Две страны подписали договор, чтобы <w>скрепить</w> свою дружбу и сотрудничество."
                            }
                        }
                    ],
                    "antonyms": [
                        "weaken",
                        "undermine"
                    ],
                    "common_phrases": [
                        "solidify a position",
                        "solidify a relationship",
                        "solidify plans"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать более прочным, устойчивым или окончательным (планы, отношения, положение и т. п.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать прочнее, стабильнее"
                            },
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "фиксировать успех, позиции"
                            },
                            {
                                "target_lang_word": "упрочивать",
                                "target_lang_sense_clarification": "придавать устойчивость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5647eeb9-a4d3-36d1-8217-f37796a6ab29",
                    "sense_definition": "To convert an open or hyphenated compound word into a single closed compound word.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern English style guides often <w>solidify</w> familiar terms that were once hyphenated.",
                            "target_lang_translations": {
                                "ru": "Современные руководства по стилю английского языка часто предписывают <w>писать слитно</w> привычные термины, которые раньше писались через дефис."
                            }
                        },
                        {
                            "text": "The editor chose to <w>solidify</w> the two words into a single noun.",
                            "target_lang_translations": {
                                "ru": "Редактор решил <w>объединить</w> эти два слова в одно существительное <w>со слитным написанием</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать составное слово слитно вместо дефисного или раздельного написания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать слитно",
                                "target_lang_sense_clarification": "в лингвистике: соединять части слова"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}