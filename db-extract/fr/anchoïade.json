                        "glosses": [
                            "Préparation culinaire à base d’anchois pilés et de câpres, avec de l’ail et de l’huile d’olive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b965a00f-f679-482f-b1fb-fc941ed687b2",
                                "sense_id": "cd9c9eda-8f53-392a-b216-35c448ed4a64",
                                "text": "Ton anchoïade est succulente."
                            },
                            {
                                "example_id": "4c5f91b4-7691-48a5-ae18-f5403857864b",
                                "sense_id": "cd9c9eda-8f53-392a-b216-35c448ed4a64",
                                "text": "Après une anchoïade servie avec son fagot de gressins torsadés … suivit une pleine assiettée de scattoni au jambon cru arrosée d'un Lacryma Christi rosso."
                            }
                        ]
                    },
