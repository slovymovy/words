                "senses": [
                    {
                        "sense_id": "d6bed20d-ed4e-359b-8fff-7f0c36bf053c",
                        "entry_id": "3485ef14-9636-3234-81f9-5cf68bb021e6",
                        "glosses": [
                            "iemand die zich buiten de dampkring van de aarde begeeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "64418952-064c-44f5-bbce-ea2a79001bbf",
                                "sense_id": "d6bed20d-ed4e-359b-8fff-7f0c36bf053c",
                                "text": "De politie in Japan doet onderzoek naar een opmerkelijke oplichtingszaak. Een zwendelaar overtuigde een vrouw uit Japan ervan dat hij een ruimtevaarder was en geld nodig had om terug te keren naar de aarde. Ze trapte erin en betaalde 4,4 miljoen yen (bijna 31.000 euro)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11acf3c1-9bc4-4a7b-aa37-177bc5fe054f",
                        "source_entry_id": "3485ef14-9636-3234-81f9-5cf68bb021e6",
                        "source_sense_id": "d6bed20d-ed4e-359b-8fff-7f0c36bf053c",
                        "source_sense_description": "iemand die zich buiten de dampkring van de aarde begeeft",
                        "target_lang_word": "astronaut",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astronaut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "752d9f6e-9cbb-3d53-89e2-c87f039e93b0",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A member of the crew of a spaceship or other spacecraft that travels beyond Earth's atmosphere, or someone trained to serve that purpose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A member of the crew of a spaceship or other spacecraft that travels beyond Earth's atmosphere, or someone trained to serve that purpose.",
                                            "An American space traveler, when contrasted against equivalent terms from other countries such as cosmonaut, taikonaut, spationaut, and vyomanaut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25a06f5c-135e-4fcd-a2d7-9704e471a58b",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "Though from different social, economic, and political worlds, the astronauts and cosmonauts had much in common, both as professionals and human beings."
                                            },
                                            {
                                                "example_id": "f39e87f6-421a-4aa2-ab46-8076dde111ef",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "The American astronauts in the competing Mercury program may have joked about being “Spam in a can,” but it seems clear that Korolev wanted to have plenty of cosmonauts on hand in case another rocket blew up."
                                            },
                                            {
                                                "example_id": "a536c303-9204-4fb3-8e79-e0e9779646ac",
                                                "sense_id": "e392b371-50e0-3e9f-a3b1-f203fd3bb7be",
                                                "text": "Longtime NASA astronaut Don Pettit, who has ventured to space four times, returned to Earth on Saturday night from the International Space Station. Pettit, who turned 70 on Sunday, landed at 9:20 p.m. ET in a Soyuz spacecraft with Roscosmos cosmonauts Alexey Ovchinin and Ivan Vagner near Zhezkazgan, Kazakhstan, after a seven-month stay aboard the orbiting laboratory. […] Space doesn't just appear dark to astronauts aboard the space station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10b3cf56-18b8-3319-9301-ca7861b98e31",
                                        "entry_id": "19f5172b-87fa-335f-bee4-95f4719e9cf5",
                                        "glosses": [
                                            "A person (typically man) working abroad away from their family."
                                        ],
                                        "tags": [
                                            "Hong-Kong"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62f47501-601b-4ff1-b33e-eedb17f5851a",
                        "source_entry_id": "3485ef14-9636-3234-81f9-5cf68bb021e6",
                        "source_sense_id": "d6bed20d-ed4e-359b-8fff-7f0c36bf053c",
                        "source_sense_description": "iemand die zich buiten de dampkring van de aarde begeeft",
                        "target_lang_word": "spaceman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spaceman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fedadc1-72fb-3200-baac-24e824399e46",
                                        "entry_id": "2bb5f3e7-cc57-32d7-abf4-66d204549e1c",
                                        "glosses": [
                                            "An astronaut, often a male astronaut."
                                        ],
                                        "tags": [
                                            "childish",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34fe9dc6-92a5-4a91-bd7b-bb66ddec0761",
                                                "sense_id": "1fedadc1-72fb-3200-baac-24e824399e46",
                                                "text": "I want to be a spaceman when I grow up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36db85f-14ee-361c-82ed-8b936b2f890b",
                                        "entry_id": "2bb5f3e7-cc57-32d7-abf4-66d204549e1c",
                                        "glosses": [
                                            "A humanoid extraterrestrial."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42d2e86d-8470-4501-8847-d60d48c423a2",
                                                "sense_id": "f36db85f-14ee-361c-82ed-8b936b2f890b",
                                                "text": "A spaceman from Mars could easily pick out the most civilized nations here. They are the only ones who know how to make atom bombs."
                                            },
                                            {
                                                "example_id": "2c190340-d9e2-4dfd-a776-04acabcb56d6",
                                                "sense_id": "f36db85f-14ee-361c-82ed-8b936b2f890b",
                                                "text": "While in Los Angeles he was contacted by a spaceman from Saturn whose name was Ramu[…]"
                                            },
                                            {
                                                "example_id": "984cfbd7-c017-466e-90be-5da86f299e3b",
                                                "sense_id": "f36db85f-14ee-361c-82ed-8b936b2f890b",
                                                "text": "He was out UFO-hunting in the Mojave Desert, California, when he was greeted by a tall, blond spaceman from Venus"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "35a75a7c-d437-4149-b45d-b21ea08faaa9",
                        "source_entry_id": "3485ef14-9636-3234-81f9-5cf68bb021e6",
