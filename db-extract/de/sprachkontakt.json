                ],
                "senses": [
                    {
                        "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                        "entry_id": "edf7644d-38ba-3ed5-9993-9194db22a6c0",
                        "glosses": [
                            "Kontakt, Berührung zwischen Sprachen aufgrund geographischer Nähe, historischer Entwicklungen, politischer oder sozialer Bedingungen etc., wobei in vielen Fällen einseitige oder auch wechselseitige sprachliche Einflüsse zustande kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416cf3a0-e3d2-40fd-881b-2eaf3cb5c0c1",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "Sprachkontakte können auf vielfältige Weise zustande kommen: wenn Sprachen sehr lange geographisch benachbart sind, wenn jemand bilingual (zweisprachig) oder multilingual (mehrsprachig) aufwächst, wenn eine bestimmte Sprachgemeinschaft (kulturell, politisch, wissenschaftlich…) ein hohes Prestige genießt."
                            },
                            {
                                "example_id": "8b504dce-7c7f-48cc-aac5-250736136f9e",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "Aus geographischen Sprachkontakten können Sprachbünde hervorgehen."
                            },
                            {
                                "example_id": "8a60cb42-f571-498a-92ec-de92ecb366b5",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "Entlehnungen, Fremdwörter geben Zeugnis von Sprachkontakten."
                            },
                            {
                                "example_id": "ac6c4eea-7f4d-45e2-9881-3b4622076781",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "„Seit über hundert Jahren ist bekannt, daß geographisch benachbarte Sprachen - die genetisch nicht miteinander verwandt sind - strukturtypische Parallelismen aufweisen, für die es nur eine plausible Erklärung gibt, u. z. die durch die Nachbarschaft bedingten arealen Sprachkontakte.“"
                            },
                            {
                                "example_id": "fb66bcbf-e5c3-4155-bb5f-77b2d6564206",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "„Sprachkontakt, Zweisprachigkeit und Sprachenmischung bilden den Problemkreis dieses nun auch auf deutsch vorliegenden »Klassikers« der modernen Sprachwissenschaft, der für den Fortschritt der Soziolinguistik maßgebend wurde.“"
                            },
                            {
                                "example_id": "fc5e3ae6-27d5-4ef8-9af4-8066aac3f2c6",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "„Infolge vielfältiger Beziehungen zwischen den Sprachträgern, direkter Berührungen und kultureller Verbindungen, internationaler Zusammenarbeit kommt es auch zu sprachlichen Annäherungen, zu Sprachkontakten, zu wechselseitiger Beeinflussung der Sprachen und zu Entlehnungen im Wortschatz.“"
                            },
                            {
                                "example_id": "f6568f40-2eb1-41f5-9b7a-a4d148cdf5ff",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "„Bei den Zahlwörtern spiegelt sich am deutlichsten der intensive Sprachkontakt mit dem Dänischen wider.“"
                            },
                            {
                                "example_id": "efb71a63-42ae-424f-ad12-821f2359b221",
                                "sense_id": "f8170a22-f1b8-3f3a-9559-12cac6d8eb84",
                                "text": "„Dennoch haben diese Sprachkontakte zum Polnischen und anderen slawischen Sprachen gerade die östlichen Dialekte des Jiddischen nachhaltig geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
