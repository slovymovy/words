            "senses": [
                {
                    "sense_id": "b3318683-6d9a-38f1-b26a-e7c815cbb3f9",
                    "sense_definition": "Qui prend plaisir à faire souffrir ou qui manifeste une méchanceté impitoyable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mechant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce maître impitoyable est particulièrement <w>cruel</w> envers ses domestiques."
                        },
                        {
                            "text": "Les enfants peuvent parfois se montrer très <w>cruels</w> entre eux."
                        }
                    ],
                    "synonyms": [
                        "féroce"
                    ],
                    "antonyms": [
                        "doux",
                        "bienveillant"
                    ],
                    "common_phrases": [
                        "homme cruel",
                        "acte cruel"
                    ]
                },
                {
                    "sense_id": "7797cb64-76ac-3482-9f29-7012b0a44580",
                    "sense_definition": "Qui cause une vive souffrance morale ou physique ; très pénible et douloureux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "douloureux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le choix entre ces deux obligations représentait pour lui un <w>cruel</w> dilemme."
                        },
                        {
                            "text": "L'échec de ce projet tant attendu a été une <w>cruelle</w> déception pour toute l'équipe."
                        }
                    ],
                    "synonyms": [
                        "pénible"
                    ],
                    "antonyms": [
                        "agréable"
                    ],
                    "common_phrases": [
                        "cruel dilemme",
                        "cruelle déception",
                        "cruelle vérité"
                    ]
                },
                {
                    "sense_id": "d7fdf2ab-747b-3727-ab84-cc9d45f9fe28",
                    "sense_definition": "Qui reste insensible ou refuse obstinément de répondre aux avances d'un prétendant amoureux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insensible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poète se désolait devant cette beauté <w>cruelle</w> qui dédaignait ses hommages."
                        },
                        {
                            "text": "Elle demeurait <w>cruelle</w> et insensible aux déclarations passionnées de son soupirant."
                        }
                    ],
                    "common_phrases": [
                        "beauté cruelle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "registre galant ou poétique classique"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "facb2221-621e-3999-b815-79012369fec5",
                    "sense_definition": "Personne impitoyable qui fait preuve de férocité ou de méchanceté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "personne_cruelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face aux supplications des prisonniers, le <w>cruel</w> n'accorda aucune clémence."
                        },
                        {
                            "text": "Ce chef sanguinaire passait pour un véritable <w>cruel</w> auprès de la population."
                        }
                    ]
                },
                {
                    "sense_id": "9414e81e-7b9b-3d3c-821f-8a45c34a7a8a",
                    "sense_definition": "Femme insensible aux déclarations amoureuses d'un soupirant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insensible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune gentilhomme consacrait toutes ses nuits à composer des élégies pour émouvoir sa <w>cruelle</w>."
                        },
                        {
                            "text": "Dans le théâtre classique, l'amant éperdu se lamente souvent de la froideur de sa <w>cruelle</w>."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "utilisé en poésie et littérature classique"
