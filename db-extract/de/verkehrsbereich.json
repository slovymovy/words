                ],
                "senses": [
                    {
                        "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                        "entry_id": "6a89864a-378a-3748-8fae-c294f338f646",
                        "glosses": [
                            "Gelände, Raum, in dem Bewegungen von Personen und Gütern stattfinden beziehungsweise der für sie vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a331263c-abe1-45cb-b797-048f6ac23340",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„Gerade im Verkehrsbereich ist eine zunehmende Vernunftsteuerung des Kindes notwendig, da die Verkehrsgegebenheiten mit ihren Regelungen und Gefährdungen am ehesten Vernunftregelungen zugänglich sind und nur durch sie beherrschbar werden.“"
                            },
                            {
                                "example_id": "d280cf9a-ef29-454e-bce7-a0071526f1bf",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„Doch im Flugverkehr gelten andere Maßstäbe als in jedem anderen Verkehrsbereich, sagt Jörg Handwerg von der Pilotenvereinigung Cockpit.“"
                            },
                            {
                                "example_id": "fcb02b12-46e6-4bc7-8080-277dac55d2f8",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„Merkel betonte, sie sei einer Meinung mit Steinbrück, dass man in den Verkehrsbereich investieren müsse.“"
                            },
                            {
                                "example_id": "10156939-74c0-46c0-967f-0227ab236c5b",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„In Portugal waren vor allem der Verkehrsbereich und der öffentliche Dienst betroffen.“"
                            },
                            {
                                "example_id": "48454910-0f6e-4acc-844c-75046a1d3c13",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„Bei den geplanten Subventionskürzungen soll die Bahn nun doch nicht stärker belastet werden als andere Verkehrsbereiche.“"
                            },
                            {
                                "example_id": "2f63554d-abe6-40c6-bfe2-98f9992996b1",
                                "sense_id": "34b6c6ab-f607-316b-a52d-7ff0a5d7ca36",
                                "text": "„Zudem sollen im Verkehrsbereich zwei Milliarden Euro für Investitionen mobilisiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
