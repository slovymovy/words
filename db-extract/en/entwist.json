                        "target_lang_word": "flechten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flechten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02ed90ea-18f1-3a80-8f4e-a4c0bacf6db1",
                                        "entry_id": "caca35fb-45fa-3f60-8300-f458809342e1",
                                        "glosses": [
                                            "(meist) drei Stränge (zum Beispiel Haare oder Bänder) miteinander verschlingen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14db3394-4760-466d-95ce-7e65e875a278",
                                                "sense_id": "02ed90ea-18f1-3a80-8f4e-a4c0bacf6db1",
                                                "text": "Flicht dir endlich die Haare!"
                                            },
                                            {
                                                "example_id": "6962fe41-bd23-49a3-8087-81a570dc2996",
                                                "sense_id": "02ed90ea-18f1-3a80-8f4e-a4c0bacf6db1",
                                                "text": "Wenn der Stallbursche doch die Mähnen der Pferde nur sorgfältiger flöchte!"
                                            },
                                            {
                                                "example_id": "b84edb32-1da0-4fb1-aa82-3c977f6f5947",
                                                "sense_id": "02ed90ea-18f1-3a80-8f4e-a4c0bacf6db1",
                                                "text": "Du sollst die Wollfäden noch flechten."
                                            },
                                            {
                                                "example_id": "ca1acd8c-c43b-4f49-a159-b72664f2ec9e",
                                                "sense_id": "02ed90ea-18f1-3a80-8f4e-a4c0bacf6db1",
                                                "text": "Kannst du mit vier Strähnen flechten?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d15db8db-b2ca-3e8c-8203-f82b3a590625",
                                        "entry_id": "caca35fb-45fa-3f60-8300-f458809342e1",
                                        "glosses": [
                                            "etwas herstellen, indem man Stränge biegsamen Materials ineinanderschlingt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84410a5-142c-490c-a000-c17f73665854",
                                                "sense_id": "d15db8db-b2ca-3e8c-8203-f82b3a590625",
                                                "text": "Man kann aus Binsen einen Korb flechten oder aus Bast eine Matte flechten."
                                            },
                                            {
                                                "example_id": "e85269a6-16bc-4b6c-83d1-4588c4454a52",
                                                "sense_id": "d15db8db-b2ca-3e8c-8203-f82b3a590625",
                                                "text": "Früher trugen viele Frauen ihr Haar in geflochtenen Zöpfen."
                                            },
                                            {
                                                "example_id": "972969ff-2359-4d3b-9390-8503c3455d2f",
                                                "sense_id": "d15db8db-b2ca-3e8c-8203-f82b3a590625",
                                                "text": "Als junge Mädchen flochten wir uns gegenseitig lange Zöpfe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ceead061-0223-4de0-b238-6c5280dd499f",
                        "source_entry_id": "8fdcf376-00a8-39b0-8da0-3acd46d76042",
                        "source_sense_id": "6462bc1b-4bf9-3fed-8e1e-524e2d17b77f",
