                                            {
                                                "example_id": "42e4a769-8be9-4e00-b48a-3536760f1dac",
                                                "sense_id": "a8946c84-8ac4-3fab-9f77-8dcfdc7bc5d0",
                                                "text": "those which mocke and condemne it, intend neverthelesse to wrong this noble vertue; but onely to condemne the abuse and profanation of so sacred a title[…]."
                                            },
                                            {
                                                "example_id": "cffe73b7-571f-49ea-a53d-6f45d62f693c",
                                                "sense_id": "a8946c84-8ac4-3fab-9f77-8dcfdc7bc5d0",
                                                "text": "[…] but there is a time and a season for all things, and we look upon such attempts as that before us, with a certain portion of respect for a good intention, but as a lamentable want of judgment and good taste, not to speak of a familiarity with the phraseology of Scripture, little short of profanation."
                                            }
                                        ]
                                    }
                                ]
