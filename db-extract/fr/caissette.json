                "senses": [
                    {
                        "sense_id": "1de90964-49d4-3c9a-bd0b-f8f6da6ad968",
                        "entry_id": "a6d3ef84-9334-3d64-bd97-ba2d8d57c42c",
                        "glosses": [
                            "Caisse d’emballage de petite taille, facilement manipulable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88f183e-af24-4880-a6c7-32bbeba7a01d",
                                "sense_id": "1de90964-49d4-3c9a-bd0b-f8f6da6ad968",
                                "text": "Les hommes triaient le poisson, rejetaient les saletés à la mer, rangeaient soles et turbots dans des caissettes, entre des couches de glace."
                            },
                            {
                                "example_id": "4ecfc69b-b0b5-48d0-ac35-fada2ae4af21",
                                "sense_id": "1de90964-49d4-3c9a-bd0b-f8f6da6ad968",
                                "text": "Zariffa et ses compagnes dépouillaient les orangers de leurs fruits vermeils, que les hommes alignaient dans des caissettes de bois."
                            },
                            {
                                "example_id": "7b557e5b-964b-4f8a-a738-095544ba81a0",
                                "sense_id": "1de90964-49d4-3c9a-bd0b-f8f6da6ad968",
                                "text": "C’étaient des étalages de mangues et de figues, de melons et de pastèques, de citrons, de grenades, des sacs d’amandes, de noix, de pistaches, des caissettes de raisins de Smyrne et de Corinthe, de bananes séchées, de fruits confits, de dattes sèches jaunes et translucides."
                            }
                        ]
                    },
