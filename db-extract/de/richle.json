                "senses": [
                    {
                        "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                        "entry_id": "ff46fc71-61ac-3b22-b6f9-30d0a1852151",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cafbc9cc-ab50-4205-ae79-9611662bdb37",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Frau Richle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b886d436-2a9d-4143-bf7a-baa26faf0ce2",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Herr Richle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2a27f532-1f15-4bb1-86b5-00a66e4ca6e4",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Die Richles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8d31bb83-568b-4b9b-9bd0-75e9660bbcf6",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Der Richle trägt nie die Schals, die die Richle ihm strickt."
                            },
                            {
                                "example_id": "c9dfa556-d99b-4296-a880-6553c46f561d",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Richle kommt, geht der Herr Richle.“"
                            },
                            {
                                "example_id": "cec616a4-acb8-4440-a8c7-6f23cae7d94f",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Richle kommt und geht."
                            },
                            {
                                "example_id": "eaddb3af-6fdd-4d5e-81e6-fbe43398a707",
                                "sense_id": "62cfdc7b-c020-3d8f-9ef2-b552ba5dfcdd",
                                "text": "Richles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
