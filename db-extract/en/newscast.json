                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ad24fd-9126-41b8-8fe1-ec2647d1a9b1",
                                                "sense_id": "8676d058-3146-3fe7-b1fb-74e2d2c2c31b",
                                                "text": "„Für Dick und Doof kam selbst Papa aus der Garage hoch, was er normalerweise nur für die Tagesschau tat.“"
                                            },
                                            {
                                                "example_id": "0043d65f-a92d-4843-9ab9-4567628cb812",
                                                "sense_id": "8676d058-3146-3fe7-b1fb-74e2d2c2c31b",
                                                "text": "„Für mich ist die Tagesschau um acht so etwas wie ein großer Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "1cd9a3db-3dc1-4e20-b004-3ef0e06b23ff",
                                                "sense_id": "8676d058-3146-3fe7-b1fb-74e2d2c2c31b",
                                                "text": "„Die Tagesschau möchte wohl andeuten, dass verwaiste Baustellen im Volksmund Schlafbaustellen genannt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
