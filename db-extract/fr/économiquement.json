                                        "sense_id": "c2067c03-37e5-3d14-8a3f-c7abab912680",
                                        "entry_id": "01c6f520-dc72-34df-bfee-064f516c20c9",
                                        "glosses": [
                                            "wirtschaftlich gesehen, die Wirtschaft betreffend"
                                        ],
                                        "tags": [
                                            "ohne Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a383ff3-de79-411c-83fc-248182a7acf9",
                                                "sense_id": "c2067c03-37e5-3d14-8a3f-c7abab912680",
                                                "text": "Die ökonomische Entwicklung gibt derzeit zu Sorgen Anlass."
                                            },
                                            {
                                                "example_id": "18bcd832-1ba0-42af-911e-b90b8a8d3ea0",
                                                "sense_id": "c2067c03-37e5-3d14-8a3f-c7abab912680",
                                                "text": "„Doch je mehr Geld, Sklaven und Güter aller Art aus den eroberten Gebieten nach Rom strömten, desto entscheidender veränderte sich das ökonomische und soziale Gleichgewichte in der agrarisch geprägten Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "320839d0-c956-3250-9324-3d34584c2c68",
                                        "entry_id": "01c6f520-dc72-34df-bfee-064f516c20c9",
                                        "glosses": [
                                            "mit möglichst wenig Aufwand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba73f0b2-11bb-4ffb-90f7-b2ec1809a615",
                                                "sense_id": "320839d0-c956-3250-9324-3d34584c2c68",
                                                "text": "Wir müssen mit unseren Ausgaben so ökonomisch wie möglich verfahren."
                                            },
                                            {
                                                "example_id": "4746c44d-812a-4ef2-9c1e-9923f7f74b0b",
                                                "sense_id": "320839d0-c956-3250-9324-3d34584c2c68",
                                                "text": "„Das Genitivattribut erlaubt auf sehr ökonomische Weise Präzisierungen von Nominalgruppen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
