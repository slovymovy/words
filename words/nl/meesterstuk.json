{
    "word_family": [
        "meester",
        "meesterschap",
        "meesterlijk",
        "stuk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bebcef53-249f-3b22-965c-cc37925a5d9f",
                    "sense_definition": "Een werkstuk waarmee een ambachtsman bewijst dat hij zijn vak volledig beheerst om de titel van meester te verkrijgen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vakmanschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge timmerman werkte maandenlang aan zijn <w>meesterstuk</w> om toegelaten te worden tot het gilde.",
                            "target_lang_translations": {
                                "en": "The young carpenter worked for months on his <w>masterpiece</w> to be admitted to the guild."
                            }
                        },
                        {
                            "text": "Zonder een goedgekeurd <w>meesterstuk</w> kon men vroeger geen eigen werkplaats openen.",
                            "target_lang_translations": {
                                "en": "In the past, one could not open their own workshop without an approved <w>master's piece</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "historische context van gilden"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of work by which a craftsman proves his full mastery of his trade in order to obtain the title of master."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "masterpiece",
                                "target_lang_sense_clarification": "historical guild requirement"
                            },
                            {
                                "target_lang_word": "master's piece",
                                "target_lang_sense_clarification": "test of craftsmanship"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99e466ad-c003-35f6-9b66-53ab51e9048d",
                    "sense_definition": "Een kunstwerk of prestatie van uitzonderlijk hoge kwaliteit; het beste werk van een kunstenaar.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De Nachtwacht wordt algemeen beschouwd als het absolute <w>meesterstuk</w> van Rembrandt van Rijn.",
                            "target_lang_translations": {
                                "en": "The Night Watch is generally considered the absolute <w>masterpiece</w> of Rembrandt van Rijn."
                            }
                        },
                        {
                            "text": "Deze nieuwe symfonie is een <w>meesterstuk</w> dat alle critici in de stad heeft verrast.",
                            "target_lang_translations": {
                                "en": "This new symphony is a <w>masterwork</w> that has surprised all the critics in the city."
                            }
                        }
                    ],
                    "synonyms": [
                        "meesterwerk",
                        "topwerk",
                        "topstuk"
                    ],
                    "common_phrases": [
                        "absoluut meesterstuk"
                    ],
                    "target_lang_definitions": {
                        "en": "A work of art or achievement of exceptionally high quality; an artist's best work."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "masterpiece",
                                "target_lang_sense_clarification": "outstanding work of art"
                            },
                            {
                                "target_lang_word": "magnum opus",
                                "target_lang_sense_clarification": "greatest achievement"
                            },
                            {
                                "target_lang_word": "masterwork",
                                "target_lang_sense_clarification": "exceptional quality"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}