                        "translation_id": "2ef20f48-c3b0-4a9e-b0f9-36898ab12c12",
                        "source_entry_id": "24faba8c-0410-312a-9c05-92f0e4650387",
                        "source_sense_id": "d9288afe-2d6c-38a1-b8a0-6b76065b46ba",
                        "target_lang_word": "concertina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concertina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64373d96-beab-3941-ad2f-d1b2d1ddb3d3",
                                        "entry_id": "c4afb2d5-2a9a-355c-b7f0-b2c6fd616b72",
                                        "glosses": [
                                            "A musical instrument, like the various accordions, that is a member of the free-reed family of musical instruments, typically having buttons on both ends."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94680a66-334e-4077-a96d-f417cad1c72d",
                                                "sense_id": "64373d96-beab-3941-ad2f-d1b2d1ddb3d3",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            },
                                            {
                                                "example_id": "71e0c29c-cba4-4e5c-bb0f-a7c3de6c40a9",
                                                "sense_id": "64373d96-beab-3941-ad2f-d1b2d1ddb3d3",
                                                "text": "Elsewhere, professionals could enthuse over new precision instruments capable, for instance, of measuring weights down to a tenth of a milligram, or over a host of self-registering thermometers and barometers, microscopes, typewriters, calculators and all sorts of technical and musical devices, including automatic concertinas, edeophones, auto-harps, bigophones and other long-forgotten objects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7913bc08-e7b3-36bf-aa0c-410dda0badde",
                                        "entry_id": "c4afb2d5-2a9a-355c-b7f0-b2c6fd616b72",
                                        "glosses": [
                                            "Something multiply folded like a concertina, such as a folded book, a bus door or a set of picture frames that are folded together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f50f6bd3-c61b-3b85-8db6-86da05a0a27d",
                                        "entry_id": "c4afb2d5-2a9a-355c-b7f0-b2c6fd616b72",
                                        "glosses": [
                                            "Coiled barbed wire for use as an obstacle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e41a5a8-e02b-3b3d-8c11-0732b7d13305",
                                        "entry_id": "c4afb2d5-2a9a-355c-b7f0-b2c6fd616b72",
                                        "glosses": [
                                            "A type of booklet label, consisting of up to 32 pages of booklet as an insert."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "concertina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                                        "entry_id": "c9726fe8-8869-38ca-befa-1faf3fa61066",
                                        "glosses": [
                                            "To become compressed into a shape reminiscent of a concertina."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f770d264-af58-4128-a6d1-9657f8ac2108",
                                                "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                                                "text": "The car concertinaed into the wall."
                                            },
                                            {
                                                "example_id": "8d65f5dc-0b8c-492e-b919-f8687e368adb",
                                                "sense_id": "a493db24-523f-33da-9959-606c16367bf6",
                                                "text": "Millions of years ago the mica schists surrounding the old Brandberg West Mine became folded and concertinaed by enormous horizontal pressures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "680a47cb-dc1c-3f94-b479-0cb6c680d6ef",
                                        "entry_id": "c9726fe8-8869-38ca-befa-1faf3fa61066",
                                        "glosses": [
                                            "To be drawn closer and farther apart repeatedly, or up and down, as if situated on a working concertina's folds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f77ce8-0f0d-4dc6-a990-f395f3e06736",
                                                "sense_id": "680a47cb-dc1c-3f94-b479-0cb6c680d6ef",
                                                "text": "This resulted in some fragmentation of the line as the boats in some cases closed to just 50 metres as they concertinaed in and out of sight of each other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
