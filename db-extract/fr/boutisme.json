                        "cross_references": [
                            {
                                "target_word": "endianness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b732c9d-7c77-3859-a03a-16f82dc5b5a6",
                                        "entry_id": "619d071e-1a2d-3fdc-9ea7-d0b8015719d3",
                                        "glosses": [
                                            "The property of being either big-endian or little-endian."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14a4cce8-05ec-4f4b-8dea-854ffa744566",
                                                "sense_id": "2b732c9d-7c77-3859-a03a-16f82dc5b5a6",
                                                "text": "When reading and writing data a byte at a time, it is necessary to know the endianness of the computer you are working on."
                                            },
                                            {
                                                "example_id": "871b7664-2216-46f5-a5a5-298aea09ef6f",
                                                "sense_id": "2b732c9d-7c77-3859-a03a-16f82dc5b5a6",
                                                "text": "The Unicode standard does not specifically does not require a particular endianness of text written in Unicode; both big- and little-endian encodings are allowed."
                                            },
                                            {
                                                "example_id": "94643fb4-45f0-40d4-a894-0e398ee774e6",
                                                "sense_id": "2b732c9d-7c77-3859-a03a-16f82dc5b5a6",
                                                "text": "Endianness comes in two varieties: big and little."
                                            },
                                            {
                                                "example_id": "36a2d904-baf9-49a2-960e-97f2a9a9800e",
                                                "sense_id": "2b732c9d-7c77-3859-a03a-16f82dc5b5a6",
                                                "text": "An endianness difference can cause problems if a computer unknowingly tries to read binary data written in the opposite format from a shared memory location or file."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
