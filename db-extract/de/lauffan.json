                ],
                "senses": [
                    {
                        "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                        "entry_id": "1a80f016-d54c-3ee9-8da3-0104289449fd",
                        "glosses": [
                            "Person, die ein großes Interesse oder eine Begeisterung für das Laufen beziehungsweise den Laufsport hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b92f0372-5a71-4e8b-ba0e-902cd478670a",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Auch dieses Jahr ist für alle Lauffans etwas dabei: Der 4 km Lauf führt wieder quer durch den Zoopark.“"
                            },
                            {
                                "example_id": "3f5c8659-0004-416c-8e2c-60a9b423bb40",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Alles in allem ist das Buch ein informatives, praxisnahes Nachschlagewerk, welches die Hausbibliothek des ambitionierten Lauffans durchaus bereichern kann.“"
                            },
                            {
                                "example_id": "627b92d2-6b78-4ba9-bf8e-cbfb984284ce",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Vom Sportschuh für Lauffans bis zum Cafétisch, an dem die Liebesgeschichte begann, bringt Künstlerin Grit Vaccarisi Kuchen in jede denkbare Form.“"
                            },
                            {
                                "example_id": "7d87da9c-c80a-4cae-8763-7e21d27c121e",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Die italienischen Lauffans dürfen sich Hoffnungen auf eine Spitzenplatzierung durch U23-Europameisterin Nadia Battocletti machen, auch ihre Dauerrivalin aus Slowenien, Klara Lukan ist am Start, ebenso wie der Großteil der italienischen Mittelstrecken-Elite bei den Frauen.“"
                            },
                            {
                                "example_id": "9eda9944-d7d8-403a-b8bd-8454f385f364",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Damit verpasste der japanische TV-Sender die Rekordquoten des Vorjahrs zwar, allerdings waren damals aufgrund der Einschränkungen rund um die Pandemie weniger Lauffans an die Strecke gegangen.“"
                            },
                            {
                                "example_id": "4b095478-0a3f-49b3-bdbd-e84851f9cb78",
                                "sense_id": "531cd535-1858-3ce0-8d09-01c758a5298a",
                                "text": "„Vincent Kipchumba, der den österreichischen Lauffans dank seines tollen Siegs beim Vienna City Marathon 2019 bekannt ist, siegte wenige Monate später beim Amsterdam Marathon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
