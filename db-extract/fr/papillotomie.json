                        "glosses": [
                            "Incision de la papille (orifice qui mène aux voies biliaires et au pancréas)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1c0509-f234-4994-b717-d00d4a14becb",
                                "sense_id": "1ce12e4d-1f7b-359c-a83c-51f5e5b83ed4",
                                "text": "Ou bien la papillotomie est l’indication ultraformelle, je dirais volontiers qu’on ne peut pas enlever le calcul d’une autre façon que par papillotomie."
                            },
                            {
                                "example_id": "e92c1f3a-b434-41e1-9945-a7834313409f",
                                "sense_id": "1ce12e4d-1f7b-359c-a83c-51f5e5b83ed4",
                                "text": "Dans la plupart des cas, l’ouverture de l’orifice à l'aide d'un couteau électrique (intervention appelée papillotomie) est nécessaire afin d’avoir un meilleur accès aux voies biliaires ou pancréatiques."
                            },
                            {
                                "example_id": "233bc224-9dc8-4ac7-9ca9-03b7114d46ec",
                                "sense_id": "1ce12e4d-1f7b-359c-a83c-51f5e5b83ed4",
                                "text": "Dans cette situation, plusieurs techniques de précoupe ont été instaurées pour réussir le cathétérisme biliaire dont l’infundibulotomie et la papillotomie."
                            }
                        ]
                    }
