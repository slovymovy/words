                "senses": [
                    {
                        "sense_id": "f7b16d9d-104e-3c58-9642-4710eea621dd",
                        "entry_id": "eca588b0-e524-3c13-af6c-50884a986109",
                        "glosses": [
                            "to rain"
                        ],
