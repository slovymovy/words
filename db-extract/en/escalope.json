                    }
                ],
                "senses": [
                    {
                        "sense_id": "f23a1e8b-d983-392d-9604-205f0286c3d0",
                        "entry_id": "98fcd065-a789-3ce0-93ac-00fbc4e93e5c",
                        "glosses": [
                            "A thin slice of meat, especially veal or poultry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae2cdb4b-7d86-486b-b561-853cdb4bfaac",
                                "sense_id": "f23a1e8b-d983-392d-9604-205f0286c3d0",
                                "text": "Both the escalope de veau Normande and a special of the day, veal Orloff, seemed to be cut from the same veal roast, not thin escalopes at all, but thick chop-like slices. Only the sauces differed."
                            }
                        ]
                    },
                    {
                        "sense_id": "d322dccf-ac06-3909-8811-bdae67344d45",
                        "entry_id": "98fcd065-a789-3ce0-93ac-00fbc4e93e5c",
                        "glosses": [
                            "A charge (depiction) of the scallop."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18198464-5097-4a52-a49c-3a1447dc4761",
                        "source_entry_id": "98fcd065-a789-3ce0-93ac-00fbc4e93e5c",
                        "source_sense_description": "thin slice of meat",
                        "target_lang_word": "escalope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escalope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                        "entry_id": "f82b557a-c77d-3696-9345-99c27535b1f1",
                                        "glosses": [
                                            "Tranche mince de viande blanche ou de poisson, de foie gras, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04a8e432-0a5f-43f7-ae50-e4034ef6e22d",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "Une escalope de veau."
                                            },
                                            {
                                                "example_id": "5cbf99ec-4446-43dd-8877-4bf2d6d6d9dc",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "Escalope de turbot."
                                            },
                                            {
                                                "example_id": "7941ee7d-accf-46e2-a3d0-a2c45c261a4a",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "Les entrées venaient de paraître : des poulardes à la maréchale, des filets de sole sauce ravigote et des escalopes de foie gras."
                                            },
                                            {
                                                "example_id": "1888ac3f-d026-4403-8e80-9f5443958520",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "Mme Touche est une lourde personne dont les joues ressemblent à des escalopes crues."
                                            },
                                            {
                                                "example_id": "611eded4-681b-4051-9c58-23680271dbea",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "« Mais, que veux-tu, mon chéri, on n’écrit pas un beau livre comme on retourne une escalope ! »"
                                            },
                                            {
                                                "example_id": "523cf2bd-216f-4404-9b6e-9c1fe3f332cf",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "24 mai 1941 – Hier soir, chez une amie de Flora. Rien à manger et trois bouteilles de mousseux pour vingt. Je suis partie à dix heures, affamée. Celui qui m’aurait offert une escalope pannée [sic] m’aurait eue."
                                            },
                                            {
                                                "example_id": "9ce6be63-d385-4cde-879d-7f0d91603468",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "— Vous voyez ! Ça se prive de viande et de tout, ceux-là, pour pouvoir envoyer des cartes postales à des paumés comme eux. Paumés, va ! Moi, je reste là mais, au moins, je mange mon escalope midi et soir. Parce que, madame Snif, je digère plus que ça, l’escalope."
                                            },
                                            {
                                                "example_id": "d64e7619-13e6-440e-9ceb-419005dfd78c",
                                                "sense_id": "043a3d1d-9c3f-364a-94b6-438797580bb2",
                                                "text": "Son visage était la neutralité même. Rien ne bougeait sur sa peau rose comme un escalope de veau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00417917-5f7a-3660-bce5-3ef453a669bf",
                                        "entry_id": "f82b557a-c77d-3696-9345-99c27535b1f1",
                                        "glosses": [
                                            "Main."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d881adfc-96f0-47e6-811c-67bc91fce4e3",
                                                "sense_id": "00417917-5f7a-3660-bce5-3ef453a669bf",
                                                "text": "Se serrer l'escalope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf644f8-c74f-3820-b2ba-f281f0a0da48",
                                        "entry_id": "f82b557a-c77d-3696-9345-99c27535b1f1",
                                        "glosses": [
                                            "Grandes lèvres du sexe d'une femme."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66ff0836-0c1c-48fa-9fbe-847980cf4ca4",
                                                "sense_id": "2bf644f8-c74f-3820-b2ba-f281f0a0da48",
                                                "text": "Entre les deux jambes on lui voit pendre tout son truc, les grandes lèvres, les petites, les escalopes au grand complet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03147ce-8b52-33b7-9a7b-0c9cb882e470",
                                        "entry_id": "f82b557a-c77d-3696-9345-99c27535b1f1",
                                        "glosses": [
                                            "Divot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
