                "senses": [
                    {
                        "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                        "entry_id": "e20c6eb7-edbc-3c82-8599-bd0155af2007",
                        "glosses": [
                            "Donner à quelque chose des caractéristiques rappelant Mediapart."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfde9982-00e1-4629-8297-a01f2bf2f469",
                                "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                                "text": "Quand l’extrême-droite vénézuélienne mediapartise Valeurs Actuelles..."
                            },
                            {
                                "example_id": "7881c5f2-f198-4048-ac2b-e95f3c6120f9",
                                "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                                "text": "Voilà qu’on compte les mani-festinants, voilà qu’on bettencourise, voilà qu’on mediapartise."
                            },
                            {
                                "example_id": "8c366dff-e979-4a50-b883-e3e997ea2f7c",
                                "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                                "text": "Et le rédacteur en chef adjoint n’a finalement que ce simple conseil aux patrons de presse qui qui chercheraient à se «mediapartiser» : « Engagez de bons journalistes, laissez-les travailler et ne cherchez pas le retour immédiat sur l’investissement… »"
                            },
                            {
                                "example_id": "300570b7-ab04-40d5-a7db-fc2b979a8f1f",
                                "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                                "text": "Gk n’aurait pas une certaine tendance à se mediapartiser?"
                            },
                            {
                                "example_id": "4a14c4b5-22ad-44d5-96a8-d6b3d80834eb",
                                "sense_id": "07318f87-cb92-3cff-9235-b798e9e0b5c7",
                                "text": "Comment le Monde se mediapartise...."
                            }
                        ]
                    }
