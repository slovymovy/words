                "senses": [
                    {
                        "sense_id": "6b668a08-bb2c-3643-8263-5b4613a1793b",
                        "entry_id": "12c95a19-b3f2-3408-96ed-9c040421d325",
                        "glosses": [
                            "grasland in de bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f20c7ec4-91cf-4913-9086-a6251269b665",
                                "sense_id": "6b668a08-bb2c-3643-8263-5b4613a1793b",
                                "text": "Op deze route dompel je jezelf onder in de natuur van het Aosta-dal in de westelijke Italiaanse Alpen. Je trekt door de ongerepte landschappen van de Vallei van Gressoney. Vanaf de voet van de Monte Rosa biedt de Ayas Vallei een schitterende aanblik. Er lopen flink wat wandelroutes langs de vele bergweiden en knusse dorpjes met een rijke historie, waar het leven wordt beheerst door het ritme van de seizoenen."
                            },
                            {
                                "example_id": "f38fead0-9f9b-4495-9155-28e28b93c4a6",
                                "sense_id": "6b668a08-bb2c-3643-8263-5b4613a1793b",
                                "text": "Op veel winterbestemmingen in Oostenrijk, Frankrijk, Duitsland, Zwitserland en Italië met nog overwegend groene bergweiden regent het annuleringen in de kerstvakantie, die vandaag begint. Hotels, pensions en chalets die hun geld niet binnen hebben, zitten met de handen in het haar."
                            },
                            {
                                "example_id": "12faa3e9-8799-41d2-885a-2a51e63f8dc2",
                                "sense_id": "6b668a08-bb2c-3643-8263-5b4613a1793b",
                                "text": "Hij ging op het geluid af en zag, op een bergweitje tussen de rotsen, een kleine donkere jongen zijn geiten hoeden."
                            }
                        ]
                    }
                ],
