    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                "word": "Juliet",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9a39199-ad09-321b-afa8-03336473ad4c",
                        "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "glosses": [
                            "A female given name from Latin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408b4f9e-eac4-4667-8971-ac8cf3d6cb49",
                                "sense_id": "f9a39199-ad09-321b-afa8-03336473ad4c",
                                "text": "\"All I ask,\" she says, fitting the cigarette into a holder, \"is that you don't call me Juli-et. I cannot abide Juli-et. It maddens me!\" \"Yes, ma'am.\" \"Here, we say Joolyut. Joolyut. Joolyut. Say it for me.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "82244f79-f17d-3099-91b9-416c9e355f69",
                        "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "glosses": [
                            "One of the title characters of Shakespeare's play Romeo and Juliet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe02f97-8a60-47ac-8605-db742a7b2d35",
                                "sense_id": "82244f79-f17d-3099-91b9-416c9e355f69",
                                "text": "For never was a story of more woe / Than this of Juliet and her Romeo."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce84c6c7-a942-3f31-b73d-bfb4c299ca95",
                        "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "glosses": [
                            "A woman who is or is with a great lover."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "29e572aa-93a2-36cc-9ee3-2358bf0d1ed6",
                        "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "glosses": [
                            "By analogy with the Shakespeare character, a woman who is in love with a man from a family, party, or country opposing that of her own."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "025e2773-64c9-3d46-8478-1d9f22fc5df7",
                        "entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "glosses": [
                            "The sixth moon of the planet Uranus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3e636cd-6e94-4b3f-aaf6-25e9186e9f29",
                        "source_entry_id": "abef3d3a-79df-3522-9882-f0100598e3de",
                        "source_sense_description": "female given name",
                        "target_lang_word": "Juliette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Juliette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                        "entry_id": "e44a786f-9423-317b-b63e-68dcb9247451",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d39a1cd-65fb-402a-b39a-40c9c6746539",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "— Ça vous intéresse donc, vous, de savoir comment une femme s’appelle ?… Drôle de curiosité !… Elle s’appelle Juliette Roux…"
                                            },
                                            {
                                                "example_id": "16f07bac-93df-46ba-a485-7e0cd00a44d7",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "– Juliette, murmura M. Chavanais comme si le prénom de son amie contenait une longue explication.\n– Je vous écoute.\n– Juliette, reprit-il encore plus bas.\n– Eh bien, oui ?\n– Juliette…\n– Vous ne savez dire que cela.\n– C’est le plus beau prénom…"
                                            },
                                            {
                                                "example_id": "a80e5b4c-dc83-493e-a2a6-7b1706af4100",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Il glissa, en vrillant sur lui-même, et vit Juliette armer son bras pour un second coup."
                                            },
                                            {
                                                "example_id": "44fba7fe-cda8-48b5-81e3-b6ad9d9bb85c",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Les rôlistes sont ouverts et tolérants pour la plupart, mais aussi un peu conservateurs par leur histoire, précise Juliette Lancel, chercheuse indépendante en histoire."
                                            },
                                            {
                                                "example_id": "fe761b18-ca11-41b7-9709-9eb9696e979c",
                                                "sense_id": "80726d20-e1e8-3e1e-9986-27e5005ff6d5",
                                                "text": "Aujourd’hui, la fondatrice de Appelle ta Jacqueline est entourée d’une équipe de six jeunes filles — Élina, Lilirose, Melly, Juliette, Jade et Tlali —, âgées de 14 ans à 19 ans, toutes très impliquées dans l’avenir à construire à cette généreuse initiative qui repose sur les valeurs de partage, de solidarité, d’écoute et d’entraide."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
