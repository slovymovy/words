                        "sense_id": "d6eb41aa-0e78-35e9-91c4-34bbc732dbe3",
                        "entry_id": "9f59b5d3-495e-3d8d-81ee-8bb5b325f3fb",
                        "glosses": [
                            "To prepare or equip; make ready; set out; hurry about; bustle"
                        ],
                        "tags": [
                            "ambitransitive",
