                "senses": [
                    {
                        "sense_id": "ffe86dde-f314-3757-8abe-8246718e1052",
                        "entry_id": "ac38a68b-730d-3e55-8009-34e7ab9e6a2c",
                        "glosses": [
                            "A sacrifice."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c1d51ca-33f6-4aef-aacc-b1f620afdc80",
                                "sense_id": "ffe86dde-f314-3757-8abe-8246718e1052",
                                "text": "Kasparov's queen sac early in the game gained him a positional advantage against Kramnik."
                            }
                        ]
                    }
