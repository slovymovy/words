                    },
                    {
                        "translation_id": "33476485-afda-4f34-b247-ab77d137320d",
                        "source_entry_id": "eaa7dd7b-3df1-364c-b8c6-56cb03a7683c",
                        "source_sense_id": "78bd66d8-5ea0-399a-805d-fc37732f21e2",
                        "target_lang_word": "notleidend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notleidend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                        "entry_id": "a96b5966-6a72-3c2f-97f4-4cec16593976",
                                        "glosses": [
                                            "direkt an wirtschaftlicher Not leidend, direkt in wirtschaftlicher Not lebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d465631-03aa-41fd-87dc-77df00a21c80",
                                                "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                                "text": "„Was wir hinter uns zurücklassen, sind Tausende und Abertausende von Toten und Krüppeln, eine notleidende Bevölkerung, verwundet an Leib und Seele, ein verwüstetes Land, eine nahezu lahmgelegte Wirtschaft und Generationen mutloser Bürger, denen das Leben praktisch keine Aussichten bietet.“"
                                            },
                                            {
                                                "example_id": "6560c616-bc85-4e0e-b8b4-fc25a6446f56",
                                                "sense_id": "8e284804-c2a5-3bbb-92bf-65a3faeabbf1",
                                                "text": "„Jeder Bauauftrag brachte der notleidenden Bevölkerung Arbeit und damit Lohn und Brot.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0140a1c-74e6-3eaa-b4b8-1e2ce714a562",
                                        "entry_id": "a96b5966-6a72-3c2f-97f4-4cec16593976",
                                        "glosses": [
                                            "eine eingegangene wirtschaftliche Verpflichtung nicht erfüllen könnend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9927af-827b-497d-bb24-7c072764a5e7",
                                                "sense_id": "a0140a1c-74e6-3eaa-b4b8-1e2ce714a562",
                                                "text": "„Als Ende 2008 die Hypo 900 Millionen an Steuergeld erhielt, lag dem eine Einstufung der Bank durch die Oesterreichische Nationalbank zu Grunde, welche die Ertragslage des Instituts als \"distresses\", also als \"nicht notleidend\" angab."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
