                                "example_id": "7d0ae9dc-5486-45c1-9c3d-618bb345c1fa",
                                "sense_id": "2caff82b-f585-3944-88a9-2f4f7e03a125",
                                "text": "W sklepie u Wacława widziałam pistolety na wodę."
                            },
