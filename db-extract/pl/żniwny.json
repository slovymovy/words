                        "source_sense_id": "61a496a2-7ae1-39c3-b3dd-dd6d223fcb5f",
                        "target_lang_word": "жатвенный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жатвенный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bcbe2bce-80d0-3ad2-be23-d7246dcce6e8",
                                        "entry_id": "ac8c8bdf-a549-32a5-917c-7e0a45513fe8",
                                        "glosses": [
                                            "с.-х. связанный, соотносящийся по значению с существительным жатва; используемый, предназначенный для жатвы и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b67c1293-4ae6-4251-9549-dce177be5aa1",
                                                "sense_id": "bcbe2bce-80d0-3ad2-be23-d7246dcce6e8",
                                                "text": "Они ездили кататься и смотреть действие вновь привезенных жатвенных машин."
                                            },
                                            {
                                                "example_id": "00c29a6d-fedc-47cb-be06-8d90e3e5abc0",
                                                "sense_id": "bcbe2bce-80d0-3ad2-be23-d7246dcce6e8",
                                                "text": "Зато следующие три показались годом: в работах перерыв; ходить по горам без цели не тянуло, да и устали мы за жатвенные дни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
