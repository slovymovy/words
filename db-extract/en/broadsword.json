                    },
                    {
                        "translation_id": "7cf769a3-9d24-44b4-b6b2-41e0cd0bd526",
                        "source_entry_id": "368330e1-7f86-3502-b090-de6daddae6fe",
                        "source_sense_description": "longsword with a broad cutting blade",
                        "target_lang_word": "пала́ш",
                        "target_lang_code": "ru",
