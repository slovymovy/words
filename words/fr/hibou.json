{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9dba80d-0648-3cf3-8679-12326fa35298",
                    "sense_definition": "Rapace nocturne caractérisé par de grands yeux et des aigrettes de plumes sur la tête qui ressemblent à des oreilles.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "oiseau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le vieux chêne près de la grange, un grand <w>hibou</w> chante chaque nuit."
                        },
                        {
                            "text": "Nous avons aperçu plusieurs <w>hiboux</w> chassant au-dessus des champs au crépuscule."
                        }
                    ],
                    "common_phrases": [
                        "hibou grand-duc",
                        "hibou moyen-duc"
                    ]
                },
                {
                    "sense_id": "706a92aa-dc19-3457-9b30-ff6d114f8613",
                    "sense_definition": "Personne solitaire, triste ou renfermée, qui fuit la société et le monde.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il a pris sa retraite, il vit comme un <w>hibou</w> au fond des bois."
                        },
                        {
                            "text": "Il refuse toutes nos invitations et reste chez lui comme un vieux <w>hibou</w>."
                        }
                    ],
                    "synonyms": [
                        "misanthrope",
                        "ours",
                        "solitaire"
                    ],
                    "common_phrases": [
                        "faire le hibou",
                        "vivre en hibou"
                    ]
                },
                {
                    "sense_id": "cebd7923-b3b5-3547-9c63-d714bbfed426",
                    "sense_definition": "Figure représentant ce rapace dans les armoiries.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les armes de cette commune portent un <w>hibou</w> d'argent sur un fond rouge."
                        },
                        {
                            "text": "Le chevalier avait fait peindre un fier <w>hibou</w> aux ailes déployées sur son bouclier."
                        }
                    ]
                },
                {
                    "sense_id": "4cfe8980-7178-3385-97bb-a4e98cb8fe0e",
                    "sense_definition": "Nom usuel d'un papillon nocturne également appelé fiancée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entomologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>hibou</w> est un papillon de nuit aux ailes postérieures bordées de noir."
                        },
                        {
                            "text": "En ouvrant la fenêtre hier soir, j'ai vu un <w>hibou</w> attiré par la lampe du salon."
                        }
                    ],
                    "synonyms": [
                        "fiancée"
                    ]
                }
            ]
        }
    ]
}