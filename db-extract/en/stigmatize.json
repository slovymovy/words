                                "target_senses": [
                                    {
                                        "sense_id": "b9ea0676-a685-3838-b213-8b3a85bda6a8",
                                        "entry_id": "bd493196-add9-30ad-bf0f-65bd9ebb4c3d",
                                        "glosses": [
                                            "jemanden öffentlich bloßstellen, anprangern, heftig kritisieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1050a363-a0a9-4f05-93cc-4173dda1ce14",
                                                "sense_id": "b9ea0676-a685-3838-b213-8b3a85bda6a8",
                                                "text": "Ronald Reagan brandmarkte in den 1980er-Jahren die „Sozialschmarotzer“ – und seither trägt die staatliche Lebensmittelhilfe, die per Kreditkarte in Supermärkten eingelöst wird, ein soziales Stigma."
                                            },
                                            {
                                                "example_id": "4b71362f-532f-4b27-9d00-e3570233dd88",
                                                "sense_id": "b9ea0676-a685-3838-b213-8b3a85bda6a8",
                                                "text": "Das US-Repräsentantenhaus wird voraussichtlich am Mittwoch über eine Gesetzesvorlage abstimmen, die künstlich niedrig gehaltene Wechselkurse kritisiert und als Export-Subvention brandmarkt."
                                            },
                                            {
                                                "example_id": "3cc52205-eb85-42f6-8d5f-a527044fd123",
                                                "sense_id": "b9ea0676-a685-3838-b213-8b3a85bda6a8",
                                                "text": "Die Regierung wehrte sich vor dem Treffen gegen den Vorwurf, sie wolle wegen der Ausschreitungen in der Bretagne einzelne Volksgruppen wie die Roma brandmarken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6be6786-d8bf-363f-89eb-33602c6b9163",
                                        "entry_id": "bd493196-add9-30ad-bf0f-65bd9ebb4c3d",
                                        "glosses": [
                                            "jemandem mit dem Brandeisen ein Zeichen, meist auf die Stirn, als Strafe einbrennen"
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e748097-223b-46b3-b3c9-352eeb0db357",
                                                "sense_id": "b6be6786-d8bf-363f-89eb-33602c6b9163",
                                                "text": "Die Taxe für den Nürnberger Nachrichter, eine Person zu brandmarken, wurde mit 5 Gulden festgelegt."
                                            },
                                            {
                                                "example_id": "8fec95b4-fa2c-4e1e-b622-dd4b942ac638",
                                                "sense_id": "b6be6786-d8bf-363f-89eb-33602c6b9163",
                                                "text": "» …; ich gab ihr mein Vermögen, ich gab ihr meine Hand, und eines Tages entdeckte ich, daß diese Frau gebrandmarkt war. Diese Frau trägt an der linken Schulter das Brandmal einer Lilie.«"
                                            },
                                            {
                                                "example_id": "9d35e600-e7fa-494d-b4b2-678e2d674353",
                                                "sense_id": "b6be6786-d8bf-363f-89eb-33602c6b9163",
                                                "text": "Er ward von der Jury oder den zwölf Geschwornen gerichtet, und sie erklärten ihn für guilty of Manslaughter, oder des unvorsätzlichen Todschlages schuldig, worauf er mit einem kalten Eisen in die Hand gebrandmarkt wurde, welches Recht der Adel und die Geistlichkeit vor andern Mördern voraus hat."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
