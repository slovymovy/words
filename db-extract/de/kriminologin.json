                "senses": [
                    {
                        "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                        "entry_id": "2c78dc0d-0fb1-38b9-8046-997b0809fa96",
                        "glosses": [
                            "fachkundige weibliche Person/Forscherin auf dem Gebiet der Kriminologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5090bcdd-59ab-4689-b341-64231c665569",
                                "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                                "text": "„Zu Wort kommen außerdem Sozialarbeiter, Polizeibeamte, der Berliner Jugendrichter Andreas Müller und die Kriminologin Kirstin Drenkhahn.“"
                            },
                            {
                                "example_id": "fc48f43a-5247-4f5d-b440-3bc130232928",
                                "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                                "text": "„Bislang leitete die Kriminologin der belgischen Universität Leuven die unabhängige Untersuchungskommission alleine.“"
                            },
                            {
                                "example_id": "59188809-ef72-4230-a3b5-9a71e56e31ad",
                                "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                                "text": "„Die Vorsitzende der von der Hochschule eingerichteten Evaluierungskommission, die Kriminologin Letizia Paoli, hat in einer 62-seitigen Darstellung ihren Vorwurf, der frühere Rektor der Universität, Professor Wolfgang Jäger, habe den Arbeitsauftrag des Gremiums eingegrenzt und damit manipuliert, untermauert.“"
                            },
                            {
                                "example_id": "153ad8da-de6c-4828-8626-4ff781b8b42b",
                                "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                                "text": "„Überhaupt soll ja, wie uns sachkundige Kriminologinnen berichten, das Verbrechen des Upskirtings sich ‚meist unbemerkt‘ vollziehen, weshalb die Einführung des geplanten neuen Tatbestands als Antragsdelikt einen etwas speziellen legislatorischen Reiz hat.“"
                            },
                            {
                                "example_id": "07db9ded-16e8-4efe-b4ad-a1ef06a3aa22",
                                "sense_id": "eeaeac51-98ff-3a95-bb95-926ea5fa5d13",
                                "text": "„Später wurde sie zu einer der führenden Kriminologinnen Israels.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
