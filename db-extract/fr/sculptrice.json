                    },
                    {
                        "translation_id": "0c86b4fc-eb71-45a4-99b4-e067f9e07d31",
                        "source_entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
                        "target_lang_word": "sculptor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                        "entry_id": "b7dcc270-1bd7-30ab-8089-30fdfadcf77e",
                                        "glosses": [
                                            "A person who sculpts; an artist who produces sculpture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00f46a1-0fa2-4389-8e7d-7ed6183de142",
                                                "sense_id": "fc4fe6c7-832c-351c-bb07-bc4270f392b0",
                                                "text": "The feisty wife of a world-renowned Russian sculptor emasculated an armed thug outside her Soho home — saying he “didn’t have the cojones to shoot her,” police sources said yesterday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47ba7480-51f4-4bf9-99fe-c6e7f1e46297",
                        "source_entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
                        "target_lang_word": "sculptrix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptrix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e27dfb6-14b6-3220-87b3-d2d4ba7715fc",
                                        "entry_id": "6aee3d1f-45cb-3158-a5f7-1bd07fdb5537",
                                        "glosses": [
                                            "A woman who sculpts; a female sculptor; a sculptress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "058bc01b-1fe3-4f95-b662-41a5b2bc0544",
                                                "sense_id": "7e27dfb6-14b6-3220-87b3-d2d4ba7715fc",
                                                "text": "The Honourable Anne Seymour Damer, sculptrix, was born in London, of parents the most illustrious[.]"
                                            },
                                            {
                                                "example_id": "7f7969fe-eea5-4786-9b83-75d0aa4b55cc",
                                                "sense_id": "7e27dfb6-14b6-3220-87b3-d2d4ba7715fc",
                                                "text": "[F]ather had the pleasure of driving Mrs. Hill and her sister afterwards to a meeting of the Livingstone Memorial Committee in George Street, where we had cake and wine, and he, as Member for the city, proposed a vote of thanks to the gifted sculptrix in a beautiful little speech which came warm from his heart, and which she seemed much to appreciate."
                                            },
                                            {
                                                "example_id": "260363ec-5364-497a-a679-026cbb9b4e70",
                                                "sense_id": "7e27dfb6-14b6-3220-87b3-d2d4ba7715fc",
                                                "text": "2001, Larissa Golden Brown and Martin John Brown, Demystifying Grant Seeking: What You Really Need to Do to Get Grants (Jossey-Bass; →ISBN, 9780787956509), page ?\nWendy is a 29-year-old mixed media sculptrix with an MFA from Port University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c4ff5e-0321-4fb8-89de-c4256a234e31",
                        "source_entry_id": "89597711-27c0-3c8d-8b36-8d7bfa01ebbb",
                        "target_lang_word": "sculptress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sculptress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a4eaac8-91f5-34cd-8323-a62b040f4043",
                                        "entry_id": "9dbefc75-12c3-311d-89d5-64b8a963d1ad",
                                        "glosses": [
                                            "A female sculptor."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8d03d8-2244-4c26-9b46-faadacb223e7",
                                                "sense_id": "0a4eaac8-91f5-34cd-8323-a62b040f4043",
                                                "text": "Nor may vve here omit to celebrate for the glory of the Sex, Propertia de Roſſi, a Florentine Sculptreſs; vvho having cut ſtupendious things in Marble, put forth alſo ſome rare things in Stampi to be encountred amongſt the Collections of the Curious."
                                            },
                                            {
                                                "example_id": "198dec12-5c26-4992-911c-36cae53bb86b",
                                                "sense_id": "0a4eaac8-91f5-34cd-8323-a62b040f4043",
                                                "text": "The opening of GALAS in Boston signifies the first organized presentation of lesbian-created art in this city. Over 60 photographers, painters, craftswomen, sculptresses, and performing artists are participating in this month-long celebration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
