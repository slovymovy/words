                                "target_senses": [
                                    {
                                        "sense_id": "9b559f5d-8d55-3350-99c6-c883e06caa06",
                                        "entry_id": "8fe62d8d-5066-3fd0-bdf6-0289d112a85c",
                                        "glosses": [
                                            "wyciągać kogoś z kłopotów, tarapatów"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1271cb39-1d32-4846-9149-18e957a51b1a",
                                                "sense_id": "9b559f5d-8d55-3350-99c6-c883e06caa06",
                                                "text": "Wyruszyliśmy, by ratować naszych przyjaciół."
                                            },
                                            {
                                                "example_id": "bc9e7e78-a165-4cd3-8c99-14efcd83bd2d",
                                                "sense_id": "9b559f5d-8d55-3350-99c6-c883e06caa06",
                                                "text": "Podejmij jakieś działania, jeśli chcesz ratować firmę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
