                        ],
                        "examples": [
                            {
                                "example_id": "8ba3a78f-4078-4744-ab97-343d7fa547a7",
                                "sense_id": "edc01804-ba48-3def-a290-140bea0f017c",
                                "text": "Het gaat om hetgeen realiter gebeurd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a73e500-55e2-4d3c-9792-de35abc87650",
                        "source_entry_id": "ad4eb6a3-2e5b-33a2-9fc3-d6b626bee1ce",
                        "source_sense_id": "edc01804-ba48-3def-a290-140bea0f017c",
                        "source_sense_description": "in werkelijkheid",
                        "target_lang_word": "realiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "realiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3f377f-80d9-3143-8fa5-e50e5906c55f",
                                        "entry_id": "f23e68f8-0d8a-3a3d-8666-e50f07d282c8",
                                        "glosses": [
                                            "in Wirklichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33aeec1c-b087-46bf-9a8e-e39dcc71cf61",
                                                "sense_id": "7e3f377f-80d9-3143-8fa5-e50e5906c55f",
                                                "text": "„Doppelgänger sind bedrohlich und die Erfahrung, einem Wiedergänger realiter gegenüberzustehen, empfand ich regelmäßig als personifizierten Angriff auf das eigene Selbst, als narzisstische Kränkung: Bin ich tatsächlich so seltsam wie der da?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21130247-1a50-4098-a230-5f52973c33d2",
                        "source_entry_id": "ad4eb6a3-2e5b-33a2-9fc3-d6b626bee1ce",
                        "source_sense_id": "edc01804-ba48-3def-a290-140bea0f017c",
                        "source_sense_description": "in werkelijkheid",
                        "target_lang_word": "really",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "In a way or manner that is real, not unreal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a8e63-d433-4df4-a07c-de3a4fbebb19",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "We are to believe that by an extraordinary Conception by Means of the holy Ghost he in an extraordinary MANNER, (unknown to us) really assumed Flesh, and was by her nourished in the Womb and in due Time born in a natural Manner, and that whilst on Earth he was really hungry, and dry, and eat and drank as really as other Men, without, any Deception of Sight in us or Delusion whatsoever."
                                            },
                                            {
                                                "example_id": "fa0b85b9-aad1-434e-97e7-65878e996862",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "If we take the phenomenal world as it strikes our senses, in all its varied and wonderful powers and aspects; as the mere symbol of the Divine Presence and power, that is, according to Christ, ever in, through, and over all, as really as are causal light, heat and gravity, or as really as our own life and souls pervade every atom of our bodies, [...]"
                                            },
                                            {
                                                "example_id": "0dfb3646-05b9-46a6-9777-5a4253706e6d",
                                                "sense_id": "7822c76c-3ee9-30f3-8062-762dc9f73428",
                                                "text": "Thus Brahman must be described as ‘really real’, while a rope, or a person, or God Himself, is ‘unreally real’. And it is only the Vedantin who can distinguish the real from the unreal, for to others all seems real."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Actually; in fact; in reality."
                                        ],
                                        "tags": [
                                            "modal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f698d2fb-ec01-41af-be15-ab2d936c3910",
                                                "sense_id": "11a26b45-1676-3caa-be56-f70e062d2cc1",
                                                "text": "\"He really is a true friend.\" / \"Really? What makes you so sure?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                        "entry_id": "810a22a4-4c81-3e82-a1dd-0280107e99f2",
                                        "glosses": [
                                            "Very (modifying an adjective); very much (modifying a verb)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d557a52-0785-43dd-b374-4de4a1b158cf",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "But ma, I really, really want to go to the show!"
                                            },
                                            {
                                                "example_id": "61416a01-e612-4565-864e-21766212f3ea",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "9c904749-08ca-41ce-8dbc-8a0f46de71bd",
                                                "sense_id": "62ef6d4e-42e2-3c46-899e-1da8878ad42a",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27dc7852-d518-4a8f-933d-341df701f6b9",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "A: He won the Nobel Prize yesterday."
                                            },
                                            {
                                                "example_id": "cd4159f2-67b5-4246-b76b-a74030122215",
                                                "sense_id": "67dc317a-e778-3869-8323-c182e9afba2e",
                                                "text": "B: Really?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating surprise at, or requesting confirmation of, some new information; to express skepticism.",
                                            "A phatic confirmation by a listener, to signal active listening; mostly devoid of literal meaning, with the phatically contrived incredulity being merely formulaic."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "589720c6-b17e-4343-8b69-fcc8e76698d4",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "A: You know, I saw Oliver the other day."
                                            },
                                            {
                                                "example_id": "caa44746-8434-44f8-91aa-e16650ee6933",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "B: Really? What's he been up to?"
                                            },
                                            {
                                                "example_id": "68c7ad7c-b748-4256-98a2-9804592d98f3",
                                                "sense_id": "1a9457c4-449e-3b07-93a2-4e676375e34c",
                                                "text": "\"Literally\" is not the only word that has lost touch with reality: look at \"really.\" That word also was meant to describe a state of reality, or literalness. Even as a substitute for \"Is that so?,\" the word asked, \"Is that true, or real?\" Nowadays, one guy goes, \"I literally flew off the handle,\" and the other guy goes \"Really.\" It's a grunt, meaning, \"I'm still here.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating that what was just said was obvious and unnecessary; contrived incredulity"
                                        ],
                                        "tags": [
                                            "informal",
                                            "sarcastic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "815b625c-e932-440c-b2cc-9d439ef49ef9",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "A: I've just been reading Shakespeare - he's one of the best authors like, ever!"
                                            },
                                            {
                                                "example_id": "671c3f5e-a06e-4013-a1f1-438d0d0a8a65",
                                                "sense_id": "d7432c22-5e10-3c8f-a9d5-600ae00195ce",
                                                "text": "B: Really."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating affirmation, agreement."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb27bef-c7c4-43f2-abe3-7a562e84913b",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "A: That girl talks about herself way too much."
                                            },
                                            {
                                                "example_id": "216152de-eaef-44ab-85ec-fa682d7c5d19",
                                                "sense_id": "94161544-5a04-3942-b9e8-82154dc0de65",
                                                "text": "B: Really. She's a nightmare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                        "entry_id": "d477883b-7970-3f32-90f1-27400d43265b",
                                        "glosses": [
                                            "Indicating displeasure at another person's behaviour or statement."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887fb587-bf8b-4d56-a0b1-9a32fb658e15",
                                                "sense_id": "f802388c-adfa-39f5-bd1d-e9da67f06087",
                                                "text": "Well, really! How rude."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "really",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                        "entry_id": "14bd7a7d-e7bd-3ac3-96f2-497367f55566",
                                        "glosses": [
                                            "Alternative form of re-ally."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5568d978-e346-421a-9359-efa3752f9b23",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "She wished since long to die and to be reallied with her children in heaven."
                                            },
                                            {
                                                "example_id": "87d4e24d-eb20-42eb-97c7-37dd5b43cef6",
                                                "sense_id": "a84d5555-c120-31fb-8c4a-8829174ec04b",
                                                "text": "Following the election, those who had publicly opposed Harding hastened to really themselves with Republicans who had remained in the party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
