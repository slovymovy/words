                "senses": [
                    {
                        "sense_id": "3ac857c8-7a15-3fc8-92f7-ecfd9ccd8804",
                        "entry_id": "d474e24a-cf85-32e8-a3ac-b607f7253348",
                        "glosses": [
                            "freier Einwohner des Stadtstaates Sparta (Lakedämon)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "d7b2ba16-d585-4104-8a42-7c16441c0ff2",
                                "sense_id": "3ac857c8-7a15-3fc8-92f7-ecfd9ccd8804",
                                "text": "„Die Lakedämonier beschlossen nun, sie zu töten, ergriffen sie und warfen sie in das Gefängnis.“"
                            },
                            {
                                "example_id": "d576023b-77c7-40f7-9d7c-dd51313d94d8",
                                "sense_id": "3ac857c8-7a15-3fc8-92f7-ecfd9ccd8804",
                                "text": "„Die Lakedämonier wußten, daß sie den Tod von denen zu erwarten hätten, welche um den Berg herumgekommen waren; daher zeigten sie den Feinden die Größe ihrer Tapferkeit und gingen mit großer Verachtung auf sie los.“"
                            },
                            {
                                "example_id": "8c98572b-bef6-48d3-b1d7-967259cc54a3",
                                "sense_id": "3ac857c8-7a15-3fc8-92f7-ecfd9ccd8804",
                                "text": "„Die Lakedämonier hatten die Führung über die verbündeten Mächte, ohne sie sich zinsbar zu machen, und begnügten sich bloß damit, deren Staatsverfassung mehr nach ihrer Gewohnheit oligarchisch einzurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
