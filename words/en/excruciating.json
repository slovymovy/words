                            },
                            {
                                "target_lang_word": "insoportable",
                                "target_lang_sense_clarification": "que apenas se puede tolerar"
                            },
                            {
                                "target_lang_word": "lacerante",
                                "target_lang_sense_clarification": "que produce un dolor agudo y desgarrador"
