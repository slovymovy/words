                                    {
                                        "sense_id": "d2db221d-9a39-3bdc-bbea-422c523b88fa",
                                        "entry_id": "5d41e192-e869-3e97-96c9-f9aa89dd2063",
                                        "glosses": [
                                            "A wooden crossbar for a plough or carriage, pivoted in the middle, from which traces are fastened to a draught animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baee2486-930b-44aa-b7ea-6251176b11e9",
                                                "sense_id": "d2db221d-9a39-3bdc-bbea-422c523b88fa",
                                                "text": "The single whippletree should have a chain attached to bring it out even with the other two."
                                            },
                                            {
                                                "example_id": "1b3d2d6d-094c-4925-a5ff-a7297e43ae09",
                                                "sense_id": "d2db221d-9a39-3bdc-bbea-422c523b88fa",
                                                "text": "Like the whippletree, the wheelbarrow only became known in the Middle Ages."
                                            },
                                            {
                                                "example_id": "9719ccb6-e8ea-4c90-b035-593aea62a121",
                                                "sense_id": "d2db221d-9a39-3bdc-bbea-422c523b88fa",
                                                "text": "Note the two-horse whippletree on the beam at the lower left. (A whippletree, of which this is the simplest possible, balances the load on the animals.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
