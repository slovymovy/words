                        "examples": [
                            {
                                "example_id": "71364ee8-9a3c-4bfa-bc0b-85e5f4bbf344",
                                "sense_id": "b02cfb1f-d384-3f77-b406-44e5b6590e1c",
                                "text": "De ingefreesde tekst - '1939 - 1945 ons de vrijheid te hergeven vroeg het offer van hun leven' op de buitenrand van het bassin was vroeger ook in brons uitgevoerd, maar de letters zijn eveneens gestolen. Hier komt geen brons meer."
                            },
                            {
                                "example_id": "aad4e461-102f-4694-807d-4390baa16d3e",
                                "sense_id": "b02cfb1f-d384-3f77-b406-44e5b6590e1c",
                                "text": "Aan de buitenrand nog stroken dungesneden en gerookte knolselderij, die bijna het voorkomen en de structuur hebben gekregen van vetspek."
                            },
                            {
                                "example_id": "a9a0c7f2-2892-4c1f-86fb-dd10c875f743",
                                "sense_id": "b02cfb1f-d384-3f77-b406-44e5b6590e1c",
                                "text": "De trek van het platteland naar de stad blijft doorgaan. De haperende woningmarkt aan de buitenranden van Nederland zorgt ervoor dat lokale makelaars, notarissen, stoffeerders en witgoedzaken hun heil zoeken in de steden."
                            }
                        ]
                    }
