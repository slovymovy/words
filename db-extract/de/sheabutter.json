                        "glosses": [
                            "aus der Kariténuss gewonnenes Pflanzenfett"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b50d22-1148-487a-ae02-70a914797630",
                                "sense_id": "66af31d5-28d5-39ef-99c8-0ddc899fcc8f",
                                "text": "„Ich schließe die Augen und atme den Duft von Kokosöl und Sheabutter ein, den ihre Locken ausströmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
