        "fr-extract.jsonl": [
            {
                "entry_id": "f4f45f53-7a0f-3541-b3f3-c9c0ecf768b9",
                "word": "adultération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "59e0ae27-f5d0-4026-92c0-9a7c1b362b2d",
                        "entry_id": "f4f45f53-7a0f-3541-b3f3-c9c0ecf768b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "adultérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                        "entry_id": "f4f45f53-7a0f-3541-b3f3-c9c0ecf768b9",
                        "glosses": [
                            "Action d’adultérer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f63e6c4d-584e-4b53-b1e0-1e4cceb23474",
                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                "text": "Aujourd’hui, cette frelaterie des produits, cette adultération criminelle a gagné le commerce intérieur et le commerce des choses les plus nécessaires à la vie."
                            },
                            {
                                "example_id": "cee12b7e-67b2-44c1-bcb1-bed59e1bd3b3",
                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                "text": "Le mouillage est une véritable adultération du lait, car non seulement il diminue ses qualités nutritives, mais il introduit directement dans un aliment populaire les germes morbides que peuvent contenir les eaux de toute provenance employées par les falsificateurs."
                            },
                            {
                                "example_id": "81840324-1cca-4495-81bb-7197c033a7db",
                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                "text": "Mandin n’a pas, tort quand il fait remonter ces incorrections, ces fautes, ce travail de destruction de la langue aux Symbolistes. Le fait est qu’ils ont été des artistes en charabia et en adultération."
                            },
                            {
                                "example_id": "1b6fd8b1-580f-4780-8fc2-0e70da55cee8",
                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                "text": "Actuellement, il n’existe aucun moyen absolu de déterminer quantitativement l’adultération."
                            },
                            {
                                "example_id": "e782ce7b-2920-46f6-80bb-f7523bbb24b7",
                                "sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                                "text": "En 1889, Cazeneuve et Hugounenq signalent à leur collègue Barral l’existence d’empoisonnements liés à des adultérations d’anis étoilé par des « badianes toxiques »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e6fcdc2-7968-4e47-88f3-2c324e87ca69",
                        "source_entry_id": "f4f45f53-7a0f-3541-b3f3-c9c0ecf768b9",
                        "source_sense_id": "c9f67d4e-bdf3-398d-aad8-c7a5e9044d4e",
                        "target_lang_word": "Fälschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fälschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das Fälschen, die Imitation eines Produktes unter Vortäuschung von dessen Authentizität"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff60ecb4-b1c9-4cca-a159-cd42ff2dbf88",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "Die Fälschung von Banknoten ist ein Verbrechen."
                                            },
                                            {
                                                "example_id": "cc1b2bd3-8271-4399-8e22-4eb1d3b03f1c",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Es ging mit ihm immer mehr bergab, fünf oder sechs Jahre später beging er Fälschungen, für die er zu den Galeeren verurteilt wurde, wo er vor sechs oder sieben Jahren starb.“"
                                            },
                                            {
                                                "example_id": "7c21da85-b8a7-4513-a789-2a13d7c3eeca",
                                                "sense_id": "39d7083c-6e16-3924-b5f9-afad55599b19",
                                                "text": "„Doch bleibt die Möglichkeit einer Fälschung offen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                        "entry_id": "ed14ff34-7344-37d8-b508-5c3d317cafd4",
                                        "glosses": [
                                            "das gefälschte Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44853d19-b894-4b59-825a-ece998be4095",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "Die goldene Rolex-Uhr für fünfzig Dollar ist mit Sicherheit eine Fälschung, da das Original sehr viel teurer ist."
                                            },
                                            {
                                                "example_id": "aa16209d-21dd-4e6c-bbc7-d4efb49dc696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Sowohl vor als auch nach dieser Zeit wurden etliche Fälschungen produziert, die allesamt eine bessere Qualität als das Original aufweisen.“"
                                            },
                                            {
                                                "example_id": "8e7fc830-3a5e-4cb0-819b-2e9fbcb16696",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Vielmehr hat Masaryk (flankiert von vielen Fachwissenschaftlern) endgültig nachgewiesen, dass die Handschriften eine Fälschung des berühmten Bibliothekars Václav Hanka waren.“"
                                            },
                                            {
                                                "example_id": "ee25d8b8-27fc-490a-a900-2daf7eb4cea9",
                                                "sense_id": "b384db93-d8b3-33b5-8fe1-705c92f33350",
                                                "text": "„Wenn im Weißpigment eines alten Gemäldes Titanweiß nachgewiesen wird, handelt es sich offensichtlich um eine Fälschung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
