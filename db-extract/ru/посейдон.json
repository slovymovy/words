                                    {
                                        "sense_id": "4a405d23-4261-3c3a-bccf-15da60af4018",
                                        "entry_id": "e68a2ced-04f0-3a35-b234-eca4ba54649e",
                                        "glosses": [
                                            "bóg mórz, trzęsień ziemi, żeglarzy, rybaków i koni, utożsamiany z rzymskim Neptunem"
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a497fdb-15fa-422c-a525-5b504c025748",
                                                "sense_id": "4a405d23-4261-3c3a-bccf-15da60af4018",
                                                "text": "Posejdon uchodził za syna Kronosa i Rei oraz męża Amfitryty."
                                            },
                                            {
                                                "example_id": "87553fdf-bba8-4399-ab7d-5fd6219c1398",
                                                "sense_id": "4a405d23-4261-3c3a-bccf-15da60af4018",
                                                "text": "Atrybutem Posejdona był trójząb, którym wzburzał morze i wstrząsał ziemią"
                                            },
                                            {
                                                "example_id": "0e1c4e6e-1aa7-4308-8724-bc56555ab9d4",
                                                "sense_id": "4a405d23-4261-3c3a-bccf-15da60af4018",
                                                "text": "Posejdonowi podlegały razem z morzem wyspy, nadbrzeża, przystanie"
                                            },
                                            {
                                                "example_id": "e1062733-cc87-4917-863e-7ddaa9d4e05f",
                                                "sense_id": "4a405d23-4261-3c3a-bccf-15da60af4018",
                                                "text": "Posejdonowi poświęcona była bajeczna wyspa Atlantyda, którą władali jego potomkowie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
