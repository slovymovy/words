                ],
                "senses": [
                    {
                        "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                        "entry_id": "60156902-c616-3c1b-9f30-a2ccced68eb1",
                        "glosses": [
                            "Bauwerk oder Maschine zum Abkühlen von technischen Flüssigkeiten oder von Wasser, wie in einem Kraftwerk oder einer Industrieanlage zur Kühlung dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897f2781-08af-4995-b0d1-25b81cec736c",
                                "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                                "text": "Ein Heizkraftwerk besitzt einen Kühlturm um das interne Prozesswasser/Kühlwasser durch die Außenluft abzukühlen."
                            },
                            {
                                "example_id": "d5472ec3-c5f1-4caa-b915-e3390df22ac2",
                                "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                                "text": "„Ein Kühlturm ist ein Wärmetauscher, in dem Wasser Wärme durch den Kontakt mit Luft entzogen wird.“"
                            },
                            {
                                "example_id": "0c3441d8-4b16-4eed-b3a0-e42574cf667d",
                                "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                                "text": "„Grundsätzlich funktioniert ein Kühlturm in der Weise, dass das aus dem Verbraucher kommende, warme Wasser über Füllkörper rieselnd mit Luft in Berührung gebracht wird, wodurch es je nach Temperatur und Feuchte der Luft abgekühlt wird.“"
                            },
                            {
                                "example_id": "1dd1faf8-2dde-4dc6-b911-f33570769be6",
                                "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                                "text": "„Das erwärmte Kühlwasser, das vom Kondensator kommt, wird in etwa 12 m Höhe über Verteilerrohre in den Kühlturm geführt und durch ein Plattensystem nach unten gegen den aufsteigenden Luftstrom verrieselt.“"
                            },
                            {
                                "example_id": "ba1802d8-3385-4c13-9285-01a7b26d1f78",
                                "sense_id": "4934b1d1-af2f-3749-b753-59a6ce575890",
                                "text": "„Der Kühlturm ist ein Wärmetauscher, in dem zu kühlendes Wasser und Luft direkt miteinander in Berührung gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
