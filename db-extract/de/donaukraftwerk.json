                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8be4c7e-f99b-4964-82db-75f810856f5d",
                                "sense_id": "27c5d783-8fe6-3cd5-ad87-c0d524513a57",
                                "text": "In Österreich gibt es mehrere Donaukraftwerke."
                            },
                            {
                                "example_id": "8058f332-4c10-42cf-a5c0-ca24badd43e8",
                                "sense_id": "27c5d783-8fe6-3cd5-ad87-c0d524513a57",
                                "text": "„Dazu wird die Traisen auf 9,4 Kilometern Länge nahe dem Donaukraftwerk Altenwörth komplett neu gestaltet.“"
                            },
                            {
                                "example_id": "e7ddb29a-ab1d-41c4-8ada-d595a61b7ae7",
                                "sense_id": "27c5d783-8fe6-3cd5-ad87-c0d524513a57",
                                "text": "„Sie erhält ihren Strom hauptsächlich vom Donaukraftwerk und den Braunkohlekraftwerken bei Deva, daneben betreiben einige Unternehmen kleine Wärmekraftwerke .“"
                            }
                        ],
