                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "55245772-5d82-3e6f-aad9-1bb72e36eec2",
                        "entry_id": "b15640c5-fda8-3e5c-82c0-6986161b0b0d",
                        "glosses": [
                            "Qualifie un animal, ou un élément animal, d’où l’on tire de la pourpre."
                        ],
                        "tags": [
                            "Histoire naturelle"
                        ],
                        "examples": [
                            {
                                "example_id": "1afcef52-626b-45e5-820f-2a16328b729a",
                                "sense_id": "55245772-5d82-3e6f-aad9-1bb72e36eec2",
                                "text": "La matière purpurigène produite par le manteau des murex."
                            },
                            {
                                "example_id": "b32ea332-9bc7-4752-bb0e-c231de84d55b",
                                "sense_id": "55245772-5d82-3e6f-aad9-1bb72e36eec2",
                                "text": "La fabrication de la pourpre demande un travail considérable. Il faut pêcher les coquillages, casser la coquille, laisser macérer quelques temps, puis extraire la petite glande contenant le suc purpurigène."
                            },
                            {
                                "example_id": "a377f393-4973-4737-a8a7-c37bc47f64e0",
                                "sense_id": "55245772-5d82-3e6f-aad9-1bb72e36eec2",
                                "text": "En Amérique Centrale, plus précisément dans le village de Pinotepa de Don Luis, sur la côte Pacifique du Mexique, il existe encore des artisans teignant avec de la pourpre extraite de Purpura patula. … Le liquide purpurigène est contrairement au Murex émis peu après que le mollusque est détaché des rochers sur lesquels il se fixe."
                            }
                        ]
                    }
