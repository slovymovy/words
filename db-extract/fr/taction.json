                        "glosses": [
                            "Action de toucher."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "9a9b5bd5-88a1-457d-aadd-0369c1100852",
                                "sense_id": "1248c5a0-c2b1-3fe8-ad36-d07f30148f1c",
                                "text": "C'est absolument le contraire pour les poissons plus diurnes que nocturnes, qui recherchent leur pâture bien plus des yeux et en nageant entre deux eaux, que par l'odorat, la taction et en rasant le sol."
                            },
                            {
                                "example_id": "00d5f4af-3fab-49e0-a696-4f1a64262db6",
                                "sense_id": "1248c5a0-c2b1-3fe8-ad36-d07f30148f1c",
                                "text": "Si les arcs se raccordent, on a, au point de branchement, un point de raccord, un point d'inflexion et un point de taction ou de contact."
                            }
                        ]
                    }
                ],
