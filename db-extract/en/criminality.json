                "senses": [
                    {
                        "sense_id": "c50e89f9-81b1-32b2-a784-7eab523edf49",
                        "entry_id": "d773a95f-47fb-3b8c-9b33-45d276ba7ac3",
                        "glosses": [
                            "The state of being criminal."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "df268843-9848-3381-bfeb-14c4fdce792f",
                        "entry_id": "d773a95f-47fb-3b8c-9b33-45d276ba7ac3",
                        "glosses": [
                            "Criminal activity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ba63e81-22ee-42e8-aede-10ad5745b621",
                                "sense_id": "df268843-9848-3381-bfeb-14c4fdce792f",
                                "text": "rampant criminality"
                            },
                            {
                                "example_id": "0c02dc6e-dbc6-4674-9f81-690d5cf6060d",
                                "sense_id": "df268843-9848-3381-bfeb-14c4fdce792f",
                                "text": "The memorandum of understanding between the Rail Accident Investigation Branch, the Office of Rail and Road and the police states: \"In the absence of a clear indication that serious criminality has caused the accident, RAIB will normally have precedence in respect of the investigation and will assume lead responsibility for the investigation.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "3a8be501-b343-34a8-9b9c-6952f9de41f9",
                        "entry_id": "d773a95f-47fb-3b8c-9b33-45d276ba7ac3",
                        "glosses": [
                            "A criminal act."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "467a839e-eb19-44b3-a7cd-d76512f00a53",
                                "sense_id": "3a8be501-b343-34a8-9b9c-6952f9de41f9",
                                "text": "The storm-centre of a combined newspaper attack lasting for months, Daylight's character had been torn to shreds. There was no fact in his history that had not been distorted into a criminality or a vice. This public making of him over into an iniquitous monster had pretty well crushed any lingering hope he had of getting acquainted with Dede Mason."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6d7e8c7-daf2-4b12-bbfd-a0af77fcbc5f",
                        "source_entry_id": "d773a95f-47fb-3b8c-9b33-45d276ba7ac3",
                        "source_sense_description": "state of being criminal",
                        "target_lang_word": "criminalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "criminalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf0b17b6-f360-35a0-ad1e-ab47c35ba3ee",
                                        "entry_id": "31c80e24-0767-3b07-8e24-cee4841000e9",
                                        "glosses": [
                                            "Qualité de ce qui est criminel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72bb8ab4-9310-3d25-ae73-e98851b98181",
                                        "entry_id": "31c80e24-0767-3b07-8e24-cee4841000e9",
                                        "glosses": [
                                            "Ensemble des actes criminels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03761b80-f503-49d2-a4cc-fffdb97a248b",
                                                "sense_id": "72bb8ab4-9310-3d25-ae73-e98851b98181",
                                                "text": "Même et surtout si le criminel est un demi-responsable pour des motifs d’ordre pathologique (et cela est presque la règle, car, en somme, la criminalité est le plus souvent presque une maladie dont la délinquance est la forme atténuée), la peine sévère aura sur lui une action plus forte que la demi-peine."
                                            },
                                            {
                                                "example_id": "cac4fa40-8c23-4e9d-8ec9-88b645491a0c",
                                                "sense_id": "72bb8ab4-9310-3d25-ae73-e98851b98181",
                                                "text": "La situation de la criminalité se distingue dans son ampleur et dans sa structure de l’image qu’en donnent les médias."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e3f75a4-dbe5-4b1a-bb74-8a3d94eb26cd",
                        "source_entry_id": "d773a95f-47fb-3b8c-9b33-45d276ba7ac3",
                        "source_sense_description": "state of being criminal",
                        "target_lang_word": "Kriminalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriminalität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                        "entry_id": "9de3d09e-b3eb-37ae-b320-c10dad79ed9e",
                                        "glosses": [
                                            "Gesamtumfang der Straftaten"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b7e54b-93ca-470c-9fb9-5a755078ae4a",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Auch organisatorisch rüsten die Rechtsextremen offenbar auf: Im Bereich der rechtsextrem motivierten Kriminalität sind laut Bundesinnenministerium seit 2001 elf Fälle von kriminellen Vereinigungen und acht Fälle von terroristischen Vereinigungen registriert.“"
                                            },
                                            {
                                                "example_id": "f198137b-389c-46e9-8435-d2d6539768cc",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Die Frage, wie die Kriminalität bei Frauen einzuschätzen sei, war im Dezember 1788 noch lange nicht beantwortet.“"
                                            },
                                            {
                                                "example_id": "c63c3373-6b9b-471c-bb4e-61c93c5dc3d5",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Noch am Bahnhof hatte er mich gefragt, ob es nicht gefährlich sei, nachts durch Berlin spazieren zu gehen, und wie es um die Kriminalität in der deutschen Hauptstadt bestellt sei.“"
                                            },
                                            {
                                                "example_id": "6824b96b-374f-4c5c-a486-517e8a89f6a4",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Die Kindersterblichkeit und die Kriminalität sind niedriger, der Lebensstandard ist höher.“"
                                            },
                                            {
                                                "example_id": "71df5750-faf5-4e7b-b0e6-e59a5cbdce41",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
