        "de-extract.jsonl": [
            {
                "entry_id": "6efbe4ef-9185-3245-9676-fe091218114c",
                "word": "nacheinander",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                        "entry_id": "6efbe4ef-9185-3245-9676-fe091218114c",
                        "glosses": [
                            "nicht gleichzeitig, zeitlich versetzt"
                        ],
                        "tags": [
                            "temporal"
                        ],
                        "examples": [
                            {
                                "example_id": "95940dfa-71ff-488c-a64b-4b30ab11cebb",
                                "sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                                "text": "Das sollten wir nacheinander erledigen."
                            },
                            {
                                "example_id": "128761fa-780f-46d4-9831-af36a0e6b2f7",
                                "sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                                "text": "„Rücksichtslos schickt er seine Sklaven zwei Sommer nacheinander auf Thorsteins Land - obwohl er weiß, dass der Nachbar angekündigt hat, solche Eindringlinge zu erschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1c1f861f-16ac-3416-99a9-42c64d99bd5c",
                        "entry_id": "6efbe4ef-9185-3245-9676-fe091218114c",
                        "glosses": [
                            "hintereinander, einer hinter dem anderen"
                        ],
                        "tags": [
                            "räumlich"
                        ],
                        "examples": [
                            {
                                "example_id": "1721a404-75e3-45bc-a1c2-b803d3cf5af0",
                                "sense_id": "1c1f861f-16ac-3416-99a9-42c64d99bd5c",
                                "text": "Sie liefen nacheinander her."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8e7ac12-290d-46c5-a915-6036fbe51d06",
                        "source_entry_id": "6efbe4ef-9185-3245-9676-fe091218114c",
                        "source_sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                        "source_sense_description": "zeitlich: nicht gleichzeitig, zeitlich versetzt",
                        "target_lang_word": "successivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "successivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                        "entry_id": "1ced2862-b287-36d0-bb58-cbcfbed06dd0",
                                        "glosses": [
                                            "L’un après l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27976698-f311-4297-8c85-0188cc6c2139",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Après une présentation rapide de l’aérogare nᵒ 1 de Roissy-en-France, avec son corps central et ses sept satellites, l’auteur décrit successivement les divers équipements réalisés dans cet ensemble."
                                            },
                                            {
                                                "example_id": "8c088ede-ebda-4589-9c0a-aea1c1868dd0",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Tous ont successivement combattu pour ou contre les Jacobins, selon les temps & les circonstances."
                                            },
                                            {
                                                "example_id": "31e1c9cc-7c07-4677-b6f4-2443e50fb6f7",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Azemmour est une ville très ancienne. D’origine berbère ou carthaginoise, elle passa successivement sous la domination romaine, vandale, byzantine et arabe. En 1518, les Portugais s’en emparèrent, […]."
                                            },
                                            {
                                                "example_id": "d5f34891-b226-428c-9bd2-49f855a32db3",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Bert effleura successivement un bon nombre de métiers : il fut groom dans un magasin de nouveautés et chez un médecin, garçon de pharmacie, apprenti plombier, griffonneur d’adresses, garçon laitier, « golf caddie », et enfin aide-mécanicien chez un loueur et réparateur de bicyclettes."
                                            },
                                            {
                                                "example_id": "e6ec93e0-4345-48d7-b75f-0dd3ee3d184d",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Seront examinés successivement : l’efficacité graminicide, l’efficacité dicotylédonicide et la sélectivité à l’égard du colza de l’association propyzamide + diuron (Kerb ultra)."
                                            },
                                            {
                                                "example_id": "650c64cb-dd21-4c1c-96cb-db32e084a21b",
                                                "sense_id": "198bef3c-af56-3ad0-96c8-536d59c9b1e2",
                                                "text": "Des planètes dont les différentes parties ne jouissent que successivement d’une lumière empruntée,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0eada4c-5e53-430a-949a-382c3d1adaca",
                        "source_entry_id": "6efbe4ef-9185-3245-9676-fe091218114c",
                        "source_sense_id": "dcda567a-c43d-349d-b3bd-0ce0e543fb89",
                        "source_sense_description": "zeitlich: nicht gleichzeitig, zeitlich versetzt",
                        "target_lang_word": "l’un après l’autre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "l’un après l’autre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6292da5-ed0d-37ec-8915-2da3661c6e36",
                                        "entry_id": "478c7088-ff4d-3041-915c-c62e7e6d3e01",
                                        "glosses": [
                                            "Chacun à son tour dans une file, une série, en succédant au précédent; successivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec308025-56ed-4b04-b9c0-ccaccf9fa4bc",
                                                "sense_id": "a6292da5-ed0d-37ec-8915-2da3661c6e36",
                                                "text": "– On dirait qu’une société secrète les subtilise les uns après les autres, – opina Bert."
                                            },
                                            {
                                                "example_id": "d10cf995-f37d-4970-acd2-1446197675fa",
                                                "sense_id": "a6292da5-ed0d-37ec-8915-2da3661c6e36",
                                                "text": "Puis, à partir de mars 1974, appliquant « la tactique du salami » il commença à se débarrasser l’un après l’autre de la plupart de ses ministres parchamis, soit en les réaffectant à des postes de moindre importance, soit en les démettant carrément."
                                            },
                                            {
                                                "example_id": "3f6e6c4e-23b0-4147-b3c9-e6269fd8b3ff",
                                                "sense_id": "a6292da5-ed0d-37ec-8915-2da3661c6e36",
                                                "text": "Ses contestations judiciaires échouent les unes après les autres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
