                "translations": [
                    {
                        "translation_id": "bfb00964-ef09-4f10-ba78-5682a2d754ec",
                        "source_entry_id": "8166369d-6a01-3380-b450-6b995f5034b0",
                        "source_sense_id": "9bee0fe0-a3d1-3069-bb57-eaf9350084b1",
                        "source_sense_description": "een handvuurwapen met een roterende trommel met kogels",
                        "target_lang_word": "Revolver",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Revolver",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                        "entry_id": "325cad38-4d2a-30d8-a028-1067e25fe63c",
                                        "glosses": [
                                            "Handfeuerwaffe mit einem Nachlademechanismus mit zylindrischer Munitionskammer (Trommel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cee370-f78a-49bd-bc34-3cdb2ed7bb78",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "Aus Angst vor Räubern hat er immer einen Revolver unter der Ladentheke."
                                            },
                                            {
                                                "example_id": "b492f5c5-2e6c-452c-bf63-2ab6facf40be",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Der Soldat nahm den Revolver an sich, einige Minuten später wurde das Todesurteil vollstreckt.“"
                                            },
                                            {
                                                "example_id": "a6027a36-3622-429e-a4c3-157d1932c2a3",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Diese Möglichkeit hatte ich nicht berücksichtigt, und ich hielt meine Flucht bereits für gescheitert, denn plötzlich fiel mir der scharf geladene Revolver ein.“"
                                            },
                                            {
                                                "example_id": "d8bcc8b2-64c5-47fb-87ba-bf61cae6206b",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Revolver gingen manchmal von selbst los.“"
                                            },
                                            {
                                                "example_id": "a8449ff2-4c36-4d94-86dd-a63e3d5bf5c4",
                                                "sense_id": "7fc25a97-2787-34a3-a3a1-e4c4e31f7c32",
                                                "text": "„Wir hatten natürlich Revolver und Gewehre und andere Waffen, auch Panzerfäuste und Mörser, Maschinenpistolen und tragbare Maschinengewehre, leichte und schwere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beeb92c3-4f78-41be-8c7f-7dfbe9665680",
