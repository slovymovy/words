                "senses": [
                    {
                        "sense_id": "f09c3c3a-2a08-3d92-8dfc-dd4b2431e1fd",
                        "entry_id": "5dda2fe6-f389-3a4b-b5bc-4466a00bd1de",
                        "glosses": [
                            "Adapter sous forme de CD-ROM."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4c556cb-6ed6-453b-ac08-cfca10d3177d",
                                "sense_id": "f09c3c3a-2a08-3d92-8dfc-dd4b2431e1fd",
                                "text": "Grand amateur de XIII, la célèbre série de Jean Van hamme et William Vance, je propose à François de « CD-Romiser » un livre en préparation sur le héros amnésique (« Le Mystère XIII »), livre qui sera édité bien plus tard."
                            },
                            {
                                "example_id": "7dd18638-e9df-4019-8e08-e3fedb1f8e04",
                                "sense_id": "f09c3c3a-2a08-3d92-8dfc-dd4b2431e1fd",
                                "text": "Thomas d'Aquin CD-ROMisé."
                            }
                        ]
                    },
                    {
                        "sense_id": "79bb0091-7709-3d44-a688-e61900ba1b0d",
                        "entry_id": "5dda2fe6-f389-3a4b-b5bc-4466a00bd1de",
                        "glosses": [
                            "Doter de CD-ROM."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0c1f732-eb44-461d-95f7-ab83239df2ab",
                                "sense_id": "79bb0091-7709-3d44-a688-e61900ba1b0d",
                                "text": "Le narrateur Abel se moque de tout et de tous, des békés, des métropolitains, des universitaires, des stars de la télé, des politiciens du monde entier, des touristes américains, et bien sûr, de l’homo martinicensis, ce nègre du XXe siècle \"vacciné-scolarisé-service militarisé, francophonisé et CD-Romisé\" (Savane 40)."
                            }
                        ]
                    }
