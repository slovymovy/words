                "senses": [
                    {
                        "sense_id": "7e46ffdf-74db-3ae0-a3b0-2faa32c46130",
                        "entry_id": "43123b83-5f5e-38d9-9765-7bdcc46f0159",
                        "glosses": [
                            "The action or process by which something is lifted; elevation"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ad30c82-747a-4b4e-a482-1b12791e1dd8",
                                "sense_id": "7e46ffdf-74db-3ae0-a3b0-2faa32c46130",
                                "text": "For some moments he stood there contemplating the little fellows as they went about their work in their business-like way, taking no notice of his presence other than the liftings of their heads now and then, as if to ascertain if he were still there."
                            }
                        ]
                    },
                    {
                        "sense_id": "814249b5-7dae-3287-8289-70b195e18ef3",
                        "entry_id": "43123b83-5f5e-38d9-9765-7bdcc46f0159",
                        "glosses": [
                            "weightlifting; a form of exercise in which weights are lifted"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "03d64109-1dba-4298-8450-524197e7dc4b",
                                "sense_id": "814249b5-7dae-3287-8289-70b195e18ef3",
                                "text": "2008, Lou Schuler, \"Foreward\", in Nate Green, Built for Show, page xi\nWhen I started lifting in 1970, I was the skinniest thirteen-year-old I knew."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f8de662-52fd-32ff-a420-8cb77afee4a2",
                        "entry_id": "43123b83-5f5e-38d9-9765-7bdcc46f0159",
                        "glosses": [
                            "plastic surgery for tightening facial tissues and improving the facial appearance"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8b7809d6-0723-36d0-8c55-24a1233a26bf",
                        "entry_id": "43123b83-5f5e-38d9-9765-7bdcc46f0159",
                        "glosses": [
                            "Theft."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bd830f4-4940-4b44-a4e3-457e24cabcc2",
                                "sense_id": "8b7809d6-0723-36d0-8c55-24a1233a26bf",
                                "text": "It was then as much the scene of continual spreaths, liftings, reavings, and herriments, as the Border country itself."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d662233-9ba3-3bbe-aac5-806aa5461aed",
                        "entry_id": "43123b83-5f5e-38d9-9765-7bdcc46f0159",
                        "glosses": [
                            "A certain operation on a measure space; see lifting theory."
                        ],
