                "translations": [
                    {
                        "translation_id": "1ced957c-f15e-43de-a37a-a44661a588e0",
                        "source_entry_id": "19c2d885-3de7-3b65-9090-5838cf2e4596",
                        "source_sense_id": "748eb7d1-1711-33fb-94ad-63af898aae30",
                        "source_sense_description": "Kugelschreiber",
                        "target_lang_word": "Kugelschreiber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kugelschreiber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                        "entry_id": "ce65e534-44b8-327e-bc6d-e7ba227b3bed",
                                        "glosses": [
                                            "Stift, dessen Farbe über eine bewegliche Kugel abgegeben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70e8be0-aabe-4fbc-8115-fa4c3bdf64f8",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "In der Schule dürfen wir nicht mit Kugelschreibern schreiben."
                                            },
                                            {
                                                "example_id": "1e9b18fa-e620-4532-bc49-d7ce3ff158ca",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Hast du mal ´nen Kugelschreiber?"
                                            },
                                            {
                                                "example_id": "51e5ffdc-2730-4309-ae97-449d3ac08954",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Leih mir bitte mal eben deinen Kugelschreiber."
                                            },
                                            {
                                                "example_id": "395b7de0-bdf7-409a-8594-c0e10226a45a",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "Mit dem Kugelschreiber kann man auf das Blatt darunter durchdrücken."
                                            },
                                            {
                                                "example_id": "e10d2540-3489-4ddc-a28a-127e5b17a79e",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Der Kugelschreiber flog nun förmlich über die Seiten, und Perlmann schaffte es kaum, die Gedanken, die sich jagten, auf dem Papier festzuhalten.“"
                                            },
                                            {
                                                "example_id": "98d3e696-54c6-4603-8ba1-a44b04726b19",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Auch Kugelschreiber lagen herum, neben dem Block, auf dem jemand sie ausprobiert hatte.“"
                                            },
                                            {
                                                "example_id": "41bb94df-d77d-48b3-a0e6-ec35b5aeaf00",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Er schnappt sich Papier und Kugelschreiber.“"
                                            },
                                            {
                                                "example_id": "9bf84d9e-34c2-4fb4-b840-7b5ef7916484",
                                                "sense_id": "02f98e25-bfb1-3ed2-8057-03e09e242a18",
                                                "text": "„Er legte die Aktentasche auf den Tisch im Flur, zog einen Notizblock und einen Kugelschreiber hervor und trat in die Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
