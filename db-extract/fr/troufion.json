                        "examples": [
                            {
                                "example_id": "64aa3ce1-9bf3-47ec-b0d9-2058d81b0f17",
                                "sense_id": "76bbce91-1816-3a6c-b4cb-962af76219d9",
                                "text": "Deux heures du matin, se disait-il, moins dix degrés, un brouillard à couper au couteau, un quartier sans intérêt, un mot de passe débile, quelques sous-officiers et sentinelles sans la moindre motivation et cinq cents troufions qui roupillent en attendant le jus tiède du matin [...]"
                            }
