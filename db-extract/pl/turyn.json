                                "example_id": "a60eb789-f179-4e73-9ecb-c6d29c7b7cfc",
                                "sense_id": "183dd335-f88b-32cc-9d81-8e36c128d9a9",
                                "text": "Nazwa miasta Turyn pochodzi od celtyckiego słowa „tau” oznaczającego góry."
                            },
                            {
                                "example_id": "0e9caa98-bea3-4a53-9070-c6b0acaa48dc",
                                "sense_id": "183dd335-f88b-32cc-9d81-8e36c128d9a9",
                                "text": "Jan Bosko zmarł w 1888 w Turynie."
                            },
                            {
                                "example_id": "745ba330-bf84-4d63-bc10-a523f33bd4b0",
                                "sense_id": "183dd335-f88b-32cc-9d81-8e36c128d9a9",
                                "text": "Warszawa jest jednym z miast partnerskich Turynu."
                            }
