                "senses": [
                    {
                        "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                        "entry_id": "a9e061f8-5ee1-3abc-a1de-2656fc6b10ad",
                        "glosses": [
                            "aanwijzend (ver af) in+dat, in+die:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d960453b-93cd-43f3-a6a3-daaddfaea0b7",
                                "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                                "text": "Het zat daarin verstopt."
                            },
                            {
                                "example_id": "8933a498-5a70-43a0-937c-8d3497fceacb",
                                "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                                "text": "Daar zat het in verstopt."
                            },
                            {
                                "example_id": "6cdd9424-9297-404c-ba3d-a66059b3822b",
                                "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                                "text": "Daarin werd beweging van belang geacht voor een gezond leven maar dienden excessen voorkomen te worden."
                            },
                            {
                                "example_id": "5fa9de37-2b91-4700-9362-d6fc3988f300",
                                "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                                "text": "Daarin ligt de nadruk op het behoud van de correcte lichamelijke balans."
                            },
                            {
                                "example_id": "60d02554-3630-4582-a843-c6fd23c63032",
                                "sense_id": "34e0c433-9810-3859-a790-ec924580fcef",
                                "text": "Geen drama, dus. Geen huilende moeder die zich vastklampt aan de kist met daarin de dode lichamen van haar kinderen."
                            }
                        ]
                    }
                ],
