{
    "word_family": [
        "dismemberment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0685e5a6-2221-3ec9-9797-0aef7fbc722d",
                    "sense_definition": "To cut or divide something into smaller pieces, often used figuratively for organizations or territories.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board of directors decided to <w>dismember</w> the company and sell off its individual departments.",
                            "target_lang_translations": {
                                "ru": "Совет директоров решил <w>расчленить</w> компанию и распродать её отдельные подразделения."
                            }
                        },
                        {
                            "text": "The civil war threatened to <w>dismember</w> the nation into several smaller independent states.",
                            "target_lang_translations": {
                                "ru": "Гражданская война грозила <w>раздробить</w> страну на несколько небольших независимых государств."
                            }
                        }
                    ],
                    "synonyms": [
                        "partition",
                        "dissect",
                        "fragment"
                    ],
                    "antonyms": [
                        "unify",
                        "assemble"
                    ],
                    "common_phrases": [
                        "dismember the company",
                        "dismember the nation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо на части, часто используется в переносном смысле в отношении организаций или территорий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчленять",
                                "target_lang_sense_clarification": "делить на части (страну, организацию)"
                            },
                            {
                                "target_lang_word": "раздробить",
                                "target_lang_sense_clarification": "разделить на мелкие фрагменты"
                            },
                            {
                                "target_lang_word": "разделить",
                                "target_lang_sense_clarification": "общий термин для разделения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57563f05-6f6b-3c75-9799-97d7ae39f01a",
                    "sense_definition": "To remove the limbs of a person or animal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forensic report detailed how the predator would <w>dismember</w> its prey before consuming it.",
                            "target_lang_translations": {
                                "ru": "В судебно-медицинском отчёте подробно описывалось, как хищник <w>расчленял</w> свою добычу перед тем, как съесть её."
                            }
                        },
                        {
                            "text": "Historical records describe brutal execution methods designed to <w>dismember</w> the body of the condemned.",
                            "target_lang_translations": {
                                "ru": "Исторические хроники описывают жестокие методы казни, предназначенные для того, чтобы <w>расчленить</w> тело осуждённого."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutilate"
                    ],
                    "common_phrases": [
                        "dismember the body"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсекать конечности у человека или животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расчленять",
                                "target_lang_sense_clarification": "отсекать конечности"
                            },
                            {
                                "target_lang_word": "четвертовать",
                                "target_lang_sense_clarification": "казнить через отсечение конечностей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}