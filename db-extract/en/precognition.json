                    {
                        "sense_id": "dc3e6314-0217-3be7-a1dc-902f1dad5e64",
                        "entry_id": "70190931-a70b-3637-8023-55fe0cb82bfc",
                        "glosses": [
                            "Knowledge of the future; understanding of something in advance, especially as a form of supernatural or extrasensory perception."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ee64181d-2235-3b70-ac59-4a10462b51ae",
                        "entry_id": "70190931-a70b-3637-8023-55fe0cb82bfc",
                        "glosses": [
                            "The practice of taking a factual statement from a witness before a trial."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad516ccf-f12a-48b9-9568-a8d14262448e",
                                "sense_id": "ee64181d-2235-3b70-ac59-4a10462b51ae",
                                "text": "‘But it seems there are some strong presumptuous proofs against you, and I came to warn you this day that a precognition is in progress, and that unless you are perfectly convinced, not only of your innocence, but of your ability to prove it, it will be the safest course for you to abscond, and let the trial go on without you.’"
                            }
                        ]
                    }
                ],
