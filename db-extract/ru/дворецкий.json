                            {
                                "example_id": "03db3af2-b9f0-498b-9b30-bc37e65cc143",
                                "sense_id": "55a04cfe-34b6-3274-8925-bee936933d9d",
                                "text": "Прия́телей на́ших встре́тили в пере́дней два ро́слых лаке́я в ливре́е; оди́н из них то́тчас побежа́л за дворе́цким.",
                                "translation": "Our friends were met in the hall by two tall footmen in livery; one of them ran at once to fetch the butler.",
                                "english": "Our friends were met in the hall by two tall footmen in livery; one of them ran at once to fetch the butler."
                            }
                        ]
                    }
