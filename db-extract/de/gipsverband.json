                                "example_id": "eceda304-192f-408b-abf5-a39cb4bf8f35",
                                "sense_id": "0b581b9c-7af3-336c-af11-f37570434dea",
                                "text": "„Als Itzig Finkelstein die volle Bedeutung des im Radio Gehörten kapierte oder begriff, sprang er, trotz Gipsverband, mit einem Freudensatz aus dem Bett.“"
                            }
