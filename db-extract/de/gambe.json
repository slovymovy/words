                "senses": [
                    {
                        "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                        "entry_id": "774d3e6e-25b8-3cdd-b059-d03c116d3afd",
                        "glosses": [
                            "historisches Streichinstrument des 16. bis 18. Jahrhunderts, dessen Charakteristikum das Halten des Instruments zwischen den Beinen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73a82033-3770-407d-943d-da3c01ddf5a9",
                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                "text": "„Als um 1500 die Familien der Violinen und Gamben ausentwickelt waren, war die Trennung in zwei grundlegend verschiedene Klanggruppen vollzogen.“"
                            },
                            {
                                "example_id": "5fe30407-4039-49dd-a93c-3be6014ed11c",
                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                "text": "„Daß der Fürst in Christian Ferdinand Abel einen bedeutenden Virtuosen auf dem Violoncello und der Gambe engagiert hat, würde sich fast von selbst verstehen, wenn er, wie gelegentlich vermutet, selbst Gambe gespielt haben sollte.“"
                            },
                            {
                                "example_id": "3a72d85a-d252-4cb7-8afd-171d717a6f92",
                                "sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                                "text": "„Der war ein umjubelter Meister auf der Gambe und ein Freund Bachs seit Kindertagen, […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1762fbd1-181f-4018-b2e6-5213d8ab296e",
                        "source_entry_id": "774d3e6e-25b8-3cdd-b059-d03c116d3afd",
                        "source_sense_id": "86c6d794-ad14-37da-b446-952d1d62d8e6",
                        "target_lang_word": "viol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "viol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5d2845-c9ba-3d26-aa39-9ef5abfe689f",
                                        "entry_id": "00a64630-7f27-30d2-b0ec-068409028ce2",
                                        "glosses": [
                                            "A stringed instrument related to the violin family, but held in the lap between the legs like a cello, usually with C-holes, a flat back, a fretted neck and six strings, played with an underhanded bow hold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37464444-7671-4b78-9c78-2494dedcc3e0",
                                                "sense_id": "2c5d2845-c9ba-3d26-aa39-9ef5abfe689f",
                                                "text": "He sayd that yᵉ ground opened, and he was brought into strange places underground, where they used musicall Instruments, violls, and Lutes, such (he sayd) as Mr. Thomas did play on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cac3bbc-d8e7-37dc-8ba6-336953e3d191",
                                        "entry_id": "00a64630-7f27-30d2-b0ec-068409028ce2",
                                        "glosses": [
                                            "A large rope used to manipulate the anchor"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "viol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a28d849-bf2c-3408-b545-95eba09fb467",
                                        "entry_id": "fae7a5a6-1e91-30d4-84d2-08e00421df63",
                                        "glosses": [
                                            "To play the viol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50a3e03-1905-4c06-aad9-12a50308c384",
                                                "sense_id": "3a28d849-bf2c-3408-b545-95eba09fb467",
                                                "text": "“Keep your gold for those who lack it, mistress,” said Henry, “and do not offer to honest hands the money that is won by violing, and tabouring, and toetripping, and perhaps worse pastimes."
                                            },
                                            {
                                                "example_id": "1f8f2b32-505e-424a-8db9-c8892d752141",
                                                "sense_id": "3a28d849-bf2c-3408-b545-95eba09fb467",
                                                "text": "Through snowy woods and shady / We went to play a tune / To the lonely manor-lady / By the light of the Christmas moon. / We violed till, upward glancing / To where a mirror leaned, / It showed her airily dancing […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
