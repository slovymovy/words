                "senses": [
                    {
                        "sense_id": "a74bdef8-841f-381a-be69-c574869e16f6",
                        "entry_id": "55942abe-d08b-3e89-9709-4c6c05a1d476",
                        "glosses": [
                            "Vorgang des Befreiens der Rinder von den Larven der Dasselfliege"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "4a4e3413-aeb2-4c1a-be17-7f11aed2caf4",
                                "sense_id": "a74bdef8-841f-381a-be69-c574869e16f6",
                                "text": "„Die Zahl der Betriebe, die jetzt, nachdem Erfahrungen vorliegen, die Abdasslung durch die amtlicherseits eingesetzten Abdasseler verweigern, ist außerordentlich niedrig.“"
                            },
                            {
                                "example_id": "5a7c1fe9-fc4c-4bac-97fa-7cdd847e028c",
                                "sense_id": "a74bdef8-841f-381a-be69-c574869e16f6",
                                "text": "„Waren Ihrer Meinung nach die bisherigen Medikamente zur Abdasslung ausreichend und konnten sie diese Schäden verhindern?“"
                            },
                            {
                                "example_id": "7b3c60e4-4bc3-475f-af5b-ff1d4e675b1c",
                                "sense_id": "a74bdef8-841f-381a-be69-c574869e16f6",
                                "text": "„Die Abdasslung hat unter Verwendung der beiden erprobten Verfahren (Einzelbehandlung durch mechanische Methode oder Ganzbehandlung durch genormte Waschmittel) zu erfolgen. Die Abdasslung muß bis spätestens 31.5. beendet sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
