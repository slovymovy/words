                                                "sense_id": "9fc8263c-28bd-3232-88d5-c1f71755e4ce",
                                                "text": "The facial constitutionality of the law is in question."
                                            },
                                            {
                                                "example_id": "2cfa989c-63c9-452e-894a-6e2a5430d396",
                                                "sense_id": "9fc8263c-28bd-3232-88d5-c1f71755e4ce",
                                                "text": "Discipline is a form of counter-law, of dissymmetry and inequality, that operates under the discourse of juridical power to make possible the stated or facial claims of equality and rights characteristic of the French Revolution."
                                            }
                                        ]
                                    }
                                ]
