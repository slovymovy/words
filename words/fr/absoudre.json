{
    "word_family": [
        "absolution",
        "absolutoire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "458d8209-10cc-34e1-af02-fd497814cc39",
                    "sense_definition": "Pardonner une faute ou un tort, excuser le comportement ou la maladresse de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses intentions bienveillantes ne suffisent pas à l'<w>absoudre</w> de cette grave erreur commise."
                        },
                        {
                            "text": "Le public a fini par <w>absoudre</w> l'artiste après ses excuses publiques sincères."
                        }
                    ],
                    "synonyms": [
                        "excuser",
                        "gracier",
                        "pardonner"
                    ],
                    "antonyms": [
                        "blâmer",
                        "condamner"
                    ],
                    "common_phrases": [
                        "absoudre une faute"
                    ]
                },
                {
                    "sense_id": "0b9ca6cb-8a3d-3fd3-963f-8c43f53745c7",
                    "sense_definition": "Donner l'absolution à un pénitent en lui remettant ses péchés au nom de Dieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a accepté d'<w>absoudre</w> le fidèle après avoir écouté sa sincère confession."
                        },
                        {
                            "text": "Dans ce sacrement, l'Église affirme le pouvoir d'<w>absoudre</w> les pécheurs repentants."
                        }
                    ],
                    "common_phrases": [
                        "absoudre les péchés"
                    ]
                },
                {
                    "sense_id": "8d57f781-bc7c-3d17-b8c5-6d61e57b77ba",
                    "sense_definition": "Déclarer juridiquement un accusé innocent du délit ou du crime reproché ; acquitter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a décidé d'<w>absoudre</w> le suspect faute de preuves tangibles contre lui."
                        },
                        {
                            "text": "Les jurés ont longuement délibéré avant d'<w>absoudre</w> l'homme de toutes les charges."
                        }
                    ],
                    "synonyms": [
                        "acquitter",
                        "blanchir",
                        "disculper",
                        "innocenter"
                    ],
                    "antonyms": [
                        "condamner"
                    ],
                    "common_phrases": [
                        "absoudre un accusé"
                    ]
                },
                {
                    "sense_id": "4ae2076b-7107-3459-8b64-099ddd4d194f",
                    "sense_definition": "Se pardonner à soi-même une faute ou chercher à se disculper moralement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pardon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il tente vainement de s'<w>absoudre</w> de sa lâcheté en inventant de fausses excuses."
                        },
                        {
                            "text": "Elle ne parvenait pas à s'<w>absoudre</w> d'avoir abandonné ses proches au mauvais moment."
                        }
                    ],
                    "synonyms": [
                        "se disculper",
                        "se justifier"
                    ],
                    "antonyms": [
                        "s'accuser"
                    ],
                    "common_phrases": [
                        "s'absoudre d'une faute"
                    ]
                }
            ]
        }
    ]
}