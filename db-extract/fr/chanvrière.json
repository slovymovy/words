                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bff802c4-a786-443e-88e5-770a1dee85ed",
                                "sense_id": "99967fcc-835f-385f-85f6-4187ea80ae1f",
                                "text": "Des brouillards fiévreux enveloppaient de petites métairies qu’on voyait de loin, perdues dans des chanvrières, sur le bord des canaux, et une humidité qui n’était plus celle de la mer me donnait le frisson, comme s’il eût fait très-froid."
                            }
                        ]
