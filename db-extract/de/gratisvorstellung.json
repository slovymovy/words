                                "example_id": "53bd2afa-be99-46b7-9664-4bada6a2ef70",
                                "sense_id": "d86ec9b3-88e6-37e0-8d73-df473f4a2bcd",
                                "text": "„Der Zirkus Knie gab eine Gratisvorstellung für die Tibeter Pflegekinder und deren Eltern, und die Zeitschrift «Nebelspalter» berichtete darüber.“"
                            },
                            {
                                "example_id": "31887c45-36c9-4db4-8a91-701ef16b030e",
                                "sense_id": "d86ec9b3-88e6-37e0-8d73-df473f4a2bcd",
                                "text": "„Später steht King auf, sie streift ihr Kleid über den Kopf und gibt noch eine zweiminütige Gratisvorstellung.“"
                            }
                        ],
