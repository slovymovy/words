                                        "entry_id": "8555e399-3bc3-30ba-be6d-9ab509523a2a",
                                        "glosses": [
                                            "opzettelijk in het nauw brengen door persoonlijke gegevens te publiceren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ddd0a0-413a-42f1-88a1-4e944caf26c8",
                                                "sense_id": "ac5535e1-6b11-3840-ae1c-f8a0798c0922",
                                                "text": "Het via sociale media oproepen tot het achterhalen en publiceren (doxen) van privégegevens van politiemensen moet ook in Nederland strafbaar gesteld worden."
                                            },
                                            {
                                                "example_id": "72105176-fade-4f2f-b9ca-ee39285d0ff1",
                                                "sense_id": "ac5535e1-6b11-3840-ae1c-f8a0798c0922",
                                                "text": "\"Die jonge hackertjes van Anonymous doen het veel\", legt ethische hacker Rickey Gevers uit. \"Zij maken er een sport van om elkaar te doxen.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a045a5a2-450f-415d-b964-928c3d3d20e6",
                        "source_entry_id": "117b4e8d-8884-39ee-b7e5-0e1edcfd39f7",
