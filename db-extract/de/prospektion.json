                "senses": [
                    {
                        "sense_id": "5a85ec1e-c53d-36f2-940c-16be2982e72e",
                        "entry_id": "c375001e-8f42-3133-82a3-09235f5b6371",
                        "glosses": [
                            "Erkundung mittels geologischer, geochemischer, geophysikalischer und ähnlicher Methoden"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c961fd12-07b2-31f2-8ffe-6870c0186190",
                        "entry_id": "c375001e-8f42-3133-82a3-09235f5b6371",
                        "glosses": [
                            "Erkundung mittels geologischer, geochemischer, geophysikalischer und ähnlicher Methoden",
                            "nutzbarer Bodenschätze"
                        ],
                        "tags": [
                            "im Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "f7383012-0293-4e26-8e7b-3a4259bec7cf",
                                "sense_id": "c961fd12-07b2-31f2-8ffe-6870c0186190",
                                "text": "Huenges: Es gibt geophysikalische Prospektionen und Nachbarbohrungen, um ein Zielgebiet zu erkunden."
                            },
                            {
                                "example_id": "f1a4d6e2-0707-47dd-9ce8-8feea55acdc9",
                                "sense_id": "c961fd12-07b2-31f2-8ffe-6870c0186190",
                                "text": "Wenn sie an einen nie versiegenden Ölquell in Nahost geglaubt hätten, hätten sie weder Kohlegesellschaften in den USA gekauft noch Prospektion im Norden des amerikanischen Kontinents betrieben, wo jede Bohrung ein Vielfaches dessen kostet, was dafür am Persischen Golf aufzuwenden ist."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "0794fcea-8bed-3601-960c-e3794da09411",
                        "entry_id": "c375001e-8f42-3133-82a3-09235f5b6371",
                        "glosses": [
                            "Erkundung mittels geologischer, geochemischer, geophysikalischer und ähnlicher Methoden",
                            "archäologischer Stätten"
                        ],
                        "tags": [
                            "in der Archäologie"
                        ],
                        "examples": [
                            {
                                "example_id": "823c68d5-5eaf-444a-b15a-2ce79ff631a0",
                                "sense_id": "0794fcea-8bed-3601-960c-e3794da09411",
                                "text": "Und plötzlich gibt es auch ein Dokument, das Chauvet just für die Zeit vom 14. Dezember 1994 bis zum 31. Januar 1995 einen Auftrag zur Prospektion neuer Höhlen erteilt."
                            },
                            {
                                "example_id": "6bd96a0b-ea0c-464a-85d8-050aa1c734ef",
                                "sense_id": "0794fcea-8bed-3601-960c-e3794da09411",
                                "text": "Für deren Erkundung werden in der archäologischen Prospektion vier Methoden angewandt: 1. Flugprospektion, 2. Airborne Laser Scanning, 3. Geländeprospektion und 4. Geophysikalische Prospektion."
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "4a767dfc-395e-31ee-ba7f-387a2dd5d46a",
                        "entry_id": "c375001e-8f42-3133-82a3-09235f5b6371",
                        "glosses": [
                            "Werbung mit Drucksachen oder Prospekten"
                        ],
                        "tags": [
                            "Werbewirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "7371bd3b-24cd-4e63-8768-c2c4c3cbdc48",
                                "sense_id": "4a767dfc-395e-31ee-ba7f-387a2dd5d46a",
                                "text": "Die Prospektion hat trotz der elektronischen Medien noch immer einen großen Marktanteil in der Werbebranche."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
