                "senses": [
                    {
                        "sense_id": "497b3b25-57a0-36be-a0ad-fff997a5b45a",
                        "entry_id": "e3b130ca-ae9f-3301-8f11-15cc358b815d",
                        "glosses": [
                            "Appliquer une force motrice à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca53229c-8d39-486a-b26c-08a936afdbc5",
                                "sense_id": "497b3b25-57a0-36be-a0ad-fff997a5b45a",
                                "text": "Contrairement à tout ce qu'on entend dans le microcosme du modélisme, les différentiels servent à différentialiser et non pas à motricer."
                            },
                            {
                                "example_id": "bc540a76-ab8e-40ec-beed-c095edcf1673",
                                "sense_id": "497b3b25-57a0-36be-a0ad-fff997a5b45a",
                                "text": "Franchement tu peut retourner la chose dans tous les sens, une traction par nature va toujours motricer moins qu'une propulsion."
                            },
                            {
                                "example_id": "6cc7885f-9de2-46b1-9a02-a5e12ed3da4e",
                                "sense_id": "497b3b25-57a0-36be-a0ad-fff997a5b45a",
                                "text": "Moralité dans certains cas il vaudrait mieux avoir moins de watts et pas de pont-court pour mieux motricer."
                            }
                        ]
                    }
