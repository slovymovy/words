                ],
                "senses": [
                    {
                        "sense_id": "8f3f10c1-97fc-3eae-a9df-a065c419d60b",
                        "entry_id": "29743fa9-c567-3e90-87af-a83a7485e923",
                        "glosses": [
                            "Stand einer Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00db2bd1-db52-4b11-8871-de0b53ed1410",
                                "sense_id": "8f3f10c1-97fc-3eae-a9df-a065c419d60b",
                                "text": "„Als Hochkulturen werden historische Gesellschaften verschiedener historischer Epochen bezeichnet, die eine komplexe, hierarchische Sozialstruktur und einen hohen allgemeinen Entwicklungsstand aufwiesen.“"
                            },
                            {
                                "example_id": "82f27e36-f55d-4a22-a414-5ca099150d01",
                                "sense_id": "8f3f10c1-97fc-3eae-a9df-a065c419d60b",
                                "text": "„Die ägyptische Heilkunde macht von zahlreichen pflanzlichen und tierischen Heilmitteln Gebrauch und ist im Altertum wegen ihres Entwicklungsstandes weithin berühmt.“"
                            },
                            {
                                "example_id": "3b36f615-542e-40fd-b11a-a144d4efa32a",
                                "sense_id": "8f3f10c1-97fc-3eae-a9df-a065c419d60b",
                                "text": "„Verständlich wird dies jedoch, wenn man sich vor Augen führt, dass nicht nur der zivilisatorische Entwicklungsstand, sondern auch die Bevölkerungsdichte der Indigenen weit unterschätzt worden ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
