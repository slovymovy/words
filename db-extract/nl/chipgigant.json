                            {
                                "example_id": "bfbb9d71-10d3-4fb0-b69b-a70560dfbb63",
                                "sense_id": "72e1fa57-ed5b-3451-bb07-4562d8b1597c",
                                "text": "De twee wereldleiders hebben de stukgelopen miljardendeal besproken op de G20-top in Buenos Aires. Het Witte Huis zegt dat China - dat de overname door het Amerikaanse Qualcomm in juli afkeurde - bereid is opnieuw te kijken naar een eventuele overname. De Amerikaanse chipgigant wilde NXP overnemen voor 44 miljard dollar."
                            },
                            {
                                "example_id": "54750bbf-1a0f-4299-898d-209da9d70d6e",
                                "sense_id": "72e1fa57-ed5b-3451-bb07-4562d8b1597c",
                                "text": "De topman van de Amerikaanse chipgigant Intel stapt op omdat hij in het verleden een relatie met een medewerker had. Volgens Intel is dat in strijd met de interne richtlijnen, ook al was de relatie met wederzijdse instemming. Wie de partner van de topman was, is onbekend."
                            }
                        ]
