                            {
                                "target_lang_word": "конечно",
                                "target_lang_sense_clarification": "используется в дружеских утверждениях (напр., 'ja hoor')"
                            },
                            {
                                "target_lang_word": "же",
                                "target_lang_sense_clarification": "смягчающая или усилительная частица"
                            }
