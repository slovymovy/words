                "senses": [
                    {
                        "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                        "entry_id": "4164b4bf-836e-333d-8159-f4d95e56ab7a",
                        "glosses": [
                            "Person, die die Runenschrift beherrschte und in der Lage war, entsprechende Texte zu gestalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d13e4051-f18c-4bfb-a38d-9e9ced922c77",
                                "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                                "text": "„Hinzu kommt, dass die Runenmeister mit ihrer Kunst sehr frei umgehen: Oft wechseln sie die Schreibrichtung, selten trennen sie die einzelnen Wörter sichtbar voneinander ab.“"
                            },
                            {
                                "example_id": "cde25a13-422b-41d3-ba7d-14d5bf7ac8d7",
                                "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                                "text": "„Zwischen Runenmeister und Runenschreiber oder Runenritzer kann, wenn es sich nicht um dieselbe Person handelt, in folgender Weise unterschieden werden: Runenmeister bezeichnet eine Person, die Kenntnis der Runen besitzt und eine Inschrift zu konzipieren vermag. Der Runenschreiber ist hingegen derjenige, der die Ausführung einer Inschrift auf einem bestimmten Gegenstand vornimmt.“"
                            },
                            {
                                "example_id": "beb75150-c1e5-4ea3-a817-4ec2e3cb9c10",
                                "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                                "text": "„Das Schreiben und Lesen von Runen war lange Zeit hindurch das Privileg von Eingeweihten, von kundigen »Runenmeistern«, die aus den Orakelrunen »die Bestimmung der Götter errieten«.“"
                            },
                            {
                                "example_id": "9e9f8bbe-3fc3-4441-8a05-4be48fb7c1b0",
                                "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                                "text": "„Daran, daß vor allem die Zahlenmagie unter den Runenmeistern im Norden geblüht hat, kann sicher kein Zweifel bestehen.“"
                            },
                            {
                                "example_id": "797efe8a-ea0f-411a-ad83-36de10d6bfd3",
                                "sense_id": "feebde3d-6963-3bf9-b306-1a8e6a0d4182",
                                "text": "„Der Stand des Runenmeisters wurde mit dem Worte erilaR (bzw. irilaR) bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
