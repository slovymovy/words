{
    "word_family": [
        "herroepen",
        "herroepelijk",
        "herroeping"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24e9aa26-7b60-3972-bdc8-f965ce3bce34",
                    "sense_definition": "zonder de mogelijkheid om ongedaan gemaakt of gewijzigd te worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "definitief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechter deed een <w>onherroepelijke</w> uitspraak waar geen beroep meer tegen mogelijk was.",
                            "target_lang_translations": {
                                "en": "The judge made an <w>irrevocable</w> ruling against which no further appeal was possible."
                            }
                        },
                        {
                            "text": "Zodra je het contract tekent, is de beslissing <w>onherroepelijk</w>.",
                            "target_lang_translations": {
                                "en": "As soon as you sign the contract, the decision is <w>final</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "definitief",
                        "onveranderlijk",
                        "finaal"
                    ],
                    "antonyms": [
                        "herroepelijk",
                        "voorlopig"
                    ],
                    "common_phrases": [
                        "onherroepelijke-beslissing",
                        "onherroepelijke-uitspraak",
                        "onherroepelijke-vonnis"
                    ],
                    "target_lang_definitions": {
                        "en": "without the possibility of being undone or changed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irrevocable",
                                "target_lang_sense_clarification": "unable to be retracted or reversed"
                            },
                            {
                                "target_lang_word": "definitive",
                                "target_lang_sense_clarification": "determining finally or conclusive"
                            },
                            {
                                "target_lang_word": "final",
                                "target_lang_sense_clarification": "not allowing for further changes or appeals"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "541679ec-cfb2-32da-af30-a9659fb90867",
                    "sense_definition": "op een manier die niet meer te stoppen of te veranderen is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "definitief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als we nu niet ingrijpen, gaat het <w>onherroepelijk</w> mis met het project.",
                            "target_lang_translations": {
                                "en": "If we don't intervene now, the project will <w>inevitably</w> go wrong."
                            }
                        },
                        {
                            "text": "De zon gaat <w>onherroepelijk</w> onder aan het einde van de dag.",
                            "target_lang_translations": {
                                "en": "The sun <w>irrevocably</w> sets at the end of the day."
                            }
                        }
                    ],
                    "synonyms": [
                        "onvermijdelijk",
                        "vaststaand"
                    ],
                    "common_phrases": [
                        "onherroepelijk-mis-gaan",
                        "onherroepelijk-verloren"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that can no longer be stopped or changed"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inevitably",
                                "target_lang_sense_clarification": "unavoidably or certain to happen"
                            },
                            {
                                "target_lang_word": "irrevocably",
                                "target_lang_sense_clarification": "in a way that cannot be undone"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}