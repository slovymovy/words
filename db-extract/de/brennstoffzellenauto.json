                "senses": [
                    {
                        "sense_id": "894d193a-d226-3fe6-88b3-4055343dfc67",
                        "entry_id": "f235bca4-2653-3f66-8883-8062b7814da6",
                        "glosses": [
                            "Elektroauto, bei dem die für den Antrieb benötigte elektrische Energie von einer Brennstoffzelle erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad3aa68-c2a9-46f0-b251-ec6ef73a3c4b",
                                "sense_id": "894d193a-d226-3fe6-88b3-4055343dfc67",
                                "text": "„Und weil die Montage eines zusätzlichen Steckers und ein paar weiterer Bauteile aus dem Regal jetzt den großen Aufwand nicht mehr bedeutet hat, machte Mercedes-Benz sein Brennstoffzellenauto gleich zum Plug-in-Hybrid, dessen Akku man an der Steckdose laden kann.“"
                            },
                            {
                                "example_id": "1cdf6b1c-0874-44f1-ac5f-43a2db3f2f75",
                                "sense_id": "894d193a-d226-3fe6-88b3-4055343dfc67",
                                "text": "„Yoshikazu Tanaka, Chefingenieur des Toyota Mirai, glaubt an die ganz grosse Zukunft des Brennstoffzellenautos.“"
                            },
                            {
                                "example_id": "3f6274c0-2098-44ec-a01a-d9b8bfe90a29",
                                "sense_id": "894d193a-d226-3fe6-88b3-4055343dfc67",
                                "text": "„Toyota und Hyundai liefern deshalb vorerst keine Brennstoffzellenautos mehr aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
