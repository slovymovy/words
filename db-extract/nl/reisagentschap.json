                                                "sense_id": "9cdb003c-3a68-33a6-b023-3950146f5f38",
                                                "text": "„Das Reisebüro gehörte einem älteren Mann und die junge Frau war seine Tochter.“"
                                            },
                                            {
                                                "example_id": "da9e6b12-63b2-4279-ab0b-26910cd1d325",
                                                "sense_id": "9cdb003c-3a68-33a6-b023-3950146f5f38",
                                                "text": "Wir lassen uns den Sommerurlaub von einem Reisebüro vermitteln."
                                            },
                                            {
                                                "example_id": "affa3281-eeaa-49da-a940-663badf3c4e0",
                                                "sense_id": "9cdb003c-3a68-33a6-b023-3950146f5f38",
                                                "text": "„Er zeigt ihr die Druckschrift des Reisebüros auf Hochglanzpapier mit einem pompösen Autobus auf der Titelseite.“"
                                            },
                                            {
                                                "example_id": "942acd6c-448f-4e18-9903-bbc666c1c014",
                                                "sense_id": "9cdb003c-3a68-33a6-b023-3950146f5f38",
                                                "text": "„In einem iranischen Reisebüro hatte ich einmal ein Poster hängen sehen, lange vor dem Erdbeben.“"
                                            },
                                            {
                                                "example_id": "60087a39-e924-4e02-9219-2fe9dd4d5dc6",
                                                "sense_id": "9cdb003c-3a68-33a6-b023-3950146f5f38",
                                                "text": "„Wie ich der Tagespresse entnehme, lädt ein westdeutsches Reisebüro zum Oktoberfest nach Moskau ein.“"
                                            }
                                        ],
