                "senses": [
                    {
                        "sense_id": "3690826d-eb8d-3a87-ac0a-7c7c1d679fd1",
                        "entry_id": "5265d74b-a29b-3912-859b-ca177f755f05",
                        "glosses": [
                            "aus etwa einhundert (früher) Männern, (heute) Einsatzkräften bestehende Einheit"
                        ],
                        "tags": [
                            "Polizei"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1c31dd-316c-4b32-bfb4-cc9bde3db0da",
                                "sense_id": "3690826d-eb8d-3a87-ac0a-7c7c1d679fd1",
                                "text": "„Vor Orenburg stieß eine weitere Hundertschaft Kosaken zu ihnen, um sie gegen Überfälle der Reiterhorden zu schützen.“"
                            },
                            {
                                "example_id": "26e68d06-dfb5-47b5-b30b-4653a7e809b9",
                                "sense_id": "3690826d-eb8d-3a87-ac0a-7c7c1d679fd1",
                                "text": "„Was uns nachmals in immerhin verhältnismäßig frühen Quellen über die Hundertschaft berichtet wird, steht für die germanische Epoche der Landbesetzung auf schwankendem Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
