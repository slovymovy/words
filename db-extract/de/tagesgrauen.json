                        "form": "dem Tagesgrauen"
                    },
                    {
                        "form_id": "d95898bb-2039-4934-bc21-10df8af2a597",
                        "entry_id": "a5e0f817-3749-384b-910c-904cfb9c762b",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Tagesgrauen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                        "entry_id": "a5e0f817-3749-384b-910c-904cfb9c762b",
                        "glosses": [
                            "erste Phase des beginnenden Tageslichts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77bea0fd-a95e-4245-9733-ac3e06d73873",
                                "sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                                "text": "„Da gehen nun diese Männer im Tagesgrauen und sammeln Früchte, als ob sie die ganze Nacht hindurch nichts anderes getan hätten.“"
                            },
                            {
                                "example_id": "04a8c9f1-8b57-4f1e-a0e2-e09cd930c43e",
                                "sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                                "text": "„Als er am anderen Morgen bei Tagesgrauen seine Schäferhütte verließ, war sein erster Gang zu dem Baume.“"
                            },
                            {
                                "example_id": "1c72b6af-c921-41d2-a07a-9e5ff8ae6a80",
                                "sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                                "text": "„Graf Orlow, der eingeschlummert war, wurde kurz vor Tagesgrauen geweckt.“"
                            },
                            {
                                "example_id": "e4223415-214f-4a0c-95b6-d1f89bb47dd3",
                                "sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                                "text": "„Bei Tagesgrauen weckte er, übel zugerichtet, die Leute in Galtarholt; voll von Kot und durchnäßt, mit klappernden Zähnen, fragte er nach Mosjö Bendix.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c725e83-361f-445d-bf37-27199f8bf685",
                        "source_entry_id": "a5e0f817-3749-384b-910c-904cfb9c762b",
                        "source_sense_id": "f74e9a73-ca14-367f-b90b-dcccfa2a3b38",
                        "source_sense_description": "erste Phase des beginnenden Tageslichts",
                        "target_lang_word": "aube",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aube",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                        "entry_id": "6eaa9818-759e-3385-985d-8b5859dacf20",
                                        "glosses": [
                                            "Clarté qui blanchit l'orient au moment précédant le lever du soleil, ce moment lui-même."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04756b4-e911-47a3-aac8-76e51f49ab62",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Au réveil, dans les premières blancheurs de l’aube apparaît un fleuve qui tourne sous ses fumées matinales […]"
                                            },
                                            {
                                                "example_id": "0cd09103-8d5a-4e78-8846-034b3098ce85",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Dès l’aube, tout Tarascon était sur pied, encombrant le chemin d’Avignon."
                                            },
                                            {
                                                "example_id": "8bf8bc0d-bd69-4215-b024-4552f2b1d128",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Non, non, ne me plaignez pas de partir à l'aube, puisque l'aube, en ce pays, s'échappe nue et empourprée, d'un ciel laiteux, éventé de sons de cloches et de vols de pigeons blancs..."
                                            },
                                            {
                                                "example_id": "c80c0a2b-8cab-458b-94b6-118c06513f31",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Souvent, la nuit, par les beaux clairs de lune, il se levait et restait à l’affût jusqu’à l’aube."
                                            },
                                            {
                                                "example_id": "c5c2f9e2-0b3b-46d6-99a8-bf16b4167264",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Ils attendent l’aube stoïquement, devant un café-crème ou, favorisés par la chance, font parfois la rencontre d’un compatriote qui leur paie à souper."
                                            },
                                            {
                                                "example_id": "2269e412-b4f6-448a-adbe-d88a1f03c147",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Enfin, l’aube, une aube splendide, mauve comme en plein été, nous fouetta. La détente fut délicieuse."
                                            },
                                            {
                                                "example_id": "5a58a2cb-2288-4886-b7bf-6d2281e6ca67",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Pas un détenu qui ne se retourne le soir sur sa paillasse à l’idée que l’aube peut être sinistre, qui ne s’endort sans souhaiter qu’il ne se passe rien."
                                            },
                                            {
                                                "example_id": "954fa76d-4434-420a-b3c3-3e2bddd373c2",
                                                "sense_id": "1f969b09-9fb5-309b-91ae-bc92ac8bd513",
                                                "text": "Il est expédient de bifurquer à faux pour dérouter les pillards qui braconnent les tenderies dès l’aube, avant le propriétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f693f3f-1193-3573-80c7-64a0f92b81ee",
                                        "entry_id": "6eaa9818-759e-3385-985d-8b5859dacf20",
                                        "glosses": [
                                            "Commencement, début."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ad7d80-4afc-4c3f-9397-630ad298c426",
                                                "sense_id": "3f693f3f-1193-3573-80c7-64a0f92b81ee",
                                                "text": "En même temps que mes petites jambes, mon esprit s'était éveillé ; une clarté un peu plus vive venait de jaillir dans ma tête, où l'aube des idées était encore si pâle."
                                            },
                                            {
                                                "example_id": "d87b2e34-6786-440b-9a53-ff843da49e71",
                                                "sense_id": "3f693f3f-1193-3573-80c7-64a0f92b81ee",
                                                "text": "A ces époques nébuleuses de l’aube chrétienne, il n'y a encore aucune division de la terre."
                                            },
                                            {
                                                "example_id": "35a796e3-72fb-4e1c-8194-99e1faaa3731",
                                                "sense_id": "3f693f3f-1193-3573-80c7-64a0f92b81ee",
                                                "text": "L’éducation moyenne atteignait un niveau extraordinaire, et, à l’aube du XXᵉ siècle, on trouvait relativement peu de gens, dans l’Europe occidentale, qui ne sussent lire et écrire."
                                            },
                                            {
                                                "example_id": "574789fb-a59a-46d2-a8bd-58e5b3469d70",
                                                "sense_id": "3f693f3f-1193-3573-80c7-64a0f92b81ee",
                                                "text": "D’ailleurs, à quelques signes, on pourrait croire que l’aube de la sincérité commence à poindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac285a5-68a2-3c3b-9654-3464014fc060",
                                        "entry_id": "6eaa9818-759e-3385-985d-8b5859dacf20",
                                        "glosses": [
                                            "Poésie lyrique du Moyen Âge (« alba ») ayant pour thème la séparation au point du jour de deux êtres qui s’aiment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "aube",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b819729-d154-345f-88a1-05228b9dc834",
                                        "entry_id": "4154e9fa-3e2e-38a8-bfa0-5be93e914694",
                                        "glosses": [
                                            "Vêtement religieux de toile blanche serré aux reins par un cordon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f5da87-27b5-436d-bb0c-c4299f14c233",
                                                "sense_id": "0b819729-d154-345f-88a1-05228b9dc834",
                                                "text": "Une file de religieux en aube, le père prieur en tête, sortit de la sacristie et se dirigea vers la porte de l’église."
                                            },
                                            {
                                                "example_id": "1ceb83ed-fdf4-4692-a936-97b96de6abad",
                                                "sense_id": "0b819729-d154-345f-88a1-05228b9dc834",
                                                "text": "Dans le tohu-bohu de la sacristie m’échoyai l’honneur d’aider le prêtre à se vêtir des ornements. Je présentais l’amict, l’aube, l’étole. Je veillais à la pose de la chasuble."
                                            },
                                            {
                                                "example_id": "b6e960cb-0bd7-49fc-a5a4-91c1da804b13",
                                                "sense_id": "0b819729-d154-345f-88a1-05228b9dc834",
                                                "text": "Nous suivîmes cette éducation religieuse jusqu’à la « communion solennelle », en aube blanche, une énorme croix de bois sur la poitrine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aube",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3859a056-298c-3946-a8ad-1df03d56f010",
                                        "entry_id": "5d154482-ba35-30d1-b21a-b2e7398971de",
                                        "glosses": [
                                            "Planche fixée à la circonférence d’une roue de moulin à eau ou d’un bateau à vapeur et sur laquelle s’exerce l’action du liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af11b2de-3ea0-4c96-bf3a-dbd57364eb3a",
                                                "sense_id": "3859a056-298c-3946-a8ad-1df03d56f010",
                                                "text": "Les aubes d’un moulin."
                                            },
                                            {
                                                "example_id": "7c1c5fc8-e302-4dbd-a42d-15d881f4453e",
                                                "sense_id": "3859a056-298c-3946-a8ad-1df03d56f010",
                                                "text": "Roue à aubes."
                                            },
                                            {
                                                "example_id": "65fd1292-9e76-46dd-be4d-71eac03348f6",
                                                "sense_id": "3859a056-298c-3946-a8ad-1df03d56f010",
                                                "text": "On aurait dit qu’un club de gentlemen avait été propulsé sans cérémonie sur un bateau à aubes du Mississippi."
                                            },
                                            {
                                                "example_id": "e076542c-9b6e-462b-93db-cfa4a406dd86",
                                                "sense_id": "3859a056-298c-3946-a8ad-1df03d56f010",
                                                "text": "La courbe des aubes se raccorde tangentiellement avec la circonférence de la roue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef83df23-de97-3175-a8c9-fb17a879c67c",
                                        "entry_id": "5d154482-ba35-30d1-b21a-b2e7398971de",
                                        "glosses": [
                                            "Par analogie, pale, ailette d'un compresseur ou d'une turbine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abac3460-00e5-4b4a-ae93-a9425c0956f0",
                                                "sense_id": "ef83df23-de97-3175-a8c9-fb17a879c67c",
                                                "text": "Les aubes d'une turbine de turboréacteur d'avion sont soumises à de fortes sollicitations."
                                            }
                                        ]
                                    }
                                ]
                            },
