                        ],
                        "form": "die Isaacs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                        "entry_id": "3272017f-b3db-3838-8b34-61db59fb5004",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9720354a-6448-4f02-a5a6-cb1b934f870a",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Frau Isaac ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d5dddd1b-c04d-4b2f-a473-7e4d30e727f6",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Herr Isaac wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c098011-37e0-4ee1-b858-4f605770a247",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Die Isaacs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2c658e46-e34d-4ca1-83a4-b0dd5bdedab7",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Der Isaac trägt nie die Schals, die die Isaac ihm strickt."
                            },
                            {
                                "example_id": "28705f52-74ae-428e-8f7a-954d065d285d",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Isaac kommt, geht der Herr Isaac.“"
                            },
                            {
                                "example_id": "eefef651-262e-482a-a0b0-492eb2810bbb",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Isaac kommt und geht."
                            },
                            {
                                "example_id": "14877ca9-c550-4db4-8af5-cc00ab47f714",
                                "sense_id": "6ef599b1-5463-351e-8fd4-7483c2b17ef4",
                                "text": "Isaacs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
