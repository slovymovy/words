                "senses": [
                    {
                        "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                        "entry_id": "9f35c7af-0bef-31a1-980d-624cb1ece4d1",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0123df06-093f-4fc4-8fc0-2c8c984e90e8",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Frau Aquila ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5fdff70c-acab-4451-b570-dd112784466b",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Herr Aquila wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ffa719f0-69d4-4fcf-a712-61274b245bb5",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Die Aquilas fliegen heute nach Dublin."
                            },
                            {
                                "example_id": "73b8440f-9d86-4c2b-a48e-46cf1e5b51a1",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Der Aquila trägt nie die Pullover, die die Aquila ihm strickt."
                            },
                            {
                                "example_id": "3eca3805-cc75-4bb6-ab81-ef0fda8925c8",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Aquila kommt, geht der Herr Aquila.“"
                            },
                            {
                                "example_id": "7eaf8c35-571b-4b52-ac89-e4d7981546b1",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Aquila kommt und geht."
                            },
                            {
                                "example_id": "bbd6a59b-45ab-4ffd-9288-2116684b45b2",
                                "sense_id": "26bd90f0-671c-3460-90b4-e64b9ce7fcf1",
                                "text": "Aquilas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
