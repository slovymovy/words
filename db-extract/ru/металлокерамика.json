                "translations": [
                    {
                        "translation_id": "6fcd5307-2734-40c9-a73a-763de656573e",
                        "source_entry_id": "28b21070-d457-3f29-b2a7-583688a9b405",
                        "source_sense_description": "материал, полученный из металлического порошка путём прессования и спекания при высокой температуре",
                        "target_lang_word": "ceramic-metal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7a2e0dfa-5302-4685-8bc5-e98895cbaf21",
                        "source_entry_id": "28b21070-d457-3f29-b2a7-583688a9b405",
                        "source_sense_description": "материал, полученный из металлического порошка путём прессования и спекания при высокой температуре",
                        "target_lang_word": "cermet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cermet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58b835c0-7c34-3a9c-b90f-5d1e380ef40c",
                                        "entry_id": "aa24b569-93a3-34d6-a481-f7b7891cb059",
                                        "glosses": [
                                            "A composite material composed of ceramic and metal materials, used in such applications as industrial saws and turbine blades."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c5a359-b09c-4778-95a0-458934dd83a0",
                                                "sense_id": "58b835c0-7c34-3a9c-b90f-5d1e380ef40c",
                                                "text": "2003, Stephen F. Krar, Arthur Gill, Exploring Advanced Manufacturing Technologies, page 3-2-14,\nThe multi-component alloy cermets, made up of different hard materials and binder elements, have high wear-resistance qualities that result in long tool life."
                                            },
                                            {
                                                "example_id": "27cc6b7c-1f12-419d-b16a-5b22a3ac7dc0",
                                                "sense_id": "58b835c0-7c34-3a9c-b90f-5d1e380ef40c",
                                                "text": "Cutting performance of cermets was improved after development of titanium-molybdenum-carbon-nitrogen and titanium-tungsten-carbon-nitrogen compounds with binders containing nickel, molybdenum, cobalt, or a combination thereof (Ref 3, p.91)."
                                            },
                                            {
                                                "example_id": "8d9d0e55-9bd8-46bb-9448-6e3746330dab",
                                                "sense_id": "58b835c0-7c34-3a9c-b90f-5d1e380ef40c",
                                                "text": "Among various tribological materials, cermets are known for their excellent wear resistance under unlubricated conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
