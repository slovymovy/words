                        "glosses": [
                            "Baside qui n’a pas de cloisonnement interne, pourvue de 4 stérigmates qui forment ensuite 4 spores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cdf9eaa-4f72-4367-b48b-5c5462402594",
                                "sense_id": "8c525b66-86a1-3843-a2ac-7f90357cde68",
                                "text": "Les basides entières sont des homobasides ou eubasides, celles cloisonnées transversalement des archéobasides et celles cloisonnées longitudinalement des hétérobasides. Une endobaside désigne une baside formée à l’intérieur d’un sporophore clos de basidiomycètes. Un organisme hypobaside s’oppose à celui qui est épibaside."
                            }
                        ]
                    }
