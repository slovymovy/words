                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f668de9f-d8b7-4b59-ae80-30902c34ce95",
                                                "sense_id": "67daa5d1-993b-362d-b8ca-493a0dcbb89a",
                                                "text": "Ik werd vanmiddag weer afgesneden door zo'n snelle auto."
                                            },
                                            {
                                                "example_id": "b5f578f7-a0ad-4169-8b74-9133e1102ceb",
                                                "sense_id": "67daa5d1-993b-362d-b8ca-493a0dcbb89a",
                                                "text": "De terugtocht van de troepen werd afgesneden"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b45ddde0-1734-3f12-a18b-53e95dd96550",
                                        "entry_id": "ae05dc63-66cf-320b-98b6-a9fcabbe787e",
                                        "glosses": [
                                            "een afkorting in een traject nemen, een weg bekorten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cac2558-34a7-4aa4-b55e-3f262c1dfe3f",
                                                "sense_id": "b45ddde0-1734-3f12-a18b-53e95dd96550",
                                                "text": "Door deze weg te nemen, kunnen wij een heel stuk afsnijden"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc8ca232-1c2d-3000-ba2d-4e3efbe1249f",
