                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd09762e-c5c1-34fe-8f17-318d6b929d43",
                                        "entry_id": "d5038142-8ee0-393d-9a1f-307737eb225f",
                                        "glosses": [
                                            "amphibische Fischart mit einem langgestreckten Körper und hochstehenden Augen, die in Mangrovenwäldern und am Brackwasser lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bede4ec-d891-405d-af87-ca58c19c9ea2",
                                                "sense_id": "cd09762e-c5c1-34fe-8f17-318d6b929d43",
                                                "text": "„Die beiden Frauen hatten während ihres Urlaubs am Ufer eines Flusses im Norden Australiens ein kleines Tier beobachtet, einen Schlammspringer.“"
                                            },
                                            {
                                                "example_id": "0434fe3c-59a4-41e1-b030-c7ee819cd291",
                                                "sense_id": "cd09762e-c5c1-34fe-8f17-318d6b929d43",
                                                "text": "„Der Schlammspringer, Periophthalmus, liegt auf einem Seitenast der Evolution.“"
                                            },
                                            {
                                                "example_id": "3131dadb-8375-4bb3-b77a-296fad8c28c1",
                                                "sense_id": "cd09762e-c5c1-34fe-8f17-318d6b929d43",
                                                "text": "„Versuche der Forscher mit Schlammspringern auf sandartigem Granulat zeigen, dass die Brustflossen zur Fortbewegung in flachem Gelände durchaus genügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
