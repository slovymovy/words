                        "cross_references": [
                            {
                                "target_word": "Cathedral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80232441-1fec-30fe-8b40-4778ce1f08b8",
                                        "entry_id": "0a2ff0bb-368d-313e-8f03-3629f92d5087",
                                        "glosses": [
                                            "The mainstream system or establishment in society, regarded as liberal or leftist."
                                        ],
                                        "tags": [
                                            "US",
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff6147f9-aafb-4efe-a675-2ad32debde0d",
                                                "sense_id": "80232441-1fec-30fe-8b40-4778ce1f08b8",
                                                "text": "The reaction from the Cathedral—the press, the political establishment, and everyone else who shaped acceptable opinion—was quick and unanimous"
                                            },
                                            {
                                                "example_id": "0a6b4ec2-8d75-467e-b354-b08185fda8f3",
                                                "sense_id": "80232441-1fec-30fe-8b40-4778ce1f08b8",
                                                "text": "This is why grown-up men and women in the Cathedral (to use the neoreactionary term for the Establishment) actually believe that the MAGA yahoos of January 6 nearly overthrew the US government."
                                            },
                                            {
                                                "example_id": "c0e469e1-19a5-47a0-964d-fc21589d352c",
                                                "sense_id": "80232441-1fec-30fe-8b40-4778ce1f08b8",
                                                "text": "[Curtis Yarvin] is forthright in his belief that the present order — to his mind, an oligarchy governed by a complex of elite institutions (like this newspaper) that he calls “the Cathedral” — should be overthrown"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
