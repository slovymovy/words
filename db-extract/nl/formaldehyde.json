                "senses": [
                    {
                        "sense_id": "76c49592-cbd5-36cc-b3ac-0e8e7fb2e95c",
                        "entry_id": "8110ce12-ebd7-3754-b7df-86fb75273aba",
                        "glosses": [
                            "gas met de formule H₂CO gebruikt voor de synthese van kunststoffen en desinfectie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4985efd0-a8cf-496d-a5f8-9d6226586406",
                                "sense_id": "76c49592-cbd5-36cc-b3ac-0e8e7fb2e95c",
                                "text": "De lekkage van het kankerverwekkende formaldehyde bij het chemiebedrijf DuPont in Dordrecht heeft geen nadelige gevolgen gehad. Dat concludeert het bedrijf na een eerste onderzoek, aldus het ministerie van Infrastructuur en Milieu dinsdag."
                            },
                            {
                                "example_id": "9ddb1b2f-6c21-4187-929a-13424272eea4",
                                "sense_id": "76c49592-cbd5-36cc-b3ac-0e8e7fb2e95c",
                                "text": "Nagellak bij baby’s klinkt misschien heel erg leuk en schattig, maar voordat je de nagels van je kleintje een flitsend kleurtje geeft, moet je je wel bedenken dat er ontzettend veel chemicaliën in nagellak zitten. Voordat je overweegt om het spul aan te schaffen, is het dus aan te raden om je te laten informeren over nagellakjes die geen dibutylftalaat, formaldehyde of toluene bevatten. Hoewel dit natuurlijk al een stuk beter is voor je kind, zitten er altijd nog wel enkele chemicaliën in de nagellak verstopt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "845b12fc-58aa-4aa1-b55d-c8100c45f80a",
                        "source_entry_id": "8110ce12-ebd7-3754-b7df-86fb75273aba",
                        "source_sense_id": "76c49592-cbd5-36cc-b3ac-0e8e7fb2e95c",
