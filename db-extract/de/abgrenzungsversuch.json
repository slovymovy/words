                "senses": [
                    {
                        "sense_id": "3ecf0617-2c61-36b0-94d5-3057d68fc2cd",
                        "entry_id": "2457637f-3172-3dfb-a871-ba6c490d33c4",
                        "glosses": [
                            "Versuch einer Abgrenzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83aeee88-cf38-4dbb-aeaa-99352243a1cb",
                                "sense_id": "3ecf0617-2c61-36b0-94d5-3057d68fc2cd",
                                "text": "„Tatsächlich ergeben sich bei dem Versuch, das mittlere Lebensalter gegen das Alter abzugrenzen, eine Reihe von Schwierigkeiten.\nDas Zusammenspiel von physiologischen Kriterien, wie z. B. die Menopause, und psychologischen Kriterien, wie das Nachlassen des Engagements in beruflichen Aktivitäten oder das Nachlassen von Ehrgeiz zugunsten eines Gefühls der persönlichen Zufriedenheit, und schließlich soziologische Kriterien, wie die Anpassung an die geänderten sozialen und ökonomischen Bedingungen des Ruhestandes, sind bei einem solchen Abgrenzungsversuch zu berücksichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
