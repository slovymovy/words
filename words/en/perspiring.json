        "perspire"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "633af634-63d5-3149-ba99-0ac87c79c930",
                    "sense_definition": "Present participle of <w>perspire</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athletes were <w>perspiring</w> heavily under the scorching midday sun.",
                            "target_lang_translations": {
                                "es": "Los atletas estaban <w>sudando</w> copiosamente bajo el sol abrasador del mediodía."
                            }
                        },
                        {
                            "text": "She could feel herself <w>perspiring</w> as she waited nervously to give her presentation.",
                            "target_lang_translations": {
                                "es": "Podía sentir que estaba <w>transpirando</w> mientras esperaba nerviosa para dar su presentación."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating"
                    ],
                    "common_phrases": [
                        "perspiring heavily",
                        "perspiring profusely"
                    ],
                    "target_lang_definitions": {
                        "es": "Participio de presente de perspire; sudando o transpirando."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sudando",
                                "target_lang_sense_clarification": "forma continua de sudar"
                            },
                            {
                                "target_lang_word": "transpirando",
                                "target_lang_sense_clarification": "forma continua de transpirar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "24b15e65-55ad-3a09-8d00-fe897d1cb244",
                    "sense_definition": "Producing or covered with sweat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped his <w>perspiring</w> forehead with a clean handkerchief after the run.",
                            "target_lang_translations": {
                                "es": "Se secó la frente <w>sudorosa</w> con un pañuelo limpio después de correr."
                            }
                        },
                        {
                            "text": "The nervous candidate tried to dry his <w>perspiring</w> palms before shaking hands.",
                            "target_lang_translations": {
                                "es": "El nervioso candidato intentó secar sus palmas <w>sudorosas</w> antes de estrechar la mano."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating"
                    ],
                    "common_phrases": [
                        "perspiring brow",
                        "perspiring palms",
                        "perspiring forehead"
                    ],
                    "target_lang_definitions": {
                        "es": "Que produce sudor o está cubierto de sudor; sudoroso o transpirado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sudoroso",
                                "target_lang_sense_clarification": "cubierto de sudor"
                            },
                            {
                                "target_lang_word": "transpirado",
                                "target_lang_sense_clarification": "humedecido por la transpiración"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bbfdad08-d38e-3b6e-a2a3-8c82e2ff7e0c",
                    "sense_definition": "The act or instance of sweating.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sweat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strenuous workout resulted in intense <w>perspiring</w> that soaked their shirts.",
                            "target_lang_translations": {
                                "es": "El extenuante entrenamiento provocó una intensa <w>sudoración</w> que empapó sus camisetas."
                            }
                        },
                        {
                            "text": "The constant <w>perspiring</w> of the workers reflected the heavy physical toil of the day.",
                            "target_lang_translations": {
                                "es": "La constante <w>transpiración</w> de los trabajadores reflejaba el arduo esfuerzo físico de la jornada."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweating"
                    ],
                    "target_lang_definitions": {
