                        ],
                        "form": "dem Widerwillen"
                    },
                    {
                        "form_id": "2ed3d3aa-354d-41c5-954e-a899f9c52124",
                        "entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Widerwillen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "glosses": [
                            "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e41a167-d759-42fb-9fe4-0efe9d2dd08b",
                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                "text": "„In diesem Augenblick fühlte er nichts anderes als einen unbestimmten Zorn, einen tiefen Widerwillen und den Beginn einer grenzenlosen Hoffnungslosigkeit.“"
                            },
                            {
                                "example_id": "4683c385-5f0b-40c3-ba52-8b951cdf2261",
                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                "text": "„Sie hatte sich bei der Arbeit niemals wohl gefühlt, aber jetzt trat zum Unbehagen plötzlich noch Widerwille hinzu.“"
                            },
                            {
                                "example_id": "743e4064-8626-4897-a82e-44f12cf8a682",
                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                "text": "„Aber gerade in diesem Widerwillen gegen alles fand Pierre einen seltsam erregenden Reiz.“"
                            },
                            {
                                "example_id": "097630bc-a125-4db5-8669-2ddd5a23adf9",
                                "sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                                "text": "„Ich tat es mit Widerwillen und stand Höllenqualen aus, nicht aus Verlangen, an seine Stelle zu treten, denn bei mir rührte sich nichts, sondern aus Wut darüber, daß sich eine so schöne Frau einem Mann hingab, der seinen einzigen Vorzug mit dem Esel gemeinsam hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f094b957-dd32-40cf-8239-6c2f895a7707",
                        "source_entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "source_sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "source_sense_description": "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "réticence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réticence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f998895c-1e06-36ec-a8f8-ac23566fc7a0",
                                        "entry_id": "2b4ff7b0-f9c8-3059-99c3-7cce5c821d90",
                                        "glosses": [
                                            "Action de taire à dessein une chose qu’on pourrait ou qu’on devrait dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db8e27e2-77d4-4758-990c-857bd513ca55",
                                                "sense_id": "f998895c-1e06-36ec-a8f8-ac23566fc7a0",
                                                "text": "Indépendamment des causes ordinaires de nullité, […], le contrat d’assurance est nul en cas de réticence ou de fausse déclaration intentionnelle de la part de l’assuré, quand cette réticence ou cette fausse déclaration change l’objet du risque ou en diminue l’opinion pour l’assureur, alors même que le risque omis ou dénaturé par l’assuré a été sans influence sur le sinistre."
                                            },
                                            {
                                                "example_id": "4a1568cf-d6f7-40d9-add3-cbc373f462ad",
                                                "sense_id": "f998895c-1e06-36ec-a8f8-ac23566fc7a0",
                                                "text": "Dans le récit qu’il m’a fait, il a mis beaucoup de réticence."
                                            },
                                            {
                                                "example_id": "3ad50514-770c-4cbc-ab1d-c2067b7c8831",
                                                "sense_id": "f998895c-1e06-36ec-a8f8-ac23566fc7a0",
                                                "text": "Il a usé avec moi de réticence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecaac79e-0e04-338c-a1b6-c1ef097af858",
                                        "entry_id": "2b4ff7b0-f9c8-3059-99c3-7cce5c821d90",
                                        "glosses": [
                                            "Chose même que l’on n’a pas dite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6716ab-1078-444b-953a-fb8fd29b1ac1",
                                                "sense_id": "ecaac79e-0e04-338c-a1b6-c1ef097af858",
                                                "text": "Dans ce discours, il n’y a point de mensonge formel, mais il y a bien des réticences."
                                            },
                                            {
                                                "example_id": "248cd84c-0c0b-4e9d-907f-6173aac576f3",
                                                "sense_id": "ecaac79e-0e04-338c-a1b6-c1ef097af858",
                                                "text": "Dans cet acte, il y a une réticence frauduleuse."
                                            },
                                            {
                                                "example_id": "0fa202b9-1431-4ce6-b051-ae4a197a86a1",
                                                "sense_id": "ecaac79e-0e04-338c-a1b6-c1ef097af858",
                                                "text": "Des réticences perfides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daea29fe-6b07-3346-b149-fc252bc89311",
                                        "entry_id": "2b4ff7b0-f9c8-3059-99c3-7cce5c821d90",
                                        "glosses": [
                                            "Figure par laquelle l’orateur en s’interrompant fait entendre ce qu’il ne veut pas dire expressément."
                                        ],
                                        "tags": [
                                            "especially",
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ba4524-4bb8-419b-a0a1-f50622da7b5c",
                                                "sense_id": "daea29fe-6b07-3346-b149-fc252bc89311",
                                                "text": "Il y a un tour de Fiction, au moyen duquel la penſée ne doit pas être entendue littéralement comme elle eſt énoncée, mais qui laiſſe apercevoir le véritable point de vûe en le rendant ſeulement plus ſenſible & plus intéreſſant par la Fiction même. De là naissent l'Hyperbole, la Litote, l'Interrogation, la Dubitation, la Prétérition, la Réticence, l'Interruption, le Dialogiſme, l'Épanorthoſe, l'Épitrope, & l'Ironie ; celle-ci ſe ſoudiviſe, à raison des points de vûe ou des tons, en ſix eſpèces ; ſavoir, la Mimèſe, le Chleuaſme ou Perſifflage, l'Aſtéiſme, le Charientiſme, le Diaſirme, & le Sarcaſme."
                                            },
                                            {
                                                "example_id": "b31fcee5-b2d4-4946-b6f1-ce033ac0b9e1",
                                                "sense_id": "daea29fe-6b07-3346-b149-fc252bc89311",
                                                "text": "La réticence en dit quelquefois plus que les paroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7daf2c90-70fd-3f53-8148-a7754f93cca4",
                                        "entry_id": "2b4ff7b0-f9c8-3059-99c3-7cce5c821d90",
                                        "glosses": [
                                            "Réserve ou restriction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80d793e-f735-424d-97d6-4d8fb00b3fdc",
                                                "sense_id": "7daf2c90-70fd-3f53-8148-a7754f93cca4",
                                                "text": "En effet, il n’y a pas si longtemps que la réunion des deux éléments de ce titre — préhistoire et Amérique — aurait suscité beaucoup de réticence chez plus d’un américaniste."
                                            },
                                            {
                                                "example_id": "96de3e96-3e7f-48ed-985a-ed691186009f",
                                                "sense_id": "7daf2c90-70fd-3f53-8148-a7754f93cca4",
                                                "text": "Dans leur ardeur surexcitée, ils morigénaient ceux qui marquaient quelque indécision ou réticence, leur démontrant que dans les circonstances actuelles la meilleure des prudences était d’agir vite."
                                            },
                                            {
                                                "example_id": "2f303fd0-8a0b-4087-a085-e516222258f7",
                                                "sense_id": "7daf2c90-70fd-3f53-8148-a7754f93cca4",
                                                "text": "Elisabeth Borne n'a d'ailleurs pas hésité à placer les parlementaires face à leurs responsabilités : \"Les oppositions sont largement d'accord pour rajouter des dépenses. Mais chaque fois que vous présentez des économies structurelles, vous avez une réticence forte. Ce n'est pas pour rien que j'ai dû passer par 49.3 la réforme des retraites\", a-t-elle narré, assumant d'avoir mené des réformes \"qui n'étaient pour le moins pas populaires\" pour rééquilibrer les comptes publics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07eb93d0-b85c-42ce-ba63-1f016612fb85",
                        "source_entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "source_sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "source_sense_description": "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "aversion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aversion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                        "entry_id": "39a572e2-6bd5-32a8-a80a-53504a3c9f5b",
                                        "glosses": [
                                            "Violente antipathie ; répugnance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ade791-3ad4-45c2-92ed-90ce8c730525",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Le mépris où il tenait le nationalisme dont j'ai toujours eu l'aversion, le dédain qu'il témoignait pour les trémolos sur le grand air de patrie qui enchantaient le sentimentalisme alangui de mon cher Paul Deschanel achevèrent de m'attacher à lui."
                                            },
                                            {
                                                "example_id": "62e4f777-eac9-4a75-8b54-08a5121d9f9e",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Un leitmotiv principal à travers son œuvre est sans aucun doute la grande aversion qu'il porte contre cette génération fondamentalement dégénérée de soixante-huitards."
                                            },
                                            {
                                                "example_id": "9f14b26a-b854-4152-be85-e70b10df6d43",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Son père, […], est surnommé « Camélinat le Rouge » pour ses convictions républicaines. Cet austère paysan a élevé ses enfants dans l’aversion de la monarchie, puis de l’Empire."
                                            },
                                            {
                                                "example_id": "4b219eda-bfd8-4c95-97ab-cbadbe04b76b",
                                                "sense_id": "87668315-ed70-33fa-92a3-8d1f6a3afd8c",
                                                "text": "Le contraire de l'amour, ce n'est pas la haine, mais l'aversion. On peut tomber subitement amoureux d'une personne qu'on déteste, mais pas d'une personne qui nous répugne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a25a9a12-0132-3c6d-ba0e-0cf4e5699252",
                                        "entry_id": "39a572e2-6bd5-32a8-a80a-53504a3c9f5b",
                                        "glosses": [
                                            "Objet lui-même de cette forte antipathie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e61b5a4-d85c-43bb-b075-dc19ecbe7529",
                        "source_entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "source_sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "source_sense_description": "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "répugnance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "répugnance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                        "entry_id": "f78927c8-aca3-3f12-85f1-320fcf12b9fc",
                                        "glosses": [
                                            "Opposition naturelle, éloignement ou répulsion pour quelqu’un ou pour quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "743684c0-c589-4226-a0d4-5dd99093d3bd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Alors Athos tira de sa poche un petit papier sur lequel étaient écrites deux lignes accompagnées d’une signature et d’un sceau, et le présenta à celui qui donnait trop prématurément ces signes de répugnance."
                                            },
                                            {
                                                "example_id": "0000f741-1e5c-4492-b10a-20e8145feddd",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Ce fut donc le clergé qui, à Plassans, mena la réaction. La noblesse devint son prête-nom, rien de plus ; il se cacha derrière elle, il la gourmanda, la dirigea, parvint même à lui rendre une vie factice. Quand il l’eut amenée à vaincre ses répugnances au point de faire cause commune avec la bourgeoisie, il se crut certain de la victoire."
                                            },
                                            {
                                                "example_id": "bcbfb70a-38fe-44b1-a0b0-b4a0742b2caa",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "L’iguane est un plat médiocre, disent les uns, cela sent le reptile. Mais si l'on peut vaincre sa répugnance, cela constitue un plat de résistance et qui vaut bien le singe rouge. Quant à moi, j'en suis très friand ; […]."
                                            },
                                            {
                                                "example_id": "a3dffe78-fedb-4abf-8145-0033419d4024",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Il est vrai, […], que le juifs, plus versés que les prêtres chrétiens dans la connaissance des Écritures, étaient de redoutables controversistes, à ce point que Saint Louis manifesta sa répugnance pour les discussions entre les juifs et les chrétiens insuffisamment instruits : […]."
                                            },
                                            {
                                                "example_id": "d45a7b05-e12a-41fd-a1a5-8660ca6455b0",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Sa nuit de noce n'avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "e7c6a1b3-82a1-4914-8204-6555e31967be",
                                                "sense_id": "d1f62ae2-3cd8-31ba-bbae-e2ce48f86bd2",
                                                "text": "Un problème d’incontinence peut ne pas être reconnu étant donné la répugnance de la personne à parler de quelque chose d’aussi privé et d’aussi intime que la fonction urinaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1786736-ba87-4cd0-a2a9-652dde0d3c1f",
                        "source_entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "source_sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "source_sense_description": "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "mauvaise volonté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mauvaise volonté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc5f54f5-e4fc-34db-9074-ca1d371eadfa",
                                        "entry_id": "362f4047-3b92-37d4-89e0-545e5abc52ef",
                                        "glosses": [
                                            "Absence flagrante de volonté de bien faire ou d’être serviable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32fa541f-d0e9-4ccb-a6f2-edfcb6fc12d9",
                                                "sense_id": "cc5f54f5-e4fc-34db-9074-ca1d371eadfa",
                                                "text": "La mauvaise volonté des événements s’était annoncée de longue date."
                                            },
                                            {
                                                "example_id": "15a56f02-925d-4605-9f22-332f16e27ad1",
                                                "sense_id": "cc5f54f5-e4fc-34db-9074-ca1d371eadfa",
                                                "text": "C'était un grand Noir filiforme qui semblait plein de nonchalance et de mauvaise volonté, bien qu'il portât une tunique à boutons et des culottes de nègre de maison."
                                            },
                                            {
                                                "example_id": "ac0f1ca0-ac4a-4df6-a800-ada9891cb186",
                                                "sense_id": "cc5f54f5-e4fc-34db-9074-ca1d371eadfa",
                                                "text": "Le constat ? « Tout s’exacerbe, avance-t-il. Les bonnes volontés sont plus belles que jamais et les mauvaises volontés encore pires que jamais ! »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83344db4-a3c2-4000-992a-70c14ab1fc1e",
                        "source_entry_id": "465119e0-84e4-3ba0-893f-9ba5756532ae",
                        "source_sense_id": "66346ae9-b882-335a-9854-c3e3979f9d16",
                        "source_sense_description": "Einstellung/Gefühl einer starken Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "opposition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opposition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45accec3-ef7e-3cf7-bc9e-fcdbdfe50b7c",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Contraste dû à la comparaison de deux choses jugées particulièrement différentes, qui s’opposent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a3f2b9a-49b2-4cc9-8fe3-576580b45a92",
                                                "sense_id": "45accec3-ef7e-3cf7-bc9e-fcdbdfe50b7c",
                                                "text": "La métaphysique tout entière est attachée à la détermination de l’idée d’infini ; il n’est point de difficulté métaphysique qui ne naisse de l’opposition entre le fini et l’infini […]"
                                            },
                                            {
                                                "example_id": "2d7d12a3-3f80-47b8-b39d-118a5a887bc3",
                                                "sense_id": "45accec3-ef7e-3cf7-bc9e-fcdbdfe50b7c",
                                                "text": "L’opposition entre le juste et le pécheur, ou le croyant et l’impie, implique qu’aucune entité incroyante ne saurait être tolérée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19aebda0-3e61-3b44-bca9-171549a2ba46",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Résistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb58ec1f-d3a0-4269-b8a0-9bee1b5ae4b5",
                                                "sense_id": "19aebda0-3e61-3b44-bca9-171549a2ba46",
                                                "text": "Hilperik entra à Paris sans aucune opposition, et logea ses guerriers dans les tours qui défendaient les ponts de la ville, alors environnée par la Seine."
                                            },
                                            {
                                                "example_id": "4e9af28e-04a5-4a77-9524-18bb26f27332",
                                                "sense_id": "19aebda0-3e61-3b44-bca9-171549a2ba46",
                                                "text": "Ainsi on ne pourrait plus contester qu’il y ait une opposition absolue entre le syndicalisme révolutionnaire et l’État ; cette opposition prend en France la forme particulièrement âpre de l’antipatriotisme, […]."
                                            },
                                            {
                                                "example_id": "14e3a9ad-d212-4225-a325-e3fd4df14e5d",
                                                "sense_id": "19aebda0-3e61-3b44-bca9-171549a2ba46",
                                                "text": "Puis, la réserve se transforma en opposition ouverte lorsqu’ils s’aperçurent que chaque ouverture d’école française était accompagnée de la fermeture d’écoles coraniques et de zâouïas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85085db1-bbbc-3b71-a622-47233921c4e3",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Ensemble des forces politiques adversaires du gouvernement en place."
                                        ],
                                        "tags": [
                                            "Science politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58d85609-8371-4eaa-bf97-4deb7b1de261",
                                                "sense_id": "85085db1-bbbc-3b71-a622-47233921c4e3",
                                                "text": "L’opposition assistait avec une sorte de pitié narquoise à l’affolement de la majorité."
                                            },
                                            {
                                                "example_id": "9e39e950-79c7-454c-a3fb-41ca707a1bda",
                                                "sense_id": "85085db1-bbbc-3b71-a622-47233921c4e3",
                                                "text": "L’opposition pense pouvoir faire l’appoint dans son vote de défiance vis-à-vis de l’actuel gouvernement, dont la gestion des affaires a déstabilisé jusqu’à ses propres troupes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d6ce878-e56e-3b05-a3df-7a652119c98e",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Recours judiciaire engagé par une personne contre une décision de justice alors qu’il n’a pas pu se défendre dans le procès ayant abouti à cette décision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f6f512-29bc-4198-803b-f9b1828391de",
                                                "sense_id": "3d6ce878-e56e-3b05-a3df-7a652119c98e",
                                                "text": "L’opposition fait partie des voies de recours ordinaires, alors que la tierce opposition constitue une voie de recours extraordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96557c9f-dfb2-3e80-9391-ff5e09be9acd",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Aspect d’un corps céleste se trouvant à 180 degrés du Soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81ffa7a0-9bec-4ce7-9dc8-2f2f43ad93de",
                                                "sense_id": "96557c9f-dfb2-3e80-9391-ff5e09be9acd",
                                                "text": "L’opposition de Mars est l’instant où la longitude géocentrique de Mars (comptée sur l’écliptique de la date) est à l’opposé de la longitude géocentrique du Soleil. Si les orbites des deux planètes étaient circulaires, cet instant serait aussi un minimum de distance entre les deux planètes. Comme les orbites sont légèrement excentriques et inclinées, la date du minimum de distance peut en différer de quelques jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db956a19-bdf1-3a14-af12-a6d4fdf1f377",
                                        "entry_id": "2b1e3347-acf5-32fd-80dc-cb2e54bbb42a",
                                        "glosses": [
                                            "Position respective des rois dans la finale, et en particulier situation dans laquelle les rois sont séparés d’un nombre impair de cases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeab1b23-e74a-4430-a571-968809524209",
                                                "sense_id": "db956a19-bdf1-3a14-af12-a6d4fdf1f377",
                                                "text": "La recherche de la domination entre deux rois qui se font face s’appelle l’opposition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
