                                        "sense_id": "9851bc1f-e52a-31c9-80d4-6f168ced91d0",
                                        "entry_id": "7b1cfe71-b2ca-3e0c-9191-c48ec9e5a4b9",
                                        "glosses": [
                                            "Qualité de ce qui est acide au goût."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2dae95d-a38b-46a8-8abe-335ab4a3b186",
                                                "sense_id": "9851bc1f-e52a-31c9-80d4-6f168ced91d0",
                                                "text": "Le pinot meunier, rouge aussi, régulier et rustique, atténue l’acidité mais donne des vins fins moins nerveux."
                                            }
                                        ]
                                    }
