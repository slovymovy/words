                "senses": [
                    {
                        "sense_id": "016519af-a9ec-3f7f-ac98-5681ccbc8505",
                        "entry_id": "56109424-6934-393a-b80d-ae9a4038136d",
                        "glosses": [
                            "Poésie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "458c9694-1d85-46f8-9996-b96540cc796e",
                                "sense_id": "016519af-a9ec-3f7f-ac98-5681ccbc8505",
                                "text": "Le parnasse français, la poésie française, les poètes français."
                            },
                            {
                                "example_id": "dead1867-ac19-470d-91b2-3b826591da86",
                                "sense_id": "016519af-a9ec-3f7f-ac98-5681ccbc8505",
                                "text": "Les nourrissons du Parnasse, les poètes."
                            },
                            {
                                "example_id": "42051ed4-c891-42f5-bf66-49b049f31e63",
                                "sense_id": "016519af-a9ec-3f7f-ac98-5681ccbc8505",
                                "text": "Monter sur le parnasse, composer des vers, s’adonner à la poésie."
                            },
                            {
                                "example_id": "4fde0e92-5480-43a8-9ce8-c88eb9cf5c25",
                                "sense_id": "016519af-a9ec-3f7f-ac98-5681ccbc8505",
                                "text": "…déjà, beaucoup de dixièmes Muses vous avaient emmené, vous tenant par la curiosité, dans leurs doubles vallons, et vous avaient proposé de goûter aux fruits de leurs parnasses de pensionnaire."
                            }
                        ]
                    },
