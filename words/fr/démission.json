                    "frequency": "High",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a accepté sa <w>démission</w> après plusieurs semaines de réflexion."
                        },
                        {
                            "text": "Elle a envoyé sa lettre de <w>démission</w> ce matin à son responsable."
                        }
                    ],
                    "synonyms": [
