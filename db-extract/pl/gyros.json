                    {
                        "translation_id": "75c7cacb-23c1-4f59-8dfd-57e75711ec2b",
                        "source_entry_id": "ba22e531-0f28-36be-bdd5-77231c588a49",
                        "source_sense_id": "57ba3891-a0b7-3cd9-871f-f908ba3aa4fb",
