                    "sense_definition": "wzbudzać w kimś ciekawość, zainteresowanie lub zmuszać do myślenia",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ciekawość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę przyznać, że bardzo mnie <w>intryguje</w> twój niezwykły sposób ubierania się.",
                            "target_lang_translations": {
                                "ru": "Должен признать, что меня очень <w>интригует</w> твоя необычная манера одеваться."
                            }
                        },
                        {
                            "text": "Ta tajemnicza wiadomość od dawna <w>intrygowała</w> wszystkich mieszkańców małego miasteczka.",
                            "target_lang_translations": {
                                "ru": "Эта загадочная весть уже давно <w>интриговала</w> всех жителей маленького городка."
                            }
                        }
                    ],
                    "synonyms": [
                        "ciekawić"
                    ],
                    "antonyms": [
                        "nużyć"
                    ],
                    "common_phrases": [
                        "bardzo intrygować",
                        "intrygować czytelnika"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать любопытство, интерес или заставлять задуматься"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интриговать",
                                "target_lang_sense_clarification": "возбуждать интерес или любопытство"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "привлекать внимание, вызывать интерес"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "569abf74-a531-30b5-888b-67a32531f820",
                    "sense_definition": "prowadzić ukryte działania, knuć spiski lub skłócać ze sobą ludzi",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spisek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doradcy króla bez przerwy <w>intrygowali</w> przeciwko sobie, aby zdobyć jak największy wpływ na władcę.",
                            "target_lang_translations": {
                                "ru": "Советники короля непрестанно <w>интриговали</w> друг против друга, чтобы получить наибольшее влияние на правителя."
                            }
                        },
                        {
                            "text": "Nie lubił współpracowników, którzy zamiast pracować, woleli stale <w>intrygować</w> za plecami szefa.",
                            "target_lang_translations": {
                                "ru": "Он не любил коллег, которые вместо работы предпочитали постоянно <w>плести интриги</w> за спиной начальника."
                            }
                        }
                    ],
                    "synonyms": [
                        "mącić",
                        "waśnić"
                    ],
                    "common_phrases": [
                        "intrygować przeciwko komuś"
                    ],
                    "target_lang_definitions": {
                        "ru": "вести скрытые действия, плести заговоры или ссорить людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интриговать",
                                "target_lang_sense_clarification": "вести скрытые козни"
                            },
