                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69755c3c-df57-4d23-b7ba-c9d689d0a73a",
                                "sense_id": "5d6f5390-ea24-3655-b193-c63203b0906a",
                                "text": "„Er stieg aus, ging über die nackte Erde des Hofes, stieg die Stufen hinauf und klopfte an die Aluminiumtür.“"
                            },
                            {
                                "example_id": "d47ce622-fbdb-4ebb-b362-6003714e0d5e",
                                "sense_id": "5d6f5390-ea24-3655-b193-c63203b0906a",
                                "text": "„Die Aluminiumtür grollte wie Donner, als sie sich hinter ihm schloss.“"
                            },
                            {
                                "example_id": "497b3ab8-af24-4811-b1eb-4efced5df36b",
                                "sense_id": "5d6f5390-ea24-3655-b193-c63203b0906a",
                                "text": "„Mit einem Knall flog die Aluminiumtür nach innen, gefolgt von einem breiten, schwarzen Lederstiefel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
