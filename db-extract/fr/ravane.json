                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1925c20-84b6-435d-bfa3-482a6d75cd68",
                                "sense_id": "8650d5ca-a7bf-3ba1-bfcb-6847a647a418",
                                "text": "Des jeunes s’étaient réunis, ils avaient allumé un feu de bois flottés et de feuilles de palmiers, ils buvaient des bières, et quand le soleil a plongé dans la mer, ils ont commencé à jouer de la ravane."
                            },
                            {
                                "example_id": "c11604c5-6774-42fe-a463-b7aee8fef38c",
                                "sense_id": "8650d5ca-a7bf-3ba1-bfcb-6847a647a418",
                                "text": "La ravane, pièce maîtresse du séga est un tambour taillé dans du bois de goyage chinois. Il est recouvert d’une peau de chèvre tendue."
                            }
                        ]
                    }
