                        "cross_references": [
                            {
                                "target_word": "orangery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af816293-9fa9-3c46-a87f-fa81e6add470",
                                        "entry_id": "fd3ac140-55c8-3edb-8235-9e5caeb9f1b5",
                                        "glosses": [
                                            "A greenhouse in which orange trees are grown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "398b50b9-578f-324c-856e-9c110d7eeca8",
                                        "entry_id": "fd3ac140-55c8-3edb-8235-9e5caeb9f1b5",
                                        "glosses": [
                                            "A garden or plantation where orange trees are grown."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9886c21-de35-4651-90a8-04561a42c0cc",
                        "source_entry_id": "2623d327-a474-346b-b2ea-64b211d507be",
                        "source_sense_id": "7e314985-ffde-3847-9320-88442d35baa7",
                        "target_lang_word": "Orangerie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orangerie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7d550e75-0ef1-3887-a48c-7770296db2c0",
                                        "entry_id": "fca34c62-5109-3a60-9da0-4f1c61396e55",
                                        "glosses": [
                                            "ein Gewächshaus für exotische Pflanzen mit großen nach Süden ausgerichteten Fenstern in barocken Parkanlagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47de9cc0-20cc-46c6-8e72-2c78247c9f2a",
                                                "sense_id": "7d550e75-0ef1-3887-a48c-7770296db2c0",
                                                "text": "„Der Weg, auf dem Fürst Nikolai Andreïtsch zur Orangerie ging, war freigemacht worden; die Spuren des Besens waren noch auf dem zur Seite gefegten Schnee zu sehen, und in dem locker aufgeschütteten Schneewall zu beiden Seiten des Weges stak eine Schaufel.“"
                                            },
                                            {
                                                "example_id": "733b6e82-6ddb-4416-a91d-90a7e8fc9e41",
                                                "sense_id": "7d550e75-0ef1-3887-a48c-7770296db2c0",
                                                "text": "„Da Don Francesco hörte, wie ich ein kleines Zimmer lobte, das auf die Orangerie hinausging, sagte er mir, ich würde darin schlafen.“"
                                            },
                                            {
                                                "example_id": "54c57d81-9612-4c6d-aba7-542565ca378e",
                                                "sense_id": "7d550e75-0ef1-3887-a48c-7770296db2c0",
                                                "text": "„Zudem gab es eine Orangerie, das heißt einen alten Glasanbau, in dem keine Orangenbäume, dafür aber ein paar tropische Topfpflanzen und ein Gartentisch mit Rattansesseln standen und natürlich Jeans Tomatenpflanzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c641876-0db7-441d-8d34-6c52a4d70d0a",
                        "source_entry_id": "2623d327-a474-346b-b2ea-64b211d507be",
                        "source_sense_id": "7e314985-ffde-3847-9320-88442d35baa7",
                        "target_lang_word": "оранжерея",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оранжерея",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                        "entry_id": "93de66b9-e834-3b22-b740-caff68dca53a",
                                        "glosses": [
                                            "застеклённое сооружение с искусственным климатом, предназначенное для выращивания и содержания различных теплолюбивых растений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a18fa9-a15d-45a4-8ef1-90cf05d2b20d",
                                                "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                                "text": "Кроме цветов, пестревших по клумбам вдоль фасада, под окнами выставлены из оранжерей цветы и деревья стран более благосклонных. 〈…〉 Окола оранжерей вся дамская компания рассеялась вдоль шпалер, искать спелых персиков к обеду."
                                            },
                                            {
                                                "example_id": "ea071312-ccab-411f-ad1b-0b07debd5518",
                                                "sense_id": "45e24f14-5ad5-3991-833d-15ce8d263340",
                                                "text": "Чаще всего мы отправлялись в сад, где была уже упомянутая мною громадная оранжерея. В оранжерее росли персики, абрикосы и сливы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
