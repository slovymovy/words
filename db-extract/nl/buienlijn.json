                        "glosses": [
                            "een lijn van zware buien en/of onweersbuien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ef32c6-1cc0-4ed4-8cd2-37750dfd0e2f",
                                "sense_id": "3d0ea122-95c0-3a4f-87fb-5529d64f3a36",
                                "text": "Een buienlijn trekt van noord naar zuid over het land, aldus de weerdienst. Ook valt er in korte tijd veel regen, waarvan het verkeer last kan hebben."
                            },
                            {
                                "example_id": "90e97a9e-3862-42e2-b6a1-9019ba4dd066",
                                "sense_id": "3d0ea122-95c0-3a4f-87fb-5529d64f3a36",
                                "text": "Strooiwagens van Rijkswaterstaat zijn vrijdagavond al preventief de weg op gegaan. Daarbij werd met een hogere dosering zout gewerkt. Zaterdagochtend volgen de strooiwagens de buienlijn."
                            }
                        ]
                    }
