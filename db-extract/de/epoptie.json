                ],
                "senses": [
                    {
                        "sense_id": "cd6b4a4b-fbca-39d2-8bf2-ff94b58ef8a8",
                        "entry_id": "4245485b-58ad-3a34-a4c6-329d48024978",
                        "glosses": [
                            "alte Bezeichnung für die Metaphysik, die besonders den Mysteriencharakter der Schau des Guten und Schönen in der platonischen Tradition hervorhebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4cd682-0a37-49b8-b812-55c3cea184d4",
                                "sense_id": "cd6b4a4b-fbca-39d2-8bf2-ff94b58ef8a8",
                                "text": "„In der Antike wird die Metaphysik unter dem Namen „Epoptie“ geführt. Schmidinger schreibt: „Der Begriff „Epoptie“ stammt aus der Mysteriensprache und bezeichnet das Erfassen „vollkommener, einfacher, unbewegter und seliger Erscheinung“ […]“"
                            },
                            {
                                "example_id": "fec9f115-ab1d-43a5-98d2-40ea6c11e4e6",
                                "sense_id": "cd6b4a4b-fbca-39d2-8bf2-ff94b58ef8a8",
                                "text": "„Wir setzen bei dem an, was rein phänomenologisch ist, indem es sich gibt, und intendieren keine „Schau des inneren Menschen“ (Epoptie), um die Mystik die höchste Stufe der Philosophie sein zu lassen.“"
                            },
                            {
                                "example_id": "3248b6e3-ee3a-42d4-9c2a-17730479013a",
                                "sense_id": "cd6b4a4b-fbca-39d2-8bf2-ff94b58ef8a8",
                                "text": "„Neben die geographische Unterscheidung zwischen kleinen und großen Mysterien tritt die Differenzierung in die drei Weihestufen Myesis, Telete und Epoptie, […]“"
                            },
                            {
                                "example_id": "90bc77eb-ad25-4ab6-aacc-814d84472726",
                                "sense_id": "cd6b4a4b-fbca-39d2-8bf2-ff94b58ef8a8",
                                "text": "„Die Philosophie Platons stellt das ganze Leben in den Dienst von Reinigung, Askese, Belehrung und Epoptie und bringt in der als »sterben lernen« verstandenen Reinigung alles Lebendige zum Opfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
