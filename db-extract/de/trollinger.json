                ],
                "senses": [
                    {
                        "sense_id": "43beb8b8-ecb7-37ee-8b56-347df962df5f",
                        "entry_id": "2aa134f3-d4ca-3a78-9af2-969f8edad5a4",
                        "glosses": [
                            "eine Rebsorte, die vor allem im Weinbaugebiet Württemberg, aber auch in Südtirol und im Trentino (hier unter den Namen Großvernatsch oder Schiava grosso) angebaut wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d67dc1c0-4a50-414e-81d1-8b0d4215feba",
                                "sense_id": "43beb8b8-ecb7-37ee-8b56-347df962df5f",
                                "text": "„Der Trollinger ist ein frischer, süffiger und bodenständiger Rotwein. […] Aus dem Trollinger werden auch leichte Roséweine erzeugt, gehaltvoller ist der in Württemberg verbreitete Verschnitt mit dem kräftigeren Lemberger.“"
                            },
                            {
                                "example_id": "f363201a-1af0-406c-bd69-cfa92b49467a",
                                "sense_id": "43beb8b8-ecb7-37ee-8b56-347df962df5f",
                                "text": "Der Trollinger gilt als Gaumenschmeichler und Brotgeber."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "345b837f-bf98-3516-8f33-0c2fa17571cd",
                        "entry_id": "2aa134f3-d4ca-3a78-9af2-969f8edad5a4",
                        "glosses": [
                            "ein Wein erzeugt aus den unter [1] genannten Reben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecac59f2-7cc3-4325-ae46-116969a442ec",
                                "sense_id": "345b837f-bf98-3516-8f33-0c2fa17571cd",
                                "text": "Der Trollinger ist der Inbegriff des schwäbischen Vierteles-Weins – und damit Ausdruck einer bodenständigen Weinkultur im Württembergischen."
                            },
                            {
                                "example_id": "0cfac253-2b0f-405f-9efc-d21907a4d812",
                                "sense_id": "345b837f-bf98-3516-8f33-0c2fa17571cd",
                                "text": "Viele Trollinger sind roter Wein, einige wenige auch echter Rotwein."
                            },
                            {
                                "example_id": "2287adfd-af3f-4d9e-8393-29b2bbdb59a7",
                                "sense_id": "345b837f-bf98-3516-8f33-0c2fa17571cd",
                                "text": "Der Trollinger gilt als Gaumenschmeichler und Brotgeber."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
