                ],
                "senses": [
                    {
                        "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                        "entry_id": "60317013-077c-3262-b570-15a00cc970d6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d167a29-777c-43b9-bce9-a4326f907204",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Frau Blümle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "22a3ec3e-e7d8-40f1-9716-051f9b4c2984",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Herr Blümle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "aa935697-6bbf-45f4-97fd-47c1a17d574b",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Die Blümles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "20482eac-7c55-4cc3-8c27-36b4ca735199",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Der Blümle trägt nie die Schals, die die Blümle ihm strickt."
                            },
                            {
                                "example_id": "851ce941-7d3c-43b7-bcb2-8a4a53488b68",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Blümle kommt, geht der Herr Blümle.“"
                            },
                            {
                                "example_id": "86028554-c208-4ddf-9028-202d0569ac34",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Blümle kommt und geht."
                            },
                            {
                                "example_id": "4f4df158-fb5b-409d-9c92-c193b1544dc5",
                                "sense_id": "bff260c5-8b52-3fec-b519-3235e39fd772",
                                "text": "Blümles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
