                        "sense_id": "70affde7-c60f-38d9-967f-664bbe96a370",
                        "entry_id": "247b3f54-e2c0-3cbf-9525-cb310c662ceb",
                        "glosses": [
                            "powolny, flegmatyczny, mało energiczny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75265a5e-9363-4d96-91b6-6b7699dc7ed9",
                                "sense_id": "70affde7-c60f-38d9-967f-664bbe96a370",
                                "text": "Działania armii szwedzkiej na Pomorzu były jednak tak nieudolne i ślamazarne, że nie stanowiły większego zagrożenia dla wojsk pruskich"
                            }
                        ],
