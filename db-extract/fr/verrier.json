            {
                "entry_id": "e690913b-f1e8-3b76-8f81-a549bfa655ec",
                "word": "Verrier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75eadbe7-2fb0-3fe8-b987-e5e4e4d8d8eb",
                        "entry_id": "e690913b-f1e8-3b76-8f81-a549bfa655ec",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220db33c-9ab1-49a1-9e93-218bef24e3fa",
                                "sense_id": "75eadbe7-2fb0-3fe8-b987-e5e4e4d8d8eb",
                                "text": "Aujourd’hui directrice générale d’un club de foot au Canada, autrice de Ne jamais rien lâcher (éd. First), maman d’un petit garçon qu’elle élève avec son épouse, la championne de basket handisport Ingrid Moatti, elle est le sujet central de Marinette, réalisé par Virginie Verrier, avec Garance Marillier pour l’incarner."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "05213ec5-5da3-3dd2-9ec2-008d947d25e5",
                "word": "verrier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6274f6e4-fe09-43e2-a9b9-d263297bccfc",
