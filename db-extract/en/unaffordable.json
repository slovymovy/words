                                    {
                                        "sense_id": "ce9d5ca6-3d0d-3efe-bd44-79e50d5ac9e5",
                                        "entry_id": "05f1c793-6acd-3854-8304-d64cfef410ac",
                                        "glosses": [
                                            "so teuer, dass alles vorhandene Geld dafür nicht genügt; extrem teuer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e4d89a4-cdca-4c13-9e7e-a70aaff2811e",
                                                "sense_id": "ce9d5ca6-3d0d-3efe-bd44-79e50d5ac9e5",
                                                "text": "Wieder sehen zu können ist nicht unbezahlbar, schreibt die Christoffel-Blindenmission."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cf394b8-a8e8-34b1-8554-96aa6b76b07d",
                                        "entry_id": "05f1c793-6acd-3854-8304-d64cfef410ac",
                                        "glosses": [
                                            "überaus wertvoll und für noch so viel Geld nicht erhältlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98c2bde-7de2-4a39-9a90-4b0bf8979bcc",
                                                "sense_id": "1cf394b8-a8e8-34b1-8554-96aa6b76b07d",
                                                "text": "Ein Menschenleben ist unbezahlbar, und doch werden nicht alle technisch möglichen Sicherheitsmaßnahmen zur Vermeidung tödlicher Unfälle verwirklicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693ff52f-33e6-4880-bea8-ea10791dc5db",
                        "source_entry_id": "b440a43d-cd56-322c-9873-d6dfa868df66",
                        "source_sense_id": "e9f50def-5771-3333-8315-c33dba14e817",
                        "source_sense_description": "too expensive to be afforded",
                        "target_lang_word": "unerschwinglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unerschwinglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                        "entry_id": "26d0d70f-0b34-348f-ab61-5ae071493e88",
                                        "glosses": [
                                            "so teuer, dass es sich jemand nicht leisten kann; zu teuer; nicht zu bezahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6c75a0-0df2-457b-86fa-25a7f6bdd175",
                                                "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                                "text": "Die Mieten sind im Prenzlauer Berg so gestiegen, die sind für den Normalverdiener inzwischen unerschwinglich."
                                            },
                                            {
                                                "example_id": "7a11a22c-26a0-4bf9-a1d1-ce1bdd4e88d4",
                                                "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                                "text": "„Ich verdiene nicht viel, ein Urlaub ist für uns seit Jahren unerschwinglich.“"
                                            },
                                            {
                                                "example_id": "02e6a97e-1e1b-4afa-8fdd-017bd0374e5d",
                                                "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                                "text": "Vor allem in Schwellenländern sind Medikamente für HIV-Infizierte nach einer Studie der Hilfsorganisation Ärzte ohne Grenzen (MSF) weiterhin unerschwinglich."
                                            },
                                            {
                                                "example_id": "e376bfb9-32d4-4e3b-803d-023d4acc3fcb",
                                                "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                                "text": "Für einen einzelnen Landwirt kann die Anschaffung eines Mähdreschers unerschwinglich sein, tun sich aber mehrere benachbarte Höfe zusammen, ist das Großgerät bezahlbar."
                                            },
                                            {
                                                "example_id": "f3577d6f-7610-4ae8-b2f3-2013774e433f",
                                                "sense_id": "45a4d186-f326-39b1-9308-bfe3a64c088e",
                                                "text": "Doch gerade der Kurssturz der [ukrainischen Währung] Hrywna zu Beginn der vergangenen Woche hat viele Menschen zusätzlich verunsichert. Vor allem Importwaren werden für viele noch unerschwinglicher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
