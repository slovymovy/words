                "senses": [
                    {
                        "sense_id": "dbbdc91a-bb48-3664-bb9f-cb6e6467c11a",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "A spin in which the head and shoulders are dropped backwards and the back arched downwards toward the ice; also called a layback spin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb3164e-345b-4c1f-8462-2d2d6caca083",
                                "sense_id": "dbbdc91a-bb48-3664-bb9f-cb6e6467c11a",
                                "text": "Mirai Nagasu, like Zhang a promising 14-year-old, showed equally astonishing flexibility on a layback spin Wednesday, leaning so far that the back of her head nearly touched her backside."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c442adf-3bcc-356f-a802-226003812946",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "A maneuver to scale a vertical crack, by pulling with the arms and jamming the legs underneath, and shuffling up one limb at a time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf6e8b3-bb7d-4c48-9f21-b4145d15df2b",
                                "sense_id": "4c442adf-3bcc-356f-a802-226003812946",
                                "text": "A layback, on the other hand, forces you to pull with your arms. A layback can protrude so far from the main rock face, that your legs will be dangling uselessly in the air, while your arms support all of your body weight. The tricky thing about the layback is that not only do you need the upper-body strength to hold yourself up and climb hand over hand, but you also need the flexibility and balance to clear the edge of the overhang."
                            }
                        ]
                    },
                    {
                        "sense_id": "21de757e-50d0-3c2c-ac74-3e271918d85c",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "A surf maneuver where the upright surfer leans back against the wave."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e2f084f2-29e3-3806-a773-66c173c77508",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "A trick where the boarder leans back while on the lip of the ramp, or down a rail."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "52338eda-11ed-3d18-8daf-ce63cc29cbe9",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "The process of recording the final sound onto the master track."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3dddcddc-7587-316f-8477-f0713190babc",
                        "entry_id": "763c40fb-12cb-35d3-a565-72f8cc5f7051",
                        "glosses": [
                            "A short backwards pass to a teammate in an attacking position."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f34e9b-7868-436f-a51c-a2cc9aafe8fb",
                                "sense_id": "3dddcddc-7587-316f-8477-f0713190babc",
                                "text": "Only a fine interception from Mickael Silvestre denied the marauding Czech international an early chance from Tomasz Radzinski's layback and, as United struggled to find any momentum, their hosts threatened to overwhelm them."
                            }
                        ]
                    },
                    {
