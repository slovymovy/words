                        "source_sense_id": "968c6bef-e0cb-3150-b978-13b221965113",
                        "target_lang_word": "loss",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d32694-da07-327e-97f9-f98cc24b06d1",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The result of no longer possessing an object, a function, or a characteristic due to external causes or misplacement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a95c9a9-56fd-4119-9ed6-5024118a2acb",
                                                "sense_id": "16d32694-da07-327e-97f9-f98cc24b06d1",
                                                "text": "loss of limb; weight loss; loss of cognitive functions; loss of appetite."
                                            },
                                            {
                                                "example_id": "7cafff2d-1736-4366-8c78-9aeee6da0c9e",
                                                "sense_id": "16d32694-da07-327e-97f9-f98cc24b06d1",
                                                "text": "In other areas, glacier loss creates serious risk of a dry period across the Third Pole, Wang said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd628e6f-78eb-33e6-9a06-1837328426d2",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The destruction or ruin of an object."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "091f1b63-ae98-304e-a994-043eb144d399",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "Something that has been destroyed or ruined."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3e00995-102e-412c-802d-221d4b178f8b",
                                                "sense_id": "091f1b63-ae98-304e-a994-043eb144d399",
                                                "text": "It was a terrible crash; both cars were total losses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ea8635-72e8-328e-a096-d891e3992054",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "Defeat; an instance of being defeated."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0307c9b-caac-45de-8dff-617d08b7f883",
                                                "sense_id": "e2ea8635-72e8-328e-a096-d891e3992054",
                                                "text": "The match ended in their first loss of the season."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The death of a person or animal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10023171-7a90-4880-9486-dfcd9d0318aa",
                                                "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                                "text": "We mourn his loss."
                                            },
                                            {
                                                "example_id": "d8f77a94-fa16-4222-a736-b6860e192fb1",
                                                "sense_id": "076f70a8-b0e5-3b5f-9ad6-2561d3b426ce",
                                                "text": "The battle was won, but losses were great."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "351b781c-ca22-38b0-b482-d66f64937f9e",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The condition of grief caused by losing someone or something, especially someone who has died."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb3e35a8-06cc-48ee-a567-81157c5308fd",
                                                "sense_id": "351b781c-ca22-38b0-b482-d66f64937f9e",
                                                "text": "Her daughter's sense of loss eventually led to depression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1dedf55-63f9-305f-ad4b-41f036c9b7ff",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "The sum an entity loses on balance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "012a5a65-43ac-488e-83e6-30c4b34afa0e",
                                                "sense_id": "e1dedf55-63f9-305f-ad4b-41f036c9b7ff",
                                                "text": "The sum of expenditures and taxes minus total income is a loss, when this difference is positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1697cb35-f52f-3bab-952b-f2a347e30584",
                                        "entry_id": "107ca82a-acf8-3056-89a9-363772734a00",
                                        "glosses": [
                                            "Electricity of kinetic power expended without doing useful work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4152687-c64e-4c6d-bbcf-0ab70bd0b6b3",
                                                "sense_id": "1697cb35-f52f-3bab-952b-f2a347e30584",
                                                "text": "The inefficiency of many old-fashioned power plants exceeds 60% loss before the subsequent losses during transport over the grid."
                                            }
                                        ]
                                    }
                                ]
