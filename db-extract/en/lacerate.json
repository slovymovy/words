                    {
                        "translation_id": "996f0ff0-c3b3-42d4-8f39-c340e2b032d7",
                        "source_entry_id": "63dc67f9-c928-3e4f-a06f-31e4af26f923",
                        "source_sense_description": "To tear, rip or wound",
                        "target_lang_word": "ра́нить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ра́нить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ecb94a78-783d-3a6a-ab24-e05a8e183818",
                                        "entry_id": "3968cc3b-859c-3ef4-ae49-680a21880eaf",
                                        "glosses": [
                                            "наносить (нанести) рану (раны)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0639874c-714e-4095-adbb-6c9ff40a97fc",
                                                "sense_id": "ecb94a78-783d-3a6a-ab24-e05a8e183818",
                                                "text": "Кто-то стрелял в лосёнка и ранил его."
                                            },
                                            {
                                                "example_id": "654f3e90-16e6-4b3c-822b-6bc750028e2e",
                                                "sense_id": "ecb94a78-783d-3a6a-ab24-e05a8e183818",
                                                "text": "Единственное, что было очевидно: Милорадовича ранила пуля из офицерского пистолета, а не из солдатского ружья."
                                            },
                                            {
                                                "example_id": "f77379a9-5663-4bb1-9ede-24e578199065",
                                                "sense_id": "ecb94a78-783d-3a6a-ab24-e05a8e183818",
                                                "text": "Осколки ранят лошадь, солдата и лекаря Мигунова, что подле саней делал перевязку раненым."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6833b025-d86c-3936-8c3e-de41d294f88d",
                                        "entry_id": "3968cc3b-859c-3ef4-ae49-680a21880eaf",
                                        "glosses": [
                                            "перен. причинять (причинить) кому-либо душевную боль, страдание"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556dc285-cde4-4032-b5c6-6c7ce10c674d",
                                                "sense_id": "6833b025-d86c-3936-8c3e-de41d294f88d",
                                                "text": "Я знаю, что моя работа противоречит многим солидным трудам и, может быть, даже ранит чьё-то самолюбие."
                                            },
                                            {
                                                "example_id": "44cd3283-928c-4930-95b7-11258f64371a",
                                                "sense_id": "6833b025-d86c-3936-8c3e-de41d294f88d",
                                                "text": "Слова этой песни поразили и больно ранили меня."
                                            },
                                            {
                                                "example_id": "9bbd1213-3aa6-49b5-947b-526ba26ada58",
                                                "sense_id": "6833b025-d86c-3936-8c3e-de41d294f88d",
                                                "text": "И гибель наша окажется такой сокрушительной, что память о ней будет ранить сердца многих поколений несчастных немцев…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
