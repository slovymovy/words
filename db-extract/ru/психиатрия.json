                    },
                    {
                        "translation_id": "3e92fead-5a6f-4c52-ba63-3a66859f87d6",
                        "source_entry_id": "894c53cf-c69d-3898-bc63-82b5372d1c68",
                        "target_lang_word": "Psychiatrie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Psychiatrie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b49be55f-5037-3d20-aaa4-69412074d206",
                                        "entry_id": "bf380f2d-96a9-3f10-b666-324ae1c3f218",
                                        "glosses": [
                                            "Wissenschaft (Fachgebiet der Medizin), die sich mit der Erkennung und Behandlung psychischer Erkrankungen beschäftigt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56508d7c-9632-4c9f-9a77-4f775699a9bf",
                                                "sense_id": "b49be55f-5037-3d20-aaa4-69412074d206",
                                                "text": "In meinem Medizinstudium mache ich jetzt den Psychiatrie Kurs."
                                            },
                                            {
                                                "example_id": "989ffa29-cb7c-4444-bd78-a6a4cbc8ffca",
                                                "sense_id": "b49be55f-5037-3d20-aaa4-69412074d206",
                                                "text": "„In der Frühzeit der modernen Psychiatrie wurde Forschung fast ausschließlich in Anstalten betrieben und befasste sich vor allem mit der Klassifizierung von Patienten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef64767e-e028-3b85-8d7e-460520414eb4",
                                        "entry_id": "bf380f2d-96a9-3f10-b666-324ae1c3f218",
                                        "glosses": [
                                            "psychiatrische Anstalt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5abdb19b-7e67-4002-a5a3-15767942a7d1",
                                                "sense_id": "ef64767e-e028-3b85-8d7e-460520414eb4",
                                                "text": "„Diese Übung hatte schon mein Vater mit mir gemacht, wenn ich ihn als Kind in seinem Untersuchungszimmer auf dem Gelände der Psychiatrie besuchte.“"
                                            },
                                            {
                                                "example_id": "f5c99e4a-f927-417b-af93-cf07795d29d3",
                                                "sense_id": "ef64767e-e028-3b85-8d7e-460520414eb4",
                                                "text": "„Kraepelin inaugurierte zudem mehrere spezielle Arbeitsgebiete der Psychiatrie.“"
                                            },
                                            {
                                                "example_id": "0d05b4a4-01a7-40bb-8390-7e547f18eaa7",
                                                "sense_id": "ef64767e-e028-3b85-8d7e-460520414eb4",
                                                "text": "Nach langem Zögern ließen wir unsere Mutter in die Psychiatrie einweisen."
                                            },
                                            {
                                                "example_id": "192b37c3-5d30-4968-905b-08760989c22c",
                                                "sense_id": "ef64767e-e028-3b85-8d7e-460520414eb4",
                                                "text": "„Für eine Unterbringung in der Psychiatrie sah der Gutachter durchaus Voraussetzungen gegeben – sie erschien ihm aber nicht zwingend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
