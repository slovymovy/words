                                    {
                                        "sense_id": "17204878-7d7c-3342-bf5f-3ed35218d7e1",
                                        "entry_id": "8bd5faaa-4ca4-319b-b963-6047b1b8b610",
                                        "glosses": [
                                            "Parti des travailleurs du Kurdistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43ccaf80-1a93-437f-a2b4-ea120bbd7d72",
                                                "sense_id": "17204878-7d7c-3342-bf5f-3ed35218d7e1",
                                                "text": "Pendant plusieurs années, il joue le rôle d’intermédiaire du président dans les tractations secrètes avec la guérilla kurde du Parti des travailleurs du Kurdistan (PKK)."
                                            },
                                            {
                                                "example_id": "2f09435f-ee83-4c77-81aa-614e85dc9727",
                                                "sense_id": "17204878-7d7c-3342-bf5f-3ed35218d7e1",
                                                "text": "Le PKK a revendiqué un attentat contre le siège de la police à Ankara, en Turquie, qui a fait deux blessés dimanche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
