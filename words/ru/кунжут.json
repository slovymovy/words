                {
                    "sense_id": "6e468bae-97fb-305a-a91a-7cbb429014c3",
                    "sense_definition": "Семена травянистого южного растения, используемые в кулинарии и для производства масла.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "растение и семена",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед выпечкой булочки для бургеров обычно посыпают белым <w>кунжутом</w>.",
                            "target_lang_translations": {
                                "en": "Before baking, burger buns are usually sprinkled with white <w>sesame seeds</w>."
                            }
                        },
                        {
                            "text": "Она добавила в овощной салат немного жареного <w>кунжута</w> для приятного орехового вкуса.",
                            "target_lang_translations": {
                                "en": "She added some toasted <w>sesame seeds</w> to the vegetable salad for a pleasant nutty flavor."
                            }
                        }
                    ],
                    "synonyms": [
                        "сезам",
                        "тахин"
                    ],
                    "common_phrases": [
                        "семена кунжута",
                        "жареный кунжут",
                        "посыпать кунжутом",
                        "масло из кунжута"
                    ],
                    "target_lang_definitions": {
                        "en": "Seeds of a southern herbaceous plant, used in cooking and for oil production."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sesame",
                                "target_lang_sense_clarification": "seeds"
                            },
                            {
                                "target_lang_word": "sesame seeds",
                                "target_lang_sense_clarification": "seeds used in food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08a503dd-bba0-3adc-b9be-51e5c7bac8ac",
                    "sense_definition": "Травянистое южное растение семейства кунжутных, из семян которого получают масло.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "растение и семена",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В странах Азии <w>кунжут</w> выращивают на больших полях уже тысячи лет.",
                            "target_lang_translations": {
                                "en": "In Asian countries, <w>sesame</w> has been grown in large fields for thousands of years."
                            }
                        },
                        {
                            "text": "Теплолюбивый <w>кунжут</w> хорошо растёт только в условиях жаркого тропического климата.",
                            "target_lang_translations": {
                                "en": "Heat-loving <w>sesame</w> grows well only in a hot tropical climate."
                            }
                        }
                    ],
                    "synonyms": [
                        "сезам"
                    ],
                    "target_lang_definitions": {
                        "en": "An herbaceous southern plant of the Pedaliaceae family, yielding oil-producing seeds."
