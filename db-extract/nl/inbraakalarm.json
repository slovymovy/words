                "senses": [
                    {
                        "sense_id": "12fb7cba-a816-34b9-9f64-432bfc33960e",
                        "entry_id": "6595076d-ff98-329d-80cf-8a468632b6ba",
                        "glosses": [
                            "alarminstallatie die een alarm afgeeft als er ingebroken wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0c89f1-631a-4eae-9edd-b2028e4112da",
                                "sense_id": "12fb7cba-a816-34b9-9f64-432bfc33960e",
                                "text": "Het is nog niet bekend hoe de dieven de Kunsthal zijn binnengekomen. Bij de politie zou een melding zijn binnengekomen van het beveiligingsbedrijf dat het inbraakalarm was afgegaan."
                            },
                            {
                                "example_id": "ee10a3e3-c868-4498-9ff1-df220c97e272",
                                "sense_id": "12fb7cba-a816-34b9-9f64-432bfc33960e",
                                "text": "Het explosief werd vannacht bij de bank gevonden, nadat het inbraakalarm rond 02.30 uur was afgegaan. Volgens ooggetuigen ging het alarm af toen inbrekers de pinautomaat van de bank wilden opblazen. Bij die explosie werd de bank zwaar beschadigd. De gevel is ontzet en de pinautomaat hangt uit de muur."
                            }
                        ]
                    },
                    {
                        "sense_id": "6405983f-b02b-3fe3-96f5-4c6e233dd70a",
                        "entry_id": "6595076d-ff98-329d-80cf-8a468632b6ba",
                        "glosses": [
                            "de keer dat de bij [1] genoemde alarminstallatie een signaal afgeeft bij een inbraak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07757155-2f28-4012-bc94-711ae8335350",
                                "sense_id": "6405983f-b02b-3fe3-96f5-4c6e233dd70a",
                                "text": "De man verstopte bovendien bier en sterke drank in zijn jas. In plaats van er met zijn buit vandoor te gaan, viel hij achter de bar in slaap. Agenten die afkwamen op het inbraakalarm hebben de man aangehouden."
                            },
                            {
                                "example_id": "7e51deaf-8267-4f15-ab62-fa63551e3377",
                                "sense_id": "6405983f-b02b-3fe3-96f5-4c6e233dd70a",
                                "text": "De dieven in de Kunsthal in Rotterdam konden vorige week snel toeslaan doordat de deuren na het inbraakalarm automatisch werden ontgrendeld. Dat was conform de brandveiligheidseisen van de Kunsthal."
                            }
                        ]
                    }
