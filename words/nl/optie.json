                {
                    "sense_id": "45a27c37-d8d7-3053-b03e-e0dc1a98980f",
                    "sense_definition": "Een zakelijk recht om iets te kopen of te verkopen tegen een vastgestelde prijs binnen een bepaalde tijd.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf heeft een <w>optie</w> genomen op het braakliggende terrein.",
                            "target_lang_translations": {
                                "ru": "Компания оформила <w>опцион</w> на этот пустырь.",
                                "en": "The company took an <w>option</w> on the vacant lot.",
                                "zh": "该公司已对这块空地取得了<w>优先购买权</w>。",
                                "it": "L'azienda ha preso un'<w>opzione</w> sul terreno incolto."
                            }
                        },
                        {
                            "text": "Hij handelt in <w>opties</w> en aandelen op de beurs.",
                            "target_lang_translations": {
                                "ru": "Он торгует <w>опционами</w> и акциями на бирже.",
                                "en": "He trades <w>options</w> and stocks on the stock exchange.",
                                "zh": "他在证券交易所从事<w>期权</w>和股票交易。",
                                "it": "Fa trading di <w>opzioni</w> e azioni in borsa."
                            }
                        }
                    ],
                    "synonyms": [
                        "kooprecht"
                    ],
                    "common_phrases": [
                        "een optie nemen",
                        "een optie lichten",
                        "opties uitoefenen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Коммерческое право купить или продать что-либо по фиксированной цене в течение определенного времени.",
                        "en": "A commercial right to buy or sell something at a fixed price within a certain time.",
                        "zh": "在规定时间内以固定价格买卖某物的商业权利。",
                        "it": "Diritto contrattuale di acquistare o vendere qualcosa a un prezzo prestabilito entro un determinato periodo."
                    },
