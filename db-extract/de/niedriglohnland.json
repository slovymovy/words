                "senses": [
                    {
                        "sense_id": "e5b61d52-7876-3b56-a757-e50a75687d9a",
                        "entry_id": "a2027594-fce9-3e52-8efb-2faf430cb41c",
                        "glosses": [
                            "Land, in dem großteils nur geringe Löhne gezahlt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d0dce77-d3b0-499c-b8b8-db5e2fda70d3",
                                "sense_id": "e5b61d52-7876-3b56-a757-e50a75687d9a",
                                "text": "Viele Unternehmen haben personalintensive Geschäftsbereiche in Niedriglohnländer ausgelagert."
                            },
                            {
                                "example_id": "14eb1e20-d74c-48b5-bd8f-13b58729bf2a",
                                "sense_id": "e5b61d52-7876-3b56-a757-e50a75687d9a",
                                "text": "„Auch Fords Rivalen General Motors hat Trump Strafzölle angedroht, sollten weiter Autos aus dem benachbarten Niedriglohnland eingeführt werden.“"
                            },
                            {
                                "example_id": "ea5cd23e-8d49-4403-91cf-bd08c67edddb",
                                "sense_id": "e5b61d52-7876-3b56-a757-e50a75687d9a",
                                "text": "„Die Löhne im Land mit der niedrigen Produktivität müssen niedriger sein als im Hochproduktivland, sodass es in jenen Sektoren, in denen es relativ produktiver ist, das Niedriglohnland billiger produzieren kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
