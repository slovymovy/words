                    },
                    {
                        "translation_id": "238d3883-d7bc-4c02-8c04-2dc73a44eb82",
                        "source_entry_id": "e9772db7-0ebb-36a5-9c6c-0630fdfecc17",
                        "source_sense_id": "bbc8986a-a0bb-3f09-9618-74d7f2d98768",
                        "source_sense_description": "Welsh dolmen or underground tomb",
                        "target_lang_word": "cromlech",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cromlech",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c1c8eb8-fcad-39ac-aca5-07c01694075c",
                                        "entry_id": "4d28e845-a745-354a-ae80-7cbfa5d1f63b",
                                        "glosses": [
                                            "Monument des âges préhistoriques formé d’une suite de menhirs disposés en cercle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d135c01c-e6df-47c7-a47b-efea4d613038",
                                                "sense_id": "2c1c8eb8-fcad-39ac-aca5-07c01694075c",
                                                "text": "Le dolmen et le cromlech celtes, le tumulus étrusque, le galgal hébreu"
                                            },
                                            {
                                                "example_id": "74e3c46c-ec1a-4b54-a020-892b93cfce48",
                                                "sense_id": "2c1c8eb8-fcad-39ac-aca5-07c01694075c",
                                                "text": "Tout auprès est un cromlech composé de blocs de pierres de dimensions beaucoup moindres et disposés circulairement."
                                            },
                                            {
                                                "example_id": "bf96fbed-4753-47bf-b737-64abedca47e1",
                                                "sense_id": "2c1c8eb8-fcad-39ac-aca5-07c01694075c",
                                                "text": "Ces blocs posés comme des champignons gigantesques sur leur étroite base, ce sont les menhirs, les dolmens, les cromlechs des anciens Gaulois, vestiges de temples cyclopéens d’où le culte de la force semblait bannir par principe le culte du beau."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
