        "pl-extract.jsonl": [
            {
                "entry_id": "ae56e2de-6b0d-39f4-bc10-31d589e68aa6",
                "word": "zawodny",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "abcb7126-0bbc-3ce2-855d-fc5f98f9751c",
                        "entry_id": "ae56e2de-6b0d-39f4-bc10-31d589e68aa6",
                        "glosses": [
                            "o człowieku taki, za którego nie jest się pewnym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867c6cfa-73b7-49bf-a9ac-094b036b0709",
                                "sense_id": "abcb7126-0bbc-3ce2-855d-fc5f98f9751c",
                                "text": "I człowiek może okazać się zawodnym w określonych okolicznościach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "db971bb5-e5ad-3e35-a9b7-0c7982a39ad6",
                        "entry_id": "ae56e2de-6b0d-39f4-bc10-31d589e68aa6",
                        "glosses": [
                            "o rzeczy, mechanizmie taki, który może nie zadziałać, mieć awarię"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90817663-4667-4bdc-bb14-cfd3a0f843f2",
                                "sense_id": "db971bb5-e5ad-3e35-a9b7-0c7982a39ad6",
                                "text": "Sprowadzone z Niemiec aparaty były zawodne."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "bf602a8c-2b52-3b87-8c98-5eefca83b557",
                        "entry_id": "ae56e2de-6b0d-39f4-bc10-31d589e68aa6",
                        "glosses": [
                            "o marzeniach, planach taki, który może się nie ziścić"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2120f948-78a7-42f4-bad2-effff70232ad",
                                "sense_id": "bf602a8c-2b52-3b87-8c98-5eefca83b557",
                                "text": "Nieśmiałe są myśli śmiertelników / i przewidywania nasze zawodne, / bo śmiertelne ciało przygniata duszę / i ziemski przybytek obciąża lotny umysł"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9940bc8a-65c2-445a-9505-9515bf082242",
                        "source_entry_id": "ae56e2de-6b0d-39f4-bc10-31d589e68aa6",
                        "source_sense_id": "abcb7126-0bbc-3ce2-855d-fc5f98f9751c",
                        "target_lang_word": "unreliable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unreliable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d07c08d-8ebf-3023-a9bc-2d68039e1f9d",
                                        "entry_id": "d236f514-8b68-3e51-8ce5-fe4387260a41",
                                        "glosses": [
                                            "Not reliable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58dd6cc0-8a04-41e6-b780-08a26ac626d6",
                                                "sense_id": "2d07c08d-8ebf-3023-a9bc-2d68039e1f9d",
                                                "text": "Tell one another whether any one of you has ever heard me discuss such questions briefly or at length; and then you will realize that the other popular reports about me are equally unreliable."
                                            },
                                            {
                                                "example_id": "2311918e-c9c2-4936-9a8e-61bc3bfb763f",
                                                "sense_id": "2d07c08d-8ebf-3023-a9bc-2d68039e1f9d",
                                                "text": "The opposite issue emerges in the summer when students face scorching temperatures with unreliable or nonexistent air conditioning."
                                            },
                                            {
                                                "example_id": "afbc7055-0df0-422f-825a-567cc0fda6c9",
                                                "sense_id": "2d07c08d-8ebf-3023-a9bc-2d68039e1f9d",
                                                "text": "\"Operating the WCML at this intensity makes it challenging to maintain acceptable performance levels, resulting in a frustratingly unreliable service for passengers. Minor disruption can escalate into significant delays because a train running only a few minutes late can miss its slot across a junction, resulting in a snowballing effect across the network.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unreliable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6df3c83d-b5e5-35c2-9630-c8b8c9ea716a",
                                        "entry_id": "1afd48ce-097c-3de8-a26b-113c87365371",
                                        "glosses": [
                                            "One who or that which cannot be relied upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198e72cb-9892-4e0a-b75f-66183269e86c",
                                                "sense_id": "6df3c83d-b5e5-35c2-9630-c8b8c9ea716a",
                                                "text": "His employment by the leading papers in Chicago was intermittent, as he was classed among the unreliables. One could never tell when he was going to get drunk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
