                    {
                        "translation_id": "5ce76385-ce43-4d63-a3e5-733d9c07ab2d",
                        "source_entry_id": "8fb588e3-c13e-3ad9-8cae-d350942dd440",
                        "source_sense_id": "a93dd1e4-ba8f-3e8b-8917-b2d1d954197f",
                        "source_sense_description": "Zoologie: Vogel aus der Gattung der Ohreulen",
                        "target_lang_word": "velduil",
                        "target_lang_code": "nl",
