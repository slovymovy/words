                {
                    "sense_id": "678f1479-00f7-35fb-b357-4563c46aec7e",
                    "sense_definition": "Закончиться, полностью израсходоваться (о времени, запасах)",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ваше время <вышло>, пожалуйста, сдавайте работы.",
                            "target_lang_translations": {
                                "en": "Your time is <up>, please hand in your papers.",
                                "de": "Ihre Zeit ist <abgelaufen>, bitte geben Sie Ihre Arbeiten ab.",
                                "zh": "你们的时间<到期>了，请交卷。"
                            }
                        },
                        {
                            "text": "У нас <вышел> весь сахар, нужно сходить в магазин.",
                            "target_lang_translations": {
                                "en": "We have <run out> of sugar, we need to go to the store.",
                                "de": "Uns ist der ganze Zucker <ausgegangen>, wir müssen zum Laden gehen.",
                                "zh": "我们的糖<用完>了，得去趟商店。"
                            }
                        }
                    ],
                    "synonyms": [
                        "кончиться",
                        "истечь"
                    ],
                    "common_phrases": [
                        "время вышло",
                        "срок вышел"
                    ],
                    "target_lang_definitions": {
                        "en": "To end, to be completely used up (of time, supplies)",
                        "de": "Zu Ende gehen oder vollständig aufgebraucht sein (von Zeit oder Vorräten)",
                        "zh": "结束，完全用尽（指时间或供应）"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run out",
                                "target_lang_sense_clarification": "to be used up completely"
                            },
                            {
                                "target_lang_word": "expire",
                                "target_lang_sense_clarification": "of time limits or validity"
                            },
                            {
                                "target_lang_word": "be up",
                                "target_lang_sense_clarification": "of time periods"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ablaufen",
                                "target_lang_sense_clarification": "von Fristen oder Zeiträumen"
                            },
                            {
                                "target_lang_word": "ausgehen",
                                "target_lang_sense_clarification": "wenn Vorräte zur Neige gehen"
                            },
                            {
                                "target_lang_word": "vorbei sein",
                                "target_lang_sense_clarification": "wenn die Zeit um ist"
                            }
                        ],
                        "zh": [
