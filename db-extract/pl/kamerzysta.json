                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95c38ab-cd77-4e47-acb6-2ec604198f0c",
                                "sense_id": "b9e13a29-9f99-33cc-8aad-5fbcb4d402ec",
                                "text": "Redaktor Słomczyński ustawił się na tle sejmowego okrąglaka i gestem dał znać kamerzyście, że może filmować"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
