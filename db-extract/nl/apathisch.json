                                "target_senses": [
                                    {
                                        "sense_id": "6c031947-6811-3cad-957b-67af8bec1a70",
                                        "entry_id": "37d4f0bd-30ed-32eb-a7cc-a9ef0c9fa317",
                                        "glosses": [
                                            "Qui souffre d’apathie, impassible, insensible."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f7eee48-90bd-3a89-abd5-e11b0daabae5",
                                        "entry_id": "37d4f0bd-30ed-32eb-a7cc-a9ef0c9fa317",
                                        "glosses": [
                                            "Qualifie quelqu'un de fatigué, mou et sans énergie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fb6fa8d-2707-41d9-a46d-3db7b1015415",
                                                "sense_id": "1f7eee48-90bd-3a89-abd5-e11b0daabae5",
                                                "text": "Ce jeune homme est vraiment apathique."
                                            },
                                            {
                                                "example_id": "e2993fec-5028-494a-8560-30ffd4377313",
                                                "sense_id": "1f7eee48-90bd-3a89-abd5-e11b0daabae5",
                                                "text": "Le Chartrain est cupide, apathique et salace, répliqua l’abbé Plomb ; cupide surtout, car la passion du lucre est ici, sous des dehors inertes, féroce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apathique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c3697a5-8393-39b4-af06-3bdb89ac82a8",
                                        "entry_id": "d32c0873-21c7-3443-9ce3-99d46d6af600",
                                        "glosses": [
                                            "Personne apathique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc7f901a-b066-46a4-8796-7c0847c62d48",
                                                "sense_id": "5c3697a5-8393-39b4-af06-3bdb89ac82a8",
                                                "text": "Enfin, comme son nom l’indique, l’apathique est l’homme de l’indifférence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb5410a6-8a3b-405d-8d85-5052f661567c",
                        "source_entry_id": "4fd83f6a-4253-3a01-938b-9e6b82c023d2",
