                        "entry_id": "238d1af6-d11a-3588-9c93-66694c6a2a5b",
                        "glosses": [
                            "A type of fruit in which the often edible flesh arises from the swollen base of the flower and not from the carpels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d5812c2-0ee2-4229-97a2-00b572e6fbd9",
                                "sense_id": "a79b281c-a273-3343-ab18-ab25d75ba612",
                                "text": "The best-known example of a pome is the apple."
                            }
                        ]
                    },
