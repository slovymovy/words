                        "glosses": [
                            "A female given name from Irish."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f26cdb-8a57-4fb9-ad83-fc8b0b30b365",
                                "sense_id": "fc73deda-e49d-3f1e-bd7a-3ba6f0c88473",
                                "text": "Deirdre, it seemed to him, was the most beautiful name in the world. But Mrs. Stanley had different views on nomenclature. She had never, she declared, heard so utterly preposterous a name. […]\"Theatre and saltpetre are both spelt that way, Arthur; depend upon it, it is Deirder - a sort of peasant name like Darby and Biddy, a corruption of something else.\""
                            },
                            {
                                "example_id": "966cc642-1c8a-460f-8dd4-7894a9267af3",
                                "sense_id": "fc73deda-e49d-3f1e-bd7a-3ba6f0c88473",
                                "text": "His daughter was called Deirdre, a good Irish name, but now she signed herself Dee, and her man friend was called Fox."
                            }
                        ]
                    }
