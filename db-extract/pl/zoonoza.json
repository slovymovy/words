                        "entry_id": "2df3e289-4995-314d-bde3-a71a54a18af4",
                        "glosses": [
                            "choroba zakaźna lub pasożytnicza zwierząt, mogąca wtórnie wystąpić u człowieka"
                        ],
                        "tags": [],
