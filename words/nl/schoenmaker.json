            "senses": [
                {
                    "sense_id": "0541275b-7e57-3897-b467-78b5930fd229",
                    "sense_definition": "Een ambachtsman die schoenen maakt en repareert.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>schoenmaker</w> heeft mijn oude leren laarzen weer als nieuw gemaakt.",
                            "target_lang_translations": {
                                "en": "The <w>shoemaker</w> made my old leather boots look like new again."
                            }
                        },
                        {
                            "text": "Als je hak kapot is, kun je die het beste naar een <w>lokale schoenmaker</w> brengen.",
                            "target_lang_translations": {
                                "en": "If your heel is broken, it is best to take it to a <w>local cobbler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schoenlapper"
                    ],
                    "common_phrases": [
                        "lokale schoenmaker",
                        "ambachtelijke schoenmaker"
                    ],
                    "target_lang_definitions": {
                        "en": "A craftsman who makes and repairs shoes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shoemaker",
                                "target_lang_sense_clarification": "a person who makes shoes"
                            },
                            {
                                "target_lang_word": "cobbler",
                                "target_lang_sense_clarification": "a person who repairs shoes"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9495eb92-0920-3959-9c33-39ed8a2ac865",
                    "sense_definition": "Een Nederlandse familienaam die oorspronkelijk naar het beroep van schoenmaker verwijst.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Meneer <w>Schoenmaker</w> werd gisteren gekozen tot de nieuwe voorzitter van de vereniging.",
                            "target_lang_translations": {
                                "en": "Mr. <w>Schoenmaker</w> was elected as the new chairman of the association yesterday."
                            }
                        },
                        {
                            "text": "De familie <w>Schoenmaker</w> woont al meer dan dertig jaar in deze straat.",
                            "target_lang_translations": {
                                "en": "The <w>Schoenmaker</w> family has been living in this street for more than thirty years."
                            }
                        }
                    ],
                    "traits": [
