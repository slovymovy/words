                                        "glosses": [
                                            "A cloth or stuff made of matted fibres of wool, or wool and fur, fulled or wrought into a compact substance by rolling and pressure, with lees or size, without spinning or weaving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "278a6e5f-a6f8-4fa2-9afb-8d313f6e164d",
                                                "sense_id": "5c70fc75-bbec-3692-8571-f86c95bf9abb",
                                                "text": "It were a delicate stratagem to shoe\n A troop of horse with felt."
                                            }
                                        ]
                                    },
