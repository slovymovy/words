                "senses": [
                    {
                        "sense_id": "5b11018b-4d8b-33c0-8436-a71e31f4bfd0",
                        "entry_id": "72bda94f-9485-34ca-b6bd-5e638b8a34a8",
                        "glosses": [
                            "die Nationalhymne Frankreichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484ae6a8-fc7c-438e-82de-8fa93dbd178f",
                                "sense_id": "5b11018b-4d8b-33c0-8436-a71e31f4bfd0",
                                "text": "Wenn die französische Nationalmannschaft auftritt, wird vorher die Marseillaise gespielt."
                            },
                            {
                                "example_id": "8d36db81-9c00-4666-aa60-64f4cea5d474",
                                "sense_id": "5b11018b-4d8b-33c0-8436-a71e31f4bfd0",
                                "text": "„Der Sergeant springt auf, singt die Marseillaise, und jetzt singen alle mit.“"
                            },
                            {
                                "example_id": "25a145f0-cf43-49a4-b5e4-3453d080aa59",
                                "sense_id": "5b11018b-4d8b-33c0-8436-a71e31f4bfd0",
                                "text": "„Die Marseillaise hallte durch die Zellenblocks, im abgeschlossenen Innenhof hörte man sie überdeutlich, und der Gesang dürfte für Gänsehaut gesorgt haben, nicht nur bei Geneviève.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
