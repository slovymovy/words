{
    "word_family": [
        "flow",
        "inflow",
        "fluent",
        "fluid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b0311a6-2042-33ca-9d6a-2ed5ea5ade25",
                    "sense_definition": "An arrival or entry of large numbers of people or things, or a continuous flow inward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel had to hire extra staff due to a sudden <w>influx</w> of tourists. ",
                            "target_lang_translations": {
                                "tr": "Otel, ani turist <w>akını</w> nedeniyle ekstra personel işe almak zorunda kaldı."
                            }
                        },
                        {
                            "text": "Local businesses flourished following an <w>influx</w> of new residents to the city.",
                            "target_lang_translations": {
                                "tr": "Şehre yeni sakinlerin <w>akın etmesiyle</w> yerel işletmeler gelişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "inflow"
                    ],
                    "antonyms": [
                        "efflux"
                    ],
                    "common_phrases": [
                        "influx of tourists",
                        "sudden influx",
                        "influx of cash"
                    ],
                    "target_lang_definitions": {
                        "tr": "Büyük miktarda insan veya şeyin gelişi veya içeriye doğru sürekli akışı."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "akın",
                                "target_lang_sense_clarification": "insan veya nesne kalabalığının gelişi"
                            },
                            {
                                "target_lang_word": "akış",
                                "target_lang_sense_clarification": "içeriye doğru sürekli geliş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14f672fb-a464-385a-a610-76b17cbefb40",
                    "sense_definition": "An inspiring or guiding influence, force, or power coming into something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist felt a spiritual <w>influx</w> of creativity while exploring the countryside.",
                            "target_lang_translations": {
                                "tr": "Sanatçı, kırsal bölgeyi keşfederken ruhani bir yaratıcılık <w>akışı</w> hissetti."
                            }
                        },
                        {
                            "text": "The philosopher wrote about the constant <w>influx</w> of divine guidance in human thought.",
                            "target_lang_translations": {
                                "tr": "Filozof, insan düşüncesindeki sürekli ilahi rehberlik <w>akışı</w> hakkında yazdı."
                            }
                        }
                    ],
                    "synonyms": [
                        "infusion"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used historically to mean spiritual or abstract influence"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin içine giren ilham verici veya yönlendirici etki, güç veya erki."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ilham akışı",
                                "target_lang_sense_clarification": "soyut veya ruhani etki/güç"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}