                "senses": [
                    {
                        "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                        "entry_id": "4de9fd80-4114-3fe3-8739-557e4c1e8ce4",
                        "glosses": [
                            "materiał budowlany z gliny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62cb02e6-d0bd-4b20-a484-5c35ec42316f",
                                "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                                "text": "9. Lekkie wypełniacze ceramiczne, jak kruszone glińce, granulowane keramzyty i porowate spieki"
                            },
                            {
                                "example_id": "943e32a7-e2c7-498c-be9b-e390dcbe8f48",
                                "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                                "text": "Keramzyt otrzymuje się przez wypalanie niskotopliwych iłów i glin o zdolności pęcznienia pod wpływem temperatury"
                            },
                            {
                                "example_id": "99ea87a9-9462-447e-9ea6-290deaf70d4c",
                                "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                                "text": "Jeżeli system korzeniowy roślin nie może się w pełni rozwinąć z powodu zbyt dużej spoistości i zwięzłości gleby, mieszając grunt z keramzytem, powodujemy spulchnienie podłoża, a dzięki temu ułatwiamy rozrastanie się korzeni i łatwiejsze dotarcie do nich wilgoci"
                            },
                            {
                                "example_id": "bd48fce8-ec80-4bc3-9398-63fe6482cdaf",
                                "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                                "text": "Z keramzytu tworzone są całe systemy budowlane"
                            },
                            {
                                "example_id": "cdfc90e2-11a3-468b-aa6c-037696d61ffd",
                                "sense_id": "b29b4960-ba54-3ca5-9e7b-b843e9ccce67",
                                "text": "Ponieważ keramzyt posiada bardzo dobre parametry cieplne, akustyczne oraz dużą wytrzymałość na ściskanie, może z powodzeniem być wykorzystany do izolacji podłóg"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
