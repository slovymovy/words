                        ],
                        "form": "synizeses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "38064cc2-aa79-3817-8208-1186d5641a83",
                        "entry_id": "1286ddbf-75f5-349c-ba8c-bbd9ccd87154",
                        "glosses": [
                            "The fusion of two syllables into one without the formation of a recognized diphthong, especially to fit a certain poetic meter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "31d9fa57-de20-35df-b114-5ab11f504b93",
                        "entry_id": "1286ddbf-75f5-349c-ba8c-bbd9ccd87154",
                        "glosses": [
                            "A dense clumping of chromosomes on one side of the nucleus of a cell, sometimes occurring prior to cell division."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8940b91d-0a8f-3f77-81ea-47a20a3bd3c8",
                        "entry_id": "1286ddbf-75f5-349c-ba8c-bbd9ccd87154",
                        "glosses": [
                            "Occlusion of the pupil of the eye, resulting in loss of vision."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
