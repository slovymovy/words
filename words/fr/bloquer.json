                {
                    "sense_id": "add913d5-23e3-308b-9801-d848bdf0e44d",
                    "sense_definition": "Obstruer un passage, une voie ou un accès, empêchant ainsi le passage ou la circulation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "obstruction_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un énorme camion accidenté <w>bloque</w> la route depuis deux heures."
                        },
                        {
                            "text": "Des manifestants ont décidé de <w>bloquer</w> le passage vers le centre-ville."
                        }
                    ],
                    "synonyms": [
                        "obstruer",
                        "barrer",
                        "entraver"
                    ],
                    "antonyms": [
                        "dégager",
                        "libérer",
                        "ouvrir"
                    ],
                    "common_phrases": [
