                        "examples": [
                            {
                                "example_id": "dda3c3fd-a156-4437-bb16-093005bdd756",
                                "sense_id": "89fe721e-91bd-33d4-b41b-56c0368f1e4e",
                                "text": "Enfin la pluie se calme, un rayon de soleil brille, et le temps redevient plus beau que jamais, aussitôt gardant un mulet pour l’insectologue Hippolite et son genou, l’on se remet en route gaîment, et plus gaîment encore, à la vue d’un manteau plus que pittoresque dont les gens de la Cantine ont affublé l’insectologue sur son mulet."
                            },
                            {
                                "example_id": "09cc7562-a936-4288-b196-86f5e99fabf6",
                                "sense_id": "89fe721e-91bd-33d4-b41b-56c0368f1e4e",
                                "text": "Ces montagnes calcaires de première alluvion, sont très-intéressantes pour l’insectologue, le botaniste & le géologue : ils pourront y faire d’abondantes récoltes en plus d’un genre."
                            },
                            {
                                "example_id": "10466d7d-a0ec-443c-b6d8-90512951974e",
                                "sense_id": "89fe721e-91bd-33d4-b41b-56c0368f1e4e",
                                "text": "Passionné de mygales depuis qu’il a 6 ou 7 ans, mon frère voulait être insectologue avec spécialisation dans les arachnées."
                            },
                            {
                                "example_id": "b03ffd6e-0e05-4734-8392-23133f162575",
                                "sense_id": "89fe721e-91bd-33d4-b41b-56c0368f1e4e",
                                "text": "Si observer une mouche peut vite s'avérer lassant, c'est surtout la chasse aux bestioles qui saura occuper votre apprenti insectologue."
                            }
                        ]
                    }
