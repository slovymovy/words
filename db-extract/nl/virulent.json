                                        "entry_id": "87cd6e69-96c1-3f8a-a3b5-c6873a7134ef",
                                        "glosses": [
                                            "Qualifie les maladies produites par un virus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4dceef8-7edf-35ae-9fc8-9770188dcf11",
                                        "entry_id": "87cd6e69-96c1-3f8a-a3b5-c6873a7134ef",
                                        "glosses": [
                                            "Qualifie tout ce qui porte et transmet les virus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "517c216b-d661-45d4-bf76-5bb14da59f29",
                                                "sense_id": "e4dceef8-7edf-35ae-9fc8-9770188dcf11",
                                                "text": "Moreta lui raconta la visite de Capiam, ses craintes pour la santé de tout le continent, car via la zoonose, une deuxième épidémie, plus virulente que la première, pouvait se propager partout, et par conséquent une vaccination massive était essentielle."
                                            },
                                            {
                                                "example_id": "cc9a8be9-29bc-4c9a-b57f-9b5395be971b",
                                                "sense_id": "e4dceef8-7edf-35ae-9fc8-9770188dcf11",
                                                "text": "Ce sont les excrétats virulents, en particulier les urines aérosolisées qui assurent la contamination des animaux et de l'homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54fbe5f8-aaaa-342d-8b17-6789c3b641f2",
                                        "entry_id": "87cd6e69-96c1-3f8a-a3b5-c6873a7134ef",
                                        "glosses": [
                                            "Qualifie des discours, des écrits où l’on attaque avec violence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c40eb0-c002-4ac2-8149-7cd6a63a509e",
                                                "sense_id": "54fbe5f8-aaaa-342d-8b17-6789c3b641f2",
                                                "text": "[…] et sa mère, tout en cardant à gestes secs et comme rageurs un paquet de laine, poussait de temps à autre une virulente malédiction."
                                            },
                                            {
                                                "example_id": "57e93e20-d9ec-4697-b8e6-9fc507d2f582",
                                                "sense_id": "54fbe5f8-aaaa-342d-8b17-6789c3b641f2",
                                                "text": "La propagande antibritannique des Frères devient alors moins virulente, car trop coûteuse."
                                            }
                                        ]
                                    }
                                ]
                            }
