    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                "word": "pertinacious",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8c34d3dd-3519-4262-9d28-8f3460c31cf2",
                        "entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more pertinacious"
                    },
                    {
                        "form_id": "24e013f7-cacf-497d-8c42-2d4692557927",
                        "entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most pertinacious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dec8082c-a571-37aa-979b-77604f93caa1",
                        "entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "glosses": [
                            "Holding tenaciously to an opinion or purpose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2921668f-0849-4592-a3ef-3aa164fbcc04",
                                "sense_id": "dec8082c-a571-37aa-979b-77604f93caa1",
                                "text": "When that divine took his leave, not a little discomfited and amazed at the pertinacious obstinacy of the women, Laura repeated her embraces and arguments with tenfold fervour to Helen, who felt that there was a great deal of cogency in most of the latter."
                            },
                            {
                                "example_id": "e8e3bb8c-7382-4dae-af76-d88b1e059974",
                                "sense_id": "dec8082c-a571-37aa-979b-77604f93caa1",
                                "text": "He would really have to make up his mind to care for his wife or not to care for her. What would Lady Vandeleur say to one alternative, and what would little Joscelind say to the other? That is what it was to have a pertinacious father and to be an accommodating son."
                            },
                            {
                                "example_id": "241ab845-5d60-4f60-962f-2ee02979cc36",
                                "sense_id": "dec8082c-a571-37aa-979b-77604f93caa1",
                                "text": "For, whether they were attracted by the lantern, or by the unaccustomed smell of a white man for which they had been waiting for the last thousand years or so, I know not; but certainly we were presently attacked by tens of thousands of the most blood-thirsty, pertinacious, and huge mosquitoes that I ever saw or read of."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdfc12b9-fd71-33bf-bab0-9d3791c5def0",
                        "entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "glosses": [
                            "Stubbornly resolute or tenacious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25fb633e-ae28-43dd-8f9b-ce76f18982d0",
                                "sense_id": "cdfc12b9-fd71-33bf-bab0-9d3791c5def0",
                                "text": "[O]ne of the Dissenters, which I could, but forbear, to name appeared to Dr. Sanderson to be so bold, so troublesome, and so illogical in the dispute, as forced patient Dr. Sanderson, who was then Bishop of Lincoln, and a moderator with other Bishops, to say, with an unusual earnestness, \"That he had never met with a man of more pertinacious confidence, and less abilities, in all his conversation.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdf79858-9022-4284-99b5-d2776dc02dae",
                        "source_entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "source_sense_description": "holding tenaciously to an opinion or purpose",
                        "target_lang_word": "vast overtuigd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a1d6054f-dede-4599-bb9f-fd5d9c78e54b",
                        "source_entry_id": "7c33eee0-dd0b-39ec-a08d-73b5c22ce24b",
                        "source_sense_description": "holding tenaciously to an opinion or purpose",
                        "target_lang_word": "obstiné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                        "entry_id": "e5ebd097-4cfd-3e53-a7b4-bff19eb0fd2e",
                                        "glosses": [
                                            "Qui s’obstine ; qui est entêté ou acharné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e2040c9-54e9-48d1-a674-8af6910c3d01",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Celui-là est défendu contre les quémandeurs trop opiniâtres par une sorte de femelle revêche, bourrue, grimaçante, qui s’entend à merveille à décourager les volontés les plus obstinées."
                                            },
                                            {
                                                "example_id": "3953b0dc-3f62-458b-8028-fcd67dcd399b",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Quoiqu’elle eût cinquante-sept ans et que ses travaux obstinés au sein du ménage lui permissent bien de se reposer, elle tricotait les bas de son mari, les siens et ceux d’un oncle, comme tricotent les femmes de la campagne, en marchant, en parlant, en se promenant dans le jardin, en allant voir ce qui se passait à sa cuisine."
                                            },
                                            {
                                                "example_id": "473b20b5-65c6-4bee-90c3-66d9f6a925df",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Le cordonnier a repris son air rogue, son visage obstiné."
                                            },
                                            {
                                                "example_id": "4bd418ff-9fb4-45fa-8180-f7eb3e6b26e5",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Les desservants peuvent, désormais, disparaître ; le peuple tiendra. Il tiendra, car il est, par caractère, obstiné ; car il vit groupé dans un rayon peu étendu."
                                            },
                                            {
                                                "example_id": "fa6d47a8-568b-470e-b978-a82fa468ee73",
                                                "sense_id": "07942af4-f50a-3422-85b1-4a52ccb9a535",
                                                "text": "Un rhume obstiné. — Lutte obstinée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                        "entry_id": "56d029c2-fe64-331b-811a-d5d528db004d",
                                        "glosses": [
                                            "Homme qui s’obstine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeecf424-5a2c-4998-8a26-70f80de46dbe",
                                                "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                                "text": "L’obstiné ne veut rien céder ; il fait paraître un esprit de contrariété."
                                            },
                                            {
                                                "example_id": "15f279e1-0cc9-4dde-a2e5-468df1133693",
                                                "sense_id": "9d3005dd-b216-3297-a276-22e57533755c",
                                                "text": "C’est un obstiné."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "obstiné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8dc4b2f-a22a-34dc-854a-5344b28c9915",
                                        "entry_id": "6c5d4e52-26f2-3b42-a8f9-38978b280836",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe obstiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e292000-a651-4fdb-b8d5-7f624e18b3af",
                                                "sense_id": "a8dc4b2f-a22a-34dc-854a-5344b28c9915",
                                                "text": "Seul le costaud ‒ nommé Bradford ‒ s’est obstiné à faire la moue, sous-entendant que j’en rajoutais pour faire l’intéressante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
