                "senses": [
                    {
                        "sense_id": "940d45f2-c9ea-3c1b-83f3-62fa9efab785",
                        "entry_id": "0c1027d0-0687-353e-9056-d925830cabd7",
                        "glosses": [
                            "Gegenstand, mit dem jemandem (einem Kind) etwas spielerisch beigebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f1c046-3b46-4322-942c-df2e6becdefa",
                                "sense_id": "940d45f2-c9ea-3c1b-83f3-62fa9efab785",
                                "text": "„Und diesen ganzen Bärchen- und Häschenkram, den du gekauft hast, den werden wir gegen pädagogisches Lernspielzeug tauschen.“"
                            },
                            {
                                "example_id": "f4093955-7687-417f-9346-f69de4f8f4a0",
                                "sense_id": "940d45f2-c9ea-3c1b-83f3-62fa9efab785",
                                "text": "„Es gibt heute alle Arten von Lernspielzeug auf dem Markt, und es gibt immer wieder neue Spielzeuge wie dieses, die hin und wieder herauskommen.“"
                            },
                            {
                                "example_id": "02ca765e-fba5-4293-84ce-60ede9890d80",
                                "sense_id": "940d45f2-c9ea-3c1b-83f3-62fa9efab785",
                                "text": "„Ich hatte jede Menge lustiges buntes Lernspielzeug für ihn besorgt und auch ein Töpfchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
