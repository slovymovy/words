        "fr-extract.jsonl": [
            {
                "entry_id": "b0823fe5-598b-3207-8c19-b169c047ea90",
                "word": "complicité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "520c2773-5626-4c1d-88b9-9e317bd8d6bd",
                        "entry_id": "b0823fe5-598b-3207-8c19-b169c047ea90",
                        "tags": [
                            "plural"
                        ],
                        "form": "complicités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                        "entry_id": "b0823fe5-598b-3207-8c19-b169c047ea90",
                        "glosses": [
                            "Participation au délit ou au crime d’un autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "034f6a61-865a-4be6-9cee-dc48b2542202",
                                "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                                "text": "[…]; mais le Bureau de Santé était implacable et livrait sans merci aux autorités administratives et judiciaires ceux qui débarquaient clandestinement, avec la complicité des terriens, des marchandises suspectes ; […]."
                            },
                            {
                                "example_id": "6e533c7e-3e7d-4e89-b321-73c698045004",
                                "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                                "text": "Le législateur canonique intervient aussi pour réprimer le rapt ; le Concile de Chalcédoine de 451 (canon 27) dépose les clercs coupables de complicité de rapt et excommunie les laïques dans ces cas."
                            },
                            {
                                "example_id": "379923f2-a3bc-4745-b10c-fa6f7ae80d37",
                                "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                                "text": "Le trabendo mafieux ne peut pas fonctionner sans la complicité active et grassement rétribuée de certains responsables."
                            },
                            {
                                "example_id": "91acc7ca-6ba9-40b1-948e-c3f9fa2a834b",
                                "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                                "text": "Ahurissant : on la juge pour la complicité dans des crimes abominables, et Monique Olivier se dépeint en ménagère effacée, régalant son tyran de mari de cacasse à cul nu et de tarte au sucre."
                            },
                            {
                                "example_id": "2242f510-cc6b-41e7-a75b-240c58f4dfec",
                                "sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                                "text": "Combien de fois des Maliens humbles ont été dépossédés de leurs biens en plein midi au profit de richissimes hommes d’affaires aux « bras longs » avec la complicité de juges véreux ? ."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f71e3ce-0c20-3be4-91a3-747c25686df8",
                        "entry_id": "b0823fe5-598b-3207-8c19-b169c047ea90",
                        "glosses": [
                            "Lien d'intelligence entre deux personnes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "29b82066-52c8-44f0-acf9-51eb745c48ad",
                                "sense_id": "5f71e3ce-0c20-3be4-91a3-747c25686df8",
                                "text": "Il a une grande complicité avec son épouse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0a98c98-9dea-4a27-b492-d751cd769df6",
                        "source_entry_id": "b0823fe5-598b-3207-8c19-b169c047ea90",
                        "source_sense_id": "5e8e29b7-5d15-3979-9535-9976b21f929d",
                        "source_sense_description": "(Droit) Participation au délit ou au crime d’un autre.",
                        "target_lang_word": "complicity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complicity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3cfd9f7-41d1-39a0-8a76-182a44c3fb88",
                                        "entry_id": "fc2beea6-ebac-35e8-be46-f656df7812bd",
                                        "glosses": [
                                            "The state of being complicit; involvement as a partner or accomplice, especially in a crime or other wrongdoing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70bad90b-4d1c-4937-9579-253905055fe5",
                                                "sense_id": "b3cfd9f7-41d1-39a0-8a76-182a44c3fb88",
                                                "text": "He drew up a placard, offering Twenty Pounds reward for the apprehension of Stephen Blackpool, suspected of complicity in the robbery of Coketown Bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e80707-c6ec-361c-838e-fef3b75491f7",
                                        "entry_id": "fc2beea6-ebac-35e8-be46-f656df7812bd",
                                        "glosses": [
                                            "Complexity."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4173df0e-9e92-42fa-af7e-079580740cde",
                                                "sense_id": "85e80707-c6ec-361c-838e-fef3b75491f7",
                                                "text": "How easy is it, on the other hand, to an enlightened teacher, particularly in the beginning, to elucidate the various forms of rhythm by methodical arrangement in respect of simplicity and increasing complicity or mixture!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
