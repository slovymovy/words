        "fr-extract.jsonl": [
            {
                "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                "word": "falbala",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "52020c38-bca6-406a-ae01-85fefa2d1863",
                        "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "tags": [
                            "plural"
                        ],
                        "form": "falbalas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27c11805-ec71-3f6a-99b8-0f9324c62b08",
                        "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "glosses": [
                            "Pièce d’étoffe plissée utilisée pour rehausser l’apparence d’un vêtement ou d’un rideau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d19e034-38a5-407e-8d1a-1bebc40b42e7",
                                "sense_id": "27c11805-ec71-3f6a-99b8-0f9324c62b08",
                                "text": "Madame Necker, […], ne le cédait en magnificence à aucune des dames de son cercle. Trois étages de falbalas garnissaient sa robe; …."
                            },
                            {
                                "example_id": "fa042c75-1ba1-4512-9286-de0de968dee9",
                                "sense_id": "27c11805-ec71-3f6a-99b8-0f9324c62b08",
                                "text": "Quant aux serpents, il en vit plusieurs, et l’Infante épouvantée serrait autour de ses chevilles sa robe à falbalas, qui traînait des guirlandes de ronces mortes."
                            },
                            {
                                "example_id": "6f324357-56e8-4ada-8c32-b79026e4b4d6",
                                "sense_id": "27c11805-ec71-3f6a-99b8-0f9324c62b08",
                                "text": "Me voilà, moi, avec mon bonnet à falbalas, ma jaquette blanche, ma jupe brodée, puisant dans un cornet de papier de journal mes grains d’orge."
                            },
                            {
                                "example_id": "0cf4e4c5-8d68-420e-8612-e650a41ae7d6",
                                "sense_id": "27c11805-ec71-3f6a-99b8-0f9324c62b08",
                                "text": "Depuis cette initiation, Coco-Lacour, spécialisé dans le vol de dentelles, a une prédilection pour les fanfreluches, rubans et autres falbalas."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7e6f228-0524-3dda-b743-4677786e040b",
                        "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "glosses": [
                            "(Par extension) Expansions latérales ondulées du stipe de certaines algues."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c2e2e727-03d3-34e8-941d-f6f8e5103ed4",
                        "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "glosses": [
                            "Ornement trop voyant sur les vêtements."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "63f04f4b-9551-46b9-961f-e4184100e3cc",
                                "sense_id": "c2e2e727-03d3-34e8-941d-f6f8e5103ed4",
                                "text": "Une dame vint à la messe avec des falbalas à remplir toute l’église ; le commissaire du quartier, qui se trouvait là par hasard, fit reculer la foule jusqu’au portail, afin de protéger une si riche toilette."
                            },
                            {
                                "example_id": "82c93465-9296-4258-a4f9-4a56a1a6b45c",
                                "sense_id": "c2e2e727-03d3-34e8-941d-f6f8e5103ed4",
                                "text": "Au lieu des falbalas dont elle s’était parée dans son jeune âge, Constance porte la robe sombre et le grand fichu de l’ère révolutionnaire ; le seul bijou est une croix de Jeannette."
                            }
                        ]
                    },
                    {
                        "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                        "entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "glosses": [
                            "Rituel inutile."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "63a8c630-31aa-4766-9bf8-e1363c954626",
                                "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                                "text": "Toutefois l’heureux temps des greniers est passé, non que je m’y trouvasse fort bien, mais j’y manquerais d’aise, j’y tiendrais trop de place avec les falbalas de ma renommée ; je n’y serais plus avec ma seule chemise et la taille fine d’un inconnu qui n’a point dîné."
                            },
                            {
                                "example_id": "bb3b7dae-0eb2-413a-8f98-7f5ee6ed7726",
                                "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                                "text": "On déjeuna, et ma mère et moi allâmes faire un tour dans la ville, pour nous remettre un peu de toute cette mort, avec tous ses falbalas, et de tous ces invités avec leurs allures de personnages de cinquième acte."
                            },
                            {
                                "example_id": "403f7ece-4280-4a40-8192-724ae7013feb",
                                "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                                "text": "Ils n’étaient pas compliqués : ils étaient sains, ils étaient justes ; je vous explique ça comme je le sais, sans falbalas."
                            },
                            {
                                "example_id": "df71ba92-8a83-4894-a4a3-3020048f3fea",
                                "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                                "text": "– Je connais les déguisements qui conviennent à toutes ces sortes de singeries, m’avait-elle expliqué. Dans la journée, il faut être printanière, claire et nette, chic et surtout pas provocatrice. Le soir, romance et falbalas, charme et féminité. Ne vous faites aucun souci, je serai une cavalière à la hauteur de votre rêve."
                            },
                            {
                                "example_id": "51bef2ed-aeea-471b-b784-7bd4ea47cd31",
                                "sense_id": "499b5a98-ae35-3dce-88ad-4a5c6a347ebe",
                                "text": "Si l'homme moderne jure qu'il ne veut pas pour lui-même de falbala religieux après sa mort, quelque chose lui enjoint d’avoir la faiblesse de l’offrir à son défunt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7849cba1-37be-4ef6-a002-eb99f5d121ca",
                        "source_entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "target_lang_word": "Falbel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fcfcd41f-5a3c-469c-940b-a8564231da98",
                        "source_entry_id": "a7f9c8ff-0499-3b1e-8e88-380a8f990dcc",
                        "target_lang_word": "furbelow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furbelow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                        "entry_id": "71c6b1f4-2789-323f-8057-985fdb67c47a",
                                        "glosses": [
                                            "A frill, flounce, or ruffle, as on clothing; a decorative piece of fabric, especially one gathered or pleated as into a ruffle, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be1fb75-c6bd-4733-adf6-88ec4734a6c9",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "I do not think that from the blissful time when I was sixteen, up to my present solemn five-and-thirty, I could ever have been tempted to look a second time at any miss under the chaperonship of such a dame as that feather and furbelow lady."
                                            },
                                            {
                                                "example_id": "8c4af945-25dd-485a-9d99-4d1099d700d5",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "All the other furbelows, and portions of this one^([this Medusa]) that lay below the expansion, floated as usual through the water, except that on some occasions an accessory power was obtained by pressing a portion of another furbelow to the side of the glass and making it adhere just like the portion that was exposed to the surface of the air."
                                            },
                                            {
                                                "example_id": "4a6d2ae9-3b4d-4ed2-a694-e38a5d424795",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "“Well, I don’t know that fifty is much for a dress, with all the furbelows and notions you have to have to finish it off these days.”"
                                            },
                                            {
                                                "example_id": "f8124076-3380-4f2c-97ca-afe3416bc26c",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "Winterbourne stood looking after her; and as she moved away, drawing her muslin furbelows over the gravel, said to himself that she had the tournure of a princess."
                                            },
                                            {
                                                "example_id": "8ab91806-3bce-466a-8e24-f5de504d5e88",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "Those dresses are good, sensible, serviceable dresses, without any frills or furbelows about them, and they’re all you’ll get this summer."
                                            },
                                            {
                                                "example_id": "c4632e98-2074-49ff-a1d4-f0c4105b20ff",
                                                "sense_id": "04033322-e824-34de-9dd4-e48b40d2ce30",
                                                "text": "Each plant has several oarweed fronds on the top of a flat stem, well adapted to swaying in one direction but rigid in the other; along the rigid edges, where the water flows and eddies, develop the wavy furbelows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c11586ce-3c52-381c-bc0e-c1c9bbc80d98",
                                        "entry_id": "71c6b1f4-2789-323f-8057-985fdb67c47a",
                                        "glosses": [
                                            "A small, showy ornamentation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c03236-29a7-4d3c-8773-4c399733fcc6",
                                                "sense_id": "c11586ce-3c52-381c-bc0e-c1c9bbc80d98",
                                                "text": "Within, among the bric-a-brac and furbelows, he found Miss Painter seated in a redundant purple armchair with the incongruous air of a horseman bestriding a heavy mount."
                                            },
                                            {
                                                "example_id": "3c44ac33-5b1f-4d7f-85c7-f195794786f3",
                                                "sense_id": "c11586ce-3c52-381c-bc0e-c1c9bbc80d98",
                                                "text": "The band played ceaselessly. Even when the other instruments were resting the pianist kept up his monotonous vamping, with a dreary furbelow for embellishment here and there, to which some few of the dancers continued to shuffle round the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "furbelow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da194a3f-5ad1-3dcc-b70e-6eda9a6c25ed",
                                        "entry_id": "7458092b-0c11-39fe-9b94-18c71653794e",
                                        "glosses": [
                                            "To adorn with a furbelow; to ornament."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be580562-8864-4675-acc2-d351d9ce2bcb",
                                                "sense_id": "da194a3f-5ad1-3dcc-b70e-6eda9a6c25ed",
                                                "text": "Mrs. Palmer, and her furbelowed daughters-in-law, who will probably carry enough of the scarlet fever about them, to remind you unpleasantly of the officiousness which preserved the lives of three daughters, when two might have been parted with advantageously enough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
