                ],
                "senses": [
                    {
                        "sense_id": "46517b0b-946e-3b50-a72f-037b0cde5aee",
                        "entry_id": "84abbf8b-bac3-3a92-8558-ffcec7e67e27",
                        "glosses": [
                            "Appareil installé sur un trottoir servant à mesurer, et souvent à payer, le temps de stationnement d’une automobile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b53d2db-3b8a-47b8-b9c5-f6c23bb24ecf",
                                "sense_id": "46517b0b-946e-3b50-a72f-037b0cde5aee",
                                "text": "Que prouvent en effet les mentions du procès-verbal dressé en notre affaire ? Deux choses seulement : la présence de telle voiture à tel endroit, à telle heure ; le fait, d’autre part, que l’aiguille du parcmètre indique le chiffre « zéro »."
                            },
                            {
                                "example_id": "bccf1358-ebbd-4a9f-8e95-0f430ff175f1",
                                "sense_id": "46517b0b-946e-3b50-a72f-037b0cde5aee",
                                "text": "Mais pour ne pas ajouter de petits frais aux gros, la prochaine fois, pensez à mettre des pièces dans le parcmètre…\nM’enfin!!!"
                            },
                            {
                                "example_id": "cc81ebb0-7c41-4352-bf53-91641fbb332b",
                                "sense_id": "46517b0b-946e-3b50-a72f-037b0cde5aee",
                                "text": "Les maisons sur le partie gauche de la carte ont fait place à un parking bordé d'arbres... et de parcmètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2263a3-d1e0-4eea-a7ea-88ea454c6fcb",
                        "source_entry_id": "84abbf8b-bac3-3a92-8558-ffcec7e67e27",
                        "source_sense_id": "46517b0b-946e-3b50-a72f-037b0cde5aee",
                        "target_lang_word": "Parkuhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parkuhr",
