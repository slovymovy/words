                                "example_id": "cc2483b3-c41c-457c-a7cf-baf87e687202",
                                "sense_id": "d2898236-c482-3575-853e-8532eca59dd9",
                                "text": "In een week zijn meestal maandag, dinsdag, woensdag, donderdag, vrijdag en soms ook zaterdag een schooldag."
                            }
                        ]
                    },
                    {
                        "sense_id": "734231bc-3e01-31b3-9539-91f6b870af38",
                        "entry_id": "7d0f63e8-bd00-3d5c-bf80-6b387cb39ca3",
                        "glosses": [
                            "dag dat men naar school gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97200237-7f16-408d-9983-10d22675c121",
                                "sense_id": "734231bc-3e01-31b3-9539-91f6b870af38",
                                "text": "Alles was nieuw voor me en ik nam het allemaal in me op als een kind op zijn eerste schooldag."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1180c0b-6978-47b4-bc8c-4ec1a27cf68c",
