                        "entry_id": "48b9a265-1a52-32a8-9b4b-4010e80672e8",
                        "glosses": [
                            "hoeveelheid van een geneesmiddel die je per keer moet innemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79e28f7b-97f9-4884-8f60-aeecdc0c8fde",
                                "sense_id": "d2254d13-6292-3623-8d74-7029e20e8bc5",
                                "text": "Omdat het medicament onvoldoende werkte verdubbelde de arts de dosis."
                            }
                        ]
                    },
                    {
                        "sense_id": "e978cf13-b329-3147-acb1-1a9a56e06523",
                        "entry_id": "48b9a265-1a52-32a8-9b4b-4010e80672e8",
                        "glosses": [
                            "afgemeten hoeveelheid van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "767e9b8d-d269-4502-8015-7b1430738b5f",
                                "sense_id": "e978cf13-b329-3147-acb1-1a9a56e06523",
                                "text": "De ouders hadden de kinderen van 10 en 12 na een hoop gedoe voor een halfjaar van school kunnen uitschrijven om gezamenlijk de PCT te lopen. De kinderen hadden meer dan genoeg aanspraak met alle hippies om zich heen en leken volop te genieten van het avontuur. Een prachtig voorbeeld van ‘gewoon doen’ met een gezonde dosis doorzettingsvermogen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca171322-8e1d-45e1-b05b-b9167560c4a7",
                        "source_entry_id": "48b9a265-1a52-32a8-9b4b-4010e80672e8",
                        "source_sense_id": "d2254d13-6292-3623-8d74-7029e20e8bc5",
                        "source_sense_description": "hoeveelheid van een geneesmiddel die je per keer moet innemen",
