                "senses": [
                    {
                        "sense_id": "26fe66fd-0954-3670-8ef0-a3c5570f1b76",
                        "entry_id": "2832fa18-199d-3609-b201-4e198de6c667",
                        "glosses": [
                            "Repeatedly compound; made up of complex constituents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c71b20b5-90c8-4a92-aa56-78377bb83131",
                                "sense_id": "26fe66fd-0954-3670-8ef0-a3c5570f1b76",
                                "text": "And it happeens in most cases, that the decomplex idea belonging to any sentence, is not compounded merely to the complex ideas belonging to the words of it; but that there are also many variations, some oppositions, and numberless additions."
                            },
                            {
                                "example_id": "3f1c442a-4322-4186-a02f-6c8bf581a2d5",
                                "sense_id": "26fe66fd-0954-3670-8ef0-a3c5570f1b76",
                                "text": "For an expert performer will play from notes, or ideas laid up in memory, or from the connexion of the several complex parts of the decomplex motions, some or all; and, at the same time, carry on a quite different train of thoughts in his mind, or even hold a conversation with another."
                            },
                            {
                                "example_id": "39b32a13-8923-45ba-a5ef-7681a481c697",
                                "sense_id": "26fe66fd-0954-3670-8ef0-a3c5570f1b76",
                                "text": "The decomplex nature of English poor relief resulted from the interplay between two factors: the growth of government at both the central and local level and the evolution of the churchwarden as a parish officer whose brief also included the relief of the poor."
                            }
                        ]
                    }
                ],
