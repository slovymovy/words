                ],
                "senses": [
                    {
                        "sense_id": "32dddb2a-4bcb-32f6-9829-f336e5a075f1",
                        "entry_id": "8713c921-9234-3f73-a683-5e0b9973ae6c",
                        "glosses": [
                            "Devenir victime d'un anévrisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9313d7-fd68-4742-a367-3a2dde2b616c",
                                "sense_id": "32dddb2a-4bcb-32f6-9829-f336e5a075f1",
                                "text": "Le tronc de la céliaque, l’aorte ventrale, peut être la mésentérique, peuvent s’anévriser."
                            },
                            {
                                "example_id": "9bdcde59-e2f2-4840-a8dd-65a98d8aafb3",
                                "sense_id": "32dddb2a-4bcb-32f6-9829-f336e5a075f1",
                                "text": "Mais il existe des femmes dont le cœur trop fortement dilaté s’anévrise dans ces terribles péripéties; d’autres, chez lesquelles le sang se tourne, et qui font de graves maladies."
                            },
                            {
                                "example_id": "e8e47d0b-c2a5-4b93-b347-630d0e6fd965",
                                "sense_id": "32dddb2a-4bcb-32f6-9829-f336e5a075f1",
                                "text": "Sézig Picoulet, quand on lui a montré ça, on a cru qu’il allait s’en anévriser une amygdale."
                            }
                        ]
                    }
                ],
