                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3dc319f-acd1-4d5d-8f1e-91f62e004c8d",
                                "sense_id": "e5639ec7-9379-3aaf-8f88-07f3ac8130cf",
                                "text": "Befestige deinen Drahtzaun doch mit Krampen."
