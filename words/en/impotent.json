{
    "word_family": [
        "impotence",
        "impotency"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78390fd4-8bac-3c74-9df6-780bc6cd8274",
                    "sense_definition": "Lacking in power, as to act effectively; helpless",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "powerlessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government felt <w>impotent</w> to stop the rising tide of public anger.",
                            "target_lang_translations": {
                                "zh": "政府感到<w>无能为力</w>，无法平息日益高涨的公众愤怒。"
                            }
                        },
                        {
                            "text": "Technology without morality is <w>impotent</w> in solving complex human problems.",
                            "target_lang_translations": {
                                "zh": "没有道德约束的科技在解决复杂的人类问题时是<w>软弱无力</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "powerless",
                        "helpless"
                    ],
                    "antonyms": [
                        "potent"
                    ],
                    "common_phrases": [
                        "feel impotent"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在采取有效行动方面缺乏力量；无能为力"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无能为力",
                                "target_lang_sense_clarification": "形容面对问题时感到束手无策"
                            },
                            {
                                "target_lang_word": "软弱无力",
                                "target_lang_sense_clarification": "形容缺乏执行力或影响力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5adae6bb-913b-3989-a199-9255efa3aeff",
                    "sense_definition": "Lacking physical strength or vigor; weak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impotent</w> old man could barely lift his own glass of water.",
                            "target_lang_translations": {
                                "zh": "这位<w>虚弱</w>的老人几乎连自己的水杯都拿不动。"
                            }
                        },
                        {
                            "text": "After the long illness, he felt <w>impotent</w> and tired.",
                            "target_lang_translations": {
                                "zh": "久病之后，他感到<w>无力</w>且疲惫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weak",
                        "feeble",
                        "puny"
                    ],
                    "target_lang_definitions": {
                        "zh": "缺乏体力或精力；虚弱"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "虚弱",
                                "target_lang_sense_clarification": "指身体状况不佳，缺乏力量"
                            },
                            {
                                "target_lang_word": "无力",
                                "target_lang_sense_clarification": "指身体疲惫或缺乏活力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17f5a11f-4f02-3fc4-863f-efe0020bb852",
                    "sense_definition": "Incapable of sexual intercourse, often because of an inability to achieve or sustain an erection",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medical treatments are now available for men who are <w>impotent</w>.",
                            "target_lang_translations": {
                                "zh": "现在已有针对<w>阳痿</w>男性的医疗方案。"
                            }
                        },
                        {
                            "text": "He worried that he might become <w>impotent</w> due to his health condition.",
                            "target_lang_translations": {
                                "zh": "他担心自己的健康状况会导致<w>阳痿</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "potent"
                    ],
                    "target_lang_definitions": {
                        "zh": "指男性无法进行性交，通常是因为无法勃起或维持勃起"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阳痿",
                                "target_lang_sense_clarification": "医学术语，指勃起功能障碍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d8469c6-b457-3a9b-a449-67415664bb5c",
                    "sense_definition": "Sterile",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hybrid plant was <w>impotent</w> and could not produce seeds.",
                            "target_lang_translations": {
                                "zh": "这种杂交植物是<w>不育</w>的，无法产生种子。"
                            }
                        },
                        {
                            "text": "Scientists found the laboratory strain to be <w>impotent</w> for breeding purposes.",
                            "target_lang_translations": {
                                "zh": "科学家发现该实验室菌株在繁殖方面是<w>不育</w>的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指生物无法繁殖；不育"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不育",
                                "target_lang_sense_clarification": "指生物无法产生后代"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97c9b93d-80f0-354b-bf9f-8873f7bb8920",
                    "sense_definition": "Lacking self-restraint",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weakness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>impotent</w> of temper and often shouted at his staff.",
                            "target_lang_translations": {
                                "zh": "他<w>缺乏自制</w>，经常对员工大吼大叫。"
                            }
                        },
                        {
                            "text": "The leader was <w>impotent</w> of tongue and spoke without thinking.",
                            "target_lang_translations": {
                                "zh": "这位领导人<w>缺乏自制</w>，说话不经大脑。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in a literary or older context"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "缺乏自制力（古语）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缺乏自制",
                                "target_lang_sense_clarification": "指无法控制自己的行为或情绪"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "50848493-d98e-358b-ab39-c2968c582399",
                    "sense_definition": "An impotent or powerless person",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "powerlessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator viewed his political rivals as mere <w>impotents</w>.",
                            "target_lang_translations": {
                                "zh": "独裁者将他的政治对手视为<w>无能之辈</w>。"
                            }
                        },
                        {
                            "text": "He felt like an <w>impotent</w> in the face of such overwhelming bureaucracy.",
                            "target_lang_translations": {
                                "zh": "面对如此庞大的官僚机构，他觉得自己像个<w>无能之辈</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wet noodle"
                    ],
                    "target_lang_definitions": {
                        "zh": "无能或无权势的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无能之辈",
                                "target_lang_sense_clarification": "指缺乏能力或影响力的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "108e7c57-138e-3ec4-94ec-542f9c9f5215",
                    "sense_definition": "A man who has erectile dysfunction",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical texts often mocked the <w>impotent</w> as figures of ridicule.",
                            "target_lang_translations": {
                                "zh": "历史文献常将<w>阳痿患者</w>描绘成嘲笑的对象。"
                            }
                        },
                        {
                            "text": "The physician treated the <w>impotent</w> with various herbal remedies.",
                            "target_lang_translations": {
                                "zh": "医生用各种草药治疗<w>阳痿患者</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "priapist"
                    ],
                    "target_lang_definitions": {
                        "zh": "患有勃起功能障碍的男性"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阳痿患者",
                                "target_lang_sense_clarification": "指患有勃起功能障碍的男性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}