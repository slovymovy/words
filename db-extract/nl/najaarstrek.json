                            {
                                "example_id": "f3d7cc11-2b2e-4e34-8ef0-7a74fd469b69",
                                "sense_id": "b0b31ebb-4567-38b4-bc1a-6c4e90283a91",
                                "text": "Wit oplichtend op de grond achter in de binnenplaatsen symboliseerden de omgekeerde bootjes hetzelfde als elders de najaarstrek van de kraanvogels of de eerste sneeuw."
                            },
