                        "examples": [
                            {
                                "example_id": "c8256787-f7a1-4a11-8f9e-ddbfcb8efe69",
                                "sense_id": "f9428f73-661f-3e14-a106-658968738f05",
                                "text": "„Die verhexte Ziege“ ist eine Humoreske von Karl May."
                            },
                            {
                                "example_id": "c7c39d53-34f7-477b-8065-1b9fad13225b",
                                "sense_id": "f9428f73-661f-3e14-a106-658968738f05",
                                "text": "„Dieser großartige Humorist war ein typischer Ostpreuße und schrieb seine Humoresken und Gedichte ausschließlich in ostpreußischer Mundart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9165fde0-f8a4-37b3-a43b-e1a245cd0000",
                        "entry_id": "bcb75370-9391-39fb-a791-cf7f6da81f5e",
                        "glosses": [
                            "heiteres Musikstück"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "277d92cb-d5a2-4ca8-8758-a3f88fa644af",
                                "sense_id": "9165fde0-f8a4-37b3-a43b-e1a245cd0000",
                                "text": "Die Humoreske Op. 101 Nr. 7 ist das berühmteste Klavierstück von Anton Dvorak."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
