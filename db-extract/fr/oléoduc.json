                "senses": [
                    {
                        "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                        "entry_id": "81edf71c-ba41-38be-92a6-1ecd677f9d42",
                        "glosses": [
                            "Tube de transport de pétrole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e13c0ce-baa0-4315-8507-281cd8909be1",
                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                "text": "Les pétroliers géants ne pouvant emprunter le canal, le projet d'un oléoduc transisthmique vit le jour à la fin des années 1970. Commencé en 1981 et mis en service début 1983, cet oléoduc sert au transport du pétrole en provenance des gisements de l'Alaska et à destination des raffineries de la côte est des États-Unis."
                            },
                            {
                                "example_id": "621ae78a-1409-436e-9832-6d4f5c194019",
                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                "text": "Les oléoducs de petit diamètre servent au transport des hydrocarbures sur de courtes distances, les longs trajets étant assurés par les chemins de fer ou les bateaux."
                            },
                            {
                                "example_id": "b66c5423-129a-48a2-935c-f79c36620c7d",
                                "sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                                "text": "Prenez les oléoducs, où le fédéral réaffirme continuellement son pouvoir de l’imposer au Québec."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b3772e4-817d-4097-b098-0716d7c644a5",
                        "source_entry_id": "81edf71c-ba41-38be-92a6-1ecd677f9d42",
                        "source_sense_id": "49204f5b-0cab-37f8-986a-7e1df379d36d",
                        "target_lang_word": "Pipeline",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pipeline",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "große, oft grenzüberschreitende Rohrleitung für Erdgas, Erdöl, manchmal auch Bier, sonstige Flüssigkeiten oder Gase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6077cf88-adba-41be-beea-c0cf0f81e04b",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "In der Ukraine wurden russische Pipelines angezapft."
                                            },
                                            {
                                                "example_id": "7d67298b-eeb8-4310-91fc-ef33cb3e40b5",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "„Nansen und Quisling nahmen auch die Pipeline in Augenschein, durch die seit der Jahrhundertwende Öl von Baku, wo die größten Ölfelder der Welt lagen, an die Schwarzmeerküste transportiert wurde.“"
                                            },
                                            {
                                                "example_id": "4ea5446d-2c41-447f-b78f-d0d9185a3053",
                                                "sense_id": "d204985f-5bb7-3b90-b267-0aa4a1ab1749",
                                                "text": "„Nach Reykjavík führt […] eine mehrere zehn Kilometer lange Pipeline mit Heißwasser, das in den Bergen mit ca. 88 °C startet und mit 86 °C in der Stadt ankommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9f016df8-87eb-3f34-9eda-5330ea50aa92",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "Zwischenpuffer, in den ein Prozess schreibt und aus dem ein anderer liest"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80d19ef-c721-4ada-9174-00cf1c6b3236",
                                                "sense_id": "9f016df8-87eb-3f34-9eda-5330ea50aa92",
                                                "text": "Der Kindprozess öffnet die Pipeline zum Lesen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7aebf7d2-df81-31f6-b139-c2a947df8dd4",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "Reihe hintereinandergeschalteter und gemeinsam getakteter Verarbeitungseinheiten in einem Mikroprozessor"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "555d4b92-46eb-441b-8491-89f09c36363d",
                                                "sense_id": "7aebf7d2-df81-31f6-b139-c2a947df8dd4",
                                                "text": "Da in jedem Takt ein neuer Befehl geladen wird, verlässt im Idealfall auch ein Befehl pro Takt die Pipeline."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a3425a5a-284e-3baf-a968-7a34e3f905e8",
                                        "entry_id": "bcac5504-a9cd-3d84-993c-c6d7e7b562fc",
                                        "glosses": [
                                            "eine (mehr oder weniger) gerade Verbindung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f9dbbf1-fb71-4466-8dc7-55265e93a6fc",
                                                "sense_id": "a3425a5a-284e-3baf-a968-7a34e3f905e8",
                                                "text": "Sie hat eine Pipeline zu ihren Kunden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd8a7350-69f7-4ace-8fae-c92b833dca2f",
                        "source_entry_id": "81edf71c-ba41-38be-92a6-1ecd677f9d42",
