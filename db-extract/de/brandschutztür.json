                        "glosses": [
                            "spezielle Tür, die im Brandfall (= Rauch + Feuer) selbsttätig schließt und das Durchlassen von Rauch und Feuer verhindern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bd1cd92-52b6-402c-873b-db0fe8a82a02",
                                "sense_id": "9e5f31a2-bc79-3447-aed8-2fe007c02838",
                                "text": "„Die Spannung an der Feststellvorrichtung wird unterbrochen und die Brandschutztür schließt automatisch.“"
                            },
                            {
                                "example_id": "58c1c94d-6495-4fdd-a52f-f16ed148ae31",
                                "sense_id": "9e5f31a2-bc79-3447-aed8-2fe007c02838",
                                "text": "„Brandschutztüren gehören zu den so genannten Feuerschutzabschlüssen.“"
                            }
                        ],
