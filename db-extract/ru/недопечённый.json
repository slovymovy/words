                "forms": [],
                "senses": [
                    {
                        "sense_id": "6fe13c34-5915-3c30-9f9e-601cf2604a6c",
                        "entry_id": "26ba08ca-087a-35ab-9674-75b3f4df0d46",
                        "glosses": [
                            "страд. прич. прош. вр. от недопечь"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "eecde03e-9d47-400f-a95c-1dabb02c05f9",
                                "sense_id": "6fe13c34-5915-3c30-9f9e-601cf2604a6c",
                                "text": "Сероватый белый хлеб полумокр и тяжёл; недопечённые куски теста комьями вываливаются в ладони из его нутра, а изюминки ― нечастые, с колючими хвостиками."
                            },
                            {
                                "example_id": "6873cfef-a7c1-4b32-8f1d-3b648dde33ea",
                                "sense_id": "6fe13c34-5915-3c30-9f9e-601cf2604a6c",
                                "text": "Человек нашего времени думает проще и благороднее, нежели эти отсталые, недопечённые умники."
                            }
                        ]
                    }
                ],
