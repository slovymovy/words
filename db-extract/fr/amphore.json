        "fr-extract.jsonl": [
            {
                "entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                "word": "amphore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ffcec8a-dc98-4ac2-b37e-abf8ea379f9b",
                        "entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "tags": [
                            "plural"
                        ],
                        "form": "amphores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "48b4684f-6744-33bf-bab5-a423df8ecad0",
                        "entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "glosses": [
                            "Jarre à deux anses dans laquelle on mettait le vin, l’huile."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "0159c313-a6bc-49dd-8248-389a6fcd6a2b",
                                "sense_id": "48b4684f-6744-33bf-bab5-a423df8ecad0",
                                "text": "L’inscription en minuscule d’une amphore de provenance espagnole trouvée au Testaccio à Rome."
                            }
                        ]
                    },
                    {
                        "sense_id": "b04664fd-8599-3f0c-8c49-6f44669e8c69",
                        "entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "glosses": [
                            "Ancienne mesure de capacité pour les liquides."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "615d7774-a2db-4b38-90be-7a4a9e1c21f4",
                                "sense_id": "b04664fd-8599-3f0c-8c49-6f44669e8c69",
                                "text": "En Grèce, l’amphore, amphoréus ou diota, se divisait en 6 conges ou chous = 36 xestès = 72 cotyles = 288 oxybaphes = 452 cyathes, et contenait le poids d’un talent d’eau ou les 72/100 d’un pied cube grec = 19.44 litres ou 4.2787 gallons.\nÀ Rome, l’amphore, amphora (amphoréus des Grecs), faisait dans le principe la 10ᵉ partie du culéus, et se divisait en 6 conges = 56 sextarii = 72 hémines = 288 acétabules = 432 cyathes = 19.44 litres = 4.2787 gallons.\nPar la suite, ces subdivisions furent changées : l’amphore représenta la capacité du pied cube romain, contenant 80 as ou livres romaines d’eau, et reçut le nom de quadrantal. Cette mesure forma la 20ᵉ partie d’un nouveau culéus qui fut substitué à l’ancien. Alors l’amphore ou quadrantal se divisa en 2 urnes = 8 conges = 48 setiers (sextarii) = 96 hémines = 192 quartiers (quartarii) = 384 acétabules = 576 cyathes = 2304 ligules, et valut 25.92 litres = 5.7049 gallons."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbfa87cf-5c85-3091-a3e3-14459a0e7367",
                        "entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "glosses": [
                            "Partie inférieure (ou urne) de la pyxide."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "228a3d37-5dcb-431f-95b8-2a79bbd8767c",
                        "source_entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "target_lang_word": "Amphora",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4024972e-56f3-4e77-86fe-ff535a47f517",
                        "source_entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "target_lang_word": "Amphore",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amphore",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                        "entry_id": "7ef70f82-94ef-3eaf-87ad-791ecab82f33",
                                        "glosses": [
                                            "bauchiges, zweihenkeliges, enghalsiges Gefäß aus Ton oder Metall, das in der Antike zur Aufbewahrung und zum Transport von Olivenöl, Wein, Honig und anderen Lebensmitteln verwendet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621e6539-7bad-4ae0-ac93-2fc5f637a95c",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Der römische Name des Weines korrespondiert natürlich mit dem antiken Weinbehälter, der Amphore."
                                            },
                                            {
                                                "example_id": "c7e88344-400a-46bd-81a1-9de1db8e13d2",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Es sind Gefäße jeder Gattung und Gestalt, von der riesigen Amphore bis zum kleinsten Näpfchen. Da sie aber nicht zu gemeinem Gebrauche benutzt wurden, konnte man an jeder Form – Amphore, Urne, Topf, Schale, Trinkhorn usw. – das Schöne und Bedeutende nach Belieben hervortreten lassen."
                                            },
                                            {
                                                "example_id": "a8db371d-26f4-498f-8263-94c7be80fcfd",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Er ergriff mit beiden Armen eine hüftenhohe Amphore, neigte sie, kauerte nieder und trank in gierigen Zügen."
                                            },
                                            {
                                                "example_id": "f1c8f65f-cfa7-40dd-b2a9-41a0ce3ff672",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Sie saßen um eine dicke Amphore, die man ihnen überlassen hatte."
                                            },
                                            {
                                                "example_id": "6513b284-1665-4bff-a83a-379ec4ab00c3",
                                                "sense_id": "6e8c23c9-d312-3d32-b546-57bb57d59660",
                                                "text": "Das 50 Meter lange Schiff sank, den Laderaum voller Luxusartikel: kostbaren Schmucks, bronzener Frauenkörper, Amphoren mit raren Weinen und reichlich Bargeld."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d9eca3b-3018-47c2-9dbd-c5af2da7cda4",
                        "source_entry_id": "4837f3af-bf31-3e96-aa59-0a5a422d9623",
                        "target_lang_word": "amphora",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amphora",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b07aab0-6aa9-36f9-84db-343802c6851c",
                                        "entry_id": "c115b2dc-afd7-378c-b95c-479a8c4d42ad",
                                        "glosses": [
                                            "A large vessel, especially a thin-necked clay vat used in ancient Greece and Rome for storing and transporting wine and oil."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22a062db-4bf9-482a-80c9-9c3472f6876b",
                                                "sense_id": "9b07aab0-6aa9-36f9-84db-343802c6851c",
                                                "text": "By concurrent use of panel decoration and concentric-circle ornament, and by free employment of red paint, the fully developed style of the Geometric Period attains a wide range of rich and elaborate effects. These are best displayed on the necks and shoulders of the very large amphorai which are characteristic of this period."
                                            },
                                            {
                                                "example_id": "c1414c3d-04d2-42a4-8819-5fcf627ffa8b",
                                                "sense_id": "9b07aab0-6aa9-36f9-84db-343802c6851c",
                                                "text": "A complete set for a ten-man symposion (an ordinary size) with ten deep cups, ten shallow cups, two mixing-bowls, two wine-jugs, two hydriai, two amphorai would cost in the neighbourhood of forty drachmai, and that would not be an unreasonable price for a rich man for a special occasion."
                                            },
                                            {
                                                "example_id": "bf914d53-8799-4a01-aea5-e01cb717e991",
                                                "sense_id": "9b07aab0-6aa9-36f9-84db-343802c6851c",
                                                "text": "Traditionally, the style of an artefact has been separated from its function. Thus, the function of a Greek pot – defined in terms of whether it was intended for transportation (hydriai or large amphorai), storage (pithoi and some kraters), distribution (oinokhoai) or consumption (cups, skyphoi and plates) – tends to be treated separately from any painted decoration on its surface."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f7d9bb6-aa5a-3bc4-8974-2671419e513d",
                                        "entry_id": "c115b2dc-afd7-378c-b95c-479a8c4d42ad",
                                        "glosses": [
                                            "A Roman unit of liquid measure reckoned as the volume of 80 Roman pounds of wine and equivalent to about 26 L although differing slightly over time."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e66544a5-1637-3e8e-a748-5d47e300bc79",
                                        "entry_id": "c115b2dc-afd7-378c-b95c-479a8c4d42ad",
                                        "glosses": [
                                            "A Roman unit of ship capacity, similar to tonnage."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53ab734f-203a-30e1-9afb-646168ed0a73",
                                        "entry_id": "c115b2dc-afd7-378c-b95c-479a8c4d42ad",
                                        "glosses": [
                                            "A lower valve of a fruit that opens transversely."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
