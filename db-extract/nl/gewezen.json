                "senses": [
                    {
                        "sense_id": "8cf7bda0-efd1-3b17-9b74-af2050b95583",
                        "entry_id": "a1caa34d-329d-3a9f-93dc-de2bad46de73",
                        "glosses": [
                            "vroegere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c03eed7-670d-41cb-8a11-ff84131a9fb8",
                                "sense_id": "8cf7bda0-efd1-3b17-9b74-af2050b95583",
                                "text": "De gewezen minister is gisteren overleden."
                            },
                            {
                                "example_id": "3c3919a8-ef3a-4c10-a1ad-d44b9abe8ce1",
                                "sense_id": "8cf7bda0-efd1-3b17-9b74-af2050b95583",
                                "text": "Het blijft verpletterend stil onder de prominente Democraten in Amerika. De Clintons, Obama, Pelosi – je hoort ze niet over de brute aanvallen van Trump op hun partij en op hun gewezen leider Joe Biden die hij „de slechtste president ooit” durfde te noemen. De enige die fel van zich laat horen, is good, very old (83) Bernie Sanders."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ae46e41-6f5d-4d00-808a-58732728f606",
                        "source_entry_id": "a1caa34d-329d-3a9f-93dc-de2bad46de73",
                        "source_sense_id": "8cf7bda0-efd1-3b17-9b74-af2050b95583",
                        "source_sense_description": "vroegere",
                        "target_lang_word": "ehemalig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehemalig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                        "entry_id": "0b5f42f5-4e56-302b-9c41-31f1c7b56c34",
                                        "glosses": [
                                            "nicht mehr existent oder nicht mehr bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4df7f26-743d-4ce7-bd5a-e80c9aa4e1af",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "Ich hab gestern meinen ehemaligen Chef getroffen."
                                            },
                                            {
                                                "example_id": "d739c384-d54e-4e88-bc77-ef01aa5108f6",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Das kann auch nicht jeder behaupten, dass sein ehemaliger Spanischlehrer der Direktor des Phallusmuseums ist, denke ich.“"
                                            },
                                            {
                                                "example_id": "98871611-ea1d-4864-893a-a46f5998ca92",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Die zerklüftete Kraterlandschaft der ehemaligen Braunkohletagebaus ist eine faszinierende, menschengemachte Landschaft.“"
                                            },
                                            {
                                                "example_id": "e3dba4b6-6d2f-48b3-9fd5-904f470b266d",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "5e5c88ed-1f1a-474e-abe8-1ac96b77fc8c",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Der ehemalige US-Präsident Trump hat im Prozess um manipulierte Vermögenswerte die vom Gericht neu festgelegte Kaution über 175 Millionen Dollar hinterlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a348928-f290-41ae-9e7b-fbc3c3a6e0ce",
                        "source_entry_id": "a1caa34d-329d-3a9f-93dc-de2bad46de73",
                        "source_sense_id": "8cf7bda0-efd1-3b17-9b74-af2050b95583",
