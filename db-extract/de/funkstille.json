                    {
                        "sense_id": "74605e32-3443-3cc9-9132-8fe6f7095585",
                        "entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "glosses": [
                            "Zeit, in der nicht gefunkt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ca17491-ce81-42b4-b3ee-9c82b0183727",
                                "sense_id": "74605e32-3443-3cc9-9132-8fe6f7095585",
                                "text": "„Es herrscht Funkstille wie vor jedem Angriff. Funkstille und Ruhe. Es ist die schwüle, unheilsschwangere Ruhe vor dem Höllengewitter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8d936fe5-c352-36c1-a76b-0d998df122c6",
                        "entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "glosses": [
                            "Pause zwischen Rundfunksendungen"
                        ],
                        "tags": [
                            "Rundfunk"
                        ],
                        "examples": [
                            {
                                "example_id": "fbd48b19-7902-40f1-b5f2-c8d8e11bb397",
                                "sense_id": "8d936fe5-c352-36c1-a76b-0d998df122c6",
                                "text": "Schon ab Mittwoch hätte es zu einer Funkstille bei mehreren UKW-Sendern kommen können."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "dd576e9c-1bcf-37b3-960f-ee94aa9674e7",
                        "entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "glosses": [
                            "Situation, in der zwei Personen/Parteien meist wegen eines Streits nicht mehr miteinander kommunizieren"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "83ac5728-7e07-4169-93d9-55c93fedc4d0",
                                "sense_id": "dd576e9c-1bcf-37b3-960f-ee94aa9674e7",
                                "text": "Seit dem Streit über die Wahl des Urlaubsortes herrscht in ihrer Beziehung Funkstille."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8744714a-f894-4006-8983-1b97a36025a8",
                        "source_entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "source_sense_id": "74605e32-3443-3cc9-9132-8fe6f7095585",
                        "source_sense_description": "Zeit, in der nicht gefunkt wird",
                        "target_lang_word": "radio silence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radio silence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8c3c14a-32b6-377f-aefa-496afa805ee3",
                                        "entry_id": "c98196e9-a8d0-3195-9844-3a83ddf07fc2",
                                        "glosses": [
                                            "A status maintained where all fixed or mobile radio stations in an area stop transmitting (sometimes limited to certain frequency bands)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ea6baf1-7a2d-36ab-8121-0120cc579d75",
                                        "entry_id": "c98196e9-a8d0-3195-9844-3a83ddf07fc2",
                                        "glosses": [
                                            "The period of time during which this status exists."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92227f73-05f0-3f28-b140-6c6c6ed13dfe",
                                        "entry_id": "c98196e9-a8d0-3195-9844-3a83ddf07fc2",
                                        "glosses": [
                                            "A period of time during which nothing is heard from a person or organization, especially when such communication would normally be expected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68bab0f2-926b-42b5-8785-ba6fd69dda19",
                                                "sense_id": "92227f73-05f0-3f28-b140-6c6c6ed13dfe",
                                                "text": "After the abuse scandal, the company went into complete radio silence."
                                            },
                                            {
                                                "example_id": "bf683376-1711-432b-b4b5-3c46bb77cb03",
                                                "sense_id": "92227f73-05f0-3f28-b140-6c6c6ed13dfe",
                                                "text": "\"No messages, actually. Total radio silence on her end all day.\""
                                            },
                                            {
                                                "example_id": "286fac72-38c4-4860-b56f-d2e6f088cb66",
                                                "sense_id": "92227f73-05f0-3f28-b140-6c6c6ed13dfe",
                                                "text": "That was more than Ms. Solomon and many of her colleagues had heard internally. “Radio silence,” she said. She began to vent her frustration on Twitter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faa6eeaa-fb16-4040-8e5e-f34ae70c6c70",
                        "source_entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "source_sense_id": "74605e32-3443-3cc9-9132-8fe6f7095585",
                        "source_sense_description": "Zeit, in der nicht gefunkt wird",
                        "target_lang_word": "silence radio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silence radio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69370ad8-128b-30f4-b05e-0ada952aff66",
                                        "entry_id": "34c1b372-2cdf-3587-afce-b49dd5b59918",
                                        "glosses": [
                                            "Interruption des communications radio pour éviter de se faire repérer par l’ennemi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5c3e09-3e2a-42dd-845f-ce76df7babfe",
                                                "sense_id": "69370ad8-128b-30f4-b05e-0ada952aff66",
                                                "text": "Il faut dire que les marins hébreux, qui conduisirent les vedettes, en six jours et six nuits, à pleine vitesse, de Cherbourg à Haïfa, observant un silence radio absolu qui leur permit d’échapper aux recherches de la Marine nationale, n’auraient pu réussir pareil coup d’éclat sans l’aide de militaires français."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa19c4b-d1e2-3e9f-a9ca-d7ee648d1d15",
                                        "entry_id": "34c1b372-2cdf-3587-afce-b49dd5b59918",
                                        "glosses": [
                                            "Silence total ; fait de ne répondre à aucune sollicitation, de ne rien publier."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b29172-e167-4a19-8df6-d08583b531b5",
                                                "sense_id": "8fa19c4b-d1e2-3e9f-a9ca-d7ee648d1d15",
                                                "text": "Si on l’avait oublié c’est que cette commission nommée par l’Église n’a rien produit de public. Seuls les noms de ses membres ont été publiés à sa création. Et depuis, silence radio. On cherche en vain un mandat de la part des évêques et des préconisations en retour de la part de ses membres…."
                                            },
                                            {
                                                "example_id": "a51a9687-8d21-46d7-b30b-2b8baa8824fa",
                                                "sense_id": "8fa19c4b-d1e2-3e9f-a9ca-d7ee648d1d15",
                                                "text": "Pour les proches aidants, le même silence radio régnait. En entrevue, la ministre Blais s’est dite « très fière » d’y avoir mis fin."
                                            },
                                            {
                                                "example_id": "80d7c547-de90-477c-a7d7-ce4512c26f17",
                                                "sense_id": "8fa19c4b-d1e2-3e9f-a9ca-d7ee648d1d15",
                                                "text": "Mais comme il s’agit d’Haïti, silence radio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2afdd5-f4ee-43aa-ac67-81294e0bcb06",
                        "source_entry_id": "9ccecf5e-0665-3d6e-b19c-49cd63a00ee8",
                        "source_sense_id": "dd576e9c-1bcf-37b3-960f-ee94aa9674e7",
                        "target_lang_word": "malaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "malaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47138d67-0482-3343-91fe-08a038bc2201",
                                        "entry_id": "f76125b4-d9a2-3c54-8139-d2481eefff6a",
                                        "glosses": [
                                            "Trouble plus ou moins léger de la santé, qui ne peut guère se localiser avec précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aff41b8-ce7b-48bd-9d5f-b8a6a9a4c8bd",
                                                "sense_id": "47138d67-0482-3343-91fe-08a038bc2201",
                                                "text": "Et tout le village bientôt, à des degrés variant selon la constitution et la force de résistance de chacun, fut en proie à des malaises étranges, symptômes inexplicables d’empoisonnement."
                                            },
                                            {
                                                "example_id": "64057dd4-72ee-4fd1-941e-22f812a094e6",
                                                "sense_id": "47138d67-0482-3343-91fe-08a038bc2201",
                                                "text": "Il s’agit de faire face à la bobologie courante, mais également aux malaises et déshydratations potentielles liées aux fortes chaleurs qui auront lieu pendant l’intégralité du festival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4059e692-6be6-323d-a02b-b62526929f70",
                                        "entry_id": "f76125b4-d9a2-3c54-8139-d2481eefff6a",
                                        "glosses": [
                                            "Sorte d’inquiétude ou de gêne résultant de causes obscures."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f76bb505-a874-4385-aed9-3b062f9e7834",
                                                "sense_id": "4059e692-6be6-323d-a02b-b62526929f70",
                                                "text": "Il y avait en lui ce vague malaise qu’on éprouve quand on s’est arrangé pour oublier un devoir qu’on s’était prescrit."
                                            },
                                            {
                                                "example_id": "9f793ec9-b20d-43bc-ae07-9dbc73d16840",
                                                "sense_id": "4059e692-6be6-323d-a02b-b62526929f70",
                                                "text": "Mais dans le même temps qu'elle admirait les robes, Francie éprouvait un étrange malaise. Ses yeux voyaient bien les couleurs, le cerise, l'orange, le bleu vif, le rouge et le jaune, mais elle avait l’impression qu'une chose sournoise se cachait derrière les costumes : […]."
                                            },
                                            {
                                                "example_id": "2cca4c95-71de-47d0-a5af-0f5158fb6b39",
                                                "sense_id": "4059e692-6be6-323d-a02b-b62526929f70",
                                                "text": "À l’instant, je me sens au milieu de nulle part. C’est une sensation de malaise indescriptible, un inconfort inqualifiable."
                                            },
                                            {
                                                "example_id": "c9f93069-721f-4810-a455-7911c7e1aec7",
                                                "sense_id": "4059e692-6be6-323d-a02b-b62526929f70",
                                                "text": "Il retrace les méandres, les scoumounes qui ont conduit ces grands enfants du malaise collectif à ces cellules réglementaires de 3 × 3 mètres. Dire les maux avec mots, ceux de Djamel, David, Laurent, Séfia, Frédéric, Damien, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94a4f146-0e58-32fa-8e4b-486399b8fa26",
                                        "entry_id": "5cf152fb-bcea-384d-b0b4-115e0b543ef1",
                                        "glosses": [
                                            "Féminin singulier de malais."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091e0bc0-3e2d-4071-9ba1-c5f401a10b44",
                                                "sense_id": "94a4f146-0e58-32fa-8e4b-486399b8fa26",
                                                "text": "Les Britanniques imposent leur protectorat aux sultanats de la péninsule malaise par étapes, de 1874 à 1914, et s'assurent par ailleurs le contrôle du Sarawak, de Bornéo du Nord (actuel Sabah) et de Brunei."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "malaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "530fd8aa-e2d0-3eac-91b9-e55ec87e56c6",
                                        "entry_id": "e869cde5-3f45-3761-bb37-7b83b34ff913",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de malaiser."
                                        ],
