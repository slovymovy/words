                                "target_senses": [
                                    {
                                        "sense_id": "1ea02eb6-4431-35c4-9b1c-6066d3e2d931",
                                        "entry_id": "2ba0bd5a-331d-3b4d-bb4f-2efec2f7882d",
                                        "glosses": [
                                            "Thermomètre qui sert à évaluer les hautes températures."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e451f713-5dbf-41ef-ac91-847606cf0a0e",
                                                "sense_id": "1ea02eb6-4431-35c4-9b1c-6066d3e2d931",
                                                "text": "Le pyromètre de Ferry est une combinaison d’un pyromètre électrique et d’un système optique."
                                            },
                                            {
                                                "example_id": "b3a7e27a-289f-41b2-b4a2-0cffd8f983f6",
                                                "sense_id": "1ea02eb6-4431-35c4-9b1c-6066d3e2d931",
                                                "text": "Sous ses jolis et tranquilles bandeaux plats, Césarine cachait une nature à faire péter tous les pyromètres du Creusot."
                                            }
                                        ]
                                    }
                                ]
                            }
