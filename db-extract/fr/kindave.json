                                "example_id": "e95405c4-aa96-4413-868b-b4f5ec070445",
                                "sense_id": "8c25fd23-2643-3218-b8ac-7117f1e47124",
                                "text": "wAllah tu kindave khey, lave tes chicots avant j’me zehef"
                            }
