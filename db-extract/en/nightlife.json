                        "target_lang_word": "nachtleven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nachtleven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "70c69d4c-88e6-30de-9066-fa5c0246b19b",
                                        "entry_id": "8ede556c-6632-3d5f-9e0d-07debcedf4e3",
                                        "glosses": [
                                            "de wereld van het uitgaan dat meestal 's-nachts plaatsvindt in cafés en nachtclubs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cec8ff5-093a-4459-8e08-ed3c35bd17ba",
                                                "sense_id": "70c69d4c-88e6-30de-9066-fa5c0246b19b",
                                                "text": "De jonge vakantiegangers leefden zich helemaal uit in het nachtleven van Amsterdam."
                                            },
                                            {
                                                "example_id": "88ae496b-9687-480a-ae61-250d4ca812f4",
                                                "sense_id": "70c69d4c-88e6-30de-9066-fa5c0246b19b",
                                                "text": "Door het nachtleven is het op de spoedpost van het ziekenhuis ook midden in de nacht heel druk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "960f1085-d139-426e-9751-d0c6b83dbe05",
                        "source_entry_id": "13e90431-f640-30e0-b880-c6eb96e241a9",
                        "source_sense_id": "0141975a-087b-3212-b83a-5e8e9ee90cea",
                        "source_sense_description": "Selection of nocturnal activities",
                        "target_lang_word": "uitgaansleven",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uitgaansleven",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "892f910a-4d0a-3dab-b99b-eb90ff19e4b8",
                                        "entry_id": "cb270987-6e8f-3c6d-a4e8-6714bf5e7eba",
                                        "glosses": [
                                            "alles wat te maken heeft met het vermaak buiten de eigen woning"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee6dee4-0304-44e9-891f-5251874581d0",
                                                "sense_id": "892f910a-4d0a-3dab-b99b-eb90ff19e4b8",
                                                "text": "Hij logeert nu al een maand bij mij, en dit is de eerste keer dat ik hem in het uitgaansleven zie."
                                            },
                                            {
                                                "example_id": "8e40e547-8890-4870-a708-37cc195b4d01",
                                                "sense_id": "892f910a-4d0a-3dab-b99b-eb90ff19e4b8",
                                                "text": "Studenten vinden de stad aan de IJssel steeds minder aantrekkelijk. Na de kunstacademie verdween ook de laatste hogeschool uit Kampen \"Studenten van de TU komen nu alleen elkaar tegen in het uitgaansleven\", zei bestuurslid Pim Boven in mei 2020 bij RTV Oost."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fbc08d8-647c-4c64-a178-a6ddd1080360",
                        "source_entry_id": "13e90431-f640-30e0-b880-c6eb96e241a9",
                        "source_sense_id": "0141975a-087b-3212-b83a-5e8e9ee90cea",
