                "senses": [
                    {
                        "sense_id": "eb562393-22f6-3b3b-818c-90f2b7e03122",
                        "entry_id": "945a69c3-573c-3a7b-a605-51a365d7574a",
                        "glosses": [
                            "Organisation der Schwarzen Bürgerrechtsbewegung in den USA"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6d1a701-276e-4daf-aa07-1fc4396d9018",
                                "sense_id": "eb562393-22f6-3b3b-818c-90f2b7e03122",
                                "text": "„Vertreter der Bürgerrechtsbewegung NAACP forderten eine Untersuchung, aber die Polizeiführung mauerte und behauptete steif und fest, es sei niemand verprügelt worden.“"
                            },
                            {
                                "example_id": "34cc936f-1a89-4598-9bda-7748b1cceb59",
                                "sense_id": "eb562393-22f6-3b3b-818c-90f2b7e03122",
                                "text": "„Nach dem Mittagessen wird sich meine Frau mit dem Cheflobbyisten der NAACP unterhalten, ein Termin, zu dem ihr Vater, der Colonel, ihr verholfen hat, der ebenfalls über gute Beziehungen verfügt.“"
                            },
                            {
                                "example_id": "16636b07-d70b-4c4a-a020-12a2355e9904",
                                "sense_id": "eb562393-22f6-3b3b-818c-90f2b7e03122",
                                "text": "„Eustace Hunt – er ist erst seit ein paar Jahren Sheriff, aber die NAACP hat eine dicke Beschwerdeakte über ihn.“"
                            },
                            {
                                "example_id": "507eddc0-590a-436a-a97b-73f178f9c2ed",
                                "sense_id": "eb562393-22f6-3b3b-818c-90f2b7e03122",
                                "text": "„UAES, SLDC, NAACP, AFL, die Liga für demokratische Ideale und besorgte Amerikaner wider den Rassenhass. Alles hochtönende Organisationen, denen anzugehören jeder gute Amerikaner stolz sein sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
