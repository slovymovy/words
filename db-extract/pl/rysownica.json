                ],
                "senses": [
                    {
                        "sense_id": "7285d2c4-8a43-3e4c-b787-5b0416d70fc8",
                        "entry_id": "c031191d-a2e9-3302-a7aa-575f3ce980f2",
                        "glosses": [
                            "gładka deska w kształcie prostokąta, na której rozpina się kartkę papieru w celu łatwiejszego rysowania, kreślenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd0593af-03ed-49fd-b26a-d5d5403cf7dd",
                                "sense_id": "7285d2c4-8a43-3e4c-b787-5b0416d70fc8",
                                "text": "], 1953-11-16."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7f0a5b5-d501-466d-8805-96626c729929",
                        "source_entry_id": "c031191d-a2e9-3302-a7aa-575f3ce980f2",
                        "source_sense_id": "7285d2c4-8a43-3e4c-b787-5b0416d70fc8",
                        "target_lang_word": "drawing board",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drawing board",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4489215a-906d-34ca-bdf8-4f8567ed9432",
                                        "entry_id": "3af9d168-bc95-3b94-9ba9-56fc346b2bf5",
                                        "glosses": [
                                            "A plane surface or table to which paper can be fastened for drawing purposes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd1d2647-65be-4a5a-834e-2a2fa7aa2786",
                                                "sense_id": "4489215a-906d-34ca-bdf8-4f8567ed9432",
                                                "text": "The T square, used by architects, makes very good parallels, if made to slide along the smooth edge of a drawing board, or a straightedge laid and kept steady on the paper."
                                            },
                                            {
                                                "example_id": "93113b50-9bc5-44f4-a8d3-53bb13e3234b",
                                                "sense_id": "4489215a-906d-34ca-bdf8-4f8567ed9432",
                                                "text": "The Drawing-Board is a smooth board, […] very accurately rectangular, with its edges quite smooth. Upon this board drawing-paper is usually fixed, and evenly stretched, by means of glue or paste applied to a small strip of paper all round, which it is not intended to retain in the drawing."
                                            },
                                            {
                                                "example_id": "f973497b-3fe2-4752-ac4d-2de4fb2e9651",
                                                "sense_id": "4489215a-906d-34ca-bdf8-4f8567ed9432",
                                                "text": "As we explored the second floor of the building, we were pleasantly surprised to find a group of artists working away at their drawing boards. Without knowing it, we had stumbled into Walt Disney's Comic Strip department."
                                            },
                                            {
                                                "example_id": "55c23b4b-a3fe-4ef3-845d-a92787dd1139",
                                                "sense_id": "4489215a-906d-34ca-bdf8-4f8567ed9432",
                                                "text": "So much of what followed from the drawing boards of others will have been designed with the demands, effort and grandeur of Primrose Hill [tunnel] in the back of their minds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                        "entry_id": "3af9d168-bc95-3b94-9ba9-56fc346b2bf5",
                                        "glosses": [
                                            "The planning stage of a project."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "122b58fc-5cdb-46c5-a67c-7d3d9aad6021",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "At the time we doubted that such a locomotive would be given swift consideration—at least in detail; but the evidence suggests that one is already on the drawing board and will appear next year."
                                            },
                                            {
                                                "example_id": "3122e2d3-8fce-4249-9af5-1b1d64e92744",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "Following every economic crisis, political leaders, finance ministers, central bank governors, policy makers, academics and other interested parties hurry back to their drawing boards to rethink and redraw the rules or \"architecture\" governing both the national and international economic order."
                                            },
                                            {
                                                "example_id": "c0b09bed-3d68-48d5-a2eb-23e698687bc4",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "Localization makes use of a process known as postponement, which refers to the method by which the commitment of a product to its final form or destination is delayed. When decisions on the final product configuration are made ahead of market demand, there is the risk that the products that are in finished goods are not what the customer demands. The philosophy of postponement ideally begins on the drawing board when the products are designed with late configuration in mind."
                                            },
                                            {
                                                "example_id": "54bedc95-43b5-459d-b368-66d2a01c2d8f",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "Although the oft-mentioned plans to diversify the economy are off the drawing board for now, Europe and China still need Russian oil and gas, and export markets for grains, NPPs and weapons continue to expand."
                                            },
                                            {
                                                "example_id": "ea196071-8b08-4e2c-a958-24a3e43cb064",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "Freightliner has advocated the long-planned development of Ripple Lane as a nodal yard. Its redevelopment, to accommodate roads up to 700 metres long, was listed in the London Freight Strategy of 2022 but hasn't gone beyond the drawing board."
                                            },
                                            {
                                                "example_id": "dfde5bf4-c0c1-4eed-998a-ed027e376700",
                                                "sense_id": "abe1d139-28b8-3423-9b26-7eb21d4fcb57",
                                                "text": "Heading into the international break, Guardiola will return to the drawing board, wondering how he can restore his side to their previous heights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
