                {
                    "sense_id": "1f4db466-58d2-3956-a59b-32b90052ce38",
                    "sense_definition": "dient in Fragen zur Erkundigung nach einer oder mehreren bestimmten Personen oder Sachen aus einer Gruppe",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Welche</w> von beiden Optionen hältst du für die beste Lösung?"
                        },
                        {
                            "text": "<w>Welche</w> Aufgaben müssen wir bis morgen unbedingt noch erledigen?"
                        }
                    ],
                    "common_phrases": [
