                                "target_senses": [
                                    {
                                        "sense_id": "1d7ae087-34f1-3e9a-a3a6-ae3765a0904f",
                                        "entry_id": "b6a88b4e-6937-3384-a9c4-365512d35a5b",
                                        "glosses": [
                                            "najwyższy kunszt w czymś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190465dd-1a36-451e-824f-39467222b453",
                                                "sense_id": "1d7ae087-34f1-3e9a-a3a6-ae3765a0904f",
                                                "text": "Doprowadziłem mianowicie do prawdziwego wirtuozostwa sztukę niedowiadywania się"
                                            },
                                            {
                                                "example_id": "b50b4474-943c-4b4f-8171-fa86ef9f464b",
                                                "sense_id": "1d7ae087-34f1-3e9a-a3a6-ae3765a0904f",
                                                "text": "Następnie odkroiłem sobie łapkę kurzą, lecz usta moje zapomniały o pracy na widok wirtuozostwa, z jakiem mój gospodarz ogołocił szkielet kury z mięsa i wsunął je sobie między szczęki"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36625b0d-00df-46c9-9203-c18b0e5f6199",
                        "source_entry_id": "3fbba8d0-fcd3-3c13-bcd7-26ca3928b52d",
                        "source_sense_description": "technical skills and fluent style of a virtuoso",
                        "target_lang_word": "wirtuozerstwo",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wirtuozerstwo",
