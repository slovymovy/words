                ],
                "senses": [
                    {
                        "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                        "entry_id": "a37d73a2-ce26-3374-ab61-0eb3e3c2bc2e",
                        "glosses": [
                            "gemessener Gehalt an Laktat (Milchsäure) im Blut beziehungsweise Serum; physiologischer Marker zur Beurteilung (unter anderem) verschiedener Stoffwechselprozesse, der körperlichen Belastungsfähigkeit und des Trainingszustands"
                        ],
                        "tags": [
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "d31a1f0a-6b40-485a-b8bb-c3f5d649ef5a",
                                "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                                "text": "„Für mich gibt der Laktatwert Aufschluss darüber, wie weit die Mannschaft belastet und wie weit die Fitness da ist - und wie wir die Trainingssteuerung in den nächsten drei Monaten auslegen müssen.“"
                            },
                            {
                                "example_id": "50482786-3a2d-473e-9ea2-65b3308b703d",
                                "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                                "text": "„Die Energiebereitstellung im Wettkampf erfolgt zu etwa 80 Prozent aerob, zudem ist eine hohe anaerobe Mobilisationsfähigkeit erforderlich, so dass nach den Rennen maximale Laktatwerte von 15-20 mmol/l gemessen werden.“"
                            },
                            {
                                "example_id": "20890476-796f-42f2-ba45-8c9ef1d8e965",
                                "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                                "text": "„Die erbrachte Geschwindigkeit, Herzfrequenz, Spirometrie- und Laktatwerte auf dem Laufband werden für jede Belastungsstufe erfasst und anschließend analysiert.“"
                            },
                            {
                                "example_id": "276a8251-f735-4ca4-85b1-bb8f751ee447",
                                "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                                "text": "„So wurden sehr niedrige Ruhepulswerte, Hämoglobinwerte von über 16 g/dl, Laktatwerte von über 28 mg/dl und Lungenvolumina von über 10 Litern (Vitalkapazität) ermittelt.“"
                            },
                            {
                                "example_id": "23dd27b0-1c71-436a-8be4-146f63c5136f",
                                "sense_id": "7663374c-a256-3f91-830d-ab0dd74af26a",
                                "text": "„Bei einem Laktatwert unter 6 mmol/l beträgt die Überlebensrate 99 %.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
