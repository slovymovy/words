                                        "entry_id": "112630cb-497a-3546-a0e3-9ec2ce456df7",
                                        "glosses": [
                                            "miasto w północno-wschodniej Estonii, na granicy z Rosją, nad rzeką Narwą (1.2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e127a20-14dc-4334-8a8d-999d382bc831",
                                                "sense_id": "bacbb734-81fa-33cd-bc72-c8c563b7dab5",
                                                "text": "Strategiczne położenie Narwy spowodowało, że w jej okolicach rozgrywało się wiele konfliktów zbrojnych."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
