                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9dad20-57c7-45bb-ae64-6a410313f491",
                                "sense_id": "609f8e5b-35d0-3aee-a569-b640287af4f0",
                                "text": "Chociaż w połowie biegu miał najlepszy międzyczas, ostatecznie przybiegł drugi."
