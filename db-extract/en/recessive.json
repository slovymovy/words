                    },
                    {
                        "sense_id": "442b1532-6dcd-339b-99c7-74351fb52b6a",
                        "entry_id": "e2cebe7b-4280-3f05-88c2-8923addeb620",
                        "glosses": [
                            "Able to be masked by a dominant allele or trait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e86902-2dd9-4877-8698-6c0a5ceb16c0",
                                "sense_id": "442b1532-6dcd-339b-99c7-74351fb52b6a",
                                "text": "1944 June 21, James A. G. Rehn, South African Bird-Locust Records and Notes (Orthoptera; Acrididae; Cyrtacanthacridinae; Group Cyrtacanthacres), Notulae Naturae, Number 137, Academy of Natural Sciences of Philadelphia, page 3,\nThe Lydenburg male and the other two females have the infuscate pattern definitely more recessive and less evident, although traceable."
                            },
                            {
                                "example_id": "1985ac81-8ff3-4563-8ed8-2a9f9d2d6436",
                                "sense_id": "442b1532-6dcd-339b-99c7-74351fb52b6a",
                                "text": "This plan takes advantage of the fact that barless is the most recessive of a series of alleles."
                            },
                            {
                                "example_id": "a3241068-f677-4c56-85c7-d2257ce2adca",
                                "sense_id": "442b1532-6dcd-339b-99c7-74351fb52b6a",
                                "text": "The series of murine Agouti alleles is a consistent array as it progresses from the most recessive to the most dominant allele (Jackson, 1994)."
                            }
                        ]
                    },
                    {
                        "sense_id": "69f47575-8010-3436-ab0c-36b4fb6be7e9",
                        "entry_id": "e2cebe7b-4280-3f05-88c2-8923addeb620",
                        "glosses": [
                            "Not dominant; whose effect is masked by stronger effects."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "51298bd1-3474-4988-91ef-7d33b6158319",
                                "sense_id": "69f47575-8010-3436-ab0c-36b4fb6be7e9",
                                "text": "The worker–client relationship is more recessive and has a more catalytic and enabling quality."
                            },
                            {
                                "example_id": "21f0b30f-fa9c-482e-98a4-e80c931dfa7e",
                                "sense_id": "69f47575-8010-3436-ab0c-36b4fb6be7e9",
                                "text": "The law-making or legislative component was the most recessive component of the legal system of hunter-gatherers, although decisions or advice given by mediators were remembered and used again to settle similar violations of rules or disputes among parties."
                            }
                        ]
                    }
                ],
