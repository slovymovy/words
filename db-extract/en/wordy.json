    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4a55a61a-e351-311f-97cd-48656cccc095",
                "word": "wordy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ed089729-d2b9-496a-a5b1-2fca7d823696",
                        "entry_id": "4a55a61a-e351-311f-97cd-48656cccc095",
