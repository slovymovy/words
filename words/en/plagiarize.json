    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e5531e3-ad1e-357c-b224-a08fec31cde6",
                    "sense_definition": "To use and pass off someone else's writing, ideas, or creative work as one's own, especially in an academic or professional context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university decided to expel the student after he was caught trying to <w>plagiarize</w> his entire final thesis.",
                            "target_lang_translations": {
                                "ru": "Университет решил отчислить студента после того, как его поймали на попытке <w>выдать за свою</w> всю его дипломную работу."
                            }
                        },
                        {
                            "text": "It is strictly forbidden to <w>plagiarize</w> someone else's work because it violates the core principles of academic integrity.",
                            "target_lang_translations": {
                                "ru": "Строго запрещено <w>заниматься плагиатом</w> чужих работ, так как это нарушает основные принципы академической этики."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "steal",
                        "pirate",
                        "lift"
                    ],
                    "antonyms": [
                        "attribute",
                        "credit",
                        "originate"
                    ],
                    "common_phrases": [
                        "plagiarize someone else's work",
                        "plagiarize an article",
                        "accused of plagiarizing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать и выдавать чужие тексты, идеи или творческие работы за свои собственные, особенно в академической или профессиональной среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься плагиатом",
