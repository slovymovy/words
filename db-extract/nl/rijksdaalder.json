                        "translation_id": "a47de51b-964f-40d9-a8ad-e589cf1b9c65",
                        "source_entry_id": "b98478cf-a8f7-31c8-90b7-ff2669ba0e62",
                        "source_sense_id": "90053ec3-165c-381c-bf49-d6af2a4dc182",
                        "target_lang_word": "rix-dollar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rix-dollar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "643de1e2-ceec-393f-9c61-8691d846997e",
                                        "entry_id": "f3b587df-a237-3840-b1fb-b1ddfd532892",
                                        "glosses": [
                                            "A silver coin and money of account in use from the late-16ᵗʰ to the mid-19ᵗʰ centuries in the European Teutonic countries and their imperial trading networks."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cb28f6-a8ea-416d-9a0b-3703fcf1518c",
                                                "sense_id": "643de1e2-ceec-393f-9c61-8691d846997e",
                                                "text": "At all other times they would receive the regular salary of thirty rix-dollars monthly."
                                            },
                                            {
                                                "example_id": "a3d5056d-e7ca-4e31-a4de-97347a473b40",
                                                "sense_id": "643de1e2-ceec-393f-9c61-8691d846997e",
                                                "text": "He sent for the celebrated necromancer who lived at the sign of the Goatskin and whose familiar spirit so plagued the thief that he returned the stolen goods to their rightful owner, for which the sorcerer was paid ten rix-dollars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2437c6a5-51e1-35e7-babe-d1e5c0bc8abf",
                                        "entry_id": "f3b587df-a237-3840-b1fb-b1ddfd532892",
                                        "glosses": [
                                            "A unit of currency introduced into certain former European colonies such as Cape Province and Ceylon."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ff4dc70-706e-4244-8719-6fcaff647c6c",
                                                "sense_id": "2437c6a5-51e1-35e7-babe-d1e5c0bc8abf",
                                                "text": "Such had the business become before Lord Somerset left, that in 1821 no less than 196 horses were shipped mostly to India, for military remounts by cavalry officers. The declared value was 56,980 rix dollars, which the then currency represented, an average of about £20 per head, or a total of £4,273."
                                            },
                                            {
                                                "example_id": "771b5c8c-ada6-437d-9ad0-9e5c840e1c96",
                                                "sense_id": "2437c6a5-51e1-35e7-babe-d1e5c0bc8abf",
                                                "text": "The Dutch monetary system of a rix-dollar or rijksdaalder of 48 stuiver was continued [in Cape Province] by the British in the early nineteenth century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
