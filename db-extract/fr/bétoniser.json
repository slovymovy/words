                "senses": [
                    {
                        "sense_id": "ba306c3a-71bb-3d8c-a066-235298d0f7f0",
                        "entry_id": "04e7d6b0-c1a3-376b-9399-0931fc7d405e",
                        "glosses": [
                            "Provoquer l’envahissement par le béton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71664772-bf53-4df5-90df-9061daaeb0a7",
                                "sense_id": "ba306c3a-71bb-3d8c-a066-235298d0f7f0",
                                "text": "Toutes ces possibilités, si elles avaient été livrées aux promoteurs qui ont bétonisé la Floride, défiguré la Côte d'Azur, désarticulé la Costa del Sol, auraient sans doute voué la Côte-d’Ivoire à un développement fructueux mais anarchique."
                            },
                            {
                                "example_id": "3bdc55ec-0ee3-4e79-9811-15055361acd3",
                                "sense_id": "ba306c3a-71bb-3d8c-a066-235298d0f7f0",
                                "text": "Je n'ai pas l’envie que la Roumanie soit «bétonisée.»"
                            }
                        ]
                    }
