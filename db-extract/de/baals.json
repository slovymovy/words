                ],
                "senses": [
                    {
                        "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                        "entry_id": "6b694988-820c-3020-ba53-e2203e6f0826",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d35a120-7a9d-4089-9361-442e9c82f1ba",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Frau Baals ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "be052b49-a79d-469f-95bf-f9da53719016",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Herr Baals wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b7631d7f-0034-4394-a9e0-57fd2690a7d4",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Die Baalsens kommen heute aus Dithmarschen."
                            },
                            {
                                "example_id": "2bfd70b0-ad7f-4ca6-93ac-41cae317b2b9",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Der Baals trägt nie die Schals, die die Baals ihm strickt."
                            },
                            {
                                "example_id": "676aaafe-7626-4a10-8845-90462df0d8fe",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baals kommt, geht der Herr Baals.“"
                            },
                            {
                                "example_id": "7b2bdca0-85bb-4da0-b912-33ab4c5a2a18",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Baals kommt und geht."
                            },
                            {
                                "example_id": "ca607a1c-76ed-4e47-97aa-59bac0cfae73",
                                "sense_id": "ab2ade93-39ed-30a4-b58f-fb14ff41338a",
                                "text": "Baalsens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
