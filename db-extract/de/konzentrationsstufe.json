                ],
                "senses": [
                    {
                        "sense_id": "1a92c3e1-00e0-3671-8c2f-d5154c49beb8",
                        "entry_id": "d25b502d-ee77-3f63-8330-1d2e33aca11c",
                        "glosses": [
                            "Grad der Fokussierung der menschlichen Aufmerksamkeit im Wetteifer"
                        ],
                        "tags": [
                            "bildsprachlich"
                        ],
                        "examples": [
                            {
                                "example_id": "bb952b3f-40e6-42da-b643-c91e4f448cf2",
                                "sense_id": "1a92c3e1-00e0-3671-8c2f-d5154c49beb8",
                                "text": "„Sportlich gesehen wird Trainer Roger Schmidt die höchste Konzentrationsstufe ausrufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02846725-7ca3-381e-9f23-a14f8f5b6252",
                        "entry_id": "d25b502d-ee77-3f63-8330-1d2e33aca11c",
                        "glosses": [
                            "bezeichneter Bereich für die Menge der Anwesenheit eines Stoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2ad6d2-5982-4679-9af6-9fe40a450baf",
                                "sense_id": "02846725-7ca3-381e-9f23-a14f8f5b6252",
                                "text": "„Soweit Gehalte von unter 5% anzugeben sind und zur Beurteilung des Gefahrenpotentials der Zubereitung nicht die Kenntnis der genauen Konzentration des Stoffes notwendig ist, kann die Konzentrationsangabe in folgenden Konzentrationsstufen erfolgen: bis unter 0,1%, 0,1% bis unter 0,5%, 0,5% bis unter 1,0%, 1,0% bis unter 1,5%,1,5% bis unter 2,0%, 2,0% bis unter 3,0%, 3,0% bis unter 4,0%, 4,0% bis unter 5,0%.“"
                            },
                            {
                                "example_id": "55a3cdd6-52e4-45ae-926e-0a1e533fc67d",
                                "sense_id": "02846725-7ca3-381e-9f23-a14f8f5b6252",
                                "text": "„Je Konzentrationsstufe und Komponente ist vom Teilnehmer ein Konzentrationswert in der Einheit μg/m³ zu ermitteln und abzuliefern.“"
                            },
                            {
                                "example_id": "b62b31a6-61f0-49e6-b99a-9f3124e811a9",
                                "sense_id": "02846725-7ca3-381e-9f23-a14f8f5b6252",
                                "text": "„In einem iterativen Prozess von Paarvergleichen (Arbeitsstoff vs. Leerprobe) wird die Konzentrationsstufe bestimmt, bei der eine Person den Arbeitsstoff gerade noch riechen kann (Geruchsschwelle) bzw. die Konzentrationsstufe, bei der sie den Arbeitsstoff richtig lateralisieren – d.h. dem linken oder rechten Nasenloch richtig zuordnen – kann (Irritationsschwelle).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "63833b90-ec73-334f-a7ed-9f775d552d60",
                        "entry_id": "d25b502d-ee77-3f63-8330-1d2e33aca11c",
                        "glosses": [
                            "Grad der Verdichtung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb81f438-0f04-41c1-b602-f8c4d4c5f5b3",
                                "sense_id": "63833b90-ec73-334f-a7ed-9f775d552d60",
                                "text": "„Eine Konzentrationsstufe eines Koppelfeldes konzentriert das Verkehrsangebot von 150 Teilnehmern auf 30 Eingänge in der nächsten Koppelfeldstufe.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
