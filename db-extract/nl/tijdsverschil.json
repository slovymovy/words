                                                "example_id": "5f241b97-b7d3-46ea-91da-94397138e43c",
                                                "sense_id": "0a547996-f5df-343b-8806-331a1c518a7e",
                                                "text": "The reſt of your Fees, O Gods, the Senators of Athens, together with the common lagge of People, what is amiſſe in them, you Gods, make ſuteable for deſtruction."
                                            }
                                        ]
