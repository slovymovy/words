                "senses": [
                    {
                        "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                        "entry_id": "b81a530f-b749-30da-a38d-4b20654134ad",
                        "glosses": [
                            "bewusste Beteiligung an einem laufenden Kampf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93249bd2-38da-44b9-a5bf-8531cf9cdfda",
                                "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                                "text": "„Für mehr als ein Jahr nach dem Ende der Kampfhandlungen blieben die Militärs die alleinigen Machthaber auf diesem Territorium.“"
                            },
                            {
                                "example_id": "bdaae456-4a67-457f-a108-4792f47a2249",
                                "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                                "text": "„Im August und September 1914 wurde Gerdauen weit mehr durch direkte Kampfhandlungen zerstört als im gesamten Zweiten Weltkrieg.“"
                            },
                            {
                                "example_id": "4638175d-1ec0-42ad-b0a6-623f12a325d4",
                                "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                                "text": "„Nach Monaten der Kampfhandlungen musste Dänemark nachgeben und durch den in Wien geschlossenen Frieden wurde Schleswig-Holstein gemeinsam von Preußen und Österreich verwaltet.“"
                            },
                            {
                                "example_id": "a2ec0b22-8792-4d6c-bab0-0616d89fa033",
                                "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                                "text": "„Vereinzelt kam es auch in der Zeit des Kalten Krieges zu Kampfhandlungen, an denen Uboote beteiligt waren.“"
                            },
                            {
                                "example_id": "e3b7e6e0-e94b-4b53-aa6a-cb758b924a37",
                                "sense_id": "0df85bd5-51fd-3765-aa49-75f3b065764c",
                                "text": "„In der Ukraine fielen Juden während des Bürgerkriegs nicht allein den unmittelbaren Kampfhandlungen zum Opfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
