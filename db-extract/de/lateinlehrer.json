                "senses": [
                    {
                        "sense_id": "53ff8fe6-8673-3d20-a8f9-f35e2270e931",
                        "entry_id": "0a47f4b4-350e-3bc8-b424-288cb5755c53",
                        "glosses": [
                            "Lehrer, der Latein unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cbb6191-8ced-4388-b5ea-04ed350d35c6",
                                "sense_id": "53ff8fe6-8673-3d20-a8f9-f35e2270e931",
                                "text": "Der Lateinlehrer überprüfte mit den Schülern die Übersetzung des „De bello Gallico“."
                            },
                            {
                                "example_id": "9f5274d2-7773-43f4-ae5f-bb16a9b5c995",
                                "sense_id": "53ff8fe6-8673-3d20-a8f9-f35e2270e931",
                                "text": "„Sein eigentliches Opfer war Krämer, der cholerische Lateinlehrer, den er so perfekt spielte, daß man ihn vor sich zu haben meinte.“"
                            },
                            {
                                "example_id": "9538e75e-8610-4059-835a-d4b20e20aa1e",
                                "sense_id": "53ff8fe6-8673-3d20-a8f9-f35e2270e931",
                                "text": "„Der Lateinlehrer mit dem römischen Profil hatte nicht dieses Vermögen, eine Klasse zu fesseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
