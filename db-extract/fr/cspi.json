                                            {
                                                "example_id": "b7a9ed9a-95b6-44e7-aba8-16c951dbb07a",
                                                "sense_id": "dfcdb67a-151e-3813-a13c-90e46e1971b5",
                                                "text": "The fact that only a small fraction of cells infected with the reprogramming factors form iPSC colonies indicates that direct reprogramming is a stochastic process."
                                            },
                                            {
                                                "example_id": "8f2a13fe-cc19-4cb5-ad40-93e60815a6fd",
                                                "sense_id": "dfcdb67a-151e-3813-a13c-90e46e1971b5",
                                                "text": "One of the most promising routes in this regard is the generation of induced pluripotent stem cells (iPSC) by reprogramming cells."
                                            },
                                            {
                                                "example_id": "8fcf6028-4a4c-4bfd-9f5a-053fd1c285ed",
                                                "sense_id": "dfcdb67a-151e-3813-a13c-90e46e1971b5",
                                                "text": "ECs Derived from ESC and iPSC"
                                            },
                                            {
                                                "example_id": "88f22871-87f3-40c3-9855-17e5e0832d6a",
                                                "sense_id": "dfcdb67a-151e-3813-a13c-90e46e1971b5",
                                                "text": "[...] the propensity of stem cells to form teratoma following transplantation is still another major obstacle in using iPSC for disease therapy."
                                            },
