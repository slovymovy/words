                "senses": [
                    {
                        "sense_id": "f83ddfec-49ea-3249-9d34-3a6729690299",
                        "entry_id": "f668d587-0415-34ad-8219-553035d89b54",
                        "glosses": [
                            "Donner un caractère rappelant le boulevard, le théâtre de boulevard, frivoliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33bb3469-9301-4629-8dc1-0154a64b8c1c",
                                "sense_id": "f83ddfec-49ea-3249-9d34-3a6729690299",
                                "text": "On doit, en cette occasion, rendre hommage au génie de M. Jean Meyer : parvenir à désamorcer cette caisse de dynamite qu’est Topaze, boulevardiser cette cruelle pièce de mœurs, ce constat vengeur et désespéré, il faut y mettre du sien."
                            },
                            {
                                "example_id": "3da4577a-d690-49c0-8770-6fd638b45143",
                                "sense_id": "f83ddfec-49ea-3249-9d34-3a6729690299",
                                "text": "Le parisianisme ne lui suffisant plus, cet enfant de Bruxelles s’est plu, si j’ose dire, à se « boulevardiser »."
                            }
                        ]
                    }
                ],
