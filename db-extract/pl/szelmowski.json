                    {
                        "translation_id": "a393f80a-b731-4976-8d87-46aec7ad2001",
                        "source_entry_id": "eaf0c529-9681-3a5e-83ec-67ee91dec4d0",
                        "source_sense_id": "313258e6-8d5a-3138-997b-726472384b94",
                        "target_lang_word": "bribón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bribón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f962bc-d903-31f9-a055-a1bb462f9eaa",
                                        "entry_id": "06098101-0757-37a3-9372-8479e40d6715",
                                        "glosses": [
                                            "Persona ociosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd631f8-e3be-4125-bf73-7c3fda7ea86c",
                                                "sense_id": "e1f962bc-d903-31f9-a055-a1bb462f9eaa",
                                                "text": "La insumisión al molde que traza la sociedad es la nota más alta y simpática de este bribón persuasivo. El vividor es el burlón que de reojo mira nuestros afanes y sonríe con gesto compasivo"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf0e87e8-d0cc-3b4a-8885-891cf5c9b6de",
                                        "entry_id": "06098101-0757-37a3-9372-8479e40d6715",
                                        "glosses": [
                                            "Persona que se dedica a engañar, robar y estafar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c48e5d6-5151-458f-9ee6-67c1353d5387",
                                                "sense_id": "bf0e87e8-d0cc-3b4a-8885-891cf5c9b6de",
                                                "text": "\"No has cumplido los once años, bribón -me dijo-, no los has cumplido, y ya he tenido que ir a sacarte de una cárcel. Ya lo verás\". Y no tenía que decirlo para saber lo que me esperaba"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c25ed334-9bfe-359b-9a96-9566fb5c1592",
                                        "entry_id": "06098101-0757-37a3-9372-8479e40d6715",
                                        "glosses": [
                                            "Persona astuta y aprovechada, que utiliza artimañas para salirse con la suya."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ce471c3-fa55-4e14-a9ab-ddda521d54a2",
                                                "sense_id": "c25ed334-9bfe-359b-9a96-9566fb5c1592",
                                                "text": "Si es la hora que se pierda\nmi fama de payador\n¡Váyase a la misma... mugre\n el bribón que me venció!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
