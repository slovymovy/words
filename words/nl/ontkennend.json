{
    "word_family": [
        "ontkennen",
        "ontkenning"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68a0bded-1bcc-328f-a6a3-8daf9e275515",
                    "sense_definition": "aangevend dat iets niet waar is of 'nee' zeggend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontkenning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij schudde <w>ontkennend</w> met haar hoofd toen ik vroeg of ze meeging.",
                            "target_lang_translations": {
                                "en": "She shook her head <w>in the negative</w> when I asked if she was coming along."
                            }
                        },
                        {
                            "text": "De minister gaf een <w>ontkennend</w> antwoord op de vragen van de journalist.",
                            "target_lang_translations": {
                                "en": "The minister gave a <w>negative</w> answer to the journalist's questions."
                            }
                        }
                    ],
                    "synonyms": [
                        "negatief"
                    ],
                    "common_phrases": [
                        "ontkennend antwoorden",
                        "ontkennend schudden"
                    ],
                    "target_lang_definitions": {
                        "en": "indicating that something is not true, or saying 'no'; negative"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "negative",
                                "target_lang_sense_clarification": "expressing denial or disagreement, e.g. a negative answer"
                            },
                            {
                                "target_lang_word": "in the negative",
                                "target_lang_sense_clarification": "answering or gesturing with 'no'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e0885f0-7392-3a6f-ab1f-6efd998b80c0",
                    "sense_definition": "gezegd van een verdachte die verklaart de ten laste gelegde feiten niet te hebben gepleegd",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ontkenning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat benadrukte dat zijn cliënt een <w>ontkennende</w> verdachte blijft.",
                            "target_lang_translations": {
                                "en": "The lawyer emphasized that his client remains a <w>denying</w> suspect."
                            }
                        },
                        {
                            "text": "Ondanks het gevonden bewijs bleef hij tijdens het verhoor een <w>ontkennende</w> verdachte.",
                            "target_lang_translations": {
                                "en": "Despite the evidence found, he remained a suspect <w>denying the charges</w> during interrogation."
                            }
                        }
                    ],
                    "antonyms": [
                        "bekennend"
                    ],
                    "common_phrases": [
                        "ontkennende verdachte"
                    ],
                    "target_lang_definitions": {
                        "en": "said of a suspect who denies having committed the charged offences; pleading not guilty"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "denying",
                                "target_lang_sense_clarification": "of a suspect who denies the charges"
                            },
                            {
                                "target_lang_word": "pleading not guilty",
                                "target_lang_sense_clarification": "maintaining innocence regarding charges"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1807983a-aac4-3dce-a8b5-ba6f1d5ebd8e",
                    "sense_definition": "onvoltooid deelwoord van <w>ontkennen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus verliet de zaal, alle beschuldigingen stellig <w>ontkennend</w>.",
                            "target_lang_translations": {
                                "en": "The politician left the room, firmly <w>denying</w> all accusations."
                            }
                        },
                        {
                            "text": "Elke betrokkenheid <w>ontkennend</w> liep de man snel weg van de politieagenten.",
                            "target_lang_translations": {
                                "en": "<w>Denying</w> any involvement, the man quickly walked away from the police officers."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "deelwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "present participle of 'ontkennen' (to deny)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "denying",
                                "target_lang_sense_clarification": "present participle form of deny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}