                    {
                        "translation_id": "9500c2f4-c9d1-4551-9c17-b4db8ea52e62",
                        "source_entry_id": "5008519b-deda-396e-b30e-ac995b2fdc50",
                        "source_sense_id": "d0f76bb8-bffa-3b71-b6e2-4250e27998bb",
                        "target_lang_word": "aviculteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aviculteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17edd73a-3a37-33c6-bcf4-4bae6b000fa0",
                                        "entry_id": "af18b34a-bad7-3bc8-9e37-6debf8e55029",
                                        "glosses": [
                                            "Éleveur d’oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc19b0a-8466-4e1f-9f8d-16acecb20fdf",
                                                "sense_id": "17edd73a-3a37-33c6-bcf4-4bae6b000fa0",
                                                "text": "Depuis longtemps, M. Alfred Rousse, de Fontenay-le-Comte (Vendée), s'occupe de l'élevage de nombreuses espèces de Perruches, et cet aviculteur émérite compte de nombreux succès."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dc60687-00d1-361c-b381-c891be17dc4d",
                                        "entry_id": "af18b34a-bad7-3bc8-9e37-6debf8e55029",
                                        "glosses": [
                                            "Professionnel spécialisé dans l'élevage des animaux de basse-cour et en particulier des volailles en vue de l'exploitation commerciale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25372ade-f845-43c2-bc53-17bde02ec2f1",
                                                "sense_id": "3dc60687-00d1-361c-b381-c891be17dc4d",
                                                "text": "Dans ce livre, il a eu pour but de fournir tous les détails dont la connaissance est nécessaire à un aviculteur sur l'installation des poulaillers la plus rationnelle et la plus hygiénique, sur l'alimentation des oiseaux de basse-cour, sur l’incubation soit naturelle, soit artificielle, sur l'élevage des poussins, et sur les divers procédés d'engraissement des volailles et leur préparation pour la vente."
                                            },
                                            {
                                                "example_id": "7533b85e-9a81-4104-8c7e-3370d86abd91",
                                                "sense_id": "3dc60687-00d1-361c-b381-c891be17dc4d",
                                                "text": "Vous avez certainement entendu dire par tel grand aviculteur professionnel : « Cette année, j’ai fait 800 000 œufs » ou par tel autre : « Je viens de faire 40 000 poulets » et vous n’avez pas souri."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
