                    {
                        "translation_id": "b574df83-5212-4adf-9668-54127c83111a",
                        "source_entry_id": "de2c4ac3-76a6-3edb-ac18-a38cd3c877e2",
                        "source_sense_id": "14aab8b9-8eb2-3eaa-a313-c63adfe8f0e7",
                        "target_lang_word": "konvulsiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konvulsiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33081e01-feb3-351d-a1ae-bc3df311108c",
                                        "entry_id": "64a70e93-8501-341c-b7a0-809215540ced",
                                        "glosses": [
                                            "in Konvulsionen, krampfhaft, zuckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844aae29-ebd6-407c-b71c-1f6795833dbd",
                                                "sense_id": "33081e01-feb3-351d-a1ae-bc3df311108c",
                                                "text": "Die konvulsiven Bewegungen deuteten auf Vergiftung hin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74613104-2084-4fff-8eb1-cd846c8791a6",
                        "source_entry_id": "de2c4ac3-76a6-3edb-ac18-a38cd3c877e2",
                        "source_sense_id": "14aab8b9-8eb2-3eaa-a313-c63adfe8f0e7",
                        "target_lang_word": "konvulsivisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konvulsivisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a09f320-f848-32c0-9910-e47b9ce8f1d9",
                                        "entry_id": "f4c39841-c96e-3068-ba96-db51908a7d4a",
                                        "glosses": [
                                            "in Konvulsionen, krampfhaft, zuckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5562fa5-fb98-450a-a12a-e714381c334f",
                                                "sense_id": "3a09f320-f848-32c0-9910-e47b9ce8f1d9",
                                                "text": "„Schritt für Schritt beginnen die verschiedenen Wärme-, Prickel- und Schauerempfindungen der Haut und der peripheren Muskulatur von Rumpf und Gliedmaßen sich zu einer konvulsivischen Reflexbewegung des gesamten Körpers zu verbinden, bei der sich das Rückgrat in unwillkürlichen klonischen Zuckungen krümmt und dehnt. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa22055-ed68-4550-8ca5-12d9889df9f2",
                        "source_entry_id": "de2c4ac3-76a6-3edb-ac18-a38cd3c877e2",
                        "source_sense_id": "14aab8b9-8eb2-3eaa-a313-c63adfe8f0e7",
                        "target_lang_word": "krampfhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krampfhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf91471e-4014-3bac-82a9-a2be5d73ccce",
                                        "entry_id": "cd03a81c-ef23-3f30-9b4d-d34e93e3a037",
                                        "glosses": [
                                            "mit großer Anstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7ab7a6b-b848-45de-92cf-feab33b3c4ff",
                                                "sense_id": "cf91471e-4014-3bac-82a9-a2be5d73ccce",
                                                "text": "„Das von unterirdischen Maschinen angetriebene Blech des „Eisernes Sees“ ist blau bemalt, und wenn du im Schinakel sitzt und dich krampfhaft bemühst, es so zu führen, daß du nicht anprallst oder umkippst, dann kannst du dir einbilden, tatsächlich auf See zu fahren, ohne die salzige Seeluft atmen zu müssen oder naß zu werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14412c86-89fd-3bc7-a0b6-233230f60b11",
                                        "entry_id": "cd03a81c-ef23-3f30-9b4d-d34e93e3a037",
                                        "glosses": [
                                            "in einem Krampf befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939f3a6e-bacd-465b-8691-6a5e89f3891b",
                                                "sense_id": "14412c86-89fd-3bc7-a0b6-233230f60b11",
                                                "text": "„Als Kolik werden stärkste, bewegungsunabhängige, meist wehenartige Schmerzen bezeichnet, die durch krampfhafte Kontraktionen der glatten Muskulatur eines Hohlorganes verursacht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
