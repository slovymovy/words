                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d78ef65-f518-4a0e-b109-f6c02c4655ca",
                                "sense_id": "a688e904-9eef-35c4-999c-abb1d9f597f6",
                                "text": "Für die Aufstockung unseres Kaders ist kein Geld vorhanden."
                            },
                            {
                                "example_id": "7d413268-6522-4c74-b2ed-4fc7c436b71a",
                                "sense_id": "a688e904-9eef-35c4-999c-abb1d9f597f6",
                                "text": "Die Baukosten sind höher ausgefallen als geschätzt, sodass wir unsere Bank um eine Aufstockung des Darlehens bitten müssen."
                            }
                        ],
                        "sense_index_json": "\"2\""
