                                        "sense_id": "95786fa1-9cac-394b-b805-30d0d8683c3e",
                                        "entry_id": "fe0705bb-f1d9-304c-b9f9-6d4ea2012ca8",
                                        "glosses": [
                                            "Unité monétaire des États africains membres de l’Union économique et monétaire ouest-africaine (UEMOA)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c125ffd2-6838-446d-b841-679932245452",
                                                "sense_id": "95786fa1-9cac-394b-b805-30d0d8683c3e",
                                                "text": "J'essayais de me frayer un passage entre les faroteurs qui se trémoussaient en s’essuyant le front avec des billets de dix mille francs CFA."
                                            },
                                            {
                                                "example_id": "3e9c8fcc-e120-4204-b4d9-8c63406a1d24",
                                                "sense_id": "95786fa1-9cac-394b-b805-30d0d8683c3e",
                                                "text": "La sortie du franc CFA sous ses modalités actuelles s’inscrit dans une dynamique historique et politique de fond qui la rend probable à une échéance plus ou moins rapprochée selon les pays. Elle ne doit pas se faire dans des conditions défavorables au plus grand nombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19b76748-57ad-3a4e-bdda-9bf19fe075a4",
                                        "entry_id": "fe0705bb-f1d9-304c-b9f9-6d4ea2012ca8",
                                        "glosses": [
                                            "Unité monétaire des États africains membres de Communauté économique et monétaire de l’Afrique centrale (CEMAC)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1ba5784-a57d-47f7-aa7c-47774c4174cd",
                                                "sense_id": "19b76748-57ad-3a4e-bdda-9bf19fe075a4",
                                                "text": "Le franc CFA a une parité fixe avec l’euro et les pays de la zone franc."
                                            }
                                        ]
                                    }
