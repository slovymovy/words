        "fr-extract.jsonl": [
            {
                "entry_id": "5c11280e-8fd0-3bde-82db-dfe10dd4ce86",
                "word": "convulsivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                        "entry_id": "5c11280e-8fd0-3bde-82db-dfe10dd4ce86",
                        "glosses": [
                            "D’une manière convulsive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "136b4001-7bde-450e-af09-ab9661000bf4",
                                "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                                "text": "Elle trembla convulsivement en approchant la clef de la serrure, et son émotion devint même si forte qu'elle s'arrêta pendant un instant pour mettre la main sur son cœur, […]."
                            },
                            {
                                "example_id": "afc4fc53-acb2-470d-92c6-275e9805e7e3",
                                "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                                "text": "[…], et le bras du landgrave retomba sur l’épaule de son frère d’armes, qu’il serra convulsivement contre lui."
                            },
                            {
                                "example_id": "bf67521a-2c2a-4863-aba7-9b73ba33e138",
                                "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                                "text": "Ne vois-tu pas que comme l’aiglon qui se débat pour briser l’œuf, la noire classe des travailleurs s’agite convulsivement pour faire éclater le moule de la vieille société."
                            },
                            {
                                "example_id": "cfc88827-d551-4f6a-bdf6-332f8b99aebd",
                                "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                                "text": "– Attendez un peu, – bredouilla-t-il, tremblant, et il se déboutonnait, convulsivement."
                            },
                            {
                                "example_id": "0290b354-fc98-4dfc-ae8f-bdde67ee5d2b",
                                "sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                                "text": "Convulsivement, elle prit le bébé dans ses bras et le couvrit de baisers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b278952b-3b88-4837-843b-e3101fb225ee",
                        "source_entry_id": "5c11280e-8fd0-3bde-82db-dfe10dd4ce86",
                        "source_sense_id": "4a542d2d-f75c-3a00-93e0-c7fa3468062d",
                        "target_lang_word": "convulsively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convulsively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66096238-09a7-329f-bbad-af8466d84aa8",
                                        "entry_id": "42f32cb6-3dae-3ac2-80ff-caf0adc93d20",
                                        "glosses": [
                                            "In a convulsive manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3865bd2b-6c50-4c4a-b0bc-6aba6a9c0939",
                                                "sense_id": "66096238-09a7-329f-bbad-af8466d84aa8",
                                                "text": "But his words died in a strange gurgling in the throat; the eyes suddenly became fixed; the mouth fell; once he stretched out his hands convulsively, but they instantly relaxed, and his head sunk on Norbourne's arm."
                                            },
                                            {
                                                "example_id": "63673fba-4b3e-4da5-8d85-530f35ef68b4",
                                                "sense_id": "66096238-09a7-329f-bbad-af8466d84aa8",
                                                "text": "Her thumb and nail lightly flicked the palm of my hand until I could bear it no longer and closed my hand convulsively over hers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
