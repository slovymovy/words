                        "glosses": [
                            "Type de parc zoologique ou de parc animalier où les animaux sauvages sont présentés en semi-liberté et observés par les visiteurs depuis un véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8decd6a1-7750-476b-94bf-04f770ceb3ee",
                                "sense_id": "f01bfcdc-1944-3791-89e5-9ef6f8adedd3",
                                "text": "Le safari-parc du Haut-Vivarais, situé à Peaugres, de part et d'autre de la N 519, entre Annonay et Serrières, est avec Thoiry et Sigean l'un des trois établissements du groupe de Thoiry."
                            },
                            {
                                "example_id": "bb079816-6d93-42d7-b7e6-93815fbf07e6",
                                "sense_id": "f01bfcdc-1944-3791-89e5-9ef6f8adedd3",
                                "text": "La formule du safari-parc inaugurée à Thoiry par le Vicomte de la Panouse n'a plus autant de succès qu'auparavant."
                            }
                        ]
                    }
