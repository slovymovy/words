                "senses": [
                    {
                        "sense_id": "e3000d85-816c-3b4b-8818-c96605350985",
                        "entry_id": "dbc4aee5-23bd-393e-8ae8-acbf2a366e0b",
                        "glosses": [
                            "Vertreter der Unterfamilie Caimaninae innerhalb der Alligatoren, ausschließlich in Südamerika lebend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95bce13-3ce9-433b-96cd-aa75aaca917a",
                                "sense_id": "e3000d85-816c-3b4b-8818-c96605350985",
                                "text": "Kaimane gehören zu der Familie der Alligatoren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d34a7da-d30c-4337-85b3-59999afb519f",
                        "source_entry_id": "dbc4aee5-23bd-393e-8ae8-acbf2a366e0b",
                        "source_sense_id": "e3000d85-816c-3b4b-8818-c96605350985",
                        "source_sense_description": "Vertreter der Unterfamilie Caimaninae innerhalb der Alligatoren",
                        "target_lang_word": "caiman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caiman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3660e3d-4e7b-3aac-a3ca-9c2eac1af16e",
                                        "entry_id": "d3540d3b-56ba-3e5c-9ab4-20ea29eb56ac",
                                        "glosses": [
                                            "Any of the relatively small crocodilians of the genus Caiman, within the family Alligatoridae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fde0122-b65b-4968-8268-d09c83896671",
                                                "sense_id": "e3660e3d-4e7b-3aac-a3ca-9c2eac1af16e",
                                                "text": "Caimans are reptiles that are closely related to their Central and South American neighbors, the alligators. Adult caimans are usually four to six feet (1.8 m) in length."
                                            },
                                            {
                                                "example_id": "93e280fc-3d42-44e2-9473-120522a5636b",
                                                "sense_id": "e3660e3d-4e7b-3aac-a3ca-9c2eac1af16e",
                                                "text": "2002, International Wildlife Encyclopedia: Brown bear - Cheetah, 3rd Edition, page 358,\nThe caimans are found in South America, mainly in the Amazon basin, with one species extending into the southern part of Mexico and another reaching northern parts of Argentina."
                                            },
                                            {
                                                "example_id": "0cc31eac-cab0-47d4-bcf4-7c59efe32c85",
                                                "sense_id": "e3660e3d-4e7b-3aac-a3ca-9c2eac1af16e",
                                                "text": "Newly hatched caimans eat insects. Young caimans are eaten by Jabirus, Wood Storks, Great Egrets, and raccoons. Adult caimans have no predators except human poachers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f560281a-1e15-367b-bea5-5c05d4cd4319",
                                        "entry_id": "d3540d3b-56ba-3e5c-9ab4-20ea29eb56ac",
                                        "glosses": [
                                            "A crocodilian of the subfamily Caimaninae, which includes the very large black caiman."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f1c2ce0-ada2-3502-9c15-47247352149d",
                                        "entry_id": "d3540d3b-56ba-3e5c-9ab4-20ea29eb56ac",
                                        "glosses": [
                                            "A semi-aquatic lizard, of the genus Dracaena, found in South America. To differentiate from caimans, they are referred to as caiman lizards."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b17eeb30-133f-4359-b62d-edcf09880da1",
                        "source_entry_id": "dbc4aee5-23bd-393e-8ae8-acbf2a366e0b",
                        "source_sense_id": "e3000d85-816c-3b4b-8818-c96605350985",
                        "source_sense_description": "Vertreter der Unterfamilie Caimaninae innerhalb der Alligatoren",
                        "target_lang_word": "caïman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caïman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebd9faf4-d541-3c5a-a2c6-e623e8ab34a3",
                                        "entry_id": "bb3758ae-a69e-3e36-abfb-c388905bcd71",
                                        "glosses": [
                                            "Reptile de la sous-famille Caimaninae originaire d’Amérique centrale ou d’Amérique du Sud, proche de l’alligator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68ffd957-4957-41f9-8eb0-2decb650b399",
                                                "sense_id": "ebd9faf4-d541-3c5a-a2c6-e623e8ab34a3",
                                                "text": "Il reconnut ces féroces alligators particuliers à l’Amérique, et nommés caïmans dans les pays espagnols."
                                            },
                                            {
                                                "example_id": "9a47917d-2c7c-4dfd-88d8-e8c8d954b842",
                                                "sense_id": "ebd9faf4-d541-3c5a-a2c6-e623e8ab34a3",
                                                "text": "Sur les bords battus par le flot rougeâtre, leur répugnante gueule jaune grande ouverte, des caïmans dormaient."
                                            },
                                            {
                                                "example_id": "e491ba18-e159-4860-84a1-6a474650f800",
                                                "sense_id": "ebd9faf4-d541-3c5a-a2c6-e623e8ab34a3",
                                                "text": "Cette trouille ! Sur le coup, j’ai cru qu’il avait aperçu un truc chaudard. Une mygale, un boa, un caïman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c81b2703-04dd-39b3-a1ce-676c13bd6e9b",
                                        "entry_id": "bb3758ae-a69e-3e36-abfb-c388905bcd71",
                                        "glosses": [
                                            "Agrégé répétiteur à l’École normale supérieure."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a324a5-4f9b-49ee-9c79-90c1e9ef59dd",
                                                "sense_id": "c81b2703-04dd-39b3-a1ce-676c13bd6e9b",
                                                "text": "Un enseignement d’appoint que nous dispensaient des « agrégés répétiteurs » ou « caïmans », anciens élèves à peine sortants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d799c0b9-1737-3d08-9e67-05327c0e1659",
                                        "entry_id": "bb3758ae-a69e-3e36-abfb-c388905bcd71",
                                        "glosses": [
                                            "Élève très travailleur. → voir caïmanter"
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
