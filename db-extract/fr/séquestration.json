                        ]
                    },
                    {
                        "sense_id": "a1d87ccf-0adc-3ff5-803c-ee495d52c9af",
                        "entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                        "glosses": [
                            "Mise sous séquestre."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                        "entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                        "glosses": [
                            "Enfermement et isolement criminels et d’une personne contre sa volonté, généralement précédés d’un enlèvement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e72f757b-971d-482a-a130-1e0478114179",
                                "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                                "text": "Séquestration de personnes."
                            },
                            {
                                "example_id": "8b056ab6-6ec4-4699-9f59-20a952195c7c",
                                "sense_id": "3968984a-341f-3c6a-889e-4da0b14d9de4",
                                "text": "La députée et son ami taxi ont ensuite été accompagnés au commissariat de Vincennes : elle a porté plainte pour séquestration, et lui pour coups et blessures."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a9ea1ca-8446-3351-b78a-9b26e84f4ed1",
                        "entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                        "glosses": [
                            "Enfermement et isolement drastiques mais volontaires d’une personne."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e2cef6f-f322-4250-99de-a5205b1cc49d",
                        "source_entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                        "source_sense_description": "Action par laquelle on séquestre",
                        "target_lang_word": "Beschlagnahmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschlagnahmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2985fe2-0fd4-36e5-b248-6b5fa8f76ea7",
                                        "entry_id": "47208891-6c8a-3d66-98d6-a09503546e99",
                                        "glosses": [
                                            "Entzug von Besitztum aufgrund amtlicher Anweisung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0594755-e808-4dbf-adcc-64a5514060f1",
                                                "sense_id": "a2985fe2-0fd4-36e5-b248-6b5fa8f76ea7",
                                                "text": "„Nachdem die bevorstehende Beschlagnahmung von Getreideprodukten angekündigt worden war, sank blitzartig auch das Angebot der noch frei handelbaren Kartoffeln.“"
                                            },
                                            {
                                                "example_id": "22867803-3d04-40c6-96a3-c1444c2d796a",
                                                "sense_id": "a2985fe2-0fd4-36e5-b248-6b5fa8f76ea7",
                                                "text": "„Trotz aller polizeilichen Beschlagnahmungen wurden die verpönten Romane unentwegt weitergedruckt – in welchem Umfang, weiß natürlich niemand, denn darüber wurde keine Statistik geführt.“"
                                            },
                                            {
                                                "example_id": "0fecc63d-4169-4169-8600-e32182adaa14",
                                                "sense_id": "a2985fe2-0fd4-36e5-b248-6b5fa8f76ea7",
                                                "text": "„Die Weimarer Verfassung gilt faktisch nicht mehr, Presse- und Versammlungsfreiheit, Post-, Telegraph- und Fernsprechgeheimnis werden außer Kraft gesetzt, willkürliche Hausdurchsuchungen und Beschlagnahmungen gestattet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb22334f-99f7-4777-a0e4-39c32b247743",
                        "source_entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
                        "source_sense_description": "Action par laquelle on séquestre",
                        "target_lang_word": "Freiheitsberaubung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freiheitsberaubung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                        "entry_id": "0275ba44-055f-316f-b1cc-1e84d80ef9c2",
                                        "glosses": [
                                            "Verhalten, durch das einem Menschen (vorsätzlich und rechtswidrig) die persönliche Fortbewegungsfreiheit entzogen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff76e66-2bb5-444f-a9ff-52c35494d9a1",
                                                "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                                "text": "Im Kinderheim waren Freiheitsberaubungen durch die Erzieher an der Tagesordnung."
                                            },
                                            {
                                                "example_id": "39b28439-0795-4df0-8659-644d473ac0ea",
                                                "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                                "text": "Sie erachtet die Strafandrohung für Freiheitsberaubungen als zu gering."
                                            },
                                            {
                                                "example_id": "1819b18f-feec-40c2-89f7-473becd59bf1",
                                                "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                                "text": "Voller Wiedersehensfreude umarmte er sie, doch sie wehrte sich gegen diese Freiheitsberaubung."
                                            },
                                            {
                                                "example_id": "56df8052-403d-4eab-b72c-78f048ae62bf",
                                                "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                                "text": "Dass sie gegen ihren Willen mit ihren Eltern im Auto in den Urlaub fahren musste, empfand sie als Freiheitsberaubung."
                                            },
                                            {
                                                "example_id": "fd7cce22-d47a-4d97-92ec-20cd08a88cc5",
                                                "sense_id": "ecd494bd-2a20-32d7-8bad-cb388c0a5d8d",
                                                "text": "Er ist mehrfach vorbestraft wegen Freiheitsberaubung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                        "entry_id": "0275ba44-055f-316f-b1cc-1e84d80ef9c2",
                                        "glosses": [
                                            "Straftat gemäß § 239 I StGB, bei der der Täter das Opfer gegen dessen Willen nicht nur ganz kurzfristig einsperrt oder ihm auf andere Weise (etwa Betäuben, Fesseln oder Festhalten) die (potenzielle) Fortbewegungsfreiheit nimmt"
                                        ],
                                        "tags": [
                                            "deutsches Strafrecht; ohne Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb0eb27-878d-4dd6-b6f1-465cd8bb03ea",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "Er ist mehrfach vorbestraft wegen Freiheitsberaubung."
                                            },
                                            {
                                                "example_id": "b7429018-ec2d-42d8-9e9d-9d12b5f2102b",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "Die Freiheitsberaubung sollte reformiert werden."
                                            },
                                            {
                                                "example_id": "4662a89b-6d8f-4aec-9c82-40930b9dbaab",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "„Die Freiheitsberaubung ist ein Spezialfall der Nötigung und geht daher grundsätzlich § 240 StGB vor, sofern der Täter nicht eine über die Duldung der Einsperrung hinausgehende Verhaltensweise des Opfers erzwingen möchte.“"
                                            },
                                            {
                                                "example_id": "483201e7-00ec-40e8-ad21-aeb07b081d24",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "Der Tatbestand der Freiheitsberaubung ist auch dann erfüllt, wenn jemand nur während des Schlafes eingesperrt war, da bereits die potenzielle Bewegungsfreiheit geschützt wird."
                                            },
                                            {
                                                "example_id": "730d869c-855a-42d5-ab07-456f6cb2ba34",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "Wer einen anderen mit dessen Einverständnis einsperrt, begeht keine Freiheitsberaubung."
                                            },
                                            {
                                                "example_id": "55cd8dc3-83e3-40a4-86b6-1bbbdd83f2e2",
                                                "sense_id": "ec4aaab1-1917-366e-b88f-3bee433331ea",
                                                "text": "„Auch Freiheitsberaubung und jede andere Form von Unterdrückung sind öffentlich zu machen und zu bekämpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3f829fe-1d78-448c-bb15-c5cedd1c81f8",
                        "source_entry_id": "7f37c4d6-9012-3be9-81d1-19f92b894acd",
