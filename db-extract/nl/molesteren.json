                        "target_lang_word": "molester",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molester",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd0a7c2-054b-3872-981d-6d0468002b71",
                                        "entry_id": "78cf4899-aadc-368b-a63a-e7638bb70d32",
                                        "glosses": [
                                            "Houspiller, maltraiter quelqu’un en paroles ou en actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf458b71-ab31-4361-ba78-011fd90efe74",
                                                "sense_id": "3fd0a7c2-054b-3872-981d-6d0468002b71",
                                                "text": "J’ai ouï dire que cette communauté avait ses dangers ; que les calopsittes étaient susceptibles de molester les jeunes ondulées au sortir du nid, de leur couper les pattes, en un mot de leur faire de fort mauvaises plaisanteries."
                                            },
                                            {
                                                "example_id": "9b5756cd-c5e6-48e6-9275-5f826dfc72f8",
                                                "sense_id": "3fd0a7c2-054b-3872-981d-6d0468002b71",
                                                "text": "Ils ne m’aiment pas. Ils ne m’ont jamais aimée. Au mieux, ils m’ignorent. Au pire, ils me molestent quand ils ont un peu trop bu l’arack."
                                            },
                                            {
                                                "example_id": "80281c23-a10b-4129-97d1-e82f7473d93d",
                                                "sense_id": "3fd0a7c2-054b-3872-981d-6d0468002b71",
                                                "text": "Il les a fort molestés par ses chicanes, par ses propos, par ses sarcasmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c419ba9-ad15-3ab4-9d5f-f04f0933f345",
                                        "entry_id": "78cf4899-aadc-368b-a63a-e7638bb70d32",
                                        "glosses": [
                                            "Tourmenter de quelque manière que ce soit, inquiéter par des embarras suscités mal à propos."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
