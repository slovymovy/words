                                            {
                                                "example_id": "af755b23-19d4-4491-8957-1f50a7419077",
                                                "sense_id": "8d66fc7e-9d64-392c-abe7-4696ae7c5c1d",
                                                "text": "Ватикан заключил в своё время конкордаты и с Муссолини, и с Гитлером, и с Франко, и с Салазаром."
                                            },
                                            {
                                                "example_id": "dc12e824-b598-4190-8e98-597001636d03",
                                                "sense_id": "8d66fc7e-9d64-392c-abe7-4696ae7c5c1d",
                                                "text": "Наступил 1933 год, власть захватил Гитлер, и довольно быстро обстановка в Германии стала зловеще меняться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0ac6425-5f3e-4047-94aa-9a7ee101374f",
