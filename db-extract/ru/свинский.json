                "senses": [
                    {
                        "sense_id": "04de8c27-c749-3dc8-8f54-7846300b7d91",
                        "entry_id": "4a309f5c-f85a-3177-abaf-dce914dc12fc",
                        "glosses": [
                            "разг. грязный, некультурный"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a6063c93-7dfd-332a-a26f-65c5e1b47167",
                        "entry_id": "4a309f5c-f85a-3177-abaf-dce914dc12fc",
                        "glosses": [
                            "разг. непорядочный, низкий, подлый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b541daf-df00-4ee3-82e4-3f44454da40f",
                                "sense_id": "a6063c93-7dfd-332a-a26f-65c5e1b47167",
                                "text": "Первая же рана кота, в чём уж, ясно, не было ни малейшего сомнения, была не чем иным, как фокусом и свинским притворством, равно как и питьё бензина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f898681-8f2d-4a81-a6cf-8b32dfd95675",
                        "source_entry_id": "4a309f5c-f85a-3177-abaf-dce914dc12fc",
                        "target_lang_word": "swinish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swinish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e77b46-8ad6-311c-9879-87be103aee8c",
                                        "entry_id": "9ec908ba-bfd0-3476-ad50-9dd4276abb4e",
                                        "glosses": [
                                            "Like a pig, resembling a swine; gluttonous, coarse, debased."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb08169d-d1f9-43a7-8e44-e7e9a8813825",
                                                "sense_id": "77e77b46-8ad6-311c-9879-87be103aee8c",
                                                "text": "[…]They clip vs drunkards, and with Swiniſh phraſe / Soyle our addition, and indeede it takes / From our atchieuements, though perform’d at height / The pith and marrow of our attribute[…]"
                                            },
                                            {
                                                "example_id": "1a2e1ff1-46ea-4310-b460-202370882518",
                                                "sense_id": "77e77b46-8ad6-311c-9879-87be103aee8c",
                                                "text": "Epicurus, though his ethic seemed to others swinish and lacking in moral exultation, was very much in earnest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f940f9a6-339f-43aa-8f85-7f62179c1779",
                        "source_entry_id": "4a309f5c-f85a-3177-abaf-dce914dc12fc",
                        "target_lang_word": "porcine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porcine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e11476ba-6f23-3e24-a26b-262ecef68973",
                                        "entry_id": "507c4f04-4cee-3a45-9ec0-5e9f3c9812b2",
                                        "glosses": [
                                            "Of or pertaining to pigs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe474cc-842c-44f9-8405-699db67c6fe6",
                                                "sense_id": "e11476ba-6f23-3e24-a26b-262ecef68973",
                                                "text": "Alas, your delicious sandwich has been slain. Gaius’ blow sent it sprawling from your hand and onto the dusty grass where its saucy, porcine contents splattered forth from its freshly-baked body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "361526b9-811c-3170-8ee4-bb4a0224e17f",
                                        "entry_id": "507c4f04-4cee-3a45-9ec0-5e9f3c9812b2",
                                        "glosses": [
                                            "Similar to a pig"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff595426-3ced-38d7-be64-a83d53634d41",
                                        "entry_id": "507c4f04-4cee-3a45-9ec0-5e9f3c9812b2",
                                        "glosses": [
                                            "Overweight to the extent of resembling a pig; morbidly obese."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
