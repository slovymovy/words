                "translations": [
                    {
                        "translation_id": "0257e91c-eaf6-464c-b998-f901c4f061c5",
                        "source_entry_id": "7541bece-214e-3382-a9ce-541633dedb47",
                        "source_sense_id": "fb76bd06-8576-3eb8-820f-5d4af9f38fa6",
                        "target_lang_word": "stink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2924a025-35f8-38c9-8be5-5c955f2e56b8",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To have a strong bad smell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To be greatly inferior; to perform badly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd488018-e645-47c5-964f-f9b6df982773",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "That movie stinks. I didn't even stay for the end."
                                            },
                                            {
                                                "example_id": "30e8d5db-3827-4d94-bff7-91a212fbe65e",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "They gave me Out of Africa, by Isak Dinesen. I thought it was going to stink, but it didn't. It was a very good book."
                                            },
                                            {
                                                "example_id": "2182cab5-edff-4198-9c09-7a6b2c04bc6d",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "My French stinks, Langdon thought, but my zodiac iconography is pretty good. Taurus was always the bull. Astrology was a symbolic constant all over the world."
                                            },
                                            {
                                                "example_id": "0f6ff5ed-b8b0-4442-9e44-5bedd0d0d4ef",
                                                "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                                                "text": "Improve your golf swing by taking your mate to the driving range. If you're good, you can show off and give her some tips. If you stink, play it for laughs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To give an impression of dishonesty, untruth, or sin."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51788603-47ff-4ec9-bbf0-7ca5ba313c4f",
                                                "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                                "text": "Something stinks about the politician's excuses."
                                            },
                                            {
                                                "example_id": "5b3aa21e-b272-424b-a3a4-b64a97928ded",
                                                "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                                                "text": "The parish stank of idolatry, abominable rites were practiced in secret, and in all the bounds there was no one had a more evil name for the black traffic than one Alison Sempill, who bode at the Skerburnfoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79b94d2-e290-3d75-ae37-1cbad1b6c40d",
                                        "entry_id": "ed82a92c-a2cb-3b19-8e28-6e536cc8cb72",
                                        "glosses": [
                                            "To cause to stink; to affect by a stink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ebd7dbd-ac56-3c07-8af2-f8ae78ee2812",
                                        "entry_id": "8acd13a5-02c7-3b64-8c69-9348e9e9f73b",
                                        "glosses": [
                                            "A strong bad smell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39eeae85-7591-44fc-954a-6a155c0af8bf",
                                                "sense_id": "8ebd7dbd-ac56-3c07-8af2-f8ae78ee2812",
                                                "text": "“I’m thankful for this beautiful morning!” He points toward the sky. “See that sunrise? Smell that air—” / “That’s stink from the rendering plant.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ccbb6b6-ad4b-300b-b5c6-8b1a73d1999a",
                                        "entry_id": "8acd13a5-02c7-3b64-8c69-9348e9e9f73b",
                                        "glosses": [
                                            "A complaint or objection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f45ec400-ea9b-4319-8821-67cdbab4f4f4",
                                                "sense_id": "5ccbb6b6-ad4b-300b-b5c6-8b1a73d1999a",
                                                "text": "If you don't make a stink about the problem, nothing will be done."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d8491c1-26c2-31cc-82e2-4020b79dd51d",
                                        "entry_id": "fc8d1d88-25f4-303e-816f-b319a6b7ce22",
                                        "glosses": [
                                            "Bad; inferior; worthless."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35dd023-d4c4-4db6-a092-98191eb12d27",
                                                "sense_id": "6d8491c1-26c2-31cc-82e2-4020b79dd51d",
                                                "text": "The concert was stink. / That was a stink concert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                        "entry_id": "fc8d1d88-25f4-303e-816f-b319a6b7ce22",
                                        "glosses": [
                                            "Bad-smelling, stinky."
                                        ],
                                        "tags": [
                                            "Caribbean",
                                            "Guyana",
                                            "Jamaica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea550713-94bf-49a6-bb2e-08c7acd53992",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "2013, Stabroek News, 19 February 2013, cited by Deborah Jan Osman Backer in a speech delivered in the National Assembly during the Budget Debate, 2013,\nEveryone is up in arms but it smells stink because it smells of racism…"
                                            },
                                            {
                                                "example_id": "bd24f65d-1b71-407c-8d2f-9dddd3ba7f2e",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "Spending hours in a “stink\" morgue, being called “Taliban”, thinking of getting shot in the head by officers—memories of Venezuela that have left Hamza Mohammed, imam of the Montrose mosque, still trembling today."
                                            },
                                            {
                                                "example_id": "cac8074a-6e18-4c99-9ad5-d8c9c432346b",
                                                "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                                                "text": "2016, Kei Miller, Augustown, New York: Pantheon, Chapter 1, p. 5,\n[…] what Ma Taffy smells on this early afternoon makes her sit up straight. She smells it high and ripe and stink on the air, like a bright green jackfruit in season being pulled to the rocky ground below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a66d7b5-6f0a-4cd8-825b-483b3a380419",
                        "source_entry_id": "7541bece-214e-3382-a9ce-541633dedb47",
                        "source_sense_id": "fb76bd06-8576-3eb8-820f-5d4af9f38fa6",
                        "target_lang_word": "reek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4853c2a-f5df-33a9-a05c-bd133755dd1d",
                                        "entry_id": "ec8d6c18-8c9d-3e16-be0e-96f9a7f04a07",
                                        "glosses": [
                                            "A strong unpleasant smell."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4496148a-d5e2-34f1-bd4e-d8cf40528fec",
                                        "entry_id": "ec8d6c18-8c9d-3e16-be0e-96f9a7f04a07",
                                        "glosses": [
                                            "Vapour; steam; smoke; fume."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54889eef-3d07-45fb-9f8f-9d702910a289",
                                                "sense_id": "4496148a-d5e2-34f1-bd4e-d8cf40528fec",
                                                "text": "Thou mightst as well say, I loue to walke by the\nCounter-gate, which is as hatefull to me, as the reeke of\na Lime-kill."
                                            },
                                            {
                                                "example_id": "314c5f14-9668-4714-805b-425b8228b7ff",
                                                "sense_id": "4496148a-d5e2-34f1-bd4e-d8cf40528fec",
                                                "text": "1768, Alexander Ross (poet), \"Helenore; or, the fortunate Shepherdess\": a Poem in the Broad Scoth Dialect\nNow, by this time, the sun begins to leam,\nAnd lit the hill-heads with his morning beam;\nAnd birds, and beasts, and folk to be a-steer,\nAnd clouds o’ reek frae lum heads to appear."
                                            },
                                            {
                                                "example_id": "2eb97284-a46c-41c2-aeec-bfcbe01212e0",
                                                "sense_id": "4496148a-d5e2-34f1-bd4e-d8cf40528fec",
                                                "text": "The blue reeks of smoke from the cottages gave the whole widespread landscape an air of settled order and homely comfort."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3acc5afc-d390-3c20-bebb-589751a2c511",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To have or give off a strong, unpleasant smell."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77a9b0c-e2c7-43a5-b142-baf7e9bf56c2",
                                                "sense_id": "3acc5afc-d390-3c20-bebb-589751a2c511",
                                                "text": "You reek of perfume."
                                            },
                                            {
                                                "example_id": "684da9bd-bd1c-43ba-8eeb-62732ca64bc5",
                                                "sense_id": "3acc5afc-d390-3c20-bebb-589751a2c511",
                                                "text": "Your fridge reeks of egg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78769e04-ba61-34f8-92f5-b19a35bc4b49",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To be evidently associated with something unpleasant."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fee4bf43-a183-4028-8171-14eed737b615",
                                                "sense_id": "78769e04-ba61-34f8-92f5-b19a35bc4b49",
                                                "text": "The boss appointing his nephew as a director reeks of nepotism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aafe2e71-04fa-3985-85b4-fe0db5f22ee2",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To be emitted or exhaled, emanate, as of vapour or perfume."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fb35609-a387-3ec5-91a9-de38439c4684",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To emit smoke or vapour; to steam."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ab1e25-12ae-41a2-821f-9efb5431a6f7",
                                                "sense_id": "0fb35609-a387-3ec5-91a9-de38439c4684",
                                                "text": "[…] innumerable Legions of his Angels of Light, the warm gleames of whose presence is able to make the Mountains to reek and smoak, and to awake that fiery principle that lies dormient in the Earth into a devouring flame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4d8380-5aa2-3dcc-9483-fe735eac32b7",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To cause (something) to smell."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce92a38-969f-40b8-a8e8-32a6d8967936",
                                                "sense_id": "df4d8380-5aa2-3dcc-9483-fe735eac32b7",
                                                "text": "The slaughter of lambs in offering reeked the fore-courts of the Temple."
                                            },
                                            {
                                                "example_id": "f2386e47-9475-4f40-90fa-5ce51bf33c0a",
                                                "sense_id": "df4d8380-5aa2-3dcc-9483-fe735eac32b7",
                                                "text": "[I]f we get caught we're for the gibbet and the chains. Our flesh will reek the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d91f7056-61e0-3596-8d83-526cb3067e03",
                                        "entry_id": "e1c83a53-f907-38fc-8624-54e92a13b28a",
                                        "glosses": [
                                            "To fall in such a way (e.g. particularly finely or heavily) as to resemble smoke."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcbfe70f-9d74-43be-8086-ff24cb75376b",
                                                "sense_id": "d91f7056-61e0-3596-8d83-526cb3067e03",
                                                "text": "... the snow still darkens the air, and reeks along the curling wreaths, as if each were a furnace."
                                            },
                                            {
                                                "example_id": "2c173555-a384-411c-bd63-c76033e1a7ed",
                                                "sense_id": "d91f7056-61e0-3596-8d83-526cb3067e03",
                                                "text": "the sun, which had been occasionally peeping from amidst the windy, rain-reeking clouds, was getting ominously low. One part, however, of the man's prophecy was not borne out - the weather steadily improved and the wind dropped."
                                            },
                                            {
                                                "example_id": "4e33c5c3-746b-4a38-b0a6-48fcfbd2b7ae",
                                                "sense_id": "d91f7056-61e0-3596-8d83-526cb3067e03",
                                                "text": "Great Serpents, like undulating clouds, / Crested, rain-reeking. Their bellies blacken the sky; / Their fierce rains flood earth's hill-rimmed vale; / Their drumming is from mountain to mountain; / From horizon to horizon is their thunder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5752377-e88f-39ef-b055-d5a4ac1cf491",
                                        "entry_id": "de198ded-00be-3418-81a8-3191764bf6d3",
                                        "glosses": [
                                            "A pile, a heap (as of snow, hay, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6142d6b-57ad-40be-8a63-941191448fb1",
                                                "sense_id": "d5752377-e88f-39ef-b055-d5a4ac1cf491",
                                                "text": "The fen \"dikes\" have been filled-in in some districts; and the black reeks remind one of snow-reeks, except for their blackness."
                                            },
                                            {
                                                "example_id": "887ee254-d514-49dd-bd79-36d59c2f469a",
                                                "sense_id": "d5752377-e88f-39ef-b055-d5a4ac1cf491",
                                                "text": "\"There'll be snow-reeks as high as houses if I wait half-an-hour longer.\" \"There'll be no occasion for ye to wade thruff snaw-reeks at all, if ye'll go wi' me. I'll tak ye across th' warpin' till ye get to the sand-lane end, […]"
                                            },
                                            {
                                                "example_id": "cc6036e2-0bdd-4b4c-830f-711276e1a27d",
                                                "sense_id": "d5752377-e88f-39ef-b055-d5a4ac1cf491",
                                                "text": "Here a reek of straw was made, and as the reek of corn reduced in size this rose higher; there was skill in making a well balanced reek. The story of the harvest was told at the front of the thresher."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2298fc80-8133-3386-bd00-0c6aa8765037",
                                        "entry_id": "daf8ebed-2a6b-3afd-aa99-ab044c74cabc",
                                        "glosses": [
                                            "A hill; a mountain."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
