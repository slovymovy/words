                        ],
                        "examples": [
                            {
                                "example_id": "d6538a73-9173-4945-87e2-7da73042e9a0",
                                "sense_id": "cb7fd32b-5c74-31f4-8854-0de52d94d4e1",
                                "text": "Super viceloque, le vendeur, un vieux faisan déguisé en homme du monde, a bien discerné la convoitise."
                            },
                            {
                                "example_id": "0c8aa4ff-41fa-4865-9038-5f5c3d02d7b5",
                                "sense_id": "cb7fd32b-5c74-31f4-8854-0de52d94d4e1",
                                "text": "Si on me traite de Jean-Louis Barrault, je ferai le sourdingue et je me vengerai traîtreusement... le coup viceloque, imparable, le poignard dans le dos... rien de tel !"
                            }
                        ]
                    },
                    {
                        "sense_id": "b450c15e-f622-3b12-9dd4-d16c82a5d3b8",
                        "entry_id": "0be84cd7-69e3-3df4-aa2d-76dcd4af3a4a",
                        "glosses": [
                            "Érotique, polisson."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "61646474-70e1-4557-90ff-8eb21fd80d97",
                                "sense_id": "b450c15e-f622-3b12-9dd4-d16c82a5d3b8",
                                "text": "Colette reprenait place près de Brigitte, lui coupant une très jolie séquence de sa gamberge viceloque, assez tôt pour que la jolie môme puisse encore loyalement croire qu’elle venait d’être assaillie par de mauvaises pensées."
                            }
                        ]
                    }
