                ],
                "senses": [
                    {
                        "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                        "entry_id": "5058278e-8b91-3ac3-ab77-3490cbe0f7e5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "475e8f4b-4e62-49c5-9e6f-42649aa56aa8",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Herr Leipold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dd6b7588-fe43-47aa-80f4-0d40b125801f",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Die Leipolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bfa731ab-2d16-4ff1-b24f-622ab5e88e0b",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Der Leipold trägt nie die Schals, die die Leipold ihm strickt."
                            },
                            {
                                "example_id": "224b7d8e-e34f-4317-b613-18db0281c001",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Leipold kommt, geht der Herr Leipold.“"
                            },
                            {
                                "example_id": "3bfa3c9c-dabd-48c0-98d4-e4143bdc67f6",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Leipold kommt und geht."
                            },
                            {
                                "example_id": "dfbea183-547d-4240-aa44-127fe2ed9300",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Leipolds kamen, sahen und siegten."
                            },
                            {
                                "example_id": "2802036d-4033-4259-b0c6-f6a2819e1fbb",
                                "sense_id": "d186ec00-935b-3c05-bf70-5667ea600290",
                                "text": "Frau Leipold ist ein Genie im Verkauf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
