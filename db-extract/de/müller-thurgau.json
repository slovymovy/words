                "senses": [
                    {
                        "sense_id": "87b5e947-d680-3e55-a986-8db9c5b260f6",
                        "entry_id": "9f0d7150-7a4d-3336-b7a1-8840087afb1c",
                        "glosses": [
                            "weiße Rebsorte, die heute auch in Deutschland aus Marketinggründen vielfach Rivaner genannt wird. Sie wurde 1882 von dem Schweizer Rebforscher Hermann Müller an der Forschungsanstalt Geisenheim im Rheingau gezüchtet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e4a036e-e2cc-48f8-bcfb-fff80b96fd9e",
                                "sense_id": "87b5e947-d680-3e55-a986-8db9c5b260f6",
                                "text": "\"Trocken und halbtrocken ausgebaut wird die Rebsorte Müller-Thurgau heute sehr häufig als \"Rivaner\" bezeichnet, nach den ursprünglich vermuteten Elternreben Riesling und Silvaner."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e414417b-bde5-36ee-b30e-18036f0d844c",
                        "entry_id": "9f0d7150-7a4d-3336-b7a1-8840087afb1c",
                        "glosses": [
                            "Wein, der aus Trauben der Rebsorte Müller-Thurgau hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3155966f-46f7-429a-9884-591b3ef4707f",
                                "sense_id": "e414417b-bde5-36ee-b30e-18036f0d844c",
                                "text": "In der Ostschweiz ist der Müller-Thurgau als Riesling x Silvaner bekannt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
