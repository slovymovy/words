                                                "sense_id": "52ba7c23-f247-3dcb-a50b-c799d511dbf0",
                                                "text": "L’exfoliation s’opère naturellement."
                                            },
                                            {
                                                "example_id": "f6e6061c-55e0-436c-b01a-ae5ef2e83b63",
                                                "sense_id": "52ba7c23-f247-3dcb-a50b-c799d511dbf0",
                                                "text": "L’exfoliation est la pratique cosmétique consistant à retirer les cellules de peau mortes de l’épiderme, la couche supérieure de la peau."
                                            }
                                        ]
                                    }
                                ]
                            }
