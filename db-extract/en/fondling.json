                "forms": [
                    {
                        "form_id": "ea2e9ccb-b678-4ba3-b54e-6a64dc1ae1f2",
                        "entry_id": "25cae073-c4e0-35ea-8170-7e9d30ccfa88",
                        "tags": [
                            "plural"
                        ],
                        "form": "fondlings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fc600a5-c133-3f5d-8f5b-19272149a53d",
                        "entry_id": "25cae073-c4e0-35ea-8170-7e9d30ccfa88",
                        "glosses": [
                            "A foolish person."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1bb1368c-8f35-46c2-ae45-e6f283312ed9",
                                "sense_id": "8fc600a5-c133-3f5d-8f5b-19272149a53d",
                                "text": "Yet were her words and lookes but false and fayned, / To some hid end to make more easie way, / Or to allure such fondlings whom she trayned / Into her trap […]."
                            },
                            {
                                "example_id": "ffbc09a7-3b15-4953-916f-28acbef94762",
                                "sense_id": "8fc600a5-c133-3f5d-8f5b-19272149a53d",
                                "text": "'How can you say I am harsh, you naughty fondling?' cried the mistress, amazed at the unreasonable assertion."
                            }
                        ]
                    },
                    {
                        "sense_id": "013b79f7-98c0-3a8d-902e-d9f7c4633e17",
                        "entry_id": "25cae073-c4e0-35ea-8170-7e9d30ccfa88",
                        "glosses": [
                            "A pet or person who is fondled; someone who is much loved."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d61b1db9-f153-47cd-b981-fbea5e742ebf",
                        "source_entry_id": "25cae073-c4e0-35ea-8170-7e9d30ccfa88",
                        "source_sense_description": "a pet or person",
                        "target_lang_word": "люби́мец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "люби́мец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1363b10e-8c91-3ac3-ae13-3e91e626e72b",
                                        "entry_id": "c8c3b0d5-83d0-3bbd-9365-67ae3948cb6f",
                                        "glosses": [
                                            "тот, кого предпочитают другим вследствие испытываемой к нему глубокой симпатии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c8de44-1fe4-4495-8fad-b1c2a63b1e12",
                                                "sense_id": "1363b10e-8c91-3ac3-ae13-3e91e626e72b",
                                                "text": "Некогда доверенный камердинер и любимец князя, Скворцалупов был возведен княгинею в почетное звание управляющего домом."
                                            },
                                            {
                                                "example_id": "ded6ea64-84bb-4ba6-9c1e-0337247105b0",
                                                "sense_id": "1363b10e-8c91-3ac3-ae13-3e91e626e72b",
                                                "text": "Ещё в училище он выделялся подчеркнутой, будто врожденной своей выправкой, властным выражением тонкого бледного лица ― лучший курсант в дивизионе, любимец командиров-строевиков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "493c86fe-2522-4b7d-8b40-7988ab962734",
                        "source_entry_id": "25cae073-c4e0-35ea-8170-7e9d30ccfa88",
                        "source_sense_description": "a pet or person",
                        "target_lang_word": "люби́мица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "люби́мица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fe1603f9-b857-3ede-89f2-0677f4cc9024",
                                        "entry_id": "13ba8140-e459-3fcd-a19e-5aa44d70ce1e",
                                        "glosses": [
                                            "женск. к любимец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc9500f-adc5-4b04-b4b9-158ae116a15f",
                                                "sense_id": "fe1603f9-b857-3ede-89f2-0677f4cc9024",
                                                "text": "Рифма изрядно определена подобным окончанием последних слогов двух речей, но, чаю, нужно к тому примечать, что многосложные речи руские иные имеют ударение го́лоса на последнем слоге, как рука, звезда, толокно, иные — на предпоследнем, как сажа, сочевица, окошко; иные — на препредпоследнем, как стенание, изряднее, любимица (не упоминая о других, в которых ударение ещё далее относится, как в слове вся́ческая, понеже к нашему делу не служат)."
                                            },
                                            {
                                                "example_id": "f08bac8b-75af-4fa9-930c-64de1587d868",
                                                "sense_id": "fe1603f9-b857-3ede-89f2-0677f4cc9024",
                                                "text": "― Эй, ты, Волга, прощай, наша матушка, наша любимица сердешная, прощай!"
                                            },
                                            {
                                                "example_id": "bbed31ef-a666-4e51-8cc9-e737cb5b6b13",
                                                "sense_id": "fe1603f9-b857-3ede-89f2-0677f4cc9024",
                                                "text": "Они уговорили участвовать японскую звезду Тэдзуко Куроянаги (а я впоследствии убедился, что это актриса, известная в Японии каждому дворнику, ― всеобщая любимица, на уровне наших Высоцкого, Пугачевой)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
