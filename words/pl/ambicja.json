            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c105318-dfc6-3042-874d-936b19ab75fd",
                    "sense_definition": "silne pragnienie osiągnięcia sukcesu, zdobycia czegoś trudnego lub doskonalenia się",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dązenie do sukcesu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielka <w>ambicja</w> nie pozwalała jej zrezygnować mimo wielu porażek po drodze.",
                            "target_lang_translations": {
                                "ru": "Огромное <w>честолюбие</w> не позволяло ей сдаться, несмотря на множество неудач на пути."
                            }
                        },
                        {
                            "text": "Ten młody pracownik ma ogromne <w>ambicje</w> i z pewnością szybko awansuje.",
                            "target_lang_translations": {
                                "ru": "У этого молодого сотрудника большие <w>амбиции</w>, и он непременно быстро пойдёт на повышение."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspiracja",
                        "pragnienie"
                    ],
                    "common_phrases": [
                        "wielka ambicja",
                        "mieć ambicję",
                        "chore ambicje"
                    ],
                    "target_lang_definitions": {
                        "ru": "сильное стремление к достижению успеха, получению признания или самосовершенствованию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбиция",
                                "target_lang_sense_clarification": "стремление к успеху, целям"
                            },
                            {
                                "target_lang_word": "честолюбие",
                                "target_lang_sense_clarification": "желание достичь славы, успеха"
                            },
                            {
                                "target_lang_word": "целеустремлённость",
                                "target_lang_sense_clarification": "настойчивое стремление к цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9c7de7-4195-3e0e-bce5-92a8c9dbdc21",
                    "sense_definition": "konkretny, wymagający cel lub plan życiowy, który ktoś zamierza zrealizować",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dązenie do sukcesu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego największą życiową <w>ambicją</w> było ukończenie prestiżowych studiów medycznych.",
                            "target_lang_translations": {
                                "ru": "Его главной жизненной <w>целью</w> было окончить престижный медицинский вуз."
                            }
                        },
                        {
                            "text": "Ona zawsze miała wysokie <w>ambicje</w> dotyczące przyszłej kariery zawodowej.",
                            "target_lang_translations": {
                                "ru": "У неё всегда были высокие <w>притязания</w> насчёт будущей профессиональной карьеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "aspiracja"
                    ],
                    "common_phrases": [
                        "życiowa ambicja",
                        "wysokie ambicje"
                    ],
                    "target_lang_definitions": {
                        "ru": "конкретная масштабная цель, притязание или жизненный план, требующий значительных усилий для реализации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амбиция",
                                "target_lang_sense_clarification": "часто во мн. ч.: притязания, масштабный план"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "жизненная цель, намерение"
                            },
                            {
                                "target_lang_word": "притязание",
                                "target_lang_sense_clarification": "заявка на высокий уровень чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c08e635-37b0-34bb-987c-9eed26b5f8a2",
                    "sense_definition": "poczucie własnej godności i wartości, duma osobista",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "godność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Urażona <w>ambicja</w> sprawiła, że odmówił przyjęcia pomocy od swoich przyjaciół.",
                            "target_lang_translations": {
                                "ru": "Уязвлённое <w>самолюбие</w> заставило его отказаться от помощи друзей."
                            }
                        },
                        {
                            "text": "Moja własna <w>ambicja</w> nie pozwala mi zostawić tego zadania niedokończonego.",
                            "target_lang_translations": {
                                "ru": "Моя собственная <w>гордость</w> не позволяет мне оставить это задание незаконченным."
                            }
                        }
                    ],
                    "synonyms": [
                        "godność",
                        "honor"
                    ],
                    "common_phrases": [
                        "urażona ambicja",
                        "podrażniona ambicja",
                        "ambicja każe",
                        "kwestia ambicji"
                    ],
                    "target_lang_definitions": {
                        "ru": "чувство собственного достоинства, самоуважение или обострённая гордость"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самолюбие",
