                                            {
                                                "example_id": "8b548c3f-a5b1-41f5-ae41-f8b3962484dd",
                                                "sense_id": "3680daa9-5b6b-3c5a-9918-b3b67f480582",
                                                "text": "La blessure du trois-quarts montpelliérain Arthur Vincent, face à Brive, lors de la 3ᵉ journée de championnat, n’était pas si anodine."
                                            },
                                            {
                                                "example_id": "44097caa-110f-4814-afad-355ed0f775f8",
                                                "sense_id": "3680daa9-5b6b-3c5a-9918-b3b67f480582",
                                                "text": "L'exploitation de M. Guy VINCENT (cheptel nᵒ 19110037), sise au lieu-dit «Le Braud», commune de LATRONCHE (19160) est placée sous la surveillance du Dr MONET Jacques, vétérinaire sanitaire à MAURIAC."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Vincent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "099fd30a-0f86-3985-b568-018be0b3be82",
                                        "entry_id": "07962425-4c94-3a4c-8afa-8c46fa39f034",
                                        "glosses": [
                                            "Village et ancienne commune française, située dans le département du Jura intégrée dans la commune de Vincent-Froideville en avril 2016."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Vincent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                                        "entry_id": "9d9c2895-3649-310d-a132-f7b8444d536c",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77529724-f416-4ef4-b29d-f0ef6ffd87b6",
                                                "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                                                "text": "Quand tante Claire donnait le signal du départ, Vincent bougonnait que les femmes étaient des casseuses de veillée. Il finissait par se lever péniblement."
                                            },
                                            {
                                                "example_id": "2a835c60-7d07-4b2c-90c5-333a664635bc",
                                                "sense_id": "4e2b5d6d-141d-3b9e-adb8-ecd21300558b",
                                                "text": "Bien accompagnée par des musiciens talentueux dont l’harmoniciste inspiré, Vincent Bucher, Joyce Tape a chanté, dansé au rythme du blues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
