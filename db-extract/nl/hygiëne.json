                    {
                        "sense_id": "b3d87b65-9297-3e85-ac0c-f811d03ef510",
                        "entry_id": "34d94538-59f6-354b-9b5e-35c461a13ad4",
                        "glosses": [
                            "alles wat een goede gezondheid vereist en de handelingen, inrichtingen en instellingen die deze bevorderen zoals b.v. het schoon-zijn om infectie te voorkomen, gezondheidsleer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef6dac61-a258-4738-bd9a-2de149045931",
                                "sense_id": "b3d87b65-9297-3e85-ac0c-f811d03ef510",
                                "text": "Persoonlijke hygiëne is natuurlijk een dingetje als je meer dan tien dagen niet doucht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233608de-10f1-4ef5-bff7-95d74c2e5d96",
                        "source_entry_id": "34d94538-59f6-354b-9b5e-35c461a13ad4",
                        "source_sense_id": "b3d87b65-9297-3e85-ac0c-f811d03ef510",
                        "target_lang_word": "卫生",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3cddf760-799c-4de2-83e4-d6728313fd1c",
                        "source_entry_id": "34d94538-59f6-354b-9b5e-35c461a13ad4",
                        "source_sense_id": "b3d87b65-9297-3e85-ac0c-f811d03ef510",
                        "target_lang_word": "Hygiene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hygiene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                        "entry_id": "ad19fdd0-bcc2-318f-a76a-6ee3e555b290",
                                        "glosses": [
                                            "Maßnahmen, die der Erhaltung der Sauberkeit dienen; Körperpflege, Reinlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1dc35a1-3b36-4c98-af13-6bea17286b77",
                                                "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                                "text": "Packen Sie bitte auch etwas für die persönliche Hygiene mit ein."
                                            },
                                            {
                                                "example_id": "2f48329f-fd94-477c-a9f2-72136ae9ef48",
                                                "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                                "text": "„Du solltest die Tastatur und den Telefonhörer im Büro regelmäßig mit Alkohol reinigen. Sonst ist das einfach mangelnde Hygiene.“"
                                            },
                                            {
                                                "example_id": "e3101a9b-0516-47f8-83bd-4f27d0408b11",
                                                "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                                "text": "Unter \"Hochdruck\" haben russische Kosmonauten am Wochenende eine Weltraum-Toilette auf der Raumstation ISS repariert. Die Hygiene auf einer Raumstation ist kompliziert und entbehrungsreich."
                                            },
                                            {
                                                "example_id": "b4b7dcb6-f84e-4023-8b73-7cc3a46f6af7",
                                                "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                                "text": "„Ich zog mich folgendermaßen aus der Angelegenheit, ohne etwas befürchten zu müssen, obwohl die Sache riskant war; denn gerade in Venedig herrschte in Fragen der Hygiene äußerste Strenge.“"
                                            },
                                            {
                                                "example_id": "9a91c03d-9679-40bf-97d4-25c2106a9804",
                                                "sense_id": "129466a4-d030-3370-8d1e-78903498fc76",
                                                "text": "„Zur Zeit der Pharaonen war man in Ägypten stets auf Hygiene und Sauberkeit bedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "49a885c8-c7bf-3cd9-8a6b-d1f2c2fcbaa0",
                                        "entry_id": "ad19fdd0-bcc2-318f-a76a-6ee3e555b290",
                                        "glosses": [
                                            "Gesundheitspflege, alle Aktivitäten, um Menschen gesund zu erhalten und Krankheiten zu verhüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b42913-eb7b-4e8b-9ef8-683264c1c995",
                                                "sense_id": "49a885c8-c7bf-3cd9-8a6b-d1f2c2fcbaa0",
                                                "text": "Im Krankenhaus ist Hygiene besonders wichtig."
                                            },
                                            {
                                                "example_id": "c9c68336-1e2d-461f-be81-69ff6ef95f5e",
                                                "sense_id": "49a885c8-c7bf-3cd9-8a6b-d1f2c2fcbaa0",
                                                "text": "Südkorea kämpft verzweifelt gegen die Verbreitung des MERS-Virus. Die Zahl der Neuerkrankungen und Todesfälle nimmt zu. Die Regierung will mit Quarantäne und Hygiene den Ausbruch unter Kontrolle bringen."
                                            },
                                            {
                                                "example_id": "e5e05e1a-0a62-44ed-91b2-4dea15a0c688",
                                                "sense_id": "49a885c8-c7bf-3cd9-8a6b-d1f2c2fcbaa0",
                                                "text": "„In den verschiedenen Sektionen wies der Kongreß eine erstaunliche disziplinäre Vielfalt auf: Physiologie und Pathologie der Sexualität wurden ebenso behandelt wie Psychologie und Pädagogik, Hygiene und Eugenik, Soziologie und Kultur, Kriminologie und Familienrecht.“"
                                            },
                                            {
                                                "example_id": "c0eee038-14ce-40b2-82a4-50026cc96d13",
                                                "sense_id": "49a885c8-c7bf-3cd9-8a6b-d1f2c2fcbaa0",
                                                "text": "„Mangelnde Hygiene in Krankenhäusern oder die hohe Zahl der Alkoholopfer stellen in Deutschland wirklich relevante Probleme dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6c8af154-4cbb-3249-9bbc-fcbcb31458c5",
                                        "entry_id": "ad19fdd0-bcc2-318f-a76a-6ee3e555b290",
                                        "glosses": [
                                            "Fachbereich Gesundheitslehre, über die Förderung und Erhaltung von Gesundheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49e0f75-e310-4d56-be33-ad8daafcb4e1",
                                                "sense_id": "6c8af154-4cbb-3249-9bbc-fcbcb31458c5",
                                                "text": "Morgen steht Hygiene auf dem Lehrplan."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
