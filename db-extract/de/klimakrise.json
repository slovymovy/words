                    }
                ],
                "senses": [
                    {
                        "sense_id": "aca98fc1-90f9-38a8-9e2b-7fd8e9851070",
                        "entry_id": "567de2c2-bcb1-37db-bf81-23fc33140629",
                        "glosses": [
                            "globale Krise, ausgelöst durch die menschengemachten Klimaerwärmung ab dem 20. Jahrhundert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa20fb49-a6cd-4e77-a8e9-39e19ac301c1",
                                "sense_id": "aca98fc1-90f9-38a8-9e2b-7fd8e9851070",
                                "text": "„Zahlreiche Politiker, Wissenschaftler und prominente Aktivisten haben am Samstag (Ortszeit) zu stärkeren und schnelleren Anstrengungen im Kampf gegen die Klimakrise aufgerufen.“"
                            },
                            {
                                "example_id": "e032089d-e14f-4888-8a5a-0a35e31b07e5",
                                "sense_id": "aca98fc1-90f9-38a8-9e2b-7fd8e9851070",
                                "text": "„Die Klimakrise wird sich also nur bewältigen lassen, wenn die Staaten und Firmen beide Wege beschreiten: CO₂ einsparen und einlagern.“"
                            },
                            {
                                "example_id": "4e140542-db60-4bbf-a487-be1d6e6358f7",
                                "sense_id": "aca98fc1-90f9-38a8-9e2b-7fd8e9851070",
                                "text": "„Weltweite Aufforstungen sollen die Klimakrise abwenden – denn Milliarden neuer Bäume könnten das Treibhausgas Kohlenstoffdioxid aus der Luft filtern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f29e075e-2dc5-4c51-90af-8e1c496af632",
                        "source_entry_id": "567de2c2-bcb1-37db-bf81-23fc33140629",
                        "source_sense_id": "aca98fc1-90f9-38a8-9e2b-7fd8e9851070",
                        "target_lang_word": "climate crisis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climate crisis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                        "entry_id": "b635473c-0a93-32c8-82e9-8476d5164e96",
                                        "glosses": [
                                            "Synonym of climate emergency."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ba5a8a7-38e7-451f-9570-b18cb36aadbe",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "If you have any doubt, just look at what’s on: The Robert Blake trial. The Laci Peterson tragedy. […] And more importantly, notice what is not on: the global climate crisis, the nation’s fiscal catastrophe, the hollowing out of America’s industrial base, and a long list of other serious public questions that need to be addressed by the American people."
                                            },
                                            {
                                                "example_id": "48901bad-3306-4441-875e-6f58a3f5a505",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "The climate crisis is not, in fact, a mystery or a riddle we haven’t yet solved due to insufficiently robust data sets. We know what it would take, but it’s not a quick fix – it’s a paradigm shift."
                                            },
                                            {
                                                "example_id": "058a3b9b-edca-4b00-adff-adc4d0107c4a",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "“The urgency of taking action against the climate crisis has prompted us to bring the first climate lawsuit in Italy against the country’s largest energy company,” said Matteo Ceruti, a lawyer for the plaintiffs."
                                            },
                                            {
                                                "example_id": "84334eae-d0c8-4bc3-afcd-2c49af2faae4",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "Gloninger’s experience is all too common among meteorologists across the country who are encountering reactions from viewers as they tie the climate crisis to extreme temperatures, blizzards, tornadoes and floods in their local weather reports."
                                            },
                                            {
                                                "example_id": "4077ce5e-a4f7-428c-af7f-44675dd933f5",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "He said that with the world facing a climate crisis, \"it is up to those at the forefront of our industry - like Network Rail - to lead by example\"."
                                            },
                                            {
                                                "example_id": "176d4dec-df8a-49b6-a210-456dd9dd8a4a",
                                                "sense_id": "04176c19-349a-36a9-b18f-5f67ac757697",
                                                "text": "The climate crisis remained an important concern for voters, Sciarini said, but “it has been supplanted by immediate worries over purchasing power, inflation and of course mass immigration, all of which were highlighted in the SVP’s campaign”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
