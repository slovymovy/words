                        "glosses": [
                            "A chamber pot enclosed in a stool or box; a commode."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "4af7b138-3353-46aa-bdef-e0d4cf9bb66b",
                                "sense_id": "eb1afee1-6b86-3645-b17a-bda8040ff440",
                                "text": "other Princes, […] to dispatch their weightiest affaires make often their close stoole, their regall Throne or Councel-chamber"
                            },
                            {
                                "example_id": "3c096202-71bd-45ac-9a89-837365c963a5",
                                "sense_id": "eb1afee1-6b86-3645-b17a-bda8040ff440",
                                "text": "[…] be careful and diligent to all strangers, and see that they lack nothing in their Chambers, which your Mistress or Lady will allow, and that your close stools and Chamber pots be duely emptied, and kept clean and sweet."
                            },
                            {
                                "example_id": "88d7fa67-1c21-44a3-820c-0873c65d014d",
                                "sense_id": "eb1afee1-6b86-3645-b17a-bda8040ff440",
                                "text": "[…] being apprised of their ambush, I got home another way, and by the help of my landlord’s apprentice, emptied a close stool out of the garret window, which did great execution upon them […]"
                            },
                            {
                                "example_id": "cdce3da9-fa65-492b-82b6-1bb897c20f17",
                                "sense_id": "eb1afee1-6b86-3645-b17a-bda8040ff440",
                                "text": "\"No more midnight treks to the outhouse. No more close-stools or thundermugs a feature of even the most exalted houses in Armethalieh.\""
                            }
                        ]
                    }
