                "senses": [
                    {
                        "sense_id": "166bd2bf-56ee-3217-978e-16cde2a9da00",
                        "entry_id": "6108b9f8-bc47-33b4-97c1-3fc5aa45a358",
                        "glosses": [
                            "Austausch der Raumluft durch eine kombinierte Zuluft- und Abluftanlage; bei Gleichdruck im Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc997a4a-27da-4962-b641-62cc9f31b217",
                                "sense_id": "166bd2bf-56ee-3217-978e-16cde2a9da00",
                                "text": "„Der Regelfall für mittlere und größere RLT-Anlagen ist die Verbundlüftung, d.h. mit Zuluft- und Abluftventilator und dies möglichst mit gleichem Volumenstrom.“"
                            },
                            {
                                "example_id": "0db5ec9d-2f41-473c-9800-6d62c84d1061",
                                "sense_id": "166bd2bf-56ee-3217-978e-16cde2a9da00",
                                "text": "„Mit dem System der Verbundlüftung reduziert sich die umgewälzte Luftmenge gegenüber einer konventionellen Luftverteilung auf zirka die Hälfte.“"
                            },
                            {
                                "example_id": "5a4052c7-ef08-42b7-a4f4-e0dca5d41edc",
                                "sense_id": "166bd2bf-56ee-3217-978e-16cde2a9da00",
                                "text": "„Die Verbundlüftung ist eine kombinierte Be- und Entlüftung.“"
                            },
                            {
                                "example_id": "b20c2b24-e9eb-4c0e-b72c-767c39caeac3",
                                "sense_id": "166bd2bf-56ee-3217-978e-16cde2a9da00",
                                "text": "„Für raumlufttechnische Anlagen findet wegen der genauen Steuerungsmöglichkeit in der Hauptsache die Verbundlüftung Verwendung, wogegen die Unterdrucklüftung oft für die Entlüftung von Küchen, Toilettenanlagen und Gaststätten eingesetzt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
