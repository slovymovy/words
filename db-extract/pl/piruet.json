                                        "entry_id": "2f4a7c58-d8e2-31de-b196-4bac01fff534",
                                        "glosses": [
                                            "To perform a pirouette; to whirl on the toes, like a dancer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
