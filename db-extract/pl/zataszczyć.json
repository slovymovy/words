                        "sense_id": "da7f5cf0-93df-3e53-a928-ec0e6743deb4",
                        "entry_id": "253676a4-852f-32b2-bdbb-499ac6ec259d",
                        "glosses": [
                            "to lug around"
                        ],
                        "tags": [
                            "colloquial",
