                                            {
                                                "example_id": "2a3dd08d-d7e7-4839-b7a0-6e29236b4a6b",
                                                "sense_id": "28a1abc5-3046-3a98-95fd-b704dc96160d",
                                                "text": "There was for some reason a shortage not only of regular private soldiers but of officers and NCOs."
                                            },
                                            {
                                                "example_id": "ee40e6a9-c963-4a4e-a9d1-f4e24596de24",
                                                "sense_id": "28a1abc5-3046-3a98-95fd-b704dc96160d",
                                                "text": "For Sgt Kudrya, an NCO who has found himself commanding a company because of a lack of officers, this low-level war means a constant struggle with the elements, paper work (he is under constant pressure from above to account for each litre of petrol and round of ammunition), and the erosion of discipline born of boredom."
                                            }
                                        ]
