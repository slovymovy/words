                    {
                        "translation_id": "3000e86e-4c81-43c6-ae6a-bdf4ed2e8efe",
                        "source_entry_id": "e7d406f6-c917-3ea2-8fee-040f82e585e8",
                        "source_sense_description": "to produce or cause to produce a sharp vibrating sound",
                        "target_lang_word": "zupfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zupfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30de21d2-c039-3b02-9f4c-d8683ac9a336",
                                        "entry_id": "7bbbc1fe-bace-36a2-bf4c-0414cf3cf628",
                                        "glosses": [
                                            "ohne große Kraft an etwas in kleinen Rucken ziehen, meist mit den Fingern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4cf347-6e37-4b47-a03d-0b077b14ba5a",
                                                "sense_id": "30de21d2-c039-3b02-9f4c-d8683ac9a336",
                                                "text": "Vorsichtig zupfte er am Ärmel der Jacke, um die Aufmerksamkeit seiner Freundin zu erregen."
                                            },
                                            {
                                                "example_id": "ee50e568-2dd2-4c97-ac40-14da18f84e57",
                                                "sense_id": "30de21d2-c039-3b02-9f4c-d8683ac9a336",
                                                "text": "Vor Nervosität hat der Redner während des ganzen Vortrags an seinem Kinnbart gezupft."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6ba23bc-ba13-3134-bc68-e922564491d7",
                                        "entry_id": "7bbbc1fe-bace-36a2-bf4c-0414cf3cf628",
                                        "glosses": [
                                            "ein Saiteninstrument mittels der Finger oder eines Plektrums mit einem kleinen Ruck in Schwingung versetzen und so zum Klingen bringen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37b2f90-03b3-4c4c-9206-51e4656dc8f0",
                                                "sense_id": "b6ba23bc-ba13-3134-bc68-e922564491d7",
                                                "text": "Die Mandoline richtig zu zupfen will gelernt sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b5884de6-cbf3-34aa-87f2-29b8ff5c0065",
                                        "entry_id": "7bbbc1fe-bace-36a2-bf4c-0414cf3cf628",
                                        "glosses": [
                                            "etwas ruckartig ausreißen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c53095ac-950a-4305-8b4f-4b6adc74ac30",
                                                "sense_id": "b5884de6-cbf3-34aa-87f2-29b8ff5c0065",
                                                "text": "Im Gemüsebeet muss immer wieder Unkraut gezupft werden, damit das Gemüse gedeiht."
                                            },
                                            {
                                                "example_id": "6d5534b6-6356-44c3-ab17-6630e3b48348",
                                                "sense_id": "b5884de6-cbf3-34aa-87f2-29b8ff5c0065",
                                                "text": "Zupfst du deine Augenbrauen nicht?"
                                            },
                                            {
                                                "example_id": "d9aa272c-5887-4970-b5fe-20c63cd37cf7",
                                                "sense_id": "b5884de6-cbf3-34aa-87f2-29b8ff5c0065",
                                                "text": "Das Mädchen zupft in Gedanken versunken die Blütenblätter aus der Blüte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
