                                "example_id": "3c7a4654-ce5c-4262-8519-4cc39f9092b0",
                                "sense_id": "d99f27fb-5420-38f1-a147-31cb65722bfb",
                                "text": "Le sable ne produit qu’un effet physique : il divise les particules de chaux et empêche la matière de prendre trop de retrait en séchant, ce qui entraînerait des fendillements."
                            },
                            {
                                "example_id": "0f83ca3a-08c5-4ef4-805a-71d571347011",
                                "sense_id": "d99f27fb-5420-38f1-a147-31cb65722bfb",
                                "text": "D’autres piliers s’indiquaient aux alentours, que la lézarde paraissait aussi gagner, par des fendillements ramifiés en tous sens."
                            }
                        ]
                    }
