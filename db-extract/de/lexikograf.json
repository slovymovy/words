                        "form": "den Lexikografen"
                    },
                    {
                        "form_id": "04b8fad7-7f07-40d2-b815-2617480bc677",
                        "entry_id": "89e594fc-6d2f-3ace-800e-eebe27909707",
                        "tags": [
                            "accusative",
