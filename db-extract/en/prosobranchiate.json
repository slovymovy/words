                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "885560e2-9039-4472-8db1-75f192a2fa0c",
                                "sense_id": "03b58ff7-c355-3282-9e02-765a09195339",
                                "text": "An external shell, usually sufficiently large to contain the entire animal, is common to all the prosobranchiates."
                            },
                            {
                                "example_id": "e19210dd-d896-4e75-93b1-f76f306576f8",
                                "sense_id": "03b58ff7-c355-3282-9e02-765a09195339",
                                "text": "Pulmonate freshwater snails are found in every type of fresh water, as one might expect, and equally predictably the prosobranchiates are found only in streams and rivers."
                            },
                            {
                                "example_id": "15ff2a46-3e33-4077-946d-2586ece3585d",
                                "sense_id": "03b58ff7-c355-3282-9e02-765a09195339",
                                "text": "The number of axons in the static nerve of prosobranchiates is usually greater than the number of receptor cells."
                            }
                        ]
                    }
