{
    "word_family": [
        "thin",
        "thinly",
        "thinness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "77f19a9a-1b96-314d-aa8e-1e6a23486fe9",
                    "sense_definition": "comparative form of <w>thin</w>: more thin",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ice on the lake is <w>thinner</w> today than it was yesterday.",
                            "target_lang_translations": {
                                "ru": "Лёд на озере сегодня <w>тоньше</w>, чем был вчера."
                            }
                        },
                        {
                            "text": "She has <w>thinner</w> hair than her sister.",
                            "target_lang_translations": {
                                "ru": "У неё волосы <w>тоньше</w>, чем у её сестры."
                            }
                        }
                    ],
                    "antonyms": [
                        "thicker"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "comparative adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сравнительная степень прилагательного «тонкий»: более тонкий"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоньше",
                                "target_lang_sense_clarification": "сравнительная степень прилагательного «тонкий»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ae7767b-5625-3aed-8a42-df954879ef1c",
                    "sense_definition": "A liquid substance used to reduce the thickness or viscosity of another liquid, such as paint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to add some paint <w>thinner</w> to make the mixture easier to apply.",
                            "target_lang_translations": {
                                "ru": "Нужно добавить немного <w>растворителя</w> для краски, чтобы смесь было легче наносить."
                            }
                        },
                        {
                            "text": "Clean your brushes with <w>thinner</w> immediately after you finish painting.",
                            "target_lang_translations": {
                                "ru": "Очищайте кисти <w>растворителем</w> сразу после окончания работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "solvent",
                        "diluent"
                    ],
                    "common_phrases": [
                        "paint thinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "жидкое вещество, используемое для уменьшения вязкости другой жидкости, например краски"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растворитель",
                                "target_lang_sense_clarification": "вещество для растворения красок и лаков"
                            },
                            {
                                "target_lang_word": "разбавитель",
                                "target_lang_sense_clarification": "вещество для уменьшения концентрации или вязкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85f5796b-cd73-3d90-8275-94b9b173584d",
                    "sense_definition": "Something that reduces the density, quantity, or thickness of something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors often prescribe a blood <w>thinner</w> to prevent heart attacks in older patients.",
                            "target_lang_translations": {
                                "ru": "Врачи часто назначают препараты, <w>разжижающие</w> кровь, для предотвращения сердечных приступов у пожилых пациентов."
                            }
                        },
                        {
                            "text": "The gardener used a mechanical <w>thinner</w> to remove excess fruit from the trees.",
                            "target_lang_translations": {
                                "ru": "Садовник использовал механический <w>разжижитель</w> (прореживатель), чтобы удалить лишние плоды с деревьев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blood thinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "средство или устройство, которое уменьшает плотность, количество или толщину чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разжижитель",
                                "target_lang_sense_clarification": "техническое вещество для снижения вязкости"
                            },
                            {
                                "target_lang_word": "антикоагулянт",
                                "target_lang_sense_clarification": "медицинский препарат, разжижающий кровь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}