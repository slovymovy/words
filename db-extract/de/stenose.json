                        "translation_id": "7f8d3d64-197e-4e38-bce0-13bb7f700b15",
                        "source_entry_id": "116d97ca-46ab-39f5-bc55-87a7fc573a97",
                        "source_sense_id": "787a3831-d46e-3742-89ae-9bcfc62fe340",
