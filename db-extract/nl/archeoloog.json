        "nl-extract.jsonl": [
            {
                "entry_id": "cf54b8e1-0518-3c69-8dd2-41544cbe49fe",
                "word": "archeoloog",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "532c0c8c-294b-41dc-a1bc-d3f105ac133e",
