                                "target_lang_sense_clarification": "difficulty or complication"
                            },
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "difficulty or inconvenience"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "问题",
