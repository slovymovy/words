                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als leidenschaftlicher <w>Fernseher</w> verfolgt er fast jede Sportsendung live.",
                            "target_lang_translations": {
                                "en": "As a passionate <w>TV viewer</w>, he follows almost every sports broadcast live.",
                                "ru": "Будучи страстным <w>телезрителем</w>, он смотрит почти каждую спортивную передачу в прямом эфире.",
                                "nl": "Als gepassioneerd <w>televisiekijker</w> volgt hij bijna elke sportuitzending live.",
                                "pl": "Jako zapalony <w>telewidz</w> śledzi niemal każdą transmisję sportową na żywo.",
                                "fr": "En tant que <w>téléspectateur</w> passionné, il suit presque chaque émission sportive en direct.",
                                "it": "Da appassionato <w>telespettatore</w>, segue quasi tutti i programmi sportivi in diretta.",
                                "cs": "Jako vášnivý <w>televizní divák</w> sleduje téměř každý sportovní přenos živě.",
                                "tr": "Tutkulu bir <w>televizyon izleyicisi</w> olarak neredeyse her spor programını canlı takip eder.",
                                "es": "Como apasionado <w>telespectador</w>, sigue casi todas las transmisiones deportivas en directo.",
                                "zh": "作为一名狂热的<w>电视观众</w>，他几乎收看每一场体育直播。"
                            }
                        },
                        {
                            "text": "Viele <w>Fernseher</w> beschwerten sich beim Sender über die Programmänderung.",
                            "target_lang_translations": {
                                "en": "Many <w>viewers</w> complained to the station about the schedule change.",
                                "ru": "Многие <w>телезрители</w> пожаловались телеканалу на изменение программы.",
                                "nl": "Veel <w>televisiekijkers</w> klaagden bij de zender over de programmawijziging.",
                                "pl": "Wielu <w>telewidzów</w> poskarżyło się stacji na zmianę programu.",
                                "fr": "De nombreux <w>téléspectateurs</w> se sont plaints auprès de la chaîne du changement de programme.",
                                "it": "Molti <w>telespettatori</w> si sono lamentati con l'emittente per il cambio di programma.",
                                "cs": "Mnoho <w>televizních diváků</w> si stěžovalo televizní stanici na změnu programu.",
                                "tr": "Birçok <w>izleyici</w> program değişikliği nedeniyle kanala şikâyette bulundu.",
                                "es": "Muchos <w>telespectadores</w> se quejaron ante la cadena por el cambio de programación.",
                                "zh": "许多<w>电视观众</w>就节目调整向电视台表达了不满。"
                            }
                        }
