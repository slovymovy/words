                    "frequency": "Middle",
                    "semantic_group_id": "spule_gegenstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An der Nähmaschine ist die kleine <w>Spule</w> schon wieder leer geworden."
                        },
                        {
                            "text": "Vor dem Nähen muss man den Faden sorgfältig auf die <w>Spule</w> wickeln."
                        }
                    ],
                    "synonyms": [
                        "Rolle"
                    ],
                    "common_phrases": [
                        "die Spule wechseln",
                        "eine Spule Garn"
                    ]
                },
                {
                    "sense_id": "aa121dad-6c7d-33f4-a11f-20588c408702",
                    "sense_definition": "Aus einem elektrischen Leiter gewickeltes Bauteil, das vor allem wegen seiner Induktivität oder Magnetwirkung genutzt wird.",
