                    },
                    {
                        "translation_id": "bbc8efc6-4072-4bcf-a484-c309b81dfb94",
                        "source_entry_id": "b67cfabd-203c-3f50-b43b-89e6cf68119f",
                        "source_sense_id": "3e08f3c1-f77b-309c-b001-f95f5d59bcc0",
                        "source_sense_description": "Zeichen, das in Texteditoren das Absatzende in Texten markiert",
                        "target_lang_word": "pied de mouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pied de mouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c456b418-eeaa-3556-a66e-ebe8f351d333",
                                        "entry_id": "e621da8d-96fd-3734-8212-eab9a9cf2f12",
                                        "glosses": [
                                            "Signe typographique (¶) dont l’usage propre est d’être placé au début d’un nouveau paragraphe lorsqu’en plus du changement de paragraphe le discours change de sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c625bc-b1dd-4c37-aadc-3b7a97d1bf5e",
                                                "sense_id": "c456b418-eeaa-3556-a66e-ebe8f351d333",
                                                "text": "Le caractère anguleux et allongé des minuscules des premières années du 13ᵉ siècle s'est maintenant étendu à toutes les majuscules, la fourche à l'extrémité des hastes montantes tend à s'écarter encore, on ne trouve quasiment plus de perluettes ni de « e » cédillés, les abréviations plus communes au 13ᵉ siècle comme le « ; » pour le est sont maintenant intégrées et le pied de mouche est connu ([…])."
                                            },
                                            {
                                                "example_id": "4c730d5c-a3cc-4395-b1f5-533d275fabc8",
                                                "sense_id": "c456b418-eeaa-3556-a66e-ebe8f351d333",
                                                "text": "Dans certains ouvrages, les alinéas sont précédés du caractère de paragraphe (U+00A7 §), un pied de mouche (U+00B6 ¶), un pied de mouche réfléchi (U+204B ⁋) ou tout autre signe graphique."
                                            },
                                            {
                                                "example_id": "7d0802c9-209b-4dad-b96d-4e5c4c214f95",
                                                "sense_id": "c456b418-eeaa-3556-a66e-ebe8f351d333",
                                                "text": "Ce signe ¶ est le pied de mouche. Il s’agit de la lettre C, pour caput en latin, ta tête."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
