                            "comment": "mostly used in negative idioms like 'not care a straw'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, не имеющее никакой ценности или важности.",
                        "tr": "Çok az değeri veya önemi olan şey.",
                        "zh": "指价值极低或不重要的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грош",
                                "target_lang_sense_clarification": "в идиомах о ценности"
                            },
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "мелочь"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değersiz",
                                "target_lang_sense_clarification": "önemsiz şey"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微不足道",
                                "target_lang_sense_clarification": "形容价值极低"
                            }
                        ]
                    }
                }
            ]
        },
        {
