                        "sense_id": "deab2ac2-83e4-3d44-a6d1-bf3a7ed8abdb",
                        "entry_id": "e7949caf-713c-3031-963a-224de53fbd2d",
                        "glosses": [
                            "To shut up or in; enclose; enwrap."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4daffb9d-f521-4d90-9e1b-f63dbc83c8bc",
                                "sense_id": "deab2ac2-83e4-3d44-a6d1-bf3a7ed8abdb",
                                "text": "It is our sensuality in which he is enclosed, and our kyndely [natural] substance is beclosed [beclosed, wrapped up] in Jesus Christ, with the blessed soul of Christ sitting in rest in the godhead."
                            },
                            {
                                "example_id": "bc0bec35-8ae5-4b6c-b31b-5b12923e384a",
                                "sense_id": "deab2ac2-83e4-3d44-a6d1-bf3a7ed8abdb",
                                "text": "He is our clothing that for love, wraps us, embraces us, and all becloses us, for tender love that he may never leave us, being to us all thing that is good as to my understanding."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c4673c0-f6f6-3fbb-b920-abaa1d305cdd",
