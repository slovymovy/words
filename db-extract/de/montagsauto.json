                "senses": [
                    {
                        "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                        "entry_id": "72593d08-ae59-34e3-bdbd-a8f6ff7cf1df",
                        "glosses": [
                            "PKW, der sich bereits als Neuwagen durch überdurchschnittlich viele Defekte auszeichnet; zurückgeführt wird die Vermutung darauf, dass Montags PKWs weniger konzentriert/sorgfältig zusammengebaut werden als üblich"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5ac13714-03c1-41a2-9594-807ef3202e67",
                                "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                                "text": "„[…] Wer einen fabrikneuen oder gebrauchten Wagen kauft, will kein Montagsauto bekommen.“"
                            },
                            {
                                "example_id": "fcc22fe5-c01c-435c-b5b1-48f1cb796fe8",
                                "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                                "text": "„Nicht mehrere einzelne Mängel [machen] einen Wagen zum \"Montagsauto\", sondern eine generell schlechte Verarbeitung, die zu immer neuen Mängeln führt.“"
                            },
                            {
                                "example_id": "aa42177e-ba9d-410e-b1ef-72c6292a6edd",
                                "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                                "text": "„Wer ein Montagsauto mit vielen Macken bekommen hat, kann in der Gewährleistungsfrist darauf bestehen, es zurückzugeben.“"
                            },
                            {
                                "example_id": "7f31835a-8e13-4a72-b077-48c37432dcd5",
                                "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                                "text": "„Wer ein Montagsauto erwischt hat, kann nach spätestens zwei erfolglosen Nachbesserunsgsversuchen den Kaufvertrag rückgängig machen.“"
                            },
                            {
                                "example_id": "af2561dd-b866-4d2f-8070-948f1a352fb2",
                                "sense_id": "7fee2b3b-01cf-3d2d-8610-f58237dc73a8",
                                "text": "„Jahrelang soll Chrysler seinen Kunden wieder hergestellte Montagsautos verkauft haben, ohne sie über deren Historie zu informieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
