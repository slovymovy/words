                                        "glosses": [
                                            "Of, relating to, acting between, or comprising two or more metals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af58e60f-13a0-49fa-93d0-47bf560a1a3c",
                                                "sense_id": "4fee8cf3-33dd-3827-be73-dcb3530d19c1",
                                                "text": "An intermetallic compound must be present, the high freezing-point of which indicates that it is formed from its components with the liberation of a large amount of energy."
                                            }
                                        ]
                                    }
