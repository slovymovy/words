                                ]
                            },
                            {
                                "target_word": "sausage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a96089-98e1-3828-8260-2edc28013b27",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To squeeze tightly into (something) in a rolled or sausage-like form."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af42091-2843-48b7-b1a7-357d522cf49d",
                                                "sense_id": "c5a96089-98e1-3828-8260-2edc28013b27",
                                                "text": "He leapt to his feet, carefully sausaged his screwdrivers in a roll beneath his arm and turned to reach into the box."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To squeeze (something) into something tightly fitting."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b426c3e1-790e-410d-b2ed-a2a922d98dcc",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "He is sausaged into several overcoats and wears a brown macintosh under which he holds a roll of parchment."
                                            },
                                            {
                                                "example_id": "e812a0dd-a916-4d25-97ee-960c8d0c0d9d",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "The second Mrs. Teague wore a baby blue tank top and too-tight white shorts that sausaged her hips."
                                            },
                                            {
                                                "example_id": "36207e5c-9cae-4e8c-8901-ab80b6a1ae1f",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "Now it was my turn to whip my wrap off the ground. I quickly sausaged myself within it while simultaneously dusting sand off my arms and legs."
                                            },
                                            {
                                                "example_id": "5946fe4b-5501-4bb0-a1ea-fcd1d1b60877",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "No longer able to wear white socks and slippers, she wore Tet Hose that sausaged her swollen feet and legs."
                                            },
                                            {
                                                "example_id": "7a368394-1ee1-4924-a255-f1a89ba68b4d",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "Knit blankets sausaged their legs."
                                            },
                                            {
                                                "example_id": "bfd755a7-213a-4fa7-8a2c-231699196674",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "In the top drawer were neatly piled thermals and socks sausaged into pairs."
                                            },
                                            {
                                                "example_id": "0160a256-14fb-4a5d-9157-a375fe2d1784",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "Socks she sausaged like everyone else, but T-shirts she folded and stacked like a factory worker."
                                            },
                                            {
                                                "example_id": "22a53bf3-bfba-4392-be69-7f6f91219661",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "Filled to bursting with IV fluids, the skin on my hips is taut; it feels like I’ve sausaged myself into pantyhose five sizes too small."
                                            },
                                            {
                                                "example_id": "d6bda9e1-8f27-41af-8676-87615aa220ba",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "Oh well, yes, I sausaged myself into the dark-blue wool—quite proper—and walked forever to the 21 Club where Dad was being tossed out—raging, whining—I hadn’t, I’ve told you already—seen him in years."
                                            },
                                            {
                                                "example_id": "30cf29ae-4e6e-4954-9cc0-f2f411cdb68e",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "In her arms, an infant sausaged inside a rolled cedar mat."
                                            },
                                            {
                                                "example_id": "9fa56672-c45e-4936-a894-9b48b8b13b42",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "My soldier has pulled the maid’s apron from the mannequin in the larder, and sausaged his hairy thighs inside splitting the lace and seams, […]"
                                            },
                                            {
                                                "example_id": "1131ec88-8aec-45bb-95e4-693f9263c5eb",
                                                "sense_id": "eedea6dc-e411-37b1-94bd-d63b82044fdc",
                                                "text": "There’s nothing worse than having cashed out the college fund so that Mom and Dad and Buddy and Sis can afford airfare to Wally World, only to find out that they are additionally facing bag fees and snack fees, and soon enough, there will likely be a fee to have the 350-pound man sausaged next to Sis in the middle seat keep his meaty elbows out of her ribcage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61992967-08f4-3595-83e1-3a2c2dc2157d",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To fit snugly into."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ede7b62a-6df1-40b0-8563-80c60fe9c239",
                                                "sense_id": "61992967-08f4-3595-83e1-3a2c2dc2157d",
                                                "text": "Dressing in a flash, she sausaged on her skinny jeans and sleeveless camo top with peek-a-boo sides for boob aficionados."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To make into sausage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911540b1-9290-4110-8797-888e768f99b1",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "There is no escaping the Limerick pig. In single file, in battalions, as solitary scout, alive or dead, baconed and sausaged, he dominates the town."
                                            },
                                            {
                                                "example_id": "a030ba61-6523-49d9-9e64-2a7cf3ad85f0",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "I mayn’t know much about pigs, but I know a lot about Muckley, and there must be something pretty wrong with any pigs that he wouldn’t risk sausaging."
                                            },
                                            {
                                                "example_id": "a2fc8284-28c7-47c2-b3ff-9f4e55300067",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "At butchering time, they kept three pigs for their own use, smoking, brining, and sausaging the meat, and trying the lard."
                                            },
                                            {
                                                "example_id": "43b2c077-87d7-41ff-aefb-7fb84ba4833e",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "Long afterward Renate remembered “the pigs squeaking and jerking while coming down a funnel in which they were shorn…on their way to getting quartered and sausaged” and the elevator that “released one steer at a time” to be “greeted with a blow of a sledge hammer on his head.”"
                                            },
                                            {
                                                "example_id": "8509b256-01db-4e8a-857e-21cc86361089",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "The fresh meat was sausaged into the tripes of pig and deer and ox, because the time for salting was not yet come."
                                            },
                                            {
                                                "example_id": "9eae441c-1e1c-4716-ac3d-1a97ec1fbc68",
                                                "sense_id": "3ec09a59-28e5-3c5b-8015-4e37e9ec04f1",
                                                "text": "So I took the lot and had much of it custom-smoked, then I roasted, fried, grilled, sautéed, stir-fried, stewed, braised, and sausaged the rest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7261c2d-6092-33b9-b5d0-070b8d60052d",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To make sausage-like, especially to give the appearance of barely fitting into the casing or skin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c1b2d9-9d2b-4bdd-bff4-cd4d23f2a9bf",
                                                "sense_id": "d7261c2d-6092-33b9-b5d0-070b8d60052d",
                                                "text": "Blood and gravity had sausaged her legs and feet, fattening them into white-stocking loaves that dangled eighteen inches above her neatly folded nurse’s uniform on the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5a9fbe0-a993-3a98-8884-3e854379129a",
                                        "entry_id": "cc7433da-89be-3e2a-8a24-d68609eee4f1",
                                        "glosses": [
                                            "To form a sausage-like shape, with a non-uniform cross section."
