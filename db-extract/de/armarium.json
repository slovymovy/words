                "senses": [
                    {
                        "sense_id": "13ea1575-78a6-3299-95f0-4c5f866ec1da",
                        "entry_id": "6c8ff236-d10e-38b6-b336-ba8569883536",
                        "glosses": [
                            "Kasten/Regal/Schrank/Wandschrank/Wandnische zur Aufbewahrung von wertvollen oder sakralen Gegenständen"
                        ],
                        "tags": [
                            "historical"
                        ],
