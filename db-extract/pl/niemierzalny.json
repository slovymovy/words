                                "target_senses": [
                                    {
                                        "sense_id": "f11f02ac-7632-3ed7-ba81-972cc01fa5b5",
                                        "entry_id": "2d4fa32f-44ea-343b-aabf-ada62ce09f5b",
                                        "glosses": [
                                            "An incommensurable value or quantity; an irrational number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff997fe-9f4f-47eb-b153-223e9036e682",
                                                "sense_id": "f11f02ac-7632-3ed7-ba81-972cc01fa5b5",
                                                "text": "Unfortunately for Pythagoras, his theorem led at once to the discovery of incommensurables, which appeared to disprove his whole philosophy."
                                            }
