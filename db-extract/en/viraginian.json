                        "glosses": [
                            "Of or pertaining to a virago; having the qualities of a virago."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "19baab86-fc49-4f78-88f8-576c3b2a8301",
                                "sense_id": "308011e3-bf54-373f-8e30-78e003ba0746",
                                "text": "But does it not argue rather the lascivious promptness of his own fancy, who, from the harmless mention of a sleekstone, could neigh out the remembrance of his old conversation among the viraginian trollops?"
                            },
                            {
                                "example_id": "660acd36-e6f0-493a-b8a7-e7825184dc5d",
                                "sense_id": "308011e3-bf54-373f-8e30-78e003ba0746",
                                "text": "We have, at different times, received viraginian epistles from gentlemen of the pellets[…]"
                            },
                            {
                                "example_id": "002ee367-301a-42a9-99ea-71bc849b0371",
                                "sense_id": "308011e3-bf54-373f-8e30-78e003ba0746",
                                "text": "I feel that Anne reserved her viraginian acts for the circumstances of her new life more than for Will’s suspected infidelities."
                            }
                        ]
                    }
