                "senses": [
                    {
                        "sense_id": "5947f68e-0484-3efc-89c1-770e5dbfac4e",
                        "entry_id": "d3a0b541-998a-3c7a-ad73-5ab0c08b3684",
                        "glosses": [
                            "den Mund bedeckender Aufsatz, durch den Atemluft fließt, gedrückt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3da1f32b-f6e5-4b8e-8fd6-19b1e8688b98",
                                "sense_id": "5947f68e-0484-3efc-89c1-770e5dbfac4e",
                                "text": "„[…] die nichtinvasive Beatmung, bei der die Ankoppelung des Beatmungsgeräts an den Patienten über eine Nasen- oder Mundmaske, eine Gesichtsmaske oder einen Helm geschieht […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bda3b382-47a4-38f5-9015-9bfb834861b7",
                        "entry_id": "d3a0b541-998a-3c7a-ad73-5ab0c08b3684",
                        "glosses": [
                            "den Mund (und meist auch die Nase) bedeckender Schutz zur Vermeidung von Ansteckung/Kontamination/Schädigung/Vergiftung"
                        ],
                        "tags": [
                            "Hygiene"
                        ],
                        "examples": [
                            {
                                "example_id": "70d24e13-ed02-4dd3-a0f3-003e4266492f",
                                "sense_id": "bda3b382-47a4-38f5-9015-9bfb834861b7",
                                "text": "„Zum Eigenschutz sollte vor einer Mund- zu-Mund-Beatmung eine Mundmaske oder andere Schutzvorrichtung verwendet werden.“"
                            },
                            {
                                "example_id": "61d365a8-83aa-4004-a184-f20c0930b082",
                                "sense_id": "bda3b382-47a4-38f5-9015-9bfb834861b7",
                                "text": "„Als Mundmasken für die Operateure verwenden wir in unserer Klinik Tücher aus leichtem Leinen- oder Batiststoff, mit Bändern versehen (Länge 35 cm, Breite 20 cm), auch doppelte genähte Gazelagen mit Bändern genügen für diesen Zweck.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
