                    {
                        "translation_id": "3fc01be9-7617-4802-9859-beaaef579e41",
                        "source_entry_id": "589a4c97-8f84-3435-884f-900d7d8861ab",
                        "source_sense_id": "d3c1ce28-b4a4-312b-85b8-9e51614e7c8b",
                        "source_sense_description": "delayed effect",
                        "target_lang_word": "Nachwirkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachwirkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                        "entry_id": "5aa865d8-ed26-3793-a6f2-800701e0d4ea",
                                        "glosses": [
                                            "Folge einer Wirkung, nachträgliche oder nachhaltige Wirkung"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41076b83-a583-44a7-a549-aa55edcd7116",
                                                "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                                "text": "Durch die Verwendung von ökologischen Putzmitteln treten keine schädlichen Nachwirkungen ein."
                                            },
                                            {
                                                "example_id": "716593d4-1617-4f90-ba50-47425eafc4a2",
                                                "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                                "text": "Der damals abgeschlossene Friedensvertrag hatte noch jahrzehntelange Nachwirkungen."
                                            },
                                            {
                                                "example_id": "a468db90-873c-432a-ac9c-2c26e64c50a8",
                                                "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                                "text": "[Coronapandemie 2021:] „Wir werden natürlich infektionsmedizinisch, epidemiologisch Nachwirkungen der Pandemie noch jahrelang haben.“"
                                            },
                                            {
                                                "example_id": "bd78f35c-1fde-43e0-9e76-1658ebcc76d4",
                                                "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                                "text": "„Die Nachwirkungen sind bis heute spürbar.“"
                                            },
                                            {
                                                "example_id": "2280744b-aa0b-4f25-accd-32164a16f7cc",
                                                "sense_id": "d50a2453-e942-342a-b593-fdc5c89e68d7",
                                                "text": "„Die Weltwirtschaftskrise und ihre Nachwirkungen hieben wie eine Axt in den Alltag der einfachen Menschen, und für Jón und Hulda war der Winter schwierig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
