                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ce400d2-5fa6-4ee0-a925-02f110a63415",
                                                "sense_id": "131f523a-9c15-3ec2-88e6-ff3a6bc0c22a",
                                                "text": "In the Moroccan dialect of Meknès, verbal negation is by means of the circumfix ma...-š, as in (15), while nonverbal negation is primarily by means of invariable ma-ši before the nonverbal predicate, as in (16)."
                                            },
                                            {
                                                "example_id": "6d6f86f9-2456-4b10-8792-4e4a265c214d",
                                                "sense_id": "131f523a-9c15-3ec2-88e6-ff3a6bc0c22a",
                                                "text": "Negative prefix in Russian is a distinctive feature of nonverbal parts of speech, namely, nouns (even those that do not denote situations, e.g. 3a), adjectives (3b), and adverbs (3c): […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nonverbal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76a717cb-d46a-3807-93f1-f696dea99c52",
                                        "entry_id": "708c04ec-3a50-38a1-b16b-c4e31c633d82",
                                        "glosses": [
                                            "Alternative form of non-verbal."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258cc7ff-f5ab-4381-9db3-ce63cfd1f4f7",
                                                "sense_id": "76a717cb-d46a-3807-93f1-f696dea99c52",
                                                "text": "So obviously when we think about nonverbal behavior, or body language -- but we call it nonverbals as social scientists -- it's language, so we think about communication. When we think about communication, we think about interactions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c5fd619-5f89-4b3e-a874-47e581c5bd7c",
                        "source_entry_id": "72a53e32-3b9e-344c-8734-2cb448a2c758",
                        "source_sense_id": "1bb181f2-e8b2-3690-bbd6-bafb12e254fd",
                        "target_lang_word": "nonverbální",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonverbální",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "7c89d409-5cf9-3ff3-b409-8b59e5c0dedf",
                                        "entry_id": "0fdc868f-a6b3-34d0-97cd-c621bbcae0c9",
                                        "glosses": [
                                            "vyjádřený jinak než slovy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72fa4194-d176-4ca5-adb5-6ebbb532a0f6",
                                                "sense_id": "7c89d409-5cf9-3ff3-b409-8b59e5c0dedf",
                                                "text": "Nonverbální forma sdělování je velmi bohatá, nespočívá pouze v mimice a gestech, dochází ke sdělování prostřednictvím pohybů těla a obličeje bez použití mluveného slova, případně komunikace slouží k jeho doplnění."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a455eab1-69ab-428f-9633-b7edaae65c96",
                        "source_entry_id": "72a53e32-3b9e-344c-8734-2cb448a2c758",
                        "source_sense_id": "1bb181f2-e8b2-3690-bbd6-bafb12e254fd",
                        "target_lang_word": "nonverbal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonverbal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26072751-5f78-32d0-a84e-ca9c0c2b886d",
                                        "entry_id": "919d0e7e-9af4-3120-977c-671ba858ab48",
                                        "glosses": [
                                            "ohne Verwendung von Sprache"
                                        ],
                                        "tags": [
                                            "Kommunikationswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "257ee790-0fa2-4884-8d9d-2e2f431d7057",
                                                "sense_id": "26072751-5f78-32d0-a84e-ca9c0c2b886d",
                                                "text": "Die Linguistik interessiert sich auch für die nonverbale Kommunikation, also die Kommunikation mit Gestik, Mimik und anderen nichtsprachlichen Mitteln."
                                            },
                                            {
                                                "example_id": "506549dd-ca5a-4834-a969-493c6a03cff3",
                                                "sense_id": "26072751-5f78-32d0-a84e-ca9c0c2b886d",
                                                "text": "„Kulturanthropologen haben viel, vielleicht sogar vor allem mit nonverbalen Zeichen zu tun.“"
                                            },
                                            {
                                                "example_id": "da637e70-93e4-4d98-a4a2-a81574abcd67",
                                                "sense_id": "26072751-5f78-32d0-a84e-ca9c0c2b886d",
                                                "text": "„Daraufhin schlossen sich auch Aziza und Ahmet der kleinen Besuchergruppe an, wobei Ahmet mir in regelmäßigen Intervallen nonverbale Zeichen der Missbilligung sendete.“"
                                            },
                                            {
                                                "example_id": "bd17c6b9-93d0-4a26-b73a-0caffdd7d6d8",
                                                "sense_id": "26072751-5f78-32d0-a84e-ca9c0c2b886d",
                                                "text": "„Wir haben in 2.4 von dem nonverbalen Verhalten im Kommunikationsprozeß gesprochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
