                "senses": [
                    {
                        "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                        "entry_id": "bc67a0c8-402d-3f0b-9cf4-4d10d9a076fc",
                        "glosses": [
                            "abschließende, kritische Zusammenfassung eines Krankheitsverlaufs durch den behandelnden Arzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be3ac26-1925-4199-b757-0aa336df8ab9",
                                "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                                "text": "„Ist auch bei optimaler Therapie keine wesentliche Verbesserung des Leistungsvermögens mehr zu erwarten, dann ist dies ebenfalls in der Epikrise und im Schlussblatt entsprechend anzuführen.“"
                            },
                            {
                                "example_id": "abf502d6-289d-45aa-bb71-fc28250539d4",
                                "sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                                "text": "„Die Interaktion zwischen Pathologie und anderen Disziplinen führt schließlich zur Gesamtinterpretation des Krankheitsfalls, der Epikrise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a854e2d8-9719-446c-b2e8-bb1f61433290",
                        "source_entry_id": "bc67a0c8-402d-3f0b-9cf4-4d10d9a076fc",
                        "source_sense_id": "5f0b3b17-921e-32bc-93de-1bf05530b8bd",
                        "source_sense_description": "Medizin: abschließende, kritische Zusammenfassung eines Krankheitsverlaufs durch den behandelnden Arzt",
                        "target_lang_word": "epicrisis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epicrisis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
                                        "glosses": [
                                            "A critical or analytical study, evaluation, or summing up, especially of a medical case history."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d4c18b-b9a2-42f4-8828-54cc580978c7",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "It would be well if every practitioner would go over his list of patients from time to time and attempt an epicrisis in each one. He will often be surprised at what he finds, and his clinical judgment should be greatly improved..."
                                            },
                                            {
                                                "example_id": "181eff63-37ce-4588-a62d-6989788136ac",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "But what if I don't have time to discharge you tomorrow. The epicrisis has to be written, you know."
                                            },
                                            {
                                                "example_id": "1f564e71-152a-4048-b659-d80bf72947ba",
                                                "sense_id": "9768f790-7d62-355f-ab4d-1fcd644d3dfd",
                                                "text": "Haberal’s epicrisis report, which was prepared on Oct. 16, 2009, was sent to the court nearly one year later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3af4bb6-ff84-39f9-abba-a4eb566d0723",
                                        "entry_id": "7ba92046-f0a8-309d-8612-3c7cc2bd0dcb",
                                        "glosses": [
                                            "A quotation followed by a commentary."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
