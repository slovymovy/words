                "senses": [
                    {
                        "sense_id": "bcfbc5de-5655-3916-9fd1-91875269f2f4",
                        "entry_id": "3c64cd64-3ce7-3678-b031-41af7dbbf312",
                        "glosses": [
                            "A red carotenoid pigment found in tomatoes, other red vegetables, and in animal tissue; there is some evidence that it may lower the risk of prostate cancer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2e185b5b-9289-438e-9f27-715affbe2c38",
                                "sense_id": "bcfbc5de-5655-3916-9fd1-91875269f2f4",
                                "text": "And eating avocado with salsa boosted the absorption of lycopene—a carotenoid in tomatoes—by almost five times."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f3a7276-e3cd-497d-b0f1-e02c8fdf69db",
                        "source_entry_id": "3c64cd64-3ce7-3678-b031-41af7dbbf312",
                        "source_sense_id": "bcfbc5de-5655-3916-9fd1-91875269f2f4",
                        "source_sense_description": "red carotenoid pigment",
                        "target_lang_word": "λυκοπένιο",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "λυκοπένιο",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "45f3d3f8-22ec-34c2-a0b5-f968e8b1512c",
                                        "entry_id": "e2df8386-05ba-38a1-9875-e57da5c52688",
                                        "glosses": [
                                            "οργανική χρωστική ουσία της κατηγορίας των καροτενοειδών, με ισχυρή αντιοξειδωτική δράση, που προσδίδει το κόκκινο χρώμα σε ορισμένα φρούτα και λαχανικά (ντομάτα, καρπούζι, παπάγια, λωτός, κόκκινη πιπεριά κ.ά."
                                        ],
                                        "tags": [
                                            "βιοχημεία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f95d019-a9a5-4e6e-a808-f9fab5a03694",
                                                "sense_id": "45f3d3f8-22ec-34c2-a0b5-f968e8b1512c",
                                                "text": "※ Το μεγαλύτερο διατροφικό του πλεονέκτημα (του καρπουζιού) είναι η περιεκτικότητά του σε λυκοπένιο και κιτρουλίνη. Το λυκοπένιο είναι ένα ισχυρό αντιοξειδωτικό που προστατεύει τα κύτταρα από το οξειδωτικό στρες, συμβάλλει στη διατήρηση της καρδιαγγειακής υγείας και ενισχύει την άμυνα του δέρματος απέναντι στην ηλιακή ακτινοβολία. Η κιτρουλίνη, από την άλλη, μετατρέπεται σε αργινίνη, η οποία αυξάνει την παραγωγή μονοξειδίου του αζώτου, βελτιώνοντας τη λειτουργία των αγγείων και τη ροή του αίματος. Παράλληλα, φαίνεται ότι βοηθά στην ταχύτερη αποκατάσταση των μυών μετά από έντονη άσκηση. (www.lifo.gr, 21.07.2026)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
