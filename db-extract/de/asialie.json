                                "target_senses": [
                                    {
                                        "sense_id": "e0d25549-402a-3fca-833b-cb1d7edc29e6",
                                        "entry_id": "8b300cfe-afcb-3c8b-95cf-223811fdd676",
                                        "glosses": [
                                            "Absence de sécrétion de salive par les glandes salivaires. N.B.: on parle aussi d'aptyalisme, d'asialisme ou d'asialorrhée ; en cas de simple diminution de la sécrétion de salive, on parle d'hyposialie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43456bb8-3a9e-489e-9322-15b5612c0f03",
                                                "sense_id": "e0d25549-402a-3fca-833b-cb1d7edc29e6",
                                                "text": "L'asialie est souvent provoquée par certaines thérapeutiques, chimiothérapies ou irradiations."
                                            },
                                            {
                                                "example_id": "a4a0ae5d-b9de-4af2-a08d-1b8d310805e8",
                                                "sense_id": "e0d25549-402a-3fca-833b-cb1d7edc29e6",
                                                "text": "L'asialie peut provoquer des caries dentaires et des infections gingivales."
                                            },
                                            {
                                                "example_id": "34450771-942d-42d2-af75-40458d2d0603",
                                                "sense_id": "e0d25549-402a-3fca-833b-cb1d7edc29e6",
                                                "text": "À ces troubles d’origine mécanique, s’associent dans la genése des troubles masticatoires, l’asialie et l’agueusie post radiothérapique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
