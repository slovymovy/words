        "fr-extract.jsonl": [
            {
                "entry_id": "f88137af-e1ea-39e0-9208-df6f57163269",
                "word": "licenciement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "69f83163-28ca-420f-8ea2-c0423faa348c",
                        "entry_id": "f88137af-e1ea-39e0-9208-df6f57163269",
                        "tags": [
                            "plural"
                        ],
                        "form": "licenciements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9225badb-283c-3adb-a499-df55aa0b2906",
                        "entry_id": "f88137af-e1ea-39e0-9208-df6f57163269",
                        "glosses": [
                            "Action de licencier des troupes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11c3d9f6-4d5c-47be-8dbe-f229d0885f63",
                                "sense_id": "9225badb-283c-3adb-a499-df55aa0b2906",
                                "text": "Le colonel, peu grièvement blessé, se retira sur la Loire et quitta Tours avant le licenciement."
                            },
                            {
                                "example_id": "ba0982b9-3663-4066-919d-12b5677e0c6d",
                                "sense_id": "9225badb-283c-3adb-a499-df55aa0b2906",
                                "text": "Son trésor est vide. Son armée, mal recrutée, mal équipée, mal disciplinée, absolument démoralisée par ses défaites récentes, est réduite à fort peu de chose par les licenciements forcés et les désertions."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccc609ed-c614-3485-958d-42c530cc0f7f",
                        "entry_id": "f88137af-e1ea-39e0-9208-df6f57163269",
                        "glosses": [
                            "Rupture du contrat de travail à l’initiative de l’employeur ou d’une autre personne."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "3739a1bd-63f5-45b5-872c-ef86c77875c0",
                                "sense_id": "ccc609ed-c614-3485-958d-42c530cc0f7f",
                                "text": "Les patrons répondent alors par le licenciement de tous les ouvriers, plongeant toute une population dans la misère."
                            },
                            {
                                "example_id": "4fb60be9-9226-4033-bb89-6f89a5349227",
                                "sense_id": "ccc609ed-c614-3485-958d-42c530cc0f7f",
                                "text": "J’effectuais les dernières semaines de mon préavis de licenciement (lequel avait été motivé par mon refus revendiqué d’adhérer aux orientations stratégiques de l’entreprise)."
                            },
                            {
                                "example_id": "ddad85c9-9c6d-4707-ba95-19d219c062ff",
                                "sense_id": "ccc609ed-c614-3485-958d-42c530cc0f7f",
                                "text": "D’une part, j’avais hérité de mon père un farouche souci d’indépendance. Le fameux « lien de subordination » qui caractérise tout contrat de travail, je ne pouvais qu’y être allergique. Ça avait d’ailleurs bien été le cas durant les dix-huit mois passés aux Presses de la Cité : j’avais développé un trouble psychosomatique qui disparut le jour même où je reçus ma lettre de licenciement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9dcf3e1f-13cd-4953-8c00-91b49b4f3475",
                        "source_entry_id": "f88137af-e1ea-39e0-9208-df6f57163269",
                        "source_sense_id": "ccc609ed-c614-3485-958d-42c530cc0f7f",
