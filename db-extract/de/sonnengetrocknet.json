                ],
                "senses": [
                    {
                        "sense_id": "9ebbd855-ed17-3042-a363-5042b334778f",
                        "entry_id": "4e922fd4-b891-3d81-9dbe-17691af3f820",
                        "glosses": [
                            "in der Sonne getrocknet, durch Trocknung in der Sonne haltbar gemacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49cccb83-babd-4d71-908d-bc7051137d30",
                                "sense_id": "9ebbd855-ed17-3042-a363-5042b334778f",
                                "text": "„Man hatte sie in einen tiefen Keller gezwängt, eine von den vielen Gruben, welche die Fischer benutzten, um sonnengetrocknete Fische darin zu lagern.“"
                            },
                            {
                                "example_id": "f486b54c-1a3c-4517-aea2-81377a13a3de",
                                "sense_id": "9ebbd855-ed17-3042-a363-5042b334778f",
                                "text": "„Er aß panierte Steaks, Eier mit Speck und richtig scharfe Burritos und erkundigte sich nie beim Kellner nach der Herkunft der sonnengetrockneten Tomaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
