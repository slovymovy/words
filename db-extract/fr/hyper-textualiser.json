                ],
                "senses": [
                    {
                        "sense_id": "948b6dea-b83d-376b-a9a8-4575b8ef35e6",
                        "entry_id": "1ec0f5b7-8e99-3aae-ae35-767e4f608f1e",
                        "glosses": [
                            "Donner un caractère hypertextuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59355625-bb37-43d0-a0c7-c594b9bc6f4f",
                                "sense_id": "948b6dea-b83d-376b-a9a8-4575b8ef35e6",
                                "text": "Mais il est aussi possible de sortir de ce planisphère hyper-textualisé."
                            },
                            {
                                "example_id": "e9f96653-b095-4ed3-b6f6-09e5cd6b9482",
                                "sense_id": "948b6dea-b83d-376b-a9a8-4575b8ef35e6",
                                "text": "Ici tout est lié, interconnecté, hyper-textualisé mais rien ne semble avoir d'origine et je n'ai aucune idée par où commencer"
                            },
                            {
                                "example_id": "9ae01e91-0d0b-4044-80c3-00bcbf9e930d",
                                "sense_id": "948b6dea-b83d-376b-a9a8-4575b8ef35e6",
                                "text": "Valorisation des capacités à faire lien, à s'associer, à « s'hyper-textualiser », à « se mettre en coopération» … de la « désinhibition connexionniste »."
                            }
                        ]
                    }
