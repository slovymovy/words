                                        "entry_id": "e2206c9a-5298-3eea-a7f6-d13c0d20663d",
                                        "glosses": [
                                            "Modèle de voiture automobile de la gamme Vedette, commercialisée et fabriquée de 1957 à 1961 par le constructeur français Simca."
                                        ],
                                        "tags": [
                                            "Marque commerciale"
                                        ],
                                        "examples": [
