                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b85f2f2e-f92e-4ba9-ba93-800979c032ee",
                                                "sense_id": "741e6027-7538-3d9a-92f9-2613eaf5677f",
                                                "text": "He expanded on his plans for the business."
                                            },
                                            {
