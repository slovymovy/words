                                    },
                                    {
                                        "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                        "entry_id": "bdf1e0f7-3ea2-3c8e-8c69-219b086fc319",
                                        "glosses": [
                                            "Ellipsis of Grim Reaper."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "capitalized",
                                            "ellipsis",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded91f44-a435-40b8-94a7-276829636023",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Thereafter when their cups were brimmed anew with foaming wine the Red Foliot spake among them and said, “O ye lords of Witchland, will you that I speak a dirge in honour of Gorice the King that the dark reaper hath this day gathered?”"
                                            },
                                            {
                                                "example_id": "b1fea9ab-f47c-49ab-9226-bfc4538c2bc7",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Don't fear the Reaper / We'll be able to fly"
                                            },
                                            {
                                                "example_id": "8dbeb545-a7e0-4fce-bbfe-eb29b9dca99b",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "Why is the Grim Reaper a man? True, the noun ending would theoretically allow us to visualize the reaper as a woman as well, but we don't."
                                            },
                                            {
                                                "example_id": "07eeca31-26d5-4006-8157-abb4e0acb419",
                                                "sense_id": "72a8ee8a-311f-3c38-a18e-12406445fd60",
                                                "text": "She told me she wanted to meet the reaper\nI had only done her a favor\nShe didn't deserve to die\nBut I deserved to kill her"
                                            }
                                        ]
                                    },
