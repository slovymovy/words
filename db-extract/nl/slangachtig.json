                ],
                "senses": [
                    {
                        "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "glosses": [
                            "met de vorm of het gedrag van een langgerekt reptiel zonder poten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0087d79e-3c9f-41ef-a55d-888a35bfc19e",
                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                "text": "Het slangachtige dier ging weer snel het water in."
                            },
                            {
                                "example_id": "0627fdb2-bbbf-4117-b457-1bdc1ce825e0",
                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                "text": "Maar nu blijkt deze aparte amfibiesoort met zijn slangachtige levensstijl er ook een ‘slangachtige’ gifbeet op na te houden. En mogelijk was de wormsalamander zelfs eerder met deze innovatie, oppert Jared, aangezien wormsalamanders evolutionair gezien honderd miljoen jaar ouder zijn dan slangen."
                            },
                            {
                                "example_id": "2fc1dc2b-b34c-4bf8-a1af-7845b4c7ec01",
                                "sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                                "text": "Via een Geheime Kamer komt Harry bij een slangachtig Voldemortmonster met dodelijke blik, een basilisk."
                            }
                        ]
                    },
                    {
                        "sense_id": "994986f1-6bb7-32b0-9543-8dc02fe222a9",
                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "glosses": [
                            "onopvallend vloeiend en verrassend snel, als de beweging van een slang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59187727-bae0-4721-b013-209846cc00b3",
                                "sense_id": "994986f1-6bb7-32b0-9543-8dc02fe222a9",
                                "text": "Op het rechte stuk haalt een shorttracker zijn schaatsen bijna niet van het ijs. Ze glijden, maken met de ijzers haast slangachtige bewegingen en kijken zo nu en dan over hun schouder om eventuele inhaalacties te pareren."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf8671c9-81a1-37c6-b24c-de7270fa8a9c",
                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "glosses": [
                            "zonder medegevoel met kwaadaardige bedoelingen misleidend"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4046fde7-1971-40f3-a89d-f1c2f3ca955e",
                                "sense_id": "cf8671c9-81a1-37c6-b24c-de7270fa8a9c",
                                "text": "Michaël Pas als Jago is ijzersterk in zijn listige, slangachtige woordenspel."
                            }
                        ]
                    },
                    {
                        "sense_id": "234047d2-9d2a-35f2-9f01-2fa254c19b0a",
                        "entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "glosses": [
                            "met een zeer langgerekte gladde, ronde vorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37e4784-b0c2-4767-86c2-89187923958f",
                                "sense_id": "234047d2-9d2a-35f2-9f01-2fa254c19b0a",
                                "text": "Zo liet Almere René van Zuuk een slangachtig gebouw ontwerpen en stelde Den Haag zich kandidaat met twee gigantische boomstronken van Liesbeth van der Pol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c282996f-fa30-4a0b-b9aa-b14d129b0a64",
                        "source_entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "source_sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
                        "source_sense_description": "met de vorm of het gedrag van een langgerekt reptiel zonder poten",
                        "target_lang_word": "snaky",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snaky",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d997e5e-597b-3301-9563-a42a9b950392",
                                        "entry_id": "e065057e-4be3-351e-8450-2e873e0d1284",
                                        "glosses": [
                                            "Resembling or relating to snakes; snakelike."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb9525a5-d3fc-4d95-b6a0-8fc522617806",
                                                "sense_id": "6d997e5e-597b-3301-9563-a42a9b950392",
                                                "text": "[S]ome of Serpent kinde\n Wondrous in length and corpulence involv'd\n Thir Snakie foulds, and added wings."
                                            },
                                            {
                                                "example_id": "94544754-b498-45f5-a0f3-e3888f108d23",
                                                "sense_id": "6d997e5e-597b-3301-9563-a42a9b950392",
                                                "text": "There is a snaky gleam in her hard grey eye, as of anticipated rounds of buttered toast, relays of hot chops, worryings and quellings of young children, sharp snappings at poor Berry, and all the other delights of her Ogress's castle."
                                            },
                                            {
                                                "example_id": "77833f57-5a77-445d-ab9f-545fb9adaec6",
                                                "sense_id": "6d997e5e-597b-3301-9563-a42a9b950392",
                                                "text": "To look at the tawny brawn of his lithe snaky limbs, you would almost have credited the superstitions of some of the earlier Puritans, and half believed this wild Indian to be a son of the Prince of the Powers of the Air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fcfb659-24aa-3213-9839-9148b1646631",
                                        "entry_id": "e065057e-4be3-351e-8450-2e873e0d1284",
                                        "glosses": [
                                            "Windy; winding; twisty; sinuous, wavy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296fa0dd-e3e6-4e61-ab74-48965ca5baae",
                                                "sense_id": "5fcfb659-24aa-3213-9839-9148b1646631",
                                                "text": "Walking through the snaky passages I was soon completely lost."
                                            },
                                            {
                                                "example_id": "6a5cbf6c-b408-4c8d-bb7d-c4ea028fdf24",
                                                "sense_id": "5fcfb659-24aa-3213-9839-9148b1646631",
                                                "text": "So are thoſe criſped ſnaky golden locks\n Which maketh ſuch wanton gambals with the wind,\n Vpon ſuppoſed faireneſſe, often knowne\n To be the dowry of a ſecond head,\n The skull that bred them in the Sepulcher."
                                            },
                                            {
                                                "example_id": "192f7fef-a432-4279-8e5c-66ef49ed4b0d",
                                                "sense_id": "5fcfb659-24aa-3213-9839-9148b1646631",
                                                "text": "The nuns' veils billowed and flapped behind the snaky line of girls as if the sisters were shooing the serpent from the Garden of Eden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95f5530c-6609-3f46-95fc-16578663478d",
                                        "entry_id": "e065057e-4be3-351e-8450-2e873e0d1284",
                                        "glosses": [
                                            "Sly; cunning; deceitful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c3504f-9cf0-4dc6-b9d0-4475d44ab8cf",
                                                "sense_id": "95f5530c-6609-3f46-95fc-16578663478d",
                                                "text": "So to the Coaſt of Jordan he directs\n His eaſie ſteps; girded with ſnaky wiles, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c70290a5-ba9a-397b-8517-bcdf7fa1d0ed",
                                        "entry_id": "e065057e-4be3-351e-8450-2e873e0d1284",
                                        "glosses": [
                                            "Covered with serpents; having serpents."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53cb7a70-4d9c-4630-8e00-3dec35a3faee",
                                                "sense_id": "c70290a5-ba9a-397b-8517-bcdf7fa1d0ed",
                                                "text": "What was that ſnakie headed Gorgon ſheild\n That wiſe Minerva wore, unconquer’d virgin\n Wherewith ſhe freez’d her foes to congeal’d ſtone?\n But rigid looks of Chaſt auſteritie\n And noble grace that daſh’t brute violence\n With ſudden adoration, and blancke aw.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            },
                                            {
                                                "example_id": "e92fe3a8-3a7c-4276-8ed4-9de79a5506d2",
                                                "sense_id": "c70290a5-ba9a-397b-8517-bcdf7fa1d0ed",
                                                "text": "His Hat, adorn’d with Wings, diſclos’d the God,\n And in his Hand he bore the Sleep-compelling Rod:\n Such as he ſeem’d, when at his Sire’s Command\n On Argus Head he laid the Snaky Wand; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0626d4dd-4bda-4172-974f-bcd88685ea53",
                        "source_entry_id": "4daca434-f51e-3db7-a0d9-23ccc3dc2520",
                        "source_sense_id": "245673b1-291e-3eef-836c-5f0126c17202",
