                                "target_senses": [
                                    {
                                        "sense_id": "4d3d3bb2-cb06-344e-bd67-5efa33a33ea8",
                                        "entry_id": "212de205-9051-3747-a794-7ccfd011fcbb",
                                        "glosses": [
                                            "příčestí minulé ženského rodu jednotného čísla a středního rodu množného čísla slovesa vít"
                                        ],
