                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62b3499b-caaf-4db8-a65d-a586cd3fb434",
                        "entry_id": "ec1cb37a-9080-3edc-8077-7b6d44546bba",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "idistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c7a1d0d0-8482-36f9-80e5-60ef0c6d22d7",
                        "entry_id": "ec1cb37a-9080-3edc-8077-7b6d44546bba",
                        "glosses": [
                            "Relatif à l’ido."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2efe9caa-6154-466f-9368-d9546d0bcb01",
                                "sense_id": "c7a1d0d0-8482-36f9-80e5-60ef0c6d22d7",
                                "text": "[…] l’Ido n’est pas autre chose qu’une mise au point de l’Esperanto. Ce travail a été commencé en octobre 1907 par la « Délégation pour l’adoption d’une langue internationale » et continué par l’Académie Idiste en tenant compte de la critique publique faite pendant six années, de 1907 à 1913, dans la Revue mensuelle Progreso, par les idistes pratiquants de tous pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95e3bbf9-20f5-4f04-8fde-bc486a4627ff",
                        "source_entry_id": "ec1cb37a-9080-3edc-8077-7b6d44546bba",
                        "source_sense_id": "c7a1d0d0-8482-36f9-80e5-60ef0c6d22d7",
                        "target_lang_word": "idistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                        "entry_id": "c70a5f8a-ed09-39bd-8e52-b58f85e64fb6",
                                        "glosses": [
                                            "auf die Sprache Ido und/oder das mit ihr verbundene Gedankengut bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78cbeb4-621f-4832-8901-3dfa1815bc7e",
                                                "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                                "text": "„Gegenwärtig verbreiten die USA ihr Konzept der Demokratie, ihr Denken und ihre Lebensweise in der ganzen Welt, und sie tun das mittels der englischen Sprache. Wir müssen diese wichtige Tatsache in unserer idistischen Tätigkeit berücksichtigen.“"
                                            },
                                            {
                                                "example_id": "1ad265e9-4716-4548-9fa7-8ba33f4fd9fd",
                                                "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                                "text": "„Louis Couturat hat oft über den linguistischen Fortschritt geschrieben. In der mehr oder weniger hagiographischen idistischen Literatur vereinigt sich dieser Begriff mit dem Begriff der Reform.“"
                                            },
                                            {
                                                "example_id": "4dadffa6-3070-43ae-9669-89ddcb0e18be",
                                                "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                                "text": "„Das Weltspracheamt ließe sich als […] Abteilung einer […] Instanz begreifen, die für die Schlichtung politischer Interessenkonflikte auf internationaler Ebene ebenso zuständig wäre wie für strittige Terminologien, etwa welches Suffix der idistische Neologismus für Neurasthenie bekäme.“"
                                            },
                                            {
                                                "example_id": "032f64e6-81ab-4c63-8692-cc56ea7a9460",
                                                "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                                "text": "„Zusätzlich redigierte er [Andreas Juste] eine Vielzahl interessanter Artikel für die idistische Zeitschrift ‚Progreso‘.“"
                                            },
                                            {
                                                "example_id": "99fa2279-0993-4ec1-86e3-71443ee6a173",
                                                "sense_id": "773aeebe-71de-33e6-be92-354c2a22dfbf",
                                                "text": "„Die idistische Elite frischte Argumente auf. Ob es ökonomische, politische oder nur praktische waren - Fazit: Ido ist vernünftig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "c2f47f0c-39b1-32de-897f-c70db2534ec1",
                "word": "idiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51e1269a-ad86-4761-94b2-d3544d351927",
                        "entry_id": "c2f47f0c-39b1-32de-897f-c70db2534ec1",
                        "tags": [
                            "plural"
                        ],
                        "form": "idistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "214d0fc5-3275-31f8-b2b2-ed4c172a0eec",
                        "entry_id": "c2f47f0c-39b1-32de-897f-c70db2534ec1",
                        "glosses": [
                            "Personne qui contribue au développement de l’ido."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "405fcd5b-d153-4432-98ea-7ddff1fd2b84",
                                "sense_id": "214d0fc5-3275-31f8-b2b2-ed4c172a0eec",
                                "text": "Aussi avons-nous préféré nous adresser directement aux idistes eux-mêmes ; nous les supplions encore d’examiner en toute sincérité l’Adjuvilo, de comparer impartialement sa grammaire à celle de l’Ido primitif."
                            }
                        ]
                    },
                    {
                        "sense_id": "a663fb8f-5795-3a8a-bc6d-d5ef419427a8",
                        "entry_id": "c2f47f0c-39b1-32de-897f-c70db2534ec1",
                        "glosses": [
                            "Personne qui parle l’ido (sans forcément contribuer à son développement)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "782c2bda-b9d4-4140-92fc-cbd0de567f94",
                        "source_entry_id": "c2f47f0c-39b1-32de-897f-c70db2534ec1",
                        "target_lang_word": "Idist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                        "entry_id": "ce81e283-2022-381c-aa83-37ca5ab8db6a",
                                        "glosses": [
                                            "Person, die Ido spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "982cabdf-125b-4bdc-8b79-58bd611e91ea",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Nach dem Schisma der Bewegung in Idisten und Esperantisten scheitert die Zusammenarbeit von Couturat und Ostwald nicht zuletzt an der Frage, in welchem Format die eigens gegründete Ido-Zeitschrift Progreso erscheinen soll.“"
                                            },
                                            {
                                                "example_id": "c724c436-2237-4f51-9ed3-483943e61b78",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Die Idisten vertreten die Auffassung, daß man eine in jeder Beziehung vollkommene Weltsprache braucht, und darum eine Reform des Esperanto notwendig ist.“"
                                            },
                                            {
                                                "example_id": "e6db66cf-29df-4c52-b53b-94b70d75efb0",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Dabei stellte Ostwald, Nobelpreisträger für Chemie des Jahres 1909, den Idisten neben propagandistischer offensichtlich auch finanzielle Unterstützung zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "4c285f2e-b375-4d16-929e-7642db079d75",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Auch haben die Idisten von den Esperantisten niemals etwas anderes verlangt, als die freie, sachliche Diskussion, […].“"
                                            },
                                            {
                                                "example_id": "fa5c0fc5-9e6e-4fef-ab1f-d86064bc3255",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Für die Entwicklung der Ido-Bewegung war problematisch, dass die Idisten ihre Sprache immer weiterentwickelten.“"
                                            },
                                            {
                                                "example_id": "2ed9db5c-ddf8-4b72-8495-be4a1be8d454",
                                                "sense_id": "836a5086-32ec-3ec4-825c-18e8eb67d781",
                                                "text": "„Es gelang weder den Idisten noch den Esperantisten, ihre Sprache als Welthilfssprachen durchzusetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
