                                        "entry_id": "61bfe98d-a7f3-3aab-8edb-8d0feec89e51",
                                        "glosses": [
                                            "The quality of being adaptable; a quality that renders adaptable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
