                                        "sense_id": "31917861-59d2-3feb-a08d-f9ccb102217e",
                                        "entry_id": "0f11fa3e-c5bb-3a75-ab4f-f2e6d40873ad",
                                        "glosses": [
                                            "Œuvre représentant la mort humaine de façon réaliste, par exemple par un squelette, par un cadavre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0073c3e-7daf-4612-80fa-c3c4943277f5",
                                                "sense_id": "31917861-59d2-3feb-a08d-f9ccb102217e",
                                                "text": "Les transis des livres d’heures et les illustrations du Dict des trois morts et des trois vifs insistent sur le cadavre et les signes de la décomposition."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                        "entry_id": "da4a8b6e-d482-32a2-9846-536a1c05b9d4",
                                        "glosses": [
                                            "Engourdi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccfdeef3-70b4-4c91-9a52-8d5f0f39db77",
                                                "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                                "text": "Le jour se lève. La rosée tombe des arbres en grosses gouttes. Les trois hommes sont transis. Toute la fatigue de leur équipée pèse sur eux."
                                            },
                                            {
                                                "example_id": "8fd46804-57b0-4a59-8311-03f9ea31f9a4",
                                                "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                                "text": "Pataugeant dans la boue, trempés de pluie, transis de froid, les soldats romains perdaient courage."
                                            },
                                            {
                                                "example_id": "e37a654e-e8bc-44c3-8a25-12e3555e95e0",
                                                "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                                "text": "Elle tombe puis glisse lentement, dessinant sur ma peau une douce ligne sinueuse qui réchauffe mon corps transi."
                                            },
                                            {
                                                "example_id": "07d36c2d-a635-4138-87e4-760940dd3bdc",
                                                "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                                "text": "Sans compter que je suis transie de froid parce que mon mini-short et ma camisole ne sont pas du tout appropriés à ce vent froid, ce qui fait que j’ai la chair de poule et certainement le nez rouge."
                                            },
                                            {
                                                "example_id": "23213567-f433-4dab-9da8-60edae79bcd5",
                                                "sense_id": "9024dfd2-5219-38c7-9b7e-169af81b89b8",
                                                "text": "Le vent souffle, glacial, sur tout ce monde qui paraît transi, qui fait piètre mine sous ce ciel d’hiver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41b40a8c-8d76-32c0-afc9-b461650594d3",
                                        "entry_id": "da4a8b6e-d482-32a2-9846-536a1c05b9d4",
                                        "glosses": [
                                            "Dont l’excès de passion rend tremblant et interdit."
                                        ],
