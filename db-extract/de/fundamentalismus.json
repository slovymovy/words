                "senses": [
                    {
                        "sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                        "entry_id": "368cd8d6-2966-31ec-9caa-b7aa70fe9053",
                        "glosses": [
                            "entschlossenes Festhalten an den Grundlagen einer Vorstellung (Gedanken, Einfall) oder eines Glaubens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc38de2d-a430-4ff7-9c79-6e779d4eeb1e",
                                "sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                                "text": "„Heute seien Israel und die meisten arabischen Regime einig in ihrem Kampf gegen den islamischen Fundamentalismus.“"
                            },
                            {
                                "example_id": "9b3a7ad0-8a19-4991-a6e7-7860fdc55aa6",
                                "sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                                "text": "„Seine These, die er durchgehend vertritt lautet: Es gibt keinen Zusammenprall der Kulturen, sondern einen Zusammenprall der Fundamentalismen.“"
                            },
                            {
                                "example_id": "9bd227ff-167f-4db4-bd5c-b5d9114759f9",
                                "sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                                "text": "„Der islamistische Fundamentalismus hatte besorgniserregende Ausmaße angenommen; nach London war jetzt auch Brüssel zu einem Heiligtum des Terrors geworden.“"
                            },
                            {
                                "example_id": "5dd5b248-3d30-4a6d-ad07-543bcecc436e",
                                "sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                                "text": "„Ich bin mit Necla Kelek verabredet und möchte mit ihr über Fanatismus und Fundamentalismus reden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
