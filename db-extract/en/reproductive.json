                                    {
                                        "sense_id": "819335a4-0f72-3cee-b400-12aebcd01f31",
                                        "entry_id": "8b4427b5-8174-30e9-8e82-7a7c1a19f3fb",
                                        "glosses": [
                                            "En particular, propio de o relativo al proceso de reproducción sexual o asexual, y, más generalmente, a la propagación de la vida."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0074885b-68ae-301d-bb15-6c806ef27444",
                                        "entry_id": "8b4427b5-8174-30e9-8e82-7a7c1a19f3fb",
                                        "glosses": [
                                            "Dicho de un animal, especialmente doméstico, que se destina a engendrar cría."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18d7998f-797a-466e-8492-497c07ab663e",
                                                "sense_id": "0074885b-68ae-301d-bb15-6c806ef27444",
                                                "text": "Debido al interés que tiene el reproductor macho en el proceso reproductivo ya la escasez de indicadores demográficos de fecundidad en el potro F.S. tanto en el país como en el extranjero, es que se hace necesario conocerlos."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "reproductor",
