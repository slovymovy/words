{
    "word_family": [
        "corrigible",
        "correction",
        "correct"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a28c422-2506-3644-a880-739db2f90763",
                    "sense_definition": "Impossible to manage or improve through punishment or discipline.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher struggled to control the <w>incorrigible</w> student who constantly disrupted the class.",
                            "target_lang_translations": {
                                "tr": "Öğretmen, dersi sürekli bölen <w>ıslah olmaz</w> öğrenciyi kontrol etmekte zorlandı."
                            }
                        },
                        {
                            "text": "Despite many warnings, the <w>incorrigible</w> youth continued to break the school rules.",
                            "target_lang_translations": {
                                "tr": "Birçok uyarıya rağmen, bu <w>yola gelmez</w> genç okul kurallarını çiğnemeye devam etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "hopeless"
                    ],
                    "antonyms": [
                        "corrigible"
                    ],
                    "common_phrases": [
                        "incorrigible youth",
                        "incorrigible behavior"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ceza veya disiplin yoluyla yönetilmesi veya yola getirilmesi imkânsız olan; ıslah olmaz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ıslah olmaz",
                                "target_lang_sense_clarification": "disiplinle düzelmeyen"
                            },
                            {
                                "target_lang_word": "yola gelmez",
                                "target_lang_sense_clarification": "söz dinlemez, asi"
                            },
                            {
                                "target_lang_word": "düzelmez",
                                "target_lang_sense_clarification": "davranışı iyileştirilemeyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d778967-d9b7-39f6-af7a-0875503afa1d",
                    "sense_definition": "Deeply established in a specific habit or belief that will not change.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is an <w>incorrigible</w> optimist who always finds a silver lining in every situation.",
                            "target_lang_translations": {
                                "tr": "O, her durumda her zaman olumlu bir yan bulan <w>iflah olmaz</w> bir iyimserdir."
                            }
                        },
                        {
                            "text": "My friend is an <w>incorrigible</w> flirt who cannot help but charm everyone he meets.",
                            "target_lang_translations": {
                                "tr": "Arkadaşım, tanıştığı herkesi büyülemekten kendini alamayan <w>iflah olmaz</w> bir çapkındır."
                            }
                        }
                    ],
                    "synonyms": [
                        "dyed-in-the-wool"
                    ],
                    "common_phrases": [
                        "incorrigible optimist",
                        "incorrigible flirt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Değişmeyecek şekilde belirli bir alışkanlığa veya inanca derinden bağlı olan; iflah olmaz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "iflah olmaz",
                                "target_lang_sense_clarification": "huyundan vazgeçmeyen"
                            },
                            {
                                "target_lang_word": "ele avuca sığmaz",
                                "target_lang_sense_clarification": "değiştirilemez huylu"
                            },
                            {
                                "target_lang_word": "vazgeçilmez",
                                "target_lang_sense_clarification": "alışkanlığı kökleşmiş"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85d48393-daa8-3972-90ed-e40f0cb018f7",
                    "sense_definition": "Impossible to cure or fix, often referring to a disease or a structural flaw.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old building suffered from an <w>incorrigible</w> structural defect that made it unsafe.",
                            "target_lang_translations": {
                                "tr": "Eski bina, onu güvensiz kılan <w>giderilemez</w> bir yapısal kusurdan mustaripti."
                            }
                        },
                        {
                            "text": "Doctors described the patient's condition as an <w>incorrigible</w> disease that resisted all known treatments.",
                            "target_lang_translations": {
                                "tr": "Doktorlar, hastanın durumunu bilinen tüm tedavilere direnen <w>tedavi edilemez</w> bir hastalık olarak tanımladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "incurable"
                    ],
                    "antonyms": [
                        "correctable"
                    ],
                    "common_phrases": [
                        "incorrigible disease",
                        "incorrigible flaw"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tedavi edilmesi veya giderilmesi imkânsız olan (hastalık veya kusur)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şifasız",
                                "target_lang_sense_clarification": "hastalık için"
                            },
                            {
                                "target_lang_word": "tedavi edilemez",
                                "target_lang_sense_clarification": "iyileştirilemez"
                            },
                            {
                                "target_lang_word": "giderilemez",
                                "target_lang_sense_clarification": "kusur için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83e1d114-e5f0-3473-9a19-48b1f6d67209",
                    "sense_definition": "So morally bad that reform is impossible.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was considered <w>incorrigible</w> by the judge, who saw no hope for his rehabilitation.",
                            "target_lang_translations": {
                                "tr": "Rehabilitasyonu için hiçbir umut görmeyen yargıç tarafından suçlunun <w>ıslah edilemez</w> olduğuna hükmedildi."
                            }
                        },
                        {
                            "text": "His <w>incorrigible</w> nature made it impossible for him to maintain any long-term friendships.",
                            "target_lang_translations": {
                                "tr": "<w>Düzelmez</w> doğası, uzun vadeli arkadaşlıklar sürdürmesini imkânsız hale getirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprobate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ahlaki açıdan düzelmesi imkânsız derecede bozuk olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ıslah edilmez",
                                "target_lang_sense_clarification": "ahlaken düzelmeyen"
                            },
                            {
                                "target_lang_word": "düzelmez",
                                "target_lang_sense_clarification": "kötü huylu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbe69fce-4775-33af-afe7-667808b41bd4",
                    "sense_definition": "Defective and impossible to materially correct or set aright.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "defective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The design error was <w>incorrigible</w>, forcing the engineers to start the project from scratch.",
                            "target_lang_translations": {
                                "tr": "Tasarım hatası <w>düzeltilemez</w> boyuttaydı ve mühendisleri projeye sıfırdan başlamak zorunda bıraktı."
                            }
                        },
                        {
                            "text": "Any attempt to fix the <w>incorrigible</w> mistake would only lead to further complications.",
                            "target_lang_translations": {
                                "tr": "Bu <w>telafi edilemez</w> hatayı düzeltmeye yönelik herhangi bir girişim yalnızca daha fazla karmaşıklığa yol açacaktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "irreparable",
                        "uncorrectable"
                    ],
                    "antonyms": [
                        "correctable"
                    ],
                    "target_lang_definitions": {
                        "tr": "Maddi olarak düzeltilmesi veya giderilmesi mümkün olmayan (hata veya kusur)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "düzeltilemez",
                                "target_lang_sense_clarification": "hata veya kusur"
                            },
                            {
                                "target_lang_word": "telafi edilemez",
                                "target_lang_sense_clarification": "onarılması imkânsız"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f795871-6f58-3cc8-9484-e316e518e933",
                    "sense_definition": "Impossible to disprove or challenge by its very nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that certain personal experiences are <w>incorrigible</w> because they cannot be doubted.",
                            "target_lang_translations": {
                                "tr": "Filozof, belirli kişisel deneyimlerin şüphe götürmez oldukları için <w>çürütülemez</w> olduğunu savundu."
                            }
                        },
                        {
                            "text": "A statement about one's own pain is often considered <w>incorrigible</w> in logical discourse.",
                            "target_lang_translations": {
                                "tr": "Kişinin kendi acısına ilişkin bir ifade, mantıksal söylemde genellikle <w>şüphe götürmez</w> kabul edilir."
                            }
                        }
                    ],
                    "synonyms": [
                        "axiomatic",
                        "unfalsifiable"
                    ],
                    "target_lang_definitions": {
                        "tr": "Doğası gereği çürütülemez, aksisi kanıtlanamaz veya sorgulanamaz olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şüphe götürmez",
                                "target_lang_sense_clarification": "kuşku duyulamaz"
                            },
                            {
                                "target_lang_word": "çürütülemez",
                                "target_lang_sense_clarification": "aksisi iddia edilemez"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5dcd2b4-ae9c-3e0d-bee6-261af74b5e00",
                    "sense_definition": "A person who is considered impossible to reform or improve.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prison warden struggled to manage the <w>incorrigibles</w> who refused to follow any rules.",
                            "target_lang_translations": {
                                "tr": "Hapishane müdürü, hiçbir kurala uymayı kabul etmeyen <w>ıslah olmaz kişileri</w> yönetmekte zorlandı."
                            }
                        },
                        {
                            "text": "Society often gives up on <w>incorrigibles</w> after they have failed multiple rehabilitation programs.",
                            "target_lang_translations": {
                                "tr": "Toplum, birden fazla rehabilitasyon programında başarısız olduktan sonra <w>yola gelmez kimselerden</w> genellikle umudunu keser."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yola gelmesi veya ıslah olması imkânsız kabul edilen kimse."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ıslah olmaz kimse",
                                "target_lang_sense_clarification": "düzelmeyen kişi"
                            },
                            {
                                "target_lang_word": "yola gelmez kimse",
                                "target_lang_sense_clarification": "söz dinlemeyen kişi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}