            "senses": [
                {
                    "sense_id": "cddcbe16-e927-36a9-b533-1e0bc4f1c136",
                    "sense_definition": "Commerce ou magasin où l'on vend des outils, des articles de bricolage et de ménage en métal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est allé à la <w>quincaillerie</w> du quartier pour acheter des vis et un tournevis."
                        },
                        {
                            "text": "Cette ancienne <w>quincaillerie</w> propose un large choix d'outils pour tous les travaux de la maison."
                        }
                    ],
                    "common_phrases": [
                        "commerce de quincaillerie",
                        "rayon quincaillerie"
                    ]
                },
                {
                    "sense_id": "3c20692e-aa30-32d2-a473-8db63d851c44",
                    "sense_definition": "Ensemble des petits objets ou ustensiles métalliques, comme les clous, les vis ou les serrures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le menuisier a commandé toute la <w>quincaillerie</w> nécessaire pour monter les meubles."
                        },
                        {
                            "text": "Il range soigneusement sa <w>quincaillerie</w> dans de petites boîtes en plastique étiquetées."
