                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "010cdf12-06e7-4537-b474-c8557f5e0404",
                        "source_entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
                        "source_sense_description": "провести время, страдая",
                        "target_lang_word": "suffer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cacbfa2b-1199-3502-8c03-3a84518f98ef",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To undergo hardship."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59997073-368c-49b2-89a3-74f67ced3536",
                                                "sense_id": "cacbfa2b-1199-3502-8c03-3a84518f98ef",
                                                "text": "Many artists suffer before becoming famous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66c9a474-b38b-3c39-8282-9769a518d487",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To feel pain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b53b07-443e-4b6b-a5c5-2f7749f8316c",
                                                "sense_id": "66c9a474-b38b-3c39-8282-9769a518d487",
                                                "text": "At least he didn't suffer when he died in the car crash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To become worse."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "608db170-2d4e-4154-8008-4403fabb34e4",
                                                "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                                "text": "If you keep partying like this, your school-work will suffer."
                                            },
                                            {
                                                "example_id": "5d98fc6d-6320-4163-b577-b3f73bf8ca25",
                                                "sense_id": "34f9b451-4841-3a76-b27e-3c2b249d2ef3",
                                                "text": "Our correspondent found that timekeeping had suffered following the substitution of Class 5 4-6-0s on these workings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To endure, undergo."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c503c889-394e-48c3-be20-2f23dff4e1c4",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "I've been suffering your insults for years."
                                            },
                                            {
                                                "example_id": "bfbed1af-e154-4a9b-a68a-ba3e871582eb",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "We hope you never have to suffer the same pain."
                                            },
                                            {
                                                "example_id": "a1842a98-1477-414d-9e1a-55a88150746a",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "If you may pleaſe to thinke I loue the King, / And through him, what’s neereſt to him, which is / Your gracious ſelfe; embrace but my direction, / If your more ponderous and ſetled proiect may ſuffer alteration."
                                            },
                                            {
                                                "example_id": "c778bb48-0b6c-4d25-8c1b-3752350a2908",
                                                "sense_id": "e4fc047b-6960-3ffa-b473-08ea1b516599",
                                                "text": "Investors face a quandary. Cash offers a return of virtually zero in many developed countries; government-bond yields may have risen in recent weeks but they are still unattractive. Equities have suffered two big bear markets since 2000 and are wobbling again. It is hardly surprising that pension funds, insurers and endowments are searching for new sources of return."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                        "entry_id": "3626381a-80a8-3886-91ad-cd65836fda70",
                                        "glosses": [
                                            "To allow."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6141434-9c67-4570-8ca0-8305561bad94",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "Thou shalt not suffer a witch to liue."
                                            },
                                            {
                                                "example_id": "f3cc9212-47a7-4d74-9193-e32a2012fab7",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "But Iesus said, Suffer little children, and forbid them not to come vnto me: for of such is þe kingdome of heauen."
                                            },
                                            {
                                                "example_id": "66bc7a8f-4aeb-44fb-8a6a-794f0e7203e0",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "These constitute the important inflectional changes that have taken place in Modern English. There are other grammatical changes, mostly syntactical in their nature, into which the limits of this work do not suffer us to enter."
                                            },
                                            {
                                                "example_id": "44bc82f8-eae6-4bf2-9e55-ef7127780c6b",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "\"Employ\" includes to suffer or permit to work."
                                            },
                                            {
                                                "example_id": "f090223c-d698-4ad5-9d1f-2033540020d6",
                                                "sense_id": "90cb37c3-4c78-353f-a18c-9f2cdbbd216b",
                                                "text": "[…] it shall be unlawful for any person to cause, allow, permit or suffer any vehicle to be parked […] beyond the period of time established by the duration of the parking meter […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "550b8b54-eb03-4c98-8a42-b1d0596c14d6",
                        "source_entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
                        "source_sense_description": "провести время, страдая",
                        "target_lang_word": "pâtir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâtir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67326869-82f9-34f1-ba9e-ed77bd00b35b",
                                        "entry_id": "7c3426cb-0443-3072-ad53-29564c26e208",
                                        "glosses": [
                                            "Souffrir, être dans la misère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3882774-4eec-414e-9f2c-e5a9ab29d888",
                                                "sense_id": "67326869-82f9-34f1-ba9e-ed77bd00b35b",
                                                "text": "— Si j’étais leur mère je gagerais un petit bout de servante qui m’enlèverait un peu de travail au dehors… et je m’occuperais d’eux… Comme cela, je n’ai pas le temps ; ils pâtissent, ils jouent sans moi et je n’ai pas leur amitié s’ils ont la mienne."
                                            },
                                            {
                                                "example_id": "5a3e911e-8b43-48c0-a88a-ac13a43e925e",
                                                "sense_id": "67326869-82f9-34f1-ba9e-ed77bd00b35b",
                                                "text": "Si Misère avait connu cet effroyable désastre, elle n’eût point voulu le prolonger, même au prix de la vie ; mais, habitués de longue date aux privations et aux infirmités, elle et Faro en pâtissaient moins que les autres : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                        "entry_id": "7c3426cb-0443-3072-ad53-29564c26e208",
                                        "glosses": [
                                            "Subir des conséquences fâcheuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28c98378-a281-4c85-8d20-dbf9d0b7f5d5",
                                                "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                                "text": "— Quand même il ne viendrait personne, dit-elle, ce n’est pas une raison pour nous laisser pâtir."
                                            },
                                            {
                                                "example_id": "a3af6e67-f01a-4a2f-9e60-3c4fb8f37157",
                                                "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                                "text": "Sa conduite ne la rassurait pas ; il avait à l’égard de sa famille des délicatesses abusives et ne semblait guère se soucier qu’elle en pâtît."
                                            },
                                            {
                                                "example_id": "2a7195f8-67aa-4969-9324-d065481579bc",
                                                "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                                "text": "Davantage tournée vers l’extérieur que ses partenaires européens, l’industrie allemande pâtit sévèrement de la contraction de la demande mondiale."
                                            },
                                            {
                                                "example_id": "0ffd6949-0b3d-4b42-bfb5-cf532f1cf299",
                                                "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                                "text": "Il ne faut pas que l’innocent pâtisse pour le coupable : souvent les bons pâtissent pour les méchants."
                                            },
                                            {
                                                "example_id": "a1f388f1-4750-4631-8942-03a7f22d86c0",
                                                "sense_id": "88e2c886-e343-3511-8ceb-0b4466692d1f",
                                                "text": "Bien sûr, les paroisses n'avaient pas toutes le même degré de développement et les conditions d'accueil en pâtissaient souvent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fce69d8f-8dad-48e2-a5e3-57d85e4bb03a",
                        "source_entry_id": "4b0e4608-64d3-36cd-ba95-b7e2a7699a1f",
                        "source_sense_description": "провести время, страдая",
                        "target_lang_word": "subir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                        "entry_id": "cd32648f-a21c-37b0-9afa-b755ec18e234",
                                        "glosses": [
                                            "Souffrir, supporter ou être soumis à quelque chose de pénible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b3fbb86-4bb6-4939-a8c4-f79dc0503633",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Cette torture par laquelle vous venez de passer, vous me l'avez fait subir, il y a une heure à peine : il était juste que vous fissiez connaissance avec elle."
                                            },
                                            {
                                                "example_id": "221430c3-3f8b-42b5-b1ed-a91bca4b428e",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "J'ai fait subir à ma famille une épreuve qu'elle commence tout juste à accepter."
                                            },
                                            {
                                                "example_id": "b55683b8-4231-44c7-ac09-2b6aa999d64f",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "La masse croit qu’elle souffre parce qu’elle subit une inique conséquence d’un passé qui était plein de violences, d’ignorance et de méchanceté."
                                            },
                                            {
                                                "example_id": "82622e2c-454f-4e7c-9b62-16c224341d36",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Rivaux comme tous bons chasseurs, c’était à qui raserait à l’autre le lièvre indiqué, et le roulé subissait naturellement les quolibets du vainqueur."
                                            },
                                            {
                                                "example_id": "652bab98-ce14-409f-9b1e-5e81907d0ac7",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Sa nuit de noce n’avait pas été pour elle une nuit d'amour. Elle avait subi son époux sans ardeur et sans répugnance."
                                            },
                                            {
                                                "example_id": "ec1531e8-7afc-4fbf-a64b-a2ce0e0681a4",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Les étudiants savent qu'ils risquent de devoir y subir un bizutage, mais en vertu de la loi du silence qui les accompagne, ils ne savent rien des brimades qu'ils auront à subir."
                                            },
                                            {
                                                "example_id": "16486778-4cb9-45fc-b398-6b6b45a6f1ea",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Mais la plupart subissent des métamorphoses qui définissent les insectes hétéromorphes ; elles sont progressives dans le type hétérométabole, et se font par étapes dans le type holométabole qui est le plus fréquent et le plus important."
                                            },
                                            {
                                                "example_id": "43e7ee9e-02ec-4a11-91f3-ad40a9086300",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Si Hostrup faisait marche arrière aujourd'hui, toutes les mésaventures qu'il avait subies pour faire plier Mørk n'auraient plus aucun sens et rimeraient tout au plus avec fiasco. Hostrup ne pouvait plus faire marche arrière."
                                            },
                                            {
                                                "example_id": "8e7d2270-a159-4fd3-bde3-24d0240026f8",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir un examen, être examiné au sujet de certaines aptitudes, être interrogé sur certaines matières pour obtenir un grade ou un emploi."
                                            },
                                            {
                                                "example_id": "b0dce064-e5d6-4fd8-ab2c-f742ccc31f1e",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir un interrogatoire, comparaître devant le juge et répondre à ses interrogations."
                                            },
                                            {
                                                "example_id": "0837a38e-ed33-4652-9b83-b8e8d3f4f427",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir une influence, se prêter plus ou moins volontairement à l'influence d'autrui."
                                            },
                                            {
                                                "example_id": "215e1c8c-edcd-4e1b-bacd-d8db5f1bf7e9",
                                                "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                                                "text": "Subir des changements, subir des modifications, subir une réforme, etc., se dit des choses qui viennent à être changées, modifiées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
