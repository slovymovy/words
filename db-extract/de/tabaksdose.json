                "senses": [
                    {
                        "sense_id": "c75e46b5-4437-3350-8a5a-4f10098dae33",
                        "entry_id": "8b6357cd-7d1c-3c36-bfcf-4992484f6e40",
                        "glosses": [
                            "Dose zur Aufbewahrung von Tabak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b59d06-bb91-44d3-ae48-03e4c73b9aab",
                                "sense_id": "c75e46b5-4437-3350-8a5a-4f10098dae33",
                                "text": "„In Reserve hatte er auch eine Tabaksdose, auf der ein Bobby abgebildet war.“"
                            },
                            {
                                "example_id": "bc695154-6033-4c76-9292-263e6dca8590",
                                "sense_id": "c75e46b5-4437-3350-8a5a-4f10098dae33",
                                "text": "„Dann hielt er Martin einen Vortrag über seine Tabaksdose.“"
                            },
                            {
                                "example_id": "6fa5c75b-f864-4b92-a11a-dde87f05ddc3",
                                "sense_id": "c75e46b5-4437-3350-8a5a-4f10098dae33",
                                "text": "„Die Tante sprach gerade von einer Tabaksdosensammlung, die Pierres verstorbener Vater, der Graf Besuchow, besessen hatte, und zeigte dann ihre eigene Tabaksdose.“"
                            },
                            {
                                "example_id": "11e8d0dd-d668-41da-9c03-d97988b6657a",
                                "sense_id": "c75e46b5-4437-3350-8a5a-4f10098dae33",
                                "text": "„Als Geschenk überreichte sie mir eine Tabaksdose aus gelblichem Schildpatt, über und über mit goldenen Arabesken inkrustiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
