                                "target_senses": [
                                    {
                                        "sense_id": "c0a3a351-10cb-3342-a35e-23772bfae7ca",
                                        "entry_id": "d3f998c3-6ed8-36e7-b095-304361266728",
                                        "glosses": [
                                            "Cas grammatical pour l’instrument ou le moyen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e55a6e5-169c-4c7e-abf3-439c06af6ce3",
                                                "sense_id": "c0a3a351-10cb-3342-a35e-23772bfae7ca",
                                                "text": "En latin, l'instrumental s'est confondu avec l'ablatif; il est usuel en russe."
                                            },
                                            {
                                                "example_id": "a52d0e48-220b-4031-8742-d7f3d5acc86f",
                                                "sense_id": "c0a3a351-10cb-3342-a35e-23772bfae7ca",
                                                "text": "Le sanskrit a conservé les huit cas de l'indo-européen : nominatif, vocatif, accusatif, instrumental, datif, ablatif, génitif, locatif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf2bc6d3-44e7-3623-b896-3f3616e5c1c6",
                                        "entry_id": "d3f998c3-6ed8-36e7-b095-304361266728",
                                        "glosses": [
                                            "Morceau de musique joué par des instruments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8232d7d4-e1e9-424f-8719-f4c4c00caf6c",
                                                "sense_id": "cf2bc6d3-44e7-3623-b896-3f3616e5c1c6",
                                                "text": "Cet éducateur spécialisé à l’IME de Bourg-la-Reine accompagne à la guitare Stanislas, Yohann, Kevin et Aurélie, quatre jeunes chanteurs atteints d’autisme, sur des instrumentaux punk, comme si Jacques Brel slammait sur les Wampas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
