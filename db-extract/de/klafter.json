                        "glosses": [
                            "клафтер, маховая сажень (мера длины)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ce9d73-8f41-423d-b0a6-184cffe8d1c9",
                                "sense_id": "c5534aa2-567f-3589-8f91-45326b98feb3",
                                "text": "Und sie senkten den Bleiwurf ein und fanden zwanzig Klafter tief; und über ein wenig davon senkten sie abermals und fanden fünfzehn Klafter.",
                                "translation": "и, вымерив глубину, нашли двадцать сажен; потом на небольшом расстоянии, вымерив опять, нашли пятнадцать сажен."
                            }
                        ]
