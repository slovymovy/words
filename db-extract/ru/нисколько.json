                                                "example_id": "36382a56-ea8e-4888-809b-6062e80d8afb",
                                                "sense_id": "7c266bd1-c178-3fb3-b2d3-b1ec667e2a14",
                                                "text": "Als Eselsbrücke für die Schreibweise von \"gar nicht\" bietet sich an: \"gar nicht\" wird gar nicht zusammengeschrieben."
                                            },
                                            {
                                                "example_id": "3d9b79c6-2351-4c08-989c-71e15bf5d52a",
                                                "sense_id": "7c266bd1-c178-3fb3-b2d3-b1ec667e2a14",
                                                "text": "Das ist gar nicht teuer, man muss ja auch den Nutzen sehen."
                                            },
                                            {
                                                "example_id": "deba1a6b-d094-4c5a-aaaf-fc3f80a246eb",
                                                "sense_id": "7c266bd1-c178-3fb3-b2d3-b1ec667e2a14",
                                                "text": "Du bist verliebt! Gar nicht! Gar nicht wahr!"
