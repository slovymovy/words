                "senses": [
                    {
                        "sense_id": "d6c89956-1a33-3cdb-ba9e-055dcd3af7c3",
                        "entry_id": "0e05a31a-f4e3-3dd0-ba76-56810024fdb5",
                        "glosses": [
                            "die Unfähigkeit, bestimmte Entscheidungen zu treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50f59a01-98c4-4132-aa22-c505fa296fd0",
                                "sense_id": "d6c89956-1a33-3cdb-ba9e-055dcd3af7c3",
                                "text": "Juristische Probleme zum Thema Unmündigkeit sollten so früh wie möglich mit einem kompetenten Rechtsanwalt besprochen werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cf33ccfd-0a1b-3176-af1f-cedbfb7ee6d7",
                        "entry_id": "0e05a31a-f4e3-3dd0-ba76-56810024fdb5",
                        "glosses": [
                            "die Unfähigkeit, bestimmte Entscheidungen zu treffen",
                            "das Unvermögen, sich seines Verstandes ohne Leitung eines anderen zu bedienen"
                        ],
                        "tags": [
                            "Definition nach Immanuel Kant"
                        ],
                        "examples": [
                            {
                                "example_id": "9ea699b4-b454-4bf2-a501-67b545298b06",
                                "sense_id": "cf33ccfd-0a1b-3176-af1f-cedbfb7ee6d7",
                                "text": "Aufklärung ist der Ausgang des Menschen aus seiner selbst verschuldeten Unmündigkeit."
                            },
                            {
                                "example_id": "c4aa17ac-533b-43eb-90fa-403716a3acee",
                                "sense_id": "cf33ccfd-0a1b-3176-af1f-cedbfb7ee6d7",
                                "text": "„Kant zieh Hamann, ein bibeltreuer Schwärmer geworden zu sein, und ohne den ersten fliegenden Brief auch nur einmal zu erwähnen, forderte er Hamann auf, nicht wieder in die selbstverschuldete Unmündigkeit zurückzufallen.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    }
                ],
