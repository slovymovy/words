                "senses": [
                    {
                        "sense_id": "e0d18da6-0774-3600-8a4b-c6f8d95b03ba",
                        "entry_id": "b21996be-f862-3553-a2c4-85aef8744685",
                        "glosses": [
                            "Rang de pavés de même hauteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fef36253-17d1-4b23-b81a-a2ca36a9a2df",
                                "sense_id": "e0d18da6-0774-3600-8a4b-c6f8d95b03ba",
                                "text": "Les pavés d'une même range sont placés en contact les uns des autres et les ranges sont serrées les unes contre les autres sans autre intervalle que celui pouvant résulter de l'inégale largeur des pavés."
                            }
                        ]
                    },
