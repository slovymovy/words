                    }
                ],
                "senses": [
                    {
                        "sense_id": "1c641083-1687-3ab4-9339-48fbf0093ee7",
                        "entry_id": "c624142e-d8ec-3173-ae5f-5108cc998e72",
                        "glosses": [
                            "A material or product that is produced for consumption."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f66dbc2-97e6-4dd5-8332-a5b9336c9181",
                                "sense_id": "1c641083-1687-3ab4-9339-48fbf0093ee7",
                                "text": "printer consumables such as toner and ink cartridges"
                            },
                            {
                                "example_id": "45e2c7c2-1a45-4d52-b8eb-2b9faaf616ac",
                                "sense_id": "1c641083-1687-3ab4-9339-48fbf0093ee7",
                                "text": "The drillhead produces the drilling rotation and torque but also must slide out of position to allow the machine to manipulate the finisher drill steel and consumables."
                            },
                            {
                                "example_id": "950302db-9db5-4c15-867c-a43c7800edef",
                                "sense_id": "1c641083-1687-3ab4-9339-48fbf0093ee7",
                                "text": "It is normal for any organization to have two types of expense items, stockable and non-stockable. The stockable expense items – factory consumables etc – are booked into a subinventory and can be accrued on receipt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "335ada22-8447-48ba-a2a6-0582fa72fda1",
                        "source_entry_id": "c624142e-d8ec-3173-ae5f-5108cc998e72",
                        "source_sense_id": "1c641083-1687-3ab4-9339-48fbf0093ee7",
                        "source_sense_description": "material or product intended for consumption",
                        "target_lang_word": "consommable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consommable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6b530b2-cf63-3daf-8e47-11f41c7ebf1e",
                                        "entry_id": "a4dcd2c7-ff08-36ed-b73e-23de58bbebfa",
                                        "glosses": [
                                            "Qui peut être consommé"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0935eeb8-c5d0-42ea-8f90-c5990cf8032e",
                                                "sense_id": "f6b530b2-cf63-3daf-8e47-11f41c7ebf1e",
                                                "text": "la même pièce de monnoie pouvant faire plusieurs fois cette fonction de lettre de change ou mandat sur la reproduction ; c’est-à-dire, sortir de la main du cultivateur pour satisfaire un de ses besoins quelconques, pour payer le Souverain & le Propriétaire, puis lui revenir en échange d’une denrée consommable de la part de celui qui l’aura reçue, par plus ou moins de cascades."
                                            },
                                            {
                                                "example_id": "4ea20f39-e10f-4ed9-9033-877c8144d1e0",
                                                "sense_id": "f6b530b2-cf63-3daf-8e47-11f41c7ebf1e",
                                                "text": "L’argent manquait, la richesse naturelle surabondait : quel phénomène pouvait sembler plus propre à confirmer le préjugé universel, qui cherche la richesse dans l’argent, non dans le capital consommable ?"
                                            },
                                            {
                                                "example_id": "e729611d-5c02-47fa-bc29-0ab2c8124357",
                                                "sense_id": "f6b530b2-cf63-3daf-8e47-11f41c7ebf1e",
                                                "text": "Le CBD est consommable sous diverses formes, comme l’huile, des tisanes. Dans les magasins spécialisés, on en trouve même en produits de beauté, en boissons ou en sucettes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51c9e1d8-56b8-3b9c-bb75-6429648efea2",
                                        "entry_id": "a4dcd2c7-ff08-36ed-b73e-23de58bbebfa",
                                        "glosses": [
                                            "Qui peut être consommé sans inconvénient, sans danger."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1d8e3e-1b09-4d0d-bedb-06dae709e12e",
                                                "sense_id": "51c9e1d8-56b8-3b9c-bb75-6429648efea2",
                                                "text": "En effet, dès le moment où le poisson a perdu la vie, le temps où il reste consommable fond comme neige au soleil."
                                            },
                                            {
                                                "example_id": "390a2a98-e01c-4197-b104-f556c4014c11",
                                                "sense_id": "51c9e1d8-56b8-3b9c-bb75-6429648efea2",
                                                "text": "Aisne : l’eau courante rétablie à Leuilly-sous-Coucy mais toujours non consommable après une pollution aux hydrocarbures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consommable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                                        "entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
                                        "glosses": [
                                            "Produit dont l’utilisation entraîne sa destruction ou une telle altération qu’il doit être remplacé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddb5b7ff-5aac-4e5e-bb51-c6d2344576c8",
                                                "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                                                "text": "« Un animal de compagnie n’est ni un consommable ni un jouet » : le ministre de l'Agriculture annonce un renforcement des mesures de protection des animaux de compagnie"
                                            },
                                            {
                                                "example_id": "8edc3fb3-410b-47bf-80b9-86051ff84849",
                                                "sense_id": "114d65df-36a8-3462-b676-869edbf1e461",
                                                "text": "Les conducteurs de deux-roues y trouveront également des équipements (blousons, casques...), des pièces et des consommables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b7b6ab-0dfd-35d9-958a-aca0822aa966",
                                        "entry_id": "8e79e3c5-5625-37cc-b34a-b4445ca893da",
                                        "glosses": [
                                            "Produit constituant une recharge pour un certain type de matériel."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0308467-9a80-4a97-a0fa-d95d1f7a9088",
                                                "sense_id": "91b7b6ab-0dfd-35d9-958a-aca0822aa966",
                                                "text": "La limitation volontaire des fonctionnalités qui ne sont pas liées à l’absence d’un consommable quelconque serait ainsi un moyen pour la marque de forcer la vente de cartouches, y compris si l’utilisateur ne souhaite pas imprimer, mais simplement utiliser des fonctions annexes de son imprimante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
