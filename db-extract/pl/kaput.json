                "translations": [
                    {
                        "translation_id": "9247095e-88e5-4445-b95e-67ab4f680f4d",
                        "source_entry_id": "2205e0e2-6799-329a-86e8-c343ac5df1e8",
                        "source_sense_id": "2d424d87-1b2e-304f-94ea-3fb5a7cc6f92",
