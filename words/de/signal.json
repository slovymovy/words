                        "ein Signal senden"
                    ]
                },
                {
                    "sense_id": "13bb9cba-777c-3914-8f51-eeb2995b174c",
                    "sense_definition": "Technische Vorrichtung, Leuchtanlage oder Tafel im Verkehr, die verbindliche Anweisungen wie Halten oder Weiterfahrt anzeigt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verkehr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Lokführer musste den Zug stoppen, weil das <w>Signal</w> vor dem Bahnhof auf Rot stand."
                        },
                        {
                            "text": "Kurz vor der Einfahrt in den Tunnel schaltete das <w>Signal</w> wieder auf Grün."
                        }
                    ],
                    "synonyms": [
                        "Ampel"
                    ],
                    "common_phrases": [
