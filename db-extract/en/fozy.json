                        ],
                        "examples": [
                            {
                                "example_id": "9502f9d8-4d20-4050-be9a-08a1c4f1d0d9",
                                "sense_id": "7c54f563-a026-3450-bf01-8d5e09ce4835",
                                "text": "He maun be a saft sap, wi' a head nae better than a fozy frosted turnip—it wad hae ta'en a hantle o' them to scaur Andrew Fairservice out o' his tale."
                            },
                            {
                                "example_id": "1cffbb6f-909a-4cfe-977c-75711db4dd16",
                                "sense_id": "7c54f563-a026-3450-bf01-8d5e09ce4835",
                                "text": "In years when grain was raw and light,\nSo fozy it would scarcely dight,\nI look'd around me, left and right,\n⁠As sharp's a razor,\nTill I got some unskilful wight\n⁠To buy by measure."
                            },
                            {
                                "example_id": "73ed7f31-3543-4431-9274-b73451354ef6",
                                "sense_id": "7c54f563-a026-3450-bf01-8d5e09ce4835",
                                "text": "Just a plain, stout, fozy, sappy burrow-man, keeping a gospel shop, with scarcely so much of a man's parts as will let him fend a blow in the face."
                            }
                        ]
                    }
