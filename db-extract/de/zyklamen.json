                    },
                    {
                        "form_id": "07869e93-1add-4612-a756-6cb5e502a24a",
                        "entry_id": "b9da635e-f5be-3cc7-b929-257a56ff59a6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zyklamen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ea58354-4876-380c-b095-486459ecfd95",
                        "entry_id": "b9da635e-f5be-3cc7-b929-257a56ff59a6",
                        "glosses": [
                            "Pflanzengattung aus der Unterfamilie der Myrsinengewächse (Myrsinaceae) innerhalb der Familie der Primelgewächse (Primulaceae) mit etwa zwanzig, vom Mittelmeer bis Zentralasien vorkommenden Arten"
                        ],
                        "tags": [
                            "Swiss Standard German",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3a5a4957-7057-40c9-827a-8e2e7f0c1ce9",
                                "sense_id": "5ea58354-4876-380c-b095-486459ecfd95",
                                "text": "Zyklamen gibt es in vielen verschiedenen Farbschattierungen."
                            },
                            {
                                "example_id": "e8ee0c43-8534-4c5f-b18a-97e58cccdade",
                                "sense_id": "5ea58354-4876-380c-b095-486459ecfd95",
                                "text": "„Die Erinnerung an die Monographie über die Gattung Zyklamen erfährt eine Verwendung, als ob sie eine Anspielung auf das Gespräch mit dem Freunde wäre, ganz ähnlich wie im Traume von dem verhinderten Souper die Erwähnung der Freundin durch die Anspielung »geräucherter Lachs« vertreten wird […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                        "entry_id": "b9da635e-f5be-3cc7-b929-257a56ff59a6",
                        "glosses": [
                            "Zierpflanze als Vertreter der unter [1] beschriebenen Gattung (Cyclamen) mit großen, ründlichen bis herzförmigen Blättern und leuchtenden roten, rosa oder weißen Blüten, die an einzelnen langen, fleischigen Stängeln sitzen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e6b672-6ea8-4056-811d-9ec905244a13",
                                "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                                "text": "Meine Oma hat ihre Zyklamen im Winter im Schlafzimmer stehen."
                            },
                            {
                                "example_id": "03270922-3da5-4406-bd93-569742daacd5",
                                "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                                "text": "„Hinter einem roten Teppich von Zyklamen ist die Regierung versammelt, um des Politikers zu gedenken.“"
                            },
                            {
                                "example_id": "1e5c1726-7590-4256-950f-818a28cb1af4",
                                "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                                "text": "„Beim ersten Blick könnte man den Hundszahn mit seinen zurückgelegten Blütenblättern mit einem Zyklamen oder mit der Götterblume (Dodecatheon) verwechseln.“"
                            },
                            {
                                "example_id": "ca2de27c-3f84-4534-81a8-94d80e8a3e44",
                                "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                                "text": "„Nur an ihn denkt sie manchmal, an Etan, der sie so sehr geliebt hatte, und eines Tages, als bei ihr wieder Unterricht ausfällt, macht sie sich auf den Weg zu seiner Siedlung, aufgeregt fährt sie über die kurvigen Straßen der Jerusalemer Berge, wie grün die Hänge nach den ersten Regenfällen sind, zwischen den Felsen blitzen sogar schon die rosafarbenen Flecken von Zyklamen hervor.“"
                            },
                            {
                                "example_id": "18a612f9-0a52-4d38-8768-53e65d0de460",
                                "sense_id": "47c72189-1d6f-349d-b31e-97034bdaf99c",
                                "text": "„In den Händen hielt sie ein Sträußchen Zyklamen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
