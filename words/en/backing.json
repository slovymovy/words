{
    "word_family": [
        "back",
        "backer",
        "background",
        "backup",
        "backward",
        "backbone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cc194812-4ee4-3a85-aa85-eb578a140db3",
                    "sense_definition": "Support or help, especially in the form of money.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "support_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new business venture failed because it lacked financial <w>backing</w>.",
                            "target_lang_translations": {
                                "ru": "Новое коммерческое предприятие провалилось, так как ему не хватало финансовой <w>поддержки</w>.",
                                "pl": "Nowe przedsięwzięcie biznesowe upadło, ponieważ brakowało mu finansowego <w>wsparcia</w>."
                            }
                        },
                        {
                            "text": "The candidate has the full <w>backing</w> of the local committee.",
                            "target_lang_translations": {
                                "ru": "Кандидат пользуется полной <w>поддержкой</w> местного комитета.",
                                "pl": "Kandydat ma pełne <w>poparcie</w> lokalnego komitetu."
                            }
                        }
                    ],
                    "synonyms": [
                        "support",
                        "funding",
                        "sponsorship",
                        "aid",
                        "endorsement"
                    ],
                    "antonyms": [
                        "opposition"
                    ],
                    "common_phrases": [
                        "financial backing",
                        "official backing",
                        "government backing",
                        "full backing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помощь или содействие, особенно в финансовой форме.",
                        "pl": "Wsparcie lub pomoc, zwłaszcza w postaci finansowej."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "помощь, содействие"
                            },
                            {
                                "target_lang_word": "финансирование",
                                "target_lang_sense_clarification": "денежная помощь"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "poparcie",
                                "target_lang_sense_clarification": "wsparcie, aprobata"
                            },
                            {
                                "target_lang_word": "wsparcie",
                                "target_lang_sense_clarification": "pomoc, w tym finansowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bda2ca14-b399-3158-9631-a0eb7c1af3a9",
                    "sense_definition": "Musicians and vocalists who perform with and support the main artist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Two guitarists and a drummer made up the <w>backing</w> for her tour.",
                            "target_lang_translations": {
                                "ru": "Два гитариста и барабанщик составляли её <w>аккомпанемент</w> в турне.",
                                "pl": "Dwóch gitarzystów i perkusista tworzyło <w>zespół towarzyszący</w> podczas jej trasy koncertowej."
                            }
                        },
                        {
                            "text": "The band provided excellent <w>backing</w> for the lead vocalist.",
                            "target_lang_translations": {
                                "ru": "Группа обеспечила отличное <w>сопровождение</w> для солиста.",
                                "pl": "Zespół zapewnił świetny <w>akompaniament</w> dla głównego wokalisty."
                            }
                        }
                    ],
                    "synonyms": [
                        "accompaniment"
                    ],
                    "common_phrases": [
                        "musical backing",
                        "instrumental backing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыканты и вокалисты, выступающие вместе с основным исполнителем для его поддержки.",
                        "pl": "Muzycy i wokaliści występujący z głównym artystą i wspierający go na scenie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккомпанемент",
                                "target_lang_sense_clarification": "музыкальное сопровождение"
                            },
                            {
                                "target_lang_word": "сопровождение",
                                "target_lang_sense_clarification": "группа поддержки исполнителя"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "akompaniament",
                                "target_lang_sense_clarification": "towarzyszenie muzyczne"
                            },
                            {
                                "target_lang_word": "zespół towarzyszący",
                                "target_lang_sense_clarification": "muzycy wspierający głównego wykonawcę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b46fbc8b-7b51-3dd8-ab98-193cdd73c0f0",
                    "sense_definition": "A layer of material attached to the back of something to strengthen, protect, or stiffen it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "layer_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rug has a non-slip rubber <w>backing</w> to keep it in place.",
                            "target_lang_translations": {
                                "ru": "Ковер имеет нескользящую резиновую <w>основу</w>, чтобы оставаться на месте.",
                                "pl": "Dywan ma antypoślizgowy gumowy <w>spód</w>, dzięki czemu nie przesuwa się."
                            }
                        },
                        {
                            "text": "You must peel off the paper <w>backing</w> before applying the sticker.",
                            "target_lang_translations": {
                                "ru": "Вы должны отклеить бумажную <w>подложку</w> перед наклеиванием стикера.",
                                "pl": "Przed naklejeniem naklejki należy zdjąć papierową <w>warstwę spodnią</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lining",
                        "reinforcement"
                    ],
                    "common_phrases": [
                        "adhesive backing",
                        "carpet backing",
                        "rubber backing",
                        "fabric backing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой материала, прикрепленный к обратной стороне чего-либо для укрепления или защиты.",
                        "pl": "Warstwa materiału przymocowana do spodu lub tyłu czegoś, aby to wzmocnić, zabezpieczyć lub usztywnić."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основа",
                                "target_lang_sense_clarification": "нижний слой ковра или покрытия"
                            },
                            {
                                "target_lang_word": "подложка",
                                "target_lang_sense_clarification": "защитный слой (напр. у наклейки)"
                            },
                            {
                                "target_lang_word": "подкладка",
                                "target_lang_sense_clarification": "внутренний слой материала"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "spód",
                                "target_lang_sense_clarification": "dolna warstwa, np. dywanu"
                            },
                            {
                                "target_lang_word": "podkładka",
                                "target_lang_sense_clarification": "warstwa ochronna"
                            },
                            {
                                "target_lang_word": "warstwa spodnia",
                                "target_lang_sense_clarification": "tylna lub spodnia warstwa materiału"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a65fe115-0550-3640-a9e3-a07c42ac0e2c",
                    "sense_definition": "The act of moving backwards or reversing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "motion_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>backing</w> of the large truck into the narrow alley required great skill.",
                            "target_lang_translations": {
                                "ru": "<w>Движение задним ходом</w> большого грузовика в узкий переулок потребовало большого мастерства.",
                                "pl": "<w>Cofanie</w> wielką ciężarówką w wąską uliczkę wymagało sporych umiejętności."
                            }
                        },
                        {
                            "text": "Careful <w>backing</w> is necessary when exiting this steep driveway.",
                            "target_lang_translations": {
                                "ru": "При выезде с этой крутой подъездной дорожки необходимо осторожное <w>движение назад</w>.",
                                "pl": "Przy wyjeździe z tego stromego podjazdu konieczne jest ostrożne <w>cofanie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reversing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение назад или задним ходом.",
                        "pl": "Czynność polegająca na cofaniu lub poruszaniu się do tyłu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движение задним ходом",
                                "target_lang_sense_clarification": "перемещение назад"
                            },
                            {
                                "target_lang_word": "задний ход",
                                "target_lang_sense_clarification": "режим движения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "cofanie",
                                "target_lang_sense_clarification": "ruch pojazdu w tył"
                            },
                            {
                                "target_lang_word": "jazda do tyłu",
                                "target_lang_sense_clarification": "manewr cofania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53e0b705-7512-3c35-a859-0472f0ae5c02",
                    "sense_definition": "A painted cloth or screen hung at the back of a stage as scenery.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "layer_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scenic <w>backing</w> was painted to look like a dense forest.",
                            "target_lang_translations": {
                                "ru": "Живописный <w>задник</w> был расписан так, чтобы напоминать густой лес.",
                                "pl": "Malowany <w>horyzont</w> sceniczny przypominał gęsty las."
                            }
                        },
                        {
                            "text": "Stagehands lowered a new <w>backing</w> for the second act of the play.",
                            "target_lang_translations": {
                                "ru": "Рабочие сцены опустили новый <w>задник</w> для второго акта пьесы.",
                                "pl": "Obsługa sceny opuściła nowy <w>horyzont</w> na drugi akt sztuki."
                            }
                        }
                    ],
                    "synonyms": [
                        "backdrop",
                        "background"
                    ],
                    "common_phrases": [
                        "scenic backing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расписное полотно или экран, висящий в глубине сцены в качестве декорации.",
                        "pl": "Malowana tkanina lub zastawka umieszczona w głębi sceny jako element dekoracji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задник",
                                "target_lang_sense_clarification": "театральная декорация заднего плана"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "horyzont",
                                "target_lang_sense_clarification": "tło sceniczne, prospekt"
                            },
                            {
                                "target_lang_word": "zastawka w głębi sceny",
                                "target_lang_sense_clarification": "element dekoracji teatralnej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab2d70cb-4db0-3227-8447-4a4f547f1bd7",
                    "sense_definition": "The process of training a young horse to accept a rider.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>backing</w> of the spirited colt took a lot of patience and time.",
                            "target_lang_translations": {
                                "ru": "<w>Заездка</w> горячего жеребенка потребовала много терпения и времени.",
                                "pl": "<w>Ujeżdżanie</w> porywczego źrebaka wymagało dużo cierpliwości i czasu."
                            }
                        },
                        {
                            "text": "Proper <w>backing</w> ensures the horse remains calm when mounted.",
                            "target_lang_translations": {
                                "ru": "Правильная <w>заездка</w> гарантирует, что лошадь останется спокойной, когда на нее садятся.",
                                "pl": "Prawidłowe <w>ujeżdżanie</w> gwarantuje, że koń zachowa spokój przy dosiadaniu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс приучения молодой лошади к всаднику.",
                        "pl": "Proces ujeżdżania młodego konia w celu przyzwyczajenia go do noszenia jeźdźca."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заездка",
                                "target_lang_sense_clarification": "обучение лошади под седлом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ujeżdżanie",
                                "target_lang_sense_clarification": "przyzwyczajanie młodego konia do siodła i jeźdźca"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c4cdc44-5858-364a-877a-89effca3a1d8",
                    "sense_definition": "Present participle and gerund of <w>back</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is currently <w>backing</w> his car out of the garage.",
                            "target_lang_translations": {
                                "ru": "В данный момент он <w>выводит задним ходом</w> свою машину из гаража.",
                                "pl": "On akurat <w>wycofuje</w> swój samochód z garażu."
                            }
                        },
                        {
                            "text": "The committee is <w>backing</w> the proposal for a new park.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>поддерживает</w> предложение о новом парке.",
                                "pl": "Komitet <w>popiera</w> projekt utworzenia nowego parku."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма глагола back (двигаться назад, поддерживать).",
                        "pl": "Imiesłów czasu teraźniejszego od czasownika 'back' (cofać, popierać)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдавать назад",
                                "target_lang_sense_clarification": "двигаться задним ходом"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "оказывать поддержку"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "popierający",
                                "target_lang_sense_clarification": "udzielający wsparcia"
                            },
                            {
                                "target_lang_word": "cofający",
                                "target_lang_sense_clarification": "poruszający się do tyłu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab9d0e52-1cba-3147-b21f-504f17d2a125",
                    "sense_definition": "Serving to support or accompany a main performer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started her career as a <w>backing</w> singer for a famous pop star.",
                            "target_lang_translations": {
                                "ru": "Она начала свою карьеру как <w>бэк-вокалистка</w> у известной поп-звезды.",
                                "pl": "Zaczynała karierę jako wokalistka <w>towarzysząca</w> u boku słynnej gwiazdy popu."
                            }
                        },
                        {
                            "text": "The <w>backing</w> musicians played softly during the emotional verse.",
                            "target_lang_translations": {
                                "ru": "<w>Аккомпанирующие</w> музыканты играли тихо во время эмоционального куплета.",
                                "pl": "Muzycy <w>towarzyszący</w> grali cicho podczas pełnej emocji zwrotki."
                            }
                        }
                    ],
                    "synonyms": [
                        "supporting",
                        "accompanying"
                    ],
                    "common_phrases": [
                        "backing vocals",
                        "backing singer",
                        "backing track",
                        "backing group",
                        "backing band"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для поддержки или сопровождения основного исполнителя.",
                        "pl": "Służący do wspierania lub akompaniowania głównemu wykonawcy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккомпанирующий",
                                "target_lang_sense_clarification": "сопровождающий музыкой"
                            },
                            {
                                "target_lang_word": "бэк-",
                                "target_lang_sense_clarification": "первая часть сложных слов (напр. бэк-вокал)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "towarzyszący",
                                "target_lang_sense_clarification": "występujący w tle, akompaniujący"
                            },
                            {
                                "target_lang_word": "akompaniujący",
                                "target_lang_sense_clarification": "grający w tle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}