                        "ascertain the cause"
                    ]
                },
                {
                    "sense_id": "523171d7-bed0-3905-bcb3-a43724eb5e4d",
                    "sense_definition": "To establish or prove that something is true or accurate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence helps to <w>ascertain</w> the true meaning of the ancient text."
                        },
                        {
                            "text": "These documents <w>ascertain</w> his claim to the property."
                        }
                    ],
                    "synonyms": [
