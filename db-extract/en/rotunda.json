    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "67ccd916-94b0-3192-bb31-c7ecabba6d11",
                "word": "Rotunda",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65e7dd6e-aee3-399a-b036-54d623f8874e",
                        "entry_id": "67ccd916-94b0-3192-bb31-c7ecabba6d11",
                        "glosses": [
                            "The United States Capitol rotunda."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d773e82-6127-44b9-8805-6802c887f637",
                                "sense_id": "65e7dd6e-aee3-399a-b036-54d623f8874e",
                                "text": "No African-Americans have lain in state in the Rotunda, and only two have lain there in honor: Mrs. Parks in 2005 and Officer Jacob Joseph Chestnut, a Capitol Police officer killed in the line of duty, in 1998."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "25cd4e6c-f885-3ef3-b122-301db1523001",
                "word": "rotunda",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "94512cd6-039e-41a1-ab6b-b3a55696b831",
                        "entry_id": "25cd4e6c-f885-3ef3-b122-301db1523001",
                        "tags": [
