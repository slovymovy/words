                    {
                        "translation_id": "66edc2f9-7c8c-460c-879f-b3a926e49c11",
                        "source_entry_id": "6d09a73d-fb22-313f-b670-93a59f147d90",
                        "source_sense_id": "fa5d3ab6-fc54-3afc-a8c3-9b72ce625cf5",
                        "target_lang_word": "Bayer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bayer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                        "entry_id": "11096ce6-16ce-3837-80ab-6d696bcb1f29",
                                        "glosses": [
                                            "eine in Bayern (Deutschland) geborene oder dort auf Dauer lebende Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799570f9-3a81-470d-b0aa-07971a591818",
                                                "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                                "text": "Seit 1989 ist Gerald ein Bayer."
                                            },
                                            {
                                                "example_id": "ca37a6b9-e6f9-4115-880e-00a5a507ce4c",
                                                "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                                "text": "Im Urlaub haben wir eine Familie aus waschechten Bayern getroffen."
                                            },
                                            {
                                                "example_id": "a9dd0240-ec19-4560-958b-43e9504b8d08",
                                                "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                                "text": "Wer in Bayern das Wahlrecht hat, gilt als Bayer."
                                            },
                                            {
                                                "example_id": "47a60bd8-b9e9-4cbb-b093-fe34ab533958",
                                                "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                                "text": "Was, du bist Bayer?"
                                            },
                                            {
                                                "example_id": "1d5c531c-b392-44e6-a838-daa4285cde13",
                                                "sense_id": "29086575-5835-3f5f-88aa-fe4aa5660315",
                                                "text": "„In diesem Papier werde ein für allemal festgelegt, dass niemand anderes als die Gebrüder Wright als erste Motorflieger genannt werden dürften; zwei Amerikaner und nicht der Bayer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bayer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                        "entry_id": "54267ba2-412e-3601-a2f2-09eaa2ee8315",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bd49fa-9f49-4778-be28-d566ba2b9587",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Frau Bayer ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b7e6e086-5a9f-4aae-bd7a-749d4b44c9d0",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Herr Bayer wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "15f99968-b88e-4b11-adb6-d0d66f77cfeb",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Die Bayers fahren heute nach Garmisch-Partenkirchen."
                                            },
                                            {
                                                "example_id": "f67fe222-d78f-4906-8e03-d0607fc56007",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Der Bayer trägt nie die Pullover, die die Bayer ihm strickt."
                                            },
                                            {
                                                "example_id": "51ac5ee1-b393-4167-9927-2cbf16ddd427",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bayer kommt, geht der Herr Bayer.“"
                                            },
                                            {
                                                "example_id": "7402b12e-fa5e-481f-9c45-c2865d26330b",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Bayer kommt und geht."
                                            },
                                            {
                                                "example_id": "bbb0deda-066b-4d76-a7d5-83a2eb8cfa22",
                                                "sense_id": "b06e7062-3c9d-3e02-84b3-b20d60f302e8",
                                                "text": "Bayers kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
