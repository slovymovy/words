                "senses": [
                    {
                        "sense_id": "c9c7df3d-5dbc-3be9-8133-87c9ed7d5c87",
                        "entry_id": "db298d84-5a88-3295-85a3-b767132b8688",
                        "glosses": [
                            "Offizier des Trains"
