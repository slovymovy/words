{
    "word_family": [
        "время",
        "одновременный",
        "одновременность",
        "современный",
        "своевременный",
        "временный"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "5c9b0706-2cfb-3f1e-9f85-5a84e941c149",
                    "sense_definition": "Происходя в одно и то же время с чем-либо другим.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_simultaneity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Невозможно работать и <w>одновременно</w> отвечать на телефонные звонки!",
                            "target_lang_translations": {
                                "en": "It is impossible to work and answer phone calls <w>at the same time</w>!",
                                "zh": "不可能一边工作一边<w>同时</w>接听电话！"
                            }
                        },
                        {
                            "text": "Все начали говорить <w>одновременно</w>, и ничего нельзя было разобрать.",
                            "target_lang_translations": {
                                "en": "Everyone started speaking <w>simultaneously</w>, and nothing could be understood.",
                                "zh": "大家开始<w>同时</w>说话，什么也听不清。"
                            }
                        }
                    ],
                    "synonyms": [
                        "синхронно",
                        "параллельно",
                        "единовременно"
                    ],
                    "antonyms": [
                        "по очереди",
                        "поочерёдно",
                        "последовательно",
                        "раздельно"
                    ],
                    "common_phrases": [
                        "делать одновременно",
                        "говорить одновременно",
                        "прийти одновременно"
                    ],
                    "target_lang_definitions": {
                        "en": "Occurring at the same time as something else.",
                        "zh": "在同一时间发生。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simultaneously",
                                "target_lang_sense_clarification": "happening at the exact same instant"
                            },
                            {
                                "target_lang_word": "at the same time",
                                "target_lang_sense_clarification": "general usage"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同时",
                                "target_lang_sense_clarification": "表示动作或状态在同一时刻发生"
                            },
                            {
                                "target_lang_word": "一齐",
                                "target_lang_sense_clarification": "强调多个主体动作一致"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8243889-3f25-34d6-8062-4bbf36ec0cdc",
                    "sense_definition": "Вместе с тем; употребляется для соединения противоречивых или дополняющих друг друга качеств или действий.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contrast_combination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ней есть что-то притягательное и <w>одновременно</w> отталкивающее.",
                            "target_lang_translations": {
                                "en": "There is something attractive and <w>at the same time</w> repulsive about her.",
                                "zh": "她身上既有吸引人的一面，<w>同时</w>又有令人反感的一面。"
                            }
                        },
                        {
                            "text": "Эта задача сложная, но <w>одновременно</w> очень интересная.",
                            "target_lang_translations": {
                                "en": "This task is difficult, but <w>at the same time</w> very interesting.",
                                "zh": "这项任务很难，但<w>同时</w>也非常有趣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "и одновременно",
                        "но одновременно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to connect contradictory or complementary qualities or actions.",
                        "zh": "用于连接相互矛盾或互补的品质或行为。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at the same time",
                                "target_lang_sense_clarification": "indicating co-existing but contrasting traits"
                            },
                            {
                                "target_lang_word": "simultaneously",
                                "target_lang_sense_clarification": "formal context"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同时",
                                "target_lang_sense_clarification": "用于并列两种性质或状态"
                            },
                            {
                                "target_lang_word": "又",
                                "target_lang_sense_clarification": "用于连接两种并存的属性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e4d78e1-69d6-3ee8-b81d-e30ab56b3b07",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>одновременный</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наступление событий было <w>одновременно</w>.",
                            "target_lang_translations": {
                                "en": "The onset of events was <w>simultaneous</w>.",
                                "zh": "这些事件是<w>同时</w>发生的。"
                            }
                        },
                        {
                            "text": "Это решение не было <w>одновременно</w> с другими мерами.",
                            "target_lang_translations": {
                                "en": "This decision was not <w>simultaneous</w> with other measures.",
                                "zh": "这项决定并非与其他措施<w>同时</w>做出。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'simultaneous'.",
                        "zh": "形容词“同时的”的短尾中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "simultaneous",
                                "target_lang_sense_clarification": "adjective describing events happening together"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同时发生",
                                "target_lang_sense_clarification": "描述事件在同一时间出现"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}