            "senses": [
                {
                    "sense_id": "a258f306-d712-395b-bf17-74d55b5c45a8",
                    "sense_definition": "present participle and gerund of <w>suckle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nursing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother cat was quietly <w>suckling</w> her kittens in the warm basket.",
                            "target_lang_translations": {
                                "nl": "De moederpoes was rustig haar kittens aan het <w>zogen</w> in de warme mand."
                            }
                        },
                        {
                            "text": "He watched the mare <w>suckling</w> her newborn foal out in the meadow.",
                            "target_lang_translations": {
                                "nl": "Hij keek toe hoe de merrie haar pasgeboren veulen <w>zoogde</w> in de wei."
                            }
                        }
                    ],
                    "synonyms": [
