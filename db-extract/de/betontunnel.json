                "senses": [
                    {
                        "sense_id": "9264b7a1-f9e6-3b78-ab56-b3e7abbe6cea",
                        "entry_id": "c6c0592d-5459-3c62-903a-65d497e7a2cf",
                        "glosses": [
                            "Tunnel aus Beton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3311081-be86-4815-8f40-4e6a740dfd89",
                                "sense_id": "9264b7a1-f9e6-3b78-ab56-b3e7abbe6cea",
                                "text": "„Sie bogen links in eine etwas breitere Straße, in der Menschen benommen an den Hauswänden hockten, dann rechts in einen Betontunnel, wo sie durch Dreck wateten, über Schlafende hinwegstiegen und sich unter baumelnden Glühbirnen und Stromkabeln hindurchduckten.“"
                            },
                            {
                                "example_id": "5745a48c-ba32-4786-a6f2-056cb9b99a62",
                                "sense_id": "9264b7a1-f9e6-3b78-ab56-b3e7abbe6cea",
                                "text": "„Das Drahtseil über ihren Köpfen verschwand in zwei Betontunneln - es kam von Süden und setzte sich nach Osten fort.“"
                            },
                            {
                                "example_id": "b6c658c7-2632-437c-8027-a7d84a42e024",
                                "sense_id": "9264b7a1-f9e6-3b78-ab56-b3e7abbe6cea",
                                "text": "„Die Papiere und die Fernbedienung fest an sich gedrückt, kletterte Marty durch einen hell erleuchteten Schacht die Leiter hinunter, die zu dem unterirdischen Betontunnel führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
