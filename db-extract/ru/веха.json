                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef109558-05a2-3ac9-b0f5-78bfa5ea16c0",
                        "entry_id": "bb5527ab-f6e7-31b5-b778-8aec6a062ed5",
                        "glosses": [
                            "шест или иная метка, указывающая на местности путь или границу участка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb15c48f-27cd-4e9e-8280-4c007f332e94",
                                "sense_id": "ef109558-05a2-3ac9-b0f5-78bfa5ea16c0",
                                "text": "Он, во-первых, никак не понимал, что человек может бесцельно отправиться на гибель, а во-вторых, дорога от станка была только одна и притом широкая и обставленная вехами, так что сбиться было невозможно, особенно в светлую все-таки ночь…"
                            }
                        ]
                    },
                    {
                        "sense_id": "25635164-280e-3f3c-8e8c-ec02926cfc63",
                        "entry_id": "bb5527ab-f6e7-31b5-b778-8aec6a062ed5",
                        "glosses": [
                            "перен. важный этап, очень значительное событие в истории чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a5af4d-ed6a-4ab5-bf05-14de576d33eb",
                                "sense_id": "25635164-280e-3f3c-8e8c-ec02926cfc63",
                                "text": "Это открытие стало вехой в истории химии — калий стал первым металлом, для получения которого воспользовались электричеством."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1e3749c-fb8b-4888-86b6-d3c2bf3dca8d",
                        "source_entry_id": "bb5527ab-f6e7-31b5-b778-8aec6a062ed5",
                        "target_lang_word": "landmark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landmark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "844a2789-30f0-3ef4-9f8c-bb486bc16a21",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "An object that marks the boundary of a piece of land (usually a stone, or a tree)."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A recognizable natural or man-made feature used for navigation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ec822b2-6030-462e-a53b-b6b012cab7a7",
                                                "sense_id": "90e085f3-0050-33a7-838f-e2288d29a38c",
                                                "text": "Anyone have any weird landmarks they often remember seeing along roads in the olden days?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a9b55f5-72e9-3967-a3a7-47f22cb0cbdd",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A notable location with historical, cultural, or geographical significance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                        "entry_id": "2bb72a07-6145-373c-8f09-2529f3be4387",
                                        "glosses": [
                                            "A major event or discovery."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bba19cf-49cd-4320-8e14-76b5aa942bf4",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "an important landmark in human history"
                                            },
                                            {
                                                "example_id": "6a18df78-d67a-4216-a302-f20e2ede3e1c",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "a landmark paper in neurosurgery"
                                            },
                                            {
                                                "example_id": "7bbdad6a-69fc-47df-8664-8e54eed990b2",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "a landmark ruling/case"
                                            },
                                            {
                                                "example_id": "84fc5315-18c3-4eb8-afb5-9f5eaddea8e7",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "He called the overthrow of Iraqi dictator Saddam Hussein and the recent elections in Afghanistan landmark events in the history of liberty."
                                            },
                                            {
                                                "example_id": "56caf902-ebf7-485f-bcf8-cd4747d643ec",
                                                "sense_id": "24d37989-67af-39cf-86b2-7157810bb6e7",
                                                "text": "Leicester closed out the win to spark emotional scenes as those inside Wembley rejoiced in a landmark victory."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "landmark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                        "entry_id": "b07c86af-5197-3a25-bab6-cc3b06f1b4ba",
                                        "glosses": [
                                            "To officially designate a site or building as a landmark."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa54efcb-a8b8-45e2-ba5b-5cf966790408",
                                                "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                                "text": "St Mary's Church stands on the north side of the village, a building of flint and stone with a 140 ft high steeple that landmarks one of the most beautiful churches in Suffolk."
                                            },
                                            {
                                                "example_id": "ff805871-6c70-47ba-bef3-23bdde7a5ac5",
                                                "sense_id": "1d2470b4-ccb5-3c9d-80e4-18b53d60a5f3",
                                                "text": "“Permitted demolition or stripping rarely occurs on landmarked buildings,” she said. Ms. de Bourbon also noted that the city already requires the Buildings Department to hold permits for 40 days for “calendared” properties — those currently under landmarks consideration — so the commission has a chance to designate them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3362f539-f357-432d-8954-cffde0abadfc",
                        "source_entry_id": "bb5527ab-f6e7-31b5-b778-8aec6a062ed5",
                        "target_lang_word": "milestone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milestone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1dede19-9cc5-393b-a469-d9af3eda3a14",
                                        "entry_id": "45c6da33-727d-3daa-9b01-db002621cef2",
                                        "glosses": [
                                            "A stone milepost (or by extension in other materials), one of a series of numbered markers placed along a road at regular intervals, typically at the side of the road or in a median."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                        "entry_id": "45c6da33-727d-3daa-9b01-db002621cef2",
                                        "glosses": [
                                            "An important event in a person's life or career, in the history of a nation, in the life of some project, etc."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea5a8800-4f22-4464-87d2-920664512c1a",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "Death is another milestone on their way."
                                            },
                                            {
                                                "example_id": "7c1c7d15-d35a-4dd8-a61b-c41d71c6ef4b",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            },
                                            {
                                                "example_id": "9f0ee2e0-f077-4daa-82cb-0602c1214fc1",
                                                "sense_id": "673ef0fc-46a6-328c-901b-1282a2d95758",
                                                "text": "She bought the model as a surprise gift for a friend who is a lifelong HST fan and railwayman, and who will soon be celebrating a milestone birthday."
                                            }
                                        ]
                                    }
                                ]
