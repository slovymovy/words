                    {
                        "translation_id": "0669e469-531e-4bc9-a07c-be33fd76d535",
                        "source_entry_id": "67260105-9957-3b90-94b9-af3af63818d7",
                        "source_sense_id": "5474bd7d-3c28-3a55-87fc-e99b3ba3b62f",
