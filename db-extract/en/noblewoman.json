                        "entry_id": "2f8f77ac-59e4-3406-b175-bc177d97fe8b",
                        "glosses": [
                            "A woman having a noble rank, especially one belonging to the peerage; a Lady."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0d4eda-27bb-4d36-90f4-7ef692dfdc54",
                                "sense_id": "7336969c-e34c-3d6e-9a19-e1db413bf782",
                                "text": "The King [...] sit at the head of the royal table with his elder warriors and advisers, noblemen and noblewomen."
                            }
                        ]
                    }
                ],
