                                "target_senses": [
                                    {
                                        "sense_id": "a8b5b495-f660-3f33-a016-102636b50dbe",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To cut."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d736a155-59bc-4d56-b717-e4fbc968e11d",
                                                "sense_id": "a8b5b495-f660-3f33-a016-102636b50dbe",
                                                "text": "My good blade carves the casques of men, / My tough lance thrusteth sure, / My strength is as the strength of ten, / Because my heart is pure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4bd01d5-d224-38c7-8b72-dbf4a02cb874",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To cut meat in order to serve it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "578931b5-06b7-4da0-a385-ed9dcd576945",
                                                "sense_id": "e4bd01d5-d224-38c7-8b72-dbf4a02cb874",
                                                "text": "You carve the roast and I’ll serve the vegetables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To shape to sculptural effect; to produce (a work) by cutting, or to cut (a material) into a finished work, especially with cuts that are curved rather than only straight slices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac02ca66-1b9d-4ef9-844f-723364a45572",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "to carve a name into a tree"
                                            },
                                            {
                                                "example_id": "8b741bea-a812-4c9c-9eb4-ce82989f35cd",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "The facades of the buildings fronting upon the avenue within the wall were richly carven[…]."
                                            },
                                            {
                                                "example_id": "3e7838df-6c95-492a-9273-e017402cbc38",
                                                "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9252d2c-cc69-309c-9a28-4a373fbe5c14",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To perform a series of turns without pivoting, so that the tip and tail of the snowboard take the same path."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To take or make, as by cutting; to provide."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e740d73-9c1e-4284-a82b-749d9313895f",
                                                "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                                "text": "[…] who could easily have carved themselves their own food."
                                            },
                                            {
                                                "example_id": "6a5e21f8-5786-406b-bb59-949f1f851739",
                                                "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                                                "text": "The Reds carved the first opening of the second period as Glen Johnson's pull-back found David Ngog but the Frenchman hooked wide from six yards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1108f64e-b112-3ad7-a268-867b82287525",
                                        "entry_id": "13683d91-efb8-3b03-810d-f60a4446f412",
                                        "glosses": [
                                            "To lay out; to contrive; to design; to plan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f3c0e3-12a4-49dc-be75-92e43e787b6e",
                                                "sense_id": "1108f64e-b112-3ad7-a268-867b82287525",
                                                "text": "Lie ten nights awake carving the fashion of a new doublet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "carve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                                        "entry_id": "154dd4d0-af89-3a4c-b8af-ad11dcf05821",
                                        "glosses": [
                                            "A carucate."
                                        ],
                                        "tags": [
                                            "obsolete"
