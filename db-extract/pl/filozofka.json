                    {
                        "translation_id": "5ad31a8a-3153-4611-b87d-8938b607f768",
                        "source_entry_id": "39384adc-679a-32c6-a5a2-991687d3265c",
                        "source_sense_id": "cf9a0dc8-d79d-3f27-af82-0dfcffdb64c1",
                        "target_lang_word": "Philosophin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Philosophin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                        "entry_id": "3c21c6db-162c-3720-86d4-cfeb4e611d48",
                                        "glosses": [
                                            "eine Frau, die (beruflich, professionell) im Gebiet der Philosophie forscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9317e4af-1921-43ab-9383-9e6b71e4a8c9",
                                                "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                                "text": "Elizabeth Anscombe, Simone de Beauvoir und Hannah Arendt waren Philosophinnen."
                                            },
                                            {
                                                "example_id": "3fb21156-c288-4484-b5f2-5d2988f3608b",
                                                "sense_id": "64972bec-12c0-31fa-bc01-2c0dc173f48a",
                                                "text": "„Manch andere Kollegen haben umgekehrt wenig Verständnis dafür, wenn sich eine Philosophin so vieler heißer Eisen und einer Minderheit nach der anderen annimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                        "entry_id": "3c21c6db-162c-3720-86d4-cfeb4e611d48",
                                        "glosses": [
                                            "eine weibliche Person mit nachdenklicher, philosophischer Veranlagung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff2c9831-f077-4610-ada6-d9db4e08394c",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "Meine Tochter war schon immer eine Philosophin."
                                            },
                                            {
                                                "example_id": "c338290d-f815-4175-86ab-2445732537d5",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "„Dreiviertel der Tischgenossen stießen Rufe der Bewunderung aus, und die schöne Philosophin freute sich, als sie mich vor Entzücken über den Beifall lachen sah.“"
                                            },
                                            {
                                                "example_id": "74806ede-a3f9-46dd-b665-6bead7a772e9",
                                                "sense_id": "fa4800c3-8bf9-3971-afeb-8dfae5371d02",
                                                "text": "„Sie ist eine Philosophin, und in ihren Deklamationen an die Natur schwingen uralte Lehren einer vorspiritualistischen Religion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
