                "senses": [
                    {
                        "sense_id": "871e34b1-b6ef-3ac7-80d9-1cf780a71907",
                        "entry_id": "4eedd523-53c9-3a2b-8f8f-d3e2fee65e5b",
                        "glosses": [
                            "Zweig der Technik, der sich besonders mit den wirtschaftlichen Möglichkeiten, die das Meer bietet, befasst und sie technisch nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0e1ff7c-8cce-4587-9f9b-04f18cca012d",
                                "sense_id": "871e34b1-b6ef-3ac7-80d9-1cf780a71907",
                                "text": "„Die Meerestechnik kombiniert und integriert Techniken, die für den Schutz und die Nutzung der Meere eingesetzt werden können.“"
                            },
                            {
                                "example_id": "29baba81-3865-4543-9e2a-4b5f518ffba1",
                                "sense_id": "871e34b1-b6ef-3ac7-80d9-1cf780a71907",
                                "text": "„Der Abschlussgrad \"Bachelor of Engineering\" weist darauf hin, dass es sich bei der Meerestechnik um ein Ingenieurstudium mit den damit verbundenen sehr guten späteren Berufsaussichten für die Absolventinnen und Absolventen handelt.“"
                            },
                            {
                                "example_id": "d1a22db9-1963-414d-b0ee-ff23348a8c1a",
                                "sense_id": "871e34b1-b6ef-3ac7-80d9-1cf780a71907",
                                "text": "„Die Meerestechnik befasst sich mit der Produktion industrieller Erzeugnisse, die für die wirtschaftliche Nutzung der Weltmeere eingesetzt werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
