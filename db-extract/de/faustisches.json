                        "form": "einem Faustischen"
                    },
                    {
                        "form_id": "bddc65c4-b2a3-46c8-8790-1cf5537a536f",
                        "entry_id": "cbe65936-d222-31fb-962c-a78f8681b4aa",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "ein Faustisches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                        "entry_id": "cbe65936-d222-31fb-962c-a78f8681b4aa",
                        "glosses": [
                            "ein bestimmter Charaktertypus nach dem namengebenden Held Faust der deutschen Volkssage, der rastlos tätig nach dem Höchsten und Tiefsten, was für den Menschengeist erreichbar ist, strebt und dem das drängende Suchen wertvoller als das Besitzen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5537d738-e5b6-4b94-95b0-660626e3d0eb",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "Faust und das Faustische (Buchtitel)"
                            },
                            {
                                "example_id": "cc7393f0-6ca2-4f8f-853e-99ca9f839ea9",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "„ … Diese Züge wurden als das Faustische, als die Lebensform des abendländischen, besonders des deutschen Menschen verherrlicht. … Goethes Faust ist zugleich Symbol des Mannes, der, von geistiger Anmaßung verzehrt, im Gefolge des Satans die Ordnungen von Welt und Menschen zerstört, solange er sich der göttlichen Gnade versagt.“"
                            },
                            {
                                "example_id": "5ea0f54d-8e2b-4179-8a28-9f98aacaab1e",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "„Sein Bruder Guido, ein „trauriges Kapitel“ der Familiengeschichte dagegen, war Nazi, wenngleich nur a bisserl. Obwohl er sich als Opfer Hitlers begreift, verspürt er gelegentlich noch das Faustische in sich.“"
                            },
                            {
                                "example_id": "e8ddfb4b-dc11-41c8-9581-e84d14a6c620",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "„Das Faustische zeichnet sich in der Szene \"Wald und Höhle\" durch mehrere Aspekte aus. Zum einen erfährt seine zerrissene Seele Heilung in der Natur. “"
                            },
                            {
                                "example_id": "84a6a99e-4110-48ce-b35d-c9e6fadb7fe6",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "„Davon redet auch dieser Faust. Ich denke, daß gerade im zweiten Teil viel vom Goetheschen Universum enthalten ist. Das interessiert mich. Was ist das Faustische? Alle tun so, als sei das eine gesicherte Erkenntnis.“"
                            },
                            {
                                "example_id": "87a8bb3c-bf22-4305-ba96-c90f355c0fe7",
                                "sense_id": "2e6a36e7-68bb-343c-8874-0008612c0e05",
                                "text": "„Durch die Unterscheidung von böse und schlecht reduziert der Autor die Sphäre des Bösen auf einen Kern, der nicht aus der Welt zu schaffen, aber auch nicht so wirkungsmächtig ist. Diesen Kern interpretiert er als Ausdruck des Faustischen im Menschen, auf den Drang, seine Grenzen zu überschreiten, ins Unendliche zu streben, am Ende dem Nichts zu begegnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
