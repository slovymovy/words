                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f898e5ee-16ee-4d4f-a363-ace1fb1d4334",
                                "sense_id": "cad6677f-a99f-370a-9390-9f2114fd3a25",
                                "text": "„Die Ostseeküste der baltischen Staaten und Ostpreußens ist eine der größten Bernstein-Fundstätten der Welt.“"
                            },
                            {
                                "example_id": "d8a0e647-ed42-4397-b8ed-20ab2b619740",
                                "sense_id": "cad6677f-a99f-370a-9390-9f2114fd3a25",
                                "text": "„Von dort aus hätten sie Ausflüge an die Ostseeküste und ans Frische Haff gemacht und seien viel schwimmen gegangen.“"
                            }
                        ],
