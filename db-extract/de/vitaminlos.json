                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8b1e439-72ad-31ec-9523-9cc80977d19a",
                        "entry_id": "b1050e3e-9684-337e-a0de-ce484aecd646",
                        "glosses": [
                            "sehr wenig bis gar keine Vitamine enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7849686-7d10-4596-8d58-07b52995c3a9",
                                "sense_id": "d8b1e439-72ad-31ec-9523-9cc80977d19a",
                                "text": "„Niemand musste hungern, aber das Essen war oft entsetzlich eintönig und vitaminlos.“"
                            },
                            {
                                "example_id": "7aba7c3e-025f-487d-b8ce-339ac4f90c55",
                                "sense_id": "d8b1e439-72ad-31ec-9523-9cc80977d19a",
                                "text": "„Das trifft besonders auch auf Süssgetränke zu – sie sind nahrungsfaser und vitaminlose Kalorienlieferanten und Hungermacher.“"
                            },
                            {
                                "example_id": "1baea4a1-8aa1-4e18-b559-9a23df4e6128",
                                "sense_id": "d8b1e439-72ad-31ec-9523-9cc80977d19a",
                                "text": "„Den Rest des Nachmittags verbringen die Gesättigten dann mit dem Verdauen des fetten und vitaminlosen Mittagessens.“"
                            },
                            {
                                "example_id": "6c6791a0-b456-4158-902a-9e43fc08509a",
                                "sense_id": "d8b1e439-72ad-31ec-9523-9cc80977d19a",
                                "text": "„Man stellt jetzt Vitamine aus Rohstoffen her und setzt sie vitaminlosen Nahrungsmitteln zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
