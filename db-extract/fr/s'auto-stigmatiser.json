                            {
                                "example_id": "06ff53e1-1a7c-4d63-8d55-7aa012f078a3",
                                "sense_id": "98bdb56d-d1e2-3170-af61-c5914ab13c24",
                                "text": "Enfin, la patiente, selon l’ISMI, s’auto-stigmatise par rapport à son trouble d’usage d’alcool."
                            },
                            {
                                "example_id": "fd050054-1285-40ba-9050-c30fd52eb051",
                                "sense_id": "98bdb56d-d1e2-3170-af61-c5914ab13c24",
                                "text": "Le personnel médical a du mal à donner le diagnostic parce qu’il a peur que les personnes s’auto-stigmatisent et en arrivent à mettre fin à leurs jours."
                            },
                            {
                                "example_id": "c848842b-b5a1-4dcd-81e6-140e69925637",
                                "sense_id": "98bdb56d-d1e2-3170-af61-c5914ab13c24",
                                "text": "Les personnes touchées peuvent alors intérioriser ces stéréotypes et s’auto-stigmatiser, ce qui peut avoir un impact négatif sur leur qualité de vie et mener à l’isolement social et à la dépression."
                            }
                        ]
