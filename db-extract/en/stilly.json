                        "entry_id": "2ef6283e-dff2-3a96-99fa-0fc2d50ada79",
                        "glosses": [
                            "While still and calm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8efff36c-65cf-4ce9-ac60-c67054ddc04b",
                                "sense_id": "08e50f97-719f-39b2-8e31-7ffc33c462d7",
                                "text": "She passed away very stilly and painlessly."
                            },
                            {
                                "example_id": "485d49f0-7923-423d-8deb-47290ea46ae4",
                                "sense_id": "08e50f97-719f-39b2-8e31-7ffc33c462d7",
                                "text": "The river, too, was colored, and every tree was like a torch burning stilly in the quiet of the evening."
                            },
                            {
                                "example_id": "06d9dc29-0e67-4543-9fa4-fd6a17dbf72a",
                                "sense_id": "08e50f97-719f-39b2-8e31-7ffc33c462d7",
                                "text": "When she arrived at the white boat which floated so stilly on the morning glitter of the water, only just stirred by a breeze from the south, she stepped at once on board."
                            }
                        ]
                    }
