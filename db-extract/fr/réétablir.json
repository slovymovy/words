                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17236a2b-9a1e-4cba-9c8b-9144a845ecbb",
                                "sense_id": "13c9c253-05c1-33b5-a58d-e7e74add7a21",
                                "text": "Si nous considérons l’ensemble de ces possibilités, nous pouvons raisonnablement espérer réétablir environ 400 000 personnes au maximum au cours de la prochaine année budgétaire, soit à peu près la moitié des personnes dont nous avons la charge."
                            },
                            {
                                "example_id": "7b065984-3514-483c-8431-6b5ac9a41d21",
                                "sense_id": "13c9c253-05c1-33b5-a58d-e7e74add7a21",
                                "text": "Le gouvernement s’est engagé à réétablir les expulsés et les réfugiés, occupés dans l’agriculture avant leur expulsion ou leur fuite."
                            }
                        ]
                    }
