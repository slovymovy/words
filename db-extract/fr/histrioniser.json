                "senses": [
                    {
                        "sense_id": "f49a7d9c-54b9-3aca-b5c7-111e055ff48a",
                        "entry_id": "c347d48e-ba0c-3c55-87d0-5af8f71c4599",
                        "glosses": [
                            "Donner un caractère histrionique, théâtral, à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7239fa7-f98c-4094-954c-7fb445652600",
                                "sense_id": "f49a7d9c-54b9-3aca-b5c7-111e055ff48a",
                                "text": "Il y a bien sûr une responsabilité particulière de Jean-Luc Mélenchon qui n'a cessé d'hystériser et d'histrioniser son aversion maniaque pour François Hollande…"
                            }
                        ]
                    },
                    {
                        "sense_id": "6b450101-1824-3c4a-9a5e-55b417db65c1",
                        "entry_id": "c347d48e-ba0c-3c55-87d0-5af8f71c4599",
                        "glosses": [
                            "Se comporter de façon histrionique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef15a3b7-a375-4a3e-a773-84bde2e47c87",
                                "sense_id": "6b450101-1824-3c4a-9a5e-55b417db65c1",
                                "text": "Sa fonction est de faire barrage à l’historialisation comme moyen d’histrioniser (toujours l’acteur !)."
                            },
                            {
                                "example_id": "24ed8fad-9d9c-4775-b9e4-1ecc0b399be6",
                                "sense_id": "6b450101-1824-3c4a-9a5e-55b417db65c1",
                                "text": "Le monde occidental offre ainsi une multiplicité d’occasions d’histrioniser."
                            }
                        ]
                    }
                ],
