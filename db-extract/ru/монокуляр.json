                "senses": [
                    {
                        "sense_id": "9819de41-1beb-3c4a-9e98-46d3a7cf8230",
                        "entry_id": "a601ae5e-a856-3596-9fd7-959583544166",
                        "glosses": [
                            "опт. оптический прибор с одним окуляром для рассматривания удалённых предметов одним глазом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "328b10c5-677b-4085-85a5-a3380d2cd378",
                                "sense_id": "9819de41-1beb-3c4a-9e98-46d3a7cf8230",
                                "text": "Кроме биноклей распространены зрительные трубы и монокуляры"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd721515-fb56-4fa5-8494-a43f674811de",
                        "source_entry_id": "a601ae5e-a856-3596-9fd7-959583544166",
                        "source_sense_id": "9819de41-1beb-3c4a-9e98-46d3a7cf8230",
                        "target_lang_word": "monocular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monocular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15cbeab1-9279-332c-9e02-b95dfa65228e",
                                        "entry_id": "7e1855fa-b217-35a6-af9c-751f0f6a99cd",
                                        "glosses": [
                                            "Having one eye."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7501404-20b8-49c4-86f6-a043664b579b",
                                                "sense_id": "15cbeab1-9279-332c-9e02-b95dfa65228e",
                                                "text": "...one of his sparks alighted upon my eye and destroyed it making me a monocular ape;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cebf07cc-c438-3029-9b01-0ff1bd328520",
                                        "entry_id": "7e1855fa-b217-35a6-af9c-751f0f6a99cd",
                                        "glosses": [
                                            "Related to a monocle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57b3dbc7-8548-4b69-8531-9275aa5280b4",
                                                "sense_id": "cebf07cc-c438-3029-9b01-0ff1bd328520",
                                                "text": "You are not such a foolish woman as to like to be seen with Fred Mostyn, that little monocular snob, after the aristocratic, handsome Basil Stanhope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1459ee73-787d-3f2d-964b-e524490fd952",
                                        "entry_id": "7e1855fa-b217-35a6-af9c-751f0f6a99cd",
                                        "glosses": [
                                            "Of any optical system suitable for use by one eye at a time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "monocular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30b032db-9387-36ce-ab23-423b8af387a0",
                                        "entry_id": "a3bbe776-3b9a-3085-b93c-046002bc085e",
                                        "glosses": [
                                            "A monocle."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d1be02-e1a5-42dc-8468-ce0d979d28e9",
                                                "sense_id": "30b032db-9387-36ce-ab23-423b8af387a0",
                                                "text": "The moony monocular set in his eye / Appeared to be scanning the Sweet Bye-and-Bye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fcb164-6165-3190-8a33-f208b8ea3927",
                                        "entry_id": "a3bbe776-3b9a-3085-b93c-046002bc085e",
                                        "glosses": [
                                            "A monocular telescope, as opposed to binoculars."
                                        ],
                                        "tags": [
                                            "retronym"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50533296-eb96-4c24-9f97-10b949e45e1c",
                                                "sense_id": "e6fcb164-6165-3190-8a33-f208b8ea3927",
                                                "text": "Monoculars are designed to fit discreetly in the hand, improving their cosmetic appearance. Most monoculars sold today have one primary optical difference from binoculars: the ability to focus at close range. These are known as short-focus telescopes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "508e2f1e-d667-44e4-a466-f0f56aabc447",
                        "source_entry_id": "a601ae5e-a856-3596-9fd7-959583544166",
                        "source_sense_id": "9819de41-1beb-3c4a-9e98-46d3a7cf8230",
                        "target_lang_word": "monoculaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monoculaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b9f4e61-3058-3a33-807e-590ac29fb7af",
                                        "entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
                                        "glosses": [
                                            "Qui n’a qu’un œil, d’un seul œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e830e7e-d42a-4e44-8952-5ea7d0eb8b5e",
                                                "sense_id": "1b9f4e61-3058-3a33-807e-590ac29fb7af",
                                                "text": "M. Dufour communique l’observation d’un cas remarquable de triplopie monoculaire, qu’il eut l’occasion d’analyser et de traiter dans la clinique du professeur de Græfe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                                        "entry_id": "5f6cd5c5-e696-3ed8-8c9c-cabffaad3c5c",
                                        "glosses": [
                                            "Qui ne concerne qu’un œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b8e560-a6d3-4b26-abb0-a45ef812af02",
                                                "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                                                "text": "L’écart des chiffres pour les deux sexes est beaucoup moins considérable dans la cécité binoculaire que dans la cécité monoculaire."
                                            },
                                            {
                                                "example_id": "83dc154e-e5e9-457a-bfd9-a3ebb777eb38",
                                                "sense_id": "8d4cc680-dd88-3a23-87c2-0406c7f8b370",
                                                "text": "L’acuité visuelle est plus élevée en vision binoculaire qu’en vision monoculaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
