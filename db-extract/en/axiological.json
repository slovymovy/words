                "senses": [
                    {
                        "sense_id": "56880072-a4b7-324e-96f5-1cc8f3ccf9db",
                        "entry_id": "12e74872-4b48-3ef3-8e4d-3fc1b1e5945d",
                        "glosses": [
                            "Of or relating to value theory, the philosophical field of axiology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f1fd3e30-79d6-4227-9021-a1649b8b090d",
                                "sense_id": "56880072-a4b7-324e-96f5-1cc8f3ccf9db",
                                "text": "Students of psychology and epistemology are familiar with the axiological literature of the last forty years, and are here reminded of the great diversity of opinions on this topic."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad03d410-3a7a-381c-8bbf-a240c3b84d1f",
                        "entry_id": "12e74872-4b48-3ef3-8e4d-3fc1b1e5945d",
                        "glosses": [
                            "Of or relating to values themselves."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6c2a563c-44d3-49dc-8251-a07f40e74b6f",
                                "sense_id": "ad03d410-3a7a-381c-8bbf-a240c3b84d1f",
                                "text": "It might now be thought that the object of this judgment is the validity of value or an axiological validity (as distinct from a theoretical validity)."
                            }
                        ]
                    }
                ],
