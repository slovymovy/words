{
    "word_family": [
        "плыть",
        "плывун",
        "плавание",
        "пловец",
        "плавник",
        "плавучий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69c81f5d-eea3-3cb5-8e18-4b1af8c5ecbf",
                    "sense_definition": "Переместиться в пространстве, двигаясь в воде, удаляясь от исходной точки.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дельфин испугался шума и <w>уплыл</w> далеко в море.",
                            "target_lang_translations": {
                                "en": "The dolphin was frightened by the noise and <w>swam away</w> far into the sea."
                            }
                        },
                        {
                            "text": "Рыба <w>уплыла</w> на глубину, когда увидела человека.",
                            "target_lang_translations": {
                                "en": "The fish <w>swam away</w> to the depths when it saw the person."
                            }
                        }
                    ],
                    "synonyms": [
                        "отплыть"
                    ],
                    "antonyms": [
                        "подплыть",
                        "приплыть"
                    ],
                    "common_phrases": [
                        "уплыть в море"
                    ],
                    "target_lang_definitions": {
                        "en": "To move through water, away from a starting point."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swim away",
                                "target_lang_sense_clarification": "To move away from a location by swimming."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76bfae52-c2ed-30de-90ef-95766df19f68",
                    "sense_definition": "Отправиться в поездку или путешествие, используя водный транспорт.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отсюда можно <w>уплыть</w> в соседний город на катере.",
                            "target_lang_translations": {
                                "en": "From here, you can <w>sail away</w> to the neighboring city by boat."
                            }
                        },
                        {
                            "text": "Туристы <w>уплыли</w> на большом корабле в круиз.",
                            "target_lang_translations": {
                                "en": "The tourists <w>sailed away</w> on a large ship for a cruise."
                            }
                        }
                    ],
                    "synonyms": [
                        "отплыть"
                    ],
                    "antonyms": [
                        "приплыть"
                    ],
                    "common_phrases": [
                        "уплыть на катере"
                    ],
                    "target_lang_definitions": {
                        "en": "To depart on a journey or trip using water transport."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sail away",
                                "target_lang_sense_clarification": "To depart by boat or ship."
                            },
                            {
                                "target_lang_word": "steam away",
                                "target_lang_sense_clarification": "To depart by a steam-powered vessel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bf654a9-e8d4-359d-9eb6-b501bc933e6a",
                    "sense_definition": "Передвигаться плавно, неспешно, с достоинством или грацией.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она гордо <w>уплыла</w> из комнаты, не сказав ни слова.",
                            "target_lang_translations": {
                                "en": "She proudly <w>glided away</w> from the room without saying a word."
                            }
                        },
                        {
                            "text": "Актриса <w>уплыла</w> за кулисы после завершения выступления.",
                            "target_lang_translations": {
                                "en": "The actress <w>glided away</w> behind the scenes after finishing her performance."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To move in a smooth, unhurried, and graceful manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "glide away",
                                "target_lang_sense_clarification": "To move smoothly and continuously."
                            },
                            {
                                "target_lang_word": "float away",
                                "target_lang_sense_clarification": "To move in a light, effortless, or detached manner."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0a8839e-4d64-3198-968e-b52a1785d06e",
                    "sense_definition": "Исчезнуть, стать недоступным или быть утраченным, часто из-за небрежности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все мои сбережения <w>уплыли</w> из-за неудачной покупки.",
                            "target_lang_translations": {
                                "en": "All my savings <w>slipped away</w> because of a bad purchase."
                            }
                        },
                        {
                            "text": "Деньги <w>уплыли</w> неизвестно куда, и теперь не на что жить.",
                            "target_lang_translations": {
                                "en": "The money <w>melted away</w> to who knows where, and now there is nothing to live on."
                            }
                        }
                    ],
                    "common_phrases": [
                        "деньги уплыли"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear, become unavailable, or be lost, often due to negligence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slip away",
                                "target_lang_sense_clarification": "To be lost or disappear gradually."
                            },
                            {
                                "target_lang_word": "melt away",
                                "target_lang_sense_clarification": "To disappear or dwindle, often used for money or resources."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e1735e0-8524-3415-9419-5fedf9cab30d",
                    "sense_definition": "Перейти в чужие руки или под чужой контроль, часто из-за ошибки или недосмотра.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "loss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ценные документы <w>уплыли</w> к конкурентам из-за нашей ошибки.",
                            "target_lang_translations": {
                                "en": "Valuable documents <w>slipped away</w> to our competitors because of our mistake."
                            }
                        },
                        {
                            "text": "Прибыльный контракт <w>уплыл</w> в другие руки.",
                            "target_lang_translations": {
                                "en": "The profitable contract <w>slipped away</w> into other hands."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уплыть в другие руки"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в деловом или разговорном контексте"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To pass into someone else's hands or control, often due to an error or oversight."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slip through one's fingers",
                                "target_lang_sense_clarification": "To lose an opportunity or possession due to lack of control."
                            },
                            {
                                "target_lang_word": "be lost to",
                                "target_lang_sense_clarification": "To no longer be in one's possession or control."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}