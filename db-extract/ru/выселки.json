                                            {
                                                "example_id": "99353b7f-dee7-4ca4-9295-75a583007fc9",
                                                "sense_id": "7bc3c073-b45e-32af-99a3-a3c45d0b20e9",
                                                "text": "Such anthropophilous behaviour makes it a good candidate for a commensal relationship with humans at the Neolithic settlements of Quanhucun, Wuzhuangguoliang and Xiawanggang, as well as other Middle and Late Neolithic settlements in China […]"
                                            }
