                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be34c949-e941-48cc-8ae6-36b9fb6ff077",
                                "sense_id": "18cb3934-24b2-3816-9bed-6fec5e97a145",
                                "text": "Na początku tygodnia z sentymentem odnotowałem, że stara animacja poklatkowa ze studia Se-ma-for, będzie kontynuowana w nowoczesnej formie animacji 3D."
                            }
                        ],
