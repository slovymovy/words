                                                "sense_id": "7d3cf2f0-469a-3383-b2af-728391ce75a0",
                                                "text": "Click the button that looks like a house to return to your browser's home page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89dff730-cf91-3dc0-aa03-037a1b0ec423",
                                        "entry_id": "45ea75df-b244-34db-af6c-41d79d5baefc",
                                        "glosses": [
                                            "A badge worn on clothes, fixed with a pin through the fabric."
                                        ],
