                        "entry_id": "bffeccad-0cfe-37b6-969a-f8b0ed9efd95",
                        "glosses": [
                            "Salat aus Weißkohl oder seltener Rotkohl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a147791-8b5d-493f-83b1-004179e0ff9b",
                                "sense_id": "ad41981e-c29e-3c7e-9114-2aea7fa91e3c",
                                "text": "Bis auf einen kleinen Rest Krautsalat war das Salatbuffet leer."
                            },
                            {
                                "example_id": "e7cdb226-07e1-4e2b-85fc-f1b565f9a8a4",
                                "sense_id": "ad41981e-c29e-3c7e-9114-2aea7fa91e3c",
                                "text": "„Herzhaft komischen Geschmack besitzt der Krautsalat, den sich die Deutschen von Yorkville im Lauf ihrer Anpassung angerichtet haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
