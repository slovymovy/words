                ],
                "senses": [
                    {
                        "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                        "entry_id": "76bafafd-502e-3df7-8274-397704a53486",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32de0a19-b9be-4948-9203-76bc95761ce2",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Frau Rößler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7db6a876-2e28-421e-8b30-e24c5337cffa",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Herr Rößler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "06ae8e93-baaf-4c69-b093-779a67bb0fe3",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Die Rößlers fliegen heute nach Paris."
                            },
                            {
                                "example_id": "06518523-c373-4c02-8dff-48e6392d9782",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Der Rößler trägt nie die Pullover, die die Rößler ihm strickt."
                            },
                            {
                                "example_id": "a53b96f1-8ea5-4f62-be38-0454532310c2",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rößler kommt, geht der Herr Rößler.“"
                            },
                            {
                                "example_id": "c17f66ff-2df0-48fe-9824-0077595d9e7b",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Rößler kommt und geht."
                            },
                            {
                                "example_id": "ee3784b8-6b31-4825-954c-ae4f584aeb8b",
                                "sense_id": "0131f9f3-945a-3c53-bc89-cffd1119e1eb",
                                "text": "Rößlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
