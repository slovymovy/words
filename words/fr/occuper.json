{
    "word_family": [
        "occupant",
        "occupation",
        "inoccupé",
        "préoccuper",
        "préoccupation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39c4ac37-4838-34e9-b34e-31ae34780cb6",
                    "sense_definition": "Prendre soin de quelqu'un ou se charger d'une tâche, d'un problème ou d'une affaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "soin_responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour les enfants, je m'<w>occupe</w> de préparer leur dîner."
                        },
                        {
                            "text": "Cette assistante efficace s'<w>occupe</w> des réservations d'hôtel pour toute l'équipe."
                        }
                    ],
                    "common_phrases": [
                        "s'occuper de tout",
                        "s'occuper de ses affaires",
                        "s'occuper de quelqu'un"
                    ]
                },
                {
                    "sense_id": "a0e2bbd3-df6f-3018-b55b-49f4379a8cd7",
                    "sense_definition": "Détenir ou exercer une fonction, un emploi ou une charge.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "statut_fonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>occupe</w> un poste de directrice financière au sein de cette grande entreprise."
                        },
                        {
                            "text": "Depuis plusieurs années, mon collègue <w>occupe</w> une fonction importante dans le syndicat."
                        }
                    ],
                    "common_phrases": [
                        "occuper un poste",
                        "occuper une fonction",
                        "occuper un emploi"
                    ]
                },
                {
                    "sense_id": "0f0febfb-222c-3cd1-9af6-79d300ef33f8",
                    "sense_definition": "Habiter un lieu ou y résider.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils <w>occupent</w> cet appartement lumineux depuis plus de dix ans."
                        },
                        {
                            "text": "Le locataire qui <w>occupait</w> cette maison a déménagé le mois dernier."
                        }
                    ],
                    "synonyms": [
                        "habiter"
                    ],
                    "common_phrases": [
                        "occuper un logement",
                        "occuper les lieux",
                        "occuper un appartement"
                    ]
                },
                {
                    "sense_id": "f70d3ab7-e7db-3f79-9488-4739361b0424",
                    "sense_definition": "Remplir un espace, une place ou une durée de temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette grande armoire en bois massif <w>occupe</w> tout le fond de la chambre."
                        },
                        {
                            "text": "La réunion imprévue a <w>occupé</w> la plus grande partie de mon après-midi."
                        }
                    ],
                    "common_phrases": [
                        "occuper de la place",
                        "occuper tout l'espace",
                        "occuper le terrain"
                    ]
                },
                {
                    "sense_id": "17aa8aff-cb3a-395c-b278-7e21c155d964",
                    "sense_definition": "Donner du travail, une activité ou un divertissement à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soin_responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents cherchent des jeux créatifs pour <w>occuper</w> les enfants pendant la pluie."
                        },
                        {
                            "text": "Ce travail manuel l'<w>occupe</w> agréablement durant les longues soirées d'hiver."
                        }
                    ],
                    "synonyms": [
                        "employer"
                    ],
                    "common_phrases": [
                        "occuper ses loisirs",
                        "occuper son temps",
                        "occuper les enfants"
                    ]
                },
                {
                    "sense_id": "0df33fa9-e6a3-3fbb-907c-f17e556c04aa",
                    "sense_definition": "Prendre possession d'un territoire, d'une ville ou d'un domaine, notamment par la force ou l'autorité militaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu_espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée ennemie a tenté d'<w>occuper</w> la capitale durant les premières semaines du conflit."
                        },
                        {
                            "text": "Les manifestants en colère ont décidé d'<w>occuper</w> pacifiquement l'usine désaffectée."
                        }
                    ],
                    "synonyms": [
                        "prendre"
                    ],
                    "common_phrases": [
                        "occuper un territoire",
                        "occuper une ville",
                        "occuper le pays"
                    ]
                },
                {
                    "sense_id": "7e264564-2f94-3056-8753-1ab460749e2a",
                    "sense_definition": "Pour un officier de justice ou un avocat, représenter une partie et soutenir ses intérêts dans un procès.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "statut_fonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a formellement déclaré devant la cour qu'il <w>occupait</w> pour la partie civile."
                        },
                        {
                            "text": "L'avoué était tenu d'<w>occuper</w> pour sa partie jusqu'au terme de la procédure."
                        }
                    ],
                    "common_phrases": [
                        "occuper pour une partie"
                    ]
                }
            ]
        }
    ]
}