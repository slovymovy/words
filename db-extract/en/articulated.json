                "senses": [
                    {
                        "sense_id": "17771498-9840-3713-b897-461bbdd485c0",
                        "entry_id": "ba0090ba-43cd-38a8-a575-f606556aed55",
                        "glosses": [
                            "Constructed with one or more pivoted joints which allow bending of an otherwise rigid structure."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a55c9618-cabf-36e6-99da-8cdcb03dec67",
                        "entry_id": "ba0090ba-43cd-38a8-a575-f606556aed55",
                        "glosses": [
                            "Of a vehicle, composed of component parts each with its own wheels and chassis, e.g. an articulated lorry, articulated bus, or certain kinds of streetcars and trains."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eaedb020-9d43-4807-b5fb-74fbdc264b82",
                                "sense_id": "a55c9618-cabf-36e6-99da-8cdcb03dec67",
                                "text": "The trains are a fixed formation of four articulated vehicles, and are fitted with large vestibules, wide aisles, open gangways and air-conditioning."
                            }
                        ]
                    },
