                ],
                "senses": [
                    {
                        "sense_id": "675b97f0-44ec-3311-a6fa-f0874867d47b",
                        "entry_id": "4bcf7487-46a3-3f50-a988-076fb48d6bbb",
                        "glosses": [
                            "kliniek waar verslaafden geholpen worden om van hun verslaving af te komen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72755d42-7b67-489e-bbac-d8a4ecdec905",
                                "sense_id": "675b97f0-44ec-3311-a6fa-f0874867d47b",
                                "text": "De bazen van de show moesten er lang over discussiëren, weet The Sun. Ant McPartlin raakte in opspraak toen hij vorig weekend gearresteerd werd voor het rijden met drank op en een ongeluk veroorzaakte. Inmiddels zit hij in een afkickkliniek."
                            },
                            {
                                "example_id": "9585fd9b-f9b6-4a9a-8ab3-aeb71d74d18b",
                                "sense_id": "675b97f0-44ec-3311-a6fa-f0874867d47b",
                                "text": "„Ik zat in die afkickkliniek en toen verveelde ik m’n eigen. Ik denk: ik ga een filmpje maken”, aldus Barbie in een video op het YouTube-kanaal Haagse Gekkigheid. Op de reactie van presentator Peter dat hij het filmpje ook heeft gezien, antwoordt de realityster enigszins geïrriteerd: „Ja, wie niet?” Volgens Barbie kreeg ze veel complimenten op de video."
                            },
                            {
                                "example_id": "53ca9bef-a491-45e9-9d58-7708f43f2523",
                                "sense_id": "675b97f0-44ec-3311-a6fa-f0874867d47b",
                                "text": "In de Leidsestraat streek vorige week een tijdelijke afkickliniek neer om mensen te wijzen op het gevaar van suiker. Want dat eten we, onbewust, veel te veel."
                            },
                            {
                                "example_id": "7b9a3891-7de4-41cf-b3b8-47a6e1828d30",
                                "sense_id": "675b97f0-44ec-3311-a6fa-f0874867d47b",
                                "text": "Bakker werd vooral bekend van zijn tv-optredens in Van etter tot engel (2006) en Family Matters (2008 en 2009), waarin hij jongeren met hun problemen hielp. Ook was hij jarenlang te zien in Spuiten en Slikken. In 2004 opende Bakker de afkickkliniek Smith & Jones, waar hij in 2010 als directeur vertrok. In 2011 werd het faillissement van zijn holding Mountain Top uitgesproken."
                            }
                        ]
                    }
