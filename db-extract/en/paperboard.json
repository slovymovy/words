                    {
                        "translation_id": "530be758-e690-414e-9454-112f289d14cb",
                        "source_entry_id": "a453888b-2b19-3d01-ba8f-5724a31b0ab8",
                        "source_sense_id": "bc2b30e6-41d7-3804-87a9-a5ffcc97f221",
                        "source_sense_description": "thick paper",
                        "target_lang_word": "bristol",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bristol",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b304416e-515a-3cb1-a3d8-c87c62bdaa30",
                                        "entry_id": "5c6ed5bb-b76b-344c-a214-b62e9857ea72",
                                        "glosses": [
                                            "Sorte de papier assez fort, fabriqué à l'origine par la superposition de papiers plus fins, employé pour le dessin, les cartes de visite ou les cartons d’invitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1460cc47-891f-4588-8a3d-e642a9fe9973",
                                                "sense_id": "b304416e-515a-3cb1-a3d8-c87c62bdaa30",
                                                "text": "Il avait épuisé ses fiches bristol, écarté deux ou trois hypothèses de travail, avait avalé cinq expresso et raté le dernier service de la cantine."
                                            },
                                            {
                                                "example_id": "f2faabbb-b6ec-48d4-b736-81829854d477",
                                                "sense_id": "b304416e-515a-3cb1-a3d8-c87c62bdaa30",
                                                "text": "À l'origine le bristol était fabriqué avec une superposition de feuilles de papier collées ensemble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b8179fd-30d5-382d-aa8a-86691a49bd6e",
                                        "entry_id": "5c6ed5bb-b76b-344c-a214-b62e9857ea72",
                                        "glosses": [
                                            "Une fiche quelconque de ce matériau, telle qu’une carte de visite ou un carton d’invitation."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47501fd9-5b9a-37c4-b18f-0c18dde60d76",
                                        "entry_id": "5c6ed5bb-b76b-344c-a214-b62e9857ea72",
                                        "glosses": [
                                            "Invitation imprimée sur du papier luxueux."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c0ca9c0-fc66-4169-8f22-09b78f99f24f",
                                                "sense_id": "47501fd9-5b9a-37c4-b18f-0c18dde60d76",
                                                "text": "Un bristol qu’ils firent distribuer le soir de la dernière journée annonçait une deuxième vente consacrée en majorité à des œuvres anciennes d’origine européenne […]"
                                            },
                                            {
                                                "example_id": "06aca278-922a-487f-b4d8-3ea2fb869a8b",
                                                "sense_id": "47501fd9-5b9a-37c4-b18f-0c18dde60d76",
                                                "text": "D’entre deux coupures il tira un bristol sur lequel était imprimé : « Monsieur et Madame Labroquère vous prient d’honorer de votre présence la soirée qu’ils… »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00621bfb-ef5b-442f-8e1f-10088b0e540c",
                        "source_entry_id": "a453888b-2b19-3d01-ba8f-5724a31b0ab8",
                        "source_sense_id": "bc2b30e6-41d7-3804-87a9-a5ffcc97f221",
