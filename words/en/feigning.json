            "senses": [
                {
                    "sense_id": "ac155787-6948-32e3-88e5-661af70ac233",
                    "sense_definition": "present participle and gerund of <w>feign</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>feigning</w> illness so she wouldn't have to go to school.",
                            "target_lang_translations": {
                                "de": "Sie <w>täuschte</w> eine Krankheit <w>vor</w>, um nicht zur Schule gehen zu müssen."
                            }
                        },
                        {
                            "text": "He was accused of <w>feigning</w> interest in the project just to get the promotion.",
                            "target_lang_translations": {
                                "de": "Man warf ihm vor, Interesse an dem Projekt nur <w>vorzutäuschen</w>, um die Beförderung zu bekommen."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretending",
                        "faking",
                        "simulating"
                    ],
                    "common_phrases": [
                        "feigning illness",
                        "feigning interest",
                        "feigning sleep"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund form"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von 'feign'; das Vortäuschen oder Simulieren von Gefühlen, Zuständen oder Absichten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "vortäuschend",
                                "target_lang_sense_clarification": "als Partizip: etwas vorgebend"
                            },
                            {
                                "target_lang_word": "simulierend",
                                "target_lang_sense_clarification": "als Partizip: eine Krankheit oder einen Zustand vortäuschend"
                            },
                            {
                                "target_lang_word": "Vortäuschen",
                                "target_lang_sense_clarification": "als Gerundium: das bewusste Vorgeben einer Sache"
                            }
