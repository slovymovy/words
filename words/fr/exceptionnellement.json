            "senses": [
                {
                    "sense_id": "9f32236f-2df0-3171-9918-5dfece967ba1",
                    "sense_definition": "À titre d'exception, par dérogation à la règle ou à l'habitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée sera <w>exceptionnellement</w> fermé au public ce lundi pour des travaux de rénovation."
                        },
                        {
                            "text": "Les enfants ont <w>exceptionnellement</w> l'autorisation de regarder un film avant d'aller se coucher."
                        }
                    ],
                    "antonyms": [
                        "habituellement",
                        "normalement"
                    ],
                    "common_phrases": [
                        "fermé exceptionnellement",
                        "ouvert exceptionnellement"
