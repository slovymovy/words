                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79107653-432b-4e7d-939e-fa0622461629",
                                "sense_id": "3a53c8d7-4a6f-3919-898d-bef58ea49b03",
                                "text": "In diesen Bereich des Stadions kommt man nur mit einem VIP-Ticket."
                            },
                            {
                                "example_id": "7d84c0f5-0e81-466e-bf84-e0f6b5686b14",
                                "sense_id": "3a53c8d7-4a6f-3919-898d-bef58ea49b03",
                                "text": "„Die 54.000 Zuschauer fassende Arena in Düsseldorf ist trotz stolzer Eintrittspreise – ein VIP-Ticket inklusive Aftershowparty kostet bis zu 692 Euro – seit Tagen bis auf wenige Restkarten ausverkauft.“"
                            },
                            {
                                "example_id": "9efa74d2-ce7e-4596-88e6-2e991a0fbb78",
                                "sense_id": "3a53c8d7-4a6f-3919-898d-bef58ea49b03",
                                "text": "„Das VIP-Ticket für Seehofer habe die Uefa zur Verfügung gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
