                        "zh": [
                            {
                                "target_lang_word": "第二个",
                                "target_lang_sense_clarification": "同类的另一个实例"
                            },
                            {
                                "target_lang_word": "另外",
                                "target_lang_sense_clarification": "额外的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1159e396-157c-3269-9f83-1d852217d040",
                    "sense_definition": "Не главный, уступающий по значению, важности или качеству; побочный.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rank_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Актёр устал быть вечно на <вторых> ролях и мечтал о славе.",
                            "target_lang_translations": {
                                "en": "The actor was tired of always being in <secondary> roles and dreamed of fame.",
                                "zh": "演员厌倦了永远担任<w>次要</w>角色，梦想着成名。"
                            }
