{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "10b92593-25e8-3114-a774-7f0445e17f96",
                    "sense_definition": "Из какого места или с какого места.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Откуда</w> ты идёшь так поздно?",
                            "target_lang_translations": {
                                "en": "<w>Where</w> are you coming from so late?"
                            }
                        },
                        {
                            "text": "Я не знаю, <w>откуда</w> приехал этот человек.",
                            "target_lang_translations": {
                                "en": "I don't know <w>where</w> this person came <w>from</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "куда"
                    ],
                    "common_phrases": [
                        "откуда взялся",
                        "откуда вы"
                    ],
                    "target_lang_definitions": {
                        "en": "From what place or location."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "where from",
                                "target_lang_sense_clarification": "The most common and natural way to ask about the origin of movement or location."
                            },
                            {
                                "target_lang_word": "whence",
                                "target_lang_sense_clarification": "A formal or literary term meaning 'from where'."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ab5bb7d-f343-3e9b-8476-ced16b6e7c80",
                    "sense_definition": "Из какого источника, от кого или по какой причине.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Откуда</w> ты знаешь мой номер телефона?",
                            "target_lang_translations": {
                                "en": "<w>How</w> do you know my phone number?"
                            }
                        },
                        {
                            "text": "<w>Откуда</w> у тебя столько денег?",
                            "target_lang_translations": {
                                "en": "<w>Where</w> did you get so much money?"
                            }
                        }
                    ],
                    "synonyms": [
                        "почему"
                    ],
                    "common_phrases": [
                        "откуда мне знать",
                        "откуда ты знаешь"
                    ],
                    "target_lang_definitions": {
                        "en": "From what source, from whom, or for what reason."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "where ... from",
                                "target_lang_sense_clarification": "Used to inquire about the origin of an idea, object, or information."
                            },
                            {
                                "target_lang_word": "how",
                                "target_lang_sense_clarification": "Often used in English to ask about the source or reason for something (e.g., 'How do you know?')."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87f99df0-d05a-341e-a6dc-565debef8ddd",
                    "sense_definition": "Союзное слово, присоединяющее придаточные предложения места, изъяснительные и определительные.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjunction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы вернулись в город, <w>откуда</w> начали наше путешествие.",
                            "target_lang_translations": {
                                "en": "We returned to the city <w>from which</w> we had set out on our journey."
                            }
                        },
                        {
                            "text": "Это место, <w>откуда</w> открывается прекрасный вид на город.",
                            "target_lang_translations": {
                                "en": "This is the place <w>from where</w> a beautiful view of the city opens up."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A relative pronoun or conjunction used to introduce clauses of place or descriptive clauses."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "from where",
                                "target_lang_sense_clarification": "Used to connect a place to an action originating from it."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f90395c-f05c-35b7-b1ca-f9b0d2957edc",
                    "sense_definition": "Выражение удивления или несогласия с чем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Говорят, ты выиграл в лотерею? — Да <w>откуда</w>! Я даже билетов не покупаю.",
                            "target_lang_translations": {
                                "en": "“They say you won the lottery?” “<w>How could</w> I have? I don't even buy tickets.”"
                            }
                        },
                        {
                            "text": "― Ты купил машину? ― <w>Откуда</w> у меня такие деньги?",
                            "target_lang_translations": {
                                "en": "― Did you buy a car? ― <w>Where</w> would I get that kind of money?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "просторечное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An expression of surprise, disbelief, or disagreement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how could",
                                "target_lang_sense_clarification": "Used to express that something is impossible or unlikely."
                            },
                            {
                                "target_lang_word": "where would ... get",
                                "target_lang_sense_clarification": "Used to rhetorically question the source of something (like money or items) to show disbelief."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}