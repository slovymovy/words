                            {
                                "target_lang_word": "deprimovat",
                                "target_lang_sense_clarification": "způsobovat někomu smutek nebo sklíčenost"
                            },
                            {
                                "target_lang_word": "skličovat",
                                "target_lang_sense_clarification": "vyvolávat pocity beznaděje nebo smutku"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "üzmek",
                                "target_lang_sense_clarification": "Birinin moralini bozmak veya kederlendirmek"
                            },
                            {
                                "target_lang_word": "karamsarlığa sürüklemek",
                                "target_lang_sense_clarification": "Birini umutsuz veya mutsuz bir ruh haline sokmak"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deprimir",
                                "target_lang_sense_clarification": "Causar tristeza o desánimo en alguien."
                            },
                            {
                                "target_lang_word": "entristecer",
                                "target_lang_sense_clarification": "Hacer que alguien se sienta triste."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使沮丧",
                                "target_lang_sense_clarification": "指使人情绪低落或感到消沉"
                            },
                            {
                                "target_lang_word": "使忧郁",
                                "target_lang_sense_clarification": "指使人感到忧伤或郁闷"
                            }
                        ]
