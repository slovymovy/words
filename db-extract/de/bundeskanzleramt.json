                ],
                "senses": [
                    {
                        "sense_id": "780d9fc5-445a-3612-a409-6a5cd668fbab",
                        "entry_id": "49bcd201-ea6d-3da7-96a2-8d424481d4a3",
                        "glosses": [
                            "Amtssitz des Bundeskanzlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fefc3c9-b242-406d-945e-f8c475f23549",
                                "sense_id": "780d9fc5-445a-3612-a409-6a5cd668fbab",
                                "text": "Das Bundeskanzleramt ist der Amtssitz des österreichischen Bundeskanzlers."
                            },
                            {
                                "example_id": "ab2d6010-bdbf-4d02-9856-0922b61901e1",
                                "sense_id": "780d9fc5-445a-3612-a409-6a5cd668fbab",
                                "text": "„Sofort wurde das Bundeskanzleramt in Bonn informiert, Spitzen der Sicherheitsdienste wurden umgehend einberufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "06ee9586-51de-30fe-9378-112cb8d55e33",
                        "entry_id": "49bcd201-ea6d-3da7-96a2-8d424481d4a3",
                        "glosses": [
                            "eine Behörde, die den Bundeskanzler bei seinen Aufgaben unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fdfb958-4ee6-4bc6-90b1-1e1361e341ff",
                                "sense_id": "06ee9586-51de-30fe-9378-112cb8d55e33",
                                "text": "Der frühere Staatsminister des Bundeskanzleramtes muss sich harsche Kritik gefallen lassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "864b25b9-5753-3f80-9f03-4e516177a7d8",
                        "entry_id": "49bcd201-ea6d-3da7-96a2-8d424481d4a3",
                        "glosses": [
                            "das Gebäude, in welchem sich die Behörde von [2] befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd53eec8-e82b-475e-9ba0-3657a90082b6",
                                "sense_id": "864b25b9-5753-3f80-9f03-4e516177a7d8",
                                "text": "Das Bundeskanzleramt steht im Herzen Berlins."
                            },
                            {
                                "example_id": "8c4f28e5-1302-4df4-9723-15a68062a52e",
                                "sense_id": "864b25b9-5753-3f80-9f03-4e516177a7d8",
                                "text": "„Als Publikumsmagnet erwies sich erneut das Bundeskanzleramt, und die längste Warteschlange bildete sich regelmäßig vor dem Helikopter der Regierungschefin.“"
                            },
                            {
                                "example_id": "4d19519d-c845-4f45-a365-379065dc0b0b",
                                "sense_id": "864b25b9-5753-3f80-9f03-4e516177a7d8",
                                "text": "„Im Bundeskanzleramt ging es entspannter zu.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
