                    "sense_id": "fd466f6b-9ffa-31e1-8501-f204a739103a",
                    "sense_definition": "Fermer à l'aide d'un verrou ou d'une serrure afin d'en interdire l'ouverture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fermeture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>verrouiller</w> la porte d'entrée avant d'aller te coucher ce soir."
                        },
                        {
                            "text": "Il appuie sur le bouton de sa clé pour <w>verrouiller</w> son véhicule garé dans la rue."
                        }
                    ],
                    "synonyms": [
                        "fermer à clé",
                        "boucler"
                    ],
                    "antonyms": [
                        "déverrouiller",
                        "ouvrir"
                    ],
                    "common_phrases": [
