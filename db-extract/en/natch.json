                                                "sense_id": "1f280414-fc84-3a48-b4c9-464c98adff20",
                                                "text": "Na stráni za domem rostl jasan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jasan",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "dec50634-9860-3f09-9ca1-de8ef3793139",
                                        "entry_id": "ff8cf537-cf50-31ec-a7de-ca2954d7dca6",
                                        "glosses": [
