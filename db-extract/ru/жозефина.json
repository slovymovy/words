                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b546c0cf-1120-401c-84d9-9ff8e9deaec4",
                                                "sense_id": "9573ddb0-2ff6-3f16-b852-6d8ea5fc338b",
                                                "text": "Wojciech i Józefa zawarli małżeństwo dnia 3. czerwca 1838 r. w parafii Brwinów pod Warszawą, gdzie mieszkali rodzice panny młodej"
                                            }
