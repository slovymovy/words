                ],
                "senses": [
                    {
                        "sense_id": "4f86eee9-1771-3d3b-999c-28e84b6cef4d",
                        "entry_id": "b930bc70-e2a6-38dc-ae26-569f2becacd1",
                        "glosses": [
                            "Gestaltung der Freizeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ef36e6e-6914-4d45-b13c-cb958b482da6",
                                "sense_id": "4f86eee9-1771-3d3b-999c-28e84b6cef4d",
                                "text": "„In den 1950er Jahren war die Familie Dreh- und Angelpunkt der Freizeitgestaltung, heute steht (neben den Urlaubsreisen) der Medienkonsum im Mittelpunkt.“"
                            },
                            {
                                "example_id": "78ed96c2-f023-4ef1-b3ac-7b0230e5cca5",
                                "sense_id": "4f86eee9-1771-3d3b-999c-28e84b6cef4d",
                                "text": "„Heute wird die Freizeitgestaltung zunehmend als Ausdruck von Individualität betrachtet.“"
                            },
                            {
                                "example_id": "83216d3d-d9eb-40af-b989-3c033ebad17e",
                                "sense_id": "4f86eee9-1771-3d3b-999c-28e84b6cef4d",
                                "text": "„Kinder aus sozial besser gestellten Familien haben offensichtlich bessere Möglichkeiten der Freizeitgestaltung und betätigen sich daher auch häufiger körperlich.“"
                            },
                            {
                                "example_id": "598416b8-c43e-4d6f-9593-6726874f9aa5",
                                "sense_id": "4f86eee9-1771-3d3b-999c-28e84b6cef4d",
                                "text": "„So reizvoll uns Kraftfahrern diese neue Möglichkeit winterlicher Freizeitgestaltung auch erscheint, lässt sie uns doch besorgt auf das Frühjahr blicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
