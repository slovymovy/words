                                        "sense_id": "31f3901e-613c-3ee7-a02c-4f3239a6a2ee",
                                        "entry_id": "0d21ae57-bb4a-33e7-ad4d-a7c4a950734b",
                                        "glosses": [
                                            "Something with the apparent solidity, opacity, or dimensions of a building wall."
