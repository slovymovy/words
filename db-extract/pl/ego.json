                    {
                        "sense_id": "6ab3f95f-c252-3ddf-acf0-6fff4d1e6c0c",
                        "entry_id": "8b6f5382-960f-3c58-a415-5f4c7c265d81",
                        "glosses": [
                            "świadoma część osobowości"
                        ],
