                "senses": [
                    {
                        "sense_id": "efb5e13f-b514-3e65-a1ce-fc58a0aa7454",
                        "entry_id": "d137984d-6cfb-3a0b-85ee-30b9b6438979",
                        "glosses": [
                            "approbierter Arzt ohne leitende Funktion, meist in der Weiterbildung zum Facharzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1027c01-0969-4537-b349-7b395aee5b91",
                                "sense_id": "efb5e13f-b514-3e65-a1ce-fc58a0aa7454",
                                "text": "Die Operation des Assistenzarztes wurde von der Oberärztin beaufsichtigt."
                            },
                            {
                                "example_id": "b5ee13ed-6b31-4db0-9f80-17454a31f8fd",
                                "sense_id": "efb5e13f-b514-3e65-a1ce-fc58a0aa7454",
                                "text": "„Ein Assistenzarzt untersucht eine ältere, dicke Dame, die während der Untersuchung sehr rot wird und schwer atmet.“"
                            },
                            {
                                "example_id": "157301d5-ffb6-4d89-a85f-96ce798793cd",
                                "sense_id": "efb5e13f-b514-3e65-a1ce-fc58a0aa7454",
                                "text": "„Ferdinand Sauerbruch erinnert sich an seine Suche als junger Assistenzarzt nach einem möblierten Zimmer in der Nähe der Berliner Charité.“"
                            },
                            {
                                "example_id": "54e63016-b46d-4315-92ff-5c6aa697a994",
                                "sense_id": "efb5e13f-b514-3e65-a1ce-fc58a0aa7454",
                                "text": "„Sie hasste es, mit nacktem Oberkörper dazustehen und die Blicke des Assistenzarztes auf sich zu fühlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
