                ],
                "senses": [
                    {
                        "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                        "entry_id": "88cbe801-64e3-3885-af01-79504b5324c8",
                        "glosses": [
                            "unter Soldaten üblicher Jargon"
                        ],
                        "tags": [
                            "Soziolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "f9c7b198-a3a5-4c2a-903a-aefedfe6b35a",
                                "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                                "text": "„Diese ›Sprachen‹ sind zum kleineren Teil ebenfalls Fachsprachen - die Soldatensprache etwa insoweit, als sich ihr Wortschatz auf den Umgang mit Waffen und andere Gegenstände militärischer Ausbildung bezieht.“"
                            },
                            {
                                "example_id": "a18375b3-3b6d-49ae-8e62-05ba38e8cb8d",
                                "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                                "text": "„Die Besonderheit der Soldatensprache scheint nicht ganz unwesentlich darauf zu beruhen, daß sie die Sprache einer ‚Gruppe wider Willen‘ ist.“"
                            },
                            {
                                "example_id": "6571c94a-9c36-4038-898a-bac2be689c72",
                                "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                                "text": "„Die verschiedenen Spielarten der Soldatensprache (im Gegensatz zur militärischen Fachsprache) gehören ebenso hierher wie Hauptteile der Prostituiertensprache.“"
                            },
                            {
                                "example_id": "699f5091-3f92-418a-be66-47131aa5ce99",
                                "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                                "text": "„Um den Zusammenhang mit der Soldatensprache früherer Generationen zu wahren und zu verdeutlichen, suchte ich bei den einzelnen Wörtern das ungefähre Entstehungsjahr zu ermitteln.“"
                            },
                            {
                                "example_id": "dafc1ac9-1845-4b1b-927c-1d35c09bdad1",
                                "sense_id": "985c4983-1b8b-3b1c-85de-0e674e7d1cf7",
                                "text": "„Damals war auch die Soldatensprache weitgehend identisch mit dem Jargon der Räuber.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
