                ],
                "senses": [
                    {
                        "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                        "entry_id": "e0a85446-a53d-3c5e-b69b-fe4a3aae33b5",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "851a2257-a354-4452-94be-b7e3de894bcc",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Frau Fränkle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b94b0d6f-0749-4e67-b0ae-9c3e67887f37",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Herr Fränkle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "361ba964-56c3-43d0-afd2-67e86480285d",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Die Fränkles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1c2b3661-0734-4ad5-8aff-34a3db5bd723",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Der Fränkle trägt nie die Schals, die die Fränkle ihm strickt."
                            },
                            {
                                "example_id": "e0040058-6fdb-4280-b9b4-fc8434907227",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fränkle kommt, geht der Herr Fränkle.“"
                            },
                            {
                                "example_id": "61e4d298-cc64-4e5e-b80f-fb8e181bb65c",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Fränkle kommt und geht."
                            },
                            {
                                "example_id": "85af666b-8182-4512-af6b-1c40fca62f11",
                                "sense_id": "54506211-ac3c-33c0-bae5-100806e6903e",
                                "text": "Fränkles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
