                        "concours de plongeon"
                    ]
                },
                {
                    "sense_id": "bcc88e1a-eece-3bf9-a732-127427d1f969",
                    "sense_definition": "Action de se projeter au sol ou dans les airs pour attraper ou bloquer un ballon dans certains sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à un <w>plongeon</w> spectaculaire, le gardien de but a arrêté le tir à la dernière seconde."
                        },
                        {
                            "text": "Le défenseur a évité le point adverse au prix d'un <w>plongeon</w> désespéré vers la ligne."
                        }
                    ],
                    "common_phrases": [
