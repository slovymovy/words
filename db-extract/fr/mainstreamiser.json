                "senses": [
                    {
                        "sense_id": "124eb978-559d-3df7-94f8-512a31eb124f",
                        "entry_id": "7d2989d7-b141-366d-856f-10d4a057322e",
                        "glosses": [
                            "Donner un caractère mainstream à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b52b9524-ac26-4934-97b4-1aee8e8ee71c",
                                "sense_id": "124eb978-559d-3df7-94f8-512a31eb124f",
                                "text": "Mais bien sûr, le succès de RAMMSTEIN fera des jaloux et OOMPH! aura bien évidemment été tenté de « mainstreamiser » son son."
                            },
                            {
                                "example_id": "07f09efd-e675-48e2-b256-a333df6549b9",
                                "sense_id": "124eb978-559d-3df7-94f8-512a31eb124f",
                                "text": "Je me rappelle d’une époque pas si lointaine où le blog Copine de Geek faisait rire tout le monde, tout en permettant de mainstreamiser le geek et sa culture."
                            },
                            {
                                "example_id": "f8875698-82dc-46db-9ecc-882ff1f72ed4",
                                "sense_id": "124eb978-559d-3df7-94f8-512a31eb124f",
                                "text": "Je connais bien le marché j'y ai travaillé, mais finalement le livre électronique n'arrive pas à se mainstreamiser... c'est dommage!"
                            }
                        ]
                    }
