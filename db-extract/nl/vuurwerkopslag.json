                        "sense_id": "e1b4ebb2-ea3e-335f-bedd-89e1e85de30a",
                        "entry_id": "28e73c9b-85f3-3877-bdc7-6c95d2fd43f6",
                        "glosses": [
                            "de ruimte waar vuurwerk tijdelijk wordt geplaatst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "761bf29a-a495-4818-b4e4-7f12c56a2011",
                                "sense_id": "e1b4ebb2-ea3e-335f-bedd-89e1e85de30a",
                                "text": "Een illegale vuurwerkopslag in de Chinese stad Tangshan is compleet verwoest door een explosie. Volgens de Chinese staatstelevisie zijn daarbij zeker twee mensen om het leven gekomen. Andere media schrijven dat het gaat om een illegale fabriek."
                            },
                            {
                                "example_id": "b8e92b81-a953-4cda-8799-47103b7e6d8e",
                                "sense_id": "e1b4ebb2-ea3e-335f-bedd-89e1e85de30a",
                                "text": "Op 13 mei 2000 ontplofte een vuurwerkopslag in de Enschedese wijk Roombeek. Bij de ramp kwamen 23 mensen om het leven en raakten 947 mensen gewond; de wijk werd grotendeels verwoest."
                            }
                        ]
                    }
