                        ]
                    },
                    {
                        "translation_id": "e0a47b0c-81c1-472d-9504-8b015d550186",
                        "source_entry_id": "e51c76d2-be82-3066-aa47-9875d7cc584d",
                        "target_lang_word": "buldog",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buldog",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "23f4b768-c5fc-3a05-bc96-b61e66fe3026",
                                        "entry_id": "97bbfb12-6c30-3031-a451-876d1cf46e6d",
                                        "glosses": [
                                            "typ psa mocnej budowy, z krótką kufą pierwotnie wykorzystywanego do walk z bykami, obecnie jako pies stróżujący lub do towarzystwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6f2aa0-c406-429f-82a1-583281b40f21",
                                                "sense_id": "23f4b768-c5fc-3a05-bc96-b61e66fe3026",
                                                "text": "Wyobraź sobie, czytelniku, buldoga ubranego w strój ludzki, a będziesz miał obraz owego człowieka"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3674dc7-4ef3-4bae-b201-0c91c9844731",
                        "source_entry_id": "e51c76d2-be82-3066-aa47-9875d7cc584d",
                        "target_lang_word": "bouledogue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouledogue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e74e12ff-ef51-3269-8a31-a9deb70d7ee0",
                                        "entry_id": "52adc783-a0fb-321f-ae05-64c264e03201",
                                        "glosses": [
                                            "Une des races de chiens molossoïdes, qui sont comme un dogue au museau écrasé ; ils ont le crâne très développé, le corps trapu et court près du sol, les babines pendantes, la musculature imposante, et le poil court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7163a21-a4ea-4ea3-bea8-35d14c309035",
                                                "sense_id": "e74e12ff-ef51-3269-8a31-a9deb70d7ee0",
                                                "text": "Il […] se tourna tout à coup vers lui avec un grincement de dents si formidable que le géant flamand recula, comme un bouledogue devant un chat."
                                            },
                                            {
                                                "example_id": "3e46b3d8-81c8-43ef-b5fc-15519367e2d7",
                                                "sense_id": "e74e12ff-ef51-3269-8a31-a9deb70d7ee0",
                                                "text": "Son portrait voisine avec ceux des bêtes qui furent plus heureuses, sinon plus résignées : ma dernière bouledogue, désespérée de vieillir, de devenir sourde, d’entendre moins ma voix, de ne distinguer mes traits que derrière un brouillard."
                                            },
                                            {
                                                "example_id": "11e35ef6-70d8-41a4-ab5b-e41d95f869fb",
                                                "sense_id": "e74e12ff-ef51-3269-8a31-a9deb70d7ee0",
                                                "text": "La réponse mettait bientôt un terme à notre errance et Sartre se renfrognait, affichant alors une laideur et une humeur de bouledogue."
                                            },
                                            {
                                                "example_id": "efe79a68-05ba-44fe-ab23-89dddbc9b35c",
                                                "sense_id": "e74e12ff-ef51-3269-8a31-a9deb70d7ee0",
                                                "text": "« Cours, Heathcliff, cours, ils ont lâché le bouledogue, le voilà qui me tient. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b02afee-1dac-3214-becd-60229310a084",
                                        "entry_id": "52adc783-a0fb-321f-ae05-64c264e03201",
                                        "glosses": [
                                            "Variante de bouledogue français (race de chien)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3721b071-10a8-31c1-9b77-cf6c4b87926f",
                                        "entry_id": "52adc783-a0fb-321f-ae05-64c264e03201",
                                        "glosses": [
                                            "Requin bouledogue."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "810074bb-5705-4632-a3d0-628b9017c4f4",
                                                "sense_id": "3721b071-10a8-31c1-9b77-cf6c4b87926f",
                                                "text": "Le bouledogue peut dépasser trois mètres de long, il s’attaque à tout ce qui lui passe à portée de dents, et il fond sur ses proies avec une rapidité fulgurante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
