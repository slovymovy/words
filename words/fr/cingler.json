{
    "word_family": [
        "cinglage",
        "cinglant",
        "cingleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b56b0506-141d-3708-b4e1-66ac17304fc2",
                    "sense_definition": "Frapper vivement et douloureusement, en parlant des intempéries comme le vent, la pluie ou la neige.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie battante et le vent glacial lui <w>cinglaient</w> douloureusement le visage."
                        },
                        {
                            "text": "Sur les hauteurs de la falaise, les rafales d'embruns <w>cinglent</w> les promeneurs imprudents."
                        }
                    ],
                    "synonyms": [
                        "fouetter"
                    ],
                    "common_phrases": [
                        "cingler le visage"
                    ]
                },
                {
                    "sense_id": "e0ef0e35-3d1c-387d-ac9b-fa6acee653d0",
                    "sense_definition": "Faire voile ou faire route vers une destination, en parlant d'un navire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voilier quitte le port et <w>cingle</w> vers le large par une brise favorable."
                        },
                        {
                            "text": "Après plusieurs semaines en mer, notre équipage <w>cinglait</w> enfin vers les côtes bretonnes."
                        }
                    ],
                    "synonyms": [
                        "naviguer",
                        "voguer"
                    ],
                    "common_phrases": [
                        "cingler vers le large",
                        "cingler vers le nord"
                    ]
                },
                {
                    "sense_id": "cfe5eef8-7b6e-373f-902c-53a67d025f21",
                    "sense_definition": "Frapper d'un coup sec et tranchant à l'aide d'un fouet, d'une verge ou d'une lanière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "frapper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En marchant dans le sentier étroit, une branche basse lui <w>cingla</w> la joue."
                        },
                        {
                            "text": "Le cocher refusa de <w>cingler</w> les chevaux pour les faire avancer plus vite."
                        }
                    ],
                    "synonyms": [
                        "fouetter",
                        "fustiger"
                    ],
                    "common_phrases": [
                        "cingler d'un coup de fouet"
                    ]
                },
                {
                    "sense_id": "d7ebfb97-9f01-3858-a628-a29940b408f8",
                    "sense_definition": "Adresser une parole ou une réplique de façon blessante, vive et incisive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "« Vos explications ne trompent personne », lui <w>cingla</w> le magistrat avec mépris."
                        },
                        {
                            "text": "Elle préféra <w>cingler</w> son interlocuteur d'un mot acerbe plutôt que de continuer la discussion."
                        }
                    ],
                    "synonyms": [
                        "rétorquer"
                    ]
                }
            ]
        }
    ]
}