                                "target_senses": [
                                    {
                                        "sense_id": "a44c9317-6881-3624-ab3e-d059746359d5",
                                        "entry_id": "58760eea-4bc6-3e18-af36-4536edc4ef35",
                                        "glosses": [
                                            "男性同胞、同輩；哥哥和弟弟"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ed9ceda-4ddf-4f81-bb19-90294fce12c3",
                                                "sense_id": "a44c9317-6881-3624-ab3e-d059746359d5",
                                                "text": "兄弟如手足，妻子如衣服。衣服破，尚可縫；手足斷，安可續？",
                                                "translation": "兄弟就像手腳，妻子就像衣服。衣服破了還可以縫補，手腳斷了還能怎樣接上呢？"
                                            },
                                            {
                                                "example_id": "3663d501-9cf8-41ea-be8b-6fdb724aa754",
                                                "sense_id": "a44c9317-6881-3624-ab3e-d059746359d5",
                                                "text": "兄弟如手足，妻子如衣服。衣服破，尚可缝；手足断，安可续？",
                                                "translation": "兄弟就像手腳，妻子就像衣服。衣服破了還可以縫補，手腳斷了還能怎樣接上呢？"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9dc35b5-e971-3b48-a4b6-2a8870db8205",
                                        "entry_id": "58760eea-4bc6-3e18-af36-4536edc4ef35",
                                        "glosses": [
                                            "內外族親、姻親"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6cf901-22dc-450b-bea6-00510a7aa44a",
                                                "sense_id": "a9dc35b5-e971-3b48-a4b6-2a8870db8205",
                                                "text": "籩豆有踐，兄弟無遠。",
                                                "translation": "行行籩豆排列整齊，親戚相談莫要疏遠。"
                                            },
                                            {
                                                "example_id": "0ecf4a13-d089-4345-824b-94602913340b",
                                                "sense_id": "a9dc35b5-e971-3b48-a4b6-2a8870db8205",
                                                "text": "笾豆有践，兄弟无远。",
                                                "translation": "行行籩豆排列整齊，親戚相談莫要疏遠。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8105b04-ba39-36c3-8b37-683a569f5867",
                                        "entry_id": "58760eea-4bc6-3e18-af36-4536edc4ef35",
                                        "glosses": [
                                            "同姓的國家"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a87bda5-fcf1-49a9-940f-b51b06a585ce",
                                                "sense_id": "a8105b04-ba39-36c3-8b37-683a569f5867",
                                                "text": "懋乃攸绩，睦乃四邻，以蕃王室，以和兄弟。"
                                            },
                                            {
                                                "example_id": "4de40f25-94db-47ae-8cf1-16491a40dbfc",
                                                "sense_id": "a8105b04-ba39-36c3-8b37-683a569f5867",
                                                "text": "懋乃攸績，睦乃四鄰，以蕃王室，以和兄弟。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45de9ce2-2c4a-31a9-8d65-c64869d40747",
                                        "entry_id": "58760eea-4bc6-3e18-af36-4536edc4ef35",
