{
    "word_family": [
        "chatter",
        "chittering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50c3f51c-380f-360d-9c41-da5acfaed906",
                    "sense_definition": "To make a series of high-pitched sounds like a bird or insect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small birds <w>chitter</w> in the trees as the sun begins to rise.",
                            "target_lang_translations": {
                                "ru": "Маленькие птицы <w>щебечут</w> на деревьях, когда начинает вставать солнце."
                            }
                        },
                        {
                            "text": "We could hear the crickets <w>chittering</w> in the tall grass all night long.",
                            "target_lang_translations": {
                                "ru": "Мы всю ночь слышали, как в высокой траве <w>стрекочут</w> сверчки."
                            }
                        }
                    ],
                    "synonyms": [
                        "chirp",
                        "twitter",
                        "chatter"
                    ],
                    "common_phrases": [
                        "birds chitter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать серию высоких звуков, характерных для птиц или насекомых."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щебетать",
                                "target_lang_sense_clarification": "о птицах"
                            },
                            {
                                "target_lang_word": "стрекотать",
                                "target_lang_sense_clarification": "о насекомых"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdaf0f20-72cb-3824-92a9-9e7dfb8cf4a3",
                    "sense_definition": "To shiver or shake due to being very cold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shiver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lost puppy was <w>chittering</w> in the snow until we brought it inside.",
                            "target_lang_translations": {
                                "ru": "Потерявшийся щенок <w>дрожал</w> на снегу, пока мы не принесли его в дом."
                            }
                        },
                        {
                            "text": "He stood <w>chittering</w> in the freezing wind while waiting for the bus.",
                            "target_lang_translations": {
                                "ru": "Он стоял и <w>дрожал</w> на ледяном ветру, ожидая автобус."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiver",
                        "tremble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дрожать или трястись от сильного холода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дрожать",
                                "target_lang_sense_clarification": "от холода"
                            },
                            {
                                "target_lang_word": "стучать зубами",
                                "target_lang_sense_clarification": "от сильного озноба или холода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b97f3a85-6b6d-3b0e-b414-42482b4be53a",
                    "sense_definition": "An alternative form of <w>chitterling</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traditional dish was prepared with cleaned <w>chitters</w> and served with hot sauce.",
                            "target_lang_translations": {
                                "ru": "Традиционное блюдо было приготовлено из очищенных <w>свиных кишок</w> и подано с острым соусом."
                            }
                        },
                        {
                            "text": "Many people enjoy eating <w>chitters</w> as a classic comfort food in the south.",
                            "target_lang_translations": {
                                "ru": "Многие люди на юге любят есть <w>свиные кишки</w> как классическую домашнюю еду."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Commonly used in certain dialects of American English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Региональный вариант названия блюда из свиных кишок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свиные кишки",
                                "target_lang_sense_clarification": "кулинарный термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}