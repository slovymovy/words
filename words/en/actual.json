{
    "word_family": [
        "actually",
        "actuality",
        "actualize",
        "actualization"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8b0bbe34-56ae-39cb-ab50-f36db60ec73f",
                    "sense_definition": "Existing in fact and reality; not merely potential, imagined, or estimated.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>actual</w> cost of the project was much higher than the initial estimate.",
                            "target_lang_translations": {
                                "ru": "<w>Фактическая</w> стоимость проекта оказалась намного выше первоначальной оценки.",
                                "zh": "该项目的<w>实际</w>成本远高于最初的估算。"
                            }
                        },
                        {
                            "text": "In <w>actual</w> fact, the situation is quite different from what was reported.",
                            "target_lang_translations": {
                                "ru": "На <w>самом</w> деле ситуация совершенно отличается от того, что сообщалось.",
                                "zh": "事实上，情况与报道的<w>完全</w>不同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "real",
                        "true",
                        "genuine"
                    ],
                    "antonyms": [
                        "potential",
                        "possible",
                        "virtual",
                        "speculative",
                        "theoretical",
                        "nominal",
                        "hypothetical",
                        "estimated",
                        "conceivable"
                    ],
                    "common_phrases": [
                        "in actual fact",
                        "actual cost",
                        "actual size",
                        "actual value"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в действительности; реальный, а не потенциальный или предполагаемый.",
                        "zh": "存在于事实和现实中；并非仅仅是潜在的、想象的或估计的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фактический",
                                "target_lang_sense_clarification": "основанный на фактах"
                            },
                            {
                                "target_lang_word": "реальный",
                                "target_lang_sense_clarification": "существующий на самом деле"
                            },
                            {
                                "target_lang_word": "действительный",
                                "target_lang_sense_clarification": "имеющий место в действительности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际的",
                                "target_lang_sense_clarification": "指客观存在的情况"
                            },
                            {
                                "target_lang_word": "真实的",
                                "target_lang_sense_clarification": "指符合事实的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83e34058-14c2-32f7-80f1-9920ba70fed0",
                    "sense_definition": "Used to emphasize the exact truth, specific identity, or existence of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the <w>actual</w> room where the famous treaty was signed.",
                            "target_lang_translations": {
                                "ru": "Это <w>та самая</w> комната, где был подписан знаменитый договор.",
                                "zh": "这<w>正是</w>签署那份著名条约的房间。"
                            }
                        },
                        {
                            "text": "I was surprised that he used those <w>actual</w> words during the meeting.",
                            "target_lang_translations": {
                                "ru": "Я был удивлен, что он использовал <w>те самые</w> слова во время встречи.",
                                "zh": "我很惊讶他在会议上用了<w>那几个</w>词。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the actual problem",
                        "the actual words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для подчеркивания точности, конкретности или самого факта существования чего-либо.",
                        "zh": "用于强调确切的真相、特定的身份或某事物的存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящий",
                                "target_lang_sense_clarification": "истинный, неподдельный"
                            },
                            {
                                "target_lang_word": "подлинный",
                                "target_lang_sense_clarification": "оригинальный, точный"
                            },
                            {
                                "target_lang_word": "тот самый",
                                "target_lang_sense_clarification": "именно этот (для усиления)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正是",
                                "target_lang_sense_clarification": "用于强调特定对象"
                            },
                            {
                                "target_lang_word": "真正的",
                                "target_lang_sense_clarification": "强调身份或本质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ed28526-114e-3383-9473-bbe1a9753d33",
                    "sense_definition": "Real income, receipts, or costs, as distinct from estimated or budgeted ones.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant compared the quarterly forecasts against the <w>actuals</w>.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер сравнил квартальные прогнозы с <w>фактическими показателями</w>.",
                                "zh": "会计将季度预测与<w>实际数据</w>进行了对比。"
                            }
                        },
                        {
                            "text": "We cannot finalize the report until we receive the <w>actuals</w> for December.",
                            "target_lang_translations": {
                                "ru": "Мы не можем завершить отчет, пока не получим <w>фактические данные</w> за декабрь.",
                                "zh": "在收到十二月的<w>实绩</w>之前，我们无法完成报告。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "budget vs actuals"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фактические доходы, поступления или расходы, в отличие от плановых или бюджетных.",
                        "zh": "实际的收入、收据或成本，与估计或预算的数字相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фактические показатели",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "фактические данные",
                                "target_lang_sense_clarification": "в отчетности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实际数据",
                                "target_lang_sense_clarification": "财务或统计中的实测值"
                            },
                            {
                                "target_lang_word": "实绩",
                                "target_lang_sense_clarification": "指实际完成的业绩或数据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fc21ed5-869e-34af-b3e0-c03a40a84602",
                    "sense_definition": "A radio callsign modifier used to identify the commanding officer of a unit directly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bravo Six <w>Actual</w>, this is Alpha One requesting orders.",
                            "target_lang_translations": {
                                "ru": "Браво-Шесть <w>Командир</w>, это Альфа-Один, запрашиваю приказы.",
                                "zh": "Bravo Six <w>指挥官</w>，我是Alpha One，请求指示。"
                            }
                        },
                        {
                            "text": "The message came directly from <w>Actual</w>, so we must move immediately.",
                            "target_lang_translations": {
                                "ru": "Сообщение пришло непосредственно от <w>Командира</w>, поэтому мы должны выдвигаться немедленно.",
                                "zh": "消息直接来自<w>指挥官</w>，所以我们必须立即行动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Позывной, используемый для обозначения командира подразделения в радиообмене.",
                        "zh": "一种无线电呼号修饰语，用于直接指代单位的指挥官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "командир",
                                "target_lang_sense_clarification": "военный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "指挥官",
                                "target_lang_sense_clarification": "军事无线电用语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}