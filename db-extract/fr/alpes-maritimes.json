        "fr-extract.jsonl": [
            {
                "entry_id": "99f4fbbf-9380-3df7-81ae-096187f79917",
                "word": "Alpes-Maritimes",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c1bd8ad0-f518-3fd1-9a47-e2f0a6049c6f",
                        "entry_id": "99f4fbbf-9380-3df7-81ae-096187f79917",
                        "glosses": [
                            "Département français de la région Provence-Alpes-Côte d’Azur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f69abcf-7ccf-427f-9af4-a605efe51c5b",
                                "sense_id": "c1bd8ad0-f518-3fd1-9a47-e2f0a6049c6f",
                                "text": "Le département des Alpes-Maritimes est peuplé d’Alpins-Maritimes."
                            },
                            {
                                "example_id": "3a607c3b-8447-4f9e-b334-54d92db62264",
                                "sense_id": "c1bd8ad0-f518-3fd1-9a47-e2f0a6049c6f",
                                "text": "Né à Puget-Théniers (Alpes-Maritimes), Blanqui est d’origine italienne, sa famille avait été francisée par l’annexion du comté de Nice en 1792."
                            },
                            {
                                "example_id": "2b9692ae-b72a-481a-9f6e-cf30ce50c5d9",
                                "sense_id": "c1bd8ad0-f518-3fd1-9a47-e2f0a6049c6f",
                                "text": "L’orage tombé sur le littoral azuréen samedi et dimanche a fait trembler plus que les murs dans les Alpes-Maritimes."
                            },
                            {
                                "example_id": "b9f071ef-7600-4f90-bedb-e1a1c26feedf",
                                "sense_id": "c1bd8ad0-f518-3fd1-9a47-e2f0a6049c6f",
                                "text": "Triomphalement réélu député en juin, mais toujours vissé à son fauteuil de président du conseil départemental des Alpes-Maritimes, le très droitier Éric Ciotti espérait continuer à cumuler tranquilou ses deux mandats jusqu’à la fin de l’année, grâce, notamment. à deux heureux recours déposés contre son élection au Palais-Bourbon…"
                            }
                        ]
                    },
