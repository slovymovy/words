                    ]
                },
                {
                    "sense_id": "c6d990a6-2461-37aa-907e-f5657853e61e",
                    "sense_definition": "Déposer un bien en garantie pour obtenir un prêt d'argent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour payer ses dettes urgentes, elle a dû <w>engager</w> plusieurs bijoux de famille au mont-de-piété."
                        },
                        {
                            "text": "Il refusait catégoriquement d'<w>engager</w> sa montre en or malgré le manque d'argent."
