                                "target_senses": [
                                    {
                                        "sense_id": "d4df6f8c-6e56-3543-b747-e5efb7930876",
                                        "entry_id": "a4b98523-299a-32a6-9cc0-4aefce87466b",
                                        "glosses": [
                                            "The state of being dependent, of relying upon another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a8f54ea-6c53-4d71-9d75-828337cff619",
                                                "sense_id": "d4df6f8c-6e56-3543-b747-e5efb7930876",
                                                "text": "He had a deep dependence on her for guidance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a451f42f-04cf-32c1-9547-d228c24e62a4",
                                        "entry_id": "a4b98523-299a-32a6-9cc0-4aefce87466b",
                                        "glosses": [
                                            "An irresistible physical or psychological need, especially for a chemical substance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92405096-6126-4d95-b658-1b2c48324c56",
                                                "sense_id": "a451f42f-04cf-32c1-9547-d228c24e62a4",
                                                "text": "Her dependence on cocaine led to her ruin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0ceb343-2921-49a2-b8ba-6c6f40b6a89f",
                        "source_entry_id": "2c14733a-29b3-38a4-8197-712d7a707ca7",
                        "source_sense_description": "деньги, средства",
                        "target_lang_word": "money",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "money",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A generally accepted means of exchange."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850bc283-ef77-4610-9ff5-10633698a3f7",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "I cannot take money that I did not work for."
                                            },
                                            {
                                                "example_id": "4d17fda8-b17c-4bba-a9b0-4cf82873b6da",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "Before colonial times cowry shells imported from Mauritius were used as money in Western Africa."
                                            },
                                            {
                                                "example_id": "58545015-35cc-4da3-9499-5cb5afebb39a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "She used to spend money every day on makeup."
                                            },
                                            {
                                                "example_id": "6248d875-a7e4-4f9f-959f-c0e62667ef8a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            },
                                            {
                                                "example_id": "a72907e5-f312-4d14-a4fb-ba3672ae4f8a",
                                                "sense_id": "0ff97bcd-e432-3e02-8caa-ddb857c8c828",
                                                "text": "At the same time, it is pouring money into cleaning up the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea86fb1e-30cf-313b-84cd-05eee61718e5",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
                                            "A currency maintained by a state or other entity which can guarantee its value (such as a monetary union)."
                                        ],
                                        "tags": [
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52152269-6b74-4d08-b2e1-37b062adb1d0",
                                                "sense_id": "ea86fb1e-30cf-313b-84cd-05eee61718e5",
                                                "text": "money supply; money market"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f943cbc-1db6-3edf-bc86-43b96fe56b61",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
