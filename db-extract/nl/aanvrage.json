                                            {
                                                "example_id": "687a4a92-f178-473b-9d91-eb5e28f6c619",
                                                "sense_id": "42e5048e-5d59-329d-b6ea-a2f5f98cbc56",
                                                "text": "Faire sa demande par écrit."
                                            },
                                            {
                                                "example_id": "e6d5fadb-6840-4a3d-8e45-bcca217af671",
