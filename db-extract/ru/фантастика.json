                ],
                "senses": [
                    {
                        "sense_id": "6cfbba6d-c910-3bb1-a087-a5eb09ca2aa1",
                        "entry_id": "25ba0c73-8f4c-3c70-83ee-346e5b30f6b4",
                        "glosses": [
                            "жанр литературы, описывающий вымышленные миры"
                        ],
                        "tags": [
                            "[филол.]"
                        ],
                        "examples": [
                            {
                                "example_id": "4f0ae5de-cf2e-4615-8e87-6e6603453fb2",
                                "sense_id": "6cfbba6d-c910-3bb1-a087-a5eb09ca2aa1",
                                "text": "Произведения Герберта Уэллса являются классикой фантастики."
                            }
                        ]
                    },
                    {
                        "sense_id": "db3e9af0-4910-30b3-ae1c-e221bd7f413b",
                        "entry_id": "25ba0c73-8f4c-3c70-83ee-346e5b30f6b4",
                        "glosses": [
                            "нечто восхитительное"
                        ],
                        "tags": [
                            "[разг.]"
                        ],
                        "examples": [
                            {
                                "example_id": "f96f0ef5-44fd-4287-8d96-064d2b6c3a58",
                                "sense_id": "db3e9af0-4910-30b3-ae1c-e221bd7f413b",
                                "text": "А квартира у неё — это просто фантастика!"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe2f6219-ba05-3eca-8ee4-14427983dc98",
                        "entry_id": "25ba0c73-8f4c-3c70-83ee-346e5b30f6b4",
                        "glosses": [
                            "отсутствующее в реальном мире"
                        ],
                        "tags": [
                            "[п.]"
                        ],
                        "examples": [
                            {
                                "example_id": "4dd7d847-4f5c-45b6-84a9-3b930518a024",
                                "sense_id": "fe2f6219-ba05-3eca-8ee4-14427983dc98",
                                "text": "Папа, а снежные люди бывают? — Нет, сынок, это фантастика."
                            }
                        ]
                    }
                ],
