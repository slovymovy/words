                "senses": [
                    {
                        "sense_id": "0f4f2ae4-8cea-3335-8846-6095b930b86e",
                        "entry_id": "e0120e2f-d1b2-307e-bf5b-18a4698e0bd1",
                        "glosses": [
                            "Qui est dans un état voisin de l'ivresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e11e589-5008-47b4-897b-20db2d13496b",
                                "sense_id": "0f4f2ae4-8cea-3335-8846-6095b930b86e",
                                "text": "Un gendre un peu éméché, un autre gendre très sérieux ce soir. Il ne l'est pas toujours : Les deux filles, deux boulottes, qui bafouillent."
                            },
                            {
                                "example_id": "122a5ce1-48ee-438d-96e3-367cfcef68b2",
                                "sense_id": "0f4f2ae4-8cea-3335-8846-6095b930b86e",
                                "text": "Il eut tôt fait d'en capter, car, ainsi que Kantor l'avait dit, les « donzelles » en question étaient éméchées, et bruyantes, ceci expliquant cela."
                            },
                            {
                                "example_id": "25097f59-68b5-4064-b6df-31485000e226",
                                "sense_id": "0f4f2ae4-8cea-3335-8846-6095b930b86e",
                                "text": "Trempés jusqu'aux os par la pluie torrentielle qui s'était abattue à la sortie du pub, et tous deux agréablement éméchés par l'alcool, on était absorbés l'un par l'autre, la fête n'existant plus pour nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34f40f7-b226-3bc2-a834-bb58ed52a7ea",
                        "entry_id": "e0120e2f-d1b2-307e-bf5b-18a4698e0bd1",
                        "glosses": [
                            "Qui dénote l'ivresse."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "98ce8fa5-2f70-416c-bada-2ce71cf83a50",
                                "sense_id": "a34f40f7-b226-3bc2-a834-bb58ed52a7ea",
                                "text": "À une heure, des voix éméchées me parvinrent et quelqu'un tâtonna pour trouver la serrure du bungalow d'à côté."
                            }
                        ]
                    }
                ],
