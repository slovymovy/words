                                "example_id": "627b082f-29bd-4dab-ab9c-e2ca37791bc5",
                                "sense_id": "517a9d37-8c40-359c-a01c-2f38e7e6d964",
                                "text": "Il risque donc de \"moustacher\" les Luxo."
                            },
                            {
                                "example_id": "30b25d74-4865-4b4a-9ab0-65889bda7043",
                                "sense_id": "517a9d37-8c40-359c-a01c-2f38e7e6d964",
                                "text": "À côté ça a tendance à moustacher sur les fréquences voisines."
