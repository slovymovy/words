                ],
                "senses": [
                    {
                        "sense_id": "f3e72dc3-d15f-35f7-9cd1-b709caedf896",
                        "entry_id": "6a12eced-b067-3735-911f-bb8a8e64cf19",
                        "glosses": [
                            "Faire perdre son caractère authentifié à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "657c1ff9-f969-4224-b8d0-bfc2952c9cee",
                                "sense_id": "f3e72dc3-d15f-35f7-9cd1-b709caedf896",
                                "text": "Les anthropologues se sont rarement posés ce problème parce qu’ils ne pensaient pas avoir à authentifier ou désauthentifier les activités et des représentations des peuples qu’ils étudiaient."
                            },
                            {
                                "example_id": "1565be5c-b755-4175-a6ff-2e9c23e62865",
                                "sense_id": "f3e72dc3-d15f-35f7-9cd1-b709caedf896",
                                "text": "La station peut se désauthentifier à tout moment en envoyant une requête EAPoL-Logoff."
                            }
                        ]
                    }
                ],
