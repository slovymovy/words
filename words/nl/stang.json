{
    "word_family": [
        "stangen",
        "stangetje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0d2b2e21-213b-3228-9235-6239ed29d6fb",
                    "sense_definition": "Een langwerpig, stijf voorwerp van metaal of hout dat dient ter ondersteuning, verbinding of afsluiting.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "staaf_voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze metalen <w>stang</w> verbindt de aanhanger met de trekker.",
                            "target_lang_translations": {
                                "en": "This metal <w>rod</w> connects the trailer to the tractor."
                            }
                        },
                        {
                            "text": "De gordijnen hangen aan een stevige houten <w>stang</w> boven het raam.",
                            "target_lang_translations": {
                                "en": "The curtains hang from a sturdy wooden <w>rod</w> above the window."
                            }
                        }
                    ],
                    "synonyms": [
                        "staaf"
                    ],
                    "common_phrases": [
                        "metalen stang",
                        "houten stang"
                    ],
                    "target_lang_definitions": {
                        "en": "An elongated, rigid object made of metal or wood that serves for support, connection, or closure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rod",
                                "target_lang_sense_clarification": "a straight, round stick or bar of metal or wood"
                            },
                            {
                                "target_lang_word": "bar",
                                "target_lang_sense_clarification": "a solid, rigid piece of metal or wood"
                            },
                            {
                                "target_lang_word": "pole",
                                "target_lang_sense_clarification": "a long, slender piece of wood or metal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a2e0339-b3d6-3fb2-8f92-1be1c7f20ab9",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>stangen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>stang</w> mijn broertje graag als hij aan het gamen is.",
                            "target_lang_translations": {
                                "en": "I like to <w>tease</w> my little brother when he is gaming."
                            }
                        },
                        {
                            "text": "Soms <w>stang</w> ik hem een beetje om zijn reactie te zien.",
                            "target_lang_translations": {
                                "en": "Sometimes I <w>needle</w> him a bit just to see his reaction."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'stangen' (to tease, needle, or wind up)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "to mock or annoy playfully or maliciously"
                            },
                            {
                                "target_lang_word": "needle",
                                "target_lang_sense_clarification": "to annoy or provoke someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3992b71b-8894-30bb-bc67-392c7c4bf747",
                    "sense_definition": "Gebiedende wijs van <w>stangen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Stang</w> hem nu niet zo, hij heeft al een slechte dag gehad.",
                            "target_lang_translations": {
                                "en": "Don't <w>tease</w> him like that now, he's already had a bad day."
                            }
                        },
                        {
                            "text": "Houd op en <w>stang</w> die arme jongen niet de hele tijd.",
                            "target_lang_translations": {
                                "en": "Stop it and don't <w>needle</w> that poor boy all the time."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'stangen' (to tease, needle, or wind up)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "to mock or annoy playfully or maliciously"
                            },
                            {
                                "target_lang_word": "needle",
                                "target_lang_sense_clarification": "to annoy or provoke someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39883d7d-6944-36c0-82e2-19abe70a75d5",
                    "sense_definition": "Inversievorm of tweede persoon enkelvoud tegenwoordige tijd van <w>stangen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Stang</w> je mij nu bewust om een discussie uit te lokken?",
                            "target_lang_translations": {
                                "en": "Are you deliberately <w>teasing</w> me now to provoke a discussion?"
                            }
                        },
                        {
                            "text": "Waarom <w>stang</w> je haar altijd als ze probeert te praten?",
                            "target_lang_translations": {
                                "en": "Why do you always <w>needle</w> her when she tries to talk?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Inversion form or second person singular present tense of 'stangen' (to tease, needle, or wind up)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tease",
                                "target_lang_sense_clarification": "to mock or annoy playfully or maliciously"
                            },
                            {
                                "target_lang_word": "needle",
                                "target_lang_sense_clarification": "to annoy or provoke someone"
                            }
                        ]
