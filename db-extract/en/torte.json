                                            {
                                                "example_id": "a734e546-7fe3-484c-a206-70c4d6985bd7",
                                                "sense_id": "45c228cd-1dae-384d-adea-5f2607e8f7e4",
                                                "text": "Sacherův dort je čokoládový dort s meruňkovou marmeládou a čokoládovou polevou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd76513-45aa-41e0-94a4-a21e55a2664b",
                        "source_entry_id": "52a9635b-a019-3d8a-8e5c-11ea19375efd",
                        "source_sense_id": "e08769f0-3ffa-3a14-b31b-a41cd22e5ad5",
                        "source_sense_description": "a rich, dense cake",
                        "target_lang_word": "Torte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Torte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                        "entry_id": "a88d7ab5-2d9b-3346-afbd-ee5dbe4f7b36",
                                        "glosses": [
                                            "meist runde Süßspeise mit mehreren horizontalen Schichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7892e2af-900a-450b-b9e6-8da983bd8598",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "Ich möchte die Torte mit viel Sahne."
                                            },
                                            {
                                                "example_id": "c521fb75-ee21-4e39-a17d-c14f16b67394",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "„Wir gingen dann in die Konditorei, und es gab dort sehr viele Kuchen und Torten in einer langen Vitrine.“"
                                            },
                                            {
                                                "example_id": "fcf56d9e-5409-4d83-9e28-2b8fb7b58209",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "Während das reiche Publikum sich bei Champagner und Torte vergnügte, waren die US-Flughäfen wieder offen für Reisende, die Trump mit seinem Dekret stoppen wollte.“"
                                            },
                                            {
                                                "example_id": "d85054eb-a244-4ea2-80ff-5b56a5742cdb",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "„Ebba lächelte, als sie die hübsche Torte sah.“"
                                            },
                                            {
                                                "example_id": "b8840c18-ffcd-4af9-b5dc-ad77d6df1de9",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "„Gestern und vorgestern sind bereits Geburtstagskuchen überreicht worden, am ersten Tag eine zweistöckige Torte zur goldenen Hochzeit.“"
                                            },
                                            {
                                                "example_id": "22f34ecf-21e2-4afd-8438-1f06f945f367",
                                                "sense_id": "ce3482be-e094-3b3b-9d2e-85510cdc99f1",
                                                "text": "„Diesmal wird die Torte vom Kranzler geliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "213310cf-b264-3802-8224-537163b8bcd4",
                                        "entry_id": "a88d7ab5-2d9b-3346-afbd-ee5dbe4f7b36",
                                        "glosses": [
                                            "Mädchen, Frau"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf3b81e-1086-4fdc-be8f-9f242465643d",
                                                "sense_id": "213310cf-b264-3802-8224-537163b8bcd4",
                                                "text": "Was is'n das für 'ne Torte, die da neben ihm steht?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
