                "senses": [
                    {
                        "sense_id": "1b28d5e7-241c-3c95-9abb-53fee6db7ce2",
                        "entry_id": "ef6f9081-9f0c-355b-93e9-ea3e7d1ab863",
                        "glosses": [
                            "met klem, met na druk, duidelijk, met ernst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17d49426-bc6b-4939-98be-606ecb1efd1a",
                                "sense_id": "1b28d5e7-241c-3c95-9abb-53fee6db7ce2",
                                "text": "Ondanks nadrukkelijke waarschuwingen door zijn arts bleef de benauwde man maar doorgaan met roken."
                            },
                            {
                                "example_id": "32f43bc2-9e13-4a8c-9682-e1a7bcc1965a",
                                "sense_id": "1b28d5e7-241c-3c95-9abb-53fee6db7ce2",
                                "text": "'Ik hoorde een geluidje en dacht: Daar is Jens,' herhaalde ze op een gek-mens-ben-ik-toch-toon met Drents accent. Vervolgens boog ze haar hoofd tussen de struiken langs de erfafscheiding en richtte zich nadrukkelijk tot mij. 'Maar ik vind het niet erg dat jij het bent, hoor.'"
                            },
                            {
                                "example_id": "514037fe-2724-4935-8c05-6b408db8bba7",
                                "sense_id": "1b28d5e7-241c-3c95-9abb-53fee6db7ce2",
                                "text": "Meneer Wang heeft nadrukkelijk verklaard dat het in zijn intenties ligt het hotel in zijn oude luister te herstellen, waarbij de financiële armslag waarover hij naar het zich laat aanzien beschikt zeer zeker van pas zal komen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0ee5b01-9c93-4dfc-a1ff-35eaa132614e",
                        "source_entry_id": "ef6f9081-9f0c-355b-93e9-ea3e7d1ab863",
                        "source_sense_id": "1b28d5e7-241c-3c95-9abb-53fee6db7ce2",
                        "target_lang_word": "emphatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emphatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5adba745-ef7a-3f35-a87f-0f23582b5f72",
                                        "entry_id": "3760768e-b409-30d7-956f-93a8c0a9fc49",
                                        "glosses": [
                                            "Characterized by emphasis; forceful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b24f803b-a0e6-4794-9af7-c9d2bc5d40c9",
                                                "sense_id": "5adba745-ef7a-3f35-a87f-0f23582b5f72",
                                                "text": "Yet when play restarted the Czech was a train that kept on running over Nadal. After breaking Nadal in the opening game of the final set, he went 2-0 up and later took the count to 4-2 with yet another emphatic ace – one of his 22 throughout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf17293-5938-34d5-81e5-afa8551151a0",
                                        "entry_id": "3760768e-b409-30d7-956f-93a8c0a9fc49",
                                        "glosses": [
                                            "Stated with conviction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc8f33b0-7cd8-4d52-a3cf-f4ade4c1aa9e",
                                                "sense_id": "dbf17293-5938-34d5-81e5-afa8551151a0",
                                                "text": "He gave me an emphatic no when I asked him out."
                                            }
                                        ]
                                    },
