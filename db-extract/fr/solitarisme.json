                ],
                "senses": [
                    {
                        "sense_id": "4a5f1c37-08fa-3e35-9d0d-830132116808",
                        "entry_id": "e4404659-22ab-3c4a-a590-e159630d4bf3",
                        "glosses": [
                            "Disposition d’esprit qui pousse à vivre à l’écart des autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c459b93-6d96-430e-ac84-de220f36aef8",
                                "sense_id": "4a5f1c37-08fa-3e35-9d0d-830132116808",
                                "text": "Chez certaines espèces, les tendances au solitarisme sont assez fortes pour ne pas permettre un rapprochement même temporaire."
                            },
                            {
                                "example_id": "b35489b1-6192-4c16-b3ff-22b774be36a6",
                                "sense_id": "4a5f1c37-08fa-3e35-9d0d-830132116808",
                                "text": "Ce peut être soit un solitarisme de fait (le sujet vivant seul), soit un solitarisme relatif, avec, dans le groupe où l’individu se trouve plus ou moins agrégé, un détachement à l’égard des autres."
                            }
                        ]
                    },
                    {
                        "sense_id": "26e94dd0-f36f-3271-be17-2f054ccf21de",
                        "entry_id": "e4404659-22ab-3c4a-a590-e159630d4bf3",
                        "glosses": [
                            "Comportement solitaire pathologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568c5ac9-3ca1-4b70-bd24-142f8edb905c",
                                "sense_id": "26e94dd0-f36f-3271-be17-2f054ccf21de",
                                "text": "II a été ainsi amené à une conduite de repliement, de solitarisme des jeux et, plus gâté par ses sœurs, d’affinités pour les occupations tranquilles, domestiques et ménagères, avec ceux qui ne le moquent pas et où il n’a pas à parler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c13277b-54b3-4712-b2b3-885da8a0218e",
                        "source_entry_id": "e4404659-22ab-3c4a-a590-e159630d4bf3",
