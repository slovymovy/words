                    {
                        "sense_id": "8e5cf311-b3db-3bfd-8852-4e5ab10b6913",
                        "entry_id": "c103db50-70f1-3ec0-80c1-76e8f8a25d16",
                        "glosses": [
                            "The determinant of a skew-symmetric matrix, capable of being written as the square of a polynomial in the matrix entries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83cca06-012a-46d6-964a-d13b5319b8db",
                                "sense_id": "8e5cf311-b3db-3bfd-8852-4e5ab10b6913",
                                "text": "If A is a skew symmetric matrix then det A is the square of a polynomial in the entries of A. This polynomial is known as the Pfaffian of A, and we denote it by Sym(pf A)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "f02aed10-8079-3048-b017-41d57778645f",
                "word": "Pfaffian",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "aa1ea802-981d-47ba-9ee4-11b1563f85b8",
                        "entry_id": "f02aed10-8079-3048-b017-41d57778645f",
                        "tags": [
                            "plural"
                        ],
                        "form": "Pfaffians"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb60b351-aa9c-3626-863c-66beb856ac2c",
                        "entry_id": "f02aed10-8079-3048-b017-41d57778645f",
                        "glosses": [
                            "A member of a circle of artists that met at Pfaff's, a restaurant on Broadway."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "76c7bddc-8514-4cde-a257-711f22eb528e",
                                "sense_id": "fb60b351-aa9c-3626-863c-66beb856ac2c",
                                "text": "Charles E. Hurd, assistant editor of the Boston Transcript, has published in the Commercial Bulletin an academic account of the literary Bohemia of New York at the time the Pfaffians flourished and Ada Clare, Whitman's friend, reigned as its queen."
                            },
                            {
                                "example_id": "9d3b5377-2124-44f6-8789-34e1ca59ed97",
                                "sense_id": "fb60b351-aa9c-3626-863c-66beb856ac2c",
                                "text": "While the publication became noted for its conservatism, the Pfaffians, inspired by the writings of Henri Murger and visits to Parisian bohemian quarters, avowedly dismissed the restraints of convention and pursued a freewheeling personal lifestyle."
                            },
                            {
                                "example_id": "a0bfdba8-f145-4cbf-a3c1-a4320fc0df49",
                                "sense_id": "fb60b351-aa9c-3626-863c-66beb856ac2c",
                                "text": "SHORTLY AFTER THE PFAFFIANS announced their version of la vie bohème in the Saturday Press, the mythos of Bohemia traveled to San Francisco."
                            }
                        ]
                    }
                ],
