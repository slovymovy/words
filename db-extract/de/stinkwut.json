                "senses": [
                    {
                        "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                        "entry_id": "a1adbf37-2890-35cd-aed2-ec8b8b11608d",
                        "glosses": [
                            "sehr große Wut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4886db78-304e-4adb-b950-167ab5c802d8",
                                "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                                "text": "„Endlich, nachdem ich acht Tage durch die Wüste geirrt bin, kommt mein Erretter, und zwar ein Teenager mit einer Stinkwut.“"
                            },
                            {
                                "example_id": "731c4335-9628-4860-ae62-db01f3fa4c8d",
                                "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                                "text": "„Stump mochte wütend sein, aber er hatte keinen blassen Schimmer davon, was eine Stinkwut war.“"
                            },
                            {
                                "example_id": "b0b11444-a92b-49c1-b21c-c7703310133f",
                                "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                                "text": "„‹Das wissen wir nicht. Möglicherweise ist er nur ein Lockvogel. Aber wahrscheinlicher ist, dass er eine Stinkwut auf das iranische Regime hat.›“"
                            },
                            {
                                "example_id": "0b65a613-2caf-41be-8d6b-2aef7c2ad4ca",
                                "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                                "text": "„›Mannomann, diese Fernsehtussi muss aus irgendeinem Grund eine Stinkwut auf dich haben. Was hast du bloß angestellt? Mit ihr geschlafen?‹“"
                            },
                            {
                                "example_id": "cade62d0-de12-4ccc-bb65-bf7419e1a1bc",
                                "sense_id": "03610a22-e2c8-3642-b411-eade702c4dc2",
                                "text": "„›Man wirft keinen Typen aus einem Zug, wenn man nicht wegen irgendetwas eine Stinkwut auf ihn hat‹, bemerkte Cupido.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
