{
    "word_family": [
        "skew",
        "skewness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1ec8f969-7595-3d53-80e9-f93499dba600",
                    "sense_definition": "Biased, distorted, or not reflecting the truth accurately.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The survey results gave a <w>skewed</w> picture of public opinion because only young people were interviewed.",
                            "target_lang_translations": {
                                "de": "Die Umfrageergebnisse lieferten ein <w>verzerrtes</w> Bild der öffentlichen Meinung, da nur junge Leute befragt wurden."
                            }
                        },
                        {
                            "text": "Personal prejudices often lead to <w>skewed</w> reporting in the media.",
                            "target_lang_translations": {
                                "de": "Persönliche Vorurteile führen in den Medien oft zu einer <w>einseitigen</w> Berichterstattung."
                            }
                        }
                    ],
                    "synonyms": [
                        "biased",
                        "distorted",
                        "slanted",
                        "warped"
                    ],
                    "antonyms": [
                        "unbiased",
                        "balanced",
                        "objective"
                    ],
                    "common_phrases": [
                        "skewed perspective",
                        "skewed results",
                        "skewed data",
                        "skewed view"
                    ],
                    "target_lang_definitions": {
                        "de": "Einseitig, verfälscht oder die Realität nicht zutreffend widerspiegelnd."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verzerrt",
                                "target_lang_sense_clarification": "statistisch oder inhaltlich ungenau bzw. verfälscht"
                            },
                            {
                                "target_lang_word": "einseitig",
                                "target_lang_sense_clarification": "nur eine Perspektive berücksichtigend"
                            },
                            {
                                "target_lang_word": "voreingenommen",
                                "target_lang_sense_clarification": "von Vorurteilen oder einer festen Haltung geprägt"
                            },
                            {
                                "target_lang_word": "tendenziös",
                                "target_lang_sense_clarification": "einer bestimmten Tendenz oder Absicht folgend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "958c150d-cadf-3148-b169-a35886d04130",
                    "sense_definition": "Turned, twisted, or positioned at an angle; not straight or aligned.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The picture hanging on the wall was visibly <w>skewed</w> after the earthquake.",
                            "target_lang_translations": {
                                "de": "Das Bild an der Wand hing nach dem Erdbeben sichtlich <w>schief</w>."
                            }
                        },
                        {
                            "text": "He noticed that the wooden frame had become <w>skewed</w> over time.",
                            "target_lang_translations": {
                                "de": "Er bemerkte, dass der Holzrahmen sich im Laufe der Zeit <w>verzogen</w> hatte."
                            }
                        }
                    ],
                    "synonyms": [
                        "crooked",
                        "askew",
                        "slanted",
                        "asymmetrical"
                    ],
                    "antonyms": [
                        "straight",
                        "aligned",
                        "level"
                    ],
                    "common_phrases": [
                        "skewed angle"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht gerade oder ausgerichtet; schief oder schräg stehend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "von der Waagerechten oder Senkrechten abweichend"
                            },
                            {
                                "target_lang_word": "schräg",
                                "target_lang_sense_clarification": "in einem Winkel verlaufend oder angeordnet"
                            },
                            {
                                "target_lang_word": "verzogen",
                                "target_lang_sense_clarification": "durch Spannung oder Alterung aus der Form geraten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37ec6b77-f282-3e68-ba4d-381b8e4e6662",
                    "sense_definition": "simple past and past participle of <w>skew</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An unusually high measurement <w>skewed</w> the final average of the experiment.",
                            "target_lang_translations": {
                                "de": "Ein ungewöhnlich hoher Messwert <w>verzerrte</w> den abschließenden Durchschnitt des Experiments."
                            }
                        },
                        {
                            "text": "The latest scandal has completely <w>skewed</w> the political debate.",
                            "target_lang_translations": {
                                "de": "Der jüngste Skandal hat die politische Debatte völlig <w>verfälscht</w>."
                            }
                        }
