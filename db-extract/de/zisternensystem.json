                "senses": [
                    {
                        "sense_id": "025ef052-8753-3bd4-8846-e87666f74758",
                        "entry_id": "f22b4b34-fcad-3fc8-85ee-2482a5039fa9",
                        "glosses": [
                            "System mehrerer oder vieler Zisternen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105d8404-c231-49e6-945e-131cab8c0f49",
                                "sense_id": "025ef052-8753-3bd4-8846-e87666f74758",
                                "text": "„Aus Natursteinen soll dort künftig Wasser fließen sowie über ein unterirdisches Zisternensystem aufgegangen und zurückgeführt werden.“"
                            },
                            {
                                "example_id": "9fdd4bc2-9096-422f-a1fa-c5ea8d5fe2dd",
                                "sense_id": "025ef052-8753-3bd4-8846-e87666f74758",
                                "text": "„Jonathans Projektgruppe ist dabei speziell für die Wasserversorgung der Schule verantwortlich, eine wichtige Aufgabe, denn durch das zentrale Zisternensystem kann der Zugang zu sauberem Wasser für Schülerinnen, Lehrkräfte und Angestellte nachhaltig gesichert werden.“"
                            },
                            {
                                "example_id": "541b6378-ca32-41b0-a6aa-a275b51fad68",
                                "sense_id": "025ef052-8753-3bd4-8846-e87666f74758",
                                "text": "„So sollen zum Beispiel energiesparende Kochkessel für die Schulen angeschafft werden (mit Kosten von 2.000 Euro pro Topf), ein Zisternensystem an den Schulen gebaut werden, damit in der Trockenzeit keine Wassernot herrscht, begabte arme Schüler sollen weiter gefördert werden und die Basis-Krankenversicherung für bedürftige Schüler soll ebenfalls ausgebaut werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
