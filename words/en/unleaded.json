                            {
                                "target_lang_word": "безалкогольное пиво",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1ad4fb56-473c-3be3-8a0f-3d1cde8653a1",
                    "sense_definition": "simple past and past participle of <w>unlead</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stained glass window was carefully <w>unleaded</w> before restoration work began.",
                            "target_lang_translations": {
                                "ru": "Витражное окно было аккуратно <w>освобождено от свинцовой оправы</w> перед началом реставрационных работ."
                            }
                        },
                        {
                            "text": "After the workers <w>unleaded</w> the old pipes, they replaced them with copper ones.",
                            "target_lang_translations": {
                                "ru": "После того как рабочие <w>демонтировали свинцовые детали</w> старых труб, они заменили их на медные."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола unlead (удалять свинец, вынимать свинец)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очищенный от свинца",
                                "target_lang_sense_clarification": "о трубах или стекле"
                            },
                            {
                                "target_lang_word": "распаянный",
                                "target_lang_sense_clarification": "о витражах, где удален свинцовый переплет"
                            }
                        ]
                    }
                }
            ]
