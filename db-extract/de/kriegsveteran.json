                ],
                "senses": [
                    {
                        "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                        "entry_id": "9637cda7-e8a8-3aea-8b1e-825107c1001d",
                        "glosses": [
                            "Person, die ehemals aktiv an Kriegshandlungen beteiligt war"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d16e4e-a24d-4342-a7ef-4a846282ba1e",
                                "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                                "text": "„Am 9. Mai, dem Tag des Siegs, standen wir zu fünft, eine Mädchenclique, vor der U-Bahn-Station und gratulierten den Kriegsveteranen.“"
                            },
                            {
                                "example_id": "e6c7ca11-969b-45e5-82bc-ed4ea15eaa4d",
                                "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                                "text": "„Unter dem so genannten Golfkriegssyndrom leiden bis heute viele US-amerikanische Kriegsveteranen.“"
                            },
                            {
                                "example_id": "6f43858c-9394-4c72-a168-b56ccf91bd90",
                                "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                                "text": "„Aber diese zwei oder drei Kriegsveteranen hätten sich erinnert, wie Kuźnice im Krieg von den Deutschen überfallen worden sei und wie diese aus irgendeinem Grund ein Massaker an den Bewohnern angerichtet hätten.“"
                            },
                            {
                                "example_id": "df146e14-d227-4ec3-9a00-b3f51f893d13",
                                "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                                "text": "„Unterdessen wartete der Kriegsveteran, begierig, seinen Monolog fortzusetzen.“"
                            },
                            {
                                "example_id": "ba5c6c0d-5c50-4e61-9fb8-2f22f107ea35",
                                "sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                                "text": "„Das Lehrersein wurde bei ihm geradezu habituell, selbst als Premierminister fand er die Zeit, Kriegsveteranen zu unterrichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79adcca1-b0c7-460a-b74e-605af27076b2",
                        "source_entry_id": "9637cda7-e8a8-3aea-8b1e-825107c1001d",
                        "source_sense_id": "615e9f89-feb9-3321-ade7-66e921c95616",
                        "source_sense_description": "Person, die ehemals aktiv an Kriegshandlungen beteiligt war",
