                                        "sense_id": "13121f66-dd1b-3593-8d1e-7012ea1af5a8",
                                        "entry_id": "1c42412e-c78d-3d22-a90b-0d5affdd5cef",
                                        "glosses": [
                                            "Movement or advancement through a series of events, or points in time; development through time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
