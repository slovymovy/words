                ],
                "senses": [
                    {
                        "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                        "entry_id": "3091d946-6e2a-3a7f-95bf-176fe3a6ddf5",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d10eb429-f29d-4c47-91a2-2b98bd4a7c5f",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Frau Jaeckel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "98a57ca3-4d4b-4eec-a59a-64d4d8b3080b",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Herr Jaeckel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fd489b60-d692-49e3-9a38-65c3f3d406c8",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Die Jaeckels kommen heute aus der Ostschweiz."
                            },
                            {
                                "example_id": "a0aed5ac-5ffa-4f3a-be8f-ae9d84dfd99b",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Der Jaeckel trägt nie die Schals, die die Jaeckel ihm strickt."
                            },
                            {
                                "example_id": "184b85b0-5b6c-490b-96c2-81063eee3c6b",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jaeckel kommt, geht der Herr Jaeckel.“"
                            },
                            {
                                "example_id": "2af2fecd-ce16-4611-9139-4f58e031df94",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Jaeckel kommt und geht."
                            },
                            {
                                "example_id": "6199cf1d-d431-4be9-94c9-7e02ce38748a",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "Jaeckels kamen, sahen und siegten."
                            },
                            {
                                "example_id": "9790243c-cc31-410e-a45d-b902636b8b3f",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "An verregneten Herbsttagen ist Familie Jaeckels liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "208cbf72-b53c-46e4-9216-d3258f30d0dc",
                                "sense_id": "9c3b828e-057e-3782-857f-78cba85b826a",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Jaeckel das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
