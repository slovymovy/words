                            {
                                "example_id": "ac2ad87a-16d8-4fb1-b3cd-f70d6ee95554",
                                "sense_id": "97f14bab-dc23-3f0b-8bf2-8018b53643b7",
                                "text": "Als die in een toren met ontbloot bovenlijf een kleipop staat te boetseren weet je gelijk: niet oké. Veel Orcs blijken juist prima knakkers."
                            }
                        ]
                    },
                    {
                        "sense_id": "18b06554-8f96-3fed-bb48-5fada399aed5",
                        "entry_id": "702e9ab0-82e7-3f39-8ce2-0a9556c6501c",
                        "glosses": [
                            "pop gemaakt van klei of plasticine die men gebruikt voor het maken van een soort animatiefilm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94214a2c-4c54-418a-8c0a-70898d2aa350",
                                "sense_id": "18b06554-8f96-3fed-bb48-5fada399aed5",
                                "text": "Bert en Ernie zijn binnenkort te bewonderen als kleipoppen. De NPS komt begin mei met een 26-delige kleipoppenserie rond de beroemde vrienden uit Sesamstraat."
                            },
                            {
                                "example_id": "5ebcdc42-0dd3-4cc6-a738-fb90dee20aa4",
                                "sense_id": "18b06554-8f96-3fed-bb48-5fada399aed5",
                                "text": "In The Missing Picture keert hij daarvoor terug naar zijn eigen jeugdjaren in de jaren zeventig, toen Pol Pot de macht greep in Cambodja. Met behulp van kleipoppetjes, spaarzaam archiefmateriaal, en een aan zijn autobiografische roman L’elimination (2012) ontleende voice-over bezoekt hij de killing fields."
                            }
                        ]
                    }
