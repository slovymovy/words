                    {
                        "sense_id": "036dae02-5f40-311a-96cd-dd0ae8f70cce",
                        "entry_id": "72bc8063-0b42-3497-b8a3-e00acceeadec",
                        "glosses": [
                            "Computersystem, das ein anderes nachbildet"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "293e0d20-8ee9-4371-b41a-fd73fac6669f",
                                "sense_id": "036dae02-5f40-311a-96cd-dd0ae8f70cce",
                                "text": "Es gibt eine Reihe von Emulatoren, mit deren Hilfe man für Spielkonsolen konzipierte Spiele auch am PC spielen kann."
                            },
                            {
                                "example_id": "2f121c5c-e3bf-46eb-b121-e1c3f03b5521",
                                "sense_id": "036dae02-5f40-311a-96cd-dd0ae8f70cce",
                                "text": "Das DVD-Laufwerk wird, ähnlich wie zuvor schon das Disketten-Laufwerk, nur noch durch einen Emulator nachgebildet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dad31486-c674-4141-bdc6-57f6abf6dc66",
                        "source_entry_id": "72bc8063-0b42-3497-b8a3-e00acceeadec",
