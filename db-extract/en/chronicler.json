    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c822d142-6b88-36bb-a000-8bc63d3d810c",
                "word": "Chronicler",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c8885b4d-f26a-3074-8b2b-eae35e787d70",
                        "entry_id": "c822d142-6b88-36bb-a000-8bc63d3d810c",
                        "glosses": [
                            "The presumed author/redactor of the Book of Chronicles and certain other books of the Tanakh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f2ac582-9c73-42e6-ba42-3ee35ffd10a0",
                                "sense_id": "c8885b4d-f26a-3074-8b2b-eae35e787d70",
                                "text": "The Chronicler's survey of events in the history of Judah (often, but not always, from a positive perspective) is articulated through a theological framework centered on covenant. In short, the book of Chronicles recounts the faithful acts of ..."
                            },
                            {
                                "example_id": "0c59c2fc-e611-43c3-90fc-f46f021c1310",
                                "sense_id": "c8885b4d-f26a-3074-8b2b-eae35e787d70",
                                "text": "[…] effort to prevent a fall back into the idolatry and apostasy that had brought on God's judgment in the first place. The Chronicler, like the postexilic prophets, did not desire a repeat of the Lord's judgment on Israel […]"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "7814ea6c-1507-4618-a5b7-5f0411b15fa2",
                        "source_entry_id": "c822d142-6b88-36bb-a000-8bc63d3d810c",
                        "source_sense_ids": [
                            "c8885b4d-f26a-3074-8b2b-eae35e787d70"
                        ],
