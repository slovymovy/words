                        ],
                        "form": "обсчита́в"
                    },
                    {
                        "form_id": "34e89de5-9826-412c-9a7d-6030bd915c44",
                        "entry_id": "f7bd76f9-2bad-379c-b259-1bf7abed26b7",
                        "tags": [
                            "adverbial",
                            "participle",
