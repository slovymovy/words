                        "cross_references": [
                            {
                                "target_word": "trowel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77114838-b21d-30c7-80d7-3d5bf558acb1",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A mason’s tool, used in spreading and dressing mortar, and breaking bricks to shape them."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A gardener’s tool, shaped like a scoop, used in taking up plants, stirring soil etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2711ab-f43f-4f12-b964-6e9fcbb1aa65",
                                                "sense_id": "d01cbbbc-4b7c-3a0c-8c03-7cbf44cd8b5d",
                                                "text": "I need to dig a hole for these begonias; would you pass me that trowel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca02c51c-f0c1-3845-9004-0caaca7c6949",
                                        "entry_id": "6950b587-1dc6-36e3-bdac-5de16803ecac",
                                        "glosses": [
                                            "A tool used for smoothing a mold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trowel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply (a substance) with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3404fbcb-4c1f-4b16-828d-b9df44b01197",
                                                "sense_id": "16f26e04-3f1a-31e7-b602-0c62d7625f35",
                                                "text": "He troweled the coarse mix with a twist, leaving a pattern of arcs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To pass over with a trowel."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93df204f-7222-4c33-afa3-5f8eb95d259c",
                                                "sense_id": "03113e37-ddf8-3a53-8a0e-447c3e23c578",
                                                "text": "Most finish coats are troweled smooth, but sometimes you will have to add cosmetic touches to make the patch match the surrounding plaster, texturing the surface randomly or uniformly with any of a variety of tools, ranging from sponges to special trowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                        "entry_id": "7b0a3525-324a-3cd1-ad06-37a8b31c98d5",
                                        "glosses": [
                                            "To apply something heavily or unsubtly."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f7b964e-208c-4ad5-bf94-67a24409fda5",
                                                "sense_id": "e7e9b673-6ab6-3365-85e1-f6d7340b9cb7",
                                                "text": "The whole Planet of the Apes set-up has been ripe for metaphor – from slavery and Afro-American revolution to European conquest of the Americas, even the war on terror. But mercifully, there's no big subtext being troweled on here."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2247f0bc-6037-4590-8bc8-1c70dad57cf2",
                        "source_entry_id": "930595c4-be0f-3e47-a5f5-ef5bc807593a",
                        "source_sense_id": "83a8ea11-de07-3337-a827-ec2554b14185",
                        "target_lang_word": "taloche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taloche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                        "entry_id": "fe787ad4-a840-300b-b6c3-53ad7273e579",
                                        "glosses": [
                                            "Tape légère donnée avec la main sur la tête ou sur le visage de quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023088e0-b383-421f-8c6d-bdad66b1894c",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "M. Eyssette, de le voir éternellement la larme à l’œil, avait fini par le prendre en grippe et l’abreuvait de taloches…"
                                            },
                                            {
                                                "example_id": "71b372b4-ca1c-4ada-b916-e2e763293cfb",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "Quand ils faisaient par trop de tapage, elle leur allongeait quelques taloches"
                                            },
                                            {
                                                "example_id": "35fc0160-63f8-4f2c-83d9-c3ef3cc0a04e",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "Si durant la journée quelquefois Alexis ou Benjamin m’envoyaient une taloche, la main retombée je n’y pensais plus, pas plus qu’ils ne pensaient à celles que je leur rendais ; et le soir, tous autour de la soupe, nous nous retrouvions amis et frères."
                                            },
                                            {
                                                "example_id": "bbee71c2-e840-49e0-84ac-2d7911dd87db",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "Un soir, entre autres, elles avaient rivalisé d’émulation et s’étaient surpassées elles-même pour solder la sépulture d’un vieux oncle, lequel ne leur avait cependant légué que le souvenir de taloches variées dont la distribution avait eu lieu naguère, aux jours de leur enfance."
                                            },
                                            {
                                                "example_id": "89122272-e06e-4c1c-b7df-1f9442b5071c",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "Ils s’habituent à être claqués comme on s’habitue à mal manger ; on pourrait même dire que, parfois, ils y prennent goût : certains parents ont la taloche gaie, ils rossent jovialement, pour un peu on provoquerait les « corrections »."
                                            },
                                            {
                                                "example_id": "641a9a3f-7ece-431e-9132-4f72ede67895",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "C’était d’ailleurs par l’église qu’il avait la première fois fait connaissance avec les misères et les vicissitudes de la vie, sous forme d’une taloche administrée par sa mère pour avoir déchiré une culotte neuve en s’accrochant au banc d’œuvre."
                                            },
                                            {
                                                "example_id": "1c52f958-9427-45ff-9095-cb252c15ba90",
                                                "sense_id": "99469f43-7db6-3e4f-bf55-9833beff8165",
                                                "text": "Bob, au passage, le secoua, le fit se lever et, lui administrant sur le crâne une amicale taloche."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taloche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79c45d19-6653-3687-9866-2f9fea751abe",
                                        "entry_id": "43a86317-9a9d-3e89-a182-db57a3efe962",
                                        "glosses": [
                                            "Outil formant une plaque de bois ou de plastique et utilisé pour déposer un peu de matière et lisser le mortier lors des travaux de finitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20fa0e25-19e3-4941-ae48-46d20391d405",
                                                "sense_id": "79c45d19-6653-3687-9866-2f9fea751abe",
                                                "text": "Tu te baisses, tu te charges la taloche avec la grande truelle de cuivre, tu te relèves, tchac tchac tu vides à la truelle la taloche sur le mur en giflant sec, tu traînes la taloche pour écraser étaler le plâtre, là tu comprends ta douleur, vite vite un coup de règle, un coup de berteley pour racler, l’apprenti (le « garçon ») apporte déjà le sac et les seaux d’eau de la gâchée suivante, tu replonges dans l’auge, c’est reparti, t’arrêtes pas, tu ruisselles, tu respires la gueule grande ouverte comme un poisson parce que t’as les narines collées au plâtre qui te bourre les poumons et te fait crever avant la cinquantaine."
                                            },
                                            {
                                                "example_id": "879a2e88-ba19-406f-a1c2-24ac9542494e",
                                                "sense_id": "79c45d19-6653-3687-9866-2f9fea751abe",
                                                "text": "Le talochage se fait sans attendre, tout de suite après avoir projeté la matière. On atténue les traces de rotation de la taloche à l'aide d'une éponge."
                                            },
                                            {
                                                "example_id": "311e486e-bf4a-44ba-be3f-dc22870a703f",
                                                "sense_id": "79c45d19-6653-3687-9866-2f9fea751abe",
                                                "text": "Le mélange est tiré à la règle ou à l’épandeuse sur le primaire recommandé, il est ensuite compacté et lissé manuellement à la taloche ou à l’hélicoptère."
                                            },
                                            {
                                                "example_id": "73e158bf-f962-41c5-a368-4e58c21bf881",
                                                "sense_id": "79c45d19-6653-3687-9866-2f9fea751abe",
                                                "text": "La compagnon manie la taloche avec une facilité qui fait l’admiration de Sylvestre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "taloche",
                                "target_lang_code": "fr",
                                "target_senses": [
