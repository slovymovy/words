                "senses": [
                    {
                        "sense_id": "39208c66-e420-32eb-81eb-5ad75dc14590",
                        "entry_id": "3a4fe2d8-97eb-3dc5-add6-b339294fc184",
                        "glosses": [
                            "Variante ancienne de greluchonner (traiter comme une greluche)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5013c53e-16ec-4630-b35f-f4a04f69e176",
                                "sense_id": "39208c66-e420-32eb-81eb-5ad75dc14590",
                                "text": "Ce qu’il y a de particulier et qui annonce la force de tempérament de cette demoiselle, c’est qu’elle aimait M. Fontaine qui était jeune et cependant se laissait guerluchonner par M. de Montamand beaucoup plus vieux et moins fait pour plaire ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "a7aa538c-c7c9-3171-babe-e74789c7be3d",
                        "entry_id": "3a4fe2d8-97eb-3dc5-add6-b339294fc184",
                        "glosses": [
                            "Variante ancienne de greluchonner (se comporter comme une greluche)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47e94bb1-1acb-4333-8694-26c319fa1977",
                                "sense_id": "a7aa538c-c7c9-3171-babe-e74789c7be3d",
                                "text": "Elle a continué de guerluchonner avec ce Corbin, jusqu’à il y a environ deux mois qu’elle l’a renvoyé de chez elle, sans doute à cause qu’il est devenu manchot du bras gauche dans la dernière campagne."
                            }
                        ]
                    }
