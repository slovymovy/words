                        "entry_id": "a759a4b7-209a-38ac-9f45-a9098658b96a",
                        "glosses": [
                            "Habitant du Morbihan, département français situé en Bretagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c2448d-d187-40aa-8738-70e087b5110e",
                                "sense_id": "53fa0ede-07e0-367a-9dc1-26cc8feb6ec1",
                                "text": "Valentin Madouas étant forfait (covid), seuls deux Bretons seront au départ : le Morbihannais Alan Jousseaume et David Gaudu."
                            },
                            {
                                "example_id": "23f00f54-3871-4ad7-9760-c6f6b3bba20b",
                                "sense_id": "53fa0ede-07e0-367a-9dc1-26cc8feb6ec1",
                                "text": "J’aurais aimé aller plus haut, bien sûr…, admet le Morbihannais Florian Martin, désormais à Valenciennes (183 rencontres de L2)."
                            },
                            {
                                "example_id": "fb055e09-a097-470b-ac7f-0c95f2ba2cea",
                                "sense_id": "53fa0ede-07e0-367a-9dc1-26cc8feb6ec1",
                                "text": "Quatrième des championnats de France il y a deux semaines, le Morbihannais licencié à Saint-Brieuc est toujours à la recherche de sa course référence."
                            }
                        ]
                    }
