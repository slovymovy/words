                "senses": [
                    {
                        "sense_id": "c4a51433-02e8-3c7c-99c9-bcd01b216b7f",
                        "entry_id": "076f7f1f-0513-3117-8050-5b0b9a7b7667",
                        "glosses": [
                            "der Sarg"
                        ],
                        "tags": [
                            "archaic",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5b64dd42-5b7b-427c-953e-3c6a63131194",
                                "sense_id": "c4a51433-02e8-3c7c-99c9-bcd01b216b7f",
                                "text": "Eine Totenlade aus Holz verrottet in der Erde nach der Zeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd487392-c15a-3599-b181-47159e4e9334",
                        "entry_id": "076f7f1f-0513-3117-8050-5b0b9a7b7667",
                        "glosses": [
                            "Hülle, die bei einer Knochenmarkentzündung durch Neubildung von Knochen entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b28a98f-8b71-4697-8c99-25017163a631",
                                "sense_id": "fd487392-c15a-3599-b181-47159e4e9334",
                                "text": "„Ein Beispiel für einen Sequester ist die sogenannte Totenlade (Kortikalissequester) bei Osteomyelitis.“"
                            },
                            {
                                "example_id": "711e14ac-0c73-4bc5-8861-face04f4a835",
                                "sense_id": "fd487392-c15a-3599-b181-47159e4e9334",
                                "text": "„Unter einer Totenlade oder auch Sequester versteht man ein totes Knochenstück, das vom lebenden Knochen rundherum durch eine bindegewebige Kapsel abgetrennt ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
