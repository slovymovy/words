                    "frequency": "Middle",
                    "semantic_group_id": "ignored",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>disregarded</w> advice led to several avoidable errors in the final report.",
                            "target_lang_translations": {
