                "senses": [
                    {
                        "sense_id": "a19ea02d-2684-3f8b-b0d2-543df6a9c68d",
                        "entry_id": "2e0ea12c-2561-336e-a15a-2368d4ce394f",
                        "glosses": [
                            "Se dit d’un cristal dont les plans coordonnés peuvent être rapportés à trois axes, tous égaux."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cabede18-8912-455d-bc71-8ea6259a4eae",
                                "sense_id": "a19ea02d-2684-3f8b-b0d2-543df6a9c68d",
                                "text": "Il [Philippe-Louis Voltz] donne en fonction des rapports des axes cristallins, les rapports de densité d’un corps qui passe nᵒ 1 du système trimétrique au système monométrique, nᵒ 2 du système monodimétrique au système monométrique, nᵒ 3 d’une forme monodimétrique à une autre forme monodimétrique."
                            },
                            {
                                "example_id": "490334c0-f586-46f4-8fa8-e797492d9bc8",
                                "sense_id": "a19ea02d-2684-3f8b-b0d2-543df6a9c68d",
                                "text": "Tous les cristaux sont classés en trois groupes distincts. Iᵉʳ groupe (monométrique), IIᵉ groupe (monodimétrique), IIIᵉ groupe (trimétrique). Ces groupes se subdivisent eux-mêmes en un ensemble de sept systèmes."
                            }
                        ]
                    },
