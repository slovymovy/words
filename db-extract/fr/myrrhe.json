        "fr-extract.jsonl": [
            {
                "entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                "word": "myrrhe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b46321e-5618-4b16-8bdd-205c948b050f",
                        "entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "tags": [
                            "plural"
                        ],
                        "form": "myrrhes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "glosses": [
                            "Gomme-résine aromatique qui vient de l’Arabie, produite par une burséracée du genre Commiphora."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41f48a30-38e9-4456-a2de-78baff899e74",
                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                "text": "Mais je sens une odeur de myrrhe qui est à donner la nausée."
                            },
                            {
                                "example_id": "00cb161d-798f-49f5-81c0-4c34b4573fb9",
                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                "text": "J’ai vu Constantinople étant petite fille,\nJe m’en souviens un peu,\nJe me souviens d’un vase où la myrrhe grésille\nEt d’un minaret bleu."
                            },
                            {
                                "example_id": "680e3413-9591-4347-a1f9-ef5aee534fc5",
                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                "text": "Et je me soûlerai de nard, d'encens, de myrrhe..."
                            },
                            {
                                "example_id": "48f62b00-df51-4709-93d3-44f2aa155f18",
                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                "text": "Adonis par l’escorce d'un arbre de myrrhe ?"
                            },
                            {
                                "example_id": "949e4849-9bf5-4157-89af-86ad3f6d28c4",
                                "sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                                "text": "On m’ouvrit la pierre qui fermait son tombeau et je pénétrai dans la cavité creusée dans la roche.\nLe parfum ravageur de la myrrhe empoissait l’air."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10411b42-28a0-48e6-9b49-dc246d15454d",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "source_sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "target_lang_word": "Myrrhe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Myrrhe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                        "entry_id": "81c200df-83d4-30ef-a36f-0abc4205bb73",
                                        "glosses": [
                                            "aus verschiedenen Bäumen des tropischen Afrika und Indien gewonnenes, wohlriechendes Gummiharz, das besonders als Mittel zum Räuchern und für Arzneien verwendet wird"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d357793-fa7c-4c09-a23a-006cfc17367e",
                                                "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                                "text": "„In ihrer Hand trägt sie ein goldenes Weihrauchfass aus dem der schwere Duft von Myrrhe und Weihrauch emporzusteigen scheint.“"
                                            },
                                            {
                                                "example_id": "64174775-e1ab-42b0-a3ed-a8cfbabe4621",
                                                "sense_id": "ace9d8c1-01ef-36ed-9f30-5249f234be75",
                                                "text": "„Wieder zerrieb Asmara die Myrrhe, kochte daraus einen Tee und flößte ihn mit großer Anstrengung dem ohnmächtigen Tarik ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2f79ead-d10b-4737-8c92-0c14e29ca69b",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "source_sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "target_lang_word": "myrrh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myrrh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "A red-brown resinous material, the dried sap of a tree of the species Commiphora myrrha, used as perfume, incense or medicine."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ded8765e-a2b7-4f0d-81fa-ad0de055ee9f",
                                                "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                                "text": "The glories of Mary held his soul captive: spikenard and myrrh and frankincense, symbolising the preciousness of God's gifts to her soul, rich garments, symbolising her royal lineage, her emblems, the lateflowering plant and lateblossoming tree, symbolising the agelong gradual growth of her cultus among men."
                                            },
                                            {
                                                "example_id": "8b782a06-3bc9-4552-a6d8-de50fcaafe17",
                                                "sense_id": "b3ca148c-5107-3411-9012-69d1b07f8795",
                                                "text": "A compound of eggs boiled with myrrh, pepper, and cinnamon, taken on several successive days, is recommended by Arabs for strengthening amorous vigor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33b081ed-3eca-3a10-b925-3babacd4c13e",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "Synonym of chrism."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08cf4c37-cff1-3c13-83ce-84725c7301a8",
                                        "entry_id": "79cd8817-0781-32bd-ba45-1dd0e53a2444",
                                        "glosses": [
                                            "The herb chervil."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25ffc707-7848-403b-be2a-6ddde832857b",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
                        "source_sense_id": "57c1b3ae-076d-3829-a091-31c84bde9d47",
                        "target_lang_word": "mirra",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirra",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f8861f3d-3c7c-3589-89b0-d9a9c8290d4c",
                                        "entry_id": "97b0948f-c2ea-3f30-bbe5-371af48ae403",
                                        "glosses": [
                                            "Gomorresina (jugo lechoso) rojiza, en forma de lágrimas y aromática, que se extrae del tallo de Commiphora abyssinica, árbol común en el Medio Oriente y Somalia. Se usa desde antaño como perfume y con propósitos medicinales y de culto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98096f1d-ae68-40ed-805c-9bd944d4f2a9",
                                                "sense_id": "f8861f3d-3c7c-3589-89b0-d9a9c8290d4c",
                                                "text": "hacía esta oración cuatro veces en cada día natural, que era al salir el sol, al mediodía, al ponerse y a la media noche, ofreciendo sahumerio de mirra y copal, y otros sahumerios aromáticos."
                                            },
                                            {
                                                "example_id": "6f10ab04-26dc-41d0-a99d-273738683ab9",
                                                "sense_id": "f8861f3d-3c7c-3589-89b0-d9a9c8290d4c",
                                                "text": "no busquemos los manjares exquisitos y delicados por solo la deleitación y el placer, ni los aromas, mirras y perfumes para engalanar un cuerpo que ha de convertirse en inmundo lodo."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968081c4-3e70-42df-80ee-45408a8c48ed",
                        "source_entry_id": "66238167-326a-332b-9a2e-88e90bc2fa15",
