                                        "glosses": [
                                            "The human soul, mind, or spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61cc1f9-13ec-46d6-b575-0634e0922eb2",
                                                "sense_id": "c99e9c32-da3a-3595-981f-a1d608a76f58",
                                                "text": "I've been driving in L.A. / And the world, it feels too big / Like a floating ball that's bound to break / Snap my psyche like a twig"
                                            },
                                            {
