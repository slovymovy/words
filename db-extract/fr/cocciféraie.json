                "senses": [
                    {
                        "sense_id": "999503ae-66b1-3c9f-8f0f-66cc700fc357",
                        "entry_id": "48bcdf37-a1af-3653-b405-c1c244fb5843",
                        "glosses": [
                            "Formation végétale de type garrigue, plantée principalement de chêne kermès."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "b51d1189-72a2-437d-b6e3-5921dbe53995",
                                "sense_id": "999503ae-66b1-3c9f-8f0f-66cc700fc357",
                                "text": "La cocciféraie, très résiduelle au Maroc et limitée à quelques zones septentrionales, est conceptualisée par le Chêne kermès et se manifeste en garrigue, ou se trouve subordonnée à d’autres essences"
                            },
                            {
                                "example_id": "072a8366-1dce-4eec-b897-0da7f1cf0a51",
                                "sense_id": "999503ae-66b1-3c9f-8f0f-66cc700fc357",
                                "text": "La cocciféraie ou la buxaie sur sols marneux mène souvent à la garrigue à romarin, lequel résiste mieux au déchaussement grâce à sa forte racine pivotante."
                            },
                            {
                                "example_id": "16ebeabe-4b7b-4024-a897-2d1b0518c7ec",
                                "sense_id": "999503ae-66b1-3c9f-8f0f-66cc700fc357",
                                "text": "En ce qui concerne la flore, la zone environnante de la réserve représente une formation relique d’une cocciféraie."
                            }
                        ]
                    }
                ],
