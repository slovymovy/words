                "senses": [
                    {
                        "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                        "entry_id": "37d018e1-01ac-3294-ae31-9d08ac769e0a",
                        "glosses": [
                            "Übertragung von Lernergebnissen eines Gebiets auf ein ähnliches anderes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa095284-cfde-4b6e-9352-a5b96db3e761",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„Wenn man in der Lage ist, eine Erkenntnis zu übertragen, dann heißt das: Lerntransfer.“"
                            },
                            {
                                "example_id": "4a5c0be9-63dc-4383-bda6-ee1b23c0a0de",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„Die Lernpsychologie als Wissenschaft vom Lernen sieht den Lerntransfer als zwar nicht zwingenden, aber entsprechend dem Intelligenzgrad wahrscheinlichen Begleitvorgang des Lernens.“"
                            },
                            {
                                "example_id": "d9882ac1-bedb-4e5b-acae-5b0778b20bcd",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„Lerntransfer ist für die Kompetenzentwicklung eine wesentliche Voraussetzung, ohne die eine Weiterentwicklung nicht stattfinden kann.“"
                            },
                            {
                                "example_id": "d74c2735-8475-4c16-826a-af5c141268b8",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„Lerntransfer wird begünstigt, indem Lern- und Arbeitsumgebung sich so weit wie möglich ähneln.“"
                            },
                            {
                                "example_id": "1ac41b17-33d8-4abc-9a63-b68969dbeebf",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„Die Forscher bezeichnen die Möglichkeit, das Gelernte in einer neuen, anderen Situation anzuwenden als Lerntransfer.“"
                            },
                            {
                                "example_id": "80e086ea-3c41-4fea-98e8-0b73c79bf5c2",
                                "sense_id": "61042231-4327-386e-ab0b-b57c6e5cee4b",
                                "text": "„An den Unis fehle genau dieser Lerntransfer leider häufig, sagt Bavelier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
