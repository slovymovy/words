                        "glosses": [
                            "Bauteil (Gestell), an dem eine Schaukel angebracht ist/werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d05f0f1d-7538-42fe-8ef9-83fa605a0721",
                                "sense_id": "67ac69a5-2768-3265-b109-273dae8c44f6",
                                "text": "„Hätte sie sich nicht noch am Schaukelgestelle halten können, so wäre sie abgestürzt und hätte auch noch Jadeturm mitheruntergezogen.“"
                            },
                            {
                                "example_id": "289974ea-ffc4-43a3-99c5-cdf0bd308a1c",
                                "sense_id": "67ac69a5-2768-3265-b109-273dae8c44f6",
                                "text": "„Auf einem Lastkraftwagen kam ein großes Schaukelgestell für uns, aus Metall.“"
                            }
                        ],
