                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final goal helped <w>cinch</w> the victory for the team.",
                            "target_lang_translations": {
                                "cs": "Poslední gól pomohl týmu <w>zajistit</w> vítězství."
                            }
