                                    },
                                    {
                                        "sense_id": "a867cf24-7e38-3880-a418-ef80af5461bc",
                                        "entry_id": "4fc8c848-c8e3-3b25-89ee-2c2a716be2be",
                                        "glosses": [
                                            "A stocking-like garment worn on the legs; pantyhose, women's tights."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f2415c6-68f2-3113-be50-4e26a7c95ce8",
                                        "entry_id": "4fc8c848-c8e3-3b25-89ee-2c2a716be2be",
                                        "glosses": [
                                            "Close-fitting trousers or breeches, reaching to the knee."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ea2e5b-3f49-4898-8b9d-7c72b0ded921",
                                                "sense_id": "5f2415c6-68f2-3113-be50-4e26a7c95ce8",
                                                "text": "Theſe men were bound in their coates, their hoſen, and their hats, and their other garments, and were caſt into the midſt of the burning fierie furnace."
                                            },
                                            {
                                                "example_id": "5c1758c7-ab45-4043-b350-9ecff66a8223",
                                                "sense_id": "5f2415c6-68f2-3113-be50-4e26a7c95ce8",
                                                "text": "His youthful hoſe, vvell ſaved, a vvorld too vvide / For his ſhrunk ſhank, […]"
                                            },
                                            {
                                                "example_id": "733a463f-a173-4167-9b9d-8a1e8ba2e86b",
                                                "sense_id": "5f2415c6-68f2-3113-be50-4e26a7c95ce8",
                                                "text": "[T]wenty yeomen, two and two, / In hosen black, and jerkins blue, / With falcons broider'd on each breast, / Attended on their lord's behest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc57aa1a-7912-3b81-a32a-aaa135fd62ca",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To water or spray with a hose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "459a4643-46c4-4559-aad1-f38221cde5bd",
                                                "sense_id": "bc57aa1a-7912-3b81-a32a-aaa135fd62ca",
                                                "text": "Only days before the garden opens, the concrete is hosed down with a high-pressure jet and scrubbed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db7a93e0-70cd-339d-b373-bf9d52713bb6",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To spray as if with a hose; to spray in great quantity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65a887db-c9e1-4804-a05c-6481d46a8a01",
                                                "sense_id": "db7a93e0-70cd-339d-b373-bf9d52713bb6",
                                                "text": "His guns hosed down the vessel's decks, sweeping them clear of sailors, blowing holes in the bulkheads, and smashing gun positions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc08d44-dd7e-3a86-9be2-076389f3e8ef",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To deliver using a hose."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc99b287-3244-4585-bdc0-0dfec81fa7df",
                                                "sense_id": "ccc08d44-dd7e-3a86-9be2-076389f3e8ef",
                                                "text": "He had just finished hosing gasoline into his tank, a short man, burly, needing a shave, and wearing greasy coveralls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1259d7d1-9a5d-37a1-a58f-86881357dcaf",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To provide with hose (garment)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "020c539c-c4b5-4417-91a2-323318d79fed",
                                                "sense_id": "1259d7d1-9a5d-37a1-a58f-86881357dcaf",
                                                "text": "The mighty mass of many a mingled race,\nWho dwell in towns where he pursued the chase;\nThe men degenerate shirted, cloaked, and hosed-\nNose and eyes only to the day exposed"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0522f331-4f5a-36c4-a1ac-0755ce8f20a5",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To trick or deceive."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3866956-a4cb-43f0-80fd-212a6be26495",
                                                "sense_id": "0522f331-4f5a-36c4-a1ac-0755ce8f20a5",
                                                "text": "Bartlett elaborated on what had happened at the warehouse, saying he thought Chandar was supposed to have advised, not hosed him."
                                            },
                                            {
                                                "example_id": "695eeea1-f81b-44dd-81de-e37fd2f9e89a",
                                                "sense_id": "0522f331-4f5a-36c4-a1ac-0755ce8f20a5",
                                                "text": "Poutine? A better McMuffin? A bigger Big Mac?? We've been hosed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d8c76a-ae2f-3e12-b2d3-a32aa269ae40",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To break or destroy (a system), especially by wiping files or other content."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff5a596-c4c6-440d-b87a-337d310023b5",
                                                "sense_id": "c5d8c76a-ae2f-3e12-b2d3-a32aa269ae40",
                                                "text": "There aren't any tricky hexadecimal calculations to snare your brain, nor is there a need to worry about hosing the registry for all eternity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df470147-c55c-39a4-adfa-ff21a8442695",
                                        "entry_id": "d563fc89-6dba-321e-877b-7528b6859313",
                                        "glosses": [
                                            "To cause an unfair disadvantage to a player or team through poor officiating; especially, to cause a player or team to lose the game with an incorrect call."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
