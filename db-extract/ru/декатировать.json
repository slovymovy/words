                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8dce4085-7805-3568-9a23-13dae78bff66",
                                        "entry_id": "0400af71-d0e6-35a1-9df7-d06816d2f31c",
                                        "glosses": [
                                            "bestimmte Gefühle, Emotionen abschwächen, weniger intensiv machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c354985c-c611-4d24-9d49-cf6488486bbc",
                                                "sense_id": "8dce4085-7805-3568-9a23-13dae78bff66",
                                                "text": "Die Nachricht vom Abstieg seiner Lieblingsmannschaft dämpfte Karls Freude über das schöne Wetter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
