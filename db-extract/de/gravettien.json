                        "entry_id": "561afa80-7042-3b16-aaee-589d4ba21087",
                        "glosses": [
                            "die wichtigste Kulturstufe des mittleren Jungpaläolithikums von etwa 28.000 bis 22.000 Jahren vor heute"
                        ],
                        "tags": [
                            "Vor- und Frühgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "e7b5699e-b4b2-4968-982a-f710bf545f1b",
                                "sense_id": "435783fb-61f1-39ab-a1ba-8369f12c1b1f",
                                "text": "„Um 30.000 vor heute endete das Aurignacien und wurde durch das Gravettien abgelöst.“"
                            },
                            {
                                "example_id": "da08e153-33c3-4759-a2f9-4270f1f121a1",
                                "sense_id": "435783fb-61f1-39ab-a1ba-8369f12c1b1f",
                                "text": "„Jäger und Sammler des Gravettiens haben ihre Spuren in weiten Teilen Europas und bis nach Sibirien hinterlassen.“"
                            },
                            {
                                "example_id": "74a7561b-421e-451c-af77-2e7bca588d95",
                                "sense_id": "435783fb-61f1-39ab-a1ba-8369f12c1b1f",
                                "text": "„Charakteristisch für den jüngeren Abschnitt des Gravettiens (ca. 25.000-22.000 BP) sind Frauenstatuetten, veraltet als Venusfigurinen bezeichnet.“"
                            }
