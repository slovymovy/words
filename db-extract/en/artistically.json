                "translations": [
                    {
                        "translation_id": "c10a0395-6e8b-4dc0-baaa-5d6efd9650c4",
                        "source_entry_id": "e15e15a2-c794-36e1-86cb-e109c874353c",
                        "source_sense_id": "d490ea46-c720-3912-bbd1-17841f8057d4",
                        "source_sense_description": "In an artistic manner",
                        "target_lang_word": "artistiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artistiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "734b8234-a090-3e43-aaf7-ca9fe4d2b510",
                                        "entry_id": "2d54246f-34c8-3198-81c2-e7e11c103272",
                                        "glosses": [
                                            "De manière artistique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5ddd8b-c78e-4ce7-aa0b-1bf991687a98",
                                                "sense_id": "734b8234-a090-3e43-aaf7-ca9fe4d2b510",
                                                "text": "Dans la mesure où ce changement ne serait ni montré ni incarné artistiquement dans l’action même, il s’éloignerait de l’art et se rapprocherait du rite."
                                            },
                                            {
                                                "example_id": "952601af-438d-4de4-80d7-70f3ce053fc2",
                                                "sense_id": "734b8234-a090-3e43-aaf7-ca9fe4d2b510",
                                                "text": "Les fougasses, les panini et les salades de fruits aux couleurs vives étaient artistiquement disposés sur des plateaux, formant une splendide composition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37f67762-9788-4e18-84fb-eee6f3e4e498",
                        "source_entry_id": "e15e15a2-c794-36e1-86cb-e109c874353c",
                        "source_sense_id": "d490ea46-c720-3912-bbd1-17841f8057d4",
                        "source_sense_description": "In an artistic manner",
                        "target_lang_word": "artistement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artistement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                        "entry_id": "7c8c5eb4-b799-3b9e-b654-8854c62cb2cd",
                                        "glosses": [
                                            "Avec art ; avec habileté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d96baf3-d46e-4c3f-b9be-da081d1fd261",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "Les crins sont artistement faits, car il faut ou élargir le membre trop grêle ou déguiser l’arqure acquise ou innée ; […]."
                                            },
                                            {
                                                "example_id": "60df4816-a5c8-4db1-b022-d59595e1d3d8",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "Il est a voir comment à Paris le pilori des grandes halles est artistement disposé pour contraindre le pilorié à montrer sa face à la foule, accourue pour le huer, l'injurier, remplir le vœu de la loi."
                                            },
                                            {
                                                "example_id": "c7027f54-c84f-48c9-808b-c5281e3d2bef",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "D'autres plus badins comparent l’évidence à une lanterne magique, qui, au moyen de quelques rayons de lumière artistement dirigés dans les ténébres, donne un air de dignité à des tableaux, qui, remis au grand jour, ne présentent plus que le barbouillage d'un mauvais peintre."
                                            },
                                            {
                                                "example_id": "dcdadab5-4189-4fc5-8e74-e5e6c0b4338f",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "Par la fenêtre de la salle de bains artistement aménagée, il jette un regard sur le jardin…"
                                            },
                                            {
                                                "example_id": "8dcfa0a0-3646-48ab-a8ac-6958ddfa9d34",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "Regardons le latin comme un superbe édifice détruit par le temps, mais dont les pierres artistement retaillées ont servi à construire un nouvel édifice."
                                            },
                                            {
                                                "example_id": "ec668172-ff59-473b-a0fe-ca241c649544",
                                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                                "text": "Il vous mène à l’arbre, cueille artistement cette prune exquise, il l’ouvre…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01828857-c1ad-44b4-bfc0-3a79c4df3523",
                        "source_entry_id": "e15e15a2-c794-36e1-86cb-e109c874353c",
                        "source_sense_id": "d490ea46-c720-3912-bbd1-17841f8057d4",
                        "source_sense_description": "In an artistic manner",
                        "target_lang_word": "künstlerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "künstlerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d51fd6eb-7bb2-3c30-9f0a-8cc60e818e53",
                                        "entry_id": "703206ef-a259-35af-b1b1-71ac7d0fb599",
                                        "glosses": [
                                            "in Bezug auf die Kunst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c1cf8f-a265-4542-ac01-193e630c5751",
                                                "sense_id": "d51fd6eb-7bb2-3c30-9f0a-8cc60e818e53",
                                                "text": "Ein Bild mit künstlerischem Wert."
                                            },
                                            {
                                                "example_id": "5c6699e2-4165-4560-8c6b-cc3d8c4fac07",
                                                "sense_id": "d51fd6eb-7bb2-3c30-9f0a-8cc60e818e53",
                                                "text": "„Bei Zirkusakrobaten, Kunstturnern, Eiskunstläufern, Kunstfliegern werden Vertigoerlebnisse Teil einer künstlerischen Gesamtleistung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
