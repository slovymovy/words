{
    "word_family": [
        "pozdrowienie",
        "pozdrowić"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7573756f-ca09-3dc1-88a0-f4ffc6689e50",
                    "sense_definition": "kierować do kogoś słowa powitania, gest powitalny lub ukłon przy spotkaniu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sąsiad zawsze uśmiecha się i uprzejmie <w>pozdrawia</w> nas na klatce schodowej.",
                            "target_lang_translations": {
                                "ru": "Сосед всегда улыбается и вежливо <w>здоровается</w> с нами на лестничной площадке."
                            }
                        },
                        {
                            "text": "Kiedy szedłem rano do pracy, z daleka <w>pozdrawiałem</w> znajomych machaniem ręki.",
                            "target_lang_translations": {
                                "ru": "Когда я шёл утром на работу, я издалека <w>приветствовал</w> знакомых взмахом руки."
                            }
                        }
                    ],
                    "synonyms": [
                        "witać"
                    ],
                    "common_phrases": [
                        "serdecznie pozdrawiać",
                        "pozdrawiać ruchem ręki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обращаться к кому-либо со словами приветствия, жестом или поклоном при встрече."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "обращаться с приветствием при встрече"
                            },
                            {
                                "target_lang_word": "здороваться",
                                "target_lang_sense_clarification": "приветствовать при встрече"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "375a2eab-fc68-3fdb-87dd-66bd527b051b",
                    "sense_definition": "przesyłać komuś życzenia, pamięć lub wyrazy szacunku, na przykład w liście lub przez inną osobę",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Piszę tę krótką wiadomość z wakacji i gorąco cię <w>pozdrawiam</w> z gór.",
                            "target_lang_translations": {
                                "ru": "Пишу это короткое сообщение из отпуска и <w>шлю</w> тебе горячий <w>привет</w> из гор."
                            }
                        },
                        {
                            "text": "Moja mama bardzo cię polubiła i zawsze ciepło cię <w>pozdrawia</w> w rozmowach.",
                            "target_lang_translations": {
                                "ru": "Ты очень понравился моей маме, и она всегда тепло <w>передаёт</w> тебе <w>привет</w> в разговорах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ciepło pozdrawiać",
                        "gorąco pozdrawiać"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать кому-либо привет, пожелания или дань уважения (например, в письме или через знакомых)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать привет",
                                "target_lang_sense_clarification": "шлёт пожелания, приветствия"
                            },
                            {
                                "target_lang_word": "слать привет",
                                "target_lang_sense_clarification": "в письмах или сообщениях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}