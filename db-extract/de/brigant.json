                    {
                        "translation_id": "e36fa547-6b95-4179-90ac-2c9354205094",
                        "source_entry_id": "31c44a32-e1d6-3b1b-b6ff-75392d44b5a9",
                        "source_sense_id": "d83d9a5c-afa4-34bf-9c6d-813eeb7d7a84",
                        "source_sense_description": "jemand, der (auf der Straße) raubt",
                        "target_lang_word": "brigand",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
