{
    "word_family": [
        "mild",
        "mildness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "70166a4c-6666-3845-aae9-50d1bf5efbe3",
                    "sense_definition": "To a slight or moderate degree; slightly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was only <w>mildly</w> interested in the lecture, but I stayed until the end.",
                            "target_lang_translations": {
                                "ru": "Лекция была мне лишь <w>слегка</w> интересна, но я остался до конца."
                            }
                        },
                        {
                            "text": "To put it <w>mildly</w>, we were extremely disappointed with the final result.",
                            "target_lang_translations": {
                                "ru": "<w>Мягко</w> говоря, мы были крайне разочарованы окончательным результатом."
                            }
                        }
                    ],
                    "synonyms": [
                        "slightly",
                        "moderately",
                        "somewhat"
                    ],
                    "antonyms": [
                        "extremely",
                        "intensely",
                        "greatly"
                    ],
                    "common_phrases": [
                        "put it mildly",
                        "to put it mildly",
                        "mildly amused",
                        "mildly surprising"
                    ],
                    "target_lang_definitions": {
                        "ru": "В незначительной, умеренной степени; слегка, немного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слегка",
                                "target_lang_sense_clarification": "в незначительной степени"
                            },
                            {
                                "target_lang_word": "немного",
                                "target_lang_sense_clarification": "чуть-чуть"
                            },
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "в выражении «мягко говоря»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac7b343-5f73-3415-b6c9-8c782ce9c4a0",
                    "sense_definition": "In a gentle, calm, or temperate manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Please don't worry about it,\" she said <w>mildly</w>.",
                            "target_lang_translations": {
                                "ru": "«Пожалуйста, не беспокойтесь об этом», — <w>мягко</w> сказала она."
                            }
                        },
                        {
                            "text": "The teacher smiled <w>mildly</w> and answered each of the students' questions.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>мягко</w> улыбнулся и ответил на каждый вопрос учеников."
                            }
                        }
                    ],
                    "synonyms": [
                        "gently",
                        "calmly",
                        "softly"
                    ],
                    "antonyms": [
                        "harshly",
                        "angrily",
                        "severely"
                    ],
                    "common_phrases": [
                        "speak mildly",
                        "smile mildly",
                        "protest mildly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кротко, спокойно или доброжелательно; без резкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягко",
                                "target_lang_sense_clarification": "не резко, спокойно"
                            },
                            {
                                "target_lang_word": "кротко",
                                "target_lang_sense_clarification": "тихо и беззлобно"
                            },
                            {
                                "target_lang_word": "спокойно",
                                "target_lang_sense_clarification": "сдержанно и мирно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}