                                        "entry_id": "e0a2668b-64ea-3fc1-b652-7a3314995930",
                                        "glosses": [
                                            "A public official who presides over an inquest into unnatural deaths, and who may have (or historically had) additional powers such as investigating cases of treasure trove."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "Japan"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13a1c9c-4c47-4a0e-8788-9fdcd7077054",
                                                "sense_id": "8b24d7f3-7f6b-3783-8227-85a3671dd30c",
                                                "text": "The coroner confirmed the cause of death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8251be56-9e5b-3832-ad24-0e0444ab4c91",
                                        "entry_id": "e0a2668b-64ea-3fc1-b652-7a3314995930",
                                        "glosses": [
                                            "A medical doctor who performs autopsies and determines time and cause of death from a scientific standpoint."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85328744-4b8b-444e-8500-7908d79bfb70",
                                                "sense_id": "8251be56-9e5b-3832-ad24-0e0444ab4c91",
                                                "text": "A report from the coroner was presented in court."
                                            }
                                        ]
                                    },
