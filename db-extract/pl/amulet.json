                                        "sense_id": "12d1b204-79f7-3ca6-ab9c-3944b72b702e",
                                        "entry_id": "e2ea91b3-f63c-3c66-94dd-87dcab170c65",
                                        "glosses": [
                                            "A religious article, protective charm, or ornament, usually bearing cultural or magical symbols, worn for protection against ill will, negative influences, or evil spirits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abecd47a-1eaf-41dc-adea-e3c012d23c47",
                                                "sense_id": "12d1b204-79f7-3ca6-ab9c-3944b72b702e",
                                                "text": "The soldier wore an amulet for protection."
                                            },
                                            {
                                                "example_id": "d2cb4010-980a-450f-b3d5-e389d8d2406b",
                                                "sense_id": "12d1b204-79f7-3ca6-ab9c-3944b72b702e",
                                                "text": "An ancient amulet was discovered in the ruins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7498c90-2323-49e6-99e3-4774d2ccabac",
                        "source_entry_id": "f141ed70-fc9c-3d2b-a7ee-c8790fbef44f",
                        "source_sense_id": "8b9e1dfe-3a24-3284-ac69-4b7f8457b15c",
