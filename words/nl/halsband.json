{
    "word_family": [
        "hals",
        "band",
        "halsbandparkiet"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7dde13e-6c79-3627-8bad-628b116fbf75",
                    "sense_definition": "een band die om de nek van een dier, zoals een hond of kat, wordt gedragen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nekband",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het baasje deed de hond zijn <w>halsband</w> om en ze gingen een stuk wandelen.",
                            "target_lang_translations": {
                                "en": "The owner put the dog's <w>collar</w> on and they went for a walk.",
                                "ru": "Хозяин надел на собаку <w>ошейник</w>, и они отправились на прогулку."
                            }
                        },
                        {
                            "text": "Aan de <w>halsband</w> van de kat hangt een klein zilveren belletje.",
                            "target_lang_translations": {
                                "en": "A small silver bell hangs from the cat's <w>collar</w>.",
                                "ru": "На <w>ошейнике</w> кошки висит маленький серебряный колокольчик."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leren halsband",
                        "halsband omdoen"
                    ],
                    "target_lang_definitions": {
                        "en": "a band worn around the neck of an animal, such as a dog or cat",
                        "ru": "ремень или лента, которую носят на шее животного, например собаки или кошки"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "for an animal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ошейник",
                                "target_lang_sense_clarification": "для животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e06cc13-bb7b-3a37-8799-685e753775c7",
                    "sense_definition": "een sieraad dat om de hals wordt gedragen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sieraad",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij droeg een prachtige gouden <w>halsband</w> bij haar nieuwe avondjurk.",
                            "target_lang_translations": {
                                "en": "She wore a beautiful golden <w>necklace</w> with her new evening gown.",
                                "ru": "К своему новому вечернему платью она надела великолепное золотое <w>ожерелье</w>."
                            }
                        },
                        {
                            "text": "Deze <w>halsband</w> met diamanten is een kostbaar erfstuk van mijn grootmoeder.",
                            "target_lang_translations": {
                                "en": "This diamond <w>necklace</w> is a precious heirloom from my grandmother.",
                                "ru": "Это бриллиантовое <w>колье</w> — ценная семейная реликвия моей бабушки."
                            }
                        }
                    ],
                    "synonyms": [
                        "halsketting"
                    ],
                    "common_phrases": [
                        "gouden halsband"
                    ],
                    "target_lang_definitions": {
                        "en": "a piece of jewelry worn around the neck",
                        "ru": "украшение, которое носят на шее"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "necklace",
                                "target_lang_sense_clarification": "general jewelry"
                            },
                            {
                                "target_lang_word": "choker",
                                "target_lang_sense_clarification": "tight-fitting necklace"
                            },
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "heavy or wide decorative neckpiece"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ожерелье",
                                "target_lang_sense_clarification": "общее украшение"
                            },
                            {
                                "target_lang_word": "колье",
                                "target_lang_sense_clarification": "драгоценное украшение"
                            },
                            {
                                "target_lang_word": "чокер",
                                "target_lang_sense_clarification": "плотно прилегающее украшение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3f712cf-b9f6-350a-8276-6dc502e7551d",
                    "sense_definition": "een natuurlijke, bandvormige tekening in de vacht of het verendek rond de nek van een dier",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tekening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogel is herkenbaar aan de zwarte <w>halsband</w> in zijn veren.",
                            "target_lang_translations": {
                                "en": "The bird is recognizable by the black <w>collar</w> in its feathers.",
                                "ru": "Птицу можно узнать по черному <w>ошейнику</w> в ее оперении."
                            }
                        },
                        {
                            "text": "Sommige hondenrassen hebben een witte <w>halsband</w> in hun donkere vacht.",
                            "target_lang_translations": {
                                "en": "Some dog breeds have a white <w>collar</w> in their dark fur.",
                                "ru": "У некоторых пород собак на темной шерсти есть белый <w>ошейник</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witte halsband"
                    ],
                    "target_lang_definitions": {
                        "en": "a natural, band-shaped marking in the fur or plumage around the neck of an animal",
                        "ru": "естественный рисунок в виде полосы на шерсти или оперении вокруг шеи животного"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "natural marking on an animal"
                            },
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "marking around the neck"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ошейник",
                                "target_lang_sense_clarification": "окрас животного"
                            },
                            {
                                "target_lang_word": "кольцо",
                                "target_lang_sense_clarification": "полоса вокруг шеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2acfed4a-e5e9-35fe-a9d6-a559d7786c99",
                    "sense_definition": "een metalen ring of band om de nek om een persoon gevangen te houden of te beperken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nekband",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de middeleeuwse kerker werden gevangenen met een ijzeren <w>halsband</w> aan de muur geketend.",
                            "target_lang_translations": {
                                "en": "In the medieval dungeon, prisoners were chained to the wall with an iron <w>collar</w>.",
                                "ru": "В средневековом подземелье узников приковывали к стене железным <w>ошейником</w>."
                            }
                        },
                        {
                            "text": "De slaaf droeg een zware <w>halsband</w> als teken van zijn onderwerping.",
                            "target_lang_translations": {
                                "en": "The slave wore a heavy <w>collar</w> as a sign of his submission.",
                                "ru": "Раб носил тяжелый <w>ошейник</w> как знак своего подчинения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ijzeren halsband"
                    ],
                    "target_lang_definitions": {
                        "en": "a metal ring or band around the neck used to keep a person captive or restricted",
                        "ru": "металлическое кольцо или лента на шее для удержания человека в плену или ограничения его свободы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "collar",
                                "target_lang_sense_clarification": "restraint for a person"
                            },
                            {
                                "target_lang_word": "iron collar",
                                "target_lang_sense_clarification": "historical restraint"
                            },
                            {
                                "target_lang_word": "shackle",
                                "target_lang_sense_clarification": "neck restraint"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ошейник",
                                "target_lang_sense_clarification": "для пленника или раба"
                            },
                            {
                                "target_lang_word": "шейное кольцо",
                                "target_lang_sense_clarification": "металлический обруч"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}