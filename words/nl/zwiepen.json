    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34f88b38-ab4a-3384-97bf-53452e677373",
                    "sense_definition": "Veerkrachtig heen en weer bewegen of doorbuigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takken <w>zwiepen</w> heen en weer door de harde wind.",
                            "target_lang_translations": {
                                "en": "The branches <w>sway</w> back and forth in the strong wind."
                            }
                        },
                        {
                            "text": "De lange hengel bleef gevaarlijk heen en weer <w>zwiepen</w> tijdens het vissen.",
                            "target_lang_translations": {
                                "en": "The long fishing rod kept <w>swaying</w> dangerously back and forth during fishing."
                            }
                        }
                    ],
                    "synonyms": [
                        "swingen",
                        "zwiepen"
                    ],
                    "common_phrases": [
                        "heen en weer zwiepen"
                    ],
                    "target_lang_definitions": {
                        "en": "To sway back and forth or bend flexibly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sway",
                                "target_lang_sense_clarification": "move back and forth"
                            },
                            {
                                "target_lang_word": "swing",
                                "target_lang_sense_clarification": "move or bend dynamically"
                            },
                            {
                                "target_lang_word": "whip",
                                "target_lang_sense_clarification": "flexible fast motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d12330b9-3ead-30d7-b522-c9c08dc2d6f3",
                    "sense_definition": "Iets of iemand met een snelle, krachtige zwaai verplaatsen of gooien",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kan de bal ver weg <w>zwiepen</w> met zijn nieuwe racket.",
                            "target_lang_translations": {
                                "en": "He can <w>whip</w> the ball far away with his new racket."
                            }
                        },
                        {
                            "text": "De man werd door een sterke golf hard tegen de boot <w>gezwiept</w>.",
                            "target_lang_translations": {
                                "en": "The man was <w>flung</w> hard against the boat by a strong wave."
                            }
                        }
                    ],
                    "synonyms": [
                        "gooien",
                        "slingeren"
                    ],
                    "common_phrases": [
                        "weg zwiepen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or throw something or someone with a quick, powerful swing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fling",
                                "target_lang_sense_clarification": "throw forcefully"
                            },
                            {
                                "target_lang_word": "whip",
                                "target_lang_sense_clarification": "move or lash with a swing"
                            },
                            {
                                "target_lang_word": "sling",
                                "target_lang_sense_clarification": "hurl or throw"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19e0812d-643a-3f4c-a71b-2f8e321c697f",
                    "sense_definition": "Meervoud van <w>zwiep</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zweep gaf een paar harde <w>zwiepen</w> door de lucht.",
                            "target_lang_translations": {
                                "en": "The whip made a few sharp <w>swishes</w> through the air."
                            }
                        },
                        {
                            "text": "Met enkele krachtige <w>zwiepen</w> sloeg de tak tegen het raam.",
                            "target_lang_translations": {
                                "en": "With a few powerful <w>lashes</w>, the branch hit the window."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of zwiep (swishing or whipping motions)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swishes",
                                "target_lang_sense_clarification": "plural of a swishing motion"
                            },
                            {
                                "target_lang_word": "lashes",
                                "target_lang_sense_clarification": "plural of a whipping motion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
