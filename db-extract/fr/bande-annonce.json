                                    {
                                        "sense_id": "436bb371-05c3-3d36-9ff6-e87ba3220ffd",
                                        "entry_id": "4aa7dba0-401c-3470-98a6-25e8305fe644",
                                        "glosses": [
                                            "Ausblick auf kommende Programme oder Veranstaltungen"
                                        ],
                                        "tags": [
                                            "Plural selten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a61e5176-0c0d-45c5-99be-f8a3aecd33de",
                                                "sense_id": "436bb371-05c3-3d36-9ff6-e87ba3220ffd",
                                                "text": "Das Fernsehen zeigt zwischen den Sendungen eine Vorschau auf kommende Blockbuster und das Hauptabendprogramm."
                                            },
                                            {
                                                "example_id": "7e1c3157-06fa-4fc1-add7-a067c5e7dd08",
                                                "sense_id": "436bb371-05c3-3d36-9ff6-e87ba3220ffd",
                                                "text": "Vor dem eigentlichen Kinofilm gibt es eine Vorschau zu anderen kommenden Filmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "685c8e2f-d76c-4a99-b470-e578662f0dbe",
                        "source_entry_id": "21ed7403-5946-39e8-8330-6e88ad200fe2",
                        "source_sense_id": "1faa7fda-a57f-3530-90cc-2db50be959e9",
                        "source_sense_description": "Séquence vidéo promotionnelle",
