                    {
                        "translation_id": "3c6a964b-a2f7-4fc3-a8d2-34e75b13e916",
                        "source_entry_id": "ad959dae-7974-3278-8f87-cbd7e95e2144",
                        "source_sense_description": "spirit, courage, force of character",
                        "target_lang_word": "Mumm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mumm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                        "entry_id": "3b3688a6-8821-36a9-ab68-974817209229",
                                        "glosses": [
                                            "Mut"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad6ad0bc-8293-4fbf-a197-6936bf83b427",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "„»Sarkozy ist am Ende«, jubelte Villepin dann auch auf dem Höhepunkt der Affäre. »Wenn die Zeitungen ihre Arbeit tun, wenn sie Mumm haben, dann wird er diese Affäre nicht überleben.«“"
                                            },
                                            {
                                                "example_id": "e2ea5ad3-74d6-4385-a272-415de254c5ad",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "Der hat noch Mumm in den Knochen!"
                                            },
                                            {
                                                "example_id": "baa332db-40ec-463c-befe-601a7008e5be",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "„Sie haben Mumm. Im bayerischen Innenministerium haben am Freitag 27 mutige Menschen die Courage-Medaille verliehen bekommen.“"
                                            },
                                            {
                                                "example_id": "fd6ccc42-3735-4fdf-b40f-dae02e4d7dcd",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "„»Alle wissen, was zu tun wäre, aber keiner hat den Mumm dazu.«“"
                                            },
                                            {
                                                "example_id": "4f5497d5-f687-437c-a4c1-7fc9927a8abd",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "„»Hört zu, Männer von Baltimore, falls ihr welche seid: Wer von euch hat den Mumm, Stonehand gegenüber zu treten und ihn zum elften Mal zu besiegen? Zehn Kämpfe sind angesetzt! Zehn Versuche habt ihr also!«“"
                                            },
                                            {
                                                "example_id": "79063f62-36cf-465a-8017-7befded78ada",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "„Die Raffinesse des neu entdeckten Tunnels zeige die Entschlossenheit und die finanziellen Mittel mexikanischer Drogenkartelle. »Wir dachten nie wirklich, dass sie den Mumm haben, so weit zu gehen«, sagte Lance LeNoir, Beauftragter für Grenzpatrouilleneinsätze.“"
                                            },
                                            {
                                                "example_id": "2aa40888-1777-4a8a-af01-7f1053eff394",
                                                "sense_id": "b3920e64-8815-303c-8de8-5bfdb230699f",
                                                "text": "[Coronapandemie 2020:] „Die Regierungen von Bund und Ländern haben von den Leuten die Verantwortung übertragen bekommen – und nun müssen sie den Mumm haben, zu handeln, selbst wenn das gegen die Befindlichkeit des Augenblicks ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4fafe53-0555-30c6-854f-f747002f1717",
                                        "entry_id": "3b3688a6-8821-36a9-ab68-974817209229",
                                        "glosses": [
                                            "körperliche Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44595009-bf71-48fa-8cc8-85ea3e3e5f85",
                                                "sense_id": "a4fafe53-0555-30c6-854f-f747002f1717",
                                                "text": "»Herrgott, der hat vielleicht Mumm,« bemerkte Prince. »Drei Stunden Schlaf nach fünfundsiebzig Meilen mit den Hunden und dann wieder auf die Strecke.«"
                                            },
                                            {
                                                "example_id": "f4f3b583-450e-4d61-8e1f-90fc11d24d19",
                                                "sense_id": "a4fafe53-0555-30c6-854f-f747002f1717",
                                                "text": "Du machst dir nichts aus Gefahr und Abenteuer, und du machst dir auch nichts aus Jungens, die Mumm und Mut haben und was riskieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mumm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                        "entry_id": "d9a8caee-d29c-3acb-9a0f-0a06c82782db",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9bb645-3c23-40cd-ac81-17b87777b149",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Frau Mumm ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "1a152546-0ec2-405f-aa48-2944228ee1f3",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Herr Mumm wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "e0721bde-02a6-4444-9e16-a3c48c852201",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Die Mumms fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "7b025823-4cf7-426e-9acd-6130c7027fc5",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Der Mumm trägt nie die Schals, die die Mumm ihm strickt."
                                            },
                                            {
                                                "example_id": "b2db80c8-9e3e-46b8-ab1c-13df1d8ab323",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mumm kommt, geht der Herr Mumm.“"
                                            },
                                            {
                                                "example_id": "d689b6b0-26d9-4ea3-abbc-5caa3120f879",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Mumm kommt und geht."
                                            },
                                            {
                                                "example_id": "be02e1b5-210d-44ad-a2ef-456e3cb07cfb",
                                                "sense_id": "b7d24d19-f802-3d14-8828-1e37ad973e10",
                                                "text": "Mumms kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e6cf18d-8744-4083-892b-dcfe9c9a5929",
