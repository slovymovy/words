                                "example_id": "d00ce06a-51b2-4545-825c-b792c9328c6b",
                                "sense_id": "9874c9af-1013-38a3-bae7-814630e89ece",
                                "text": "stealthy military manoeuvres"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "698a075e-d68a-415b-a16d-c14243c3c72c",
                        "source_entry_id": "94ace0d2-d1ba-32ca-842c-914cd8d6c0ea",
                        "source_sense_id": "9874c9af-1013-38a3-bae7-814630e89ece",
                        "source_sense_description": "characterized by or resembling stealth or secrecy",
                        "target_lang_word": "furtif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furtif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43da50b6-bb97-3df4-b4d6-47da73672b86",
                                        "entry_id": "5fafb08c-ab88-31b6-a823-2ad94482484f",
                                        "glosses": [
                                            "Qui se fait à la dérobée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03634214-df0c-4969-9532-2d698eeea41e",
                                                "sense_id": "43da50b6-bb97-3df4-b4d6-47da73672b86",
                                                "text": "Ces bousculades entre fillettes et garçons, ces jambes en l’air, et ces mains furtives sous les jupons, lui paraissaient surtout des jeux délicats et gracieux."
                                            },
                                            {
                                                "example_id": "dd6bc42a-4a4c-4284-a63c-d5bcb693136d",
                                                "sense_id": "43da50b6-bb97-3df4-b4d6-47da73672b86",
                                                "text": "On se surprend, en parcourant tôt le matin la rue principale, à surveiller son environnement. Des regards un peu furtifs sont échangés à l’occasion de très rares rencontres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ee2332-45bf-310f-9e65-65117c4e043f",
                                        "entry_id": "5fafb08c-ab88-31b6-a823-2ad94482484f",
                                        "glosses": [
                                            "Qui dérobe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0937fcfd-9090-4b4f-af61-2e8827088efb",
                                                "sense_id": "f5ee2332-45bf-310f-9e65-65117c4e043f",
                                                "text": "Prendre quelque chose d’une main furtive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "526b8082-fd36-3e6d-abc1-3893b4c9b6d8",
                                        "entry_id": "5fafb08c-ab88-31b6-a823-2ad94482484f",
                                        "glosses": [
                                            "Se dit d’un virus qui modifie le comportement du système infecté afin de masquer sa présence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0626e25a-a873-4c44-a81a-388aaff541d6",
                                                "sense_id": "526b8082-fd36-3e6d-abc1-3893b4c9b6d8",
                                                "text": "La différence fondamentale avec les autres virus […] réside dans le fait que, dans le cas d’un virus furtif, non seulement il infecte d’autres programmes, mais il modifie ou utilise également certains appels système de telle sorte que, lorsqu’une vérification est faite par le système ou l’utilisateur (via le système néanmoins) pour contrôler l’intégrité des programmes, ces derniers paraissent sains alors qu’en réalité ils ont été infectés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61aeb492-815a-340a-a8ce-2b653102d91a",
                                        "entry_id": "5fafb08c-ab88-31b6-a823-2ad94482484f",
                                        "glosses": [
                                            "Se dit des plate-formes de combat dont la signature radar est minimisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc60b591-027f-4035-8426-11e8f5f2b9fe",
                                                "sense_id": "61aeb492-815a-340a-a8ce-2b653102d91a",
                                                "text": "Un avion furtif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5a9241c-a5ad-48ae-a5c5-c8cc43c0b7f0",
                        "source_entry_id": "94ace0d2-d1ba-32ca-842c-914cd8d6c0ea",
                        "source_sense_id": "9874c9af-1013-38a3-bae7-814630e89ece",
                        "source_sense_description": "characterized by or resembling stealth or secrecy",
                        "target_lang_word": "subreptice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subreptice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d049f43-a10a-3619-8276-441187e931c0",
                                        "entry_id": "8fa20b8b-19a1-35ab-835b-94fe8303719b",
                                        "glosses": [
                                            "Qualifie une décision, une grâce, un jugement obtenu sur un faux exposé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63dbd4cf-2dbf-407b-b282-16d585a7a863",
                                                "sense_id": "7d049f43-a10a-3619-8276-441187e931c0",
                                                "text": "Pour qu'une dispense soit valide, il ne suffit pas qu'elle ait été accordée par celui qui a le pouvoir de dispenser : elle peut être nulle comme obreptice ou comme subreptice. La dispense obreptice est celle qu'on a obtenue sur un faux exposé, soit par rapport au fait, qu'on n'a pas représenté d'une manière conforme à la vérité; soit par rapport aux raisons, qu'on a faussement alléguées. La dispense est subreptice, lorsqu'on tait dans la supplique ce qui, suivant le style de la cour romaine, doit être exprimé sous peine de nullité. Pour que la dispense soit nulle comme subreptice ou comme obreptice, il est nécessaire que la réticence ou le faux exposé soit la cause finale et déterminante de la dispense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe8ac46-eb20-3012-a50e-5112516a3804",
                                        "entry_id": "8fa20b8b-19a1-35ab-835b-94fe8303719b",
                                        "glosses": [
                                            "Qualifie certaines choses qui se font furtivement et d’une manière illicite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71171d19-a55e-42cc-9a2a-a5033f670855",
                                                "sense_id": "bfe8ac46-eb20-3012-a50e-5112516a3804",
                                                "text": "Il s'est mis en frais pour la nouvelle édition du Siècle de Louis XIV; il n'a épargné aucun soin; et voilà que, pour fruit de ses peines, M. de La Beaumelle fait imprimer sous main une édition subreptice à Francfort, ville impériale, malgré le privilège de l'empereur, dont Walther est en possession."
                                            },
                                            {
                                                "example_id": "403a7753-0b84-4102-8676-df517fcb65e7",
                                                "sense_id": "bfe8ac46-eb20-3012-a50e-5112516a3804",
                                                "text": "[…] Je cite un aphorisme de Jean Claude Marin, ex-procureur de Paris et actuel procureur général près de la cour de cassation : « L’ouverture d’une information judiciaire [c’est alors le juge d’instruction et non le procureur qui dirige l’enquête, NDLR] est la forme la plus subreptice du classement sans suite .»..."
                                            },
                                            {
                                                "example_id": "f2bd2a56-da5d-436d-b3c2-13a68675624f",
                                                "sense_id": "bfe8ac46-eb20-3012-a50e-5112516a3804",
                                                "text": "La règle était qu’il fallait entrer à l’hôpital de la manière la plus subreptice possible, et toujours un à un."
                                            },
                                            {
                                                "example_id": "3d3ca1b4-aa7f-41c3-a24d-93d472625029",
                                                "sense_id": "bfe8ac46-eb20-3012-a50e-5112516a3804",
                                                "text": "Quelques jours plus tard, divulguée à grand bruit par la radio et la presse après des préparations gauchement subreptices, la malencontreuse équipée de Suez commença."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ace87db-ff53-36eb-8bd8-be4c2efa79af",
                                        "entry_id": "8fa20b8b-19a1-35ab-835b-94fe8303719b",
                                        "glosses": [
                                            "Qui est fait ou obtenu à l’insu de quelqu’un et contre son gré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e2c5d2-b057-48e9-b9cf-6215f37e9c5a",
                                                "sense_id": "7ace87db-ff53-36eb-8bd8-be4c2efa79af",
                                                "text": "En résumé donc la définition que l'auteur donne de l'usure, — « l'accaparement subreptice, au nom du capital, de la partie des bénéfices destinée à rémunérer soit les autres parties du capital, soit le travail » — est aussi vague, aussi incolore que toutes les définitions hasardées par d'autres écrivains."
                                            },
                                            {
                                                "example_id": "a8860a63-cac0-478f-b0e2-484fa56e80ca",
                                                "sense_id": "7ace87db-ff53-36eb-8bd8-be4c2efa79af",
                                                "text": "La notion d’emploi à vie est en train de se perdre de manière subreptice\", observe Jean Viard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
