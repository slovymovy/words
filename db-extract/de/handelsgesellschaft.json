                "senses": [
                    {
                        "sense_id": "4c016d41-2af0-31ae-b81a-e4923712da5f",
                        "entry_id": "72d1cab6-9d8b-336f-9fef-4920f1f5f6ab",
                        "glosses": [
                            "Unternehmen, das ein Handelsgewerbe betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04619e86-85e2-4f13-ba8e-c86b7b807348",
                                "sense_id": "4c016d41-2af0-31ae-b81a-e4923712da5f",
                                "text": "„[…] Es waren vor allem die beiden großen holländischen Handelsgesellschaften mit ihren Schiffsflotten, die Vereinigte Ostindische Kompanie und die Vereinigte Westindische Kompanie, die das Geschäft mit den Sklaven machten und diese über die Ozeane transportierten.“"
                            },
                            {
                                "example_id": "fd86ac34-a4ac-4c52-86ec-851a135cfb37",
                                "sense_id": "4c016d41-2af0-31ae-b81a-e4923712da5f",
                                "text": "„So wurde die Grundlage für die Errichtung eines Territorialstaats durch eine Handelsgesellschaft gelegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
