                            {
                                "target_word": "osculatory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd8119ca-d68e-34d6-ba55-78593202ffdf",
                                        "entry_id": "b060e861-fa26-3c4e-aed8-1c6c89fce70e",
                                        "glosses": [
                                            "Of or relating to kissing."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c907ef-ae57-4cf1-bd31-0e73a69a2bcd",
                                                "sense_id": "dd8119ca-d68e-34d6-ba55-78593202ffdf",
                                                "text": "On this the two ladies went through the osculatory ceremony which they were in the habit of performing, and Mrs. Pendennis got a great secret comfort from the little quarrel—for Laura’s confession seemed to say, “That girl can never be a wife for Pen, for she is light-minded and heartless, and quite unworthy of our noble hero.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6c68202-b2f2-3ece-81ab-236c5c0eb21c",
                                        "entry_id": "b060e861-fa26-3c4e-aed8-1c6c89fce70e",
                                        "glosses": [
                                            "Relating to, or having the properties of, an osculatrix; capable of osculation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5cf28b5-3cf8-4dc3-8942-ac02ffe2fb14",
                                                "sense_id": "b6c68202-b2f2-3ece-81ab-236c5c0eb21c",
                                                "text": "A circle may be osculatory with a curve, at a given point."
                                            }
                                        ]
                                    }
