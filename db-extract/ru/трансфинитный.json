                                    }
                                ]
                            },
                            {
                                "target_word": "transfinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660de03c-34ea-32ba-a408-675e7e4f23a8",
                                        "entry_id": "e5f8f579-6abc-3bf7-8981-dc6e8eaa4cdc",
                                        "glosses": [
                                            "A transfinite number."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4267078-8b23-477d-b75f-1aab58082932",
                                                "sense_id": "660de03c-34ea-32ba-a408-675e7e4f23a8",
                                                "text": "An interesting and perhaps essential formal model of this quality is to be found in Cantor's concepts of infinite sets and transfinite cardinals. The laws of ordinary, inductive mathematics do not apply to these, for the 'least part' of such transfinites are equal to the whole, and convey their infinite (i.e. world-like) quality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6683773-619e-4805-8494-4433aee616e6",
                        "source_entry_id": "f4f98c84-a7e8-35e2-8a8a-89ef038bedfa",
                        "target_lang_word": "transfinit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transfinit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eeebb21e-9c9e-3946-b1f6-c6f973025bfe",
                                        "entry_id": "dd5c07af-e8a0-3abf-a42a-c5b258108668",
                                        "glosses": [
                                            "unendlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62aab6d6-7bf7-4c04-a848-618f44cf5301",
                                                "sense_id": "eeebb21e-9c9e-3946-b1f6-c6f973025bfe",
                                                "text": "„\"Wer von einem tiefen Verlangen nach einem Leben nach dem Tod erfüllt ist\", rettet Sagan mühsam die Ehre des Agnostikers, \"könnte sich demnach mit Kosmologie, Quantengravitation, Teilchenphysik und transfiniter Arithmetik befassen.\"“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d10a886e-d44c-4025-9094-0facc57b2caf",
                        "source_entry_id": "f4f98c84-a7e8-35e2-8a8a-89ef038bedfa",
                        "target_lang_word": "transfini",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transfini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce2bcdc-1eeb-32e0-ad7f-c53584d45035",
                                        "entry_id": "92c1a9f4-b18a-3f5d-8c80-02cb513571ed",
                                        "glosses": [
                                            "Ordinal dans un ensemble ordonné infini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc25424c-83c4-47b2-b69a-22a606322699",
                                                "sense_id": "2ce2bcdc-1eeb-32e0-ad7f-c53584d45035",
                                                "text": "Cette affirmation sont de nos corps (...) et non des tables de corrélation, des nombres transfinis et du calcul des matrices."
                                            },
                                            {
                                                "example_id": "b15534f0-53e7-4016-b360-9c917175c7e6",
                                                "sense_id": "2ce2bcdc-1eeb-32e0-ad7f-c53584d45035",
                                                "text": "[…] et pourquoi il insiste sur la définition du premier cardinal transfini."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transfini",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a231e289-a56d-3217-8a0e-8c0eff847234",
                                        "entry_id": "0b0b1278-3caa-3aa6-bf53-ebcc86aa801f",
                                        "glosses": [
                                            "Nombre ordinal d'un ensemble ordonné infini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eeda6685-26b9-42d3-8cf6-d36e459458b0",
                                                "sense_id": "a231e289-a56d-3217-8a0e-8c0eff847234",
                                                "text": "Il reste encore des problèmes intéressants à résoudre sur l'infini et les transfinis."
                                            },
                                            {
                                                "example_id": "c33a8291-3b26-41ee-afeb-0607cf223dd9",
                                                "sense_id": "a231e289-a56d-3217-8a0e-8c0eff847234",
                                                "text": "Quand Georg Cantor découvre le transfini, il croit trouver une sorte de paradis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
