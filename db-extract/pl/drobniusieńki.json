                "senses": [
                    {
                        "sense_id": "df8dd01b-9868-3ec0-84e4-e1d18e3ed1f3",
                        "entry_id": "8efabe84-c962-3f7f-aa51-7a495d6ca139",
                        "glosses": [
                            "od: drobny"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "63b2316a-e947-4d02-b676-173231f06fb5",
                                "sense_id": "df8dd01b-9868-3ec0-84e4-e1d18e3ed1f3",
                                "text": "Prezenty były wówczas drobniusieńkie, bo np. ktoś tam dostał na gwiazdkę dwa jajka"
                            },
                            {
                                "example_id": "c8116042-8b22-46e5-9b36-71bad101cc3c",
                                "sense_id": "df8dd01b-9868-3ec0-84e4-e1d18e3ed1f3",
                                "text": "Lecz, niestety, figa z kochliwych zachcianek! Każdy drobny, drobniusieńki krok naszych junaków ku ucięciu flirtu, acz najniewinniejszego, niezmiennie rozbijał się o przeszkody, zawzięcie stawiane przez mężczyzn Wietnamczyków"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
