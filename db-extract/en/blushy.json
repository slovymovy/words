                "senses": [
                    {
                        "sense_id": "458d2bbe-523b-3212-bac6-e7a59ee96dbf",
                        "entry_id": "43be1b9b-0c4a-35de-986a-2cc7c0625786",
                        "glosses": [
                            "Suffused with blushes or blushlike hues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c26561f-44ce-443a-bfb2-bb1801cfb80e",
                                "sense_id": "458d2bbe-523b-3212-bac6-e7a59ee96dbf",
                                "text": "The artistic impulse that impels one to give a touch of beauty to all material objects extends even to the green-grocer and butcher, and the shop windows of these tradesmen betray both design and beanty. The blushiest side of the apple is always turned towards the passer-by and the hectic glow of the cranberry is further heightened by the contrasting whiteness of celery tops."
                            },
                            {
                                "example_id": "5fcb0adf-16bc-4308-b285-7f2685c7e269",
                                "sense_id": "458d2bbe-523b-3212-bac6-e7a59ee96dbf",
                                "text": "As it happens, the blushy tone does wonders for tallowy New York winter complexions, and, more important, it sets off to advantage the booth’s prize display: a 1901 portrait miniature of the future Kings George VI and Edward VIII, at ages 6 and 7 respectively."
                            },
                            {
                                "example_id": "077f38e2-24b1-47be-87c2-e7cd20a1f72f",
                                "sense_id": "458d2bbe-523b-3212-bac6-e7a59ee96dbf",
                                "text": "Well, before you have to ask and get all blushy again, I'll take you home, since you're so pathetically without wheels."
                            },
                            {
                                "example_id": "e6ec6d3e-69b3-422e-8df6-ec052dc2e5c9",
                                "sense_id": "458d2bbe-523b-3212-bac6-e7a59ee96dbf",
                                "text": "I felt my face do the melt, like Miss’s, only blushier."
                            }
                        ]
                    },
                    {
                        "sense_id": "11dfc7e4-8e57-3317-a722-b9f7bf2fe870",
                        "entry_id": "43be1b9b-0c4a-35de-986a-2cc7c0625786",
                        "glosses": [
                            "Embarrassed, blushing; feeling as though one might blush."
                        ],
                        "tags": [
                            "of a person"
                        ],
                        "examples": [
                            {
                                "example_id": "5b912a07-134d-417b-ab98-2debd1007402",
                                "sense_id": "11dfc7e4-8e57-3317-a722-b9f7bf2fe870",
                                "text": "I didn't feel blushy or quakey, but quite cool, and only a little excited."
                            }
                        ]
                    }
                ],
