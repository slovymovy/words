                    "sense_id": "5bf426c3-4a61-3558-915a-b5d2d6efc626",
                    "sense_definition": "een gevoel van trots of respect dat iemand krijgt van anderen vanwege goede daden of kwaliteiten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "respect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kreeg veel <w>eer</w> voor zijn harde werk aan het project.",
                            "target_lang_translations": {
                                "en": "He received a lot of <w>credit</w> for his hard work on the project."
                            }
                        },
                        {
                            "text": "Het is een grote <w>eer</w> om deze prijs vandaag te mogen ontvangen.",
                            "target_lang_translations": {
                                "en": "It is a great <w>honor</w> to be able to receive this prize today."
                            }
                        }
                    ],
                    "antonyms": [
                        "schande"
                    ],
                    "common_phrases": [
                        "een eer vinden",
                        "ter ere van",
                        "alle eer krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "a feeling of pride or respect that someone receives from others because of good deeds or qualities"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "honor",
                                "target_lang_sense_clarification": "recognition of importance or value"
                            },
                            {
                                "target_lang_word": "honour",
                                "target_lang_sense_clarification": "British spelling of recognition and respect"
                            },
                            {
                                "target_lang_word": "credit",
                                "target_lang_sense_clarification": "praise or respect for an achievement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "754942a1-c856-3600-823a-02d57d8cea56",
