                        "sense_id": "5cee6ba8-a468-3bca-9a41-d09271cbc031",
                        "entry_id": "b9c60af2-6ac5-3fc5-9c4f-886546c23343",
                        "glosses": [
                            "de lijnen in het gezicht die een bepaalde uitdrukking geven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2edd30b4-ff97-483d-b58f-651ca332e6b3",
                                "sense_id": "5cee6ba8-a468-3bca-9a41-d09271cbc031",
                                "text": "Er piepten blonde krullen onder de rand van haar smoezelige muts uit. Ze zou een mooi gezicht hebben gehad als haar pafferige huid haar tere gelaatstrekken niet had verhuld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15ba5221-89e3-48eb-97f7-d06763a7f920",
                        "source_entry_id": "b9c60af2-6ac5-3fc5-9c4f-886546c23343",
                        "source_sense_id": "5cee6ba8-a468-3bca-9a41-d09271cbc031",
                        "source_sense_description": "de lijnen in het gezicht die een bepaalde uitdrukking geven",
                        "target_lang_word": "Gesichtszug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesichtszug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                        "entry_id": "1d0bb2a8-7b7e-3770-a117-ddd7fd669364",
                                        "glosses": [
                                            "ein bestimmter Aspekt (Zug) der Gestalt des Gesichts (Singular relativ ungebräuchlich)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6bd1a2a-0ec6-4858-a3a1-bd486a930a54",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Ist die Lebenserwartung niedrig und die Verbreitung ansteckender Krankheiten vergleichsweise hoch, bevorzugen Frauen Männer mit maskulinen Gesichtszügen.“"
                                            },
                                            {
                                                "example_id": "193d3462-f7a3-4971-8b4a-9eb4e4e18c3f",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„In einigen Sitzungen wurde zunehmend das „Einfrieren“ geübt, sodass letztlich über Minuten hinweg, kein Körperteil, kein Gesichtszug sich bewegen durfte.“"
                                            },
                                            {
                                                "example_id": "3d60b50a-462c-43f9-b92b-30965d5b6184",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Der Mann mochte ein Fünfziger, vielleicht älter sein, denn die Haare waren stark ergraut, die Gesichtszüge noch stärker durchfurcht.“"
                                            },
                                            {
                                                "example_id": "dc3ea690-55ff-4e9b-a30a-2867e2c38b70",
                                                "sense_id": "b074ef34-55e8-3455-9d40-8c2b95750e9c",
                                                "text": "„Seine angenehmen Gesichtszüge hatten es Grete sogleich angetan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
