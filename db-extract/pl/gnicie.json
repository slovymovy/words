                        "cross_references": []
                    },
                    {
                        "translation_id": "074c97ff-c999-4117-991b-fd5187027888",
                        "source_entry_id": "ac64bac5-3765-3630-8d16-56e64df0abc3",
                        "source_sense_id": "bd1fb4b5-09d9-332b-8055-d29b8046a104",
                        "target_lang_word": "гниение",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гниение",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa795bdc-af34-3101-859d-b5920b654e22",
                                        "entry_id": "782bc29a-7ca7-36f0-9c1f-48f61a50e4f1",
                                        "glosses": [
                                            "действие по значению гл. гнить; разложение органических веществ в результате жизнедеятельности микроорганизмов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67331af2-114e-48c6-9b5c-e0b876eabaa1",
                                                "sense_id": "aa795bdc-af34-3101-859d-b5920b654e22",
                                                "text": "К числу рассматриваемых окислений принадлежат, например, почти все случаи так называемого самовольного разложения и гниения, т. е. медленного изменения при содействии воздуха, или воздуха и влажности."
                                            },
                                            {
                                                "example_id": "20f2490a-036b-49ce-83e8-d39dac32e268",
                                                "sense_id": "aa795bdc-af34-3101-859d-b5920b654e22",
                                                "text": "Человек умирает и утучняет гниением своего тела землю, земля вскармливает колос, колос приносит зерно, человек поглощает хлеб и питает им свое тело."
                                            },
                                            {
                                                "example_id": "e3ca8eb4-acb0-4ce8-846c-6cfc72842ec9",
                                                "sense_id": "aa795bdc-af34-3101-859d-b5920b654e22",
                                                "text": "Залитые здесь потоками электрического света, под огромным стеклянным колпаком, в температуре, предохраняющей от гниения, эти трупы лежат здесь неделями, месяцами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7330ef21-be3b-3958-8378-6b6d9bcb31ad",
                                        "entry_id": "782bc29a-7ca7-36f0-9c1f-48f61a50e4f1",
                                        "glosses": [
                                            "процесс порчи чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "021e5e7d-f19b-48e9-a8b2-eab8a8db17fb",
                                                "sense_id": "7330ef21-be3b-3958-8378-6b6d9bcb31ad",
                                                "text": "Памятуйте, что это тихое житие равносильно позорному гниению, и не завидуйте гниющим потому только, что они гниют без помехи!"
                                            },
                                            {
                                                "example_id": "cf2709f5-52b6-4afb-83a6-e790bcfdb4ea",
                                                "sense_id": "7330ef21-be3b-3958-8378-6b6d9bcb31ad",
                                                "text": "― И чем ниже человек, тем выше от него бог, гонимый смрадом гниения нашего во грехах."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
