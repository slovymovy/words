                                                "example_id": "c18eff0f-b2f3-48b7-b9af-f63d2783e615",
                                                "sense_id": "165f7fa6-49d4-3195-84f7-893223b12deb",
                                                "text": "Athen ist eine Partnerstadt Eriwans."
