                ],
                "senses": [
                    {
                        "sense_id": "e1239b3e-c3b1-39fe-a5a9-5e11cd2f4121",
                        "entry_id": "a838b13f-3296-3e4e-8a78-d0931dedff55",
                        "glosses": [
                            "plump, chubby"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfc1e2a-d9b9-45af-82c9-40ed2b5ae7a1",
                                "sense_id": "e1239b3e-c3b1-39fe-a5a9-5e11cd2f4121",
                                "text": "— Э́то ужа́сно! — говори́л он, задыха́ясь (несмотря́ на свои́ 26 лет, он пухл, тяжёл и страда́ет оды́шкой). — Э́то ужа́сно! Без языко́в я, как пти́ца без кры́льев. Про́сто хоть рабо́ту броса́й.",
                                "translation": "\"It's awful!\" he used to say, losing his breath (for although only twenty-six he was stout, heavy, and short of breath). \"It's awful. Without knowing languages I'm like a bird without wings. I'll simply have to chuck the work.\"",
                                "english": "\"It's awful!\" he used to say, losing his breath (for although only twenty-six he was stout, heavy, and short of breath). \"It's awful. Without knowing languages I'm like a bird without wings. I'll simply have to chuck the work.\""
                            }
                        ]
