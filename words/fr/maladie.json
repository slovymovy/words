                            "text": "Le médecin a diagnostiqué une <w>maladie</w> bénigne qui se soigne facilement.",
                            "target_lang_translations": {
                                "en": "The doctor diagnosed a benign <w>illness</w> that is easy to treat.",
                                "ru": "Врач диагностировал доброкачественную <w>болезнь</w>, которую легко вылечить.",
                                "nl": "De arts stelde een goedaardige <w>ziekte</w> vast die makkelijk te genezen is.",
                                "de": "Der Arzt diagnostizierte eine gutartige <w>Krankheit</w>, die sich leicht behandeln lässt.",
                                "pl": "Lekarz zdiagnozował łagodną <w>chorobę</w>, którą łatwo się leczy.",
                                "it": "Il medico ha diagnosticato una <w>malattia</w> benigna che si cura facilmente.",
                                "cs": "Lékař diagnostikoval nezhoubnou <w>chorobu</w>, která se dá snadno vyléčit.",
                                "tr": "Doktor, kolayca tedavi edilebilen iyi huylu bir <w>hastalık</w> teşhis etti.",
                                "es": "El médico diagnosticó una <w>enfermedad</w> benigna que se cura fácilmente.",
                                "zh": "医生诊断出一种良性<w>疾病</w>，比较容易治愈。"
                            }
                        },
                        {
                            "text": "Elle a pris un arrêt <w>maladie</w> pour se reposer quelques jours chez elle.",
                            "target_lang_translations": {
                                "en": "She took <w>sick leave</w> to rest at home for a few days.",
                                "ru": "Она взяла <w>больничный</w>, чтобы несколько дней отдохнуть дома.",
                                "nl": "Ze nam <w>ziekteverlof</w> om een paar dagen thuis uit te rusten.",
                                "de": "Sie ließ sich eine <w>Krankschreibung</w> ausstellen, um sich ein paar Tage zu Hause auszuruhen.",
                                "pl": "Wzięła <w>zwolnienie lekarskie</w>, żeby kilka dni odpocząć w domu.",
                                "it": "Si è messa in <w>malattia</w> per riposare qualche giorno a casa.",
                                "cs": "Šla na <w>neschopenku</w>, aby si pár dní odpočinula doma.",
                                "tr": "Birkaç gün evde dinlenmek için <w>hastalık izni</w> aldı.",
                                "es": "Se tomó una <w>baja por enfermedad</w> para descansar unos días en casa.",
                                "zh": "她请了病假，在家休息了几天。"
                            }
