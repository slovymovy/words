                        ],
                        "examples": [
                            {
                                "example_id": "070269bb-6741-4b1c-a8e7-01746c1322c6",
                                "sense_id": "bf1be172-81a3-3ceb-84c6-8d7ddd88df9f",
                                "text": "‘Wij bevinden ons op dit ogenblik van de wereldgeschiedenis in een toestand, waarin alles aankomt op onze houding tegen de dreiging van nieuwe onheilen. Nederland moet niet alleen drijvende blijven op de wilde golven van het wereldgebeuren. Het moet zelf zijn koers bepalen, en bovendien trachten met de andere volken samen de koers uit te zetten van de ganse wereldvloot.’"
                            }
