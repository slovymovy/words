                        "sense_id": "f610377b-95fc-3718-9843-c93696e9f522",
                        "entry_id": "9049c78c-2af3-3539-b67d-9dfb10ad2154",
                        "glosses": [
                            "versiering van een oppervlakte in de vorm van een daarop aangebracht motief gemaakt uit ander materiaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38688eec-1190-443c-bbdc-eaca86c60288",
                                "sense_id": "f610377b-95fc-3718-9843-c93696e9f522",
                                "text": "Uit zwart haaieleer bestaat de band die aan weerszijden op de hoeken is versierd met geciseleerd beslag, voorstellende vier verschillende bloemen en vervaardigd door de Amsterdamse zilversmid Johannes Lutma II. Midden op het voor- en achterplat bevindt zich een ruitvormige applique met het wapen van de Amsterdamse familie Soolmans."
                            }
                        ]
                    },
                    {
                        "sense_id": "23e6ca20-f30d-3c92-8044-406bdfc438c1",
                        "entry_id": "9049c78c-2af3-3539-b67d-9dfb10ad2154",
                        "glosses": [
                            "lamp die aan de wand is bevestigd"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4d96a93a-f80e-4778-a8fa-2427d2802dea",
                                "sense_id": "23e6ca20-f30d-3c92-8044-406bdfc438c1",
                                "text": "De fraaie applique in den vorm van twee elkaar omstrengelende bladeren, die even voor de trap haar licht liet vallen op de witte marmeren steenen, welke aan beide zijden van den traplooper uitstaken, brandde reeds haar drie kaarsen."
                            }
                        ]
                    }
