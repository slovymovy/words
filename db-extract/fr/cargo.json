                ],
                "senses": [
                    {
                        "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                        "entry_id": "8a1d52f8-1167-3a15-8a28-657f0ccf4466",
                        "glosses": [
                            "Navire destiné à transporter des marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "959c4649-9a70-43c7-92bc-4fe17610a532",
                                "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                                "text": "Les glaces de la mer Blanche n’avaient que peu de rapports avec celles de la banquise, et les cargos étaient précédés et convoyés par de remarquables « brise-glaces »."
                            },
                            {
                                "example_id": "d8bf691d-a269-43db-aef0-520545fc9843",
                                "sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                                "text": "Le bulbe opalin déchirait la pellicule liquide, des floches d'écume chatouillaient les flancs du cargo."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbfc6cd7-0ac9-3a57-b30e-3a83c905f2cf",
                        "entry_id": "8a1d52f8-1167-3a15-8a28-657f0ccf4466",
                        "glosses": [
                            "Véhicule destiné à transporter des marchandises (en général dans un nom composé)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a560be-dbc3-4a37-bbf8-2bd0c2a8dae2",
                        "source_entry_id": "8a1d52f8-1167-3a15-8a28-657f0ccf4466",
                        "source_sense_id": "84656753-9126-3c72-9ee4-508dbe2cb678",
                        "source_sense_description": "Navire destiné à transporter des marchandises.",
                        "target_lang_word": "Frachtschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frachtschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                        "entry_id": "0983c7d7-0ef0-36e2-a665-cfde615f6a4d",
                                        "glosses": [
                                            "ausschließlich Frachtgut transportierendes Schiff, sowohl in Binnengewässern als auch auf offener See verkehrend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2240dd36-ef70-4c9a-bcca-0c1b171db63b",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "Das Frachtschiff wird erst morgen eintreffen."
                                            },
                                            {
                                                "example_id": "d4b2b256-8460-478a-a37a-93eb7d9910b7",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„An der Rolandsbrücke haben im 9. Jahrhundert die Frachtschiffe festgemacht, hier sitzt die Norddeutsche Vermögen, Kortüms Reederei.“"
                                            },
                                            {
                                                "example_id": "f075b629-5f5e-48cf-af69-97c6c5fd16b1",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Wir sitzen länger hier und sinnieren über die Ladung der Frachtschiffe.“"
                                            },
                                            {
                                                "example_id": "a6f0154c-b9fe-479a-a3e1-0d289ce8974d",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Frachtschiffe tuckerten zum Be- oder Entladen in Richtung Hafen, die ersten Ausflugsschiffe waren auch schon wieder unterwegs.“"
                                            },
                                            {
                                                "example_id": "092aaad2-8910-497d-9acc-e298f1bf1934",
                                                "sense_id": "ae85ca6b-ce4d-3174-87ab-030686c14285",
                                                "text": "„Zu jener Zeit traf Lai-bau mit dem Frachtschiff aus Nanking wieder ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
