                        "sense_id": "17744d35-78a9-35cd-a669-5d3f32ae5b6c",
                        "entry_id": "1e1e1a00-4cf4-3ac4-b6a8-a40e8ab8886e",
                        "glosses": [
                            "A simple form of research that examines a group or groups before and after an event, to see whether there is change, but does not employ a control group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1014a72-9965-47df-85ff-3929b7936794",
                                "sense_id": "17744d35-78a9-35cd-a669-5d3f32ae5b6c",
                                "text": "A study that uses only a manipulation is considered a pre-experiment. As the name implies, a pre-experiment has not quite achieved the level of control necessary to be termed an experiment at all."
                            },
                            {
                                "example_id": "c192b954-c4c8-4339-874e-ea88a3db032d",
                                "sense_id": "17744d35-78a9-35cd-a669-5d3f32ae5b6c",
                                "text": "Campbell and Stanley describe three forms of preexperiments: the one-shot case study, the one-group pretest–posttest design, and the static-group comparison."
                            }
                        ]
                    }
