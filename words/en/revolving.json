{
    "word_family": [
        "revolve",
        "revolution",
        "revolutionary",
        "revolver"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5cd4d238-4b8c-3961-b1e5-77274da88af4",
                    "sense_definition": "Moving or turning around a central point or axis.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>revolving</w> door at the hotel entrance was difficult to push.",
                            "target_lang_translations": {
                                "nl": "De <w>draaideur</w> bij de ingang van het hotel was moeilijk open te duwen."
                            }
                        },
                        {
                            "text": "The planet follows a <w>revolving</w> path around the sun.",
                            "target_lang_translations": {
                                "nl": "De planeet volgt een <w>draaiende</w> baan rond de zon."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotating",
                        "spinning"
                    ],
                    "antonyms": [
                        "stationary"
                    ],
                    "common_phrases": [
                        "revolving door"
                    ],
                    "target_lang_definitions": {
                        "nl": "Draaiend om een centraal punt of as."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "draaiend",
                                "target_lang_sense_clarification": "Algemene term voor iets dat ronddraait."
                            },
                            {
                                "target_lang_word": "roterend",
                                "target_lang_sense_clarification": "Formelere term voor draaibewegingen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4889cbc9-f3f8-3a47-9f89-f858639b3ff2",
                    "sense_definition": "Relating to a credit account where the balance can be carried over to the next billing cycle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most credit cards offer a <w>revolving</w> line of credit to their customers.",
                            "target_lang_translations": {
                                "nl": "De meeste creditcards bieden hun klanten een <w>doorlopend</w> krediet."
                            }
                        },
                        {
                            "text": "Interest rates on <w>revolving</w> debt can become very expensive over time.",
                            "target_lang_translations": {
                                "nl": "Rente op <w>doorlopende</w> schulden kan na verloop van tijd erg duur worden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "revolving credit"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op een kredietvorm waarbij het saldo kan worden meegenomen naar de volgende periode."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doorlopend",
                                "target_lang_sense_clarification": "Gebruikt in de context van doorlopend krediet."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5fb84b74-e1fc-3f7c-8470-005a5cbf5470",
                    "sense_definition": "The act of something that turns or moves in a circle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>revolving</w> of the fan blades kept the room cool.",
                            "target_lang_translations": {
                                "nl": "Het constante <w>draaien</w> van de ventilatorbladen hield de kamer koel."
                            }
                        },
                        {
                            "text": "He watched the slow <w>revolving</w> of the earth globe on the desk.",
                            "target_lang_translations": {
                                "nl": "Hij keek naar het langzame <w>draaien</w> van de wereldbol op het bureau."
                            }
                        }
                    ],
                    "synonyms": [
                        "rotation",
                        "spin"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van iets dat in een cirkel draait."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "draaiing",
                                "target_lang_sense_clarification": "De actie van het ronddraaien."
                            },
                            {
                                "target_lang_word": "rotatie",
                                "target_lang_sense_clarification": "Technischere term voor een draaibeweging."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e04d4584-71a0-319e-b8af-a7fdd4c37d78",
                    "sense_definition": "A 3D modeling technique where a 2D shape is rotated around an axis to create a solid object.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software uses a <w>revolving</w> tool to turn the profile into a vase.",
                            "target_lang_translations": {
                                "nl": "De software gebruikt een <w>wentelingsfunctie</w> om het profiel in een vaas te veranderen."
                            }
                        },
                        {
                            "text": "Creating a sphere is simple using the <w>revolving</w> function in the program.",
                            "target_lang_translations": {
                                "nl": "Een bol maken is eenvoudig met de <w>wentelingsfunctie</w> in het programma."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een 3D-modelleringstechniek waarbij een 2D-vorm om een as wordt gedraaid om een solide object te creëren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "wenteling",
                                "target_lang_sense_clarification": "Term voor het creëren van een volume door rotatie."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "31edea21-3a2d-3d9e-8e1d-9a25c4fd0989",
                    "sense_definition": "Present participle and gerund of <w>revolve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earth is constantly <w>revolving</w> around the sun.",
                            "target_lang_translations": {
                                "nl": "De aarde is constant aan het <w>draaien</w> rond de zon."
                            }
                        },
                        {
                            "text": "She was <w>revolving</w> the idea in her mind for several days.",
                            "target_lang_translations": {
                                "nl": "Ze was het idee al enkele dagen in haar hoofd aan het <w>omwentelen</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van 'revolve' (draaien)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "draaiend",
                                "target_lang_sense_clarification": "De actieve vorm van draaien."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}