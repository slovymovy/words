                "senses": [
                    {
                        "sense_id": "b9a1f084-1f57-35ad-8c4b-56c2cd147838",
                        "entry_id": "009979b7-c9e1-3803-9cd5-cf95b4f79de3",
                        "glosses": [
                            "Commettre un inceste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044e7257-9d9f-4bf8-a78d-45a40c63bc5d",
                                "sense_id": "b9a1f084-1f57-35ad-8c4b-56c2cd147838",
                                "text": "Ou alors, pour en revenir à ce qui met fin aux abus sexuels, si l’incesteur est un frère, il s’arrête d’incester parce qu’il rencontre d’autres partenaires sexuels, à l’extérieur de la maison, et qu’il laisse tomber ses cousins, frères ou sœurs incestés."
                            },
                            {
                                "example_id": "46c271c1-e3aa-4fb7-bfce-6197fb8a449a",
                                "sense_id": "b9a1f084-1f57-35ad-8c4b-56c2cd147838",
                                "text": "Le fait qu’il se soit autorisé à incester sa sœur ne dit rien de sa motivation, mais montre simplement que le jeune homme n’est pas rebelle à l’ordre social dans lequel il vit."
                            }
                        ]
                    }
