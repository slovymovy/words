                        "source_sense_id": "3d53b2d5-f847-30ea-83d4-f712ea13a22c",
                        "source_sense_description": "eine Person, die Waren aufkauft, um diese an einem anderen Ort zu einem höheren Preis zu verkaufen",
                        "target_lang_word": "Zwischenhändler",
                        "target_lang_code": "de",
