                ],
                "senses": [
                    {
                        "sense_id": "526c6d3f-095d-3bc9-9c9b-79323f818b04",
                        "entry_id": "e9227133-33dc-339f-a967-6b36fd24ddc3",
                        "glosses": [
                            "разг. есть немного, наскоро"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0fe0db-c61a-4cdb-99c2-16535731e8b2",
                                "sense_id": "526c6d3f-095d-3bc9-9c9b-79323f818b04",
                                "text": "То есть в машине можно приготовить полноценный обед, а не перекусывать всухомятку."
                            },
                            {
                                "example_id": "e2357948-fc45-4827-aab1-b64375941fea",
                                "sense_id": "526c6d3f-095d-3bc9-9c9b-79323f818b04",
                                "text": "Перекусывать любят чебуреками, шаурмой, гамбургерами и хот-догами, причем нередко для большей убедительности продавцы пишут на ценниках «горячие хот-доги»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a6b7a3e-976a-4b6e-9c19-7f2e4af5bd08",
                        "source_entry_id": "e9227133-33dc-339f-a967-6b36fd24ddc3",
                        "source_sense_id": "526c6d3f-095d-3bc9-9c9b-79323f818b04",
                        "target_lang_word": "feed one's face",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feed one's face",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bb1e8f5-f40e-343d-806b-76ead74cf487",
                                        "entry_id": "43a2a114-ebc9-3d62-9c3d-9016b480c18d",
                                        "glosses": [
                                            "To eat."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "686ef426-c9ae-4f9e-982e-9ae912090b8c",
                                                "sense_id": "6bb1e8f5-f40e-343d-806b-76ead74cf487",
                                                "text": "\"Step up and feed your face.\"\n\"What?\" stammered Samuel, perplexed.\n\"EAT!\" said the other."
                                            },
                                            {
                                                "example_id": "851bdce2-a72a-49dc-8693-c9d9ab6d2fbd",
                                                "sense_id": "6bb1e8f5-f40e-343d-806b-76ead74cf487",
                                                "text": "\"Feed your face, and we'll go upstream.\" Bob ate rapidly."
                                            },
                                            {
                                                "example_id": "3bc7da06-564d-4592-8264-b98253e07e67",
                                                "sense_id": "6bb1e8f5-f40e-343d-806b-76ead74cf487",
                                                "text": "While the players are out there whacking away at tennis balls, the lower-deck patrons are feeding their faces on $5 shrimps and sipping $10 glasses of wine."
                                            },
                                            {
                                                "example_id": "8c57095c-7c39-47dc-ab49-b0b31cb45360",
                                                "sense_id": "6bb1e8f5-f40e-343d-806b-76ead74cf487",
                                                "text": "“Though why I should give the boys bacon and eggs when they've already fed their faces wi' fish 'n' chips, I can't imagine.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "723081c2-f0a8-4639-a750-2cb03dfb3d65",
                        "source_entry_id": "e9227133-33dc-339f-a967-6b36fd24ddc3",
