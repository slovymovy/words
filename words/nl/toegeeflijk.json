    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08f304bf-c581-304b-b92d-bb49b4af72d1",
                    "sense_definition": "bereid om anderen hun zin te geven of fouten gemakkelijk te vergeven",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar was <w>toegeeflijk</w> en gaf de studenten extra tijd voor hun project.",
                            "target_lang_translations": {
                                "en": "The teacher was <w>lenient</w> and gave the students extra time for their project."
                            }
                        },
                        {
                            "text": "Veel ouders zijn te <w>toegeeflijk</w> als het gaat om de schermtijd van hun kinderen.",
                            "target_lang_translations": {
                                "en": "Many parents are too <w>indulgent</w> when it comes to their children's screen time."
                            }
                        },
                        {
                            "text": "Ondanks haar fouten was hij altijd <w>toegeeflijk</w> en vergevingsgezind.",
                            "target_lang_translations": {
                                "en": "Despite her mistakes, he was always <w>forgiving</w> and lenient."
                            }
                        }
                    ],
                    "synonyms": [
                        "inschikkelijk",
                        "meegaand",
                        "vergeeflijk",
                        "clement",
                        "permissief"
                    ],
                    "antonyms": [
                        "streng",
                        "onbuigzaam",
                        "onverzettelijk"
                    ],
                    "common_phrases": [
                        "te toegeeflijk zijn",
                        "een toegeeflijke houding"
                    ],
                    "target_lang_definitions": {
                        "en": "willing to let others have their way or to forgive mistakes easily"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lenient",
                                "target_lang_sense_clarification": "not strict in punishment or judgment"
                            },
                            {
                                "target_lang_word": "indulgent",
                                "target_lang_sense_clarification": "allowing someone to have what they want"
                            },
                            {
                                "target_lang_word": "permissive",
                                "target_lang_sense_clarification": "allowing great freedom of behavior"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d457e2f-2fef-342b-8643-607f35d38abf",
                    "sense_definition": "gemakkelijk mee te krijgen in de wensen van anderen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij is een zeer <w>toegeeflijke</w> man die zelden nee zegt tegen zijn vrienden.",
                            "target_lang_translations": {
                                "en": "He is a very <w>compliant</w> man who rarely says no to his friends."
                            }
                        },
                        {
                            "text": "Door zijn <w>toegeeflijke</w> aard werd er vaak misbruik van hem gemaakt.",
                            "target_lang_translations": {
                                "en": "Because of his <w>yielding</w> nature, he was often taken advantage of."
                            }
                        }
                    ],
                    "synonyms": [
                        "inschikkelijk",
                        "meegaand",
                        "dociel"
                    ],
                    "antonyms": [
                        "koppig",
                        "eigenzinnig"
                    ],
                    "common_phrases": [
                        "toegeeflijke aard"
                    ],
                    "target_lang_definitions": {
                        "en": "easily persuaded or inclined to go along with the wishes of others"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "compliant",
                                "target_lang_sense_clarification": "disposed to agree with others or obey rules"
                            },
                            {
                                "target_lang_word": "yielding",
                                "target_lang_sense_clarification": "giving way under pressure or influence"
                            },
                            {
                                "target_lang_word": "accommodating",
                                "target_lang_sense_clarification": "willing to fit in with someone's wishes or needs"
                            }
                        ]
                    }
                }
            ]
        }
    ]
