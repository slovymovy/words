                ],
                "senses": [
                    {
                        "sense_id": "b7ebeba8-01ab-3b11-9c54-8bfff662c351",
                        "entry_id": "8960f9dc-5857-38db-b62c-a5b8da6a26c4",
                        "glosses": [
                            "Rundfunkempfangsgerät, in dem hauptsächlich Elektronenröhren für die Signalverarbeitung verwendet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce2f0e04-6846-4ea3-9253-def9f04bf8e7",
                                "sense_id": "b7ebeba8-01ab-3b11-9c54-8bfff662c351",
                                "text": "„Ein Röhrenempfänger steht auf der Probebühne des Theaters in der Josefstadt, Melodien und Nachrichtenfetzen dringen in den Zuschauerraum.“"
                            },
                            {
                                "example_id": "9c184a54-3655-46bf-b6d9-af8252cec51e",
                                "sense_id": "b7ebeba8-01ab-3b11-9c54-8bfff662c351",
                                "text": "„Nach der Erfindung des Transistors im Jahr 1947 dauerte es nicht lange, bis die ersten Transistorradios auf den Markt kamen. Diese verdrängten nach und nach die damals verbreiteten Röhrenempfänger, in denen klobige Vakuumröhren die empfangenen Signale verstärkten.“"
                            },
                            {
                                "example_id": "e2ee5f68-e655-491b-a1c3-db17f9989d5a",
                                "sense_id": "b7ebeba8-01ab-3b11-9c54-8bfff662c351",
                                "text": "„Das Radio meiner Grosseltern war ein Röhrenempfänger der Marke Philips, Holzgehäuse, Lautsprecherbespannung, magisches Auge für die Senderfeinabstimmung, eben so ein Ding aus den Fünfzigerjahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
