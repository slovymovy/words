{
    "word_family": [
        "ciężar",
        "obciążenie",
        "obciążnik",
        "odciążać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "34971b80-d2e1-3d4c-b98f-eba37a095aed",
                    "sense_definition": "zwiększać masę czegoś lub nakładać na kogoś dodatkowe obowiązki",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "obciążenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie należy <w>obciążać</w> kręgosłupa zbyt ciężkimi zakupami.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>нагружать</w> позвоночник слишком тяжелыми покупками."
                            }
                        },
                        {
                            "text": "Szef lubi <w>obciążać</w> pracowników dodatkowymi zadaniami przed weekendem.",
                            "target_lang_translations": {
                                "ru": "Начальник любит <w>нагружать</w> сотрудников дополнительными задачами перед выходными."
                            }
                        }
                    ],
                    "synonyms": [
                        "nakładać",
                        "obarczać",
                        "obładowywać"
                    ],
                    "antonyms": [
                        "odciążać",
                        "zdejmować"
                    ],
                    "common_phrases": [
                        "obciążać kręgosłup",
                        "obciążać budżet"
                    ],
                    "target_lang_definitions": {
                        "ru": "увеличивать вес чего-либо или возлагать на кого-либо дополнительные обязанности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагружать",
                                "target_lang_sense_clarification": "физически или функционально увеличивать нагрузку"
                            },
                            {
                                "target_lang_word": "обременять",
                                "target_lang_sense_clarification": "возлагать обязанности или ответственность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3360dfb6-e476-3639-bf99-518cb75e3b16",
                    "sense_definition": "wskazywać na czyjąś winę w kontekście prawnym lub moralnym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowe dowody w sprawie mogą <w>obciążać</w> głównego podejrzanego.",
                            "target_lang_translations": {
                                "ru": "Новые доказательства по делу могут <w>отягощать</w> положение главного подозреваемого."
                            }
                        },
                        {
                            "text": "Zeznania świadków <w>obciążać</w> go w oczach opinii publicznej.",
                            "target_lang_translations": {
                                "ru": "Показания свидетелей <w>компрометируют</w> его в глазах общественности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "obciążać winą"
                    ],
                    "target_lang_definitions": {
                        "ru": "указывать на чью-либо вину в правовом или моральном контексте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отягощать",
                                "target_lang_sense_clarification": "ухудшать положение, свидетельствовать против кого-то"
                            },
                            {
                                "target_lang_word": "компрометировать",
                                "target_lang_sense_clarification": "выставлять в невыгодном свете, указывать на вину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22912eec-0998-3021-9bc1-bddb482c4f55",
                    "sense_definition": "brać na siebie zbyt wiele obowiązków lub problemów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obciążenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie powinieneś <w>obciążać</w> się tak wieloma projektami naraz.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует <w>перегружать</w> себя таким количеством проектов одновременно."
                            }
                        },
                        {
                            "text": "Często <w>obciążać</w> się niepotrzebnymi zmartwieniami.",
                            "target_lang_translations": {
                                "ru": "Часто <w>обременять</w> себя ненужными тревогами."
                            }
                        }
                    ],
                    "synonyms": [
                        "obarczać"
                    ],
                    "target_lang_definitions": {
                        "ru": "брать на себя слишком много обязанностей или проблем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перегружать себя",
                                "target_lang_sense_clarification": "брать на себя избыточную работу"
                            },
                            {
                                "target_lang_word": "обременять себя",
                                "target_lang_sense_clarification": "взваливать на себя лишние заботы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aefe2ea5-96c9-3c3b-af53-944f68ebae80",
                    "sense_definition": "przyznawać się do winy lub dostarczać dowodów przeciwko sobie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wina",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas przesłuchania zaczął <w>obciążać</w> się swoimi własnymi zeznaniami.",
                            "target_lang_translations": {
                                "ru": "Во время допроса он начал <w>давать показания против себя</w>."
                            }
                        },
                        {
                            "text": "Nieświadomie <w>obciążać</w> się w trakcie rozmowy z policją.",
                            "target_lang_translations": {
                                "ru": "Неосознанно <w>подставлять</w> себя во время разговора с полицией."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "признаваться в вине или предоставлять доказательства против самого себя"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "давать показания против себя",
                                "target_lang_sense_clarification": "юридический контекст самообвинения"
                            },
                            {
                                "target_lang_word": "подставлять себя",
                                "target_lang_sense_clarification": "разговорный вариант, создавать себе проблемы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}