                        ]
                    },
                    {
                        "translation_id": "ee1bc22d-3dbb-445d-ad5d-b65ff37ac580",
                        "source_entry_id": "5254ffed-27ee-367a-b085-c36a7af280dc",
                        "source_sense_id": "9e118eff-86e7-3382-9a65-25dc8c7b5dad",
                        "target_lang_word": "Antifaschismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antifaschismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb0dc9b-e66f-3fbf-96be-23f2338b89cb",
                                        "entry_id": "78c6d1a2-8c20-32fe-b4b9-659f6e9b4927",
                                        "glosses": [
                                            "politische Ablehnung des Faschismus und möglicher Entwicklungen dorthin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b2bd355-5906-43c5-9755-28e89a74eaa4",
                                                "sense_id": "aeb0dc9b-e66f-3fbf-96be-23f2338b89cb",
                                                "text": "Antifaschismus ist notwendig und muss Neonazis am Arbeitsplatz, in der Nachbarschaft und in der Öffentlichkeit immer wieder aus der Deckung holen."
                                            },
                                            {
                                                "example_id": "29b9ef5e-7534-49e9-9b3b-8fddd959713d",
                                                "sense_id": "aeb0dc9b-e66f-3fbf-96be-23f2338b89cb",
                                                "text": "„Deshalb war der Antifaschismus einer seiner ersten großen Impulse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
