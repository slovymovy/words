    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "236d29ff-8841-3867-8c05-c4a01588fd05",
                    "sense_definition": "A Japanese unit of weight equal to approximately 3.75 kilograms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant calculated the total value of the silver in <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "商人计算了白银以<w>贯</w>为单位的总价值。"
                            }
                        },
                        {
                            "text": "Historical records indicate the shipment weighed over fifty <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "历史记录显示这批货物重达五十<w>贯</w>以上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "日本的一种重量单位，约等于3.75公斤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贯",
                                "target_lang_sense_clarification": "日本传统重量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4a932c4-427a-3772-bf4f-76e182ae7d80",
                    "sense_definition": "A unit of weight known as a catty, legally defined as approximately 0.6 kilograms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "units",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local market uses the <w>kan</w> to measure bulk goods.",
                            "target_lang_translations": {
                                "zh": "当地市场使用<w>斤</w>来衡量散装商品。"
                            }
                        },
                        {
                            "text": "Each package was weighed and found to be exactly one <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "每个包裹称重后发现正好是一<w>斤</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种重量单位，即“斤”，法定定义约为0.6公斤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斤",
                                "target_lang_sense_clarification": "东亚传统重量单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ff6f933-a6d6-3925-947b-ea0eec4888a9",
                    "sense_definition": "A set of four identical tiles in certain tile-based games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She revealed her <w>kan</w> to complete the winning hand.",
                            "target_lang_translations": {
                                "zh": "她亮出了自己的<w>杠</w>以完成获胜的牌局。"
                            }
                        },
                        {
                            "text": "Drawing the final tile allowed him to declare a <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "摸到最后一张牌使他能够宣告<w>杠</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kong",
                        "quad",
                        "four-of-a-kind"
                    ],
                    "target_lang_definitions": {
                        "zh": "在某些麻将类游戏中，由四张相同牌组成的牌组。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杠",
                                "target_lang_sense_clarification": "麻将术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a877269c-3444-3556-9ae9-d9b4c32e7048",
                    "sense_definition": "A verbal declaration made when forming a set of four identical tiles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player shouted <w>kan</w> as soon as the fourth tile was drawn.",
                            "target_lang_translations": {
                                "zh": "第四张牌一摸到，玩家就大喊了一声<w>杠</w>。"
                            }
                        },
                        {
                            "text": "He made a <w>kan</w> to improve his score significantly.",
                            "target_lang_translations": {
                                "zh": "他通过<w>杠</w>牌显著提高了自己的分数。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在麻将游戏中宣告组成四张相同牌组时的口头声明。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "杠",
                                "target_lang_sense_clarification": "麻将动作声明"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96bfb3af-88d4-3191-be98-73255fdd8257",
                    "sense_definition": "An archaic spelling of the title khan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text refers to the ruler as the great <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "古籍中将这位统治者称为伟大的<w>汗</w>。"
                            }
                        },
                        {
                            "text": "Historians often study the reign of each powerful <w>kan</w>.",
                            "target_lang_translations": {
                                "zh": "历史学家经常研究每一位强大<w>汗</w>的统治时期。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This spelling is no longer in standard use."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "“汗”的古旧拼写，指古代中亚及蒙古统治者的称号。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "汗",
                                "target_lang_sense_clarification": "古代统治者称号"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b15460be-2ba0-3922-b5d8-4ecc07e4527d",
                    "sense_definition": "A unisex given name of Japanese origin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Kan</w> is visiting from Tokyo next week.",
                            "target_lang_translations": {
                                "zh": "我的朋友<w>宽</w>下周要从东京来访。"
                            }
                        },
                        {
                            "text": "The author <w>Kan</w> wrote several interesting short stories.",
                            "target_lang_translations": {
                                "zh": "作家<w>宽</w>写了几篇有趣的小说。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "源自日本的中性人名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宽",
                                "target_lang_sense_clarification": "常见日本名字音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4a72a74-4b25-3656-a24f-0e9b70cc6e7b",
                    "sense_definition": "A surname with multiple historical origins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The professor <w>Kan</w> gave a lecture on linguistics today.",
                            "target_lang_translations": {
                                "zh": "<w>甘</w>教授今天做了一场关于语言学的讲座。"
                            }
                        },
                        {
                            "text": "Many people with the surname <w>Kan</w> live in East Asia.",
                            "target_lang_translations": {
                                "zh": "许多姓<w>甘</w>的人居住在东亚。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "具有多种历史起源的姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "甘",
                                "target_lang_sense_clarification": "常见东亚姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "507d29e2-7b06-3ac3-9d59-c1519cc763f5",
