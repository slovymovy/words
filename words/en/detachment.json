{
    "word_family": [
        "detach",
        "detachable",
        "detached",
        "detachedly",
        "detachedness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd201827-8dac-379b-9dcd-30f3b80390f5",
                    "sense_definition": "The state of being objective, unbiased, or emotionally neutral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A good judge must review the evidence with complete <w>detachment</w>.",
                            "target_lang_translations": {
                                "ru": "Хороший судья должен рассматривать доказательства с полной <w>беспристрастностью</w>."
                            }
                        },
                        {
                            "text": "She spoke about her past struggles with surprising emotional <w>detachment</w>.",
                            "target_lang_translations": {
                                "ru": "Она рассказывала о пережитых трудностях с удивительной душевной <w>отрешённостью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "impartiality",
                        "objectivity",
                        "neutrality"
                    ],
                    "antonyms": [
                        "bias",
                        "partiality"
                    ],
                    "common_phrases": [
                        "emotional detachment",
                        "clinical detachment",
                        "with detachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние объективности, беспристрастности или эмоционального нейтралитета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспристрастность",
                                "target_lang_sense_clarification": "отсутствие предвзятости и личного отношения"
                            },
                            {
                                "target_lang_word": "непредвзятость",
                                "target_lang_sense_clarification": "объективный, нейтральный подход"
                            },
                            {
                                "target_lang_word": "отрешённость",
                                "target_lang_sense_clarification": "эмоциональная нейтральность, взгляд со стороны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8137fb2-04bb-36e2-b6f5-47ef2bee5561",
                    "sense_definition": "A lack of emotional involvement, warmth, or interest; aloofness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His cold <w>detachment</w> made it hard for anyone to feel close to him.",
                            "target_lang_translations": {
                                "ru": "Из-за его холодной <w>отчуждённости</w> мало кому удавалось с ним сблизиться."
                            }
                        },
                        {
                            "text": "She maintained an air of <w>detachment</w> throughout the heated family discussion.",
                            "target_lang_translations": {
                                "ru": "На протяжении всего бурного семейного спора она сохраняла вид <w>отстранённости</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aloofness",
                        "indifference",
                        "nonchalance"
                    ],
                    "antonyms": [
                        "warmth",
                        "engagement"
                    ],
                    "common_phrases": [
                        "air of detachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие эмоциональной вовлечённости, душевной теплоты или интереса; замкнутость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчуждённость",
                                "target_lang_sense_clarification": "холодность и эмоциональная дистанция"
                            },
                            {
                                "target_lang_word": "отстранённость",
                                "target_lang_sense_clarification": "нежелание идти на сближение, сухость в общении"
                            },
                            {
                                "target_lang_word": "отрешённость",
                                "target_lang_sense_clarification": "равнодушие к происходящему вокруг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c9071be-3a63-3948-82ab-277be698088b",
                    "sense_definition": "A military group or unit dispatched separately from the main body for a specific duty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>detachment</w> of soldiers was sent to secure the border crossing.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>отряд</w> солдат был направлен для охраны пограничного перехода."
                            }
                        },
                        {
                            "text": "The general ordered a cavalry <w>detachment</w> to scout the valley ahead.",
                            "target_lang_translations": {
                                "ru": "Генерал приказал кавалерийскому <w>отряду</w> провести разведку в долине впереди."
                            }
                        }
                    ],
                    "synonyms": [
                        "unit",
                        "contingent"
                    ],
                    "common_phrases": [
                        "small detachment",
                        "military detachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воинское подразделение или группа, выделенная из состава основных сил для выполнения специальной задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "воинское формирование для особой задачи"
                            },
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "низшее воинское подразделение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48e5ea15-20d0-321e-8eb5-20365262755b",
                    "sense_definition": "The act or process of separating or disconnecting one thing from another.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sudden vision loss can indicate retinal <w>detachment</w>, which requires immediate surgery.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря зрения может указывать на <w>отслойку</w> сетчатки, требующую немедленного хирургического вмешательства."
                            }
                        },
                        {
                            "text": "The design allows for the quick <w>detachment</w> of the trailer from the truck.",
                            "target_lang_translations": {
                                "ru": "Конструкция обеспечивает быстрое <w>отсоединение</w> прицепа от грузовика."
                            }
                        }
                    ],
                    "synonyms": [
                        "disconnection",
                        "separation"
                    ],
                    "antonyms": [
                        "attachment",
                        "connection"
                    ],
                    "common_phrases": [
                        "retinal detachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс разъединения, отделения или отсоединения одного предмета от другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделение",
                                "target_lang_sense_clarification": "разъединение, отсоединение частей"
                            },
                            {
                                "target_lang_word": "отслойка",
                                "target_lang_sense_clarification": "в медицине: отслоение ткани, например сетчатки"
                            },
                            {
                                "target_lang_word": "отсоединение",
                                "target_lang_sense_clarification": "размыкание или расцепление объектов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71aa50cf-6828-3a79-926d-fdcd7db04601",
                    "sense_definition": "The physical state of being unattached, disconnected, or isolated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physical <w>detachment</w> of the cable caused the machine to lose power.",
                            "target_lang_translations": {
                                "ru": "Физическое <w>отсоединение</w> кабеля привело к обесточиванию оборудования."
                            }
                        },
                        {
                            "text": "Damage to the wing resulted in the total <w>detachment</w> of the fuel tank.",
                            "target_lang_translations": {
                                "ru": "Повреждение крыла привело к полному <w>отрыву</w> топливного бака."
                            }
                        }
                    ],
                    "synonyms": [
                        "isolation",
                        "disconnection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое состояние разъединённости, оторванности или изоляции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсоединение",
                                "target_lang_sense_clarification": "состояние отключения или размыкания контакта"
                            },
                            {
                                "target_lang_word": "отрыв",
                                "target_lang_sense_clarification": "физическое отделение детали или части конструкции"
                            },
                            {
                                "target_lang_word": "отделённость",
                                "target_lang_sense_clarification": "состояние разъединённости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f10b97e-a647-3f3a-8680-f3f74052e147",
                    "sense_definition": "The act of sending or separating a military unit away from the main force for a special mission.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commander authorized the <w>detachment</w> of two companies to assist the allies.",
                            "target_lang_translations": {
                                "ru": "Командир дал согласие на <w>выделение</w> двух рот для помощи союзникам."
                            }
                        },
                        {
                            "text": "Strategic planning required the temporary <w>detachment</w> of naval forces to patrol the coastline.",
                            "target_lang_translations": {
                                "ru": "Стратегический план требовал временного <w>откомандирования</w> военно-морских сил для патрулирования побережья."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по выделению или направлению воинской части из состава главных сил для выполнения спецзадания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделение",
                                "target_lang_sense_clarification": "направление воинского подразделения на спецзадание"
                            },
                            {
                                "target_lang_word": "откомандирование",
                                "target_lang_sense_clarification": "направление группы войск в распоряжение других сил"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17e701c3-23f9-3a6c-bf78-004b525313a8",
                    "sense_definition": "A permanent military or police unit established for specialized tasks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "military_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was assigned to the special operations <w>detachment</w> at the naval base.",
                            "target_lang_translations": {
                                "ru": "Её направили в <w>отряд</w> специальных операций на военно-морской базе."
                            }
                        },
                        {
                            "text": "The security <w>detachment</w> guarded the embassy day and night.",
                            "target_lang_translations": {
                                "ru": "Охранный <w>отряд</w> круглосуточно охранял посольство."
                            }
                        }
                    ],
                    "common_phrases": [
                        "security detachment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянное воинское или полицейское подразделение, сформированное для выполнения специализированных задач."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "специальное военное или силовое подразделение"
                            },
                            {
                                "target_lang_word": "подразделение",
                                "target_lang_sense_clarification": "формирование специального назначения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f33174-eed2-375c-88cb-d22d15bd9219",
                    "sense_definition": "Any smaller part or portion separated from a main group or body for a distinct purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A small <w>detachment</w> of researchers left the main camp to collect rock samples.",
                            "target_lang_translations": {
                                "ru": "Небольшая <w>группа</w> исследователей покинула базовый лагерь для сбора образцов горных пород."
                            }
                        },
                        {
                            "text": "The committee formed a <w>detachment</w> of delegates to meet with community leaders.",
                            "target_lang_translations": {
                                "ru": "Комитет сформировал <w>делегацию</w> из своих членов для встречи с лидерами общины."
                            }
                        }
                    ],
                    "synonyms": [
                        "subgroup",
                        "section"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая часть или группа, выделенная из основного состава для конкретной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "отдельная часть команды или организации"
                            },
                            {
                                "target_lang_word": "отряд",
                                "target_lang_sense_clarification": "небольшой коллектив, направленный с заданием"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}