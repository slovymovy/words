                        "glosses": [
                            "Gesamtheit der Erwachsenen sowie ihre Lebensumstände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2369d00f-aa5d-4672-8e86-3240ad0a15bd",
                                "sense_id": "4727bc26-0f32-3669-9a38-2f2e51b589b3",
                                "text": "„Ich bereitete meine Flucht sorgfältig vor, damit die Erwachsenenwelt nichts mitbekam.“"
                            },
                            {
                                "example_id": "eb6afe49-fc80-47a6-b42e-eed85fe67d6f",
                                "sense_id": "4727bc26-0f32-3669-9a38-2f2e51b589b3",
                                "text": "„In Deutschland hat sich hingegen – vorrangig durch ein Arbeitsleben, an dem Kinder meist nicht teilhaben können – in vielen Familien eine Trennung zwischen Erwachsenen- und Kinderwelt durchgesetzt.“"
                            }
                        ],
