                        "examples": [
                            {
                                "example_id": "d60756f6-b8cc-4ceb-bdbd-c92429b58c12",
                                "sense_id": "a3ffbeb6-b08c-355e-868e-751081ba70c4",
                                "text": "Cet enfant est un larmoyeur."
                            },
                            {
                                "example_id": "932cb28f-6a63-4a45-8162-ae15ce58135e",
                                "sense_id": "a3ffbeb6-b08c-355e-868e-751081ba70c4",
                                "text": "Je ne suis pas un larmoyeur, et ne crois pas être un hypocrite."
                            },
                            {
                                "example_id": "57520d80-e437-4127-a3b1-69d2ac72bcdf",
                                "sense_id": "a3ffbeb6-b08c-355e-868e-751081ba70c4",
                                "text": "La petite releva le front, montra ses yeux mouillés, une bouche carrée comme celle des enfants larmoyeurs et cria :\n– Non, maman, non maman !"
                            }
                        ]
                    }
