                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5e62510-7132-4eae-9638-6526d19d4a19",
                                "sense_id": "f82ac4f8-9b87-35ff-acf8-1c386f52a9e5",
                                "text": "Het handschrift was zo slordig dat het bijna onleesbaar was.",
                                "translation": "The handwriting was so messy that it was almost unreadable.",
                                "english": "The handwriting was so messy that it was almost unreadable."
                            },
                            {
                                "example_id": "a6ca664f-301c-4e85-ada4-17cad5f1a281",
                                "sense_id": "f82ac4f8-9b87-35ff-acf8-1c386f52a9e5",
                                "text": "Door de vlekken was de tekst op het papier onleesbaar geworden.",
                                "translation": "The text on the paper had become illegible due to the stains.",
                                "english": "The text on the paper had become illegible due to the stains."
                            },
                            {
                                "example_id": "daad70c1-4a2a-4269-97d5-314ad815bbd3",
                                "sense_id": "f82ac4f8-9b87-35ff-acf8-1c386f52a9e5",
                                "text": "De oude inscripties waren door de tand des tijds onleesbaarder geworden.",
                                "translation": "The ancient inscriptions had become more illegible over time.",
                                "english": "The ancient inscriptions had become more illegible over time."
                            }
                        ]
                    }
