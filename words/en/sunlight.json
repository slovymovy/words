    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41ca96ee-dca9-3f8a-893c-222eefe9de92",
                    "sense_definition": "Light and energy that comes from the sun.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was filled with bright <w>sunlight</w>.",
                            "target_lang_translations": {
                                "ru": "Комната была залита ярким <w>солнечным светом</w>.",
                                "zh": "房间里充满了明亮的<w>阳光</w>。"
                            }
                        },
                        {
                            "text": "Plants need water and <w>sunlight</w> to grow.",
                            "target_lang_translations": {
                                "ru": "Растениям нужны вода и <w>солнечный свет</w> для роста.",
                                "zh": "植物生长需要水和<w>阳光</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunshine",
                        "daylight",
                        "sun"
                    ],
                    "common_phrases": [
                        "bright sunlight",
                        "direct sunlight",
                        "morning sunlight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свет и энергия, исходящие от солнца.",
                        "zh": "来自太阳的光和能量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнечный свет",
                                "target_lang_sense_clarification": "электромагнитное излучение солнца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阳光",
                                "target_lang_sense_clarification": "太阳发出的光线"
                            },
                            {
                                "target_lang_word": "日光",
                                "target_lang_sense_clarification": "太阳的光照"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e7f2d2a-d207-363c-bf6f-bc45ea7019f5",
                    "sense_definition": "A feeling of happiness, hope, or positivity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her smile brought a little <w>sunlight</w> into the gloomy room.",
                            "target_lang_translations": {
                                "ru": "Её улыбка принесла немного <w>света</w> в мрачную комнату.",
                                "zh": "她的微笑给阴沉的房间带来了一丝<w>希望</w>。"
                            }
                        },
                        {
                            "text": "He tried to find some <w>sunlight</w> in the difficult situation.",
                            "target_lang_translations": {
                                "ru": "Он пытался найти какой-то <w>просвет</w> в этой сложной ситуации.",
                                "zh": "他试图在困境中寻找一丝<w>曙光</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hope",
                        "optimism"
                    ],
                    "common_phrases": [
                        "ray of sunlight",
                        "bring sunlight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство счастья, надежды или позитива.",
                        "zh": "一种快乐、希望或积极的感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свет",
                                "target_lang_sense_clarification": "метафорически: радость, надежда"
                            },
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "появление надежды в трудной ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "希望",
                                "target_lang_sense_clarification": "比喻带来光明和希望"
                            },
                            {
                                "target_lang_word": "曙光",
                                "target_lang_sense_clarification": "比喻困难中出现的希望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14b54280-8fcb-332a-a1dc-d0f2f6624acc",
                    "sense_definition": "The time of day when the sun rises; synonym of <w>sunrise</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were already in the fields by <w>sunlight</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры были уже в полях с <w>рассветом</w>.",
                                "zh": "农民们在<w>黎明</w>时分就已经在地里干活了。"
                            }
                        },
                        {
                            "text": "We must leave the camp before <w>sunlight</w>.",
                            "target_lang_translations": {
                                "ru": "Мы должны покинуть лагерь до <w>восхода солнца</w>.",
                                "zh": "我们必须在<w>日出</w>前离开营地。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunrise",
                        "dawn",
                        "sunup",
                        "first light",
                        "break of day"
                    ],
                    "common_phrases": [
                        "at sunlight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время суток, когда встает солнце; синоним слова <w>sunrise</w>.",
                        "zh": "太阳升起的时间；与 sunrise 同义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассвет",
                                "target_lang_sense_clarification": "время перед восходом солнца"
                            },
                            {
                                "target_lang_word": "восход солнца",
                                "target_lang_sense_clarification": "момент появления солнца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黎明",
                                "target_lang_sense_clarification": "天刚亮的时候"
                            },
                            {
                                "target_lang_word": "日出",
                                "target_lang_sense_clarification": "太阳升起的时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b3cf8b7-cf1a-3df1-b513-38b3c7a3046f",
                    "sense_definition": "Relating to the layer of the ocean that receives enough light for photosynthesis; synonym of <w>photic</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most marine life is found in the <w>sunlight</w> zone.",
                            "target_lang_translations": {
                                "ru": "Большая часть морской жизни обитает в зоне <w>солнечного света</w>.",
                                "zh": "大多数海洋生物都生活在<w>透光层</w>。"
                            }
                        },
                        {
                            "text": "Plants cannot grow below the <w>sunlight</w> layer of the ocean.",
                            "target_lang_translations": {
                                "ru": "Растения не могут расти ниже слоя океана, куда проникает <w>солнечный свет</w>.",
                                "zh": "植物无法在海洋的<w>透光层</w>以下生长。"
                            }
                        }
                    ],
                    "synonyms": [
                        "photic"
                    ],
                    "common_phrases": [
                        "sunlight zone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к слою океана, получающему достаточно света для фотосинтеза.",
                        "zh": "指海洋中光照充足、足以进行光合作用的区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солнечный свет",
                                "target_lang_sense_clarification": "в контексте проникновения света в воду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "透光层",
                                "target_lang_sense_clarification": "海洋中阳光能照射到的表层"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4fdece3a-d961-33e5-af97-e9736976b861",
                    "sense_definition": "To work a secondary job during the day, often in contrast to working a main job at night.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works at a bar at night and <w>sunlights</w> as a painter.",
                            "target_lang_translations": {
                                "ru": "Он работает в баре по ночам, а днем <w>подрабатывает</w> маляром.",
                                "zh": "他晚上在酒吧工作，白天<w>兼职</w>做油漆工。"
                            }
                        },
                        {
                            "text": "She <w>sunlights</w> to earn extra money for her family.",
                            "target_lang_translations": {
                                "ru": "Она <w>подрабатывает днем</w>, чтобы заработать дополнительные деньги для семьи.",
                                "zh": "她通过<w>兼职</w>为家里赚取额外的收入。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "play on moonlighting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать на второй работе днем, часто в противоположность работе ночью.",
                        "zh": "指白天从事第二份工作，通常与夜间的主业相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрабатывать днем",
                                "target_lang_sense_clarification": "иметь дополнительную дневную работу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兼职",
                                "target_lang_sense_clarification": "从事额外的工作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}