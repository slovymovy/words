                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lecanomancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bfa7132-6033-3408-961f-792e38ce691e",
                                        "entry_id": "1c90f1bf-4da2-3e58-8a94-71494e562229",
                                        "glosses": [
                                            "Divination by interpreting the sound or effect of an object or substance (commonly a gem) falling into a body of water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6725f183-8b0b-47b9-aa11-0a62e5303efe",
                                                "sense_id": "4bfa7132-6033-3408-961f-792e38ce691e",
                                                "text": "1610 Vives in J. Healey Saint Augustine of the Citie of God\nDiuination generally was done by diuers means..Hydromancy..done..in a basen of water, which is called Lecanomancie, in which Strabo sayth the Asians are singular."
                                            },
                                            {
                                                "example_id": "47ef0532-f4d0-4c21-8de9-dddac66c29a0",
                                                "sense_id": "4bfa7132-6033-3408-961f-792e38ce691e",
                                                "text": "1660 Urquhart tr. Rabelais Gargantua & Pantagruel iii. xxv.\nHave you a mind (quoth Her Trippa) to have the truth of the matter yet more fully and amply disclosed unto you..by Leconomancy, of old in prime request amongst the Assyrians, and thoroughly tried by Hermolaus Barbarus."
                                            },
                                            {
                                                "example_id": "3989816f-8cc3-423c-b435-de785aa0a7c5",
                                                "sense_id": "4bfa7132-6033-3408-961f-792e38ce691e",
                                                "text": "1893 Howitt tr. Ennemoser Hist. Magic ii.\nAmong the various other kinds of divination not here mentioned may be enumerated Chilomancy performed with keys; Alphitomancy or Aleuromancy, by flour; Keraunoscopia, by the consideration of thunder; Eychnomancy, by lamps; Ooscopy, by eggs; Licanomancy by a basin of water; Palpitatim, Salisatio, by the pulsation or motion of some member etc."
                                            },
                                            {
                                                "example_id": "d34a316c-ca9e-4bb3-95fd-8734d4f81d8d",
                                                "sense_id": "4bfa7132-6033-3408-961f-792e38ce691e",
                                                "text": "1931 Lock tr. de Givry Picture Museum of Sorcery\nI may mention further lecanomancy, which was performed by letting precious stones drop into water; a mysterious little whistling resulted which announced the thing desired."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
