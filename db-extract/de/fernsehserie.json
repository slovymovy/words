                "senses": [
                    {
                        "sense_id": "0b10f3e7-b961-36a9-b066-17dbf9f3580b",
                        "entry_id": "aa6e1f51-dd0f-3822-bbcc-295aca131c2c",
                        "glosses": [
                            "unter gleichem Titel über längere Zeit fortgeführte Filmserie im Fernsehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7930f47f-d84a-4d33-a620-84fcf1ba3179",
                                "sense_id": "0b10f3e7-b961-36a9-b066-17dbf9f3580b",
                                "text": "„Rechts von mir wird über eine Fernsehserie debattiert, die ich nicht kenne.“"
                            },
                            {
                                "example_id": "a3aa7949-86d4-4a52-84cd-05dbf8c26133",
                                "sense_id": "0b10f3e7-b961-36a9-b066-17dbf9f3580b",
                                "text": "„Die Fernsehserie mit Alfred Tetzlaff konnte Oma nicht leiden.“"
                            },
                            {
                                "example_id": "ce457efa-765e-4ada-930e-e1851775711c",
                                "sense_id": "0b10f3e7-b961-36a9-b066-17dbf9f3580b",
                                "text": "„Die Mahlzeit ließ das Eis schmelzen, das Gespräch lief von selbst, wir redeten über Reisen, Fernsehserien und gemeinsame Bekannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
