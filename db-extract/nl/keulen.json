                        "entry_id": "8f2b6e9a-f5ec-39fb-aac3-4dd1aa00a096",
                        "glosses": [
                            "een stadsdistrict en stad in Duitsland, grootste stad in de deelstaat Noord-Rijnland-Westfalen"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
