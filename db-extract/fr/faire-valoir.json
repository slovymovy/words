                                    },
                                    {
                                        "sense_id": "880a9125-6bc6-3acb-b680-1d1d5b71ac01",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "Thin aluminium/aluminum (or, formerly, tin) used for wrapping food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08cbbee1-2393-4d65-8264-bd45479aa2b7",
                                                "sense_id": "880a9125-6bc6-3acb-b680-1d1d5b71ac01",
                                                "text": "wrap the sandwich up in foil"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c75e08b-b89c-3885-a3e2-ccc0b7e7baac",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "A thin layer of metal put between a jewel and its setting to make it seem more brilliant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a54d744-e99a-3fb1-81c0-17fc64270554",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "In literature, theatre/theater, etc., a character who helps emphasize the traits of the main character and who usually acts as an opponent or antagonist, but can also serve as the sidekick of the protagonist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4a91874-8c7e-45ed-a538-b22fbd53bc38",
                                                "sense_id": "7a54d744-e99a-3fb1-81c0-17fc64270554",
                                                "text": "Whereas the female invests heavily in the wake of conception, the male invests heavily prior to conception. Hitherto, the male has been regarded as the mere foil to the heavy investment in reproduction that renders the female the logjam (the limiting factor) in reproduction – reproduction overall is expandable by increasing the number of females, not by increasing the number of males."
                                            },
                                            {
                                                "example_id": "093e8939-c7f7-4126-81aa-9f25beaa957f",
                                                "sense_id": "7a54d744-e99a-3fb1-81c0-17fc64270554",
                                                "text": "As Puss comes to realize his legendary status is not a substitute for interpersonal connection, his interactions with Kitty and the therapy dog start to take on a surprising amount of weight, while Goldilocks serves as a well-realized foil who has more in common with Puss that is at first apparent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "551ec872-71bc-32d4-a03d-3b78530815c5",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "Anything that acts by contrast to emphasise the characteristics of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "579e538a-353e-46e0-b7c0-4ed3f4d8ba2b",
                                                "sense_id": "551ec872-71bc-32d4-a03d-3b78530815c5",
                                                "text": "As she a black silk cap on him begun / To set, for foil of his milk-white to serve.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "4f40861a-c5bd-46b1-a51d-63d0dcdd2b1a",
                                                "sense_id": "551ec872-71bc-32d4-a03d-3b78530815c5",
                                                "text": "1725-1726, William Broome, The Odyssey\nHector has also a foil to set regard"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb544d0-e5e3-33cd-8823-5632383bc94e",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "A very thin sword with a blunted (or foiled) tip"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e738bee6-af29-418f-9708-bcf0bfd3d8bd",
                                                "sense_id": "9fb544d0-e5e3-33cd-8823-5632383bc94e",
                                                "text": "Blunt as the fencer's foils, which hit, but hurt not."
                                            },
                                            {
                                                "example_id": "79ebb18a-b812-4743-8ba1-c07ee11a7d06",
                                                "sense_id": "9fb544d0-e5e3-33cd-8823-5632383bc94e",
                                                "text": "1784-1810, William Mitford, History of Greece\nSocrates contended with a foil against Demosthenes with a sword."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5221a51-c9bd-3c43-bfb0-678ddbaa3f6a",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "A thin, transparent plastic material on which marks are made and projected for the purposes of presentation. See transparency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dad14e33-385a-309e-b9d9-920a5ef8b46a",
                                        "entry_id": "dbdd96ea-2449-3047-87df-dd31d630d535",
                                        "glosses": [
                                            "A premium trading card with a glossy finish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b7f457c-0081-4cb6-8ec0-7b012d52a889",
                                                "sense_id": "dad14e33-385a-309e-b9d9-920a5ef8b46a",
                                                "text": "I personally would collect all the foils from Base Set before this one, but the market is what the market is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1100321d-6000-3034-8860-e1ff8c6fbab7",
