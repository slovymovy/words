                ],
                "senses": [
                    {
                        "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                        "entry_id": "8eceaea7-1b93-36b7-9ce4-d6616c6472cc",
                        "glosses": [
                            "Fahrzeug, das ein anderes Fahrzeug zieht, welches selbst keinen funktionierenden Antrieb besitzt (zum Beispiel einen Anhänger)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2199e5-eaca-445a-99b5-4ff281a2620c",
                                "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                                "text": "„Hinter dem Zugfahrzeug, für das ein Anhängerzuschlag erhoben wird, können ohne steuerliche Nachteile auch die versteuerten Wohnwagenanhänger mitgeführt werden.“"
                            },
                            {
                                "example_id": "1854ca42-ec7c-4469-8861-706f64b61083",
                                "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                                "text": "„Die technisch zulässige Stützlast des Zugfahrzeugs ist vom Hersteller festzulegen; sie darf - ausgenommen bei Krafträdern - nicht geringer als 25 kg sein.“"
                            },
                            {
                                "example_id": "19d5b611-5cd7-408e-91b3-61bca464f5fc",
                                "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                                "text": "„Crash auf dem Frankfurter Flughafen: Eine Maschine der Thai International ist beim Rangieren mit einem Zugfahrzeug zusammengeprallt.“"
                            },
                            {
                                "example_id": "4cdc84bc-4063-4d5f-af0d-e1df7716d7ce",
                                "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                                "text": "„. Das System nutzt die Sensorik des ESP und greift ein, sobald es eine Schlingerbewegung des Anhängers erkennt. Dann wird das Zugfahrzeug mittels Gaswegnehmen und Bremseingriff so lange verzögert, bis sich das Gespann wieder stabilisiert.“"
                            },
                            {
                                "example_id": "11409593-8752-4642-a43e-47e433e9cecf",
                                "sense_id": "0ef95ca8-2b77-3a7c-b023-e2e439800edc",
                                "text": "„Da auch dort die Landwirtschaft zunehmend niedergeht und somit immer weniger Traktoren als Zugfahrzeuge für die TSA zur Verfügung stehen, war die Ausrückebereitschaft dortiger Feuerwehren nicht mehr gewährleistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
