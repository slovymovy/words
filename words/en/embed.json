{
    "word_family": [
        "embeddable",
        "embeddedness",
        "embedding",
        "re-embed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc7d63b2-175d-3276-92d0-bfb8a5489f6a",
                    "sense_definition": "To fix or set something firmly and deeply into a surrounding mass or substance.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_placement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction workers had to <w>embed</w> the steel posts into the concrete foundation for stability.",
                            "target_lang_translations": {
                                "ru": "Строителям пришлось <w>вделать</w> стальные стойки в бетонный фундамент для устойчивости."
                            }
                        },
                        {
                            "text": "The ancient fossils were <w>embedded</w> in rock for millions of years before being discovered.",
                            "target_lang_translations": {
                                "ru": "Древние окаменелости были <w>заключены</w> в горную породу на протяжении миллионов лет, прежде чем их обнаружили."
                            }
                        }
                    ],
                    "synonyms": [
                        "fix",
                        "lodge",
                        "plant",
                        "root"
                    ],
                    "antonyms": [
                        "extract",
                        "remove",
                        "detach"
                    ],
                    "common_phrases": [
                        "embed in concrete",
                        "deeply embedded",
                        "firmly embed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно и глубоко закрепить что-либо в окружающей массе или веществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вделывать",
                                "target_lang_sense_clarification": "закреплять внутри чего-либо"
                            },
                            {
                                "target_lang_word": "вставлять",
                                "target_lang_sense_clarification": "помещать внутрь"
                            },
                            {
                                "target_lang_word": "закреплять",
                                "target_lang_sense_clarification": "фиксировать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2816930-30de-30d7-b2f3-cfab19d4d2f9",
                    "sense_definition": "To incorporate a digital object, such as a video, image, or code, into another document or file.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "digital_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can easily <w>embed</w> a video from a streaming site into your personal blog post.",
                            "target_lang_translations": {
                                "ru": "Вы можете легко <w>встроить</w> видео со стримингового сайта в свой личный блог."
                            }
                        },
                        {
                            "text": "The designer decided to <w>embed</w> a chart into the report to make the data clearer.",
                            "target_lang_translations": {
                                "ru": "Дизайнер решил <w>внедрить</w> диаграмму в отчет, чтобы сделать данные более наглядными."
                            }
                        }
                    ],
                    "synonyms": [
                        "insert",
                        "integrate",
                        "incorporate"
                    ],
                    "antonyms": [
                        "unlink",
                        "exclude"
                    ],
                    "common_phrases": [
                        "embed a video",
                        "embed a link",
                        "embed code"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включать цифровой объект, такой как видео, изображение или код, в другой документ или файл."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встраивать",
                                "target_lang_sense_clarification": "интегрировать код или медиа"
                            },
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "включать в состав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "056bc2ee-8b85-345a-8efe-37c18652f2bd",
                    "sense_definition": "To assign a person, such as a journalist, to travel and live with a specific group, often a military unit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news agency decided to <w>embed</w> a reporter with the troops during the conflict.",
                            "target_lang_translations": {
                                "ru": "Новостное агентство решило <w>прикомандировать</w> репортера к войскам во время конфликта."
                            }
                        },
                        {
                            "text": "It is common for journalists to <w>embed</w> with units to get a firsthand view of the situation.",
                            "target_lang_translations": {
                                "ru": "Журналисты часто <w>внедряются</w> в подразделения, чтобы увидеть ситуацию своими глазами."
                            }
                        }
                    ],
                    "synonyms": [
                        "attach",
                        "assign"
                    ],
                    "common_phrases": [
                        "embed with troops",
                        "embed a reporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Назначать человека, например журналиста, для поездки и проживания с определенной группой, часто с воинским подразделением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикомандировывать",
                                "target_lang_sense_clarification": "назначать к группе"
                            },
                            {
                                "target_lang_word": "внедрять",
                                "target_lang_sense_clarification": "вводить в состав группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79bf8569-e837-36da-9e6f-696d0bb48214",
                    "sense_definition": "To define a mathematical function from one set to another that preserves certain structures or properties.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematical_mapping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In topology, we can <w>embed</w> a circle into a three-dimensional space in various ways.",
                            "target_lang_translations": {
                                "ru": "В топологии мы можем <w>вложить</w> окружность в трехмерное пространство различными способами."
                            }
                        },
                        {
                            "text": "The theorem explains how to <w>embed</w> a manifold into a higher-dimensional Euclidean space.",
                            "target_lang_translations": {
                                "ru": "Теорема объясняет, как <w>вложить</w> многообразие в евклидово пространство более высокой размерности."
                            }
                        }
                    ],
                    "synonyms": [
                        "map"
                    ],
                    "common_phrases": [
                        "embed into space"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определять математическую функцию из одного множества в другое, сохраняющую определенные структуры или свойства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вкладывать",
                                "target_lang_sense_clarification": "математическое отображение"
                            },
                            {
                                "target_lang_word": "погружать",
                                "target_lang_sense_clarification": "в топологии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a106d71f-8ca5-31cf-b3a0-ce01047719ef",
                    "sense_definition": "A piece of digital content, like a video or social media post, that is integrated into another webpage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "digital_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website's layout was broken because one <w>embed</w> was not loading correctly.",
                            "target_lang_translations": {
                                "ru": "Макет сайта был нарушен, потому что одна <w>вставка</w> загружалась некорректно."
                            }
                        },
                        {
                            "text": "Adding an HTML5 video <w>embed</w> is simple and improves user engagement on the page.",
                            "target_lang_translations": {
                                "ru": "Добавление <w>встроенного</w> видео HTML5 — это просто и повышает вовлеченность пользователей на странице."
                            }
                        }
                    ],
                    "synonyms": [
                        "plugin",
                        "integration"
                    ],
                    "common_phrases": [
                        "video embed",
                        "social media embed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фрагмент цифрового контента, например видео или пост в социальной сети, интегрированный в другую веб-страницу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вставка",
                                "target_lang_sense_clarification": "встроенный объект"
                            },
                            {
                                "target_lang_word": "эмбед",
                                "target_lang_sense_clarification": "сленг, встроенный код"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7849c35e-eceb-3ece-8cb3-51b013a4c252",
                    "sense_definition": "A person, typically a journalist, who is assigned to live and work within a specific group or military unit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military <w>embed</w> provided daily updates from the front lines of the operation.",
                            "target_lang_translations": {
                                "ru": "Военный <w>спецкор</w> ежедневно передавал сводки с передовой операции."
                            }
                        },
                        {
                            "text": "As an <w>embed</w> with the campaign, the reporter had unique access to the candidate.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>прикомандированным</w> к кампании, репортер имел уникальный доступ к кандидату."
                            }
                        }
                    ],
                    "synonyms": [
                        "embedded reporter"
                    ],
                    "common_phrases": [
                        "military embed",
                        "journalistic embed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обычно журналист, прикомандированный для жизни и работы в определенной группе или воинском подразделении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикомандированный журналист",
                                "target_lang_sense_clarification": "в составе группы"
                            },
                            {
                                "target_lang_word": "внедренный специалист",
                                "target_lang_sense_clarification": "внутри организации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17db3181-7fc0-34f8-b59b-3c95ed80475e",
                    "sense_definition": "A hardware component or computer system that is built into a larger machine or device.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hardware_integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smart refrigerator uses a specialized <w>embed</w> to manage its internal temperature sensors.",
                            "target_lang_translations": {
                                "ru": "Умный холодильник использует специализированную <w>встроенную систему</w> для управления внутренними датчиками температуры."
                            }
                        },
                        {
                            "text": "Engineers are testing a new <w>embed</w> for the car's navigation and entertainment system.",
                            "target_lang_translations": {
                                "ru": "Инженеры тестируют новый <w>встраиваемый модуль</w> для навигационной и развлекательной системы автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "embedded system"
                    ],
                    "common_phrases": [
                        "hardware embed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аппаратный компонент или компьютерная система, встроенная в более крупную машину или устройство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встроенная система",
                                "target_lang_sense_clarification": "аппаратное обеспечение"
                            },
                            {
                                "target_lang_word": "встраиваемый модуль",
                                "target_lang_sense_clarification": "компонент устройства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04eb78b3-5c23-35c3-bcbf-38b032bdaa38",
                    "sense_definition": "A hidden message or image placed within an advertisement to influence the viewer subconsciously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "psychological_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some critics claim that the commercial contains a subtle <w>embed</w> designed to trigger hunger.",
                            "target_lang_translations": {
                                "ru": "Некоторые критики утверждают, что рекламный ролик содержит тонкую <w>скрытую вставку</w>, предназначенную для того, чтобы вызвать чувство голода."
                            }
                        },
                        {
                            "text": "He studied the advertisement closely to see if he could find any hidden <w>embeds</w>.",
                            "target_lang_translations": {
                                "ru": "Он внимательно изучил рекламу, чтобы проверить, сможет ли он найти какие-либо скрытые <w>внедрения</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "subliminal message"
                    ],
                    "common_phrases": [
                        "subliminal embed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытое сообщение или изображение, помещенное в рекламу для подсознательного воздействия на зрителя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрытая вставка",
                                "target_lang_sense_clarification": "подсознательное воздействие"
                            },
                            {
                                "target_lang_word": "внедренный образ",
                                "target_lang_sense_clarification": "в рекламе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}