                            },
                            {
                                "target_lang_word": "rant",
                                "target_lang_sense_clarification": "to speak or shout at length in a wild, impassioned way"
                            },
                            {
                                "target_lang_word": "rave",
                                "target_lang_sense_clarification": "to talk wildly or incoherently, as if in a fit of rage"
                            },
                            {
                                "target_lang_word": "fume",
                                "target_lang_sense_clarification": "to be very angry"
                            }
                        ]
