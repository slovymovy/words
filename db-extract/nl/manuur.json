                        "examples": [
                            {
                                "example_id": "222ce735-6c4d-4eda-a0b7-8d040e9278a2",
                                "sense_id": "465843ab-9e8a-3793-93db-b623d4b6a899",
                                "text": "De klus kostte in totaal 8 manuren om te voltooien.",
                                "translation": "The task took a total of 8 man-hours to complete.",
                                "english": "The task took a total of 8 man-hours to complete."
                            },
                            {
                                "example_id": "0701a3eb-299f-487a-ab68-763c8504c9dd",
                                "sense_id": "465843ab-9e8a-3793-93db-b623d4b6a899",
                                "text": "Eén persoon kan gemiddeld 5 manuren per dag werken.",
                                "translation": "One person can work an average of 5 man-hours per day.",
                                "english": "One person can work an average of 5 man-hours per day."
                            },
                            {
                                "example_id": "60f8b3e2-f545-4f01-bac7-e51e8ed64d90",
                                "sense_id": "465843ab-9e8a-3793-93db-b623d4b6a899",
                                "text": "Deze taak vereist 3 manuren van je tijd.",
                                "translation": "This task requires 3 man-hours of your time.",
                                "english": "This task requires 3 man-hours of your time."
                            }
                        ]
                    }
