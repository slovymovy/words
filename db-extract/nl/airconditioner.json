                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5071f00-1556-4073-87b3-b4749986f2bd",
                        "source_entry_id": "33ec5e31-01ec-3074-bb6f-43deae9ea7f3",
                        "source_sense_id": "cfa2ab72-320b-31ee-8376-7ad886ab634d",
                        "source_sense_description": "een apparaat dat voor airconditioning zorgt",
                        "target_lang_word": "climatiseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "climatiseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                        "entry_id": "098073f8-8c79-3d2b-96dc-0cff76aa3d79",
                                        "glosses": [
                                            "Appareil servant à modifier les caractéristiques thermiques et hygrométriques de l’atmosphère d’un local, afin de le rendre plus agréable."
                                        ],
                                        "tags": [
                                            "Génie climatique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c551a17a-add1-492f-9edc-21342148a7d1",
                                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                                "text": "Poursuivant notre flânage, nous voyons depuis la ruelle l’envers du décor: des dizaines de climatiseurs, fixés aux murs, soufflent la chaleur des restos vers l’extérieur."
                                            },
                                            {
                                                "example_id": "3b8cf487-7db3-40a9-8642-128a742b339a",
                                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                                "text": "Tous ces courtisans, profiteurs et forniqueurs dans les bureaux où les climatiseurs ne s'arrêtaient jamais de ronronner, trouvèrent au Président Bagabaga Daba des qualités telles que ses ancêtres durent se retourner dans leur tombe."
                                            },
                                            {
                                                "example_id": "2421b55c-8207-4274-b1ea-7c76a9f23013",
                                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                                "text": "Ce soir, je brancherai le climatiseur pour dormir convenablement."
                                            },
                                            {
                                                "example_id": "34766cf5-f7df-4ce4-a492-b5724a507b58",
                                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                                "text": "Willis Carrier est l’homme que vous devez remercier si vous possédez un climatiseur pour faire face aux périodes de canicule. Cet ingénieur américain a inventé le prototype de l’appareil en 1902 (...)."
                                            },
                                            {
                                                "example_id": "5dcf7499-c283-41be-a839-5bba8a6758d7",
                                                "sense_id": "dcf1e35f-c5d8-30ea-8c5e-6384f82d0358",
                                                "text": "Si par contre d’ici à dix ans on n’installait que des climatiseurs individuels, l’augmentation de température monterait à 2°C."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
