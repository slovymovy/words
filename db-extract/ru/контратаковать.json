                    {
                        "translation_id": "2263c599-ce90-413f-828f-c4be428e7543",
                        "source_entry_id": "b275d09b-331b-377c-be97-83cdbccc2132",
                        "source_sense_id": "56930534-69ca-3197-8297-aaf19d185897",
                        "target_lang_word": "contre-attaquer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contre-attaquer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                        "entry_id": "4c819ada-04fb-3710-838e-cc13edac1371",
                                        "glosses": [
                                            "Attaquer après avoir repoussé une attaque adverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "992e7b5e-2d5a-42d4-9d1a-c7379bbe6cf2",
                                                "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                                "text": "Vers 10 heures, la 10ᵉ division ayant atteint le front Bayonville, Sivry, prenait pour objectifs Fossé, Nouart. Un peu après, de l'infanterie ennemie qui avait occupé la ferme de Brière et Doulcon était contre-attaquée par le 4ᵉ (5ᵉ corps) et par un bataillon du 115ᵉ."
                                            },
                                            {
                                                "example_id": "60a74e90-ab53-4de2-a929-3517d3f2f361",
                                                "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                                "text": "Sur les communiqués, on apprend que les Allemands repoussent, victorieusement bien sûr, les contre-attaques soviétiques. Donc nous savons indirectement que les Russes ont commencé à contre-attaquer."
                                            },
                                            {
                                                "example_id": "b5680a08-7e87-4f9a-99ad-ba9d18547acc",
                                                "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                                "text": "Sur un siège éjectable depuis qu’il a embrassé de force sur la bouche la joueuse Jenni Hermoso après la victoire de l’Espagne dimanche au Mondial féminin, le grand patron du foot espagnol, Luis Rubiales, a pris tout le monde de court hier en refusant de démissionner et en contre-attaquant."
                                            },
                                            {
                                                "example_id": "8d64315d-e705-4d31-ab6a-bb8f7e01964c",
                                                "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                                "text": "Mᵉ Duval Perron, pour la défense, a contre-attaqué en demandant un sursis probatoire renforcé qui permettrait à son client de travailler, de se soigner et surtout de voir son fils."
                                            },
                                            {
                                                "example_id": "686a9142-192b-484b-8211-7b0040a188ac",
                                                "sense_id": "66bdc6ea-9d3a-314b-8bb4-e8d347c6d971",
                                                "text": "Les riverains n'apprécient plus de voir leur route départementale transformée en itinéraire alternatif. Pour contre-attaquer, le maire de Camphin-en-Carembault (Nord) a installé des panneaux stop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
