                        ],
                        "form": "die Hausmanns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                        "entry_id": "88dcd8b3-9db3-3bb1-8495-2ad576eec7dd",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5722d0a8-9710-4ffb-b96b-5b997d8699ba",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Frau Hausmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0dbbeefb-57d8-492f-a76f-8a6644f94c5c",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Herr Hausmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "006f2d33-e6c2-479e-aaea-d0eb569b18a1",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Die Hausmanns fliegen heute nach Kanada."
                            },
                            {
                                "example_id": "c389a816-f22e-4911-a177-5a9e6c2acad4",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Der Hausmann trägt nie die Pullover, die die Hausmann ihm strickt."
                            },
                            {
                                "example_id": "ef65d88c-1fdf-4cd3-b5a5-6dc0f54bb10e",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hausmann kommt, geht der Herr Hausmann.“"
                            },
                            {
                                "example_id": "b1189d7f-2f8b-4fbb-ba10-7513ca3df685",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Hausmann kommt und geht."
                            },
                            {
                                "example_id": "e73f7054-6543-437b-a21e-38b1da8f41e1",
                                "sense_id": "a3b7f2f9-9ad3-3332-93e4-0116c1473463",
                                "text": "Hausmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
