                "senses": [
                    {
                        "sense_id": "36a107d7-0ffa-31a1-82fc-0f1ea5eb0196",
                        "entry_id": "df8360c9-1f26-357e-b317-6b9529c2ae52",
                        "glosses": [
                            "in Spanien, Lateinamerika und auf den Philippinen verbreitete gefüllte Teigtasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b10a8a54-c243-49c5-aaff-09a61acafd4f",
                                "sense_id": "36a107d7-0ffa-31a1-82fc-0f1ea5eb0196",
                                "text": "„Der Tag beginnt mit einem häuslichen Diebstahl, der den Kauf von zwei Schokoladen-Alfajores am Eingang des Schulgebäudes erlaubt, ein Schnitzelsandwich in der Pause und auf dem Weg zurück ein Dutzend Empanadas sowie drei große Pizzen in unterschiedlichen Pizzerien, um in unserem Viertel keine Aufmerksamkeit zu erregen.“"
                            },
                            {
                                "example_id": "383cfe79-f8a0-488e-a0b5-23bb4ed46b0b",
                                "sense_id": "36a107d7-0ffa-31a1-82fc-0f1ea5eb0196",
                                "text": "„Sekunden später kam sie mit einem Tablett mit gebratenen Empanadas, Bohnen, Kochbananen und Salat zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
