                            {
                                "example_id": "e8e35f97-241b-4dc5-aeda-87029710d5b4",
                                "sense_id": "ec6018ae-fb5f-3426-9509-26670f6dcc7d",
                                "text": "Pensée totalisante qui réduit toute activité humaine à un calcul économique — rentable/pas rentable — et transforme toute chose en marché."
                            },
                            {
                                "example_id": "62b6a86e-660d-488a-83aa-e754229aede3",
                                "sense_id": "ec6018ae-fb5f-3426-9509-26670f6dcc7d",
                                "text": "Toute vision totalisante de l’histoire risque de nier la complexité des faits et des acteurs."
                            }
                        ]
                    }
