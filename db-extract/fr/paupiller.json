                "senses": [
                    {
                        "sense_id": "d4ad85ed-010d-399c-afce-5f23cfd6c055",
                        "entry_id": "64c3f26a-8e39-3dfc-8c3b-56e5d5fb9789",
                        "glosses": [
                            "Ciller, bouger les paupières."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "2d8273fc-55a0-47d0-abea-4fff4aabce5d",
                                "sense_id": "d4ad85ed-010d-399c-afce-5f23cfd6c055",
                                "text": "Et arrête de paupiller comme un abruti !"
                            },
                            {
                                "example_id": "49d77df3-aa61-4705-bb22-7936c96c18bd",
                                "sense_id": "d4ad85ed-010d-399c-afce-5f23cfd6c055",
                                "text": "Je notai le tout, le vieux attendit que je lève la plume, il paupilla et dit ensuite: — Une livre de tabac par mois pour moé et une demi-livre pour ma femme Rose-Aimée."
                            },
                            {
                                "example_id": "4d81c621-30a4-42f3-a2de-6abad4b05151",
                                "sense_id": "d4ad85ed-010d-399c-afce-5f23cfd6c055",
                                "text": "J’ai jeté un coup d'œil comme distrait dans sa direction, l’ai vu qui paupillait des deux yeux."
                            }
                        ]
                    }
                ],
