                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a3f4a80-b225-4141-9bcc-d8a01e1da6ef",
                        "source_entry_id": "1cbac44c-ade1-3794-8331-ce670b4767a7",
                        "source_sense_id": "04b042ce-ee6c-381a-ac3f-045c7e3ae3d3",
                        "source_sense_description": "Jägerin",
                        "target_lang_word": "Jägerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jägerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                        "entry_id": "8341153a-be20-3843-943f-2fe0a1d0d56a",
                                        "glosses": [
                                            "weibliche Person, die auf die Jagd geht"
                                        ],
                                        "tags": [
                                            "Jagdwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "470f4f80-f30b-490b-824c-7b3526beb267",
                                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                                "text": "Erschöpft trat am Sonntagmorgen die Jägerin aus dem Wald."
                                            },
                                            {
                                                "example_id": "4e0ed4e2-680d-4329-bfd2-fc2ae3d4b313",
                                                "sense_id": "012ad76d-c340-3794-8fda-5caa01e06f16",
                                                "text": "„Er sah Elisabeth zum erstenmal völlig losgelöst von der Zeit, bei sich selbst, hingegeben einer unbefangenen und tiefen Spielerei, überschüttet von Licht und Zärtlichkeit und Liebe, ernst und gesammelt wie eine Jägerin, die ihre Waffen zum Kampfe prüft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3e3ec2e-0ee1-4484-b1bf-426845b46c17",
                        "source_entry_id": "1cbac44c-ade1-3794-8331-ce670b4767a7",
                        "source_sense_id": "4649cabd-78db-3875-836a-9c3ded38bf04",
                        "source_sense_description": "eine Stute (weibliches Pferd), welche zur Jagd eingesetzt wird",
                        "target_lang_word": "Stute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03a480b0-241e-3bad-a444-e8a5af3abf10",
                                        "entry_id": "56ae5407-78a4-3e3a-bacb-731e1af93233",
                                        "glosses": [
                                            "weibliches Tier der Familien Pferde (Equidae) und Kamele (Camelidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e839102-6ace-4e8f-8f1c-860e6b8110ce",
                                                "sense_id": "03a480b0-241e-3bad-a444-e8a5af3abf10",
                                                "text": "Die Stute grast mit ihrem Fohlen."
                                            },
                                            {
                                                "example_id": "02b8cf0a-9ea9-4e4b-8e3c-f85dd643f45f",
                                                "sense_id": "03a480b0-241e-3bad-a444-e8a5af3abf10",
                                                "text": "„Doch da stellte sich heraus, daß das Reittier des Dänen eine Stute und darum um seine Tugend besorgt war, und sowie er zu dicht mit seinem Pferd hinter der Stute ritt, begann sie zu wiehern und auszuschlagen.“"
                                            },
                                            {
                                                "example_id": "81060c43-678c-4895-8cb2-96162e91d7a4",
                                                "sense_id": "03a480b0-241e-3bad-a444-e8a5af3abf10",
                                                "text": "„So entdeckte er im Harn trächtiger Stuten einen heilenden Wirkstoff.“"
                                            },
                                            {
                                                "example_id": "40bcfc41-a3b2-4059-882f-1a1cd3593b2d",
                                                "sense_id": "03a480b0-241e-3bad-a444-e8a5af3abf10",
                                                "text": "„Abgesehen von den Schwielen sind sie feingliedrig, die langen Finger halten locker die Zügel der gutmütigen Stute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
