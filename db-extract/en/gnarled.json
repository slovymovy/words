                                    {
                                        "sense_id": "1fbf0e39-8a72-3b91-9025-38f53693cb32",
                                        "entry_id": "a9ed1d95-5eb6-3b3f-ab6f-fe7e8f51feca",
                                        "glosses": [
                                            "Dont les articulations présentent des nodosités, en parlant d’une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca2e08a1-ae25-4ee5-86b1-98dc656929f2",
                                                "sense_id": "1fbf0e39-8a72-3b91-9025-38f53693cb32",
                                                "text": "Une énergie impitoyable reposait dans ses yeux glauques, plus froids que des yeux de verre. Il avait les pommettes saillantes, et des mains à articulations noueuses."
                                            },
                                            {
                                                "example_id": "9cda3f8d-2cb1-42fa-8584-6d33c4e79d2b",
                                                "sense_id": "1fbf0e39-8a72-3b91-9025-38f53693cb32",
                                                "text": "L’autre, sec, noueux, noiraud, correct à la façon d’un danseur salarié, répondait à l’appellation du « Mondain »."
                                            },
                                            {
                                                "example_id": "a8bcdf3b-ac11-4149-895b-8efebbc39432",
                                                "sense_id": "1fbf0e39-8a72-3b91-9025-38f53693cb32",
                                                "text": "Triggs perdit connaissance comme s'il avait été une petite femmelette de rien du tout et non un solide et noueux vieillard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "691c00a5-967d-39f7-b5d4-578740652333",
                                        "entry_id": "a9ed1d95-5eb6-3b3f-ab6f-fe7e8f51feca",
                                        "glosses": [
                                            "Qui produit des nodosités."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99996315-7be5-43ed-a819-4f23828575a4",
                                                "sense_id": "691c00a5-967d-39f7-b5d4-578740652333",
                                                "text": "Rhumatisme noueux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84da0b3a-1d51-3dbf-be9c-f15d6bb5cec4",
                                        "entry_id": "a9ed1d95-5eb6-3b3f-ab6f-fe7e8f51feca",
                                        "glosses": [
                                            "Se dit d’un meuble héraldique présentant à sa surface des nœuds de branches ou des écots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9173fde6-4196-4ef2-9732-590f40e0963f",
                                                "sense_id": "84da0b3a-1d51-3dbf-be9c-f15d6bb5cec4",
                                                "text": "Tiercé en pairle renversé au nᵒ 1 d'or au lion de gueules, armé, lampassé et couronné d'argent, la queue fourchue passée en sautoir ; au nᵒ 2 d'azur à la serre de griffon d'or tenant un bâton noueux d'argent ; au nᵒ 3 de gueules au fer à cheval d'or accosté de deux clochettes de muguet d'argent. ; au pairle renversé ondé d'argent brochant sur la partition, qui est de Nubecourt → voir illustration « bâton noueux »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
