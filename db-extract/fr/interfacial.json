                "senses": [
                    {
                        "sense_id": "7c4199cf-3716-3d70-a72a-ca5931f70649",
                        "entry_id": "58741423-8a84-3ae5-8067-0ef8c68cfc66",
                        "glosses": [
                            "Relatif à une interface."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "c14fcfff-4eb6-49ea-a0fa-824a464968ef",
                                "sense_id": "7c4199cf-3716-3d70-a72a-ca5931f70649",
                                "text": "Dans le cas de liquides immiscibles, l'énergie interfaciale est déterminée expérimentalement à partir de la forme d'une goutte de liquide 1 dans le liquide 2. Comme la plupart des polymères sont immiscibles entre eux, la méthode s'applique également à la mesure de l'énergie interfaciale de deux polymères [Hata 1980]."
                            },
                            {
                                "example_id": "4d30d0e7-4f98-4457-836c-ec9a6bd20ad2",
                                "sense_id": "7c4199cf-3716-3d70-a72a-ca5931f70649",
                                "text": "Il est possible de sentir des réactions instantanées, non seulement dans des simulations de RV, mais aussi avec de simples périphériques interfaciaux de poursuite visuelle ou par biorétroaction au moyen d’analyseurs."
                            }
                        ]
                    }
