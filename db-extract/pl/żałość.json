                    },
                    {
                        "translation_id": "77744832-4c2f-42fe-bf55-fc21ac9a8b17",
                        "source_entry_id": "f7263ed5-74dd-3d12-a256-303cdfacf191",
                        "source_sense_id": "0f63332d-567f-3310-8ac5-9fa4b93bc55d",
                        "target_lang_word": "woe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "woe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                                        "entry_id": "1867e0fe-64d1-39ba-8eeb-517820510b59",
                                        "glosses": [
                                            "Great sadness or distress; a misfortune causing such sadness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad466666-b52b-4f20-aa61-78bb5ba97aaf",
                                                "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                                                "text": "Thus saying, from her side the fatal key, / Sad instrument of all our woe, she took."
                                            },
                                            {
                                                "example_id": "0ba296cc-ae21-48aa-9241-7376737f5336",
                                                "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                                                "text": "Soon as thy letters trembling I unclose / That well-known name awakens all my woes."
                                            },
                                            {
                                                "example_id": "2fdd2ae1-f11a-421c-94fb-de13ba36b3f5",
                                                "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                                                "text": "But if there was a competition between a ſick family and a new broach, the broach was ſure to carry the day. This would not have been the caſe, had they been habituated to viſit themſelves the abodes of penury and woe."
                                            },
                                            {
                                                "example_id": "7eabced8-64ab-4492-b1ad-0704f0c5df20",
                                                "sense_id": "5d25df93-14e0-3931-a4ab-3774bc8a10e0",
                                                "text": "The Friday night rains which wrecked families in Kurabarahalli saw all the three major political parties making a beeline to express their condolences, listen to their woes and provide compensation in the hope of garnering their goodwill ahead of the 2018 assembly elections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "437c20c4-9bbe-3dc2-ae87-fa316bc20368",
                                        "entry_id": "1867e0fe-64d1-39ba-8eeb-517820510b59",
                                        "glosses": [
                                            "Calamity, trouble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "876311ab-a967-4546-8a22-b54f21c9a0e7",
                                                "sense_id": "437c20c4-9bbe-3dc2-ae87-fa316bc20368",
                                                "text": "And I beheld, and heard an angel flying through the midst of heaven, saying with a loud voice, Woe, woe, woe, to the inhabiters of the earth by reason of the other voices of the trumpet of the three angels, which are yet to sound!"
                                            },
                                            {
                                                "example_id": "f0c69cb6-96d1-469c-8edd-49a398466a29",
                                                "sense_id": "437c20c4-9bbe-3dc2-ae87-fa316bc20368",
                                                "text": "Don't let the little woes of life harm you / Let the joy in the life you lead / Let it charm you / Let it charm you now"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17da25aa-a88d-34fc-816b-1c103f26fd66",
                                        "entry_id": "1867e0fe-64d1-39ba-8eeb-517820510b59",
                                        "glosses": [
                                            "A curse; a malediction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401979d2-8f26-4f9e-ae21-0456c8f0a7cf",
                                                "sense_id": "17da25aa-a88d-34fc-816b-1c103f26fd66",
                                                "text": "Can there be a woe or curse in all the stores of vengeance equal to the malignity of such a practice?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                                        "entry_id": "cdda4973-306b-3bff-a308-4b99d0912be9",
                                        "glosses": [
                                            "Woeful; sorrowful"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2b79f2d-48a1-4443-8ed9-9d4fdadccace",
                                                "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                                                "text": "hys clerk was wo to do þat dede"
                                            },
                                            {
                                                "example_id": "841b2bed-2cf3-4b78-878c-e22afc084717",
                                                "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                                                "text": "And looking vp, when as his shield he lakt, / And sword saw not, he wexed wondrous woe"
                                            },
                                            {
                                                "example_id": "2edbb1ac-450c-44a0-a448-e731be523cdc",
                                                "sense_id": "fa371850-e0a4-3df9-ba3a-04e5b03d85d5",
                                                "text": "Prospero: I am woe for't, Sir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "woe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5fbc55b-0c54-3e4d-a6f7-731496b62cdf",
                                        "entry_id": "817008dc-d268-3b7e-8cba-46dfa74d54d2",
                                        "glosses": [
                                            "An exclamation of grief."
                                        ],
