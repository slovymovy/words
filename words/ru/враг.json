{
    "word_family": [
        "вражда",
        "вражеский",
        "враждебный",
        "враждовать",
        "враждебно"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09025c0b-39c3-3546-bc85-80b062ed4d9f",
                    "sense_definition": "Человек, который находится в состоянии вражды с кем-либо, желает зла.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_hostile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого доброго человека совсем нет <w>врагов</w>.",
                            "target_lang_translations": {
                                "en": "This kind man has no <w>enemies</w> at all.",
                                "es": "Este buen hombre no tiene ningún <w>enemigo</w>.",
                                "fr": "Cet homme bon n'a aucun <w>ennemi</w>."
                            }
                        },
                        {
                            "text": "Он мой старый друг, а не <w>враг</w>.",
                            "target_lang_translations": {
                                "en": "He is my old friend, not an <w>enemy</w>.",
                                "es": "Él es mi viejo amigo, no mi <w>enemigo</w>.",
                                "fr": "C'est mon vieil ami, pas un <w>ennemi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "недруг",
                        "противник",
                        "неприятель"
                    ],
                    "antonyms": [
                        "друг"
                    ],
                    "common_phrases": [
                        "заклятый враг",
                        "личный враг",
                        "нажить врагов",
                        "смертельный враг"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who is hostile towards someone and wishes them harm.",
                        "es": "Persona que siente hostilidad hacia alguien y le desea el mal.",
                        "fr": "Une personne qui est hostile envers quelqu'un et lui souhaite du mal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enemy",
                                "target_lang_sense_clarification": "personal opponent"
                            },
                            {
                                "target_lang_word": "foe",
                                "target_lang_sense_clarification": "literary or formal"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enemigo",
                                "target_lang_sense_clarification": "persona que siente hostilidad o antipatía hacia otra"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ennemi",
                                "target_lang_sense_clarification": "personne qui veut du mal à quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1969b74b-3154-38eb-b0e3-cc80c8312770",
                    "sense_definition": "Военный противник; армия или страна, с которой ведётся война.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "military_hostile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наши солдаты смело пошли в атаку на <w>врага</w>.",
                            "target_lang_translations": {
                                "en": "Our soldiers bravely went on the attack against the <w>enemy</w>.",
                                "es": "Nuestros soldados atacaron valientemente al <w>enemigo</w>.",
                                "fr": "Nos soldats ont courageusement attaqué l'<w>ennemi</w>."
                            }
                        },
                        {
                            "text": "Армия <w>врага</w> отступила далеко от границы.",
                            "target_lang_translations": {
                                "en": "The <w>enemy</w> army retreated far from the border.",
                                "es": "El ejército <w>enemigo</w> se retiró lejos de la frontera.",
                                "fr": "L'armée <w>ennemie</w> s'est retirée loin de la frontière."
                            }
                        }
                    ],
                    "synonyms": [
                        "противник",
                        "неприятель"
                    ],
                    "antonyms": [
                        "союзник"
                    ],
                    "common_phrases": [
                        "тыл врага",
                        "разбить врага",
                        "окружить врага",
                        "наступление врага"
                    ],
                    "target_lang_definitions": {
                        "en": "A military opponent; an army or country with which a war is being waged.",
                        "es": "Oponente militar; ejército o país con el que se está en guerra.",
                        "fr": "Un adversaire militaire ; une armée ou un pays avec lequel une guerre est menée."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enemy",
                                "target_lang_sense_clarification": "military force"
                            },
                            {
                                "target_lang_word": "foe",
                                "target_lang_sense_clarification": "adversary"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enemigo",
                                "target_lang_sense_clarification": "fuerza militar o país rival en un conflicto"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ennemi",
                                "target_lang_sense_clarification": "nation ou armée en guerre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77b184be-e591-373b-843c-5b82a16cf729",
                    "sense_definition": "То, что приносит вред, зло или является помехой (в переносном смысле).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Курение — это опасный <w>враг</w> твоего здоровья.",
                            "target_lang_translations": {
                                "en": "Smoking is a dangerous <w>enemy</w> of your health.",
                                "es": "Fumar es un <w>enemigo</w> peligroso para tu salud.",
                                "fr": "Le tabagisme est un <w>ennemi</w> dangereux pour ta santé."
                            }
                        },
                        {
                            "text": "Лень часто становится главным <w>врагом</w> успеха.",
                            "target_lang_translations": {
                                "en": "Laziness often becomes the main <w>enemy</w> of success.",
                                "es": "La pereza a menudo se convierte en el principal <w>enemigo</w> del éxito.",
                                "fr": "La paresse devient souvent le principal <w>ennemi</w> de la réussite."
                            }
                        }
                    ],
                    "common_phrases": [
                        "враг народа",
                        "лучшее — враг хорошего",
                        "враг здоровья"
                    ],
                    "target_lang_definitions": {
                        "en": "Something that causes harm, evil, or acts as a hindrance (figuratively).",
                        "es": "Algo que causa daño, mal o actúa como un obstáculo (en sentido figurado).",
                        "fr": "Quelque chose qui cause du tort, du mal ou qui agit comme un obstacle (au sens figuré)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "enemy",
                                "target_lang_sense_clarification": "harmful influence"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "enemigo",
                                "target_lang_sense_clarification": "factor o influencia perjudicial"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "ennemi",
                                "target_lang_sense_clarification": "concept ou chose nuisible"
                            }
                        ]
                    }
                }
            ]
        }
    ]
