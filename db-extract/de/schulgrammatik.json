                ],
                "senses": [
                    {
                        "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                        "entry_id": "d0465a44-44cb-36ce-852b-7e01c5781108",
                        "glosses": [
                            "Grammatik, die für Zwecke des Unterrichts in der Muttersprache oder einer Fremdsprache entwickelt wurde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c438c2d-03ce-4ec8-b859-5265006e6d21",
                                "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                                "text": "Schulgrammatiken beruhen auf den Erkenntnissen der wissenschaftlichen Grammatik, sind aber anders als diese nicht auf Vollständigkeit angelegt und stärker normativ (präskriptiv) angelegt."
                            },
                            {
                                "example_id": "d809b26f-559f-423c-a5b4-0dc63982b5de",
                                "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                                "text": "Schulgrammatiken werden für bestimmte Leistungsniveaus entwickelt."
                            },
                            {
                                "example_id": "59aefec4-3124-4a2a-94cc-5c57348a4ef5",
                                "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                                "text": "„Semantik, das heißt der Zeichencharakter sprachlicher Elemente stand sowohl bei der historisch-vergleichenden Sprachwissenschaft wie auch bei der vom aufgeklärten Rationalismus geprägten Schulgrammatik des 19. Jahrhunderts nicht gerade im Mittelpunkt des Interesses.“"
                            },
                            {
                                "example_id": "adcb1fbb-f122-4e12-a085-a06e0e0486db",
                                "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                                "text": "„Die Formenlehre beschäftigt sich mit den uns aus der Schulgrammatik geläufigen Paradigmen der Deklination, Konjugation und Komparation.“"
                            },
                            {
                                "example_id": "f1fac2e7-9a38-44c0-b65f-9111bee40b47",
                                "sense_id": "1bcd1e81-b9a9-3b58-abfb-3ec7b1d2e4ad",
                                "text": "„Dort sind die grammatischen Begriffe der Schulgrammatik von A bis Z aufgeführt, wie sie die Kultusministerkonferenz für die Schulen zum Gebrauch vorschlägt, und zwar sowohl die lateinischen, wie zum Beispiel Subjekt und Prädikat, als auch die deutschen, wie Satzgegenstand und Satzaussage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
