                        "glosses": [
                            "то же, что Святой Грааль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "370c84ee-4e42-4682-9588-1c3f4ff0a440",
                                "sense_id": "180b039f-9d4f-3467-9dc7-f9d0b776f441",
                                "text": "Я не совсем понял, — проговорил Андрей. — А как эти люди овладели Граалем? Агапит принёс его лично им? — Нет. Агапит, как Бодхисатва, принёс Грааль в мир, но не лично этим людям."
                            }
                        ]
                    }
