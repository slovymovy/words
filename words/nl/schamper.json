    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2015f7de-1a10-39a9-8231-70de0e69315d",
                    "sense_definition": "getuigend van geringschatting en minachting; spottend en honend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schamper_spottend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij had genoeg van haar <w>schampere</w> opmerkingen over zijn nieuwe hobby.",
                            "target_lang_translations": {
                                "de": "Er hatte genug von ihren <w>höhnischen</w> Bemerkungen über sein neues Hobby."
                            }
                        },
                        {
                            "text": "De minister reageerde met een <w>schamper</w> lachje op de kritiek vanuit de oppositie.",
                            "target_lang_translations": {
                                "de": "Der Minister reagierte mit einem <w>spöttischen</w> Lächeln auf die Kritik der Opposition."
                            }
                        }
                    ],
                    "synonyms": [
                        "honend",
                        "smalend",
                        "spottend"
                    ],
                    "antonyms": [
                        "eerbiedig",
                        "respectvol"
                    ],
                    "common_phrases": [
                        "een schampere lach",
                        "schampere opmerkingen"
                    ],
                    "target_lang_definitions": {
                        "de": "von Geringschätzung und Verachtung zeugend; spöttisch, höhnisch"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "höhnisch",
                                "target_lang_sense_clarification": "voller Hohn und Spott"
                            },
                            {
                                "target_lang_word": "spöttisch",
                                "target_lang_sense_clarification": "sich lustig machend, herablassend"
                            },
                            {
                                "target_lang_word": "hämisch",
                                "target_lang_sense_clarification": "schadenfroh, bösartig spottend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "360c1761-2910-3b01-9c6a-33880e4356f2",
                    "sense_definition": "eerste persoon enkelvoud van de tegenwoordige tijd van <w>schamperen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "schamperen_verboeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schamper</w> over zijn dwaze plan, hoewel ik beter zou moeten weten.",
                            "target_lang_translations": {
                                "de": "Ich <w>spotte</w> über seinen närrischen Plan, obwohl ich es besser wissen sollte."
                            }
                        },
                        {
                            "text": "Soms <w>schamper</w> ik als reactie op zulke overdreven verhalen.",
                            "target_lang_translations": {
                                "de": "Manchmal <w>höhne</w> ich als Reaktion auf solche übertriebenen Geschichten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van schamperen"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "erste Person Singular Präsens von 'schamperen' (höhnen, spotten)"
                    },
                    "translations": {
