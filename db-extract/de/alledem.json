                "entry_id": "2c936252-c607-39a8-9103-761826ab803a",
                "word": "alledem",
                "pos": "pron",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "521ddc84-3955-3c05-b0a1-7a3f75626632",
                        "entry_id": "2c936252-c607-39a8-9103-761826ab803a",
                        "glosses": [
                            "all (of) this, any of this"
                        ],
                        "tags": [
                            "prepositional",
                            "with-dative"
                        ],
                        "examples": [
                            {
                                "example_id": "9a5e422f-b125-4135-9c6e-87e5eda111ad",
                                "sense_id": "521ddc84-3955-3c05-b0a1-7a3f75626632",
                                "text": "Trotz alledem blieben sie optimistisch.",
                                "translation": "Despite all this, they remained optimistic.",
                                "english": "Despite all this, they remained optimistic."
                            },
                            {
                                "example_id": "9bf08d11-0f3a-4e6c-a4e2-39713e57a5c9",
                                "sense_id": "521ddc84-3955-3c05-b0a1-7a3f75626632",
                                "text": "Sie wollen von alledem nichts gewusst haben.",
                                "translation": "They claim to have known nothing about any of this.",
                                "english": "They claim to have known nothing about any of this."
                            },
                            {
                                "example_id": "c5f5f3c0-2fd9-4a1b-800a-e43fc43e37fa",
                                "sense_id": "521ddc84-3955-3c05-b0a1-7a3f75626632",
                                "text": "Nach alledem glaubst du immer noch an das Glück?",
                                "translation": "After all of this you still believe in luck?",
                                "english": "After all of this you still believe in luck?"
                            },
                            {
                                "example_id": "bad305a6-adca-4037-92a7-44c9231a118a",
                                "sense_id": "521ddc84-3955-3c05-b0a1-7a3f75626632",
                                "text": "Nun aber, da es Blüten schneit / Nun ist es kalt, trotz alledem / Trotz alledem und alledem / Trotz Wien, Berlin und alledem"
                            }
                        ]
                    }
                ],
