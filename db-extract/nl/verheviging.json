                ],
                "senses": [
                    {
                        "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                        "entry_id": "541fb91e-2794-3a15-8689-64e9c6552691",
                        "glosses": [
                            "het erger worden van iets; het sterker worden van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56dc742f-a76e-4c4e-8180-060ca223690f",
                                "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                                "text": "Dit laatste scheen te worden bevestigd door haar hand die, gretig, steeds sneller ging, en door een versnelling en verheviging van haar adem, terwijl haar ogen, ofschoon niet meer dan half gesloten en wel degelijk op de man naast haar gericht, hem in hun glazigheid niet langer leken op te nemen."
                            },
                            {
                                "example_id": "a60f3271-fdc1-4759-b322-3801d7c11682",
                                "sense_id": "5a527da5-0c79-3a35-b68e-758f52f978fc",
                                "text": "Wie met de jongste beschietingen is begonnen, valt nauwelijks vast te stellen. De partijen beschuldigen elkaar over en weer. De waarnemers van de enige onafhankelijke organisatie in het gebied, de OVSE, geven ook geen uitsluitsel. Zij meldden gisteren wel een verheviging van de gevechten."
                            }
                        ]
                    }
                ],
