                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Tending to suggest or imply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0f6a0ba-254a-403b-b226-f9ef339bf065",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "The painting is abstract, but the colors are suggestive of fruit or the Mediterranean."
                                            },
                                            {
                                                "example_id": "5edcc428-b40e-4d73-adf7-8a726d17bf71",
                                                "sense_id": "ba266cb6-f03f-3e3e-a4b2-f1d4a6312271",
                                                "text": "But Sophia's mother was not the woman to brook defiance. After a few moments' vain remonstrance her husband complied. His manner and appearance were suggestive of a satiated sea-lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                        "entry_id": "f85350d3-bdab-3bc7-9e72-3522acf632ed",
                                        "glosses": [
                                            "Suggesting romance, sex, etc.; risqué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4025fe7d-3b79-4fa8-ad51-7541ac181f1f",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "She crossed her legs and shot him a suggestive smile."
                                            },
                                            {
                                                "example_id": "81b1b8f0-5715-4087-bd2e-aa26d0ff37c7",
                                                "sense_id": "c1a27af5-f776-36b4-9bd1-b75eda2392df",
                                                "text": "Girls read fashion and celebrity magazines at younger and younger ages and look for the same kinds of sexy, suggestive clothing worn by the models."
                                            }
                                        ]
                                    },
