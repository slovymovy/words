        "pl-extract.jsonl": [
            {
                "entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                "word": "wzmianka",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                        "entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                        "glosses": [
                            "krótka informacja o czymś, napomknięcie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7877a865-fcf7-4875-9f82-b10cb33edade",
                                "sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                                "text": "Pierwsze wzmianki o Singapurze znajdują się w chińskich kronikach z III wieku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f7c1f60-4106-4da1-92a9-9371999af9b1",
                        "source_entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                        "source_sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                        "target_lang_word": "mention",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6e33a43-a6d8-3676-a582-ebcc427d1f23",
                                        "entry_id": "cb40a5bc-9c29-3fd8-85ee-1f10b456a29c",
                                        "glosses": [
                                            "A speaking or noticing of anything, usually in a brief or cursory manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c582457-0471-42e8-9aa6-941132942a76",
                                                "sense_id": "d6e33a43-a6d8-3676-a582-ebcc427d1f23",
                                                "text": "I will make mention of thy righteousness."
                                            },
                                            {
                                                "example_id": "8e593320-49ac-482a-9108-436cdd65a9de",
                                                "sense_id": "d6e33a43-a6d8-3676-a582-ebcc427d1f23",
                                                "text": "And sleep in dull, cold marble, where no mention / Of me more must be heard of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75ff7cb6-4ff6-31cb-95ee-96cdc90c8d6c",
                                        "entry_id": "cb40a5bc-9c29-3fd8-85ee-1f10b456a29c",
                                        "glosses": [
                                            "A social media feed, a list of replies or posts mentioning a person."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "496b80f6-c4a7-44f4-bb65-72fabd875939",
                                                "sense_id": "75ff7cb6-4ff6-31cb-95ee-96cdc90c8d6c",
                                                "text": "\"I would like Twitter to put some kind of filters in place,\" suggests Prakash. \"At present I can't see troll tweets if I block the user, but others who go into my 'mentions' can do so, and read the graphic abuse, which is disturbing.\""
                                            },
                                            {
                                                "example_id": "72014d2b-c6da-4cd6-989b-ca017a4bc921",
                                                "sense_id": "75ff7cb6-4ff6-31cb-95ee-96cdc90c8d6c",
                                                "text": "In response to the flood of replies, Chance returned to Twitter several hours later — presumably, after his mentions calmed down — to request that users format their resumes as \"creative decks, pitches or proposals\" […]."
                                            },
                                            {
                                                "example_id": "16707210-f3fa-4c44-905e-aea9261fef68",
                                                "sense_id": "75ff7cb6-4ff6-31cb-95ee-96cdc90c8d6c",
                                                "text": "I didn’t delete my account — yet! I know! I am full of shame! — but I did change the way I use it (no looking at my mentions; far less tweeting; aiming to highlight the work of people I like rather than criticize the work of those I don’t)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mention",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c513711d-ed45-3a51-aaad-e49274c3b565",
                                        "entry_id": "17c11c7c-9e85-30ad-9aab-1a508d4cca61",
                                        "glosses": [
                                            "To make a short reference to something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2728dfd4-7cd7-4775-82a0-a901153600d9",
                                                "sense_id": "c513711d-ed45-3a51-aaad-e49274c3b565",
                                                "text": "Finance is seldom romantic. But the idea of peer-to-peer lending comes close. This is an industry that brings together individual savers and lenders on online platforms.[…]Banks and credit-card firms are kept out of the picture. Talk to enough people in the field and someone is bound to mention the “democratisation of finance”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e5866f-3238-3712-a294-0114eec3bc50",
                                        "entry_id": "17c11c7c-9e85-30ad-9aab-1a508d4cca61",
                                        "glosses": [
                                            "To utter a word or expression in order to refer to the expression itself, as opposed to its usual referent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a856c2d-ba82-4ec2-96c2-69481d92ba34",
                                                "sense_id": "89e5866f-3238-3712-a294-0114eec3bc50",
                                                "text": "I can illustrate this by mentioning the word lead. Now you have no way of knowing for sure which meaning I have in mind until I give it some context by using it in a sentence."
                                            },
                                            {
                                                "example_id": "c89287bc-14e8-44db-a032-481aab8d47fc",
                                                "sense_id": "89e5866f-3238-3712-a294-0114eec3bc50",
                                                "text": "If the verbatimness view derives from the popular notion that DST repeats 'the actual words spoken', a second line of thought takes its cue from Quine's (1940: 23–26, 1960: 146–156) philosophical distinction between words which are “used” vs. words which are merely “mentioned”."
                                            },
                                            {
                                                "example_id": "5f3fa8ce-8893-4592-8d1a-476ec28c91be",
                                                "sense_id": "89e5866f-3238-3712-a294-0114eec3bc50",
                                                "text": "If I said rightly, “'Niggers' is a seven letter word,” I would be mentioning the word, and when we write it, we use mention-quotes for this purpose (speech typically lacks quotes, except for the occasional air-quotes). If I said, rightly or wrongly, “Niggers are good athletes,” then I would be using “niggers,” not merely mentioning it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fb70e53-27fa-4a99-9c9f-f150f01b3738",
                        "source_entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                        "source_sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                        "target_lang_word": "zmínka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7751e0dc-290b-403a-b74b-5d034819c7f6",
                        "source_entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                        "source_sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                        "target_lang_word": "Notiz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Notiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze schriftliche Aufzeichnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f35ddfd-a578-43f9-88ba-2a6d1fcc8943",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Protokollführer machte sich auf einem Notizblock seine Notizen, um sie später in Reinschrift zu übertragen."
                                            },
                                            {
                                                "example_id": "1b2be198-1b8b-4940-aac4-720611d48524",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "Der Schreibtisch war übersät mit Zettelchen, Zeitungsausschnitten, Notizen und Skizzen."
                                            },
                                            {
                                                "example_id": "ab63cb3d-5454-425d-86b4-b0454cf98f73",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Jürgen Loose sieht von seinen Notizen auf.“"
                                            },
                                            {
                                                "example_id": "c964fbc2-dfcb-4f7f-beb2-0ba004c94f20",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Doch »Paris, die Hauptstadt des 19. Jahrhunderts« blieb unvollendet, obwohl in seinem Nachlass nach dem Kriege ein großes Konvolut aus Manuskripten, Zetteln, Notizen gefunden wurde.“"
                                            },
                                            {
                                                "example_id": "f0c85930-ed58-4910-9be0-714f046b6df4",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Ich glaubte, alles von und über Kant zu kennen, in diesem Text aber stieß ich auf eine scheinbar unbedeutende Notiz, die meine Dissertation zur Makulatur werden ließ.“"
                                            },
                                            {
                                                "example_id": "2335a12f-3790-4f1a-91e4-8149c0bfd060",
                                                "sense_id": "0d1230a2-97f2-33a4-a64e-84758debba2a",
                                                "text": "„Am Ausgang des Friedhofs standen die Presseleute mit Kameras und Notizblöcken, machten sich ab und zu kurze Notizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "kurze Zeitungsmeldung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517e23d9-b244-49a4-9d62-fbc2d23ed9c5",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Im Abendblatt fand sich am nächsten Tag nur eine kleine Notiz."
                                            },
                                            {
                                                "example_id": "5c2f8ed9-5c01-449e-a1d7-afe19608b55c",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "Ich finde, sie hätten wenigstens eine Notiz über seinen Tod bringen können."
                                            },
                                            {
                                                "example_id": "e1e6b367-fb96-4f04-b839-e02123819bc6",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich las die Notiz durch.“"
                                            },
                                            {
                                                "example_id": "7a050dc1-813a-449a-91b3-7998776ac276",
                                                "sense_id": "c9955dbd-dd58-3577-88d7-187e284ecf35",
                                                "text": "„Ich blätterte sie durch, überflog die Schlagzeilen, bis ich eine Notiz entdeckte, über die ich lachen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                        "entry_id": "25da09ff-2428-31ea-96af-77f6db55b9f1",
                                        "glosses": [
                                            "Börsennotierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee11bc4-459e-4ebb-a0e6-3a297172dda2",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die amtliche Notiz ist die Festsetzung eines amtlichen Börsenkurses durch den Börsenvorstand, der diese Aufgabe aber auch auf einen Kursmakler übertragen kann."
                                            },
                                            {
                                                "example_id": "0199a5e5-4e16-4531-9bdb-c33004be0472",
                                                "sense_id": "ec3cacfd-679a-3636-86ce-a259c0f7858b",
                                                "text": "Die Voraussetzungen für eine Notiz im Prime Market der Wiener Börse sind nicht mehr gegeben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2315d0f-956f-46a8-8253-c2fe8a33836a",
                        "source_entry_id": "2ca21599-f93a-3ca3-87fb-7c6b9a9ff496",
                        "source_sense_id": "eaabcad9-d355-3a05-aad0-2f666ffd6c4b",
                        "target_lang_word": "Andeutung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Andeutung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                        "entry_id": "a3595aff-cd54-3ad0-bb48-686cc36bc7c0",
                                        "glosses": [
                                            "ein indirekter, undeutlicher, relativ vager Hinweis auf etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8edc9727-6e9c-4480-b38d-c1369f924148",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "Ich komme durch schlimmen Weg und Wetter übel zugerichtet im Kloster an, ich lasse sie in Eurem Namen vor mich fordern, sie erscheint, und ich reiche ihr statt des Grußes den Stiefel hin, mit der Andeutung, sie solle mir ihn ausziehen. (Johann Wolfgang Goethe, Italienische Reise, Philipp Neri, der humoristische Heilige, zitiert nach Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "287124b2-d9ed-4eb4-b8d3-3b96e788c9b0",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Die Gräfin war durch die Andeutungen Anna Michailownas bereits vorbereitet.“"
                                            },
                                            {
                                                "example_id": "d51f7296-9b9b-40a2-82cb-53566440cb41",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Ich konnte weder an der Verschwiegenheit C. C.s zweifeln noch an der Aufrichtigkeit, mit der sie mir davon erzählt hätte, wenn sie ihrer Nonne auch nur die geringste Andeutung gemacht hätte.“"
                                            },
                                            {
                                                "example_id": "58b50150-cb06-46ec-87f7-56aba0161726",
                                                "sense_id": "acb9f1df-f1be-397b-a7dc-9eb5d9a10eef",
                                                "text": "„Die Dame des Hauses macht in großer Gesellschaft Andeutungen über ihr Alter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e9f7f866-d43b-34ff-8778-598217581137",
                                        "entry_id": "a3595aff-cd54-3ad0-bb48-686cc36bc7c0",
                                        "glosses": [
                                            "nicht ausgeprägte Darstellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa711f41-a8c7-429f-b480-48813a19f3f0",
                                                "sense_id": "e9f7f866-d43b-34ff-8778-598217581137",
                                                "text": "Die Körperlichkeit Christi und der Heiligen ist zur bloßen Andeutung eingeschrumpft, aber diese Andeutung wird mit dem größten Aufwand des Stoffes und mit der emsigsten Sauberkeit zur Darstellung gebracht. (Jacob Burckhardt, Der Cicerone, Dritter Teil Malerei, zitiert nach Projekt Gutenberg)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
