                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f4a54d0-ac96-4838-816f-bc5e81eb378c",
                        "source_entry_id": "ec282ba0-d1ce-3d0d-901d-ea10cdf8cc9b",
                        "source_sense_id": "1aadac5f-66a1-3a0a-9786-47d8658843e1",
                        "target_lang_word": "xanthine",
