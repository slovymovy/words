                    {
                        "sense_id": "faa2a86f-0d26-3fe2-949e-5abda44bc40d",
                        "entry_id": "726cd823-81a4-317e-b190-0f903ff68f3d",
                        "glosses": [
                            "einseitig geprägte kleine Goldscheibe"
