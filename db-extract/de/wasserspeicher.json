                "senses": [
                    {
                        "sense_id": "4a535642-a7f9-3b33-abf7-d5a13dd63a47",
                        "entry_id": "e171378a-c251-357a-abe7-21a4fd28865d",
                        "glosses": [
                            "natürlicher oder künstlich angelegter Speicher, der einen Wasservorrat enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f576227-d0cd-4651-87c3-1c4cfb7397ad",
                                "sense_id": "4a535642-a7f9-3b33-abf7-d5a13dd63a47",
                                "text": "„Künftig könnten leer stehende Bergwerksstollen als Wasserspeicher genutzt werden und damit helfen, die Energiewende zu schaffen.“"
                            },
                            {
                                "example_id": "2eb4064c-d241-4bc6-91b0-aa48611826dc",
                                "sense_id": "4a535642-a7f9-3b33-abf7-d5a13dd63a47",
                                "text": "„Die Talsperre staut ein natürliches Fließgewässer auf und erzeugt den notwendigen Wasserspeicher für das Speicherkraftwerk.“"
                            },
                            {
                                "example_id": "f0af1048-c1cf-4443-81a2-c8ddb8562d46",
                                "sense_id": "4a535642-a7f9-3b33-abf7-d5a13dd63a47",
                                "text": "„Durch den Klimawandel schrumpfen die natürlichen Wasserspeicher in der Tiefe.“"
                            },
                            {
                                "example_id": "7bff014c-283e-40a1-acd6-3cbe8d1761cb",
                                "sense_id": "4a535642-a7f9-3b33-abf7-d5a13dd63a47",
                                "text": "„Die Hochgebirgsregion war einst stark vergletschert, womit sie einen wichtigen Wasserspeicher für die pakistanische Wasserversorgung bildete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
