                                        "sense_id": "74663894-ad6a-3f60-a5f4-0c3f495ef846",
                                        "entry_id": "3d380994-5370-3264-a00f-1620376edad4",
                                        "glosses": [
                                            "Roche métamorphique à amphiboles et feldspath plagioclases, de texture assez massive, vert sombre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd1c18c0-062b-4443-ac6a-1bd24ff2fb00",
                                                "sense_id": "74663894-ad6a-3f60-a5f4-0c3f495ef846",
                                                "text": "Ici, les mots fracture, amphibolite, affleurement, astéries, cénozoïque, entroques, colluvions, faille, poudingue, montille et autres schistes ardoisiers sont autant de réalités minérales et telluriques qui renvoient justement à ce caractère « minéral » dont on parle tant dans les vins, mais qui, avouons-le, demeure encore et toujours aussi insaisissable qu’un boson de Higgs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d8e9168-3c53-463b-85d9-79e8e05d5c20",
                        "source_entry_id": "db3b0654-5c87-31a3-8cad-cf112d0616d5",
                        "source_sense_id": "6510f311-df3e-387d-b737-4115272ed159",
                        "target_lang_word": "anfibolita",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
