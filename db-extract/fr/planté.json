                    },
                    {
                        "form_id": "3b6380a6-c930-4d13-9253-673328b09649",
                        "entry_id": "dfeb53e5-8f7b-3280-aeea-1c71798c768b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "plantées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                        "entry_id": "dfeb53e5-8f7b-3280-aeea-1c71798c768b",
                        "glosses": [
                            "S’emploie dans diverses expressions et locutions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c93a2d0-0e40-4614-b1b2-3e78b850a8a3",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "C’est la terre du monde la mieux plantée."
                            },
                            {
                                "example_id": "96025f30-14e6-4c62-a866-c9173673e5fc",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "Une maison bien plantée — Une maison bâtie dans une situation agréable."
                            },
                            {
                                "example_id": "163e65b6-3e39-4626-9fdb-75f0a216736d",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "Des cheveux bien plantés — Des cheveux bien placés sur le front."
                            },
                            {
                                "example_id": "fa97fa68-f629-4117-8bfc-c1ee56063d66",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "Un garçon bien planté, une fille bien plantée — Un garçon, une fille de belle santé et d’aspect solide."
                            },
                            {
                                "example_id": "1e54d2a3-0a6d-480e-853d-6b3837967232",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "Ses cheveux crépus et bas plantés, qui lui donnaient l’air mutin et courageux, obéissaient mal à la coiffure lisse et moelleuse que les dames de cette époque avaient empruntée aux belles Anglaises."
                            },
                            {
                                "example_id": "798de2df-3282-403e-ba59-e03ef1e14099",
                                "sense_id": "17c9efe0-6458-3830-9cd1-1d62c02d7366",
                                "text": "Une terre bien plantée — Une terre où il y a beaucoup de belles avenues d’arbres."
                            }
                        ]
                    },
                    {
                        "sense_id": "2afe08fc-691c-3e60-97f2-f15dbfb22572",
                        "entry_id": "dfeb53e5-8f7b-3280-aeea-1c71798c768b",
                        "glosses": [
                            "Se dit d'un ou plusieurs arbres qui sont posés sur une pièce ou un meuble. Peut également se dire d’une pièce ou meuble sur lequel est posé un ou plusieurs arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "affc5626-ae8f-46ac-8f55-951d190d7d34",
                                "sense_id": "2afe08fc-691c-3e60-97f2-f15dbfb22572",
                                "text": "D'or à un houx au naturel planté sur une terrasse de sable, qui est de Plan-d’Aups-Sainte-Baume → voir illustration « houx planté »"
                            },
                            {
                                "example_id": "9fa51255-8021-4df5-b620-98db96cfb46e",
                                "sense_id": "2afe08fc-691c-3e60-97f2-f15dbfb22572",
                                "text": "D’azur aux deux montagnes cousues de sable mouvant des flancs, formant un val planté d’un cep du même feuillé et fruité d’or accolé à un échalas d’argent surmonté d’un croissant aussi d’argent, qui est de Le Val → voir illustration « val planté d’un arbre »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a1bdbd15-074e-3ddd-a707-9da1402f4959",
                        "entry_id": "dfeb53e5-8f7b-3280-aeea-1c71798c768b",
                        "glosses": [
                            "Se dit d’un meuble composé présentant des arbres d'un émail différent de celui du meuble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad8ded9b-e51f-419f-ba45-c9e1b6a73d22",
                                "sense_id": "a1bdbd15-074e-3ddd-a707-9da1402f4959",
                                "text": "D’azur à la silhouette de village d’argent planté d’arbres de sinople, l’église au centre avec un long clocher, accosté à dextre d’une tête de cerf contournée et à senestre d’un casque à nasal, taré de profil, soutenu d’une épée basse, le tout d’argent au chef aussi de sinople soutenu d’un filet d’or, qui est de Feuillie’' → voir illustration « village planté de sinople »"
                            }
                        ]
                    }
                ],
