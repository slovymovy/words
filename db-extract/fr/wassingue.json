        "fr-extract.jsonl": [
            {
                "entry_id": "6198efc9-be83-3a92-8005-df2ebb650387",
                "word": "wassingue",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "252cc3b2-528b-412c-945d-5307d31ded22",
                        "entry_id": "6198efc9-be83-3a92-8005-df2ebb650387",
                        "tags": [
                            "plural"
                        ],
                        "form": "wassingues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                        "entry_id": "6198efc9-be83-3a92-8005-df2ebb650387",
                        "glosses": [
                            "Serpillière."
                        ],
                        "tags": [
                            "Nord-Pas-de-Calais",
                            "Picardie"
                        ],
                        "examples": [
                            {
                                "example_id": "5796f65c-b6cb-41bd-851f-eb51c0270df4",
                                "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                                "text": "N’est-ce point aujourd’hui samedi ? Ma femme lave la maison, et, comme j'ai horreur des wassingues…"
                            },
                            {
                                "example_id": "49ea042f-48a0-4e51-84ba-b6e341376538",
                                "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                                "text": "Une bouffée de mauvais temps pesa rageusement sur la verrière. Un petit reptile noir, qui partait du bas de la fenêtre, se mit à ramper lentement… À quoi je connus que la fenêtre fermait mal et que l’eau commençait à imbiber le tapis, j’allais chercher des « wassingues » et le secours de Maria, l’Aveyronnaise qui me servait à cette époque-là."
                            },
                            {
                                "example_id": "8b71dc1c-5ee9-406e-993a-d741545407a5",
                                "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                                "text": "La crainte du « noir », la fétidité, la peur des rats, les arrêtaient sur le seuil, et c’est avec répugnance, du bout des doigts, qu’ils tiraient à eux les wassingues et les balais de bouleau."
                            },
                            {
                                "example_id": "105b251d-8008-4850-87ef-6805f50fc825",
                                "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                                "text": "Il dit « Nom de Dieu de nom de Dieu ! », puis, dans un mouvement d’une extrême rapidité, enleva son pantalon et, à la façon d’une wassingue, s’en servit pour éponger l’inondation."
                            },
                            {
                                "example_id": "dd601dc3-09ec-4ad2-878e-d3e730763c83",
                                "sense_id": "2a1b0bb0-d997-3e1e-9fd1-cc80eeaba834",
                                "text": "Un blanc sec sur le zinc\nVaut mille wassingues\nPour, toute peine bue,\nEn essuyer la crue…"
                            }
                        ]
                    }
                ],
