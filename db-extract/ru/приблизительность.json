                    },
                    {
                        "translation_id": "9e8db224-cd02-4ff9-9147-f5e26bde3af7",
                        "source_entry_id": "e5c37e5a-298a-3762-8d19-0df35e962cbd",
                        "source_sense_id": "0c724255-c9e0-34d7-872c-3e648bc7e962",
                        "target_lang_word": "Ungenauigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungenauigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                        "entry_id": "654235eb-8951-3ed2-a34c-d48ec526bd9c",
                                        "glosses": [
                                            "Eigenschaft, Zustand, nicht präzise, genau zu sein, also nur ungefähr zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3d7b09-992e-4ae5-80c5-393b77a56ac9",
                                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                                "text": "„Die in den Messungen steckende Ungenauigkeit beträgt etwa 90 Sekunden.“"
                                            },
                                            {
                                                "example_id": "febe5a29-22ed-4488-9e86-0e734a3a1e36",
                                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                                "text": "„Die Ungenauigkeit von 47 ppm (Teile pro Million), bislang ein großes Problem, konnte deutlich auf 12 ppm gesenkt werden.“"
                                            },
                                            {
                                                "example_id": "e286977a-fbb3-460b-9d11-b7dbff481b08",
                                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                                "text": "„Im Extremfall kann die Ungenauigkeit der Ortung in diesen Gebieten 38 Kilometer betragen.“"
                                            },
                                            {
                                                "example_id": "c336d12f-ada9-45d5-a44e-bd3a2b0473ce",
                                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                                "text": "„Und was die Ungenauigkeit der DNA-Schreibgeräte angeht, so wären die Algorithmen des DNA-Fountain-Verfahrens effektiv genug, um die fehlerhaften DANN-Informationsschnipsel zuverlässig im Herstellungsprozess auszusortieren.“"
                                            },
                                            {
                                                "example_id": "e00591fc-6a63-4132-8e85-5d277bdde158",
                                                "sense_id": "1aae72cb-aa8f-3e89-88b9-e30443204b47",
                                                "text": "„Um diese Ungenauigkeit zu vermeiden, legen einige Hersteller viel Wert auf ihre eigene Clock, die hinreichend exakt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                        "entry_id": "654235eb-8951-3ed2-a34c-d48ec526bd9c",
                                        "glosses": [
                                            "etwas, das [1] hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3321635a-8fb4-4a04-bd04-60b36c7ac612",
                                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                                "text": "„Um diese Ungenauigkeit zu vermeiden, legen einige Hersteller viel Wert auf ihre eigene Clock, die hinreichend exakt ist.“"
                                            },
                                            {
                                                "example_id": "5d2071b1-bbbd-4c9a-bf33-d2183aa1a42b",
                                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                                "text": "„Es seien einige sachliche Fehler und ‚Ungenauigkeiten der Schilderung‘ aufgefallen.“"
                                            },
                                            {
                                                "example_id": "030f38c7-e58a-4998-8274-a49bc80b4834",
                                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                                "text": "„Es hatte sich herausgestellt, dass sachliche Fehler, Ungenauigkeiten und Flüchtigkeiten bei der Zuordnung des Materials unterlaufen waren und durch die Art der Präsentation ‚pauschale und suggestive Aussagen‘ getroffen wurden.“"
                                            },
                                            {
                                                "example_id": "f1402bc0-f418-427d-aa1c-3705cfadd44f",
                                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                                "text": "„Schnell führen sprachliche Ungenauigkeiten zum Pranger und zum Abkanzeln, zumal die Erregungsschleifen in den sozialen Medien eine aufklärerische und differenzierte Diskussion erschweren.“"
                                            },
                                            {
                                                "example_id": "a17b8e99-64cd-49ec-8ec8-74e896f38328",
                                                "sense_id": "964cbe75-dfc5-34c1-9aca-c2df02d5c219",
                                                "text": "„Trotz verstärkter Briefwahl und dadurch bedingter Ungenauigkeiten in der Prognose gab es keine Überraschungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c1aa26c-e136-42f0-bd03-1b92740ea8c9",
                        "source_entry_id": "e5c37e5a-298a-3762-8d19-0df35e962cbd",
                        "source_sense_id": "0c724255-c9e0-34d7-872c-3e648bc7e962",
                        "target_lang_word": "yaklaşıklık",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1089cc4a-271a-4d32-aba2-24e6cb77f4e5",
                        "source_entry_id": "e5c37e5a-298a-3762-8d19-0df35e962cbd",
                        "source_sense_id": "0c724255-c9e0-34d7-872c-3e648bc7e962",
                        "target_lang_word": "approximation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approximation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65272309-c80a-332e-9502-fe2d5b4fb33b",
                                        "entry_id": "66b24894-e44d-3e1c-b673-761c3ba96e3d",
                                        "glosses": [
                                            "Estimation par à peu près, où l’on se contente d’approcher de la vérité sans s’attacher à une exactitude rigoureuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d8d4faa-1594-49fe-a070-b6edbf97543e",
                                                "sense_id": "65272309-c80a-332e-9502-fe2d5b4fb33b",
                                                "text": "Je ne vous demande qu’une approximation, une simple approximation."
                                            },
                                            {
                                                "example_id": "d50f1f02-9fb1-4505-93f3-2f57e57a3a19",
                                                "sense_id": "65272309-c80a-332e-9502-fe2d5b4fb33b",
                                                "text": "Ce plan de la gare n’est pas tout à fait exact parce que j’avais peur, alors je ne faisais pas très attention aux choses, c’est seulement ce dont je me souviens, donc c’est une approximation."
                                            },
                                            {
                                                "example_id": "18b9fd4a-4839-48bf-80b9-e8f3e9994537",
                                                "sense_id": "65272309-c80a-332e-9502-fe2d5b4fb33b",
                                                "text": "Au milieu de la catastrophe, Trump pérore tous les jours à la télévision, enfilant mensonges, approximations et bravades autosatisfaites, l’œil rivé sur son propre audimat et sur l’audience qu’il recueille sur les réseaux sociaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd6502c-3654-3e64-b993-f8084ed56814",
                                        "entry_id": "66b24894-e44d-3e1c-b673-761c3ba96e3d",
                                        "glosses": [
                                            "Mode d’articulation consonantique caractérisé par un resserrement du canal vocal sans compression de l’air, de manière à ne produire aucune impression auditive de friction."
                                        ],
                                        "tags": [
                                            "Phonétique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30b0061-83d7-45b5-a82e-a98921f81107",
                                                "sense_id": "1fd6502c-3654-3e64-b993-f8084ed56814",
                                                "text": "L’approximation labiale est un resserrement de la gorge qui s’accompagne d’une fermeture des lèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f16a89-414f-3946-a471-a030db06f662",
                                        "entry_id": "66b24894-e44d-3e1c-b673-761c3ba96e3d",
                                        "glosses": [
                                            "Procédure permettant de calculer une valeur approchée d’un nombre, par exemple en arrondissant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63ecc8d-3594-4f1f-8be9-d1abdbd632c5",
                                                "sense_id": "66f16a89-414f-3946-a471-a030db06f662",
                                                "text": "Si le nombre choisi pour approximer la racine carrée du nombre donné est trop grand, on aura une sous-estimation, si le nombre choisi pour approximer la racine carrée du nombre donné est trop petit, on aura une sur-estimation. Dans les deux cas, on peut dire que l’on se trompe sur l’approximation de la racine carrée du nombre donné."
                                            },
                                            {
                                                "example_id": "24e071dc-4eac-4bff-9312-f9df8322d7ce",
                                                "sense_id": "66f16a89-414f-3946-a471-a030db06f662",
                                                "text": "Résoudre une équation consiste à trouver le ou les nombres qui font que cette équation est vraie. On peut souvent résoudre des problèmes en utilisant l’algèbre. Cela permet d’obtenir des approximations, mais pas toujours une réponse exacte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
