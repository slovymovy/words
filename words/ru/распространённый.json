                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "common",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>распространённый</w> журнал был доступен в каждом киоске города.",
