                    {
                        "translation_id": "95e09f74-df21-4e50-8b10-bdaeddd1d1f5",
                        "source_entry_id": "cd97db2e-106a-3301-b901-493414228550",
                        "source_sense_id": "8322d487-8231-3136-a0ee-87bfdc9e9bee",
