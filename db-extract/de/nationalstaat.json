                        ],
                        "form": "den Nationalstaat"
                    },
                    {
                        "form_id": "280ba505-5ac5-4b1a-877c-f27efae6e379",
                        "entry_id": "9fdcca6c-0539-3b86-aef5-6c481cabb3f6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nationalstaaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                        "entry_id": "9fdcca6c-0539-3b86-aef5-6c481cabb3f6",
                        "glosses": [
                            "Staat, dessen Einwohner einer Nation angehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9a05328-5c45-4cae-bce3-f1c9dd695d5d",
                                "sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                                "text": "„Mit ihrem Appell an die nationalen Interessen stilisiert sich die Polizei einmal mehr als Erbin jener Helden, denen der griechische Nationalstaat einst seine Freiheit verdankte: den Kriegern der Revolution gegen die Türken, den Kleften.“"
                            },
                            {
                                "example_id": "5262e4be-8bdc-4fee-83aa-a72d8575bd1e",
                                "sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                                "text": "„Das Konzept des Nationalstaates entwickelte sich erst im 17. Jahrhundert, nach dem Dreißigjährigen Krieg.“"
                            },
                            {
                                "example_id": "2919effd-561b-4404-acc1-5367a4501b35",
                                "sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                                "text": "„Es ist klar, dass diejenigen, die einen tschechischen Nationalstaat haben wollten, mit dieser Idee halbsouveräner nationaler Gesellschaften nichts anfangen wollten.“"
                            },
                            {
                                "example_id": "505658dc-ddfa-41a1-81fa-ae501c61b4da",
                                "sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                                "text": "„Die Nationalstaaten des 19. Jahrhunderts übernahmen viele Vorstellungen aus jener Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fe5bf40-4d96-4a86-b5ba-f77111edddeb",
                        "source_entry_id": "9fdcca6c-0539-3b86-aef5-6c481cabb3f6",
                        "source_sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                        "source_sense_description": "Politik: Staat, dessen Einwohner einer Nation angehören",
                        "target_lang_word": "nation state",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nation state",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b0b6468-6ca6-3d3c-8f51-2640a795af3e",
                                        "entry_id": "9019d50d-d171-3ae3-a807-4207463c3243",
                                        "glosses": [
                                            "Alternative spelling of nation-state."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74120a8c-23b2-4c68-b932-9456b7be6ad1",
                                                "sense_id": "7b0b6468-6ca6-3d3c-8f51-2640a795af3e",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]:[…]; […] or perhaps to muse on the irrelevance of the borders that separate nation states and keep people from understanding their shared environment."
                                            },
                                            {
                                                "example_id": "ad057b8f-5b9b-4db9-bb7c-cada792512ee",
                                                "sense_id": "7b0b6468-6ca6-3d3c-8f51-2640a795af3e",
                                                "text": "But times have changed, and mother / Standing at the garden gate / Calls us home for dinner / With the nation state"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fcda784-ca67-4852-8143-d82ef2ee9840",
                        "source_entry_id": "9fdcca6c-0539-3b86-aef5-6c481cabb3f6",
                        "source_sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                        "source_sense_description": "Politik: Staat, dessen Einwohner einer Nation angehören",
                        "target_lang_word": "nation-state",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nation-state",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96e3bd57-d520-3339-b68c-ca4e536c0b7c",
                                        "entry_id": "1f3583c2-794d-3a11-a002-d7d449d79eb8",
                                        "glosses": [
                                            "A political entity (a state) associated with a common national identity (historically, culturally, or ethnically; as with a nation) and a sovereign territorial unit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f238ff-2ce1-4067-a5a3-2933323ae5ef",
                                                "sense_id": "96e3bd57-d520-3339-b68c-ca4e536c0b7c",
                                                "text": "Two years on, and while the Sultan of Slowjamastan has instigated more than a few bizarre laws (he’s outlawed the wearing of Crocs, for example), the Republic also has all the trappings of a fledgling nation-state. It issues its own passports, flies its own flag, prints its own currency (“the duble”), and has a national anthem that’s played on state occasions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3914e98c-742f-3cf9-a997-0470b75a9aae",
                                        "entry_id": "1f3583c2-794d-3a11-a002-d7d449d79eb8",
                                        "glosses": [
                                            "Any independent political state; a country."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "proscribed"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b454df5f-ee2c-4995-ae27-ffee68e4d74c",
                        "source_entry_id": "9fdcca6c-0539-3b86-aef5-6c481cabb3f6",
                        "source_sense_id": "7bdb9863-15b6-3147-821f-33039f999447",
                        "source_sense_description": "Politik: Staat, dessen Einwohner einer Nation angehören",
                        "target_lang_word": "État-nation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "État-nation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c525cd86-02da-3a38-96f9-f14018a8aec6",
                                        "entry_id": "c263e4b3-0443-3b10-a59c-2af69da4b6d9",
                                        "glosses": [
                                            "État en coïncidence exacte avec une nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "211b20ea-f576-4e45-b96e-982f8be8cfb7",
                                                "sense_id": "c525cd86-02da-3a38-96f9-f14018a8aec6",
                                                "text": "À dire vrai, l’idéal de l’État-nation a fait faillite. L’État-nation est incapable de prévenir une agression étrangère, il ne constitue plus l’institution suprême capable de protéger son peuple contre la guerre et toutes les infortunes que la guerre apporte."
                                            },
                                            {
                                                "example_id": "2e4f1ce8-bb05-4ec9-80e7-7fd0dae94a6d",
                                                "sense_id": "c525cd86-02da-3a38-96f9-f14018a8aec6",
                                                "text": "En tant que concept politique, l’État-nation se caractérise par une autorité à base territoriale, et non par des conceptions universalistes, extra-territoriales.\nL'expression État-nation est donc trompeuse quand on l'applique aux divers pays du Proche-Orient, car, dans la plupart d'entre eux, la nation est perçue en termes religieux afin d'englober ceux que n'enserrent pas les frontières des États particuliers."
                                            },
                                            {
                                                "example_id": "8ea8e923-fa8d-47bf-9f6b-0f8a81d5de13",
                                                "sense_id": "c525cd86-02da-3a38-96f9-f14018a8aec6",
                                                "text": "Pour certains même, l'idée de l'État-nation serait dépassée, comme l'avait écrit il y a longtemps P.E. Trudeau (1962)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
