                                "target_senses": [
                                    {
                                        "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                                        "entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                                        "glosses": [
                                            "A decorative technique in which veneers of wood, ivory, metal etc. are inlaid into a wooden surface to form intricate designs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "433cb284-7e97-4d47-8467-81f3ec52ca1c",
                                                "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                                                "text": "strawen marquetry"
                                            },
                                            {
                                                "example_id": "15b921e6-cfe9-45f5-b4d2-07a1f9ab982d",
                                                "sense_id": "04c02fba-d24e-3572-a36c-50a1f57ba900",
                                                "text": "Wearing a dress in Labour's ruby red, the shadow chancellor joins me at a circular table amid the art deco glamour of Bettys' subterranean Spindler room, which is adorned with numerous stained-wood “marquetry pictures”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "421b9811-63e3-3de1-b57d-178c9019f3f7",
                                        "entry_id": "7ba12788-d83c-3043-aafa-4253fb4199e5",
                                        "glosses": [
                                            "An example of this work."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2ad8f82-97d7-4cf7-9fed-645a90208360",
                                                "sense_id": "421b9811-63e3-3de1-b57d-178c9019f3f7",
                                                "text": "Unkind people asserted that everything in his apartment was for sale and that after he had invited wealthy Americans for an excellent lunch, with vintage wines, one or two of his valuable drawings would disappear, or a marquetry commode would be replaced by one in lacquer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86b75060-8a11-46dd-86e9-6e2f97cfe8e7",
                        "source_entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                        "target_lang_word": "marquetería",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e432057f-9055-4fb2-91b8-9d00a78a1152",
                        "source_entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                        "target_lang_word": "marqueterie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marqueterie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7b5f46ee-01ce-35c2-a660-62e68742bacc",
                                        "entry_id": "ab17f3a9-43af-3871-b4fe-2bac03ee2ec2",
                                        "glosses": [
                                            "een vorm van inlegwerk waarbij verschillende delen als een legpuzzel op elkaar aansluiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "388db73a-a024-42d5-b3bf-c5f14ccf1ce7",
                                                "sense_id": "7b5f46ee-01ce-35c2-a660-62e68742bacc",
                                                "text": "Er was trouwens in dat aardige bergdorp, bekend vacantie-oord voor de Europeanen van Tokio en Yokohama gedurende de zomermaanden, nog wel iets anders te zien Winkeltjes vol met het kunstig ingelegde houtwerk, dat aan de ‘marqueterie’ van de Riviera herinnert, schietbanen voor de aloude nationale boogschutterskunst, uitstallingen van gelooide en opgemaakte dierenhuiden uit het gebergte, depots van curiositeiten, schilderachtige theehuizen, kleine Buddha- en Shinto-tempels, ateliers van inlandsche fotografen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44727d32-4d6e-4855-95c8-5f16c6484d4e",
                        "source_entry_id": "22ed1680-9dd5-3476-868a-cc8340593127",
                        "target_lang_word": "lappendeken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lappendeken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d5ac70-4394-31cd-a5d6-7fed21aa637b",
                                        "entry_id": "5ae59a07-8c7b-33b3-8270-9df01ee4db97",
                                        "glosses": [
                                            "een deken gemaakt uit verschillende losse delen die aan elkaar gestikt zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d622cb3-c586-45ff-8d9c-e775a3d1edb2",
                                                "sense_id": "e3d5ac70-4394-31cd-a5d6-7fed21aa637b",
                                                "text": "Mitjenka's vrouw en haar zusters staken in het voorhuis hun verschrikte gezichten om de deur van hun kamer, waar een glanzende samowar stoomde en het hoge met een lappendeken bedekte bed van de rentmeester stond"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7b7dee0-17e6-369a-a827-9b746a8fed2b",
                                        "entry_id": "5ae59a07-8c7b-33b3-8270-9df01ee4db97",
                                        "glosses": [
                                            "een bont onsamenhangend geheel"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52f19288-f556-42c9-9913-8e770deeb60e",
                                                "sense_id": "a7b7dee0-17e6-369a-a827-9b746a8fed2b",
                                                "text": "Het gevolg daarvan is dat de komende acht weken 30.000 Syriërs vanuit belegerde dorpen en steden naar elders moeten worden gebracht. Vanwege de lappendeken aan strijdende partijen gaat de reis vaak dwars door vijandelijk gebied."
                                            },
                                            {
                                                "example_id": "894a637d-c151-4658-80f5-e0ee1943025e",
                                                "sense_id": "a7b7dee0-17e6-369a-a827-9b746a8fed2b",
                                                "text": "De Koerdische oud-minister neemt Bagdad een manifest gebrek aan wil om de vernielde stad op te bouwen kwalijk. Hij twijfelt er ook aan of Mosul, een (gewezen) lappendeken van etnieën en religieuze gezindheden, nog tot zoiets als verzoening kan komen. De woede van Christenen, Jezidi’s, Koerden en anderen is gericht op de soennitische meerderheid: IS is een salafistische, fundamentalistisch soennitische, beweging."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
