                            {
                                "example_id": "c9a17638-a97f-4cc4-b079-8c35403f1875",
                                "sense_id": "f8d0973f-e6a3-35d8-8189-6dafcb8d90ba",
                                "text": "Herr Krätzel ist als Kaninchenzüchter erfolgreich."
                            },
                            {
                                "example_id": "de44260a-3fc6-4e40-a047-948fffe8b4aa",
                                "sense_id": "f8d0973f-e6a3-35d8-8189-6dafcb8d90ba",
                                "text": "Herr Krätzel heiratet im September auf Hawaii."
                            },
                            {
                                "example_id": "503903ec-fb13-45fb-8159-c1c7054a5872",
                                "sense_id": "f8d0973f-e6a3-35d8-8189-6dafcb8d90ba",
                                "text": "Frau Krätzel liebt es, an Weihnachten Plätzchen zu backen."
                            },
                            {
                                "example_id": "870eddd8-3b38-476b-bf73-22509d532b1e",
                                "sense_id": "f8d0973f-e6a3-35d8-8189-6dafcb8d90ba",
                                "text": "Die Krätzels lieben die Natur und die Tiere."
                            }
