                ],
                "senses": [
                    {
                        "sense_id": "43e6ee4f-49a1-32fb-aef8-ed9dce7cd53c",
                        "entry_id": "9b401e25-9fe9-3019-9651-4b584e30df8a",
                        "glosses": [
                            "женское имя; гипокор. к Людмила"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a882d51e-070e-43d2-b7bd-2e4cb34c9d41",
                                "sense_id": "43e6ee4f-49a1-32fb-aef8-ed9dce7cd53c",
                                "text": "Пододвигая жене тарелку, он спросил: — Люда, ты помнишь, конечно, гипотезу Проута? Людмила Николаевна, недоумевая, подняла ложку."
                            },
                            {
                                "example_id": "b6e8a195-9d09-4a83-bf12-db0bee850f8e",
                                "sense_id": "43e6ee4f-49a1-32fb-aef8-ed9dce7cd53c",
                                "text": "Оленька слушала Люду, посмеиваясь, но зорко занята была своей глажкой."
                            },
                            {
                                "example_id": "d2a2bf2c-b649-46c7-b2ea-bea1f847afeb",
                                "sense_id": "43e6ee4f-49a1-32fb-aef8-ed9dce7cd53c",
                                "text": "К вечеру гости расходятся, но эта женщина, родственница тёти Люды, остаётся ночевать."
                            }
                        ]
                    }
                ],
