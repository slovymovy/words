                        "examples": [
                            {
                                "example_id": "c7e64a0a-f1cb-4a24-a342-beb9aea76192",
                                "sense_id": "ce9ee198-086e-3246-81af-7693548263d8",
                                "text": "He has titles enough to greatness, without borrowing plumes from the gratuitous bedeckings of prurient writers."
