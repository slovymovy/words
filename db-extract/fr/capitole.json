                                        "glosses": [
                                            "Any particular capitol",
                                            "The building in Washington, D.C., in which both houses of the Congress of the United States meet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17c8ebf1-2157-44b4-b41f-866b4d6433bb",
                                                "sense_id": "628bc33e-a360-329c-bde3-ad00745d82af",
                                                "text": "ON January 20, 1953, I stood on a platform at the East Front of the Capitol in Washington to take the oath, administered by Chief Justice Fred M. Vinson, as the thirty-fourth President of the United States — an office I was to hold for eight years."
                                            }
                                        ]
                                    },
