                "senses": [
                    {
                        "sense_id": "2cbf33d9-aec7-3f9c-aefa-78f38714257b",
                        "entry_id": "2db98f63-2df0-3c81-aaf4-72354109a50e",
                        "glosses": [
                            "tragbare Feuerwaffe, die mit der Hand betätigt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf3d0da-814b-40ad-b57e-83092f5b9f41",
                                "sense_id": "2cbf33d9-aec7-3f9c-aefa-78f38714257b",
                                "text": "Er betätigte die Handfeuerwaffe."
                            },
                            {
                                "example_id": "77eedc68-efe5-427a-b949-29039e5a061b",
                                "sense_id": "2cbf33d9-aec7-3f9c-aefa-78f38714257b",
                                "text": "„Die Konsequenz war 1997 ein neues Gesetz für ganz Großbritannien (eingeschränkt in Nordirland), welches das Halten von Handfeuerwaffen, egal ob groß- oder kleinkalibrig, im eigenen Haushalt verbietet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4541e2d-cce7-481b-86d2-2d7cc7e10465",
                        "source_entry_id": "2db98f63-2df0-3c81-aaf4-72354109a50e",
                        "source_sense_id": "2cbf33d9-aec7-3f9c-aefa-78f38714257b",
                        "source_sense_description": "tragbare Feuerwaffe, die mit der Hand betätigt werden kann",
                        "target_lang_word": "handgun",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handgun",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                                        "entry_id": "28a977e6-b878-337d-886d-9f85f7516751",
                                        "glosses": [
                                            "A small gun with a relatively short barrel, designed to be held and operated with a single hand."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be5cbc27-3465-4817-a181-039e57f0b8df",
                                                "sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                                                "text": "Petric used his father's key to open a lockbox and remove a 9mm handgun and the game."
                                            },
                                            {
                                                "example_id": "fbeb4fd6-41a5-4821-b43e-baeb1bcc7835",
                                                "sense_id": "6a459cef-5a95-3c70-9dd6-fdbe953be5f7",
                                                "text": "A related design and marketing innovation has been the sale to civilians of “vest busters,” handguns specifically designed to penetrate body armor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "219fdb61-a5f9-4fed-89b7-745720e1b8ba",
                        "source_entry_id": "2db98f63-2df0-3c81-aaf4-72354109a50e",
                        "source_sense_id": "2cbf33d9-aec7-3f9c-aefa-78f38714257b",
                        "source_sense_description": "tragbare Feuerwaffe, die mit der Hand betätigt werden kann",
                        "target_lang_word": "arme de poing",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arme de poing",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f80fad4-7ac7-3cbb-8b57-f6b4403b0b44",
                                        "entry_id": "fc6249b8-706c-31b8-85cc-eac515bf1f04",
                                        "glosses": [
                                            "Arme à feu que l'on peut tenir avec une seule main."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b2301f3-85fc-45dc-9f86-979d95e88548",
                                                "sense_id": "5f80fad4-7ac7-3cbb-8b57-f6b4403b0b44",
                                                "text": "Les faits se sont produits vendredi soir près de Naples (sud), lorsque deux hommes à bord dʼun puissant scooter ont menacé un automobiliste avec une arme de poing pour lui subtiliser sa montre de marque Rolex."
                                            },
                                            {
                                                "example_id": "a9fb28f5-0572-4e00-a858-6e8c7885c7bb",
                                                "sense_id": "5f80fad4-7ac7-3cbb-8b57-f6b4403b0b44",
                                                "text": "Un mouvement de protestation ébranla les rangs des officiers. L’un d’eux sortit son arme de poing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
