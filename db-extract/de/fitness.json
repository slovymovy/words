                                    {
                                        "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "The condition of being fit, suitable or appropriate."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441da393-b449-4519-bb0b-c1f87574160e",
                                                "sense_id": "19935bc1-6976-3091-9fcc-f8c573874ddb",
                                                "text": "Having introduced my two characters separately, let me present them together. Why not? He, young, wealthy, honorable; she also young, also intelligent — why not bring them together? There is an eternal fitness in all things, and nothing more so than in the case of man and woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7576c05f-c697-3b82-a5f0-603ebccbb5ee",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "The cultivation of an attractive and/or healthy physique."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9f71e3-6fd5-4ab0-b576-99fc8595b80e",
                                                "sense_id": "7576c05f-c697-3b82-a5f0-603ebccbb5ee",
                                                "text": "Carroll has been edging slowly towards full fitness after his expensive arrival from Newcastle United and his partnership with £23m Luis Suarez showed rich promise as Liverpool controlled affairs from start to finish."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "266a5e2b-5061-3365-a217-980ed92d0224",
                                        "entry_id": "6836f50b-bfc4-32c5-af29-ccb6db02e497",
                                        "glosses": [
                                            "An organism's or species' degree of success in finding a mate and producing offspring."
                                        ],
