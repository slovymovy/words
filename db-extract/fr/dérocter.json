                "senses": [
                    {
                        "sense_id": "60cf2d4f-69ee-3826-bed0-e193f1b0208b",
                        "entry_id": "c0daa1ca-4fb1-32a8-b27d-6d0aad96aa48",
                        "glosses": [
                            "Faire exploser des roches gênantes en fond de mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01781499-6745-461e-970d-5fa0346d8c2b",
                                "sense_id": "60cf2d4f-69ee-3826-bed0-e193f1b0208b",
                                "text": "Les roches de type stratifiées (calcaires, grès…) ou litées (schistes, gneiss) seront beaucoup plus faciles à dérocter que les roches massives (calcaires récifaux, granites, masses basaltiques…), les plans ou joints de stratification donnant presque toujours lieu à certaines hétérogénéités mécaniques."
                            },
                            {
                                "example_id": "b71ea857-4ce7-4de9-9c91-0d42cdd5f745",
                                "sense_id": "60cf2d4f-69ee-3826-bed0-e193f1b0208b",
                                "text": "Au total, les parties à dérocter s’étendent sur 416 m, les zones à démonter sur 4 900 m et à repiquer sur 6 695 m."
                            },
                            {
                                "example_id": "9c74a2e7-69ea-45dc-8dc3-44a81b9a49a1",
                                "sense_id": "60cf2d4f-69ee-3826-bed0-e193f1b0208b",
                                "text": "Cependant, des critères comme le tirant d’eau des navires, les travaux de dragage à effectuer, les seuils à dérocter, ont amené à choisir celui de Fray Bentos."
                            }
                        ]
                    }
                ],
