                                "target_senses": [
                                    {
                                        "sense_id": "c0c31179-2722-38dc-b90a-0314352b0055",
                                        "entry_id": "16b87bd6-a89f-3e3b-9cc3-b10b244d9842",
                                        "glosses": [
                                            "Affluent du fleuve Mississippi, s’écoulant entièrement dans l’État du Wisconsin, auquel il a donné son nom."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6a364f0-df8b-3199-8ef7-c57962ec8ae9",
                                        "entry_id": "16b87bd6-a89f-3e3b-9cc3-b10b244d9842",
                                        "glosses": [
                                            "Un des cinquante États des États-Unis d’Amérique, (code postal WI)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab49047c-5519-4cef-9a0b-6d991c91d67d",
                                                "sense_id": "b6a364f0-df8b-3199-8ef7-c57962ec8ae9",
                                                "text": "L’émigration islandaise a commencé en 1870 […] On a cherché à concentrer le mouvement, mais la difficulté était de trouver une contrée convenable ; on a proposé la Nouvelle-Écosse, l’Ontario, le Wisconsin, le Nebraska, le Manitoba."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95aa4e0e-f58c-4bda-9f4b-d4b4563bf16d",
                        "source_entry_id": "d6feb300-eb15-3dea-8f33-3ebd6eac5a15",
                        "source_sense_description": "state of the United States of America",
                        "target_lang_word": "Wisconsin",
