                "senses": [
                    {
                        "sense_id": "22bc102f-05bc-3905-853f-2cefc37fc885",
                        "entry_id": "a5891db3-a5d7-3460-81bf-3bb3b43816e6",
                        "glosses": [
                            "Schlagsahne"
