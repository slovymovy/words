{
    "word_family": [
        "benauwen",
        "benauwdheid",
        "benauwenis"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "995daee5-e1b4-3bab-bd3c-535b71f0c3d5",
                    "sense_definition": "gebrek aan frisse lucht hebbend; muf of slecht geventileerd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "luchtkwaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is erg <w>benauwd</w> in deze kleine kamer omdat het raam al uren dicht zit.",
                            "target_lang_translations": {
                                "en": "It is very <w>stuffy</w> in this small room because the window has been closed for hours.",
                                "ru": "В этой маленькой комнате очень <w>душно</w>, потому что окно закрыто уже несколько часов."
                            }
                        },
                        {
                            "text": "In de volle trein hing een <w>benauwde</w> lucht door het gebrek aan ventilatie.",
                            "target_lang_translations": {
                                "en": "There was a <w>stuffy</w> atmosphere in the crowded train due to the lack of ventilation.",
                                "ru": "В переполненном поезде стоял <w>спертый</w> воздух из-за отсутствия вентиляции."
                            }
                        }
                    ],
                    "synonyms": [
                        "muf",
                        "bedompt"
                    ],
                    "antonyms": [
                        "fris",
                        "luchtig"
                    ],
                    "common_phrases": [
                        "benauwde lucht",
                        "benauwd kamertje"
                    ],
                    "target_lang_definitions": {
                        "en": "lacking fresh air; musty or poorly ventilated",
                        "ru": "характеризующийся недостатком свежего воздуха; душный или затхлый"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuffy",
                                "target_lang_sense_clarification": "of a room or air"
                            },
                            {
                                "target_lang_word": "close",
                                "target_lang_sense_clarification": "uncomfortably warm and airless"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "душный",
                                "target_lang_sense_clarification": "о воздухе или помещении"
                            },
                            {
                                "target_lang_word": "спертый",
                                "target_lang_sense_clarification": "о воздухе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a737c93d-02e8-357b-9b4c-875f78c684a1",
                    "sense_definition": "moeilijk kunnen ademhalen of een beklemmend gevoel op de borst hebben",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fysieke toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt kreeg het plotseling erg <w>benauwd</w> en had direct extra zuurstof nodig.",
                            "target_lang_translations": {
                                "en": "The patient suddenly became very <w>short of breath</w> and needed extra oxygen immediately.",
                                "ru": "Пациент внезапно начал сильно <w>задыхаться</w>, и ему срочно потребовался дополнительный кислород."
                            }
                        },
                        {
                            "text": "Iemand met astma heeft het vaak <w>benauwd</w> tijdens een aanval van kortademigheid.",
                            "target_lang_translations": {
                                "en": "Someone with asthma often feels <w>breathless</w> during an attack of shortness of breath.",
                                "ru": "Человеку с астмой часто <w>трудно дышать</w> во время приступа одышки."
                            }
                        }
                    ],
                    "synonyms": [
                        "kortademig"
                    ],
                    "common_phrases": [
                        "het benauwd krijgen",
                        "het benauwd hebben"
                    ],
                    "target_lang_definitions": {
                        "en": "having difficulty breathing or experiencing a tight feeling in the chest",
                        "ru": "испытывающий затруднения с дыханием или чувство сдавленности в груди"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "short of breath",
                                "target_lang_sense_clarification": "physical sensation"
                            },
                            {
                                "target_lang_word": "breathless",
                                "target_lang_sense_clarification": "unable to breathe easily"
                            },
                            {
                                "target_lang_word": "oppressed",
                                "target_lang_sense_clarification": "feeling a weight on the chest"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "задыхающийся",
                                "target_lang_sense_clarification": "испытывающий нехватку воздуха"
                            },
                            {
                                "target_lang_word": "трудно дышать",
                                "target_lang_sense_clarification": "в безличных конструкциях (het benauwd hebben)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcdf463d-7af3-3f85-ba1f-3851708b212a",
                    "sense_definition": "met zeer weinig bewegingsruimte; eng of beklemmend klein",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruimte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige mensen worden erg angstig wanneer ze zich in een <w>benauwde</w> ruimte bevinden.",
                            "target_lang_translations": {
                                "en": "Some people become very anxious when they are in a <w>cramped</w> space.",
                                "ru": "Некоторые люди начинают сильно паниковать, когда оказываются в <w>тесном</w> помещении."
                            }
                        },
                        {
                            "text": "De lift was zo klein en <w>benauwd</w> dat er nauwelijks drie mensen in pasten.",
                            "target_lang_translations": {
                                "en": "The elevator was so small and <w>confined</w> that barely three people could fit in it.",
                                "ru": "Лифт был настолько маленьким и <w>тесным</w>, что в него едва помещались три человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "nauw",
                        "eng",
                        "klein",
                        "krap"
                    ],
                    "antonyms": [
                        "ruim",
                        "weids"
                    ],
                    "common_phrases": [
                        "benauwde ruimte"
                    ],
                    "target_lang_definitions": {
                        "en": "having very little room to move; uncomfortably small or cramped",
                        "ru": "имеющий очень мало пространства; тесный или вызывающий чувство стесненности"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cramped",
                                "target_lang_sense_clarification": "lacking space"
                            },
                            {
                                "target_lang_word": "confined",
                                "target_lang_sense_clarification": "restricted in space"
                            },
                            {
                                "target_lang_word": "claustrophobic",
                                "target_lang_sense_clarification": "inducing a feeling of being trapped"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тесный",
                                "target_lang_sense_clarification": "о пространстве"
                            },
                            {
                                "target_lang_word": "стесненный",
                                "target_lang_sense_clarification": "ограниченный в пространстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb9cfb8c-f629-30ce-b8af-5e847f850bb1",
                    "sense_definition": "een gevoel van angst of onrust ervarend door een dreigende situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik kreeg het er <w>benauwd</w> van doordat ik vreesde dat de verbinding elk moment kon verbreken.",
                            "target_lang_translations": {
                                "en": "It made me feel <w>anxious</w> because I feared the connection could drop at any moment.",
                                "ru": "Мне стало <w>не по себе</w> от страха, что связь может прерваться в любой момент."
                            }
                        },
                        {
                            "text": "Zijn lijfspreuk bleef door de jaren heen altijd: niet van dat <w>benauwde</w>.",
                            "target_lang_translations": {
                                "en": "His motto over the years always remained: don't be so <w>timid</w>.",
                                "ru": "Его девизом на протяжении многих лет всегда оставалось: «никаких <w>страхов</w>»."
                            }
                        }
                    ],
                    "synonyms": [
                        "angstig",
                        "bang",
                        "beklemd"
                    ],
                    "antonyms": [
                        "gerust",
                        "kalm"
                    ],
                    "common_phrases": [
                        "niet van dat benauwde"
                    ],
                    "target_lang_definitions": {
                        "en": "experiencing a feeling of fear or anxiety due to a threatening situation",
                        "ru": "испытывающий тревогу, беспокойство или страх из-за угрожающей ситуации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "feeling uneasy or worried"
                            },
                            {
                                "target_lang_word": "fearful",
                                "target_lang_sense_clarification": "feeling afraid"
                            },
                            {
                                "target_lang_word": "uneasy",
                                "target_lang_sense_clarification": "vague feeling of dread"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тревожный",
                                "target_lang_sense_clarification": "испытывающий беспокойство"
                            },
                            {
                                "target_lang_word": "не по себе",
                                "target_lang_sense_clarification": "об ощущении страха или тревоги (het benauwd krijgen)"
                            },
                            {
                                "target_lang_word": "боязливый",
                                "target_lang_sense_clarification": "робкий, пугливый"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b397cde-dbd9-3b18-b95f-6645a2fd3a56",
                    "sense_definition": "voltooid deelwoord van <w>benauwen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gedachte aan de naderende deadline heeft hem de hele week <w>benauwd</w>.",
                            "target_lang_translations": {
                                "en": "The thought of the approaching deadline has <w>oppressed</w> him all week.",
                                "ru": "Мысль о приближающемся дедлайне <w>тяготила</w> его всю неделю."
                            }
                        },
                        {
                            "text": "Zij voelde zich door de vele vragen van de politie behoorlijk <w>benauwd</w>.",
                            "target_lang_translations": {
                                "en": "She felt quite <w>anxious</w> due to the many questions from the police.",
                                "ru": "Из-за многочисленных вопросов полиции она чувствовала себя совершенно <w>загнанной в угол</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'benauwen' (to oppress, to make anxious)",
                        "ru": "причастие прошедшего времени от глагола benauwen (тяготить, стеснять, пугать)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oppressed",
                                "target_lang_sense_clarification": "weighed down by thoughts or feelings"
                            },
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "made to feel worried"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "тяготил",
                                "target_lang_sense_clarification": "давил психологически"
                            },
                            {
                                "target_lang_word": "стесненный",
                                "target_lang_sense_clarification": "напуганный или сдавленный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}