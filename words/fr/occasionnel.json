                {
                    "sense_id": "9d6133ba-fbf0-308b-84c3-666f4fb84bb7",
                    "sense_definition": "En philosophie, qualifie une cause seconde qui n'engendre pas un effet par elle-même mais donne lieu à l'intervention d'une cause première.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon cette doctrine, la volonté humaine n'est qu'une cause <w>occasionnelle</w>, Dieu seul agissant réellement."
                        },
                        {
                            "text": "Pour Malebranche, toute action humaine est simplement une cause <w>occasionnelle</w> déterminée par une volonté supérieure."
                        }
                    ],
                    "common_phrases": [
                        "cause occasionnelle"
                    ]
                }
            ]
        }
