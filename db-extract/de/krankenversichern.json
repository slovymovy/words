                        "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                        "entry_id": "f574236a-8b22-301c-90da-ff974147ae33",
                        "glosses": [
                            "eine Krankenversicherung abschließen; mit einem Krankenversicherer einen Vertrag schließen"
                        ],
                        "tags": [
                            "sich",
                            "etwas",
                            "jemanden krankenversichern"
                        ],
                        "examples": [
                            {
                                "example_id": "b60c149a-258f-4c97-9f14-04942ec40e84",
                                "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                                "text": "„Der Unterhaltspflichtige darf auch selbst Altersvorsorge betreiben und sich privat krankenversichern.“"
                            },
                            {
                                "example_id": "67f946b9-ebfe-4b39-ae07-847ee806ab24",
                                "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                                "text": "„Für Menschen mit hohem Armutsrisiko besteht zudem die Gefahr, dass sie sich nicht mehr ausreichend krankenversichern können.“"
                            },
                            {
                                "example_id": "f4b1cea8-4bdb-4ada-8df3-8c9778e3bc58",
                                "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                                "text": "„Während der Vorlesungszeit dürfen Studierende nicht mehr als 20 Stunden pro Woche arbeiten und nicht mehr als 520 Euro verdienen, da sie sich ansonsten selbst krankenversichern sowie je nach Höhe des Verdienstes, Steuern zahlen müssen.“"
                            },
                            {
                                "example_id": "370a4d3e-fce6-45dc-9a71-6703f8375ee3",
                                "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                                "text": "„Sie müssen aber nachweisen, dass sie arbeiten oder über ausreichende finanzielle Mittel verfügen und krankenversichert sind.“"
                            },
                            {
                                "example_id": "ddc1bd28-9155-4328-965c-781dbdc20537",
                                "sense_id": "732f6def-1974-3e86-b54d-ebeebf8a7f51",
                                "text": "„Die exponentiell wachsende Zahl der Todesopfer der Pandemie hätten sowohl die fortgesetzte Realitätsverleugnung Trumps und seiner Anhänger als auch die eklatanten Schwächen des US-Gesundheitssystems aufgedeckt: 28 Millionen US-Bürger sind nicht krankenversichert, ebenso elf Millionen nicht eingebürgerte Einwanderer, eine unbekannte Zahl hat kein Anrecht auf Lohnfortzahlung im Krankheitsfall.“"
                            }
                        ],
