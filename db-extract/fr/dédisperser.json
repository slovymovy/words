                "senses": [
                    {
                        "sense_id": "d092a644-b5f4-305c-8c94-218529fd3bc3",
                        "entry_id": "62d9bc09-b9ca-3e7f-a122-d8b971a932c5",
                        "glosses": [
                            "Dans l’observation des pulsars, corriger le décalage des temps d’arrivée des signaux émis par ceux-ci en fonction de leur fréquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27548da0-e3f6-43ca-989b-646beab40f16",
                                "sense_id": "d092a644-b5f4-305c-8c94-218529fd3bc3",
                                "text": "Plusieurs façons de 'dédisperser' le signal radio ont été développées."
                            },
                            {
                                "example_id": "b97ad238-71fb-43b5-a1cd-15b15cb5fe42",
                                "sense_id": "d092a644-b5f4-305c-8c94-218529fd3bc3",
                                "text": "Après détection et numérisation, le signal large bande est découpé en canaux, dédispersé, puis intégré en fréquence et en temps."
                            },
                            {
                                "example_id": "48ad285b-a5c4-488f-b542-311bf1693d2f",
                                "sense_id": "d092a644-b5f4-305c-8c94-218529fd3bc3",
                                "text": "Le signal radio a été dédispersé (la dispersion interstellaire est enlevée dans le domaine fréquentiel grâce à une grosse puissance de calcul apportée par des GPUs -Graphics Processing Units- sur une bande totale de 512MHz et intégré sur 30 minutes."
                            }
                        ]
                    }
