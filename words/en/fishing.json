    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4cb3eca-7013-32be-8d18-990b5fc36d85",
                    "sense_definition": "The activity or sport of catching fish.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a good day's <w>fishing</w> at the weekend.",
                            "target_lang_translations": {
                                "ru": "Мы отлично провели день на <w>рыбалке</w> в выходные.",
                                "zh": "周末我们<w>钓鱼</w>玩得很开心。"
                            }
                        },
                        {
                            "text": "My father loves <w>fishing</w> in the quiet lake near our home.",
                            "target_lang_translations": {
                                "ru": "Мой отец любит <w>рыбалку</w> на тихом озере недалеко от нашего дома.",
                                "zh": "我父亲喜欢在我们家附近那片安静的湖里<w>钓鱼</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go fishing",
                        "fishing rod",
                        "fishing trip",
                        "fishing boat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или спорт, заключающиеся в ловле рыбы.",
                        "zh": "作为休闲活动或运动的捕鱼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рыбалка",
                                "target_lang_sense_clarification": "самый распространенный термин для любительской ловли"
                            },
                            {
                                "target_lang_word": "рыбная ловля",
                                "target_lang_sense_clarification": "более формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钓鱼",
                                "target_lang_sense_clarification": "最常用的休闲捕鱼术语"
                            },
                            {
                                "target_lang_word": "垂钓",
                                "target_lang_sense_clarification": "较正式的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b3f14c9-cb6d-3197-83a6-0fa1b22cfd75",
                    "sense_definition": "The business or industry of catching fish and other seafood for sale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is good news for the <w>fishing</w> industry.",
