                                    {
                                        "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                        "entry_id": "6ceb018f-5082-3ffe-b25a-b44ca6884793",
                                        "glosses": [
                                            "ohne klare Konturen; nicht klar und geordnet"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38aac668-ef62-42e8-a488-61c5a337554e",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Er war von einer diffusen Angst befallen."
                                            },
                                            {
                                                "example_id": "8f077a84-410e-4f8c-9dfe-b254003c7891",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Er hat nur eine diffuse Vorstellung davon, was ein Kunststudium mit sich bringt."
                                            },
                                            {
                                                "example_id": "803a7880-5463-4da1-ac5c-a651f1f19ad8",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Die Patientin klagte über diffuse Schmerzen im Oberbauch."
                                            },
                                            {
                                                "example_id": "2b958d55-68d9-473e-b973-9781b5456a2d",
                                                "sense_id": "255ad728-17a8-34b0-bf3a-28d65214907e",
                                                "text": "Die beiden wollen nach Afrika, haben aber zur Zeit erst recht diffuse Pläne, was sie da eigentlich genau sehen wollen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8310172d-9853-3291-880b-a4807fed1fd0",
                                        "entry_id": "6ceb018f-5082-3ffe-b25a-b44ca6884793",
                                        "glosses": [
                                            "zerstreut; unscharf, schwer abgrenzbar"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c4d735-5623-484f-a2e9-4e969bb161ae",
                                                "sense_id": "8310172d-9853-3291-880b-a4807fed1fd0",
                                                "text": "Der Raum war in diffuses Licht getaucht."
                                            },
                                            {
                                                "example_id": "0ce41dcb-fb07-462b-b1d9-78e1d822b8c1",
                                                "sense_id": "8310172d-9853-3291-880b-a4807fed1fd0",
                                                "text": "„Von der Decke, dort wo die Rundungen des Gewölbes an ihrem höchsten Punkt einander berührten und die Statik der Konstruktion vollendeten, hing ein schwerer, gußeiserner Leuchter, der ein diffuses, schummriges Licht verbreitete.“"
                                            },
                                            {
                                                "example_id": "cf74498b-49e0-4153-a855-8b95146cdb5a",
                                                "sense_id": "8310172d-9853-3291-880b-a4807fed1fd0",
                                                "text": "Während der Globalstrahlungssensor frei steht, wird der Sensor zur Messung der diffusen Strahlung montiert auf einem Suntracker von Schattenkeulen abgeschattet, um auch nur den diffusen Anteil der Solarstrahlung zu messen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
