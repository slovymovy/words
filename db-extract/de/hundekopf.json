                "senses": [
                    {
                        "sense_id": "f8947ccd-787f-3485-91cb-e3415878e1aa",
                        "entry_id": "bda8360f-3009-3640-8026-53bced4c0a79",
                        "glosses": [
                            "Kopf eines Hundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779c8762-bead-4186-becb-9b389554db42",
                                "sense_id": "f8947ccd-787f-3485-91cb-e3415878e1aa",
                                "text": "„Nur wenn Leerlauf im Hundekopf entsteht, lassen sie sich die Tiere ihre eigenen \"Spielchen\" einfallen oder reagieren phlegmatisch.“"
                            },
                            {
                                "example_id": "d8f616ea-3537-42e3-b5a9-ba79594d36fd",
                                "sense_id": "f8947ccd-787f-3485-91cb-e3415878e1aa",
                                "text": "„Der Hingucker ist dabei fraglos Wolfgang Raab an seinem bizarr aussehenden Dudelsack, dessen Ende ein geschnitzter Hundekopf ziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
