                                "target_senses": [
                                    {
                                        "sense_id": "6fa865df-4adf-30c9-b611-84a4f65a95bb",
                                        "entry_id": "a79ca51d-a9f6-3ff6-afeb-01842d462a43",
                                        "glosses": [
                                            "Fromage italien rentrant dans la composition des desserts et des recettes de cuisine. Il est notamment employé dans la composition du tiramisu."
                                        ],
                                        "tags": [
                                            "Fromage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5a81f74-6798-4154-8061-e5605e31c610",
                                                "sense_id": "6fa865df-4adf-30c9-b611-84a4f65a95bb",
                                                "text": "Pour 2 personnes\n10 cerises, dénoyautées et coupées en 2 – 10 cl de mascarpone –2 c. à s. de yaourt à la grecque – 3 c. à s. de cassonade."
                                            },
                                            {
                                                "example_id": "615ea5c3-e7b7-4bd9-b5c2-a6c943b4691c",
                                                "sense_id": "6fa865df-4adf-30c9-b611-84a4f65a95bb",
                                                "text": "Trévise, quant à elle, est formelle, c’est à la signora Alba, épouse du restaurateur Campeol, que revient la conception, dans les années 1960, de l’actuel tiramisu : la finaude sut transformer une erreur, du mascarpone versé par inadvertance dans un sabayon, en recette miraculeuse enrichie au cacao et au café."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e0c0c9f-2196-4a2a-9d96-d412c02e6e1b",
                        "source_entry_id": "d0f9ffd5-d747-3557-9ed9-50decd6256a0",
                        "source_sense_id": "b10f813d-65d9-3f0c-9b5c-9c4da6b6765b",
                        "source_sense_description": "cheese",
                        "target_lang_word": "Mascarpone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mascarpone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                        "entry_id": "25d0f234-2f24-38ab-a89e-4fee7f176f75",
                                        "glosses": [
                                            "ein aus Italien stammender Frischkäse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b02a96bf-4392-4e06-a36a-569d76b2ab2a",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone ist ein italienischer Frischkäse aus dem Gebiet um Lodi, der aus Sahne hergestellt wird.“"
                                            },
                                            {
                                                "example_id": "93556f1a-d336-4ec8-835b-e1eb451f15fa",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone ist cremig und leicht streichbar.“"
                                            },
                                            {
                                                "example_id": "c949124b-a267-46fe-948e-d8861f98615f",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone enthält ca. 80% Fett i.Tr.“"
                                            },
                                            {
                                                "example_id": "e28572b1-5c8e-4899-94fd-5b7150b0e1ff",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Da Mascarpone sehr schnell fremde Gerüche annimmt, sollte man sie immer gut verschlossen und gekühlt aufbewahren.“"
                                            },
                                            {
                                                "example_id": "b610a7b7-5680-44b5-9820-773533caf318",
                                                "sense_id": "ed0c1889-b2e9-36c4-98cb-9b7a753bbdc3",
                                                "text": "„Mascarpone kann man mit Gewürzen als herzhaften Brotaufstrich zubereiten, sie zum Überbacken von Aufläufen verwenden, in Suppen oder Saucen rühren, aber auch für Torten und Desserts wie das klassische Tiramisu verwenden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
