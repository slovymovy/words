                ],
                "senses": [
                    {
                        "sense_id": "1c554c9c-d65e-3208-a0b3-53b63134d30d",
                        "entry_id": "44d45396-4626-3144-904f-df5afad99688",
                        "glosses": [
                            "Celle qui dresse et gouverne les oiseaux de proie et qui les fait voler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e4fde0-fb39-4862-8d25-9f518f0df11a",
                                "sense_id": "1c554c9c-d65e-3208-a0b3-53b63134d30d",
                                "text": "Depuis sept ans, Nadya Potvin est fauconnière. Pour transmettre sa passion, elle a un petit compagnon de 3 ans qui pèse à peine un kilo, Spirit, son faucon gerfaut."
                            },
                            {
                                "example_id": "e413bcf5-6046-4cfa-b6d0-30d865dc38aa",
                                "sense_id": "1c554c9c-d65e-3208-a0b3-53b63134d30d",
                                "text": "La fauconnière, qui travaille avec les oiseaux depuis près de vingt ans, fabrique elle-même presque tout son équipement."
                            },
                            {
                                "example_id": "39b0619e-d206-405c-9a47-921b336c2059",
                                "sense_id": "1c554c9c-d65e-3208-a0b3-53b63134d30d",
                                "text": "Mais après avoir paré au plus urgent, Emmanuelle Dulain, fauconnière du mond’Emmane, a pour mission de faire fuir la trentaine de pigeons installés sur le toit de l’église."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb07d377-0004-3e1a-a463-66697ac0a72b",
                        "entry_id": "44d45396-4626-3144-904f-df5afad99688",
                        "glosses": [
                            "Espèce de sac ou de gibecière dont les fauconniers se servaient pour porter toutes les choses dont ils avaient besoin."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd77326c-9aaf-3761-bf3e-48fb224e91cf",
                        "entry_id": "44d45396-4626-3144-904f-df5afad99688",
                        "glosses": [
                            "Toute espèce de gibecière séparée en deux que l’on met à l’arçon de la selle pour porter de menus objets."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
