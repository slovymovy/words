                    {
                        "translation_id": "ca1d81fe-f276-48de-b7cc-6b727c61795f",
                        "source_entry_id": "a8d355b7-8741-38bf-a7f9-233de19fc743",
                        "source_sense_description": "a four-footed or four-legged animal",
                        "target_lang_word": "quadrupède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
