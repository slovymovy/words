                "senses": [
                    {
                        "sense_id": "ea7f73f5-f8d5-3731-9fcc-ed8266f13bab",
                        "entry_id": "1dba4537-fa42-38ec-9233-f06a38f5c843",
                        "glosses": [
                            "Pays d’Amérique latine, situé au nord du continent sud-américain, délimité au nord par la mer des Caraïbes et l'océan Atlantique, à l’ouest par la Colombie, au sud par le Brésil et à l’est par le Guyana."
                        ],
                        "tags": [
                            "Pays"
                        ],
                        "examples": [
                            {
                                "example_id": "d7b90438-89e2-4778-b8ba-ecb324967edd",
                                "sense_id": "ea7f73f5-f8d5-3731-9fcc-ed8266f13bab",
                                "text": "Le traité avait pour objectif de délimiter « les régions sous-marines » du golfe de Paria qui sépare Trinité-et-Tobago, alors colonie britannique, du Venezuela. L'accord fixait ainsi trois segments depuis les bouches du Dragon jusqu'aux bouches du Serpent. Les surfaces délimitées respectaient vaguement ce qu'aurait pu donner une ligne d’équidistance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ca50a7e-c949-4237-af79-693133275e6c",
                        "source_entry_id": "1dba4537-fa42-38ec-9233-f06a38f5c843",
                        "source_sense_id": "ea7f73f5-f8d5-3731-9fcc-ed8266f13bab",
                        "target_lang_word": "Venezuela",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venezuela",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                        "entry_id": "cb0b99d1-be38-31ea-a132-330a52c64179",
                                        "glosses": [
                                            "Staat in Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9e034ff-7ff3-4c37-bead-4fe38bd8daec",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Ich möchte einen Urlaub durch die 43 Nationalparks Venezuelas machen."
                                            },
                                            {
                                                "example_id": "218f4d58-2383-4cca-8441-75b3cfd6afc8",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Caracas ist die Hauptstadt von Venezuela."
                                            },
                                            {
                                                "example_id": "311cb117-df2c-4f78-ac58-3dee1bb93a97",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "Die hohe Kriminalität in Venezuela stellt ein großes Problem dar."
                                            },
                                            {
                                                "example_id": "cc5d14d6-ab33-4649-be4f-2a3b7fb23de4",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Das war eine der Vorgaben des Madrid-Vertrags: Die Welser sollten in Venezuela zwei Städte mit jeweils 300 Menschen besiedeln und drei Festungen bauen.“"
                                            },
                                            {
                                                "example_id": "28b2267c-3dcf-4369-83c9-e28921fed46a",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Venezuela gilt damit als erster Staat in der jüngeren Vergangenheit, der gletscherfrei wurde.“"
                                            },
                                            {
                                                "example_id": "1bc5ab57-c966-44b3-ace0-200219b4d65c",
                                                "sense_id": "67edaa4a-aa93-3bcd-9cab-e8c15f7031c4",
                                                "text": "„Neu-Nürnberg hat zwei Millionen Einwohner, liegt traumhaft an einem karibischen Meerbusen, heißt heute Maracaibo und ist die zweitgrößte Stadt Venezuelas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d62a8d-3821-47ec-a38e-5daa17f4421a",
                        "source_entry_id": "1dba4537-fa42-38ec-9233-f06a38f5c843",
