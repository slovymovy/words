                "senses": [
                    {
                        "sense_id": "aeecdd4f-98cb-3e23-a5a4-73acc5021e58",
                        "entry_id": "1b2f6037-b656-3aaa-8b99-baa42bba6a93",
                        "glosses": [
                            "taalvorm waarin elementen van twee of meer talen aanwezig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658c5612-38c7-4346-8c62-8070d1a21897",
                                "sense_id": "aeecdd4f-98cb-3e23-a5a4-73acc5021e58",
                                "text": "De mengtaal van jongeren in Amsterdam."
                            },
                            {
                                "example_id": "b5b64ee9-962e-496b-bcad-bd5904dc359d",
                                "sense_id": "aeecdd4f-98cb-3e23-a5a4-73acc5021e58",
                                "text": "Alle anderen bij de bouw wisten tenslotte dat hij Noors was — hoezeer hij zich ook had verzweedst, zoals ze deze mengtaal hadden genoemd onder de spoorwegarbeiders op de Hardangervidda, zodra hij zijn mond opende wist je meteen dat hij Noors was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1d5281f-0820-450b-81a8-62f5443a4477",
                        "source_entry_id": "1b2f6037-b656-3aaa-8b99-baa42bba6a93",
                        "source_sense_id": "aeecdd4f-98cb-3e23-a5a4-73acc5021e58",
                        "source_sense_description": "taalvorm die is ontstaan door contact tussen sprekers van verschillende talen",
                        "target_lang_word": "Mischsprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mischsprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                        "entry_id": "da3b2083-1fcd-32fb-83f2-048757368b81",
                                        "glosses": [
                                            "Sprache, die aufgrund engen Kontakts zwischen zwei oder mehr Sprachen entstanden ist und deutliche Züge der Ausgangssprachen trägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf50df6-c46f-42fe-9bf2-fb0472154b6a",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "In Bezug auf den Wortschatz gilt das Englische als Mischsprache, da es in erheblichem Maße romanischen Wortschatz aufgenommen hat."
                                            },
                                            {
                                                "example_id": "526ee3d4-a0ec-4149-8613-0974044ada86",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "Als Mischsprachen gelten vor allem Pidgin- und Creolsprachen."
                                            },
                                            {
                                                "example_id": "f5e3b0c1-be4a-478b-8790-9ea90b2b3a3b",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "„Es gibt allerdings Mischsprachen mit hohem deutschsprachigen Anteil, die in historischer Zeit aus nicht durchgehaltener Zweisprachigkeit oder Pidginisierung des Deutschen und einem Bedürfnis oder Zwang zur sozialen Absonderung als Sondersprachen entstanden sind.“"
                                            },
                                            {
                                                "example_id": "1b367fb3-3d16-476c-9f5a-8611747ead26",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "„Dann entstehen Sprachen, die wir als Mischsprachen bezeichnen.“"
                                            },
                                            {
                                                "example_id": "f6e41eab-790d-47e2-b0e4-5f1a6900befa",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "„Die Gefahr ist groß, daß sich bald eine Mischsprache herausbildet, ohne daß dies allen sogleich bewußt wird.“"
                                            },
                                            {
                                                "example_id": "0abf7432-cad3-42a4-b324-bf8549617b56",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "Mischsprachen sind das Ergebnis von Sprachmischung."
                                            },
                                            {
                                                "example_id": "f3729974-c639-4549-953e-75948e0c9f61",
                                                "sense_id": "8c4a5e7e-3a55-3bdf-b01e-be2d9fd85211",
                                                "text": "„Soll man nun beim Jiddisch des Ostens nach wie vor von Mischsprache oder Kauderwelsch sprechen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
