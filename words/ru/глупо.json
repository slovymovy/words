{
    "word_family": [
        "глупый",
        "глупость",
        "глупец",
        "глупить",
        "сглупить",
        "поглупеть"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "96e69160-6a6e-3d02-ac71-7b3897aac344",
                    "sense_definition": "Неразумно, бестолково; образом, свойственным человеку с недостатком ума.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты поступил очень <w>глупо</w>, когда отказался от помощи друзей.",
                            "target_lang_translations": {
                                "en": "You acted very <w>stupidly</w> when you refused your friends' help.",
                                "nl": "Je handelde heel <w>dom</w> toen je de hulp van vrienden weigerde."
                            }
                        },
                        {
                            "text": "В этой огромной шапке я выгляжу немного <w>глупо</w>.",
                            "target_lang_translations": {
                                "en": "I look a bit <w>stupid</w> in this huge hat.",
                                "nl": "Met deze enorme muts op zie ik er een beetje <w>stom</w> uit."
                            }
                        }
                    ],
                    "synonyms": [
                        "нелепо",
                        "дурацки",
                        "бестолково"
                    ],
                    "antonyms": [
                        "обдуманно",
                        "осмысленно",
                        "умно"
                    ],
                    "common_phrases": [
                        "поступить глупо",
                        "выглядеть глупо",
                        "вести себя глупо"
                    ],
                    "target_lang_definitions": {
                        "en": "In a foolish or senseless manner; unreasonably.",
                        "nl": "Op een dwaze, onverstandige manier; op een wijze die getuigt van weinig verstand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stupidly",
                                "target_lang_sense_clarification": "in a manner showing a lack of good sense or judgment"
                            },
                            {
                                "target_lang_word": "foolishly",
                                "target_lang_sense_clarification": "unwisely; without good judgment"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dom",
                                "target_lang_sense_clarification": "op onverstandige wijze"
                            },
                            {
                                "target_lang_word": "stom",
                                "target_lang_sense_clarification": "dwaas of onhandig"
                            },
                            {
                                "target_lang_word": "onnozel",
                                "target_lang_sense_clarification": "op een naïeve of gekke manier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eb83400-8f6f-3e79-8d9c-f45f1aaf38df",
                    "sense_definition": "Оценка ситуации или действий как противоречащих здравому смыслу.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "predicative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Было бы <w>глупо</w> спорить с очевидными фактами.",
                            "target_lang_translations": {
                                "en": "It would be <w>stupid</w> to argue with obvious facts.",
                                "nl": "Het zou <w>dom</w> zijn om te redetwisten over overduidelijke feiten."
                            }
                        },
                        {
                            "text": "Это звучит <w>глупо</w>, но я забыл свой собственный номер телефона.",
                            "target_lang_translations": {
                                "en": "It sounds <w>stupid</w>, but I forgot my own phone number.",
                                "nl": "Het klinkt <w>stom</w>, maar ik ben mijn eigen telefoonnummer vergeten."
                            }
                        }
                    ],
                    "synonyms": [
                        "нелепо"
                    ],
                    "common_phrases": [
                        "это глупо",
                        "звучит глупо",
                        "получилось глупо"
                    ],
                    "target_lang_definitions": {
                        "en": "Evaluation of a situation or action as contrary to common sense.",
                        "nl": "Beoordeling van een situatie of handeling als strijdig met het gezond verstand."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stupid",
                                "target_lang_sense_clarification": "predicative use (e.g., 'it is stupid')"
                            },
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "unwise or imprudent"
                            },
                            {
                                "target_lang_word": "silly",
                                "target_lang_sense_clarification": "lacking seriousness or sense"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dom",
                                "target_lang_sense_clarification": "onverstandig, onlogisch"
                            },
                            {
                                "target_lang_word": "stom",
                                "target_lang_sense_clarification": "niet slim, dwaas"
                            },
                            {
                                "target_lang_word": "onverstandig",
                                "target_lang_sense_clarification": "getuigend van weinig inzicht"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f04543d1-7f69-30f3-836f-ff5da69b6760",
                    "sense_definition": "Краткая форма среднего рода прилагательного <w>глупый</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Выражение его лица было <w>глупо</w> и растерянно.",
                            "target_lang_translations": {
                                "en": "The expression on his face was <w>stupid</w> and confused.",
                                "nl": "Zijn gezichtsuitdrukking was <w>dom</w> en verward."
                            }
                        },
                        {
                            "text": "Это животное совсем не <w>глупо</w>, оно просто напугано.",
                            "target_lang_translations": {
                                "en": "This animal is not <w>stupid</w> at all, it is just scared.",
                                "nl": "Dit dier is helemaal niet <w>dom</w>, het is gewoon bang."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter form of the adjective 'stupid'.",
                        "nl": "Korte onzijdige vorm van het bijvoeglijk naamwoord 'глупый' (dom, dwaas)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stupid",
                                "target_lang_sense_clarification": "lacking intelligence or common sense"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "dom",
                                "target_lang_sense_clarification": "gebrek hebbend aan verstand"
                            },
                            {
