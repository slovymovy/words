                                "target_senses": [
                                    {
                                        "sense_id": "31029b3c-91c5-3db3-8a21-4792e5ebe232",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "A person who bakes and sells bread, cakes and similar items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225968da-68c7-4859-aab1-6fab2eff8757",
                                                "sense_id": "31029b3c-91c5-3db3-8a21-4792e5ebe232",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2c1041-ed1b-3d1e-b1d8-23022e2617c7",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "A portable oven for baking."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "87b9da0d-a0c0-3e49-9b13-6f6b4bf1bffb",
                                        "entry_id": "3209ec2f-b74e-38bb-823d-a7505dd55238",
                                        "glosses": [
                                            "An apple suitable for baking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbf469ba-7941-4bb5-b309-9524189349d5",
                                                "sense_id": "87b9da0d-a0c0-3e49-9b13-6f6b4bf1bffb",
                                                "text": "Wealthys and McIntoshes are not good bakers."
                                            }
                                        ]
