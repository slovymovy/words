                    {
                        "sense_id": "4664b47e-4533-32e5-9805-93c3dd86c8d9",
                        "entry_id": "248e3000-ee3a-377e-b98e-2672aa4479a8",
                        "glosses": [
                            "szlachetny lub półszlachetny kamień ozdobiony reliefem ciętym wypukło"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44273686-7656-48d6-8936-4071398b1a8c",
                                "sense_id": "4664b47e-4533-32e5-9805-93c3dd86c8d9",
                                "text": "Na kameach często utrwalano wizerunki rzymskich władców."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dc1b2ae-2e3b-4e4a-b6be-f6e6ce15237f",
                        "source_entry_id": "248e3000-ee3a-377e-b98e-2672aa4479a8",
                        "source_sense_id": "4664b47e-4533-32e5-9805-93c3dd86c8d9",
                        "target_lang_word": "cameo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cameo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2edb0b-9849-33ac-931b-8063f8f2d7c5",
                                        "entry_id": "77eb37bc-d417-3598-8379-c5d32d129bca",
                                        "glosses": [
                                            "A piece of jewelry, etc., carved in relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b6e49c7-d906-4c6e-9927-52c2ba6ee198",
                                                "sense_id": "6f2edb0b-9849-33ac-931b-8063f8f2d7c5",
                                                "text": "Aarfy's buxom trollop had vanished with her smutty cameo ring, and Nurse Duckett was ashamed of him because he had refused to fly more combat missions and would cause a scandal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1c0372-3b0c-3423-9663-bee99b185031",
                                        "entry_id": "77eb37bc-d417-3598-8379-c5d32d129bca",
                                        "glosses": [
                                            "A single very brief appearance, especially by a prominent celebrity in a movie or song."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a098a9-4c8e-4dea-9876-ae972344270f",
                                                "sense_id": "3a1c0372-3b0c-3423-9663-bee99b185031",
                                                "text": "Famous comic book writer Stan Lee had a cameo in the Spider-Man movie. He was on screen for perhaps ten seconds, but aficionados distinctly remember him."
                                            },
                                            {
                                                "example_id": "282932c4-2f62-4162-b726-1f477970bd4d",
                                                "sense_id": "3a1c0372-3b0c-3423-9663-bee99b185031",
                                                "text": "As they turned into Hertford Street they startled a robin from the poet's head on a barren fountain, and he fled away with a cameo note."
                                            },
                                            {
                                                "example_id": "cadf6d1e-a856-4a8e-ba2f-671364cf268f",
                                                "sense_id": "3a1c0372-3b0c-3423-9663-bee99b185031",
                                                "text": "Southgate will have been delighted to give Foden the first of many England caps while Greenwood will also have enjoyed his taste of international action during his cameo after coming on as a substitute for Kane."
                                            },
                                            {
                                                "example_id": "23dec76e-3995-4c1b-b429-d3395db802a5",
                                                "sense_id": "3a1c0372-3b0c-3423-9663-bee99b185031",
                                                "text": "Dr. Helen O’Connell, Australia’s first female urologist, recalled that in her own medical training, the clitoris barely made a cameo."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cameo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ccb8a6c-3665-3eb2-99d5-5c7f85d2e550",
                                        "entry_id": "0a52228f-e398-3831-abf1-2b8d608388bf",
                                        "glosses": [
                                            "To appear in a cameo role."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7db6589-7b06-44be-afee-5b6ca8d10169",
                        "source_entry_id": "248e3000-ee3a-377e-b98e-2672aa4479a8",
                        "source_sense_id": "4664b47e-4533-32e5-9805-93c3dd86c8d9",
                        "target_lang_word": "camée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d85bea5b-da40-3930-b6a9-f090541a332f",
                                        "entry_id": "8a63c1ff-f399-3d36-aadd-ee6f9c3733c2",
                                        "glosses": [
                                            "Pierre composée de différentes couches de diverses couleurs superposées et sculptée en relief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60784450-875e-4a70-8216-5c7cc46937fa",
                                                "sense_id": "d85bea5b-da40-3930-b6a9-f090541a332f",
                                                "text": "Un beau camée est plus rare qu’une belle pierre taillée en creux."
                                            },
                                            {
                                                "example_id": "9cea9a63-6b34-4ac8-a2d3-45220fb1ddac",
                                                "sense_id": "d85bea5b-da40-3930-b6a9-f090541a332f",
                                                "text": "Un camée sur pierre dure."
                                            },
                                            {
                                                "example_id": "60e7f490-9032-431e-8f9e-3046a6695439",
                                                "sense_id": "d85bea5b-da40-3930-b6a9-f090541a332f",
                                                "text": "… assise sur des coussins persiques, elle devisait avec les sages en tournant dans ses doigts son collier de camées."
                                            },
                                            {
                                                "example_id": "9fffa50d-c3ab-46bd-8dd8-bafa1ed2f54c",
                                                "sense_id": "d85bea5b-da40-3930-b6a9-f090541a332f",
                                                "text": "On cesse de disputer du classicisme et du réalisme quand on a sous les yeux leur complète fusion dans un camée romain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "501c6ca9-7b30-355c-a44b-ef1e24dd9db2",
                                        "entry_id": "8a63c1ff-f399-3d36-aadd-ee6f9c3733c2",
                                        "glosses": [
                                            "Imitation de camée faite en grisaille."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bb21c77-99a5-40de-bf53-7e51d68b195f",
                                                "sense_id": "501c6ca9-7b30-355c-a44b-ef1e24dd9db2",
                                                "text": "Mais Françoise s'était entichée de son unique petite-fille, qui lui ressemblait tant qu'on eut dit son camée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f71b0ea-0315-33e2-9d53-7aeef9378430",
                                        "entry_id": "d433cc7e-03a4-3385-88cc-e34f066ee08e",
                                        "glosses": [
                                            "Celle qui s'adonne à la consommation de drogues."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f4987b7-0eca-43e4-9e48-53aabd174c80",
                                                "sense_id": "3f71b0ea-0315-33e2-9d53-7aeef9378430",
                                                "text": "Notre ancienne camée n'avait jamais été revendeuse et, notre trafiquant ignorait qu'elle ne se schnouffait plus."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
