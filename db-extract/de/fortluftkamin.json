                "senses": [
                    {
                        "sense_id": "ba721d35-ba22-3dad-a30f-674ff2a2c358",
                        "entry_id": "f27729d4-d1ba-3e54-bfb0-3e0e8decb2ef",
                        "glosses": [
                            "senkrechter massiver Kamin zum Abführen von Fortluft bis ins Freie"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "e299dec6-3fec-4be6-9ff5-df1a071dccb1",
                                "sense_id": "ba721d35-ba22-3dad-a30f-674ff2a2c358",
                                "text": "„In Zusammenarbeit mit der KELAG Umwelttechnik GmbH&CO KG, (www.kelag-ut.at) entwickelte und fertigte AUMAYR für eine Abfallbehandlungsanlage in Großbritannien einen runden Kulissenschalldämpfer für den Einschub in einen Fortluftkamin.“"
                            },
                            {
                                "example_id": "2f86b765-33bd-47a8-b389-85d35790f366",
                                "sense_id": "ba721d35-ba22-3dad-a30f-674ff2a2c358",
                                "text": "„Die Ableitung radioaktiver Stoffe über den Fortluftkamin kann außerdem kontinuierlich durch eine Ionisationskammer im Fortluftkamin über wacht werden“"
                            },
                            {
                                "example_id": "1c105c04-9ba2-43cf-a55b-c9db1f079be1",
                                "sense_id": "ba721d35-ba22-3dad-a30f-674ff2a2c358",
                                "text": "„Angaben über Einrichtungen für Lüftung sowie für Ableitung und Lagerung radioaktiver Stoffe, soweit erforderlich (z.B. Be- und Entlüftungssysteme mit Abscheideeinrichtungen, Abluftsystem und Fortluftkamin mit Abscheidevorrichtungen, Abwassersysteme mit Abscheidevorrichtungen,Abklinganlagen, Einleitstellen in öffentliches Kanalsystem, Einschlusssysteme, wie Heiße Zellen, Abzüge etc., Lager für radioaktive Stoffe und Abfälle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad112676-3fd2-34c3-aee2-a161b041c465",
                        "entry_id": "f27729d4-d1ba-3e54-bfb0-3e0e8decb2ef",
                        "glosses": [
                            "fachsprachlich: metallischerKamin zum Abführen von Fortluft aus einer Küche bis ins Freie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5523dc-40bf-40b0-9827-508fe09be65b",
                                "sense_id": "ad112676-3fd2-34c3-aee2-a161b041c465",
                                "text": "„Fortluftkamin wird über Dach geführt, jedoch nicht über den höchsten Punkt des Gebäudes: nur möglich, wenn das Kamin mindestens über die bewohnten Räumlichkeiten des Gebäudes geführt wird und kein weiteres Gebäude im Immissionsbereich von 15 m vorhanden ist“"
                            },
                            {
                                "example_id": "a4fc8d4a-010e-4f7c-812f-63a37f9d26bb",
                                "sense_id": "ad112676-3fd2-34c3-aee2-a161b041c465",
                                "text": "„Zu- und Abluftgerät mit Wärmerückgewinnung in wetterfester Ausführung, da Aufstellung im Innenhof; Luftleistung ca. 8.000m³; Kanäle:Zu-u. Abluft; Fortluftkamin, Wärmeschutzarbeiten; Demontage und Entsorgung des vorhand. Lüftungsgerätes; neue Regelungstechnik; Einbau v. Küchenlüftungshauben-/ Decke inkl. Beleuchtung“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
