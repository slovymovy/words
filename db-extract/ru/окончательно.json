                ],
                "translations": [
                    {
                        "translation_id": "110118d6-43ae-4c73-ab2e-42ef38e61d22",
                        "source_entry_id": "bddd039d-7f99-3907-be25-5cadb750a1c0",
                        "source_sense_description": "нареч. к окончательный; не подлежа пересмотру или отмене",
                        "target_lang_word": "finally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At the end or conclusion; ultimately."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4885f8-0eed-452f-a3aa-6f284a654ca1",
                                                "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                                "text": "The contest was long, but the Romans finally conquered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At bottom; ultimately; when all is considered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df087c1d-5fbd-4fbb-8a4d-8d3b0a8a2390",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "In a world in which \"like singing,/ the next day's shriek for ease rises,\" in a world whose \"survivors\" are \"capable of any cry, never done/ clasping in the city's shaken places,\" it is perhaps not surprising to find a dehumanizing but finally protective system of alienation imposing itself."
                                            },
                                            {
                                                "example_id": "6f64760b-5409-406a-bd47-50839ce0edf1",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "Cyberneticism is, finally, a refined form of scientism, and therefore it is also more dangerous. This form of scientism is not based on linear causality, as mechanistic thought is; rather, it is based on circular causality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "To finish (with); lastly (in the present)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "sequence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875b37ec-bba3-41ca-8867-2ffd6e05b11b",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            },
                                            {
                                                "example_id": "8df4194e-2089-4c1b-8b70-30bedc67125f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I washed my dog."
                                            },
                                            {
                                                "example_id": "2fad7140-79ff-4eb0-9a5f-6ac67fb4182a",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I'd like to thanks all the people who helped to make it this far."
                                            },
                                            {
                                                "example_id": "477d690b-7350-4ee0-84a9-8a77f5d0780f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "Definitively, comprehensively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4d0e58-62b6-421d-bdba-f19368c907f4",
                                                "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                                "text": "The question of his long-term success has now been finally settled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07404733-9944-4380-b1d8-f1a6ce0c6f32",
                        "source_entry_id": "bddd039d-7f99-3907-be25-5cadb750a1c0",
                        "source_sense_description": "нареч. к окончательный; не подлежа пересмотру или отмене",
                        "target_lang_word": "definitively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "definitively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75f56364-a1d4-3e8f-a86a-434cc29df5c4",
                                        "entry_id": "964883e5-3e9c-3041-871d-b8918007fdb3",
                                        "glosses": [
                                            "In a way that is not only decisive, but also conclusive and final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9ef8908-473d-45bd-a491-b0625063b13a",
                                                "sense_id": "75f56364-a1d4-3e8f-a86a-434cc29df5c4",
                                                "text": "Far from making the kind of statement of hard fact that editors had readily made regarding claims about Trump’s racism, the article fails to definitively state that the laptop is not, in fact, Russian disinformation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e31dc8d-bf39-471f-8804-5f2240886e46",
                        "source_entry_id": "bddd039d-7f99-3907-be25-5cadb750a1c0",
                        "source_sense_description": "нареч. к окончательный; не подлежа пересмотру или отмене",
                        "target_lang_word": "completely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "In a complete manner; thoroughly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef0e07a-86f1-4c4b-b8ea-dd67121cec32",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Please completely fill in the box for your answer, using a number 2 pencil."
                                            },
                                            {
                                                "example_id": "bc5853fb-b049-4275-b1c1-b1490997c41b",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "I will have completely finished my degree by next July, when my thesis has been properly edited."
                                            },
                                            {
                                                "example_id": "d43b1f8e-e132-46b0-8d56-f64952f8e530",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "It should not have been omitted that previous to completely stripping the body of the leviathan, he was beheaded."
                                            },
                                            {
                                                "example_id": "c3c37d13-9a2d-47c4-a772-ceb61c44a5bd",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "She completely abandoned her Tuesdays at home, and did not return the visits of those who had called upon her."
                                            },
                                            {
                                                "example_id": "fa3892a0-d491-4f94-a747-371556908c5e",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Lieutenant (junior grade) KERRY immediately maneuvered his craft through several strafing runs which completely silenced the enemy."
                                            },
                                            {
                                                "example_id": "17a3b433-3441-46b0-84e9-784d726ef42a",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "To the fullest extent or degree; totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59585da3-49e8-4d49-8f1c-d93feb4eb04b",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "He is completely mad."
                                            },
                                            {
                                                "example_id": "3b0f2f43-1c7d-47fa-8130-7d1202d6bddd",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "42630122-febf-46fe-af3e-0d94e0c8b1d7",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "Our future may lie beyond our vision, but it is not completely beyond our control."
                                            },
                                            {
                                                "example_id": "f9ba36d2-d4c2-47e3-a0f1-dd6ae8191e76",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "1975, Helen Schucman, A Course in Miracles/Workbook for Students, Lesson 75: The light has come,\nKeep a completely open mind, washed of all past ideas and clean of every concept you have made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d69b9ff4-0c17-4555-9d4f-d45a5d8f5b45",
                        "source_entry_id": "bddd039d-7f99-3907-be25-5cadb750a1c0",
                        "source_sense_description": "нареч. к окончательный; не подлежа пересмотру или отмене",
                        "target_lang_word": "définitivement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "définitivement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "D’une manière définitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60fd9f4-9a25-4df9-920d-474349ea549e",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Et quand elle se sentit définitivement seule et abandonnée, Yasmina se rendit chez ses deux amies qui l'accueillirent avec joie."
                                            },
                                            {
                                                "example_id": "d942812f-b007-4f25-831c-53ee085af493",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Elle enrageait de ne pas être sortie major. Elle l’aurait mérité pourtant, et cela aurait définitivement claqué le beignet à tous ces types qui ne la calculaient pas."
                                            },
                                            {
                                                "example_id": "f203e2b8-c9e7-4ee8-bb87-e33ae202088a",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Toutefois, si un magnanime sentiment de fraternité s'imposait sincèrement et définitivement, sans arrière-pensée, à tous les esprits européens, alors nous n'aurions pas à nous inquiéter du cosmopolitisme marseillais, intéressant embryon de la civilisation future."
                                            },
                                            {
                                                "example_id": "39da4482-c213-4f1d-bc2b-d8b63e62e232",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Ces messieurs me catalogueraient définitivement et toute démarche de ma part afin de me justifier ne servirait qu'à aggraver la situation."
                                            },
                                            {
                                                "example_id": "78325ce3-0990-49f1-a4ed-91e35fc9c17f",
                                                "sense_id": "ec87352f-e409-3244-84fe-8b3d53472253",
                                                "text": "Je me contentais depuis la veille de monter quelques instants dans la mâture ; à ce moment, je pris définitivement mon poste sur les barres du petit perroquet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1502d9e-5fc1-3ea5-92ae-df8283c508fe",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "Par jugement définitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10c7270-50ea-4a7d-ad97-8e291b8831f3",
                                                "sense_id": "a1502d9e-5fc1-3ea5-92ae-df8283c508fe",
                                                "text": "L’affaire a été jugée définitivement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653dd9bb-6a95-3fc6-89fc-628e2f4d96e4",
                                        "entry_id": "d289f49e-83dc-3405-bfcf-2f025e15ea2a",
                                        "glosses": [
                                            "(Usage critiqué) référence nécessaire (résoudre le problème) Assurément, comme on peut le conclure sans l’ombre d’un doute."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38069d26-c904-4888-9307-c544f35b0095",
                                                "sense_id": "653dd9bb-6a95-3fc6-89fc-628e2f4d96e4",
                                                "text": "Donc, oui, définitivement, le Parisien est ultra-sociable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
