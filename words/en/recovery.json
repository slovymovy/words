{
    "word_family": [
        "recover",
        "recoverable",
        "recoverability",
        "recoverer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea001d82-1874-3775-95cd-d10e53f1648c",
                    "sense_definition": "A return to normal health or strength after being ill or injured.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health_restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all wished him a speedy <w>recovery</w> from the flu.",
                            "target_lang_translations": {
                                "ru": "Мы все желали ему скорейшего <w>выздоровления</w> от гриппа.",
                                "zh": "我们都祝愿他能从流感中尽快<w>康复</w>。"
                            }
                        },
                        {
                            "text": "The doctor was surprised by her complete <w>recovery</w> after the accident.",
                            "target_lang_translations": {
                                "ru": "Врач был удивлен её полным <w>восстановлением</w> после аварии.",
                                "zh": "医生对她在事故后的完全<w>恢复</w>感到惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recuperation",
                        "healing",
                        "improvement"
                    ],
                    "common_phrases": [
                        "speedy recovery",
                        "full recovery",
                        "make a recovery",
                        "wish for a recovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение к нормальному здоровью или силам после болезни или травмы.",
                        "zh": "指生病或受伤后恢复到正常的健康状态或体力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выздоровле́ние",
                                "target_lang_sense_clarification": "после болезни"
                            },
                            {
                                "target_lang_word": "восстановле́ние",
                                "target_lang_sense_clarification": "сил или после травмы"
                            },
                            {
                                "target_lang_word": "попра́вка",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "康复",
                                "target_lang_sense_clarification": "指身体机能的恢复"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指健康状况的好转"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20e4b748-9716-3aeb-a46d-234d416f0846",
                    "sense_definition": "The process of improving or becoming strong again after a difficult period, especially in an economy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experts predict a slow economic <w>recovery</w> following the recession.",
                            "target_lang_translations": {
                                "ru": "Эксперты прогнозируют медленное экономическое <w>восстановление</w> после рецессии.",
                                "zh": "专家预测经济衰退后会出现缓慢的<w>复苏</w>。"
                            }
                        },
                        {
                            "text": "The company showed signs of <w>recovery</w> in the last quarter.",
                            "target_lang_translations": {
                                "ru": "Компания продемонстрировала признаки <w>оздоровления</w> в прошлом квартале.",
                                "zh": "该公司在上一季度显示出<w>恢复</w>的迹象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic recovery",
                        "signs of recovery",
                        "road to recovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс улучшения или укрепления после трудного периода, особенно в экономике.",
                        "zh": "指在困难时期过后，情况有所改善或变得强劲的过程，尤指经济方面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстановле́ние",
                                "target_lang_sense_clarification": "экономики, рынка"
                            },
                            {
                                "target_lang_word": "оживле́ние",
                                "target_lang_sense_clarification": "рост активности"
                            },
                            {
                                "target_lang_word": "оздоровле́ние",
                                "target_lang_sense_clarification": "финансового состояния"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复苏",
                                "target_lang_sense_clarification": "指经济或市场的回暖"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指整体状况的改善"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92f9b9ad-6fe5-37e1-b6ab-427b1b55b22d",
                    "sense_definition": "The act of getting something back that was lost, stolen, or missing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regaining_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police coordinated the <w>recovery</w> of the stolen vehicle.",
                            "target_lang_translations": {
                                "ru": "Полиция координировала <w>возврат</w> угнанного автомобиля.",
                                "zh": "警方协调了被盗车辆的<w>找回</w>工作。"
                            }
                        },
                        {
                            "text": "We specialize in data <w>recovery</w> from damaged hard drives.",
                            "target_lang_translations": {
                                "ru": "Мы специализируемся на <w>восстановлении</w> данных с поврежденных жестких дисков.",
                                "zh": "我们专门从事受损硬盘的<w>数据恢复</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "data recovery",
                        "recovery team",
                        "recovery of assets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по возвращению чего-либо потерянного, украденного или пропавшего.",
                        "zh": "指找回丢失、被盗或遗失物品的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвра́т",
                                "target_lang_sense_clarification": "имущества"
                            },
                            {
                                "target_lang_word": "восстановле́ние",
                                "target_lang_sense_clarification": "данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "找回",
                                "target_lang_sense_clarification": "指寻回失物"
                            },
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "指数据或文件的还原"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06d00194-45ad-37e9-8b1a-490bf4172055",
                    "sense_definition": "The process of collecting money that is owed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank has initiated debt <w>recovery</w> procedures against the client.",
                            "target_lang_translations": {
                                "ru": "Банк начал процедуры <w>взыскания</w> долга с клиента.",
                                "zh": "银行已针对该客户启动了债务<w>追回</w>程序。"
                            }
                        },
                        {
                            "text": "He sued for the <w>recovery</w> of his legal costs.",
                            "target_lang_translations": {
                                "ru": "Он подал иск о <w>возмещении</w> своих судебных издержек.",
                                "zh": "他起诉要求<w>索回</w>他的法律费用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "debt recovery",
                        "cost recovery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс взыскания причитающихся денежных средств.",
                        "zh": "指收回欠款的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взыска́ние",
                                "target_lang_sense_clarification": "долгов"
                            },
                            {
                                "target_lang_word": "возмеще́ние",
                                "target_lang_sense_clarification": "расходов"
                            },
                            {
                                "target_lang_word": "возвра́т",
                                "target_lang_sense_clarification": "средств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "追回",
                                "target_lang_sense_clarification": "指债务的收回"
                            },
                            {
                                "target_lang_word": "索回",
                                "target_lang_sense_clarification": "指通过法律手段要求赔偿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "843e9775-d8cf-3b73-ab88-7ce350bfe141",
                    "sense_definition": "The process of obtaining a substance, such as metal or oil, from rock or waste materials.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New technology allows for better oil <w>recovery</w> from old wells.",
                            "target_lang_translations": {
                                "ru": "Новая технология позволяет улучшить <w>добычу</w> нефти из старых скважин.",
                                "zh": "新技术使得从老油井中能更好地<w>开采</w>石油。"
                            }
                        },
                        {
                            "text": "The <w>recovery</w> of gold from the ore was highly efficient.",
                            "target_lang_translations": {
                                "ru": "<w>Извлечение</w> золота из руды было высокоэффективным.",
                                "zh": "从矿石中<w>提取</w>黄金的效率非常高。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс получения вещества, например металла или нефти, из породы или отходов.",
                        "zh": "指从岩石或废料中提取金属或石油等物质的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извлече́ние",
                                "target_lang_sense_clarification": "полезных ископаемых"
                            },
                            {
                                "target_lang_word": "добы́ча",
                                "target_lang_sense_clarification": "нефти, газа"
                            },
                            {
                                "target_lang_word": "рекупера́ция",
                                "target_lang_sense_clarification": "техническое: из отходов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开采",
                                "target_lang_sense_clarification": "指矿产或石油的获取"
                            },
                            {
                                "target_lang_word": "提取",
                                "target_lang_sense_clarification": "指从矿石中分离出金属"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a52b5d23-b832-3496-b1e5-37306603207c",
                    "sense_definition": "The act of returning to a defensive or neutral position after making a movement or attack.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His quick <w>recovery</w> after the lunge prevented his opponent from scoring.",
                            "target_lang_translations": {
                                "ru": "Его быстрый <w>возврат</w> в стойку после выпада помешал противнику нанести укол.",
                                "zh": "他在刺击后的快速<w>回位</w>阻止了对手得分。"
                            }
                        },
                        {
                            "text": "In rowing, the <w>recovery</w> phase prepares the athlete for the next stroke.",
                            "target_lang_translations": {
                                "ru": "В академической гребле фаза <w>возврата</w> готовит спортсмена к следующему гребку.",
                                "zh": "在赛艇运动中，<w>还原</w>阶段为运动员下一次划桨做好了准备。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение в защитную или нейтральную позицию после движения или атаки.",
                        "zh": "指在做出动作或攻击后，回到防御或中立位置的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возвра́т",
                                "target_lang_sense_clarification": "в исходное положение"
                            },
                            {
                                "target_lang_word": "восстановле́ние",
                                "target_lang_sense_clarification": "позиции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "回位",
                                "target_lang_sense_clarification": "指回到初始姿势"
                            },
                            {
                                "target_lang_word": "还原",
                                "target_lang_sense_clarification": "指动作后的姿态调整"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}