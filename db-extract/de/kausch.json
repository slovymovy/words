                                        "entry_id": "bd5a1ccf-a9d0-3443-9395-37959a28557b",
                                        "glosses": [
                                            "A pitted, now usually metal, cup-shaped cap worn on the tip of a finger, which is used in sewing to push the needle through material."
                                        ],
                                        "tags": [],
