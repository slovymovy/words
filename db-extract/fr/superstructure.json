                                "target_senses": [
                                    {
                                        "sense_id": "4dbd9e73-9696-319c-910d-8ef0c0c5fb82",
                                        "entry_id": "90f6204a-af6d-3b29-8ea4-95e6ef6489e4",
                                        "glosses": [
                                            "een benaming die algemeen gesproken wordt gebruikt voor de hogere leerjaren van het primair (in Nederland) en secundair onderwijs (in Nederland en België)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a9036e-5331-4fa8-a2a7-309ce956c2ea",
                                                "sense_id": "4dbd9e73-9696-319c-910d-8ef0c0c5fb82",
                                                "text": "De leerlingen van de bovenbouw zijn de oudste leerlingen van de school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca40865-0854-3452-8874-c43229004d2b",
                                        "entry_id": "90f6204a-af6d-3b29-8ea4-95e6ef6489e4",
                                        "glosses": [
                                            "bovenste deel van een gebouw"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80893c06-f42b-4db8-897a-f41c006f7f69",
                                                "sense_id": "fca40865-0854-3452-8874-c43229004d2b",
                                                "text": "Daarachter ontvouwde zich het tweede deel van het plein, als een verborgen surprise, geflankeerd door het onwereldse dogepaleis, dat leek te zweven met twee breekbaar ogende, opengewerkte benedenverdiepingen onder een stoere, middeleeuwse bovenbouw, en de twee zuilen waarachter het plaveisel zonder muurtje, hek, verkeersbord of waarschuwing overging in het water van Canal Grande, de lagune en de open zee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38759871-0384-406c-bd37-11907cfdff35",
