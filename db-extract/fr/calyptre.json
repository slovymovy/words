                "senses": [
                    {
                        "sense_id": "cb9da9a7-034b-374c-90c8-7e77b1911817",
                        "entry_id": "ed2d18b5-7a7b-323e-a60e-4cb8e8117522",
                        "glosses": [
                            "Dans l'antiquité, coiffe portée par les femmes grecques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e2c7c4-5285-4864-b41c-598d51936c80",
                                "sense_id": "cb9da9a7-034b-374c-90c8-7e77b1911817",
                                "text": "Un voile léger, une calyptre jetée à terre est sans forme comme une nappe d’eau, mais, posée sur la tète d’une femme, tombant sur les épaules, sur les seins et jusqu’aux pieds, elle devient plastique infiniment."
                            },
                            {
                                "example_id": "b25e4939-e69e-4be5-92de-8c311042dfd3",
                                "sense_id": "cb9da9a7-034b-374c-90c8-7e77b1911817",
                                "text": "Dans son Èlectre , les plis de la calyptre tombent droit, du col aux pieds, auprès d’une colonne dorique aux cannelures droites,en avant d’un laurier droit — (Robert de La Sizeranne, La peinture anglaise contemporaine, Librairie Hachette, 1922)"
                            }
                        ]
                    }
                ],
