{
    "word_family": [
        "precedence",
        "precede",
        "unprecedented",
        "precedential"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93a49664-44c9-35c3-b471-7ce00d32245b",
                    "sense_definition": "A legal decision or case that is used as a guide or justification for subsequent cases with similar facts.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_precedent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge's ruling in this case will set a <w>precedent</w> for all future environmental lawsuits.",
                            "target_lang_translations": {
                                "ru": "Решение судьи по этому делу создаст <w>прецедент</w> для всех будущих экологических исков.",
                                "zh": "法官在本案中的裁决将为未来所有的环境诉讼<w>开创先例</w>。"
                            }
                        },
                        {
                            "text": "Lawyers often search for a legal <w>precedent</w> to support their arguments in court.",
                            "target_lang_translations": {
                                "ru": "Юристы часто ищут юридический <w>прецедент</w>, чтобы подкрепить свои аргументы в суде.",
                                "zh": "律师经常寻找法律<w>先例</w>来支持他们在法庭上的论点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal precedent",
                        "set a precedent",
                        "judicial precedent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судебное решение или дело, используемое в качестве руководства или обоснования для последующих дел с аналогичными фактами.",
                        "zh": "指在法律上作为后续类似案件参考或依据的判决或案例。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прецедент",
                                "target_lang_sense_clarification": "судебный или юридический случай"
                            },
                            {
                                "target_lang_word": "судебный прецедент",
                                "target_lang_sense_clarification": "решение суда, имеющее силу закона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先例",
                                "target_lang_sense_clarification": "法律上的判例"
                            },
                            {
                                "target_lang_word": "判例",
                                "target_lang_sense_clarification": "具有法律效力的裁决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c297983d-9c39-3749-af77-c78c1611dab2",
                    "sense_definition": "An earlier event or action that is regarded as an example or guide to be considered in subsequent similar circumstances.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_example",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>precedent</w> for a company of this size filing for bankruptcy so suddenly.",
                            "target_lang_translations": {
                                "ru": "Нет <w>прецедента</w> тому, чтобы компания такого размера так внезапно подавала на банкротство.",
                                "zh": "像这样规模的公司如此突然地申请破产，此前并无<w>先例</w>。"
                            }
                        },
                        {
                            "text": "The committee decided to break with <w>precedent</w> and appoint a student as the chairperson.",
                            "target_lang_translations": {
                                "ru": "Комитет решил отойти от <w>прецедента</w> и назначить председателем студента.",
                                "zh": "委员会决定打破<w>惯例</w>，任命一名学生担任主席。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "break with precedent",
                        "without precedent",
                        "dangerous precedent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более раннее событие или действие, рассматриваемое как пример или руководство для последующих аналогичных обстоятельств.",
                        "zh": "指可作为后续类似情况参考或效仿的早期事件或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прецедент",
                                "target_lang_sense_clarification": "случай в прошлом"
                            },
                            {
                                "target_lang_word": "пример",
                                "target_lang_sense_clarification": "образец для подражания или сравнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先例",
                                "target_lang_sense_clarification": "以往的例子"
                            },
                            {
                                "target_lang_word": "范例",
                                "target_lang_sense_clarification": "可供参考的榜样"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8cb7300-ad5e-3b4c-b0f0-eae1158ad215",
                    "sense_definition": "An established habit, custom, or way of doing things based on past practice.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_example",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual gala followed the <w>precedent</w> of previous years by starting with a silent auction.",
                            "target_lang_translations": {
                                "ru": "Ежегодный гала-концерт последовал <w>примеру</w> прошлых лет, начавшись с тихого аукциона.",
                                "zh": "年度盛会遵循往年的<w>惯例</w>，以无声拍卖拉开序幕。"
                            }
                        },
                        {
                            "text": "Following historical <w>precedent</w>, the ceremony was held in the ancient town square.",
                            "target_lang_translations": {
                                "ru": "Следуя историческому <w>прецеденту</w>, церемония прошла на старинной городской площади.",
                                "zh": "依照历史<w>惯例</w>，仪式在古老的城镇广场举行。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "historical precedent",
                        "follow precedent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установившаяся привычка, обычай или способ ведения дел, основанный на прошлой практике.",
                        "zh": "基于过去实践而形成的既定习惯、习俗或行事方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "традиция",
                                "target_lang_sense_clarification": "устоявшийся обычай"
                            },
                            {
                                "target_lang_word": "прецедент",
                                "target_lang_sense_clarification": "сложившаяся практика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惯例",
                                "target_lang_sense_clarification": "一贯的做法"
                            },
                            {
                                "target_lang_word": "传统",
                                "target_lang_sense_clarification": "长期形成的习俗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f71d2080-2424-3ace-bc3a-63f81f995e58",
                    "sense_definition": "A preliminary draft or original version of a legal document or writing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clerk was asked to return the <w>precedent</w> to the lords once the final copy was signed.",
                            "target_lang_translations": {
                                "ru": "Клерка попросили вернуть <w>оригинал</w> лордам, как только была подписана окончательная копия.",
                                "zh": "文员被要求在最终副本签署后将<w>原稿</w>归还给领主。"
                            }
                        },
                        {
                            "text": "He kept the <w>precedent</w> safe as a reference for the final version of the treaty.",
                            "target_lang_translations": {
                                "ru": "Он сохранил <w>черновик</w> в качестве справочного материала для окончательной версии договора.",
                                "zh": "他妥善保管了<w>草案</w>，作为最终版条约的参考。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предварительный проект или оригинальная версия юридического документа или текста.",
                        "zh": "法律文件或文书的初步草案或原始版本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черновик",
                                "target_lang_sense_clarification": "предварительный набросок документа"
                            },
                            {
                                "target_lang_word": "оригинал",
                                "target_lang_sense_clarification": "первоначальный образец документа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草案",
                                "target_lang_sense_clarification": "初步拟定的文件"
                            },
                            {
                                "target_lang_word": "原稿",
                                "target_lang_sense_clarification": "最初的文本"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d36b4fc-13fc-386e-ad7c-2dc05e0362de",
                    "sense_definition": "Occurring or existing before something else in time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>precedent</w> events led directly to the crisis we are facing today.",
                            "target_lang_translations": {
                                "ru": "<w>Предшествующие</w> события привели непосредственно к кризису, с которым мы сталкиваемся сегодня.",
                                "zh": "<w>先前</w>发生的事件直接导致了我们今天所面临的危机。"
                            }
                        },
                        {
                            "text": "We must examine the <w>precedent</w> conditions before we can understand the current results.",
                            "target_lang_translations": {
                                "ru": "Мы должны изучить <w>предыдущие</w> условия, прежде чем сможем понять текущие результаты.",
                                "zh": "我们必须先检查<w>先前</w>的条件，才能理解当前的结果。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antecedent#Adjective"
                    ],
                    "antonyms": [
                        "subsequent",
                        "following"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или существующий до чего-либо другого во времени.",
                        "zh": "在时间上发生或存在于某事之前的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предшествующий",
                                "target_lang_sense_clarification": "бывший ранее по времени"
                            },
                            {
                                "target_lang_word": "предыдущий",
                                "target_lang_sense_clarification": "случившийся до настоящего момента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先前的",
                                "target_lang_sense_clarification": "时间上在前的"
                            },
                            {
                                "target_lang_word": "前述的",
                                "target_lang_sense_clarification": "之前提到的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "519dc017-9e90-3bb7-b697-cd642fcddacf",
                    "sense_definition": "Coming before in a specific order, arrangement, or sequence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As mentioned in the <w>precedent</w> section, the beauty of the landscape is unmatched.",
                            "target_lang_translations": {
                                "ru": "Как упоминалось в <w>предыдущем</w> разделе, красота пейзажа не имеет себе равных.",
                                "zh": "正如在<w>前一</w>节中所提到的，这里的风景美得无与伦比。"
                            }
                        },
                        {
                            "text": "The <w>precedent</w> chapters provide the necessary background for this complex theory.",
                            "target_lang_translations": {
                                "ru": "<w>Вышеуказанные</w> главы содержат необходимую основу для этой сложной теории.",
                                "zh": "<w>前述</w>章节为这一复杂的理论提供了必要的背景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "predecessive"
                    ],
                    "antonyms": [
                        "succeeding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идущий впереди в определенном порядке, расположении или последовательности.",
                        "zh": "在特定的顺序、排列或序列中位于前面的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышеуказанный",
                                "target_lang_sense_clarification": "упомянутый ранее в тексте"
                            },
                            {
                                "target_lang_word": "предыдущий",
                                "target_lang_sense_clarification": "расположенный перед текущим элементом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前一个",
                                "target_lang_sense_clarification": "顺序在前的"
                            },
                            {
                                "target_lang_word": "上述",
                                "target_lang_sense_clarification": "文中提到的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "33c6fa11-dba2-3753-9db2-e7610c9b0a01",
                    "sense_definition": "To serve as an example or justification for a future action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "to_set_example",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This unusual decision might <w>precedent</w> a shift in how the law is applied.",
                            "target_lang_translations": {
                                "ru": " Это необычное решение может <w>создать прецедент</w> для изменения того, как применяется закон.",
                                "zh": "这一不同寻常的决定可能会为法律适用方式的转变<w>开创先例</w>。"
                            }
                        },
                        {
                            "text": "The court's choice to <w>precedent</w> the new rule surprised many legal experts.",
                            "target_lang_translations": {
                                "ru": "Решение суда <w>сделать прецедентом</w> новое правило удивило многих экспертов в области права.",
                                "zh": "法院选择将这项新规则作为<w>先例</w>，这令许多法律专家感到惊讶。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить примером или оправданием для будущего действия.",
                        "zh": "作为未来行动的例子或正当理由。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "создавать прецедент",
                                "target_lang_sense_clarification": "становиться образцом для будущего"
                            },
                            {
                                "target_lang_word": "служить примером",
                                "target_lang_sense_clarification": "обосновывать будущие действия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开创先例",
                                "target_lang_sense_clarification": "成为未来的榜样"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}