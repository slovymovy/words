                    "frequency": "Low",
                    "semantic_group_id": "mnożenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przedsiębiorca konsekwentnie <w>rozmnażał</w> swój majątek przez mądre inwestycje giełdowe.",
                            "target_lang_translations": {
                                "en": "The entrepreneur consistently <w>multiplied</w> his wealth through wise stock market investments."
                            }
                        },
                        {
                            "text": "Nie powinniśmy bez potrzeby <w>rozmnażać</w> dodatkowych trudności w tym projekcie.",
                            "target_lang_translations": {
