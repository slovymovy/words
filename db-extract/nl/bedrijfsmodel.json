                        "entry_id": "f4988d4c-ba85-3c56-a9a7-dfd83b0cfb48",
                        "glosses": [
                            "model dat gebruikt wordt om diverse bedrijfsaspecten in kaart te brengen en te beheren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08d16ec-495e-4bf1-8b82-8d74a6cb02e2",
                                "sense_id": "19134560-e9d6-3404-a243-0aaae2413b62",
                                "text": "De vervalsing werd ontdekt nadat foto's op internet waren gezet. Het museum werd daarna door Chinese internetters bespot. Zo werd voorgesteld het bedrijfsmodel radicaal om te gooien en er een nepkunstmuseum van te maken. Uiteindelijk besloten de Chinese autoriteiten in te grijpen."
                            },
                            {
                                "example_id": "0ef07ff7-5961-411f-8aa9-2b0501a2c083",
                                "sense_id": "19134560-e9d6-3404-a243-0aaae2413b62",
                                "text": "De Duitse minister van Financiën Schäuble zegt dat het onzeker is of de twee grootste banken op Cyprus toekomst hebben. Tegen de zender ZDF zei hij dat het bedrijfsmodel van de banken niet langer houdbaar is."
                            }
                        ]
                    }
