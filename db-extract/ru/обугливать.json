                                        "sense_id": "21829442-7d37-3f13-9433-ca1a3b2a75da",
                                        "entry_id": "26c8defd-ce2f-3b9a-b1a7-40bcd0898c8c",
                                        "glosses": [
                                            "Faire éprouver une violente action du feu à quelque chose."
