                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039fd11e-5000-405a-bf79-938e7a607f32",
                                "sense_id": "ba6ab910-badc-3a2e-b451-00476503d8a0",
                                "text": "Pochodził z jakiejś lichej mieściny na Podolu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0ee3cd78-fea2-3c6a-ac75-bb27601b1cec",
                        "entry_id": "823aa227-a520-31ec-a058-308a2390177f",
                        "glosses": [
                            "mieszkańcy małego miasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05263b64-de17-4eca-a7b6-3835b26818ec",
                                "sense_id": "0ee3cd78-fea2-3c6a-ac75-bb27601b1cec",
                                "text": "Cała mieścina zebrała się u wrót meczetu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ab58006-5324-49de-ad86-486c78e1d26e",
                        "source_entry_id": "823aa227-a520-31ec-a058-308a2390177f",
                        "source_sense_id": "ba6ab910-badc-3a2e-b451-00476503d8a0",
                        "target_lang_word": "backwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21d65a62-cdfa-34d5-9760-814f25ad7bd7",
                                        "entry_id": "ed95764f-4c6b-39b8-add6-77bb260cae98",
                                        "glosses": [
                                            "The water held back by a dam or other obstruction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6799572-5dbb-4864-a19f-af6f7d91c6fb",
                                                "sense_id": "21d65a62-cdfa-34d5-9760-814f25ad7bd7",
                                                "text": "[…] The backwater separates the main line from Hinksey marshalling yards"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                        "entry_id": "ed95764f-4c6b-39b8-add6-77bb260cae98",
                                        "glosses": [
                                            "A remote place: somewhere that remains unaffected by new events, progresses, ideas, etc; any field of endeavor that figuratively resembles such a place."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f467ff-62ba-45da-bf6f-11185c0c1333",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "Near-synonyms: (place) jerkwater town, one-horse town, Podunk; see also Thesaurus:remote place"
                                            },
                                            {
                                                "example_id": "4fcf24e4-e291-46d5-b603-99b7773e854d",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "an academic backwater"
                                            },
                                            {
                                                "example_id": "2c25a8a9-3ed7-4125-a269-906469e936ae",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "Usually, however, this line, which once had a monopoly of all the traffic to Bournemouth, is a quiet backwater carrying a purely local traffic."
                                            },
                                            {
                                                "example_id": "326bb0ee-3387-42c7-a9e5-2ed798ba772d",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "It's a volume for those who delight in exploring the backwaters of nineteenth-century opera."
                                            },
                                            {
                                                "example_id": "258e0f75-7b08-4e17-ba77-8286db822611",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "Far out in the uncharted backwaters of the unfashionable end of the Western Spiral arm of the Galaxy lies a small unregarded yellow sun."
                                            },
                                            {
                                                "example_id": "fd756858-2b54-4974-98e5-226b1e61d32d",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "What was once the industrial heart of Uruguay is now a quiet riverside backwater where nothing much happens—the shops don't bother to open until midday and not at all if it's raining."
                                            },
                                            {
                                                "example_id": "5576c5b3-368f-4384-85b1-e88bf19d4059",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "In the 19th century silt deposits began to block the harbour, and the city began to decline. To make matters worse, conservative elements in Lukang refused in the early 20th century to allow trains and modern highways to be built near their city. Lukang became a backwater, only to be reborn decades later when modern Taiwanese began to search for a living connection with the past."
                                            },
                                            {
                                                "example_id": "16bb4921-b472-474c-85ad-14b8fb70de48",
                                                "sense_id": "0990c82c-d4ab-3a8f-82ca-5a110036b808",
                                                "text": "The Hope Valley, while scenic, is no quiet backwater. There's no sign it will ever be one either."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bb50331-ef74-35ba-b8a1-b25c82364b1e",
                                        "entry_id": "ed95764f-4c6b-39b8-add6-77bb260cae98",
                                        "glosses": [
                                            "A rowing stroke in which the oar is pushed forward to stop the boat; see back water"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ebf83f1-f29e-3704-bbf6-95ad54603b11",
                                        "entry_id": "ed95764f-4c6b-39b8-add6-77bb260cae98",
                                        "glosses": [
                                            "Water used in the papermaking process. Recycled to reduce usage of fresh water, and usually containing residual amounts of chemicals and fibres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70759c2a-669e-4f96-8d5d-2df5602fdb79",
                                                "sense_id": "3ebf83f1-f29e-3704-bbf6-95ad54603b11",
                                                "text": "The back-water (overflow) can be used for \"thinning down\" the chests when emptying. If \"Wastive\" does this, his mind will be at ease regarding waste of pulp, and his machine-men will be happy and do their work much better than by trying to use all the back-water on the paper machine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55035e36-0647-3226-91b3-73b45cec7e2d",
                                        "entry_id": "d22f6be3-8a74-31be-8188-2adb77e299ec",
                                        "glosses": [
                                            "To row or paddle a backwater stroke."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f6e34e7-3693-30ec-8641-5bb45ad3c5ae",
                                        "entry_id": "d22f6be3-8a74-31be-8188-2adb77e299ec",
                                        "glosses": [
                                            "To vacillate on a long-held position."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c3aab4c-3a55-43ad-802f-e602d8db8d30",
                        "source_entry_id": "823aa227-a520-31ec-a058-308a2390177f",
                        "source_sense_id": "ba6ab910-badc-3a2e-b451-00476503d8a0",
                        "target_lang_word": "one-horse town",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one-horse town",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb391b1d-f26f-3b97-b2f3-66f6e35c613b",
                                        "entry_id": "1d98c6ad-adc8-35c7-82c5-2ab0a8437b61",
                                        "glosses": [
                                            "A very small town, especially one of a rural nature and/or offering very few or no attractions."
                                        ],
                                        "tags": [
                                            "US",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aceee78-032f-483c-8285-c4a13e636384",
                                                "sense_id": "bb391b1d-f26f-3b97-b2f3-66f6e35c613b",
                                                "text": "It's surrounded by beautiful wilderness, but otherwise it's just a one-horse town."
                                            },
                                            {
                                                "example_id": "f28a125d-f067-443d-bced-88dff1db3d68",
                                                "sense_id": "bb391b1d-f26f-3b97-b2f3-66f6e35c613b",
                                                "text": "The journey took 48 hours with a stopover in a Bates-style motel in the one-horse town of Marblemount – the last services for 70 wild miles of boscage and bears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
