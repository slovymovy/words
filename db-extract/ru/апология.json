                                    {
                                        "sense_id": "50c036a4-6967-32d2-9402-0c53f4341aa4",
                                        "entry_id": "d13a6025-c48f-3390-89aa-1c56ee63608e",
                                        "glosses": [
                                            "Äußerung des Bedauerns über einen eigenen Fehler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ff55daf-353e-46e6-a978-8661cb3254b9",
                                                "sense_id": "50c036a4-6967-32d2-9402-0c53f4341aa4",
                                                "text": "Sie hat meine Entschuldigung nicht akzeptiert."
                                            },
                                            {
                                                "example_id": "7b57e24d-ca4f-4f3b-b345-e7f901541768",
                                                "sense_id": "50c036a4-6967-32d2-9402-0c53f4341aa4",
                                                "text": "Was soll ich mehr tun, als um Entschuldigung bitten."
                                            },
                                            {
                                                "example_id": "dff99914-907b-475d-a028-67668b9bd9d4",
                                                "sense_id": "50c036a4-6967-32d2-9402-0c53f4341aa4",
                                                "text": "„Auch keine Silbe von Entschuldigung war dem armen, sich am Boden krümmenden Mädchen entfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f00660bd-3193-3c72-a4f5-e235c52c54e5",
                                        "entry_id": "d13a6025-c48f-3390-89aa-1c56ee63608e",
                                        "glosses": [
                                            "Befreiung vom Vorwurf der Schuld"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a609dbf1-3acb-42c2-a8d1-b7a9bfe7b5cd",
                                                "sense_id": "f00660bd-3193-3c72-a4f5-e235c52c54e5",
                                                "text": "Für dieses Verhalten gibt es keine Entschuldigung!"
                                            },
                                            {
                                                "example_id": "15554001-0062-4b23-a319-e21057892177",
                                                "sense_id": "f00660bd-3193-3c72-a4f5-e235c52c54e5",
                                                "text": "Wenn ich eine Entschuldigung hätte, so würde ich sie jetzt vorbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Entschuldigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8331914-51fa-3632-b3f6-486714271469",
                                        "entry_id": "1b17639a-5cc6-3c75-947f-9b3a407084c3",
                                        "glosses": [
                                            "Wort, das man beim Bedauern eines eigenen Fehlers sagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e3e5550-62e1-4793-838d-965323628877",
                                                "sense_id": "f8331914-51fa-3632-b3f6-486714271469",
                                                "text": "Entschuldigung. Ich wollte dich nicht verletzen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "accefe60-58d7-3464-99dc-d356cd7b02bf",
                                        "entry_id": "1b17639a-5cc6-3c75-947f-9b3a407084c3",
                                        "glosses": [
                                            "Einleitungswort, das man benutzt, wenn man Unbekannte anspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c9c219-0bb8-45c9-8f9d-ad12a1ff5fe8",
                                                "sense_id": "accefe60-58d7-3464-99dc-d356cd7b02bf",
                                                "text": "Entschuldigung! Könnten Sie mir hier kurz behilflich sein?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a26ba342-b595-4ea4-a44c-8d873a4217fa",
                        "source_entry_id": "f9b45dcc-fd2f-31ef-be2d-4754e32ed81e",
