    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0fa24371-151c-3bdc-841f-b09f8690d498",
                    "sense_definition": "Se réunir, se serrer étroitement en un groupe ou une masse compacte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regroupement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'ouverture des portes, les spectateurs ont commencé à s'<w>agglutiner</w> devant la scène."
                        },
                        {
                            "text": "Les enfants curieux s'<w>agglutinent</w> autour du prestidigitateur pour découvrir le secret de son tour."
                        }
                    ],
                    "synonyms": [
                        "s'amasser",
                        "s'attrouper",
                        "s'entasser"
                    ],
                    "antonyms": [
                        "s'éparpiller",
                        "se disperser"
                    ]
                },
                {
                    "sense_id": "62154987-3233-3abc-b486-1c9e65d70789",
                    "sense_definition": "Unir ou coller ensemble des éléments ou des substances pour former un tout compact.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité excessive finit par <w>agglutiner</w> la farine au fond du récipient."
                        },
                        {
                            "text": "Le froid intense a fait <w>agglutiner</w> les particules de neige le long des vitres."
                        }
                    ],
                    "synonyms": [
                        "agglomérer",
                        "amalgamer",
                        "coller"
                    ],
                    "antonyms": [
                        "désagréger",
                        "dissocier",
                        "séparer"
                    ],
                    "common_phrases": [
                        "agglutiner des particules"
                    ]
                },
                {
                    "sense_id": "9027b967-b973-3ced-9c96-1b86fca76939",
                    "sense_definition": "Réunir des éléments morphologiques distincts au sein d'un même mot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette langue particulière a tendance à <w>agglutiner</w> plusieurs suffixes à la racine verbale."
                        },
                        {
                            "text": "Certains dialectes anciens préfèrent <w>agglutiner</w> les pronoms directement à la fin du verbe."
                        }
                    ],
                    "synonyms": [
                        "accoler"
                    ]
                }
            ]
        }
    ]
