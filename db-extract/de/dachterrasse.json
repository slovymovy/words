                "senses": [
                    {
                        "sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                        "entry_id": "b4ef7009-a99c-3a4d-9be8-ff011bc95457",
                        "glosses": [
                            "freie Fläche auf dem Dach, die als Terrasse genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7515ec2b-d99e-4ed9-a3b6-68aa9c1bb7be",
                                "sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                                "text": "„Eine Dachterrasse ist vor allem dort interessant, wo der Freiraum begrenzt ist, also in Städten.“"
                            },
                            {
                                "example_id": "a7006148-7c57-41ff-93a1-e4ffa3f9f09a",
                                "sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                                "text": "„Mit der Flasche in der Hand stieg er die steile Treppe zur Dachterrasse hinauf.“"
                            },
                            {
                                "example_id": "af81753c-d008-45ec-9c22-75859e5ae867",
                                "sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                                "text": "„In der Hotellobby schlägt Vicky einen Absacker auf der Dachterrasse vor.“"
                            },
                            {
                                "example_id": "443250a6-313c-4090-bc2f-a4610a684a6c",
                                "sense_id": "dc8a3cfb-0866-3c59-9832-edff986805a3",
                                "text": "„Vorsichtig trat er auf die Dachterrasse, in die kalte Morgenluft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
