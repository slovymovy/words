                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷文",
                                "target_lang_sense_clarification": "地名"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Raven",
                                "target_lang_sense_clarification": "topónimo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "39df9db5-4c10-34de-a250-a713504ef6e3",
                    "sense_definition": "Having the glossy black color of a raven; jet-black.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The princess was famous for her pale skin and long <w>raven</w> hair.",
                            "target_lang_translations": {
                                "ru": "Принцесса славилась своей бледной кожей и длинными волосами <w>цвета воронова крыла</w>.",
                                "zh": "公主以她苍白的皮肤和一头长长的<w>乌黑</w>秀发而闻名。",
                                "es": "La princesa era famosa por su piel pálida y su largo cabello <w>negro azabache</w>."
                            }
                        },
                        {
                            "text": "He stared into the <w>raven</w> darkness of the cave.",
                            "target_lang_translations": {
                                "ru": "Он вглядывался в <w>иссиня-черную</w> тьму пещеры.",
                                "zh": "他凝视着洞穴中<w>漆黑</w>的黑暗。",
                                "es": "Él miró fijamente hacia la <w>negra</w> oscuridad de la cueva."
                            }
                        }
                    ],
                    "synonyms": [
                        "jet-black",
                        "ebony",
                        "pitch-black"
                    ],
                    "antonyms": [
                        "snow-white",
                        "blond"
                    ],
                    "common_phrases": [
                        "raven hair",
                        "raven locks",
                        "raven curls"
                    ],
                    "traits": [
