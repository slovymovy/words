                "senses": [
                    {
                        "sense_id": "fb8c15af-29c4-3bd6-908f-3575c84faf9a",
                        "entry_id": "49980116-ab13-3551-bb3b-d12eebe90b9e",
                        "glosses": [
                            "iemand die mensen bang probeert te maken zonder dat er een goede reden voor angst is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f7c7f14-6be7-420d-9ad1-8e5e268ccc79",
                                "sense_id": "fb8c15af-29c4-3bd6-908f-3575c84faf9a",
                                "text": "‘Ik geloof niet dat Noord-Korea technisch ooit sterk genoeg wordt voor een aanval op Amerikaans grondgebied. Nu ja, wie weet, Guam of Alaska. Zelfs dan zouden ze het bijzonder goed moeten voorbereiden. Een impulsief afgevuurde raket zie ik nooit de VS bereiken, nu niet en morgen niet. En dus zouden de paniekzaaiers beter wat gas terugnemen.’"
                            },
                            {
                                "example_id": "44b868e7-0e9f-4b65-9870-90d7d4c48f51",
                                "sense_id": "fb8c15af-29c4-3bd6-908f-3575c84faf9a",
                                "text": "Overstromingen, tropische cyclonen, verzengende droogte, immense bosbranden: het lijkt erop dat Australië de afgelopen jaren steeds vaker ten prooi viel aan grootschalige natuurrampen. Maar wie die hardop in verband wilde brengen met het fenomeen klimaatverandering, werd doorgaans weggezet als paniekzaaier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8f1e984-7654-4f76-af0c-494757150a57",
                        "source_entry_id": "49980116-ab13-3551-bb3b-d12eebe90b9e",
                        "source_sense_id": "fb8c15af-29c4-3bd6-908f-3575c84faf9a",
                        "source_sense_description": "iemand die, zonder dat daar een goede reden voor is, mensen bang probeert te maken",
                        "target_lang_word": "scaremonger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scaremonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e170948-d1ad-3591-9711-4b3b8c9d788a",
                                        "entry_id": "ee0dcfa8-8025-3467-ad39-face8bc66059",
                                        "glosses": [
                                            "Someone who spreads worrying rumours or needlessly alarms people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfcb65b-8c98-418b-9bc2-af581168b41f",
                                                "sense_id": "1e170948-d1ad-3591-9711-4b3b8c9d788a",
                                                "text": "I have refrained from giving actual names and dates, for obvious reasons, and have therefore been compelled, even at the risk of being again denounced as a scaremonger, to present the facts in the form of fiction—fiction which, I trust, will point its own patriotic moral."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scaremonger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dba3683-48de-39fe-80da-9d98f4e8d247",
                                        "entry_id": "89936a4a-ecaa-3ec2-b356-effa78e4c52c",
                                        "glosses": [
                                            "To spread worrying rumours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7804fa0-63a7-4875-8581-2e89d3b5c2ef",
                                                "sense_id": "6dba3683-48de-39fe-80da-9d98f4e8d247",
                                                "text": "We're not scaremongering / This is really happening, happening"
                                            },
                                            {
                                                "example_id": "150867d9-f6f7-48bc-b397-e9e27d02e6df",
                                                "sense_id": "6dba3683-48de-39fe-80da-9d98f4e8d247",
                                                "text": "If no new cases come from the Buff Club exposure site, it will be hard to believe politicians scaremongering that the delta variant is so infectious that all you have to do is walk past an infected person to get it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
