                "senses": [
                    {
                        "sense_id": "a95ccc72-446c-380d-8c32-e00736efe9e6",
                        "entry_id": "a1133b04-894a-3aa6-beb3-31735f3fe119",
                        "glosses": [
                            "Werkzeug zum Öffnen oder Schließen eines Bohrfutters, damit der Bohrer entnommen oder festgespannt werden kann"
                        ],
                        "tags": [
                            "Werkzeugkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "537ac6fb-1031-44c2-9187-90439841b850",
                                "sense_id": "a95ccc72-446c-380d-8c32-e00736efe9e6",
                                "text": "„Sie stand auf und reichte ihm den Bohrfutterschlüssel aus der Kiste. Carlotta kannte sich aus, im Zirkus wurde schließlich ständig auf- und abgebaut.“"
                            },
                            {
                                "example_id": "b5f65b03-1198-4ccc-9b9c-2e7b8f467efc",
                                "sense_id": "a95ccc72-446c-380d-8c32-e00736efe9e6",
                                "text": "„Ein junger Mann in Jeans und T-Shirt steht vor einem Fenster. In der rechten Hand hält er eine Bohrmaschine, in der linken den Bohrfutterschlüssel, der zwischen Mittelfinger und Daumen geklemmt ist.“"
                            },
                            {
                                "example_id": "d0f9c6a7-dae6-4b6b-a530-3418e3d05ed0",
                                "sense_id": "a95ccc72-446c-380d-8c32-e00736efe9e6",
                                "text": "„Nun, die Natur verabscheut viele Dinge, zum Beispiel Vakua, angeblich unsinkbare Schiffe namens Titanic und insbesondere Bohrfutterschlüssel für elektrische Bohrmaschinen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
