                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356c05ad-2a6f-4046-98f1-a0cc2fedd81c",
                                                "sense_id": "ede00b62-3666-3450-b73a-d6c29fafd953",
                                                "text": "„Weil sie die Ehre der Familie befleckt habe, wurde eine junge Frau gemeinschaftlich von ihrem Ehemann und von ihrem Vater getötet, so lautet die Anklage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
