                                            {
                                                "example_id": "f7938dcb-c8d6-481c-a3bf-b37867d0cc08",
                                                "sense_id": "0d07abbd-c9a9-3506-a106-20d778bc59d2",
                                                "text": "De koude berglucht had de lente op deze hoogte wat vertraagd, maar door de warmte liepen nu ook de bergbloemen allemaal uit."
                                            }
                                        ]
                                    }
                                ]
                            }
