{
    "word_family": [
        "koczek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e898a28-9e7b-3e30-9de3-f10e56c0ba7a",
                    "sense_definition": "fryzura damska polegająca na zwinięciu i upięciu długich włosów w węzeł na czubku lub z tyłu głowy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fryzura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wielkim wyjściem elegancko upięła swoje długie włosy w wysoki <w>kok</w>.",
                            "target_lang_translations": {
                                "ru": "Перед важным выходом она элегантно уложила свои длинные волосы в высокий <w>пучок</w>."
                            }
                        },
                        {
                            "text": "Kiedy miałam długie włosy, codziennie czesałam je w wygodny <w>kok</w>.",
                            "target_lang_translations": {
                                "ru": "Когда у меня были длинные волосы, я каждый день собирала их в удобный <w>пучок</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "upinać w kok",
                        "wysoki kok",
                        "fryzura w kok"
                    ],
                    "target_lang_definitions": {
                        "ru": "женская причёска, при которой длинные волосы собраны и заколоты в узел на затылке или макушке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пучок",
                                "target_lang_sense_clarification": "женская причёска из собранных волос"
                            },
                            {
                                "target_lang_word": "гулька",
                                "target_lang_sense_clarification": "разговорное обозначение пучка на голове"
                            },
                            {
                                "target_lang_word": "узел",
                                "target_lang_sense_clarification": "волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95440542-1c8f-37a0-8a94-debbb60476f0",
                    "sense_definition": "kucharz pracujący na statku lub okręcie morskim",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zawód",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Okrętowy <w>kok</w> przygotował dla całej załogi pożywny obiad w czasie sztormu.",
                            "target_lang_translations": {
                                "ru": "Корабельный <w>кок</w> приготовил для всей команды сытный обед во время шторма."
                            }
                        },
                        {
                            "text": "Marynarze często chwalili posiłki, które serwował im stary <w>kok</w>.",
                            "target_lang_translations": {
                                "ru": "Моряки часто хвалили еду, которую подавал им старый <w>кок</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kuk"
                    ],
                    "common_phrases": [
                        "okrętowy kok"
                    ],
                    "target_lang_definitions": {
                        "ru": "повар на морском или военном судне"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кок",
                                "target_lang_sense_clarification": "повар на корабле"
                            },
                            {
                                "target_lang_word": "судовой повар",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8d1e801-aaee-38f4-bf3e-1d98ad3e7196",
                    "sense_definition": "odmiana gołębia domowego charakteryzująca się jaskrawym upierzeniem",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ptak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego okazałym gołębniku można było zobaczyć rzadkiego ptaka, jakim był kolorowy <w>kok</w>.",
                            "target_lang_translations": {
                                "ru": "В его великолепной голубятне можно было увидеть редкую птицу — цветного <w>голубя-кока</w>."
                            }
                        },
                        {
                            "text": "Hodowca z dumą pokazał sędziom młodego <w>koka</w> o wyjątkowo lśniącym upierzeniu.",
                            "target_lang_translations": {
                                "ru": "Заводчик с гордостью показал судьям молодого <w>кока</w> с исключительно блестящим оперением."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "порода домашнего голубя с ярким оперением"
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "70cffae4-87fd-3699-b068-8f3aafb3e0a2",
                    "sense_definition": "dopełniacz liczby mnogiej rzeczownika <w>koka</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "forma",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Policjanci zabezpieczyli kilkanaście gramów nielegalnych liści krzewu <w>koki</w>.",
                            "target_lang_translations": {
                                "ru": "Полицейские изъяли несколько десятков граммов нелегальных листьев куста <w>коки</w>."
                            }
                        },
                        {
                            "text": "Plantacje andyjskiej <w>koki</w> rozciągały się wzdłuż całego zbocza górskiego.",
                            "target_lang_translations": {
                                "ru": "Плантации андской <w>коки</w> простирались по всему горному склону."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma gramatyczna"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "родительный падеж множественного числа от слова koka (растение кока)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кока",
                                "target_lang_sense_clarification": "в форме родительного падежа множественного числа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}