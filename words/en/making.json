                    "sense_id": "953229a6-4cbe-3be7-9ea0-f5d445cce765",
                    "sense_definition": "The act or process of forming, causing, or creating something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "creation_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>making</w> of the documentary film took over three years.",
                            "target_lang_translations": {
                                "ru": "<w>Создание</w> документального фильма заняло более трех лет.",
                                "es": "La <w>creación</w> del documental tomó más de tres años."
                            }
                        },
                        {
                            "text": "She is very skilled in the <w>making</w> of traditional jewelry.",
