                                    {
                                        "sense_id": "5d1de726-74e1-3beb-b447-31d694ae05c3",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Flat, level."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a637f209-e9c5-41ba-b85e-d840168d1770",
                                                "sense_id": "5d1de726-74e1-3beb-b447-31d694ae05c3",
                                                "text": "The crooked shall be made straight, and the rough places plain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35327cc3-d7e8-3563-8405-b7e9c94facb6",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Simple, unaltered.",
                                            "Ordinary; lacking adornment or ornamentation; unembellished."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69848dc7-9e20-4305-9556-1da5170e24d0",
                                                "sense_id": "35327cc3-d7e8-3563-8405-b7e9c94facb6",
                                                "text": "a plain tune"
                                            },
                                            {
                                                "example_id": "1e5dd9f0-a6d8-483f-bb57-b42a9adcbbea",
                                                "sense_id": "35327cc3-d7e8-3563-8405-b7e9c94facb6",
                                                "text": "He was dressed simply in plain black clothes."
                                            },
                                            {
                                                "example_id": "5da7a3a4-410e-4f74-b875-77fb5230e281",
                                                "sense_id": "35327cc3-d7e8-3563-8405-b7e9c94facb6",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone, essentially what today we might term a frameless magnifying glass or plain glass paperweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06282410-4ea8-39d9-bb85-d6fbe13edb8d",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Simple, unaltered.",
                                            "Of just one colour; lacking a pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db007657-8ee8-4691-bf37-bb8b56acde4d",
                                                "sense_id": "06282410-4ea8-39d9-bb85-d6fbe13edb8d",
                                                "text": "a plain pink polycotton skirt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1995d9-a37d-3687-a596-1c3c996a6dc2",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Simple, unaltered.",
                                            "Simple in habits or qualities; unsophisticated, not exceptional, ordinary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b69538e-27a0-4a91-8a5a-42683f4e5c26",
                                                "sense_id": "5f1995d9-a37d-3687-a596-1c3c996a6dc2",
                                                "text": "They're just plain people like you or me."
                                            },
                                            {
                                                "example_id": "73859162-bf6b-4af1-ab09-c6a9046fbf5d",
                                                "sense_id": "5f1995d9-a37d-3687-a596-1c3c996a6dc2",
                                                "text": "plain yet pious Christians"
                                            },
                                            {
                                                "example_id": "8ce23b22-0b32-4ac9-a18f-351d49f01d03",
                                                "sense_id": "5f1995d9-a37d-3687-a596-1c3c996a6dc2",
                                                "text": "the plain people"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beae925e-6bbb-35a2-8bb7-53cd7415a285",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Simple, unaltered.",
                                            "Having only few ingredients, or no additional ingredients or seasonings; not elaborate, without toppings or extras."
                                        ],
                                        "tags": [
                                            "of food"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8167cefd-21f9-454f-91cf-dc47aa38ef9d",
                                                "sense_id": "beae925e-6bbb-35a2-8bb7-53cd7415a285",
                                                "text": "Would you like a poppy bagel or a plain bagel?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ceb636-f683-3d50-91c0-a482259df068",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Simple, unaltered.",
                                            "Containing no extended or nonprinting characters (especially in plain text)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d32d1d64-1c54-343e-babb-6f4c4d0cdbd3",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Obvious.",
                                            "Evident to one's senses or reason; manifest, clear, unmistakable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cd0f7b7-f388-47fc-adcf-6df6e7130e35",
                                                "sense_id": "d32d1d64-1c54-343e-babb-6f4c4d0cdbd3",
                                                "text": "In fact, by excommunication or persuasion, by impetuosity of driving or adroitness in leading, this Abbot, it is now becoming plain everywhere, is a man that generally remains master at last."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4952e7d8-0cff-33f5-b172-9ce6c2bff802",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Obvious.",
                                            "Downright; total, unmistakable (as intensifier)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b64d0f25-c520-4e5f-9ac8-c6624262f837",
                                                "sense_id": "4952e7d8-0cff-33f5-b172-9ce6c2bff802",
                                                "text": "His answer was just plain nonsense."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a351890-d2c9-37ca-bc39-8f0ba04ecd8b",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Open.",
                                            "Honest and without deception; candid, open; blunt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbb52cd-f767-4bd9-bbfb-f4de23761e1b",
                                                "sense_id": "3a351890-d2c9-37ca-bc39-8f0ba04ecd8b",
                                                "text": "Let me be plain with you: I don't like her."
                                            },
                                            {
                                                "example_id": "5f9992ee-98b3-446e-a048-c044b44e1bf8",
                                                "sense_id": "3a351890-d2c9-37ca-bc39-8f0ba04ecd8b",
                                                "text": "[VV]e are able with playne demonſtration to proue, and vvith reaſon to perſvvade that in tymes paſt our fayth vvas alike, that then vve preached thinges correſpondent vnto the forme of faith already published of vs, ſo that none in this behalfe can repyne or gaynesay vs."
                                            },
                                            {
                                                "example_id": "080d3c4e-1ac6-4278-bf04-7976bb939043",
                                                "sense_id": "3a351890-d2c9-37ca-bc39-8f0ba04ecd8b",
                                                "text": "an honest mind, and plain, he must speak truth"
                                            },
                                            {
                                                "example_id": "1ce454be-a53d-4929-88d7-c052fd1de56f",
                                                "sense_id": "3a351890-d2c9-37ca-bc39-8f0ba04ecd8b",
                                                "text": "The Quaker was no sooner assured by this fellow of the birth and low fortune of Jones, than all compassion for him vanished; and the honest plain man went home fired with no less indignation than a duke would have felt at receiving an affront from such a person."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645f7b75-e0cb-336c-995e-37c71dc39455",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Open.",
                                            "Clear; unencumbered; equal; fair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cf35053-fcba-4ac5-8270-594ccf99b690",
                                                "sense_id": "645f7b75-e0cb-336c-995e-37c71dc39455",
                                                "text": "Our troops beat an army in plain fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a03f83-590c-3001-87c3-5184b74fd883",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Not unusually beautiful; unattractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0488c8-f60a-4194-bbc8-ac99c4081dc0",
                                                "sense_id": "e7a03f83-590c-3001-87c3-5184b74fd883",
                                                "text": "Throughout high school she worried that she had a rather plain face."
                                            },
                                            {
                                                "example_id": "154835da-9b5e-4ecc-b223-a232b9fa65ff",
                                                "sense_id": "e7a03f83-590c-3001-87c3-5184b74fd883",
                                                "text": "Yet her beauty clung to her like an identity she was trying to deny and her plainness kept slipping like a bad disguise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6126f8b0-5dac-3aab-9b7c-a19955222e57",
                                        "entry_id": "bd8b3fc6-2172-3110-8890-a5f8f67bbb1f",
                                        "glosses": [
                                            "Not a trump."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "plain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c0b96e7-35d3-3cd5-bfb6-49c6211df007",
                                        "entry_id": "bcdd2f43-e331-3cc4-91a2-8570a9d6fe23",
                                        "glosses": [
                                            "Simply."
                                        ],
                                        "tags": [
