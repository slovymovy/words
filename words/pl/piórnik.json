{
    "word_family": [
        "pióro",
        "pierzasty",
        "upierzenie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b265fae-26b2-3723-8809-cb9f03db9eaa",
                    "sense_definition": "podłużne etui lub pudełko służące do przechowywania przyborów do pisania i innych artykułów szkolnych",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "przybory_szkolne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem do szkoły włożył do <w>piórnika</w> nowy ołówek i gumkę.",
                            "target_lang_translations": {
                                "ru": "Перед выходом в школу он положил в <w>пенал</w> новый карандаш и ластик."
                            }
                        },
                        {
                            "text": "Dziewczynka rozpięła kolorowy <w>piórnik</w>, aby wyjąć z niego nożyczki i linijkę.",
                            "target_lang_translations": {
                                "ru": "Девочка расстегнула разноцветный <w>пенал</w>, чтобы достать из него ножницы и линейку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "szkolny piórnik",
                        "piórnik z wyposażeniem",
                        "schować do piórnika"
                    ],
                    "target_lang_definitions": {
                        "ru": "продолговатый футляр или коробочка для хранения письменных принадлежностей и школьных мелочей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пенал",
                                "target_lang_sense_clarification": "для ручек и карандашей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa5622de-32c6-3dff-885b-fa728d4b7e9b",
                    "sense_definition": "dawny ludowy zwyczaj wspólnego darcia pierza organizowany zimą przez kobiety i dziewczęta",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "zwyczaje_ludowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimą na wsi organizowano tradycyjny <w>piórnik</w>, podczas którego kobiety darły gęsie pióra na poduszki.",
                            "target_lang_translations": {
                                "ru": "Зимой в деревне устраивали традиционные <w>посиделки за ощипыванием перьев</w>, во время которых женщины теребили гусиные перья для подушек."
                            }
                        },
                        {
                            "text": "W trakcie wspólnego <w>piórnika</w> dziewczęta śpiewały pieśni i opowiadały rozmaite historie.",
                            "target_lang_translations": {
                                "ru": "Во время совместных <w>посиделок</w> девушки пели песни и рассказывали разные истории."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "tradycja ludowa"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "zwyczaj historyczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старинный народный обычай совместного ощипывания и теребления перьев женщинами и девушками зимними вечерами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посиделки за ощипыванием перьев",
                                "target_lang_sense_clarification": "народный обычай"
                            },
                            {
                                "target_lang_word": "супрядки",
                                "target_lang_sense_clarification": "традиционные зимние женские работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fcb50f4-9809-3133-a736-d36bd01c8347",
                    "sense_definition": "grube płótno służące jako wsypa do napełniania pierzem na poduszkę lub pierzynę",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "posciel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gospodyni nasypała świeżego puchu w uszyty z mocnego płótna <w>piórnik</w>.",
                            "target_lang_translations": {
                                "ru": "Хозяйка насыпала свежего пуха в сшитый из плотной ткани <w>наперник</w>."
                            }
                        },
                        {
                            "text": "Stary <w>piórnik</w> przetarł się w kilku miejscach i drobne pióra uciekały z pościeli.",
                            "target_lang_translations": {
                                "ru": "Старый <w>наперник</w> протёрся в нескольких местах, и мелкие перья вылезали из постели."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Warmia i Mazury"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "плотная ткань, наперник для набивания пером подушки или перины"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наперник",
                                "target_lang_sense_clarification": "чехол для перьевой подушки"
                            },
                            {
                                "target_lang_word": "перина",
                                "target_lang_sense_clarification": "чехол или чехол перины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "098a2190-532d-328b-8d64-6994de82e9ad",
                    "sense_definition": "przyrząd z ząbkami używany do rozczesywania lub układania włosów",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fryzjerstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mężczyzna wyciągnął kieszonkowy <w>piórnik</w>, żeby szybko poprawić potarganą fryzurę.",
                            "target_lang_translations": {
                                "ru": "Мужчина достал карманный <w>гребень</w>, чтобы быстро поправить растрёпанную причёску."
                            }
                        },
                        {
                            "text": "Na toaletce leżał drewniany <w>piórnik</w> z gęsto osadzonymi ząbkami.",
                            "target_lang_translations": {
                                "ru": "На туалетном столике лежал деревянный <w>гребень</w> с частыми зубьями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "użycie gwarowe lub przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "зубчатый предмет для расчесывания и укладки волос"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребень",
                                "target_lang_sense_clarification": "для расчесывания волос"
                            },
                            {
                                "target_lang_word": "расческа",
                                "target_lang_sense_clarification": "предмет туалета"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c55f4692-109b-39e7-943e-105e3372f0fb",
                    "sense_definition": "osoba postępująca nierozsądnie, naiwnie lub niemądrze",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wyzwiska",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten naiwny <w>piórnik</w> znowu dał się oszukać w ten sam sposób.",
                            "target_lang_translations": {
                                "ru": "Этот наивный <w>простак</w> снова дал себя обмануть тем же способом."
                            }
                        },
                        {
                            "text": "Nie słuchaj tego <w>piórnika</w>, bo on nie ma pojęcia o naszej pracy.",
                            "target_lang_translations": {
                                "ru": "Не слушай этого <w>болвана</w>, ведь он понятия не имеет о нашей работе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "użycie potoczne lub gwarowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, поступающий глупо, неразумно или наивно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "простак",
                                "target_lang_sense_clarification": "наивный человек"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "бранное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8321a3e6-da1a-30c4-b738-a3eacc21f876",
                    "sense_definition": "skrzynia przeznaczona do pochówku ciała zmarłego",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pochowek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W starym żargonie grabarzy drewniana trumna bywała nazywana <w>piórnikiem</w>.",
                            "target_lang_translations": {
                                "ru": "В старом жаргоне могильщиков деревянный гроб порой называли <w>пеналом</w>."
                            }
                        },
                        {
                            "text": "Zanim złożono ciało do grobu, zamknięto dębowy <w>piórnik</w>.",
                            "target_lang_translations": {
                                "ru": "Прежде чем тело предали земле, закрыли дубовый <w>гроб</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "żargonowe lub środowiskowe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "ящик для погребения умершего; гроб на жаргоне"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гроб",
                                "target_lang_sense_clarification": "ящик для захоронения"
                            },
                            {
                                "target_lang_word": "деревянный макинтош",
                                "target_lang_sense_clarification": "жаргонное название гроба"
                            },
                            {
                                "target_lang_word": "ящик",
                                "target_lang_sense_clarification": "жаргонное о гробе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}