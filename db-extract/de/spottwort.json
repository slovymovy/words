                "senses": [
                    {
                        "sense_id": "1fbd36d4-f21d-33d5-8133-744847f7c113",
                        "entry_id": "fe16b1ee-26c6-33bf-ba72-63d1dd9f9c65",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person mit Spott bedacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461b7caf-68d4-48ac-af52-8bef826524d9",
                                "sense_id": "1fbd36d4-f21d-33d5-8133-744847f7c113",
                                "text": "„Dichteritis, dieses volksetymologische Spottwort, das mit Anklang an Diphtheritis das Dichten kleinerer Geister als eine Art Krankheit kennzeichnet…“"
                            },
                            {
                                "example_id": "415c0c3a-7f39-4687-a732-96d133b50775",
                                "sense_id": "1fbd36d4-f21d-33d5-8133-744847f7c113",
                                "text": "Ein in der politischen Auseinandersetzung bekannt gewordenes Spottwort ist der Ausdruck „Nordlichter“, den Franz Josef Strauß gegenüber norddeutschen Politikern der Union verwendet hat."
                            },
                            {
                                "example_id": "69f90b3f-3222-4580-a946-3b7449eb970b",
                                "sense_id": "1fbd36d4-f21d-33d5-8133-744847f7c113",
                                "text": "„Es handelt sich dabei um ein kaum bekanntes, in Eisenbahnerkreisen geprägtes, mildes Spottwort für Hobbyeisenbahner, die in ihrer Freizeit Kursbücher studieren, Fahrpläne rekonstruieren oder mit elektrischen Miniatureisenbahnen spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
