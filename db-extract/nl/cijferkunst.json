                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arithmetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
