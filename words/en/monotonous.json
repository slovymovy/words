    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f08d4bba-2173-38c8-b47e-bede99ac35db",
                    "sense_definition": "Having an unvarying pitch or tone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker delivered a <w>monotonous</w> speech that put half the audience to sleep.",
                            "target_lang_translations": {
                                "ru": "Оратор произнес <w>моното́нную</w> речь, от которой половина аудитории уснула."
                            }
                        },
                        {
                            "text": "He spoke in a <w>monotonous</w> voice that lacked any emotional expression.",
                            "target_lang_translations": {
                                "ru": "Он говорил <w>моното́нным</w> голосом, в котором не было никакой эмоциональной окраски."
                            }
                        }
                    ],
                    "synonyms": [
                        "unvarying"
                    ],
                    "common_phrases": [
                        "monotonous voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий неизменяемую высоту или тембр звука."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "моното́нный",
                                "target_lang_sense_clarification": "о звуке или речи, лишенной интонационного разнообразия"
                            },
                            {
                                "target_lang_word": "одното́нный",
                                "target_lang_sense_clarification": "звучащий на одной ноте"
                            },
                            {
                                "target_lang_word": "однозву́чный",
                                "target_lang_sense_clarification": "звучащий однообразно, без перепадов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a443ef33-cfeb-377c-8f05-a68fa0e1fae2",
                    "sense_definition": "Tedious, repetitious, or lacking in variety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boredom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>monotonous</w> task of sorting files became very boring after a few hours.",
                            "target_lang_translations": {
                                "ru": "<w>Однообра́зная</w> работа по сортировке файлов стала очень скучной через несколько часов."
                            }
                        },
                        {
                            "text": "She found the <w>monotonous</w> routine of her daily commute quite draining.",
                            "target_lang_translations": {
                                "ru": "Она находила <w>однообра́зную</w> рутину своих ежедневных поездок на работу довольно изматывающей."
                            }
                        }
                    ],
                    "synonyms": [
                        "tedious",
                        "repetitive",
                        "tiresome"
                    ],
                    "antonyms": [
                        "various"
                    ],
                    "common_phrases": [
                        "monotonous routine",
                        "monotonous task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Утомительный, повторяющийся или лишенный разнообразия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "однообра́зный",
                                "target_lang_sense_clarification": "лишенный разнообразия, скучный из-за повторяемости"
                            },
                            {
                                "target_lang_word": "моното́нный",
                                "target_lang_sense_clarification": "скучный из-за отсутствия перемен"
                            },
                            {
                                "target_lang_word": "ску́чный",
                                "target_lang_sense_clarification": "вызывающий скуку из-за рутины"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}