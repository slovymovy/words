                    "frequency": "Middle",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Puisque le bus est annulé, <w>autant</w> rentrer chez nous à pied dès maintenant."
                        },
                        {
                            "text": "Si le spectacle commence en retard, <w>autant</w> prendre un café en attendant."
