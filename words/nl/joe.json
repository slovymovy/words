                {
                    "sense_id": "70b9fc47-77bd-30f4-8ee3-452078670117",
                    "sense_definition": "Een informele groet die wordt gebruikt bij het weggaan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting_farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was erg gezellig, tot de volgende keer, <w>joe</w>!",
                            "target_lang_translations": {
                                "ru": "Было очень здорово, до следующего раза, <w>пока</w>!",
                                "en": "It was really nice, see you next time, <w>bye</w>!",
                                "pl": "Było bardzo miło, do następnego razu, <w>pa</w>!",
                                "de": "Es war sehr schön, bis zum nächsten Mal, <w>tschüss</w>!",
                                "fr": "C'était très sympa, à la prochaine, <w>salut</w> !",
                                "it": "È stato molto piacevole, alla prossima, <w>ciao</w>!",
                                "cs": "Bylo to moc fajn, tak zase příště, <w>ahoj</w>!",
                                "tr": "Çok keyifliydi, bir dahaki sefere görüşmek üzere, <w>bay bay</w>!",
                                "es": "Fue muy agradable, hasta la próxima, ¡<w>chao</w>!",
                                "zh": "玩得很开心，下次见，<w>拜拜</w>！"
                            }
                        },
                        {
                            "text": "Ik ga er vandoor, <w>joe</w>!",
                            "target_lang_translations": {
                                "ru": "Я пошел, <w>давай</w>!",
                                "en": "I'm off, <w>see ya</w>!",
                                "pl": "Ja już lecę, <w>na razie</w>!",
                                "de": "Ich mache mich vom Acker, <w>ciao</w>!",
                                "fr": "J'y vais, <w>tchao</w> !",
                                "it": "Io vado, <w>ciao</w>!",
                                "cs": "Už musím jít, <w>čau</w>!",
                                "tr": "Ben kaçtım, <w>hadi eyvallah</w>!",
                                "es": "Me voy, ¡<w>adiós</w>!",
                                "zh": "我先走了，<w>再见</w>！"
                            }
                        }
                    ],
                    "synonyms": [
                        "doei",
                        "dag",
                        "aju",
                        "later",
                        "doeg",
                        "de groeten"
                    ],
                    "antonyms": [
                        "hallo",
