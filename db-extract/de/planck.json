                ],
                "senses": [
                    {
                        "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                        "entry_id": "e1c6d02e-0e20-36fd-9240-5327dd897bcf",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf183bf-45cd-46df-8a34-a493c0f90d81",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Frau Planck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "661f7e02-ff21-40fc-9afe-fd9c4a20a627",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Herr Planck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8c076717-6cc4-48f5-9ebb-08944129c0dc",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Die Plancks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "acbd9f3a-efac-495d-8993-99484be0d746",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Der Planck trägt nie die Schals, die die Planck ihm strickt."
                            },
                            {
                                "example_id": "b4cf242c-1c80-44c8-810a-58b797445f4f",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Planck kommt, geht der Herr Planck.“"
                            },
                            {
                                "example_id": "524f8e22-678a-4867-b314-93273a45b3ae",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Planck kommt und geht."
                            },
                            {
                                "example_id": "aa4c5c6c-01fd-4b36-a89a-a48cf8a68c5f",
                                "sense_id": "c0448e4d-1744-3f1e-b444-982372793d8b",
                                "text": "Plancks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
