                                        "entry_id": "e27fabe5-2597-3363-8ffd-eee78c34c1c0",
                                        "glosses": [
                                            "The action of asking questions; a survey; an inquiry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
