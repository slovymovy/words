                        "examples": [
                            {
                                "example_id": "22193e22-37a9-47e3-abc8-f6cc3d356917",
                                "sense_id": "eb9afeab-49b5-3157-9736-faa38c109057",
                                "text": "Cette pèlerine délavée a une poche profonde : tante Clara y rangeait son tricot, du temps qu’elle aussi, dans un « jouquet » solitaire, guettait les palombes."
                            },
                            {
                                "example_id": "949e7e51-fc1e-4585-8881-3b4575a5a8d4",
                                "sense_id": "eb9afeab-49b5-3157-9736-faa38c109057",
                                "text": "L'armoire s'est transformée en jouquet – cette cabane que les chasseurs de palombes construisent sur un pylône ou au sommet d'un chêne ou d'un hêtre, en l'étayant d'une solide fourche constituée de branches, pour servir de poste de guet et de tir."
                            }
                        ]
