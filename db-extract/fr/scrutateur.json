                    {
                        "sense_id": "fb88948a-c776-37e0-a1fa-e7cea23aa547",
                        "entry_id": "04d2c98a-3561-3a72-ba7e-d7d3c02f0778",
                        "glosses": [
                            "Celui qui scrute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36316b96-ac47-4757-8bd2-38d846a29d97",
                                "sense_id": "fb88948a-c776-37e0-a1fa-e7cea23aa547",
                                "text": "Un sage scrutateur de la nature, des secrets de la nature. - Dieu est le scrutateur des cœurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "87c65d2e-fc8f-3b98-9cf4-c8568879bac4",
                        "entry_id": "04d2c98a-3561-3a72-ba7e-d7d3c02f0778",
                        "glosses": [
                            "Personne désignée pour prendre part à l'organisation du scrutin, à sa vérification et à son dépouillement."
                        ],
                        "tags": [
                            "Élection"
                        ],
                        "examples": [
                            {
                                "example_id": "60028f85-6a62-45a6-a55f-bd5d39d5844b",
                                "sense_id": "87c65d2e-fc8f-3b98-9cf4-c8568879bac4",
                                "text": "A chaque table, l'un des scrutateurs extrait le bulletin de chaque enveloppe et le passe déplié à un autre scrutateur ; celui-ci le lit à haute voix ; les noms portés sur les bulletins sont relevés par deux scrutateurs au moins sur des listes préparées à cet effet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8e40eec-01d2-4ed5-8042-34cac6f7d384",
                        "source_entry_id": "04d2c98a-3561-3a72-ba7e-d7d3c02f0778",
                        "source_sense_id": "fb88948a-c776-37e0-a1fa-e7cea23aa547",
                        "target_lang_word": "scrutinizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrutinizer",
