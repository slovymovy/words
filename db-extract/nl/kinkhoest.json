                                    {
                                        "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                        "entry_id": "4af69faf-a46d-3393-a057-9613976dc480",
                                        "glosses": [
                                            "bakterielle Infektionskrankheit, die starke Hustenanfälle verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df193182-9a4f-43ad-9953-996aebb3be52",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "Für Säuglinge kann Keuchhusten lebensbedrohlich sein."
                                            },
                                            {
                                                "example_id": "aad753e2-b4a7-4a87-b609-fc61acd82e04",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Nur, mit ihrem eigenen Glauben daran schien es nicht gar so weit her zu sein, denn sie bekamen Masern, Keuchhusten und Windpocken.“"
                                            },
                                            {
                                                "example_id": "aee11c85-ece7-43d1-b15e-42a45b5c1fe9",
                                                "sense_id": "4e920a44-1c34-3a14-a678-8b33f9e317ba",
                                                "text": "„Die drei Kinder hatten Keuchhusten und konnten ihn nicht loswerden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "477758f1-2be5-4fb6-abe4-5f469a4028d2",
                        "source_entry_id": "2f7a3197-089e-33ab-8403-33dffe6c6379",
                        "source_sense_id": "5aaf6c8f-72f3-3900-89ef-f5796a919dd6",
                        "source_sense_description": "een bepaalde kinderziekte die veroorzaakt wordt door de bacterie Bordetella pertussis",
                        "target_lang_word": "pertussis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pertussis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                        "entry_id": "396d496b-21b9-3fb6-bfb9-4de7814dc06d",
                                        "glosses": [
                                            "Whooping cough."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24e1784-70f2-47cf-bd6e-cd92c6bcafe3",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "With the introduction of an improved and standardized pertussis vaccine in the 1940s, there followed a remarkable decline in pertussis in the United States, most of the Western world, and Australia, New Zealand, and Japan."
                                            },
                                            {
                                                "example_id": "66eda0a3-c505-4b11-918a-8a6c5a191827",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "Bordetella pertussis is a Gram-negative bacterial pathogen that infects the human respiratory tract, causing the disease pertussis or whooping cough."
                                            },
                                            {
                                                "example_id": "c54a0153-34cc-4080-82ad-a1f6703bef9e",
                                                "sense_id": "16d700db-fddc-35da-a4d7-ed66f8a06869",
                                                "text": "2015, Dr. Stephen Berger, Pertussis: Global Status, GIDEON Informatics, Inc., E-book, page 343,\nDuring 1993 to 2004, the hospitalization rate [in the US] for pertussis among infants ages <= 2 months was 239 per 100,000 live births."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aab9054-af03-48ca-9adb-b79fdf225b77",
                        "source_entry_id": "2f7a3197-089e-33ab-8403-33dffe6c6379",
                        "source_sense_id": "5aaf6c8f-72f3-3900-89ef-f5796a919dd6",
                        "source_sense_description": "een bepaalde kinderziekte die veroorzaakt wordt door de bacterie Bordetella pertussis",
                        "target_lang_word": "whooping cough",
