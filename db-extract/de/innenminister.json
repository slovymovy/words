                                        "sense_id": "098cfee2-9fb2-30d5-978b-2f3de6211ac3",
                                        "entry_id": "adfaffd7-2230-3b81-a1b8-738877174901",
                                        "glosses": [
                                            "Ministre chargé de l’administration du territoire."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b388f90-1bb2-45cc-a0fb-30f087536233",
                                                "sense_id": "098cfee2-9fb2-30d5-978b-2f3de6211ac3",
                                                "text": "[…] c'est oublier un peu vite que si ce trafic existe, c'est parce qu'il y a des usagers qui […] consomment allègrement et régulièrement de la drogue tant et si bien que le ministre de l’Intérieur lui-même a proposé de « contraventionner » la consommation."
                                            },
                                            {
                                                "example_id": "6fd9aa05-4963-4702-885a-93385068938f",
                                                "sense_id": "098cfee2-9fb2-30d5-978b-2f3de6211ac3",
                                                "text": "Peut-être avait-il quelque peu embelli sa relation avec le ministre de l’Intérieur en faisant allusion à une amitié et à une intimité qui, pour l’instant, n’existaient pas, mais on n’a rien sans rien, comme l’avait dit un jour un homme sage."
                                            }
                                        ]
