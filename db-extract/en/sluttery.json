                                        "examples": [
                                            {
                                                "example_id": "61ae7dbd-437f-40e6-9d78-49159e3f0d63",
                                                "sense_id": "ccd1ee3b-d0c4-34a9-ae9f-caecba11a4d8",
                                                "text": "„Die Schlampigkeit von Schülern war dem Lehrer solche Routine, dass er von ihnen nichts anderes erwartete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
