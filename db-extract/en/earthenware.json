                        "target_lang_word": "Steingutgeschirr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe70e432-ae1a-4195-9162-f6528028e75e",
                        "source_entry_id": "d3a369cb-f88c-3cbb-88c9-0135a2d0d3ea",
                        "source_sense_id": "94f4dc65-0973-3f2e-826c-f1303fa91ba3",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Steingut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steingut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                        "entry_id": "4160b4b1-342e-38af-b3f7-e65674392f9f",
                                        "glosses": [
                                            "aus Quarz, Ton und Feldspat bestehende, bei niedriger Hitze gebrannte, durchsichtig glasierte Tonwaren mit weißem, porösem Scherben für Geschirr, Fliesen, Waschtische, Badewannen und andere sanitäre Artikel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3bb952-78e6-4d8c-b342-dbe222d21f35",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Führt zur Hütte für traditionelle Fähigkeiten, wo die Jungen Körbe flechten und die Mädchen Steingut brennen."
                                            },
                                            {
                                                "example_id": "e2c06685-50c1-4bec-8bce-ebe4be0077e3",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Kommunale Wohnungen sind vielleicht nicht das Tafelsilber, aber das Steingut des Stadthaushalts."
                                            },
                                            {
                                                "example_id": "6d475cdb-9aff-4168-930a-4ad370883368",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Künftig durfte das Essen nur noch in Steingut und Porzellan serviert werden."
                                            },
                                            {
                                                "example_id": "106388b3-843b-467c-988b-0bd51a208675",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Auch dieses [Waschbecken] war von weißem Steingut, und nun kamen auch die Handtücher zu Ehren."
                                            },
                                            {
                                                "example_id": "9a0b4694-ca02-4664-a3d5-79e2c6284166",
                                                "sense_id": "a68e427d-2dd6-383c-befb-68b6d7eb8ddc",
                                                "text": "Dicht neben den Verkaufsständen mit Kirchengeräten wurde kunstvoll geschliffenes Glas feilgeboten, und gegenüber den gewaltigen, mit Pokalen und Weingläsern reich besetzten Vitrinen leuchtete das blanke Steingut der Toiletteneinrichtungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bffc0de-d206-4c75-8def-9525fef5beec",
                        "source_entry_id": "d3a369cb-f88c-3cbb-88c9-0135a2d0d3ea",
                        "source_sense_id": "94f4dc65-0973-3f2e-826c-f1303fa91ba3",
                        "source_sense_description": "sdÜ",
