                "senses": [
                    {
                        "sense_id": "b69bdc72-1d83-373b-8825-49355213a1b8",
                        "entry_id": "a989a0d7-ec09-39cf-bd7e-45d4863cd549",
                        "glosses": [
                            "To move with a slapping or flopping action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "974acd8a-cddf-4589-9efb-0ee12314d194",
                                "sense_id": "b69bdc72-1d83-373b-8825-49355213a1b8",
                                "text": "Both Ivor and Philip were cowed by this royal anger and they were silent for some time after she had slipslopped in her carpet slippers down the passage, muttering fiercely as she went."
                            },
                            {
                                "example_id": "8b23aa13-3ccc-4e9f-b3a2-c8cb6194bdf7",
                                "sense_id": "b69bdc72-1d83-373b-8825-49355213a1b8",
                                "text": "One man punts ferociously at the front, his companion steers languidly from the back, and together they maneuver their craft, its load barely clear of the water, to catch the breeze in a tattered sail as they slipslop their way across."
                            },
                            {
                                "example_id": "4689aa63-208d-458c-83bb-8fffe35e1500",
                                "sense_id": "b69bdc72-1d83-373b-8825-49355213a1b8",
                                "text": "She had a pair of old, oversized slippers on her feet that slipslopped as she walked."
                            }
                        ]
                    },
                    {
                        "sense_id": "c13c85fc-93c4-3e2c-8787-ffafe5312154",
                        "entry_id": "a989a0d7-ec09-39cf-bd7e-45d4863cd549",
                        "glosses": [
                            "To slide about like waves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf38a4b-74b0-4cc8-8a32-de21fec9f2d2",
                                "sense_id": "c13c85fc-93c4-3e2c-8787-ffafe5312154",
                                "text": "Below, among dark mysteries of the under-wharf, the water placidly slipslopped; the sea-wind blew gently in, fluffing a lock of hair across my face."
                            },
                            {
                                "example_id": "bbf0ce1a-6e0b-49cd-9256-0c3fc6016b8e",
                                "sense_id": "c13c85fc-93c4-3e2c-8787-ffafe5312154",
                                "text": "They slipslopped and spilled over, some of their contents trickling back into the room, under the warped edge of the door."
                            },
                            {
                                "example_id": "145b84f2-9435-44b1-8ffe-5c966b3633f9",
                                "sense_id": "c13c85fc-93c4-3e2c-8787-ffafe5312154",
                                "text": "The ample yellow yolk of it slipslopped back and forth in the pan, following the rocking of the ark."
                            }
                        ]
                    }
