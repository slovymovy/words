                        "glosses": [
                            "Épithète qualifiant une divinité ou un personnage portant un veau en vue de le sacrifier."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "55e59a2c-bd8f-4d1f-b331-88dbc52ae3d7",
                                "sense_id": "65a4d054-601b-3b10-8dd9-1320605fd887",
                                "text": "Hermès moschophore, fragment d'un marbre d'ancien style découvert à l'est de l'Acropole d'Athènes et qui se trouve aujourd'hui au Musée de l'Acropole."
                            },
                            {
                                "example_id": "4a7344d2-1bee-48f0-918b-6d19a63ba6a0",
                                "sense_id": "65a4d054-601b-3b10-8dd9-1320605fd887",
                                "text": "Le barbu tient son arc ; l'imberbe porte sur ses épaules , de la même manière que toutes les figures criophores, tragophores ou moschophores, que l'art grec nous a léguées."
                            }
                        ]
                    }
