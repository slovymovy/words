                ],
                "senses": [
                    {
                        "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                        "entry_id": "744d5de2-a824-370d-b774-1832c8abfdf2",
                        "glosses": [
                            "Spielform, bei der vorrangig die Sinnesorgane beansprucht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fed8da3-6bf7-4cf9-a97a-e17f12d962cd",
                                "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                                "text": "„Ein dreizehnjähriger Junge namens Kim, Hauptfigur des Kultromans ‚Kim’ von R. Kipling, gab einer Gruppe von Wahrnehmungsspielen seinen Namen.“"
                            },
                            {
                                "example_id": "9619a8b5-3cd2-4751-82a8-864d9e1c586a",
                                "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                                "text": "„Im letzten Monet-Raum führt Naoya Hatakeyama dessen Wahrnehmungsspiele fotografisch fort, indem er Luftbilder Tokios im Wandel des Lichts und der Jahreszeiten festhält.“"
                            },
                            {
                                "example_id": "eb53ec94-221e-498c-b949-29ac211f6772",
                                "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                                "text": "„Darum werden in der Therapie auch Wahrnehmungsspiele und psychomotorische Spiele eingesetzt.“"
                            },
                            {
                                "example_id": "883df576-f321-4779-ac40-1107ee3e58e6",
                                "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                                "text": "„Das Hippy-Programm […], entwickelt von der Hebroner Universität und jetzt auch hierzulande probeweise im Einsatz, hilft ausländischen Eltern, ihr Vorschulkind mit Sprach- und Wahrnehmungsspielen auf die Schule vorzubereiten.“"
                            },
                            {
                                "example_id": "3b60a623-e3ee-4916-833b-922a94680094",
                                "sense_id": "f0e2dc7e-04db-3334-b515-4c376620dced",
                                "text": "„Es ist eine Art Kurzkrimi, ein absurdes Theater voller rätselhafter Andeutungen, Wahrnehmungsspiele und Klangtäuschungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
