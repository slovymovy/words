                        "examples": [
                            {
                                "example_id": "4e864e28-4f40-4de8-b3e8-1c47e087ecd2",
                                "sense_id": "670a31e1-f0f6-3cdf-a4ce-e334eb32ef45",
                                "text": "De in 1940 in Trinidad en Tobago geboren zanger kwam als 15-jarige naar Engeland. Midden jaren zestig sloot hij zich als achtergrondzanger aan bij een multiraciale band die kort daarna als The Foundations verderging. Curtis werd de leadzanger."
                            },
                            {
                                "example_id": "5086b1d6-8dea-48a6-b9b5-4275be1a0c6c",
                                "sense_id": "670a31e1-f0f6-3cdf-a4ce-e334eb32ef45",
                                "text": "Vanavond geeft de Britste zanger nog een concert in de Ziggo Dome. Zijn concert van gisteren kreeg veel lovende reacties in de media. Het Parool noemde de singer-songwriter \"een eigen achtergrondzanger, tweede gitarist, bassist en drummer. Een eenmansband, maar dan echt.\" Ook looft de krant zijn brede muzikale spectrum."
                            }
                        ]
                    }
