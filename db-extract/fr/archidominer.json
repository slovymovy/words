                                "example_id": "3bb57485-9de0-4f4b-821f-b7095904b8b9",
                                "sense_id": "14d5ed32-9677-37a3-a5c3-4fc77d120956",
                                "text": "Chantôme : «On a archidominé»."
                            },
                            {
                                "example_id": "33d72e72-7901-4b1d-a7c7-e0a4413b62c2",
                                "sense_id": "14d5ed32-9677-37a3-a5c3-4fc77d120956",
                                "text": "J'estime même qu'on a archidominé la seconde période."
