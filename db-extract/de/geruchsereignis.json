                "senses": [
                    {
                        "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                        "entry_id": "91eb5e67-33c1-395c-af5f-ec3e7103fee7",
                        "glosses": [
                            "bedeutsame, geruchliche Wahrnehmung von Geruchsstoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c949e0a4-674d-40c3-b296-1e3303351a13",
                                "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                                "text": "„Bei Meldungen im Zusammenhang mit Geruchsereignissen wurden teilweise technische Ursachen mitgeteilt.“"
                            },
                            {
                                "example_id": "4eb549fe-48f4-4fae-b480-0566a0f984e6",
                                "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                                "text": "„Denn schon beim Anblick der Blüte erwartet unser Unbewusstes ein angenehmes Geruchsereignis.“"
                            },
                            {
                                "example_id": "092419db-c46d-4cca-9b7d-ec08829daa47",
                                "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                                "text": "„Die Testpersonen sollten demzufolge im Vorfeld kaum mit Geruchsbewertungen und -training konfrontiert worden sein, sie sollen sich selbst als ganz normal riechend einschätzen und völlig unvoreingenommen das zu bewertende Geruchsereignis räsentiert bekommen.“"
                            },
                            {
                                "example_id": "a6be6c5f-30e1-46b8-a251-7e8e8c5a8db8",
                                "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                                "text": "„Das Auftreten von Geruchsereignissen ist nach den Richtlinien stundenweise zu berücksichtigen, also in Geruchsstunden.“"
                            },
                            {
                                "example_id": "fc50bfbe-8fe3-4630-b1d5-9746aa0a6e6a",
                                "sense_id": "5a06c5bd-e41a-347a-b808-8465b57b273a",
                                "text": "„\"Wir haben mittlerweile gute Belege dafür, dass die Salton Sea für das sehr starke und ungewöhnliche Geruchsereignis verantwortlich ist\", sagt Barry Wallerstein, Leiter des South Coast Air Quality Management District in einer Stellungnahme.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
