                                "example_id": "bf7f5017-ff84-4946-838d-3616867f8aa5",
                                "sense_id": "8b2f1783-6450-3b09-a40f-1f0a41738c28",
                                "text": "Ik zweer het je! Je hebt mijn werk ongedaan gemaakt."
