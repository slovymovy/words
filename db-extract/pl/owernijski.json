                ],
                "senses": [
                    {
                        "sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                        "entry_id": "a7ffe075-50be-31c7-9e82-f7c12867909e",
                        "glosses": [
                            "związany z Owernią, dotyczący Owernii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9424d55b-0f1d-4d87-865c-828badf6326b",
                                "sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                                "text": "Właściciel firmy miał lekki owernijski akcent, ale ważniejszy był ton jego głosu, sprawiający wrażenie, że zwraca się do rozmówcy z czubka jednego z wulkanów tego regionu"
                            },
                            {
                                "example_id": "e8862693-351d-488b-a230-ba00fcf4e74c",
                                "sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                                "text": "Stała rekrutacja nowych członków w Europie i lawinowy nieomal wzrost ilości dóbr zakonnych nadawanych joannitom na terenie całego kontynentu spowodowały konieczność podziału rycerzy na grupy narodowościowo-terytorialne, zwane później „językami”. Powstało ich osiem: prowansalski, owernijski, francuski, włoski, aragońsko-kataloński i wyodrębniony z niego później kastylijsko-portugalski, a także niemiecki i angielski"
                            },
                            {
                                "example_id": "14b88bcd-1e2e-4183-acdb-7de4016e1b96",
                                "sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                                "text": "Ze wszystkich opinii miarkując, nie przestawała być damą, w salonie naśladującą (i jak!) swadę jakiejś swej znajomej farmerki, jakiejś prostej kobiety, uczciwej rzetelnej rubachy owernijskiej czy burgundzkiej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dda2df6b-fafe-4746-bc12-adab6627f413",
                        "source_entry_id": "a7ffe075-50be-31c7-9e82-f7c12867909e",
                        "source_sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                        "target_lang_word": "Auvergnese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auvergnese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8a0af16-9f42-3f7d-b069-3e65cf9d5907",
                                        "entry_id": "7cbaf5ed-d8da-3510-a045-ba46a7f09332",
                                        "glosses": [
                                            "Of, from, or pertaining to the region of Auvergne in France"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0da9f8d-b38d-42da-bf9d-6ce0feaddb23",
                                                "sense_id": "d8a0af16-9f42-3f7d-b069-3e65cf9d5907",
                                                "text": "[…] as for the others, they at once fall back upon an Auvergnese patois, at least as different from ordinary French as a Durham miner's vernacular is from a West countryman's."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Auvergnese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "082e361d-32c2-3d24-b68e-80fe55352a71",
                                        "entry_id": "dcbfc447-c939-32a1-83d1-3323e1f570e2",
                                        "glosses": [
                                            "A person from the Auvergne region"
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30617e81-8db1-4eeb-8ad1-0d3964cd4ef9",
                                                "sense_id": "082e361d-32c2-3d24-b68e-80fe55352a71",
                                                "text": "The little Auvergnese retired highly delighted, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a0c59f7-e00c-4123-9ca7-c5e3f5ff0487",
                        "source_entry_id": "a7ffe075-50be-31c7-9e82-f7c12867909e",
                        "source_sense_id": "cfd42c7a-add8-3730-8fd8-56498cb77b9d",
                        "target_lang_word": "auvergnat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auvergnat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                        "entry_id": "7b0df4c2-6969-3655-ba38-3220e545c1b2",
                                        "glosses": [
                                            "Relatif à l’Auvergne et à ses habitants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f0474f-e72e-4770-ad37-7d99bb6d5d9f",
                                                "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                                "text": "Le gars aux biques portait, sous une limousine de roulier, un bourgeron bleu serré à la taille par une ceinture rouge qui maintenait un pantalon de velours à l'instar des charbonniers auvergnats, […]."
                                            },
                                            {
                                                "example_id": "79b83510-0b91-4c30-b32a-6a8ea46730ff",
                                                "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                                "text": "Voilà pourquoi la Haute-Saintonge a toujours attiré des populations venues d’ailleurs, défricheurs poitevins, tâcherons auvergnats, éleveurs vendéens, résiniers landoux ou réfugiés espagnols."
                                            },
                                            {
                                                "example_id": "b427f80f-a96e-4c93-8fc6-62223699f462",
                                                "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                                "text": "À peine paru, mon premier livre déchaînerait le scandale, je deviendrais un ennemi public : insulté par les journaux auvergnats, les commerçants refuseraient de me servir, des exaltés jetteraient des pierres dans mes carreaux ; pour échapper au lynchage il me faudrait fuir."
                                            },
                                            {
                                                "example_id": "f2477ea4-45c0-4421-b66b-5f05ea807a0c",
                                                "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                                "text": "C’est ça la bourrée auvergnate!… bien qu’il y a des Auvergnats qui la connaissent mal!…"
                                            },
                                            {
                                                "example_id": "a553044d-4d6d-46ec-ad19-57e304d6e4ae",
                                                "sense_id": "a401adc0-f42e-382e-8ab4-c2156cbd1c03",
                                                "text": "Une bétaillère qui avançait trop lentement abrégea son voyage terrestre en projetant sa Rolls contre le mur du cimetière auvergnat du Cheix-sur-Morge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "auvergnat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d47ed33e-6097-371c-acab-05e0d79b8ce1",
                                        "entry_id": "5c297494-5060-3355-80a3-f03ecfb16f03",
                                        "glosses": [
                                            "Variété dialectale de l’occitan ou langue d’oc parlée essentiellement en Auvergne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a8d9c0a-54a3-458b-b9ae-941cba6ff1e7",
                                                "sense_id": "d47ed33e-6097-371c-acab-05e0d79b8ce1",
                                                "text": "Madame Brignolin lance après lui des chansons du Midi.\nMa mère — paysanne — dit : « Ça, c’est des airs de freluquets, » et elle entonne en auvergnat :\nDigue d’Janette,\nTe vole marigua\nLaya !\nVole prendre un homme !\nQue sabe trabailla,\nLaya !"
                                            },
                                            {
                                                "example_id": "8f7f0122-e3c7-4bac-9a70-4491f2fa476b",
                                                "sense_id": "d47ed33e-6097-371c-acab-05e0d79b8ce1",
                                                "text": "Le parler dialectal thiernois appartient au groupe des parlers nord-occitans, qui comprend le limousin, le marchois, l’auvergnat et le provençal alpin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
