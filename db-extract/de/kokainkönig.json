                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2a25fc-4ab9-4098-88d4-3c817adc677f",
                                "sense_id": "f55ea449-9657-31fe-bf88-1e7742af7ae2",
                                "text": "„Die Kokainkönige hatten herrschaftliche Häuser, Luxuslimousinen, Rennautos, eigene Hubschrauber und Flugzeuge, vornehme Kleidung und ausgefallene Kunstwerke (manche, darunter Pablo, engagierten einen Innenausstatter, um sich bei der Wahl von Gemälden und Skulpturen hinsichtlich ihres zum Grellen und Surrealen neigenden Geschmacks beraten zu lassen.)“"
                            },
                            {
                                "example_id": "f6604b83-772b-4a72-aac6-05e17eaeb347",
                                "sense_id": "f55ea449-9657-31fe-bf88-1e7742af7ae2",
                                "text": "„El Padrino war der mexikanische Kokainkönig.“"
                            }
                        ],
