{
    "word_family": [
        "flodderen",
        "flodderig",
        "flodderbroek",
        "flodderkous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a7aa6a3-eac3-3660-a2ce-e460bc4d0d5d",
                    "sense_definition": "Een oefenpatroon zonder kogel, waarbij enkel kruit ontbrandt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "munitie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de militaire oefening gebruikten de soldaten slechts een losse <w>flodder</w>.",
                            "target_lang_translations": {
                                "fr": "Pendant l'exercice militaire, les soldats n'ont utilisé qu'une <w>balle à blanc</w>."
                            }
                        },
                        {
                            "text": "Het geweer schoot met een <w>flodder</w> zodat er geen gevaar was voor omstanders.",
                            "target_lang_translations": {
                                "fr": "Le fusil tirait <w>à blanc</w> afin qu'il n'y ait aucun danger pour les passants."
                            }
                        }
                    ],
                    "common_phrases": [
                        "losse flodder"
                    ],
                    "target_lang_definitions": {
                        "fr": "Cartouche d'exercice sans projectile, ne contenant que de la poudre."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "balle à blanc",
                                "target_lang_sense_clarification": "munition d'entraînement"
                            },
                            {
                                "target_lang_word": "cartouche à blanc",
                                "target_lang_sense_clarification": "munition sans projectile"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34ce711a-b61b-3eaa-9047-627243b3e9e3",
                    "sense_definition": "Een loze uitspraak, actie of aanval die geen enkel effect of resultaat heeft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn kritiek op het nieuwe beleid bleek uiteindelijk niet meer dan een losse <w>flodder</w>.",
                            "target_lang_translations": {
                                "fr": "Sa critique de la nouvelle politique s'est finalement révélée n'être qu'un <w>coup d'épée dans l'eau</w>."
                            }
                        },
                        {
                            "text": "Het dreigement van de oppositie was een losse <w>flodder</w> zonder echte gevolgen.",
                            "target_lang_translations": {
                                "fr": "La menace de l'opposition n'était qu'un <w>tir à blanc</w> sans véritables conséquences."
                            }
                        }
                    ],
                    "common_phrases": [
                        "losse flodder"
                    ],
                    "target_lang_definitions": {
                        "fr": "Parole en l'air, menace vaine ou action sans portée ni effet réel."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "coup d'épée dans l'eau",
                                "target_lang_sense_clarification": "action inutile, sans effet"
                            },
                            {
                                "target_lang_word": "tir à blanc",
                                "target_lang_sense_clarification": "menace ou attaque sans conséquence"
                            },
                            {
                                "target_lang_word": "parole en l'air",
                                "target_lang_sense_clarification": "propos sans suite"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac86e9d-32fe-3081-a5fd-bb9e0eb9518d",
                    "sense_definition": "Slordige, wijdhangende of verfomfaaide kleding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kleding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liep thuis het liefst rond in een oude <w>flodder</w> van een jurk.",
                            "target_lang_translations": {
                                "fr": "À la maison, il préférait se promener dans une vieille <w>loque</w> en guise de robe."
                            }
                        },
                        {
                            "text": "Ze droeg een vormloze <w>flodder</w> die haar figuur helemaal verborg.",
                            "target_lang_translations": {
                                "fr": "Elle portait une <w>fripe</w> informe qui cachait complètement sa silhouette."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Vêtement lâche, débraillé ou informe."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "loque",
                                "target_lang_sense_clarification": "vêtement très négligé"
                            },
                            {
                                "target_lang_word": "guenille",
                                "target_lang_sense_clarification": "vêtement usé ou informe"
                            },
                            {
                                "target_lang_word": "fripe",
                                "target_lang_sense_clarification": "vêtement froissé ou négligé"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c05bc58-ad26-34ca-a258-34c9b630fee1",
                    "sense_definition": "Eerste persoon enkelvoud van de tegenwoordige tijd van <w>flodderen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>flodder</w> het liefst in comfortabele kleding door het huis op zondag.",
                            "target_lang_translations": {
                                "fr": "Le dimanche, je préfère <w>traînailler</w> dans la maison en tenue décontractée."
                            }
                        },
                        {
                            "text": "Als ik haast heb, <w>flodder</w> ik soms een beetje met het schilderwerk.",
                            "target_lang_translations": {
                                "fr": "Quand je suis pressé, je <w>bâcle</w> parfois un peu les travaux de peinture."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier au présent de l'indicatif du verbe « flodderen » (traînailler, s'habiller de façon négligée, bâcler)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "traîne",
                                "target_lang_sense_clarification": "traînailler, glander"
                            },
                            {
                                "target_lang_word": "bâcle",
                                "target_lang_sense_clarification": "travailler négligemment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "009c7e8d-25fc-35b2-872d-378ef54e3f9e",
                    "sense_definition": "Gebiedende wijs van <w>flodderen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Flodder</w> toch niet zo rond en kleed je netjes aan voor het diner.",
                            "target_lang_translations": {
                                "fr": "Ne <w>traîne</w> pas ainsi et habille-toi convenablement pour le dîner."
                            }
                        },
                        {
                            "text": "<w>Flodder</w> niet met die natte verf over de schone vloer.",
                            "target_lang_translations": {
                                "fr": "Ne <w>mets pas</w> de la peinture fraîche n'importe où sur le sol propre."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif singulier du verbe « flodderen »."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ne traîne pas",
                                "target_lang_sense_clarification": "ordre de ne pas traînailler"
                            },
                            {
                                "target_lang_word": "ne bâcle pas",
                                "target_lang_sense_clarification": "ordre de ne pas faire n'importe comment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6697b5c3-e92e-33b1-8381-bc670a671d2a",
                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>flodderen</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Flodder</w> je altijd zo door het huis als er bezoek langskomt?",
                            "target_lang_translations": {
                                "fr": "<w>Traînes-tu</w> toujours ainsi dans la maison quand des invités arrivent ?"
                            }
                        },
                        {
                            "text": "Waarom <w>flodder</w> je zo met die natte handdoek in de badkamer?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>secoues-tu</w> cette serviette mouillée dans tous les sens dans la salle de bain ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier au présent de l'indicatif (inversion) du verbe « flodderen »."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "traînes",
                                "target_lang_sense_clarification": "traînailler en tenue débraillée"
                            },
                            {
                                "target_lang_word": "bâcles",
                                "target_lang_sense_clarification": "faire de façon désordonnée"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}