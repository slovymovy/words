                    {
                        "sense_id": "ae0f1a3b-01e9-3375-96c7-0efc849ea684",
                        "entry_id": "11ed125c-42bc-3ac6-a44a-5a56469b3888",
                        "glosses": [
                            "An irrational fear or hatred of dogs or other canines."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "55266aec-5533-4684-9965-55bd8194b58e",
                                "sense_id": "ae0f1a3b-01e9-3375-96c7-0efc849ea684",
                                "text": "Taffy's cynophobia, expressed in spitting, growling, melancholy miauling, served to ease the awkwardness of greeting between unprepared hostess and uninvited guest."
                            },
                            {
                                "example_id": "20797e2c-c030-425b-beda-4ea0637cfbff",
                                "sense_id": "ae0f1a3b-01e9-3375-96c7-0efc849ea684",
                                "text": "This finding has significant implications for the study of cynophobia, since one would expect from the classical conditioning model of fear that a dog bite should have a lasting negative impact on a child's attitude toward dogs."
                            }
                        ]
                    }
                ],
