                {
                    "sense_id": "7b0bcd29-e288-3c14-b797-d5cb25d5bc29",
                    "sense_definition": "iemand anders van kleding ontdoen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontkleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>kleedde</w> haar kindje <w>uit</w> en legde hem in zijn bedje.",
                            "target_lang_translations": {
                                "en": "She <w>undressed</w> her baby and put him in his crib.",
                                "ru": "Она <w>раздела</w> своего малыша и положила его в кроватку.",
                                "pl": "<w>Rozebrała</w> swoje dziecko i położyła je do łóżeczka.",
                                "de": "Sie <w>zog</w> ihr Baby <w>aus</w> und legte es in sein Bettchen.",
                                "fr": "Elle <w>déshabilla</w> son bébé et le mit dans son berceau.",
                                "it": "Lei <w>spogliò</w> il suo bambino e lo mise nel suo lettino.",
                                "cs": "Ona <w>svlékla</w> své děťátko a položila ho do postýlky.",
                                "tr": "Bebeğini <w>soymuş</w> ve onu yatağına yatırmıştı.",
                                "es": "Ella <w>desvistió</w> a su bebé y lo acostó en su cuna."
                            }
                        },
                        {
                            "text": "De verpleegkundige hielp de patiënt met <w>uitkleden</w> voor het onderzoek.",
                            "target_lang_translations": {
                                "en": "The nurse helped the patient with <w>undressing</w> before the examination.",
                                "ru": "Медсестра помогла пациенту <w>раздеться</w> перед осмотром.",
                                "pl": "Pielęgniarka pomogła pacjentowi w <w>rozbieraniu się</w> przed badaniem.",
                                "de": "Die Pflegekraft half dem Patienten beim <w>Ausziehen</w> vor der Untersuchung.",
                                "fr": "L'infirmière a aidé le patient à se <w>déshabiller</w> avant l'examen.",
                                "it": "L'infermiere ha aiutato il paziente a <w>spogliarsi</w> per l'esame.",
                                "cs": "Sestra pomohla pacientovi se <w>svlékáním</w> před vyšetřením.",
                                "tr": "Hemşire, muayene öncesinde hastanın <w>soyunmasına</w> yardımcı oldu.",
                                "es": "La enfermera ayudó al paciente a <w>desvestirse</w> para el examen."
                            }
                        }
