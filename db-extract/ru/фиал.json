                "senses": [
                    {
                        "sense_id": "8fa85e89-981d-3185-ab77-7df0987b3c16",
                        "entry_id": "a4de8bca-6dde-30aa-89cb-3fead321b8a1",
                        "glosses": [
                            "сосуд с узким горлышком"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e101108c-fcac-428a-a022-916ba30cb86e",
                                "sense_id": "8fa85e89-981d-3185-ab77-7df0987b3c16",
                                "text": ".. потом мы разглядывали крещальный фиал, употребляемый для водосвятия .. Чаша его из цельного куска мрамора."
                            },
                            {
                                "example_id": "5453da5e-291d-43a5-b1a5-510d187eff28",
                                "sense_id": "8fa85e89-981d-3185-ab77-7df0987b3c16",
                                "text": "Пригласив друзей на великолепный пир, празднуя с ними, звеня чашами и фиалами, хозяин приглашал к себе и женщин, для большей прелести беседы и разгулья: это были прелестницы, танцовщицы, плясуньи, певицы афинские, римские."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac019bfb-3b5f-3bc7-8100-cfe2333c111a",
                        "entry_id": "a4de8bca-6dde-30aa-89cb-3fead321b8a1",
                        "glosses": [
                            "архит. гранёное шатровое навершие пирамидальной формы, венчающее башенки — пинакли"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd19cb72-fc77-45dc-871a-04d5d5c6a08c",
                        "source_entry_id": "a4de8bca-6dde-30aa-89cb-3fead321b8a1",
                        "source_sense_description": "сосуд",
                        "target_lang_word": "vial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                        "entry_id": "8bc918b2-874b-3673-986c-0e92c5e78cf9",
                                        "glosses": [
                                            "A glass or plastic vessel or bottle, especially a small tube-shaped bottle used to store medicine, perfume or other chemicals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "399fff0c-484f-493a-a488-be76a1cd4a0e",
                                                "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                                "text": "Take thou this vial, being then in bed, / And this distilled liquor drink thou off."
                                            },
                                            {
                                                "example_id": "12e5b6e8-b9fe-42b0-8390-1872ba131f33",
                                                "sense_id": "34619ca5-08eb-37ea-96d6-ec7d176fb4c5",
                                                "text": "And the second angel poured out his vial upon the sea; and it became as the blood of a dead man: and every living soul died in the sea."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "999caade-8f85-332d-9304-6d7a59a6d4e4",
                                        "entry_id": "18bd4f7a-6118-3c4d-a64d-d416d5e7722f",
                                        "glosses": [
                                            "To keep or put (something, especially a liquid) in, or as if in, a vial (noun sense)."
                                        ],
