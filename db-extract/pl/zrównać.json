                        "examples": [
                            {
                                "example_id": "c0751cfd-6474-427c-a3c1-c36e01d47938",
                                "sense_id": "1f18f112-892c-3e73-86be-1561ffd25a07",
                                "text": "Dodatkowo mieszkańcy wskazali, że położenie warstwy termoizolacji zrównałoby lico budynku z licem fasady przylegającego narożnego budynku, których został ocieplony (a także podniesiony o 1,5 piętra) w latach 90-tych.",
                                "translation": "In addition, the residents indicated that the placement of a layer of insulation would make the face of the building equal to the face of the facade of the adjacent building on the corner, which was insulated (and also made 1.5 floors higher) in the 90's.",
                                "english": "In addition, the residents indicated that the placement of a layer of insulation would make the face of the building equal to the face of the facade of the adjacent building on the corner, which was insulated (and also made 1.5 floors higher) in the 90's."
                            },
                            {
                                "example_id": "52548a05-31a4-477c-b59a-b84050388234",
                                "sense_id": "1f18f112-892c-3e73-86be-1561ffd25a07",
                                "text": "Czesi chcą zrównać rosyjski sybol^([sic]) \"Z\" ze swastyką",
                                "translation": "The Czechs want to make the Russian Z symbol legally equivalent to the swastika.",
                                "english": "The Czechs want to make the Russian Z symbol legally equivalent to the swastika."
                            },
                            {
                                "example_id": "e344155c-a363-4732-b56a-1aa4aa160a5a",
                                "sense_id": "1f18f112-892c-3e73-86be-1561ffd25a07",
                                "text": "Zrównanie uprawnień Polaków i Ukraińców nie dotyczy pewnych dziedzin, np. praw wyborczych...",
                                "translation": "The equalization of the legal rights of Poles and Ukrainians does not include certain areas, such as the right to vote...",
