                                "target_senses": [
                                    {
                                        "sense_id": "ac09afbd-223e-35f9-9072-477151bec5c4",
                                        "entry_id": "0e249425-cdc3-3c42-b4f0-a27ed0f790d7",
                                        "glosses": [
                                            "A bag or case with one or two shoulder straps, especially used to carry books etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6620279d-d6dd-4aed-8d7e-da7bd41b274f",
                                                "sense_id": "ac09afbd-223e-35f9-9072-477151bec5c4",
                                                "text": "\"Come, now, take yourselves off, like good boys and girls,\" he said; and the whole assemblage, dark and light, disappeared through a door into a large verandah, followed by Eva, who carried a large satchel, which she had been filling with apples, nuts, candy, ribbons, laces, and toys of every description, during her whole homeward journey."
                                            },
                                            {
                                                "example_id": "2cb1c44b-7c0b-46eb-8374-905e6f4fe6a2",
                                                "sense_id": "ac09afbd-223e-35f9-9072-477151bec5c4",
                                                "text": "A young culprit has been caught in the fact of robbing an orchard, and brought back to his master, who stands over him with an iron face of angry authority;—the very apples, as if anxious to bear witness against him, are tumbling from his satchel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
