                                    {
                                        "sense_id": "02d2ac5f-2ec4-313c-9547-4fff78588a51",
                                        "entry_id": "9d5013ae-323a-3cc2-ab9b-bfffe4a3ae93",
                                        "glosses": [
                                            "definire qualcuno o qualcosa in generale, appunto senza le specifiche distinzioni e/o senza individuare gradi, livelli o particolarità esistenti"
                                        ],
                                        "tags": [
