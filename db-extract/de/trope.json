                        "form": "die Tropen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "094bee58-b7ac-3591-b748-1d8b3060796b",
                        "entry_id": "2a3ca793-d25d-342b-9e71-6451a01d061d",
                        "glosses": [
                            "Tropus, bildlicher Ausdruck"
                        ],
                        "tags": [
                            "variant"
                        ],
                        "examples": [
                            {
                                "example_id": "984339e6-7ed0-4f07-a056-644898048e11",
                                "sense_id": "094bee58-b7ac-3591-b748-1d8b3060796b",
                                "text": "Metapher und Allegorie sind Tropen."
                            },
                            {
                                "example_id": "77601b8d-f01c-4182-aecf-edf2cf8ac4ed",
                                "sense_id": "094bee58-b7ac-3591-b748-1d8b3060796b",
                                "text": "„Eine Trope verändert die Aussage anhand eines einzelnen Wortes, wohingegen sich eine rhetorische Figur auf das Wortgefüge bezieht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "27566da1-33f0-382c-b6c1-bbcc2e0e1adc",
                        "entry_id": "2a3ca793-d25d-342b-9e71-6451a01d061d",
                        "glosses": [
                            "Grundkategorie der Beschreibung, die individuelle, distinkt auftretende Eigenschaften betrachtet, statt übergreifende, zusammenfassende Universalbegriffe zu schaffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf235c1a-d18c-4ea8-94e7-1b8ad261edf7",
                                "sense_id": "27566da1-33f0-382c-b6c1-bbcc2e0e1adc",
                                "text": "„Eine Trope von F-heit ist üblicherweise nicht selbst F. Tropen von Menschheit beispielsweise sind selbst nicht menschlich.“"
                            },
                            {
                                "example_id": "d78cd29b-8e91-4c64-9318-b71357c71244",
                                "sense_id": "27566da1-33f0-382c-b6c1-bbcc2e0e1adc",
                                "text": "Diese rosa Blüte zeigt eine Trope von ›rosa‹, die Blüte daneben zeigt exakt die gleiche Trope, allerdings eine numerisch zweite. Beide Blütenfarben sind keinesfalls zwei Realisationen der einen, gleichen, abstrakten Eigenschaft ›rosa‹."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
