                        ],
                        "examples": [
                            {
                                "example_id": "7a5d890a-6dc2-49ac-b6d0-8cf64b3e30b7",
                                "sense_id": "e6005902-1b1d-3417-9e4a-36bbedc63174",
                                "text": "Kennelijk kwam de verschrikkelijke onweerswolk, waarnaar hij met hart en ziel had verlangd en die hem tegelijk onwillekeurig angst aanjoeg -, kennelijk kwam die wolk naderbij."
                            },
                            {
                                "example_id": "d129520d-577a-49e8-b95f-f397d2be8b60",
                                "sense_id": "e6005902-1b1d-3417-9e4a-36bbedc63174",
                                "text": "Een bliksemschicht ontstaat door ontlading van negatieve deeltjes in een onweerswolk via een kilometerslang kanaal van de wolk naar de aarde."
                            }
                        ]
                    }
