                                        "sense_id": "ec223a28-46a6-3a32-824e-95f2301e8ba8",
                                        "entry_id": "e5d46c9b-14d8-32e0-8996-ee22d47a36ad",
                                        "glosses": [
                                            "A marching band color guard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
