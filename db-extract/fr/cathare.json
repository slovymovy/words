                                        "sense_id": "596c5f0b-3514-3eeb-b7b6-cd448b66d758",
                                        "entry_id": "0be85e11-51e8-3ba5-8092-91bf5d64f895",
                                        "glosses": [
                                            "aanhanger van een Middeleeuwse christelijke sekte die door de toenmalige rooms-katholieke kerk als ketters werd beschouwd en met geweld vervolgd tot alle katharen waren uitgeroeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70568afd-2573-401b-a3bd-a7894f00941a",
                                                "sense_id": "596c5f0b-3514-3eeb-b7b6-cd448b66d758",
                                                "text": "”De goede Katharen” is een roman die zich afspeelt tegen de achtergrond van de vervolging van de katharen in de Franse Pyreneeën, die duurde van de twaalfde tot de veertiende eeuw."
                                            },
                                            {
                                                "example_id": "576d55a0-9ba1-42e3-aeeb-d3e41495bb01",
                                                "sense_id": "596c5f0b-3514-3eeb-b7b6-cd448b66d758",
                                                "text": "Katharen onderwerp van historische jeugdroman: Wat moet je doen als de boeken die je graag wilt lezen er bijna niet zijn? Louise Flint besloot ze dan maar zelf te gaan schrijven. ”Hoogverraad” is haar debuutroman voor jongeren."
                                            },
                                            {
                                                "example_id": "d75f0745-1a96-47b6-be3d-02bccf7acec3",
                                                "sense_id": "596c5f0b-3514-3eeb-b7b6-cd448b66d758",
                                                "text": "Het Zuid-Franse Montségur, dicht tegen de Pyreneeën, is een klein dorp met een grote geschiedenis. Honderden jaren geleden vonden ruim 200 Katharen er de dood door toedoen van fanatieke kruisvaarders."
                                            }
                                        ]
                                    }
                                ]
                            }
