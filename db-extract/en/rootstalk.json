                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ba6fb15-fe05-4795-9bdf-ecc19c5246ef",
                                "sense_id": "e0637703-1516-3c35-bdda-23f1a5715d3e",
                                "text": "All these species are climbing, briery plants, having long slender roots, which proceed in all directions from a common rootstalk or rhizome."
                            },
                            {
                                "example_id": "ce47114f-b00d-4969-8f03-5c5574a1c2e5",
                                "sense_id": "e0637703-1516-3c35-bdda-23f1a5715d3e",
                                "text": "For Theophrastus insists that the scion's relation to the rootstalk is not essentially different from that of any other plant's relation to the earth. The rootstalk simply provides nourishment, just as the earth does, while the formation and growth of the scion are both due to the power of the scion itself."
                            }
                        ]
                    }
