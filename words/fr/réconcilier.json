                    "sense_definition": "Faire la paix et rétablir de bonnes relations mutuelles après une dispute.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relations_humaines",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de silence, ils ont enfin choisi de se <w>réconcilier</w>."
                        },
                        {
                            "text": "Les deux amies ont réussi à se <w>réconcilier</w> après une dispute sans importance."
                        }
                    ],
                    "synonyms": [
