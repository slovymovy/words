                        "entry_id": "f748e8b5-8e93-3413-a157-f114665defa8",
                        "glosses": [
                            "A beverage composed of hot milk curdled by some strong infusion, such as wine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f94afc5e-68a3-4481-a996-e35ad50300b0",
                                "sense_id": "a75ede3e-46c7-3e39-8f89-d0693bf89f41",
                                "text": "I have drugged their possets."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc9c3fab-f340-3f30-85bd-5674d6ab5150",
                        "entry_id": "f748e8b5-8e93-3413-a157-f114665defa8",
                        "glosses": [
                            "A baby's vomit, comprising curdled milk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adf68b06-6205-4266-b2ec-989d4d6a30bb",
                                "sense_id": "dc9c3fab-f340-3f30-85bd-5674d6ab5150",
                                "text": "Some people will tell you that this position may allow inhalation of posset, but there is no evidence to support this."
                            },
                            {
                                "example_id": "3e425b17-20f3-4d32-87b5-224ec7e213c7",
                                "sense_id": "dc9c3fab-f340-3f30-85bd-5674d6ab5150",
                                "text": "Derek saw that a smear of posset had appeared on the left shoulder of his jacket [...] He smiled softly at Charlotte and said softly, 'I've been puked on.'"
                            },
                            {
                                "example_id": "4837e8f0-fef9-47a0-bf52-5316d55eaac6",
                                "sense_id": "dc9c3fab-f340-3f30-85bd-5674d6ab5150",
                                "text": "While a little posseting is nothing to be worried about, a lot of posset is more likely to be 'reflux'."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e755397-b8a3-3723-b56d-d1c2fd4966c4",
                        "entry_id": "f748e8b5-8e93-3413-a157-f114665defa8",
                        "glosses": [
