                "senses": [
                    {
                        "sense_id": "897e538f-859a-3632-b070-c4c9fd367923",
                        "entry_id": "30a87fb9-9f25-3813-8d0e-f3e14ad437dc",
                        "glosses": [
                            "Mangel an Freude, innerem Glück"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611b2a7e-0ffc-4d4b-971e-01db21ba35e8",
                                "sense_id": "897e538f-859a-3632-b070-c4c9fd367923",
                                "text": "„Das Bild der nebelverhangenen Dächer erweckt abermals die Vorstellung von Dunkelheit und Freudlosigkeit.“"
                            },
                            {
                                "example_id": "67b7d2d7-2ef1-428b-ac6b-a2290083ee2f",
                                "sense_id": "897e538f-859a-3632-b070-c4c9fd367923",
                                "text": "„Franziskas Freudlosigkeit glitt in die scheinbar unausweichliche Zwangsvorstellung hinein, nur im Selbstmord einen Ausweg zu finden.“"
                            },
                            {
                                "example_id": "8a76472a-af3b-4384-aa50-d324287cb1eb",
                                "sense_id": "897e538f-859a-3632-b070-c4c9fd367923",
                                "text": "„Betroffene Patienten leiden unter Niedergeschlagenheit, Hoffnungslosigkeit, Freudlosigkeit, Interessenverlust, Antriebsmangel, häufig begleitet von Ängstlichkeit und erhöhter Müdigkeit (Hautzinger, 2011).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
