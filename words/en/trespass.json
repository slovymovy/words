{
    "word_family": [
        "trespasser",
        "trespassing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d09aac67-8e4c-32fa-b99a-d1f6b4376aa7",
                    "sense_definition": "To enter someone else's property without permission.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illegal_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The security guard warned the teenagers not to <w>trespass</w> on the private construction site.",
                            "target_lang_translations": {
                                "ru": "Охранник предупредил подростков, чтобы они не <w>проникали</w> на частную строительную площадку."
                            }
                        },
                        {
                            "text": "Signs were posted everywhere to warn visitors not to <w>trespass</w> on the farmer's land.",
                            "target_lang_translations": {
                                "ru": "Везде были развешаны знаки, предупреждающие посетителей о запрете <w>заходить</w> на землю фермера без разрешения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "trespass on property"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проникать или вторгаться во владение или частную собственность без разрешения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проникать без разрешения",
                                "target_lang_sense_clarification": "на чужую территорию"
                            },
                            {
                                "target_lang_word": "вторгаться",
                                "target_lang_sense_clarification": "в чужие владения"
                            },
                            {
                                "target_lang_word": "нарушать границы владения",
                                "target_lang_sense_clarification": "юридически"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "874f4d74-860c-3d3f-b76c-dfc2635b73cc",
                    "sense_definition": "To intrude on someone's time, patience, or kindness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intrusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to <w>trespass</w> on your valuable time, but I have a quick question.",
                            "target_lang_translations": {
                                "ru": "Я не хочу <w>злоупотреблять</w> вашим драгоценным временем, но у меня есть короткий вопрос."
                            }
                        },
                        {
                            "text": "She apologized for <w>trespassing</w> on his patience with so many requests.",
                            "target_lang_translations": {
                                "ru": "Она извинилась за то, что <w>испытывала</w> его терпение таким количеством просьб."
                            }
                        }
                    ],
                    "synonyms": [
                        "transgress"
                    ],
                    "common_phrases": [
                        "trespass on time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злоупотреблять чьим-либо временем, терпением или добротой; обременять своим присутствием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злоупотреблять",
                                "target_lang_sense_clarification": "временем, терпением"
                            },
                            {
                                "target_lang_word": "посягать",
                                "target_lang_sense_clarification": "на чужое время, покой"
                            },
                            {
                                "target_lang_word": "утруждать",
                                "target_lang_sense_clarification": "кого-либо просьбами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85082aec-611b-3dd6-817c-3e5d6548a622",
                    "sense_definition": "To commit a sin or moral offense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text warns those who <w>trespass</w> against the sacred laws of the community.",
                            "target_lang_translations": {
                                "ru": "Древний текст предостерегает тех, кто <w>преступает</w> священные законы общины."
                            }
                        },
                        {
                            "text": "He felt deep regret for the ways he had <w>trespassed</w> throughout his life.",
                            "target_lang_translations": {
                                "ru": "Он глубоко раскаивался в том, как <w>согрешал</w> на протяжении всей своей жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "transgress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in religious or formal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершать грех, проступок или нарушать моральные законы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "согрешать",
                                "target_lang_sense_clarification": "совершать грех"
                            },
                            {
                                "target_lang_word": "преступать",
                                "target_lang_sense_clarification": "заповеди, закон"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "моральные нормы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1268718-1bd8-3c71-a94d-a40c33d38c46",
                    "sense_definition": "The act of entering someone else's property without permission.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illegal_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the man for criminal <w>trespass</w> after he climbed the fence.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала мужчину за преступное <w>нарушение границ частной собственности</w> после того, как он перелез через забор."
                            }
                        },
                        {
                            "text": "The company filed a lawsuit against the protesters for <w>trespass</w> on their private grounds.",
                            "target_lang_translations": {
                                "ru": "Компания подала иск против протестующих за <w>незаконное проникновение</w> на её частную территорию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "criminal trespass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконное проникновение или вторжение во владение без разрешения владельца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарушение границ владения",
                                "target_lang_sense_clarification": "юридический термин"
                            },
                            {
                                "target_lang_word": "незаконное проникновение",
                                "target_lang_sense_clarification": "на чужую территорию"
                            },
                            {
                                "target_lang_word": "посягательство",
                                "target_lang_sense_clarification": "на чужую собственность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c75bedb-90b6-3e66-ad86-3cf9b953cbf0",
                    "sense_definition": "A sin or moral offense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prayer asks for forgiveness for all past <w>trespasses</w>.",
                            "target_lang_translations": {
                                "ru": "В молитве звучит просьба о прощении всех прошлых <w>прегрешений</w>."
                            }
                        },
                        {
                            "text": "He sought redemption for his many <w>trespasses</w> against his neighbors.",
                            "target_lang_translations": {
                                "ru": "Он искал искупления своих многочисленных <w>проступков</w> перед ближними."
                            }
                        }
                    ],
                    "synonyms": [
                        "transgress"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Commonly found in religious texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грех, моральное прегрешение или проступок против кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грех",
                                "target_lang_sense_clarification": "религиозное прегрешение"
                            },
                            {
                                "target_lang_word": "прегрешение",
                                "target_lang_sense_clarification": "моральный проступок"
                            },
                            {
                                "target_lang_word": "проступок",
                                "target_lang_sense_clarification": "нарушение правил или норм"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}