                                        "entry_id": "f3a730ae-61ed-348c-a1bd-9b03e38468fb",
                                        "glosses": [
                                            "λαϊκό εστιατόριο ελληνικής κουζίνας που συχνά προσφέρει και κρασί βαρελίσιο"
                                        ],
                                        "tags": [],
