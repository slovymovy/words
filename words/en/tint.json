{
    "word_family": [
        "tinted",
        "tinting",
        "tinter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aa29d6d9-bf8d-3ee0-b52c-8694cfd4f94f",
                    "sense_definition": "A slight or pale coloring or tinge of a color.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color_variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sky had a pink <w>tint</w> as the sun began to set over the mountains.",
                            "target_lang_translations": {
                                "ru": "Небо приобрело розовый <w>оттенок</w>, когда солнце начало садиться за горы."
                            }
                        },
                        {
                            "text": "She added a slight <w>tint</w> of blue to the white paint to make it look cooler.",
                            "target_lang_translations": {
                                "ru": "Она добавила легкий голубой <w>оттенок</w> в белую краску, чтобы она выглядела холоднее."
                            }
                        }
                    ],
                    "synonyms": [
                        "tinge",
                        "hue",
                        "shade"
                    ],
                    "common_phrases": [
                        "slight tint",
                        "pink tint",
                        "blue tint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкий или бледный оттенок цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттенок",
                                "target_lang_sense_clarification": "нюанс цвета"
                            },
                            {
                                "target_lang_word": "привкус",
                                "target_lang_sense_clarification": "едва заметный тон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fed0e3d-d09f-3041-a04b-ff51794937ba",
                    "sense_definition": "A variation of a color produced by adding white to it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_variation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In color theory, a <w>tint</w> is created by mixing a pure color with white.",
                            "target_lang_translations": {
                                "ru": "В теории цвета <w>светлый оттенок</w> создается путем смешивания чистого цвета с белым."
                            }
                        },
                        {
                            "text": "The artist used various <w>tints</w> of green to capture the light on the leaves.",
                            "target_lang_translations": {
                                "ru": "Художник использовал различные <w>оттенки</w> зеленого, чтобы передать свет на листьях."
                            }
                        }
                    ],
                    "antonyms": [
                        "shade"
                    ],
                    "common_phrases": [
                        "lighter tint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант цвета, полученный путем добавления к нему белого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбел",
                                "target_lang_sense_clarification": "художественный термин"
                            },
                            {
                                "target_lang_word": "светлый оттенок",
                                "target_lang_sense_clarification": "осветленный тон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55877c33-c8f9-34b1-b517-5d5647374821",
                    "sense_definition": "A darkened film applied to vehicle windows to provide privacy or reduce sunlight.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The celebrity arrived in a black SUV with <w>tints</w> so dark you couldn't see inside.",
                            "target_lang_translations": {
                                "ru": "Знаменитость приехала на черном внедорожнике с настолько темной <w>тонировкой</w>, что внутри ничего не было видно."
                            }
                        },
                        {
                            "text": "He decided to get dark <w>tints</w> on his new car to keep the interior cool.",
                            "target_lang_translations": {
                                "ru": "Он решил сделать темную <w>тонировку</w> на своей новой машине, чтобы в салоне было прохладно."
                            }
                        }
                    ],
                    "synonyms": [
                        "window film"
                    ],
                    "common_phrases": [
                        "dark tints",
                        "window tints"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Темная пленка, наносимая на стекла автомобиля для обеспечения приватности или защиты от солнца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонировка",
                                "target_lang_sense_clarification": "автомобильные стекла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5932c113-5b5c-3fad-a113-9e48dc96cbf2",
                    "sense_definition": "A shaded effect in engraving created by many fine parallel lines placed close together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "art_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engraver used a delicate <w>tint</w> to create the illusion of shadow on the figure's face.",
                            "target_lang_translations": {
                                "ru": "Гравер использовал тонкую <w>тушевку</w>, чтобы создать иллюзию тени на лице фигуры."
                            }
                        },
                        {
                            "text": "The old print was characterized by a fine <w>tint</w> that gave it great depth.",
                            "target_lang_translations": {
                                "ru": "Старинная гравюра отличалась тонкой <w>штриховкой</w>, придававшей ей большую глубину."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in engraving"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффект затенения в гравюре, создаваемый множеством тонких параллельных линий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тушевка",
                                "target_lang_sense_clarification": "в гравюре"
                            },
                            {
                                "target_lang_word": "фон",
                                "target_lang_sense_clarification": "штриховка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6acfc95a-0847-3652-a279-e951f29adac6",
                    "sense_definition": "To apply a small amount of color to something; to shade or color slightly.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "coloring_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>tint</w> her hair a subtle shade of red for the summer.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>тонировать</w> волосы в едва заметный рыжий оттенок на лето."
                            }
                        },
                        {
                            "text": "The sunset began to <w>tint</w> the clouds with a beautiful golden glow.",
                            "target_lang_translations": {
                                "ru": "Закат начал <w>окрашивать</w> облака красивым золотистым сиянием."
                            }
                        }
                    ],
                    "synonyms": [
                        "color",
                        "dye",
                        "tinge"
                    ],
                    "common_phrases": [
                        "tint hair",
                        "tint the glass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить небольшое количество цвета; слегка подкрашивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонировать",
                                "target_lang_sense_clarification": "придавать оттенок"
                            },
                            {
                                "target_lang_word": "подкрашивать",
                                "target_lang_sense_clarification": "слегка изменять цвет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}