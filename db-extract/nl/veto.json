                        "entry_id": "a2f0ad49-710c-308e-b081-00dffb740903",
                        "glosses": [
                            "het recht, dat aan één of meer partijen van een besluitvormende raad kan zijn verleend, om het in stemming brengen van voorstellen te verbieden of aangenomen besluiten ongeldig te verklaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd036f8-9ac5-47e9-8484-e4b3f21764a8",
                                "sense_id": "7791b5ba-9195-345e-80ca-f92bb55a8e19",
                                "text": "Een veto kon worden voorkomen door de tekst wat af te zwakken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf69990b-fdad-44a3-bb2e-c562ba0c19a7",
                        "source_entry_id": "a2f0ad49-710c-308e-b081-00dffb740903",
                        "source_sense_id": "7791b5ba-9195-345e-80ca-f92bb55a8e19",
