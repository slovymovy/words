                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd87d87-6b3a-4f6a-b1f3-548e99c458ef",
                                "sense_id": "95644163-b64b-30e1-a775-c68af0b1257f",
                                "text": "„Wir waren kaum ein paar Wochen in Deutschland, als unsere Eltern zur Behörde gingen, um unsere Existenz an das deutsche Namensrecht anzupassen.“"
                            },
                            {
                                "example_id": "7faea41d-d051-4ed5-b32f-60cbd42c47e6",
                                "sense_id": "95644163-b64b-30e1-a775-c68af0b1257f",
                                "text": "„Es ist im deutschen Namensrecht nicht erlaubt, Familiennamen als Vornamen zu benutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e7e5db70-de07-3d08-abd5-0a0d07e479b2",
