                        ],
                        "form": "carrossières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1752864c-1ae6-3513-88cd-9d58e73c932b",
                        "entry_id": "8574dc92-4c60-381d-8e9b-85c101d1d521",
                        "glosses": [
                            "Qualifiait les animaux de trait propres à tirer les carrosses."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0762ea56-2cb6-4d10-93b7-985243371068",
                                "sense_id": "1752864c-1ae6-3513-88cd-9d58e73c932b",
                                "text": "nᵒ 2 Une médaille d'argent à M. Prigent Cougard, de Plouénan (Finistère), pour sa pouliche Mystère, dont suit le signalement : espèce carrossière ; âge, deux ans; robe aubère; taille 1 m. 54; origine : père, Sénégal, demi-sang; aug. normand; […]."
                            },
                            {
                                "example_id": "2dd4da6c-3f24-445f-99ec-d6a6e1efddb4",
                                "sense_id": "1752864c-1ae6-3513-88cd-9d58e73c932b",
                                "text": "Le vieux cocher était devenu jardinier, le vicomte se chargeant de conduire lui-même et ayant vendu les carrossiers pour n'avoir plus à payer leur nourriture."
                            },
                            {
                                "example_id": "f5c71a1a-0270-4631-ba5e-3cf3a7091d03",
                                "sense_id": "1752864c-1ae6-3513-88cd-9d58e73c932b",
                                "text": "En effet, le landau des Duvillard parut enfin, avec son cocher et son valet de pied en livrée gros vert et or, un landau très correctement attelé de deux grands carrossiers superbes."
                            }
                        ]
                    },
                    {
                        "sense_id": "a47ec7e1-bf72-3814-98cc-47ef3bfc056d",
                        "entry_id": "8574dc92-4c60-381d-8e9b-85c101d1d521",
                        "glosses": [
                            "Relatif à la carrosserie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c7dfc4-23ce-4e01-ba24-2004c589d500",
                                "sense_id": "a47ec7e1-bf72-3814-98cc-47ef3bfc056d",
                                "text": "En d'autres termes un seul atelier peut rassembler des artisans de métiers différents par lesquels un produit doit passer: la manufacture carrossière réunit un grand nombre d'artisans indépendants les uns des autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c387139-bde2-4800-8498-0bf47f9f4222",
                        "source_entry_id": "8574dc92-4c60-381d-8e9b-85c101d1d521",
                        "target_lang_word": "carrocero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
