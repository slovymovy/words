                "senses": [
                    {
                        "sense_id": "5ca084f0-4aa3-3be7-b321-b2c4d651308b",
                        "entry_id": "8249002c-953c-37c2-a8a4-28967c69e845",
                        "glosses": [
                            "Qui louange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28e0556-129c-478a-972b-45760747973d",
                                "sense_id": "5ca084f0-4aa3-3be7-b321-b2c4d651308b",
                                "text": "Elle dirait à Odette, après lui avoir insinué adroitement quelques mots louangeurs pour Forcheville, comme elle avait fait si souvent pour lui : « Vous allez faire une petite place à côté de vous à M. de Forcheville. »"
                            },
                            {
                                "example_id": "eb96f029-fd4d-4127-a2a4-8439515c074c",
                                "sense_id": "5ca084f0-4aa3-3be7-b321-b2c4d651308b",
                                "text": "Léa s’était trouvée soudainement métamorphosée en femme idéale comme si elle émergeait d’une chrysalide de propos louangeurs."
                            },
                            {
                                "example_id": "e9e88680-ec5c-4b60-9c66-35cd421d5cd4",
                                "sense_id": "5ca084f0-4aa3-3be7-b321-b2c4d651308b",
                                "text": "Discours louangeur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8e7abd4-9f11-4d84-9e9b-4d22e806a281",
                        "source_entry_id": "8249002c-953c-37c2-a8a4-28967c69e845",
                        "source_sense_id": "5ca084f0-4aa3-3be7-b321-b2c4d651308b",
