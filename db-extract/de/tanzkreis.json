                ],
                "senses": [
                    {
                        "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                        "entry_id": "f566eb57-3aa6-35fc-9b36-488a09222ffa",
                        "glosses": [
                            "Gruppe von Menschen, die sich (regelmäßig) zum gemeinsamen Tanzen zusammenfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041daf9f-cc09-4510-83cf-4adf750c5a0b",
                                "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                                "text": "„Der private Reisende hat zwischen all den Töpfer- und Spinnkursen, den Musik- und Tanzkreisen, den Singwochenenden und Sommernachtsfesten kaum noch eine Chance, hier seine Ferien zu verbringen.“"
                            },
                            {
                                "example_id": "2c2773f7-eed9-487d-a3b6-d63b04e63165",
                                "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                                "text": "„Ich war Standardtänzer im Tanzkreis Orchidee und hatte mich mit meiner Partnerin alle Klassen hochgetanzt, sodass wir im Frühsommer vor dem Abi im sozialistischen Ausland tourten – dafür wurde ich sogar ein paar Wochen von der Schule freigestellt.“"
                            },
                            {
                                "example_id": "4679009e-b98e-4f54-9fe3-cd64ac34c839",
                                "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                                "text": "„Erst der Tanzkreis und die Bierduschen in der Halle, dann die Sangesrunden auf dem Rathausplatz bis 1.00 Uhr, anschließend die Fete in den VIP-Räumen der Sparkassen-Arena, wo wenige Stunden zuvor im abschließenden Saisonspiel der TBV Lemgo mit 33:29 bezwungen wurde, und schließlich die Absacker-Orgie in den Kneipen der Stadt.“"
                            },
                            {
                                "example_id": "1a6984b6-3dfb-47cb-b4c3-ec3ae56c070b",
                                "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                                "text": "„Ein Dutzend Frauen in leuchtenden Boubou-Gewändern bilden einen Tanzkreis, Kinder hüpfen dazwischen.“"
                            },
                            {
                                "example_id": "262cf34e-7c40-4ef1-86a8-cfdd503f4e32",
                                "sense_id": "6d993c7c-85e0-3163-9387-91c408074ddd",
                                "text": "„Einmal hat sie sich im Tanzkreis sehr aufregen müssen, als sich nämlich zwei deutsche Mädchen über das Aussehen der Türkinnen mokierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
