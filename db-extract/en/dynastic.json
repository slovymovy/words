                    {
                        "translation_id": "7cb19a26-dfaf-4017-a5d5-ca91cf70d4d3",
                        "source_entry_id": "8e51e8b6-7945-310a-ad75-855971f5c79f",
                        "source_sense_id": "b482c629-c5d6-38b8-aae4-c22d9743f787",
