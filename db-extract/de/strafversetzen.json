                "senses": [
                    {
                        "sense_id": "440be664-9a58-30cb-8c42-a880df2dbe35",
                        "entry_id": "abc451a5-b786-3611-872f-bd0387590aeb",
                        "glosses": [
                            "jemanden zur Bestrafung auf einen für denjenigen ungünstigeren Posten beordern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ca1328-5b6f-49f8-b8a8-37417b794502",
                                "sense_id": "440be664-9a58-30cb-8c42-a880df2dbe35",
                                "text": "„Schon in den vergangenen Wochen waren Tausende von Polizisten, Staatsanwälten und Richtern entlassen oder strafversetzt worden.“"
                            },
                            {
                                "example_id": "34f62eee-5be8-4092-8e09-d9166077cf3b",
                                "sense_id": "440be664-9a58-30cb-8c42-a880df2dbe35",
                                "text": "„Dabei soll die Kirchenleitung auch gedroht haben, den Pfarrgemeinderat abzusetzen oder den Pfarrer strafzuversetzen.“"
                            },
                            {
                                "example_id": "070de5aa-8749-4a51-b48e-2d164cf6fb87",
                                "sense_id": "440be664-9a58-30cb-8c42-a880df2dbe35",
                                "text": "„Für diese unverzeihliche Eigeninitiative wurde er in die Zentrale strafversetzt, und zwar in die Abteilung für Mitarbeitervalidierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9db6f3de-f601-3a61-8301-786f201342ec",
                        "entry_id": "abc451a5-b786-3611-872f-bd0387590aeb",
                        "glosses": [
                            "einen Schüler zur Bestrafung in eine andere Klasse oder Schule verweisen"
                        ],
                        "tags": [
                            "Erziehungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "87467ba4-e024-4f63-937e-658ef412be78",
                                "sense_id": "9db6f3de-f601-3a61-8301-786f201342ec",
                                "text": "Man versuchte, die renitente Schülerin los zu werden, indem man sie strafversetzte."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ed56b406-f840-3816-92b0-22016d10a3b2",
                        "entry_id": "abc451a5-b786-3611-872f-bd0387590aeb",
                        "glosses": [
                            "jemanden zur Bestrafung in einer Rangfolge auf einen schlechteren Rang/Position versetzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7129ce6a-2e57-43b1-a76f-2116180783fa",
                                "sense_id": "ed56b406-f840-3816-92b0-22016d10a3b2",
                                "text": "„Sollte an Vettels Auto das Getriebe getauscht werden müssen, würde der Titelverteidiger fünf Plätze nach hinten strafversetzt werden.“"
                            },
                            {
                                "example_id": "b7de46bb-aa0f-49b0-9259-c39a34d1722d",
                                "sense_id": "ed56b406-f840-3816-92b0-22016d10a3b2",
                                "text": "„Nach einem Getriebewechsel am Red Bull wurde der viermalige Formel-1-Weltmeister am Samstag in der Startaufstellung um weitere fünf Plätze nach hinten strafversetzt.“"
                            },
                            {
                                "example_id": "bdf6b0b4-f69d-498f-b1d6-429ac1cfc382",
                                "sense_id": "ed56b406-f840-3816-92b0-22016d10a3b2",
                                "text": "„Weltmeister Sebastian Vettel wird in der Startaufstellung des Großen Preises von Spanien am Sonntag […] um fünf Plätze strafversetzt und geht damit nur als 15. ins Rennen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
