                                            "expressively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9d9c862-eba3-3eb4-af33-c2ff488865df",
                                        "entry_id": "e000d61e-c4cb-3ca7-8681-69d88f8c0a6c",
                                        "glosses": [
                                            "nezřízená touha po hromadění peněz a majetku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c748ee27-63d5-441e-aee6-8a6038273d52",
                                                "sense_id": "f9d9c862-eba3-3eb4-af33-c2ff488865df",
                                                "text": "Ale sluhu Ferdinanda, když viděl ty dva zlatníky, chyt najednou mamon. Že prej ne, buď všechno, anebo nic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
