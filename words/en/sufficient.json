                    "sense_definition": "A quantity of something that is as large as is needed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We do not need any more because we already have <w>sufficient</w>.",
                            "target_lang_translations": {
                                "ru": "Нам больше не нужно, так как у нас уже есть <w>достаточно</w>.",
                                "de": "Wir brauchen nicht mehr, da wir bereits <w>genug</w> haben."
                            }
                        },
                        {
                            "text": "<w>Sufficient</w> of the committee members agreed to pass the motion.",
                            "target_lang_translations": {
                                "ru": "<w>Достаточно</w> членов комитета согласилось принять предложение.",
                                "de": "<w>Genug</w> Ausschussmitglieder stimmten zu, um den Antrag anzunehmen."
                            }
                        }
                    ],
