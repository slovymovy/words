                    {
                        "sense_id": "0d5ad0ee-d163-3cee-a96a-dbb6dabdb3e4",
                        "entry_id": "d3c32d47-90e8-32b0-9ebe-4a72d4df5c17",
                        "glosses": [
                            "Ort, an dem man an Geräten Kraft- und Ausdauersport betreiben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42485c6c-422d-4a90-8a03-6e4094a294c2",
                                "sense_id": "0d5ad0ee-d163-3cee-a96a-dbb6dabdb3e4",
                                "text": "Nach dem Weihnachtsessen nahm er sich fest vor ins Fitnessstudio zu gehen."
                            },
                            {
                                "example_id": "bce50cf1-f435-4f42-89e9-3342bb32de1b",
                                "sense_id": "0d5ad0ee-d163-3cee-a96a-dbb6dabdb3e4",
                                "text": "„Heute haben alle Mitgliedskarten von Fitnessstudios und fahren wirklich nach Island.“"
                            },
                            {
                                "example_id": "bd43b984-5b8d-49c4-9dbc-40045b05e433",
                                "sense_id": "0d5ad0ee-d163-3cee-a96a-dbb6dabdb3e4",
                                "text": "„Im Fitnessstudio sind junge Frauen in knappen Oberteilen keine Seltenheit."
                            },
                            {
                                "example_id": "ff53caec-4ddc-4559-80cd-74e5ce9d880c",
                                "sense_id": "0d5ad0ee-d163-3cee-a96a-dbb6dabdb3e4",
                                "text": "„Er geht ins Fitnessstudio, arbeitet an seinem Körper, ernährt sich gesund und ist immer auf der Suche nach Jobs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
