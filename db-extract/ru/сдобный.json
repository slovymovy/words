                "senses": [
                    {
                        "sense_id": "3de1c3d0-06ac-3361-a580-672fd1a84922",
                        "entry_id": "05258095-41b4-359c-9456-8bb3479c7014",
                        "glosses": [
                            "сдо́ба, relished, seasoned; shortened"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "8d5b0773-63e9-4fcd-8da5-08da4b0ab62f",
                                "sense_id": "3de1c3d0-06ac-3361-a580-672fd1a84922",
                                "text": "Напи́лись генера́лы ко́фею, нае́лись сдо́бных бу́лок и наде́ли мунди́ры.",
                                "translation": "Mikhail Saltykov-Shchedrin",
                                "english": "Mikhail Saltykov-Shchedrin"
                            },
                            {
                                "example_id": "19ed108f-930f-4df4-94e4-325a15f9d0ca",
                                "sense_id": "3de1c3d0-06ac-3361-a580-672fd1a84922",
                                "text": "Моско́вские калачи́ отлича́ются от ленингра́дских рецепту́рой те́ста: моско́вские не сдо́бны, а ленингра́дские сдо́бны."
                            }
                        ]
                    }
