{
    "word_family": [
        "rumble"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "75f6fd0d-87dc-3096-9860-8574a39a208c",
                    "sense_definition": "A deep low noise.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rumbling</w> of distant thunder echoed from the hilltop.",
                            "target_lang_translations": {
                                "nl": "Het <w>gerommel</w> van verre donder echode vanaf de heuveltop."
                            }
                        },
                        {
                            "text": "We heard the low <w>rumbling</w> of the train as it approached the station.",
                            "target_lang_translations": {
                                "nl": "We hoorden het lage <w>gedreun</w> van de trein terwijl deze het station naderde."
                            }
                        }
                    ],
                    "synonyms": [
                        "thunder",
                        "rumble"
                    ],
                    "common_phrases": [
                        "distant rumbling",
                        "low rumbling"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een diep, laag geluid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gerommel",
                                "target_lang_sense_clarification": "algemeen diep, laag geluid"
                            },
                            {
                                "target_lang_word": "gedreun",
                                "target_lang_sense_clarification": "zwaarder, trillend geluid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007b5bbc-5b52-3855-ad4e-8524f50e482c",
                    "sense_definition": "A muted sound of complaint or discontent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rumblings</w> of the workers suggest they are unhappy with the new policy.",
                            "target_lang_translations": {
                                "nl": "Het <w>gemor</w> van de werknemers suggereert dat ze ontevreden zijn met het nieuwe beleid."
                            }
                        },
                        {
                            "text": "There were <w>rumblings</w> of discontent among the staff after the announcement.",
                            "target_lang_translations": {
                                "nl": "Er was <w>gemor</w> van ontevredenheid onder het personeel na de aankondiging."
                            }
                        }
                    ],
                    "synonyms": [
                        "murmur",
                        "grumbling"
                    ],
                    "common_phrases": [
                        "rumblings of discontent"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een gedempt geluid van klachten of ontevredenheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gemor",
                                "target_lang_sense_clarification": "geuite ontevredenheid"
                            },
                            {
                                "target_lang_word": "gefluister",
                                "target_lang_sense_clarification": "onduidelijke geruchten of klachten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "679e7057-7f21-36de-ade4-5d01ef8be1d1",
                    "sense_definition": "Deep- and slow-sounding.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>rumbling</w> voice suited the solemn occasion.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>dreunende</w> stem paste bij de plechtige gelegenheid."
                            }
                        },
                        {
                            "text": "The <w>rumbling</w> engine indicated that the old truck needed repairs.",
                            "target_lang_translations": {
                                "nl": "De <w>rommelende</w> motor gaf aan dat de oude vrachtwagen reparaties nodig had."
                            }
                        }
                    ],
                    "synonyms": [
                        "booming",
                        "resonant"
                    ],
                    "common_phrases": [
                        "rumbling voice",
                        "rumbling engine"
                    ],
                    "target_lang_definitions": {
                        "nl": "Diep en langzaam klinkend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "dreunend",
                                "target_lang_sense_clarification": "met een diep, zwaar geluid"
                            },
                            {
                                "target_lang_word": "rommelend",
                                "target_lang_sense_clarification": "met een rollend, laag geluid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f765126a-0503-3054-87b2-29a3eef5a3b1",
                    "sense_definition": "Present participle and gerund of <w>rumble</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ground was <w>rumbling</w> beneath our feet during the earthquake.",
                            "target_lang_translations": {
                                "nl": "De grond was aan het <w>dreunen</w> onder onze voeten tijdens de aardbeving."
                            }
                        },
                        {
                            "text": "I could hear the stomach <w>rumbling</w> because I had not eaten all day.",
                            "target_lang_translations": {
                                "nl": "Ik kon mijn maag horen <w>rommelen</w> omdat ik de hele dag niet had gegeten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb rumble."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van 'rumble' (rommelen)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "rommelend",
                                "target_lang_sense_clarification": "het maken van een diep geluid"
                            },
                            {
                                "target_lang_word": "dreunend",
                                "target_lang_sense_clarification": "het produceren van een zware trilling"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}