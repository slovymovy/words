    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "a48f59c7-c684-3d3f-ac01-7f1999943d65",
                    "sense_definition": "Фонетический вариант предлога <w>с</w>, употребляемый для благозвучия перед словами, начинающимися с определённых сочетаний согласных.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я хочу пойти в кино <w>со</w> своим лучшим другом.",
                            "target_lang_translations": {
                                "en": "I want to go to the cinema <w>with</w> my best friend.",
                                "pl": "Chcę pójść do kina <w>ze</w> swoim najlepszym przyjacielem."
                            }
                        },
                        {
                            "text": "Ситуация в стране обязательно улучшится <w>со</w> временем.",
                            "target_lang_translations": {
                                "en": "The situation in the country will definitely improve <w>with</w> time.",
                                "pl": "Sytuacja w kraju z pewnością poprawi się <w>z</w> czasem."
                            }
                        }
                    ],
                    "antonyms": [
                        "безо",
                        "на"
                    ],
                    "common_phrases": [
                        "со временем",
                        "со страху",
                        "со стороны",
                        "со дня на день"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "phonetic variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Phonetic variant of the preposition 's', used for euphony before words starting with certain consonant clusters.",
                        "pl": "Wariant fonetyczny przyimka „с”, używany przed niektórymi zbitkami spółgłoskowymi dla ułatwienia wymowy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "with",
                                "target_lang_sense_clarification": "accompaniment or interaction"
                            },
                            {
                                "target_lang_word": "from",
                                "target_lang_sense_clarification": "origin, source, or cause"
                            },
                            {
                                "target_lang_word": "off",
                                "target_lang_sense_clarification": "movement away from a surface"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "ze",
                                "target_lang_sense_clarification": "towarzyszenie lub pochodzenie"
                            },
                            {
                                "target_lang_word": "z",
                                "target_lang_sense_clarification": "forma podstawowa przyimka"
                            }
                        ]
                    }
                }
            ]
        },
