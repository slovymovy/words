                                        "entry_id": "a46eb2a1-ccd9-3019-9bcd-6ccb96f3480d",
                                        "glosses": [
                                            "gebruikelijke vorm van straffen volgens de sharia en in het oude testament, het stenigen d.w.z. met stenen doden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2b5a52-c2d7-44da-9dc9-2fc40e4ebb8e",
                                                "sense_id": "08fb0a5c-bb09-3642-92be-ec65137d4db6",
                                                "text": "Als Afghanistan steniging opnieuw invoert als sanctie op overspel, heeft dat gevolgen voor de relatie van Nederland met dat land"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42f22d9d-573f-414e-8e7e-1c88d7a0400a",
                        "source_entry_id": "878e13d7-7eeb-3fdb-80fd-a5b71b62acbe",
                        "source_sense_id": "c4bca3db-bf39-335e-a009-3768da94e927",
                        "source_sense_description": "act of stoning, sometimes to the point of death",
                        "target_lang_word": "lapidation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lapidation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                                        "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                                        "glosses": [
                                            "Action de lapider."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e77d8889-f9bc-48e1-a2c6-82321571e43e",
                                                "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                                                "text": "Lapidé ! Nahoum voyait juste. Ma singularité, mon opposition au Temple, cela me conduirait à la lapidation"
                                            },
                                            {
                                                "example_id": "3ed2ceff-3c80-4460-99da-763a60675fc9",
                                                "sense_id": "0c13a80a-e9c6-32a4-b590-a2ece1ba17e9",
                                                "text": "En 2007, un mémoire, présenté à la commission Bouchard-Taylor, par Bernard Thompson et son acolyte André Drouin, stipulait notamment qu’il était indésirable de tuer les femmes par lapidation ou de les brûler vives à Hérouxville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9024a26-f1d1-371c-ad76-fd3bb91ec018",
                                        "entry_id": "ba8db891-dbd5-3a5f-be03-5ad1f3928c26",
                                        "glosses": [
                                            "Représentation artistique d’une lapidation."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb430bda-d666-43b9-ac33-c4d537494f21",
                                                "sense_id": "b9024a26-f1d1-371c-ad76-fd3bb91ec018",
                                                "text": "Pour dénoncer l’oppression des femmes, elle avait peint une lapidation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de6f6070-e9b5-4054-910e-f3036de6876e",
                        "source_entry_id": "878e13d7-7eeb-3fdb-80fd-a5b71b62acbe",
                        "source_sense_id": "c4bca3db-bf39-335e-a009-3768da94e927",
                        "source_sense_description": "act of stoning, sometimes to the point of death",
                        "target_lang_word": "Steinigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed6ac1f0-df1d-3055-8f2d-025f61180d4f",
                                        "entry_id": "18449bca-dbef-3970-b269-dfd8652f7a37",
                                        "glosses": [
                                            "Bewurf mit Steinen bis zum Tod"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97db1706-7e49-4977-a06d-942d867a2695",
                                                "sense_id": "ed6ac1f0-df1d-3055-8f2d-025f61180d4f",
                                                "text": "Die Steinigung war im Mittelalter eine grausame Todesstrafe."
                                            },
                                            {
                                                "example_id": "070e1076-9a64-4bed-9e5b-0385131b48e6",
                                                "sense_id": "ed6ac1f0-df1d-3055-8f2d-025f61180d4f",
                                                "text": "Heute findet die Steinigung noch in bestimmten islamisch geprägten Regionen und Ländern Anwendung."
                                            },
                                            {
                                                "example_id": "2d7253e0-4c02-4c46-ac44-ce4d490c6382",
                                                "sense_id": "ed6ac1f0-df1d-3055-8f2d-025f61180d4f",
                                                "text": "„Gelegentlich werden sie sogar verdächtigt, dass sie mit den Taliban, den Mullahs oder mit den Ultraorthodoxen sympathisieren und womöglich sogar Prügelstrafen oder Steinigungen klammheimlich in Kauf nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
