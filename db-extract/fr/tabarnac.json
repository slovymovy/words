                        "glosses": [
                            "Substantif : personne méritant la colère ou l’indignation."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "4b756f3e-4a10-46e5-add7-93a5444c1731",
                                "sense_id": "f698368c-0fe1-3642-9f12-02678cad42b8",
                                "text": "Veux-tu pas courir de même ! Mon p’tit tabarnac, si j’te pogne, tu vas avoir affaire à moé ! Arrête de courir ! Arrête de courir, tu vas te tuer !"
                            }
                        ]
                    }
