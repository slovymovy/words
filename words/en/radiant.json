{
    "word_family": [
        "radiance",
        "radiancy",
        "radiate",
        "radiation",
        "radiator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "903da255-f5de-375a-94b7-4d199975c324",
                    "sense_definition": "Beaming with vivacity and happiness",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a <w>radiant</w> smile after hearing the good news.",
                            "target_lang_translations": {
                                "ru": "У неё была <w>сияющая</w> улыбка после того, как она услышала хорошие новости."
                            }
                        },
                        {
                            "text": "The bride looked absolutely <w>radiant</w> on her wedding day.",
                            "target_lang_translations": {
                                "ru": "В день своей свадьбы невеста выглядела совершенно <w>светящейся от счастья</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "beaming",
                        "joyful",
                        "glowing"
                    ],
                    "antonyms": [
                        "miserable",
                        "gloomy"
                    ],
                    "common_phrases": [
                        "radiant smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светящийся от счастья, выражающий бурную радость и оживление"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "от счастья или радости"
                            },
                            {
                                "target_lang_word": "лучезарный",
                                "target_lang_sense_clarification": "о взгляде, улыбке или человеке"
                            },
                            {
                                "target_lang_word": "светящийся",
                                "target_lang_sense_clarification": "от переполняющих радостных чувств"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9dcce4a-776f-369d-b170-c5e679e34103",
                    "sense_definition": "Strikingly beautiful",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked <w>radiant</w> in her elegant evening gown.",
                            "target_lang_translations": {
                                "ru": "Она выглядела <w>ослепительно</w> в своём элегантном вечернем платье."
                            }
                        },
                        {
                            "text": "The garden was filled with <w>radiant</w> flowers in full bloom.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>великолепных</w> цветущих цветов."
                            }
                        }
                    ],
                    "synonyms": [
                        "stunning",
                        "gorgeous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ослепительно красивый, великолепный и притягательный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "поражающий красотой"
                            },
                            {
                                "target_lang_word": "великолепный",
                                "target_lang_sense_clarification": "о внешнем виде или красоте"
                            },
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "красотой, цветущий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61af7fce-7cd8-36d9-bab7-cdb5d9a9cd0e",
                    "sense_definition": "Radiating light or heat",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>radiant</w> sun warmed the cold ground quickly.",
                            "target_lang_translations": {
                                "ru": "<w>Лучистое</w> солнце быстро согрело холодную землю."
                            }
                        },
                        {
                            "text": "We felt the <w>radiant</w> heat from the large fireplace.",
                            "target_lang_translations": {
                                "ru": "Мы почувствовали <w>лучистое</w> тепло от большого камина."
                            }
                        }
                    ],
                    "synonyms": [
                        "shining",
                        "bright",
                        "luminous"
                    ],
                    "common_phrases": [
                        "radiant heat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучающий свет или тепло"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лучистый",
                                "target_lang_sense_clarification": "излучающий свет или тепловую энергию"
                            },
                            {
                                "target_lang_word": "светящийся",
                                "target_lang_sense_clarification": "излучающий свет"
                            },
                            {
                                "target_lang_word": "лучеиспускательный",
                                "target_lang_sense_clarification": "физ., о передаче тепла или энергии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8840dc1f-864f-3bf8-9b52-6ea9e96fad84",
                    "sense_definition": "The apparent origin in the night sky of a meteor shower",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>radiant</w> of the Perseid meteor shower is in the constellation Perseus.",
                            "target_lang_translations": {
                                "ru": "<w>Радиант</w> метеорного потока Персеиды находится в созвездии Персея."
                            }
                        },
                        {
                            "text": "Observers tracked the <w>radiant</w> to predict where the meteors would appear.",
                            "target_lang_translations": {
                                "ru": "Наблюдатели отслеживали <w>радиант</w>, чтобы предсказать, где появятся метеоры."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущаяся точка на небесной сфере, из которой вылетают метеоры во время метеорного потока"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радиант",
                                "target_lang_sense_clarification": "астрономический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}