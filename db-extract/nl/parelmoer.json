                                "target_senses": [
                                    {
                                        "sense_id": "e4ea77a7-0ba5-3b3a-9a6f-0527bd96c7d3",
                                        "entry_id": "c2cf76df-5062-3b92-9fe8-ee210e86abaa",
                                        "glosses": [
                                            "A shellfish which contains mother-of-pearl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "445a3339-a7f7-4ddc-9973-4d744cfaa381",
                                                "sense_id": "e4ea77a7-0ba5-3b3a-9a6f-0527bd96c7d3",
                                                "text": "The shell-fish called a Nacre, liveth even so with the Pinnotere, which is a little creature like unto a Crabfish[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2fb5fa-4585-3bfc-93d1-2582ab156f0a",
                                        "entry_id": "c2cf76df-5062-3b92-9fe8-ee210e86abaa",
                                        "glosses": [
                                            "A pearly substance made mainly of stacked layers of aragonite and organic matter which lines the interior of many shells; mother-of-pearl."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "027f7d04-5efd-434c-b0f4-626cb5b2c260",
                                                "sense_id": "ca2fb5fa-4585-3bfc-93d1-2582ab156f0a",
                                                "text": "On a little table of dark perfumed wood thickly encrusted with nacre, […]was lying a note from Lord Henry, and beside it was a book bound in yellow paper, the cover slightly torn and the edges soiled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
