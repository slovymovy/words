                "senses": [
                    {
                        "sense_id": "b8bbce82-e882-30f9-89d3-81b61abde096",
                        "entry_id": "a79dec59-2464-3d8d-b977-344863b485a3",
                        "glosses": [
                            "ein Viertel oder Teil einer Stadt, welches/-r in der Altstadt liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc5d23f6-7d1a-4062-b77f-b36147676966",
                                "sense_id": "b8bbce82-e882-30f9-89d3-81b61abde096",
                                "text": "Wir kennen das Altstadtquartier als begehrtes Wohngebiet mit reichem kulturellem Angebot und einem sehr eigenen Charme."
                            },
                            {
                                "example_id": "e2b000be-dbc6-4f7d-a45f-e37e7ec3b215",
                                "sense_id": "b8bbce82-e882-30f9-89d3-81b61abde096",
                                "text": "»Ihre Entwürfe zum Frankfurter Altstadtquartier haben eine Debatte über zeitgemäßes Bauen losgetreten. Hat Sie das überrascht?«"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c27af72a-d668-35d5-ab24-c7fccdc03146",
                        "entry_id": "a79dec59-2464-3d8d-b977-344863b485a3",
                        "glosses": [
                            "ein Viertel oder Teil einer Stadt, welches/-r in der Altstadt liegt",
                            "die gesamten Einwohner, Bewohner eines Quartiers^([1])"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c0800e37-8a2c-40bb-acd3-07ce85a0b621",
                                "sense_id": "c27af72a-d668-35d5-ab24-c7fccdc03146",
                                "text": "Das ganze Altstadtquartier hat gegen den Abriss des alten Fachwerkhauses gekämpft und demonstriert."
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "9da09f3c-bb57-3199-b561-ed6ef7045e77",
                        "entry_id": "a79dec59-2464-3d8d-b977-344863b485a3",
                        "glosses": [
                            "ein Häuserblock innerhalb der Altstadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b615a0c-ca20-4838-9aba-a60995d8cc19",
                                "sense_id": "9da09f3c-bb57-3199-b561-ed6ef7045e77",
                                "text": "Die Rekonstruktion der historischen Altstadtquartiere am Dresdner Neumarkt stößt auf sehr viel Gegenliebe und lockt zahlreiche Besucher in die sächsische Hauptstadt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8161649b-10d6-34f6-92c8-80c4e883db48",
                        "entry_id": "a79dec59-2464-3d8d-b977-344863b485a3",
                        "glosses": [
