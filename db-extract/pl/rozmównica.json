                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d9834c-51e5-4802-80f6-5caa4ce5cddf",
                                "sense_id": "03db4a28-6387-3d91-aada-f8c7399ffb7e",
                                "text": "Przekazanie ostrzeżenia o zbliżającej się przeszkodzie przez rozmównicę pokładową okazało się niemożliwe."
