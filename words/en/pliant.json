{
    "word_family": [
        "pliability",
        "pliancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "604078cb-7e19-3a2f-bbdf-35f5aa8a2d57",
                    "sense_definition": "Capable of bending or being bent easily without breaking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basket was woven from <w>pliant</w> willow branches.",
                            "target_lang_translations": {
                                "zh": "这个篮子是用<w>柔韧</w>的柳条编织而成的。"
                            }
                        },
                        {
                            "text": "She used <w>pliant</w> wire to create the intricate sculpture.",
                            "target_lang_translations": {
                                "zh": "她用<w>易弯曲</w>的金属丝制作了那件复杂的雕塑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flexible",
                        "pliable",
                        "lithe",
                        "limber",
                        "plastic"
                    ],
                    "antonyms": [
                        "rigid",
                        "stiff"
                    ],
                    "common_phrases": [
                        "pliant material",
                        "pliant branches"
                    ],
                    "target_lang_definitions": {
                        "zh": "指物体容易弯曲而不易折断的，即柔韧的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "柔韧",
                                "target_lang_sense_clarification": "形容物体既柔软又有韧性，不易折断。"
                            },
                            {
                                "target_lang_word": "易弯曲",
                                "target_lang_sense_clarification": "描述物理性质，指容易改变形状。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ecd4b276-c72d-32a8-b262-5251aba9ae62",
                    "sense_definition": "Easily influenced, controlled, or persuaded by others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavioral_flexibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader sought a <w>pliant</w> advisor who would never question his decisions.",
                            "target_lang_translations": {
                                "zh": "这位领导寻找的是一位<w>顺从</w>的顾问，这样就不会有人质疑他的决定。"
                            }
                        },
                        {
                            "text": "He found the new employee to be quite <w>pliant</w> and eager to follow instructions.",
                            "target_lang_translations": {
                                "zh": "他发现这位新员工非常<w>顺从</w>，而且很乐意听从指示。"
                            }
                        }
                    ],
                    "antonyms": [
                        "stubborn",
                        "obstinate"
                    ],
                    "common_phrases": [
                        "pliant mind",
                        "pliant nature"
                    ],
                    "target_lang_definitions": {
                        "zh": "指人的性格容易受他人影响、控制或说服，即顺从的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "顺从",
                                "target_lang_sense_clarification": "形容人听话，容易被他人左右。"
                            },
                            {
                                "target_lang_word": "易受影响",
                                "target_lang_sense_clarification": "指人的意志不坚定，容易被他人改变想法。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}