                                "target_lang_word": "диапазон",
                                "target_lang_sense_clarification": "музыкальный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ses aralığı",
                                "target_lang_sense_clarification": "müzikte ton dizisi"
                            },
                            {
                                "target_lang_word": "diyapazon",
                                "target_lang_sense_clarification": "müzikal ses sınırı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "音域",
                                "target_lang_sense_clarification": "音乐术语，指声音的高低范围"
                            }
                        ]
                    }
