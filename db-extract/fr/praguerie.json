                "senses": [
                    {
                        "sense_id": "99dcf630-1279-3b3f-a6c6-0be9ab6a15ae",
                        "entry_id": "2d1a2bb8-5254-3b16-8e69-98d8b4442313",
                        "glosses": [
                            "Fronde nobiliaire, jacquerie ayant eu lieu sous le règne de Charles VII de France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "550b9294-334d-491e-bb6c-14a6f3bad243",
                                "sense_id": "99dcf630-1279-3b3f-a6c6-0be9ab6a15ae",
                                "text": "Après l’entrée de Charles VII à Paris, avait éclaté un soulèvement de grandes compagnies et de paysans, une praguerie, comme on le disait alors à cause de révoltes des Bohémiens qu’avaient suscitées Jean Hus et Jérôme de Prague."
                            },
                            {
                                "example_id": "197bf71e-9d6e-499f-b027-c586dcfee5e6",
                                "sense_id": "99dcf630-1279-3b3f-a6c6-0be9ab6a15ae",
                                "text": "La province estoit remplie de volleries, pragueries et autres sortes d'insolences."
                            },
                            {
                                "example_id": "986dc383-a7ba-43e6-9cb1-0e28978a66ae",
                                "sense_id": "99dcf630-1279-3b3f-a6c6-0be9ab6a15ae",
                                "text": "Les partisans de la praguerie étaient nommés pragons."
                            }
                        ]
                    }
