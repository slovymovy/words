                "senses": [
                    {
                        "sense_id": "f4ec50d9-fd0d-385b-bab0-6c538acec2e3",
                        "entry_id": "d7127f0e-36c7-3537-8b00-a9244161aa84",
                        "glosses": [
                            "Verkaufsstand"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "100e73f2-6712-448c-a531-1b9e556b0e4f",
                                "sense_id": "f4ec50d9-fd0d-385b-bab0-6c538acec2e3",
                                "text": "Bei diesem Standl sehen die Orangen am besten aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b651a65-6e0e-4522-8beb-4333702df719",
                        "source_entry_id": "d7127f0e-36c7-3537-8b00-a9244161aa84",
                        "source_sense_id": "f4ec50d9-fd0d-385b-bab0-6c538acec2e3",
                        "source_sense_description": "bayrisch, österreichisch: Verkaufsstand",
                        "target_lang_word": "étal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14782fc0-1e6b-3916-9d19-d1a700e861c3",
                                        "entry_id": "2a2ab5ae-70dd-3ee1-830b-d0f2a8e0b074",
                                        "glosses": [
                                            "Sorte de table sur laquelle les bouchers débitent la viande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6223bb7-4fbc-48b2-aa6c-3f1cf5875912",
                                                "sense_id": "14782fc0-1e6b-3916-9d19-d1a700e861c3",
                                                "text": "— N'aimez-vous point que l'on vous peigne? s'est-il enquis d'un ton rogue en voyant mon sourire faiblir après qu'il m’eut dévisagée comme un morceau de viande posé sur l’étal du boucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a63335e1-4dd1-347c-9db3-179701818c36",
                                        "entry_id": "2a2ab5ae-70dd-3ee1-830b-d0f2a8e0b074",
                                        "glosses": [
                                            "Table où sont exposées les marchandises dans un marché public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb3a25ea-6304-42fe-bdb5-6160aeabc9d9",
                                                "sense_id": "a63335e1-4dd1-347c-9db3-179701818c36",
                                                "text": "Des ménagères comméraient devant les vendeurs, dont les bourgerons bleus dominaient l’entassement des poissons nacrés, luisants, sur les étals."
                                            },
                                            {
                                                "example_id": "4e994a14-b30c-4d57-a8b9-6ca70740b952",
                                                "sense_id": "a63335e1-4dd1-347c-9db3-179701818c36",
                                                "text": "À six ans, les jours de marché, je volais à l’étal du poissonnier un hareng, et mon grand jeu était de poursuivre les filles pour frotter leurs jambes nues avec mon poisson."
                                            },
                                            {
                                                "example_id": "398b6943-d12d-46bd-a1c6-ae2ea97b6f98",
                                                "sense_id": "a63335e1-4dd1-347c-9db3-179701818c36",
                                                "text": "Ali et moi déambulons sous le tablier du métro aérien qui abrite, entre les étals du marché, les bicraves, les petits trafics du trabendo […]"
                                            },
                                            {
                                                "example_id": "496380cf-fbf2-4d0a-afd5-45228a5b35fa",
                                                "sense_id": "a63335e1-4dd1-347c-9db3-179701818c36",
                                                "text": "il participait du paysage en général, au même titre que la pierre, les arbres, les urinoirs, bordels, pavillons de viandes, étaux de fleuristes et autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "defcbce7-db0b-3b5d-ab21-46966ffb3723",
                                        "entry_id": "2a2ab5ae-70dd-3ee1-830b-d0f2a8e0b074",
                                        "glosses": [
                                            "Boutique même où l’on vend de la viande."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0738f508-ba7d-4894-9504-acc7bcd81105",
                                                "sense_id": "defcbce7-db0b-3b5d-ab21-46966ffb3723",
                                                "text": "Tout étalier qui voudra s'établir ne pourra le faire qu'en laissant cinq étaux entre son établissement et ceux des bouchers chez lesquels il aura travaillé pendant deux mois, à moins que ce ne soit depuis plus d'un an."
                                            },
                                            {
                                                "example_id": "9121cfa4-398c-4d0f-bbb5-aed572c6dbea",
                                                "sense_id": "defcbce7-db0b-3b5d-ab21-46966ffb3723",
                                                "text": "Plus de 100 bouchers firent faillite ; et la valeur des étaux, qui était au moins de 25.000 fr. en moyenne, avant l'ordonnance, fut entièrement anéantie ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4181ccd7-e4b4-4f85-a098-5bd75dba01d2",
                        "source_entry_id": "d7127f0e-36c7-3537-8b00-a9244161aa84",
                        "source_sense_id": "f4ec50d9-fd0d-385b-bab0-6c538acec2e3",
                        "source_sense_description": "bayrisch, österreichisch: Verkaufsstand",
                        "target_lang_word": "stand",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2cf1ac41-cf48-380a-b47d-3b5e4a6e2ebd",
                                        "entry_id": "e570f4cf-ce34-3188-824e-3248f8ecd90a",
                                        "glosses": [
                                            "Lieu disposé pour le tir sportif."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fb8a01f-ac82-4f94-8bd0-53ee5c18ddcd",
                                                "sense_id": "2cf1ac41-cf48-380a-b47d-3b5e4a6e2ebd",
                                                "text": "Il venait de recevoir une balle. Et n’allait pas tarder à en prendre d’autres, s’il restait ainsi à découvert. Il se propulsa derrière cette grosse roche qui lui tendait les bras. Des tirs ricochèrent contre les parois, le danger arrivait de toutes parts. De temps en temps, quelques Apaches surgissaient de la grotte, mais ils étaient aussitôt abattus une fois dehors. C’était un véritable jeu de massacre, comme dans un stand de tir d’une macabre fête foraine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d285ad5-350a-3c00-a294-8ed8ef0fb0b1",
                                        "entry_id": "e570f4cf-ce34-3188-824e-3248f8ecd90a",
                                        "glosses": [
                                            "Partie réservée à l’étalage d’un produit ou des produits d’une même maison de commerce dans une exposition commerciale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2763707-9263-4134-b3c6-6cc7200abb47",
                                                "sense_id": "6d285ad5-350a-3c00-a294-8ed8ef0fb0b1",
                                                "text": "Puis ce fut le Salon de l’Aéronautique. La recordwoman du monde est, bien entendu, la fée du stand Caudron-Renault."
                                            },
                                            {
                                                "example_id": "b320f926-773c-45f5-ad1b-de580605bf01",
                                                "sense_id": "6d285ad5-350a-3c00-a294-8ed8ef0fb0b1",
                                                "text": "Sur le trottoir, devant l’école primaire, tous les après-midi, un groupe de six à huit femmes installait un stand de petites tables bancales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756ca7e7-adf9-3c1a-9a20-0a1f6d036e7a",
                                        "entry_id": "e570f4cf-ce34-3188-824e-3248f8ecd90a",
                                        "glosses": [
                                            "Tablette ou support pour machine de bureau, clavier musical ou instrument de musique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a111b3de-04b6-40b8-80a3-8624fc8e725c",
                                                "sense_id": "756ca7e7-adf9-3c1a-9a20-0a1f6d036e7a",
                                                "text": "Le clavier est livré avec son stand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d1d75dc-4444-3261-b8ce-9a4d5afdc2c2",
                                        "entry_id": "e570f4cf-ce34-3188-824e-3248f8ecd90a",
                                        "glosses": [
                                            "Garage pour l’arrêt ravitaillement pendant une course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea27dd77-0eff-4072-98a7-23e0aa829724",
                                                "sense_id": "1d1d75dc-4444-3261-b8ce-9a4d5afdc2c2",
                                                "text": "Red Bull a battu le record de l'arrêt aux stands le plus rapide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7237b1ae-382b-32b5-97f3-fc189fe216fa",
                                        "entry_id": "e570f4cf-ce34-3188-824e-3248f8ecd90a",
                                        "glosses": [
                                            "Petit commerce dans une foire ou une exposition n’offrant le plus souvent qu’un type de produits à la consommation finale et directe, sinon très peu de choix possibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcc21b5-d187-4a94-9672-fe6a566e839d",
                                                "sense_id": "7237b1ae-382b-32b5-97f3-fc189fe216fa",
                                                "text": "Et là, c'est à la fête foraine... Ma mère adore que je l'emmène aux stands de loterie."
                                            },
                                            {
                                                "example_id": "c7fe61b7-85f2-4baa-befc-7a33fd95a615",
                                                "sense_id": "7237b1ae-382b-32b5-97f3-fc189fe216fa",
                                                "text": "Souvent caricaturés en peuple discipliné, les Allemands ont les pires difficultés à reproduire les efforts consentis au printemps. Les stands de vin chaud, une tradition avant les Fêtes, attirent dans les rues des foules compactes."
                                            },
                                            {
                                                "example_id": "f5b64c20-52f9-4cb7-a358-983989622c0c",
                                                "sense_id": "7237b1ae-382b-32b5-97f3-fc189fe216fa",
                                                "text": "Les deux enfants ambitieux auraient tenu à plusieurs reprises des stands de limonade, mais aussi de pâtisseries, pour lever de l’argent pour leur sœur aînée et acheter éventuellement une moto tout-terrain et un quatre-roues, pour suivre les enfants d’autres voisins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
