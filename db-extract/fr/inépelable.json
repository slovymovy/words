                                        "entry_id": "36d7cae2-5346-314c-a51b-4f56a0e76c68",
                                        "glosses": [
                                            "Difficult or impossible to spell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276ef0e0-9f8d-4cb1-9fe1-0fc9857b27d5",
                                                "sense_id": "6a1e02d2-ef5d-3ab9-aeda-6dcd2976bde9",
                                                "text": "His masters, the Houyhnhnms of the unspellable and unsayable name, were more than performing horses or uncultured squires."
                                            },
                                            {
                                                "example_id": "62edfdfc-f2fc-46da-a765-da8fa7730f8f",
                                                "sense_id": "6a1e02d2-ef5d-3ab9-aeda-6dcd2976bde9",
                                                "text": "Their children, with unpronounceable, unspellable names, came to school in tattered clothes, the boys in drab vests and the girls in more colorful ones."
                                            }
                                        ]
                                    }
                                ]
                            }
