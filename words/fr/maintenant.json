                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois partir <w>maintenant</w> pour ne pas rater mon train.",
                            "target_lang_translations": {
                                "en": "I have to leave <w>now</w> so I don't miss my train.",
                                "ru": "Мне нужно уходить <w>сейчас</w>, чтобы не опоздать на поезд.",
                                "nl": "Ik moet <w>nu</w> weg om mijn trein niet te missen.",
                                "de": "Ich muss <w>jetzt</w> gehen, damit ich meinen Zug nicht verpasse.",
                                "pl": "Muszę <w>teraz</w> iść, żeby nie spóźnić się na pociąg.",
                                "it": "Devo partire <w>adesso</w> per non perdere il treno.",
                                "cs": "Musím <w>teď</w> odejít, abych nezmeškal vlak.",
                                "tr": "Trenimi kaçırmamak için <w>şimdi</w> gitmem gerekiyor.",
                                "es": "Tengo que irme <w>ahora</w> para no perder el tren.",
                                "zh": "我<w>现在</w>得走了，免得误了火车。"
                            }
                        },
                        {
                            "text": "Il faut agir dès <w>maintenant</w> pour régler cette situation.",
                            "target_lang_translations": {
                                "en": "We need to act right <w>now</w> to resolve this situation.",
                                "ru": "Нужно действовать уже <w>сейчас</w>, чтобы урегулировать эту ситуацию.",
                                "nl": "We moeten <w>nu</w> al handelen om deze situatie op te lossen.",
                                "de": "Wir müssen schon <w>jetzt</w> handeln, um diese Situation in den Griff zu bekommen.",
                                "pl": "Trzeba działać już <w>teraz</w>, żeby uporać się z tą sytuacją.",
                                "it": "Bisogna agire fin da <w>adesso</w> per risolvere questa situazione.",
                                "cs": "Je třeba jednat už <w>teď</w>, abychom tuto situaci vyřešili.",
                                "tr": "Bu durumu çözmek için <w>şimdiden</w> harekete geçmek gerekiyor.",
                                "es": "Hay que actuar desde <w>ahora</w> mismo para resolver esta situación.",
                                "zh": "要解决这个问题，我们<w>现在</w>就得行动。"
                            }
                        }
