{
    "word_family": [
        "banger",
        "banging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c3ec27a-7888-30e4-9f92-1c3a1d7ae25c",
                    "sense_definition": "To make a sudden, loud, explosive noise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noise_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fireworks <w>banged</w> and crackled in the night sky.",
                            "target_lang_translations": {
                                "ru": "Фейерверки <w>грохотали</w> и трещали в ночном небе.",
                                "zh": "烟花在夜空中<w>砰砰</w>作响，噼啪作响。"
                            }
                        },
                        {
                            "text": "My car engine started to <w>bang</w> loudly on the highway.",
                            "target_lang_translations": {
                                "ru": "Двигатель моей машины начал громко <w>стучать</w> на шоссе.",
                                "zh": "我的汽车引擎在高速公路上开始<w>砰砰</w>作响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boom",
                        "explode",
                        "thunder",
                        "clap",
                        "crack"
                    ],
                    "common_phrases": [
                        "bang away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать резкий, громкий, взрывной звук.",
                        "zh": "发出突然、响亮、爆炸性的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грохотать",
                                "target_lang_sense_clarification": "издавать громкий шум"
                            },
                            {
                                "target_lang_word": "бабахать",
                                "target_lang_sense_clarification": "разг. издавать звук взрыва"
                            },
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "издавать повторяющийся шум (о механизме)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨响",
                                "target_lang_sense_clarification": "发出巨大的声响"
                            },
                            {
                                "target_lang_word": "砰砰作响",
                                "target_lang_sense_clarification": "发出连续的撞击声"
                            }
                        ]
                    }
                },
                {
