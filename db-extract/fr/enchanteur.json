            {
                "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                "word": "enchanteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ef39839a-2712-4933-80b7-b3205668dbbd",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "tags": [
                            "plural"
                        ],
                        "form": "enchanteurs"
                    },
                    {
                        "form_id": "5e9ae7db-aee1-4897-9d63-9839a92c017a",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "enchanteresse"
                    },
                    {
                        "form_id": "de62ac8b-1411-4015-a079-2f7de0da31af",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "tags": [
                            "feminine"
                        ],
                        "form": "enchanteuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33a7508a-1c1f-3679-b472-eddf4dab7656",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "glosses": [
                            "Personne qui est réputée pratiquer des enchantements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb3aa0a1-8089-4888-a516-3a2ca7e69f0e",
                                "sense_id": "33a7508a-1c1f-3679-b472-eddf4dab7656",
                                "text": "Sur les tréteaux l'arlequin blême\nSalue d'abord les spectateurs\nDes sorciers venus de Bohême\nQuelques fées et les enchanteurs."
                            },
                            {
                                "example_id": "0247ff61-223a-4d3a-8d54-32976f3c6796",
                                "sense_id": "33a7508a-1c1f-3679-b472-eddf4dab7656",
                                "text": "Les enchanteurs s'évanouirent frappés à mort, et je vis de loin leurs livres de magie brûler comme une torche dans le noir clocher."
                            }
                        ]
                    },
                    {
                        "sense_id": "20b9e0a6-ec95-3023-8df1-97613680b665",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "glosses": [
                            "Personne dont le beau langage, les manières séduisantes peuvent charmer, tromper."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "45039033-ef5a-4b3d-81b4-c657c239c2da",
                                "sense_id": "20b9e0a6-ec95-3023-8df1-97613680b665",
                                "text": "[…] ; et plus vous vous étendrez sur votre passion, plus il se hâtera de la terminer par la mort de la belle enchanteresse ; […]."
                            },
                            {
                                "example_id": "e9f86ff7-f4a7-4124-b962-3831b6428442",
                                "sense_id": "20b9e0a6-ec95-3023-8df1-97613680b665",
                                "text": "Comme un jeune premier qui s'éveille dans le jardin d'une magicienne, je faillis soupirer : « Où suis-je ? » car mon enchanteresse demeurait immobile et je ne savais pas bien où j'étais entré."
                            }
                        ]
                    },
                    {
                        "sense_id": "466b6da3-6ab6-3b0f-ae84-6b15c8e92b5e",
                        "entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "glosses": [
                            "Celui dont l’astuce et l’ingéniosité le rendent comparable à un magicien dans ses talents et inventions."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ede8ad-ce62-4454-8866-508a40594a0f",
                                "sense_id": "466b6da3-6ab6-3b0f-ae84-6b15c8e92b5e",
                                "text": "Le Mage Dédale et Icare, son fils, ont été enfermés dans le Labyrinthe de Crète par Minos, roi de l’Île, qui redoute le pouvoir de l’Enchanteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2fc0862-301c-4af9-93fe-ccd9143a3a16",
                        "source_entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "target_lang_word": "enchanter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchanter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f54c75e0-2a0a-3894-87a2-2f4d6205a006",
                                        "entry_id": "6ab899de-5aec-3984-881c-5e358d52c89b",
                                        "glosses": [
                                            "One who enchants or delights."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224584ee-11a0-4b07-8b9d-d376965cb3a7",
                                                "sense_id": "f54c75e0-2a0a-3894-87a2-2f4d6205a006",
                                                "text": "Robert Morse brings back to life the author, wit, bon vivant, self-pitier and true enchanter that was Truman Capote in this Tony-winning one-man performance […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                        "entry_id": "6ab899de-5aec-3984-881c-5e358d52c89b",
                                        "glosses": [
                                            "A spellcaster, conjurer, wizard, sorcerer or soothsayer who specializes in enchantments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "282550f4-54ac-46e6-9157-46870dfe8eaf",
                                                "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                                "text": "1590, Edmund Spenser, The Faerie Queene, Book One, Indianapolis: Hackett, 2006, Canto VII, stanza 35, p. 113,\nNo magicke arts hereof had any might, / Nor bloody wordes of bold Enchaunters call, / But all that was not such, as seemd in sight, / Before that shield did fade, and suddeine fall:"
                                            },
                                            {
                                                "example_id": "ac459f78-e29d-4501-bedb-67c9845686e9",
                                                "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                                "text": "He was indeed as bitter an enemy to the savage authority too often exercised by husbands and fathers, over the young and lovely of the other sex, as ever knight-errant was to the barbarous power of enchanters; nay, to say truth, I have often suspected that those very enchanters with which romance everywhere abounds were in reality no other than the husbands of those days; and matrimony itself was, perhaps, the enchanted castle in which the nymphs were said to be confined."
                                            },
                                            {
                                                "example_id": "9779517c-7efd-4e29-bdd8-d1fa17d57288",
                                                "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                                "text": "[I]n the reign of Henry the Second, a body happening, by chance, to be dug up near Glastonbury Abbey, without any symptoms of putrefaction or decay, the Welch, the descendants of the Ancient Britons, tenacious of the dignity and reputation of that illustrious hero [King Arthur], vainly supposed it could be no other than the body of their justly-boasted Pen-Dragon; and that he had been immured in that sepulchre by the spells of some powerful and implacable inchanter."
                                            },
                                            {
                                                "example_id": "b24aa3cd-339d-4a92-b6eb-6ef2a71b5ec7",
                                                "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                                "text": "Thou from whose unseen presence the leaves dead / Are driven like ghosts from an enchanter fleeing,"
                                            },
                                            {
                                                "example_id": "2f912826-f498-4f04-8412-d6c26568b01e",
                                                "sense_id": "1dd16c59-24f4-3889-9c45-8c506d39e02d",
                                                "text": "[…] Goldstein […] seemed like some sinister enchanter, capable by the mere power of his voice of wrecking the structure of civilization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a202af6-c7e4-4743-b197-8ac435112232",
                        "source_entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "target_lang_word": "enchantress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enchantress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A woman, especially an attractive one, skilled at using magic; an alluring witch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5324d610-cb61-42e8-bbf3-b462719456f7",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "Him fortuned (hard fortune ye may gheſſe)\n To come, where vile Acraſia does wonne [live],\n Acraſia a falſe enchauntereſſe,\n That many errant knightes hath fowle fordonne: […]"
                                            },
                                            {
                                                "example_id": "ccf9d290-bf4f-4522-8e04-a34fd9e39cb0",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "The tablets upon which the events of the day were recorded refer to enchantresses, and we can conclude that they were by no means restricted to ancient beldames."
                                            },
                                            {
                                                "example_id": "405f5f65-840c-417f-9d3b-d157f22341d0",
                                                "sense_id": "1dd5e579-9321-3dc6-9561-f8a3dfd944a9",
                                                "text": "For even the enchantresses Circe and Medea could not, by their black arts, prevent the unfaithfulness of Odysseus and Jason."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afcfc152-490a-3d22-9838-bdfb229e43f6",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A beautiful, charming and irresistible woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0069e96e-4e08-484d-bef3-a0a77a2bd8c7",
                                                "sense_id": "afcfc152-490a-3d22-9838-bdfb229e43f6",
                                                "text": "She was the enchantress of men’s hearts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244448dc-56aa-3284-94ff-b484963cfb74",
                                        "entry_id": "cf9058ec-6892-3cdd-9946-31934c3aa7ec",
                                        "glosses": [
                                            "A femme fatale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae8b7ff-4497-42cc-af2b-518df2ffb92b",
                                                "sense_id": "244448dc-56aa-3284-94ff-b484963cfb74",
                                                "text": "His desire for that enchantress led him to financial ruin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77569ff3-a35e-4b4a-8eee-8c1f05a14d06",
                        "source_entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "target_lang_word": "sorcerer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorcerer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                        "entry_id": "b8a3cb3a-5338-3514-9425-9ccf36257571",
                                        "glosses": [
                                            "A magician or wizard. Sometimes specifically male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3298215e-0bc5-4c17-aa36-2200e2e9168e",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "Pope Joan, who once occupied the throne of the Vatican, was reputed to be the blackest sorcerer of them all."
                                            },
                                            {
                                                "example_id": "e7a46346-c9b2-4598-9e25-03c2001fb7ac",
                                                "sense_id": "32dd64b0-f086-3663-8db4-6d638c589dab",
                                                "text": "\"Well, sorcerer?\" growled the Norman. \"Nay, not well,\" replied Catweazle shivering miserably, \"I have the bone-ache.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11cd7395-7eb4-437c-a9e8-c6a5ccfcd1a6",
                        "source_entry_id": "f9f20c68-cb56-3c28-bc5f-6491de46e37a",
                        "target_lang_word": "sorceress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorceress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7890324-9a47-30c8-bc53-62fbbc7b0621",
                                        "entry_id": "62b2ab72-2d74-390d-8f0c-fe1d18a8baa6",
                                        "glosses": [
                                            "A female sorcerer, especially one who is elegant; compare witch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ef39c40-1f8b-45b0-8366-6f89d37d042e",
                                                "sense_id": "f7890324-9a47-30c8-bc53-62fbbc7b0621",
                                                "text": "The strange-looking chamber, the red glare of the charcoal, her tall form, and long black hair loose, realised the wildest dream of one of the sorceresses of old, bending over herb and drug, to form their potent spells."
                                            },
                                            {
                                                "example_id": "33192524-b669-40fc-b1d9-762ce62eb853",
                                                "sense_id": "f7890324-9a47-30c8-bc53-62fbbc7b0621",
                                                "text": "Perch: In the head of this fish there are small stones that sorceresses used in concocting love-philtres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
