                    {
                        "sense_id": "a4a214b9-d788-3144-8167-fda15c3c5c78",
                        "entry_id": "93cd6791-84a4-36c3-af49-74872aeef31f",
                        "glosses": [
                            "Vase contenant l’eau qui sert à rincer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab20123-916b-44cb-b8d5-7897f0064cda",
                                "sense_id": "a4a214b9-d788-3144-8167-fda15c3c5c78",
                                "text": "L’une des fonctions du gouverneur est de laver et rincer plusieurs fois tous les matins les piles, les maillets, les couloirs, et tous les ustensiles du moulin. Cela se fait avec une petite cuvette, toujours pleine d’eau très-nette, et qu’on nomme le rinçoir. Il faut même rincer quelquefois dans la journée, quand il arrive que quelque partie de l’ouvrage rejaillit sur les maillets, ou sur les bords des piles."
                            }
                        ]
                    },
                    {
                        "sense_id": "45748d68-de50-3098-9195-028a6d717f3f",
                        "entry_id": "93cd6791-84a4-36c3-af49-74872aeef31f",
                        "glosses": [
                            "Lavoir spécial ou partie du lavoir, contenant de l’eau très propre pour servir au rinçage du linge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7836732-d24e-4c75-87de-a53282b0bfff",
                                "sense_id": "45748d68-de50-3098-9195-028a6d717f3f",
                                "text": "Quand on n’a pas de rinçoir, on renouvelle l’eau du lavoir pour opérer le rinçage."
                            }
                        ]
                    }
                ],
