                "senses": [
                    {
                        "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                        "entry_id": "1f5565b6-c467-3ab7-81a0-bed433e85743",
                        "glosses": [
                            "Anfertigung zu benotender Arbeiten unter Aufsicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24f458f4-cde2-452b-817a-2035fd917a9c",
                                "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                                "text": "„Die Klausurprüfung umfasst schriftliche, grafische und/oder praktische Klausurarbeiten nach Maßgabe des 4. Abschnittes.“"
                            },
                            {
                                "example_id": "c47347c4-ceee-4ffd-a2fa-0c0be000b807",
                                "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                                "text": "„Der Bewerber hat Arbeiten zur Begutachtung einzusenden (Mappenprüfung) und danach Arbeiten unter Aufsicht anzufertigen (Klausurprüfung).“"
                            },
                            {
                                "example_id": "e26a9e51-b2e4-4fa3-a4b7-e004f9fe27d8",
                                "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                                "text": "„Zu Beginn der Klausurprüfung haben sich die Bewerberinnen und Bewerber durch Vorlage des Personalausweises zu identifizieren.“"
                            },
                            {
                                "example_id": "95d84789-0213-4a98-8994-230ef14f33b7",
                                "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                                "text": "„Wenn der bisherige Lehrveranstaltungsraum den Anforderungen für die Klausurprüfung entspricht, kann dieser Raum für die Prüfung genutzt werden.“"
                            },
                            {
                                "example_id": "e9be7d21-5b34-48d1-a6e5-875a0ab63fb2",
                                "sense_id": "c09403a5-c8d4-37fb-a75b-45f4252a9e62",
                                "text": "„Das Abitur an österreichischen Gymnasien wurde mit Umsetzung im Schuljahr 2014/15 einer grundlegenden Reform unterzogen, sodass die Klausurprüfung in Mathematik zukünftig als ‚standardisierte schriftliche Reifeprüfung‘ von allen österreichischen Schülerinnen und Schülern im Gymnasium geschrieben werden muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
