                        "glosses": [
                            "Être qui est à la fois homme et ange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfeedb70-891b-4eac-869b-2e49cc8a7a00",
                                "sense_id": "a46f777e-664d-304d-9f0c-ce1012bdf064",
                                "text": "Un homme sans passion, le juste parfait, est un monstre, un demi-ange qui n’a pas encore ses ailes."
                            },
                            {
                                "example_id": "4212e8c4-ad4a-425b-af2a-8f1dee42dc61",
                                "sense_id": "a46f777e-664d-304d-9f0c-ce1012bdf064",
                                "text": "Avant que j’aie anéanti Damballa, il a eu le temps d’user de sa puissance de demi-ange et de concevoir un enfant."
                            },
                            {
                                "example_id": "695847a8-464e-45df-8ceb-437f40adf2a6",
                                "sense_id": "a46f777e-664d-304d-9f0c-ce1012bdf064",
                                "text": "Je me moque que tu sois un ange, un demi-ange ou même un dingue qui se prend pour un ange ! poursuivit-elle avec humeur."
                            }
                        ]
                    }
