                "senses": [
                    {
                        "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                        "entry_id": "1d52f71e-ad5e-3161-b509-dec4ddc218f1",
                        "glosses": [
                            "To give a new name to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "32227d6a-e1cb-4d76-99ce-f6e4ce7b1f7b",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "However, in 1844, saner counsels prevailed, and Edgeley became the principal station—the directors eating their words once more by retaining the older station, which was renamed Heaton Norris."
                            },
                            {
                                "example_id": "5b70e9b1-647a-4784-82fd-ea1265c1c5bd",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "[…] And then, finally, we got to Vietnam. Given the dishonesty surrounding that war, I guess it's not surprising that, at the time, the very same condition was renamed post-traumatic stress disorder."
                            },
                            {
                                "example_id": "a8f7cd8d-8b06-4889-8644-6d13fddd9f01",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "MERIDIAN (HNS) - Habitat 7 Renamed Ryder-I\nIn honor of his achievements in the Heleus Cluster, the planet formerly known as Habitat 7 has been renamed after the human Pathfinder. The Pathfinder's father, former Pathfinder Alec Ryder, was killed exploring the planet. Now it will bear his son's name."
                            },
                            {
                                "example_id": "bbb496d1-d7d0-4a6f-99b6-f475352ce977",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "Taipei County was upgraded to the status as a special municipality in 2010 and renamed New Taipei."
                            },
                            {
                                "example_id": "3ef003bc-085a-4888-928b-260e52e76deb",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "The order temporarily renames the United States Digital Service as the United States DOGE Service for 18 months and directs the entity to overhaul the software used at federal agencies as part of a “Software Modernization Initiative” in order to “maximize governmental efficiency and productivity.”"
                            },
                            {
                                "example_id": "66e4c7f4-bbe6-4550-987a-927e81c9e6bd",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "On Monday, Trump signed an executive order renaming the Gulf of Mexico."
                            },
                            {
                                "example_id": "4276fb3a-4b3b-4ef1-95dd-9f53e60d7026",
                                "sense_id": "5dbd5ee6-292c-38f5-a7ae-3118e4c6f956",
                                "text": "When Google announced it was complying with US President Donald Trump’s executive order to rename the Gulf of Mexico to the Gulf of America, many Mexicans responded with a laugh and a long, exhausted sigh."
                            }
                        ]
                    }
                ],
