                "senses": [
                    {
                        "sense_id": "6313f032-f8e7-3665-be0f-ae28c945c5e4",
                        "entry_id": "370dbdb7-9141-35be-adfc-6da9d9650736",
                        "glosses": [
                            "To destroy the morale of; to dishearten."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5bcc1e7c-14c1-3232-abf8-257ff7bc29fd",
                        "entry_id": "370dbdb7-9141-35be-adfc-6da9d9650736",
                        "glosses": [
                            "To erode the moral adherence of; to corrupt."
                        ],
                        "tags": [
                            "British",
                            "English",
                            "Oxford",
                            "US",
                            "dated",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9196f164-b124-47ac-b791-d1414665d247",
                                "sense_id": "5bcc1e7c-14c1-3232-abf8-257ff7bc29fd",
                                "text": "[I]f you convert a man brought up in another creed, you inevitably demoralize him."
                            },
                            {
                                "example_id": "efd4ab49-7c99-4983-88c1-695548d0f259",
                                "sense_id": "5bcc1e7c-14c1-3232-abf8-257ff7bc29fd",
                                "text": "The election of a man like Mr. Blaine would be such an encouragement to the base and rapacious impulses apt to govern the conduct of politicians, it would so demoralize the public mind and open the floodgates of corruption so wide, that it is no exaggeration to say the success of our free institutions is at stake."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8763e44e-7e48-42be-95fd-b849567d5400",
                        "source_entry_id": "370dbdb7-9141-35be-adfc-6da9d9650736",
                        "source_sense_description": "to destroy morale; to dishearten",
                        "target_lang_word": "demoralizovat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7726e176-4ae3-4e19-b573-d28580480f03",
                        "source_entry_id": "370dbdb7-9141-35be-adfc-6da9d9650736",
                        "source_sense_description": "to destroy morale; to dishearten",
                        "target_lang_word": "démoraliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoraliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08c0a343-090e-34f2-9c4f-7b595e089727",
                                        "entry_id": "1584a46f-1814-39a8-961e-de234dff040d",
                                        "glosses": [
                                            "Éloigner de la loi morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d363fe4-477b-4b63-9efd-40f40cea5182",
                                                "sense_id": "08c0a343-090e-34f2-9c4f-7b595e089727",
                                                "text": "L’excès du luxe démoralise l'élite d'une nation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e3544b-4744-33c1-ae9d-5b2ee738b15f",
                                        "entry_id": "1584a46f-1814-39a8-961e-de234dff040d",
                                        "glosses": [
                                            "Priver de la force morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99b3f46-f5e5-4290-9d63-e94c9fd2a6ab",
                                                "sense_id": "37e3544b-4744-33c1-ae9d-5b2ee738b15f",
                                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3ba721b-e3bd-3b59-a1e9-d7c546c5dbe6",
                                        "entry_id": "1584a46f-1814-39a8-961e-de234dff040d",
                                        "glosses": [
                                            "Faire perdre son caractère moral à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "314f54c4-8a7b-42bb-9d9d-0ecd4285aa97",
                                                "sense_id": "c3ba721b-e3bd-3b59-a1e9-d7c546c5dbe6",
                                                "text": "La « mission » de M. Guefter, en cette période bouleversante où le pays tout entier semble avoir pris la plume, s’être mis à parler, paraît en quelque sorte de « déconjoncturer », « dépolitiser » voire « démoraliser » l’histoire — mais pour mieux la réactiver, lui restituer son rôle nourricier, pour mieux la réinsérer dans un tissu socio-politique, un tissu mémoriel où la conscience de l’histoire ne se confondrait pas avec une « moralisation » stérile de cette dernière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d4f368-b6f1-4e50-8a35-b9c279221790",
                        "source_entry_id": "370dbdb7-9141-35be-adfc-6da9d9650736",
                        "source_sense_description": "to destroy morale; to dishearten",
                        "target_lang_word": "demoralisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demoralisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0715b86e-8b61-331a-9dbb-ecb470657290",
                                        "entry_id": "88ecc248-b960-3a08-bd36-3d6486796f2f",
                                        "glosses": [
                                            "jemandes Moral (Stimmung, Kampfgeist) zerstören, jemandem den Mut nehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ebfb42c-76e9-42ea-b510-04aaadb64bff",
                                                "sense_id": "0715b86e-8b61-331a-9dbb-ecb470657290",
                                                "text": "Er hat sehr fleißig gearbeitet. Dass er kein Lob bekam, demoralisierte ihn."
                                            },
                                            {
                                                "example_id": "49be07f1-c7c2-4489-b220-c0ae48540834",
                                                "sense_id": "0715b86e-8b61-331a-9dbb-ecb470657290",
                                                "text": "„Die wissen genau, wie sie noch den letzten Streikwilligen demoralisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
