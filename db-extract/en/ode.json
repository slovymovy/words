                    {
                        "translation_id": "90d68b02-6c6e-4d36-9b9a-d1024df0ee6a",
                        "source_entry_id": "52a2cc19-c003-3e3c-b56e-6504ac225dd0",
                        "source_sense_id": "3b70ec35-862b-3d5a-b27a-117235aff7df",
                        "source_sense_description": "a short poetical composition",
                        "target_lang_word": "ode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f30f43-a7ef-376c-8650-b64e959cdc56",
                                        "entry_id": "2c140ee5-32a7-3ded-8fb6-e54308085865",
                                        "glosses": [
                                            "Poème lyrique (donc chanté) composé d’une strophe, d’une antistrophe et d’une épode, que le chœur chantait en décrivant certaines évolutions."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc98ee8-7249-49b1-9a06-e88b31eed1dc",
                                                "sense_id": "a3f30f43-a7ef-376c-8650-b64e959cdc56",
                                                "text": "Les odes de Pindare."
                                            },
                                            {
                                                "example_id": "9b4daae6-7b25-4669-a710-71301d1a7bd2",
                                                "sense_id": "a3f30f43-a7ef-376c-8650-b64e959cdc56",
                                                "text": "Les Sirènes dévient l’odos d’Odysseus (l’ode en langue grecque veut dire en même temps le chemin et le chant)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334ef9d0-f3c0-3e67-b3de-eb24a972f2db",
                                        "entry_id": "2c140ee5-32a7-3ded-8fb6-e54308085865",
                                        "glosses": [
                                            "Poème lyrique divisé en strophes qui sont ordinairement semblables entre elles par le nombre et la mesure des vers."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3165bebe-051d-4074-80b3-12741eedfb9b",
                                                "sense_id": "334ef9d0-f3c0-3e67-b3de-eb24a972f2db",
                                                "text": "En bon Champenois, il célébra le vin de Champagne dans une ode en vers iambiques, dont le style vif et pétillant, présente la belle image de cette charmante liqueur."
                                            },
                                            {
                                                "example_id": "9dc34e86-352d-4118-a878-0fb5225bda54",
                                                "sense_id": "334ef9d0-f3c0-3e67-b3de-eb24a972f2db",
                                                "text": "Plus d’un jeune instituteur stagiaire a retrouvé dans le siècle celle pour qui s’échafaudaient ses odes et ses sonnets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a9e4757-3a4d-4f1b-a191-cc50d6aec1f8",
                        "source_entry_id": "52a2cc19-c003-3e3c-b56e-6504ac225dd0",
                        "source_sense_id": "3b70ec35-862b-3d5a-b27a-117235aff7df",
                        "source_sense_description": "a short poetical composition",
                        "target_lang_word": "Ode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76d0417c-9817-371d-8c4c-6f0fe69fc014",
                                        "entry_id": "b6fc29f8-4b71-3c67-a39e-49e97be6d76a",
                                        "glosses": [
                                            "Lyrik in Begleitung von Musik"
                                        ],
                                        "tags": [
                                            "Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8a0493-cfb7-4051-9c23-1c9e9ecd5377",
                                                "sense_id": "76d0417c-9817-371d-8c4c-6f0fe69fc014",
                                                "text": "„In einer Ode, die Horaz zu dieser Zeit abfasste, wurde die Heimkehr des Augustus wie die Epiphanie eines Gottes geschildert.“"
                                            },
                                            {
                                                "example_id": "70420673-15a3-42da-b09b-dd6a63580945",
                                                "sense_id": "76d0417c-9817-371d-8c4c-6f0fe69fc014",
                                                "text": "„In Göschens Verlagsbüro in Grimma saß Seume auf glühenden Kohlen, über Oden von Klopstock und Romane von Wieland gebeugt, manchmal hochfahrend, häufig niedergedrückt.“"
                                            },
                                            {
                                                "example_id": "fa566104-6a91-4fa6-9a63-33bd2dbd7f77",
                                                "sense_id": "76d0417c-9817-371d-8c4c-6f0fe69fc014",
                                                "text": "„Er las mir daraufhin sein Gedicht vor, und da ich es voll Gefühl und nach der Art des Guidi verfaßt fand, riet ich ihm, es als Ode zu bezeichnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f10a569e-5b63-34b4-88c2-3b2019172f7d",
                                        "entry_id": "b6fc29f8-4b71-3c67-a39e-49e97be6d76a",
                                        "glosses": [
                                            "feierliches, erhabenes, reimloses Gedicht"
                                        ],
                                        "tags": [
                                            "Lyrik"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
