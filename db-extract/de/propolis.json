                                        "sense_id": "0b058b71-c38d-392d-bc6a-b0fee10a0971",
                                        "entry_id": "583aaf3d-d9e9-3d44-9238-e6015b8896cb",
                                        "glosses": [
                                            "een stof die door bijen verzameld wordt van knoppen van populieren, kastanjes en naaldbomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a41dae-3b73-4e4d-9fe6-704c1ff34fa1",
                                                "sense_id": "0b058b71-c38d-392d-bc6a-b0fee10a0971",
                                                "text": "Bijen kitten met propolis kieren dicht, maar de stof heeft natuurlijke antibiotische eigenschappen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e40fbbcb-0a36-48a6-85f3-cc0b5dd2c97a",
                        "source_entry_id": "0f650a67-218f-38cd-a232-40c5528fe15d",
                        "source_sense_id": "ccb8f3a5-87a9-3ee4-b885-236d6e6b04cb",
                        "target_lang_word": "пчелиный клей",
