                        "glosses": [
                            "Qualifie une poésie écrite à la manière de Pétrarque."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "1c797dbb-43a8-4175-bc8c-e9c0026d1701",
                                "sense_id": "6ec9897f-490c-3e74-89ca-a5ce78916326",
                                "text": "On ne lira pas sans étonnement l'un des plus sensuels poètes de l'école d'Ebn-el-Farid écrire ce vers pétrarquisant :\nJe demande où elle est : et elle est en moi."
                            },
                            {
                                "example_id": "f5e80d8d-d88e-44b7-97ae-ecb1c0daa929",
                                "sense_id": "6ec9897f-490c-3e74-89ca-a5ce78916326",
                                "text": "Selon la théorie rhétorique de l'Antiquité, l'art oratoire est étroitement lié à la poésie ; Camillo, qui était lui même un poète pétrarquisant le savait très bien."
                            }
                        ]
