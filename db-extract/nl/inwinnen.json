        "nl-extract.jsonl": [
            {
                "entry_id": "b4ab9b26-7648-3d2a-bb34-5773523a31fe",
                "word": "inwinnen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf4f0792-b098-3464-b7f4-c5279bad47b1",
                        "entry_id": "b4ab9b26-7648-3d2a-bb34-5773523a31fe",
                        "glosses": [
                            "verzamelen van met name informatie en advies"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09f4f74b-35d0-4239-bf51-1ff9c23d09be",
                                "sense_id": "bf4f0792-b098-3464-b7f4-c5279bad47b1",
                                "text": "B. werd maandag veroordeeld tot één jaar cel voor het inwinnen van informatie om explosieven te maken."
                            },
                            {
                                "example_id": "227cec1e-6ab7-417f-b657-69280da4f275",
                                "sense_id": "bf4f0792-b098-3464-b7f4-c5279bad47b1",
                                "text": "De Europese Commissie gaat meer wetenschappelijk advies inwinnen bij de lidstaten over maatschappelijke thema’s die leven. Daarvoor wordt een groep van zeven onafhankelijke wetenschappers ingesteld. Deze groep kan zelf onderwerpen op de Brusselse agenda zetten, in samenspraak met de diverse academies in de 28 lidstaten."
                            }
                        ]
                    },
                    {
                        "sense_id": "763146fe-482a-3f2d-ada0-207255683c10",
                        "entry_id": "b4ab9b26-7648-3d2a-bb34-5773523a31fe",
                        "glosses": [
                            "verkrijgen van wat eerst verloren is gegaan"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be19eab5-4752-4c1a-b573-0d69b31599e1",
                        "source_entry_id": "b4ab9b26-7648-3d2a-bb34-5773523a31fe",
                        "source_sense_id": "bf4f0792-b098-3464-b7f4-c5279bad47b1",
                        "source_sense_description": "verzamelen met name in informatie",
                        "target_lang_word": "obtain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obtain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                        "entry_id": "6ee02438-eddb-32ea-abe4-17fc51a2706f",
                                        "glosses": [
                                            "To get hold of; to gain possession of, to procure; to acquire, in any way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ecdf37c-4fa6-4410-94df-4198ab031641",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "obtain permission"
                                            },
                                            {
                                                "example_id": "93aa89b8-01af-43b7-bed6-3203f3ddd90d",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "obtain information"
                                            },
                                            {
                                                "example_id": "5e5e0567-a94a-46b9-8785-de0e7dd20aee",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "difficult to obtain"
                                            },
                                            {
                                                "example_id": "3957ebd3-f417-458d-a8d8-9a251a6de2e1",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "Applicants must obtain a permit before construction."
                                            },
                                            {
                                                "example_id": "0fe56e84-dd25-47df-acd8-aca948ed0127",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "We obtained accurate data from the survey."
                                            },
                                            {
                                                "example_id": "9ba6a3bd-bce9-4c07-802c-a7798c16e79c",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "And a certayne ruler axed him: sayinge: Goode Master: what ought I to do, to obtaine eternall lyfe?"
                                            },
                                            {
                                                "example_id": "c44c3d3b-d4ab-49a0-8fd6-25ec9f2634b7",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "[…] Julia was quite as eager for novelty and pleasure as Maria, though she might not have struggled through so much to obtain them, and could better bear a subordinate situation."
                                            },
                                            {
                                                "example_id": "ecc72e99-17ca-414b-8b81-053951d3ca75",
                                                "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                                                "text": "But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention. Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b05fffa-fc4a-3fa6-b6c4-e49073940088",
                                        "entry_id": "6ee02438-eddb-32ea-abe4-17fc51a2706f",
                                        "glosses": [
                                            "To secure (that) a specific objective or state of affairs be reached."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44c30acc-651c-4f61-8b2a-14782abfdd21",
                                                "sense_id": "2b05fffa-fc4a-3fa6-b6c4-e49073940088",
                                                "text": "he was condemned to die for the felony, and being so well known for an old offender, had certainly died, but the merchant, upon his earnest application, had obtained that he should be transported, on condition that he restored all the rest of his bills, which he had done accordingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "507494e7-2230-3540-bcd2-867821c14713",
                                        "entry_id": "6ee02438-eddb-32ea-abe4-17fc51a2706f",
                                        "glosses": [
                                            "To prevail, be victorious; to succeed."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c414c4e-b0ea-4ce4-84a2-470ef956f065",
                                                "sense_id": "507494e7-2230-3540-bcd2-867821c14713",
                                                "text": "“O daughter deare!” (said she) “despeire no whit; / For never sore but might a salve obtain [...].”"
                                            },
                                            {
                                                "example_id": "c097197b-fcd6-4158-8cef-d970d9b99641",
                                                "sense_id": "507494e7-2230-3540-bcd2-867821c14713",
                                                "text": "This, though it failed at present, yet afterward obtained, and was a mighty step to the ruin of the commonwealth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fb14767-77cb-3c14-8831-3f77ea0d7000",
                                        "entry_id": "6ee02438-eddb-32ea-abe4-17fc51a2706f",
                                        "glosses": [
                                            "To hold; to keep, possess or occupy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91930e7d-8ff7-4766-8b6a-b3d09bfb6ea4",
                                                "sense_id": "1fb14767-77cb-3c14-8831-3f77ea0d7000",
                                                "text": "His mother then is mortal, but his Sire / He who obtains the monarchy of Heav'n, / And what will he not do to advance his Son?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a68da25-106b-3912-9125-b2a64ae4d5a1",
                                        "entry_id": "6ee02438-eddb-32ea-abe4-17fc51a2706f",
                                        "glosses": [
                                            "To exist or be the case; to hold true, be in force."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a2106dc-f91e-4880-911e-33890c9c3c3b",
                                                "sense_id": "8a68da25-106b-3912-9125-b2a64ae4d5a1",
                                                "text": "Even though the Pervaise confession had never come to light, no reasonable doubt could obtain; for the act in question […] was on a par with countless other acts committed by the oligarchs, and, before them, by the capitalists."
                                            },
                                            {
                                                "example_id": "796bfb78-778c-44fc-a0fd-9c116281a94c",
                                                "sense_id": "8a68da25-106b-3912-9125-b2a64ae4d5a1",
                                                "text": "In connection with the various courses of practical instruction, the companies maintain signalling schools fitted with standard railway equipment in which the staff can be given instructions under conditions exactly similar to those which obtain in signal boxes."
                                            },
                                            {
                                                "example_id": "b7c07002-6d64-49ee-b46c-e3e10c68d151",
                                                "sense_id": "8a68da25-106b-3912-9125-b2a64ae4d5a1",
                                                "text": "But the hostage situation no longer obtains, and so Uncle Enzo feels it important to stop Rife now, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
