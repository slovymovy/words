                ],
                "senses": [
                    {
                        "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                        "entry_id": "7140fe6d-a416-3187-b2d2-ca96b765ae7d",
                        "glosses": [
                            "(schadhaft gewordenes und deshalb achtlos) gekapptes beziehungsweise weggeworfenes oder verloren gegangenes Fischernetz"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "8ad608ef-89a4-4e23-910c-a0c4c156165f",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Mitte April erst veröffentlichte die Weltwildtier-Stiftung WWF eine Studie, wonach sich jedes Jahr ‚mindestens 200 000 Wale und Delphine sowie Hunderttausende von Seevögeln in den Geisternetzen aus Nylon verfangen‘.“"
                            },
                            {
                                "example_id": "30324567-fc52-457e-aba3-a13b89267f45",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Die Folgen sind verheerend: Vögel verfangen sich in Sechserpackringen, Fische gehen in gekappten, frei treibenden ‚Geisternetzen‘ zugrunde.“"
                            },
                            {
                                "example_id": "01f3d94d-fc69-497f-8e73-1f079fcadf11",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Sie ‚sinken dann nicht auf den Meeresboden, sondern treiben als sogenannte »Geisternetze« unkontrolliert im Meer und fangen weiter: Fische, Delphine, Wale, Seehunde‘, sagte ein Sprecher der internationalen Umweltschutzorganisation.“"
                            },
                            {
                                "example_id": "3c86318f-cf72-4fff-a235-a466c41d41f2",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Das verzweifelte Geflatter der Seeschwalbe nahm mit unserem Näherkommen zu, und wir erkannten jetzt, daß ihre Füße sich in den nahezu unsichtbaren Maschen eines Geisternetzes verfangen hatten, einem Stück Treibnetz, das weiterschwimmt und fast jedes Tier fängt, das damit in Kontakt kommt.“"
                            },
                            {
                                "example_id": "af5d1215-a40f-45b3-af6c-3d9a6e8251fb",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Obwohl die Fangrate langsam abnahm (vermutlich einfach deshalb, weil die Anzahl der noch lebenden Tiere im Gebiet abnahm), fingen die Geisternetze immer weiter Tiere, bis zum Ende der Beobachtungsperiode nach neun Monaten.“"
                            },
                            {
                                "example_id": "1b45806e-0bdc-4440-9ef6-74463f682c63",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Die Tiere verenden in Schlepp- und Stellnetzen oder verheddern sich in Verbindungsleinen zu Hummerkörben am Meeresboden. Andere werden Opfer von Geisternetzen, verloren gegangenem Fanggerät, das herumtreibt und herrenlos weitertötet.“"
                            },
                            {
                                "example_id": "9f61e797-aa76-428a-9b34-7a61fda684ae",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Stählerne Riesennetze pflügen eine Schneise in den Boden der Tiefsee, die sich über Jahrhunderte nicht erholen wird. Was sie verschonen, stirbt oft in achtlos weggeworfenen ‚Geisternetzen‘ – so zum Beispiel viele langsam wachsende Bodenfische.“"
                            },
                            {
                                "example_id": "dd1d5a33-6803-47df-8248-f7ea85307e69",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Viele sogenannte Geisternetze, also gerissene Fischernetze, treiben im Meer.“"
                            },
                            {
                                "example_id": "a7ca84b6-a4f8-4860-9c07-62a9573189bc",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Der Fang des Tages war ein riesiges Geisternetz. George, der Kapitän und ich zogen es über die Seite hoch, ein ungeheures Gewirr aus Netzen und Seilen, das vielleicht einen Durchmesser von einem Meter hatte und bestimmt siebzig Kilo wog.“"
                            },
                            {
                                "example_id": "834a71b4-7feb-4dc7-b840-173c4ba766ad",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Ein Dorsch hat sich in einem Geisternetz am Wrack des Holzfrachters ‚Fliegender Holländer‘ verfangen.“"
                            },
                            {
                                "example_id": "5282e309-2d49-4289-9061-848a1fe3ad3b",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Sie sind aktiv bei den Umweltorganisationen tätig und versuchen auch mit eigenen Initiativen, gestrandete Meeressäuger zum offenen Meer zu begleiten, im Geisternetz gefangene Haie zu befreien, oder sie kämpfen gegen Tierversuche.“"
                            },
                            {
                                "example_id": "9e638258-7a69-411a-957b-6baf54cb7b5b",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„Geisternetze setzen Schadstoffe frei, die über das Meer in Lebensmittel gelangen können.“"
                            },
                            {
                                "example_id": "a69b48e5-9238-43eb-b67c-0596a9521689",
                                "sense_id": "e6be1990-749d-3656-b5d2-d60d17095424",
                                "text": "„In der Ostsee werden nun erste Geisternetze geborgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
