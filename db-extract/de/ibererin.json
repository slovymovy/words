                        "glosses": [
                            "Urbewohnerin der Pyrenäenhalbinsel vor Ankunft der Indogermanen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51e5c1d-725f-40bf-871b-6a0a6da59a63",
                                "sense_id": "bc5d531b-0a6b-3af4-b85a-ac54c26dfba7",
                                "text": "Vor der Völkerwanderung war die Iberische Halbinsel von Iberern und Ibererinnen besiedelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce56b5fb-7311-4da1-873d-7f5145ed23bc",
                        "source_entry_id": "28bb8a78-195d-3970-aac1-a2aac1255ac2",
                        "source_sense_id": "bc5d531b-0a6b-3af4-b85a-ac54c26dfba7",
