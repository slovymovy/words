                        "eat Thai",
                        "order Thai",
                        "love Thai"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайская кухня; традиционная еда Таиланда.",
                        "zh": "泰国菜；传统的泰国食物。"
