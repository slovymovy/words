                        "sense_id": "b46ac1b6-3686-3cec-beaa-687a762a290f",
                        "entry_id": "cd30a857-9a3b-3890-b755-e54722f7189a",
                        "glosses": [
                            "Any of a class of proteins that bind specific carbohydrates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57114f29-9e61-42ea-b976-a1ad4600fe5b",
                                "sense_id": "b46ac1b6-3686-3cec-beaa-687a762a290f",
                                "text": "The result proved less about the safety of genetic engineering than it did about the safety of lectins – known animal poisons."
                            },
                            {
                                "example_id": "242b85f3-5c60-4d92-8542-ab43f233121a",
                                "sense_id": "b46ac1b6-3686-3cec-beaa-687a762a290f",
                                "text": "Soybeans are another excellent source of plant proteins but they are also on the list of high lectin foods. They are very important to vegans and vegetarians as they make it easy for them to get adequate proteins in their diet."
                            }
                        ]
                    }
                ],
                "translations": [
