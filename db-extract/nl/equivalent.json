                                            {
                                                "example_id": "202071da-ad9c-4d72-812e-b51e9ae739fe",
                                                "sense_id": "70e5cba5-b566-3f69-ac09-f4c274fcfcad",
                                                "text": "Als Äquivalent zu Bohnenkaffee kann Getreidekaffee verwendet werden."
                                            }
