                                "target_lang_word": "abfinden",
                                "target_lang_sense_clarification": "Renten- oder Pensionsansprüche einlösen"
                            },
                            {
                                "target_lang_word": "auszahlen lassen",
                                "target_lang_sense_clarification": "vorzeitig bar erhalten"
                            }
                        ]
