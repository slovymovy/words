                "senses": [
                    {
                        "sense_id": "ed2ea56f-fb56-35c3-9e75-cda2ab08495e",
                        "entry_id": "775c77b9-ccc3-30f4-9486-c8fcb0454f7f",
                        "glosses": [
                            "To fail to suit."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f5a1f1c9-6c3a-48ce-bfe3-9c6393689b81",
                                "sense_id": "ed2ea56f-fb56-35c3-9e75-cda2ab08495e",
                                "text": "I now discovered — as in hasty love matches has but too often proved to be the case — that my guide and I were unhappily missuited to each other, and the consequence was we had at least six quarrels […]"
                            },
                            {
                                "example_id": "264d0922-5b34-4b63-a249-69c1160f4ba5",
                                "sense_id": "ed2ea56f-fb56-35c3-9e75-cda2ab08495e",
                                "text": "Each states the law and fact and face o' the thing\nJust as he'd have them, finds what he thinks fit,\nIs blind to what missuits him, just records\nWhat makes his case out, quite ignores the rest."
                            },
                            {
                                "example_id": "087d258e-8d06-45c6-a3e4-587d10c11044",
                                "sense_id": "ed2ea56f-fb56-35c3-9e75-cda2ab08495e",
                                "text": "But I think they suit the landscape, atmosphere, limpid sky, massive sunlight, of Italy, as much as they would missuit England, France, and Germany."
                            }
                        ]
                    }
                ],
