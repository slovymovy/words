                                            },
                                            {
                                                "example_id": "c0a1ddbe-e916-4f48-a773-6c0285e82e79",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "Decision realities research recognizes the occupational tribalism identified in occupational realities research, but goes further by paying attention to all the players – patients and lay caregivers included – who participate in negotiating care."
                                            },
                                            {
                                                "example_id": "257e6647-f796-45b7-a4f1-a88b36f9e5cb",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "Another Bush — George W.’s brother Jeb — is likely to be a big player in the Republican Party’s future."
                                            },
                                            {
                                                "example_id": "d175b7dc-79ab-49e0-88ab-6e0ca73a0741",
                                                "sense_id": "35c1520a-901f-303e-91cd-8513a7f53813",
                                                "text": "As the biggest rail player, Network Rail was usually held accountable for failings, but had no authority to change anything to solve the problems. The DfT had been given that authority in 2004 - but consistently ducked accountability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f26d8de-3507-3de2-84a6-fe93251d22be",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "A participant; one involved in something.",
                                            "One who participates in a particular type of sexual play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd5f91b3-f9c6-4dc1-98cc-6f12e14f81d4",
                                                "sense_id": "4f26d8de-3507-3de2-84a6-fe93251d22be",
                                                "text": "In this space we explored lesbian sadomasochism, met other S/M women who were serious players, had access to safe equipment and, through watching other women, learned new techniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e26be3-6ded-3023-bf2f-428f8d2be068",
                                        "entry_id": "7b01ec3d-b341-36b6-a43e-3f07228e5f3a",
                                        "glosses": [
                                            "A person who plays the field rather than having a long-term sexual relationship."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccf4ed2-53d1-4093-b847-9323808b2aa1",
                                                "sense_id": "d7e26be3-6ded-3023-bf2f-428f8d2be068",
                                                "text": "Thunder only happens when it’s rainin’ / Players only love you when they’re playin’ / Say women, they will come and they will go / When the rain washes you clean, you’ll know"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e8abf40-6103-4a5a-8a0b-c23373e3c2a1",
                        "source_entry_id": "2750789f-f610-307a-93ff-a2359a3981cb",
                        "source_sense_id": "93f9292c-a0bb-3c80-b118-8478c8734088",
                        "source_sense_description": "Jargon: Spielerin (eines Computer- oder Konsolenspiels)",
                        "target_lang_word": "joueuse",
