                            "plural"
                        ],
                        "form": "die Butzen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e705774-3f65-30e2-b745-7fbe481466a5",
                        "entry_id": "39cd0e30-e4a3-38c3-8af3-4bad19cb2aa6",
                        "glosses": [
                            "abgetrennte, fensterlose Schlafnische in Bauernhäusern"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "7996f665-a030-47ae-924f-e3f2e0ad5400",
                                "sense_id": "0e705774-3f65-30e2-b745-7fbe481466a5",
                                "text": "Er hat heute seine Butze aufgeräumt."
                            },
                            {
                                "example_id": "2156fe05-3822-4a94-94e4-2c109e6441ce",
                                "sense_id": "0e705774-3f65-30e2-b745-7fbe481466a5",
                                "text": "„Doch als er hinterher in der Butze lag und überdachte, wie es ihm ergangen war, machte er die Finger an beiden Händen krumm.“"
                            },
                            {
                                "example_id": "703f9ecb-1182-48e8-b6ee-1ec59ae13f66",
                                "sense_id": "0e705774-3f65-30e2-b745-7fbe481466a5",
                                "text": "„Jetzt konnten wir unter den Tisch kriechen und in der Butze sitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aeb79262-2141-3d59-8f95-d4719d0f942b",
                        "entry_id": "39cd0e30-e4a3-38c3-8af3-4bad19cb2aa6",
                        "glosses": [
                            "besonders kleine Bude, Bretterverschlag"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "66d327be-7d10-4d98-b62f-60d3ba6d9382",
                                "sense_id": "aeb79262-2141-3d59-8f95-d4719d0f942b",
                                "text": "„Wie man sich denken kann, war der junge Mann über diese Nachricht ganz außer sich vor Freude, und seine Begeisterung wurde noch größer, als der Propst ihm vorschlug, ins Propstheim zu ziehen, wo er für ihn im oberen Stockwerk eine Stube einrichten lassen wolle; bis jetzt hatte Gisli in einer kläglichen Butze bei Bekannten im Ort gewohnt und während der Fischsaison sein Bett mit zwei anderen Leuten teilen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
