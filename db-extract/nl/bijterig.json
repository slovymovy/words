                    {
                        "sense_id": "8683d18d-d55e-3cc8-aace-bf04cb36fe58",
                        "entry_id": "e6037ff3-acaf-3bc2-b788-3203adac9e32",
                        "glosses": [
                            "geneigd zijn om te bijten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd76ebe2-5af2-444e-8b57-518cf312c081",
                                "sense_id": "8683d18d-d55e-3cc8-aace-bf04cb36fe58",
                                "text": "De rotspython, die bekend staat als agressief en bijterig, komt voor in Afrika en eet voornamelijk kleine zoogdieren zoals ratten."
                            },
                            {
                                "example_id": "b3b793c8-d47c-438e-99b5-e5706ae1e1f8",
                                "sense_id": "8683d18d-d55e-3cc8-aace-bf04cb36fe58",
                                "text": "Ondanks hun angstaanjagende uiterlijk zijn Cacata's zijn niet gevaarlijk. Ze zijn niet giftig. Wel hebben ze de neiging om soms wat bijterig te zijn. De verwondingen die dat gedrag oplevert zijn niet ernstig."
                            }
                        ]
                    }
