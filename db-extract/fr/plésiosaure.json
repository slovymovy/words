                                        "sense_id": "0f644f5d-d2a6-313d-86bb-0b9f8ab1a546",
                                        "entry_id": "6c7de4da-515b-330e-93eb-31da0fe23780",
                                        "glosses": [
                                            "Any of the genus †Plesiosaurus of extinct long-necked marine reptiles from the Early Jurassic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23c23427-64b3-4089-95a8-7e8dffad0bb0",
                                                "sense_id": "0f644f5d-d2a6-313d-86bb-0b9f8ab1a546",
                                                "text": "\"Plesiosaurus! A fresh-water plesiosaurus!\" cried Summerlee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "425cc1b9-e5ae-4ce4-b6f4-0478eefd7ec4",
                        "source_entry_id": "4564b45c-658a-30eb-8bd3-86b67f89b7cf",
                        "source_sense_id": "647b71cb-d4b0-3ee9-9028-5b3abe2c52c3",
