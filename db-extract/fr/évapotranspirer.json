                ],
                "senses": [
                    {
                        "sense_id": "34dbe4a2-1125-3a86-9642-7ed76e7df08f",
                        "entry_id": "504b1dc9-b304-3eb5-8a33-d5dfab8826a4",
                        "glosses": [
                            "Transférer par évapotranspiration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f9b442-5697-47d6-990f-f72ded88aefa",
                                "sense_id": "34dbe4a2-1125-3a86-9642-7ed76e7df08f",
                                "text": "Lorsqu’en même temps les surfaces foliaires sont bien développées, c’est alors tout le couvert végétal qui évapotranspire au taux de évapotranspiration potentielle."
                            },
                            {
                                "example_id": "cb8df0b8-f17e-49c3-b6d5-1a2f2983086c",
                                "sense_id": "34dbe4a2-1125-3a86-9642-7ed76e7df08f",
                                "text": "Ainsi, l’eau alimentant la surface du sol pourra ruisseler, s’évapotranspirer (évaporation de surface + transpiration de la végétation) ou être infiltrée vers des horizons de sub-surface."
                            }
                        ]
                    }
                ],
