                        "cross_references": [
                            {
                                "target_word": "ansia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7bbc35-39c9-3e13-b003-8068dd3f0018",
                                        "entry_id": "827322b1-f177-34bc-9d46-46adf070273d",
                                        "glosses": [
                                            "sensazione di incertezza o paura causata da uno o più conflitti inconsci di fronte a qualcosa o qualcuno che viene identificato come pericoloso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a44f241-eb5d-4e74-9be7-4a1d9841a20c",
                                                "sense_id": "9b7bbc35-39c9-3e13-b003-8068dd3f0018",
                                                "text": "Quando il professore mi rivolse quella domanda complicata, fui preso dall'ansia di non essere in grado di rispondere correttamente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536947af-f9e6-3b22-ad90-68ae4090ca9a",
                                        "entry_id": "827322b1-f177-34bc-9d46-46adf070273d",
