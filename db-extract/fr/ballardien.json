                    {
                        "sense_id": "f8185329-dbc6-3981-8889-7253307801cd",
                        "entry_id": "42b750ad-327e-3e13-96de-6b462baf096a",
                        "glosses": [
                            "Qui se rapporte à J. G. Ballard, son style, ses thèmes d’écriture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83a4e81c-ccd1-4770-824e-c6c817d51ff9",
                                "sense_id": "f8185329-dbc6-3981-8889-7253307801cd",
                                "text": "Aujourd’hui, il y reconnaît « un monument extrêmement ballardien, comme une station spatiale échouée dans les blés. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "915d404a-d619-4f5b-b016-8371513116a7",
                        "source_entry_id": "42b750ad-327e-3e13-96de-6b462baf096a",
                        "source_sense_id": "f8185329-dbc6-3981-8889-7253307801cd",
                        "target_lang_word": "Ballardian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ballardian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                        "entry_id": "0066fda7-f2db-394e-93b0-293932a76cfe",
                                        "glosses": [
                                            "Of or pertaining to the characteristic fictional milieu of author J. G. Ballard (1930–2009)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be69a5b2-f39d-40e2-a9d2-f00883e1c984",
                                                "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                                "text": "Yet the sense of evil—which seems to motivate the Christian allusions in Golding, as though evil were what was missing from the Wellsian world picture—is nowhere present in the Ballardian text."
                                            },
                                            {
                                                "example_id": "fc9e5e66-18e7-4c02-bd41-7ec601e6368e",
                                                "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                                "text": "Like some Ballardian nightmare from 1986 / Let the satellite navigation system guide us to the Styx"
                                            },
                                            {
                                                "example_id": "a8a46004-3fe8-4e9e-b67c-3608d5acf6b0",
                                                "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                                "text": "The purest Ballardian set, poised chronologically between High-Rise and Millennium People, was an estate on the edge of the recently created Barrier Park (architectural planting in the deep trenches of an old dock)."
                                            },
                                            {
                                                "example_id": "9618652a-00a5-42f9-90cb-be37e308db09",
                                                "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                                "text": "However space age, dislocated and alienated his music became, however Ballardian, surreal and abstract his conceptual concerns, he remained fixed in a northern time and space."
                                            },
                                            {
                                                "example_id": "7e05c332-c704-467f-9954-0772efbf4489",
                                                "sense_id": "596f86b8-7caa-34d3-9c30-bc5ec6a0b56b",
                                                "text": "The very Ballardian violence comes from rogue Salafist jihadists and their far-right counterparts, the Nativists (imagine the EDL with brains); […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
