                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cde84ca5-afc9-40ac-9e10-1659dc75ab97",
                                "sense_id": "2bf85440-acad-3434-b4e2-df7d491f1927",
                                "text": "„Im Vergleich zum postalischen Briefkontakt (im Netzjargon: Snail Mail) ist der E-Mail-Austausch sehr viel schneller und erlaubt bei Bedarf einen Austausch mit derselben Person mehrmals täglich, wodurch etwa im beruflichen Kontext die Kooperation über Distanzen hinweg erleichtert wird und im privaten Kontext besonders enge Brieffreundschaften entstehen können.“"
                            },
                            {
                                "example_id": "1ece4587-d5f3-4eda-9476-efa9caa0f595",
                                "sense_id": "2bf85440-acad-3434-b4e2-df7d491f1927",
                                "text": "„Zu dieser Zeit pflegte Stroud mit einer älteren Witwe namens Della Jones engen Briefkontakt, der sich über eine ornithologische Zeitschrift angebahnt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
