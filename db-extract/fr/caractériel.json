                "senses": [
                    {
                        "sense_id": "bcf3b287-96bc-385a-b6ea-bd9f01c86eef",
                        "entry_id": "d125abf3-8bdb-3a75-9756-7523423dca64",
                        "glosses": [
                            "Qui souffre d’un trouble du comportement, du caractère donnant une adaptation difficile à son milieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "025661c5-d98e-4979-a95f-e2e512be6d37",
                                "sense_id": "bcf3b287-96bc-385a-b6ea-bd9f01c86eef",
                                "text": "un enfant caractériel."
                            },
                            {
                                "example_id": "d78284a1-a51c-464b-a553-3de834ba0082",
                                "sense_id": "bcf3b287-96bc-385a-b6ea-bd9f01c86eef",
                                "text": "Une personne caractérielle ou querelleuse, rancunière ou vindicative, qui ne parvient pas à bâtir des relations harmonieuses avec son prochain…"
                            }
                        ]
                    },
                    {
                        "sense_id": "52ea3fa7-d0cf-3c9e-8b30-4bb27dd101c6",
                        "entry_id": "d125abf3-8bdb-3a75-9756-7523423dca64",
                        "glosses": [
                            "Qui a mauvais caractère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8acf8e7-aaf7-4ab2-8826-334828a22283",
                                "sense_id": "52ea3fa7-d0cf-3c9e-8b30-4bb27dd101c6",
                                "text": "Autant de commentaires déjà assez inhabituels, pour un président que l’on sait caractériel, mais qui soigne généralement une image de modéré, adepte du compromis et des échanges courtois."
                            },
                            {
                                "example_id": "49a8faf2-efad-412a-b564-43df653e3ad7",
                                "sense_id": "52ea3fa7-d0cf-3c9e-8b30-4bb27dd101c6",
                                "text": "KDB est un capitaine beaucoup trop caractériel."
                            }
                        ]
                    }
                ],
