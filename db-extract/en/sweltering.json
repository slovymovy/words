                "senses": [
                    {
                        "sense_id": "8c109eb8-26b9-37f0-aa59-7995424cb372",
                        "entry_id": "34b49dc3-4ec2-3906-be9e-93e114298337",
                        "glosses": [
                            "hot and humid; oppressively sticky"
                        ],
                        "tags": [
                            "of weather"
                        ],
                        "examples": [
                            {
                                "example_id": "42cc6346-0db5-48e9-a6e2-85cc15a77268",
                                "sense_id": "8c109eb8-26b9-37f0-aa59-7995424cb372",
                                "text": "The day was sweltering, so Lauren put on the shortest pair of shorts she could find and went to get ice-cream with her friend Rob."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dab77144-113b-45d3-bee6-f3c6aed4b606",
