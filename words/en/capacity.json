{
    "word_family": [
        "capable",
        "capability",
        "capacious",
        "capacitor",
        "incapacitate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ecbf139d-140d-3348-a29c-9d71d7e9b0bd",
                    "sense_definition": "The maximum amount that something can contain or hold.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium was filled to <w>capacity</w> for the final match.",
                            "target_lang_translations": {
                                "ru": "На финальный матч стадион был заполнен до <w>отказа</w>.",
                                "zh": "决赛时体育场内<w>座无虚席</w>。"
                            }
                        },
                        {
                            "text": "The fuel tank has a <w>capacity</w> of fifty liters.",
                            "target_lang_translations": {
                                "ru": "Топливный бак имеет <w>ёмкость</w> пятьдесят литров.",
                                "zh": "这个油箱的<w>容量</w>是五十升。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "full capacity",
                        "storage capacity",
                        "filled to capacity",
                        "seating capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Максимальное количество, которое что-либо может вместить или удержать.",
                        "zh": "某物所能容纳或包含的最大数量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вместимость",
                                "target_lang_sense_clarification": "объем пространства"
                            },
                            {
                                "target_lang_word": "ёмкость",
                                "target_lang_sense_clarification": "объем сосуда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容量",
                                "target_lang_sense_clarification": "容纳空间的大小"
                            },
                            {
                                "target_lang_word": "容积",
                                "target_lang_sense_clarification": "容器内部的空间大小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2829f74c-8278-3733-8b0d-a069940e0c0f",
                    "sense_definition": "The ability or power to do, experience, or understand something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a great <w>capacity</w> for hard work and dedication.",
                            "target_lang_translations": {
                                "ru": "У неё огромная <w>способность</w> к упорному труду и самоотдаче.",
                                "zh": "她有极强的<w>能力</w>去刻苦工作和奉献。"
                            }
                        },
                        {
                            "text": "The problem was beyond the mental <w>capacity</w> of the child.",
                            "target_lang_translations": {
                                "ru": "Эта задача была выше умственных <w>способностей</w> ребёнка.",
                                "zh": "这个问题超出了那个孩子的理解<w>能力</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capacity for",
                        "mental capacity",
                        "intellectual capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность или сила делать, испытывать или понимать что-либо.",
                        "zh": "做、经历或理解某事的能力或力量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способность",
                                "target_lang_sense_clarification": "умение или возможность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "能力",
                                "target_lang_sense_clarification": "胜任某事的力量或本领"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7d39533-7899-3460-b770-5daf571f1b02",
                    "sense_definition": "The maximum amount that can be produced by a machine, factory, or system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory is operating at full <w>capacity</w> to meet the high demand.",
                            "target_lang_translations": {
                                "ru": "Завод работает на полную <w>мощность</w>, чтобы удовлетворить высокий спрос.",
                                "zh": "工厂正在以全<w>产能</w>运转，以满足高涨的需求。"
                            }
                        },
                        {
                            "text": "We need to increase our manufacturing <w>capacity</w> next year.",
                            "target_lang_translations": {
                                "ru": "В следующем году нам нужно увеличить наши производственные <w>мощности</w>.",
                                "zh": "我们明年需要提高我们的制造<w>产能</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "production capacity",
                        "manufacturing capacity",
                        "excess capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Максимальный объем продукции, который может быть произведен машиной, заводом или системой.",
                        "zh": "机器、工厂或系统所能产生的最大产量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощность",
                                "target_lang_sense_clarification": "производственная"
                            },
                            {
                                "target_lang_word": "производительность",
                                "target_lang_sense_clarification": "эффективность работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "产能",
                                "target_lang_sense_clarification": "生产能力"
                            },
                            {
                                "target_lang_word": "生产力",
                                "target_lang_sense_clarification": "生产效率或能力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87c59603-7993-3320-9807-fa86c3d2c8de",
                    "sense_definition": "A specific role or position in which someone functions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He signed the document in his <w>capacity</w> as the chairman of the board.",
                            "target_lang_translations": {
                                "ru": "Он подписал документ в <w>качестве</w> председателя совета директоров.",
                                "zh": "他以董事会主席的<w>身份</w>签署了这份文件。"
                            }
                        },
                        {
                            "text": "She is currently acting in an advisory <w>capacity</w> to the government.",
                            "target_lang_translations": {
                                "ru": "В настоящее время она выступает в <w>качестве</w> советника правительства.",
                                "zh": "她目前正以顾问的<w>身份</w>为政府工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a capacity",
                        "official capacity",
                        "advisory capacity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная роль или должность, в которой кто-либо действует.",
                        "zh": "某人行事时所处的特定角色或职位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качество",
                                "target_lang_sense_clarification": "роль, статус (в качестве кого-либо)"
                            },
                            {
                                "target_lang_word": "должность",
                                "target_lang_sense_clarification": "служебное положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身份",
                                "target_lang_sense_clarification": "担任的职位或角色"
                            },
                            {
                                "target_lang_word": "资格",
                                "target_lang_sense_clarification": "以某种身份行事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c4d1a1a-9911-3645-b7d4-d60111f2ee2b",
                    "sense_definition": "The ability of a system to store an electric charge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_electrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The battery has lost much of its <w>capacity</w> over the years.",
                            "target_lang_translations": {
                                "ru": "За эти годы аккумулятор потерял большую часть своей <w>ёмкости</w>.",
                                "zh": "多年来，电池的<w>电容</w>已经损耗了很多。"
                            }
                        },
                        {
                            "text": "Engineers measured the electrical <w>capacity</w> of the circuit.",
                            "target_lang_translations": {
                                "ru": "Инженеры измерили электрическую <w>ёмкость</w> цепи.",
                                "zh": "工程师测量了电路的<w>电容</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность системы накапливать электрический заряд.",
                        "zh": "系统存储电荷的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ёмкость",
                                "target_lang_sense_clarification": "электрическая"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电容",
                                "target_lang_sense_clarification": "物理学中的电学容量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af359dbd-ae7d-31b1-a9ca-ce8897e40a1f",
                    "sense_definition": "Filling all the available space; fully occupied.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_volume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played to a <w>capacity</w> crowd at the arena.",
                            "target_lang_translations": {
                                "ru": "Группа играла перед <w>переполненным</w> залом на арене.",
                                "zh": "乐队在竞技场为<w>爆满</w>的观众进行了表演。"
                            }
                        },
                        {
                            "text": "There was a <w>capacity</w> audience for the opening night of the play.",
                            "target_lang_translations": {
                                "ru": "На премьере спектакля был <w>полный</w> зал зрителей.",
                                "zh": "戏剧首演当晚观众<w>座无虚席</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "capacity crowd",
                        "capacity audience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заполняющий всё доступное пространство; полностью занятый.",
                        "zh": "填满所有可用空间；完全被占用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полный",
                                "target_lang_sense_clarification": "заполненный до отказа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满座的",
                                "target_lang_sense_clarification": "形容观众席坐满"
                            },
                            {
                                "target_lang_word": "爆满的",
                                "target_lang_sense_clarification": "形容人多拥挤"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}