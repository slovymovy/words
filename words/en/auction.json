{
    "word_family": [
        "auctioneer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1995c324-b5b8-33cd-9d68-2e3c88947bc4",
                    "sense_definition": "A public event where goods or property are sold to the highest bidder.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They bought a beautiful vintage painting at an <w>auction</w>.",
                            "target_lang_translations": {
                                "ru": "Они купили красивую винтажную картину на <w>аукционе</w>.",
                                "zh": "他们在一次<w>拍卖会</w>上买到了一幅精美的复古画。"
                            }
                        },
                        {
                            "text": "The house will be sold by public <w>auction</w> next week.",
                            "target_lang_translations": {
                                "ru": "Дом будет продан с публичного <w>аукциона</w> на следующей неделе.",
                                "zh": "这栋房子下周将通过公开<w>拍卖</w>出售。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "public auction",
                        "auction house",
                        "silent auction",
                        "online auction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное мероприятие, на котором товары или имущество продаются тому, кто предложит самую высокую цену.",
                        "zh": "一种公开活动，将商品或财产出售给出价最高的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аукцион",
                                "target_lang_sense_clarification": "публичная продажа"
                            },
                            {
                                "target_lang_word": "торги",
                                "target_lang_sense_clarification": "конкурсная продажа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍卖",
                                "target_lang_sense_clarification": "公开竞价出售"
                            },
                            {
                                "target_lang_word": "拍卖会",
                                "target_lang_sense_clarification": "指代拍卖活动本身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cfd6ed8-2dce-3e53-944f-05b1ccf67d50",
                    "sense_definition": "The first stage of a deal in card games, in which players bid to determine the final contract.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the <w>auction</w>, the partners signaled their strong suits to each other.",
                            "target_lang_translations": {
                                "ru": "Во время <w>торговли</w> партнёры подавали друг другу сигналы о своих сильных мастях.",
                                "zh": "在<w>叫牌</w>过程中，搭档之间互相示意了各自的强牌花色。"
                            }
                        },
                        {
                            "text": "He won the <w>auction</w> with a bold bid of four spades.",
                            "target_lang_translations": {
                                "ru": "Он выиграл <w>торговлю</w> смелой заявкой в четыре пики.",
                                "zh": "他以大胆的四黑桃叫牌赢得了<w>叫牌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Первая стадия раздачи в карточных играх, на которой игроки делают ставки для определения финального контракта.",
                        "zh": "纸牌游戏中的第一阶段，玩家通过叫牌来确定最终合约。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговля",
                                "target_lang_sense_clarification": "в карточных играх"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叫牌",
                                "target_lang_sense_clarification": "桥牌等游戏中的竞价阶段"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41c7d082-3624-3114-8079-97fa29233f7c",
                    "sense_definition": "To sell something to the highest bidder at an auction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity decided to <w>auction</w> off the signed jerseys to raise funds.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация решила <w>продать с аукциона</w> подписанные футболки для сбора средств.",
                                "zh": "慈善机构决定将签名球衣<w>拍卖</w>以筹集资金。"
                            }
                        },
                        {
                            "text": "The bank had to <w>auction</w> the property after the owner went bankrupt.",
                            "target_lang_translations": {
                                "ru": "Банк был вынужден <w>продать с молотка</w> имущество после банкротства владельца.",
                                "zh": "业主破产后，银行不得不将该房产<w>拍卖</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "auction off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать что-либо тому, кто предложит самую высокую цену на аукционе.",
                        "zh": "在拍卖会上将某物出售给出价最高的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продавать с аукциона",
                                "target_lang_sense_clarification": "продажа через торги"
                            },
                            {
                                "target_lang_word": "продавать с молотка",
                                "target_lang_sense_clarification": "идиома, часто о принудительной продаже"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拍卖",
                                "target_lang_sense_clarification": "动词，进行拍卖"
                            },
                            {
                                "target_lang_word": "变卖",
                                "target_lang_sense_clarification": "指通过拍卖处理资产"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}