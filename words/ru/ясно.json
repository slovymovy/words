    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2a46c1d8-f4f8-34f8-9a42-1cd8a24a5f3b",
                    "sense_definition": "Оценка ситуации как понятной, очевидной и не вызывающей сомнений.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне всё <w>ясно</w>, спасибо за подробное объяснение.",
                            "target_lang_translations": {
                                "en": "Everything is <w>clear</w> to me, thanks for the detailed explanation.",
                                "es": "Me queda todo <w>claro</w>, gracias por la explicación detallada.",
                                "fr": "Tout est <w>clair</w> pour moi, merci pour l'explication détaillée."
                            }
                        },
                        {
                            "text": "Вам <w>ясно</w> ваше домашнее задание на завтра?",
                            "target_lang_translations": {
                                "en": "Is your homework for tomorrow <w>clear</w> to you?",
                                "es": "¿Les queda <w>clara</w> su tarea para mañana?",
                                "fr": "Votre devoir pour demain est-il <w>clair</w> ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "понятно",
                        "очевидно"
                    ],
                    "antonyms": [
                        "неясно"
                    ],
                    "common_phrases": [
                        "всё ясно",
                        "совершенно ясно",
                        "стало ясно",
                        "предельно ясно"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessment of a situation as understandable, obvious, and free of doubt.",
                        "es": "Evaluación de una situación como comprensible, evidente y sin lugar a dudas.",
                        "fr": "Évaluation d'une situation comme compréhensible, évidente et sans doute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "understandable; free of ambiguity"
                            },
                            {
                                "target_lang_word": "understood",
                                "target_lang_sense_clarification": "comprehended"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "claro",
                                "target_lang_sense_clarification": "comprensible o evidente"
                            },
                            {
                                "target_lang_word": "entendido",
                                "target_lang_sense_clarification": "que se ha comprendido bien"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "clair",
                                "target_lang_sense_clarification": "évident, compréhensible"
                            },
                            {
                                "target_lang_word": "évident",
                                "target_lang_sense_clarification": "qui ne laisse aucun doute"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9583a78f-01ef-3f5e-aa61-34332f40458a",
                    "sense_definition": "Хорошо различимо слухом или зрением; отчётливо, внятно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>ясно</w> и громко произнёс своё имя.",
                            "target_lang_translations": {
                                "en": "He pronounced his name <w>clearly</w> and loudly.",
                                "es": "Pronunció su nombre con <w>claridad</w> y en voz alta.",
                                "fr": "Il a prononcé son nom <w>clairement</w> et fort."
                            }
                        },
                        {
                            "text": "С горы было <w>ясно</w> видно всю деревню.",
                            "target_lang_translations": {
                                "en": "From the mountain, the whole village was <w>clearly</w> visible.",
                                "es": "Desde la montaña se veía <w>claramente</w> todo el pueblo.",
                                "fr": "Depuis la montagne, tout le village était <w>distinctement</w> visible."
                            }
                        }
                    ],
                    "synonyms": [
                        "отчётливо"
                    ],
                    "antonyms": [
                        "смутно",
                        "неясно"
                    ],
                    "common_phrases": [
                        "ясно видеть",
                        "ясно слышать",
                        "ясно понимать",
                        "коротко и ясно"
                    ],
                    "target_lang_definitions": {
                        "en": "Clearly distinguishable by hearing or sight; distinctly.",
                        "es": "Bien distinguible por el oído o la vista; de forma clara y nítida.",
                        "fr": "Bien distinct à l'ouïe ou à la vue ; nettement, clairement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "in a distinct manner; audibly or visibly"
                            },
                            {
                                "target_lang_word": "distinctly",
                                "target_lang_sense_clarification": "sharply; without blurring"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "claramente",
                                "target_lang_sense_clarification": "de manera clara o comprensible"
                            },
                            {
                                "target_lang_word": "claridad",
                                "target_lang_sense_clarification": "con nitidez o precisión"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "clairement",
                                "target_lang_sense_clarification": "d'une manière claire et nette"
                            },
                            {
                                "target_lang_word": "distinctement",
                                "target_lang_sense_clarification": "de façon bien perceptible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fdf3465-2a54-3218-8cc0-05d19d1d5366",
                    "sense_definition": "О погоде: светло, солнечно, без облаков.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сегодня на улице тепло и <w>ясно</w>.",
                            "target_lang_translations": {
                                "en": "It is warm and <w>clear</w> outside today.",
                                "es": "Hoy hace calor y está <w>despejado</w> afuera.",
                                "fr": "Aujourd'hui, il fait chaud et le temps est <w>dégagé</w> dehors."
                            }
                        },
                        {
                            "text": "Завтра в Санкт-Петербурге будет <w>ясно</w>, без осадков.",
                            "target_lang_translations": {
                                "en": "Tomorrow in Saint Petersburg it will be <w>clear</w>, with no precipitation.",
                                "es": "Mañana en San Petersburgo estará <w>despejado</w>, sin precipitaciones.",
                                "fr": "Demain à Saint-Pétersbourg, le ciel sera <w>dégagé</w>, sans précipitations."
                            }
                        }
                    ],
                    "synonyms": [
                        "безоблачно",
                        "солнечно",
                        "светло"
                    ],
                    "antonyms": [
                        "пасмурно",
                        "хмуро"
                    ],
                    "common_phrases": [
                        "сегодня ясно",
                        "на небе ясно"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding weather: bright, sunny, without clouds.",
                        "es": "Referido al tiempo: despejado, soleado, sin nubes.",
                        "fr": "Concernant le temps qu'il fait : lumineux, ensoleillé, sans nuages."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "of the sky: cloudless"
                            },
                            {
                                "target_lang_word": "sunny",
                                "target_lang_sense_clarification": "bright weather"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "despejado",
                                "target_lang_sense_clarification": "sin nubes, referente al tiempo"
                            },
                            {
                                "target_lang_word": "claro",
                                "target_lang_sense_clarification": "luminoso y soleado"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "dégagé",
                                "target_lang_sense_clarification": "en parlant du ciel, sans nuages"
                            },
                            {
                                "target_lang_word": "beau",
                                "target_lang_sense_clarification": "en parlant du temps, ensoleillé"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "391b83d1-2f33-3c55-a910-d312a06a7471",
                    "sense_definition": "Разговорное выражение, означающее согласие или принятие информации к сведению.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "conversation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Я не смогу прийти на встречу. — <w>Ясно</w>, тогда перенесём.",
                            "target_lang_translations": {
                                "en": "— I won't be able to come to the meeting. — <w>I see</w>, then we'll reschedule.",
                                "es": "— No podré ir a la reunión. — <w>Entendido</w>, entonces la cambiamos de fecha.",
                                "fr": "— Je ne pourrai pas venir à la réunion. — <w>D'accord</w>, on la décalera."
                            }
                        },
                        {
                            "text": "— Не трогай эту кнопку! — <w>Ясно</w>, не буду.",
                            "target_lang_translations": {
                                "en": "— Don't touch that button! — <w>Got it</w>, I won't.",
                                "es": "— ¡No tocás ese botón! — <w>Entendido</w>, no lo haré.",
                                "fr": "— Ne touche pas à ce bouton ! — <w>Compris</w>, je ne le ferai pas."
                            }
                        }
                    ],
                    "synonyms": [
                        "понятно",
                        "я́сненько"
                    ],
                    "common_phrases": [
                        "ну ясно",
                        "всё с тобой ясно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial expression indicating agreement or acknowledgement of information.",
                        "es": "Expresión coloquial que indica acuerdo o toma de conocimiento de la información.",
                        "fr": "Expression familière marquant l'accord ou la prise en compte d'une information."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "I see",
                                "target_lang_sense_clarification": "phrase indicating understanding"
                            },
                            {
                                "target_lang_word": "got it",
                                "target_lang_sense_clarification": "colloquial acknowledgement"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "short for 'it is clear'"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "entendido",
                                "target_lang_sense_clarification": "expresión de asentimiento"
                            },
                            {
                                "target_lang_word": "ya veo",
                                "target_lang_sense_clarification": "expresión que indica comprensión"
                            },
                            {
                                "target_lang_word": "claro",
                                "target_lang_sense_clarification": "expresión coloquial de acuerdo"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "d'accord",
                                "target_lang_sense_clarification": "expression marquant la compréhension"
                            },
                            {
                                "target_lang_word": "compris",
                                "target_lang_sense_clarification": "marque de prise en note d'une information"
                            }
                        ]
                    }
                }
            ]
        },
