                "senses": [
                    {
                        "sense_id": "26e7170d-e10a-3d43-8c91-600219356861",
                        "entry_id": "83e24f19-5412-30e5-a6a7-61084b323dc7",
                        "glosses": [
                            "Voiture publique qui transportait très vite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8ae4d6-04fe-415b-892d-f8259abc50f4",
                                "sense_id": "26e7170d-e10a-3d43-8c91-600219356861",
                                "text": "Un célérifère, qui attend les passagers du bateau à vapeur, les conduit le même soir à Bex, où l'on couche ordinairement."
                            },
                            {
                                "example_id": "4f09f02b-31a9-4f9d-9e3c-822cf770f4eb",
                                "sense_id": "26e7170d-e10a-3d43-8c91-600219356861",
                                "text": "Ne voila-t-il pas qu’un beau matin, tombent des nues à ma porte, par le célérifère de Villeneuve et trois carioles, un maître de pension français et toute une armée d'écoliers !"
                            },
                            {
                                "example_id": "103e40a3-24fa-4d3a-8ced-2323689dea0e",
                                "sense_id": "26e7170d-e10a-3d43-8c91-600219356861",
                                "text": "Sans parler, dit-on, des artistes de l’imitation qui, s’entendant à contrefaire les accents, n’hésitent pas à guetter indifféremment la diligence de Lyon après le célérifère de Bordeaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbedfcf0-3418-34d3-9e49-86de32716523",
                        "entry_id": "83e24f19-5412-30e5-a6a7-61084b323dc7",
                        "glosses": [
                            "Prétendu ancêtre du vélo qui aurait été inventé par le comte de Sivrac en 1790 mais qui est en fait un canular du journaliste français Louis Baudry de Saunier. ^([2])"
                        ],
                        "tags": [],
                        "note": "Il s’agirait d’un animal en bois (cheval, lion ou autre animal pouvant être monté) dont les pattes servent de fourches à une roue (une à l’avant et une à l’arrière) permettant de se déplacer en roulant. Il ne comporterait ni pédales, ni freins, ni système de direction. Il a été en fait inventé de toute pièce pour attribuer l’invention du vélo à un français",
                        "examples": []
                    }
                ],
