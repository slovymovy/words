                        "endormir un animal"
                    ]
                },
                {
                    "sense_id": "46ab1399-3bec-309f-b890-457ae3ce0cdf",
                    "sense_definition": "Dérober ou voler quelque chose discrètement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la fête, quelqu'un s'est arrangé pour m'<w>endormir</w> mon manteau sans que je m'en rende compte."
                        },
                        {
                            "text": "Il s'est encore fait <w>endormir</w> son téléphone dans les transports bondés."
