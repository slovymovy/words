                "senses": [
                    {
                        "sense_id": "56f33122-0812-33ce-a235-9731a8a59ea6",
                        "entry_id": "e34d03c1-1426-3400-a38b-19e35a0ea6f6",
                        "glosses": [
                            "Any leaf beetle of the family Chrysomelidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de3b70cc-31f1-40dc-bc2f-143c18ee2122",
                                "sense_id": "56f33122-0812-33ce-a235-9731a8a59ea6",
                                "text": "There was a paucity of chrysomelids at Greek sites and a distinctively northern faunal composition at sites north of Poland."
                            },
                            {
                                "example_id": "7fc50242-e3ff-4940-9da1-a9fa9b24937c",
                                "sense_id": "56f33122-0812-33ce-a235-9731a8a59ea6",
                                "text": "Working the low areas around the parking lot, I beat a fair number and diversity of beetles and hemipterans—mostly chrysomelids—but only a single Agrilus sp. off of Prosopis glandulosa."
                            },
                            {
                                "example_id": "ac36ea1c-67cb-49da-b630-0cf5b582eeb5",
                                "sense_id": "56f33122-0812-33ce-a235-9731a8a59ea6",
                                "text": "Chrysomelids use their faeces as a biomaterial for constructions and self-decoration behaviours that serve as defensive coats, mobile debris shields, and protective domiciles."
                            }
                        ]
                    }
