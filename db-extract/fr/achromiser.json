                "senses": [
                    {
                        "sense_id": "ca38cdfe-393c-39a1-9bf4-3123a6155a4d",
                        "entry_id": "c64b6fff-cf6b-3bd6-bb2d-2ef755d5826f",
                        "glosses": [
                            "Faire perdre sa couleur à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9813854d-5ab5-48f9-9811-89d191648b79",
                                "sense_id": "ca38cdfe-393c-39a1-9bf4-3123a6155a4d",
                                "text": "Enfin la pelade fait une clairière blanche, elle achromise la peau, qui conserve sa couleur dans la syphilis."
                            },
                            {
                                "example_id": "6b29eb8d-9c14-45f5-9005-b2025ee6461b",
                                "sense_id": "ca38cdfe-393c-39a1-9bf4-3123a6155a4d",
                                "text": "Toi, homme, comment peux-tu dire que tu aimes Le Soleil, si jamais dans ta vie tu n’as vu Le Prince, vivant aux nues, escorté de ses gemmes, Lorsque le ciel s’achromise et s’ôte de nos vues ?"
                            }
                        ]
                    }
