{
    "word_family": [
        "befuddle",
        "fuddle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae287da4-93dd-35f4-893f-b11bb554d813",
                    "sense_definition": "Feeling confused, perplexed, or unable to think clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>befuddled</w> student stared at the complex math problem, unable to find a starting point.",
                            "target_lang_translations": {
                                "zh": "那名<w>困惑</w>的学生盯着复杂的数学题，找不到切入点。"
                            }
                        },
                        {
                            "text": "After hearing the complicated instructions, he felt completely <w>befuddled</w> and asked for clarification.",
                            "target_lang_translations": {
                                "zh": "听完复杂的指令后，他感到完全<w>迷糊</w>了，于是请求进一步解释。"
                            }
                        }
                    ],
                    "synonyms": [
                        "confused",
                        "perplexed",
                        "bewildered",
                        "muddled",
                        "puzzled"
                    ],
                    "common_phrases": [
                        "befuddled brain",
                        "look befuddled"
                    ],
                    "target_lang_definitions": {
                        "zh": "感到困惑、迷茫，或无法清晰思考。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "困惑",
                                "target_lang_sense_clarification": "指因不理解或不清楚而感到迷茫。"
                            },
                            {
                                "target_lang_word": "糊涂",
                                "target_lang_sense_clarification": "指思维混乱，不清醒。"
                            },
                            {
                                "target_lang_word": "迷糊",
                                "target_lang_sense_clarification": "指头脑不清醒，处于混沌状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e88ea663-ae2e-336d-8c66-a751d870e870",
                    "sense_definition": "Intoxicated or drunk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intoxication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stumbled out of the bar, clearly <w>befuddled</w> by the excessive amount of wine he had consumed.",
                            "target_lang_translations": {
                                "zh": "他跌跌撞撞地走出酒吧，显然是因为喝了太多酒而<w>醉醺醺</w>的。"
                            }
                        },
                        {
                            "text": "The <w>befuddled</w> man could barely stand after a long night of heavy drinking.",
                            "target_lang_translations": {
                                "zh": "那个<w>烂醉</w>的男人在彻夜豪饮后几乎站不稳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "intoxicated",
                        "tipsy"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is considered somewhat old-fashioned."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "喝醉了的，受酒精影响而神志不清的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "醉醺醺",
                                "target_lang_sense_clarification": "形容醉酒后神志不清的样子。"
                            },
                            {
                                "target_lang_word": "烂醉",
                                "target_lang_sense_clarification": "指醉得非常厉害。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b957a72-0252-37c5-8bec-f402831f1d1d",
                    "sense_definition": "Simple past and past participle of <w>befuddle</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected news <w>befuddled</w> everyone in the room.",
                            "target_lang_translations": {
                                "zh": "突如其来的消息把屋里的每个人都<w>搞糊涂</w>了。"
                            }
                        },
                        {
                            "text": "He had been <w>befuddled</w> by the strange behavior of his colleagues all day.",
                            "target_lang_translations": {
                                "zh": "他整天都被同事们奇怪的行为<w>弄得困惑</w>不已。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使困惑，使迷糊（befuddle 的过去式及过去分词）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使困惑",
                                "target_lang_sense_clarification": "指导致某人无法理解或思考。"
                            },
                            {
                                "target_lang_word": "搞糊涂",
                                "target_lang_sense_clarification": "指把某人弄得思维混乱。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}