                        "examples": [
                            {
                                "example_id": "096db908-e7ed-4b5c-9d72-3f0f9018dcc6",
                                "sense_id": "1c424e16-aa3b-3588-8184-243167971759",
                                "text": "In vele streken bakken de huisvrouwen op St-Martensavond boetweitkoeken. In Limburg leeft dit aloud gebruik ook nog voort. De koekenbak wordt er niet vergeten omdat, zegt het volk, deze Heilige boekweit deed malen en gereed maken om het volk te spijzen."
                            }
                        ]
                    },
                    {
                        "sense_id": "93ff33bf-4129-3ddf-a898-770dacaa90dc",
                        "entry_id": "0210acc2-e4f1-3037-9bc6-380845bf71fe",
                        "glosses": [
                            "feestelijke bijeenkomst rond het bakken van pannenkoeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997efb86-9b44-43ae-b36d-aab8f2a3cefd",
                                "sense_id": "93ff33bf-4129-3ddf-a898-770dacaa90dc",
                                "text": "Pas in de zomer raakt de handeling in een stroomversnelling, wanneer zowel beide zusters als Luc Hancq van de partij zijn op een koekenbak bij Rijken Boer."
                            }
                        ]
                    },
                    {
                        "sense_id": "f877f1b6-2977-34c8-923c-01c463556d11",
                        "entry_id": "0210acc2-e4f1-3037-9bc6-380845bf71fe",
                        "glosses": [
