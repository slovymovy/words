                ],
                "senses": [
                    {
                        "sense_id": "f78fb2b9-5531-3ec0-bb91-96f88824509e",
                        "entry_id": "0168ca25-0ac7-397f-9c92-4fc2e6b4ced8",
                        "glosses": [
                            "gasförmige chemische Verbindung, die aus Sauerstoff und Stickstoff besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bae8c46-0d86-42a4-87c7-379120320830",
                                "sense_id": "f78fb2b9-5531-3ec0-bb91-96f88824509e",
                                "text": "„So haben einige tierische Krankheitserreger gelernt, die toxischen Wirkungen des Stickoxids in bösartiger Weise gegen ihr Opfer selbst zu wenden.“"
                            },
                            {
                                "example_id": "c6f5752c-283f-49ac-a06a-24dca09238e1",
                                "sense_id": "f78fb2b9-5531-3ec0-bb91-96f88824509e",
                                "text": "„Wie Stickoxid der Pflanze bei der Bekämpfung von Schädlingen hilft, ist noch weitgehend unklar.“"
                            },
                            {
                                "example_id": "32b4b03c-a916-4e8d-a5bb-20913aee87bf",
                                "sense_id": "f78fb2b9-5531-3ec0-bb91-96f88824509e",
                                "text": "„Stickoxid ist aber – ebenso wie Superoxid und Wasserstoffperoxid – auch als Signalgeber an der Mobilisierung von Abwehrgenen in der Pflanze beteiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
