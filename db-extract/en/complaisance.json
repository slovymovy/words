                "forms": [],
                "senses": [
                    {
                        "sense_id": "7cbcc1ea-c54e-3772-82ba-71b509366722",
                        "entry_id": "36425d26-16ec-32d8-b5d2-57ad89e29adc",
                        "glosses": [
                            "Gefälligkeit, Willfähigkeit, Höflichkeit"
                        ],
                        "tags": [],
                        "examples": [],
