                                        "examples": [
                                            {
                                                "example_id": "3b1b0aa5-1844-49cc-ab4f-c7441c4bdf7c",
                                                "sense_id": "67b85226-e6b9-3d4a-b17c-b1314abad2f9",
                                                "text": "I feel for him: he’s lost two family members in two months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a9cf7b7-7691-3f52-8e91-cec4877fd51c",
                                        "entry_id": "3380e3cf-93d8-3b0b-bbcc-82bc44d720f8",
                                        "glosses": [
                                            "To search for something by touching (as with one’s hand in a bag)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d7c9bf-6e15-4670-89b8-cf708fc35408",
                                                "sense_id": "1a9cf7b7-7691-3f52-8e91-cec4877fd51c",
                                                "text": "He felt for his purse."
                                            },
                                            {
                                                "example_id": "0151ea13-38c2-4f81-85bb-070e3f6b333e",
                                                "sense_id": "1a9cf7b7-7691-3f52-8e91-cec4877fd51c",
                                                "text": "Harry felt for his purse in his left-hand trousers pocket, but it was not there. He then tried his right-hand trousers pocket, but it was not there. He then tested the left hand pocket of his vest, but it was not there. He then explored the right-hand pocket of his vest, but it was not there. He then darted a hand into each of the pockets of his shooting-jacket, but it was not there."
                                            }
                                        ]
                                    }
                                ]
                            }
