                        "target_lang_word": "Schiffseigner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiffseigner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc3692f5-dfe4-354c-be0a-4d74e4a06895",
                                        "entry_id": "bf873c23-83ad-381d-968d-9c505d1d8b0c",
                                        "glosses": [
                                            "Eigner eines Schiffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0657ab1e-9de5-4f72-b82b-046ab439b803",
                                                "sense_id": "cc3692f5-dfe4-354c-be0a-4d74e4a06895",
                                                "text": "Bei der Schiffstaufe war auch der Schiffseigner anwesend."
                                            },
                                            {
                                                "example_id": "146b32f1-88a4-461d-a22b-338e2aca867b",
                                                "sense_id": "cc3692f5-dfe4-354c-be0a-4d74e4a06895",
                                                "text": "„Die Schiffseigner stellten die drittgrößte Handelsflotte der Welt und flankierten Deutschlands Aufstieg zum Exportweltmeister.“"
                                            },
                                            {
                                                "example_id": "1b8d57eb-1840-497c-b545-3fa84a55d9a6",
                                                "sense_id": "cc3692f5-dfe4-354c-be0a-4d74e4a06895",
                                                "text": "„Mit einer Tüte voll Obst, Fladenbrot und Wasser finde ich mich beim Schiffseigner wieder ein, damit er mir erklärt, wie ich zur Dhau gelangen kann.“"
                                            },
                                            {
                                                "example_id": "a8e7de51-b864-4000-8071-d0962a442aa6",
                                                "sense_id": "cc3692f5-dfe4-354c-be0a-4d74e4a06895",
                                                "text": "„Die Briten verzichteten ab 1660 darauf, für die Ostindiengesellschaft eine eigene Flotte zu unterhalten, sondern mieteten statt dessen die Schiffe von Schiffseignern, die sich darum bemühten, der Ostindiengesellschaft die schnellsten und besten Schiffe anzubieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
