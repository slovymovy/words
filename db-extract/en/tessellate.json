                        "target_lang_word": "parkettieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parkettieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                        "entry_id": "b11b3e26-802a-300c-9e04-63be217ac508",
                                        "glosses": [
                                            "einen Raum mit Parkettboden ausstatten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07a8f4ca-8a21-4ca2-bbf1-511d2da0a432",
                                                "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                                "text": "Er gab allen diesen zusammengehörigen Gebäuden eine neue Einrichtung, öffnete Fenster, ließ Thüren anbringen, den Boden parkettieren, verbarg die Balken …"
                                            },
                                            {
                                                "example_id": "30f518b5-8c8f-43a4-9420-c049ee08a945",
                                                "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                                "text": "„Der Fußboden meines Wohnzimmers ist ein Rechteck und ich habe ihn mit elf Quadraten parkettieren lassen, die die Seitenlängen ein Fuß, zwei Fuß, drei Fuß bis hin zu elf Fuß haben. Alle Quadratseiten verlaufen parallel oder quer zu den Wänden.“"
                                            },
                                            {
                                                "example_id": "25d05884-cd62-48c0-bfd5-cfdba8bd1607",
                                                "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                                "text": "Der Wert der größten Banknote (100 Zim$) sinkt während meines Aufenthalts in Victoria Falls von 80 auf 65 Pfennige. Wenn man 200 Dollar tauscht, kann man mit den Scheinen ein kleines Zimmer parkettieren."
                                            },
                                            {
                                                "example_id": "e9caabb6-3587-4f5c-bc89-31c7ff8b931e",
                                                "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                                "text": "Der Saal war blau gestrichen, mit roten Gardinen ausgestattet, Stühle und Tische waren weiß lackiert; der Fußboden wurde parkettiert."
                                            },
                                            {
                                                "example_id": "08c93dce-2c39-4157-9b85-f1618a6f1bed",
                                                "sense_id": "0a2447a6-307f-3ec8-81df-de138f87336f",
                                                "text": "Das Gemälde ist auf einer Eichenholztafel gemalt, die vermutlich im frühen 19. Jahrhundert parkettiert wurde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
