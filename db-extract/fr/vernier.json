                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50a9a53f-bc83-3abf-bf52-a11a29e4784d",
                                        "entry_id": "3cfc8bd3-94e3-3775-b7ef-90867eee15dc",
                                        "glosses": [
                                            "A secondary control input with finer control than the primary, or coarse, input; for example the vernier frequency tuning knob on a radio."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "caa2fd2c-ced8-3218-a37c-fd1d1a47b2cf",
