                    {
                        "translation_id": "8b409282-819f-45a5-98fa-763a4e6ef6ee",
                        "source_entry_id": "269dcac0-8290-37fe-bfb8-b2b1a14990a0",
                        "source_sense_id": "2be64493-ee08-3739-abec-995246bd2b07",
                        "target_lang_word": "unbalance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbalance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                        "entry_id": "ea31637d-6143-3efc-bd62-2a8d9ac39d6d",
                                        "glosses": [
                                            "To cause to be out of balance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282853c9-012a-45ef-9df6-8c313e9eca86",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "If you put that weight on the edge of the tray, it will unbalance it and dump all of the dishes on the floor."
                                            },
                                            {
                                                "example_id": "5ee4be66-2f44-4b9c-bd6b-b28e75a3dff1",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "Or, finally, might our awful situation prey upon and unbalance our minds? A group of insane folk upon a dead world!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "656340d7-2dc4-4394-b434-5d379adc61f2",
                        "source_entry_id": "269dcac0-8290-37fe-bfb8-b2b1a14990a0",
                        "source_sense_id": "2be64493-ee08-3739-abec-995246bd2b07",
                        "target_lang_word": "offset",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "offset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78b1e0b3-0d2c-3e51-a806-1920ecf66897",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "Anything that acts as counterbalance; a compensating equivalent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f23e5baf-0f4d-4919-bdc9-1548e5e49712",
                                                "sense_id": "78b1e0b3-0d2c-3e51-a806-1920ecf66897",
                                                "text": "Today's victory was an offset to yesterday's defeat."
                                            },
                                            {
                                                "example_id": "ec604cba-d33c-4e91-8cb0-49b03459b031",
                                                "sense_id": "78b1e0b3-0d2c-3e51-a806-1920ecf66897",
                                                "text": "There were more applicants for situations than vacancies, and nothing better or more congenial to my taste offering, I accepted a place in a Saloon. The salary was $100 per month, which was somewhat of an offset against the peculiarities of the position."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb8fbac5-b625-392a-a840-28b36e4b16bf",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A form of countertrade arrangement, in which the seller agrees to purchase within a set time frame products of a certain value from the buying country. This kind of agreement may be used in large international public sector contracts such as arms sales."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4279a1f-4ed2-37db-9c7e-8d8a2de6a058",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A time at which something begins; outset."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485d251c-0fe7-418f-84ab-c294862c24ba",
                                                "sense_id": "d4279a1f-4ed2-37db-9c7e-8d8a2de6a058",
                                                "text": "Later, Timberlake would tell Playboy that he noticed Ryan's talent from the offset, saying, 'I thought he had charisma that was just beaming, which has turned out to serve him really well as an actor.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4853496-aec2-3e64-95c3-f63fa7e90ff8",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "The offset printing process, in which ink is carried from a metal plate to a rubber blanket and from there to the printing surface."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ee3084-4b81-4a7b-96db-dee520bf2ca2",
                                                "sense_id": "b4853496-aec2-3e64-95c3-f63fa7e90ff8",
                                                "text": "offset lithographs"
                                            },
                                            {
                                                "example_id": "51a09884-1e9f-40e3-a2db-288cbdd7df45",
                                                "sense_id": "b4853496-aec2-3e64-95c3-f63fa7e90ff8",
                                                "text": "offset process"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff301728-fde2-3494-81a1-6bdec002c948",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "The difference between a target memory address and a base address."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b9cfe3-7f8e-4cf9-9e04-f213286bfc64",
                                                "sense_id": "ff301728-fde2-3494-81a1-6bdec002c948",
                                                "text": "An array of bytes uses its index as the offset, of words a multiple thereof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e5da4e-d1db-39ac-88e7-b7e6c91d69fc",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "The displacement between the base level of a measurement and the signal's real base level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1647341-fe2a-4430-a3c0-57bdeb79b5ef",
                                                "sense_id": "42e5da4e-d1db-39ac-88e7-b7e6c91d69fc",
                                                "text": "The raw signal data was subjected to a baseline correction process to subtract the sensor's offset and drift variations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d63ae606-b231-3a50-99b0-1b1bd799d72d",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "The distance by which one thing is out of alignment with another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d8ed13-b4bb-444f-aac2-b8896412224a",
                                                "sense_id": "d63ae606-b231-3a50-99b0-1b1bd799d72d",
                                                "text": "There is a small offset between the switch and the indicator which some users found confusing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f529199-e2d6-3692-b03a-feb79270d902",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A short distance measured at right angles from a line actually run to some point in an irregular boundary, or to some object."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52c9f9c0-06a0-3107-bd32-fddd1f7c6bd4",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "An abrupt bend in an object, such as a rod, by which one part is turned aside out of line, but nearly parallel, with the rest; the part thus bent aside."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "442d7ed7-e5fb-36ec-834d-4963c92f088c",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A short prostrate shoot that takes root and produces a tuft of leaves, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48cc58fb-1e52-4770-9beb-d800e05a09f9",
                                                "sense_id": "442d7ed7-e5fb-36ec-834d-4963c92f088c",
                                                "text": "[…] [I]nfected tulips are weakened by the viruses that cause the very patterns and swirls that fascinated horticulturists and investors in the first place. Such bulbs tend to dwindle away instead of fattening up and producing offsets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "febb478d-eb98-361f-b1f0-5bd09af6ebd1",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A spur from a range of hills or mountains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ddbeb7d4-bb49-3100-9583-5cb12ee4e943",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A horizontal ledge on the face of a wall, formed by a diminution of its thickness, or by the weathering or upper surface of a part built out from it; a set-off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1b19b00-98fb-3ba8-81bb-091de4631598",
                                        "entry_id": "6e9a2208-6064-358c-adef-8f0b15e87be2",
                                        "glosses": [
                                            "A terrace on a hillside."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "offset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                        "entry_id": "7d8e098e-f57c-315b-a5d9-e047f5e82929",
                                        "glosses": [
                                            "To counteract or compensate for, by applying a change in the opposite direction."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ebd72b-87e0-4427-9cc4-39a49b43b5cb",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "I'll offset the time difference locally."
                                            },
                                            {
                                                "example_id": "88968750-63e5-463f-aa7b-d691a34f9a24",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "to offset one charge against another"
                                            },
                                            {
                                                "example_id": "e04d5700-8003-42a5-a78a-50d3f897ce23",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "But the modest gain in comfort and operating convenience so secured has been more than offset, in my experience, by the draughtiness of the standard cab."
                                            },
                                            {
                                                "example_id": "ac8d7d20-2c5e-4204-9d58-4ee207703ef2",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "In order to gain first-hand experience of the operation of the new services I made a footplate journey on the only down two-hour train in the current timetable, the 8.30 a.m. Paddington [to Birmingham], a new express put on to offset the withdrawal of the 8.40 a.m. from Euston."
                                            },
                                            {
                                                "example_id": "0c9fa944-d95f-4247-a236-efac1826a108",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "The maroon livery of D1001 is offset, not only by yellow buffer beams and \"aprons\", but by white-painted cab window frames."
                                            },
                                            {
                                                "example_id": "fad3b05e-0053-4225-a036-3eaa993acf13",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "The company said its rising production and sales were largely offset by reductions in the impact of raw material use, for instance by replacing virgin cashmere fibres with regenerated cashmere that had previously been considered a waste material."
                                            },
                                            {
                                                "example_id": "70a30fc9-fd8f-4b45-8468-639d966d96ba",
                                                "sense_id": "ba0d8955-9dba-3e1e-939f-00364de55aff",
                                                "text": "For many investors using $3,000 in losses to offset regular income taxes can be more financially beneficial than offsetting gains, said Indiana-based CFP Russ Ford, because their income tax rates are higher than their long-term capital gains rate, which is 15% for most investors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e7dc8f0-b29e-31a2-9ec9-673be25ed835",
                                        "entry_id": "7d8e098e-f57c-315b-a5d9-e047f5e82929",
                                        "glosses": [
                                            "To place out of line."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2f0c78-03fb-3ada-9fca-a67130af7472",
                                        "entry_id": "7d8e098e-f57c-315b-a5d9-e047f5e82929",
                                        "glosses": [
                                            "To form an offset in (a wall, rod, pipe, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "offset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                        "entry_id": "ebe9c9d6-5dda-322d-a665-a72d7f8f90cd",
                                        "glosses": [
                                            "Away from or off from the set of a movie, film, video, or play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bedc34-6d03-40ab-9346-6331ccbb1810",
                                                "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                                "text": "For his scenes in alien form Bowie had to spend up to five hours each day in make-up: offset he painted, wrote and read voraciously."
                                            },
                                            {
                                                "example_id": "0597d34a-8746-41e8-82c8-5857d51423b3",
                                                "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                                "text": "Offset Riley is romantically involved with Alexandra Maria Lara, who plays lan Curtis's lover Annik Honoré in Control."
                                            },
                                            {
                                                "example_id": "a2294823-2f90-4996-85d5-c35094f4cf1d",
                                                "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                                "text": "Anita's pianoises are made offset for her by Norma Boleslawski, wife of late, great director Richard Boleslawski."
                                            },
                                            {
                                                "example_id": "bd46113d-e484-42b7-bf5a-35fac2323e79",
                                                "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                                "text": "'Are the pubs open?' When the reply came back that they were indeed open, he would say, 'Then fuck your quarterly,' and rush offset, even though the break wasn't meant for the actors."
                                            },
                                            {
                                                "example_id": "d195b5f1-b2b5-49c9-ac1b-8196e86cedc7",
                                                "sense_id": "28de55f1-51ee-311d-a0cd-1f0335225e54",
                                                "text": "Not only did the cast and crew get along on set, that camaraderie continued offset as well."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offset",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c390fe4e-be37-31b3-9ab8-8057300d60a4",
                                        "entry_id": "293eb291-cdb2-3c73-91c4-c887e497d83a",
                                        "glosses": [
                                            "Away from or off from the set of a movie, film, video, or play."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6498dab9-5b97-46a2-93ea-34dc572e39c9",
                                                "sense_id": "c390fe4e-be37-31b3-9ab8-8057300d60a4",
                                                "text": "By then, the cast had become good friends and spent all their offset time together."
                                            },
                                            {
                                                "example_id": "451a685c-fb02-47d1-ab8a-9dcc75159029",
                                                "sense_id": "c390fe4e-be37-31b3-9ab8-8057300d60a4",
                                                "text": "This is the principal need for a stand-in. To allow the actor to reset their own performance in a space right offset; which may also include resetting wardrobe and makeup."
                                            },
                                            {
                                                "example_id": "ecb60e20-e99f-41aa-b86a-5a7b62946033",
                                                "sense_id": "c390fe4e-be37-31b3-9ab8-8057300d60a4",
                                                "text": "Offset photos show him absorbed in a biography of acting hero Buster Keaton upon whom Bowie modelled his stone face — 'on which you could read anything'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
