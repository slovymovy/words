                                                "example_id": "15b6ad6c-a304-4141-9df7-c54180abd9d7",
                                                "sense_id": "5acc2b22-8820-3333-8cbd-3ed8998c8a13",
                                                "text": "Tu wszyscy spólnie robią: wierna strzeże rada, • Jeśli który daremnie trąd miodu nie zjada …"
                                            }
