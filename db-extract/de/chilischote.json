                "senses": [
                    {
                        "sense_id": "ce38ea25-41ad-3795-9cb0-e8e05c7c1c11",
                        "entry_id": "2913bec5-1c2e-3fb8-8175-51bc41e43247",
                        "glosses": [
                            "Fruit du piment piquant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0e4975-c8c1-47b1-af3b-fd4fb1b00c24",
                                "sense_id": "ce38ea25-41ad-3795-9cb0-e8e05c7c1c11",
                                "text": "Zwiebeln und Chilischoten klein schneiden, Kürbis waschen, entkernen und 1,5 cm breite Würfel schneiden.",
                                "translation": "Emincer les oignons et les piments, laver le potiron, l’épépiner et le couper en cubes de 1,5 cm de large."
                            },
                            {
                                "example_id": "d02c688f-e4e8-42e7-ae83-9275afce5df4",
                                "sense_id": "ce38ea25-41ad-3795-9cb0-e8e05c7c1c11",
                                "text": "Schalotten, Knoblauch und Ingwer schälen und fein hacken, Chilischote halbieren, Samen entfernen und klein würfeln (Alternative: Chilipulver).",
                                "translation": "Eplucher et hacher finement les échalotes, l’ail et le gingembre, couper le piment en deux, retirer les graines et couper en petits dés (alternative : piment en poudre)."
                            }
                        ]
                    }
                ],
