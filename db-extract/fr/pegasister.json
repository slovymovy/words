                                        "entry_id": "e9dd5a4d-553e-3d9b-8b12-503376ffbc77",
                                        "glosses": [
                                            "A female fan of the animated television series My Little Pony: Friendship Is Magic, typically an adult."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6231d5fe-c9ed-42ab-af38-cc74a8219c4f",
                                                "sense_id": "1860da30-f998-3559-ba8b-35ae2a31c682",
                                                "text": "\"Bronies\" and \"pegasisters,\" as some fans are called, point to the quality of animation and humor as what makes the series enjoyable."
                                            },
                                            {
                                                "example_id": "43c89800-1222-4b46-b4bc-7f09aa9b9af9",
                                                "sense_id": "1860da30-f998-3559-ba8b-35ae2a31c682",
                                                "text": "The group included four \"Pegasisters,\" as the small minority of female bronies sometimes call themselves in this male-dominated world."
                                            },
                                            {
                                                "example_id": "a8894945-254b-4d01-b373-d66044e60cdf",
                                                "sense_id": "1860da30-f998-3559-ba8b-35ae2a31c682",
                                                "text": "“I’d say 80 percent of my friends are into it,” says the “pegasister,” slang for a female fan. “My dorm loves it. We get together to watch the shows, and we eat and laugh.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
