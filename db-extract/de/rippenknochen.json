                "senses": [
                    {
                        "sense_id": "6ffd29de-b23b-35b8-ae89-22a3a66548bf",
                        "entry_id": "c818e86b-c441-326f-be45-d386e9894395",
                        "glosses": [
                            "Knochen, welche die Rippen bilden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a860ac6a-8065-4fee-a4d9-fa8f473c4079",
                                "sense_id": "6ffd29de-b23b-35b8-ae89-22a3a66548bf",
                                "text": "„Seine Atemzüge gingen kurz und keuchend und die gebrochenen Rippenknochen knirschten bei jedem Röcheln mit.“"
                            },
                            {
                                "example_id": "987413af-f5b6-4c34-8e56-0dc2bfb84649",
                                "sense_id": "6ffd29de-b23b-35b8-ae89-22a3a66548bf",
                                "text": "„Und unter einer dicken Muskelschicht fühlt man ihre Rippenknochen.“"
                            },
                            {
                                "example_id": "ec670fd9-415a-4d60-bf92-05e06251af50",
                                "sense_id": "6ffd29de-b23b-35b8-ae89-22a3a66548bf",
                                "text": "„Der Mann hatte durch den Hieb die Deckung vernachlässigt; seine Rippenknochen waren ungeschützt.“"
                            },
                            {
                                "example_id": "865b5080-2a74-4e73-b3e5-79c920ff2058",
                                "sense_id": "6ffd29de-b23b-35b8-ae89-22a3a66548bf",
                                "text": "„Pollys gebrochene Rippenknochen reiben sich aneinander, und sie beißt sich auf die Zunge, um nicht vor Schmerzen laut aufzuschreien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
