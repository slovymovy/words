                        "glosses": [
                            "zentral gelegener Teil eines Ortes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3925b33e-3d65-4e37-b4a7-d7a3dbc7f8e3",
                                "sense_id": "7de6212e-42e9-3588-9644-c69cfdc4e767",
                                "text": "Die mittelalterlichen Fachwerkhäuser im Ortszentrum sind alle denkmalgeschützt."
                            },
                            {
                                "example_id": "975398ce-0b83-430f-ad88-e798fdf5218b",
                                "sense_id": "7de6212e-42e9-3588-9644-c69cfdc4e767",
                                "text": "„Daher wartete ich bis elf, bis ich ins Ortszentrum loszog.“"
                            },
                            {
                                "example_id": "57bb5960-3f3b-43e3-84c2-a9cbb0d22430",
                                "sense_id": "7de6212e-42e9-3588-9644-c69cfdc4e767",
                                "text": "„Das Ortszentrum bildet die kleine Holzkirche aus dem Jahr 1867.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
