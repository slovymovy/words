                "senses": [
                    {
                        "sense_id": "afac6b99-fad0-3245-97e1-f626e09b0fdf",
                        "entry_id": "e0cf186f-4354-33f6-97ce-41b396f013e2",
                        "glosses": [
                            "Faire perdre son caractère bootable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3e94d1-911b-49f4-a18c-32328d131116",
                                "sense_id": "afac6b99-fad0-3245-97e1-f626e09b0fdf",
                                "text": "Je souhaiterais savoir si après avoir booté une clé USB, on peut la \"débooter\", c’est-à-dire la rendre normale?"
                            },
                            {
                                "example_id": "07b6cf89-b096-43d6-90b4-ce9f9807f6c6",
                                "sense_id": "afac6b99-fad0-3245-97e1-f626e09b0fdf",
                                "text": "Comment débooter une clé usb ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4314b03-797e-3423-8be3-15d602e22a95",
                        "entry_id": "e0cf186f-4354-33f6-97ce-41b396f013e2",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4aaf0e1-9d93-4dc2-855a-9a202886bd0e",
                                "sense_id": "a4314b03-797e-3423-8be3-15d602e22a95",
                                "text": "J’ai vu la blanche écume venir doucement lécher le rivage et mourir dans la langueur d’une dernière étreinte avec le sable chaud… Ne me regardez pas avec ces loops de lump ! Non, je n’ai pas complètement débooté !"
                            }
                        ]
                    }
