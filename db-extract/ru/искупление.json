                    {
                        "translation_id": "1670c6ab-aa47-4cb5-a0f7-46bbdb4f5caa",
                        "source_entry_id": "6dcda355-0e98-3315-b601-d7a9e1b8bbd5",
                        "source_sense_id": "e7ba61fd-d2f4-3709-b342-5b25db3f17eb",
                        "target_lang_word": "ransom",
                        "target_lang_code": "en",
