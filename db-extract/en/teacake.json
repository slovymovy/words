    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                "word": "teacake",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "24362972-a2c2-410f-899b-fd729c5f8d5a",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "tags": [
                            "plural"
                        ],
                        "form": "teacakes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e28c31f8-4537-346f-a16b-269b84ad532f",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A flat, round bread bun, usually containing currants, sultanas or peel and often served toasted and buttered with tea."
                        ],
                        "tags": [
                            "Ireland",
                            "Southern-England",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "adcd36f4-8c61-48ce-8afe-94f07a2c9598",
                                "sense_id": "e28c31f8-4537-346f-a16b-269b84ad532f",
                                "text": "Molly poured from the teapot and Judith drank the strong hot tea and ate the buttered teacakes."
                            },
                            {
                                "example_id": "395b7ef3-bc8b-4402-bbbc-e274bb2aeb5b",
                                "sense_id": "e28c31f8-4537-346f-a16b-269b84ad532f",
                                "text": "Traditionalists will adore the Lanesborough on Hyde Park Corner, with its stately decor, toasted teacakes and clotted cream-laden scones."
                            },
                            {
                                "example_id": "c4a6c138-82d3-4dd1-8b0f-232680607880",
                                "sense_id": "e28c31f8-4537-346f-a16b-269b84ad532f",
                                "text": "I love the tart, sticky fruit in a warm toasted teacake."
                            }
                        ]
                    },
                    {
                        "sense_id": "24204890-4212-3f45-b59f-99c218098d10",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A bread roll without fruit; a barm."
                        ],
                        "tags": [
                            "Cumbria",
                            "Northern-England"
                        ],
                        "examples": [
                            {
                                "example_id": "4f6466ea-d3e1-48f8-9087-959f325ef0a1",
                                "sense_id": "24204890-4212-3f45-b59f-99c218098d10",
                                "text": "... in Yorkshire and Lancashire mill-workers largely use the plain teacake as a convenient form of bread to be consumed at the meals which they carry with them to eat during the day when living far from their work."
                            },
                            {
                                "example_id": "0d67c898-d996-4f67-8c55-d11d0fbb040e",
                                "sense_id": "24204890-4212-3f45-b59f-99c218098d10",
                                "text": "I thought at the time that they must be deaf or daft in Sheffield. I'd noticed the same at Slack's bread shop on Staniforth Road. I had asked for a teacake and ended up with a currant breadcake."
                            },
                            {
                                "example_id": "f6f23ac7-bb85-436c-82f0-839b18484cd0",
                                "sense_id": "24204890-4212-3f45-b59f-99c218098d10",
                                "text": "Outside a bread shop in the city centre [Bradford], a queue of two dozen students formed. They wore red armbands and carried the slogan 'Peace, Land, Bread'. Each student bought one teacake."
                            }
                        ]
                    },
                    {
                        "sense_id": "fecc338a-1a37-3285-b968-8f3475dd72c9",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A snack consisting of shortbread topped with meringue or marshmallow, coated in chocolate."
                        ],
                        "tags": [
                            "Ireland",
                            "Scotland",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "0f379073-cecd-4d38-bb5a-5f15c4d31e74",
                                "sense_id": "fecc338a-1a37-3285-b968-8f3475dd72c9",
                                "text": "Sometimes there was a Tunnock's wafer or (bastard) a chocolate marshmallow teacake in its red-and-silver foil."
                            },
                            {
                                "example_id": "82247a20-9343-4793-b8d7-7ab63d9d6167",
                                "sense_id": "fecc338a-1a37-3285-b968-8f3475dd72c9",
                                "text": "In 2014, captivated by the Glasgow Commonwealth Games, many found dancing teacakes and Scottie dogs great guilty fun."
                            },
                            {
                                "example_id": "0cbf0186-0b23-4d1b-9e54-c53a8932288f",
                                "sense_id": "fecc338a-1a37-3285-b968-8f3475dd72c9",
                                "text": "A liquid meringue flooded from the seam where the dome met the biscuit, so that each teacake transformed into a melted snowman wearing a chocolate bowler hat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba2057e5-f52a-3fb9-b696-75c224065e06",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A traditional type of dense, large cookie, typically hard-baked, not particularly sweet, and with few extra fillings."
                        ],
                        "tags": [
                            "Southern-US",
                            "US",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "3ebd19e5-904a-485d-886e-9b0fd070607c",
                                "sense_id": "ba2057e5-f52a-3fb9-b696-75c224065e06",
                                "text": "He turned to get her attention then, but I didn't hear what he said because that was when Celeste asked me if a teacake was an American madeleine. And I said not really because it was really a very plain, not very sweet soft cookie, whereas a madeleine was very sweet like a down-home muffin and was baked in a muffin pan."
                            },
                            {
                                "example_id": "75b1072a-f6de-48bf-a327-0bee3c3a89f4",
                                "sense_id": "ba2057e5-f52a-3fb9-b696-75c224065e06",
                                "text": "She liked children and kept them supplied with little teacakes or sugar cookies which the children called Duffy cakes."
                            }
                        ]
                    },
                    {
                        "sense_id": "77141bdb-c932-3c53-a3f2-a33a1fb1d9b3",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A small delicate cake or pastry; a petit four."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "c0095d14-1400-4437-95b1-fdb37ae534bb",
                                "sense_id": "77141bdb-c932-3c53-a3f2-a33a1fb1d9b3",
                                "text": "Madeleines: These buttery French teacakes, something between a sponge cake and a butter cake in texture, are traditionally baked in scallop-shaped madeleine molds, but you can use miniature muffin pans or small tartlet pans in any shape."
                            },
                            {
                                "example_id": "bc818348-4ddc-43d7-974a-4c73222de847",
                                "sense_id": "77141bdb-c932-3c53-a3f2-a33a1fb1d9b3",
                                "text": "The tray of French d'auberge petit fours, small frosted and decorated teacakes cut in squares with eight alternating layers of chocolate cake and chocolate icing, waits on top of the icebox."
                            },
                            {
                                "example_id": "7edae81d-ca41-44a9-a3e8-758fb5f6e18e",
                                "sense_id": "77141bdb-c932-3c53-a3f2-a33a1fb1d9b3",
                                "text": "Fetching a plate of teacakes, Eleanor placed it in front of her.\n\"Thank you,\" Beatrice said, pinching a small, sticky sweet between her fingers."
                            },
                            {
                                "example_id": "77ad4e17-be09-44fc-b2d6-80888de95ece",
                                "sense_id": "77141bdb-c932-3c53-a3f2-a33a1fb1d9b3",
                                "text": "The glass case was filled with an assortment of treats, from flaky croissants to decadent chocolate cakes, macarons, baklava, teacakes and petit fours."
                            }
                        ]
                    },
                    {
                        "sense_id": "f50aa427-e696-3fed-b481-58cb8d45f22c",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A baked good such as a cake or biscuit intended to be eaten with tea or at an afternoon tea.",
                            "A sweet cake similar to pound cake, sometimes sprinkled with cinnamon and caster sugar, often served warm."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "8000bfea-cc2c-45a0-8895-d963e337c4fa",
                                "sense_id": "f50aa427-e696-3fed-b481-58cb8d45f22c",
                                "text": "Teacakes in Australia are actually pound cakes, sometimes sprinkled with sugar and cinnamon and so called just because they are eaten at teatime."
                            },
                            {
                                "example_id": "615ab36a-a892-4908-b05a-b3cb43e24144",
                                "sense_id": "f50aa427-e696-3fed-b481-58cb8d45f22c",
                                "text": "The teacake was delicious, just the right warmth to melt the butter, the inside soft enough to melt in the mouth, whilst the top was crisp with cooked brown sugar and cinnamon."
                            },
                            {
                                "example_id": "4ff3ce93-4616-441e-91f3-c82a301b80d2",
                                "sense_id": "f50aa427-e696-3fed-b481-58cb8d45f22c",
                                "text": "Immediately, as if by magic, Brother Jude arrived with a tray bearing English china, a hand of fresh bananas and a real, cinnamon-covered, teacake."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec902911-d0ed-3896-bf74-6269910d5f6e",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A cake flavoured with tea."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e73147b6-110b-371f-beaf-b64c595ce428",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A cake flavoured with tea.",
                            "A fruit cake similar to a barmbrack (but often without yeast) flavoured with tea and whiskey, especially associated with Halloween."
                        ],
                        "tags": [
                            "Ireland"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf8d282-e07d-42cc-ba9d-4d56b1b3164e",
                                "sense_id": "e73147b6-110b-371f-beaf-b64c595ce428",
                                "text": "Barm brack, a raisin-studded teacake of gargantuan proportions, is the speciality of many an Irish matron. In the right hands, it is a divine thing. Ma's hands were not the right hands"
                            },
                            {
                                "example_id": "7cd2eeeb-3a3a-4011-bfa4-25647c0cc064",
                                "sense_id": "e73147b6-110b-371f-beaf-b64c595ce428",
                                "text": "We sat around the table sipping tea as I sliced piece after piece of this fruity brack, chatting for nearly an hour, and when the water diviner left, he thanked me for a tea cake as \"fine as my mother's.\""
                            },
                            {
                                "example_id": "298b82cc-8db3-4ec4-a1eb-09b7c79f899d",
                                "sense_id": "e73147b6-110b-371f-beaf-b64c595ce428",
                                "text": "One Halloween tradition that can also be brought into your St Patrick Day festivities is the Barmbrack (bairín breac) cake. Made with cold tea, whiskey and dried fruit, this traditional Celtic teacake has an extra edge of fun."
                            }
                        ]
                    },
                    {
                        "sense_id": "c792fee2-f015-31af-8bcd-3be30ddfbdfc",
                        "entry_id": "e7af789e-6705-33ea-9680-0ec3644a1578",
                        "glosses": [
                            "A brick of dried tea."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6774f3e6-fee0-45e3-aceb-962dabe1536e",
                                "sense_id": "c792fee2-f015-31af-8bcd-3be30ddfbdfc",
                                "text": "For quotations using this term, see Citations:teacake."
                            }
                        ]
                    }
