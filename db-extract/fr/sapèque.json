                                        "entry_id": "8160e2d4-bfd3-32a4-8496-392405ca29e9",
                                        "glosses": [
                                            "對錢的戲稱"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ce5326e-07c6-4781-8e46-13bc032dbb96",
                                                "sense_id": "3ee7921e-5438-35f5-9c53-53d74b695c69",
                                                "text": "孔方兄，孔方兄，我瞧你光閃閃響噹噹的無價之寶，滿身通麻了。"
                                            },
                                            {
                                                "example_id": "e7e32aad-ab31-481b-a125-02cc532f0534",
                                                "sense_id": "3ee7921e-5438-35f5-9c53-53d74b695c69",
                                                "text": "孔方兄，孔方兄，我瞧你光闪闪响当当的无价之宝，满身通麻了。"
                                            },
                                            {
                                                "example_id": "29e40283-2c20-4094-a4fb-6fdf230e7298",
                                                "sense_id": "3ee7921e-5438-35f5-9c53-53d74b695c69",
                                                "text": "他不過向孔方兄告得個長頭假。"
                                            },
                                            {
                                                "example_id": "09163aa1-f172-4378-b773-fbfb8cd53b4f",
                                                "sense_id": "3ee7921e-5438-35f5-9c53-53d74b695c69",
                                                "text": "他不过向孔方兄告得个长头假。"
                                            }
                                        ]
                                    }
