                                        "sense_id": "343328dd-ee0a-3ee7-b93d-8338281deab3",
                                        "entry_id": "3bdd989f-b932-3122-9fe4-d61439978fe5",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe aider."
