{
    "word_family": [
        "perfidement",
        "perfidie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53f9c1c1-bf7a-32b6-89c6-22cd572f8f65",
                    "sense_definition": "Qui manque à sa foi, à sa parole ou à la confiance reçue ; déloyal et sournoisement malveillant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Méfie-toi de cet associé, car c'est un individu <w>perfide</w> prêt à tout pour réussir."
                        },
                        {
                            "text": "L'histoire dépeint ce courtisan comme un homme <w>perfide</w> qui trahissait tous ses alliés."
                        }
                    ],
                    "synonyms": [
                        "déloyal",
                        "traître",
                        "fourbe"
                    ],
                    "antonyms": [
                        "loyal",
                        "fidèle",
                        "dévoué"
                    ],
                    "common_phrases": [
                        "perfide Albion"
                    ]
                },
                {
                    "sense_id": "f4918f42-cd07-3872-9020-87bd8e19e78a",
                    "sense_definition": "Qui recèle un danger caché, une tromperie ou une intention malveillante sous des dehors anodins.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manifestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a esquissé un sourire <w>perfide</w> avant de révéler notre secret à tout le monde."
                        },
                        {
                            "text": "Cette question en apparence anodine cachait un piège <w>perfide</w> destiné à le faire trébucher."
                        }
                    ],
                    "synonyms": [
                        "insidieux",
                        "sournois",
                        "trompeur"
                    ],
                    "antonyms": [
                        "franc",
                        "sincère"
                    ],
                    "common_phrases": [
                        "sourire perfide",
                        "piège perfide"
                    ]
                },
                {
                    "sense_id": "2f1f3289-492f-32d0-821b-5a7e2d3d0214",
                    "sense_definition": "Qui n'a pas la vraie foi, incrédule ou rebelle à la doctrine religieuse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon le chroniqueur, ces nations <w>perfides</w> refusaient obstinément d'embrasser la vraie foi."
                        },
                        {
                            "text": "Le prédicateur condamnait sans relâche ces royaumes <w>perfides</w> égarés loin de l'Église."
                        }
                    ],
                    "synonyms": [
                        "incrédule",
                        "infidèle",
                        "hérétique"
                    ],
                    "antonyms": [
                        "croyant",
                        "orthodoxe"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage théologique ancien"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dd86cbf0-8c9b-3d3d-8924-ec128b4fdc08",
                    "sense_definition": "Personne déloyale qui trompe autrui ou trahit sa confiance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce <w>perfide</w> a livré les secrets de l'entreprise à tous nos concurrents."
                        },
                        {
                            "text": "Elle refusa d'adresser la parole au <w>perfide</w> qui lui avait brisé le cœur."
                        }
                    ],
                    "synonyms": [
                        "traître",
                        "fourbe"
                    ]
                }
            ]
        }
    ]
}