                "senses": [
                    {
                        "sense_id": "b0aa55e7-82f8-32e3-b266-7f6674db3d0a",
                        "entry_id": "31b092cc-3147-342c-8f49-0bee0d13ec60",
                        "glosses": [
                            "разг., груб. широко открыть (обычно о рте)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40cf97c0-cf25-483d-8b11-68b318a496f5",
                                "sense_id": "b0aa55e7-82f8-32e3-b266-7f6674db3d0a",
                                "text": "Дед Артём мусолит огрызок карандаша, пишет, криво раззявив рот."
                            },
                            {
                                "example_id": "422a206e-5799-46aa-a8e0-138e296d5018",
                                "sense_id": "b0aa55e7-82f8-32e3-b266-7f6674db3d0a",
                                "text": "Кое-как пообедали, кажный солдат прежде чем рот раззявить, в ложку себе смотрит: нет ли в кашке изюмцу тараканьего."
                            },
                            {
                                "example_id": "16e478b9-bfb7-43f5-8845-0a702cca9846",
                                "sense_id": "b0aa55e7-82f8-32e3-b266-7f6674db3d0a",
                                "text": "Девки высыпали на площадь перед почтой и, раззявя рты, любовались на сытые морды бойцов."
                            }
                        ]
                    }
                ],
