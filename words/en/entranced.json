{
    "word_family": [
        "entrance",
        "entrancement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4f3d923-c25b-358d-a89b-04b44453b3b0",
                    "sense_definition": "Held at attention, as if by magic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>entranced</w> audience watched the magician perform his final trick in complete silence.",
                            "target_lang_translations": {
                                "nl": "Het <w>betoverde</w> publiek keek in volledige stilte naar de laatste truc van de goochelaar."
                            }
                        },
                        {
                            "text": "She stood <w>entranced</w> by the beautiful sunset over the ocean.",
                            "target_lang_translations": {
                                "nl": "Ze stond daar, <w>geboeid</w> door de prachtige zonsondergang boven de oceaan."
                            }
                        }
                    ],
                    "synonyms": [
                        "fascinated",
                        "hypnotized",
                        "mesmerized",
                        "spellbound"
                    ],
                    "common_phrases": [
                        "completely entranced",
                        "stood entranced"
                    ],
                    "target_lang_definitions": {
                        "nl": "Volledig in beslag genomen door iets, alsof door magie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "betoverd",
                                "target_lang_sense_clarification": "geboeid door schoonheid of magie"
                            },
                            {
                                "target_lang_word": "gehypnotiseerd",
                                "target_lang_sense_clarification": "volledig gefocust op iets"
                            },
                            {
                                "target_lang_word": "geboeid",
                                "target_lang_sense_clarification": "aandachtig en geboeid kijkend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c5cd623-0860-3818-9ee7-cef408a48867",
                    "sense_definition": "Placed in a trance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient remained <w>entranced</w> throughout the entire duration of the hypnotherapy session.",
                            "target_lang_translations": {
                                "nl": "De patiënt bleef gedurende de hele hypnotherapiesessie <w>in trance</w>."
                            }
                        },
                        {
                            "text": "He appeared <w>entranced</w> as if he were in a deep sleep while standing upright.",
                            "target_lang_translations": {
                                "nl": "Hij leek <w>in trance</w>, alsof hij in een diepe slaap was terwijl hij rechtop stond."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "In een trance gebracht."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "in trance",
                                "target_lang_sense_clarification": "in een toestand van trance verkerend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39144542-dd89-32ca-959f-2445b1775c46",
