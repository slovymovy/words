                        "examples": [
                            {
                                "example_id": "2cff4c85-6fc9-4746-8754-3b0bd69b397f",
                                "sense_id": "6cbcbde3-6015-383f-abd3-cd98fff049e4",
                                "text": "Een van de terroristen die omkwamen op het vliegveld Zaventem is Ibrahim el-Bakraoui (29). Hij werd geïdentificeerd aan de hand van zijn vingerafdrukken. In januari 2010 schoot hij bij een overval op een effectenkantoor met een kalasjnikov op een politieagent. Daarvoor werd hij in oktober van dat jaar veroordeeld tot negen jaar cel, maar hij kwam vervroegd vrij."
                            },
                            {
                                "example_id": "51527536-c30a-457c-81c1-a3faca8a8f1b",
                                "sense_id": "6cbcbde3-6015-383f-abd3-cd98fff049e4",
                                "text": "De Bakraoui-broers hebben een crimineel verleden en lijken ook in verband te staan met de aanslagen in Parijs. In januari 2010 schoot Ibrahim el Bakraoui met een kalasjnikov op een politieagent, waarvoor hij in oktober van dat jaar werd veroordeeld. De broers waren toen betrokken bij een overval op een effectenkantoor."
                            }
                        ]
                    }
