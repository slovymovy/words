                        "sense_id": "9ff36132-e586-32c7-9421-6c27b9b3e36e",
                        "entry_id": "f04406ee-8589-38ec-8d23-e26c316f15eb",
                        "glosses": [
                            "The right to keep a person, or a person's goods or property, against his will. A type of custody."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35fcee1f-b754-4bd5-b3fe-74e13c1e1eef",
                                "sense_id": "9ff36132-e586-32c7-9421-6c27b9b3e36e",
                                "text": "On Monday, the federal Immigration and Customs Enforcement agency placed a similar detainer on Melvin Jovel, 18, who on Sunday was the sixth person to be arrested in the case."
                            },
                            {
                                "example_id": "57de08e4-1a5b-4429-af6c-7c555735fbdd",
                                "sense_id": "9ff36132-e586-32c7-9421-6c27b9b3e36e",
                                "text": "Through January, immigration authorities placed detainers on an additional 1,468 people — giving federal agents the right to hold suspects who are released from jail. […] Scott Weber, the field office director for the enforcement office in Newark, said that in roughly a third of the cases, his agency would file a detainer or immigration charges; another third involved individuals who could be deported after their court cases; and the rest might be United States citizens or legal residents."
                            },
                            {
                                "example_id": "1dbfd787-7079-47f9-ab1e-1cca4291099b",
                                "sense_id": "9ff36132-e586-32c7-9421-6c27b9b3e36e",
                                "text": "Officer Torres’s lawyer, Paul S. Missan, said on Saturday that he had been told by a prison official in Pennsylvania that a detainer was lodged against his client, meaning he was likely to face federal charges."
                            }
                        ]
                    }
