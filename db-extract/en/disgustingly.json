                                                "sense_id": "245284a6-7e2f-3363-8c25-079b91689851",
                                                "text": "Diese Schamlosigkeit ist ja ekelhaft."
                                            },
                                            {
                                                "example_id": "2df43805-b52a-4fed-ad34-a657eb70c0b7",
                                                "sense_id": "245284a6-7e2f-3363-8c25-079b91689851",
                                                "text": "„Der Ökonom Colin Camerer sagte dem ‚New York Magazine‘, dass Handlungen, die in guten Zeiten glamourös sind, in schlechten ekelhaft werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
