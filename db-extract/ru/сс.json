                                        "sense_id": "23a3101e-a49b-382d-8b91-f61a5892be2d",
                                        "entry_id": "6ea92e0a-8bd0-3128-9b63-c9d7c80939b6",
                                        "glosses": [
                                            "Strong Safety"
                                        ],
                                        "tags": [
