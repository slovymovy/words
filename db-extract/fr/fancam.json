                "senses": [
                    {
                        "sense_id": "360eacf7-bf1d-3813-9d69-711feec69351",
                        "entry_id": "5461bdcc-93ad-35be-b501-eb36efab348d",
                        "glosses": [
                            "Vidéo d’une célébrité filmée par un·e fan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "994b5f50-6c11-401a-ba50-2a62180d6763",
                                "sense_id": "360eacf7-bf1d-3813-9d69-711feec69351",
                                "text": "La fancam de Jimin publiée par la chaîne Youtube ‘M2’ le 31 mars est devenue à présent la fancam la plus regardée d’une idole de K-pop de tous les temps avec plus de 29 millions de vues et 280,000 mentions j’aime."
                            },
                            {
                                "example_id": "5c698a9f-a046-49ef-80a8-5a30d5a1c836",
                                "sense_id": "360eacf7-bf1d-3813-9d69-711feec69351",
                                "text": "Les amateurs de K-pop ont donc commencé à poster des fancams, des vidéos prises par des fans d’artistes en train de se produire sur scène, dans l’application destinée à dénoncer les manifestants."
                            },
                            {
                                "example_id": "94993b28-ab8e-4571-a58f-863da091338e",
                                "sense_id": "360eacf7-bf1d-3813-9d69-711feec69351",
                                "text": "Les internautes s'amusent à transformer les débats télévisés en générique d'animes: les «fancams», ces courtes vidéos mettant en avant le charisme d'un personnage, ne sont plus dédiés aux stars, mais aux hommes et femmes politiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e1b7649-4638-4142-b680-190d43d9b4a5",
                        "source_entry_id": "5461bdcc-93ad-35be-b501-eb36efab348d",
                        "source_sense_id": "360eacf7-bf1d-3813-9d69-711feec69351",
                        "target_lang_word": "fancam",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fancam",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d81997d1-6659-3371-baa4-09a8fae501a7",
                                        "entry_id": "d390ebc9-b208-323b-992d-2070b42162c7",
                                        "glosses": [
                                            "Amateur film footage of a celebrity taken unofficially by a fan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "488f5f16-4ef9-4d51-8bbb-d2dfe8b617f7",
                                                "sense_id": "d81997d1-6659-3371-baa4-09a8fae501a7",
                                                "text": "A smorgasbord of extras enable the Beastie fiend to view the concert from other, remote-controlled cameras and jump in and out of different fancams, even accompanying one concertgoer on a trip to the bog."
                                            },
                                            {
                                                "example_id": "75b90573-b1eb-4f7d-90a6-f013f7cfefdc",
                                                "sense_id": "d81997d1-6659-3371-baa4-09a8fae501a7",
                                                "text": "EXID's Hani has made a splash with her fancam in 2014 and is now regarded as one of the hottest female idol stars."
                                            },
                                            {
                                                "example_id": "8c596987-9e31-49c8-b42e-7d593267508b",
                                                "sense_id": "d81997d1-6659-3371-baa4-09a8fae501a7",
                                                "text": "He didn't seem tired when he was onstage, but Jin-woo had seen a number of backstage videos and some candid shots, not to mention fancams following Ki-tae everywhere, where Ki-tae just looked exhausted. Did Vampires get exhausted?"
                                            },
                                            {
                                                "example_id": "ea8a0bab-5d3b-4f41-aa40-752e953dfe34",
                                                "sense_id": "d81997d1-6659-3371-baa4-09a8fae501a7",
                                                "text": "In addition to the live coverage on TV, YouTube, and various news and entertainment websites, countless short clips edited for maximum virality have circulated on Instagram and TikTok — “fancams,” in social media parlance, featuring forensic analyses of Mr. Depp’s and Ms. Heard’s trial attire, and courtroom exchanges that have been described as “SAVAGE.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8574c276-a258-3d42-9465-d4f104c97ff0",
                                        "entry_id": "d390ebc9-b208-323b-992d-2070b42162c7",
                                        "glosses": [
                                            "An edit which incorporates fancams into it."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
