                "senses": [
                    {
                        "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                        "entry_id": "6bf0d98c-b17c-34a5-b892-374884a6da58",
                        "glosses": [
                            "Programmiersprache, die auf numerische Berechnungen hin optimiert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42fa63a-092c-4ba8-a6c6-e44fb612ea6d",
                                "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                                "text": "Fortran zählt zu den ältesten höheren Programmiersprachen."
                            },
                            {
                                "example_id": "c32bcf01-a4b1-4e0c-9cf6-e11bf82e0a6a",
                                "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                                "text": "Bis zur Version FORTRAN 77 wurde Fortran mit Großbuchstaben geschrieben."
                            },
                            {
                                "example_id": "9c646535-cd45-44f5-9563-dc03b14e635f",
                                "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                                "text": "\"Fortran ist eine prozedurale und in ihrer neuesten Version zusätzlich eine objektorientierte Programmiersprache …\""
                            },
                            {
                                "example_id": "fa76cc0c-3a9a-4a6d-b66f-9c035e55c2e7",
                                "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                                "text": "„Fortress soll sich als moderner Ersatz von Fortran etablieren und im Bereich High-Performance-Computing AnwenderInnen [sic] finden.“"
                            },
                            {
                                "example_id": "bf9b8d97-233d-49d4-8987-0b9bb1494b73",
                                "sense_id": "ba03309b-318e-3b92-b80f-26197b396152",
                                "text": "„Acht Jahre nach Fortran 2008 haben die Spezifikationsautoren eine neue Ausgabe der ersten realisierten höheren Programmiersprache freigegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
