                    {
                        "translation_id": "5963256c-278d-497b-97e7-acdcdf7320ba",
                        "source_entry_id": "bd33edbd-9855-39bf-9fe8-d575ecef9d68",
                        "source_sense_id": "36566d1f-a6a2-379c-bae9-baa8fb85a331",
