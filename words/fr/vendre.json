            "senses": [
                {
                    "sense_id": "0d5f9191-3260-392c-8c1b-5adafc878fbf",
                    "sense_definition": "Céder la propriété d'un bien ou d'une marchandise à quelqu'un contre une somme d'argent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il veut <w>vendre</w> sa vieille voiture pour acheter un modèle plus récent."
                        },
                        {
                            "text": "Cette boulangerie du centre-ville <w>vend</w> du pain frais tous les matins."
                        }
                    ],
                    "synonyms": [
                        "céder",
                        "écouler"
                    ],
                    "antonyms": [
                        "acheter",
                        "acquérir"
                    ],
                    "common_phrases": [
                        "vendre à perte",
                        "vendre aux enchères",
                        "vendre au détail"
                    ]
                },
                {
                    "sense_id": "28fd1470-9807-3301-ac67-576ee5358bd3",
                    "sense_definition": "Être acheté par le public, trouver des acquéreurs en parlant d'un produit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son nouveau roman se <w>vend</w> très bien dans toutes les librairies."
                        },
                        {
                            "text": "Cet album s'est <w>vendu</w> à des millions d'exemplaires dans le monde entier."
                        }
                    ],
                    "synonyms": [
                        "partir",
                        "s'écouler"
                    ],
                    "common_phrases": [
                        "se vendre comme des petits pains",
                        "bien se vendre"
                    ]
                },
                {
                    "sense_id": "c80b9683-c13b-3f83-a7a0-de75b29e88d6",
                    "sense_definition": "Trahir quelqu'un ou livrer un secret par intérêt, déloyauté ou lâcheté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trahison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le complice a fini par <w>vendre</w> ses associés à la police."
                        },
                        {
                            "text": "Ils pensaient pouvoir lui faire confiance, mais il les a <w>vendus</w> sans hésiter."
                        }
                    ],
                    "synonyms": [
