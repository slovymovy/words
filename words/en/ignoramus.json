    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c9209963-ff66-39d9-adb9-c7df68bea091",
                    "sense_definition": "A person who is completely uneducated, uninformed, or lacks basic knowledge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ignorant_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor refused to debate the <w>ignoramus</w> who clearly had not read the assigned textbook."
                        },
                        {
                            "text": "Do not act like a total <w>ignoramus</w> when you are speaking to the board of directors."
                        }
                    ],
                    "synonyms": [
                        "dunce",
                        "numskull"
                    ],
                    "antonyms": [
                        "genius",
                        "scholar"
                    ],
                    "common_phrases": [
                        "total ignoramus"
                    ]
                },
                {
                    "sense_id": "98de2371-21a0-3c82-a4a2-bd90a60b3a6e",
                    "sense_definition": "A legal decision by a grand jury that there is not enough evidence to proceed with a trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_ruling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The grand jury returned an <w>ignoramus</w> because the prosecution failed to provide sufficient evidence."
                        },
                        {
                            "text": "After reviewing the case, the jury issued an <w>ignoramus</w> and dismissed the charges."
                        }
                    ],
                    "common_phrases": [
                        "return an ignoramus"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ef5cb51-1cdd-32a3-b46e-af3577b0dc27",
                    "sense_definition": "To officially decide that there is insufficient evidence to send a case to trial.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_ruling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury decided to <w>ignoramus</w> the indictment due to a lack of credible witnesses."
                        },
                        {
                            "text": "They chose to <w>ignoramus</w> the case after the evidence was deemed unreliable."
                        }
                    ]
                }
            ]
        }
    ]
