                                "target_senses": [
                                    {
                                        "sense_id": "7769d11c-430f-3f4a-a620-f0d8fbbe9e23",
                                        "entry_id": "5ce7db3c-4873-345f-8174-d41a66d8d96f",
                                        "glosses": [
                                            "Enseignant au collège ou au lycée chargé du suivi et de l’orientation des élèves d’une classe, en supplément à l’enseignement de sa matière."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1a2f3a5-292b-4b17-a5b1-b3a9be7ce75c",
                                                "sense_id": "7769d11c-430f-3f4a-a620-f0d8fbbe9e23",
                                                "text": "Cette suppression, à peu près générale, du professeur principal, chargé de suivre, au moins pendant un an et dans la plus grande partie de leurs exercices, les mêmes élèves, voilà certainement ce qui était le mieux fait pour tuer un système d’études, si pavé de bonnes intentions qu’il pût se prétendre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
