                "senses": [
                    {
                        "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                        "entry_id": "472488b4-910f-32e8-a2ac-a7f5cdf0e414",
                        "glosses": [
                            "Person, die mit einem Hängegleiter fliegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64561efb-53ad-4aad-8b2a-d32250faff45",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Der Drachenflieger klinkt sich im Schwerpunkt seines Delta ein, um sein Fluggerät in einer schwebenden Liegendposition durch Gleichgewichtsveränderungen zu den Seiten, nach vorn oder nach hinten über ein Trapez steuern zu können.“"
                            },
                            {
                                "example_id": "552e0744-ad2a-4afd-ac22-df8a51bba916",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Während man jedoch beim Segelfliegen in einem kleinen Cockpit hockt, beim Gleitschirmfliegen in einem Sitz schaukelt, hängt der Drachenflieger unter der Tragfläche, Kopf voraus.“"
                            },
                            {
                                "example_id": "e66195f1-6bd7-49b1-a37e-fccaa3335295",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Der Hochfelln in Bergen ist sowohl bei Drachenfliegern als auch Paraglidern sehr beliebt.“"
                            },
                            {
                                "example_id": "7435a9ba-c417-46fe-8114-52449cdd3981",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Nach einem Zusammenstoß mit einem Paragleiter ist am Samstagnachmittag auf der Hohen Wand (Bezirk Wiener Neustadt) ein 61-jähriger Drachenflieger abgestürzt.“"
                            },
                            {
                                "example_id": "9ceee7ad-615e-4e83-8da4-585fb5cd1b89",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Ein Drachenflieger ist am Samstag auf einem Flugplatz in Niedergörsdorf (Teltow-Fläming) beim Startvorgang verunglückt.“"
                            },
                            {
                                "example_id": "216987bd-4b4b-4a98-ab8e-0161edc41a91",
                                "sense_id": "cdf14b8d-fa28-3f61-9915-b7170e560717",
                                "text": "„Als Drachenflieger kommt man mit dem Luftfahrtbundesamt bei einem Unfall in Berührung, weil das Luftfahrtbundesamt für die Flugunfalluntersuchungen zuständig ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
