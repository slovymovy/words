                    }
                ],
                "senses": [
                    {
                        "sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                        "entry_id": "ddea1e75-2b2d-3a1b-ac91-c0dafb744d25",
                        "glosses": [
                            "Kampfmaßnahme, die darin besteht, dass eine Person die Nahrungsaufnahme verweigert, bis eine von ihr benannte Bedingung erfüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6e18b2-c723-43bb-86e4-847245b7e35c",
                                "sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                                "text": "„Sie erklärten der Welt von Paris aus, daß es keinen Hungerstreik gäbe.“"
                            },
                            {
                                "example_id": "474e78a8-c7b4-41c0-8ee4-eb8c870a33f6",
                                "sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                                "text": "„Ich trete in den Hungerstreik, mir bleibt kein anderes Mittel, mich zu wehren.“"
                            },
                            {
                                "example_id": "d3c188e3-5f4d-4e71-b3e6-08f60485a24e",
                                "sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                                "text": "„Da mir der Appetit längst vergangen war, hatte ich beschlossen, in den Hungerstreik zu treten.“"
                            },
                            {
                                "example_id": "b82302b6-83a0-477e-8548-47d49b55b75a",
                                "sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                                "text": "„Oskar Maria Graf reagierte mit Aufsässigkeit gegen den Militärdienst, kam immer wieder in Arrest, bis er in der Isolation in Hungerstreik trat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7fdb14d-7fd2-497b-9669-29332e2aa6e3",
                        "source_entry_id": "ddea1e75-2b2d-3a1b-ac91-c0dafb744d25",
                        "source_sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                        "target_lang_word": "hunger strike",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunger strike",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d432d7-147c-3149-841d-e36ea0c55d37",
                                        "entry_id": "2a64f8e9-877e-35ca-9f8b-64da9dceff48",
                                        "glosses": [
                                            "A fast undertaken as a means of protest, often by a prisoner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ff66314-e66f-49a7-b735-d1c2c7767d60",
                                                "sense_id": "c2d432d7-147c-3149-841d-e36ea0c55d37",
                                                "text": "Alekhina has become a vocal advocate for prisoners’ rights, a sort of jailhouse lawyer who has exposed numerous violations, filed copious complaints, and, in May, held an 11-day hunger strike that succeeded in changing conditions in her penal colony."
                                            },
                                            {
                                                "example_id": "6e38fcba-ea43-47af-9f6d-4a4bed343c00",
                                                "sense_id": "c2d432d7-147c-3149-841d-e36ea0c55d37",
                                                "text": "A hunger strike at a South Florida immigration detention center state officials have named “Alligator Alcatraz” has entered its tenth day, as detainees protest what they call inhumane and dangerous living conditions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d88cd84-a5bf-427b-908d-e1b43183dd78",
                        "source_entry_id": "ddea1e75-2b2d-3a1b-ac91-c0dafb744d25",
                        "source_sense_id": "7647f6f7-18fc-352a-b2a0-504a6d5f476b",
                        "target_lang_word": "grève de la faim",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grève de la faim",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58a159ea-c3c6-3667-bee8-cf2e6721781e",
                                        "entry_id": "e565a234-12d8-3f79-9018-5da225e0c6c4",
                                        "glosses": [
                                            "Cessation volontaire de la prise d’aliments, moyen de protestation non violent visant à faire entendre ses revendications par une personne, une personne morale, une entité politique, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94739268-b35b-4557-b88c-4e98e0966bad",
                                                "sense_id": "58a159ea-c3c6-3667-bee8-cf2e6721781e",
                                                "text": "14 mai. - On apprend que le haut clergé bouddhique a commencé une grève de la faim pour protester contre la discrimination dont il s'estime victime."
                                            },
                                            {
                                                "example_id": "7ff53ce3-45a8-45b9-991d-db780bdc319d",
                                                "sense_id": "58a159ea-c3c6-3667-bee8-cf2e6721781e",
                                                "text": "Transférée dans un hôpital-prison en Sibérie après plusieurs grèves de la faim, Nadia aussi était prête à aller au bout de sa peine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cd333f5-9fe7-4611-ae3d-763d1e0af0e8",
                        "source_entry_id": "ddea1e75-2b2d-3a1b-ac91-c0dafb744d25",
