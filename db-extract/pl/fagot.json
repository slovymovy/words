                    {
                        "sense_id": "9610667d-0200-31fc-92eb-c88a0c0f7329",
                        "entry_id": "e871ca8d-2df2-3a0f-a614-50572f8eecfa",
                        "glosses": [
                            "stroikowy, drewniany instrument dęty o niskiej skali"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d1c17c-03b3-47dc-82c4-f36f3eb7f6f5",
                                "sense_id": "9610667d-0200-31fc-92eb-c88a0c0f7329",
                                "text": "Jan od pięciu lat gra na fagocie a sąsiadom na nerwach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f511c5a-314b-47ac-858b-13297fe21a9f",
                        "source_entry_id": "e871ca8d-2df2-3a0f-a614-50572f8eecfa",
                        "source_sense_id": "9610667d-0200-31fc-92eb-c88a0c0f7329",
                        "target_lang_word": "bassoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bassoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "738cc6b7-74a3-308d-8920-f881240d710f",
                                        "entry_id": "5ee3c8b1-28ab-3d39-a9c4-a893a0eafc4a",
                                        "glosses": [
                                            "A musical instrument in the woodwind family, having a double reed and playing in the tenor and bass ranges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3537f43b-d574-469f-bd21-611cf6fd11aa",
                                                "sense_id": "738cc6b7-74a3-308d-8920-f881240d710f",
                                                "text": "Higher and higher every day, / Till over the mast at noon— / The Wedding-Guest here beat his breast, / For he heard the loud bassoon."
                                            },
                                            {
                                                "example_id": "94febe46-28d1-4498-8c2a-ab653bb5d39a",
                                                "sense_id": "738cc6b7-74a3-308d-8920-f881240d710f",
                                                "text": "The most convenient and natural order is, perhaps, the following: the upper staff may have the flute-part, because it has the highest notes, and, therefore, requires most room above the staff; then follow the parts for the hautboys, clarinets, horns, bassoons, tromboni, trumpets, and drums; the upper half of the page thus containing the wind-instruments: the lower half belongs to the violins, viola, voices, violoncello, and double base."
                                            },
                                            {
                                                "example_id": "66ddf9f7-1799-4038-9817-c73aa35f0a55",
                                                "sense_id": "738cc6b7-74a3-308d-8920-f881240d710f",
                                                "text": "After another alternation of the two elements, there is a more playful episode, in which flute and bassoon take up the first element, with swooping glissando on the ondes Martenot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bassoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17d7499d-9183-3bbc-a51f-56c846bb6ade",
                                        "entry_id": "54dd23a7-e501-3f37-86d4-ac8aed0e22d9",
                                        "glosses": [
                                            "To play the bassoon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
