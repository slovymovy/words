                "senses": [
                    {
                        "sense_id": "31dddb60-8304-3367-9d8f-d5412d7ed44c",
                        "entry_id": "d97a6997-8c66-3f25-921f-bfb46fe97929",
                        "glosses": [
                            "Déesse de l’égarement funeste et des actes irréfléchis, pour les Grecs anciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b1554f-fa77-4841-85a6-9d79157585c8",
                                "sense_id": "31dddb60-8304-3367-9d8f-d5412d7ed44c",
                                "text": "D’ailleurs, les lumières acquises par Esther sur les moyens secrètement honteux auxquels le baron devait sa fortune colossale lui ôtèrent tout scrupule, elle se plut à jouer le rôle de la déesse Até, la vengeance, selon le mot de Carlos."
                            }
                        ]
                    },
                    {
                        "sense_id": "32230208-c8fd-31e4-be45-3498de21599a",
                        "entry_id": "d97a6997-8c66-3f25-921f-bfb46fe97929",
                        "glosses": [
                            "Folie passagère causée par l’action d’un dieu ou d’un démon ^([1]), dans la mythologie grecque."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "e73b874e-9c8f-48e6-bba6-0d1ff9c4de58",
                                "sense_id": "32230208-c8fd-31e4-be45-3498de21599a",
                                "text": "Elle a obéi à la perversion de son cœur, à l’Até funeste qui, l’entraînant vers l’adultère, l’a précipitée dans le meurtre."
                            }
                        ]
                    }
                ],
