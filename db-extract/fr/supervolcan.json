                                    {
                                        "sense_id": "84aa7a51-d12c-3f53-93ef-b20f9483fe01",
                                        "entry_id": "57498af7-1dba-3aeb-94e9-a80467f264be",
                                        "glosses": [
                                            "A powerful volcano, often having an explosive or cataclysmic eruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecff7df-75b3-4de2-94ce-c5270c5036e8",
                                                "sense_id": "84aa7a51-d12c-3f53-93ef-b20f9483fe01",
                                                "text": "Mosaic of Olympus Mons on Mars. The supervolcano is nearly 600 kilometers wide at the base and 25 kilometers high and is capped by a crater 65 kilometers in diameter. It is about five times larger than the most massive volcanic cone on earth, Mauna Loa in Hawaii."
                                            },
                                            {
                                                "example_id": "bb984c99-f85a-416d-a5d9-2fb17c00c153",
                                                "sense_id": "84aa7a51-d12c-3f53-93ef-b20f9483fe01",
                                                "text": "The stone went dark, and instantly the supervolcano burst with an unthinkable blast. A miles-deep plug of dark and hot earth flew upward, followed by a tremendous expanding cloud. Swirling, dense substance spread and thickened [...]"
                                            },
                                            {
                                                "example_id": "653f3b3f-253e-4048-a20b-efb424064173",
                                                "sense_id": "84aa7a51-d12c-3f53-93ef-b20f9483fe01",
                                                "text": "Sytau is rabidly volcanic; a dozen \"supervolcanoes\" 50-120 kilometers wide are erupting across the planet. Sytau's carbon content and constant volcanism make natural diamonds plentiful, if extremely costly and dangerous to recover."
                                            }
                                        ]
