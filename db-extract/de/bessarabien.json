                                        "sense_id": "17e31b71-53a6-30e6-9578-ada3aa821ca6",
                                        "entry_id": "0729db0a-f8c8-366a-96aa-38b25b572a40",
                                        "glosses": [
                                            "A geographic region of Eastern Europe bounded by the Dniester River on the east and the Prut River on the west; now divided politically between Moldova and Ukraine."
                                        ],
