                        "glosses": [
                            "One who is loved; a recipient of love."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dce8be8-a9bb-4e01-aa8a-ab2c77ec0543",
                                "sense_id": "eeeb36ad-17c4-3dea-a8b6-4c6143c7b7a1",
                                "text": "What is a lovee without a confidant?"
                            },
                            {
                                "example_id": "6425b4a1-ecee-4bd3-b010-a88934363f96",
                                "sense_id": "eeeb36ad-17c4-3dea-a8b6-4c6143c7b7a1",
                                "text": "One might even describe a monitored feedback loop that permits one to sense when insufficient loving is returning from the lovee, causing a lessening of the lover's efforts."
                            },
                            {
                                "example_id": "bd734cdf-7867-49c9-81c6-59eec179d1c2",
                                "sense_id": "eeeb36ad-17c4-3dea-a8b6-4c6143c7b7a1",
                                "text": "It's just that one is the lover, while the other is the lovee. Together, they make love. One has an obligation to nurture, and the other has a duty of care."
                            }
                        ]
                    }
