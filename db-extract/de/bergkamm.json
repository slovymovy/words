                "senses": [
                    {
                        "sense_id": "71ed6594-ee00-3118-9f00-204e31ecc352",
                        "entry_id": "aef0ba6c-bac1-3809-8210-e85d3aebd701",
                        "glosses": [
                            "Linie des höchsten, schmalen Verlaufs eines Bergzugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd09b6fa-898b-4d81-b7b9-627348dd6dad",
                                "sense_id": "71ed6594-ee00-3118-9f00-204e31ecc352",
                                "text": "„Mittags kamen wir auf einem Bergkamm an, und es war heiß, aber Onkel Edgar wollte nicht Rast machen.“"
                            },
                            {
                                "example_id": "370827b8-02c8-426f-b523-29db452a30da",
                                "sense_id": "71ed6594-ee00-3118-9f00-204e31ecc352",
                                "text": "„Irgendwann dämmerte es und wir hüpften bibbernd vor dem Zelt auf und ab, als über einen Bergkamm ein Sonnenstrahl fiel.“"
                            },
                            {
                                "example_id": "c43114f0-61d9-49f7-adc3-1c217555f382",
                                "sense_id": "71ed6594-ee00-3118-9f00-204e31ecc352",
                                "text": "„Aber ich hielt den Mund, stand bloß da und sah den Bus auf dem Bergkamm auftauchen wie einen Satz, mit dem die Hochheide den Fjord grüßte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0b05953-83aa-4f65-8053-457a96888868",
                        "source_entry_id": "aef0ba6c-bac1-3809-8210-e85d3aebd701",
                        "source_sense_id": "71ed6594-ee00-3118-9f00-204e31ecc352",
