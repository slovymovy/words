                                "target_senses": [
                                    {
                                        "sense_id": "f9aa6f4f-bb66-3e83-95c7-796b32812710",
                                        "entry_id": "309ee55b-5764-30e2-b039-f241ba7453c2",
                                        "glosses": [
                                            "het niet goed afgesteld staan en naar een bepaalde kant neigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff62282-cdd8-46cc-ba73-5e991c5100ab",
                                                "sense_id": "f9aa6f4f-bb66-3e83-95c7-796b32812710",
                                                "text": "Het stuur had een afwijking naar links."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                        "entry_id": "309ee55b-5764-30e2-b039-f241ba7453c2",
                                        "glosses": [
                                            "lichamelijk of geestelijk gebrek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f19d796-426b-4843-bcf4-baa6af2ffc1b",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Een aangeboren afwijking aan de aortaklep."
                                            },
                                            {
                                                "example_id": "757162af-49af-4942-83af-65347a648007",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Het buurmeisje had een afwijking, maar was ook erg aardig."
                                            },
                                            {
                                                "example_id": "2735049c-67e1-4099-a536-ab62e5cf1732",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "De moderne wereld behoorde uitdrukkelijk toe aan de extraverte mens, terwijl de introvert gestemden thuis aan hun lot werden overgelaten en het gevoel kregen opgedrongen dat datgene waar ze zich het prettigst bij voelden - alleen-zijn - een afwijking was."
                                            },
                                            {
                                                "example_id": "bbd927f9-7903-4d46-8ea9-b5517dea60d0",
                                                "sense_id": "3aba13ea-62c1-3d50-aaca-f11b50982028",
                                                "text": "Een afwijking die ik heb overgehouden aan mijn eerste twee maanden in Hohenschônhausen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
