                    {
                        "translation_id": "ad76f099-14b9-4472-9e3c-fae69c3122cc",
                        "source_entry_id": "4e85c909-9870-31b7-a283-7e904d8ac672",
                        "source_sense_description": "насаждать (насадить), распространять (распространить) латинский язык, латинскую культуру",
                        "target_lang_word": "latiniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "latiniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5317c449-7fca-3f4c-a9c5-c6253585439f",
                                        "entry_id": "2c87bbb1-5c3f-3e45-a7f9-36796e43295e",
                                        "glosses": [
                                            "Romaniser, dans la langue et dans les mœurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05e7ea8-93fb-4ec3-96a5-405068af2fcf",
                                                "sense_id": "5317c449-7fca-3f4c-a9c5-c6253585439f",
                                                "text": "Depuis sa conquête par César et jusqu'à la fin du Vᵉ siècle, la Gaule n'a été qu'une terre romaine, entièrement latinisée et son histoire se confond avec celle de Rome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee66ebc6-9c58-35a6-accf-5cb467ec8584",
                                        "entry_id": "2c87bbb1-5c3f-3e45-a7f9-36796e43295e",
                                        "glosses": [
                                            "Donner une terminaison ou une forme latine à un mot d’une autre langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13f04363-9e5d-44ca-97a3-910ccdcce9be",
                                                "sense_id": "ee66ebc6-9c58-35a6-accf-5cb467ec8584",
                                                "text": "Les Romains, qui ne connoissoient ni l'un ni l'autre de ces bœufs sauvages avant de les avoir vus en Germanie, ont adopté ces noms: de vrochs ils ont fait vrus, et de visen, bison; et ils n'ont pas imaginé que le bœuf sauvage, décrit par Aristote sous le nom de bonasus, pouvoit être l'un ou l'autre de ces bœufs dont ils venoient de latiniser et de gréciser les noms germains."
                                            },
                                            {
                                                "example_id": "baa703e9-86ae-495c-976c-18dcbe7c7046",
                                                "sense_id": "ee66ebc6-9c58-35a6-accf-5cb467ec8584",
                                                "text": "Dans Pantagruel, François Rabelais se moque joyeusement du jargon prétentieux des écumeurs de latin. Ces derniers étaient des étudiants de la Sorbonne ayant pris l’habitude de latiniser leur propre langue à un tel point qu’ils en devenaient inintelligibles pour le reste de la population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c31b492-2901-39d1-97e3-8754884a1824",
                                        "entry_id": "2c87bbb1-5c3f-3e45-a7f9-36796e43295e",
                                        "glosses": [
                                            "Faire adopter les rites de l’Église latine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fd513a-1538-4a48-9395-7f7db669a7f6",
                                                "sense_id": "1c31b492-2901-39d1-97e3-8754884a1824",
                                                "text": "La société grecque et l'Église doivent se tenir sur le qui-vive parce que le Vatican n’a pas abandonné ses objectifs permanents de latiniser les Grecs."
                                            }
                                        ]
                                    }
                                ]
                            }
