                ],
                "senses": [
                    {
                        "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                        "entry_id": "a926beb9-7db2-3e0c-ac99-b997db55e028",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa2ea641-01b5-40a3-882b-7976c8a7f22a",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Frau Assenheimer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6683fb66-bcc4-48fd-9e3f-ed9468d9f782",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Herr Assenheimer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c82103b0-ca3d-4959-bc74-e7733d49ed7e",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Die Assenheimers kommen heute aus dem Schwarzwald."
                            },
                            {
                                "example_id": "500ada33-8e26-41ce-948c-2875c5ea87e4",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Der Assenheimer trägt nie die Schals, die die Assenheimer ihm strickt."
                            },
                            {
                                "example_id": "447ba3ec-c64a-4363-9679-863f605d80ae",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Assenheimer kommt, geht der Herr Assenheimer.“"
                            },
                            {
                                "example_id": "a6054f18-a588-4491-a666-803c802c73f7",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Assenheimer kommt und geht."
                            },
                            {
                                "example_id": "7e6c3210-6e13-48ac-be5d-5581e9661d5c",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "Assenheimers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "2fb00b21-0cf1-4f32-a295-b82b41d81637",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "An verregneten Herbsttagen ist Familie Assenheimers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "bae27227-cb42-4d2d-b616-b9acc7733976",
                                "sense_id": "2ac1e784-a6af-30c1-8b6c-f7f6389312be",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Assenheimer das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
