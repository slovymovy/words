                "senses": [
                    {
                        "sense_id": "eea3597a-cf8a-3dd1-8c5b-8fa69e080dfa",
                        "entry_id": "f87bc11a-3db9-3f19-84dd-74e235a6479a",
                        "glosses": [
                            "op grote schaal, in groten getale"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f82d785-bc6c-4b6a-a3d9-0423defd5e49",
                                "sense_id": "eea3597a-cf8a-3dd1-8c5b-8fa69e080dfa",
                                "text": "Door het politieoptreden is de Occupy-beweging alleen maar massaler geworden."
                            },
                            {
                                "example_id": "71d6ccac-3573-41dc-b77b-7d2eb2da3ed5",
                                "sense_id": "eea3597a-cf8a-3dd1-8c5b-8fa69e080dfa",
                                "text": "Toen Russische tanks ruim drie jaar geleden de Oekraïense grens overstaken, waren er vooropgezette plannen om massaal Oekraïense kinderen te ontvoeren en mee te nemen naar Rusland. Dat blijkt uit documenten van het Kremlin in handen van Oekraïense mensenrechtenorganisaties."
                            }
                        ]
                    }
