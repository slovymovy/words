                            {
                                "target_lang_word": "темный",
                                "target_lang_sense_clarification": "о тяжелых временах или мыслях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e8b66a2-2119-3912-867f-459f24e0520d",
                    "sense_definition": "de toestand waarin er geen licht aanwezig is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lichtsterkte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen durven niet alleen in het <w>donker</w> te slapen.",
