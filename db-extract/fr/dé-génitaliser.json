                ],
                "senses": [
                    {
                        "sense_id": "aba31932-1bec-3f3f-8b67-e253970c6dfc",
                        "entry_id": "9293aa35-46f5-35b8-8878-fb9625adfb11",
                        "glosses": [
                            "Enlever son caractère génital, ou purement génital, à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5c28d87-4f00-458f-b4e2-b109f54f9eee",
                                "sense_id": "aba31932-1bec-3f3f-8b67-e253970c6dfc",
                                "text": "S’il passe par le lieu anatomique du sexe qu’il dé-sexualise et dé-génitalise, son projet reste l’extermination à l’image de ce temps fou de l’holocauste qui, côté bourreau devait durer 1000 ans, côté victime dure l’éternité – transgénérationnelle – d’un matricule à l’avant-bras."
                            },
                            {
                                "example_id": "0c812c0a-08d5-48d5-8550-4b34b23c720c",
                                "sense_id": "aba31932-1bec-3f3f-8b67-e253970c6dfc",
                                "text": "Chacune peut devenir experte de son corps, libérer son bassin des tensions qui bloquent l’énergie sexuelle, dé-génitaliser la sexualité pour explorer la capacité du corps entier à éprouver du plaisir."
                            },
                            {
                                "example_id": "2c3e4b14-b27d-4a80-b6fb-0988da22ac22",
                                "sense_id": "aba31932-1bec-3f3f-8b67-e253970c6dfc",
                                "text": "Comme tout grand musicien, Jimi s’emploie à dé-génitaliser des pulsions."
                            },
                            {
                                "example_id": "dfad7de8-8dc0-4ea4-9b6c-7bbaccc6dcf7",
                                "sense_id": "aba31932-1bec-3f3f-8b67-e253970c6dfc",
                                "text": "Pour remédier à cela, il faut développer votre capacité à “dé-génitaliser” l’excitation sexuelle par une conscience corporelle globale."
                            }
                        ]
                    }
                ],
