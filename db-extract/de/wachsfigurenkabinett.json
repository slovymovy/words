                        "source_sense_id": "083f9e41-4820-3604-a115-e5aef7a49a28",
                        "source_sense_description": "Ausstellung von Wachsfiguren",
                        "target_lang_word": "musée de cire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "musée de cire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fd54ad8-7862-31cf-bf0d-4e87726632f9",
                                        "entry_id": "3a6614e6-33d1-3aef-9aa5-afbd925fd2c8",
                                        "glosses": [
                                            "Un musée de cire est un musée qui expose des statues en cire représentant des personnes célèbres, qu’elles soient contemporaines, historiques, ou imaginaires, éventuellement dans des reconstitutions de scènes mémorables dont elles ont été les protagonistes. — (Wikipédia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d0c61c3-7ea3-4134-ab88-1d5344c61770",
                                                "sense_id": "1fd54ad8-7862-31cf-bf0d-4e87726632f9",
                                                "text": "Le musée de Madame Tussauds est le musée de cire le plus célèbre du monde. Il expose plus de 1000 statues des gens les plus célèbres de la planète. Maria Grosholtz (Madame Tussauds) fonda le musée en 1761, après que son „oncle“, le docteur Philippe Curtius, lui apprit à faire des statues de cire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
