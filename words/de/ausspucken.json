                {
                    "sense_id": "b88f8319-a046-38dd-a83a-353d39904364",
                    "sense_definition": "etwas aus dem Mund befördern oder stoßen",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "mund_ausstoss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das kleine Kind <w>spuckte</w> die bittere Medizin sofort wieder <w>aus</w>.",
                            "target_lang_translations": {
                                "en": "The little child immediately <w>spat out</w> the bitter medicine again."
                            }
                        },
                        {
                            "text": "Er aß eine Kirsche und <w>spuckte</w> den harten Kern <w>aus</w>.",
                            "target_lang_translations": {
                                "en": "He ate a cherry and <w>spat out</w> the hard pit."
                            }
                        }
                    ],
                    "synonyms": [
                        "ausspeien"
                    ],
                    "common_phrases": [
                        "den Kern ausspucken"
                    ],
                    "target_lang_definitions": {
                        "en": "to eject or expel something (such as food, an object, or liquid) from the mouth"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to spit out",
                                "target_lang_sense_clarification": "food or objects from the mouth"
                            },
                            {
                                "target_lang_word": "to expectorate",
                                "target_lang_sense_clarification": "formal / medical"
                            }
                        ]
                    }
                },
                {
