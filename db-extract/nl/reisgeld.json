                    {
                        "sense_id": "fbffca9b-daa5-3044-bb2b-82d8eaf46515",
                        "entry_id": "0bb2e425-94b1-38a6-a25c-56636f707f89",
                        "glosses": [
                            "hoeveelheid geld die nodig is voor het maken van een reis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f661e7-a475-49ca-be85-5e500d1cadeb",
                                "sense_id": "fbffca9b-daa5-3044-bb2b-82d8eaf46515",
                                "text": ",,Het is géén repatriëringsvlucht, daarvoor zal eerst de Stichting Garantiefonds Reisgelden de situatie als calamiteit moeten benoemen\", zegt Kok. Het gaat om passagiers die al zouden terugvliegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8c4def7-ed83-33be-b00d-b77892c0d694",
                        "entry_id": "0bb2e425-94b1-38a6-a25c-56636f707f89",
                        "glosses": [
                            "vergoeding die men krijgt voor reiskosten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6909e40f-5339-4a45-aada-d80ff03af36a",
                                "sense_id": "d8c4def7-ed83-33be-b00d-b77892c0d694",
                                "text": "De SP wil dat de overheid stopt met het vergoeden van vervoer van 'religieuze leerlingen'. Het geld hiervoor kan beter naar het vervoer van gehandicapte kinderen. Dat gaat SP-Kamerlid Jasper van Dijk maandag voorstellen tijdens een overleg over het onderwijs en Artikel 23 van de Grondwet. Van Dijk vindt het reisgeld niet meer van deze tijd."
                            }
                        ]
                    }
