                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e7305f-f889-4d5b-b52f-2720c4bca649",
                                                "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                                                "text": "puffy breath"
                                            },
                                            {
                                                "example_id": "16b90d9c-2d40-4c5e-a48a-1de39035df1d",
                                                "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                                                "text": "A puffy fat man in a tracksuit came jogging around the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0cd40e-9fb5-341d-bdcc-4b67728cdda2",
                                        "entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                                        "glosses": [
                                            "Speaking or writing in an exaggeratedly eloquent and self-important manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e78da4c-8437-45b5-bf1a-95170f7128be",
                                                "sense_id": "6a0cd40e-9fb5-341d-bdcc-4b67728cdda2",
                                                "text": "There has been much puffy stuff written about whether Lyell's uniformitarianism permitted variations in intensity of causes, or whether he applied his logic in a consistent way, and whether he assumed indefinite stretches of geological time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf40b6da-a2a3-39b0-99df-cb61f48438bf",
                                        "entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                                        "glosses": [
                                            "Having inflated cheeks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2352abb-51f7-4619-8213-69c360097a76",
                        "source_entry_id": "1520dbc1-66d4-3501-a385-98915946d3fe",
                        "source_sense_id": "e8e1ecaf-fb17-3920-b156-14c1a0189424",
                        "target_lang_word": "snooty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snooty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d17d1e5-4a02-3bd4-87a9-856ff7a83f0d",
                                        "entry_id": "154ea6e8-758a-35eb-8a7c-5890da274257",
                                        "glosses": [
                                            "Haughty, pompous, snobbish; inclined to turn up one's nose."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea70fed-3c26-4b84-a76b-2dcfd0011470",
                                                "sense_id": "3d17d1e5-4a02-3bd4-87a9-856ff7a83f0d",
                                                "text": "Sir Sydney was an arrogant, snooty, bigoted prig, so it was with some satisfaction that I wrote out his parking ticket."
                                            },
                                            {
                                                "example_id": "555e7a29-826a-4dc2-a86d-73083589650a",
                                                "sense_id": "3d17d1e5-4a02-3bd4-87a9-856ff7a83f0d",
                                                "text": "I didn't like the way you looked at May Arnold, or the snooty way you talked."
                                            },
                                            {
                                                "example_id": "1d00f7e7-d898-4397-a495-268df4be1dc8",
                                                "sense_id": "3d17d1e5-4a02-3bd4-87a9-856ff7a83f0d",
                                                "text": "ever since she landed the National gig she's got very snooty about struggling theatre mates, as if she alone has discovered the secret to being successful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6149c863-843b-3c2f-9a53-9f20c80b41e4",
                                        "entry_id": "154ea6e8-758a-35eb-8a7c-5890da274257",
                                        "glosses": [
                                            "Of an event, a thing, etc.: elite, exclusive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f2681e-fe65-43d8-8adc-e071f0b4f527",
                                                "sense_id": "6149c863-843b-3c2f-9a53-9f20c80b41e4",
                                                "text": "Her parties were snooty affairs; custom-designed cocktail dresses that cost more than a decent luxury car were de rigueur."
                                            },
                                            {
                                                "example_id": "00fe7322-b058-4b76-8710-1dc397bfef69",
                                                "sense_id": "6149c863-843b-3c2f-9a53-9f20c80b41e4",
                                                "text": "The Mercury for 1959 firmly establishes itself as Ford Motor's flashy centerpiece in the middle-price field. […] It's snootier than the Edsel—and snootier than it was, itself, in 1958."
                                            },
                                            {
                                                "example_id": "e618904b-3b3a-47ae-8b50-daca10a77207",
                                                "sense_id": "6149c863-843b-3c2f-9a53-9f20c80b41e4",
                                                "text": "I grew up a privileged princess in Nob Hill, the snootiest neighborhood in San Francisco. My father's family had so much money they didn't know what to do with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9651b792-76fe-304c-835e-cd91e52f985f",
                                        "entry_id": "154ea6e8-758a-35eb-8a7c-5890da274257",
                                        "glosses": [
                                            "Easily angered or irritated; irritable, short-tempered."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
