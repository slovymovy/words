                        "examples": [
                            {
                                "example_id": "5654e899-fd5c-4160-b7ce-c19421b6473a",
                                "sense_id": "fde8958c-55fe-3604-87e1-718683c73cbe",
                                "text": "Burg wordt in de finale vervangen door Pien Dicke, die op de reservelijst stond. De SCHC-speelster maakte afgelopen seizoen twaalf velddoelpunten in de hoofdklasse, het op een na hoogste aantal van alle hockeysters in de Nederlandse competitie."
                            },
                            {
                                "example_id": "3a79225f-ee2e-4d77-b384-06944a2563ab",
                                "sense_id": "fde8958c-55fe-3604-87e1-718683c73cbe",
                                "text": "Yibbi Jansen en Xan de Waard zijn genomineerd voor de prijs van beste hockeyster ter wereld. Bij de mannen maken Thierry Brinkman en Joep de Mol kans op de individuele onderscheiding."
                            }
                        ]
                    }
