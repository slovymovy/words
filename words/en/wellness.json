                    "sense_id": "df61bfe5-02d7-323a-bcfb-03c2c5669b02",
                    "sense_definition": "The state of being in good physical and mental health, often as an actively pursued goal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diet and exercise are the essential cornerstones of <w>wellness</w> for people of all ages.",
                            "target_lang_translations": {
                                "ru": "Диета и физические упражнения являются важнейшими краеугольными камнями <w>здоровья</w> для людей всех возрастов."
                            }
                        },
                        {
                            "text": "The police decided to conduct a <w>wellness</w> check after the neighbor had not been seen for days.",
                            "target_lang_translations": {
                                "ru": "Полиция решила провести проверку <w>благополучия</w>, после того как соседа не видели несколько дней."
                            }
                        }
                    ],
                    "synonyms": [
