    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a444ded-e6e6-3a7f-a8a9-1f41f462f101",
                    "sense_definition": "Sortir naturellement ou volontairement du sommeil.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, je me <w>réveille</w> de bonne heure pour aller courir dans le parc."
                        },
                        {
                            "text": "L'enfant a fait un cauchemar et s'est <w>réveillé</w> en sursaut au milieu de la nuit."
                        }
                    ],
                    "synonyms": [
                        "s'éveiller"
                    ],
                    "antonyms": [
                        "s'endormir"
                    ],
                    "common_phrases": [
                        "se réveiller tôt",
                        "se réveiller en sursaut"
                    ]
                },
                {
                    "sense_id": "192b70f5-977b-3a70-9732-472bb9a4265a",
                    "sense_definition": "Tirer quelqu'un du sommeil, faire cesser son repos.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La sonnerie du téléphone a fini par <w>réveiller</w> toute la maisonnée."
                        },
                        {
                            "text": "Pense à <w>réveiller</w> ton frère avant sept heures pour qu'il ne rate pas son bus."
                        }
                    ],
                    "synonyms": [
                        "éveiller"
                    ],
                    "antonyms": [
                        "endormir"
                    ],
                    "common_phrases": [
                        "réveiller en sursaut",
                        "réveiller quelqu'un en douceur"
                    ]
                },
                {
                    "sense_id": "0655d61d-3244-3af0-9db1-5befab18c7f6",
                    "sense_definition": "Faire renaître ou susciter de nouveau un sentiment, un souvenir ou une sensation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ranimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille mélodie a suffi à <w>réveiller</w> des souvenirs d'enfance oubliés depuis longtemps."
                        },
                        {
                            "text": "La décision soudaine du ministre risque fort de <w>réveiller</w> les tensions sociales."
                        }
                    ],
                    "synonyms": [
                        "ranimer",
                        "raviver",
                        "susciter"
                    ],
                    "antonyms": [
                        "apaiser",
                        "endormir",
                        "étouffer"
                    ],
                    "common_phrases": [
                        "réveiller des souvenirs",
                        "réveiller les soupçons",
                        "réveiller une douleur"
                    ]
                },
                {
                    "sense_id": "5103e100-8075-3e98-9c4c-acb8f44bf25c",
                    "sense_definition": "Reprendre vie, activité ou dynamisme après une période d'inactivité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ranimer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au retour des beaux jours, toute la nature se <w>réveille</w> sous le soleil printanier."
                        },
                        {
                            "text": "Après plusieurs mois de silence, les scientifiques craignent que le volcan ne se <w>réveille</w>."
                        }
                    ],
                    "synonyms": [
                        "renaître",
                        "s'animer"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "s'endormir"
                    ],
                    "common_phrases": [
                        "la nature se réveille",
                        "le volcan se réveille"
                    ]
                },
                {
                    "sense_id": "c8fe08a8-300f-3b06-b6fe-0a9f9a5b3cff",
                    "sense_definition": "Reprendre conscience après un évanouissement, un coma ou une anesthésie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le patient commence lentement à se <w>réveiller</w> après cette délicate intervention chirurgicale."
                        },
                        {
                            "text": "Elle a ouvert les yeux et s'est enfin <w>réveillée</w> dans sa chambre d'hôpital."
                        }
                    ],
                    "synonyms": [
                        "reprendre connaissance",
                        "revenir à soi"
                    ],
                    "antonyms": [
                        "s'évanouir",
                        "sombrer"
                    ],
                    "common_phrases": [
                        "se réveiller du coma",
                        "se réveiller après l'opération"
                    ]
                }
            ]
        }
