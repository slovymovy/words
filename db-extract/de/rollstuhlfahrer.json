                        "sense_id": "16328fff-5710-38e4-9432-f4da9a728672",
                        "entry_id": "0a81e526-a465-380f-91e1-3d0cd1d0df3a",
                        "glosses": [
                            "Person, die sich mithilfe eines Rollstuhls fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18de6b2-3362-4553-be8a-8464acde8e68",
                                "sense_id": "16328fff-5710-38e4-9432-f4da9a728672",
                                "text": "„Segeln ist auch unter Rollstuhlfahrern eine sehr beliebte Wassersportart, wobei die Boote an die Behinderung angepasst werden.“"
                            },
                            {
                                "example_id": "2f1f2457-90bc-417c-b254-51897ec844a4",
                                "sense_id": "16328fff-5710-38e4-9432-f4da9a728672",
                                "text": "„Auch der Rollstuhlfahrer hatte Bücher gestapelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
