                "forms": [
                    {
                        "form_id": "5166fe58-945d-4938-8a5d-875b22e33ac0",
                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                        "tags": [
                            "plural"
                        ],
                        "form": "prélats"
                    },
                    {
                        "form_id": "0b2574d8-e074-4b8a-a4e1-8a3b3f9920b2",
                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                        "tags": [
                            "feminine"
                        ],
                        "form": "prélatesse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                        "glosses": [
                            "Celui qui a une dignité considérable dans l’Église, avec juridiction spirituelle ou, jadis, temporelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6a0b635-ffcd-4a7f-b39f-80e72a2daff8",
                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                "text": "De votre dignité soutenez mieux l'éclat :\nEst-ce pour travailler que vous êtes prélat?"
                            },
                            {
                                "example_id": "4207508d-ebe6-41b8-aa82-e1a5615bb73c",
                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                "text": "Tout ce monde achète, vend, brocante. Des prélats spéculent sur les terrains et les construction, des lazaristes sur les agences de recrutement militaire, etc., etc."
                            },
                            {
                                "example_id": "391de43a-016e-48f5-af99-5bc3b7aae98d",
                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                "text": "Cette chapelle renferme le tombeau de l’évêque Radulphe, dont l’inscription donne la date de 1266, comme étant celle de la mort du prélat."
                            },
                            {
                                "example_id": "fad19be9-9ed5-4b7a-92d9-49909d71a6f5",
                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                "text": "Nous n’en finirions pas si nous voulions citer tous les démêlés des habitants d’Épinal avec les prélats de Metz."
                            },
                            {
                                "example_id": "2472b2ea-3797-43ae-911c-4308b7337c10",
                                "sense_id": "71cfdc2d-ea08-3dc1-b619-b0b5a2326ec9",
                                "text": "Hector fit un geste d’absolution, onctueux comme un prélat, plus dissimulé qu’un Tartuffe et soulagea Arsène André de sa présence."
                            }
                        ]
                    },
                    {
                        "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                        "entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                        "glosses": [
                            "Ecclésiastique qui a droit de porter le violet, à la cour de Rome."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "df11ab48-3b76-4790-a76e-866fe535d460",
                                "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                                "text": "Tous les prélats du palais."
                            },
                            {
                                "example_id": "303c928e-817e-4f23-9d33-8f5748a77d91",
                                "sense_id": "24868c19-4bf7-35fa-8803-2ef2e83b217c",
                                "text": "Les prélats qui accompagnaient le légat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c3fedab-0cbc-4659-a570-41656c091188",
                        "source_entry_id": "27a409f2-7b4d-3a45-ab73-dd8f88713b27",
                        "target_lang_word": "Prälat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prälat",
