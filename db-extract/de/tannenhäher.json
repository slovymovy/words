                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66f12064-87af-4f18-99da-e267140dd4ab",
                                "sense_id": "59135b2c-5296-3588-ad0a-203d49ff5019",
                                "text": "Im Garten sitzt ein Tannenhäher."
                            },
                            {
                                "example_id": "e08dcfce-4219-4076-a073-964240d7d9de",
                                "sense_id": "59135b2c-5296-3588-ad0a-203d49ff5019",
                                "text": "Der Tannenhäher, ein Rabenvogel, ist mit Eichelhäher und Elster verwandt."
                            },
                            {
                                "example_id": "16ec00de-c202-423d-94dd-60f72767e286",
                                "sense_id": "59135b2c-5296-3588-ad0a-203d49ff5019",
                                "text": "„Der Tannenhäher ist in den Wäldern der Mittelgebirge, Bergwäldern der Alpen und des Balkans, aber auch in Südskandinavien und Sibirien zu Hause.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
