                                    }
                                ]
                            },
                            {
                                "target_word": "beetle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f313f70e-66bd-3437-9d3b-edc89187e3d3",
                                        "entry_id": "87f2ccf7-693a-3c6e-8f06-cd11c2db4df4",
                                        "glosses": [
                                            "Archaic spelling of betel."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c6d103-4c74-443e-8a3b-30827478938d",
                                                "sense_id": "f313f70e-66bd-3437-9d3b-edc89187e3d3",
                                                "text": "Scatter black sand, and offer camphor, sandal, flowers, beetle-leaves, and all sorts of fragrance."
                                            },
                                            {
                                                "example_id": "bbd58353-77d2-4f5c-8b42-f5b71a82c988",
                                                "sense_id": "f313f70e-66bd-3437-9d3b-edc89187e3d3",
                                                "text": "Beetle-leaf is absolutely a primary necessary article of life; every person consumes it daily, especially when travelling; the hindoo of caste has great difficulties in the way of cooking food, which are augmented whenever from home, and the beetle alleviates his hunger."
                                            },
                                            {
                                                "example_id": "4bdd7385-d392-4a56-a068-8b48b3cd3255",
                                                "sense_id": "f313f70e-66bd-3437-9d3b-edc89187e3d3",
                                                "text": "\"It consists of the beetle leaf, in which the piece of an areca-nut is mixed with some lime out of the oyster and muscle shells, and so put into the mouth and chewed. Out of the beetle leaves, during the preparation, the fibres that are hard and rough are first drawn to the leaf; the form of a little horn is then given, open at the bottom, and pointed at the top, which when the areca-nut is inserted is closed, and so chewed.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
