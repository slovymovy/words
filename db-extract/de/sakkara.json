                "senses": [
                    {
                        "sense_id": "0356356c-ec4f-3241-be37-842087469739",
                        "entry_id": "6b1c628b-2102-3b26-aa12-b2de5c37f6b5",
                        "glosses": [
                            "altägyptische Nekropole am westlichen Nilufer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7778c483-3d7c-4e66-a223-597a239b3abc",
                                "sense_id": "0356356c-ec4f-3241-be37-842087469739",
                                "text": "„Auch die Pyramiden einiger Pharaonen finden sich in Sakkara.“"
                            },
                            {
                                "example_id": "9249e512-4627-433c-a98c-3e5bedb90985",
                                "sense_id": "0356356c-ec4f-3241-be37-842087469739",
                                "text": "„Hier kann man typische Beispiele ägyptischer Einbalsamierungskunst finden - von den frühesten Mumien aus der Totenstadt Sakkara bis zu den spätesten derartigen Unternehmungen der Kopten im 8. Jahrhundert; darüber hinaus auch Mumien aus anderen Kulturen, einschließlich prähistorischer indianischer Beispiele, die jüngst auf den Aleuten entdeckt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
