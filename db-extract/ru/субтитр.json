                "senses": [
                    {
                        "sense_id": "75a20d51-9d79-3d4c-be11-2aa495e820ff",
                        "entry_id": "4443ed09-d2d5-3fe9-a6b2-dee34ec60739",
                        "glosses": [
                            "надпись в нижней части кадра кинофильма, являющаяся переводом иноязычного диалога или любого текста"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81f754f7-f61f-44b6-94ad-b078dae72ce1",
                                "sense_id": "75a20d51-9d79-3d4c-be11-2aa495e820ff",
                                "text": "Далее: производители DVD-дисков любят напихивать туда всяческих бонусов: материалов со съемок, фильмографию, субтитры на китайском или чего-нибудь еще."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfc74a27-bf58-4398-bb59-de2175df0273",
                        "source_entry_id": "4443ed09-d2d5-3fe9-a6b2-dee34ec60739",
                        "source_sense_id": "75a20d51-9d79-3d4c-be11-2aa495e820ff",
                        "target_lang_word": "subtitle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subtitle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7007a885-7830-30e3-a4cb-05697a9db822",
                                        "entry_id": "3db48e52-e85d-3b8a-8816-c3d74f481515",
                                        "glosses": [
                                            "A heading below or after a title."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "981ae609-d555-39a3-ae2c-4bd70d553e71",
                                        "entry_id": "3db48e52-e85d-3b8a-8816-c3d74f481515",
                                        "glosses": [
                                            "Textual versions of the dialogue in films (and similar media such as television or video games), usually displayed at the bottom of the screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9faf790-8328-41a0-b7af-08ba25e3f885",
                                                "sense_id": "981ae609-d555-39a3-ae2c-4bd70d553e71",
                                                "text": "Careful viewers have long observed that in the movies, one can not only watch but read cigarettes like subtitles — translating the action on the screen into another language which the camera registers but rarely foregrounds, a part of the thickness of the medium which is almost never brought into focus. […] The cigarette in the scene serves as a subtext, a mute caption or subtitle, sometimes accompanying, sometimes contradicting or diverting the explicit premise of the action or the open meaning of signs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subtitle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f39bbb69-da99-3fe3-826c-e1bc397836fd",
                                        "entry_id": "09568505-de73-3b0f-a76e-344cd3d88971",
                                        "glosses": [
                                            "To create subtitles for the dialogue in a film."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05666816-3b9c-4a48-b9af-8da37d1ab943",
                        "source_entry_id": "4443ed09-d2d5-3fe9-a6b2-dee34ec60739",
                        "source_sense_id": "75a20d51-9d79-3d4c-be11-2aa495e820ff",
                        "target_lang_word": "Untertitel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Untertitel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "ein zweiter Titel, der unter dem ersten steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3ddc149-15d5-446b-b281-4478669eac4b",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "Die deutsche Version des Buches trägt den Untertitel: „Ein Paar am Rande der Trennung“."
                                            },
                                            {
                                                "example_id": "3cd84ebe-98a3-4fda-a2fd-b9ceaf8a7baa",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Sie ermorde den jüdischen Witz, heißt es im Untertitel seiner Kritik.“"
                                            },
                                            {
                                                "example_id": "d6346b8a-504b-488a-98b0-42c85224922c",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Unter all den durch den Untertitel angekündigten Figuren ist der Fischhändler womöglich die eindrücklichste.“"
                                            },
                                            {
                                                "example_id": "b6926095-9519-4ea2-be0a-c8c68725e8a1",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Mir war bewußt, daß mich noch ein Untertitel erwartete.“"
                                            },
                                            {
                                                "example_id": "d1d547ee-0c6d-4c52-bb98-8df6226a213f",
                                                "sense_id": "ade01603-fa55-3175-9372-f46d46ff6451",
                                                "text": "„Wie das im Falle von Neubearbeitungen gern geschieht, werden nicht selten bei Verlagswechsel gleichzeitig Titel oder Untertitel verändert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "73f190e4-9fe8-3098-9deb-23c2eb9ae0e2",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "unter dem Bild eingeblendete Schrift in Filmen"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f000a91-fc44-47ee-9823-64cd8ba53d58",
                                                "sense_id": "73f190e4-9fe8-3098-9deb-23c2eb9ae0e2",
                                                "text": "Die DVD hat Untertitel mit Kommentaren zum philosophischem Hintergrund der Geschichte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "unter dem Bild eingeblendete Schrift in Filmen",
                                            "speziell; meist: ausgeschriebenes Gesprochenes des Films oder Übersetzung dessen"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67895bc6-0f06-44d6-ad09-d24d83c50b08",
                                                "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                                "text": "Er schaut die Filme meist auf Koreanisch und mit englischen Untertiteln."
                                            },
                                            {
                                                "example_id": "2553fec0-35af-4b0a-8656-79e5f7abc463",
                                                "sense_id": "1463b2b2-f567-3fc5-bfd5-700881049db7",
                                                "text": "„Natürlich schleppt mich dieser bekloppte Cineast in die Originalfassung, kantonesisch mit englischen Untertiteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "08109458-4377-3b7d-8866-53066facdb27",
                                        "entry_id": "65a00319-c87f-3b47-befc-beed59cdab9e",
                                        "glosses": [
                                            "ein Titel oder Kommentar, der unter etwas geschrieben steht und darauf Bezug nimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98412f0-2606-467b-92ee-bfb35c6398d8",
                                                "sense_id": "08109458-4377-3b7d-8866-53066facdb27",
                                                "text": "Auf den Bildern befinden sich Untertitel mit humoristischen Anmerkungen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
