                "senses": [
                    {
                        "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                        "entry_id": "0b4514e9-5f16-3f05-991c-4098471f9ff6",
                        "glosses": [
                            "Architektur, die hauptsächlich der Repräsentation dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1021c59-f53c-4e79-a134-8885c19a3e54",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Das 14. Jahrhundert, das der Kunsthistoriker Wilhelm Pinder als \"erste Bürgerzeit\" bezeichnete, habe in der Folge bürgerlichen Machtgewinns auch eine eigene Repräsentationsarchitektur entwickelt, die Pfarrkirche als monumentale Hallenkirche.“"
                            },
                            {
                                "example_id": "f6482ebd-6490-45f2-8923-28d7aba5147f",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Und sie tun das in Berlin, Potsdamer Platz - in jener kalten, leeren \"Neuen Mitte\", der Renzo Pianos Repräsentationsarchitektur vergeblich neues Leben einzuhauchen sucht.“"
                            },
                            {
                                "example_id": "e46d8ade-6365-4084-87ff-29539b371575",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Anders sah es in der ehemaligen DDR aus, die streng zwischen staatlicher Repräsentationsarchitektur und kollektivistischen Massenbehausungen unterschied.“"
                            },
                            {
                                "example_id": "68b5fe19-fb10-4476-a1d2-997910b4167f",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Dabei stellten die Römer den Zweckbau und die Bewältigung natürlicher Gegebenheiten als architektonische Herausforderung in ihrer Wertschätzung auf die gleiche Stufe mit Aufgaben der Sakral- und Repräsentationsarchitektur.“"
                            },
                            {
                                "example_id": "2788234c-61b4-44aa-a856-e6c434a7012b",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Sowohl die herrscherliche Repräsentationsarchitektur als auch die Idee einer monastischen Idealarchitektur im 9. Jahrhundert (St. Galler Klosterplan) zeigen die enorme Bedeutung, die man der Baukunst wieder zuzumessen begann.“"
                            },
                            {
                                "example_id": "fdc650e8-1268-415c-b67b-671f9c8e0997",
                                "sense_id": "ddf63a6a-abd4-3c19-9f76-7fad94a47f0b",
                                "text": "„Auf dem Weg dorthin passiert man die Repräsentationsarchitektur der Ringstraße und des Schwarzenbergplatzes, den Unteren Teil des Schlosses Belvedere und durchfährt in weiterer Folge auch den 11. Bezirk, einen Arbeiterbezirk mit multikulturellem Einschlag - man bekommt also einen gar nicht so unrepräsentativen Querschnitt der Stadt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
