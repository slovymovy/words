                            {
                                "example_id": "301453ad-f76b-4219-90b4-b04d32b3be6a",
                                "sense_id": "a983e02d-51f5-3927-9808-6203cba05c4a",
                                "text": "Als uitgangspunt voor de voegovergang op het tussensteunpunt/landhoofd is gekozen voor een oplossing met een rijijzer."
                            },
                            {
                                "example_id": "28739bd6-e05a-431d-8abb-b25e2e695fa7",
                                "sense_id": "a983e02d-51f5-3927-9808-6203cba05c4a",
                                "text": "Ter voorkoming van beschadigen van het brugdek bij het oprijden van voertuigen, is een rij-ijzer aangebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "08b68237-d156-3d28-8565-5bed28ad8f6d",
