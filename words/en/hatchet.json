{
    "word_family": [
        "hatcheting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a0b7b30-aa54-38f9-9ee5-c79b356b1af7",
                    "sense_definition": "A small, light axe with a short handle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The camper used a <w>hatchet</w> to chop small pieces of wood for the fire.",
                            "target_lang_translations": {
                                "de": "Der Camper benutzte ein <w>Beil</w>, um kleine Holzstücke für das Feuer zu hacken."
                            }
                        },
                        {
                            "text": "He carried a sharp <w>hatchet</w> in his belt while hiking through the dense forest.",
                            "target_lang_translations": {
                                "de": "Er trug ein scharfes <w>Beil</w> am Gürtel, während er durch den dichten Wald wanderte."
                            }
                        }
                    ],
                    "synonyms": [
                        "tomahawk"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleines, leichtes Beil mit kurzem Stiel."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Beil",
                                "target_lang_sense_clarification": "kurzes, kleines Schlagwerkzeug zum Holzspalten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac101717-44c1-3df5-9537-e2d19c068b72",
                    "sense_definition": "Belligerence, animosity, or harsh criticism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of arguing, the two rivals finally decided to bury the <w>hatchet</w> and become friends.",
                            "target_lang_translations": {
                                "de": "Nach Jahren des Streits beschlossen die beiden Rivalen endlich, das <w>Kriegsbeil</w> zu begraben und Freunde zu werden."
                            }
                        },
                        {
                            "text": "The newspaper published a brutal <w>hatchet</w> job that destroyed the politician's reputation.",
                            "target_lang_translations": {
                                "de": "Die Zeitung veröffentlichte einen brutalen <w>Verriss</w>, der den Ruf des Politikers zerstörte."
                            }
                        }
                    ],
                    "synonyms": [
                        "animosity",
                        "hostility"
                    ],
                    "antonyms": [
                        "friendship",
                        "peace"
                    ],
                    "common_phrases": [
                        "bury the hatchet",
                        "hatchet job"
                    ],
                    "target_lang_definitions": {
                        "de": "Kriegerische Haltung, Feindseligkeit oder vernichtende Kritik."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kriegsbeil",
                                "target_lang_sense_clarification": "im übertragenen Sinne für Feindseligkeiten (in 'das Kriegsbeil begraben')"
                            },
                            {
                                "target_lang_word": "Verriss",
                                "target_lang_sense_clarification": "vernichtende Kritik oder Rezension"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "baab1498-d969-33b6-9fe9-739b1b4711ad",
                    "sense_definition": "To cut or chop something using a hatchet.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodsman began to <w>hatchet</w> the thick branches away from the fallen tree.",
                            "target_lang_translations": {
                                "de": "Der Holzfäller begann, die dicken Äste vom umgestürzten Baum <w>abzuhacken</w>."
                            }
                        },
                        {
                            "text": "They had to <w>hatchet</w> through the thick undergrowth to clear a path for the group.",
                            "target_lang_translations": {
                                "de": "Sie mussten sich durch das dichte Unterholz <w>hacken</w>, um einen Pfad für die Gruppe freizumachen."
                            }
                        }
                    ],
                    "synonyms": [
                        "chop",
                        "hack"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit einem Beil schneiden oder hacken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "behacken",
                                "target_lang_sense_clarification": "mit einem Beil bearbeiten"
                            },
                            {
                                "target_lang_word": "abhacken",
                                "target_lang_sense_clarification": "etwas mit einem Beil abtrennen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}