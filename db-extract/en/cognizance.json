                                        "entry_id": "ddcbe723-570a-398f-a7b7-6abdaa4821be",
                                        "glosses": [
                                            "een toestand waarin men gewaarwordingen uit zijn omgeving ondergaat en besef heeft van het eigen ik, wakker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de0ca55-8a4a-44aa-a390-dc6ad6959ba8",
                                                "sense_id": "f67f76c7-23a2-32b4-a3f9-2beb959a0c60",
                                                "text": "Hij verloor het bewustzijn na het zien van het bloed."
                                            },
                                            {
                                                "example_id": "7e051d8e-abfa-4abf-a0ba-c9ffe9242dbc",
                                                "sense_id": "f67f76c7-23a2-32b4-a3f9-2beb959a0c60",
                                                "text": "Natuurlijk had ze er al eerder uitgebreid over willen spreken, maar haar bewustzijn gaf deze emotie gewoonweg geen toegang tot haar dagelijkse gedachtegang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f244553-040d-30aa-b3f2-b1f1e8620d12",
                                        "entry_id": "ddcbe723-570a-398f-a7b7-6abdaa4821be",
                                        "glosses": [
