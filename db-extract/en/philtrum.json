                                                "sense_id": "91863fbd-20ec-3dba-87d3-3924e2845c33",
                                                "text": "το μητρικό φίλτρο"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce06489a-94ba-3b26-bfaa-ce27d14a8508",
                                        "entry_id": "85908ba4-70df-354c-81a2-c39ff97a0fa3",
                                        "glosses": [
                                            "οποιοδήποτε παρασκεύασμα με συνήθως παράδοξα συστατικά με μαγικές ιδιότητες"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e874738-2d8c-43ff-86fb-796c0fdd3fbf",
                                                "sense_id": "ce06489a-94ba-3b26-bfaa-ce27d14a8508",
                                                "text": "ερωτικό φίλτρο, μαγικό φίλτρο"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d6136e3-f1fc-3374-8fea-7a80df0f3ea4",
                                        "entry_id": "85908ba4-70df-354c-81a2-c39ff97a0fa3",
                                        "glosses": [
                                            "όρος που περιγράφει αυλακώσεις όπως αυτή του άνω χείλους"
                                        ],
                                        "tags": [
                                            "ανατομία"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d4895b4-1c42-3089-b37e-ba8ea429f479",
                                        "entry_id": "85908ba4-70df-354c-81a2-c39ff97a0fa3",
                                        "glosses": [
                                            "όρος που περιγράφει δύο αυλακώσεις:"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b05c3fdb-22a1-4b68-8326-851a4026e055",
                                                "sense_id": "1d4895b4-1c42-3089-b37e-ba8ea429f479",
                                                "text": "α. Φίλτρο του άνω χείλους ονομάζεται η αύλακα που βρίσκεται ακριβώς πάνω από το μέσο του άνω χείλους και εκεί που τελειώνει το ρινικό διάφραγμα"
                                            },
                                            {
                                                "example_id": "cb5b6229-e1f9-4f1e-bfca-cbf430e6dce8",
                                                "sense_id": "1d4895b4-1c42-3089-b37e-ba8ea429f479",
                                                "text": "β. Φίλτρο του Μέρκελ ονομάζεται μια αύλακα στην άνω μοίρα της λαρυγγικής κοιλότητας"
                                            }
                                        ]
