                "senses": [
                    {
                        "sense_id": "f5fe23c2-a6c3-36b2-8987-130d1f3f95f9",
                        "entry_id": "1f4467a6-dcb4-3f1b-8f12-52bb9d384cd3",
                        "glosses": [
                            "Aktivität, die regelmäßig am Abend durchgeführt wird, typischerweise kurzer, entspannter Spaziergang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fc0e652-149a-4df8-9813-6c0a51e3b2a9",
                                "sense_id": "f5fe23c2-a6c3-36b2-8987-130d1f3f95f9",
                                "text": "„Ein Funkstreifenwagen der Düsseldorfer Polizei machte seine Abendrunde durch den Stadtteil Lierenfeld, als er gegen 20.35 Uhr auf der Karl-Geusen-Straße von Passanten gestoppt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "32a8184f-5349-3278-bc7c-abac51304983",
                        "entry_id": "1f4467a6-dcb4-3f1b-8f12-52bb9d384cd3",
                        "glosses": [
                            "Aktivität (zum Beispiel Diskussion, kulturelle Veranstaltung oder sportliche Aktivität) oder Treffen, die/das abends stattfindet, oft in einer entspannten und geselligen Atmosphäre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c2924aa-57e9-4d8d-9ba7-4c39c78a7cc3",
                                "sense_id": "32a8184f-5349-3278-bc7c-abac51304983",
                                "text": "„Das Ziel: Ob bei der Diskussion in der Mittagspause mit Kollegen, der Abendrunde mit Freunden oder im Parlament – man soll immer die wichtigsten Argumente griffbereit haben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
