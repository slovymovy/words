{
    "word_family": [
        "petroleum",
        "petroliferous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d4fdaa7-087a-3a22-9973-4e8ab6cd8f1e",
                    "sense_definition": "A liquid fuel derived from petroleum, used to power internal combustion engines in vehicles.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to stop at the next station because the car is almost out of <w>petrol</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно остановиться на следующей заправке, потому что в машине почти закончился <w>бензин</w>."
                            }
                        },
                        {
                            "text": "The price of <w>unleaded</w> <w>petrol</w> has increased significantly over the last few months.",
                            "target_lang_translations": {
                                "ru": "Цена на <w>неэтилированный</w> <w>бензин</w> значительно выросла за последние несколько месяцев."
                            }
                        }
                    ],
                    "synonyms": [
                        "gasoline",
                        "gas"
                    ],
                    "common_phrases": [
                        "unleaded petrol",
                        "petrol station",
                        "petrol tank",
                        "petrol pump"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жидкое топливо, получаемое из нефти, используемое для работы двигателей внутреннего сгорания в транспортных средствах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бензин",
                                "target_lang_sense_clarification": "топливо для автомобилей"
                            },
                            {
                                "target_lang_word": "горючее",
                                "target_lang_sense_clarification": "общее название топлива"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "067ac279-189e-3456-b399-ec0a826dc45f",
                    "sense_definition": "A motor vehicle that runs on petrol rather than diesel or electricity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicle_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When choosing a new car, many buyers still prefer <w>petrols</w> over diesel models for city driving.",
                            "target_lang_translations": {
                                "ru": "При выборе нового автомобиля многие покупатели по-прежнему предпочитают <w>бензиновые модели</w> дизельным для езды по городу."
                            }
                        },
                        {
                            "text": "The dealership has a wide range of <w>petrols</w> and diesels available for a test drive.",
                            "target_lang_translations": {
                                "ru": "В дилерском центре представлен широкий выбор <w>бензиновых</w> и дизельных автомобилей, доступных для тест-драйва."
                            }
                        }
                    ],
                    "common_phrases": [
                        "petrols and diesels"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used when comparing engine types"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Транспортное средство с бензиновым двигателем (в отличие от дизельного или электрического)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бензиновый автомобиль",
                                "target_lang_sense_clarification": "машина с бензиновым двигателем"
                            },
                            {
                                "target_lang_word": "бензиновая модель",
                                "target_lang_sense_clarification": "тип двигателя автомобиля"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6833eadf-bf84-3add-94ad-5694e9859830",
                    "sense_definition": "To fill or supply a vehicle or container with petrol.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "refueling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We stopped to <w>petrol</w> the car before starting our long journey across the country.",
                            "target_lang_translations": {
                                "ru": "Мы остановились, чтобы <w>заправить</w> машину перед началом долгого путешествия через всю страну."
                            }
                        },
                        {
                            "text": "He spent the morning <w>petrolling</w> the lawnmower and other garden equipment.",
                            "target_lang_translations": {
                                "ru": "Утро он провел, <w>заправляя бензином</w> газонокосилку и другой садовый инвентарь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заправлять или наполнять транспортное средство или емкость бензином."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заправлять бензином",
                                "target_lang_sense_clarification": "наполнять бак"
                            },
                            {
                                "target_lang_word": "заливать бензин",
                                "target_lang_sense_clarification": "процесс заправки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}