                ],
                "senses": [
                    {
                        "sense_id": "28c4eecf-007b-34f8-926b-ede1ae52ae8d",
                        "entry_id": "b8481667-0b6b-32cc-9be5-ac786a72b806",
                        "glosses": [
                            "Munir de lunettes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9180804e-068b-430e-978e-04db5e71d09e",
                                "sense_id": "28c4eecf-007b-34f8-926b-ede1ae52ae8d",
                                "text": "A moins cependant que, comme pour la vaccination, l'État ne préfère imposer aux parents l'obligation de lunetter leurs enfants au berceau."
                            },
                            {
                                "example_id": "9cdd05e9-b7a0-40dc-91c8-44da42842b44",
                                "sense_id": "28c4eecf-007b-34f8-926b-ede1ae52ae8d",
                                "text": "On le retapissait même s'il avait pris la précaution de se lunetter de noir."
                            },
                            {
                                "example_id": "6fc2fd37-fb7f-4776-8593-3aa2415def96",
                                "sense_id": "28c4eecf-007b-34f8-926b-ede1ae52ae8d",
                                "text": "Il s'est lunetté, d'abord d'écaille qui lui tombait sur le milieu du nez et le blessait, maintenant d'or qui lui donne l'allure d'un notaire échappé de sa province."
                            }
                        ]
                    }
                ],
