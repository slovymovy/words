                ],
                "senses": [
                    {
                        "sense_id": "7f3167d9-cae3-3f27-88aa-673e1b3b5105",
                        "entry_id": "a3be5b45-42f7-3b39-9892-56bbd4419c61",
                        "glosses": [
                            "pracownik odpowiadający za techniczną i organizacyjną stronę przedstawienia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec347c51-7c9b-4882-a038-d040d095220c",
                                "sense_id": "7f3167d9-cae3-3f27-88aa-673e1b3b5105",
                                "text": "Na znak inspicjenta zgaszono światło na sali, a orkiestra rozpoczęła uwerturę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05275689-5bf8-40bc-b55d-391d56bc8809",
                        "source_entry_id": "a3be5b45-42f7-3b39-9892-56bbd4419c61",
                        "source_sense_id": "7f3167d9-cae3-3f27-88aa-673e1b3b5105",
                        "target_lang_word": "régisseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régisseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f3b5c50e-a2d7-3843-bc3e-b997b2aa3eee",
                                        "entry_id": "3441e87a-0a5c-3f04-80e2-0705b3d75b7f",
                                        "glosses": [
                                            "Homme qui régit, qui gère par commission et a la charge de rendre compte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa028462-dc1b-436d-98c6-1021c94dc9f7",
                                                "sense_id": "f3b5c50e-a2d7-3843-bc3e-b997b2aa3eee",
                                                "text": "Le poste de régisseur de Chausey est très recherché, et donne lieu à autant d’intrigues que peut en susciter un portefeuille de ministre autour d’un, roi constitutionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fda62414-4636-3064-aaa8-4f612a2c5074",
                                        "entry_id": "3441e87a-0a5c-3f04-80e2-0705b3d75b7f",
                                        "glosses": [
                                            "Homme qui régit et gère un domaine pour le compte d’autrui."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c2242a3-22f8-4aa8-9507-0504dca0ff55",
                                                "sense_id": "fda62414-4636-3064-aaa8-4f612a2c5074",
                                                "text": "Quoique d’un produit considérable, la terre était abandonnée aux soins d’un régisseur et gardée par d’anciens serviteurs."
                                            },
                                            {
                                                "example_id": "530ac4a1-52c5-4032-8517-24e580558a21",
                                                "sense_id": "fda62414-4636-3064-aaa8-4f612a2c5074",
                                                "text": "Je vais lui proposer d’être ici notre régisseur. Je crois qu’il nous secondera avec probité, expérience."
                                            },
                                            {
                                                "example_id": "601f9e0a-7f55-44fb-b4c5-1869bd535df7",
                                                "sense_id": "fda62414-4636-3064-aaa8-4f612a2c5074",
                                                "text": "Ils gèrent leur domaine en exploitation semi-directe, par l’intermédiaire d’un régisseur qui a la haute main sur les travaux et les ouvriers, le plus souvent des ouvriers employés au mois, \"mesadiers\" venus de la montagne et plus dociles que les journaliers venus du village voisin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                        "entry_id": "3441e87a-0a5c-3f04-80e2-0705b3d75b7f",
                                        "glosses": [
                                            "Employé chargé particulièrement de veiller à tous les détails matériels de la représentation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8df0006-0098-471e-805b-c2643154da87",
                                                "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                                "text": "Le régisseur frappa les trois coups, la toile se leva lentement, découvrant une salle bondée de monde."
                                            },
                                            {
                                                "example_id": "3d0a3243-d8cd-4dd7-87f3-2b3781468cc5",
                                                "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                                "text": "Les machinistes prenaient leurs postes, les figurants se massaient en reculant vers le troisième plan, et le régisseur gesticulait pour accélérer la manœuvre."
                                            },
                                            {
                                                "example_id": "58375c0e-d370-48e4-80c2-1f7d9a44dbab",
                                                "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                                "text": "Je veux passer avant tes girls, expliquait-il au régisseur. Arrange-toi pour ne pas me faire poireauter. Avec elles, on n’en finit plus."
                                            },
                                            {
                                                "example_id": "1927f427-e93e-4db3-a414-84ac6d55588f",
                                                "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                                "text": "Le régisseur de scène doit réaliser la maquette du décorateur. Ou bien alors il faut un régisseur-constructeur, bras droit du metteur en scène et qui a tous droits sur le plateau."
                                            },
                                            {
                                                "example_id": "3f23081b-f7f0-42d2-b101-5d96224d7051",
                                                "sense_id": "ffdc380c-b1c0-399d-9e90-70d0ef1edfe3",
                                                "text": "Il vit le metteur en scène et le régisseur se lever, à contre-jour — enfin à contre-lumière — ; il vit une sorte de panique en ombres chinoises sur le plateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a38279fe-6cbb-38c4-897a-bb4d0d99133a",
                                        "entry_id": "3441e87a-0a5c-3f04-80e2-0705b3d75b7f",
                                        "glosses": [
                                            "Celui qui est responsable de l’organisation matérielle et logistique d’un tournage."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
