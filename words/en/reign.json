{
    "word_family": [
        "regnal",
        "interregnum"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "307e42ef-a94e-37ea-aec3-8fb837341beb",
                    "sense_definition": "The period of time during which a monarch rules.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reign</w> of Queen Victoria lasted for more than sixty years.",
                            "target_lang_translations": {
                                "ru": "<w>Царствование</w> королевы Виктории длилось более шестидесяти лет.",
                                "zh": "维多利亚女王的<w>统治</w>持续了六十多年。",
                                "pl": "<w>Panowanie</w> królowej Wiktorii trwało ponad sześćdziesiąt lat."
                            }
                        },
                        {
                            "text": "Many important social changes occurred during the King's long <w>reign</w>.",
                            "target_lang_translations": {
                                "ru": "Многие важные социальные изменения произошли за время долгого <w>правления</w> короля.",
                                "zh": "在国王漫长的<w>在位</w>期间，发生了许多重要的社会变革。",
                                "pl": "Wiele ważnych zmian społecznych zaszło podczas długiego <w>panowania</w> króla."
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "era",
                        "period"
                    ],
                    "common_phrases": [
                        "during the reign of",
                        "long reign",
                        "end of a reign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого правит монарх.",
                        "zh": "君主统治的时期。",
                        "pl": "Okres czasu, w którym panuje monarcha."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ца́рствование",
                                "target_lang_sense_clarification": "время пребывания на троне"
                            },
                            {
                                "target_lang_word": "правле́ние",
                                "target_lang_sense_clarification": "период осуществления власти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "君主行使权力的时期"
                            },
                            {
                                "target_lang_word": "在位",
                                "target_lang_sense_clarification": "君主执政期间"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "panowanie",
                                "target_lang_sense_clarification": "okres władzy danego monarchy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa0c2854-35df-3f98-90fd-08eb0c892423",
                    "sense_definition": "The exercise of sovereign power or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator's <w>reign</w> of terror caused suffering for millions of people.",
                            "target_lang_translations": {
                                "ru": "<w>Царство</w> террора диктатора причинило страдания миллионам людей.",
                                "zh": "独裁者的恐怖<w>统治</w>给数百万人带来了苦难。",
                                "pl": "<w>Rządy</w> terroru dyktatora przyniosły cierpienie milionom ludzi."
                            }
                        },
                        {
                            "text": "Under the <w>reign</w> of the new emperor, the country prospered greatly.",
                            "target_lang_translations": {
                                "ru": "В <w>правление</w> нового императора страна сильно процветала.",
                                "zh": "在新皇帝的<w>统治</w>下，国家变得非常繁荣。",
                                "pl": "Pod <w>panowaniem</w> nowego cesarza kraj bardzo się rozwinął."
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "dominion",
                        "sovereignty",
                        "command"
                    ],
                    "common_phrases": [
                        "reign of terror",
                        "under someone's reign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществление верховной власти или полномочий.",
                        "zh": "行使主权或权威。",
                        "pl": "Sprawowanie władzy zwierzchniej lub autorytetu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правле́ние",
                                "target_lang_sense_clarification": "управление государством"
                            },
                            {
                                "target_lang_word": "госпо́дство",
                                "target_lang_sense_clarification": "полная власть, доминирование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "对国家或地区的管辖"
                            },
                            {
                                "target_lang_word": "支配",
                                "target_lang_sense_clarification": "拥有绝对的控制权"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "panowanie",
                                "target_lang_sense_clarification": "władza, dominacja"
                            },
                            {
                                "target_lang_word": "rządy",
                                "target_lang_sense_clarification": "sprawowanie władzy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b1dae70-50d0-3f67-9932-cd8beb52641b",
                    "sense_definition": "To exercise sovereign power; to rule as a monarch.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "to_rule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Queen Elizabeth II <w>reigned</w> over the United Kingdom for seven decades.",
                            "target_lang_translations": {
                                "ru": "Королева Елизавета II <w>царствовала</w> в Соединенном Королевстве семь десятилетий.",
                                "zh": "伊丽莎白二世女王在英国<w>在位</w>长达七十年。",
                                "pl": "Królowa Elżbieta II <w>panowała</w> w Zjednoczonym Królestwie przez siedem dekad."
                            }
                        },
                        {
                            "text": "The king <w>reigned</w> with wisdom and kindness towards his subjects.",
                            "target_lang_translations": {
                                "ru": "Король <w>правил</w> мудро и по-доброму по отношению к своим подданным.",
                                "zh": "国王以智慧和仁慈<w>统治</w>着他的臣民。",
                                "pl": "Król <w>panował</w> mądrze i życzliwie wobec swoich poddanych."
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "govern"
                    ],
                    "common_phrases": [
                        "reign over",
                        "reign supreme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осуществлять верховную власть; править как монарх.",
                        "zh": "行使主权；作为君主进行统治。",
                        "pl": "Sprawować władzę zwierzchnią; rządzić jako monarcha."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ца́рствовать",
                                "target_lang_sense_clarification": "быть царем, королем"
                            },
                            {
                                "target_lang_word": "пра́вить",
                                "target_lang_sense_clarification": "управлять страной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "统治",
                                "target_lang_sense_clarification": "管理国家"
                            },
                            {
                                "target_lang_word": "在位",
                                "target_lang_sense_clarification": "担任君主职位"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "panować",
                                "target_lang_sense_clarification": "być władcą kraju"
                            },
                            {
                                "target_lang_word": "królować",
                                "target_lang_sense_clarification": "sprawować władzę królewską"
                            },
                            {
                                "target_lang_word": "władać",
                                "target_lang_sense_clarification": "sprawować nad czymś władzę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8ba62a3-531f-3468-aa87-30c84f0e943e",
                    "sense_definition": "To be the dominant quality or characteristic of a place or situation; to prevail.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "to_prevail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An awkward silence <w>reigned</w> in the room after the argument ended.",
                            "target_lang_translations": {
                                "ru": "После окончания спора в комнате <w>воцарилась</w> неловкая тишина.",
                                "zh": "争吵结束后，房间里<w>笼罩</w>着尴尬的沉默。",
                                "pl": "Po zakończeniu kłótni w pokoju <w>panowała</w> niezręczna cisza."
                            }
                        },
                        {
                            "text": "Confusion <w>reigned</w> as the crowd tried to find the emergency exits.",
                            "target_lang_translations": {
                                "ru": "Пока толпа пыталась найти аварийные выходы, <w>царила</w> неразбериха.",
                                "zh": "当人群试图寻找紧急出口时，现场<w>充斥</w>着混乱。",
                                "pl": "W tłumie <w>panował</w> chaos, gdy ludzie próbowali znaleźć wyjścia ewakuacyjne."
                            }
                        }
                    ],
                    "synonyms": [
                        "prevail",
                        "predominate",
                        "rule"
                    ],
                    "common_phrases": [
                        "silence reigns",
                        "chaos reigns",
                        "confusion reigns"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often literary or dramatic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть преобладающим качеством или характеристикой места или ситуации; воцаряться.",
                        "zh": "指某种氛围或状态在某地占主导地位。",
                        "pl": "Być dominującą cechą lub stanem w danym miejscu lub sytuacji; przeważać."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цари́ть",
                                "target_lang_sense_clarification": "о тишине, хаосе, атмосфере"
                            },
                            {
                                "target_lang_word": "госпо́дствовать",
                                "target_lang_sense_clarification": "преобладать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笼罩",
                                "target_lang_sense_clarification": "指气氛或情绪弥漫"
                            },
                            {
                                "target_lang_word": "充斥",
                                "target_lang_sense_clarification": "指混乱或某种状态普遍存在"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "panować",
                                "target_lang_sense_clarification": "występować, pojawiać się (np. o nastroju)"
                            },
                            {
                                "target_lang_word": "królować",
                                "target_lang_sense_clarification": "zajmować dominującą pozycję"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09e9af4a-aacf-3b52-a8bf-c03a1b025c63",
                    "sense_definition": "To hold the title of winner or champion in a competition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to_win",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is the currently <w>reigning</w> world champion in women's tennis.",
                            "target_lang_translations": {
                                "ru": "Она является <w>действующей</w> чемпионкой мира по теннису среди женщин.",
                                "zh": "她是目前女子网球的<w>卫冕</w>世界冠军。",
                                "pl": "Jest obecnie <w>panującą</w> mistrzynią świata w tenisie kobiet."
                            }
                        },
                        {
                            "text": "The team has <w>reigned</w> at the top of the league for three consecutive years.",
                            "target_lang_translations": {
                                "ru": "Команда <w>царствовала</w> на вершине лиги три года подряд.",
                                "zh": "该队已连续三年<w>统治</w>联赛榜首。",
                                "pl": "Zespół <w>panował</w> na szczycie ligi przez trzy lata z rzędu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "reigning champion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать титул победителя или чемпиона в соревновании.",
                        "zh": "在比赛中保持冠军头衔。",
                        "pl": "Utrzymywać tytuł zwycięzcy lub mistrza w zawodach."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уде́рживать ти́тул",
                                "target_lang_sense_clarification": "оставаться чемпионом"
                            },
                            {
                                "target_lang_word": "домини́ровать",
                                "target_lang_sense_clarification": "быть лучшим в спорте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卫冕",
                                "target_lang_sense_clarification": "保持冠军地位"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bronić tytułu",
                                "target_lang_sense_clarification": "utrzymywać pozycję mistrza"
                            },
                            {
                                "target_lang_word": "dominować",
                                "target_lang_sense_clarification": "być najlepszym w rywalizacji"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5646479b-ddef-3f51-9caf-0c5c45b3c437",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My cousin named her newborn son <w>Reign</w>.",
                            "target_lang_translations": {
                                "ru": "Моя кузина назвала своего новорожденного сына <w>Рейн</w>.",
                                "zh": "我的表妹给她刚出生的儿子取名为<w>雷恩</w>。",
                                "pl": "Moja kuzynka nazwała swojego nowo narodzonego syna <w>Reign</w>."
                            }
                        },
                        {
                            "text": "<w>Reign</w> is becoming a more popular name in recent years.",
                            "target_lang_translations": {
                                "ru": "<w>Рейн</w> становится всё более популярным именем в последние годы.",
                                "zh": "<w>雷恩</w>这个名字近年来变得越来越流行。",
                                "pl": "<w>Reign</w> staje się w ostatnich latach coraz bardziej popularnym imieniem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя.",
                        "zh": "男性名字。",
                        "pl": "Męskie imię własne."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рейн",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷恩",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "Reign",
                                "target_lang_sense_clarification": "imię własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}