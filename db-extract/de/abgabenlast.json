                "senses": [
                    {
                        "sense_id": "a87bd2f5-9719-301a-82a8-10c9198cc608",
                        "entry_id": "c975ed47-87ac-3ad4-8d0b-e3ee4a283868",
                        "glosses": [
                            "Belastung durch die Notwendigkeit, Abgaben zu leisten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15588ac9-cbc6-4586-b799-974f18f1ca31",
                                "sense_id": "a87bd2f5-9719-301a-82a8-10c9198cc608",
                                "text": "„Im Frankenreich soll ein Reitpferd den Wert von sechs Kühen gehabt haben, im Delhi-Sultanat dagegen von dreißig Kühen. Das lässt erahnen, welche Abgabenlast die Bevölkerung in den Militärfeudalstaaten der Reiterkrieger zu tragen hatte.“"
                            },
                            {
                                "example_id": "ce68e894-c484-4b10-b95e-d6dacbed0e78",
                                "sense_id": "a87bd2f5-9719-301a-82a8-10c9198cc608",
                                "text": "„Diese eigentümliche Unterwerfungsform, die einen Menschen persönlich völlig unfrei und doch nicht ganz zum Sklaven machte, hatte sich wie die Abgabenlast seit Generationen ausgeweitet.“"
                            },
                            {
                                "example_id": "3d8bd8a7-86b2-410c-be8c-4a580a165f9f",
                                "sense_id": "a87bd2f5-9719-301a-82a8-10c9198cc608",
                                "text": "„Auf der einen Seite wirkten die Abgabenlast und die Abhängigkeit vom Wohlwollen der Gesandten des Oba sicher belastend, vor allem in ärmeren Gegenden und in Regionen am Rande des Reiches.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
