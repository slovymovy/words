                    "frequency": "High",
                    "semantic_group_id": "alter_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor is <w>altering</w> the jacket so it fits more comfortably.",
                            "target_lang_translations": {
                                "de": "Der Schneider <w>ändert</w> das Sakko <w>um</w>, damit es bequemer sitzt."
                            }
                        },
                        {
                            "text": "He succeeded in <w>altering</w> the original plan without causing any major delays.",
                            "target_lang_translations": {
                                "de": "Es gelang ihm, den ursprünglichen Plan <w>zu ändern</w>, ohne größere Verzögerungen zu verursachen."
                            }
                        }
                    ],
                    "synonyms": [
                        "changing",
                        "modifying"
                    ],
                    "antonyms": [
                        "preserving",
                        "maintaining"
                    ],
                    "common_phrases": [
