                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "440485a8-d1f5-36e8-a3b9-520c4662de16",
                                        "entry_id": "c6d40461-e2b2-3369-b322-e5ce72833573",
                                        "glosses": [
                                            "To estimate the amount of space required by the type used for the given copy."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f0ff82-b70c-449f-943e-393b0e09b57e",
                                                "sense_id": "440485a8-d1f5-36e8-a3b9-520c4662de16",
                                                "text": "To conserve type, copy was \"cast off\"; that is, type needed for the initial pages was estimated so that the pages need not be composed in the same sequence as the copy."
                                            }
                                        ]
                                    }
