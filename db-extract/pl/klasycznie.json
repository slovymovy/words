                        "entry_id": "e44213b7-0a93-3aac-ae0a-faac379abf9a",
                        "glosses": [
                            "w sposób, którego by się nie chciało"
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
