                                    {
                                        "sense_id": "34b85d0e-a0d0-3b88-a3d4-2104540f1e34",
                                        "entry_id": "6adb0891-bc7f-30fc-b94f-a0bd85b22371",
                                        "glosses": [
                                            "związany z solipsyzmem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16115128-9b07-49b0-a3e6-e32b2a83116d",
                                                "sense_id": "34b85d0e-a0d0-3b88-a3d4-2104540f1e34",
                                                "text": "Ci ludzie są znani nie ze swych poglądów, dokonań, a choćby błędów i porażek, ale z tego, że są znani – z codziennych występów na temat dowolny, a najchętniej solipsystyczny"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
