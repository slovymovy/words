                                    {
                                        "sense_id": "6f83dff7-87a8-37a6-a933-436605c35618",
                                        "entry_id": "e464dc01-54d4-36c7-a5a9-7990b74e4b33",
                                        "glosses": [
                                            "Hauptstadt von Iran"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d9ac70-f3e3-4cd2-971f-8359e6dc4560",
                                                "sense_id": "6f83dff7-87a8-37a6-a933-436605c35618",
                                                "text": "Los Angeles ist eine Partnerstadt Teherans."
                                            },
                                            {
                                                "example_id": "d42bf131-f1e6-4999-8d99-d61b483d9cc8",
                                                "sense_id": "6f83dff7-87a8-37a6-a933-436605c35618",
                                                "text": "„Wenige Tage später stieg ich in Köln-Bonn in eine Maschine von Iran Air und stieg fünf Stunden später am Flughafen in Teheran aus, einfach so, als gäbe es nichts Selbstverständlicheres auf der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faebef12-2c21-4b5a-8731-5c8a5cb53e50",
                        "source_entry_id": "77ed2797-4c4d-3627-9b87-ab847b4da006",
