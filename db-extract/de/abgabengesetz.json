                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1df90528-0337-4931-8cbd-afdaf7fc49d7",
                                "sense_id": "a364e09b-5b77-347f-9af3-e115dc94d92a",
                                "text": "„Das österreichische Abgabengesetz wiederum lüftet die Identität von Personen, die nach einem Grundstückserwerb Grundsteuer gezahlt haben, nicht.“"
                            },
                            {
                                "example_id": "f2113601-ec2d-4f3e-a0ed-0aa997c3ff41",
                                "sense_id": "a364e09b-5b77-347f-9af3-e115dc94d92a",
                                "text": "„Einige Gesetze schließt die rot-grüne Koalition schon von vornherein aus der Volksabstimmung aus, wie beispielsweise das Haushaltsgesetz, Abgabengesetze oder die Wiedereinführung der Todesstrafe.“"
                            }
                        ],
