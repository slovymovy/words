                        "entry_id": "428db9e9-af2b-36d7-95c9-bfe4dcccfdbc",
                        "glosses": [
                            "bezüglich Art und Weise oder Ausmaß so geartet, dass es ohne Beispiel ist"
                        ],
                        "tags": [
                            "nur nachgestellt bei Substantiven",
                            "zur emotionalen Verstärkung"
                        ],
                        "examples": [
                            {
                                "example_id": "99ac1ff8-d541-467e-a93f-e0fd86000d9e",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Dass ausgerechnet ich das Ferienhaus neben dem Feld bekommen habe, auf dem frische Gülle ausgefahren worden war, war eine Zumutung sondergleichen."
                            },
                            {
                                "example_id": "bd3ba3eb-147d-4ed1-9c4f-dd10a0ed2316",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Kyrill ist eine Leseratte sondergleichen."
                            },
                            {
                                "example_id": "dc79d6c4-e062-47c0-90b2-7ca50d18ca49",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Es ist eine Frechheit sondergleichen, dass die Enkel meiner Schwester sich bei ihren Besuchen immer lautstark lustig machen, wenn die Nachbarin die übergroßen Unterhosen ihres Mannes auf die Leine hängt."
                            },
                            {
                                "example_id": "acabe85d-ecf2-4f19-b5bc-fbddbcce526a",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Illonas Lispeln ist eine Belästigung sondergleichen."
                            },
                            {
                                "example_id": "bb78b213-f634-4c79-97b0-d999abb99bf2",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Sein Sieg bei einem Springturnier im Alter von 78 Jahren war für Igor ein Triumph sondergleichen."
                            },
                            {
                                "example_id": "f44e5b6e-a7e6-412e-bd8f-565e88f62446",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Der Theaterbesuch wurde wegen Opas Schwerhörigkeit zu einer Peinlichkeit sondergleichen: Er fragte uns ständig für die anderen Zuschauer unüberhörbar, was auf der Bühne gerade gesprochen wurde."
                            },
                            {
                                "example_id": "77a82711-e88b-45cc-8b0b-542bb644f4d9",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Mit seiner mobilen Garküche gelang Waldemar ein Erfolg sondergleichen."
                            },
                            {
                                "example_id": "83b228d5-e258-460e-9681-b01e9c054c30",
                                "sense_id": "ba7ca626-f7f7-399d-8807-c392ac81b158",
                                "text": "Dieses Utensil zur Entfernung von Hornhaut entwickelte sich in den letzten Jahren zu einem Verkaufsschlager sondergleichen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
