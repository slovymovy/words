                                                "sense_id": "52243e06-e299-371d-a63d-96e330fe7d4c",
                                                "text": "Fernando Vallejo ist ein berühmter Schriftsteller."
                                            },
                                            {
                                                "example_id": "927948e0-517f-47b5-8b09-ebcb8b238b12",
                                                "sense_id": "52243e06-e299-371d-a63d-96e330fe7d4c",
