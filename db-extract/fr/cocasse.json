                                    },
                                    {
                                        "sense_id": "a667f760-2de7-35a7-b628-3d8f8a86f378",
                                        "entry_id": "4b159c29-5087-364c-9a08-1f6144e1eff1",
                                        "glosses": [
                                            "Se dice de algo inesperada o asombrosamente grande."
