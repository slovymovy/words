                        "examples": [
                            {
                                "example_id": "d8ba9a0d-5654-40b3-9036-8bbcff1c6f2e",
                                "sense_id": "8e78427b-6b51-35d5-8654-91656a16056c",
                                "text": "„Die dann verschossenen Bolzen erreichen Anfangsgeschwindigkeiten von rund 150 m/s, weisen aber ein äußerst unstabiles Flugverhalten auf.“"
                            },
                            {
                                "example_id": "cda7dade-8fa0-431b-a624-81effc4761e2",
                                "sense_id": "8e78427b-6b51-35d5-8654-91656a16056c",
                                "text": "„Diese große Anfangsgeschwindigkeit ermöglicht dem Flugfisch ein Gleiten mit den großen Tragflächen der gespreizten Seitenflossen in Form eines passiven Drachenfluges.“"
                            }
                        ],
