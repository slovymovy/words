                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque employé est libre de rejoindre le <w>syndicat</w> de son choix dans l'entreprise."
                        },
                        {
                            "text": "Un représentant du <w>syndicat</w> négocie une hausse générale des salaires avec la direction."
                        }
                    ],
                    "common_phrases": [
