{
    "word_family": [
        "disciplinary",
        "disciplinarian",
        "interdisciplinary",
        "multidisciplinary",
        "undisciplined"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9e129217-4275-32cc-9536-bb55d9776b77",
                    "sense_definition": "The ability to control one's own behaviour and feelings, often to achieve a goal.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "control_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It takes a lot of <w>discipline</w> to study for three hours every single day.",
                            "target_lang_translations": {
                                "ru": "Требуется огромная <w>дисциплина</w>, чтобы учиться по три часа каждый день.",
                                "zh": "每天坚持学习三个小时需要极强的<w>自律</w>。"
                            }
                        },
                        {
                            "text": "Martial arts teach children respect and self-<w>discipline</w> from a young age.",
                            "target_lang_translations": {
                                "ru": "Боевые искусства с ранних лет учат детей уважению и <w>самодисциплине</w>.",
                                "zh": "武术从小就教导孩子们尊重他人和<w>自律</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "spontaneity"
                    ],
                    "common_phrases": [
                        "self-discipline",
                        "mental discipline",
                        "lack of discipline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность контролировать свое поведение и чувства, часто для достижения цели.",
                        "zh": "指控制自身行为和情绪的能力，通常是为了实现某个目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплина",
                                "target_lang_sense_clarification": "самоконтроль"
                            },
                            {
                                "target_lang_word": "дисциплинированность",
                                "target_lang_sense_clarification": "черта характера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自律",
                                "target_lang_sense_clarification": "自我约束的能力"
                            },
                            {
                                "target_lang_word": "纪律性",
                                "target_lang_sense_clarification": "个人性格特征"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ae64cc0-5575-39e0-a357-b1607ac8632f",
                    "sense_definition": "A specific branch of knowledge, learning, or practice, especially in higher education.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "knowledge_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sociology is a distinct academic <w>discipline</w> with its own research methods.",
                            "target_lang_translations": {
                                "ru": "Социология — это отдельная академическая <w>дисциплина</w> со своими методами исследования.",
                                "zh": "社会学是一门拥有独特研究方法的独立学术<w>学科</w>。"
                            }
                        },
                        {
                            "text": "The conference brought together experts from various scientific <w>disciplines</w>.",
                            "target_lang_translations": {
                                "ru": "Конференция собрала экспертов из различных научных <w>дисциплин</w>.",
                                "zh": "这次会议汇集了来自不同科学<w>学科</w>的专家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "field",
                        "sphere"
                    ],
                    "common_phrases": [
                        "academic discipline",
                        "scientific discipline"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная отрасль знаний, науки или практики, особенно в высшем образовании.",
                        "zh": "特定的知识、学习或实践领域，尤指在高等教育中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплина",
                                "target_lang_sense_clarification": "научная"
                            },
                            {
                                "target_lang_word": "предмет",
                                "target_lang_sense_clarification": "учебный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "学科",
                                "target_lang_sense_clarification": "学术研究领域"
                            },
                            {
                                "target_lang_word": "专业",
                                "target_lang_sense_clarification": "学习或研究的专门领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcd810c2-6ea9-3a98-9d90-e263624eb8aa",
                    "sense_definition": "A state of order and obedience resulting from training or rules.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher struggled to maintain <w>discipline</w> in the noisy classroom.",
                            "target_lang_translations": {
                                "ru": "Учитель с трудом поддерживал <w>дисциплину</w> в шумном классе.",
                                "zh": "老师在嘈杂的教室里努力维持<w>纪律</w>。"
                            }
                        },
                        {
                            "text": "Military <w>discipline</w> is strict and requires absolute obedience to officers.",
                            "target_lang_translations": {
                                "ru": "Воинская <w>дисциплина</w> строга и требует абсолютного подчинения офицерам.",
                                "zh": "军队<w>纪律</w>严明，要求绝对服从长官。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "strict discipline",
                        "maintain discipline",
                        "military discipline",
                        "enforce discipline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние порядка и повиновения, являющееся результатом обучения или правил.",
                        "zh": "因训练或规则而产生的秩序和服从状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплина",
                                "target_lang_sense_clarification": "повиновение"
                            },
                            {
                                "target_lang_word": "порядок",
                                "target_lang_sense_clarification": "организованность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纪律",
                                "target_lang_sense_clarification": "行为准则与服从"
                            },
                            {
                                "target_lang_word": "秩序",
                                "target_lang_sense_clarification": "组织良好的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84f63cae-21f8-3879-8e9e-ab82c0cf8b34",
                    "sense_definition": "A punishment imposed to correct behaviour or maintain control.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school uses detention as a form of <w>discipline</w> for minor offenses.",
                            "target_lang_translations": {
                                "ru": "Школа использует оставление после уроков как форму <w>наказания</w> за мелкие проступки.",
                                "zh": "学校将留校察看作为对轻微违规行为的一种<w>惩戒</w>。"
                            }
                        },
                        {
                            "text": "Harsh <w>discipline</w> can sometimes have a negative effect on a child's development.",
                            "target_lang_translations": {
                                "ru": "Суровые <w>наказания</w> иногда могут негативно сказаться на развитии ребенка.",
                                "zh": "严厉的<w>惩戒</w>有时会对孩子的成长产生负面影响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "penalty",
                        "sanction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказание, применяемое для исправления поведения или поддержания контроля.",
                        "zh": "为纠正行为或维持控制而实施的惩罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "карательная мера"
                            },
                            {
                                "target_lang_word": "взыскание",
                                "target_lang_sense_clarification": "официальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惩戒",
                                "target_lang_sense_clarification": "正式的惩罚措施"
                            },
                            {
                                "target_lang_word": "处分",
                                "target_lang_sense_clarification": "针对违规的处罚"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3120e9a9-5ebf-3a7b-8106-961399369358",
                    "sense_definition": "To train someone to obey rules or a code of behaviour.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents must <w>discipline</w> their children when they misbehave to teach them right from wrong.",
                            "target_lang_translations": {
                                "ru": "Родители должны <w>дисциплинировать</w> своих детей, когда те плохо себя ведут, чтобы научить их отличать хорошее от плохого.",
                                "zh": "当孩子表现不好时，父母必须对其进行<w>管教</w>，以教导他们明辨是非。"
                            }
                        },
                        {
                            "text": "He <w>disciplined</w> himself to wake up early every morning to exercise.",
                            "target_lang_translations": {
                                "ru": "Он <w>приучил</w> себя вставать рано каждое утро для зарядки.",
                                "zh": "他<w>训练</w>自己每天早起锻炼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drill"
                    ],
                    "common_phrases": [
                        "discipline yourself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обучать кого-либо соблюдению правил или норм поведения.",
                        "zh": "训练某人遵守规则或行为准则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисциплинировать",
                                "target_lang_sense_clarification": "приучать к порядку"
                            },
                            {
                                "target_lang_word": "тренировать",
                                "target_lang_sense_clarification": "развивать навыки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "训练",
                                "target_lang_sense_clarification": "培养习惯或技能"
                            },
                            {
                                "target_lang_word": "管教",
                                "target_lang_sense_clarification": "教导遵守规矩"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "007dd183-1fdd-31e8-9124-710a32e204d5",
                    "sense_definition": "To punish someone for an offense or bad behaviour.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The employee was <w>disciplined</w> for repeatedly arriving late to work.",
                            "target_lang_translations": {
                                "ru": "Сотрудник был <w>наказан</w> за систематические опоздания на работу.",
                                "zh": "该员工因多次上班迟到而受到了<w>处分</w>。"
                            }
                        },
                        {
                            "text": "The committee has the power to <w>discipline</w> members who break the association's rules.",
                            "target_lang_translations": {
                                "ru": "Комитет имеет право <w>наказывать</w> членов, нарушающих правила ассоциации.",
                                "zh": "委员会拥有对违反协会规则的成员进行<w>惩罚</w>的权力。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказывать кого-либо за проступок или плохое поведение.",
                        "zh": "因某人的过错或不良行为而对其进行惩罚。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказывать",
                                "target_lang_sense_clarification": "применять санкции"
                            },
                            {
                                "target_lang_word": "подвергать взысканию",
                                "target_lang_sense_clarification": "официально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惩罚",
                                "target_lang_sense_clarification": "对违规行为的制裁"
                            },
                            {
                                "target_lang_word": "处分",
                                "target_lang_sense_clarification": "正式的行政或组织处罚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}