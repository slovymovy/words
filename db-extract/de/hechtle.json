                "senses": [
                    {
                        "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                        "entry_id": "af820d5a-0cff-363b-b284-c28cae70ced0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e6b335b-0e6c-402f-bb39-750f1ea1af9a",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Frau Hechtle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a6819d3-b4c7-44a3-9417-a0b0d299e04a",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Herr Hechtle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "89ba9d97-14b9-4e88-a6fd-6a76c1365b35",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Die Hechtles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "22de76c7-7d9f-4153-8846-89e1f15924f9",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Der Hechtle trägt nie die Pullover, die die Hechtle ihm strickt."
                            },
                            {
                                "example_id": "78375351-c921-40d5-822c-0fd5fb2f8a0e",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hechtle kommt, geht der Herr Hechtle.“"
                            },
                            {
                                "example_id": "38495dc8-880b-4d25-9281-dd9a3f18599d",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Hechtle kommt und geht."
                            },
                            {
                                "example_id": "d4cdd6d6-e855-4f6c-844f-83693515f6b3",
                                "sense_id": "22d8851c-5d6f-3fbc-b84f-ce8b645a660d",
                                "text": "Hechtles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
