                "senses": [
                    {
                        "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                        "entry_id": "5ae8a530-b264-3f1f-8bac-050b2e2f6df0",
                        "glosses": [
                            "Grief; sorrow; trouble."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "670457d9-a972-4508-8b76-4a699a9b1a34",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "In which the birds song many a lovely lay / Of Gods high praise, and of their loves sweet teene, / As it an earthly Paradize had beene […]"
                            },
                            {
                                "example_id": "a9dd0991-3a7a-475c-8848-ef7697fd5ba6",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "The Soldan changed hue for grief and teen, / On that sad book his shame and loss he lear'd."
                            },
                            {
                                "example_id": "c7fe7b37-3cfd-4a5e-ab56-1ae83a2de12e",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "Miranda: O my heart bleedes / To thinke oth' teene that I haue turn'd you to, / Which is from my remembrance,[…]"
                            },
                            {
                                "example_id": "a75591e8-4915-464c-9949-37bc0b583812",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "Your soul forgot her joys, forgot / Her times of teen; / Yea, this life likewise will you not / Forget"
                            },
                            {
                                "example_id": "72bbc8d5-e4ee-4fc1-bda5-a66144956ddc",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "With public toil and private teen Thou sank'st alone."
                            },
                            {
                                "example_id": "f7ff6d84-aef5-440b-ac3a-aa56f60f62d4",
                                "sense_id": "e8a3de5c-9330-34ee-8a50-01146400e66c",
                                "text": "That City's sombre Patroness and Queen, / In bronze sublimity she gazes forth / Over her Capital of teen and threne"
                            }
                        ]
                    },
                    {
                        "sense_id": "2bd8136a-c7b5-3298-be2c-ebf364a4f827",
                        "entry_id": "5ae8a530-b264-3f1f-8bac-050b2e2f6df0",
                        "glosses": [
                            "Vexation; anger; hate."
