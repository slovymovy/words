                "translations": [
                    {
                        "translation_id": "1cf34865-d4cb-470e-a67a-527c61c6530f",
                        "source_entry_id": "4ead399e-dc11-3e74-b396-7344fd17196b",
                        "source_sense_id": "4e11e23e-bf14-3367-bdc3-745307eb2819",
                        "source_sense_description": "de geschiedenis van de talen",
                        "target_lang_word": "Sprachgeschichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprachgeschichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                        "entry_id": "1f243f4f-01db-38c4-8f43-28407b6fa04d",
                                        "glosses": [
                                            "Geschichte (Entwicklung) einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25b274da-bf63-4e11-8df7-b83b62ea633c",
                                                "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                                "text": "Die Sprachgeschichte des Deutschen verlief vom Althochdeutschen über das Mittelhochdeutsche, Frühneuhochdeutsche bis zum gegenwärtigen Neuhochdeutschen."
                                            },
                                            {
                                                "example_id": "849682ad-92bb-49a2-a03c-355928104f59",
                                                "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                                "text": "„Althochdeutsch heißt somit…erst langsames Zusammenwachsen verschiedener Mundarten einer sehr schallvollen, vokalreichen Sprache in einer durch die politische Vormachtstellung der Franken bestimmten Umwelt, einer Vormachtstellung übrigens, die für die Sprachgeschichte des frühen Deutschen seit merowingischer Zeit bedeutsam wird…“"
                                            },
                                            {
                                                "example_id": "9295b85a-dfee-4737-915d-b358aca2d17f",
                                                "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                                "text": "„Der Begriff der Sprachgeschichte ist ein weiterer, er bezieht alle äußeren Faktoren des Lebens einer Sprache mit ein, z. B. das Schicksal der sprachtragenden Völker, die territoriale Ausdehnung einer Sprache zu verschiedenen Zeiten, den Geltungsbereich von Sprachen, Vorgänge der Verschriftung und Normierung, Konkurrenz von Sprachen u. a. m.“"
                                            },
                                            {
                                                "example_id": "7e59eb7d-b808-4895-a0fd-c987117ecb44",
                                                "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                                "text": "„Wir sind gespannt, was Sprachhistoriker in 100 Jahren über diesen hochmoralischen Abschnitt deutscher Sprachgeschichte schreiben werden.“"
                                            },
                                            {
                                                "example_id": "9684c76f-ec53-4074-abab-640fff9989c8",
                                                "sense_id": "a89fa5e0-a464-3928-837e-934e0a0cda67",
                                                "text": "„Nach 1800 beginnt die letzte Phase der englischen Sprachgeschichte, sie dauert bis heute an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2201ddcc-3932-3885-b05f-18dc7b26bad0",
                                        "entry_id": "1f243f4f-01db-38c4-8f43-28407b6fa04d",
                                        "glosses": [
                                            "linguistische Disziplin, die sich mit der Geschichte von Sprachen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f51f98f-2c43-4349-aea5-e50da702d0d9",
                                                "sense_id": "2201ddcc-3932-3885-b05f-18dc7b26bad0",
                                                "text": "Die Sprachgeschichte erforscht die Geschichte beliebiger Sprachen."
                                            },
                                            {
                                                "example_id": "c1df180b-a06a-4627-8100-55d53ea5d0e6",
                                                "sense_id": "2201ddcc-3932-3885-b05f-18dc7b26bad0",
                                                "text": "„Sprachgeschichte (…) Zweig der Allgemeinen Sprachwissenschaft und jeder Einzelphilologie, der sich mit der inneren und äußeren Geschichte von Sprache(n) befaßt.“"
                                            },
                                            {
                                                "example_id": "cf3c37ee-08bd-425b-94cd-a96e2e7f5964",
                                                "sense_id": "2201ddcc-3932-3885-b05f-18dc7b26bad0",
                                                "text": "„Erforschte die Vergleichung, welche Abweichungen voneinander die einzelnen verwandten Sprachen aufwiesen, so zeigte die Sprachgeschichte den Weg, auf dem es zu diesen Abweichungen gekommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2fd8f162-aa07-38a0-9fa4-283dc5e1bb73",
                                        "entry_id": "1f243f4f-01db-38c4-8f43-28407b6fa04d",
                                        "glosses": [
                                            "ein Buch über Sprachgeschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037e7f8f-b060-419f-8e9c-74b29eb1e1dd",
                                                "sense_id": "2fd8f162-aa07-38a0-9fa4-283dc5e1bb73",
                                                "text": "Es gibt eine ganze Reihe von Sprachgeschichten des Deutschen; die umfangreichste „Deutsche Sprachgeschichte“ hat Peter von Polenz vorgelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
