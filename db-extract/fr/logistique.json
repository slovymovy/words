                            }
                        ]
                    },
                    {
                        "sense_id": "689617f0-4829-3307-9fc2-6cece57fdbf5",
                        "entry_id": "9d997f1d-cdad-37cb-ab57-7921a268e9cf",
                        "glosses": [
                            "Ensemble des moyens et méthodes de transport, de manutention ou de ravitaillement.",
                            "Ensemble des opérations humaines et matérielles qui permettent aux armées de fonctionner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66e446e-31bc-4eef-ba81-27a57a79c47a",
                                "sense_id": "689617f0-4829-3307-9fc2-6cece57fdbf5",
                                "text": "Le combat n’est pas tout, le soutien logistique est essentiel à une armée pour qu’elle puisse vaincre."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9d6980c-2123-3e2a-bb4b-6f5fe8411c2f",
