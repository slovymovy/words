                "senses": [
                    {
                        "sense_id": "602376ab-e882-3c6c-b511-78bd228815cf",
                        "entry_id": "472f357f-299f-37ab-bf7a-1c424d6f46ab",
                        "glosses": [
                            "мужское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fd8b4d-f4f6-43cc-89d2-6a8ff0d42052",
                                "sense_id": "602376ab-e882-3c6c-b511-78bd228815cf",
                                "text": "На звонок тотчас же вошёл старый друг, камердинер Матвей, неся платье, сапоги и телеграмму."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c27efb2e-8ded-4d24-aae9-d9a3730f23be",
                        "source_entry_id": "472f357f-299f-37ab-bf7a-1c424d6f46ab",
                        "source_sense_id": "602376ab-e882-3c6c-b511-78bd228815cf",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Matthias",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matthias",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3aed6f7c-7654-3597-b3c3-fb8a2adaeb75",
                                        "entry_id": "35c3e46b-0604-3e0d-8809-341bd4573a7d",
                                        "glosses": [
                                            "The Apostle chosen to replace Judas Iscariot. (biblical character)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b09d2fb7-b3b0-3e31-8be4-2e4db01f044e",
                                        "entry_id": "35c3e46b-0604-3e0d-8809-341bd4573a7d",
                                        "glosses": [
                                            "A male given name from Hebrew, derived from the same source as Matthew."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdc99436-8056-49fa-be27-f789b42d1a7c",
                        "source_entry_id": "472f357f-299f-37ab-bf7a-1c424d6f46ab",
                        "source_sense_id": "602376ab-e882-3c6c-b511-78bd228815cf",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Matthew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Matthew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29c5c90f-082f-3aaa-bbf4-511b42db0e2f",
                                        "entry_id": "3b4de65a-33b8-3239-a515-7a98bade0e73",
                                        "glosses": [
                                            "A male given name from Hebrew of biblical origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29f2c07c-e2fc-43ba-860a-6e861f2e0332",
                                                "sense_id": "29c5c90f-082f-3aaa-bbf4-511b42db0e2f",
                                                "text": "- - - My name is Matthew Bramble, at your service. The truth is, I have a foolish pique at the name of Matthew, because it savours of those canting hypocrites, who in Cromwell's time, christened all their children by names taken from the Scripture.\""
                                            },
                                            {
                                                "example_id": "e52dfd94-7964-4dc0-b62c-b6ab2859214f",
                                                "sense_id": "29c5c90f-082f-3aaa-bbf4-511b42db0e2f",
                                                "text": "People with incorruptible names like Matthew are always calling people named Charles, Charlie. I wish my folks had named me Matthew. Matt is the worst that can be made of it."
                                            },
                                            {
                                                "example_id": "5e798759-fc13-4c83-afd1-d8fdf187469b",
                                                "sense_id": "29c5c90f-082f-3aaa-bbf4-511b42db0e2f",
                                                "text": "The men, 37-year-old Matthew Allison and 34-year-old Dallas Humber, are the leaders of an online White supremacist group called the Terrorgram Collective, prosecutors say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f65805e-db7d-3096-ac2b-b5f21b100e3b",
                                        "entry_id": "3b4de65a-33b8-3239-a515-7a98bade0e73",
                                        "glosses": [
                                            "A surname originating as a patronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88e7a809-5d6d-370d-ab81-fedd8b338c6e",
                                        "entry_id": "3b4de65a-33b8-3239-a515-7a98bade0e73",
                                        "glosses": [
                                            "Matthew the Evangelist, one of the twelve Apostles. A publican or tax-collector at Capernaum and credited with the authorship of the Gospel of Matthew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b1d2bed-ea00-4cfb-843e-f68b049b743c",
                                                "sense_id": "88e7a809-5d6d-370d-ab81-fedd8b338c6e",
                                                "text": "And as Jesus passed forth from thence, he saw a man, named Matthew, sitting at the receipt of custom: and he saith unto him, Follow me. And he arose, and followed him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70d8d58f-7dfa-3588-b81c-d0eec828bb14",
                                        "entry_id": "3b4de65a-33b8-3239-a515-7a98bade0e73",
                                        "glosses": [
                                            "The Gospel of St. Matthew, the first book of the New Testament of the Bible. Traditionally the first of the four gospels, a book attributed to Matthew the Evangelist."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
