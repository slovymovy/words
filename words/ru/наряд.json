{
    "word_family": [
        "наряжать",
        "нарядиться",
        "нарядный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f77a3550-6e4d-3716-ad0b-1d0d075b5556",
                    "sense_definition": "Красивая, праздничная или официальная одежда.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На праздник она выбрала свой самый красивый <w>наряд</w>.",
                            "target_lang_translations": {
                                "de": "Für das Fest wählte sie ihr schönstes <w>Outfit</w> aus."
                            }
                        },
                        {
                            "text": "Девушка долго выбирала праздничный <w>наряд</w> для вечеринки.",
                            "target_lang_translations": {
                                "de": "Das Mädchen suchte lange nach einem festlichen <w>Outfit</w> für die Party."
                            }
                        }
                    ],
                    "synonyms": [
                        "вид"
                    ],
                    "common_phrases": [
                        "праздничный наряд"
                    ],
                    "target_lang_definitions": {
                        "de": "Schöne, festliche oder formelle Kleidung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Outfit",
                                "target_lang_sense_clarification": "allgemein für ein zusammengestelltes Kleidungsset"
                            },
                            {
                                "target_lang_word": "Festtagskleidung",
                                "target_lang_sense_clarification": "speziell für festliche Anlässe"
                            },
                            {
                                "target_lang_word": "Aufmachung",
                                "target_lang_sense_clarification": "eher umgangssprachlich für ein auffälliges Outfit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d092778e-2e16-321e-b0c4-083f3264aec5",
                    "sense_definition": "Внешний вид, убранство или украшение чего-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "одежда",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весенний лес надел свой праздничный <w>наряд</w> из молодой листвы.",
                            "target_lang_translations": {
                                "de": "Der Frühlingswald legte sein festliches <w>Gewand</w> aus jungem Laub an."
                            }
                        },
                        {
                            "text": "Город преобразился, сменив зимний <w>наряд</w> на яркие летние цветы.",
                            "target_lang_translations": {
                                "de": "Die Stadt verwandelte sich und tauschte ihr winterliches <w>Gewand</w> gegen bunte Sommerblumen."
                            }
                        }
                    ],
                    "synonyms": [
                        "вид"
                    ],
                    "target_lang_definitions": {
                        "de": "Das äußere Erscheinungsbild, die Ausstattung oder Dekoration von etwas."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gewand",
                                "target_lang_sense_clarification": "gehoben, oft metaphorisch für Natur oder Gebäude"
                            },
                            {
                                "target_lang_word": "Schmuck",
                                "target_lang_sense_clarification": "im Sinne von Verzierung oder Dekoration"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31759f3f-0dc6-3f16-8748-78b1aeab9dee",
                    "sense_definition": "Задание или работа, выполняемая военнослужащими.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "задание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдат отправили в <w>наряд</w> по столовой.",
                            "target_lang_translations": {
                                "de": "Die Soldaten wurden zum <w>Küchendienst</w> eingeteilt."
                            }
                        },
                        {
                            "text": "Сегодня у него тяжелый <w>наряд</w> на кухне.",
                            "target_lang_translations": {
                                "de": "Heute hat er einen schweren <w>Dienst</w> in der Küche."
                            }
                        }
                    ],
                    "common_phrases": [
                        "наряд по столовой"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine militärische Dienstaufgabe oder ein Arbeitseinsatz."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Dienst",
                                "target_lang_sense_clarification": "allgemeiner militärischer Dienst oder Wache"
                            },
                            {
                                "target_lang_word": "Arbeitseinsatz",
                                "target_lang_sense_clarification": "spezifische Arbeitsaufgabe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01227456-eca0-3349-8ad9-13bcbde64d95",
                    "sense_definition": "Группа военнослужащих, выполняющая специальные обязанности.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "задание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Военный <w>наряд</w> патрулировал улицы города.",
                            "target_lang_translations": {
                                "de": "Eine militärische <w>Patrouille</w> patrouillierte durch die Straßen der Stadt."
                            }
                        },
                        {
                            "text": "На входе в часть стоял <w>наряд</w> из двух человек.",
                            "target_lang_translations": {
                                "de": "Am Eingang der Kaserne stand eine <w>Wachmannschaft</w> aus zwei Personen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Gruppe von Militärangehörigen, die spezielle Aufgaben ausführt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Patrouille",
                                "target_lang_sense_clarification": "militärische oder polizeiliche Streife"
                            },
                            {
                                "target_lang_word": "Wachmannschaft",
                                "target_lang_sense_clarification": "Gruppe, die für die Bewachung zuständig ist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0be78aea-5fce-3842-a283-ee4843cb6315",
                    "sense_definition": "Распоряжение или приказ о выполнении работы.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "задание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мастер выдал <w>наряд</w> на выполнение ремонтных работ.",
                            "target_lang_translations": {
                                "de": "Der Meister stellte einen <w>Arbeitsauftrag</w> für die Reparaturarbeiten aus."
                            }
                        },
                        {
                            "text": "Рабочие получили письменный <w>наряд</w> на сегодня.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter erhielten einen schriftlichen <w>Arbeitsauftrag</w> für heute."
                            }
                        }
                    ],
                    "synonyms": [
                        "приказ"
                    ],
                    "common_phrases": [
                        "письменный наряд"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Anweisung oder ein Befehl zur Ausführung einer Arbeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Arbeitsauftrag",
                                "target_lang_sense_clarification": "formelle Anweisung für eine Arbeit"
                            },
                            {
                                "target_lang_word": "Befehl",
                                "target_lang_sense_clarification": "im militärischen oder strengen Kontext"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8d04dc9-175c-31a8-aa38-4de3c7ea50a5",
                    "sense_definition": "Документ для учета выполненной работы или получения товаров.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "задание",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Бухгалтерия требует закрыть <w>наряд</w> до конца месяца.",
                            "target_lang_translations": {
                                "de": "Die Buchhaltung verlangt, den <w>Arbeitsschein</w> bis Ende des Monats abzuschließen."
                            }
                        },
                        {
                            "text": "Для получения материалов на складе нужен <w>наряд</w>.",
                            "target_lang_translations": {
                                "de": "Um Materialien aus dem Lager zu erhalten, benötigt man einen <w>Materialschein</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Dokument zur Abrechnung von Arbeit oder zur Materialanforderung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Arbeitsschein",
                                "target_lang_sense_clarification": "Dokument zur Erfassung geleisteter Arbeit"
                            },
                            {
                                "target_lang_word": "Materialschein",
                                "target_lang_sense_clarification": "Dokument zur Anforderung von Waren"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}