                    {
                        "sense_id": "40b643c1-0b65-3e50-b450-b2d171665761",
                        "entry_id": "4d0fc7bd-34dc-355b-8e85-eeb9c58b721d",
                        "glosses": [
                            "Itinéraire cyclable de moyenne ou longue distance, continu, jalonné et sécurisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d9af7b-ed6e-4526-97d2-7164a765da11",
                                "sense_id": "40b643c1-0b65-3e50-b450-b2d171665761",
                                "text": "La Loire à vélo est ainsi aujourd'hui un itinéraire jalonné dans les deux sens […] ; la véloroute s'étend de Saint-Brevin-les-Pins, au bord de l'Atlantique, jusqu'à Cuffy, dans le Cher (peu avant Nevers), […]."
                            },
                            {
                                "example_id": "cfbefa80-1bb7-4920-b3f0-6ae4a5246508",
                                "sense_id": "40b643c1-0b65-3e50-b450-b2d171665761",
                                "text": "Bienvenue sur la véloroute de la Vallée du Lot d'Aiguillon à Cahors"
                            },
                            {
                                "example_id": "7a4dc1ce-0bce-4f75-8404-25a2ce2e75ac",
                                "sense_id": "40b643c1-0b65-3e50-b450-b2d171665761",
                                "text": "Une véloroute emprunte plusieurs types de voies : des petites routes à faible circulation et, autant que possible, des pistes cyclables et des voies vertes."
                            }
                        ]
                    }
