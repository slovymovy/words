                "senses": [
                    {
                        "sense_id": "d2038adb-7d52-3882-890b-aaa22875e458",
                        "entry_id": "ec73425b-1796-3599-849b-3525b53b6f0c",
                        "glosses": [
                            "höchster Wert, der innerhalb eines Jahres erreicht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6ca368-53fb-4cc8-bac3-5f348f1040dd",
                                "sense_id": "d2038adb-7d52-3882-890b-aaa22875e458",
                                "text": "„In den vergangenen Monaten hatten die Titel sukzessive zugelegt; das Jahrestief betrug 15,58 Euro, das Jahreshöchst im April 21,26 Euro.“"
                            },
                            {
                                "example_id": "97ae8f9b-30f7-4725-abdf-0ee9bd2ae675",
                                "sense_id": "d2038adb-7d52-3882-890b-aaa22875e458",
                                "text": "„Am Vorabend der Veröffentlichung des Jahresabschlusses per 31. Juli schloss der Kurs auf dem Jahreshöchst von 200 Pence, 3 Pence höher als am letzten Handelstag (Freitag) und knapp 20 Prozent teurer als drei Wochen zuvor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
