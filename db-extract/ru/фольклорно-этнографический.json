                "senses": [
                    {
                        "sense_id": "e90b534e-568e-31cd-ba59-b3f75b51495d",
                        "entry_id": "328134d2-824e-38a0-ad23-b103d4b23277",
                        "glosses": [
                            "отражающий устное народное творчество и культурно-исторические особенности народа, народности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b56b4d-c42c-4924-b4de-8ba2546e37a1",
                                "sense_id": "e90b534e-568e-31cd-ba59-b3f75b51495d",
                                "text": "Наряду с известными деятелями культуры, такими как Валентина Михель и Заслуженный работник культуры России Александр Михель из Алтайского края, Артур Иордан из Омской области, фольклорно-этнографический ансамбль «Астраханская песня», возглавляемый Еленой Шишкиной-Фишер, семейный ансамбль аккордеонистов под руководством Пауля Альтнера из города Оренбурга, ансамбли из Омской, Саратовской областей, Алтайского края, москвичи и гости столицы познакомились с недавно созданными коллективами."
                            }
                        ]
                    }
