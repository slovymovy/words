                                    {
                                        "sense_id": "35bebb74-c1b9-3ced-a730-1c0f306c65c2",
                                        "entry_id": "f41e9f9f-74aa-31fb-a9ab-5d27185330ec",
                                        "glosses": [
                                            "in het begin, oorspronkelijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f84085-f128-41ac-b7bd-0b34fb202dfa",
                                                "sense_id": "35bebb74-c1b9-3ced-a730-1c0f306c65c2",
                                                "text": "Aanvankelijk was de aarde woest en ledig."
                                            },
                                            {
                                                "example_id": "061895fe-bbe9-4779-9c06-48857e44b56b",
                                                "sense_id": "35bebb74-c1b9-3ced-a730-1c0f306c65c2",
                                                "text": "Hoewel ze aanvankelijk vaak ruzie maakten zijn ze nu toch de beste vrienden."
                                            },
                                            {
                                                "example_id": "6e4cb864-e197-4696-96af-60ceded9d975",
                                                "sense_id": "35bebb74-c1b9-3ced-a730-1c0f306c65c2",
                                                "text": "‘Ik heb begrip voor de maatregelen van de overheid. Misschien hadden die wat eerder genomen moeten worden, we hebben het in Nederland misschien aanvankelijk een beetje onderschat."
                                            },
                                            {
                                                "example_id": "c79d7229-2c0c-4818-b9d9-b3868c2296a4",
                                                "sense_id": "35bebb74-c1b9-3ced-a730-1c0f306c65c2",
                                                "text": "Oftewel de manier waarop Dorien tegen de situatie aan keek. Omdat Chantal nu niet bepaald openstond voor een andere visie, liep het gesprek aanvankelijk stroef."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aanvankelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
