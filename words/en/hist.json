                {
                    "sense_id": "55b0fe44-eb7f-3ee0-a9e1-918b4c08b6d1",
                    "sense_definition": "A command to be quiet or to listen carefully to something.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "silence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hist</w> child, if the guards hear us, they will surely throw us into the dungeon.",
                            "target_lang_translations": {
