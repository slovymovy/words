                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f16dcdf-4ceb-40b9-8607-06ca9e5d5d8b",
                                                "sense_id": "cfcbe163-fad3-3a3c-b87f-6c1e0299ee70",
                                                "text": "According to market research, many men list DIY as one of their main hobbies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "DIY",
                                "target_lang_code": "en",
