                                    {
                                        "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                        "entry_id": "02ccb870-0b9a-3a91-b31c-09bc05151fed",
                                        "glosses": [
                                            "Unsteady, random; prone to unexpected changes; not consistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0939f58e-e2cc-400d-bf01-4561a6cd6d26",
                                                "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                                "text": "Henry has been getting erratic scores on his tests: 40% last week, but 98% this week."
                                            },
                                            {
                                                "example_id": "319dbae5-e13d-41ec-a0a6-43b0d397f1d8",
                                                "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                                "text": "The V-2's directional system was notoriously erratic. In May 1947, a V-2 launched from White Sands Proving Ground headed south instead of north, missing downtown Juarez, Mexico, by 3 miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e712705-6764-39b3-b0b1-8a4e436d810c",
                                        "entry_id": "02ccb870-0b9a-3a91-b31c-09bc05151fed",
                                        "glosses": [
                                            "Deviating from normal opinions or actions; eccentric; odd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2064979-5bb1-4765-a5a7-0635da25c8f7",
                                                "sense_id": "0e712705-6764-39b3-b0b1-8a4e436d810c",
                                                "text": "erratic conduct"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "erratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                        "entry_id": "7fa35eac-a56a-3a2a-b99c-0c568dbf2bdf",
                                        "glosses": [
                                            "A rock moved from one location to another, usually by a glacier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504cdee8-2b51-4567-8c67-f43efa4e6dfd",
                                                "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                                "text": "The term for a displaced boulder is an erratic, but in the nineteenth century the expression seemed to apply more often to the theories than to the rocks."
                                            },
                                            {
                                                "example_id": "6a4d60a8-31e0-4e3f-8025-04eb577db482",
                                                "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                                "text": "During the last ice-age, massive stones were carried for miles by the scouring glaciers, only to be left, like passengers at the end of the line, when the glaciers retreated. Stranded in their new surroundings with rocks with which they share no common geology, their out-of-place-ness is evoked by their name: “erratics”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4e732f7-ba71-3732-abd1-5409ff6e5fae",
                                        "entry_id": "7fa35eac-a56a-3a2a-b99c-0c568dbf2bdf",
                                        "glosses": [
                                            "Anything that has erratic characteristics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
