                        "entry_id": "b0f52566-6a37-38db-a48b-a665f7e7b4ec",
                        "glosses": [
                            "Gefühl von Schwäche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99e89fa-96bd-4475-9224-c87595ffbadb",
                                "sense_id": "7d20d587-e229-3768-9e3a-38ba0d35e9f4",
                                "text": "„Mit einem plötzlichen Schwächegefühl erinnerte sich Graham an das gigantische Ding, das er vor seinem Abteilfenster gesehen hatte.“"
                            },
                            {
                                "example_id": "3a7f8c9b-d845-41c5-984a-92af7897af9a",
                                "sense_id": "7d20d587-e229-3768-9e3a-38ba0d35e9f4",
                                "text": "„Auf der Kunstakademie lernt man die Symptome einer fortgeschrittenen Bleivergiftung: Erschöpfung, Niedergeschlagenheit, Schwächegefühl, Verblödung - Symptome, die Misty nahezu ihr ganzes Leben lang an sich beobachtet hat.“"
                            }
                        ],
