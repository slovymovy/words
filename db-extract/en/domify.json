                    {
                        "sense_id": "b436ab74-4fa4-3fd0-bf42-133f5d9c13e4",
                        "entry_id": "d6bb5ae8-a173-3ab0-a9e2-77eeb47d53cb",
                        "glosses": [
                            "To divide (the heavens) into different astrological houses."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d929b246-9b73-4f7d-8010-932789fdfe24",
                                "sense_id": "b436ab74-4fa4-3fd0-bf42-133f5d9c13e4",
                                "text": "There are various ways of domifying. That of Regiomontanus, which is the most common, makes the circles of position pass through the intersections of the meridian and the horizon; but others make them pass through the poles of the zodiac."
                            }
                        ]
                    },
                    {
                        "sense_id": "529c2527-b22f-3ac1-a836-5b11912771f0",
                        "entry_id": "d6bb5ae8-a173-3ab0-a9e2-77eeb47d53cb",
                        "glosses": [
                            "To tame; to domesticate."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e2cd0786-2673-4228-9cfa-5cc52aff37b1",
                                "sense_id": "529c2527-b22f-3ac1-a836-5b11912771f0",
                                "text": "Its vagrant habit was changed; and it became entirely stationary, and domified"
                            }
                        ]
                    }
