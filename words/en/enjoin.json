{
    "word_family": [
        "injunction",
        "enjoinment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ffa50075-6528-35f9-a039-3550aef77ba6",
                    "sense_definition": "To command or urge someone to do something with authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>enjoined</w> the students to remain quiet during the exam."
                        },
                        {
                            "text": "The rules <w>enjoin</w> all members to follow the safety procedures strictly."
                        }
                    ],
                    "synonyms": [
                        "command",
                        "order",
                        "direct",
                        "instruct"
                    ]
                },
                {
                    "sense_id": "a5ca6004-a250-33e1-8caf-6ab9468b96f4",
                    "sense_definition": "To prescribe or establish a rule or law authoritatively.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "command",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new constitution <w>enjoins</w> the protection of individual rights for all citizens."
                        },
                        {
                            "text": "Religious texts often <w>enjoin</w> followers to practice charity and kindness."
                        }
                    ],
                    "synonyms": [
                        "prescribe",
                        "ordain",
                        "mandate"
                    ]
                },
                {
                    "sense_id": "fe03f64a-ef48-3675-b6e4-2b99dadca386",
                    "sense_definition": "To legally prohibit or restrain an action through a court order.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge <w>enjoined</w> the company from selling the product until the patent dispute was resolved."
                        },
                        {
                            "text": "Environmental groups sought to <w>enjoin</w> the construction project to protect the local habitat."
                        }
                    ],
                    "synonyms": [
                        "prohibit",
                        "restrain",
                        "ban"
                    ]
                }
            ]
        }
    ]
}