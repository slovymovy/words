                        "glosses": [
                            "Quelque chose qui relève à la fois de la cosmétologie et du soin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb5ba8ee-a523-4609-ae6b-70afd9939447",
                                "sense_id": "bae16d91-f8cb-3c49-8768-3cc724b756f0",
                                "text": "La EE contient de la glycérine, ce qui en soi n’a rien de bien dément sur le front du cosméto-soin moderne, avec par là-dessus du tocophérol E, vitamine anti-âge découverte en 1922 dans le germe de blé et la laitue, pour ceux que ça intéresse vaguement."
                            },
                            {
                                "example_id": "e9a4b777-4e88-4dfc-948e-5f0a21408d7d",
                                "sense_id": "bae16d91-f8cb-3c49-8768-3cc724b756f0",
                                "text": "Ce qui change : la couvrance (souvent plus importante avec le fond de teint classique), et l’aspect soin, plus présent chez les cosméto-soins comme la BB et la CC cream."
                            },
                            {
                                "example_id": "9aeb8c46-563a-445f-8a21-c9d7b613fddd",
                                "sense_id": "bae16d91-f8cb-3c49-8768-3cc724b756f0",
                                "text": "Crèmes soins redensifiantes et de la cosméto-soin !"
                            }
                        ]
                    }
