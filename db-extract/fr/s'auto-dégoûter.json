                    {
                        "sense_id": "9336cf7e-26a7-3a13-a4f7-1e994803787d",
                        "entry_id": "9cc20e28-f1ff-33af-82d5-02ff3a846b16",
                        "glosses": [
                            "Se dégoûter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2be634a1-3b23-45ff-aa80-e74d48b9b7c3",
                                "sense_id": "9336cf7e-26a7-3a13-a4f7-1e994803787d",
                                "text": "Ma foi, je veux bien tenter du Asimov aussi, mais je garantis pas d'accrocher, je me suis auto-dégoûtée de lui ado."
                            },
                            {
                                "example_id": "12961d11-5be9-4397-8da6-94ab7e67a884",
                                "sense_id": "9336cf7e-26a7-3a13-a4f7-1e994803787d",
                                "text": "Mais ce faisant je me suis auto-dégoûtée grande prude que suis-je, alors ça compense !"
                            },
                            {
                                "example_id": "1836501a-b061-4aa4-b72b-8b2b07ae5671",
                                "sense_id": "9336cf7e-26a7-3a13-a4f7-1e994803787d",
                                "text": "Je me lance donc le défi aujourd'hui de ne pas trop m'auto-dégoûter…"
                            }
                        ]
                    }
