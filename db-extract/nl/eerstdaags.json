                "forms": [],
                "senses": [
                    {
                        "sense_id": "ec920f6e-dca3-3cd2-898f-b5cfb6c9e8ff",
                        "entry_id": "338f5b6f-6e14-3bc3-97c0-5c1861616ed5",
                        "glosses": [
                            "binnenkort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a35708f2-d795-40c5-b248-1714350d4f0c",
                                "sense_id": "ec920f6e-dca3-3cd2-898f-b5cfb6c9e8ff",
                                "text": "Ik zal eerstdaags er voor zorgen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0cfc0e0-cde8-4946-9ef3-755fdad81de0",
                        "source_entry_id": "338f5b6f-6e14-3bc3-97c0-5c1861616ed5",
                        "source_sense_id": "ec920f6e-dca3-3cd2-898f-b5cfb6c9e8ff",
                        "target_lang_word": "soon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Short in length of time from the present."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3173a0e7-5e22-4ea5-911a-bd539f8bd51d",
                                                "sense_id": "d7b7eb68-e050-39c6-b3f8-9cf17a74f364",
                                                "text": "I need the soonest date you have available."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f4dae0-cab4-4340-a865-86ec92591542",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Late in the evening we arrived at Quincy where we bivouacked for the night and taken a soon start the next morning to march to the arsenal."
                                            },
                                            {
                                                "example_id": "de10cacb-480f-4fe5-84fa-692fc6ea0bd5",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "Got up pretty early, ate a soon breakfast, had the sulky and was about to start to Newtown when it commenced raining.."
                                            },
                                            {
                                                "example_id": "3f156422-1ac6-436a-a9a6-b13ef6bdcca3",
                                                "sense_id": "d55979d4-eddd-30b1-aff2-f35dda54dc23",
                                                "text": "They were different from colored folks who had to be out to get a soon start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                        "entry_id": "7e2f33f8-1630-3b54-8efc-d1b3502d08c9",
                                        "glosses": [
                                            "Used as an alternative to express 'to be going to' in the form 'to be soon to'."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eec91b3-3572-4fc7-9fc0-33cdeb5e75ff",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "Hurry up, the wedding is soon to start!"
                                            },
                                            {
                                                "example_id": "96e6da7d-c537-4b32-b1c9-71414e58b574",
                                                "sense_id": "b8335078-0ca3-36fa-94b7-368247768676",
                                                "text": "A new shop is soon to be opened in this street."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "soon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64920a44-afc2-371a-a23b-21428d4c888f",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Immediately, instantly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Within a short time; quickly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "555d5a98-8f4e-4e10-836c-f8b7d11041ee",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "His wife is likely to come too after him, but we just do not know how soon after."
                                            },
                                            {
                                                "example_id": "f2669e72-cf69-4a66-8240-b2d56ba10d59",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                                            },
                                            {
                                                "example_id": "fb1399c9-d019-47de-a189-5f2d81e92d7b",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly,[…], down the nave to the western door.[…]At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "1dbfb7b6-6a4e-4005-8caa-86e72479b0bb",
                                                "sense_id": "ba107ec4-880b-3bbd-a321-325b71af4247",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese[…]began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Early."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b5e7563-0256-4adc-a899-17a9c5b43978",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "How is it that ye are come so soon to day?"
                                            },
                                            {
                                                "example_id": "bd10ade2-b7b4-42b4-9d0c-308e53e73d1e",
                                                "sense_id": "f852e2c8-c2a6-3a36-bea3-11f8e5346b87",
                                                "text": "“Been huntin’ fuh mah mule. Anybody seen ’im?” he asked.\n“Seen ’im soon dis mornin’ over behind de school-house,” Lum said. “’’Bout ten o’clock or so. He musta been out all night tuh be way over dere dat early.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                        "entry_id": "71c35774-478c-3b06-9285-120a57bd3553",
                                        "glosses": [
                                            "Readily; willingly; used with would, or some other word expressing will."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06526372-cf03-4d8d-b562-8d279ecd6668",
                                                "sense_id": "4c6f0278-1a57-3172-9a1f-4163191adc56",
                                                "text": "I would as soon see a river winding through woods or in meadows, as when it is tossed up in so many whimsical figures at Versailles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
