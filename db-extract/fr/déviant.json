                "senses": [
                    {
                        "sense_id": "9d96e859-05e6-3f48-91ef-09647c55b64d",
                        "entry_id": "0ec3d468-c501-3e8c-8292-5b1c64eb0b07",
                        "glosses": [
                            "Personne qui conteste, transgresse ou qui se met à l'écart de règles et de normes en vigueur dans un système social donné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e966d382-f696-4f12-8071-8045509cbfa4",
                                "sense_id": "9d96e859-05e6-3f48-91ef-09647c55b64d",
                                "text": "À l'action exercée par le déviant contre la société correspond donc une réaction de la société contre ce déviant."
                            },
                            {
                                "example_id": "64f93f4f-0c48-4ef1-a3a3-381b4da63773",
                                "sense_id": "9d96e859-05e6-3f48-91ef-09647c55b64d",
                                "text": "Le mécanisme iatrogénique est le même que celui qui poussait les philanthropes du XIXᵉ siècle à sortir les jeunes des prisons : les comportements déviants sont contagieux, particulièrement pour les déviants."
                            },
                            {
                                "example_id": "41936a8b-5a80-421b-9f48-c0faa70c0afc",
                                "sense_id": "9d96e859-05e6-3f48-91ef-09647c55b64d",
                                "text": "Qu'il s'agisse de phénomènes de culte de la personnalité ou de résurgences religieuses comme dans l'Islam de Khomeiny, les déviants sont en effet supprimés parce qu'ils sont intégrés dans un corps social entièrement devenu déviant."
                            }
                        ]
                    }
                ],
