                                    {
                                        "sense_id": "c5bca4ce-4f45-378b-b9ba-291eaf1267ae",
                                        "entry_id": "3bc8fc46-0f78-3abd-ad24-ba4e2d4e7149",
                                        "glosses": [
                                            "Petit corps oblong, vermiforme, qui est couché le long du bord supérieur du testicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507f3733-4f66-4127-91cf-47a18d9555f6",
                                                "sense_id": "c5bca4ce-4f45-378b-b9ba-291eaf1267ae",
                                                "text": "L’épididyme, plus allongé que le testicule, présente une courbe assez prononcée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15d35a05-9597-3147-add5-76745f50c8af",
                                        "entry_id": "3bc8fc46-0f78-3abd-ad24-ba4e2d4e7149",
                                        "glosses": [
                                            "Canal spermatozoïde qui, à partir du testicule, se termine par le canal déférent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f13f1ed-692b-4b3e-96c9-e951cbaa5edd",
                                                "sense_id": "15d35a05-9597-3147-add5-76745f50c8af",
                                                "text": "L’épididyme est un canal en spirale de 5 à 6 mètres de longueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
