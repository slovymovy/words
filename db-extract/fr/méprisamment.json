                        "glosses": [
                            "D’un ton méprisant, d’une manière méprisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f89826d-4050-4d6a-8f57-f1d220ca72fe",
                                "sense_id": "5aa252e7-7b23-325d-9f23-b1ecf8110bdb",
                                "text": "« Il y en a, voyez-vous, qui ne meurent pas. Ils… »\nElle allongea méprisamment ses lèvres minces.\n« Ils s’oublient… Il faut chaque jour songer à la mort comme à l’heure la plus grave que Dieu ait faite."
                            },
                            {
                                "example_id": "2c1e9d48-9a80-4246-b8a6-aea40826fb76",
                                "sense_id": "5aa252e7-7b23-325d-9f23-b1ecf8110bdb",
                                "text": "Elle se disait féministe, suivait des cours de droit, parlait méprisamment de ces plaisirs faciles que recherchaient, dans des amours vénales, ses compagnons d'études."
                            }
                        ]
                    }
