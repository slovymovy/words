                                "target_senses": [
                                    {
                                        "sense_id": "58471dae-07f7-30dc-bac1-ac1bc1b038a1",
                                        "entry_id": "cbc7fc08-5adf-36d1-9409-e6ac3465cbbb",
                                        "glosses": [
                                            "člen lehkého jezdectva, vojín lehké kavalérie"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f345b519-29f2-46d8-960c-692e0ee3d7b6",
                                                "sense_id": "58471dae-07f7-30dc-bac1-ac1bc1b038a1",
                                                "text": "Koštištář měl hlas opravdu jako na lesích a ukazoval tlupě šavlí po nějakém švališéru v pravo do ouvozu, kudy šla cesta do Domašic. Už se šeřilo, když přitáhli sedláci do dědiny."
                                            },
                                            {
                                                "example_id": "53c307bd-aac0-4cc9-b75c-4e00b7ccc791",
                                                "sense_id": "58471dae-07f7-30dc-bac1-ac1bc1b038a1",
                                                "text": "Smáli jsme se, jak Lokvencka udělala Kaválkovi kompliment, jak se šedý švališér dal proti ní do positury, jak oživl a sebou škubl, když Paďour spustil notu, při které za mlada minet tancovávali"
                                            }
                                        ]
                                    }
                                ]
                            }
