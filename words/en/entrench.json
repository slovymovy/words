{
    "word_family": [
        "entrenchment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "08503d34-a09a-3893-85ef-ac074af41b32",
                    "sense_definition": "To surround or provide with a trench, especially for defense.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "military_defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers began to <w>entrench</w> their camp before the enemy arrived."
                        },
                        {
                            "text": "They had to <w>entrench</w> themselves quickly to survive the heavy artillery fire."
                        }
                    ],
                    "synonyms": [
                        "trench",
                        "dig in"
                    ],
                    "common_phrases": [
                        "entrench themselves"
                    ]
                },
                {
                    "sense_id": "3ef7d7a7-ef42-3988-bbdc-1accba76f765",
                    "sense_definition": "To establish a firm and secure position in business, politics, or society.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "establish_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>entrench</w> its position as the market leader."
                        },
                        {
                            "text": "New policies helped to <w>consolidate</w> and <w>entrench</w> the political power of the ruling party."
                        }
                    ],
                    "synonyms": [
                        "consolidate"
                    ],
                    "common_phrases": [
                        "entrench a position"
                    ]
                },
                {
                    "sense_id": "1e07cff3-5adf-3b25-be8e-b29d36ba0aec",
                    "sense_definition": "To become so firmly fixed in a belief or attitude that it is difficult to change.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "establish_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to debate with someone who has <w>entrenched</w> views on the subject."
                        },
                        {
                            "text": "Prejudices can easily <w>entrench</w> themselves in a community if they are not challenged."
                        }
                    ]
                },
                {
                    "sense_id": "8f1c29d6-3710-3c84-a2e9-d45c3fa228b6",
                    "sense_definition": "To encroach or trespass upon the rights or property of another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations must not <w>entrench</w> upon the fundamental rights of the citizens."
                        },
                        {
                            "text": "He felt that the government's actions began to <w>entrench</w> on his personal privacy."
                        }
                    ]
                }
            ]
        }
    ]
}