                        "examples": [
                            {
                                "example_id": "316842db-5157-4386-8e81-339f8fa245b3",
                                "sense_id": "f0a4ceea-908b-3a5a-b602-c3d85b7dd523",
                                "text": "Ногти насандалит, штаны ― клёшем, на шее ― цепочки…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2f45d939-0bfb-38d5-b054-8df9bf176c50",
                        "entry_id": "3a49625e-3dbf-3562-b48f-a642ffcea1ab",
                        "glosses": [
                            "перен., прост. натереть до блеска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71a04a2b-7533-4250-8cf0-3c804a8dec00",
                                "sense_id": "2f45d939-0bfb-38d5-b054-8df9bf176c50",
                                "text": "Глаз прищурил: блестит столик, будто его корова мокрым языком облизала. ― Ловко, ― говорит, ― насандалил!"
                            }
                        ]
                    }
