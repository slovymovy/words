                ],
                "senses": [
                    {
                        "sense_id": "50eb6930-1038-3d8f-9a39-b3589a73e04b",
                        "entry_id": "5ee8b744-3ef7-3916-8b3c-1d4c01950915",
                        "glosses": [
                            "„Leistungsvermögen eines Truppenverbands“"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ee407b4a-598d-45e0-b1a0-0c7943a4642a",
                                "sense_id": "50eb6930-1038-3d8f-9a39-b3589a73e04b",
                                "text": "„Der Einsatz von Satelliten zur Raketenwarnung, Nachrichtenübermittlung, Wetterbeobachtung, Navigation und Aufklärung habe nach eigenem Bekunden die Kampfkraft der integrierten Streitkräfte der USA gestärkt.“"
                            },
                            {
                                "example_id": "97e7ca76-a9a3-4911-b680-b97eb3fac902",
                                "sense_id": "50eb6930-1038-3d8f-9a39-b3589a73e04b",
                                "text": "„Dieser Widerspruch rührt daher, dass die Kriegswissenschaft die Kampfkraft einer Partei für identisch mit ihrer zahlenmässigen Stärke hält.“"
                            },
                            {
                                "example_id": "d88d542d-8237-4086-82ee-e1cf9eb61a21",
                                "sense_id": "50eb6930-1038-3d8f-9a39-b3589a73e04b",
                                "text": "„Kampfkraft, Geschick in der Kriegsführung und im Verhandeln attestieren sie den Keltinnen – schwer vorstellbar, dass eine männliche Geschichtsschreibung Frauen derart maskuline Kompetenzen nachsagt, wenn die Frauen nicht eben dadurch aufgefallen wären.“"
                            },
                            {
                                "example_id": "099d1716-7446-428d-a4f8-82737304456c",
                                "sense_id": "50eb6930-1038-3d8f-9a39-b3589a73e04b",
                                "text": "„Das Gewicht einer Kugel, die Stärke der Rohrwandung und die Menge des benötigten Pulvers pro Schuss hingen unmittelbar zusammen und waren von wesentlicher Bedeutung für die Kampfkraft der Waffe und für die Kosten ihrer Unterhaltung und ihres Transports.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "97d9e274-5c85-3218-bf90-d3bc85c7e91f",
                        "entry_id": "5ee8b744-3ef7-3916-8b3c-1d4c01950915",
                        "glosses": [
                            "Person, die im Rahmen einer Truppe in (kriegerischen) Auseinandersetzungen eingesetzt werden kann"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "b2a3179a-ecf3-4d9e-9af6-db246c89e17a",
                                "sense_id": "97d9e274-5c85-3218-bf90-d3bc85c7e91f",
                                "text": "Kampfkräfte der Alliierten nahmen die Stellung am Abend ein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
