                "senses": [
                    {
                        "sense_id": "e064eeef-f9f4-35da-bf61-9d3925a4ec79",
                        "entry_id": "b7cde152-1d15-3b8f-88d1-cd3e2fc4abc5",
                        "glosses": [
                            "weibliche Person, die eine andere Person, unabhängig davon, ob diese tatsächlich schuldig ist, (oftmals anonym) anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8617ad-091c-4594-bcbd-e82d7152d8a0",
                                "sense_id": "e064eeef-f9f4-35da-bf61-9d3925a4ec79",
                                "text": "„Zwölf Tage später drohte er einer Frau, die er für eine Denunziantin hielt, sie umzubringen.“"
                            },
                            {
                                "example_id": "d2772927-7775-4500-acb3-a9ccd93c569c",
                                "sense_id": "e064eeef-f9f4-35da-bf61-9d3925a4ec79",
                                "text": "„Nach dem Krieg stellte sich heraus, dass Madame Dubois nicht die einzige Denunziantin gewesen war.“"
                            },
                            {
                                "example_id": "77ddd29b-766a-4b75-ada4-a7b043aaee8d",
                                "sense_id": "e064eeef-f9f4-35da-bf61-9d3925a4ec79",
                                "text": "„Er überlegte, ob er den Wodka dalassen sollte; aber wer wußte, was die Denunziantin daraus machen würde?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
