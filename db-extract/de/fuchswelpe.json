                ],
                "senses": [
                    {
                        "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                        "entry_id": "c63b31f4-1b6d-3338-aa65-f803a1cc6537",
                        "glosses": [
                            "Jungtier eines Fuchses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a53fb6-2464-4700-b741-d66c8b4fe6d7",
                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                "text": "„Voraussetzung dafür ist, daß diese Ammen Junge haben, die etwa im Alter der Fuchswelpen sind.“"
                            },
                            {
                                "example_id": "08f4e1fc-5267-407d-aee7-1109821e5f6d",
                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                "text": "„In der Natur wird es wohl anders sein, da der Fuchswelpe dort den scharfen Ruch des Fuchsbaues mitbekommt.“"
                            },
                            {
                                "example_id": "5d6d2831-a6e6-4994-a539-80bf7ea8cffa",
                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                "text": "„Sie sind kleiner als die Fuchswelpen und wiegen zwischen 60 und 85 g, Rumpflänge 11–13 cm, Schwanz 4,2–6 cm, […]“"
                            },
                            {
                                "example_id": "e3c34e4d-f381-4072-8722-c1cb4c31340a",
                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                "text": "„Vieles deutet darauf hin, daß die Fuchswelpen sensibler sind als die Nerzwelpen, […]“"
                            },
                            {
                                "example_id": "3f6878b2-ae14-41c8-8258-ff2025caf6b8",
                                "sense_id": "d55b3899-dd07-3134-9434-f590389cf5ed",
                                "text": "„Mit solchen Begriffen kann ich ohne Zusatzhypothese den Kommunikationsvorgang beschreiben, bei dem das Quärren von Fuchswelpen die Fähe nach dem Hören der Laute veranlaßt, sich ihnen zu nähern, um ein Verhalten auszuführen, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
