                            {
                                "target_word": "side by side",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f437fda-9b73-3160-a784-d49a60a61aff",
                                        "entry_id": "42d192f5-2551-39ca-841d-f880148f1dbd",
                                        "glosses": [
                                            "Beside or alongside one another; close to one another and abreast."
                                        ],
                                        "tags": [
                                            "literally",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4ca3ed-4715-478c-8e29-69718541e5d3",
                                                "sense_id": "1f437fda-9b73-3160-a784-d49a60a61aff",
                                                "text": "The new houses were built side by side, facing the lake."
                                            },
                                            {
                                                "example_id": "4eb897dd-232a-422c-92c1-bd75178bca2a",
                                                "sense_id": "1f437fda-9b73-3160-a784-d49a60a61aff",
                                                "text": "The structure was examined and passed by the Board of Trade in February, 1890, after it had been tested with two trains of 50 loaded wagons, each hauled by two engines, and pushed by a third. The trains ran side by side, and their combined weight, including the six engines, was 1,800 tons. The deflections of the girders were precisely in accordance with the calculations of the engineers."
                                            },
                                            {
                                                "example_id": "6990f80a-0a50-4639-939c-aabb8abc745d",
                                                "sense_id": "1f437fda-9b73-3160-a784-d49a60a61aff",
                                                "text": "Two lamps mounted side by side about two feet apart will flash alternately and when this happens traffic must stop; disobedience of these signs becomes an offence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4820afa-82e7-3f12-becc-1b2ced8bb780",
                                        "entry_id": "42d192f5-2551-39ca-841d-f880148f1dbd",
                                        "glosses": [
                                            "In peace."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4cc2259-1d12-30d6-9c9b-0e5a3f879bea",
                                        "entry_id": "42d192f5-2551-39ca-841d-f880148f1dbd",
                                        "glosses": [
                                            "With a common purpose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "731c9bc1-304e-4583-aea2-5b966aa39e1d",
                                                "sense_id": "f4cc2259-1d12-30d6-9c9b-0e5a3f879bea",
                                                "text": "The soldiers of XX and YY were fighting side by side against a common enemy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7703ed13-735b-4d99-91f1-38ee4f0689e3",
                        "source_entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                        "source_sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
                        "source_sense_description": "in unmittelbarer Nähe und gleicher Orientierung",
                        "target_lang_word": "côte à côte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "côte à côte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                        "entry_id": "65fee409-2dfc-3b1a-99e5-4abe60666f84",
                                        "glosses": [
                                            "À côté l’un de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8524f879-84a6-4bb7-bf55-1130691fd030",
                                                "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                                "text": "C’était la première fois qu’il leur paraissait être seuls, bien qu’ils eussent vécu côte à côte."
                                            },
                                            {
                                                "example_id": "f7faf3f1-f45f-4ec3-b5ce-439c00e0078b",
                                                "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                                "text": "Il y aurait, gravées sur sa tombe, deux dates côte à côte, 1926-1876, séparées par un tiret."
                                            },
                                            {
                                                "example_id": "476c5d7a-7490-417b-b2c2-39cae90b128f",
                                                "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                                "text": "Nous nous allongeons côte à côte dans des chaises longues qui mériteraient d’être repeintes."
                                            },
                                            {
                                                "example_id": "2ecc9bd4-c9ca-4f9b-a92e-8bd097518918",
                                                "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                                "text": "L’instant d’après, ils chevauchaient côte à côte en direction de l’ouest, leurs ombres fugaces caressant les hautes herbes."
                                            },
                                            {
                                                "example_id": "1a5ea98f-3237-4c07-9e7c-a7eda96e7fc8",
                                                "sense_id": "0fb99cb4-9e0b-3268-85b6-8dbdb6e1e509",
                                                "text": "Il met côte à côte, c'est le cas de le dire, le squelette d'un prêtre et celui d'un singe – j'ignore si Darwin connaissait ce fait, qui peut s'apparenter à une facétie..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cb99013-0872-4154-8108-a544e98d7fb0",
                        "source_entry_id": "7dfeb44b-4c7a-38cf-a6db-9d85849f6e63",
                        "source_sense_id": "e0a84adc-3ed8-3829-8160-83b7027879a3",
                        "source_sense_description": "in unmittelbarer Nähe und gleicher Orientierung",
                        "target_lang_word": "conjointement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjointement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "D’une manière conjointe, ensemble et au même moment qu’une autre chose ou personne ; ensemble ; simultanément."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e88e4a-a393-4deb-b28e-e4e55de84740",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Au tournant d’une place […] deux personnes, qui marchent conjointement, attirent, je ne sais pourquoi, mon attention. C’est un couple en costume de voyage."
                                            },
                                            {
                                                "example_id": "a0f62dfa-8869-4352-8fcf-2fc580880cfe",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "[…] la phase de Thérophytes a une durée beaucoup plus courte en raison du développement rapide de Petasites dont les larges feuilles réduisent l’éclairement et favorisent conjointement avec les rhizomes de la plante, un alluvionnement propice à l’installation de la Saulaie."
                                            },
                                            {
                                                "example_id": "576212d7-e09b-4d1b-ac65-590edccd93f1",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Fendt et Trelleborg ont développé conjointement les pneus TM1 Eco Power spécialement conçus pour la gamme électrique."
                                            },
                                            {
                                                "example_id": "cab018ea-099d-4fcd-8ce8-b60293c1230c",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "L’accommodement se fit effectivement par le moyen de Cléopâtre leur sœur, à condition que les deux frères régneraient conjointement."
                                            },
                                            {
                                                "example_id": "d35ffd51-99d0-4c24-9457-394c1d210a07",
                                                "sense_id": "2306915a-9562-34f5-98e8-b9b7738bacb5",
                                                "text": "Le Live Aid est un double concert donné conjointement à Londres et à Philadelphie le 13 juillet 1985, par des artistes majoritairement américains et britanniques, organisé par Bob Geldof et Midge Ure dans le but de lever des fonds pour soulager la famine éthiopienne en cours lors de cette année-là. L'événement a permis d'amasser la somme de 127 millions de dollars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11c0e816-ec4b-3e2e-894d-ecc3acbb11fd",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "À plusieurs légataires en termes exprès ou par le fait."
                                        ],
                                        "tags": [
                                            "Jurisprudence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8018b304-aba2-47e2-a9e6-ed38c3ad2f72",
                                                "sense_id": "11c0e816-ec4b-3e2e-894d-ecc3acbb11fd",
                                                "text": "Legs fait conjointement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                        "entry_id": "2a11e5e4-520e-389b-862b-62039dacac8a",
                                        "glosses": [
                                            "De concert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498141b5-c5e9-4e40-95e2-1730df25e7fa",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "C’est ainsi que la Fondation assistance aux animaux (FAA) décrit le pavillon de Maisons-Alfort (Val-de-Marne) dans lequel elle est intervenue, lundi matin, pour une opération de saisie de chiens, menée conjointement avec les services de la Direction départementale de la protection des populations."
                                            },
                                            {
                                                "example_id": "27e1ca43-21d2-4a0d-bcf5-8597749c500c",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "Il est nécessaire que le temps travaille conjointement avec les excellents maîtres."
                                            },
                                            {
                                                "example_id": "78781ca1-3854-49f6-9d05-fa64bf30bf48",
                                                "sense_id": "298dfdb9-f214-3046-800b-30910ab38a12",
                                                "text": "Il [Bucer] persista tellement dans l’accord, que toujours depuis il fut regardé par ceux de la confession d’Augsbourg comme membre de leurs églises, et agit en tout conjointement avec eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
