                ],
                "senses": [
                    {
                        "sense_id": "4e63088f-aa9d-3618-ad96-881b5e216829",
                        "entry_id": "89265d24-ed45-3a82-a06c-2e04a00d877b",
                        "glosses": [
                            "The minimum number of ten (male) adult Jews required for a communal religious service."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "ab625703-48aa-4eff-9e8e-12327555e1cd",
                                "sense_id": "4e63088f-aa9d-3618-ad96-881b5e216829",
                                "text": "So without my visit, if Simon didn't attend, a minyan would be hard to come by."
                            },
                            {
                                "example_id": "dcb80864-20c1-497f-a508-184688f394e0",
                                "sense_id": "4e63088f-aa9d-3618-ad96-881b5e216829",
                                "text": "As mourners cannot attend synagogue during shiva, a minyan gathers for morning, afternoon, and evening services in their home."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7dfe872-3c3d-349c-9cdc-c4ff990bca8c",
                        "entry_id": "89265d24-ed45-3a82-a06c-2e04a00d877b",
                        "glosses": [
                            "A Jewish prayer service."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d9bb71fe-642b-462e-9449-17756a91a2b5",
                                "sense_id": "b7dfe872-3c3d-349c-9cdc-c4ff990bca8c",
                                "text": "New people assume leadership positions as required and stay around for as long as the minyan meets their needs."
                            },
                            {
                                "example_id": "4932a7ac-d5b5-43ef-a72e-ab0f9c108820",
                                "sense_id": "b7dfe872-3c3d-349c-9cdc-c4ff990bca8c",
                                "text": "Tefillin are not used on Sabbaths and holidays, so unless you attend a minyan on weekday mornings or grew up in a home where men prayed daily, this practice may be unfamiliar to you."
                            }
                        ]
                    }
                ],
