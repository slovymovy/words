                                "target_senses": [
                                    {
                                        "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                        "entry_id": "37486849-e760-393b-8dbe-c2fe9022013c",
                                        "glosses": [
                                            "Any of a variety of coarse-grained crystalline metamorphic rocks with a foliated structure that allows easy division into slabs or slates."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb8d971d-8b9e-4c09-97f3-318128034bcb",
                                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                                "text": "Although it shows under the microscope traces of the original gabbro structure and of the original gabbro minerals, no one would hesitate from a microscopical examination to class it with the schists."
                                            },
                                            {
                                                "example_id": "68b0b174-56af-49e2-a6a9-3792be0483e2",
                                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                                "text": "1915, Charles Will Wright, Geology and Ore Deposits of Copper Mountain and Kasaan Peninsula, Alaska, US Geological Survey, Professional Paper 87, page 29,\nNarrow bands of schist are interstratified with these limestones, and in turn narrow beds of limestone are interstratified with the schists."
                                            },
                                            {
                                                "example_id": "16abd8a8-c56c-4e5b-b7bb-8fc60a51b5e5",
                                                "sense_id": "3d8d721a-f4a6-3be9-9638-2a6c0a9c165e",
                                                "text": "Millions of years ago the mica schists surrounding the old Brandberg West Mine became folded and concertinaed by enormous horizontal pressures."
                                            }
                                        ]
                                    }
                                ]
                            }
