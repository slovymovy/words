                "senses": [
                    {
                        "sense_id": "7ab8eefd-fe4c-3025-9e0e-afac34867432",
                        "entry_id": "1f21b984-0b61-3db7-9125-23fc076b72ea",
                        "glosses": [
                            "een tafeltje of kastje dat naast het bed staat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39507bba-5fd2-431a-87da-e996dfabb108",
                                "sense_id": "7ab8eefd-fe4c-3025-9e0e-afac34867432",
                                "text": "Ik heb mijn bril en mobiele telefoon altijd op het nachttafeltje naast mijn bed liggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d52069f9-ba55-4c41-849f-7774194bdce4",
                        "source_entry_id": "1f21b984-0b61-3db7-9125-23fc076b72ea",
                        "source_sense_id": "7ab8eefd-fe4c-3025-9e0e-afac34867432",
                        "target_lang_word": "Nachttisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachttisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                        "entry_id": "7732871b-d40c-31c5-91b6-b0c99fe3d529",
                                        "glosses": [
                                            "neben dem Bett stehendes Tischchen oder Schränkchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cd0e79c-0e1a-4a9b-a79e-96842a3c1699",
                                                "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                                "text": "Er hat im Dunkeln die Lampe vom Nachttisch geworfen."
                                            },
                                            {
                                                "example_id": "9b5a0994-0375-4af7-81ca-c34da90ebce5",
                                                "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                                "text": "„Unsere Zimmer hatten ein Bett mit einem Nachttopf darunter und einen Nachttisch mit einer Bibel.“"
                                            },
                                            {
                                                "example_id": "00edb5cd-3403-4763-a0b0-a610b9ee09f4",
                                                "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                                "text": "„Auf Papas Nachttisch stand eine große Schale mit Obst, das hat Papa dann mit seinem Taschenmesser zerlegt, und wir haben ein paar Birnen und Äpfel gegessen.“"
                                            },
                                            {
                                                "example_id": "911afe0d-71cf-4a82-b2ba-849d37a0213a",
                                                "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                                "text": "„Zuletzt nahm sie die Ohrringe ab und legte sie auf den Nachttisch.“"
                                            },
                                            {
                                                "example_id": "9d8af0ce-9a04-4b95-b390-8fda99979ea3",
                                                "sense_id": "6ef8a797-2652-3a59-9ec8-f7101cc07c29",
                                                "text": "„Ohne eine Antwort abzuwarten, warf sie den Jogginganzug nach links, auf die rechte Seite des Bettes, und legte das Smartphone auf den kleinen Nachttisch gegenüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
