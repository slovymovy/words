                                        "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A large shrub of the genus Syringa, especially Syringa vulgaris, bearing white, pale-pink, or purple flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "129e9219-75a3-4df4-8a78-6b0089b6fa66",
                                                "sense_id": "fbfdeebd-4c54-3c35-8e6b-08604842dc1a",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A flower of the lilac shrub."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fced0e6-1221-4050-8ae9-0643ec0aac6f",
                                                "sense_id": "341999fd-4eff-3e50-a505-a48ff3cf66a2",
                                                "text": "[…] O death, I cover you over with roses and early lilies, / But mostly and now the lilac that blooms the first, / Copious I break, I break the sprigs from the bushes, / With loaded arms I come, pouring for you, / For you and the coffins all of you O death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68dc6f2-ceaf-3d27-8fe1-d6ee9145cdd5",
                                        "entry_id": "f0f4d874-94fe-3081-afd4-4a51498c0542",
                                        "glosses": [
                                            "A pale purple color, the color of some lilac flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2980c96-7335-3947-a1aa-41a27edc7a0f",
