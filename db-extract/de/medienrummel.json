                "senses": [
                    {
                        "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                        "entry_id": "5fb7ed34-954f-3d6c-9b48-797c626d8c67",
                        "glosses": [
                            "großes Aufheben, das von den Medien um etwas gemacht wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c7f7e501-a0d0-42d6-85a2-25017f4d6f74",
                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                "text": "„Der Medienrummel um die Autobombe kam gerade erst richtig in Fahrt, und Ferris befürchtete, dass Hani irgendetwas tun könnte, was das Netz, das sie so mühselig gesponnen hatten, an einer entscheidenden Stelle zum Reißen brachte.“"
                            },
                            {
                                "example_id": "b6026913-8b2d-479e-9793-4d2b7284a444",
                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                "text": "„Nun reiste Tim Blackman nach Japan, was einen riesigen Medienrummel zur Folge hatte.“"
                            },
                            {
                                "example_id": "428e4675-7ac4-4c2b-a795-f014f9fcb791",
                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                "text": "„›Auf uns wartet unerträglicher Druck und wochenlanger Medienrummel.‹“"
                            },
                            {
                                "example_id": "b4cdee1f-1ba7-4113-b923-5acc2f4d9671",
                                "sense_id": "bba6554f-db63-306f-9733-4f915d39cd16",
                                "text": "„Er entzieht sich dem Gefängnis, der Verantwortung, entzieht sich dem Medienrummel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
