                "senses": [
                    {
                        "sense_id": "388d6995-bcd6-34b8-beb3-5c86c3646fe6",
                        "entry_id": "39e59f52-3758-38fc-8732-7b0b4b8b7136",
                        "glosses": [
                            "To be overemployed (working more than one job simultaneously)."
                        ],
                        "tags": [
                            "Internet",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8f8b6f68-0461-404b-ad25-29e63512649a",
                                "sense_id": "388d6995-bcd6-34b8-beb3-5c86c3646fe6",
                                "text": "But then he might be found out at the other companies where he OEs as a transgender person. Obviously the solution is to interview as a furry"
                            },
                            {
                                "example_id": "b26522a6-6f27-4c7e-973a-679b6cafccc2",
                                "sense_id": "388d6995-bcd6-34b8-beb3-5c86c3646fe6",
                                "text": "Before that, I was at a company where I could have easily OEed but didn't because it didn't even cross my mind."
                            },
                            {
                                "example_id": "faef6c0d-8076-469f-a13b-9efb256eecb8",
                                "sense_id": "388d6995-bcd6-34b8-beb3-5c86c3646fe6",
                                "text": "Hello all, I have been OEing for the last two years and I am thinking of starting some kind of online business on the side but I am just lost on where to start and whether it is worth it. I am curious to know if anyone else has considered building a business with their extra income?"
                            },
                            {
                                "example_id": "0d847ae6-d2ac-4a05-ad8a-bb089ea85e3d",
                                "sense_id": "388d6995-bcd6-34b8-beb3-5c86c3646fe6",
                                "text": "18 months. Most people advise to OE when you're an expert at your field. I can get J1s work out of the way with 6 hours of aggressive concentration weekly. J2 is a bit hard, new territory but I'm making it work."
                            }
                        ]
                    }
