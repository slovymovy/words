                "senses": [
                    {
                        "sense_id": "45cf8eb8-13b6-3bfa-9f67-468150f30a4a",
                        "entry_id": "f0e153cd-5553-3be8-9070-741b8522fba6",
                        "glosses": [
                            "irreale Welt, die nur in der eigenen Fantasie oder in Träumen existiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42fe4313-5bf3-4db3-9b13-2dcb55f0dc06",
                                "sense_id": "45cf8eb8-13b6-3bfa-9f67-468150f30a4a",
                                "text": "„Traumkräuter können helfen, die Schwelle in die Traumwelt bewusst zu übertreten und luzides Träumen zu erleichtern.“"
                            },
                            {
                                "example_id": "573d74b0-5f16-4007-8ecc-1ae67b4b09da",
                                "sense_id": "45cf8eb8-13b6-3bfa-9f67-468150f30a4a",
                                "text": "„Die Träume der Menschen erschaffen Wesen und Abläufe in der Traumwelt.“"
                            },
                            {
                                "example_id": "1262a7c8-1222-4fee-8e20-6ae48ad569d4",
                                "sense_id": "45cf8eb8-13b6-3bfa-9f67-468150f30a4a",
                                "text": "„Sie lebt dann in einer Traumwelt, die nichts mit der Wirklichkeit zu tun hat, und ist leicht und schwerelos, und ich würde mich nicht wundern, wenn die Zitronenfalter, die überall herumspielen, sich ihr auf die Schulter setzten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
