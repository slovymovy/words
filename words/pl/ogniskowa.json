                        "krótka ogniskowa",
                        "ogniskowa obiektywu",
                        "odległość ogniskowa"
                    ],
                    "target_lang_definitions": {
                        "ru": "расстояние от оптического центра линзы или системы до её фокуса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокусное расстояние",
                                "target_lang_sense_clarification": "в оптике"
                            }
                        ]
                    }
                }
            ]
        },
        {
