                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8bc61bc0-43dd-4c28-8e03-ade779f77e6a",
                        "entry_id": "2fac1df2-e52c-3cb5-b9bf-aaef1a4a659e",
                        "tags": [
                            "plural"
                        ],
                        "form": "amphibiens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bf08e4e-a2ab-3631-b390-e98d9a2e2553",
                        "entry_id": "2fac1df2-e52c-3cb5-b9bf-aaef1a4a659e",
                        "glosses": [
                            "Animal vertébré tétrapode anamniote qui a la particularité de posséder deux « vies » : une première aquatique à l’état larvaire et une seconde terrestre à l’état adulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922a9de1-63c0-474f-9a72-ca3b792ad3fd",
                                "sense_id": "6bf08e4e-a2ab-3631-b390-e98d9a2e2553",
                                "text": "Ces nouveaux orifices respiratoires internes en position supra-glottique ne résultent pas d’un recul des orifices narinaires internes des dipneustes et des amphibiens."
                            },
                            {
                                "example_id": "65930cee-0245-498e-9f70-d07863017e3c",
                                "sense_id": "6bf08e4e-a2ab-3631-b390-e98d9a2e2553",
                                "text": "L’embryon était recroquevillé comme un amphibien, un œil braqué sur lui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c005d8e9-102a-41d5-a84a-dd4a7b070d9a",
                        "source_entry_id": "2fac1df2-e52c-3cb5-b9bf-aaef1a4a659e",
                        "source_sense_id": "6bf08e4e-a2ab-3631-b390-e98d9a2e2553",
                        "target_lang_word": "Amphibie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amphibie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d1b0e3-da19-3874-9a47-356e2d22b85f",
                                        "entry_id": "a3090d38-3db2-365f-8395-f97ea0821081",
                                        "glosses": [
                                            "Tier aus der Klasse Amphibia, das im Lebens- und Jahresverlauf sowohl aquatische wie terrestrische Lebensräume bewohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1240be94-6e78-4056-a6f1-024807c5c607",
                                                "sense_id": "d4d1b0e3-da19-3874-9a47-356e2d22b85f",
                                                "text": "Amphibien fehlen nur in den ariden Zonen der Erde."
                                            },
                                            {
                                                "example_id": "8cc56838-ff65-4ef9-a4c1-fbfbd2c99708",
                                                "sense_id": "d4d1b0e3-da19-3874-9a47-356e2d22b85f",
                                                "text": "Die Erdkröte ist die am häufigsten anzutreffende Amphibie in Deutschland."
                                            },
                                            {
                                                "example_id": "9617e5a8-3034-46c6-abed-4632c8e85899",
                                                "sense_id": "d4d1b0e3-da19-3874-9a47-356e2d22b85f",
                                                "text": "„Amphibien haben im Grunde in Finnland die gleichen Probleme.“"
                                            },
                                            {
                                                "example_id": "0b5cd57b-6524-4810-891a-919ddaf03ca2",
                                                "sense_id": "d4d1b0e3-da19-3874-9a47-356e2d22b85f",
                                                "text": "„Unter ihm lag der Sandstrand, rechts von der Mündung und einer Ansammlung von Felsbrocken begrenzt, die zur Hälfte vom Meer bedeckt waren und wie eine Gruppe ruhender Amphibien aussahen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f790e30b-95b4-49ee-943f-c40dc1c9f334",
                        "source_entry_id": "2fac1df2-e52c-3cb5-b9bf-aaef1a4a659e",
                        "source_sense_id": "6bf08e4e-a2ab-3631-b390-e98d9a2e2553",
                        "target_lang_word": "Lurch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
