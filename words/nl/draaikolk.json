    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97ab561c-1820-3fa3-8a62-b6ca6cdf23d5",
                    "sense_definition": "een cirkelvormige en neerwaartse beweging in een vloeistof zoals water",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waterbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De sterke stroming in de rivier veroorzaakte een gevaarlijke <w>draaikolk</w> nabij de brug.",
                            "target_lang_translations": {
                                "en": "The strong current in the river caused a dangerous <w>whirlpool</w> near the bridge."
                            }
                        },
                        {
                            "text": "Het water stroomde snel weg door het putje en vormde een kleine <w>draaikolk</w>.",
                            "target_lang_translations": {
                                "en": "The water drained away quickly through the plug hole and formed a small <w>vortex</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kolk",
                        "maalstroom"
                    ],
                    "common_phrases": [
                        "gevaarlijke draaikolk",
                        "grote draaikolk",
                        "draaikolk in water"
                    ],
                    "target_lang_definitions": {
                        "en": "a circular and downward movement in a liquid such as water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whirlpool",
                                "target_lang_sense_clarification": "a powerful circular current of water"
                            },
                            {
                                "target_lang_word": "vortex",
                                "target_lang_sense_clarification": "a mass of whirling fluid or air"
                            },
                            {
                                "target_lang_word": "eddy",
                                "target_lang_sense_clarification": "a circular movement of water counter to a main current"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eee3e524-5e47-3e04-a8f7-6060cbdbf87d",
                    "sense_definition": "een situatie of proces dat mensen of dingen onweerstaanbaar meesleurt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij raakte verstrikt in een <w>draaikolk</w> van emoties na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "He became entangled in a <w>whirlpool</w> of emotions after the bad news."
                            }
                        },
                        {
                            "text": "De stad kan je als een <w>draaikolk</w> opslokken als je niet oppast.",
                            "target_lang_translations": {
                                "en": "The city can swallow you up like a <w>maelstrom</w> if you are not careful."
                            }
                        }
                    ],
                    "synonyms": [
                        "maalstroom"
                    ],
                    "common_phrases": [
                        "draaikolk van emoties",
                        "draaikolk van geweld"
                    ],
                    "target_lang_definitions": {
                        "en": "a situation or process that irresistibly drags people or things along"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whirlpool",
                                "target_lang_sense_clarification": "figurative use for a chaotic or overwhelming situation"
                            },
                            {
                                "target_lang_word": "maelstrom",
                                "target_lang_sense_clarification": "a powerful or violent whirlpool, often used figuratively"
                            },
                            {
                                "target_lang_word": "vortex",
                                "target_lang_sense_clarification": "a situation into which someone is drawn and cannot escape"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}