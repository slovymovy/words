                                            {
                                                "example_id": "b1e941d7-6175-497a-b1ec-65f5b4543f4a",
                                                "sense_id": "8b613a7f-be02-3a88-ab8b-c51108904883",
                                                "text": "„Die italienische Presseagentur ließ verlauten, der Mann sei kein Algerier. Die übrigen Verdächtigen sollen die algerische Staatsbürgerschaft besitzen.“"
                                            },
                                            {
                                                "example_id": "7875d507-aade-4fc3-a8bb-f0c9d2440358",
                                                "sense_id": "8b613a7f-be02-3a88-ab8b-c51108904883",
                                                "text": "Geboren als Franzose, ist er nun nach 20 Jahren endlich Algerier geworden."
                                            }
                                        ],
