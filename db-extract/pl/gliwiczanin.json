                        ],
                        "examples": [
                            {
                                "example_id": "96876e9a-39b9-410f-89a4-54b5a9d3ae99",
                                "sense_id": "59d7737b-9823-3c25-892c-3cdddb3f59a6",
                                "text": "Osiem lat więzienia grozi Maciejowi B., przedstawicielowi otwartego funduszu emerytalnego Norwich Union. Gliwiczanin m.in. usiłował pobrać prowizję od zawarcia umowy sporządzonej... bez wiedzy klienta.",
                                "translation": "Maciej B., a representative of the Norwich Union open pension fund, faces eight years in prison. Among other things, the inhabitant of Gliwice attempted to collect a commission on a contract drawn up... without the client's knowledge.",
                                "english": "Maciej B., a representative of the Norwich Union open pension fund, faces eight years in prison. Among other things, the inhabitant of Gliwice attempted to collect a commission on a contract drawn up... without the client's knowledge."
                            }
                        ]
