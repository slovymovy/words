                    "semantic_group_id": "departure_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn <w>vertrek</w> kwam nogal onaangekondigd en verraste iedereen.",
                            "target_lang_translations": {
                                "en": "His <w>departure</w> came rather unannounced and surprised everyone.",
                                "ru": "Его <w>отъезд</w> был довольно неожиданным и удивил всех.",
                                "pl": "Jego <w>odejście</w> było dość niespodziewane i zaskoczyło wszystkich.",
                                "de": "Sein <w>Abschied</w> kam ziemlich unangekündigt und überraschte alle.",
                                "fr": "Son <w>départ</w> a été plutôt soudain et a surpris tout le monde.",
                                "it": "La sua <w>partenza</w> è stata piuttosto improvvisa e ha sorpreso tutti.",
                                "cs": "Jeho <w>odchod</w> byl dosti nečekaný a všechny překvapil.",
                                "tr": "Onun <w>ayrılışı</w> oldukça habersiz oldu ve herkesi şaşırttı.",
                                "es": "Su <w>salida</w> fue bastante inesperada y sorprendió a todos."
                            }
                        },
                        {
                            "text": "Het vliegtuig is helemaal klaar voor <w>vertrek</w> naar het zuiden.",
                            "target_lang_translations": {
                                "en": "The plane is completely ready for <w>departure</w> to the south.",
                                "ru": "Самолет полностью готов к <w>отправлению</w> на юг.",
                                "pl": "Samolot jest całkowicie gotowy do <w>odlotu</w> na południe.",
                                "de": "Das Flugzeug ist völlig bereit für den <w>Abflug</w> nach Süden.",
                                "fr": "L'avion est tout à fait prêt pour le <w>départ</w> vers le sud.",
                                "it": "L'aereo è completamente pronto per la <w>partenza</w> verso il sud.",
                                "cs": "Letadlo je zcela připraveno k <w>odletu</w> na jih.",
                                "tr": "Uçak, güneye <w>kalkış</w> için tamamen hazır.",
                                "es": "El avión está completamente listo para la <w>partida</w> hacia el sur."
                            }
                        }
