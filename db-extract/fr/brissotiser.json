                        "entry_id": "241a543d-8f88-3e33-a460-94aeb10d3c0c",
                        "glosses": [
                            "Rapprocher des idées de Jacques Pierre Brissot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b237c73a-c791-42cf-9459-1e9444b96e4f",
                                "sense_id": "43841747-4cd0-3415-bc36-84b9c490a409",
                                "text": "La société résiste aux insinuations de celle de Pui-l'Evêque, département de Lot, qui a tenté tous les moyens humainement possibles pour la brissotiser."
                            },
                            {
                                "example_id": "21b031f2-e0bb-482f-beb1-5b19806d9449",
                                "sense_id": "43841747-4cd0-3415-bc36-84b9c490a409",
                                "text": "Continue de publier que toute la nation, excepté une douzaine de tes bons amis, est feuillantisée, brissotisée, girondisée ;"
                            }
                        ]
                    }
