        "ru-extract.jsonl": [
            {
                "entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                "word": "вконец",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                        "entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                        "glosses": [
                            "совершенно, совсем, окончательно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306aa123-79ff-45bd-9c88-a6ec30bbefa0",
                                "sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                                "text": "Вконец измучился."
                            },
                            {
                                "example_id": "95ba8f15-d4a8-440e-81d1-f2721e7c105f",
                                "sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                                "text": "Вконец расстроился."
                            },
                            {
                                "example_id": "69b1703f-a6a7-4c75-874c-5c4a30302b61",
                                "sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                                "text": "Вконец разорюсь!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f1716f1-f272-476b-8baa-05ebe170bf0d",
                        "source_entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                        "source_sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                        "target_lang_word": "completely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "In a complete manner; thoroughly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef0e07a-86f1-4c4b-b8ea-dd67121cec32",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Please completely fill in the box for your answer, using a number 2 pencil."
                                            },
                                            {
                                                "example_id": "bc5853fb-b049-4275-b1c1-b1490997c41b",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "I will have completely finished my degree by next July, when my thesis has been properly edited."
                                            },
                                            {
                                                "example_id": "d43b1f8e-e132-46b0-8d56-f64952f8e530",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "It should not have been omitted that previous to completely stripping the body of the leviathan, he was beheaded."
                                            },
                                            {
                                                "example_id": "c3c37d13-9a2d-47c4-a772-ceb61c44a5bd",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "She completely abandoned her Tuesdays at home, and did not return the visits of those who had called upon her."
                                            },
                                            {
                                                "example_id": "fa3892a0-d491-4f94-a747-371556908c5e",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Lieutenant (junior grade) KERRY immediately maneuvered his craft through several strafing runs which completely silenced the enemy."
                                            },
                                            {
                                                "example_id": "17a3b433-3441-46b0-84e9-784d726ef42a",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "To the fullest extent or degree; totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59585da3-49e8-4d49-8f1c-d93feb4eb04b",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "He is completely mad."
                                            },
                                            {
                                                "example_id": "3b0f2f43-1c7d-47fa-8130-7d1202d6bddd",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "42630122-febf-46fe-af3e-0d94e0c8b1d7",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "Our future may lie beyond our vision, but it is not completely beyond our control."
                                            },
                                            {
                                                "example_id": "f9ba36d2-d4c2-47e3-a0f1-dd6ae8191e76",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "1975, Helen Schucman, A Course in Miracles/Workbook for Students, Lesson 75: The light has come,\nKeep a completely open mind, washed of all past ideas and clean of every concept you have made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f157b72d-ba70-4da9-bf9c-e12dcbaa10f0",
                        "source_entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                        "source_sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                        "target_lang_word": "finally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At the end or conclusion; ultimately."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac4885f8-0eed-452f-a3aa-6f284a654ca1",
                                                "sense_id": "15585502-d934-3723-843e-72858195c54a",
                                                "text": "The contest was long, but the Romans finally conquered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "At bottom; ultimately; when all is considered."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df087c1d-5fbd-4fbb-8a4d-8d3b0a8a2390",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "In a world in which \"like singing,/ the next day's shriek for ease rises,\" in a world whose \"survivors\" are \"capable of any cry, never done/ clasping in the city's shaken places,\" it is perhaps not surprising to find a dehumanizing but finally protective system of alienation imposing itself."
                                            },
                                            {
                                                "example_id": "6f64760b-5409-406a-bd47-50839ce0edf1",
                                                "sense_id": "11e99bdb-7c55-31fa-9bf4-6c01e81189cf",
                                                "text": "Cyberneticism is, finally, a refined form of scientism, and therefore it is also more dangerous. This form of scientism is not based on linear causality, as mechanistic thought is; rather, it is based on circular causality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "To finish (with); lastly (in the present)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "sequence"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "875b37ec-bba3-41ca-8867-2ffd6e05b11b",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "At any other time Jessamy would have laughed at the expressions that chased each other over his freckled face: crossness left over from his struggle with the baby; incredulity; distress; and finally delight."
                                            },
                                            {
                                                "example_id": "8df4194e-2089-4c1b-8b70-30bedc67125f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I washed my dog."
                                            },
                                            {
                                                "example_id": "2fad7140-79ff-4eb0-9a5f-6ac67fb4182a",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "Finally, I'd like to thanks all the people who helped to make it this far."
                                            },
                                            {
                                                "example_id": "477d690b-7350-4ee0-84a9-8a77f5d0780f",
                                                "sense_id": "8015577e-c50f-3823-b7f2-66b2b90d8795",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                        "entry_id": "d37be823-e8fc-39e4-9fbe-2b8caf36b196",
                                        "glosses": [
                                            "Definitively, comprehensively."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4d0e58-62b6-421d-bdba-f19368c907f4",
                                                "sense_id": "a0af31ed-438a-3ab2-97d2-690363be8622",
                                                "text": "The question of his long-term success has now been finally settled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e749441b-1273-4ce3-ae74-75756d2cfb76",
                        "source_entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                        "source_sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                        "target_lang_word": "utterly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "utterly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                        "entry_id": "7ecf6a8f-bd7a-30f3-adb2-6cfd72e17686",
                                        "glosses": [
                                            "Completely; entirely; to the fullest extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8f6137b-8541-4050-a535-f0463471a9ca",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "Well, now we are utterly lost."
                                            },
                                            {
                                                "example_id": "00e43d21-bdff-44c8-8dfe-080f73555d69",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "I have failed you utterly."
                                            },
                                            {
                                                "example_id": "2a847c47-db00-4c97-ad67-b0d9f2d1def9",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "An utterly emphatic 5-0 victory was ultimately capped by two wonder strikes in the last two minutes from Aston Villa midfielder Gary Gardner. Before that, England had utterly dominated to take another purposeful stride towards the 2013 European Championship in Israel. They have already established a five-point buffer at the top of Group Eight."
                                            },
                                            {
                                                "example_id": "609a0305-08a3-4f1c-aaaa-3990cbb9f24d",
                                                "sense_id": "223ceaa8-09c8-3ad6-abcd-a2bf9c347c1b",
                                                "text": "Scott, somewhat stunned and now worried that everybody might have opened fire at the U.S. destroyers (he presumably missed Laffey and Farenholt merrily blazing away with their own guns into the darkness), ordered all firing to cease after a couple of minutes. Helena, along with Boise, was already several hundred shells lighter, and both Boise and San Francisco herself actually kept firing, as their captains were utterly sure about their targets; San Francisco's captain was very apologetic as he overruled Admiral Scott."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70ad7743-04b3-486a-b49e-8be0abfac6ce",
                        "source_entry_id": "2bd939cf-8f05-3fb0-92f1-bc523ebdfd49",
                        "source_sense_id": "7bbad0b6-653b-3de8-9e20-b4bcdbc96df5",
                        "target_lang_word": "vollends",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vollends",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                        "entry_id": "58fa7dbb-ec00-372a-98ac-eb9be1478695",
                                        "glosses": [
                                            "ohne Ausnahme, ohne Einschränkung, in vollem Umfang"
                                        ],
                                        "tags": [
                                            "in Hinblick auf einen Rest, etwas noch Verbliebenes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f7ff0da-b641-486b-b746-9e60f3abe3f0",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Man würde sie wahrscheinlich morgen schon aus dem Bompard zurück in ein endgültiges Lager schicken, dort würde sie rasch vollends zerfallen.“"
                                            },
                                            {
                                                "example_id": "565ea9dd-fcc1-402c-8f8a-949e96bd63a2",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Die Spannung entwich vollends, und an ihrer Stelle strömte ein ungeheurer Jubel in seine Brust.“"
                                            },
                                            {
                                                "example_id": "f1fb0104-a5da-4a6d-a781-34f57727166e",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Er dankte ihr, indem er sich vollends zu ihr umwandte, seine Arme um sie schlang und lange unersättlich blieb.“"
                                            },
                                            {
                                                "example_id": "127f828a-aed3-4e30-ad69-7c49fe4c0b5c",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„An dieser Stelle war Roberts Irrtum vollends klar.“"
                                            },
                                            {
                                                "example_id": "e657d80e-b890-49f2-98c3-f6ea880e761b",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Ich ließ ihn liegen, alles andere hätte ihn vollends umgebracht.“"
                                            },
                                            {
                                                "example_id": "6d986dbf-279a-4176-95dc-b01f8d44139c",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Ein loderndes Feuer und der Duft des bratenden Truthahns erweckten uns vollends zu neuem Leben.“"
                                            },
                                            {
                                                "example_id": "39b812bb-4ef0-48ee-b6ea-843a6ea325eb",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Er griff wieder zum Schraubenzieher und löste das Brett vollends von den Seitenbrettern.“"
                                            },
                                            {
                                                "example_id": "771cfc10-0000-402f-b646-5c094e5cdf47",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Nach der Pause, etliche waren nicht mehr auf ihren Platz zurückgekehrt, siechte das Stück vollends dahin.“"
                                            },
                                            {
                                                "example_id": "daa02913-8a86-4f0b-9efc-942b9c31f3f4",
                                                "sense_id": "e6760577-3aeb-3853-9f63-e9577cef4572",
                                                "text": "„Richard wohnt ja nun in dieser inzwischen schon zwei Jahre alten Zukunft und weiß daher, dass Libyen seit dem Sturz Gaddafis durch die verschiedenen Milizen, deren Ziele niemand mehr durchschaut, vollends in ein Schlachtfeld verwandelt worden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                        "entry_id": "58fa7dbb-ec00-372a-98ac-eb9be1478695",
                                        "glosses": [
                                            "darüber hinaus (noch), erst recht, noch dazu"
                                        ],
                                        "tags": [
                                            "bezeichnet eine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b9ed51-252f-43ad-b0ff-1d6404f97b7d",
                                                "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                                "text": "„Im Großen vollends geht es nicht anders zu.“"
                                            },
                                            {
                                                "example_id": "b1b5c7d5-25b7-415e-83fe-28c92053d935",
                                                "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                                "text": "„Die offizielle Kunst des alten Reichs stellt den Gott stets als Leiche dar, in Mumienbinden gehüllt, ja das mittlere Reich, vollends die Spätzeit hat dann sogar noch Ptah, den höchsten Gott, eingeschreint.“"
                                            },
                                            {
                                                "example_id": "c3d8cf65-4e87-4d5d-b97e-5db8a4055224",
                                                "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                                "text": "„Ich kann das nicht mehr ertragen, vollends jetzt nicht, wo fast alles, was der König tut, einem die Brust beklemmt … ich schlag dem Faß den Boden ein!“"
                                            },
                                            {
                                                "example_id": "03aa5faa-892a-4fdd-b0f7-7b5b62bb1a1e",
                                                "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                                "text": "„Dann wäre er vor ihr hergerannt, sicher, daß sie ihm folgte, vollends hin zum Schilf und durchs Schilf durch und hin zu der Stelle, wo im letzten Sommer das Boot angetrieben worden war, in dem Elsa und Valentin gekentert waren.“"
                                            },
                                            {
                                                "example_id": "12f6f422-ef76-44c6-9235-c765a1f0d601",
                                                "sense_id": "6055f5ca-37a4-3f9d-a371-40e38193cf9f",
                                                "text": "„Ich habe zum Beispiel immer vermieden, die Schüler zum Unterrichtsbeginn als Gruppe, gar mit einer Ziffer zu begrüßen, vollends, wenn ich nicht vorher jeden einzelnen begrüßt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
