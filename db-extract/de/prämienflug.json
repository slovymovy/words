                "senses": [
                    {
                        "sense_id": "c7394e9b-eeab-357e-90a5-77057fcf6250",
                        "entry_id": "47cc05d1-f148-36df-8b98-82f5e2e8baa9",
                        "glosses": [
                            "Flug, der gänzlich oder teilweise mit den im Rahmen eines Vielfliegerprogramms gesammelten Prämienmeilen bezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3d465a0-751e-4506-b7d4-c672128606ec",
                                "sense_id": "c7394e9b-eeab-357e-90a5-77057fcf6250",
                                "text": "„Alitalia bietet auf ihren Flügen eine unglaubliche Meilenausbeute von bis zu 40 Prozent der für einen Prämienflug auf derselben Strecke benötigten Meilen.“"
                            },
                            {
                                "example_id": "e0c0cc44-85de-4344-a8a8-a419a46ee766",
                                "sense_id": "c7394e9b-eeab-357e-90a5-77057fcf6250",
                                "text": "„Schon für 7.500 Prämienmeilen können Fluggäste einen einfachen Prämienflug einlösen.“"
                            },
                            {
                                "example_id": "0b6db653-b2f8-447e-9060-441bffec3941",
                                "sense_id": "c7394e9b-eeab-357e-90a5-77057fcf6250",
                                "text": "„Bei Lufthansa sammeln Sie mit jeder Reise Bonusmeilen. Wie Sie diese für einen Prämienflug am besten einsetzen, erfahren Sie in diesem Praxistipp.“"
                            },
                            {
                                "example_id": "bab718f3-2e9c-4f2f-b60d-4287bf45339f",
                                "sense_id": "c7394e9b-eeab-357e-90a5-77057fcf6250",
                                "text": "„Vielen ist nicht bewusst, dass wenn Sie einen Prämienflug mit gesammelten Miles & More Meilen bezahlen, trotzdem die Steuern und Gebühren für diesen Flug zu zahlen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
