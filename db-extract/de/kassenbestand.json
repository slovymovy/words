                    {
                        "sense_id": "2ba7fdc6-124b-39ce-bfa7-bc60ee79ac0c",
                        "entry_id": "de952904-9687-3b9a-849c-a7c0dd521758",
                        "glosses": [
                            "Gesamtheit der in einer Kasse vorhandenen Zahlungsmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7c2d5b-68e7-4f41-aa0e-414eca7965f6",
                                "sense_id": "2ba7fdc6-124b-39ce-bfa7-bc60ee79ac0c",
                                "text": "„Wenig überraschend machen die Sozialausgaben mit zuletzt 2,4 Mrd. Euro pro Jahr die größte Position im Wiener Budget aus. Für den Kassenbestand verheerend ist jedoch, dass dieser traditionell kostenintensive Sektor im untersuchten Zeitraum auch besonders stark wuchs, und zwar um 95,4 Prozent.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
