                "senses": [
                    {
                        "sense_id": "1d1a7778-96c7-3158-b4f2-bb2d1ecaeed7",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "transitif"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "39a7e399-6851-3930-82e3-24b36d174e7d",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "transitif",
                            "Posséder sexuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f444af47-3e5a-4818-9e0c-4b6146af6325",
                                "sense_id": "39a7e399-6851-3930-82e3-24b36d174e7d",
                                "text": "On veut tout chibrer tout de suite, toutes les nanas qui se présentent, tout croquer, défoncer tous les pucelages."
                            },
                            {
                                "example_id": "74104c93-43bd-4ee8-ba5d-e33fed76390d",
                                "sense_id": "39a7e399-6851-3930-82e3-24b36d174e7d",
                                "text": "Tu verras qu'l'golf miniature à madame s'est transformé en vélodrome ! La prochain' fois qu'tu vas la chibrer, t'auras l'sentiment d'courir les six jours d'Grenob'."
                            }
                        ]
                    },
                    {
                        "sense_id": "73e13c9c-2b55-3028-9a07-7a0173ddab85",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "transitif",
                            "Manquer, rater, avoir effectué une piètre performance"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7199a29f-18fd-42ca-b70d-c586734e0477",
                                "sense_id": "73e13c9c-2b55-3028-9a07-7a0173ddab85",
                                "text": "Je n'ai pas intérêt à chibrer mes oraux, sinon, je devrai faire 5/2."
                            }
                        ]
                    },
                    {
                        "sense_id": "c02d4cb9-8620-32f3-8bc1-213f222167d1",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "intransitif"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ed877031-4b76-3242-b732-c5409880123a",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "intransitif",
                            "Jouer au jeu de chibre."
                        ],
                        "tags": [
                            "Cartes à jouer",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "4085489b-4aa1-4334-84d6-e34ca5250ec0",
                                "sense_id": "ed877031-4b76-3242-b732-c5409880123a",
                                "text": "Quand je rentre en Suisse, j’essaie de grignoter des caraques mais aussi de réunir quelques personnes pour pouvoir goûter au bonheur de chibrer, poser des atouts et observer l’étrange notation en Z des points, que je n’ai à ma grande tristesse jamais comprise."
                            }
                        ]
                    },
                    {
                        "sense_id": "41b57548-36e1-336d-bd51-3ef1c89bd89c",
                        "entry_id": "1cfa07e4-811d-31f8-b080-18a9b70e52ed",
                        "glosses": [
                            "intransitif",
                            "Laisser, dans une partie de chibre, son partenaire choisir l'atout."
                        ],
                        "tags": [
                            "Cartes à jouer",
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "b142c8a7-525a-46e2-8374-9ab894ca1c8c",
                                "sense_id": "41b57548-36e1-336d-bd51-3ef1c89bd89c",
                                "text": "Le but du chibre est d'atteindre 1000 points. Pour la première donne, c'est le joueur possédant le 7 de carreau qui commence la partie et choisit l'atout ou chibre. Dans ce dernier cas, son partenaire lui indiquera simplement la couleur choisie. Ensuite, c'est le joueur qui se trouve à droite de celui qui a fait atout de choisir à son tour l'atout ou de chibrer, et ainsi de suite."
                            }
                        ]
                    }
