                        "examples": [
                            {
                                "example_id": "c4a522df-dddc-4432-8767-53210ccb03e5",
                                "sense_id": "6f603539-bca0-3951-96f5-4cf17504f608",
                                "text": "„In Kiew lässt der Konvertit nun alle heidnischen Götterbilder und Statuen zerschlagen oder ins Feuer werfen und befiehlt zudem seinen Untertanen, sich am Ufer des Dnjepr zu einer Massentaufe einzufinden.“"
                            },
                            {
                                "example_id": "99995621-2553-4b86-92ef-9ee5acd1c803",
                                "sense_id": "6f603539-bca0-3951-96f5-4cf17504f608",
                                "text": "„In der Günter-Klotz-Anlage fand am Sonntag bei strömenden Regen eine Massentaufe mit über 100 Täuflingen statt.“"
                            }
                        ],
