{
    "word_family": [
        "pezen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d62d0858-1549-32e8-a0cc-834711df0b23",
                    "sense_definition": "Een uitloper van spierweefsel die de spier aanhecht aan het bot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>pees</w> in mijn enkel is ontstoken door het hardlopen.",
                            "target_lang_translations": {
                                "en": "The <w>tendon</w> in my ankle is inflamed from running."
                            }
                        },
                        {
                            "text": "Bij een zware blessure kan een <w>pees</w> volledig afscheuren.",
                            "target_lang_translations": {
                                "en": "In a severe injury, a <w>tendon</w> can tear completely."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tough band of fibrous tissue that connects a muscle to a bone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tendon",
                                "target_lang_sense_clarification": "The standard anatomical term for the tissue connecting muscle to bone."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "458911b2-1c7c-3cfd-90c3-a353f4f962ca",
                    "sense_definition": "Een taaie, vezelige structuur in het lichaam, ook wel sinew genoemd.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vlees was erg taai door de vele <w>pezen</w> die erin zaten.",
                            "target_lang_translations": {
                                "en": "The meat was very tough because of the many <w>sinews</w> in it."
                            }
                        },
                        {
                            "text": "De <w>pees</w> verbindt de spier met het bot voor beweging.",
                            "target_lang_translations": {
                                "en": "The <w>tendon</w> connects the muscle to the bone for movement."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A tough, fibrous structure in the body, often found in meat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sinew",
                                "target_lang_sense_clarification": "Often used to describe tough, fibrous tissue in meat or anatomy."
                            },
                            {
                                "target_lang_word": "gristle",
                                "target_lang_sense_clarification": "Commonly used to describe tough, chewy parts in meat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3a02492-d2d2-3076-a7fa-ff97d9507eb3",
                    "sense_definition": "De snaar van een boog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wapens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boogschutter spande de <w>pees</w> van zijn boog aan.",
                            "target_lang_translations": {
                                "en": "The archer tightened the <w>bowstring</w> of his bow."
                            }
                        },
                        {
                            "text": "De <w>pees</w> knapte plotseling tijdens het richten.",
                            "target_lang_translations": {
                                "en": "The <w>bowstring</w> snapped suddenly while aiming."
                            }
                        }
                    ],
                    "synonyms": [
                        "boogpees",
                        "boogstreng"
                    ],
                    "target_lang_definitions": {
                        "en": "The string of a bow used for archery."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bowstring",
                                "target_lang_sense_clarification": "The specific string used on a bow."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11d3f717-55f4-30cd-981e-9637bc06a161",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>pee</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de tuin groeien verschillende soorten <w>pezen</w>.",
                            "target_lang_translations": {
                                "en": "Different types of <w>carrots</w> grow in the garden."
                            }
                        },
                        {
                            "text": "De boer oogstte de <w>pezen</w> voor de winter.",
                            "target_lang_translations": {
                                "en": "The farmer harvested the <w>carrots</w> for the winter."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Wordt soms gebruikt als synoniem voor wortel in bepaalde regio's."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural of 'pee', a regional term for a carrot."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "carrots",
                                "target_lang_sense_clarification": "Regional synonym for the root vegetable."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d4762411-87b1-3b6c-87bf-bd9c7b63fffa",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>pezen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>pees</w> de hele dag door om het werk af te krijgen.",
                            "target_lang_translations": {
                                "en": "I <w>toil</w> all day long to get the work finished."
                            }
                        },
                        {
                            "text": "Elke dag <w>pees</w> ik hard voor mijn studie.",
                            "target_lang_translations": {
                                "en": "Every day I <w>grind</w> hard for my studies."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Betekent hard werken."
