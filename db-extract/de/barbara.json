                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae88e93-4116-460e-ad99-ec7adfc0bd9f",
                                                "sense_id": "979d7e03-7af8-30bc-a508-85ec379ac984",
                                                "text": "Mam na imię Barbara i pracuję w kopalni doświadczalnej na Górnym Śląsku."
                                            },
                                            {
                                                "example_id": "d1a8bfae-2fd2-4034-91ab-ba9d62ce0160",
                                                "sense_id": "979d7e03-7af8-30bc-a508-85ec379ac984",
                                                "text": "W Kościele katolickim na 4 grudnia przypada wspomnienie św. Barbary z Nikomedii, patronki górników i artylerzystów."
                                            },
                                            {
                                                "example_id": "ef1a374d-aaeb-4c79-9267-f4f8952fddad",
                                                "sense_id": "979d7e03-7af8-30bc-a508-85ec379ac984",
                                                "text": "Część łożyska w tym miejscu była zarośnięta i okryta kwitnącymi nenufarami, które bardzo się podobały pannie Barbarze"
                                            },
                                            {
                                                "example_id": "f7414658-a7b3-44f4-88aa-450b0bc02b04",
                                                "sense_id": "979d7e03-7af8-30bc-a508-85ec379ac984",
                                                "text": "Zygmunt II August, król polski i wielki książę litewski, poślubił potajemnie Barbarę Radziwiłłównę."
                                            },
                                            {
                                                "example_id": "75df0194-6507-4dbd-82c2-14d3c3942b0f",
                                                "sense_id": "979d7e03-7af8-30bc-a508-85ec379ac984",
                                                "text": "Barbary dzień swej patronki, czyli imieniny, obchodzą 4 grudnia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "343cfcb3-2d0b-3f69-bfbb-96be3b326a2d",
                                        "entry_id": "e1469e01-03ce-37d7-b828-23c589909f7b",
                                        "glosses": [
                                            "planetoida o numerze katalogowym 234"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaed6c94-a2b7-4c0e-9c96-b3021383f501",
                                                "sense_id": "343cfcb3-2d0b-3f69-bfbb-96be3b326a2d",
                                                "text": "Barbara porusza się w obszarze między orbitami Marsa i Jowisza, czyli w pasie głównym planetoid."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
