                        "target_lang_word": "Abiologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abiologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43f539b5-c07f-3127-8069-57a4c8696b2c",
                                        "entry_id": "ff5967ef-50b1-3b56-88fe-008aa8f38b2c",
                                        "glosses": [
                                            "ungebräuchlich, historisch: Gesamtwissenschaft von der unbelebten Natur (u. a. Mineralogie, Geologie, Meteorologie)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592e32a8-38fa-425d-9eb0-6024120dbbce",
                                                "sense_id": "43f539b5-c07f-3127-8069-57a4c8696b2c",
                                                "text": "„Die Abiologie oder Anorganologie, die Anorganen-Lehre, ist die Gesammtwissenschaft von den Anorganismen (Abien) oder den sogenannten ‚leblosen‘ Naturkörpern, Mineralien, Wasser, atmosphärischer Luft etc. Wie diese beiden Hauptzweige der irdischen Naturwissenschaft, welche ihren gesammten Inhalt bilden, Biologie und Abiologie, sich coordinirt gegenüber stehen, so werden wir auch zwischen den ihnen subordinirten Disciplinen eine Parallele herstellen können, welche uns für die Werthschätzung und Rangordnung der einzelnen Zweige einen schätzenswerthen Maassstab liefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
