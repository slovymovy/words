                        {
                            "trait_type": "form",
                            "comment": "plural noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тарелки, миски, чашки и другие предметы, используемые для еды или сервировки стола.",
                        "zh": "指用于进餐或盛放食物的盘子、碗、杯子等餐具。"
                    },
