                        "target_lang_word": "nuque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nuque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3da4e9ef-d1d0-3ec6-8b10-b620b5b13c26",
                                        "entry_id": "50a1a76c-ab92-355c-8c74-35084f53fc5a",
                                        "glosses": [
                                            "Partie dorsale du cou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c02f3047-208f-4fc6-aa59-204446d8bd8c",
                                                "sense_id": "3da4e9ef-d1d0-3ec6-8b10-b620b5b13c26",
                                                "text": "Ses regards inspectèrent la salle et, finalement, se fixèrent sur la grosse nuque puissante de Feempje."
                                            },
                                            {
                                                "example_id": "5cd8ca2e-6138-4ba8-a3a2-528c5b88fad1",
                                                "sense_id": "3da4e9ef-d1d0-3ec6-8b10-b620b5b13c26",
                                                "text": "Elle marcha très lentement par la chambre, les mains croisées autour de la nuque, toute à la volupté d'appliquer sur les dalles ses pieds nus où la sueur se glaçait."
                                            },
                                            {
                                                "example_id": "1db816e0-8800-429f-a34d-c7262a2e3750",
                                                "sense_id": "3da4e9ef-d1d0-3ec6-8b10-b620b5b13c26",
                                                "text": "Une blonde qui possédait des nichons et une nuque inoubliables a cru bon de venir rompre le silence de l'écran par une chanson où il était question de sa solitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7563033c-9672-363a-ba84-6a50b039383f",
                                        "entry_id": "50a1a76c-ab92-355c-8c74-35084f53fc5a",
                                        "glosses": [
                                            "Partie de la chevelure à l’arrière du cou."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2933da71-f389-4f2b-bce4-c6dcb2486982",
                                                "sense_id": "7563033c-9672-363a-ba84-6a50b039383f",
                                                "text": "Elle se coiffait avec le chignon haut, selon la mode d’alors, et ses cheveux d’un blond sombre moussaient sur sa nuque. (Cette merveille oubliée aujourd’hui : une nuque mousseuse.)"
                                            },
                                            {
                                                "example_id": "fee88286-4686-4989-8d99-00be93a8b659",
                                                "sense_id": "7563033c-9672-363a-ba84-6a50b039383f",
                                                "text": "Quant à la nuque elle est dégradée de haut en bas, sans effilage, elle comporte 3 ou 4 étages, l'ensemble pourrait être signé monsieur de Paris car le bourreau doit préparer d'une manière analogue la chevelure de ceux qui sont promis à la veuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1826a7-88b8-338e-b5b5-2085e6aa5c9b",
                                        "entry_id": "50a1a76c-ab92-355c-8c74-35084f53fc5a",
                                        "glosses": [
                                            "Partie arrière de la tourelle d’un char."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf1ab71-64aa-40a0-add9-022f1559ba1b",
                                                "sense_id": "2e1826a7-88b8-338e-b5b5-2085e6aa5c9b",
                                                "text": "Sur les modèles américains et européens, les obus sont stockés dans la nuque du char, à l’extérieur de la tourelle, séparés des opérateurs par une paroi blindée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
