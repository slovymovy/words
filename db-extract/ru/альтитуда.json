                "senses": [
                    {
                        "sense_id": "561e9b0d-9370-3f88-ac19-6c4f085bc428",
                        "entry_id": "47051841-ad0c-3638-9ac8-052fc9cd3f99",
                        "glosses": [
                            "геогр. высота точки земной поверхности над уровнем океана"
                        ],
                        "tags": [],
