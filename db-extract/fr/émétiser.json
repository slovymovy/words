                "senses": [
                    {
                        "sense_id": "2df06c34-6fd4-32e0-8e62-11fd87cccecc",
                        "entry_id": "85e3c679-9b1d-3ffa-afb6-d7673102a643",
                        "glosses": [
                            "Administrer un émétique à (quelqu’un) pour le faire vomir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61883fd4-d8b5-4723-8c02-e1a72ede6eaf",
                                "sense_id": "2df06c34-6fd4-32e0-8e62-11fd87cccecc",
                                "text": "Ce ne fut qu’à cette époque qu’on appela un chirurgien de la ville voisine, qui jugea convenable d’émétiser la malade, et ensuite de la purger."
                            }
                        ]
                    },
                    {
                        "sense_id": "add34180-1c90-31ee-88a2-2da55001baa5",
                        "entry_id": "85e3c679-9b1d-3ffa-afb6-d7673102a643",
                        "glosses": [
                            "Ajouter un émétique à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9ee8e40-7348-4185-a805-eb0a4333c108",
                                "sense_id": "add34180-1c90-31ee-88a2-2da55001baa5",
                                "text": "Il est vrai qu’hier soir dans la chambre de Votre Majesté, le docteur m’a entretenu de la nécessité d’émétiser les boissons qui lui seraient présentées, sans l’en instruire, mais je croyais l’en avoir dissuadé en lui disant qu’il ne pouvait se permettre un acte de cette nature auprès de Votre Majesté."
                            }
                        ]
                    }
                ],
