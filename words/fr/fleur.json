                {
                    "sense_id": "ca67d5cc-549d-3089-a094-6c8e9a3405c1",
                    "sense_definition": "Organe reproducteur des plantes à fleurs, souvent coloré et parfumé, composé notamment de pétales, d'étamines et de carpelles.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fleur_plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a cueilli une <w>fleur</w> rouge dans le jardin de sa grand-mère."
                        },
                        {
                            "text": "Cette <w>fleur</w> sent très bon au printemps."
                        },
                        {
                            "text": "Les abeilles vont d'une <w>fleur</w> à l'autre pour récolter le pollen."
                        }
                    ],
                    "common_phrases": [
                        "cueillir une fleur",
                        "bouquet de fleurs",
                        "fleur des champs",
                        "fleurs séchées"
                    ]
                },
