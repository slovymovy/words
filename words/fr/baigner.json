{
    "word_family": [
        "baignade",
        "baigneur",
        "baigneuse",
        "baignoire",
        "bain"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bfd920c-9303-3f41-a21e-d22bc77fa0a1",
                    "sense_definition": "Entrer dans l'eau pour nager, se détendre ou se laver.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "immersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances d'été, nous aimons nous <w>baigner</w> dans le lac chaque après-midi."
                        },
                        {
                            "text": "L'eau de la mer est trop froide aujourd'hui pour se <w>baigner</w> sans combinaison."
                        }
                    ],
                    "common_phrases": [
                        "se baigner dans la mer",
                        "se baigner dans un lac"
                    ]
                },
                {
                    "sense_id": "d191e2b1-ead4-3cb5-ba52-ad518ca15d65",
                    "sense_definition": "Plonger le corps de quelqu'un ou un animal dans l'eau pour le laver ou le soigner.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "immersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents doivent <w>baigner</w> leur jeune enfant tous les soirs avant le coucher."
                        },
                        {
                            "text": "Le vétérinaire conseille de <w>baigner</w> le chien avec ce produit spécial une fois par mois."
                        }
                    ],
                    "synonyms": [
                        "tremper"
                    ],
                    "common_phrases": [
                        "baigner un enfant"
                    ]
                },
                {
                    "sense_id": "521c34e3-01df-34ad-aff1-34000efdc590",
                    "sense_definition": "Se dérouler parfaitement ; aller très bien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'inquiète pas pour les préparatifs de la fête, tout <w>baigne</w>."
                        },
                        {
                            "text": "Depuis qu'il a changé de poste, tout <w>baigne</w> dans sa vie professionnelle."
                        }
                    ],
                    "common_phrases": [
                        "tout baigne"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "35d89f8d-fc92-3c90-b640-2760728a81b3",
                    "sense_definition": "Être immergé complètement ou reposer dans un liquide.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "immersion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier laisse <w>baigner</w> les morceaux de viande dans une marinade épicée."
                        },
                        {
                            "text": "Les olives doivent <w>baigner</w> dans l'huile d'olive pour conserver toute leur saveur."
                        }
                    ],
                    "synonyms": [
                        "tremper"
                    ],
                    "common_phrases": [
                        "baigner dans l'huile"
                    ]
                },
                {
                    "sense_id": "0c208b78-dd76-39e9-80c1-e6425935d5d8",
                    "sense_definition": "Border ou longer une terre en parlant d'une étendue d'eau.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'océan Atlantique <w>baigne</w> les côtes occidentales de la France et de la péninsule Ibérique."
                        },
                        {
                            "text": "Un magnifique fleuve tranquille <w>baigne</w> les remparts de cette vieille cité médiévale."
                        }
                    ],
                    "common_phrases": [
                        "baigner les côtes"
                    ]
                },
                {
                    "sense_id": "f0ec4c4f-dce9-3156-bdd4-c2eeee0fc644",
                    "sense_definition": "Envelopper une personne ou un lieu, en parlant de lumière, d'air ou d'une ambiance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil couchant <w>baigne</w> tout le salon d'une douce lueur dorée."
                        },
                        {
                            "text": "Cette maison de campagne <w>baigne</w> dans une tranquillité particulièrement reposante."
                        }
                    ],
                    "common_phrases": [
                        "baigner dans la lumière"
                    ]
                },
                {
                    "sense_id": "2a01b59e-0172-3e25-98ab-73e8c8212d44",
                    "sense_definition": "Être couvert d'une très grande quantité de sang à la suite d'une grave blessure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les secours ont découvert la victime qui <w>baignait</w> dans son sang sur le trottoir."
                        },
                        {
                            "text": "Après ce choc violent, le soldat blessé <w>baignait</w> dans son sang en attendant l'ambulance."
                        }
                    ],
                    "common_phrases": [
                        "baigner dans son sang"
                    ]
                },
                {
                    "sense_id": "8127fdb1-2515-333c-bc8b-b4dc68700992",
                    "sense_definition": "Inonder ou mouiller abondamment une surface de larmes ou de sueur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des larmes abondantes <w>baignaient</w> le visage de la mère lorsqu'elle a retrouvé son fils."
                        },
                        {
                            "text": "L'athlète épuisé par l'effort intense <w>baignait</w> son front d'une sueur glacée."
                        }
                    ],
                    "common_phrases": [
                        "baigner de larmes"
                    ]
                }
            ]
        }
    ]
}