                "senses": [
                    {
                        "sense_id": "06611507-32fd-38fb-84fc-e251ce581115",
                        "entry_id": "72a4fa8b-57ca-302b-a48c-6bf7e8fcf651",
                        "glosses": [
                            "anerkannte Bestleistung eines afrikanischen Sportlers in einer bestimmten Disziplin zu einem bestimmten Zeitpunkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721f698c-c0d2-4fce-9029-f28f119d66d7",
                                "sense_id": "06611507-32fd-38fb-84fc-e251ce581115",
                                "text": "„Doch erst nachdem sie aus ihrer 400 Kilometer entfernten Heimatstadt Constantine nach Algier umgezogen war, um dort bei Amar Bouras im olympischen Trainingszentrum zu trainieren, stieß sie 1990 zur Weltspitze vor und brach mit 4:05,20 Minuten den Afrikarekord über 1500 Meter.“"
                            },
                            {
                                "example_id": "d56924fd-48bf-468b-9e24-cef56d2dfc59",
                                "sense_id": "06611507-32fd-38fb-84fc-e251ce581115",
                                "text": "„Im Finale landete Fraser-Pryce in 10,95 Sekunden allerdings nur auf Platz fünf, den Sieg sicherte sich die Nigerianerin Blessing Okagbare mit Afrikarekord von 10,79 Sekunden.“"
                            },
                            {
                                "example_id": "6bb27c38-b1d5-4c55-a1cc-f55b227079dc",
                                "sense_id": "06611507-32fd-38fb-84fc-e251ce581115",
                                "text": "„Die Bedingungen stimmten, in 1:41,01 lief er beim Meeting in der 47.000-Einwohner-Stadt in Mittelitalien um exakt eine Sekunde schneller als vor einem Jahr, als er in Rieti den 25 Jahre alten Afrikarekord seines Landsmanns Sammy Koskei brach.“"
                            },
                            {
                                "example_id": "a662cf9a-bd18-4f53-8f24-eedb8ab6ea7d",
                                "sense_id": "06611507-32fd-38fb-84fc-e251ce581115",
                                "text": "„Am Freitag waren die Ränge voller enthusiastischer Menschen, und die Athleten boten Sport vom Feinsten. Etwa der Kenyaner Asbel Kiprop, der über 1500 m mit der Aura eines Regenten auftrat und in 3:29,18 siegte. Oder dessen Landsfrau Hellen Obiri, die im 3000-m-Lauf die im Vorfeld gehypte Äthiopierin Genzebe Dibaba zuerst arbeiten liess und dann in 8:20,68 zum Afrikarekord stürmte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
