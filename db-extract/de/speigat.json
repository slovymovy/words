                "senses": [
                    {
                        "sense_id": "ab9d9ab5-7041-38d4-aa93-8ef33c96b4ce",
                        "entry_id": "4d02d628-e7af-3bb4-bcfc-0c860f8d5bcf",
                        "glosses": [
                            "Ablauf auf einem Schiffsdeck durch den das Wasser nach Außenbord oder in die Bilge ablaufen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6cc1b5c-346d-4fe0-812d-fc25362fa319",
                                "sense_id": "ab9d9ab5-7041-38d4-aa93-8ef33c96b4ce",
                                "text": "„Nicht ganz so einfach verhält es sich mit der Decksbucht (engl. = camber), der queren Wölbung des Decks, welche die Längsstabilität der Konstruktion verbessert und den Wasserabfluss zu den Speigats sicherstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fa769a5-d085-44bd-9443-5b2716aba1db",
                        "source_entry_id": "4d02d628-e7af-3bb4-bcfc-0c860f8d5bcf",
                        "source_sense_id": "ab9d9ab5-7041-38d4-aa93-8ef33c96b4ce",
                        "target_lang_word": "scupper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scupper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84e93d99-7cd0-30e8-bd64-eebb2129f341",
                                        "entry_id": "eda0f888-9b0b-3b4a-b693-691be7b18728",
                                        "glosses": [
                                            "A drainage hole on the deck of a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c054d02-7979-38c6-b2fd-0cc055a682f5",
                                        "entry_id": "eda0f888-9b0b-3b4a-b693-691be7b18728",
                                        "glosses": [
                                            "A similar opening in a wall or parapet that allows water to drain from a roof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1e00517-0cfc-41bd-ad3b-3ec6fffb6c2e",
                                                "sense_id": "0c054d02-7979-38c6-b2fd-0cc055a682f5",
                                                "text": "I have said that our roof was decidedly Biblical in style; but to make it a dry one, something of a nautical character was added to its architecture, for on either side were scuppers, and it was slightly arched in the centre[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scupper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                        "entry_id": "374aa621-dca8-3262-bc47-516b295eb693",
                                        "glosses": [
                                            "To thwart or destroy, especially something belonging or pertaining to another."
                                        ],
                                        "tags": [
                                            "UK",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f060adbe-5777-4a46-9be2-883bf9f72146",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "The bad media coverage scuppered his chances of being elected."
                                            },
                                            {
                                                "example_id": "77a89d9f-b9d7-42af-a83b-fce4c312889a",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "[\"]The only chance was to get the guns and try a rescue. Of course they may scupper them at once in revenge.[\"]"
                                            },
                                            {
                                                "example_id": "03ac9fd6-ce22-499c-a631-34b40988f780",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "This is the face of American exceptionalism[…] threatening to scupper both the court and, failing that, UN peace-keeping operations in Bosnia and anywhere else the US might have forces deployed on such work."
                                            },
                                            {
                                                "example_id": "2f028d9f-9dd8-4fd1-a9b0-03d436c9826b",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "Anthony Watson’s late interception and Owen Farrell’s 100% kicking contribution also helped scupper the Wallabies, despite the promise of their exciting new centre Jordan Petaia and the roadrunner pace of winger Marika Koroibete."
                                            },
                                            {
                                                "example_id": "abc139a3-5a82-4790-a66f-0b65f23d3cfa",
                                                "sense_id": "35491bdc-3dd4-394d-8f8f-b783503ad8d4",
                                                "text": "Pacers should have all been withdrawn by now, but that has been scuppered by a failure to deliver new trains on time and delays to infrastructure projects. The most high-profile withdrawals were to be Northern's Class 142s and '144s' (the latter by the end of 2018, and the '142s' by the end of last year)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
