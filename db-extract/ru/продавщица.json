                    {
                        "translation_id": "81ff1e63-fa83-4837-b6cc-f6fe384ec0b3",
                        "source_entry_id": "865259ab-879b-3215-9247-0a85b1a7085f",
                        "source_sense_id": "7bb76aa2-5d0e-30a7-a1af-3b48af2ddee7",
                        "target_lang_word": "Verkäuferin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkäuferin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8f5dfa-8d79-3df1-908a-875ecdeb432f",
                                        "entry_id": "4db0e8c8-3e7a-38ef-92da-72efaa65d16d",
                                        "glosses": [
                                            "weibliche Person, die etwas verkauft (hat)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e11ecb73-5bbb-4098-b8c8-d8c4939a8fb5",
                                                "sense_id": "2a8f5dfa-8d79-3df1-908a-875ecdeb432f",
                                                "text": "Die Verkäuferin wusste schon, warum sie den Wagen loswerden wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                        "entry_id": "4db0e8c8-3e7a-38ef-92da-72efaa65d16d",
                                        "glosses": [
                                            "weiblicher berufsmäßiger Verkäufer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "570fa4cd-3a5b-44c5-bd99-994947075566",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "Sie ist Verkäuferin beim Modehaus Puvogel."
                                            },
                                            {
                                                "example_id": "ed83f000-10b0-4837-ac6b-2d5e4a11ad17",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                                            },
                                            {
                                                "example_id": "02ad4c61-b585-4bca-ba59-f96cc7fe3335",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Du gehst hinein, und die Verkäuferin schaut dich forschend an.“"
                                            },
                                            {
                                                "example_id": "fe69b797-1bac-4f98-9315-1f87d0023a3c",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Eine Verkäuferin steht hinter der Kasse, auf die wir zusteuern.“"
                                            },
                                            {
                                                "example_id": "49e344d1-beb4-4c7d-acfb-f87ed72734a5",
                                                "sense_id": "0b300780-88d0-3241-bf58-d545ce21d810",
                                                "text": "„Die Verkäuferin betrachtet ihre Fingernägel und pustet über der Stirn eine splissige Haarsträhne hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
