                "senses": [
                    {
                        "sense_id": "28fa51fd-0a2c-3c0d-b015-6bf65880bc50",
                        "entry_id": "2d6fcd35-f8e3-3ff0-8494-a08e0e95dcea",
                        "glosses": [
                            "gedrehter Gesichtsbart an Oberlippe und/oder Kinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a163d778-01da-4808-a078-f81e926c2d68",
                                "sense_id": "28fa51fd-0a2c-3c0d-b015-6bf65880bc50",
                                "text": "„Der erste, dem Range nach, war General von Rossow, ein hochschultriger Herr mit dünnem Schnurr- und noch dünnerem Knebelbart, dazu braunem Teint und roten vorstehenden Backenknochen; nach Rossow folgte: von Kraczinski, Kriegsministerialoberst und polnisch-katholisch, Geheimrat Hedemeyer, hager, spitznasig und süffisant, Sanitätsrat Wandelstern, fanatischer Anti-Schweninger, und Frau Baronin von Snatterlöw.“"
                            },
                            {
                                "example_id": "03d5c22a-9b95-4004-8aef-bcae71d62b81",
                                "sense_id": "28fa51fd-0a2c-3c0d-b015-6bf65880bc50",
                                "text": "„Deutschlands Krieger waren von riesigem Wuchs, mit wunderlichen Helmen mit Spitzen oben, wie Spieße geformt, und hatten Knebelbärte, die Widderhörnern glichen.“"
                            },
                            {
                                "example_id": "d43aedad-67cb-47aa-a654-250b02612e2d",
                                "sense_id": "28fa51fd-0a2c-3c0d-b015-6bf65880bc50",
                                "text": "„Herr Nels, der Hotelbesitzer, der einen Knebelbart im Stil Napoleons III. trug und in Lothringen gelebt hatte, erzählte mir, er erinnere sich, früher hätten alle Männer die Haare lang getragen und erst die Preußen hätten sich die Haare kurz schneiden lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
