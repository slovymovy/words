                "senses": [
                    {
                        "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                        "entry_id": "66f82672-ed6c-3066-89ee-7aaafaeeb936",
                        "glosses": [
                            "weibliche Person, die eine Diskussion, Veranstaltung oder eine Sendung moderiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60cbb13-c09f-4bc1-8909-4d2eee1d5dc7",
                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                "text": "Die Moderatorin kündigte die nächste Musikgruppe an."
                            },
                            {
                                "example_id": "98622eb6-ab14-4667-9ffb-bc8382c87952",
                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                "text": "„Die Frage der Moderarorin, ob es sich um einen Anschlag handele und wer ihn ausgeführt habe, beantwortete der Reporter ausweichend.“"
                            },
                            {
                                "example_id": "94bf51da-6cf7-4b1e-9649-491fa9f40a47",
                                "sense_id": "c0ebeab2-c1d0-3b07-a8ae-ce4501df7087",
                                "text": "„Einmal war ich mit meinen Witzen zum Frühstücksfernsehen bei SAT.1 eingeladen und lernte dort eine besonders gewitzte und gut aussehende Moderatorin, Simone Panteleit, kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
