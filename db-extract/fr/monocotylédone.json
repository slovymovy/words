                                        "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                        "entry_id": "9a22cc82-08c6-36e7-9eb0-a7613fb76949",
                                        "glosses": [
                                            "Of or pertaining to a flowering plant having a seed with one embryonic leaf (a single cotyledon)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c54d47f-4cb8-4a2b-9c32-b86cac0e64d1",
                                                "sense_id": "67ebd837-31fb-3473-920d-b350b1be271e",
                                                "text": "Strange to say, the islet of Ronde, about 16 miles north of Mauritius, forms a separate biological kingdom, possessing one peculiar species of cabbage-palm, some lizards, two snakes, and relatively more monocotyledonous plants than any other region in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce21e7bc-471b-4914-9f50-61c1e8824d90",
