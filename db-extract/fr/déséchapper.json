                "senses": [
                    {
                        "sense_id": "2d99667b-ea7b-3e3d-ae85-6a2d0dc57ecd",
                        "entry_id": "02450cf6-db21-3e06-9cec-8ca21d27b98b",
                        "glosses": [
                            "Ne plus échapper (des caractères)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a42a8bc5-7356-4a3f-973f-8944ad0d030d",
                                "sense_id": "2d99667b-ea7b-3e3d-ae85-6a2d0dc57ecd",
                                "text": "Les cinq caractères XML spéciaux (recensés ci-dessous) peuvent être échappés et déséchappés avec les références d'entité correspondantes (recensées ci-dessous) en marquant un bloc de texte et en sélectionnant la commande de menu contextuel Échapper les caractères XML ou Déséchapper caractères XML."
                            },
                            {
                                "example_id": "68bb0b5d-60a1-4fe7-8e3c-d7c78830abaf",
                                "sense_id": "2d99667b-ea7b-3e3d-ae85-6a2d0dc57ecd",
                                "text": "Existe-t-il une fonction C # qui pourrait être utilisée pour échapper et déséchapper une chaîne, qui pourrait être utilisée pour remplir le contenu d’un élément XML?"
                            },
                            {
                                "example_id": "af247ba2-26e1-4f5b-b146-05fddf066501",
                                "sense_id": "2d99667b-ea7b-3e3d-ae85-6a2d0dc57ecd",
                                "text": "Comment déséchapper des caractères spéciaux en Javascript qui ont déjà été échappés par StringEscapeUtils.escapeHtml ()?"
                            },
                            {
                                "example_id": "913f51c1-90bd-464f-90c2-9de71317d7ef",
                                "sense_id": "2d99667b-ea7b-3e3d-ae85-6a2d0dc57ecd",
                                "text": "L'outil peut alors échapper le code source si l'utilisateur clique sur le bouton Échap ou déséchapper la source si le bouton Unescape est enfoncé."
                            }
                        ]
                    }
