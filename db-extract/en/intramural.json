                                        "glosses": [
                                            "Qui est caché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554947fe-0ce4-416d-9d77-a344cdffc310",
                                                "sense_id": "99baf936-5df9-31fd-ad39-d0312997a51d",
                                                "text": "Boutons internes : ceux qui restent cachés jusqu’à l’époque du bourgeonnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79db84fa-459a-3302-ac6c-ddfd9ce2a980",
