                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be998e77-4ce1-4236-8397-a364984966b3",
                                "sense_id": "83f20a35-737c-32f9-88c6-b04d3a5031e6",
                                "text": "Dans le récipient où se fait le trempage, tourne constamment un agiteur à palettes qui remue l’enduit, et ne laisse pas le pigment coloré se déposer au fond"
                            },
                            {
                                "example_id": "1e4f4dc2-012a-49f5-b8d7-db529c3cabea",
                                "sense_id": "83f20a35-737c-32f9-88c6-b04d3a5031e6",
                                "text": "[…] on régularise enfin l’étendage avec un agiteur coudé ; avoir soin de verser toujours de très bas et très doucement la mixtion gélatinée […]."
                            },
                            {
                                "example_id": "b57ce4bf-88ba-44f0-aa37-2d05cfda9661",
                                "sense_id": "83f20a35-737c-32f9-88c6-b04d3a5031e6",
                                "text": "Probablement le fameux agiteur russe , le comte Vladimir A. Bobrinsk."
                            }
                        ]
                    }
