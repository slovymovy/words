                    ]
                },
                {
                    "sense_id": "f044bdb6-b7c9-33fb-b99e-173a76819969",
                    "sense_definition": "Weibliche Person, die eine bestimmte Denkrichtung, Kunstströmung oder Theorie befürwortet und vertritt.",
