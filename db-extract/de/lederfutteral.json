                        "examples": [
                            {
                                "example_id": "78672a31-786b-499e-be67-bd0d2e2502e6",
                                "sense_id": "dc174707-cad7-3f18-9f2a-2a62daff7600",
                                "text": "„Er ließ das kleine Lederfutteral an seinem Gürtel aufschnappen, nahm sein Messer heraus, stand auf und zog abermals sein Hemd aus.“"
                            },
                            {
                                "example_id": "83b6bf4b-d772-47f4-96fe-66bfab8760e8",
                                "sense_id": "dc174707-cad7-3f18-9f2a-2a62daff7600",
                                "text": "„Mit seiner freien Hand suchte er Taschen und Gürtel des Fettsacks ab, zog eine Brieftasche, ein Springmesser und ein kleines, aber schweres Lederfutteral mit Reißverschluss heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
