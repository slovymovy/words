                                        "entry_id": "c15ca727-648a-3f3f-9785-13211d6aeff5",
                                        "glosses": [
                                            "Adaptation d’un récit ou d’un matériau narratif à la forme dramatique (dialogues, scènes, mise en intrigue) pour la scène, la radio, la télévision ou le cinéma."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93c17c8f-d660-4206-8956-4515fc2053ff",
                                                "sense_id": "aa4a7413-040f-3225-9df8-76b38e08d326",
                                                "text": "La dramatisation d’épisodes de l’histoire sainte dans les mystères du Moyen Âge."
                                            },
                                            {
                                                "example_id": "8ee35b7a-0d1d-4c5f-a480-eec811fabc15",
                                                "sense_id": "aa4a7413-040f-3225-9df8-76b38e08d326",
                                                "text": "La dramatisation d’un récit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff66ef3b-8463-36d5-9c79-072d333ea3b7",
                                        "entry_id": "c15ca727-648a-3f3f-9785-13211d6aeff5",
                                        "glosses": [
                                            "Procédé consistant à accentuer le caractère dramatique d’un fait ou d’un débat pour susciter l’émotion, l’indignation ou l’intérêt (proche de sensationalisme)."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec850b08-ed15-4c59-a9a0-88873d579585",
                                                "sense_id": "ff66ef3b-8463-36d5-9c79-072d333ea3b7",
                                                "text": "La dramatisation d’un incident par la presse."
                                            },
                                            {
                                                "example_id": "1e9b9ac8-393d-4070-9d1d-9d44083cc96d",
                                                "sense_id": "ff66ef3b-8463-36d5-9c79-072d333ea3b7",
                                                "text": "Pourquoi donc cette dramatisation aujourd’hui si ce n’est en raison des mutations importantes surgies de nos pouvoirs croissants et de nos incertitudes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c519cfc-25d3-316a-8887-d6375a3820cd",
                                        "entry_id": "c15ca727-648a-3f3f-9785-13211d6aeff5",
                                        "glosses": [
                                            "Tendance à surestimer la gravité des événements dans son appréciation personnelle (biais cognitif)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d38ca1c0-ec19-36c6-bfbd-f49ed2d10432",
                                        "entry_id": "c15ca727-648a-3f3f-9785-13211d6aeff5",
                                        "glosses": [
                                            "Activité d’apprentissage fondée sur la mise en scène ou le jeu de rôles pour travailler des situations, des textes ou des compétences langagières."
                                        ],
                                        "tags": [
                                            "Pédagogie"
                                        ],
