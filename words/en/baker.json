{
    "word_family": [
        "bake",
        "bakery",
        "baking",
        "bakehouse"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "31029b3c-91c5-3db3-8a21-4792e5ebe232",
                    "sense_definition": "A person who bakes and sells bread, cakes, and similar items.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "baking professional",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>baker</w> wakes up very early to prepare fresh bread for the morning.",
                            "target_lang_translations": {
                                "ru": "Местный <w>пекарь</w> встает очень рано, чтобы приготовить свежий хлеб к утру."
                            }
                        },
                        {
                            "text": "I asked the skilled <w>baker</w> to make a special cake for my daughter's birthday.",
                            "target_lang_translations": {
                                "ru": "Я попросил опытного <w>пекаря</w> испечь особенный торт на день рождения моей дочери."
                            }
                        }
                    ],
                    "synonyms": [
                        "baxter",
                        "dougher"
                    ],
                    "common_phrases": [
                        "skilled baker",
                        "local baker",
                        "master baker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который занимается выпечкой и продажей хлеба, кондитерских изделий и аналогичных товаров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пекарь",
                                "target_lang_sense_clarification": "тот, кто выпекает хлебные изделия"
                            },
                            {
                                "target_lang_word": "хлебопёк",
                                "target_lang_sense_clarification": "специалист по выпечке хлеба"
                            },
                            {
                                "target_lang_word": "булочник",
                                "target_lang_sense_clarification": "владелец булочной или тот, кто печет булки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87b9da0d-a0c0-3e49-9b13-6f6b4bf1bffb",
                    "sense_definition": "An apple specifically suitable for baking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baking fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These large green apples are excellent <w>bakers</w> because they hold their shape in the oven.",
                            "target_lang_translations": {
                                "ru": "Эти крупные зеленые яблоки — отличные <w>сорта для запекания</w>, потому что они сохраняют форму в духовке."
                            }
                        },
                        {
                            "text": "Wealthys and McIntoshes are not good <w>bakers</w> compared to Granny Smith apples.",
                            "target_lang_translations": {
                                "ru": "Сорта Уэлси и Макинтош не так <w>хороши для запекания</w>, как яблоки Гренни Смит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good baker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сорт яблок, специально предназначенный для запекания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яблоко для запекания",
                                "target_lang_sense_clarification": "кулинарный сорт"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b2c1041-ed1b-3d1e-b1d8-23022e2617c7",
                    "sense_definition": "A portable oven used for baking.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "baking equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campers used a small tin <w>baker</w> to cook biscuits over the fire.",
                            "target_lang_translations": {
                                "ru": "Туристы использовали небольшую жестяную <w>печку</w>, чтобы испечь печенье над костром."
                            }
                        },
                        {
                            "text": "This antique portable <w>baker</w> was once a common sight in rural kitchens.",
                            "target_lang_translations": {
                                "ru": "Эта старинная переносная <w>печь</w> когда-то была обычным явлением на сельских кухнях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "portable baker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносная печь, используемая для выпекания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переносная печь",
                                "target_lang_sense_clarification": "для выпечки"
                            },
                            {
                                "target_lang_word": "печка",
                                "target_lang_sense_clarification": "небольшое устройство для готовки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f77d60dc-847f-3d8e-8a8c-e4e109a9e51c",
                    "sense_definition": "A radiotelephony clear-code word representing the letter B.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "phonetic alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old radio alphabet, they used <w>Baker</w> instead of the modern Bravo.",
                            "target_lang_translations": {
                                "ru": "В старом радиоалфавите использовали слово <w>Бейкер</w> вместо современного Браво."
                            }
                        },
                        {
                            "text": "The signal was recorded as <w>Baker</w> Easy Able during the transmission.",
                            "target_lang_translations": {
                                "ru": "Во время передачи сигнал был записан как <w>Бейкер</w> Изи Эйбл."
                            }
                        }
                    ],
                    "synonyms": [
                        "Bravo"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "replaced by Bravo in the modern NATO phonetic alphabet"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кодовое слово в радиотелефонии, обозначающее букву B."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бейкер",
                                "target_lang_sense_clarification": "фонетический алфавит"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "764edda0-06e3-3995-beba-a33828fdea4e",
                    "sense_definition": "An English surname originating from the occupation of a <w>baker</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Baker</w> is our new history teacher at the high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Бейкер</w> — наш новый учитель истории в старшей школе."
                            }
                        },
                        {
                            "text": "The <w>Baker</w> family has lived in this neighborhood for three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Бейкер</w> живет в этом районе уже три поколения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "common English last name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от названия профессии пекаря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бейкер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4367e023-ad76-36a0-b4c9-98f7fa295f52",
                    "sense_definition": "A male given name transferred from the surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "given name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They decided to name their son <w>Baker</w> after his grandfather's maiden name.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать сына <w>Бейкер</w> в честь девичьей фамилии его дедушки."
                            }
                        },
                        {
                            "text": "Young <w>Baker</w> is starting his first day of kindergarten today.",
                            "target_lang_translations": {
                                "ru": "Юный <w>Бейкер</w> сегодня идет первый день в детский сад."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя, перешедшее из фамилии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бейкер",
                                "target_lang_sense_clarification": "личное имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d144dd49-a1c9-3529-971c-65af5a5b9246",
                    "sense_definition": "A city in the United States, such as the county seat of Fallon County, Montana.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We stopped for gas in <w>Baker</w> while driving across Montana.",
                            "target_lang_translations": {
                                "ru": "Мы остановились заправиться в <w>Бейкере</w>, когда ехали через Монтану."
                            }
                        },
                        {
                            "text": "The population of <w>Baker</w> increases slightly during the summer festival.",
                            "target_lang_translations": {
                                "ru": "Население <w>Бейкера</w> немного увеличивается во время летнего фестиваля."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в США, например, административный центр округа Фаллон, штат Монтана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Бейкер",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}