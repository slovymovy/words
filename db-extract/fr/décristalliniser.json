                "senses": [
                    {
                        "sense_id": "8061bbd3-bff7-32ee-8316-7bd4679ec73c",
                        "entry_id": "1e59b5c1-468f-34ca-b71a-b82325f231ae",
                        "glosses": [
                            "Faire perdre son caractère cristallin à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dfbf216-ce41-42b4-acdb-a57b7da54c59",
                                "sense_id": "8061bbd3-bff7-32ee-8316-7bd4679ec73c",
                                "text": "Cette seconde hydrolyse peut aussi être également dissociée en deux phases afin de décristalliniser la cellulose dans un premier temps grâce à un acide concentré puis de l’hydrolyser par un prétraitement plus doux à l’acide dilué."
                            },
                            {
                                "example_id": "5852b413-213d-47f7-b18b-d16022d66ca9",
                                "sense_id": "8061bbd3-bff7-32ee-8316-7bd4679ec73c",
                                "text": "Cette réaction qui a pour but de décristalliniser et de dissoudre la cellulose, s’effectue à 30°C pendant 60 minutes."
                            }
                        ]
                    }
