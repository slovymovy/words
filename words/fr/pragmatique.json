    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e3c49b8b-e8d4-333e-9811-444c09ecff64",
                    "sense_definition": "Qui s'adapte aux contraintes du réel et recherche l'efficacité concrète plutôt que la théorie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à cette situation imprévue, la directrice a proposé une solution <w>pragmatique</w>."
                        },
                        {
                            "text": "Ils ont adopté une approche <w>pragmatique</w> pour résoudre rapidement les difficultés techniques."
                        }
                    ],
                    "synonyms": [
                        "pratique",
                        "réaliste"
                    ],
                    "antonyms": [
                        "idéaliste",
                        "théorique",
                        "utopique"
                    ],
                    "common_phrases": [
                        "approche pragmatique",
                        "solution pragmatique"
                    ]
                },
                {
                    "sense_id": "7f16b246-1866-3707-a189-182f74a2319d",
                    "sense_definition": "Qui se rapporte à l'étude des énoncés en contexte ou à l'usage de la communication.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur étudie les compétences <w>pragmatiques</w> des jeunes enfants lors de leurs échanges."
                        },
                        {
                            "text": "Certaines difficultés de compréhension relèvent d'un problème de décodage <w>pragmatique</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4b7ebd0a-3473-3f40-9740-fe2c55dc99a9",
                    "sense_definition": "Personne guidée par le sens pratique et l'efficacité plutôt que par des principes théoriques.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pratique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un véritable <w>pragmatique</w> qui cherche toujours la méthode la plus directe."
                        },
                        {
                            "text": "En tant que <w>pragmatique</w>, elle refuse de perdre son temps avec des projets irréalisables."
                        }
                    ],
                    "synonyms": [
                        "réaliste"
                    ],
                    "antonyms": [
                        "idéaliste",
                        "rêveur"
                    ]
                },
                {
                    "sense_id": "40ad6ea8-4882-3730-8669-7e7e543b6191",
                    "sense_definition": "Discipline de la linguistique qui étudie l'utilisation du langage dans son contexte d'énonciation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>pragmatique</w> analyse la manière dont les locuteurs adaptent leurs propos aux circonstances."
                        },
                        {
                            "text": "Ce cours universitaire de linguistique accorde une place importante à la <w>pragmatique</w>."
                        }
                    ]
                }
            ]
        }
    ]
