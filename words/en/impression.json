{
    "word_family": [
        "impress",
        "impressive",
        "impressionable",
        "impressionism",
        "impressionist",
        "impressively",
        "unimpressed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5132ce0d-212b-324c-8b76-bcad9145c106",
                    "sense_definition": "The overall effect or feeling that something or someone leaves on a person",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dressed professionally because he wanted to make a good <w>impression</w> on his new boss.",
                            "target_lang_translations": {
                                "ru": "Он оделся профессионально, потому что хотел произвести хорошее <w>впечатление</w> на своего нового босса."
                            }
                        },
                        {
                            "text": "The first <w>impression</w> of the city was one of noise and crowded streets.",
                            "target_lang_translations": {
                                "ru": "Первое <w>впечатление</w> от города было связано с шумом и переполненными улицами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a good impression",
                        "first impression",
                        "lasting impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Общий эффект или чувство, которое что-то или кто-то оставляет у человека"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впечатление",
                                "target_lang_sense_clarification": "эффект, производимый на кого-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2b0da53-bb52-3e8a-b13e-012c43c4b419",
                    "sense_definition": "An idea, feeling, or opinion about something or someone, especially one formed without conscious thought",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have the <w>impression</w> that he is not telling us the whole truth about the accident.",
                            "target_lang_translations": {
                                "ru": "У меня такое <w>впечатление</w>, что он не говорит нам всей правды об аварии."
                            }
                        },
                        {
                            "text": "She was under the <w>impression</w> that the meeting had been cancelled.",
                            "target_lang_translations": {
                                "ru": "Она была под <w>впечатлением</w>, что встречу отменили."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have the impression",
                        "under the impression",
                        "get the impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея, чувство или мнение о ком-то или чем-то, особенно сформированное без сознательного обдумывания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впечатление",
                                "target_lang_sense_clarification": "мнение или ощущение"
                            },
                            {
                                "target_lang_word": "ощущение",
                                "target_lang_sense_clarification": "интуитивное чувство"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "понимание ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e094993-c3ec-3816-83b2-37df0fb302d4",
                    "sense_definition": "An imitation of a person's voice or mannerisms, usually for entertainment",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The comedian did a hilarious <w>impression</w> of the president during his stand-up routine.",
                            "target_lang_translations": {
                                "ru": "Комик сделал уморительную <w>пародию</w> на президента во время своего выступления."
                            }
                        },
                        {
                            "text": "He can do a great <w>impression</w> of his teacher that makes everyone laugh.",
                            "target_lang_translations": {
                                "ru": "Он умеет отлично <w>имитировать</w> своего учителя, что всех смешит."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do an impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подражание голосу или манерам человека, обычно в развлекательных целях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пародия",
                                "target_lang_sense_clarification": "комическое подражание"
                            },
                            {
                                "target_lang_word": "имитация",
                                "target_lang_sense_clarification": "воспроизведение манер или голоса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acc56d11-de4a-3d25-b64c-07ab8782261e",
                    "sense_definition": "A mark or indentation produced by pressure on a surface",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy suitcase left a deep <w>impression</w> in the soft carpet.",
                            "target_lang_translations": {
                                "ru": "Тяжелый чемодан оставил глубокую <w>вмятину</w> на мягком ковре."
                            }
                        },
                        {
                            "text": "The detective found a clear <w>impression</w> of a boot in the mud near the window.",
                            "target_lang_translations": {
                                "ru": "Детектив нашел четкий <w>отпечаток</w> ботинка в грязи у окна."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leave an impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "След или вмятина, оставленная давлением на поверхность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отпечаток",
                                "target_lang_sense_clarification": "след от надавливания"
                            },
                            {
                                "target_lang_word": "вмятина",
                                "target_lang_sense_clarification": "углубление на поверхности"
                            },
                            {
                                "target_lang_word": "след",
                                "target_lang_sense_clarification": "оставленный оттиск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7f33b27-cb22-32a5-8875-1bd240e87e6f",
                    "sense_definition": "An instance of a digital advertisement or post being displayed on a screen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "marketing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The marketing team analyzed the number of <w>impressions</w> the social media campaign received.",
                            "target_lang_translations": {
                                "ru": "Маркетинговая команда проанализировала количество <w>показов</w>, которые получила кампания в социальных сетях."
                            }
                        },
                        {
                            "text": "Each ad <w>impression</w> costs the company a small fraction of a cent.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>показ</w> рекламы обходится компании в малую долю цента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ad impression"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай отображения цифровой рекламы или поста на экране"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "в цифровом маркетинге"
                            },
                            {
                                "target_lang_word": "импрессия",
                                "target_lang_sense_clarification": "профессиональный термин в рекламе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bccf3dd-51d2-3011-a55a-c23a207f8f65",
                    "sense_definition": "All the copies of a book or publication printed at one time",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>impression</w> of the novel sold out within a week of its release.",
                            "target_lang_translations": {
                                "ru": "Первый <w>тираж</w> романа был распродан в течение недели после выхода."
                            }
                        },
                        {
                            "text": "Errors in the text were corrected for the second <w>impression</w> of the textbook.",
                            "target_lang_translations": {
                                "ru": "Ошибки в тексте были исправлены для второго <w>издания</w> учебника."
                            }
                        }
                    ],
                    "common_phrases": [
                        "first impression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Все экземпляры книги или издания, напечатанные за один раз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тираж",
                                "target_lang_sense_clarification": "количество напечатанных экземпляров"
                            },
                            {
                                "target_lang_word": "оттиск",
                                "target_lang_sense_clarification": "печатный экземпляр"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17fe3e58-e228-3d0b-a848-df9a1eade39f",
                    "sense_definition": "To mark a blank key by pressing it into a lock to determine the correct shape for a duplicate",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locksmithing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The locksmith began <w>impressioning</w> the key to help the owner get back into the house.",
                            "target_lang_translations": {
                                "ru": "Слесарь начал <w>делать слепок</w> ключа, чтобы помочь владельцу вернуться в дом."
                            }
                        },
                        {
                            "text": "He learned the skill of <w>impressioning</w> a lock during his vocational training.",
                            "target_lang_translations": {
                                "ru": "Он освоил навык <w>изготовления ключа по оттиску</w> замка во время профессионального обучения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Создание следа на заготовке ключа путем прижатия его к замку для определения формы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снятие слепка",
                                "target_lang_sense_clarification": "в слесарном деле"
                            },
                            {
                                "target_lang_word": "импрессинг",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                }
            ]
        }
