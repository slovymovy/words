                ],
                "senses": [
                    {
                        "sense_id": "22d17039-8ef4-3d82-8270-ed2a596db503",
                        "entry_id": "b26a5a20-5665-3886-8d19-b1a54d4ac8bf",
                        "glosses": [
                            "Lebewesen, dessen Habitat das offene Meer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3079f884-8520-4adb-a9c6-a0e2a38b6181",
                                "sense_id": "22d17039-8ef4-3d82-8270-ed2a596db503",
                                "text": "„Korallenriffe bestehen aus den kalkhaltigen Ausscheidungen von Korallen und anderen Meereslebewesen, sowie aus versteinerten Korallen, Schnecken, Muscheln und Seeigeln.“"
                            },
                            {
                                "example_id": "5264a9ae-097c-48ef-8ce9-957f39c5b624",
                                "sense_id": "22d17039-8ef4-3d82-8270-ed2a596db503",
                                "text": "„Um ein Massensterben von Meereslebewesen zu verhindern, sollten mindestens 30 Prozent der Weltmeere, die die verschiedenen Ökosysteme zu gleichen Teilen repräsentieren, für jegliche kommerzielle Nutzung gesperrt werden, raten Wissenschaftler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
