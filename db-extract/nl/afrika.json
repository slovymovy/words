                    {
                        "translation_id": "c4986489-46f0-4da3-97ef-3f836d58af16",
                        "source_entry_id": "8e03e459-0069-3cdb-9ac9-fdfc85b83098",
                        "source_sense_id": "98a82aae-3472-34b1-9e1d-30d919db2fb2",
                        "source_sense_description": "het continent ten zuiden van Europa, tussen de Indische en de Atlantische Oceaan.",
                        "target_lang_word": "Afrika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afrika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e30ce9-6d2d-3857-ab7d-df24fbc0d3a4",
                                        "entry_id": "6027d373-e13a-3ebe-8157-bc1e25179040",
                                        "glosses": [
                                            "ein Kontinent auf der nördlichen und südlichen Erdhalbkugel, südlich von Europa, südwestlich von Asien und östlich von Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0699796f-4cb7-4417-8252-1a4b1967ee20",
                                                "sense_id": "c2e30ce9-6d2d-3857-ab7d-df24fbc0d3a4",
                                                "text": "„Die hartnäckige Armut in Afrika ist für die meisten modernen ökonomischen Theorien nur schwer zu fassen und verursacht heftigste Debatten.“"
                                            },
                                            {
                                                "example_id": "592ec66f-be42-4c7e-9922-da9d84727d81",
                                                "sense_id": "c2e30ce9-6d2d-3857-ab7d-df24fbc0d3a4",
                                                "text": "„Im Zuge der Dekolonisation Afrikas wurden mehrere Staaten in den 1950er Jahren unabhängig.“"
                                            },
                                            {
                                                "example_id": "afcb1159-4d07-4056-a0d7-42d31ca594d6",
                                                "sense_id": "c2e30ce9-6d2d-3857-ab7d-df24fbc0d3a4",
                                                "text": "„Die Erforschung Afrikas orientierte sich lange an den kolonialen oder missionarischen Interessen der Europäer.“"
                                            },
                                            {
                                                "example_id": "cb2c8c50-0717-4a35-be31-68c158e22570",
                                                "sense_id": "c2e30ce9-6d2d-3857-ab7d-df24fbc0d3a4",
                                                "text": "„Auch wenn die Schätzungen zu Hebungen in Afrika sehr weit auseinandergehen, gibt es doch Hinweise darauf, dass zum Beispiel das Gebirgsgebiet Namibias, welches aktuell bis über 2000 Meter hoch aufragt, in den letzten 10 Millionen Jahren um etwa 1000 Meter angehoben wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe96b7cd-8f41-4f90-8889-7cfee2f4b081",
                        "source_entry_id": "8e03e459-0069-3cdb-9ac9-fdfc85b83098",
                        "source_sense_id": "98a82aae-3472-34b1-9e1d-30d919db2fb2",
