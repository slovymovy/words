{
    "word_family": [
        "paganisme",
        "paganiser",
        "néopaïen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7edb2196-d12e-3343-8cb4-88872cf8f16e",
                    "sense_definition": "Relatif au paganisme, aux religions polythéistes de l'Antiquité ou à leurs survivances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "paganisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses coutumes de carnaval trouvent leur origine dans d'anciennes fêtes <w>païennes</w>."
                        },
                        {
                            "text": "Ce monument servait autrefois à célébrer un culte <w>païen</w> avant l'arrivée du christianisme."
                        }
                    ],
                    "synonyms": [
                        "polythéiste",
                        "idolâtre"
                    ],
                    "antonyms": [
                        "chrétien",
                        "monothéiste"
                    ],
                    "common_phrases": [
                        "fêtes païennes",
                        "traditions païennes",
                        "rites païens"
                    ]
                },
                {
                    "sense_id": "bb94da40-977e-36d6-954b-f2c72ba8ba2a",
                    "sense_definition": "Qui manque de piété ou refuse les préceptes de la religion ; impie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le curé du village considérait son voisin comme un esprit <w>païen</w> en raison de son détachement."
                        },
                        {
                            "text": "Dans ce roman, le protagoniste adopte une attitude <w>païenne</w> face aux dogmes moraux de son époque."
                        }
                    ],
                    "synonyms": [
                        "impie",
                        "mécréant",
                        "athée"
                    ],
                    "antonyms": [
                        "pieux",
                        "croyant"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0421a217-5c6d-359b-a761-a231d92b3ccc",
                    "sense_definition": "Adepte d'une religion polythéiste, particulièrement dans le monde gréco-romain antique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "paganisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>païens</w> honoraient plusieurs divinités pour protéger les récoltes et les foyers."
                        },
                        {
                            "text": "L'empereur romain accorda aux chrétiens les mêmes droits civiques qu'aux <w>païens</w>."
                        }
                    ],
                    "synonyms": [
                        "polythéiste",
                        "idolâtre"
                    ],
                    "antonyms": [
                        "chrétien",
                        "monothéiste"
                    ]
                },
                {
                    "sense_id": "4f0d4823-6921-3cb4-93f6-194a38c6a014",
                    "sense_definition": "Personne qui ne croit pas ou dont la conduite est jugée contraire aux mœurs religieuses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa grand-mère le traitait de <w>païen</w> car il refusait d'aller à la messe le dimanche."
                        },
                        {
                            "text": "Ces aventuriers vivaient comme de véritables <w>païens</w>, sans aucun respect pour la morale établie."
                        }
                    ],
                    "synonyms": [
                        "mécréant",
                        "impie"
                    ],
                    "antonyms": [
                        "croyant",
                        "fidèle"
                    ]
                }
            ]
        }
    ]
}