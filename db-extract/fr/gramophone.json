        "fr-extract.jsonl": [
            {
                "entry_id": "c9f3c717-da05-3f7f-b781-ad6227f25165",
                "word": "gramophone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3c405161-1089-4cb6-927d-b557a8c7276a",
                        "entry_id": "c9f3c717-da05-3f7f-b781-ad6227f25165",
                        "tags": [
