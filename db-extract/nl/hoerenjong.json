                                        "entry_id": "3c1f2daf-1d20-3b82-92e3-17db4f0b9813",
                                        "glosses": [
                                            "An objectionable, despicable person."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "usually",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3db7ed03-2ebd-4205-8eeb-888f1357e7bc",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "My mother never saw the irony in calling me a son of a bitch."
                                            },
                                            {
                                                "example_id": "20a9ed03-e766-45d7-993c-1ef1529d735a",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "Those sons of bitches don’t stand a chance."
                                            },
                                            {
                                                "example_id": "5276a4aa-8cf3-4d56-935b-46f166807a3d",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "There's that snarling cur, and son of a Bitch Boccaline."
                                            },
                                            {
                                                "example_id": "d435ef18-be9d-4721-9ab7-a6aacfdf9a6c",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "He had the insolence obliquely to give me the name of Son of a Bitch."
                                            },
                                            {
                                                "example_id": "1c6eacd3-bbd7-42ae-ac1b-6c6517e5502b",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "[…] Count Davia, like a Son of a Bitch as he is, Chop'd upon mine and the Duke of Mantuu's Equipage, and rubb'd off with our Plate, Jewels, and other Knicknacks of Inestimable Value."
                                            },
                                            {
                                                "example_id": "80d3ba4e-d2eb-4727-9e08-fe4dc1f44433",
                                                "sense_id": "85403141-89af-394c-ab05-35ada5b2ec69",
                                                "text": "But ya ought to thank me, before I die / For the gravel in ya guts and the spit in ya eye / Because I'm the son-of-a-bitch that named you Sue"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dee9627-9e24-3d2d-a8fd-f0c7144c581a",
                                        "entry_id": "3c1f2daf-1d20-3b82-92e3-17db4f0b9813",
                                        "glosses": [
                                            "Any objectionable thing."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "offensive",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923f1026-fde5-4983-883b-29cf34381862",
                                                "sense_id": "8dee9627-9e24-3d2d-a8fd-f0c7144c581a",
                                                "text": "\"This son of a bitch won't move!\" Marty exclaimed as he grappled with the supermarket cart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21cbeea1-da63-37e0-a6d1-cc0f71b72133",
                                        "entry_id": "3c1f2daf-1d20-3b82-92e3-17db4f0b9813",
                                        "glosses": [
                                            "An impressive, daring, or admirable man."
                                        ],
                                        "tags": [
                                            "endearing",
                                            "humorous",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1b195e-509b-4e5a-97ba-3479aaddc474",
                                                "sense_id": "21cbeea1-da63-37e0-a6d1-cc0f71b72133",
                                                "text": "I quickly checked around and I found Simon, he was hit but landed on a dead horse, the lucky son of a bitch could have been dead but the animal absorbed his fall and now he was on the ground trying to stay alive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "250e0a2e-0852-3f46-b821-05caffe1cd24",
                                        "entry_id": "3c1f2daf-1d20-3b82-92e3-17db4f0b9813",
                                        "glosses": [
                                            "A suffering person deemed deserving of compassion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eadf05a-0e7c-4a85-890c-4e48b6d1fdd1",
                                                "sense_id": "250e0a2e-0852-3f46-b821-05caffe1cd24",
                                                "text": "That poor son of a bitch didn't even make it."
                                            }
                                        ]
