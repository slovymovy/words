{
    "word_family": [
        "pausal",
        "pauseless",
        "pausation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dbb8bd6e-55c0-3a28-a7c4-4765a59d6cd2",
                    "sense_definition": "To stop an activity for a short time before continuing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>paused</w> for a moment to catch his breath before running again.",
                            "target_lang_translations": {
                                "ru": "Он на мгновение <w>остановился</w>, чтобы перевести дух, прежде чем снова побежать.",
                                "zh": "他<w>停顿</w>了片刻，喘口气后再继续跑。"
                            }
                        },
                        {
                            "text": "The speaker <w>paused</w> to let the audience laugh at his joke.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>сделал паузу</w>, чтобы дать аудитории посмеяться над его шуткой.",
                                "zh": "演讲者<w>停顿</w>了一下，让观众笑完他的笑话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stop",
                        "halt",
                        "wait",
                        "break"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановиться на короткое время перед продолжением действия.",
                        "zh": "在继续之前短时间停止活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделать паузу",
                                "target_lang_sense_clarification": "прервать действие на время"
                            },
                            {
                                "target_lang_word": "остановиться",
                                "target_lang_sense_clarification": "прекратить движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "中断动作"
                            },
                            {
                                "target_lang_word": "停顿",
                                "target_lang_sense_clarification": "说话或动作的间歇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbce6c5c-d0ff-3f57-8e61-7e2ba873e502",
                    "sense_definition": "To temporarily stop the playback of a video, song, or game so that it can be resumed later.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>pause</w> the movie while I go to the kitchen.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>поставь на паузу</w> фильм, пока я схожу на кухню.",
                                "zh": "我去厨房时请把电影<w>暂停</w>。"
                            }
                        },
                        {
                            "text": "I <w>paused</w> the game to answer the phone call.",
                            "target_lang_translations": {
                                "ru": "Я <w>поставил на паузу</w> игру, чтобы ответить на звонок.",
                                "zh": "我把游戏<w>暂停</w>了去接电话。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Временно остановить воспроизведение видео, песни или игры.",
                        "zh": "暂时停止视频、歌曲或游戏的播放，以便稍后恢复。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить на паузу",
                                "target_lang_sense_clarification": "остановить воспроизведение"
                            },
                            {
                                "target_lang_word": "приостановить",
                                "target_lang_sense_clarification": "временно прекратить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "停止播放"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f756344-38e1-32e1-9e22-b96dd2917499",
                    "sense_definition": "To hesitate or hold back due to doubt or uncertainty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>paused</w> before answering the difficult question.",
                            "target_lang_translations": {
                                "ru": "Она <w>помедлила</w> перед тем, как ответить на сложный вопрос.",
                                "zh": "她在回答那个难题前<w>迟疑</w>了一下。"
                            }
                        },
                        {
                            "text": "The complexity of the problem made him <w>pause</w> and think.",
                            "target_lang_translations": {
                                "ru": "Сложность проблемы заставила его <w>остановиться</w> и подумать.",
                                "zh": "问题的复杂性让他<w>迟疑</w>并思考起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колебаться или медлить из-за сомнений или неуверенности.",
                        "zh": "因怀疑或不确定而犹豫或退缩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помедлить",
                                "target_lang_sense_clarification": "задержаться с ответом или действием"
                            },
                            {
                                "target_lang_word": "замешкаться",
                                "target_lang_sense_clarification": "проявить нерешительность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迟疑",
                                "target_lang_sense_clarification": "犹豫不决"
                            },
                            {
                                "target_lang_word": "犹豫",
                                "target_lang_sense_clarification": "拿不定主意"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48038ff7-fb23-38fc-98ab-aea92887b873",
                    "sense_definition": "A temporary stop or rest in an action or speech.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a long <w>pause</w> in the conversation while everyone thought.",
                            "target_lang_translations": {
                                "ru": "В разговоре возникла долгая <w>пауза</w>, пока все размышляли.",
                                "zh": "谈话中出现了一段长长的<w>停顿</w>，大家都在思考。"
                            }
                        },
                        {
                            "text": "After a brief <w>pause</w>, the music continued louder than before.",
                            "target_lang_translations": {
                                "ru": "После короткой <w>паузы</w> музыка продолжилась громче, чем раньше.",
                                "zh": "短暂的<w>停顿</w>后，音乐比之前更响亮地继续播放。"
                            }
                        }
                    ],
                    "synonyms": [
                        "break",
                        "interruption",
                        "respite",
                        "hiatus",
                        "recess",
                        "stop",
                        "gap"
                    ],
                    "antonyms": [
                        "finish"
                    ],
                    "common_phrases": [
                        "brief pause",
                        "long pause",
                        "pregnant pause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временная остановка или перерыв в действии или речи.",
                        "zh": "动作或言语中的暂时停止或休息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "затишье в речи или действии"
                            },
                            {
                                "target_lang_word": "перерыв",
                                "target_lang_sense_clarification": "интервал в работе"
                            },
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "короткий отдых"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停顿",
                                "target_lang_sense_clarification": "言语或动作的间歇"
                            },
                            {
                                "target_lang_word": "暂停",
                                "target_lang_sense_clarification": "短暂的停止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d70aa77a-a9d7-3555-a10d-a70d6b66a821",
                    "sense_definition": "A control or button used to temporarily stop media playback.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Press the <w>pause</w> button if you need to take a break.",
                            "target_lang_translations": {
                                "ru": "Нажми кнопку <w>паузы</w>, если тебе нужно сделать перерыв.",
                                "zh": "如果你需要休息，请按<w>暂停键</w>。"
                            }
                        },
                        {
                            "text": "I hit <w>pause</w> on the remote control so we could talk.",
                            "target_lang_translations": {
                                "ru": "Я нажал <w>паузу</w> на пульте, чтобы мы могли поговорить.",
                                "zh": "我按了遥控器上的<w>暂停键</w>，这样我们就能谈话了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "press pause",
                        "hit pause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кнопка или элемент управления для временной остановки воспроизведения.",
                        "zh": "用于暂时停止媒体播放的控件或按钮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пауза",
                                "target_lang_sense_clarification": "кнопка или режим"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暂停键",
                                "target_lang_sense_clarification": "控制播放的按钮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2889bf3c-566e-3188-8150-8a3504816651",
                    "sense_definition": "A feeling of hesitation, suspense, or doubt that causes one to stop and think.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The serious allegations gave the committee members <w>pause</w>.",
                            "target_lang_translations": {
                                "ru": "Серьезные обвинения заставили членов комитета <w>задуматься</w>.",
                                "zh": "这些严重的指控让委员会成员产生了<w>顾虑</w>。"
                            }
                        },
                        {
                            "text": "His strange behavior gave us <w>pause</w> about trusting him.",
                            "target_lang_translations": {
                                "ru": "Его странное поведение заставило нас <w>усомниться</w> в том, стоит ли ему доверять.",
                                "zh": "他奇怪的行为让我们对是否信任他产生了<w>顾虑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hesitation",
                        "doubt"
                    ],
                    "common_phrases": [
                        "give pause"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство сомнения или колебания, заставляющее задуматься.",
                        "zh": "一种导致人停下来思考的怀疑或悬念感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сомнение",
                                "target_lang_sense_clarification": "неуверенность"
                            },
                            {
                                "target_lang_word": "замешательство",
                                "target_lang_sense_clarification": "смущение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "顾虑",
                                "target_lang_sense_clarification": "因担心而犹豫"
                            },
                            {
                                "target_lang_word": "迟疑",
                                "target_lang_sense_clarification": "因怀疑而停顿"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "df1d83ed-7bc3-38c8-a085-7258e26f717f",
                    "sense_definition": "Used immediately after a statement to indicate that no sexual innuendo was intended.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really love spending time with guys, <w>pause</w>.",
                            "target_lang_translations": {
                                "ru": "Я очень люблю проводить время с парнями, <w>не в том смысле</w>.",
                                "zh": "我真的很喜欢和男生待在一起，<w>没别的意思</w>。"
                            }
                        },
                        {
                            "text": "That sounded weird, <w>pause</w>, I didn't mean it that way.",
                            "target_lang_translations": {
                                "ru": "Это прозвучало странно, <w>не в том смысле</w>, я не это имел в виду.",
                                "zh": "那听起来很奇怪，<w>没别的意思</w>，我不是那个意思。"
                            }
                        }
                    ],
                    "synonyms": [
                        "no homo"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется после утверждения, чтобы указать на отсутствие сексуального подтекста.",
                        "zh": "用于陈述后，表示无性暗示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не в том смысле",
                                "target_lang_sense_clarification": "уточнение контекста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没别的意思",
                                "target_lang_sense_clarification": "澄清非性暗示"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}