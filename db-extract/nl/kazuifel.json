                                    {
                                        "sense_id": "71d51a41-e65a-3890-8814-8aeefa1bd413",
                                        "entry_id": "86700424-37cf-3962-aa1b-d630119d4c7a",
                                        "glosses": [
                                            "Messgewand von katholischen Priestern und Bischöfen"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "996a64ad-4c40-4e05-930f-833f291db468",
                                                "sense_id": "71d51a41-e65a-3890-8814-8aeefa1bd413",
                                                "text": "„Das liturgische Gewand der Priester und des Bischofs ist die Kasel, deren Form und deren bildlicher, ornamentaler Schmuck vielfachen Veränderungen unterworfen war.“"
                                            },
                                            {
                                                "example_id": "9a5ae382-12da-48ae-a54f-fc69f4733497",
                                                "sense_id": "71d51a41-e65a-3890-8814-8aeefa1bd413",
                                                "text": "„Der Beschreibung nach gehört die an anderer Stelle beschriebene Kasel zu diesen Paramenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kasel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b08b44c-4d56-3ab3-a697-84851bd16f46",
                                        "entry_id": "46ecba3d-4144-3cec-bacf-275f5873e4bf",
