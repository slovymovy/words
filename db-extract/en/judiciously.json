                "senses": [
                    {
                        "sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                        "entry_id": "64e1d69e-0d99-3d82-8251-0cd9eef56749",
                        "glosses": [
                            "In a judicious manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2131d4c9-832a-4477-8bf0-2eb484a4f8fb",
                                "sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                                "text": "She knows how to ask questions judiciously: and it is a first requisite to make people feel it is easy to answer you; and, also, that their answer reflects credit on themselves."
                            },
                            {
                                "example_id": "fb9b69cc-e4f7-4e14-ad30-939398165fb5",
                                "sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                                "text": "“That applies to Tylenol tomorrow the same as it does today, the same as it did yesterday. That is the standard of care: to only use medications when indicated during pregnancy and judiciously,” Dr. DeNicola said."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72f58277-7304-4891-b9cb-f6b2b9e88cef",
                        "source_entry_id": "64e1d69e-0d99-3d82-8251-0cd9eef56749",
                        "source_sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                        "source_sense_description": "in a judicious manner",
                        "target_lang_word": "judicieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judicieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                        "entry_id": "8b4d7521-bfaa-3b3f-befd-c83bdb662201",
                                        "glosses": [
                                            "D’une manière judicieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d8370b-e189-408b-937d-472775991c3a",
                                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                                "text": "Gérez très judicieusement votre temps."
                                            },
                                            {
                                                "example_id": "f618f7c3-cb94-4e28-951c-86fc2d3e43f8",
                                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                                "text": "Que si la loi générale qu’on fit alors [faire une notice sur chaque académicien aussitôt après sa mort] eût été depuis aussi exactement observée qu’elle était judicieusement établie, je ne serais guère en peine pour vous parler des académiciens morts."
                                            },
                                            {
                                                "example_id": "617c78f5-f376-469a-9d45-2deaff978094",
                                                "sense_id": "83877409-f645-3968-bd18-96a950de2397",
                                                "text": "Prenez le temps de réfléchir et de calculer judicieusement votre plan d’attaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6107f245-8a5c-4dd3-a5cc-f064f41e5050",
                        "source_entry_id": "64e1d69e-0d99-3d82-8251-0cd9eef56749",
                        "source_sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                        "source_sense_description": "in a judicious manner",
                        "target_lang_word": "umsichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "umsichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                        "entry_id": "426834b6-1988-312a-a767-c50037e821c9",
                                        "glosses": [
                                            "vorausschauend, überlegt, mit Bedacht handelnd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6edcaecf-4ea7-452d-987d-d56e8e31c8aa",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "Der umsichtige Mitarbeiter entdeckte den Fehler, bevor ein Unglück passieren konnte."
                                            },
                                            {
                                                "example_id": "dc64d5be-ffbe-4939-87ac-db54609a95e5",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "„Die gedankliche Auseinandersetzung mit dieser Frage wird vom Reiseleiter in der Weise geschickt eingeleitet, dass er die umsichtige Leistung des Fahrers nochmals hervorhebt und dabei beschreibt, dass es sich in der Türkei gehöre, sich persönlich zu bedanken.“"
                                            },
                                            {
                                                "example_id": "56f29e10-97de-406c-abad-9ee243cbd1af",
                                                "sense_id": "69f83710-8454-3455-b922-f84100e32d27",
                                                "text": "[COVID-19-Pandemie:] „Allein die Empfehlungen an die Politik fielen etwas zurückhaltender aus: Aufgrund der Daten und der bestehenden Unsicherheiten ‚raten wir zur Vorsicht und zur umsichtigen Überwachung‘ der Aufhebung der Corona-Maßnahmen, heißt es in dem Text.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06cea348-7b36-40aa-90c5-34847e58f4d2",
                        "source_entry_id": "64e1d69e-0d99-3d82-8251-0cd9eef56749",
                        "source_sense_id": "dcb697bb-3f8e-34a4-b741-0532d49fe25a",
                        "source_sense_description": "in a judicious manner",
                        "target_lang_word": "vernünftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vernünftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "seinen Verstand (die Vernunft) gebrauchend, statt sich von Emotionen leiten zu lassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86c545bc-46a2-4179-bc6b-173c08029f77",
                                                "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                                "text": "Hierbei bedarf es vernünftigen Handelns."
                                            },
                                            {
                                                "example_id": "81fba33e-1d5d-47be-8adc-f95f5a6433f0",
                                                "sense_id": "8abc57c5-89be-3e1b-b8eb-04b0b48f7940",
                                                "text": "„Die Deutschen verursachen fünfmal so viel CO2, wie es für das Klima vernünftig wäre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "gut oder angemessen handelnd, einsichtig sein und somit die Konsequenzen einer Handlung beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb937c2-4445-4e4e-9674-551a2a6f5464",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Das ist eine vernünftige Entscheidung."
                                            },
                                            {
                                                "example_id": "b9681ab4-6e33-4b59-b1a2-b990e9545bbc",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Sei doch vernünftig!"
                                            },
                                            {
                                                "example_id": "f4e72936-a9fd-4d38-8a0c-4ad17c06f0e6",
                                                "sense_id": "9d168e59-c50b-3695-9c4c-825db2eae303",
                                                "text": "Alleine ist er immer so vernünftig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                        "entry_id": "3657ab15-a295-365b-a004-22c98314100b",
                                        "glosses": [
                                            "gut, vollwertig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31059b42-492d-4fed-b17f-9b24a4d86ef0",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Jetzt brauche ich ein vernünftiges Frühstück!"
                                            },
                                            {
                                                "example_id": "65e00e56-2619-4c34-8f86-c69620d78cc3",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Endlich gibt es wieder was Vernünftiges zu essen!"
                                            },
                                            {
                                                "example_id": "f108c0d6-4806-4930-8f21-01d85765df52",
                                                "sense_id": "2c679198-3f77-3ab1-9a96-ea79f5ca50da",
                                                "text": "Gibt es nichts Vernünftiges im Fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
