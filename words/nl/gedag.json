                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "groet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een kort <w>gedag</w> liep hij snel naar zijn auto om te vertrekken.",
                            "target_lang_translations": {
