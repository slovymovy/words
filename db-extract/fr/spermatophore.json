                                        "entry_id": "e39d1341-57d2-37ae-b50b-7052e3793667",
                                        "glosses": [
                                            "A capsule or pocket enclosing a number of spermatozoa, found in many annelids, brachiopods, insects, mollusks, and crustaceans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f928563-8a30-4b6e-8931-7e83db6dcdc0",
                                                "sense_id": "b43b200b-98d9-3100-82cf-72dc33e15a28",
                                                "text": "The spermatophores begin to ejaculate immediately after leaving the penis and the whole process is completed in a very few seconds. Pulling the filament attached to the ejaculatory end of a spermatophore is all that is needed to start its ejaculation."
                                            }
                                        ]
                                    }
