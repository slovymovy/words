                        ]
                    },
                    {
                        "translation_id": "c481a52b-b27f-4fbb-a240-6223bd155da8",
                        "source_entry_id": "e37afb0d-4d74-3ab2-9d63-5c3719240b07",
                        "target_lang_word": "megabyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "megabyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37dd6807-1650-3f68-a7a9-05437cf15e53",
                                        "entry_id": "e79bd4a2-ba0f-3ef6-acf0-4ed472447675",
                                        "glosses": [
                                            "One million (10⁶, or 1,000,000) bytes or 1,000 kilobytes."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57346572-b565-4e46-817e-c283ee0e8e21",
                                                "sense_id": "37dd6807-1650-3f68-a7a9-05437cf15e53",
                                                "text": "The IBM 2301 Drum Storage (Figure 20) provides random access storage of approximately 4 million bytes at a data rate of 1.2 megabytes per second."
                                            },
                                            {
                                                "example_id": "0a0a2648-200b-4d0f-b2ba-2441c3ece5cd",
                                                "sense_id": "37dd6807-1650-3f68-a7a9-05437cf15e53",
                                                "text": "This 70-megabyte [69,889,536 bytes] data module contains fixed heads in addition to the normal access heads."
                                            },
                                            {
                                                "example_id": "ff7a498b-2895-4092-82df-7796137c103a",
                                                "sense_id": "37dd6807-1650-3f68-a7a9-05437cf15e53",
                                                "text": "AT&T Wireless Services Inc. in Redmond, Washington, is currently offering $1 per megabyte as its cheapest rate for General Packet Radio Service wireless service, which can provide 20K to 40K bit/sec. throughput. But that price is only if a subscriber buys the most megabytes per month now being offered: 200MB of data for $199 a month."
                                            },
                                            {
                                                "example_id": "6229ed94-82db-40a9-8a32-16fd2202a1f7",
                                                "sense_id": "37dd6807-1650-3f68-a7a9-05437cf15e53",
                                                "text": "The overage charge on this plan has been reduced to 10 cents per megabyte over the limit. Previously, the company charged 25 cents per megabyte for overages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e828062-8486-3aa7-bc6b-971e662f3ead",
                                        "entry_id": "e79bd4a2-ba0f-3ef6-acf0-4ed472447675",
                                        "glosses": [
                                            "A mebibyte."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42a8d3f4-a1ef-4666-8ad4-d8218b590297",
                                                "sense_id": "7e828062-8486-3aa7-bc6b-971e662f3ead",
                                                "text": "One megabyte is 1,048,576 bytes. One megahertz, however is a million Hertz."
                                            },
                                            {
                                                "example_id": "ae0414e2-60de-4d1d-8386-4a54d94001a4",
                                                "sense_id": "7e828062-8486-3aa7-bc6b-971e662f3ead",
                                                "text": "Defaults to 2 megabytes (2,097,152 bytes)."
                                            },
                                            {
                                                "example_id": "488e462c-fa4d-4018-9779-7da98549c919",
                                                "sense_id": "7e828062-8486-3aa7-bc6b-971e662f3ead",
                                                "text": "By default, each log file [...] is exactly 5 megabytes (5,242,880 bytes) in size."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
