                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8e62c37-8ce3-45fd-97be-3dd484bd2ecb",
                        "source_entry_id": "98bbfd5b-0250-3757-b7d4-6ffe48348fa7",
                        "source_sense_id": "a8c152b1-77b5-365f-97fd-b31695a00e97",
                        "source_sense_description": "uitvoerder van een gerechtelijk vonnis",
                        "target_lang_word": "exécuteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exécuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f0b855e-3cff-33ce-9d51-e6f81a9dfeef",
                                        "entry_id": "756110f6-85b5-3290-9c5b-f25a5cbb88a9",
                                        "glosses": [
                                            "Qui exécute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9372fe2-e8af-4e5e-964e-e95e2db37be1",
                                                "sense_id": "0f0b855e-3cff-33ce-9d51-e6f81a9dfeef",
                                                "text": "La puissance exécutrice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exécuteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                        "entry_id": "a5facf4d-8e82-313d-b0ef-af1d7c8fdc36",
                                        "glosses": [
                                            "Celui qui exécute."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ab11a7-a12e-4ad3-bbef-0dfbccebcc71",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Ainsi le comprenait l’orateur qui flétrissait, il y a trois ans, dans un premier discours, ceux qu'on appelle des vendus, et qui s'annonçait déjà comme l’exécuteur des épurations nécessaires."
                                            },
                                            {
                                                "example_id": "5a9a7abc-d6cb-4eb9-8411-1055e21f6227",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Je ne veux rien être que le premier gentilhomme du royaume et l'exécuteur de vos désirs."
                                            },
                                            {
                                                "example_id": "2c0b4f15-5e50-464e-9f8f-f06b311cde1e",
                                                "sense_id": "9e4445c1-9b48-333a-b4b3-883745781fae",
                                                "text": "Pour un « niaquoué », S. M. l’Empereur Bao Dai n'est que l’exécutant des volontés françaises, l’exécuteur de nos plus basses œuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                        "entry_id": "a5facf4d-8e82-313d-b0ef-af1d7c8fdc36",
                                        "glosses": [
                                            "Personne qui exécute un condamné à la peine de mort."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e70cb7-1c81-4f4c-b750-b149e7184388",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "Le peuple poussa un long gémissement, et s’avança contre le bourreau : ce misérable, tout troublé, lui porta un second coup, qui ne fit encore que l’écorcher et l’abattre sur le théâtre, où l’exécuteur se roula sur lui pour l’achever."
                                            },
                                            {
                                                "example_id": "4928fe04-5918-44e3-bac4-415d46cc9a1a",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "En sentant la main de l'exécuteur se poser sur son épaule pour arracher le mouchoir qui couvrait son cou, elle pâlit une seconde fois, …."
                                            },
                                            {
                                                "example_id": "c887a105-9767-4654-b708-622b37f980d9",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "La guillotine avait été disloquée exprès par quelqu’un qui voulait nuire à l’exécuteur des hautes œuvres."
                                            },
                                            {
                                                "example_id": "0d95e973-3113-4487-a4e9-2dec8b8c7999",
                                                "sense_id": "3a25edfc-5467-3216-8c14-fb12b41f7e7f",
                                                "text": "L’un d’eux, d’aspect particulièrement féroce et assez semblable à l’exécuteur dans certains tableaux de la Renaissance qui figurent des supplices, s’avança vers lui d’un air implacable pour lui prendre ses affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
