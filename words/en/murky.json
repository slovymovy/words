{
    "word_family": [
        "murk",
        "murkiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6d165540-7180-3f7c-b947-04b2869aaba1",
                    "sense_definition": "Hard to see through due to fog, mist, or sediment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat struggled to navigate through the <w>murky</w> water of the harbor.",
                            "target_lang_translations": {
                                "nl": "De boot had moeite om door het <w>troebele</w> water van de haven te navigeren."
                            }
                        },
                        {
                            "text": "We could barely see the path ahead in the <w>murky</w> morning fog.",
                            "target_lang_translations": {
                                "nl": "We konden het pad voor ons nauwelijks zien in de <w>dichte</w> ochtendmist."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark"
                    ],
                    "common_phrases": [
                        "murky water"
                    ],
                    "target_lang_definitions": {
                        "nl": "Moeilijk om doorheen te kijken door mist, nevel of bezinksel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "troebel",
                                "target_lang_sense_clarification": "Niet helder of doorzichtig, vaak gebruikt voor vloeistoffen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80e31390-dc24-3d6c-b615-f67c4c21caea",
                    "sense_definition": "Dark, dim, or gloomy in appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old castle had many <w>murky</w> corners that felt quite frightening.",
                            "target_lang_translations": {
                                "nl": "Het oude kasteel had veel <w>donkere</w> hoekjes die nogal beangstigend aanvoelden."
                            }
                        },
                        {
                            "text": "They walked slowly through the <w>murky</w> light of the basement.",
                            "target_lang_translations": {
                                "nl": "Ze liepen langzaam door het <w>schemerige</w> licht van de kelder."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark"
                    ],
                    "target_lang_definitions": {
                        "nl": "Donker, schemerig of somber van uiterlijk."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "donker",
                                "target_lang_sense_clarification": "Met weinig licht."
                            },
                            {
                                "target_lang_word": "schemerig",
                                "target_lang_sense_clarification": "Niet goed verlicht, onduidelijk zichtbaar."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1a733ac-779e-3f73-8442-0d8c09d90003",
                    "sense_definition": "Difficult to understand or lacking clarity; obscure.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has a <w>murky</w> history regarding its financial dealings.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf heeft een <w>duister</w> verleden wat betreft zijn financiële transacties."
                            }
                        },
                        {
                            "text": "The legal situation remains <w>murky</w> until the judge makes a final decision.",
                            "target_lang_translations": {
                                "nl": "De juridische situatie blijft <w>onduidelijk</w> totdat de rechter een definitieve beslissing neemt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "murky territory"
                    ],
                    "target_lang_definitions": {
                        "nl": "Moeilijk te begrijpen of onduidelijk; vaag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onduidelijk",
                                "target_lang_sense_clarification": "Niet helder of begrijpelijk."
                            },
                            {
                                "target_lang_word": "vaag",
                                "target_lang_sense_clarification": "Niet precies of scherp gedefinieerd."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092f2b78-1e2d-3a66-9ae4-f241b975345b",
                    "sense_definition": "Involving dishonest or suspicious activities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was involved in some <w>murky</w> business deals that eventually led to his arrest.",
                            "target_lang_translations": {
                                "nl": "Hij was betrokken bij enkele <w>duistere</w> zakendeals die uiteindelijk tot zijn arrestatie leidden."
                            }
                        },
                        {
                            "text": "The politician was accused of having <w>murky</w> connections to local crime syndicates.",
                            "target_lang_translations": {
                                "nl": "De politicus werd beschuldigd van <w>duistere</w> connecties met lokale misdaadsyndicaten."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op oneerlijke of verdachte praktijken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "duister",
                                "target_lang_sense_clarification": "Verdacht, niet transparant of crimineel."
                            },
                            {
                                "target_lang_word": "troebel",
                                "target_lang_sense_clarification": "Figuurlijk gebruikt voor zaken die niet eerlijk of zuiver zijn."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}