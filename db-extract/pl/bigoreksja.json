                        "cross_references": [
                            {
                                "target_word": "bigorexie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e288f051-9ded-31f6-87bc-d4ff562ef775",
                                        "entry_id": "1f907eb3-6a85-3a8b-8683-f2d9ce789541",
                                        "glosses": [
                                            "Dépendance excessive d’un être humain à l’activité sportive, notamment pour développer sa masse musculaire."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff9bf0ce-915e-47e0-8c00-a8058cb0c3f0",
                                                "sense_id": "e288f051-9ded-31f6-87bc-d4ff562ef775",
                                                "text": "En septembre 2011, l'Organisation mondiale de la santé (OMS) reconnaît officiellement la bigorexie.\nLa bigorexie touche toute personne pratiquant une activité sportive à trop forte dose pour son corps."
                                            },
                                            {
                                                "example_id": "ae8b9f91-21b1-4de2-aae7-d5ac550d6557",
                                                "sense_id": "e288f051-9ded-31f6-87bc-d4ff562ef775",
                                                "text": "Au-delà de ces conclusions l’addiction au sport est récemment devenue une maladie : la bigorexie est officiellement reconnue par l’Organisation mondiale de la Santé (OMS) depuis septembre 2011."
                                            },
                                            {
                                                "example_id": "8a907659-9dd0-4ffd-a55f-c08e18bf28e4",
                                                "sense_id": "e288f051-9ded-31f6-87bc-d4ff562ef775",
                                                "text": "On parle de bigorexie, explique Yves St-Louis, \"quand le sport devient une drogue\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
