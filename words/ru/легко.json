            "senses": [
                {
                    "sense_id": "baac3901-119f-3991-b522-0ddd788569c9",
                    "sense_definition": "Без затруднений, усилий или напряжения.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <легко> решил эту сложную задачу за пять минут.",
                            "target_lang_translations": {
                                "en": "He <easily> solved this complex problem in five minutes.",
                                "zh": "他五分钟内就<w>轻松</w>地解决了这道难题。",
                                "nl": "Hij loste deze complexe opgave <w>gemakkelijk</w> op in vijf minuten.",
                                "pl": "On <w>łatwo</w> rozwiązał to trudne zadanie w pięć minut.",
                                "de": "Er hat diese komplexe Aufgabe <w>mühelos</w> in fünf Minuten gelöst.",
                                "fr": "Il a <w>facilement</w> résolu ce problème complexe en cinq minutes.",
                                "it": "Ha risolto <w>facilmente</w> questo problema complesso in cinque minuti.",
                                "cs": "Tento složitý úkol vyřešil <w>snadno</w> za pět minut.",
                                "tr": "Bu zor problemi beş dakikada <w>kolayca</w> çözdü.",
                                "es": "Él resolvió <w>fácilmente</w> este problema complejo en cinco minutos."
                            }
                        },
                        {
                            "text": "Мы <легко> нашли дорогу к вашему дому без карты.",
                            "target_lang_translations": {
                                "en": "We <easily> found the way to your house without a map.",
                                "zh": "我们没用地图也<w>容易</w>地找到了去你家的路。",
                                "nl": "Wij vonden de weg naar uw huis <w>gemakkelijk</w> zonder kaart.",
                                "pl": "My <w>łatwo</w> znaleźliśmy drogę do waszego domu bez mapy.",
                                "de": "Wir haben den Weg zu Ihrem Haus auch ohne Karte <w>leicht</w> gefunden.",
                                "fr": "Nous avons <w>facilement</w> trouvé le chemin vers votre maison sans carte.",
                                "it": "Abbiamo trovato <w>facilmente</w> la strada per casa vostra senza una mappa.",
                                "cs": "Cestu k vašemu domu jsme bez mapy našli <w>snadno</w>.",
                                "tr": "Evinizin yolunu harita olmadan <w>kolayca</w> bulduk.",
                                "es": "Encontramos el camino a su casa <w>fácilmente</w> sin mapa."
                            }
                        }
                    ],
                    "synonyms": [
                        "без труда",
                        "просто"
                    ],
                    "antonyms": [
                        "трудно",
                        "сло́жно",
                        "с трудом"
                    ],
                    "common_phrases": [
                        "легко сделать",
                        "легко понять",
                        "легко запомнить"
                    ],
                    "target_lang_definitions": {
                        "en": "Without difficulty, effort, or tension.",
                        "zh": "指做某事没有困难、不需要费力或紧张。",
                        "nl": "Zonder moeilijkheden, inspanning of spanning.",
                        "pl": "Bez trudności, wysiłku lub napięcia.",
                        "de": "Ohne Schwierigkeiten, Anstrengung oder Spannung.",
                        "fr": "Sans difficulté, effort ou tension.",
                        "it": "Senza difficoltà, sforzo o tensione.",
                        "cs": "Bez obtíží, úsilí nebo napětí.",
                        "tr": "Zorluk, çaba veya gerilim olmadan.",
                        "es": "Sin dificultad, esfuerzo o tensión."
                    },
