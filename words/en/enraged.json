{
    "word_family": [
        "enrage",
        "rage"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "97eac644-6b6d-3bbc-b6bc-a5e846bf2a9d",
                    "sense_definition": "Extremely angry; filled with intense fury or rage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>enraged</w> customer demanded to speak with the manager immediately after the error.",
                            "target_lang_translations": {
                                "nl": "De <w>woedende</w> klant eiste direct na de fout de manager te spreken."
                            }
                        },
                        {
                            "text": "Supported by an <w>enraged</w> public, the organization demanded swift governmental reform.",
                            "target_lang_translations": {
                                "nl": "Gesteund door een <w>razend</w> publiek eiste de organisatie snelle hervormingen van de overheid."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "infuriated",
                        "incensed",
                        "livid"
                    ],
                    "antonyms": [
                        "calm",
                        "placid",
                        "serene"
                    ],
                    "common_phrases": [
                        "enraged crowd",
                        "enraged mob",
                        "visibly enraged"
                    ],
                    "target_lang_definitions": {
                        "nl": "Extreem boos; vervuld van intense woede of razernij."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "woedend",
                                "target_lang_sense_clarification": "zeer kwaad"
                            },
                            {
                                "target_lang_word": "razend",
                                "target_lang_sense_clarification": "buiten zichzelf van woede"
                            },
                            {
                                "target_lang_word": "ziedend",
                                "target_lang_sense_clarification": "kokend van woede"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39126e2c-1eb4-3180-b761-d9b9a5b299bb",
                    "sense_definition": "Mentally deranged; insane or mad.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "madness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old chronicles described the wanderer as entirely <w>enraged</w> and unfit for society.",
                            "target_lang_translations": {
                                "nl": "De oude kronieken beschreven de zwerver als volkomen <w>krankzinnig</w> en ongeschikt voor de samenleving."
                            }
                        },
                        {
                            "text": "Locked away in the asylum, he was considered hopelessly <w>enraged</w> by the attendants.",
                            "target_lang_translations": {
                                "nl": "Opgesloten in het gesticht werd hij door de verzorgers als hopeloos <w>waanzinnig</w> beschouwd."
                            }
                        }
                    ],
                    "synonyms": [
                        "insane",
                        "mad",
                        "deranged"
                    ],
                    "antonyms": [
                        "sane"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical contexts to describe madness"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Geestelijk gestoord; krankzinnig of waanzinnig."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "krankzinnig",
                                "target_lang_sense_clarification": "geestelijk gestoord"
                            },
                            {
                                "target_lang_word": "waanzinnig",
                                "target_lang_sense_clarification": "buiten zinnen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04c16ee8-b077-3674-af07-affadcb0160d",
                    "sense_definition": "Simple past and past participle of <w>enrage</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden cancellation of the festival <w>enraged</w> thousands of hopeful fans.",
                            "target_lang_translations": {
                                "nl": "De plotselinge afgelasting van het festival <w>maakte</w> duizenden hoopvolle fans <w>woedend</w>."
                            }
                        },
                        {
                            "text": "His careless remarks have thoroughly <w>enraged</w> several members of the local committee.",
                            "target_lang_translations": {
                                "nl": "Zijn ondoordachte opmerkingen hebben verschillende leden van het lokale comité grondig <w>woedend gemaakt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "infuriated",
                        "angered"
                    ],
                    "antonyms": [
                        "appeased",
                        "calmed"
                    ],
                    "traits": [
