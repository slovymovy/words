{
    "word_family": [
        "uprzedzać",
        "uprzedzenie",
        "uprzedzony",
        "uprzedzający"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba35591c-4e3d-38ec-bcbf-4d54f88589bd",
                    "sense_definition": "powiadomić kogoś z wyprzedzeniem o czymś, co ma nastąpić",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "informowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę cię wcześniej <w>uprzedzić</w>, że jutro wyjeżdżam z miasta.",
                            "target_lang_translations": {
                                "en": "I need to <w>let</w> you <w>know in advance</w> that I am leaving town tomorrow."
                            }
                        },
                        {
                            "text": "Dlaczego nikt nas nie <w>uprzedził</w> o zmianie terminu spotkania?",
                            "target_lang_translations": {
                                "en": "Why didn't anyone <w>notify</w> us about the rescheduled meeting?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "uprzedzić o planach",
                        "uprzedzić z wyprzedzeniem",
                        "uprzedzić fakty"
                    ],
                    "target_lang_definitions": {
                        "en": "to inform or notify someone in advance about something that will happen"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "let know in advance",
                                "target_lang_sense_clarification": "inform beforehand"
                            },
                            {
                                "target_lang_word": "forewarn",
                                "target_lang_sense_clarification": "inform in advance"
                            },
                            {
                                "target_lang_word": "give advance notice",
                                "target_lang_sense_clarification": "notify prior to an event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88f90dcb-435f-3957-ae53-86dc1fc595d9",
                    "sense_definition": "ostrzec kogoś przed grożącym niebezpieczeństwem lub negatywnymi konsekwencjami",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znajomy <w>uprzedził</w> mnie przed oszustami działającymi w tej okolicy.",
                            "target_lang_translations": {
                                "en": "A friend <w>warned</w> me about the scammers operating in this area."
                            }
                        },
                        {
                            "text": "Dyrektor <w>uprzedził</w> pracowników o możliwych konsekwencjach takich decyzji.",
                            "target_lang_translations": {
                                "en": "The director <w>cautioned</w> the employees about the potential consequences of such decisions."
                            }
                        }
                    ],
                    "synonyms": [
                        "ostrzec"
                    ],
                    "common_phrases": [
                        "uprzedzić przed niebezpieczeństwem"
                    ],
                    "target_lang_definitions": {
                        "en": "to warn someone about impending danger or negative consequences"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "warn",
                                "target_lang_sense_clarification": "alert about danger or trouble"
                            },
                            {
                                "target_lang_word": "caution",
                                "target_lang_sense_clarification": "advise caution against a risk"
                            },
                            {
                                "target_lang_word": "alert",
                                "target_lang_sense_clarification": "make aware of danger"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "893d866c-b930-31be-bd65-11aec6e22728",
                    "sense_definition": "zrobić coś wcześniej niż ktoś inny, wyprzedzić czyjeś działanie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wyprzedzanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chciałem kupić ten rzadki obraz, ale inny kolekcjoner mnie <w>uprzedził</w>.",
                            "target_lang_translations": {
                                "en": "I wanted to buy that rare painting, but another collector <w>beat</w> me <w>to it</w>."
                            }
                        },
                        {
                            "text": "Konkurencja znowu nas <w>uprzedziła</w> i wprowadziła nowy produkt jako pierwsza.",
                            "target_lang_translations": {
                                "en": "The competition <w>pre-empted</w> us again and launched the new product first."
                            }
                        }
                    ],
                    "synonyms": [
                        "ubiec",
                        "wyprzedzić"
                    ],
                    "common_phrases": [
                        "uprzedzić ruch przeciwnika"
                    ],
                    "target_lang_definitions": {
                        "en": "to do something before someone else, pre-empting their action"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beat to it",
                                "target_lang_sense_clarification": "do something before someone else can"
                            },
                            {
                                "target_lang_word": "forestall",
                                "target_lang_sense_clarification": "act in advance to prevent or anticipate"
                            },
                            {
                                "target_lang_word": "pre-empt",
                                "target_lang_sense_clarification": "take action before someone else"
                            },
                            {
                                "target_lang_word": "anticipate",
                                "target_lang_sense_clarification": "act before another party"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4f0bbe9-c8d1-3128-b880-ba7cc20570b4",
                    "sense_definition": "wywołać u kogoś niechęć lub negatywne nastawienie do kogoś bądź czegoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nastawienie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego nieeleganckie zachowanie od razu <w>uprzedziło</w> do niego całą grupę.",
                            "target_lang_translations": {
                                "en": "His uncouth behavior immediately <w>prejudiced</w> the whole group <w>against</w> him."
                            }
                        },
                        {
                            "text": "Nie chciałam nikogo <w>uprzedzić</w> do nowego projektu, więc unikałam krytyki.",
                            "target_lang_translations": {
                                "en": "I didn't want to <w>bias</w> anyone <w>against</w> the new project, so I avoided criticizing it."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uprzedzić do siebie kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "to prejudice or bias someone against a person or thing, causing a negative attitude"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prejudice against",
                                "target_lang_sense_clarification": "cause an unfavorable opinion of someone/something"
                            },
                            {
                                "target_lang_word": "bias against",
                                "target_lang_sense_clarification": "instil a negative attitude towards"
                            },
                            {
                                "target_lang_word": "turn against",
                                "target_lang_sense_clarification": "make disinclined or hostile towards"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}