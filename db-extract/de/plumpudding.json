                "senses": [
                    {
                        "sense_id": "29b81647-6cd0-303b-a19b-a80b516dfbd7",
                        "entry_id": "602da7f8-4886-3836-9f91-e73b86471713",
                        "glosses": [
                            "traditionell englische, zur Weihnachtszeit gereichte Süßspeise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96e5d23c-a89d-423e-9e2c-8c53a3893051",
                                "sense_id": "29b81647-6cd0-303b-a19b-a80b516dfbd7",
                                "text": "„Gastronomiebetriebe und Ferienorte rühmen sich ihrer ,traditionellen“ Weihnachtsmenüs an offenen Kaminen – mit gefülltem Truthahn, brennendem Plumpudding und Grog am prasselnden Feuer. “"
                            },
                            {
                                "example_id": "d321cb22-0fda-42d0-a391-45e612590d72",
                                "sense_id": "29b81647-6cd0-303b-a19b-a80b516dfbd7",
                                "text": "„Und er sprach bei der Fleischbrühe über Norwegen, und beim Rinderfilet über Griechenland und beim Plumpudding über Kreta.“"
                            },
                            {
                                "example_id": "91d05d75-fab4-4d1d-91c1-e6f539526bad",
                                "sense_id": "29b81647-6cd0-303b-a19b-a80b516dfbd7",
                                "text": "„Ada war zum Festschmaus bei ihren Eltern im Dorf, also verzehrten die Florins ihren Truthahn und ihren Plumpudding allein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
