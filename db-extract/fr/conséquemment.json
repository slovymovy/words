        "fr-extract.jsonl": [
            {
                "entry_id": "cfe66d04-b80a-350b-bcb5-eafbd8fa5fd5",
                "word": "conséquemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                        "entry_id": "cfe66d04-b80a-350b-bcb5-eafbd8fa5fd5",
                        "glosses": [
                            "D’une manière conséquente, qui se suit, s’enchaîne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbba62df-c65b-4e05-b9ae-72963d9a81a2",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Bien définir ses mots pour parler conséquemment."
                            },
                            {
                                "example_id": "20480489-4bb3-4ec2-bb4f-68a1c4d10940",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "On ne peut parler conséquemment avec nous."
                            },
                            {
                                "example_id": "284985dd-bda7-4a65-be56-77a6ec9ab893",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Qui doute que les enfants ne conçoivent, qu’ils ne jugent, qu’ils ne raisonnent conséquemment ?"
                            },
                            {
                                "example_id": "23ff93cc-b798-43ed-b68e-9bc9236919f5",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Aussi ne parle-t-il guère conséquemment et avec suite."
                            },
                            {
                                "example_id": "ae45ba69-f3d9-4333-a283-e288bb273877",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Ceux qui disent que, si la matière pouvait recevoir le don de la pensée, l’âme ne serait pas immortelle, raisonnent-ils bien conséquemment ?"
                            },
                            {
                                "example_id": "ac528732-c486-4ed2-9b2e-54b7747d0835",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Il y a des hommes qui conçoivent très distinctement et qui ne raisonnent pas conséquemment."
                            },
                            {
                                "example_id": "e7bfad55-965a-4072-b682-910c846e59a7",
                                "sense_id": "f14fad13-1302-394a-bf95-6f4d9a622822",
                                "text": "Personne ne parlait plus juste, plus nettement, plus conséquemment [que le duc de Chevreuse]."
                            }
                        ]
                    },
                    {
                        "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                        "entry_id": "cfe66d04-b80a-350b-bcb5-eafbd8fa5fd5",
                        "glosses": [
                            "En conséquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618ba463-5277-497d-aecc-2595cf8d79d3",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "Ainsi conséquemment [il en est de même] de tout dont je t’offense."
                            },
                            {
                                "example_id": "c44e9060-2a1a-4a35-9270-b944fd9fd08e",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "Ils décident en leur faveur et agissent conséquemment."
                            },
                            {
                                "example_id": "9fd391b5-bef4-475d-84ef-6875c5bb98e2",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "Si l’Inde est la contrée la plus anciennement policée, elle doit conséquemment avoir eu la plus ancienne forme de religion."
                            },
                            {
                                "example_id": "95fcc3fe-15be-4617-b471-4809c30f7a98",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "C’est dans ce sacrifice où le religieux se donne lui-même, qu’il donne conséquemment et qu’il sacrifie toutes ces prétentions [du monde]."
                            },
                            {
                                "example_id": "5ae69263-1253-4b7b-83d4-9f8493677d54",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "Nous n’avons éprouvé que peu de fatigues, et conséquemment, peu de retards."
                            },
                            {
                                "example_id": "9a5064d1-3a6a-4a73-804a-9484c5a2ffb9",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "La nuit était noire, conséquemment propice au projet hardi que le jeune Alsacien comptait mettre à exécution."
                            },
                            {
                                "example_id": "9caa049f-0872-4e17-a2c1-602d5c9bb428",
                                "sense_id": "523cc9b1-253d-3ddb-ab85-69465c4075c5",
                                "text": "Fils de Berthe, et conséquemment cousin germain de « la personne en question », il juge avoir son mot à dire sur le sujet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
