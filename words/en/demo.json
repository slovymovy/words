{
    "word_family": [
        "demonstrate",
        "demonstration",
        "demonstrator",
        "demolish",
        "demolition",
        "demographic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2678e61d-bec6-30ec-b724-8cf15749aad3",
                    "sense_definition": "A practical exhibition or explanation of how something works.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demonstration_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor prepared a <w>demo</w> to help her class understand the topic.",
                            "target_lang_translations": {
                                "ru": "Профессор подготовила <w>демонстрацию</w>, чтобы помочь классу понять тему.",
                                "zh": "教授准备了一次<w>演示</w>，以帮助学生理解这个主题。"
                            }
                        },
                        {
                            "text": "We watched a cooking <w>demo</w> at the local market.",
                            "target_lang_translations": {
                                "ru": "Мы смотрели кулинарный <w>показ</w> на местном рынке.",
                                "zh": "我们在当地市场观看了一场烹饪<w>演示</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "demonstration",
                        "presentation."
                    ],
                    "common_phrases": [
                        "product demo",
                        "live demo",
                        "give a demo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практическая демонстрация или объяснение того, как что-то работает.",
                        "zh": "对某事物如何运作的实际展示或说明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "показ работы чего-либо"
                            },
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演示",
                                "target_lang_sense_clarification": "展示工作原理"
                            },
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "呈现或介绍"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32cf07a3-05a3-33d3-b65d-8c16f80e8135",
                    "sense_definition": "A limited version of a software program or game released to let users try it before buying.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demonstration_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game's developers released a <w>demo</w> version to the public before the full release.",
                            "target_lang_translations": {
                                "ru": "Разработчики игры выпустили <w>демо</w>-версию для публики перед полным релизом.",
                                "zh": "游戏开发商在正式发布前向公众发布了<w>试用版</w>。"
                            }
                        },
                        {
                            "text": "You can download the <w>demo</w> for free to see if you like the app.",
                            "target_lang_translations": {
                                "ru": "Вы можете скачать <w>демо-версию</w> бесплатно, чтобы узнать, нравится ли вам приложение.",
                                "zh": "你可以免费下载<w>试用版</w>，看看是否喜欢这个应用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "game demo",
                        "free demo",
                        "download the demo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограниченная версия программы или игры для ознакомления перед покупкой.",
                        "zh": "软件或游戏的受限版本，供用户在购买前试用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демо-версия",
                                "target_lang_sense_clarification": "пробная версия ПО"
                            },
                            {
                                "target_lang_word": "демо",
                                "target_lang_sense_clarification": "разг. сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "试用版",
                                "target_lang_sense_clarification": "软件的测试版本"
                            },
                            {
                                "target_lang_word": "演示版",
                                "target_lang_sense_clarification": "用于展示功能的版本"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ed0d3de-ae80-3aee-9351-b06cfbe79abc",
                    "sense_definition": "A rough recording of a song made to demonstrate its sound or arrangement, often to get a record deal.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hearing the <w>demo</w>, the record label approved funding to record the song with a full band.",
                            "target_lang_translations": {
                                "ru": "После прослушивания <w>демозаписи</w> лейбл одобрил финансирование записи песни с полным составом группы.",
                                "zh": "听过<w>小样</w>后，唱片公司批准了资金，用于录制完整乐队版本的歌曲。"
                            }
                        },
                        {
                            "text": "The band sent a <w>demo</w> of their new tracks to several producers.",
                            "target_lang_translations": {
                                "ru": "Группа отправила <w>демо</w> своих новых треков нескольким продюсерам.",
                                "zh": "乐队将他们新曲目的<w>小样</w>寄给了几位制作人。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "demo tape",
                        "record a demo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Черновая запись песни для демонстрации звучания или аранжировки.",
                        "zh": "为展示歌曲音效或编曲而制作的粗略录音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демозапись",
                                "target_lang_sense_clarification": "черновая фонограмма"
                            },
                            {
                                "target_lang_word": "демо",
                                "target_lang_sense_clarification": "музыкальный сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小样",
                                "target_lang_sense_clarification": "音乐制作中的粗录音"
                            },
                            {
                                "target_lang_word": "演示录音",
                                "target_lang_sense_clarification": "用于展示的录音"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10650ed-2b88-37cd-81d6-70d26bb1f935",
                    "sense_definition": "A public meeting or march to protest against something or express views on a political issue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protest_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students organized a large <w>demo</w> against the rising tuition fees.",
                            "target_lang_translations": {
                                "ru": "Студенты организовали крупную <w>демонстрацию</w> против повышения платы за обучение.",
                                "zh": "学生们组织了一场大规模的<w>示威</w>，反对学费上涨。"
                            }
                        },
                        {
                            "text": "Will you join our <w>demo</w> to support the new environmental policy?",
                            "target_lang_translations": {
                                "ru": "Ты присоединишься к нашему <w>митингу</w> в поддержку новой экологической политики?",
                                "zh": "你会参加我们支持新环境政策的<w>游行</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "march",
                        "demonstration"
                    ],
                    "common_phrases": [
                        "go on a demo",
                        "anti-war demo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for demonstration"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное собрание или шествие в знак протеста или для выражения политических взглядов.",
                        "zh": "为抗议某事或表达政治观点而举行的公开集会或游行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "политическая акция"
                            },
                            {
                                "target_lang_word": "митинг",
                                "target_lang_sense_clarification": "собрание людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "示威",
                                "target_lang_sense_clarification": "政治抗议活动"
                            },
                            {
                                "target_lang_word": "游行",
                                "target_lang_sense_clarification": "公开的集体行动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76453c6d-afac-3acd-999d-f5e6faf406aa",
                    "sense_definition": "A product used for display or demonstration in a store, often sold later at a discount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "demonstration_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought the <w>demo</w> because it was much cheaper than the boxed unit.",
                            "target_lang_translations": {
                                "ru": "Я купил <w>выставочный образец</w>, потому что он был намного дешевле товара в упаковке.",
                                "zh": "我买了这台<w>展示品</w>，因为它比包装好的全新产品便宜得多。"
                            }
                        },
                        {
                            "text": "The shop is selling off its <w>demo</w> models to make room for new stock.",
                            "target_lang_translations": {
                                "ru": "Магазин распродает свои <w>демонстрационные</w> модели, чтобы освободить место для нового товара.",
                                "zh": "商店正在清仓处理展示<w>样机</w>，以便为新货腾出空间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "floor model"
                    ],
                    "common_phrases": [
                        "demo model",
                        "demo unit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товар, используемый для демонстрации в магазине, часто продаваемый позже со скидкой.",
                        "zh": "商店中用于陈列或演示的产品，通常随后会打折出售。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выставочный образец",
                                "target_lang_sense_clarification": "товар с витрины"
                            },
                            {
                                "target_lang_word": "демонстрационный образец",
                                "target_lang_sense_clarification": "модель для показа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展示品",
                                "target_lang_sense_clarification": "陈列在店内的商品"
                            },
                            {
                                "target_lang_word": "样机",
                                "target_lang_sense_clarification": "用于演示的机器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90183966-2cbf-3d11-9579-670cb78d8bbf",
                    "sense_definition": "The act of knocking down a building or structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "demolition_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>demo</w> portion of the renovation project is the relatively fast and inexpensive part.",
                            "target_lang_translations": {
                                "ru": "Этап <w>сноса</w> в проекте реконструкции — это относительно быстрая и недорогая часть.",
                                "zh": "翻新工程中的<w>拆除</w>部分相对较快且成本较低。"
                            }
                        },
                        {
                            "text": "We need to finish the <w>demo</w> of the old garage before we can build the new one.",
                            "target_lang_translations": {
                                "ru": "Нам нужно закончить <w>демонтаж</w> старого гаража, прежде чем мы сможем построить новый.",
                                "zh": "在建造新车库之前，我们需要完成旧车库的<w>拆除</w>工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "demo crew",
                        "start the demo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for demolition"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс сноса здания или сооружения.",
                        "zh": "拆除建筑物或结构的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снос",
                                "target_lang_sense_clarification": "разрушение здания"
                            },
                            {
                                "target_lang_word": "демонтаж",
                                "target_lang_sense_clarification": "разборка конструкций"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拆除",
                                "target_lang_sense_clarification": "毁坏建筑物"
                            },
                            {
                                "target_lang_word": "拆卸",
                                "target_lang_sense_clarification": "拆解结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3926b196-4cde-3745-a0a9-ca8ef2f705bb",
                    "sense_definition": "A specific section of a population, often used in marketing to describe a target audience.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "demographic_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our target <w>demo</w> is sports-minded families with young children.",
                            "target_lang_translations": {
                                "ru": "Наша <w>целевая аудитория</w> — это спортивные семьи с маленькими детьми.",
                                "zh": "我们的<w>目标群体</w>是热爱运动且有小孩的家庭。"
                            }
                        },
                        {
                            "text": "The show is very popular with the eighteen to thirty-four <w>demo</w>.",
                            "target_lang_translations": {
                                "ru": "Шоу очень популярно в <w>возрастной группе</w> от восемнадцати до тридцати четырех лет.",
                                "zh": "这个节目在18到34岁的<w>人口统计群体</w>中非常受欢迎。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "target demo",
                        "key demo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for demographic"
                        },
                        {
                            "trait_type": "slang",
                            "comment": "marketing jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная группа населения, часто используемая в маркетинге для описания целевой аудитории.",
                        "zh": "特定的人口群体，常用于市场营销以描述目标受众。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "целевая аудитория",
                                "target_lang_sense_clarification": "маркетинговый термин"
                            },
                            {
                                "target_lang_word": "демографическая группа",
                                "target_lang_sense_clarification": "статистика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标群体",
                                "target_lang_sense_clarification": "营销中的目标受众"
                            },
                            {
                                "target_lang_word": "人口统计群体",
                                "target_lang_sense_clarification": "基于统计的分类"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24c775b0-5851-33ea-ae8c-5a32f6452651",
                    "sense_definition": "A non-interactive computer program created by enthusiasts to demonstrate technical and artistic skills.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "demoscene_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmers released a stunning <w>demo</w> that pushed the hardware to its limits.",
                            "target_lang_translations": {
                                "ru": "Программисты выпустили потрясающее <w>демо</w>, которое выжало максимум из оборудования.",
                                "zh": "程序员发布了一个令人惊叹的<w>演示程序</w>，将硬件性能发挥到了极致。"
                            }
                        },
                        {
                            "text": "He spent years in the <w>demo</w> scene creating visual effects for competitions.",
                            "target_lang_translations": {
                                "ru": "Он провел годы на <w>демосцене</w>, создавая визуальные эффекты для конкурсов.",
                                "zh": "他多年来一直活跃在<w>演示程序</w>圈，为比赛创作视觉特效。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "computing subculture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неинтерактивная компьютерная программа, созданная энтузиастами для демонстрации технических и художественных навыков.",
                        "zh": "由爱好者创作的非交互式计算机程序，旨在展示技术和艺术技巧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демо",
                                "target_lang_sense_clarification": "компьютерное искусство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演示程序",
                                "target_lang_sense_clarification": "展示技术能力的程序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b584c9ba-809a-3044-96bc-80a309fa746c",
                    "sense_definition": "To show how something works or is performed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demonstration_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesperson offered to <w>demo</w> the vacuum cleaner for us.",
                            "target_lang_translations": {
                                "ru": "Продавец предложил <w>продемонстрировать</w> нам пылесос.",
                                "zh": "销售人员主动提出为我们<w>演示</w>这款吸尘器。"
                            }
                        },
                        {
                            "text": "Can you <w>demo</w> the new software features during the meeting?",
                            "target_lang_translations": {
                                "ru": "Ты можешь <w>показать</w> новые функции программы во время встречи?",
                                "zh": "你能在会议期间<w>演示</w>一下新软件的功能吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "demo the product",
                        "demo the software"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать, как что-то работает или выполняется.",
                        "zh": "展示某事物如何运作或执行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстрировать",
                                "target_lang_sense_clarification": "показывать в действии"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "演示",
                                "target_lang_sense_clarification": "展示操作过程"
                            },
                            {
                                "target_lang_word": "展示",
                                "target_lang_sense_clarification": "呈现功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "340eb10f-f07a-3815-8662-2ba99e29f4bc",
                    "sense_definition": "To record a rough version of a song, usually not intended for commercial release.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "music_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band <w>demoed</w> thirty songs before choosing ten for the album.",
                            "target_lang_translations": {
                                "ru": "Группа <w>записала демо</w> тридцати песен, прежде чем выбрать десять для альбома.",
                                "zh": "乐队在选出十首收录进专辑之前，先<w>录制</w>了三十首歌曲的小样。"
                            }
                        },
                        {
                            "text": "He <w>demoed</w> the track in his home studio over the weekend.",
                            "target_lang_translations": {
                                "ru": "Он <w>сделал демозапись</w> трека в своей домашней студии на выходных.",
                                "zh": "周末他在家庭工作室里<w>录制</w>了这首曲子的小样。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать черновую версию песни, обычно не предназначенную для коммерческого выпуска.",
                        "zh": "录制歌曲的粗略版本，通常不打算商业发行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записывать демо",
                                "target_lang_sense_clarification": "делать черновую запись"
                            }
                        ],
                        "zh": [
