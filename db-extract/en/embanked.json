                "senses": [
                    {
                        "sense_id": "c46f64f1-f264-3699-bcee-3386aa65ead6",
                        "entry_id": "39f91ab1-d091-343d-84a2-c64a24232c33",
                        "glosses": [
                            "Protected by or containing embankments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f787e49-863e-4c4c-a845-8a5060c81249",
                                "sense_id": "c46f64f1-f264-3699-bcee-3386aa65ead6",
                                "text": "As it approaches its conflux, this creek becomes more and more embanked, and difficult to ford: the heights are equal on the two banks; but for this reason the advantage was in favour of him who defended the passage."
                            },
                            {
                                "example_id": "536eb71f-c5bc-4856-aba0-c4179f7a9869",
                                "sense_id": "c46f64f1-f264-3699-bcee-3386aa65ead6",
                                "text": "Most of the older buildings are of reddish-brown ironstone with mossy-tiled roofs, and almost all have stone-embanked gardens, richly planted and expertly maintained."
                            },
                            {
                                "example_id": "87c1adba-6bc3-43ee-8c0f-8f70910dab4d",
                                "sense_id": "c46f64f1-f264-3699-bcee-3386aa65ead6",
                                "text": "North of the wood from the Hospice Redoubt stood Red Château where today stands a cottage, its position edging what was then a sunken road, the remains of its original course still visible alongside the more embanked road of today."
                            },
                            {
                                "example_id": "1a8e6eb2-9963-4de3-a12d-f947fe16a7bc",
                                "sense_id": "c46f64f1-f264-3699-bcee-3386aa65ead6",
                                "text": "The open floodplains in the Long Xuyen Quadrangle became more and more embanked, and therefore the conditions for flood-adapted, traditional floating rice increasingly declined."
                            }
                        ]
                    }
