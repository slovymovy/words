                "senses": [
                    {
                        "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                        "entry_id": "fa65a305-0194-31fd-9be8-2be49c077e97",
                        "glosses": [
                            "wurstförmiger, länglicher, mit Rosshaar ausgestopfter Lederbeutel als Phallussymbol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "249e72b4-ab3d-4971-a368-8e0fb663af1f",
                                "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                                "text": "„Durch einen leichten Schlag mit der Narrenwurst auf die Schulter zieht der Narr die Person, der aufgesagt werden soll, in seinen Bann.“"
                            },
                            {
                                "example_id": "3c10e336-8126-4f67-a058-ddd2ad3c365b",
                                "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                                "text": "„Als Narrenattribut trägt sie eine Narrenwurst.“"
                            },
                            {
                                "example_id": "80eda661-318c-4618-875f-47213881709c",
                                "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                                "text": "„Streckschere, Narrenwurst und Rätsche können ausprobiert werden.“"
                            },
                            {
                                "example_id": "814273d0-44b0-45e0-b244-e966384ced47",
                                "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                                "text": "„Die bekanntesten sind der Spiegel, die Schweinsblase (im Dialekt Saubloder genannt), die Narrenwurst, die Karbatsche, die Pritsche und die Streckschere.“"
                            },
                            {
                                "example_id": "4749fd4f-ed66-4852-ae8b-5e236f096be3",
                                "sense_id": "01ad6aca-6631-3564-adb3-2fe40cd28306",
                                "text": "„Auf der mit Rosshaar gefassten Larve trägt er ein Narrenhütchen mit Federbusch und in der Hand eine Narrenwurst in Häsfarben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
