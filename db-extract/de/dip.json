                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc9c0df-710d-42bd-8ccd-9ac6130b56a4",
                                "sense_id": "0c7305fc-1665-3df7-b416-288a2a16aa59",
                                "text": "„Ein paar Stunden später ist der Esstisch randvoll gedeckt mit Köstlichkeiten: wilde Artischocken in Beeren-Essig. Maisbrote mit einem Dip aus geräuchertem Chili, Koriander, Knoblauch und Basilikum – ein Rezept, das sich alle notieren.“"
                            }
