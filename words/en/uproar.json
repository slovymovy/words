{
    "word_family": [
        "uproarious",
        "uproariously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d677ffbd-a280-3210-a5aa-c815cd6047a2",
                    "sense_definition": "A loud and public expression of protest, controversy, or anger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "public_protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government's decision to raise taxes caused a huge public <w>uproar</w>.",
                            "target_lang_translations": {
                                "es": "La decisión del gobierno de subir los impuestos provocó una enorme <w>indignación</w> pública."
                            }
                        },
                        {
                            "text": "His controversial remarks sparked an immediate <w>uproar</w> in the press.",
                            "target_lang_translations": {
                                "es": "Sus polémicas declaraciones desataron un inmediato <w>revuelo</w> en la prensa."
                            }
                        }
                    ],
                    "synonyms": [
                        "hue and cry"
                    ],
                    "common_phrases": [
                        "cause an uproar",
                        "spark an uproar",
                        "public uproar"
                    ],
                    "target_lang_definitions": {
                        "es": "Expresión pública, ruidosa y generalizada de protesta, indignación o controversia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "indignación",
                                "target_lang_sense_clarification": "enfado colectivo ante una situación injusta o polémica"
                            },
                            {
                                "target_lang_word": "clamor",
                                "target_lang_sense_clarification": "manifestación pública de protesta o descontento"
                            },
                            {
                                "target_lang_word": "revuelo",
                                "target_lang_sense_clarification": "agitación o conmoción generada en la opinión pública"
                            },
                            {
                                "target_lang_word": "escandalera",
                                "target_lang_sense_clarification": "gran escándalo o protesta ruidosa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2297cb1a-6084-3eb4-9d79-1e778d5ebcd9",
                    "sense_definition": "A loud, confused, and continuous noise, especially from a crowd.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "commotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire room was in an <w>uproar</w> as people shouted over one another.",
                            "target_lang_translations": {
                                "es": "Toda la sala era un <w>alboroto</w> mientras la gente se gritaba unos a otros."
                            }
                        },
                        {
                            "text": "I could barely hear what she said over the deafening <w>uproar</w> of the street market.",
                            "target_lang_translations": {
                                "es": "Apenas pude escuchar lo que dijo por encima del ensordecedor <w>bullicio</w> del mercado callejero."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in an uproar"
                    ],
                    "target_lang_definitions": {
                        "es": "Ruido fuerte, confuso y continuado, especialmente el provocado por una multitud."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alboroto",
                                "target_lang_sense_clarification": "ruido y desorden causado por un grupo de personas"
                            },
                            {
                                "target_lang_word": "bullicio",
                                "target_lang_sense_clarification": "ruido animado o desordenado de mucha gente"
                            },
                            {
                                "target_lang_word": "estrépito",
                                "target_lang_sense_clarification": "ruido ensordecedor y abrumador"
                            },
                            {
                                "target_lang_word": "griterío",
                                "target_lang_sense_clarification": "conjunto ensordecedor de gritos confusos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d5c685a-2bf1-33ee-bc9d-5a6f6708bcbb",
                    "sense_definition": "A state of tumultuous, noisy excitement or agitation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium was thrown into an <w>uproar</w> when the home team scored the winning goal.",
                            "target_lang_translations": {
                                "es": "El estadio se convirtió en un <w>tumulto</w> cuando el equipo local marcó el gol de la victoria."
                            }
                        },
                        {
                            "text": "The unexpected news sent the entire school into a joyful <w>uproar</w>.",
                            "target_lang_translations": {
                                "es": "La inesperada noticia desató un alegre <w>alboroto</w> en todo el colegio."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Estado de gran agitación o entusiasmo ruidoso y descontrolado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "tumulto",
                                "target_lang_sense_clarification": "gran agitación y desorden ruidoso"
                            },
                            {
                                "target_lang_word": "alboroto",
                                "target_lang_sense_clarification": "emoción intensa y ruidosa"
                            },
                            {
                                "target_lang_word": "euforia",
                                "target_lang_sense_clarification": "exaltación y júbilo ruidoso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7473b95-cbc8-3cd0-87a8-92cd6e23c67c",
                    "sense_definition": "To throw into disorder, confusion, or turmoil.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause_confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such reckless rebellion would only <w>uproar</w> the fragile peace established between the rival factions.",
                            "target_lang_translations": {
                                "es": "Una rebelión tan imprudente no haría más que <w>trastornar</w> la frágil paz establecida entre las facciones rivales."
                            }
                        },
                        {
                            "text": "He sought to <w>uproar</w> the calm atmosphere with false rumors.",
                            "target_lang_translations": {
                                "es": "Buscaba <w>alborotar</w> el ambiente tranquilo con rumores falsos."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used transitively outside of older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Sumir en el desorden, la confusión o la agitación (uso literario o arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "trastornar",
                                "target_lang_sense_clarification": "alterar gravemente la paz o el orden"
                            },
                            {
                                "target_lang_word": "alborotar",
                                "target_lang_sense_clarification": "causar agitación o desorden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                    "sense_definition": "To make a noisy disturbance or commotion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Outside the castle gates, the angry mobs began to <w>uproar</w> through the night.",
                            "target_lang_translations": {
                                "es": "Frente a las puertas del castillo, las turbas enfurecidas comenzaron a <w>amotinarse</w> durante la noche."
                            }
                        },
                        {
                            "text": "The drunken sailors began to shout and <w>uproar</w> in the tavern until morning.",
                            "target_lang_translations": {
                                "es": "Los marineros borrachos comenzaron a gritar y <w>armar jaleo</w> en la taberna hasta la mañana."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as an intransitive verb in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Causar un alboroto, escándalo o disturbio ruidoso (uso arcaico)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "alborotar",
                                "target_lang_sense_clarification": "hacer ruido o causar disturbios"
                            },
                            {
                                "target_lang_word": "armar jaleo",
                                "target_lang_sense_clarification": "generar ruido y confusión"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}