                "senses": [
                    {
                        "sense_id": "04e79daa-f6c1-3e2c-bc22-552ca96b7130",
                        "entry_id": "75ef0c97-56ae-3a92-804d-b7bea9b9ec41",
                        "glosses": [
                            "Fensterscheibe aus mehreren kleinen Glasstücken, die mit Bleiruten verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54890ee1-8fd3-4aba-8bc8-27d27c4e2fe2",
                                "sense_id": "04e79daa-f6c1-3e2c-bc22-552ca96b7130",
                                "text": "„Die historischen Bleiglasfenster, Strebebögen, Säulen und Gesimse stehen im Dialog mit den modernen Einbauten aus Glas und Stahl.“"
                            },
                            {
                                "example_id": "00dbe5cd-3585-4b91-9d7f-3db6eeddefbb",
                                "sense_id": "04e79daa-f6c1-3e2c-bc22-552ca96b7130",
                                "text": "„An der Wand gegenüber ging eine Reihe von Bleiglasfenstern auf einen Garten hinaus, in dem ein kleiner, von Blumen und Büschen umgebener Springbrunnen plätscherte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
