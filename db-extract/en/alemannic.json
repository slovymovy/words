                                        "entry_id": "54eff5c2-8be9-3e3b-8d83-8ba10ad8e5bd",
                                        "glosses": [
                                            "die Alemannen betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68f7d02-292b-454f-a7d3-7c3d8c011823",
                                                "sense_id": "ef97025f-85ca-3881-bc7b-64d2c206e10b",
                                                "text": "Alemannische Bevölkerungsgruppen können auch anhand schriftlicher Quellen identifiziert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e2d78df-c8ce-3b8b-b9a3-0319adf6a6ef",
                                        "entry_id": "54eff5c2-8be9-3e3b-8d83-8ba10ad8e5bd",
                                        "glosses": [
                                            "auf die Gruppe oberdeutscher Dialekte, das Alemannische, bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d834b018-3a36-4b3f-addf-73df8465e735",
                                                "sense_id": "3e2d78df-c8ce-3b8b-b9a3-0319adf6a6ef",
                                                "text": "„Mit Sorge beobachtet Renn vor allem den alemannischen Sprachraum, der im weiten Sinne vom Wallis bis ins Ries und vom Lechrain bis in die Vogesen reicht.“"
                                            },
                                            {
                                                "example_id": "c27ba261-8fa4-4b95-952c-82bda7888641",
                                                "sense_id": "3e2d78df-c8ce-3b8b-b9a3-0319adf6a6ef",
                                                "text": "„Anlässlich eines neulichen Abends im Berliner Haus der Kulturen erzählte Oliver, zuhause in Hausach sei im ersten Stockwerk alemannisch gesprochen worden, im Obergeschoss andalusisch.“"
                                            },
                                            {
                                                "example_id": "e08a0314-8834-4c23-8cc8-6bf6266e9b11",
                                                "sense_id": "3e2d78df-c8ce-3b8b-b9a3-0319adf6a6ef",
                                                "text": "„Alle diese Aussagen sind für das dialektal alemannisch geprägte Bundesland Vorarlberg nur eingeschränkt gültig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
