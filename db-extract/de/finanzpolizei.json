                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac44f40d-b5fa-4e3f-a2c2-4a2150e1e3f2",
                                "sense_id": "4e004aa4-e90f-38f9-966a-dd73275cbed8",
                                "text": "„Der Chef der Finanzpolizei gibt bekannt, dass gegen mehrere Mitarbeiter des Ministeriums für Energie und Bodenschätze wegen Korruption ermittelt wird.“"
                            },
                            {
                                "example_id": "9cef6ef8-00cc-4e66-8f32-0ea3ab9fad86",
                                "sense_id": "4e004aa4-e90f-38f9-966a-dd73275cbed8",
                                "text": "„In einer von der Finanzpolizei Neapel koordinierten Aktion, an der auch Interpol und die spanische Polizei beteiligt ist, wird er im Mai 2010 am Flughafen Madrid verhaftet, nachdem man seinen Sohn beschattet hat, der sich in Spanien mit ihm treffen wollte.“"
                            }
                        ],
