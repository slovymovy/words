                    "sense_id": "7e28e854-b02b-327f-a31c-c7071b61e0b4",
                    "sense_definition": "etwas eben, faltenfrei oder geschmeidig machen; Unebenheiten von einer Oberfläche beseitigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physisch_ebnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor dem wichtigen Vorstellungsgespräch <w>glättete</w> er sorgfältig sein zerknittertes Hemd mit dem Bügeleisen."
                        },
                        {
                            "text": "Sie benutzt jeden Morgen ein spezielles Gerät, um ihre lockigen Haare zu <w>glätten</w>."
                        }
                    ],
                    "synonyms": [
                        "ebnen",
                        "glattstreichen"
                    ],
                    "common_phrases": [
                        "die Haare glätten",
                        "Falten glätten",
                        "den Stoff glätten"
                    ]
                },
                {
                    "sense_id": "769b4247-db79-31e5-894f-ca56fc19da6a",
                    "sense_definition": "Aufregung, Spannungen oder Streitigkeiten mildern und für Beruhigung sorgen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beruhigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die erfahrene Schlichterin versuchte sofort, die Wogen im heftigen Streit zu <w>glätten</w>."
                        },
                        {
                            "text": "Mit ein paar freundlichen Worten konnte der Chef die erhitzten Gemüter schnell wieder <w>glätten</w>."
                        }
                    ],
                    "synonyms": [
                        "beschwichtigen",
                        "beruhigen",
                        "beilegen"
                    ],
                    "antonyms": [
