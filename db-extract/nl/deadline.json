                                "sense_id": "91bd637c-89bd-3b5c-bd91-1d3e48de966f",
                                "text": "De deadline van de redactie lag om 16:00."
                            },
                            {
                                "example_id": "646503c7-186f-4813-8536-9b04db5d0ee9",
                                "sense_id": "91bd637c-89bd-3b5c-bd91-1d3e48de966f",
                                "text": "Hij had zijn scriptie net 2 minuten na de deadline ingeleverd."
                            },
