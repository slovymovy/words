                            {
                                "example_id": "53362707-b153-44a0-8a56-7bb64c1cd338",
                                "sense_id": "2e77a59d-ca0e-30cd-b017-c3674f67b13a",
                                "text": "Een studie uit 2012 die onderzocht hoe woordvormen in ons brein verwerkt worden, werd recent uit het wetenschappelijke tijdschrift ‘Cerebral Cortex’ geschrapt."
                            },
                            {
                                "example_id": "614537fd-50f4-4dcc-a484-04101f63563a",
                                "sense_id": "2e77a59d-ca0e-30cd-b017-c3674f67b13a",
                                "text": "ER IS in het Engels een werkwoordsvorm waarmee je kunt aangeven dat een handeling of een gebeurtenis aanhoudt. Ze is weliswaar al vroeger begonnen, maar behoort toch nog niet tot het verleden.... Die woordvorm laat zien dat er gebeurtenissen zijn die zich er hardnekkig tegen verzetten afgesloten te worden, definitief tot het verleden te gaan behoren. Het heden duurt maar voort als een werkwoord die vorm aanneemt.'Ing' zeggen die woorden."
                            }
                        ]
                    }
