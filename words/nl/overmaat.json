                    ],
                    "common_phrases": [
                        "tot overmaat van ramp",
                        "in overmaat aanwezig"
                    ],
                    "target_lang_definitions": {
                        "en": "An amount that is greater than what is necessary or desirable"
                    },
                    "translations": {
