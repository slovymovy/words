        "fr-extract.jsonl": [
            {
                "entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                "word": "symboliste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aaf69965-40ee-434e-a892-7c29067aa2cc",
                        "entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "symbolistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b350cfb9-3c9b-3f61-985f-fdd868158f54",
                        "entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                        "glosses": [
                            "Qui a rapport au symbolisme littéraire ou artistique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80574d38-0d98-483f-ad40-14a8b87073ff",
                                "sense_id": "b350cfb9-3c9b-3f61-985f-fdd868158f54",
                                "text": "Le mouvement symboliste."
                            },
                            {
                                "example_id": "9ab1fd4b-fddc-4a97-8823-8713b68ad8b5",
                                "sense_id": "b350cfb9-3c9b-3f61-985f-fdd868158f54",
                                "text": "C’est la préoccupation de l’école. La phrase plus qu’assouplie, disloquée ; les règles, la syntaxe, la vieille construction logique dont parle Fénelon, abolies ; mots anciens et de jargon, grecs, latins, picards, toute l’érudition en délire et monstrueusement goguenarde de Rabelais, versée dogmatiquement et pontificalement dans la langue par ces prêtres du Son ; l’absence de rythme devenant le rythme suprême ; et des effets de verbe, des cabrioles d’adjectifs, des dégingandements de périodes, la langue entière prise d’hystérie, les oh ! les ah ! les si ! les pâmoisons, les spasmes, les râles et les roulements d’yeux coupant la prose en bonne santé de nos pères ; par là-dessus, je ne sais quelle affectation de mystère et d’hiérophantisme, voilà, en fin de compte, à quoi se réduit « l’écriture symboliste »."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf5b5e8e-c45e-37b1-8a16-6a33d7ecb137",
                        "entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                        "glosses": [
                            "Qui se rattache au symbolisme, en parlant de personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed02aae4-04fe-4574-98ee-9a0e3818cd81",
                                "sense_id": "cf5b5e8e-c45e-37b1-8a16-6a33d7ecb137",
                                "text": "— C’est cela, c’est cela ! dit vivement Camille, qui plaisantait durement d’ordinaire les peintres symbolistes, mais qui devait projeter d’attarder sa mère, avec l’espoir encore de lui faire manquer le rendez-vous."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c0f47ca-f4f5-3c6f-8167-1062b3fb3184",
                        "entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                        "glosses": [
                            "Qui s’exprime par symboles."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafebb24-9e09-4410-ae8c-413e8e1a77be",
                        "source_entry_id": "daee212b-4576-3ad8-8cbd-a609fdb0f6bb",
                        "source_sense_id": "b350cfb9-3c9b-3f61-985f-fdd868158f54",
                        "target_lang_word": "symbolist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbolist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d71843-77d9-3001-aab2-0075e47ac755",
                                        "entry_id": "437e5a73-371d-33cc-a0e9-713d8f3620b0",
                                        "glosses": [
                                            "Of or pertaining to the Symbolist movement in late 19th-century and early 20th-century European arts and literature"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ec100b-a1a3-4016-adf3-9353b0d2cff0",
                                                "sense_id": "c7d71843-77d9-3001-aab2-0075e47ac755",
                                                "text": "The general picture that has emerged is one of Cubism bubbling up out of a thick Parisian stew of symbolist poetry, Cézanne, cafe society, African masks, absinthe and a fascination with all things mechanical and modern, mostly airplanes and automatons."
                                            }
                                        ]
                                    }
                                ]
                            },
