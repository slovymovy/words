                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "69d0dc12-41cd-47e9-800b-4ed0a266c30f",
                                "sense_id": "2997371b-4551-3953-b780-c3cee3e7a4ba",
                                "text": "A letter begun to a Gentlewoman of some account, which was left of by means of the aduise of a friend of his, who said she was foresped."
                            },
                            {
                                "example_id": "2de09be6-6f90-4029-a531-56a84958cdd9",
                                "sense_id": "2997371b-4551-3953-b780-c3cee3e7a4ba",
                                "text": "Thus he spake; but now there sounded Through the night the holy bell That to Lord's Day matins gather'd Every monk from every cell. Eager at the sound, Columba In the way foresped the rest, And before the altar kneeling Pray'd with hands on holy breast."
                            },
                            {
                                "example_id": "1e3c22fb-c687-453d-b7fd-eab879aaeaeb",
                                "sense_id": "2997371b-4551-3953-b780-c3cee3e7a4ba",
                                "text": "\"And come he early, come he late,\" She saith, \"it will undo me; The sharp fore-speeded shaft of fate Already quivers through me.\""
                            }
                        ]
                    }
