                    },
                    {
                        "translation_id": "48c3f1ec-e8db-442c-9cc4-3159edab7c65",
                        "source_entry_id": "df1897d9-e9d8-36e9-8008-80b8580a5751",
                        "target_lang_word": "clematis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clematis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e82f6c-89cf-359c-8ef8-dc46f5217901",
                                        "entry_id": "8d4525cf-4689-307a-9b47-e41e704f8eba",
                                        "glosses": [
                                            "Any plant of the genus Clematis, vigorous climbing lianas found throughout the temperate zones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d89a2b-baba-42b8-bd57-432fb0da158f",
                                                "sense_id": "c3e82f6c-89cf-359c-8ef8-dc46f5217901",
                                                "text": "He came slowly up to the open door, which was all hung round with clematis and roses; and then peeped in, half afraid."
                                            },
                                            {
                                                "example_id": "1da937e1-57a0-4918-9d62-f49bf851c9ee",
                                                "sense_id": "c3e82f6c-89cf-359c-8ef8-dc46f5217901",
                                                "text": "Noiselessly she laid the clematis and wattle on her bed, then stood near the covered face, and, looking down at her untied bootlaces, sighed an impatient sigh always well known and understood by this now unresponsive father."
                                            },
                                            {
                                                "example_id": "08c485f5-365a-40c5-9a88-7c64511350ab",
                                                "sense_id": "c3e82f6c-89cf-359c-8ef8-dc46f5217901",
                                                "text": "Jim is a nurseryman, specialising in clematis, and he has built up a business exporting 150 varieties to countries all over the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eb9e2d9-1f2d-4175-93ec-ecda5be2ee97",
                        "source_entry_id": "df1897d9-e9d8-36e9-8008-80b8580a5751",
