                            "accusative",
                            "singular"
                        ],
                        "form": "die Sprachvarietät"
                    },
                    {
                        "form_id": "70f58deb-14d1-46de-b5fc-bfac54035a5b",
                        "entry_id": "1973bc82-a125-33d3-9ad0-af9b8e7eebfc",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Sprachvarietäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                        "entry_id": "1973bc82-a125-33d3-9ad0-af9b8e7eebfc",
                        "glosses": [
                            "Begriff für die verschiedenen lokalen, sozialen, temporalen Erscheinungsformen einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8749492d-fb9b-43cd-9a63-c17f88f0594e",
                                "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                                "text": "„Während die Standardsprache als die zentrale Sprachvarietät in einer Sprachgemeinschaft gilt, stellt die Jugendsprache eine gruppenspezifische Varietät dar.“"
                            },
                            {
                                "example_id": "67eef52e-0d4d-4a20-88ca-4505d79e1887",
                                "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                                "text": "„Daß die Soziolinguistik letztlich ein Beschreibungs- und Erklärungsmodell der verschiedenen Sprachvarietäten darstellt, wird bereits hier modellhaft deutlich.“"
                            },
                            {
                                "example_id": "f64ce1ec-d9bb-47ed-8d58-eb006d57923e",
                                "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                                "text": "„In seinem Konzept der »inneren Mehrsprachigkeit des Deutschen« zeigt H. Henne auf, daß Sprachvarietäten nicht nur nebeneinander, sondern miteinander existieren.“"
                            },
                            {
                                "example_id": "016df3b6-171c-40f8-ad34-5ad7dd52b021",
                                "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                                "text": "„Diese Art der wechselseitigen Beeinflussung von Sprachvarietäten und die dadurch bedingte Weiterentwicklung der Sprache ist in der Vergangenheit vorwiegend am Beispiel der Existenzformen untersucht worden, indem verschiedene Interferenzerscheinungen erfaßt wurden.“"
                            },
                            {
                                "example_id": "6967bc71-246b-4c9e-90ea-12749dcee877",
                                "sense_id": "ac299e04-30df-3f71-a887-2595d30e4882",
                                "text": "„Ohne Basiskenntnisse der Sprachvarietäten beziehungsweise der Regiolekte kommt man schwer voran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
