                        "glosses": [
                            "To stare; to stare gloatingly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d145c1cf-03a2-41bc-a78e-6d9e1a83ff0f",
                                "sense_id": "7873fbee-95f7-3343-b9eb-0787dab41c81",
                                "text": "... namely that whosoever attempteth any thing for the publike (specially if it pertaine to Religion, and to the opening and clearing of the word of God) the same setteth himselfe upon a stage to be glouted upon by every evil eye, yea, he casteth himselfe headlong upon pikes, to be gored by every sharpe tongue."
                            }
                        ]
