                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "baby_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>nipple</w> the bottle correctly to prevent leaks.",
