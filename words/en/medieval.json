                            {
                                "target_lang_word": "habitante de la Edad Media",
                                "target_lang_sense_clarification": "persona de esa época histórica"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "orta çağ insanı",
                                "target_lang_sense_clarification": "o dönemde yaşayan kişi"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mittelalterlicher",
