                        "translation_id": "9220507f-b386-4a54-8231-efd7e8840370",
                        "source_entry_id": "271ec5a3-9f14-3113-89ab-5b97de1f1624",
                        "source_sense_id": "42a90045-9a0a-315a-8466-52612bbcde10",
                        "target_lang_word": "enneahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enneahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e2f29a3-1bcd-3154-bea3-d58a2218db4e",
                                        "entry_id": "afb03919-281f-30ff-b16b-03cd2585ff48",
                                        "glosses": [
                                            "A polyhedron with nine faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afc4812f-64cf-44dd-b6de-b1a151409b6f",
                                                "sense_id": "1e2f29a3-1bcd-3154-bea3-d58a2218db4e",
                                                "text": "The enneahedron is a simple all-space filler discovered by myself, based on the cubic antiprism, again omitted by Wood."
                                            },
                                            {
                                                "example_id": "c4eb0138-d7ce-4e01-a30a-b73b57997625",
                                                "sense_id": "1e2f29a3-1bcd-3154-bea3-d58a2218db4e",
                                                "text": "1996, Michael O'Keeffe, Bruce G. Hyde, Crystal Structures, Number 1: Patterns & Symmetry, page 350,\nThis is based on a packing of 36-vertex icosahedra [5¹².6⁸] and enneahedra (4³.5⁶]."
                                            },
                                            {
                                                "example_id": "985f95ad-1bc9-49c8-8fec-3b5d38e766c5",
                                                "sense_id": "1e2f29a3-1bcd-3154-bea3-d58a2218db4e",
                                                "text": "In Figure 9.10.3 we see a projection of the skeleton of an enneahedron (a solid with nine faces). All the faces of this enneahedron are quadrilaterals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5456dfdb-5165-47a0-a525-3dfe13a79ba2",
                        "source_entry_id": "271ec5a3-9f14-3113-89ab-5b97de1f1624",
                        "source_sense_id": "42a90045-9a0a-315a-8466-52612bbcde10",
                        "target_lang_word": "nonahedron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonahedron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91e5dc19-b4a8-3312-840e-def1d7978cf3",
                                        "entry_id": "9c206d2b-dcc0-3756-820f-b6e9939d80c0",
                                        "glosses": [
                                            "A polyhedron with nine faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd8971a8-6051-4d52-a201-420fe48f01bb",
                                                "sense_id": "91e5dc19-b4a8-3312-840e-def1d7978cf3",
                                                "text": "A polyhedral oligomeric silsesquioxane (POSS), consisting mainly of a mixture of octahedra, nonahedra, and decahedra with bulky and flexible organic substituents, with three secondary hydroxyls per organic group, was used to modify epoxy networks produced by the homopolymerization of diglycidyl ether of bisphenol A in the presence of benzyldimethylamine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "583d6420-fe4c-4400-96f7-a7e964d4093e",
