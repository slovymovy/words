                ],
                "senses": [
                    {
                        "sense_id": "7e38ea71-f7db-3be0-a90d-db6697771bd8",
                        "entry_id": "02c29135-d669-33ed-9688-b2f30695c323",
                        "glosses": [
                            "kleine/kurze Straße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4958a351-50d5-4972-9745-5bc1f8e8813f",
                                "sense_id": "7e38ea71-f7db-3be0-a90d-db6697771bd8",
                                "text": "„Da die Bretagne das größte Agrargebiet Frankreichs ist, gibt es im Landesinneren zahlreiche Felder mit geteerten oder ungeteerten Sträßchen, aber nur wenig markierte Wege.“"
                            },
                            {
                                "example_id": "5ea91c08-751e-4e29-b52a-5e83a46971b4",
                                "sense_id": "7e38ea71-f7db-3be0-a90d-db6697771bd8",
                                "text": "„Um dorthin zu gelangen, durchquerte ich ein Labyrinth schmaler Sträßchen tief drinnen im Getto oder spazierte, zur Abwechslung, wenn ich die aufregende Tätigkeit der Schmuggler beobachten wollte, direkt an seinem Rand, die Mauer entlang.“"
                            },
                            {
                                "example_id": "ee3d0864-0af9-4e63-b81a-841ea973a86b",
                                "sense_id": "7e38ea71-f7db-3be0-a90d-db6697771bd8",
                                "text": "„Die krummen Sträßchen des Ortes entlang lief ich im Häuserschatten durch die Mittagshitze, die Straßen leer gefegt unter der Sommersonne, das Tappen meiner Schuhe auf den Pflastersteinen und die Geräusche von Fernsehern oder Gesprächen aus den von Jalousien verdunkelten Häusern, das Klappern von Besteck oder das Bellen eines Hundes meine einzigen Begleiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
