                "senses": [
                    {
                        "sense_id": "07735b80-930e-382e-bc10-c8c6c2c5cdfa",
                        "entry_id": "66ecf2fd-9e7e-38ba-b6b2-af8f4da5ad45",
                        "glosses": [
