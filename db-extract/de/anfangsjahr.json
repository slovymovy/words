                "senses": [
                    {
                        "sense_id": "ad30c0af-15bc-3be1-9322-a125e1e78f8f",
                        "entry_id": "10d79c3a-3c63-3ed4-aa8a-f2bdd20a0434",
                        "glosses": [
                            "Jahr, in dem etwas beginnt/entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a692d9-6481-47b8-817b-28d9137b42e9",
                                "sense_id": "ad30c0af-15bc-3be1-9322-a125e1e78f8f",
                                "text": "„Immer wieder hat es Benko in jenen Anfangsjahren verstanden, erfolgreiche Bündnisse zu schmieden.“"
                            },
                            {
                                "example_id": "97eb9774-699e-43e1-b2b4-904ea4a8cb35",
                                "sense_id": "ad30c0af-15bc-3be1-9322-a125e1e78f8f",
                                "text": "„Die Bewegung der Bündnisfreien überlebte Nehru, aber die Euphorie, die in ihren Anfangsjahren geherrscht hatte, war verflogen.“"
                            },
                            {
                                "example_id": "e6572793-a209-4c58-b3c2-add34321afe1",
                                "sense_id": "ad30c0af-15bc-3be1-9322-a125e1e78f8f",
                                "text": "„Bereits in seinen Anfangsjahren als Premierminister ab 1980 ließ der «Hoffnungsträger» politische Gegner foltern und hieß solche Praktiken in aller Öffentlichkeit gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
