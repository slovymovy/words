                    }
                ],
                "senses": [
                    {
                        "sense_id": "52fa640d-2059-3ef3-8ac7-cd1756aae8d1",
                        "entry_id": "0622e4c3-2af4-3e52-8dbf-15f64e02eb3e",
                        "glosses": [
                            "Prunus persica boom waaraan perziken groeien (en soms ook nectarines)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b660a174-810a-4e86-8e54-bb9ee7bfb110",
                                "sense_id": "52fa640d-2059-3ef3-8ac7-cd1756aae8d1",
                                "text": "Wat hen wel bevallen zal zijn, is dat perzikbomen snel vrucht dragen (na twee, drie jaar zijn ze al productief), en dat ze goed te selecteren zijn op grootte en zoetheid. Allemaal redenen waarom perziken tot de eerste gekweekte fruitsoorten zullen hebben behoord."
                            },
                            {
                                "example_id": "26b4752e-0e15-44da-8d3c-356df44fa32d",
                                "sense_id": "52fa640d-2059-3ef3-8ac7-cd1756aae8d1",
                                "text": "Roald Dahl: James and the Giant Peach: Een levende krokodillentong betovert de perzikboom in de tuin, en wanneer James van de reusachtige vruchten eet, verandert zijn hele wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "785a8a21-8f62-49a0-8ec2-c51458a8e9da",
                        "source_entry_id": "0622e4c3-2af4-3e52-8dbf-15f64e02eb3e",
                        "source_sense_id": "52fa640d-2059-3ef3-8ac7-cd1756aae8d1",
                        "source_sense_description": "(plantkunde) (Prunus persica) boom waaraan perziken groeien (en soms ook nectarines)",
                        "target_lang_word": "peach",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2373f34-cd22-3175-8eea-f7674c03ac60",
                                        "entry_id": "7caca213-cd0e-3f75-9e92-d4e6ae3a23ab",
                                        "glosses": [
                                            "Any tree of species Prunus persica, native to China and now widely cultivated throughout temperate regions, having pink flowers and edible fruit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "234ca7db-75d0-463f-9ce9-da2320b45565",
                                                "sense_id": "c2373f34-cd22-3175-8eea-f7674c03ac60",
                                                "text": "I think it the best way to plant the fifteen sorts, and the hard Peaches I have mentioned, in the same order as they stand in the list."
                                            },
                                            {
                                                "example_id": "fb8adcf6-c584-4c2d-be89-0b164488eaa8",
                                                "sense_id": "c2373f34-cd22-3175-8eea-f7674c03ac60",
                                                "text": "Several attempts have been made to class the varieties of Peaches and Nectarines by the leaf and flower, as well as the fruit."
                                            },
                                            {
                                                "example_id": "451fe075-baad-4d55-a99b-ebbf5d1b59ee",
                                                "sense_id": "c2373f34-cd22-3175-8eea-f7674c03ac60",
                                                "text": "Scattered plantings of peaches are maintained on the light-textured deep alluvial soils of the Foster, Cajon, Hanford, Hesperia, and Greenfield series west of Porterville, near Woodville, Poplar, Sausalito School, and farther south along the Kern County boundary line north of Delano."
                                            },
                                            {
                                                "example_id": "6d7f3f1a-ed79-4781-bafd-168564dcc51d",
                                                "sense_id": "c2373f34-cd22-3175-8eea-f7674c03ac60",
                                                "text": "State universities and U.S. Department of Agriculture facilities have largely replaced the private state and national pomological and horticultural organizations as the primary researchers for peach cultivation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0cc129b-77a3-31ad-8bd4-8b822a636f6d",
                                        "entry_id": "7caca213-cd0e-3f75-9e92-d4e6ae3a23ab",
                                        "glosses": [
                                            "Soft juicy stone fruit of the peach tree, having yellow flesh, downy, red-tinted yellow skin, and a deeply sculptured pit or stone containing a single seed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b399964f-78f5-42e3-b364-3c074e3c7d60",
                                                "sense_id": "e0cc129b-77a3-31ad-8bd4-8b822a636f6d",
                                                "text": "[A]nd that the English should eat peaches in May, and green pease in October, sounds to Italian ears as a miracle; they comfort themselves, however, by saying that they must be very insipid, while we know that fruits forced by strong fire are at least many of them higher in flavour than those produced by sun […]"
                                            },
                                            {
                                                "example_id": "a35a7c55-8881-41ca-860d-99510d9afa5a",
                                                "sense_id": "e0cc129b-77a3-31ad-8bd4-8b822a636f6d",
                                                "text": "When dissolved, stir it up well, and put in the peaches, without crowding them, and boil them slowly about twenty minutes."
                                            },
                                            {
                                                "example_id": "be9a7faa-7292-4102-99af-557f4a870ba6",
                                                "sense_id": "e0cc129b-77a3-31ad-8bd4-8b822a636f6d",
                                                "text": "Shall I part my hair behind? Do I dare eat a peach? / I shall wear white flannel trousers, and walk upon the beach."
                                            },
                                            {
                                                "example_id": "a517feb3-a270-4d28-9f85-596f42b4bae1",
                                                "sense_id": "e0cc129b-77a3-31ad-8bd4-8b822a636f6d",
                                                "text": "Boiling water or steam loosens the peel of very ripe peaches, especially freestone or melting-flesh types, in 10–30 sec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2b59c96-bad1-38d0-8a9d-e3c949c86c5a",
                                        "entry_id": "7caca213-cd0e-3f75-9e92-d4e6ae3a23ab",
                                        "glosses": [
                                            "A light yellow-red colour."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85438e69-eb5a-43a9-87b5-d55dfff71508",
                                                "sense_id": "c2b59c96-bad1-38d0-8a9d-e3c949c86c5a",
                                                "text": "To dye one chip bonnet peach colour, put four ounces of cudbear in one gallon of water, make it boil, and put one ounce of soda in the liquor."
                                            },
                                            {
                                                "example_id": "4b317ec1-3a8b-4294-a362-6c2031058d2b",
                                                "sense_id": "c2b59c96-bad1-38d0-8a9d-e3c949c86c5a",
                                                "text": "If the dye is for a light color such as peach, more dry dye could be used."
                                            },
                                            {
                                                "example_id": "9fcc5b74-d13e-4f30-a7dc-4aa1591eacf3",
                                                "sense_id": "c2b59c96-bad1-38d0-8a9d-e3c949c86c5a",
                                                "text": "Circle Quilt throw in peach and green"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09848405-6dec-3bd9-84ee-053d7f036f8c",
                                        "entry_id": "7caca213-cd0e-3f75-9e92-d4e6ae3a23ab",
                                        "glosses": [
                                            "A particularly admirable or pleasing person or thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abca0fec-ac1a-4255-938b-d833e4699f5b",
                                                "sense_id": "09848405-6dec-3bd9-84ee-053d7f036f8c",
                                                "text": "How did the common expressions \"She's a peach!\" and \"He has a peach of a job!\" arise if not because the peach of all fruits is a symbol of perfection?"
                                            },
                                            {
                                                "example_id": "1c7f1021-d688-490a-8f32-9f635c395c30",
                                                "sense_id": "09848405-6dec-3bd9-84ee-053d7f036f8c",
                                                "text": "Walking on the beaches / looking at the peaches"
                                            },
                                            {
                                                "example_id": "5adf78ec-6d6a-41a3-a6c8-cfb87487489e",
                                                "sense_id": "09848405-6dec-3bd9-84ee-053d7f036f8c",
                                                "text": "Except for the loss of Uncle Jack's income, his mother's growing disenchantment with her domestic arrangements, and the deepening Depression, it was a peach of a time for Berryman."
                                            },
                                            {
                                                "example_id": "de682671-2740-423e-80a9-46ff843af94a",
                                                "sense_id": "09848405-6dec-3bd9-84ee-053d7f036f8c",
                                                "text": "Arsenal's dominance was reflected in a flurry of goals before half-time – three in six minutes: first, Podolski turned the screw with a peach of a free-kick; then Gervinho accelerated on to Mikel Arteta's beautifully crafted pass and beat Davis at his near post with conviction; and finally Southampton's defence unspooled completely when Gervinho broke to release Gibbs, whose return ball cannoned off Nathaniel Clyne for Southampton's second own goal of a sobering afternoon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ea8e95-2242-3474-97e0-ec0d04b95c23",
                                        "entry_id": "7caca213-cd0e-3f75-9e92-d4e6ae3a23ab",
                                        "glosses": [
                                            "Buttock or bottom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "often",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98b82b54-cdef-4a41-a74e-67fd26dbdf9f",
                                                "sense_id": "22ea8e95-2242-3474-97e0-ec0d04b95c23",
                                                "text": "Down on the beaches, just look at all the peaches"
                                            },
                                            {
                                                "example_id": "0c8d358a-706a-40e4-8baa-65c156ba16f6",
                                                "sense_id": "22ea8e95-2242-3474-97e0-ec0d04b95c23",
                                                "text": "Gia danced around a little, shaking her peaches for show. She shook it hard. Too hard. In the middle of a shimmy, her stomach cramped. A fart slipped out. A loud one. And stinky."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6067e94-6689-38ec-925e-0f89019f40b7",
                                        "entry_id": "55ca2457-14f7-34d1-b335-36e8a6cefaea",
                                        "glosses": [
                                            "Of or pertaining to the color peach."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8dbd621-ec20-4742-bf67-ad8bfe58b836",
                                                "sense_id": "b6067e94-6689-38ec-925e-0f89019f40b7",
                                                "text": "Looking around her very large and very peach open kitchen and family room, I couldn't believe my eyes, but I knew the color must be there for a reason."
                                            },
                                            {
                                                "example_id": "82fe8257-65f9-4bb6-88a9-9ebc18c6f227",
                                                "sense_id": "b6067e94-6689-38ec-925e-0f89019f40b7",
                                                "text": "The dining compartment was very peach."
                                            },
                                            {
                                                "example_id": "21b28484-8577-429d-a6b7-a5b3e92c7e6e",
                                                "sense_id": "b6067e94-6689-38ec-925e-0f89019f40b7",
                                                "text": "Perhaps this is best illustrated in the particularly bizarre Kinkade painting entitled The Good Shepherd's Cottage, where an openarmed (and very peach) Jesus welcomes a herd of sheep—literal sheep—to the threshold of a glowing cottage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08fdf271-6266-3425-9351-6c3192aececf",
                                        "entry_id": "55ca2457-14f7-34d1-b335-36e8a6cefaea",
                                        "glosses": [
                                            "Particularly pleasing or agreeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "515930ee-7f2d-45ea-80ed-13ea62055c32",
                                                "sense_id": "08fdf271-6266-3425-9351-6c3192aececf",
                                                "text": "'That'll be just peach with me.'"
                                            },
                                            {
                                                "example_id": "3110a65a-ce46-4328-bbc4-316a05045129",
                                                "sense_id": "08fdf271-6266-3425-9351-6c3192aececf",
                                                "text": "If I explain that I won't help them maintain systems running proprietary software (I'll make an exception for firmware, sometimes.) they usually shrug their shoulders and ask someone else -- which is just peach with me."
                                            },
                                            {
                                                "example_id": "de2cb56b-c99b-45e4-bf47-ee6a83360f8d",
                                                "sense_id": "08fdf271-6266-3425-9351-6c3192aececf",
                                                "text": "Her words were peach with sincerity, and I could tell she really believed it was a good idea."
                                            },
                                            {
                                                "example_id": "069041e4-cd18-4499-83a7-03cf9fa09710",
                                                "sense_id": "08fdf271-6266-3425-9351-6c3192aececf",
                                                "text": "I am sure I was just peach to deal with."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8493ee49-4d6d-310a-a73c-1ac8c6c33701",
                                        "entry_id": "1e7da62a-fae5-3180-9f43-75da8b6dc0eb",
                                        "glosses": [
                                            "To inform on someone; turn informer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91cf4314-2bd4-4d6d-846d-10598100f602",
                                                "sense_id": "8493ee49-4d6d-310a-a73c-1ac8c6c33701",
                                                "text": "If I be ta'en, I'll peach for this."
                                            },
                                            {
                                                "example_id": "2243dfa9-ba39-4a62-a8f7-f29eddb6c977",
                                                "sense_id": "8493ee49-4d6d-310a-a73c-1ac8c6c33701",
                                                "text": "\"But will your cousin tell?\" was Ripton's reflection.\n\"He!\" Richard's lip expressed contempt. \"A ploughman refuses to peach, and you ask if a Feverel will?\""
                                            },
                                            {
                                                "example_id": "7982a524-37bb-4d94-ad6f-8c630021ff6d",
                                                "sense_id": "8493ee49-4d6d-310a-a73c-1ac8c6c33701",
                                                "text": "And his father had told him if he ever wanted anything to write home to him and, whatever he did, never to peach on a fellow."
                                            },
                                            {
                                                "example_id": "43bb44a2-63aa-4a7d-b39d-8c9432b3a7e3",
                                                "sense_id": "8493ee49-4d6d-310a-a73c-1ac8c6c33701",
                                                "text": "\"Do you think we want to peach? No, thank you. We may be none too good, but we won't hang a guy up, no matter who he is.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8431358a-9b64-38cb-9a45-dc910d0a0fc0",
                                        "entry_id": "1e7da62a-fae5-3180-9f43-75da8b6dc0eb",
                                        "glosses": [
                                            "To inform against."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "975f2712-7f8d-453f-8571-dc7e21f5ceca",
                                                "sense_id": "8431358a-9b64-38cb-9a45-dc910d0a0fc0",
                                                "text": "Complaining of the conduct of Sir Ralph Robinson, parson of Brede, in Sussex, who took from him a psalter book in English, printed cum privilegio regali, and peached him of heresy, whereupon he was put in the stocks by the King's constable for two days."
                                            },
                                            {
                                                "example_id": "09778d33-99d7-47dc-a95f-32947e2cb045",
                                                "sense_id": "8431358a-9b64-38cb-9a45-dc910d0a0fc0",
                                                "text": "[…] and finding out the residence of his brother Charles, desires him not to peach him, but to lend him a suit of his fine cloaths, that he might see what it was to be a fine gentleman […]"
                                            },
                                            {
                                                "example_id": "9e607e82-303c-4d15-8994-4e8e9e37482d",
                                                "sense_id": "8431358a-9b64-38cb-9a45-dc910d0a0fc0",
                                                "text": "Ay, says Will, I am undone for all that; for the officers are after me; and I am a dead dog if I am taken, for George is in custody, and he has peached me and all the others, to save his life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be03cc36-fbe3-3485-9c53-dc04e48857bf",
                                        "entry_id": "6a66ee80-1604-34b0-9aaa-ee07b39e8e85",
                                        "glosses": [
                                            "A particular rock found in tin mines, sometimes associated with chlorite."
                                        ],
                                        "tags": [
                                            "Cornwall",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a144fba-5398-4289-af2c-040a6774d949",
                                                "sense_id": "be03cc36-fbe3-3485-9c53-dc04e48857bf",
                                                "text": "Chlorite forms the characterizing ingredient in chlorite slate; it is common in Cornwall with the tin veins, constituting with quartz the rock commonly known there as killas; the ordinary name for chlorite is peach."
                                            },
                                            {
                                                "example_id": "ce283170-3622-4c0e-a92f-2e4d49e313c7",
                                                "sense_id": "be03cc36-fbe3-3485-9c53-dc04e48857bf",
                                                "text": "Peach, which is a word used by the Cornish miners, in a generic sense, to denote all minerals of the chloritic family—and is consequently a very convenient word—seems to be essentially the \"mother\" of tin; but the experience of Cornwall goes to show that peach alone does not produce a permanent tin mine: an intermixture of quartz is necessary to give what miners call \"strength\" to the lode."
                                            },
                                            {
                                                "example_id": "3077fe00-7be1-4498-bab3-e2a7aa4f411d",
                                                "sense_id": "be03cc36-fbe3-3485-9c53-dc04e48857bf",
                                                "text": "A quartz (sparry) vein, unless accompanied by other minerals such as peach, chlorite, &c., is considered valueless as an indication of the presence of ore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
