            {
                "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                "word": "blob",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f7489932-23e3-4121-a5cc-6ee58edd35c7",
                        "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "tags": [
                            "plural"
                        ],
                        "form": "blobs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5236f3a7-4ae2-301f-a0ab-567ace890d58",
                        "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "glosses": [
                            "Nom vernaculaire des myxomycètes au développement plasmodial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34af9bd6-29b3-4749-afbf-612837d3d682",
                                "sense_id": "5236f3a7-4ae2-301f-a0ab-567ace890d58",
                                "text": "Le Physarum polycephalum, ce blob à une cellule, mais plein d’extensions."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e15c896-cbec-342b-a2b5-e79f3a1fb82f",
                        "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "glosses": [
                            "Physarum polycephalum et, plus rarement, Fuligo septica."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f0b09631-0f00-4b83-9a9f-5891bf2264a7",
                                "sense_id": "9e15c896-cbec-342b-a2b5-e79f3a1fb82f",
                                "text": "Les chercheurs l’ont surnommé «le blob», en raison de son côté informe. Mais «le blob» est plein de ressource."
                            }
                        ]
                    },
                    {
                        "sense_id": "73b4dabc-0ce9-3317-8f5b-24f74d0cb85e",
                        "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "glosses": [
                            "Vaste zone océanique à la température différente de la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cabd27b1-65f1-4e8c-ae79-a2208ec49e3a",
                                "sense_id": "73b4dabc-0ce9-3317-8f5b-24f74d0cb85e",
                                "text": "Les canicules océaniques peuvent durer des semaines, des mois, voire des années, à l’instar du Blob, une vague de chaleur océanique au large de l’Alaska qui a duré plus de 3 ans."
                            }
                        ]
                    },
                    {
                        "sense_id": "79ae40ef-9122-3c96-9dd5-4765a5c27a89",
                        "entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "glosses": [
                            "Masse à l’intérieur du manteau terrestre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa7eb1b-ca7f-45cf-9672-631a2ffbb097",
                                "sense_id": "79ae40ef-9122-3c96-9dd5-4765a5c27a89",
                                "text": "Deux énormes « blobs », gros comme des continents, reposent sous le manteau terrestre, à 2900 Kilomètres de profondeur. Des scientifiques sont peut-être sur le point de résoudre leur mystère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70c9c15f-6309-4109-ad2b-7840625be657",
                        "source_entry_id": "fcab1758-61cf-3f55-81e4-defbec1cf25e",
                        "target_lang_word": "blob",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "191f97a3-027d-3d51-9754-0ccb615756b1",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A shapeless or amorphous mass; a vague shape or amount, especially of a liquid or semisolid substance; a clump, group or collection that lacks definite shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9e9ddc-9cee-4580-8827-e4ada70d5c17",
                                                "sense_id": "191f97a3-027d-3d51-9754-0ccb615756b1",
                                                "text": "Only the outermost blob on either side in map 2 displays misalignment."
                                            },
                                            {
                                                "example_id": "59b18053-0300-47a0-80ce-f581a37f73c0",
                                                "sense_id": "191f97a3-027d-3d51-9754-0ccb615756b1",
                                                "text": "It was a colourful vase with red and white hoops on the lid, and red bands above and below the main frieze. These bands also carry a metope pattern in white of triple lines and blobs, which can just be distinguished on the photographs."
                                            },
                                            {
                                                "example_id": "7dbacc2c-db32-49c8-b872-7e91f59a396c",
                                                "sense_id": "191f97a3-027d-3d51-9754-0ccb615756b1",
                                                "text": "But there, on the very top, is a hollow full of water, with a sandy bottom; with a blob of jelly stuck to the side, and some mussels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "866c37cc-c9a4-3c65-9433-bd62390e9653",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A large cloud of gas."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "362dae8b-664f-36e9-9562-abc8d44ea5d9",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A large cloud of gas.",
                                            "Ellipsis of extended Lyman-Alpha blob, a huge body of gas that may be the precursor to a galaxy."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45e6dfa7-6424-3f0f-ad53-abcd2237e3ac",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A bubble; a bleb."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "121bf6cf-119a-3f2e-84ad-9a38d7437b9b",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A small freshwater fish (Cottus bairdii); the miller's thumb."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23c1e65e-6328-3221-90f8-90c1fa5a0387",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "The partially inflated air bag used in the sport of blobbing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71c90f79-489b-34ac-a1ff-63cd2ca236e6",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "A score of zero."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee2ca842-1024-4db0-ac76-71b1ce4748fe",
                                                "sense_id": "71c90f79-489b-34ac-a1ff-63cd2ca236e6",
                                                "text": "A gentleman named W. Shakespeare scored a blob in the Worcestershire v. Lancashire match. We understand that he got out because the ball pitched on a \"damned spot.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58f0d477-b385-3c37-9490-59b2812d32ca",
                                        "entry_id": "79323c2f-fe30-3fc4-a38b-ff880e183eb9",
                                        "glosses": [
                                            "Physarum polycephalum, a bright yellow acellular slime mold known for solving puzzles, making decisions, etc. without a nervous system."
                                        ],
                                        "tags": [
                                            "as the blob"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blob",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a56aecb-23bf-398b-9815-67032ae62718",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To splash in the form of a blob or blobs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0406f6a1-8206-4f55-9b30-98afafc282dd",
                                                "sense_id": "5a56aecb-23bf-398b-9815-67032ae62718",
                                                "text": "Bones put the tiny crimson speck between his slides, blobbed a drop of oil on top, and focused the microscope."
                                            },
                                            {
                                                "example_id": "4abcf9b5-9c4d-4f6d-85b1-f0568f5af87f",
                                                "sense_id": "5a56aecb-23bf-398b-9815-67032ae62718",
                                                "text": "[…] a cross has been burned during the night on Wechsler's lawn and a painted KKK blobbed across one wall of his home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "819beecd-7fcd-3265-adf9-63e6903b9c76",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To drop a blob or blobs onto; to cover with blobs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a236f68-2194-4bf2-b6f2-ce209aff72c5",
                                                "sense_id": "819beecd-7fcd-3265-adf9-63e6903b9c76",
                                                "text": "She was beating something in a pail, beating it with her hands; her arms were blobbed with pink froth to the elbows."
                                            },
                                            {
                                                "example_id": "06a18fe6-f4a2-4d45-b7db-31f081eca3e9",
                                                "sense_id": "819beecd-7fcd-3265-adf9-63e6903b9c76",
                                                "text": "Asked to do a mural in the coffee room of the Municipal Museum, Appel responded by blobbing all four walls and the ceiling with brilliant colors […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "056a0541-f301-3893-acad-6b2a69b380bd",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To fall in the form of a blob or blobs."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdaa6c6e-da53-4708-9bb5-3fc7bc9b1545",
                                                "sense_id": "056a0541-f301-3893-acad-6b2a69b380bd",
                                                "text": "Caroline began to separate eggs, cracking them into unbelievably even halves, sliding the gold, round and elastic, from shell to shell, whilst the white hung, heavy, translucent, in thick sheets, and blobbed suddenly into her basin."
                                            },
                                            {
                                                "example_id": "086829a3-7f58-4767-ae3f-fc69eb8ab258",
                                                "sense_id": "056a0541-f301-3893-acad-6b2a69b380bd",
                                                "text": "2013, Marcus Berkmann, \"Blood and gore of the real 'who dunnits',\" Review of Silent Witnesses by Nigel McCrery, Daily Mail, 22 August, 2013, http://www.dailymail.co.uk/home/books/article-2400118/Blood-gore-real-dunnits-SILENT-WITNESSES-BY-NIGEL-MCCRERY.html\n[…] whether the blood has splashed, or blobbed, or trickled, can reveal whether the victim was killed here or moved afterwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "589ee3d8-59c1-33b5-9f01-e89461417e81",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To spill sauce on oneself while eating."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "feb1de15-1c3d-3f30-ac19-52c609fae77f",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To relax idly and mindlessly; to veg out."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3c9871cd-4b6b-3fb8-8e9e-d2a7ad28e1ea",
                                        "entry_id": "f3cd29c6-b03d-31b1-be16-9b1cc333893e",
                                        "glosses": [
                                            "To catch eels by means of worms strung on a thread."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395a400f-322e-4b0e-ab2e-e9c63fc52dbc",
                                                "sense_id": "3c9871cd-4b6b-3fb8-8e9e-d2a7ad28e1ea",
                                                "text": "[…] where he had surreptitiously tickled small trout, or openly \"blobbed\" for eels with worms threaded on to darning wool when the rains came, […]"
                                            }
