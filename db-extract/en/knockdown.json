                    {
                        "sense_id": "ddd8739f-39f0-30a0-af8b-acfa578f3166",
                        "entry_id": "a86e3885-76e7-33de-94ff-5f3a9aee4482",
                        "glosses": [
                            "a short pass played downwards, for example from the head onto someone's feet."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6cc776e-20d1-487c-bc67-b06902f9bbdf",
                                "sense_id": "ddd8739f-39f0-30a0-af8b-acfa578f3166",
                                "text": "Pires, a three-time Cup winner with Arsenal who scored the Gunners' winner against Southampton in the 2003 final, has been a largely peripheral figure at Villa Park since joining in November - but the 37-year-old rolled back the years with a fine finish from Delfouneso's knockdown."
                            }
                        ]
                    },
                    {
                        "sense_id": "d02ab596-2882-33af-b487-fbda5cc027bc",
                        "entry_id": "a86e3885-76e7-33de-94ff-5f3a9aee4482",
                        "glosses": [
                            "A shelter erected for use as a temporary dressing room."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72f0a245-ffd0-4dc5-9290-f8e4e4e0fd90",
                                "sense_id": "d02ab596-2882-33af-b487-fbda5cc027bc",
                                "text": "We shot 'The Caterpillar' at General Service Studios, and the dressing rooms for the actors were what they call knockdowns: wooden frames covered in grungy, dirty red canvas. It looked like a circus tent."
                            }
                        ]
                    },
                    {
