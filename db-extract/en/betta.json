                ],
                "senses": [
                    {
                        "sense_id": "8ed36a20-d3f5-334d-a442-8accdac168a3",
                        "entry_id": "a3f197b3-e1f9-3d02-b183-0a5740c94ee9",
                        "glosses": [
                            "Any fish of the genus Betta, especially Betta splendens (the Siamese fighting fish)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517e46c2-f492-4054-bb34-dc2bbf45dbd9",
                                "sense_id": "8ed36a20-d3f5-334d-a442-8accdac168a3",
                                "text": "Rather than simply waiting for a clockwise turn and then presenting the mirror, past experience with another betta suggested that the turning behavior could be established more rapidly using a shaping procedure."
                            },
                            {
                                "example_id": "ed97c084-2198-401d-9645-0a2bcc54315a",
                                "sense_id": "8ed36a20-d3f5-334d-a442-8accdac168a3",
                                "text": "\"Do you know that Siamese fighting fish—bettas—excrete ammonia in their waste, and that ammonia is toxic to fish? Twenty-four hours flapping their little gills in the same, unfiltered water, and they're history.[…]\""
                            },
                            {
                                "example_id": "ea5c38f3-8772-4a42-9b79-f92d5b5a32dc",
                                "sense_id": "8ed36a20-d3f5-334d-a442-8accdac168a3",
                                "text": "I had previously bought a bright red betta fish from the Chinese spiritual store, which I also sense had been sent for Aurayah."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1efc4145-45f3-4e1f-9afb-0cce2007b557",
                        "source_entry_id": "a3f197b3-e1f9-3d02-b183-0a5740c94ee9",
                        "source_sense_id": "8ed36a20-d3f5-334d-a442-8accdac168a3",
                        "source_sense_description": "Fish of the genus Betta",
