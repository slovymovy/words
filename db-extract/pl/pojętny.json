                        "translation_id": "773a0bd6-799a-4134-ad06-4d338b21148a",
                        "source_entry_id": "29fe9a50-bd58-3e0f-9e86-98f88f32ebf4",
                        "source_sense_id": "d09f6118-bb95-3a0f-a5b2-8e4f63fbdb92",
                        "target_lang_word": "gelehrig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelehrig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f262335-e700-3018-b3d9-5aa9323b104e",
                                        "entry_id": "dc8cd04a-bc52-3561-bbda-7338e938dafe",
                                        "glosses": [
                                            "gerne und schnell lernend, schnell in der Auffassung, leicht zu belehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ebae7b-e5a3-4dd6-85cb-b6a73b216dde",
                                                "sense_id": "4f262335-e700-3018-b3d9-5aa9323b104e",
                                                "text": "Karl, der die Worte des Paters begierig in sich aufnahm, war inzwischen einer seiner gelehrigsten Schüler geworden."
                                            },
                                            {
                                                "example_id": "c06d3093-55d4-47f6-b9d5-253cabc4e527",
                                                "sense_id": "4f262335-e700-3018-b3d9-5aa9323b104e",
                                                "text": "Ein gelehriges Tier kann seine Lebensgewohnheiten schnell der menschlichen Umgebung anpassen."
                                            },
                                            {
                                                "example_id": "2909a545-a3e6-41d0-b741-cf7a64fe0a4b",
                                                "sense_id": "4f262335-e700-3018-b3d9-5aa9323b104e",
                                                "text": "„Die gelehrigen Dickhäuter bildeten in dem unwegsamen Dschungel eine unschätzbare Hilfe, zumal sie im ausgewachsenen Zustand außer dem Menschen keine natürlichen Feinde haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
