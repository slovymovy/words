                        "examples": [
                            {
                                "example_id": "bf0b2ded-1936-4611-990b-0d77a9789c25",
                                "sense_id": "bc92f4e0-e168-3c18-a59d-f3791373baa2",
                                "text": "Hij heeft een talent voor het schrijven van pakkende songteksten.",
                                "translation": "He has a talent for writing catchy lyrics.",
                                "english": "He has a talent for writing catchy lyrics."
                            },
                            {
                                "example_id": "34170e5f-c9f3-43a4-bdcb-75d271610cc6",
                                "sense_id": "bc92f4e0-e168-3c18-a59d-f3791373baa2",
                                "text": "De bandleden werken samen aan het schrijven van de songteksten voor hun nieuwe album.",
                                "translation": "The band members collaborate on writing the lyrics for their new album.",
                                "english": "The band members collaborate on writing the lyrics for their new album."
                            },
                            {
                                "example_id": "fbdf8bc0-a3f8-453d-b8e4-d6c9a1f9f421",
                                "sense_id": "bc92f4e0-e168-3c18-a59d-f3791373baa2",
                                "text": "De zangeres zingt met veel emotie en brengt de songteksten tot leven.",
                                "translation": "The singer sings with a lot of emotion and brings the lyrics to life.",
                                "english": "The singer sings with a lot of emotion and brings the lyrics to life."
                            }
                        ]
                    }
