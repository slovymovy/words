                        "glosses": [
                            "Grandeur physique mesurant la propension d’un matériau d’une épaisseur donnée à laisser passer la vapeur d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65f6ddb-6c6f-4f22-bbed-a30815593323",
                                "sense_id": "0b70ccba-0791-3ee3-9729-b4a2fff33ec2",
                                "text": "La perméance est égale à la quantité de vapeur d'eau qui traverse un mètre carré en une heure avec un gradient de pression de 1 mm de Hg."
                            },
                            {
                                "example_id": "5b8f5d2e-942b-44cb-88f2-8f958bcbaacd",
                                "sense_id": "0b70ccba-0791-3ee3-9729-b4a2fff33ec2",
                                "text": "Pour une perforation donnée, la perméance tend vers une valeur constante en deçà d’une taille limite de particule."
                            }
                        ]
                    }
