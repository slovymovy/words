                                "target_senses": [
                                    {
                                        "sense_id": "918513ad-1223-3d54-98e7-a7ebe083c77c",
                                        "entry_id": "30301ca1-03eb-35d5-89c4-bc2fbd74ba43",
                                        "glosses": [
                                            "Relatif à la cryogénie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08486a62-e795-4680-b534-6abf6e1e91e4",
                                                "sense_id": "918513ad-1223-3d54-98e7-a7ebe083c77c",
                                                "text": "Il se tourna vers Alvare, la jeune femme qui l'accompagnait, responsable scientifique de la mission, spécialiste en exobiologie et terraformation. Une belle femme brune d'ailleurs, qui, les derniers temps du voyage, n'était jamais sortie de sa réserve glaciale, comme si son cerveau et son corps n'étaient pas parvenus à se remettre de la stase cryogénique."
                                            },
                                            {
                                                "example_id": "82a6abaa-e13a-4ef6-9541-2325e01fb6d2",
                                                "sense_id": "918513ad-1223-3d54-98e7-a7ebe083c77c",
                                                "text": "Le principe est connu mais reste à mettre au point pour des liquides cryogéniques, c'est-à-dire l'hydrogène et l'oxygène liquides."
                                            },
                                            {
                                                "example_id": "edafe77f-44a8-4562-84ee-3ad6ecc79247",
                                                "sense_id": "918513ad-1223-3d54-98e7-a7ebe083c77c",
                                                "text": "Durant leurs travaux, les ingénieurs d’Absolut ont mis au point une caméra hyperspectrale cryogénique dont le seuil de détection est d’une précision unique sur le marché et d’un niveau de résolution lui aussi inédit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
