    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "111fb327-7abd-3bdc-86d2-c6b16e597c47",
                "word": "afterpain",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "56bdeaa0-9595-4c48-9861-e845565eb6e4",
                        "entry_id": "111fb327-7abd-3bdc-86d2-c6b16e597c47",
                        "tags": [
                            "plural"
                        ],
                        "form": "afterpains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                        "entry_id": "111fb327-7abd-3bdc-86d2-c6b16e597c47",
                        "glosses": [
                            "Pain that occurs or remains after an event, such as surgery (especially dental surgery), eating spicy food, or simply an initial, sharper pain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c34c28ed-ecc0-47aa-9074-72ffe5a6ab67",
                                "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                                "text": "[Causes of] afterpain are rapid injection of the solution or using it too hot, and where the solution is taken from a stock bottle and not boiled; afterpain may also result from sepsis. The enigma of afterpain will undoubedly always by with us[…]"
                            },
                            {
                                "example_id": "76cd3a98-492b-4df8-bb4e-f70ef50781c8",
                                "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                                "text": "In spite of all our precautions to avoid afterpain, in spite of the fact that our instruments are properly sterilized and our technique is perfect in every way, nevertheless, pain often follows ex-tractions."
                            },
                            {
                                "example_id": "a4923292-c989-45c0-b936-e6ebe9eb7228",
                                "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                                "text": "[…] he vomited a great deal of red material. […] The sharp pain had not been continuous, but a dull afterpain persisted from one attack of sharp pain to the next attack of sharp pain."
                            },
                            {
                                "example_id": "075d67f6-c3ce-4d29-9c6a-1582a14e5058",
                                "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                                "text": "After dental treatment, afterpain may occur. This is not caused by the administration of local anaesthesia but by tissue damage during dental treatment. Depending on the dental treatment, the expected afterpain may be severe[…]"
                            },
                            {
                                "example_id": "d5a1dcf4-59f1-4788-b9f8-b395fc140d36",
                                "sense_id": "36520dd5-9476-36f5-b839-322937ba64ac",
                                "text": "\"And how long did the sort of afterpain last for on that [eating spicy nuts]?\" \"Till the following morning, for sure.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "4be63f21-829f-3fee-9a79-1456fe652668",
                        "entry_id": "111fb327-7abd-3bdc-86d2-c6b16e597c47",
                        "glosses": [
                            "Pain of uterine contractions experienced after childbirth (especially after passage of the placenta)."
                        ],
                        "tags": [
                            "in-plural",
                            "often"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
