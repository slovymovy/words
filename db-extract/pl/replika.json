                    {
                        "translation_id": "97924138-b70b-48f5-9843-4b386ee712f0",
                        "source_entry_id": "a189c5a0-dbcc-36d1-9108-b1a08b9c30dd",
                        "source_sense_id": "838a774f-a230-33b0-be5d-336c5280cae0",
                        "target_lang_word": "Replik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Replik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c723381-d004-3d7c-85cf-68d4e1e63e3a",
                                        "entry_id": "70e33b32-6a41-3191-a7f6-bd360fd9c5ae",
                                        "glosses": [
                                            "Erwiderung auf eine Äußerung, These"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "550c03c5-01fa-4902-9aa9-bbaf53c43413",
                                                "sense_id": "6c723381-d004-3d7c-85cf-68d4e1e63e3a",
                                                "text": "Auf diesen üblen Vorwurf entgegnete er mit einer ähnlich heftigen Replik."
                                            },
                                            {
                                                "example_id": "5719ff2c-84ab-4e1e-a5b6-9bb3444caf9c",
                                                "sense_id": "6c723381-d004-3d7c-85cf-68d4e1e63e3a",
                                                "text": "Zur Schlagfertigkeit gehört auch, eine gute Replik parat zu haben."
                                            },
                                            {
                                                "example_id": "87f659f1-e9ef-47d7-a950-e1f9d0925c4e",
                                                "sense_id": "6c723381-d004-3d7c-85cf-68d4e1e63e3a",
                                                "text": "„Die vier nächsten Repliken der Dame vorauszuwissen, gewährte immer noch ein blasses intellektuelles Vergnügen, doch wurde es nachgerade unterwandert von einer leisen Müdigkeit.“"
                                            },
                                            {
                                                "example_id": "490d984c-3de4-41fa-aa28-877f9b902f1f",
                                                "sense_id": "6c723381-d004-3d7c-85cf-68d4e1e63e3a",
                                                "text": "„Das alles ist ausgesprochene Situationskomik, während der neuzeitliche Ehebruchwitz kurz ist und auf den Wortwitz, auf die schlagfertige Replik aufbaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89c46841-a120-3602-a87f-6ae9f2d17621",
                                        "entry_id": "70e33b32-6a41-3191-a7f6-bd360fd9c5ae",
                                        "glosses": [
                                            "erneute Ausführung eines bereits vorhandenen Originals durch den Künstler selbst"
                                        ],
                                        "tags": [
                                            "Kunstwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392d0bcc-92ed-4eba-87e3-2aeb277b222c",
                                                "sense_id": "89c46841-a120-3602-a87f-6ae9f2d17621",
                                                "text": "Die Replik war vom Original kaum zu unterscheiden."
                                            },
                                            {
                                                "example_id": "5a54e989-faa2-4ed1-ab41-98647ea64e13",
                                                "sense_id": "89c46841-a120-3602-a87f-6ae9f2d17621",
                                                "text": "„Neben dem Altar ist eine Replik des Bischofsstabs ausgestellt.“"
                                            },
                                            {
                                                "example_id": "62155cec-8824-4490-b3cd-4745bf33cb74",
                                                "sense_id": "89c46841-a120-3602-a87f-6ae9f2d17621",
                                                "text": "„Wenn Hoffmann eine Replik des Peter Schlemihl schreibt, so gibt er ihr auch eine neue Tiefe, eine tragische Gewalt, die man in Chamissos Werk nicht findet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5c52d4e6-6634-3b33-9385-15e7d3262791",
                                        "entry_id": "70e33b32-6a41-3191-a7f6-bd360fd9c5ae",
                                        "glosses": [
                                            "im 16. Jahrhundert von französisch réplique ^(→ fr) entlehnt, das letztlich auf lateinisch replicare ^(→ la) „überdenken, einwenden“ zurückgeht."
                                        ],
