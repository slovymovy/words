                            {
                                "example_id": "f37a4511-f85c-4901-90b9-043c80989ebb",
                                "sense_id": "a47b2f35-993b-34ee-bf07-ad669acc0ae2",
                                "text": "Le peuple hän vit le long du fleuve Yukon et de ses affluents au nord-ouest de Dawson."
                            }
                        ]
                    },
                    {
                        "sense_id": "4db212bd-141e-3b44-bb2f-b56c69e97e70",
                        "entry_id": "ac8acdc7-953e-3a01-a7f8-85bd52483cab",
                        "glosses": [
                            "Relatif au hän, langue athapaskienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0150f1-11fd-4975-9ad0-eb376b4f2efd",
                                "sense_id": "4db212bd-141e-3b44-bb2f-b56c69e97e70",
                                "text": "En langue hän, le nom du peuple signifie « rivière », et l’expression Hän Huchʼinn signifie littéralement « le peuple qui vit le long de la rivière »."
                            }
                        ]
                    }
