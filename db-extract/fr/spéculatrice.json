            {
                "entry_id": "1aae4c1a-1f83-3576-961e-4cda325ef7e6",
                "word": "spéculatrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "27aa799f-e346-4cc2-a698-4f30ebb59d4f",
                        "entry_id": "1aae4c1a-1f83-3576-961e-4cda325ef7e6",
                        "tags": [
