                ],
                "senses": [
                    {
                        "sense_id": "b2b87ff6-8eb0-3399-82ed-9561fe3da93a",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Clipping of difference"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "1765f9ba-834b-44a4-ab5f-d079a6fd9d6c",
                                "sense_id": "b2b87ff6-8eb0-3399-82ed-9561fe3da93a",
                                "text": "A peach and an apricot? What's the diff?"
                            },
                            {
                                "example_id": "3e035843-6324-4517-8ed5-4266a011219a",
                                "sense_id": "b2b87ff6-8eb0-3399-82ed-9561fe3da93a",
                                "text": "MrX provided close to 100 diffs presented in a lengthy brief divided into sections."
                            }
                        ]
                    },
                    {
                        "sense_id": "61a6340c-6de1-3129-b4fe-1605bc3341ad",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Clipping of differential"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping"
                        ],
                        "examples": [
                            {
                                "example_id": "ffa18dba-9252-48dd-96a5-cfae7b1d4124",
                                "sense_id": "61a6340c-6de1-3129-b4fe-1605bc3341ad",
                                "text": "This function takes that diff and plugs it into the larger structure."
                            },
                            {
                                "example_id": "1166f344-fe33-4901-b0ef-ba54b5b52434",
                                "sense_id": "61a6340c-6de1-3129-b4fe-1605bc3341ad",
                                "text": "[Pogo:] A woman outthunk is a woman scorned and you know what's got no fury like that! [...] Mus' I tell you? It's Sunday.\n [Albert:] What's the diff? Tell away.\n [Pogo, whispering:] Hell."
                            }
                        ]
                    },
                    {
                        "sense_id": "b17ada1e-afed-366f-8bb6-16eac54dfb24",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Used to trash-talk an opposing team at the end of a game by pointing out a skill difference between some role and the same role on the other team."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "55f7a688-93e1-4f44-886e-e5d3a06bb17c",
                                "sense_id": "b17ada1e-afed-366f-8bb6-16eac54dfb24",
                                "text": "tank diff (i.e., the deciding factor in the game was the difference in skill between the teams' tank players)"
                            }
                        ]
                    },
                    {
                        "sense_id": "1f6f4f29-531c-31b6-8f30-6d9062a654ac",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Any program which compares two files or sets of files and outputs a description of the differences between them."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "385a0a36-cc36-37f3-9114-88ddd871e87d",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "The output of a diff program, a diff file."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57df6285-0833-4b8d-826f-4a39bf40acbd",
                                "sense_id": "385a0a36-cc36-37f3-9114-88ddd871e87d",
                                "text": "edit diff"
                            },
                            {
                                "example_id": "43fdced5-8162-4c2e-925c-c0d7d5a49c2b",
                                "sense_id": "385a0a36-cc36-37f3-9114-88ddd871e87d",
                                "text": "I didn't want to waste people's time telling them things they already knew. It's more efficient just to give them the diffs."
                            }
                        ]
                    },
                    {
                        "sense_id": "0886b375-706d-35a6-b9fd-05f49395c4a9",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Abbreviation of differential: the differential gear in an automobile."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "27a53e07-7bff-49ca-844a-337cf2b732d7",
                                "sense_id": "0886b375-706d-35a6-b9fd-05f49395c4a9",
                                "text": "This diff is capable of locking up when wheel slip occurs."
                            },
                            {
                                "example_id": "049d5059-4f7b-4b50-b53f-b4d9dc038c04",
                                "sense_id": "0886b375-706d-35a6-b9fd-05f49395c4a9",
                                "text": "Many operators cursed the early diff and driveline set-ups[.]"
                            }
                        ]
                    },
                    {
                        "sense_id": "837bc66a-e556-39dc-8624-82fbf55150c6",
                        "entry_id": "e25a2f6c-8d90-37ac-963c-9f75169aa48a",
                        "glosses": [
                            "Abbreviation of differential: differential of types of white blood cell in a complete blood count."
                        ],
                        "tags": [
