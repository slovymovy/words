                    }
                ],
                "translations": [
                    {
                        "translation_id": "69d6a376-d3c9-4997-98e8-67e71a060509",
                        "source_entry_id": "c65ac270-510c-3b94-8a16-cec8aa856f2e",
                        "target_lang_word": "immure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                        "entry_id": "e3a7a077-ca61-3188-b702-b51da21565e9",
                                        "glosses": [
                                            "To cloister, confine, imprison or hole up: to lock someone up or seclude oneself behind walls."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "052411e2-fa9f-4579-b1ad-9caa02075a8c",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "The gentlemen looked at each other for a ſolution of this ſtrange event, each preſuming an order had been obtained to again immure the unfortunate Clara."
                                            },
                                            {
                                                "example_id": "e54ff092-8fa3-4142-8c9b-2825a8425b35",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "[I]n the reign of Henry the Second, a body happening, by chance, to be dug up near Glastonbury Abbey, without any symptoms of putrefaction or decay, the Welch, the descendants of the Ancient Britons, tenacious of the dignity and reputation of that illustrious hero [King Arthur], vainly supposed it could be no other than the body of their justly-boasted Pen-Dragon; and that he had been immured in that sepulchre by the spells of some powerful and implacable inchanter."
                                            },
                                            {
                                                "example_id": "e40f0e05-0d94-4e6e-baa9-054f3891077a",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "In a happy moment for the Levy-Lawson-Levis, Lady Lytton was betrayed, seized, and immured. The Editor saw his chance, and made the Metropolis ring with the outrage. Levi was saved; so also was Lady Lytton."
                                            },
                                            {
                                                "example_id": "0667f621-b64f-484f-adc4-528df06f1c62",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "Immured in Heaven! What a Cell! / Let every bondage be, / Thou Sweetest of the Universe, / Like that which ravished thee!"
                                            },
                                            {
                                                "example_id": "9dceda0a-1dd7-4129-8944-838b3347ed96",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "This rule is followed in all common-law jurisdictions, although it was not adopted by the House of Lords until 1932, and then only with vigorous dissent, in a case where a mouse was immured in a ginger-beer bottle."
                                            },
                                            {
                                                "example_id": "eb0ef767-a52e-415a-b848-8ca03d4a7f70",
                                                "sense_id": "7307b902-8c5f-3de0-a78e-0fab41aa15f5",
                                                "text": "Mattes creates a perversely sympathetic character: one who is so immured and immersed in his own self-pity/-hatred that his only connection to life is to dominate and control those with whom he connects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b032b4-bca8-331b-9488-72c23631c467",
                                        "entry_id": "e3a7a077-ca61-3188-b702-b51da21565e9",
                                        "glosses": [
                                            "To put or bury within a wall."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0f12624-7db1-485c-b0ee-6f0d4623c20c",
                                                "sense_id": "14b032b4-bca8-331b-9488-72c23631c467",
                                                "text": "John's body was immured Thursday in the mausoleum."
                                            },
                                            {
                                                "example_id": "7459160b-075f-409f-b44b-a934977842e8",
                                                "sense_id": "14b032b4-bca8-331b-9488-72c23631c467",
                                                "text": "The dreadful punishment of immuring persons, or burying them alive in the walls of convents, was undoubtedly sometimes resorted to by monastic communities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d34e61-4336-3e7e-b317-3b4c639bd812",
                                        "entry_id": "e3a7a077-ca61-3188-b702-b51da21565e9",
                                        "glosses": [
                                            "To wall in."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79c32141-37e5-3c61-aa11-b9b050a84c44",
                                        "entry_id": "e3a7a077-ca61-3188-b702-b51da21565e9",
                                        "glosses": [
                                            "To trap or capture (an impurity); chiefly in the participial adjective immured and gerund or gerundial noun immuring."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "410417ca-6fc1-46d6-a114-68403bcf73dc",
                                                "sense_id": "79c32141-37e5-3c61-aa11-b9b050a84c44",
                                                "text": "1975, American Institute of Physics, American Crystallographic Association, Soviet Physics, Crystallography, Volume 19, Issues 1-3, page 296,\nOn increasing the supercooling, the step starts completely immuring the impurity and v rises sharply."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immure",
                                "target_lang_code": "en",
