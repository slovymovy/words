                        "examples": [
                            {
                                "example_id": "19bbcb8e-86b1-43b2-9d3c-6f47be389408",
                                "sense_id": "2f22d982-7b4f-3634-8886-c9e83322883d",
                                "text": "Un merveilleux machin-chouette, apparemment tombé du ciel, se matérialise devant tes yeux. Aussitôt, tu as le nez collé sur la vitre et des picotements sur tout le corps… Et tu te dis que ta vie serait bien meilleure si seulement tu pouvais posséder cet objet… ,"
                            },
                            {
                                "example_id": "32973893-b642-4da6-8698-809801a2e41e",
                                "sense_id": "2f22d982-7b4f-3634-8886-c9e83322883d",
                                "text": "Près de l’entrée, Paulin, le commandant du Dépôt, les dirigeait sur les cuisines: - Vous, les machins-chouettes , leur disait-il, allez bouffer ! ,"
                            }
                        ]
                    }
