                ],
                "senses": [
                    {
                        "sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
                        "entry_id": "47bc2959-1ce2-36b0-a34e-61b264f455a1",
                        "glosses": [
                            "Salz der salpetrigen Säure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59315850-a4cb-49e1-9608-46fa373a8343",
                                "sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
                                "text": "„Nitrit (NO₂⁻) kommt als Salz der Salpetrigen Säure (HNO₂) vor.“"
                            },
                            {
                                "example_id": "8946e2ab-51b6-4b2e-ad4e-1943e85e259d",
                                "sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
                                "text": "„Nitrit ist wie Ammoniak für Fische giftig und bereits ab Werten von 1 Milligramm pro Liter tödlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "89d62838-315f-37d6-a4ee-63be4008dbbd",
                        "entry_id": "47bc2959-1ce2-36b0-a34e-61b264f455a1",
                        "glosses": [
                            "Ester der salpetrigen Säure"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e8fbc36-a0e5-4034-8584-33c2d0a32b81",
                                "sense_id": "89d62838-315f-37d6-a4ee-63be4008dbbd",
                                "text": "„ Unter NO-Pharmaka werden Substanzen zusammengefaßt, die sich von der salpetrigen Säure oder deren Ester (Nitrite: R-O-N=O) bzw. von Estern der Salpetersäure (Nitrate: R-O-NO) ableiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e89e2d5-a479-4943-8af4-c5c072203b77",
                        "source_entry_id": "47bc2959-1ce2-36b0-a34e-61b264f455a1",
                        "source_sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
                        "source_sense_description": "Chemie: Salz der salpetrigen Säure",
                        "target_lang_word": "nitrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc42592d-c0e6-3fd8-997e-e557d7d1cb32",
                                        "entry_id": "5d5a4ae9-e095-3002-8fa1-7ce23b13bb2b",
                                        "glosses": [
                                            "Any salt or ester of nitrous acid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "489c2d67-d9b4-4bdc-a331-dcda2f31a905",
                                                "sense_id": "fc42592d-c0e6-3fd8-997e-e557d7d1cb32",
                                                "text": "John Birdsall, a scientist for the American Meat Institute, said that there were no industry qualms about trying to lower the nitrite amounts even farther. For centuries, some form of nitrites have been used to cure and to preserve bacon and to give it a pink color."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d41d3d-f2d8-3c2b-941a-9da379f4e2cc",
                                        "entry_id": "5d5a4ae9-e095-3002-8fa1-7ce23b13bb2b",
                                        "glosses": [
                                            "The univalent radical -NO₂, and the anion NO₂⁻"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b550ed64-14b1-4407-97c6-1c9c4f3be3d0",
                        "source_entry_id": "47bc2959-1ce2-36b0-a34e-61b264f455a1",
                        "source_sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
                        "source_sense_description": "Chemie: Salz der salpetrigen Säure",
                        "target_lang_word": "nitrite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nitrite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                        "entry_id": "d40ade8f-53ab-3c92-9da7-dee40e1d5b2f",
                                        "glosses": [
                                            "Sel produit par la combinaison de l’acide nitreux (HNO₂) avec une base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4394c6f0-5e71-409c-a5c8-38990c256801",
                                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                                "text": "L’équipe montre pour la première fois, in vivo chez le rat, qu'une charcuterie modèle riche en hème (…), salée, additionnée de nitrites, cuite et oxydée était promotrice du développement du cancer colorectal."
                                            },
                                            {
                                                "example_id": "61586745-6093-4e77-9df8-c04b99414a03",
                                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                                "text": "Les nitrites (E249 et E250). Conservateurs et fixateurs de couleur, ils se retrouvent dans presque toutes les salaisons et les conserves de charcuteries pour empêcher la prolifération de l'agent du botulisme."
                                            },
                                            {
                                                "example_id": "840ee35c-315e-4fab-84e0-d26be6e34243",
                                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                                "text": "Ce nouvel intermédiaire est l’oxyde nitrique (NO) qui, dans des conditions de sol normales, est un précurseur chimique du nitrite qui sera transformé en nitrate."
                                            },
                                            {
                                                "example_id": "17315fb2-5c18-4343-b7f9-343b417264d4",
                                                "sense_id": "0e44824c-75d5-3f31-a6f6-43148b782b55",
                                                "text": "Ils alimentent leur métabolisme en énergie en oxydant l’ammoniac (NH3) en nitrite (NO₂⁻), la source principale d’azote en mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63e99b78-dfe0-4496-b51a-f6692cb764aa",
                        "source_entry_id": "47bc2959-1ce2-36b0-a34e-61b264f455a1",
                        "source_sense_id": "ecedebdb-e66b-34cd-8dac-1ed742a3a045",
