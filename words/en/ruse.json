                                "target_lang_sense_clarification": "английская фамилия Ruse"
                            },
                            {
                                "target_lang_word": "Русе",
                                "target_lang_sense_clarification": "фамилия Ruse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "751c3ffb-1dcd-3488-9f06-8c278847ad0f",
                    "sense_definition": "A suburb in the City of Campbelltown, near Sydney, New South Wales, Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They recently purchased a family home in the quiet residential suburb of <w>Ruse</w>.",
                            "target_lang_translations": {
                                "ru": "Недавно они приобрели семейный дом в тихом жилом пригороде <w>Рьюз</w>."
                            }
                        },
                        {
                            "text": "Local schools and parks make <w>Ruse</w> a popular choice for young families moving to the area.",
                            "target_lang_translations": {
                                "ru": "Местные школы и парки делают <w>Рьюз</w> популярным выбором для молодых семей, переезжающих в этот район."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пригород в районе Кэмпбеллтаун, недалеко от Сиднея, Новый Южный Уэльс, Австралия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рьюз",
                                "target_lang_sense_clarification": "пригород в Австралии"
                            }
                        ]
