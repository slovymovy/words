                ],
                "senses": [
                    {
                        "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                        "entry_id": "5957219e-1e11-3c49-aa39-565726be5c7c",
                        "glosses": [
                            "jemand, der übertrieben genau, pingelig, kleinlich, geizig ist"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e40c8c7d-6716-495e-84f0-d241c9853c6e",
                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                "text": "„Seit seiner Gründung 1832 ist der Baedeker bekannt für Zuverlässigkeit und Genauigkeit. Autor und Verleger Karl Baedeker war ein Erbsenzähler in wörtlichem Sinne: Um die Stufen des Mailänder Doms zu zählen, steckte er alle 20 Schritte eine Erbse von der Westen- in die Hosentasche.“"
                            },
                            {
                                "example_id": "5e9015fa-23c7-4b0b-ab54-afb7a1ce9d6b",
                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                "text": "„In Deutschland dagegen werden ganze Zeitungen mit detailbesessenen Artikeln und Anzeigen gefüllt, minutiös bis ins Letzte und so politikbesessen langweilig, dass hier aus amerikanischer Sicht nur ein Erbsenzähler wie Al Gore mithalten könnte.“"
                            },
                            {
                                "example_id": "9484849f-1b20-4983-a7fa-a0e6ecaaf357",
                                "sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                                "text": "„Erbsenzähler sind übergenau, Mauerblümchen zu schüchtern und auf Hallodris ist kein Verlass. Überflieger lernen schnell, Nieten können gar nichts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa362508-2358-488b-976d-25a8b60ced2c",
                        "source_entry_id": "5957219e-1e11-3c49-aa39-565726be5c7c",
                        "source_sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der übertrieben genau, pingelig, kleinlich, geizig ist",
                        "target_lang_word": "bean counter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bean counter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e06628ba-b710-3145-9aa5-a3a446ae6982",
                                        "entry_id": "487ee2b9-cf5b-3b07-8410-524a47b80de5",
                                        "glosses": [
                                            "A person who is excessively interested in controlling or reducing expenses, increasing profits, or in quantitative details in general."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "idiomatic",
                                            "mildly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1076746e-2933-45ad-b090-a98dfe189e82",
                                                "sense_id": "e06628ba-b710-3145-9aa5-a3a446ae6982",
                                                "text": "As any good bean counter will tell you, it costs money to treat people at a hospital."
                                            },
                                            {
                                                "example_id": "1f653e09-ac99-496a-a22f-8b534c30ceb3",
                                                "sense_id": "e06628ba-b710-3145-9aa5-a3a446ae6982",
                                                "text": "And, in our case, the accounting firm of Halpern & Mantovani, CPA, in Encino, Calif., Chais' chief bean counter, pumped out the quarterly statements as if it were all rock solid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77dfa33d-ce6c-4fbe-9d68-42860c815a2d",
                        "source_entry_id": "5957219e-1e11-3c49-aa39-565726be5c7c",
                        "source_sense_id": "e5b99fd4-4d1f-3832-a0b2-a3ece5dae7dd",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der übertrieben genau, pingelig, kleinlich, geizig ist",
                        "target_lang_word": "pinailleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2432bf5d-fdec-3dd2-b30e-19062ad455ef",
                                        "entry_id": "a43e5df3-9b9d-3724-b4d8-622b67577929",
                                        "glosses": [
                                            "Personne qui pinaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ccbbd50-70bb-40dc-9019-4f8bbffcf8bf",
                                                "sense_id": "2432bf5d-fdec-3dd2-b30e-19062ad455ef",
                                                "text": "Faites passer le message par votre avocat que la partie adverse est un pinailleur de première et que comme il a déjà fait des histoires sur des horaires… des affaires… des paiements… les coups de fil… vous avez besoin que tout soit écrit noir sur blanc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinailleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                                        "entry_id": "13da58bc-130f-3181-a13e-420124116767",
                                        "glosses": [
                                            "Qui pinaille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c407b995-a757-4a7a-8c86-51c723ae1d87",
                                                "sense_id": "c90ff5b3-a5a3-3305-b850-0604ce4731d1",
                                                "text": "D'apparence purement technique, et souvent caricaturé comme pinailleur et ennuyeux, ce développement a en réalité nécessité des années d'âpres négociations politiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
