                    {
                        "sense_id": "af4feedd-491e-3803-a606-e0f7df041ee6",
                        "entry_id": "64794dec-058d-3786-9853-135b534f3841",
                        "glosses": [
                            "Relatif à l’Ibérie, à la péninsule Ibérique, à l’Espagne ou au Portugal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45c3af20-a5da-4425-94be-561cb1f5474a",
                                "sense_id": "af4feedd-491e-3803-a606-e0f7df041ee6",
                                "text": "Tous les ingrédients sont en effet réunis dans le pays ibérique pour qu’une simple étincelle se transforme en un violent incendie : des vents forts, avec des rafales de 70 kilomètres-heure, des températures encore élevées pour la fin de l’été, dépassant les 30 degrés, et un taux d’humidité très bas, de moins de 20 %, voire 10 % par endroits."
                            },
                            {
                                "example_id": "3560df0b-acc0-4f2b-84fa-2a0fdc25ddf3",
                                "sense_id": "af4feedd-491e-3803-a606-e0f7df041ee6",
                                "text": "Les peuples ibériques."
                            },
                            {
                                "example_id": "fb10fc31-0f9e-437f-bfc4-8fcf0c20b797",
                                "sense_id": "af4feedd-491e-3803-a606-e0f7df041ee6",
                                "text": "La péninsule ibérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "bae3cd2f-6185-31a6-80f0-dec3eb1184e5",
                        "entry_id": "64794dec-058d-3786-9853-135b534f3841",
                        "glosses": [
                            "Espagnol, relatif à l’Espagne."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
