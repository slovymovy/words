                        "glosses": [
                            "onderzoek naar de eigen woonomgeving; lokale geschiedenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d35155-e617-4de7-b906-22daab777683",
                                "sense_id": "65e179ea-1211-3976-83d0-1a59d88a0f47",
                                "text": "Marian Oude Elberink was oud-stadsdichter, ruim 30 jaar vrijwilliger voor de rk-kerk in Ootmarsum en jarenlang secretaris van de Stichting Heemkunde Ootmarsum. Nog steeds is ze voorzitter van het Sint Elisabethfonds en is ze actief voor het Katholiek Vrouwen Dispuut."
                            },
                            {
                                "example_id": "07d0e55f-5a9e-4897-ae54-84312196ab98",
                                "sense_id": "65e179ea-1211-3976-83d0-1a59d88a0f47",
                                "text": "Andere projecten die een bijdrage ontvangen; Tennisvereniging Tie-Break uit Hengelo 1.815 euro voor het vervangen van speeltuintoestellen, Turncentrum Twente uit Hengelo krijgt 7.500 euro voor de aanschaf van nieuw meubilair voor de sportkantines, Vereniging Heemkunde Ambt Delden 750 euro voor een investering in ICT-middelen en Muziekvereniging Amicitia uit Delden ontvangt 5000 euro voor de aanschaf van drie nieuwe pauken."
                            },
                            {
                                "example_id": "6b496657-1bb9-42a8-a8dc-1b3da74b2fef",
                                "sense_id": "65e179ea-1211-3976-83d0-1a59d88a0f47",
                                "text": "Een heropening van het kanaal Almelo-Nordhorn leidt tot een vernietiging van waardevolle leefgebieden. Dat is de gezamenlijke overtuiging van de werkgroep Natuur van de Stichting Heemkunde Denekamp en de Naturschutzbund van het graafschap Bentheim."
                            }
                        ]
                    }
