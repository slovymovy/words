                        "sense_id": "218a9d65-afa8-3dd9-b730-2a2f6671ac6d",
                        "entry_id": "751ff7bc-f59f-3f5f-9829-27b5cc358684",
                        "glosses": [
                            "geluid van slag of knal direct gevolgd door een doffe bons of ontploffing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d18ed2d-94cf-46fc-8801-7ae0dd8d69bb",
                                "sense_id": "218a9d65-afa8-3dd9-b730-2a2f6671ac6d",
                                "text": "Pats-boem. Ace nummer zoveel op de paarse baan in de wielerhal. Verkerk verliest deze donderdagavond in Apeldoorn geen servicegame."
                            },
                            {
                                "example_id": "820a9e54-b6f2-4138-a08f-b9616f384027",
                                "sense_id": "218a9d65-afa8-3dd9-b730-2a2f6671ac6d",
                                "text": "Prachtig vond Dompeling junior het om te zien hoe z'n pa de kolf van de machtige Beretta tegen zijn schouder legde, de loop op een overvliegende kleiduif richtte, de trekker overhaalde en pats-boem de ronde schijf aan diggelen schoot."
                            }
                        ]
                    },
                    {
                        "sense_id": "7203bb30-fc43-318e-8377-10d8df05f3e0",
                        "entry_id": "751ff7bc-f59f-3f5f-9829-27b5cc358684",
                        "glosses": [
                            "om een onverwachte plotselinge verandering of een onmiddellijk effect aan te geven"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c4f31389-a405-4634-8ce4-02864c492852",
                                "sense_id": "7203bb30-fc43-318e-8377-10d8df05f3e0",
                                "text": "Die concerns zullen hun fabriek hier niet pats-boem sluiten. Kost geld, geeft gedoe. Ze verleggen gewoon hun investeringen naar landen die wél een concurrentievoordeel hebben."
                            },
                            {
                                "example_id": "7c08ab95-4cc6-47bc-88ad-459af41ac5b7",
                                "sense_id": "7203bb30-fc43-318e-8377-10d8df05f3e0",
                                "text": "Heel snel allemaal. Toen ik voor mijzelf uitgekomen was, heb ik het ook direct aan iedereen verteld. Wat dat betreft ben ik anders dan anderen. Voor veel homo's is de coming-out een proces, voor mij was het pats-boem."
                            }
                        ]
                    }
