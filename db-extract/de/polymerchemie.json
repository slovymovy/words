                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                        "entry_id": "5d975d38-eb89-396c-a678-a78319cc1005",
                        "glosses": [
                            "wissenschaftliche Beschäftigung mit Polymeren und ihren Eigenschaften, ihrer Herstellung und Modifizierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "484b1fab-427f-46b8-99c1-6bf999bc26ae",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Die Schwingungsspektroskopie als Methode in der Analytik wurde Ende der 1940er-Jahre hauptsächlich von Forschern der Polymerchemie etabliert.“"
                            },
                            {
                                "example_id": "a178fa7f-8e6b-4857-abd1-827e9d508c88",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Kohlenwasserstoffe sind die Bausteine der organischen Chemie und wesentlich für die Polymerchemie.“"
                            },
                            {
                                "example_id": "bf83de7d-82df-4136-816b-225ed5f3c46b",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Sie sind aus Quarz, der Rest ist aus Plastik oder Bakelit, den Früchten der Polymerchemie.“"
                            },
                            {
                                "example_id": "b674eb3f-fbe9-4a7b-8ed4-39ef93256e0c",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Als Gyrationsradius wird in der Polymerchemie der mittlere Abstand der Polymersegmente von dem Massenschwerpunkt bezeichnet.“"
                            },
                            {
                                "example_id": "ae6d84de-48e5-42be-a1af-b26e1a55561b",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Die radikalische Thiol-En-Reaktion wurde bereits früh in der Polymerchemie verwendet.“"
                            },
                            {
                                "example_id": "94650c2b-9024-45e9-a05e-40564dd847d4",
                                "sense_id": "0f11351f-b3fa-3b89-a4fb-becfaf8eafa6",
                                "text": "„Anfang 1948 folgte er einer Einladung der Cornell University als Lecturer, Vorlesungen über Polymerchemie zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
