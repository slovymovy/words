                    },
                    {
                        "sense_id": "a11171b6-3525-3c4f-8d56-58ac1c28391b",
                        "entry_id": "3133accc-fb99-3a32-963d-d7c19b55479c",
                        "glosses": [
                            "to be old enough"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b0339901-1110-43fa-93e2-064cbcaea827",
                                "sense_id": "a11171b6-3525-3c4f-8d56-58ac1c28391b",
                                "text": "не дорасти́",
                                "translation": "not to be old enough; be too young",
                                "english": "not to be old enough; be too young"
                            },
                            {
                                "example_id": "609799dc-d9b8-4372-bc14-654cdbd3f991",
                                "sense_id": "a11171b6-3525-3c4f-8d56-58ac1c28391b",
                                "text": "он ещё не доро́с (до того́, что́бы) пить вино́",
                                "translation": "he is too young to drink wine",
                                "english": "he is too young to drink wine"
                            }
                        ]
                    },
                    {
                        "sense_id": "71bf1874-c845-38ca-8148-2800b15143bd",
                        "entry_id": "3133accc-fb99-3a32-963d-d7c19b55479c",
                        "glosses": [
                            "to rise (to), to attain the level (of)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f454cc0-951a-49d9-bac4-10e25d196cfc",
                                "sense_id": "71bf1874-c845-38ca-8148-2800b15143bd",
                                "text": "дорасти́ до сла́вы",
                                "translation": "to rise to fame",
                                "english": "to rise to fame"
                            },
                            {
                                "example_id": "99b87a99-a312-49cf-9093-530cb0ba8ac8",
                                "sense_id": "71bf1874-c845-38ca-8148-2800b15143bd",
                                "text": "он не доро́с до понима́ния э́того писа́теля",
                                "translation": "he has a long way to go before he begins to understand this writer",
                                "english": "he has a long way to go before he begins to understand this writer"
                            },
                            {
                                "example_id": "0e879f49-e8b1-47fd-a75b-b519018ab75c",
                                "sense_id": "71bf1874-c845-38ca-8148-2800b15143bd",
                                "text": "нос не доро́с у кого́-либо",
                                "translation": "someone is still wet behind his ears",
                                "english": "someone is still wet behind his ears"
                            }
                        ]
                    }
