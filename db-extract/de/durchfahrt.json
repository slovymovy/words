                "senses": [
                    {
                        "sense_id": "771f5119-7d53-3372-ae51-7977f95c9087",
                        "entry_id": "f82fd54f-0f16-3125-a11d-f10b14ba781a",
                        "glosses": [
                            "Bauwerk oder natürliche Topographie, das/die eine Passage für Fahrzeuge zulässt, wie zum Beispiel ein Tor, eine Brücke oder eine enge Schlucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a125c6-b875-4a3e-a2a8-46b6b13d75f4",
                                "sense_id": "771f5119-7d53-3372-ae51-7977f95c9087",
                                "text": "Das Stadttor besitzt eine große Durchfahrt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "24581836-7c28-3fd3-a98d-8907c3b48a90",
                        "entry_id": "f82fd54f-0f16-3125-a11d-f10b14ba781a",
                        "glosses": [
                            "das Durchfahren einer Durchfahrt nach [1]"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "7b973aa4-901e-4312-a566-78fe7de2ced8",
                                "sense_id": "24581836-7c28-3fd3-a98d-8907c3b48a90",
                                "text": "An der Grenze nach Österreich haben Personenkraftwagen häufig freie Durchfahrt."
                            },
                            {
                                "example_id": "ae7bee1d-afd4-429c-a13f-bc6f65fd24cc",
                                "sense_id": "24581836-7c28-3fd3-a98d-8907c3b48a90",
                                "text": "„Im ganzen wurde dieses noch mit zu Einundsechzig gezählt, da das Wasser zwischen beiden zu seicht war, um größeren Flatbooten eine Durchfahrt zu gestatten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a9f71ab-13f6-41c9-9574-756ac0450e21",
                        "source_entry_id": "f82fd54f-0f16-3125-a11d-f10b14ba781a",
                        "source_sense_id": "771f5119-7d53-3372-ae51-7977f95c9087",
                        "source_sense_description": "Bauwerk oder natürliche Topographie, das/die eine Passage für Fahrzeuge zulässt",
                        "target_lang_word": "passage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb1dc15a-5b45-38fb-bc99-616b59741c4f",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "A paragraph or section of text or music with particular meaning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4222ef-ba79-4603-91b7-f11536b27733",
                                                "sense_id": "bb1dc15a-5b45-38fb-bc99-616b59741c4f",
                                                "text": "passage of scripture"
                                            },
                                            {
                                                "example_id": "4eb99eef-029c-42f8-8065-7de22339b688",
                                                "sense_id": "bb1dc15a-5b45-38fb-bc99-616b59741c4f",
                                                "text": "She struggled to play the difficult passages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "692fb00b-38c0-3cfa-951e-fd58c6012573",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "Part of a path or journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd8a915b-f035-46a2-aaa7-091aa739c5e8",
                                                "sense_id": "692fb00b-38c0-3cfa-951e-fd58c6012573",
                                                "text": "He made his passage through the trees carefully, mindful of the stickers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69d752aa-f98d-31cb-b23d-603754ea0563",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "An incident or episode."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1a4e4c-3309-49e2-9c49-769b6e8fccab",
                                                "sense_id": "69d752aa-f98d-31cb-b23d-603754ea0563",
                                                "text": "But there are those who do not feel that the sordid passages of life should be kept off the stage. It is a matter of opinion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c91e73-fe54-3b0d-9943-ec61c4dd292e",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "The official approval of a bill or act by a parliament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5926d2f3-f552-4ef9-b35c-34982bc4f1ea",
                                                "sense_id": "d3c91e73-fe54-3b0d-9943-ec61c4dd292e",
                                                "text": "The company was one of the prime movers in lobbying for the passage of the act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86a547e8-657d-37a6-bb88-c297b8699ba0",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "The advance of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1da62908-736f-4b55-aa87-60cbcd3d83e3",
                                                "sense_id": "86a547e8-657d-37a6-bb88-c297b8699ba0",
                                                "text": "The passage of decades has not erased the value of parental monitoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e4b67ac-bcd4-3c49-aec4-1d283e0a9d2c",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "The use of tight brushwork to link objects in separate spatial plains. Commonly seen in Cubist works."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "109dcd60-919f-31ff-bf32-7c248ba507df",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "A passageway or corridor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26d73cc9-0a93-3ab7-aa9f-89f7e913e57c",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "A strait or other narrow waterway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6af3a22-6306-4e3e-a0c7-8e77dc540ea4",
                                                "sense_id": "26d73cc9-0a93-3ab7-aa9f-89f7e913e57c",
                                                "text": "the Northwest Passage"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93bd547a-1302-3619-ad83-311d9ac64e76",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "An underground cavity, formed by water or falling rocks, which is much longer than it is wide."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71ae1f3b-bd71-3004-8bf2-2af2e6293792",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "The vagina."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ef0351-c152-47b0-a56f-e625ecf40fc6",
                                                "sense_id": "71ae1f3b-bd71-3004-8bf2-2af2e6293792",
                                                "text": "With a look of triumph that he was unable to keep from his dark eyes he slid into her passage with one smooth thrust, […]"
                                            },
                                            {
                                                "example_id": "8440194e-b810-439b-9e6f-d6f89190b53b",
                                                "sense_id": "71ae1f3b-bd71-3004-8bf2-2af2e6293792",
                                                "text": "This way, the tip of your penis will travel up and down her passage."
                                            },
                                            {
                                                "example_id": "87595db6-764a-43f8-b90f-ae6a0053de34",
                                                "sense_id": "71ae1f3b-bd71-3004-8bf2-2af2e6293792",
                                                "text": "At the same moment, Aidan plunged two fingers deep into her passage and broke through her fragile barrier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b053284a-9572-3524-9856-1779ac7378ee",
                                        "entry_id": "76c726e0-8a20-375f-aafe-3409a729acbb",
                                        "glosses": [
                                            "The act of passing; movement across or through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5037ae7-a69e-471b-a6be-b887a155043e",
                                                "sense_id": "b053284a-9572-3524-9856-1779ac7378ee",
                                                "text": "He claimed that he felt the passage of the knife through the ilio-cæcal valve, from the very considerable pain which it caused."
                                            },
                                            {
                                                "example_id": "9780b6f6-ebce-45ac-8f54-67d3e73ac8e1",
                                                "sense_id": "b053284a-9572-3524-9856-1779ac7378ee",
                                                "text": "When the scheme is completed, the 99-year-old swing bridge over the canal will be dispensed with as the new bridge will have sufficient height to allow clearance for the passage of canal traffic."
                                            }
                                        ]
                                    },
                                    {
