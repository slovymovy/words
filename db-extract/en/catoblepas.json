                ],
                "senses": [
                    {
                        "sense_id": "d0f8ded2-48de-3b0e-86cf-8fa369c2de90",
                        "entry_id": "f23d12a4-b2b4-32f8-8f70-9e01d6341ead",
                        "glosses": [
                            "A legendary creature from Ethiopia, said to have the body of a Cape buffalo, scales on its back, and the head of a wild boar, which always points downward because of its weight."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbe9efd-b6ed-40d0-9748-9f6915963a31",
                                "sense_id": "d0f8ded2-48de-3b0e-86cf-8fa369c2de90",
                                "text": "Behind them, blindfolded and muzzled, came catoblepones."
                            },
                            {
                                "example_id": "ebfddf17-9e96-478f-9d93-bd2451c943d3",
                                "sense_id": "d0f8ded2-48de-3b0e-86cf-8fa369c2de90",
                                "text": "The most obvious curseinflicting monsters that came to mind were Basilisks, Cockatrices, and Catoblepones."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6533d759-d725-4c5f-a642-185eb130eb88",
                        "source_entry_id": "f23d12a4-b2b4-32f8-8f70-9e01d6341ead",
                        "source_sense_id": "d0f8ded2-48de-3b0e-86cf-8fa369c2de90",
                        "source_sense_description": "mythological creature",
                        "target_lang_word": "catoblephas",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cc14b222-9994-4031-9431-939dae30ffff",
                        "source_entry_id": "f23d12a4-b2b4-32f8-8f70-9e01d6341ead",
                        "source_sense_id": "d0f8ded2-48de-3b0e-86cf-8fa369c2de90",
                        "source_sense_description": "mythological creature",
                        "target_lang_word": "catoblépas",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catoblépas",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ada046b-da71-371f-a3cd-4ff5321cf58c",
                                        "entry_id": "baab08be-c49d-3858-8f33-542734d66f95",
                                        "glosses": [
                                            "Animal fabuleux supposé avoir la tête si lourde que celle-ci est toujours inclinée vers le bas. Dans l’Antiquité, son regard passait pour être mortel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02135133-fb0c-4049-92df-5c0fed8b63f0",
                                                "sense_id": "5ada046b-da71-371f-a3cd-4ff5321cf58c",
                                                "text": "Il me montra aussi les portraits des principaux animaux métaphysiques : le catoblépas, qui se mange les pieds ; le catoboryx qui s’exprime par borborygmes : à cette espèce appartenaient Charles du Bos, Gabriel Marcel et la plupart des collaborateurs de la N.R.F."
                                            },
                                            {
                                                "example_id": "d68819c3-b7ca-41aa-a5a8-0dda243b3430",
                                                "sense_id": "5ada046b-da71-371f-a3cd-4ff5321cf58c",
                                                "text": "Car le budget que vous présentez […] on pourrait aussi bien le comparer à cet animal fabuleux, le catoblépas, qui se dévore lui-même ; il n’a même pas la force de lever la tête, celle-ci traîne à terre, et il dévore ses propres jambes."
                                            },
                                            {
                                                "example_id": "3fdc179e-83bd-43c0-9f1a-6a5c1c9a5230",
                                                "sense_id": "5ada046b-da71-371f-a3cd-4ff5321cf58c",
                                                "text": "La vie est comme le catoblépas, animal fabuleux qui se nourrit en se dévorant lui-même."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
