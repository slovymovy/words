                        "translation_id": "fd498ba9-1a88-482a-a0dd-83353ea78bda",
                        "source_entry_id": "d84d56f7-87a5-3897-9ecd-e042a5bd63c3",
                        "source_sense_id": "610ac1d9-8d96-3b9b-92d2-684b80d7b765",
