                "senses": [
                    {
                        "sense_id": "a62ae9d2-e24c-3161-aed1-b28627c99469",
                        "entry_id": "5c4383af-436c-3544-9cca-769c364e4d8e",
                        "glosses": [
                            "Légende urbaine ou récit effrayant diffusé sur Internet."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9abbd0af-5dad-47a1-9f62-93ae93ff44e8",
                                "sense_id": "a62ae9d2-e24c-3161-aed1-b28627c99469",
                                "text": "Majoritairement, les creepypastas naissent de rumeurs et s’alimentent de spéculations. Elles peuvent se targuer de leur aura mystérieuse, mais gardent des distances avec leurs implications sur la réalité."
                            },
                            {
                                "example_id": "25376146-95a3-49d4-9638-d8d8cdbd4035",
                                "sense_id": "a62ae9d2-e24c-3161-aed1-b28627c99469",
                                "text": "Ce sont des creepypastas, ces nouvelles légendes urbaines, dont on sourit, bien malin, tant qu’il fait jour. On n’en parle guère, sinon le soir, cérémonieusement, de préférence en pixels, pour ajouter son grain de sel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "270f3660-db14-4c68-81cf-78e847f4ecaa",
                        "source_entry_id": "5c4383af-436c-3544-9cca-769c364e4d8e",
                        "source_sense_id": "a62ae9d2-e24c-3161-aed1-b28627c99469",
                        "target_lang_word": "creepypasta",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creepypasta",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                        "entry_id": "bde05afa-cf9d-3fae-aa45-5c2c8b6f9283",
                                        "glosses": [
                                            "Frightening urban legends and short stories in the horror genre, circulated on the Internet."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ebcb7a-0272-47c6-a947-604361f122a4",
                                                "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                                "text": "The video is part of a growing phenomenon making its way around message boards and e-mail chains called “creepypasta” — bite-sized bits of scariness that have joined the unending list of things-to-do-when-you’re-bored-at-work. […] Most creepypasta manufacture their own authenticity."
                                            },
                                            {
                                                "example_id": "890d10b1-bbd3-46b5-90b9-5cdee843e487",
                                                "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                                "text": "The game was born from the familiar 'Slenderman' image, which you may or may not be familiar with from internet memes and creepypasta horror stories."
                                            },
                                            {
                                                "example_id": "11bfc6cb-34f4-4d2f-bea2-43a96017b948",
                                                "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                                "text": "\"[…] Listen to the nineteen personal creepypasta-style stories to piece together the mysterious events of that fateful night in 1898, when twelve orphans simply… disappeared!\""
                                            },
                                            {
                                                "example_id": "47e2083b-18e4-4bb9-a67c-7a83b72676c6",
                                                "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                                "text": "The eerie “Lavender Town” theme has infiltrated the nightmares of an entire generation of children and has even inspired one of the most well known “creepypastas” on the Internet."
                                            },
                                            {
                                                "example_id": "6b086fb4-4f74-4443-a3cb-c48f9807e04d",
                                                "sense_id": "af58c922-bb50-3588-b8f5-1e80d519758c",
                                                "text": "A friend pointed her to Creepypasta, a collection of user-generated horror fan sites in which written, Photoshopped, and videotaped accounts of encounters with monsters and supernatural evil are presented as “real” in the form of encyclopedia entries, testimonials, and other “documentary” evidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
