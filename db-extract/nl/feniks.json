        "nl-extract.jsonl": [
            {
                "entry_id": "f7975cb0-b6b6-3705-826b-cc37430f7d0c",
                "word": "feniks",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "95faefdb-d6fa-4983-bef5-d6503f9c0bf0",
                        "entry_id": "f7975cb0-b6b6-3705-826b-cc37430f7d0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "feniksen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "87ea8df8-84f5-35da-9e84-060d9f2ae0f5",
                        "entry_id": "f7975cb0-b6b6-3705-826b-cc37430f7d0c",
                        "glosses": [
                            "fabeldier, een vogel die zich om de vijf eeuwen verbrandde en dan verjongd uit zijn as verrees"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd7e5d6e-f121-4969-9e89-421bb4276ac2",
                                "sense_id": "87ea8df8-84f5-35da-9e84-060d9f2ae0f5",
                                "text": "Ze was onzeker, maar als het licht op het podium aanging, veranderde ze en werd ze zó krachtig. Ze was een soort feniks die steeds uit de as herrees."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "418618db-074f-4c51-92fc-fbc6d7e96f25",
                        "source_entry_id": "f7975cb0-b6b6-3705-826b-cc37430f7d0c",
                        "source_sense_id": "87ea8df8-84f5-35da-9e84-060d9f2ae0f5",
                        "target_lang_word": "Phönix",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phönix",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "759e986e-4c9d-3d1f-b36d-70d1686e0706",
                                        "entry_id": "79be58b4-430c-3a4e-aa42-b02731a23d93",
                                        "glosses": [
                                            "Vogel, der verbrennt und aus seiner Asche neu entsteht, aus der ägyptisch-hellenistischen Sagenwelt (er gilt als das Symbol der Wiedergeburt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd96514-78f4-4855-972e-cab9775e249d",
                                                "sense_id": "759e986e-4c9d-3d1f-b36d-70d1686e0706",
                                                "text": "Der Phönix wird aus seiner eigenen Asche wiedergeboren."
                                            },
                                            {
                                                "example_id": "4b034341-c8dc-49e9-854e-085d9e2304f5",
                                                "sense_id": "759e986e-4c9d-3d1f-b36d-70d1686e0706",
                                                "text": "„Phönix: Sein Name ist altgriechischen Ursprungs. Phoinix bedeutete flammendes Rot. Der Mythos des Phönix reichte jedoch weit über Griechenland und den östlichen Mittelmeerraum hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "809ee4dd-0234-33f4-af20-e8e2f9163085",
                                        "entry_id": "79be58b4-430c-3a4e-aa42-b02731a23d93",
                                        "glosses": [
                                            "Wappentier in Vogelgestalt"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99c15a98-d703-46cb-a11a-ed7f5977fccb",
                                                "sense_id": "809ee4dd-0234-33f4-af20-e8e2f9163085",
                                                "text": "Die Familie führte den Phönix im Wappen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1a671a5a-f32b-3d15-a2ea-c8ead43e46ea",
                                        "entry_id": "79be58b4-430c-3a4e-aa42-b02731a23d93",
                                        "glosses": [
                                            "Sternbild des Südhimmels"
                                        ],
                                        "tags": [
                                            "Astrologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d515104-093e-4943-bbd9-f5ebdde2b371",
                                                "sense_id": "1a671a5a-f32b-3d15-a2ea-c8ead43e46ea",
                                                "text": "Der Phönix gehört im Gegensatz zum Altar nicht zu den 48 antiken Sternbildern."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3e96b8e9-ed72-3e2e-ae6a-50cdd00cf03f",
                                        "entry_id": "79be58b4-430c-3a4e-aa42-b02731a23d93",
                                        "glosses": [
                                            "Rebsorte"
                                        ],
                                        "tags": [
                                            "Winzerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e94c38-c32b-47d5-9e21-b32d53c283bb",
                                                "sense_id": "3e96b8e9-ed72-3e2e-ae6a-50cdd00cf03f",
                                                "text": "Die weiße Sorte Phönix wird als Qualitätswein vermarktet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a196c352-39ef-3193-8114-b5f9350e482a",
                                        "entry_id": "79be58b4-430c-3a4e-aa42-b02731a23d93",
                                        "glosses": [
                                            "historische Währung Griechenlands"
                                        ],
                                        "tags": [
                                            "finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a26237-9dce-4d44-a36b-11980095ecc7",
                                                "sense_id": "a196c352-39ef-3193-8114-b5f9350e482a",
                                                "text": "Die neue Währung, die eingeführt wurde, war der Phönix, eine Münze aus Silber."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efde4859-2911-474a-8301-dcc078ea1995",
                        "source_entry_id": "f7975cb0-b6b6-3705-826b-cc37430f7d0c",
                        "source_sense_id": "87ea8df8-84f5-35da-9e84-060d9f2ae0f5",
                        "target_lang_word": "phoenix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phoenix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a9f622f-2ee0-3f70-9a37-7ddd6dba6617",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "A mythological bird, said to be the only one of its kind, which lives for 500 years and then dies by burning to ashes on a pyre of its own making, ignited by the sun. It then arises anew from the ashes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4139a65-8048-41fd-91ad-fed888646e0e",
                                                "sense_id": "9a9f622f-2ee0-3f70-9a37-7ddd6dba6617",
                                                "text": "burn the long-lived phoenix in her blood"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45f601a9-00cb-3cb1-96e4-8bb0519eb211",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "Anything that is reborn after apparently being destroyed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060f652c-60f4-4bec-87b7-3abde5b3146e",
                                                "sense_id": "45f601a9-00cb-3cb1-96e4-8bb0519eb211",
                                                "text": "Astronomers believe planets might form in this dead star's disk, like the mythical Phoenix rising up out of the ashes."
                                            },
                                            {
                                                "example_id": "be690ad0-0349-477a-8479-3d6b5a12d5b9",
                                                "sense_id": "45f601a9-00cb-3cb1-96e4-8bb0519eb211",
                                                "text": "Lord Allerton was that modern phœnix, a young man, without a single objection."
                                            },
                                            {
                                                "example_id": "328ece43-08a8-4677-8a05-93668317c2c0",
                                                "sense_id": "45f601a9-00cb-3cb1-96e4-8bb0519eb211",
                                                "text": "Many of the legitimate nightclubs of today sprang like legalized phoenixes from the still-hot ashes of the speakeasies of prohibition days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9d0be0-48b7-35bf-8584-e132a1937c47",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "A mythological Chinese chimerical bird whose physical body symbolizes the six celestial bodies; a fenghuang."
                                        ],
                                        "tags": [
                                            "Chinese"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f4a8dfe-760f-399e-b273-909d9a745097",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "A Greek silver coin used briefly from 1828 to 1832, divided into 100 lepta."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34dbd389-5f3c-4b1f-b20a-167b26cb8d74",
                                                "sense_id": "8f4a8dfe-760f-399e-b273-909d9a745097",
                                                "text": "The national currency, the phoenix, which had been established by Kapodistrias, was renamed after an ancient Greek coin, the drachma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df584b7c-6abf-361a-8af0-45b25c502b3a",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "A marvelous person or thing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e519837f-155f-4d98-ad57-8ae718b59c5d",
                                                "sense_id": "df584b7c-6abf-361a-8af0-45b25c502b3a",
                                                "text": "He may not be a phœnix of cleverness in your sense; his profession is different; but it would be all the better for you to talk a little on his subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68470ca-06a7-3f4d-8d04-5121e501448e",
                                        "entry_id": "423b0a14-8a41-3bb6-9388-2d6152791b6d",
                                        "glosses": [
                                            "Alternative letter-case form of Phoenix (“A geometer moth of species Eulithis prunata.”)."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "phoenix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8904073-86d4-30f3-80a5-8cb2c0d0b411",
                                        "entry_id": "77408eea-0d0b-3e34-a77d-a07e8aff9b24",
                                        "glosses": [
                                            "To transfer assets from one company to another to dodge liability"
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e03e64f-1752-44df-87b5-a3f06f4e9a80",
                                                "sense_id": "a8904073-86d4-30f3-80a5-8cb2c0d0b411",
                                                "text": "Australian Restructuring Insolvency and Turnaround Association CEO John Winter said phoenixing has been \"endemic\" for decades."
                                            },
                                            {
                                                "example_id": "33d3edd0-cec7-4a85-811c-0b13cdc57621",
                                                "sense_id": "a8904073-86d4-30f3-80a5-8cb2c0d0b411",
                                                "text": "The ATO defines iIllegal^([sic – meaning illegal]) phoenixing as when a new company is created to continue the business of a company that has been deliberately liquidated to avoid paying its debts, including taxes, creditors and employee entitlements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
