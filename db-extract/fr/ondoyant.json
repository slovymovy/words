                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Les flammes ondoyantes."
                            },
                            {
                                "example_id": "981e9bf7-c9b3-42c1-a80e-31f7685d5d9b",
                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Des cheveux ondoyants."
                            },
                            {
                                "example_id": "ee3ae7b3-e473-4eff-86eb-0ce68c0e9526",
                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Des drapeaux ondoyants."
                            },
                            {
                                "example_id": "31d7525a-4efc-495d-83de-1ead7d24ebb5",
                                "sense_id": "b6eb646f-e8ed-3fcc-9411-15f9d3760061",
                                "text": "Avec ses vêtements ondoyants et nacrés,\nMême quand elle marche on dirait qu'elle danse"
                            }
                        ]
                    },
                    {
