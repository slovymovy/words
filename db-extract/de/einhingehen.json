                        "examples": [
                            {
                                "example_id": "40816b79-1915-4ab4-93c4-bafde0b743fb",
                                "sense_id": "1a3a3178-391a-3024-9666-92df8472441a",
                                "text": "„Dann geh i eine und kriag an da Garderobe a Marke mit da Nummer 4!“"
                            },
                            {
                                "example_id": "6bcd9092-e229-454f-999a-4efb5575cd85",
                                "sense_id": "1a3a3178-391a-3024-9666-92df8472441a",
                                "text": "„Und des Madl is in Zimma eineganga.“"
                            },
                            {
                                "example_id": "1ee6652c-9400-40ff-8d3b-632b4f8a15c4",
                                "sense_id": "1a3a3178-391a-3024-9666-92df8472441a",
                                "text": "„S Roos is hoid in Boch eineganga, und mia Buam hamma omgsessn.“"
                            },
                            {
                                "example_id": "c5232fb6-a7db-4a55-b5e0-5da49f1e99ac",
                                "sense_id": "1a3a3178-391a-3024-9666-92df8472441a",
                                "text": "„Waun i vur an Heirign steh, waß i, daß i durt einegeh, weu a Weinderl in Ehren kaun do niemand verwehren!“"
                            },
                            {
                                "example_id": "98e895ea-154c-4f1f-888a-40490c75dfff",
                                "sense_id": "1a3a3178-391a-3024-9666-92df8472441a",
                                "text": "„»Hm, gor net einiganga soit i sei' in dö Sauwirtschaft!« grantelte er verdrießlich in seinen Bart: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3af77d6d-2885-4ecc-936c-03fb3c20cd4f",
