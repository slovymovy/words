                "senses": [
                    {
                        "sense_id": "30b71d10-725a-31ef-b2c4-df7b7ef08b9f",
                        "entry_id": "e77b3435-654a-3e0f-b687-43a957e66af2",
                        "glosses": [
                            "Corrupted or filled with imperfections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d79d25-b289-4958-8846-9ab4a4d922e3",
                                "sense_id": "30b71d10-725a-31ef-b2c4-df7b7ef08b9f",
                                "text": "Hey, get that away from me! It was bought with tainted money."
                            },
                            {
                                "example_id": "a0fff186-1816-46d2-a84c-9c7c1ba65934",
                                "sense_id": "30b71d10-725a-31ef-b2c4-df7b7ef08b9f",
                                "text": "A statement from the official Lao News Agency (KPL) Friday reported that “the consumption of tainted alcoholic beverages” was the suspected cause of the deaths."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aef7823-27ea-327e-8ce5-2e24ce79def6",
                        "entry_id": "e77b3435-654a-3e0f-b687-43a957e66af2",
                        "glosses": [
                            "Originating from an untrusted source."
                        ],
                        "tags": [
                            "of data"
                        ],
                        "examples": [
                            {
                                "example_id": "983e8469-5fc0-4cfc-9416-324b48c3d1e7",
                                "sense_id": "3aef7823-27ea-327e-8ce5-2e24ce79def6",
                                "text": "Do not use tainted values in SQL queries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70ba4a7e-fb52-4d8c-8b6a-e6ef8c27f595",
                        "source_entry_id": "e77b3435-654a-3e0f-b687-43a957e66af2",
                        "source_sense_description": "corrupted or filled with imperfections",
                        "target_lang_word": "unrein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unrein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                        "entry_id": "d962e590-5712-3773-a257-748dd44ee2c8",
                                        "glosses": [
                                            "nicht sauber, also in gewisser Weise verunreinigt, verschmutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d487d4e8-4869-495b-ba8f-dca3614d0f0c",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Wasche dein Gesicht nicht mit diesem unreinen Tuch."
                                            },
                                            {
                                                "example_id": "8f9cfaa7-011b-4728-b8b8-221beddd8f1f",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Er wäscht seine unreinen Hände immer vor dem Essen."
                                            },
                                            {
                                                "example_id": "a57ce9be-add3-4e44-91b7-907ecf7b0afa",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Das Wasser ist unrein – man sollte es nicht trinken."
                                            },
                                            {
                                                "example_id": "c9b4ba63-641c-40ac-89b8-5c6525d985b3",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Aufgrund der besonders unreinen Luft sollte man eine Maske tragen, um sich vor Krankheiten zu schützen."
                                            },
                                            {
                                                "example_id": "4b3cd941-d395-473e-a3a4-836c37b2e959",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Sie legt viel Wert auf die Pflege ihrer unreinen Haut."
                                            },
                                            {
                                                "example_id": "9c429616-c6e9-40f3-ab3a-09bfaa9a10e5",
                                                "sense_id": "25af04ae-e633-33d6-b030-b35532ac1846",
                                                "text": "Wer unreine Kleidung trägt, braucht auch nicht ein unreiner Mensch sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "499590c5-e8b9-3dbc-a43e-267ccd395ab9",
                                        "entry_id": "d962e590-5712-3773-a257-748dd44ee2c8",
                                        "glosses": [
                                            "die Qualität von etwas beeinträchtigend, herabsetzend"
                                        ],
                                        "tags": [
                                            "allgemeiner"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8339ad-19d9-432f-95ea-192cf53f0d17",
                                                "sense_id": "499590c5-e8b9-3dbc-a43e-267ccd395ab9",
                                                "text": "Wegen seiner sehr unreinen Stimme ist er nicht als Sänger geeignet."
                                            },
                                            {
                                                "example_id": "bd535832-e00f-43fd-b118-c440811c67d1",
                                                "sense_id": "499590c5-e8b9-3dbc-a43e-267ccd395ab9",
                                                "text": "Der Pianist spielte teilweise unreine Akkorde."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1df7e7a6-b757-3b73-b94b-8ac4e5633cc8",
                                        "entry_id": "d962e590-5712-3773-a257-748dd44ee2c8",
                                        "glosses": [
                                            "als Gläubiger nicht annehmbar, akzeptabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b80ccda2-8797-4c82-808c-32de26993869",
                                                "sense_id": "1df7e7a6-b757-3b73-b94b-8ac4e5633cc8",
                                                "text": "In vielen Religionen gilt das Schwein als unrein."
                                            },
                                            {
                                                "example_id": "07cbedd3-2a42-47e7-bf2b-4ef4ffd3eeea",
                                                "sense_id": "1df7e7a6-b757-3b73-b94b-8ac4e5633cc8",
                                                "text": "Die unreinen Geister wurden aus seiner Seele vertrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "070ef21f-4d0f-37b5-8d75-2d70bc906810",
                                        "entry_id": "d962e590-5712-3773-a257-748dd44ee2c8",
                                        "glosses": [
                                            "nicht anständig und ehrlich; unredlich"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b40c417f-c091-4bb1-a893-01d8b8780dc0",
                                                "sense_id": "070ef21f-4d0f-37b5-8d75-2d70bc906810",
                                                "text": "Wer unreine Kleidung trägt, braucht auch nicht ein unreiner Mensch sein."
                                            },
                                            {
                                                "example_id": "8519df14-08e9-4a8a-a160-c94d9d281743",
                                                "sense_id": "070ef21f-4d0f-37b5-8d75-2d70bc906810",
                                                "text": "Wenn er zornig ist, spricht er viele unreine Worte."
                                            },
                                            {
                                                "example_id": "e76a262c-3450-41d8-81c9-ad4427e293c9",
                                                "sense_id": "070ef21f-4d0f-37b5-8d75-2d70bc906810",
                                                "text": "Menschen mit unreinen Absichten werden oft scheitern."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
