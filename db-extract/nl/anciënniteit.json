                        "examples": [
                            {
                                "example_id": "4d64b25a-b069-4023-967e-6cea2421fd7a",
                                "sense_id": "1fb17191-fd80-373d-b9cc-aee06368569f",
                                "text": "Bij het leggen van die puzzel gelden een paar vuistregels. Fracties hebben per Tweede Kamerlid recht op 52 vierkante meter. Binnen die ruimte wordt ook het ondersteunend personeel gehuisvest. Grote fracties, vanaf vijftien zetels, hebben recht op een eigen ‘fractiekamer’: een vaste vergaderruimte. Binnen veel fracties geldt anciënniteit: het langstzittende Tweede Kamerlid - kabinetsjaren tellen ook mee - mag de mooiste werkkamer uitzoeken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
