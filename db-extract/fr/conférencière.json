                                                "example_id": "48936555-fba6-4cc9-b7b3-5e20085150b1",
                                                "sense_id": "de315ae1-20e3-3dfa-8efe-7e5faa289cf3",
                                                "text": "Die neue Referentin im Sozialministerium muss sich erst noch richtig einarbeiten."
                                            }
