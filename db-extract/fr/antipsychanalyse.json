                            {
                                "example_id": "fe94f9a9-721b-42f5-8e0b-1fb5e71f918f",
                                "sense_id": "25bc89d5-6610-39d9-9ae5-6082d7fad245",
                                "text": "L’exploitation des fonds de tiroir de l’antipsychanalyse va jusqu’à publier un texte d’Aldous Huxley de 1925 dans lequel il s’autorise des jugements péremptoires en toute ignorance."
                            },
                            {
                                "example_id": "5f30967c-352b-472a-8245-95dad6af810d",
                                "sense_id": "25bc89d5-6610-39d9-9ae5-6082d7fad245",
                                "text": "L’antipsychanalyse s'est particulièrement distinguée par le repérage des lieux dits communs qui n’ont rien à partager avec ce qu’il en est effectivement de la psychanalyse."
                            },
                            {
                                "example_id": "35bc4f5d-ce3c-4651-8b8e-709e8a254f1c",
                                "sense_id": "25bc89d5-6610-39d9-9ae5-6082d7fad245",
                                "text": "Il représente sans doute un des piliers principaux de l’édifice de la psychanalyse, même si certains auteurs lui ont apporté quelques variantes, et l’antipsychanalyse se trouve parfois nommée « la mort d’Œdipe »."
                            }
                        ]
                    }
