                "senses": [
                    {
                        "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                        "entry_id": "3e063dac-9172-3eb9-bc09-4b34ccbcc1b9",
                        "glosses": [
                            "meist große, aus größerer Entfernung sichtbare Uhr, die in oder an einem Turm montiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b32d3a9c-3ca4-4f48-8628-d2bf4850806d",
                                "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                                "text": "Die Turmuhr zeigt 11 Uhr."
                            },
                            {
                                "example_id": "ceea60de-2489-4827-a301-478613ddf612",
                                "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                                "text": "„Die Turmuhr in Brocklesby Park, die um 1722 fertiggestellt wurde, zeigt noch heute die Zeit an. Sie läuft seit über 270 Jahren – abgesehen von einer kurzen Unterbrechung im Jahre 1884, als sie überholt wurde.“"
                            },
                            {
                                "example_id": "eef793fc-1d46-4374-bb95-3bf7dd25a588",
                                "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                                "text": "„Um zehn Uhr drang der Schlag der Turmuhr von Trinità de'Monti gebieterisch an unser Ohr.“"
                            },
                            {
                                "example_id": "94b74412-1500-499a-8605-a5167d14ed96",
                                "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                                "text": "„Die Turmuhren auf dem Gendarmenmarkt schlugen elf, als die Gäste von Frau Carayon auf die Behrenstraße hinaustraten und, nach links einbiegend, auf die Linden zuschritten.“"
                            },
                            {
                                "example_id": "bb52c765-5bd5-46c7-bdba-8a298bac1b52",
                                "sense_id": "8a5b370d-d9c0-3b85-adf9-d72a91781859",
                                "text": "„Eine Turmuhr schlug draußen die dritte Morgenstunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
