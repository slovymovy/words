                                                "sense_id": "900891c9-9c31-3c54-9090-55e989ea41d9",
                                                "text": "A good WebApp interface is understandable and forgiving, providing the user with a sense of control. […] Work is carefully and continuously saved, with full option for the user to undo any activity at any time."
                                            }
                                        ]
                                    }
