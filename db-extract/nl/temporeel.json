                            {
                                "target_word": "temporal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd4f8a1a-19e5-377f-83d9-32831ca03e8e",
                                        "entry_id": "89477242-9dcd-33e2-ba11-367848178434",
                                        "glosses": [
                                            "Anything temporal or secular; a temporality."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5c5e33f-3af3-45e7-95cd-0cab8bd68e84",
                                                "sense_id": "fd4f8a1a-19e5-377f-83d9-32831ca03e8e",
                                                "text": "for God's people love always to be dealing as well in temporals as spirituals"
                                            },
                                            {
                                                "example_id": "c1598a40-d494-4ecf-b11a-f7203712fe6a",
                                                "sense_id": "fd4f8a1a-19e5-377f-83d9-32831ca03e8e",
                                                "text": "He assigns supremacy to the pope in spirituals, and to the emperor in temporals."
                                            }
