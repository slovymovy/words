                "senses": [
                    {
                        "sense_id": "14d3bbaa-bca0-372d-82b8-ab6a49c0d3b5",
                        "entry_id": "1544d2d4-ee99-3c2d-9d59-c6e0318a963e",
                        "glosses": [
                            "Mettre à la retraite."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "a003cb28-7e5c-4eb2-bcc1-c6e377b311b5",
                                "sense_id": "14d3bbaa-bca0-372d-82b8-ab6a49c0d3b5",
                                "text": "L’on propose de charger le Président de Namur d’aviser sur la question, s’il ne conviendroit pas de renvoyer Poffon du service ou de le jubilariser."
                            },
                            {
                                "example_id": "3152249f-3e2d-4527-ac59-8bbdaa29a603",
                                "sense_id": "14d3bbaa-bca0-372d-82b8-ab6a49c0d3b5",
                                "text": "L’état ci-joint renferme les noms des employés à jubilariser dès aujourd’hui; ils ont été traités strictement sur le pied de la norme du 24 mars 1781, non pas par rapport aux petites sommes que les traitemens proposés par le nouveau directeur auroient coûté de plus, mais uniquement parce qu’une déviation de la règle occasioneroit une infinité d'exceptions à l’ordre établi, que chacun voudroit interpréter en sa faveur."
                            }
                        ]
                    }
