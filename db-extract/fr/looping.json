                "senses": [
                    {
                        "sense_id": "8576c299-8ad7-3e50-8510-75373aec2719",
                        "entry_id": "ee7cc7c5-d8b1-3931-acdc-d099f1f66e9e",
                        "glosses": [
                            "Figure de voltige aérienne en forme de boucle où l'aéronef se cabre, passe sur le dos puis redescend."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "dbe0537b-d142-46dd-b254-fd835470001b",
                                "sense_id": "8576c299-8ad7-3e50-8510-75373aec2719",
                                "text": "L'avion continuait effectivement sa route sans faire de piqué ni de looping ! Ça aurait pu être amusant de varier un peu la trajectoire, mais les passagers derrière n'auraient peut-être pas apprécié..."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0f52481-81ad-3e02-afbb-fe6c5fb0872b",
                        "entry_id": "ee7cc7c5-d8b1-3931-acdc-d099f1f66e9e",
                        "glosses": [
                            "Section d’un grand huit où les rails forment une boucle."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c6d7f17-3bd4-471e-b984-d4f161eac2b8",
                        "source_entry_id": "ee7cc7c5-d8b1-3931-acdc-d099f1f66e9e",
                        "source_sense_id": "8576c299-8ad7-3e50-8510-75373aec2719",
                        "source_sense_description": "Figure de voltige aérienne",
                        "target_lang_word": "Looping",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Looping",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93ec8086-91dc-3da2-a032-339c3cded782",
                                        "entry_id": "81431c81-e29b-31d5-972e-823257fb7d6b",
                                        "glosses": [
                                            "Flugmanöver, bei dem ein Flugzeug sich überschlägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87911e7f-b9b9-4007-9614-7bc93aa9c7f9",
                                                "sense_id": "93ec8086-91dc-3da2-a032-339c3cded782",
                                                "text": "„In großer Höhe drehte ein Doppeldecker einen Looping nach dem andern und weit draußen übte die Marine Schießen.“"
                                            },
                                            {
                                                "example_id": "fa5bac33-1e4c-4ece-8ab4-ba79c7fde361",
                                                "sense_id": "93ec8086-91dc-3da2-a032-339c3cded782",
                                                "text": "„Hiervon macht vor allem der Kunstflieger mit seinen Figuren wie Loopings, Steilkehren, Spiralen, Trudeln, Rückenkreisen, Gestoßenen und Gesteuerten Rollen Gebrauch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b3af63bb-5ae3-31fe-83b6-59005aa3be9b",
                                        "entry_id": "81431c81-e29b-31d5-972e-823257fb7d6b",
                                        "glosses": [
                                            "vertikale Schleife als Element von manchen Achterbahnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a68594-9483-4892-9a36-6bebadfda253",
                                                "sense_id": "b3af63bb-5ae3-31fe-83b6-59005aa3be9b",
                                                "text": "„Im englischen Freizeitpark Alton Towers hat eine Weltneuheit eröffnet. Eine Achterbahn mit 14 Loopings und visuellen Illusionen verspricht eine Fahrt, die man so schnell nicht mehr vergisst.“"
                                            },
                                            {
                                                "example_id": "7ecd8dba-f5cf-4aaf-9c27-b4f1ee0e05e5",
                                                "sense_id": "b3af63bb-5ae3-31fe-83b6-59005aa3be9b",
                                                "text": "„Zum Geburtstag kriegte ich einen Looping für die Carrerabahn, eine Single, Süßigkeiten, Strümpfe, zehn Mark und von Tante Dagmar ein Oberhemd mit tausend Stecknadeln drin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5583c8b8-459e-4c01-a6f9-704d8d4d96e8",
                        "source_entry_id": "ee7cc7c5-d8b1-3931-acdc-d099f1f66e9e",
                        "source_sense_id": "8576c299-8ad7-3e50-8510-75373aec2719",
