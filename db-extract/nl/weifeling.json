                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ed9b31f-3cff-40b1-b306-ab49c8832a33",
                                                "sense_id": "f548c7cb-ad4e-3920-b0b5-71dba0d91203",
                                                "text": "It is a picture of dither, delay, unrealistic costings - and Department for Transport indecisiveness."
                                            }
                                        ]
