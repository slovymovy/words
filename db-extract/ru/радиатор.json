                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ddf416d-45f0-3a71-ba80-3aeb398ad08c",
                                        "entry_id": "b069a821-071c-3ec6-b835-b9b64e6927be",
                                        "glosses": [
                                            "To fit with a heat sink."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b2ec4ea-ddaa-45ce-8341-671ac91dd264",
                                                "sense_id": "0ddf416d-45f0-3a71-ba80-3aeb398ad08c",
                                                "text": "It was necessary to heatsink the device through the center conductor of the coax thereby producing a total thermal resistance from the active layer to the ambient of almost 50°C/watt."
                                            },
                                            {
                                                "example_id": "65667347-54f6-4774-a156-bc044af7b5f2",
                                                "sense_id": "0ddf416d-45f0-3a71-ba80-3aeb398ad08c",
                                                "text": "The device itself can dissipate a peak power of 78 W when properly heatsinked and has a 65 W steady dissipation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
