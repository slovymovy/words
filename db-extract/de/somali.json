                                            {
                                                "example_id": "e32c2905-13a1-4323-b41a-92ec4d4128a8",
                                                "sense_id": "f6a3cd64-d031-3214-8f7d-1bdb57b70495",
                                                "text": "Après mon départ de Gondar, je finis par des relations de hasard, au quartier chaud de Djibouti, avec des filles somali ; pourtant, de ces amours ou dérisoires ou malheureuses j’ai gardé une impression de paradis."
                                            },
                                            {
                                                "example_id": "5435bad9-3d42-4b4e-a1b6-5f8359adab23",
                                                "sense_id": "f6a3cd64-d031-3214-8f7d-1bdb57b70495",
                                                "text": "L’augmentation des commerces tenus par les Yéménites va de pair avec la disparition des commerçants somalis et afars, ainsi qu’une « yéménisation » des modes de vie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somali",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0d706f-bc73-3896-ab2f-5563eeb09701",
                                        "entry_id": "fb80762f-8f8b-3caa-88ff-bf81657e6352",
                                        "glosses": [
                                            "Langue couchitique parlée dans presque toute la Corne de l’Afrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "576e21e5-55b5-4a42-be0c-5888b204c833",
                                                "sense_id": "6e0d706f-bc73-3896-ab2f-5563eeb09701",
                                                "text": "L’entreprise a mis au point un outil de traduction automatique entre le tigrinia, l’amharique et l’anglais, et prévoit d’ajouter bientôt l’oromo et le somali."
                                            }
                                        ]
                                    }
