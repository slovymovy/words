                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7509a1e0-5a2b-36af-ac6f-dba01fa0fc13",
                                        "entry_id": "2b2265b6-6c7e-3413-9ba2-59532c58827d",
                                        "glosses": [
                                            "etwas nach vorne durchreichen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23465ded-1456-45af-9f28-68035e96b9c2",
                                                "sense_id": "7509a1e0-5a2b-36af-ac6f-dba01fa0fc13",
                                                "text": "Sie gab ihr Hausaufgabenheft zum Lehrer vor."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "448d44bd-44e7-3b96-94df-b51b1841fb7f",
                                        "entry_id": "2b2265b6-6c7e-3413-9ba2-59532c58827d",
                                        "glosses": [
                                            "jemandem einen Vorteil einräumen, eine Vorgabe gewähren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22b95950-332f-4910-8788-26ca3261c4f8",
                                                "sense_id": "448d44bd-44e7-3b96-94df-b51b1841fb7f",
                                                "text": "Mein Vater gab mir früher beim Schachspielen immer einen Turm vor."
                                            },
                                            {
                                                "example_id": "a917c012-e0cf-4d8a-964f-be1e14a5313c",
                                                "sense_id": "448d44bd-44e7-3b96-94df-b51b1841fb7f",
                                                "text": "Es wurde mit einer Grundzeit von 10 Minuten gespielt, wovon der elobessere Spieler je 100 Elo eine Minute vorgeben musste."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf82e83c-010d-49ee-9bad-732bf29c52c0",
                        "source_entry_id": "31c07173-f476-3d9a-bc42-96868f137878",
                        "source_sense_id": "d9ac24c5-98f8-3421-a092-5847f3521981",
                        "source_sense_description": "To define in advance",
                        "target_lang_word": "festlegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "festlegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "einen verbindlichen Beschluss fassen, eine verbindliche Entscheidung treffen; durch verbindliche Regeln, Vorschriften bestimmen, verordnen; verbindlich festsetzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3767c9-40f9-418a-ab04-583b2551974a",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "Das generelle Vorgehen kann nur durch ein weiteres Meinungsbild festgelegt werden."
                                            },
                                            {
                                                "example_id": "658d47c9-b498-4974-907c-44f52a780c36",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "Die EU-Kommission legt jährlich die Fangquoten für die Fischer fest."
                                            },
                                            {
                                                "example_id": "5afe1384-050c-4d0b-bad8-5bfbe1e8be32",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "Historiker können den Beginn des Holocaust nicht auf einen Tag festlegen."
                                            },
                                            {
                                                "example_id": "6d0c97ea-56c9-40dc-9c88-63fe1fab3b8f",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "„Dieser Doppelgriff sollte mein Leben, zumindest jenes Leben, welches abseits meiner Trommel zu führen ich mir anmaßte, festlegen und beeinflussen.“"
                                            },
                                            {
                                                "example_id": "92ed4625-5bc2-4bcf-8b16-7af23b8a978e",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "„Sie legte die Normen fest, gab für das Mischen 11 Minuten vor, für das Betonieren 22, für die Hilfsarbeiten 2, für das Fahren des Druckgerätes 6, addierte und gelangte auf 41 Minuten pro Einheit.“"
                                            },
                                            {
                                                "example_id": "fe5fef4d-0835-46aa-8af0-c8a18823d6a9",
                                                "sense_id": "a55930e5-a4a9-37d6-adee-06e2645f1ce5",
                                                "text": "„Gut zwei Monate nach der Kapitulation des verbrecherischen NS-Regimes treffen sich die Siegermächte erneut, um auf der Konferenz von Potsdam (17.7. bis 2.8.1945) die zukünftigen Staatsgrenzen endgültig festzulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b543775e-b04f-31e4-b0d3-51a504e1f4a0",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "von jemandem eine bindende Auskunft oder Zusage erwarten, verlangen; von jemandem erwarten, verlangen, dass er das tut beziehungsweise sich an das hält, was er gesagt, versprochen hat"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bad43743-0a15-4763-9029-4dd5bbec0424",
                                                "sense_id": "b543775e-b04f-31e4-b0d3-51a504e1f4a0",
                                                "text": "„‚Heißt das‘, griff Toinette zu, ‚daß Sie dann den Allianzvertrag schließen würden?‘– ‚Nun ja‘, drückte Louis herum, ‚dann allerdings.‘ – ‚Also, abgemacht, Sire‘, legte ihn Toinette fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84d76eda-238a-38f9-8282-75efe372d921",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "etwas ganz fest zusagen (lassen); versprechen (lassen), etwas zu tun; (jemanden, sich) an, für etwas fest binden, verpflichten (lassen)"
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd2abea-3172-46e9-a139-7ea8a1098aeb",
                                                "sense_id": "84d76eda-238a-38f9-8282-75efe372d921",
                                                "text": "„Udo: Hast du dich heute vorbereitet? Einen Plan oder so?",
                                                "translation": "Udo: Nanana.“"
                                            },
                                            {
                                                "example_id": "1db2ae7a-0513-4af5-b530-70e413f8725f",
                                                "sense_id": "84d76eda-238a-38f9-8282-75efe372d921",
                                                "text": "„Illustratorin Larissa Bertonasco will sich nicht aufs Kochbuch-Genre festlegen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fb92a5bc-95e5-31d0-88dc-44e5b571c2b4",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "jemanden für etwas verantwortlich machen, jemandem die Schuld an etwas zuschreiben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100671f5-7628-4e16-98ef-165c5ad6008f",
                                                "sense_id": "fb92a5bc-95e5-31d0-88dc-44e5b571c2b4",
                                                "text": "„Weitere Morde, auf die man sie festlegen wollte, stritt sie jedoch energisch ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "(einen Geldbetrag) für längere Zeit fest und sicher (zum Beispiel in Sachgütern) anlegen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b6df0d6-2a88-40dd-a3d2-8b1eec0f8870",
                                                "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                                "text": "„Solang sein Kapital als Kapital fungirt, gehört es dem Reproduktionsprocess, ist es darin festgelegt.“"
                                            },
                                            {
                                                "example_id": "f44f1e82-9876-4e2e-ad07-3bcc6bca7fdc",
                                                "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                                "text": "„[…]; mehrfach auch haben sie [= die Banken] große Geldmittel in Börsenspekulationen festgelegt und dadurch dem inländischen industriellen Kredit entzogen.“"
                                            },
                                            {
                                                "example_id": "dc6d4272-131a-450a-b440-6b24b4b5f79c",
                                                "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                                "text": "„Es war Blödsinn, so viel Geld festzulegen für einen Ring. Aber er legte es fest.“"
                                            },
                                            {
                                                "example_id": "54568591-a14d-4cce-98c9-24ec1d0e71a1",
                                                "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                                "text": "„Also noch einmal: ein Alleinstehender kann monatlich 26 Mark vermögenswirksam, also auf wenigstens fünf Jahre festgelegt, einzahlen, dafür zahlt er keine Steuern, kassiert aber …“"
                                            },
                                            {
                                                "example_id": "c83bcacc-67d9-4d85-bf3a-c1789ce8827c",
                                                "sense_id": "b132051f-5711-322d-80a5-cc70df12592c",
                                                "text": "„Empfehlung: Verstärkter Aktienkauf in Chemie- und Autoindustrie, und höchstens drei bis vier Jahre Geld festlegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "527cf1fc-c4f7-370d-953a-0913b92d7940",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "(ein Wasserfahrzeug) ankern oder an einer Anlegestelle mit Tauen vor dem Abtreiben sichern"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e7e2f37-2812-49c5-9868-eb29b38f6549",
                                                "sense_id": "527cf1fc-c4f7-370d-953a-0913b92d7940",
                                                "text": "„Mit der Flut gingen wir wieder ankerauf und kamen an einem schönen Julimorgen im Hafen von Kingston upon Hull an, legten am Bollwerk des alten Marktes fest und verkauften den bedauerlich mageren Rest unseres Fangergebnisses.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "14bb6ade-db3d-3f1d-9303-c19c37b6ad45",
                                        "entry_id": "71a0c2e7-169a-3a77-8739-b9a9e8ecea2e",
                                        "glosses": [
                                            "(etwas, jemanden, sich) an, auf etwas fest anbringen"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "reflexive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710aa91d-9241-48a8-b704-b2d08dfde3bc",
                                                "sense_id": "14bb6ade-db3d-3f1d-9303-c19c37b6ad45",
                                                "text": "„Der Knabe erklärte sich bereit, seinen Affen vorzuführen, und in der Tat zeigte sich das Tier außerordentlich gut unterrichtet. Kaum war er von seiner Fessel befreit worden, als er mit großer Geschwindigkeit eine Palme erstieg, eine große Nuß abdrehte und sich geduldig wieder festlegen ließ, nachdem die Nuß gefallen war, und er, um vieles langsamer, wieder niederkletterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    },
