                "senses": [
                    {
                        "sense_id": "bc1a457e-431b-3c56-a7bc-e6eb084427dd",
                        "entry_id": "3c1c39f6-0211-3657-be4c-5d2712964ad3",
                        "glosses": [
                            "Umwandlung eines Bauern auf der gegnerischen Grundreihe in eine geringerwertige Figur als die Dame"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "9032fd5e-bb73-49a9-b20d-30f7c4209d0d",
                                "sense_id": "bc1a457e-431b-3c56-a7bc-e6eb084427dd",
                                "text": "„›Ganz genau, er verwandelt sich, im Allgemeinen in eine Dame, wie jeder weiß, aber er kann auch zu einer anderen Figur werden, je nach Wunsch des Spielers. Das Entscheidende beim Excelsior ist, dass der Bauer sich in jede andere Figur verwandeln kann. Er wird hier aber nicht zur Dame, sondern zu etwas anderem. Wir nennen das Unterverwandlung. Sie kennen den Begriff?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
