                "senses": [
                    {
                        "sense_id": "fe63b0ed-c388-334c-9ccc-908a9aa6be82",
                        "entry_id": "c781a670-4df1-349b-8ec9-65032e2eedf9",
                        "glosses": [
                            "to rot away"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff609a45-efea-40fe-949f-f1b34b5af599",
                                "sense_id": "fe63b0ed-c388-334c-9ccc-908a9aa6be82",
                                "text": "Het oude hout is aan het wegrotten in de tuin.",
                                "translation": "The old wood is rotting away in the garden.",
                                "english": "The old wood is rotting away in the garden."
                            },
                            {
                                "example_id": "f0ae759b-4ad8-42cd-82bf-8fd4ddf01bbf",
                                "sense_id": "fe63b0ed-c388-334c-9ccc-908a9aa6be82",
                                "text": "Als we het voedsel niet snel consumeren, zal het wegrotten.",
                                "translation": "If we don't consume the food soon, it will rot away.",
                                "english": "If we don't consume the food soon, it will rot away."
                            },
                            {
                                "example_id": "b47b11cb-dd66-4552-bf27-e267ec46cfb7",
                                "sense_id": "fe63b0ed-c388-334c-9ccc-908a9aa6be82",
                                "text": "De pompoen is weggerot na een week buiten te hebben gelegen.",
                                "translation": "The pumpkin has rotted away after being outside for a week.",
                                "english": "The pumpkin has rotted away after being outside for a week."
                            }
                        ]
                    }
