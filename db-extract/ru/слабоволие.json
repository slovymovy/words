                        "translation_id": "2ce8807a-ff08-414d-aefe-1dfa78a1a1d0",
                        "source_entry_id": "0251b8b1-b509-302b-81a0-5392e6b07929",
                        "source_sense_id": "42ec6ca7-f82d-39c1-ba59-88d53fc56b42",
                        "target_lang_word": "veulerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veulerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "663c6bfa-8da9-3d43-8d85-6dc0a3010839",
                                        "entry_id": "861442fb-285f-3fa8-9119-8e3ffd0ef722",
                                        "glosses": [
                                            "Caractère, état de celui ou de celle qui est veule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93119ddc-8e17-4d83-8874-c7e7689e8ed6",
                                                "sense_id": "663c6bfa-8da9-3d43-8d85-6dc0a3010839",
                                                "text": "Et la canaillerie de cette liaison, cette dépravation enjouée et facile séduisaient Pierre, flattant un fonds de veulerie qui se trouvait en lui."
                                            },
                                            {
                                                "example_id": "1b112739-1e46-4057-9758-5a6545ba021d",
                                                "sense_id": "663c6bfa-8da9-3d43-8d85-6dc0a3010839",
                                                "text": "La veulerie des hommes de ce temps fut si grande que parfois la substitution du nouveau personnel à l’ancien prenait des allures bouffonnes ; […]."
                                            },
                                            {
                                                "example_id": "65c4cfe6-55fa-42ec-9890-2f9d8df808b8",
                                                "sense_id": "663c6bfa-8da9-3d43-8d85-6dc0a3010839",
                                                "text": "J'avais beau plonger des yeux furieux dans ses prunelles sombres, je n'y trouvais ni contact, ni étincelle, rien qu'une veulerie menaçante noyée dans de l'eau morte."
                                            },
                                            {
                                                "example_id": "fe5c518c-9aba-4ecb-a8b0-72cc852e8164",
                                                "sense_id": "663c6bfa-8da9-3d43-8d85-6dc0a3010839",
                                                "text": "La seule explication qui tient la route pour expliquer leur décision est la lâcheté. Une veulerie nourrie par l’influence encore forte de Trump dans le Parti républicain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
