                "senses": [
                    {
                        "sense_id": "366c54b5-b2d3-3f6b-a743-fb35a54dd6d7",
                        "entry_id": "e0945835-fe63-3271-af41-de3577689631",
                        "glosses": [
                            "Qualifiait le figuier ombrageant le groupe de bronze qui se voyait au forum, et représentait Romulus et Rémus allaités par une louve."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "e7773aaa-9e48-4922-b67e-f54133e3bca6",
                                "sense_id": "366c54b5-b2d3-3f6b-a743-fb35a54dd6d7",
                                "text": "Ainsi le figuier Ruminal avait été compris par les Anciens principalement en fonction de la scène où il apparaissait dans la légende du héros fondateur, par référence à un terme signifiant mamelle et d'une Diva Rumina, au nom apparenté, protectrice de la fonction nourricière."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeef411f-a8bb-3632-b16c-b384ca4950c4",
                        "entry_id": "e0945835-fe63-3271-af41-de3577689631",
                        "glosses": [
                            "Relatif au rumen et à la digestion gastrique de ruminants."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "97786cae-53b4-47a4-9bc9-f6fed48cd6c9",
                                "sense_id": "aeef411f-a8bb-3632-b16c-b384ca4950c4",
                                "text": "En conclusion, la vitesse de dégradation ruminale des aliments concentrés pourrait modifier le métabolisme énergétique et la composition du lait des ruminants en début de lactation."
                            },
                            {
                                "example_id": "5deb940c-e0e3-4c69-834e-619796a9ba53",
                                "sense_id": "aeef411f-a8bb-3632-b16c-b384ca4950c4",
                                "text": "Cette activité métabolique leur permet d'interagir avec la microflore ruminale."
                            },
                            {
                                "example_id": "e610941f-7b5b-47ed-846c-18ec656dee6b",
                                "sense_id": "aeef411f-a8bb-3632-b16c-b384ca4950c4",
                                "text": "Ceux–ci servent de précurseurs à la synthèse de ces mêmes acides aminés dans les cellules, mais également des acides gras ramifiés des microorganismes ruminaux."
                            }
                        ]
                    }
