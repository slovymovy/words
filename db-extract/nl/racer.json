                                                "sense_id": "79ad5c29-b4ea-3dda-afd8-95949d23bb01",
                                                "text": "Die Renners fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "9eaf4f50-4518-4866-a369-cc62088ade08",
                                                "sense_id": "79ad5c29-b4ea-3dda-afd8-95949d23bb01",
                                                "text": "Der Renner trägt nie die Schals, die die Renner ihm strickt."
                                            },
