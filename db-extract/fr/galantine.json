                "senses": [
                    {
                        "sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
                        "entry_id": "5a9b4d2e-7342-35f3-8515-42a50e9c782d",
                        "glosses": [
                            "Charcuterie faite de viandes blanches, désossées, assaisonné de divers ingrédients et que l’on sert en gelée."
                        ],
                        "tags": [
                            "Charcuterie"
                        ],
                        "examples": [
                            {
                                "example_id": "3caf840d-e544-44bc-b1a7-11c73833244c",
                                "sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
                                "text": "Galantine de volaille."
                            },
                            {
                                "example_id": "1b22d322-a605-4887-b79c-85b2e26e032c",
                                "sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
                                "text": "Galantine truffée."
                            },
                            {
                                "example_id": "ee41fe0c-4940-4e5a-902e-191d97619133",
                                "sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
                                "text": "Le rôti chaud était un filet aux truffes, et le rôti froid, une galantine de pintade à la gelée."
                            },
                            {
                                "example_id": "f7656f01-0c4a-4e47-9f10-76af36a6fffe",
                                "sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
                                "text": "Œufs en gelée, cornets, aspics et barquettes, ballottines, galantines, pâtés, chauds-froids, daubes, terrines, confits, tourtes, tartes, frangipanes : toutes ces dames avaient rempli avec zèle leurs devoirs sociaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fa7975c-9778-4715-98b6-1ee60dfabb37",
                        "source_entry_id": "5a9b4d2e-7342-35f3-8515-42a50e9c782d",
                        "source_sense_id": "7207eadb-8f4e-35f9-957d-755c8e25d3bc",
