                                "target_senses": [
                                    {
                                        "sense_id": "0c2dcc2c-28f1-34fa-ae2c-1662d20c59ea",
                                        "entry_id": "4238450b-56d4-3db3-bf9f-76dcedcd0110",
                                        "glosses": [
                                            "im Schwarm jagender Raubfisch mit sehr scharfen Zähnen, der seine Beute rasch abfrisst"
                                        ],
                                        "tags": [
                                            "Ichthyologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58777030-14ea-4342-9476-7531671c49b3",
                                                "sense_id": "0c2dcc2c-28f1-34fa-ae2c-1662d20c59ea",
                                                "text": "Der Schwarze Piranha ist der Fisch mit dem kräftigsten Kiefer."
                                            },
                                            {
                                                "example_id": "1bc768df-b6e6-4d19-a36c-5be25223374a",
                                                "sense_id": "0c2dcc2c-28f1-34fa-ae2c-1662d20c59ea",
                                                "text": "Auch der Kiefer von Tyrannosaurus Rex hätte im Verhältnis schwach gewirkt neben dem des Schwarzen Piranhas."
                                            },
                                            {
                                                "example_id": "f45aaf05-d3db-496f-954e-e5c5e6eaca2d",
                                                "sense_id": "0c2dcc2c-28f1-34fa-ae2c-1662d20c59ea",
                                                "text": "Ein Mann soll von Piranhas gefressen worden sein, nachdem er vor einem Bienenschwarm floh und ins Wasser sprang."
                                            },
                                            {
                                                "example_id": "cba1c267-b927-4076-a157-d43e9b870925",
                                                "sense_id": "0c2dcc2c-28f1-34fa-ae2c-1662d20c59ea",
                                                "text": "Die Gier der Piranhas wurde denn auch in der Tat von den Indianern am Orinoco ehemals dazu benutzt, ihre Toten, deren Skelette sie aufbewahrten, präparieren zu lassen, indem sie die Leichname eine Nacht im Flusse aufhingen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "046ec7b4-aca3-4d2e-9e1b-643bf2711291",
                        "source_entry_id": "e1ae6c40-d825-3b41-a5c8-b226153f77d0",
                        "source_sense_id": "9449cead-00d8-3d16-aba6-0eaecc7a1da4",
