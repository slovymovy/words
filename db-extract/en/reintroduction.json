                "entry_id": "4b611052-becb-355e-aad3-1626724967f5",
                "word": "reintroduction",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5ee6ff87-0181-4673-8e2d-a57372670b35",
                        "entry_id": "4b611052-becb-355e-aad3-1626724967f5",
                        "tags": [
