                                                "example_id": "0c7729a2-4b87-4750-bbed-71ce7d66e2e7",
                                                "sense_id": "d8b5e33c-de5e-386d-ab45-11f5c4dace08",
                                                "text": "Located on the northbound platform, the detached, timber-clad waiting room (a period Furness Railway structure) has been adapted into a pet-friendly, self-catering, two-bedroom holiday home complete with sun lounge and garden for those sunny Cumbrian days."
                                            }
