                        "examples": [
                            {
                                "example_id": "a8c2fccb-7c7a-4030-9c63-c5ac9f357e36",
                                "sense_id": "0a54f664-f2dc-39cb-81d4-3907735d9015",
                                "text": "A heavy trampling of steps—clashing as if of swords—several rounds of musketry—screams—shouts—rose in the direction of the court."
                            },
                            {
                                "example_id": "7951ed82-b457-4cf0-af1c-1f6c99596ea1",
                                "sense_id": "0a54f664-f2dc-39cb-81d4-3907735d9015",
                                "text": "Nor was this less ominous than the rattle of musketry, for it suggested but a single solution to the little band of rescuers—that the illy garrisoned village had already succumbed to the onslaught of a superior force."
                            }
                        ]
                    }
