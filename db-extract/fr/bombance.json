        "fr-extract.jsonl": [
            {
                "entry_id": "d0acdade-0196-3054-a5b5-b7d450700171",
                "word": "bombance",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a855152a-9523-424c-a674-b1dad4783285",
                        "entry_id": "d0acdade-0196-3054-a5b5-b7d450700171",
                        "tags": [
                            "plural"
                        ],
                        "form": "bombances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                        "entry_id": "d0acdade-0196-3054-a5b5-b7d450700171",
                        "glosses": [
                            "Bonne chère abondamment servie."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "87c429c1-2673-467e-b6b1-e7709d4849e3",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "c’était là que Florent et Gavard venaient faire des bombances avec ces deux salopes de Méhudin ; au dessert, il se passait des choses abominables."
                            },
                            {
                                "example_id": "cd5bf896-ef54-47f0-acaf-595597de26a0",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Toujours très longs, les dîners que donnait ce bon vieux prêtre ; souvent même, c’étaient des bombances méridionales auxquelles plusieurs des notables de la région étaient conviés. Dix ou quinze plats se succédaient, accompagnés des fruits les plus dorés, les plus beaux, et des vins les plus choisis parmi ceux que la contrée produisait si abondamment en ce temps-là."
                            },
                            {
                                "example_id": "b1ba7659-2b46-4a1a-b754-842175debe29",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Le jeûne commence au f’jer, à l’heure où l’on parvient à distinguer un fil blanc d’un fil noir. Au moghreb, un coup de canon, salué avec allégresse par les fidèles affamés et altérés, annonce sa fin et la reprise des bombances qui durent toute la nuit."
                            },
                            {
                                "example_id": "f24962e6-4c43-4b63-92c0-5552749b4e2a",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Il racontait ses amours de passage avec des femmes noires et des femmes jaunes, des bombances qui duraient des semaines, et se terminaient par des sommeils de quarante-huit heures, au creux des buissons, dans des pays étranges"
                            },
                            {
                                "example_id": "15d9a4ac-70aa-4d19-87e2-2b0a2dbfccf3",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Le contrat jouait depuis deux mois, et l’argent, s’il en restait au bout du semestre, paierait des bombances, des filets à papillons, une nasse à goujons…"
                            },
                            {
                                "example_id": "bb3c13da-2512-43b6-b246-3c3f92719b7f",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Convenons-en, les exemples de bombance qui lui sont ici donnés ne sont pas faits pour lui inspirer des idées de modération."
                            },
                            {
                                "example_id": "9833d17c-c21a-44dd-aac6-0ba21b980786",
                                "sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                                "text": "Il y eut, chez les plus fortunés de ses amis, le festin, le balthazar, la ripaille, la ribote, la bombance, la grande bouffe avec, en point d'orgue, une langouste sauce thermidor à se lécher tous les doigts de la main."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f880ecf5-59c1-4aab-9ed9-5d21c2b3ad06",
                        "source_entry_id": "d0acdade-0196-3054-a5b5-b7d450700171",
                        "source_sense_id": "1911ac4e-d44d-3ce2-a6ff-d7d15e157517",
                        "target_lang_word": "feast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A holiday, festival, especially a religious one"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2877a9f-ed1b-43f7-ba49-220865df89b6",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "The seventh day shall be a feast to the Lord."
                                            },
                                            {
                                                "example_id": "0b05dcf1-561f-4e23-814c-425be5303c4b",
                                                "sense_id": "d4499a9e-6638-3f42-8810-0f76c6c16aa6",
                                                "text": "Now his parents went to Jerusalem every year at the feast of the passover."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "A very large meal, often of a ceremonial nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ec09425-9087-4fd9-9eff-1b89f3f49d20",
                                                "sense_id": "5ae85136-2876-32b0-96f1-7abb30dfbc3a",
                                                "text": "We had a feast to celebrate the harvest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                        "entry_id": "04753c9f-92ca-3e48-8427-b321ccd14482",
                                        "glosses": [
                                            "Something delightful"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bebc70b9-6ff3-4843-917f-18e7ec695d06",
                                                "sense_id": "b9863f69-0d43-3c03-97b2-d78f2675a438",
                                                "text": "It was a feast for the eyes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To partake in a feast, or large meal."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b748fbd4-6ebe-45dd-b8e4-b3599661b0ab",
                                                "sense_id": "1f457f9d-fbda-3daf-90a9-7f8ce13fc79e",
                                                "text": "I feasted on turkey and dumplings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To dwell upon (something) with delight."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d4fa5d-1560-488e-986a-1f1561493273",
                                                "sense_id": "7161a144-b64c-3114-8b4d-510e0403bce6",
                                                "text": "With my love's picture then my eye doth feast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To hold a feast in honor of (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59c9db80-1d4d-4c6c-8e7e-1076bc731421",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "He that shall see this day, and live old age,\nWill yearly on the vigil feast his neighbors\nAnd say “Tomorrow is Saint Crispian.”"
                                            },
                                            {
                                                "example_id": "0a8e348b-1309-44d1-847f-d2a516e7031e",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "His ancestor, he said, had been feasted there, when he went forward with the then Lord Ravenswood to the fatal battle of Flodden, in which they both fell."
                                            },
                                            {
                                                "example_id": "d7f69121-5aac-4c4d-a817-34343b80a094",
                                                "sense_id": "b090fe59-d756-35fb-bcec-4bd44bd0c4e6",
                                                "text": "We feasted them after the victory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                        "entry_id": "4b89ca0f-a952-34a1-8fcf-e891b4347b48",
                                        "glosses": [
                                            "To serve as a feast for; to feed sumptuously."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e454e0d-b62d-4ee5-95fb-e24067140212",
                                                "sense_id": "15ef318b-4929-31d9-8364-59810c446f91",
                                                "text": "1597–1598, Joseph Hall, Virgidemiarum\nOr once a week, perhaps, for novelty / Reez'd bacon-soords shall feast his family."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
