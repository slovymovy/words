                "senses": [
                    {
                        "sense_id": "e96ac0f4-72c3-32ff-a882-94a9c1d709c7",
                        "entry_id": "fa564b76-4dfa-3a25-aeed-a66c92c9c881",
                        "glosses": [
                            "Éclairer par l’arrière, par rétroéclairage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c3b70e-1e12-462e-b76f-99d7947767f4",
                                "sense_id": "e96ac0f4-72c3-32ff-a882-94a9c1d709c7",
                                "text": "Bien qu’il ne soit que LCD LED, ce téléviseur a tout pour plaire. Il faut ajouter sa fonction Ambilight qui rétroéclaire l’écran sur trois côtés."
                            },
                            {
                                "example_id": "6364928c-5000-43fe-b8f4-3130f778c2c8",
                                "sense_id": "e96ac0f4-72c3-32ff-a882-94a9c1d709c7",
                                "text": "Ou peut-on rétroéclairer sa GBA?"
                            },
                            {
                                "example_id": "837231fe-ce8f-4600-bc37-011e586a0bda",
                                "sense_id": "e96ac0f4-72c3-32ff-a882-94a9c1d709c7",
                                "text": "Ce message concerne le kit afterburner pour rétroéclairer une GBA."
                            },
                            {
                                "example_id": "c09a03b4-6ec2-419d-8db6-ecc30ea672e2",
                                "sense_id": "e96ac0f4-72c3-32ff-a882-94a9c1d709c7",
                                "text": "Il a ensuite voulu projeter des animations sur les murs, décorer la voiture, rétroéclairer le sapin du jardin, ou je ne sais plus quoi et ça commençait à me faire chier."
                            }
                        ]
                    }
                ],
