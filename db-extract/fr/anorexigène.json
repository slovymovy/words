                                        "entry_id": "2937c038-d712-3342-9444-716c29e5826c",
                                        "glosses": [
                                            "Characterised by a lack of appetite, especially as suffering from anorexia nervosa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475b3a5f-05bb-4ee2-9947-61e2802b483e",
                                                "sense_id": "928ba21b-7919-3719-b37b-7f66775b1ea6",
                                                "text": "[…]cultural historians would trace the impact of the drug across a wide spectrum of popular culture, from the Mods of Britain to the new anorectic chic of the fashion world as exemplified by models like Twiggy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f47c422-c231-3e8e-9723-c15ee85bf3d2",
