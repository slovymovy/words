                "senses": [
                    {
                        "sense_id": "89577fbf-e38e-3799-8a61-5c4a02597151",
                        "entry_id": "05f70355-4a33-31d8-95b8-a0c6d0fa32fe",
                        "glosses": [
                            "aus einer klebrigen, breiigen Masse bestehend"
                        ],
                        "tags": [
                            "Austrian German",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "75df2161-8782-48c9-861e-1e6ae1033f02",
                                "sense_id": "89577fbf-e38e-3799-8a61-5c4a02597151",
                                "text": "Meine Lieblingsnachspeise in meinem Stammlokal ist der batzige Schokobatz aus Vollmilchschokolade mit Mandelwaffel und Vanille-Birnen."
                            },
                            {
                                "example_id": "0d24d5e5-8c72-4aec-95b5-0f5d57393e15",
                                "sense_id": "89577fbf-e38e-3799-8a61-5c4a02597151",
                                "text": "Seit es so stark geregnet hat, ist der Weg hinterm Haus total batzig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
