                        "cross_references": [
                            {
                                "target_word": "stabiliteit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f8591cde-97ea-3443-926c-7033e309dee5",
                                        "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                                        "glosses": [
                                            "een situatie waarin zonder verstoring geen verandering zal plaatsvinden. Dit kan zowel een maatschappelijke, psychologische alsook een natuur- of scheikundige betekenis hebben (dit is de definitie van statisch)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66799c65-5cb3-4295-b8ab-be1da6ea2725",
                                                "sense_id": "f8591cde-97ea-3443-926c-7033e309dee5",
                                                "text": "Ze beargumenteren op basis van hun onderzoeken onder meer dat je voor economische groei in een land vaak politieke stabiliteit nodig hebt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6273d07-36ea-3267-964c-9620c9c21325",
                                        "entry_id": "caff157f-a5c1-384a-bf17-1caabc3d6994",
                                        "glosses": [
                                            "het vermogen van een dynamisch systeem om in de gewenste evenwichtsstand terug te komen na een verstoring"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc86bcb-70c7-438c-9048-f9c9553e18a6",
                                                "sense_id": "e6273d07-36ea-3267-964c-9620c9c21325",
                                                "text": "in een stabiel systeem kunnen grote veranderingen plaats vinden(!), de stabiliteit zegt alleen iets over de resistentie tegen ongewenste verstoringen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7386fe6f-4896-434d-acec-be67fdfa677a",
                        "source_entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                        "source_sense_description": "inactivity",
                        "target_lang_word": "Stillstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stillstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                        "entry_id": "9913e17d-7615-3bfe-90c5-4955e09f0210",
                                        "glosses": [
                                            "Ende einer Bewegung, eines Prozesses/Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433cdc29-43da-4cb3-a4bc-107919c75c3c",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "Wegen der Schäden an den Anlagen kam es zu einem Stillstand der Produktion."
                                            },
                                            {
                                                "example_id": "1de5832f-5f64-4224-9d30-72c793204b19",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Tatsächlich war der Zug schon nach wenigen hundert Metern wieder zum Stillstand gekommen, so daß die Frau ihr Buch hatte sinken lassen.“"
                                            },
                                            {
                                                "example_id": "1e8af26a-b6a9-46f1-99a8-3b197fca610a",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„In erster Linie hatte er dafür gesorgt, dass die starke Blutung aus dem Oberschenkel des Halbtoten zum Stillstand kam, und dann den gebrochenen rechten Unterarm stabilisiert.“"
                                            },
                                            {
                                                "example_id": "ed97b5cc-73e0-4eed-8c76-24e5f1c153d7",
                                                "sense_id": "9d926c54-937d-397a-aca5-8c88ddfd76c4",
                                                "text": "„Dies schafft auf der einen Seite einen sehr engen gesellschaftlichen Zusammenhang innerhalb einer biraderi-Einheit. Es wirkt aber auf der anderen Seite auch häufig als Blockade und bedingt weitgehenden gesellschaftlichen Stillstand in den ländlichen Regionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "487118b7-c8d1-4d9a-9444-870e0d2efdd1",
                        "source_entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                        "source_sense_description": "inactivity",
                        "target_lang_word": "Statik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Statik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "662c1bf7-bd39-3553-9fc8-e93e4120e649",
                                        "entry_id": "322308c1-16ad-3f94-bbb0-74f59329ad83",
                                        "glosses": [
                                            "Lehre von den Kräften im Gleichgewicht"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73a847bd-2562-43d7-8833-d46fe7003eca",
                                                "sense_id": "662c1bf7-bd39-3553-9fc8-e93e4120e649",
                                                "text": "Nachdem die letzten Probleme mit der Statik geklärt wurden, konnten die Baumaßnahmen abgeschlossen werden."
                                            },
                                            {
                                                "example_id": "b3b48443-efd7-44f6-beae-924675fd946e",
                                                "sense_id": "662c1bf7-bd39-3553-9fc8-e93e4120e649",
                                                "text": "„Dies gilt sowohl für die Probleme der Statik wie der Dynamik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b202601-fd9b-382b-8927-51d015ce0325",
                                        "entry_id": "322308c1-16ad-3f94-bbb0-74f59329ad83",
                                        "glosses": [
                                            "Zustand der Beharrung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "482fcf97-7ac1-4c2b-9528-45baa361a3c9",
                                                "sense_id": "6b202601-fd9b-382b-8927-51d015ce0325",
                                                "text": "„Jeder Ausdruck der Bewegung verschwindet in der Statik der Komposition.“"
                                            },
                                            {
                                                "example_id": "230fe68b-4632-4459-8966-b55881b230ff",
                                                "sense_id": "6b202601-fd9b-382b-8927-51d015ce0325",
                                                "text": "„Von der Decke, dort wo die Rundungen des Gewölbes an ihrem höchsten Punkt einander berührten und die Statik der Konstruktion vollendeten, hing ein schwerer, gußeiserner Leuchter, der ein diffuses, schummriges Licht verbreitete.“"
                                            },
                                            {
                                                "example_id": "434944c3-9613-434f-a829-7bd2753cd28e",
                                                "sense_id": "6b202601-fd9b-382b-8927-51d015ce0325",
                                                "text": "„Außen am Haus sind mehrere Balken zu sehen, die aber eher der Dekoration als der Statik dienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eed7c953-ff8e-3c62-a275-6aab2c1180f7",
                                        "entry_id": "322308c1-16ad-3f94-bbb0-74f59329ad83",
                                        "glosses": [
                                            "Zustand des menschlichen Körpers im Gleichgewicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6498164-86cf-4de4-98c5-f53f7433f7d2",
                                                "sense_id": "eed7c953-ff8e-3c62-a275-6aab2c1180f7",
                                                "text": "„Medizinische Einlagen können den Fuß unterstützen, wenn die Muskulatur die Statik nicht mehr allein kompensieren kann“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90c70155-66c2-4c9d-92f2-6ac9cf6cf22d",
                        "source_entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
