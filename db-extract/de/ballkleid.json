                        "entry_id": "afe21963-dc53-387a-9865-096a75a3400f",
                        "glosses": [
                            "meist festliches und bodenlanges Kleid, das bei einem Ball getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4244a58e-7196-4298-9d34-f1ede6ac131e",
                                "sense_id": "2893e837-04a2-36aa-934a-28bb41932969",
                                "text": "Heute trug sie ihr erstes Ballkleid."
                            },
                            {
                                "example_id": "a466f296-5d17-4ea4-abdb-9ee70d3a9c64",
                                "sense_id": "2893e837-04a2-36aa-934a-28bb41932969",
                                "text": "„Sie trug ein nach der Mode von 1914 gearbeitetes Kleid aus blauem Tüll – das einzige Ballkleid, das sie je besessen und, soviel ich weiß, nur zweimal in ihrem Leben getragen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
