                                        "entry_id": "79584558-b194-3d1e-888f-77cb06c257b5",
                                        "glosses": [
                                            "Nachfolger des Propheten Mohammed, Oberhaupt der moslemischen Gemeinde und weltlicher Herrscher"
                                        ],
                                        "tags": [
                                            "Islam"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33406161-0ba4-4753-900a-8cd764bb1b51",
                                                "sense_id": "3f264c04-ec66-3030-aa39-ded4e155d751",
                                                "text": "Muhammed Metin Kaplan wurde in den Medien als der „Kalif von Köln“ bekannt."
                                            },
                                            {
                                                "example_id": "7179a000-75b6-430e-a5b7-de1075bd60f1",
                                                "sense_id": "3f264c04-ec66-3030-aa39-ded4e155d751",
                                                "text": "„Dies währte unverändert bis zu der Zeit, da Córdoba seine eigenen Kalifen erhielt, die unabhängig von den Bagdader Kalifen waren.“"
                                            },
                                            {
                                                "example_id": "aa3d56cd-d197-41cf-9bc3-e5e6f6b4a174",
                                                "sense_id": "3f264c04-ec66-3030-aa39-ded4e155d751",
                                                "text": "„Indessen verlor Zarathustras Lehre dadurch sehr an Ansehen, und als die mohammedanischen Kalifen im Lande zur Macht kamen, wurde sie fast ganz ausgerottet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "902b4866-1f40-31be-a8de-0a37e33f7646",
                                        "entry_id": "79584558-b194-3d1e-888f-77cb06c257b5",
                                        "glosses": [
                                            "Träger des unter [1] genannten Titels"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc2259a-3a6d-447c-89b7-17b2c3281f6f",
                                                "sense_id": "902b4866-1f40-31be-a8de-0a37e33f7646",
                                                "text": "„Unter dem Kalifen Omar, dem Begründer der arabischen Großmacht, zerstörten die Araber das Perserreich der Sassaniden und setzten sich im östlichen Mittelmeerraum (Syrien, Ägypten) fest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
