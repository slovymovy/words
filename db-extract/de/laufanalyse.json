                "senses": [
                    {
                        "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                        "entry_id": "a2958c49-ee31-341a-9b24-418b3f6b5a8f",
                        "glosses": [
                            "fachlich durchgeführte Untersuchung und Auswertung des Bewegungsablaufs beim Laufen, meistens mit dem Ziel, individuelle Empfehlungen zu geben, etwa zur Wahl passender Laufschuhe oder zur Optimierung der Lauftechnik"
                        ],
                        "tags": [
                            "Laufsport",
                            "Orthopädie"
                        ],
                        "examples": [
                            {
                                "example_id": "ce6903cb-562d-46dc-9bd1-2b90f3da3c3a",
                                "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                                "text": "„Viele Sportgeschäfte bieten auch Laufanalysen an, um Dir bei der Wahl des richtigen Laufschuhs zu helfen.“"
                            },
                            {
                                "example_id": "200dc4e4-ddd4-4d24-ac7a-9359e5d10d01",
                                "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                                "text": "„Im medizinischen Fachhandel wird der Patient von geschultem Personal beraten und vermessen (Fußabdruck oder Laufanalyse).“"
                            },
                            {
                                "example_id": "46d3ac81-43d9-49c3-b2a3-71a1f1d98c1f",
                                "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                                "text": "„Stefano De Icco ist Orthopädietechniker und bietet für Interessierte im Anova Fabrikladen in Zofingen neu einmal pro Monat Laufanalysen sowie Einlageversorgung nach Mass an.“"
                            },
                            {
                                "example_id": "824810d9-6f3a-45bb-9569-0e37a5f2552d",
                                "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                                "text": "„Bei einer Laufanalyse (lat: Pedographie) handelt es sich um ein Verfahren zur Untersuchung des Bewegungsablaufs beim Gehen und Laufen.“"
                            },
                            {
                                "example_id": "cda8a1ca-12e6-4aa0-a116-c08f0bfd0125",
                                "sense_id": "9e02dc38-117b-3860-9c5c-4d09a2fc5758",
                                "text": "„Während Bewegungsablauf bei einer Ganganalyse nur im Gehen ausgewertet wird, findet bei einer Laufanalyse zusätzlich eine Messung der Bewegungsdaten beim Laufen statt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
