                "senses": [
                    {
                        "sense_id": "32a296b9-60ca-3856-a981-394afe2dff29",
                        "entry_id": "c526bb88-ebd0-3a38-baab-93f6ecc2b6c2",
                        "glosses": [
                            "Donner un caractère musicologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f66fa0a-5eda-4fc5-99fa-6c93796afa86",
                                "sense_id": "32a296b9-60ca-3856-a981-394afe2dff29",
                                "text": "Le jazz fut alors « musicologisé », c'est-à-dire détaché de sa réduction à une expression sonore de la « culture afro-américaine » pour être promu au rang de « langage musical » autonome."
                            }
                        ]
                    },
                    {
                        "sense_id": "a07ef41b-c459-3e77-a012-2de8113bcb17",
                        "entry_id": "c526bb88-ebd0-3a38-baab-93f6ecc2b6c2",
                        "glosses": [
                            "Faire de la musicologie."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a4dc18cb-4674-4a50-916e-1604387345c7",
                                "sense_id": "a07ef41b-c459-3e77-a012-2de8113bcb17",
                                "text": "C'est pour ça que c'est fait, pas pour musicologiser entre connaisseurs."
                            },
                            {
                                "example_id": "18f47657-60b4-4e9b-8326-659ecaa34679",
                                "sense_id": "a07ef41b-c459-3e77-a012-2de8113bcb17",
                                "text": "Le critique écrit, l'historien étudie, le musicologue « musicologise » et le jazzman… joue et doit la fermer !"
                            }
                        ]
                    }
