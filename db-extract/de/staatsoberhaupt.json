                        "form": "die Staatsoberhäupter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cdcf6aa3-cb47-3172-af73-1c54b4104ce2",
                        "entry_id": "2d30f24a-3361-3117-94fd-35d0d06f1fba",
                        "glosses": [
                            "Person, die an der Spitze eines Staates steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48bc7d8d-37a2-4188-8bb9-a3898b286146",
                                "sense_id": "cdcf6aa3-cb47-3172-af73-1c54b4104ce2",
                                "text": "„Die Ermittler hätten für ihre Durchsuchung \"mehrere Stunden\" benötigt, wie die Staatsanwaltschaft mitteilte. Sie beschlagnahmten Unterlagen und Computerdateien. Das Staatsoberhaupt sprach zu der Zeit vor dem Deutschen Verkehrsgerichtstag in Goslar.“"
                            },
                            {
                                "example_id": "a539390a-86c5-41cf-9e76-cf5b36c941d8",
                                "sense_id": "cdcf6aa3-cb47-3172-af73-1c54b4104ce2",
                                "text": "„In den folgenden Jahrzehnten ist er das Gesicht Äthiopiens, das vielleicht am weitesten gereiste Staatsoberhaupt der Welt.“"
                            },
                            {
                                "example_id": "fee3755c-7361-4dbe-b2ac-0201930e9d10",
                                "sense_id": "cdcf6aa3-cb47-3172-af73-1c54b4104ce2",
                                "text": "„Die Büros beider Staatsoberhäupter, in Frankreich wie in Deutschland, spiegeln völlig verschiedene Vorstellungen von Macht wieder.“"
                            },
                            {
                                "example_id": "c66e5751-48b5-4322-99b5-db20bf385303",
                                "sense_id": "cdcf6aa3-cb47-3172-af73-1c54b4104ce2",
                                "text": "„Tarja Kaarina Halonen - diese Frau schrieb Geschichte, denn sie wurde das erste weibliche finnische Staatsoberhaupt, die erste finnische Präsidentin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
