                ],
                "senses": [
                    {
                        "sense_id": "dff7fb57-be9b-3ed3-9296-77f0d8a51d5c",
                        "entry_id": "b58e06c6-bbeb-374e-9ba2-0f7b5a005dfd",
                        "glosses": [
                            "Avoir un éclat comme celui du soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1d9dd4-a195-4028-a391-cd19e5f71f46",
                                "sense_id": "dff7fb57-be9b-3ed3-9296-77f0d8a51d5c",
                                "text": "J’ai vu le soleil dur contre les touffes\nFerrailler. — J’ai vu deux fers soleiller,\nDeux fers qui faisaient des parades bouffes ;\nDes merles en noir regardaient briller"
                            }
                        ]
                    },
                    {
                        "sense_id": "582f4ec8-e32c-3dee-92a0-96a4eb290833",
                        "entry_id": "b58e06c6-bbeb-374e-9ba2-0f7b5a005dfd",
                        "glosses": [
                            "Éclairer, éclaircir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f246f98-ffa2-44a8-b20a-0e66d172de31",
                                "sense_id": "582f4ec8-e32c-3dee-92a0-96a4eb290833",
                                "text": "D’autant que, maintenant, fin clair, ça faisait soleiller bien des points obscurs : ça expliquait la bastide fermée et la bouche cousue de Saturnin."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe86c0bb-d8ab-3afa-b286-b9845c60ec3d",
                        "entry_id": "b58e06c6-bbeb-374e-9ba2-0f7b5a005dfd",
                        "glosses": [
                            "Se mettre au soleil, par plaisir."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "2a284e70-ac10-4de1-95fb-dd21851a349e",
                                "sense_id": "fe86c0bb-d8ab-3afa-b286-b9845c60ec3d",
                                "text": "C'est juste une jeune fille (ou femme) qui prend soin d'elle, a le sens de la répartie, s'habille avec élégance et aime se soleiller sur les plages ou les calanques..."
                            },
                            {
                                "example_id": "7aa53bc2-7184-453e-b6c1-93e041c0be1a",
                                "sense_id": "fe86c0bb-d8ab-3afa-b286-b9845c60ec3d",
                                "text": "Et plût au ciel, moi pauvret! plût au ciel, une fois l'an, — que je pusse, à genoux, comme à présent, — me soleiller aux rayons de ton visage, — et surtout que je pusse encore — t'effleurer les doigts d'un baiser tremblant!"
                            }
                        ]
                    }
                ],
