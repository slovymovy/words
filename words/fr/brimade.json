            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2e8be35a-83b3-3227-94b0-053624834ea2",
                    "sense_definition": "Mesure ou traitement injuste, vexatoire et humiliant infligé à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humiliation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé a fini par démissionner après avoir subi des <w>brimades</w> répétées au travail."
                        },
                        {
                            "text": "Les élèves ont été sévèrement sanctionnés pour avoir infligé une telle <w>brimade</w> à leur camarade."
                        }
                    ],
                    "common_phrases": [
                        "subir des brimades"
                    ]
                },
                {
                    "sense_id": "e5916f86-090a-3b15-90f8-7ec164342822",
                    "sense_definition": "Épreuve vexatoire ou humiliante que les anciens imposent aux nouveaux venus, notamment dans une école ou à l'armée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "initiation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les jeunes recrues devaient affronter la traditionnelle <w>brimade</w> dès leur arrivée à la caserne."
                        },
                        {
                            "text": "La direction de l'école a formellement interdit toute <w>brimade</w> lors des cérémonies d'accueil."
                        }
                    ],
                    "synonyms": [
                        "bizutage"
                    ],
                    "common_phrases": [
                        "brimades militaires"
                    ]
                },
                {
                    "sense_id": "e2fc6a56-0b65-3b37-8639-47ddc46dec16",
                    "sense_definition": "Punition infligée à un enfant, consistant généralement en une privation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "punition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour avoir désobéi, le petit garçon s'est vu infliger une <w>brimade</w> par ses parents."
                        },
                        {
                            "text": "Le précepteur refusait d'employer la <w>brimade</w> pour maintenir la discipline dans sa classe."
                        }
                    ],
                    "traits": [
