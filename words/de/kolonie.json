                    "frequency": "Low",
                    "semantic_group_id": "gemeinschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die deutschen Gäste an der Seine bildeten damals eine regelrechte kleine <w>Kolonie</w>."
