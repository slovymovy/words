        "fr-extract.jsonl": [
            {
                "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                "word": "sellette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "73c4e4a4-fb1f-45ce-ab9a-9a042bdcd318",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "sellettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e26139cc-d2bc-368b-8fc3-7cda4d3b17a1",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Petit siège de bois fort bas, sur lequel on obligeait un accusé à s’asseoir quand on l’interrogeait pour le juger, et que les conclusions du ministère public tendaient à une peine afflictive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d38d40cc-2a79-4792-842a-af18f2fd974e",
                                "sense_id": "e26139cc-d2bc-368b-8fc3-7cda4d3b17a1",
                                "text": "Elle se trouvait blessée d’être mise sur la sellette par ce juge, quand elle se proposait d’en pervertir le jugement"
                            },
                            {
                                "example_id": "661e42c6-02ba-464c-becc-6b89930c299b",
                                "sense_id": "e26139cc-d2bc-368b-8fc3-7cda4d3b17a1",
                                "text": "Mettre un accusé sur la sellette ; le tenir longtemps sur la sellette."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5abb2d1-83a5-3cca-a61e-d44369424070",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Petit siège accroché aux barreaux d’une échelle ou soutenu par des cordes sur lequel s’assoient, à défaut d’échafaudage, les ravaleurs et les peintres en bâtiment."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f9b6571d-bbc1-321a-a5b2-1780a4cbd9ff",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Pièce du harnais d’un cheval de trait, en forme de petite selle, qui est placée sur le dos du cheval et qui supporte des courroies auxquelles sont attachés les brancards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1a9803f-e368-4e5f-a5de-bccc330f2ea5",
                                "sense_id": "f9b6571d-bbc1-321a-a5b2-1780a4cbd9ff",
                                "text": "Et ici, avec quel faste les alignait-on, et quelles brides, quelles sellettes, quels caparaçons !"
                            }
                        ]
                    },
                    {
                        "sense_id": "bfa3997e-10ed-3288-b167-51ca652e514d",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Petite selle de sculpteur."
                        ],
                        "tags": [
                            "Sculpture"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "185489a0-bd3e-3226-ae21-b634d719c10b",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Partie des anciennes charrues sur laquelle le timon était appuyé."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1446a6fa-ed3b-326e-863e-f265e841e6ae",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Plateforme sur laquelle vient reposer l’avant d’une semi-remorque accrochée à un tracteur routier."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1f3c159d-f51e-3499-8eae-506d362a588b",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Ensemble siège-harnais du pilote de parapente sur lequel sont fixées les suspentes de la voile, éventuellement d’un parachute de secours ou d’instruments de vol. Il est généralement équipé d’un mousse-bag ou d’un sac gonflable pour l’atterrissage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d1063419-56a1-3c5a-a7cf-60c6752374d1",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Pièce de bois en manière de moise, arrondie par les bouts, qui, accolant l’arbre d’un engin, sert avec deux liens à porter le fauconneau."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4dbfea5f-631a-3317-8241-98d2a96df52c",
                        "entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "glosses": [
                            "Banc haut sur pied, faisant partie du mobilier, ancien comme contemporain, pour exposer (mettre sur la sellette) un objet."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "918931dd-7197-49fb-bee1-9b27a44ba72a",
                        "source_entry_id": "d980e674-d0ba-3283-a6ae-7e4fccaa98fc",
                        "source_sense_id": "f9b6571d-bbc1-321a-a5b2-1780a4cbd9ff",
                        "source_sense_description": "Pièce du harnais d’un cheval de trait, en forme de petite selle, qui est placée sur le dos du cheval",
                        "target_lang_word": "harness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a08af64c-8b06-3243-bfb3-ea71f4b65220",
                                        "entry_id": "67aed6bf-7b8c-3346-8721-25616bd0b977",
                                        "glosses": [
                                            "A restraint or support, especially one consisting of a loop or network of rope or straps, and especially one worn by a working animal such as a horse pulling a carriage or farm implement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dac04d5-2042-3d79-89da-77d19b0e5d3e",
                                        "entry_id": "67aed6bf-7b8c-3346-8721-25616bd0b977",
                                        "glosses": [
                                            "A collection of wires or cables bundled and routed according to their function: a wiring harness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9093ce18-10d5-47ff-82ff-16137b58e415",
                                                "sense_id": "7dac04d5-2042-3d79-89da-77d19b0e5d3e",
                                                "text": "The cars then enter the main lines for further assembly - including the installation of internal electrical harnesses, underfloor equipment, internal panelling, roof equipment, carpets, seats and tables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adc50e8b-571c-3c93-bb02-1fc34149edf5",
                                        "entry_id": "67aed6bf-7b8c-3346-8721-25616bd0b977",
                                        "glosses": [
                                            "The complete dress, especially in a military sense, of a man or a horse; armour in general."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2f28ab-658a-41ee-8c7f-401b6f068f39",
                                                "sense_id": "adc50e8b-571c-3c93-bb02-1fc34149edf5",
                                                "text": "Ring the alarum-bell! Blow, wind! come, wrack!\nAt least we'll die with harness on our back."
                                            },
                                            {
                                                "example_id": "e49b07bb-edb7-4032-9c16-e3bc33144e4d",
                                                "sense_id": "adc50e8b-571c-3c93-bb02-1fc34149edf5",
                                                "text": "Under the sea-girt cliffs the shining ship was readied, laden with coats of mail, swords, and gleaming war harness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dd980d4-f9bc-3d37-b52d-a8b250d2e341",
                                        "entry_id": "67aed6bf-7b8c-3346-8721-25616bd0b977",
                                        "glosses": [
                                            "The part of a loom comprising the heddles, with their means of support and motion, by which the threads of the warp are alternately raised and depressed for the passage of the shuttle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c01b701f-04ba-31c0-8b0b-de7140ff6c68",
                                        "entry_id": "67aed6bf-7b8c-3346-8721-25616bd0b977",
                                        "glosses": [
                                            "Equipment for any kind of labour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "harness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1699e42a-01cd-3834-84cd-69c670702796",
                                        "entry_id": "b5c6c656-8686-3b4e-95ad-c67c4ca534c2",
                                        "glosses": [
                                            "To place a harness on something; to tie up or restrain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc89f728-36f7-4513-9b56-df3c08fb7fa5",
                                                "sense_id": "1699e42a-01cd-3834-84cd-69c670702796",
                                                "text": "They harnessed the horse to the post."
                                            },
                                            {
                                                "example_id": "b64466f8-a00e-4f54-8d2b-b72e77355544",
                                                "sense_id": "1699e42a-01cd-3834-84cd-69c670702796",
                                                "text": "Ancient nomads, wishing to ward off the evening chill and enjoy a meal around a campfire, had to collect wood and then spend time and effort coaxing the heat of friction out from between sticks to kindle a flame. With more settled people, animals were harnessed to capstans or caged in treadmills to turn grist into meal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1eb76f6-28b5-3a16-8fcf-6f631162b182",
                                        "entry_id": "b5c6c656-8686-3b4e-95ad-c67c4ca534c2",
                                        "glosses": [
                                            "To capture, control or put to use."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ed757e-eaa8-4f67-b23c-9e36a698029f",
                                                "sense_id": "e1eb76f6-28b5-3a16-8fcf-6f631162b182",
                                                "text": "Imagine what might happen if it were possible to harness solar energy fully."
                                            },
                                            {
                                                "example_id": "e31d711b-9f04-4b82-93c5-150f610d2b9b",
                                                "sense_id": "e1eb76f6-28b5-3a16-8fcf-6f631162b182",
                                                "text": "Most of the Himalayan rivers have been relatively untouched by dams near their sources. Now the two great Asian powers, India and China, are rushing to harness them as they cut through some of the world's deepest valleys."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c8a5fc8-2655-3bdd-bc2e-d5b73d3afab0",
                                        "entry_id": "b5c6c656-8686-3b4e-95ad-c67c4ca534c2",
                                        "glosses": [
                                            "To equip with armour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
