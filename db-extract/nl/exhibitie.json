                                    {
                                        "sense_id": "0fe66706-f53d-3b3f-b940-dc43081680d5",
                                        "entry_id": "91714de2-51d1-3e84-8899-ec53a58b915c",
                                        "glosses": [
                                            "An instance of exhibiting, or something exhibited."
                                        ],
