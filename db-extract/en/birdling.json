                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Piepmatz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                        "entry_id": "3a005ffd-df47-3683-90ce-2396cd61410f",
                                        "glosses": [
                                            "kleiner Vogel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac0eef2e-d78a-4426-8fd0-d12fd34ed12c",
                                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                                "text": "Dieser Piepmatz frisst am liebsten Sonnenblumenkerne."
                                            },
                                            {
                                                "example_id": "30415c16-5068-4d8b-8abf-467bd971dfec",
                                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                                "text": "„Für einen Moment stellte ich mir vor, wie es wäre, so fixiert zu sein, so fest verschraubt in die eigenen Möglichkeiten wie dieser aufgeschmissene Piepmatz.“"
                                            },
                                            {
                                                "example_id": "16f15559-aab3-4032-b057-4a0cf88d314e",
                                                "sense_id": "efdbebf5-cd92-3679-8219-f7b09ff9a6c4",
                                                "text": "„Ein Piepmatz ist vorbeigeflogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea2efe30-0b15-4f4e-87ed-69768aa45492",
                        "source_entry_id": "c39084bb-d288-33f0-9a51-2cf24df5be5a",
                        "source_sense_id": "c07314e3-336c-3405-bad2-7235495cfb86",
