                    "sense_definition": "Een informele begroeting om iemand hallo te zeggen bij een ontmoeting.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "greeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hoi</w>, hoe gaat het met jou vandaag?",
                            "target_lang_translations": {
                                "ru": "<w>Привет</w>, как у тебя сегодня дела?",
                                "en": "<w>Hi</w>, how are you doing today?",
                                "pl": "<w>Cześć</w>, jak się dzisiaj masz?",
                                "de": "<w>Hallo</w>, wie geht es dir heute?",
                                "fr": "<w>Salut</w>, comment vas-tu aujourd'hui ?",
                                "it": "<w>Ciao</w>, come stai oggi?",
                                "cs": "<w>Ahoj</w>, jak se dnes máš?",
                                "tr": "<w>Selam</w>, bugün nasılsın?",
                                "es": "<w>Hola</w>, ¿cómo estás hoy?",
                                "zh": "<w>嗨</w>，你今天怎么样？"
                            }
                        },
                        {
                            "text": "Toen ik de kamer binnenkwam, zei ik meteen <w>hoi</w> tegen iedereen.",
                            "target_lang_translations": {
                                "ru": "Когда я вошел в комнату, я сразу сказал всем <w>привет</w>.",
                                "en": "When I entered the room, I immediately said <w>hi</w> to everyone.",
                                "pl": "Kiedy wszedłem do pokoju, od razu powiedziałem wszystkim <w>cześć</w>.",
                                "de": "Als ich den Raum betrat, sagte ich sofort <w>hallo</w> zu jedem.",
                                "fr": "Quand je suis entré dans la pièce, j'ai tout de suite dit <w>salut</w> à tout le monde.",
                                "it": "Quando sono entrato nella stanza, ho detto subito <w>ciao</w> a tutti.",
                                "cs": "Když jsem vešel do místnosti, hned jsem všem řekl <w>ahoj</w>.",
                                "tr": "Odaya girdiğimde hemen herkese <w>selam</w> verdim.",
                                "es": "Cuando entré en la habitación, dije <w>hola</w> inmediatamente a todos.",
                                "zh": "我走进房间时，立刻向大家说了声<w>嗨</w>。"
                            }
                        }
                    ],
