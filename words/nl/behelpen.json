            "senses": [
                {
                    "sense_id": "89a1cf26-d2fa-3dc6-b790-b6d4067752ba",
                    "sense_definition": "zich behelpen: zich redden met beperkte of provisorische middelen bij gebrek aan beter",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behelpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de natuurcamping moet je je maar <w>behelpen</w> met eenvoudige middelen.",
                            "target_lang_translations": {
                                "pl": "Na kempingu na łonie natury musisz po prostu <w>radzić sobie</w> za pomocą prostych środków."
                            }
                        },
                        {
                            "text": "Zonder elektriciteit moesten we ons met kaarsen <w>behelpen</w>.",
                            "target_lang_translations": {
                                "pl": "Bez prądu musieliśmy <w>radzić sobie</w> przy pomocy świec."
                            }
                        }
                    ],
                    "synonyms": [
                        "rooien",
                        "behelpen",
                        "redden"
                    ],
                    "common_phrases": [
                        "moeten behelpen",
                        "zich behelpen met"
                    ],
                    "target_lang_definitions": {
                        "pl": "radzić sobie za pomocą ograniczonych lub prowizorycznych środków z braku czegoś lepszego"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "radzić sobie",
                                "target_lang_sense_clarification": "za pomocą prowizorycznych środków"
                            },
                            {
                                "target_lang_word": "zadowolić się",
                                "target_lang_sense_clarification": "czymś gorszym z braku lepszego"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035e4e57-54a2-39c4-8279-529c4b37f54f",
                    "sense_definition": "rondkomen of overleven met minimale middelen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behelpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In tijden van crisis is het een kwestie van hard werken en <w>behelpen</w>.",
                            "target_lang_translations": {
                                "pl": "W czasach kryzysu to kwestia ciężkiej pracy i <w>wiązania końca z końcem</w>."
                            }
                        },
                        {
                            "text": "Zij moesten jarenlang <w>behelpen</w> in dat kleine, tochtige huisje.",
                            "target_lang_translations": {
                                "pl": "Przez lata musieli <w>klepać biedę</w> w tym małym, przewiewnym domku."
                            }
                        }
                    ],
                    "synonyms": [
                        "rondkomen",
                        "behelpen"
                    ],
                    "common_phrases": [
                        "behelpen en aanpassen"
                    ],
                    "target_lang_definitions": {
                        "pl": "wiązać koniec z końcem lub przeżyć przy minimalnych środkach"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wiązać koniec z końcem",
                                "target_lang_sense_clarification": "żyć skromnie przy minimalnych środkach"
                            },
                            {
                                "target_lang_word": "klepać biedę",
                                "target_lang_sense_clarification": "żyć w trudnych warunkach materialnych"
                            }
                        ]
                    }
                }
            ]
        }
    ]
