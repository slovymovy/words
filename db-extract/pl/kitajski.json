                        "translation_id": "a799476a-98d8-4ebe-8804-ea8c83f074c2",
                        "source_entry_id": "9f4971d0-4123-3847-97e5-48ea9ba11a38",
                        "source_sense_id": "9f9e69a9-0984-3200-9a83-ff25afefd3e3",
                        "target_lang_word": "китайский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "китайский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c845cf95-f61c-38dc-8e6f-48651b90f25a",
                                        "entry_id": "b69dede0-17bc-35fd-b3b2-2a75db3b1504",
                                        "glosses": [
                                            "относящийся к Китаю, китайцам или к их языку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5d8be20-44ea-4aaa-873e-f58c8421d10a",
                                                "sense_id": "c845cf95-f61c-38dc-8e6f-48651b90f25a",
                                                "text": "В китайский красный халат был одет барин, с золотыми головастыми змеями, и золотая мурмолка сияла на голове, как солнце."
                                            },
                                            {
                                                "example_id": "5acd0fda-4746-4e1a-9fb2-a79d14d31569",
                                                "sense_id": "c845cf95-f61c-38dc-8e6f-48651b90f25a",
                                                "text": "Китайский чай дает навар бледно-желтый, слабый, но удивительно ароматный; его надо пить без сахара ― сладкий он неприятен."
                                            },
                                            {
                                                "example_id": "fee8dabe-d4df-498a-99b8-9c05e903b688",
                                                "sense_id": "c845cf95-f61c-38dc-8e6f-48651b90f25a",
                                                "text": "На соседних брошенных дачах я нашёл железный фонарь, песочные часы и китайский зонтик."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d37056-bf31-37de-9198-f21056eee45f",
                                        "entry_id": "b69dede0-17bc-35fd-b3b2-2a75db3b1504",
                                        "glosses": [
                                            "лингв., субстантивир. то же, что китайский язык"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97433e1-30b9-45d0-a379-9afd984717af",
                                                "sense_id": "41d37056-bf31-37de-9198-f21056eee45f",
                                                "text": "На китайский переводят только настоящие китайцы, на японский — японцы и т. п."
                                            },
                                            {
                                                "example_id": "9f8e0781-c4e8-44bf-b083-0f85649741cc",
                                                "sense_id": "41d37056-bf31-37de-9198-f21056eee45f",
                                                "text": "Брату не повезло: он был востоковедом, знал в совершенстве японский, китайский, корейский, провёл на дипломатической работе за нашими восточными рубежами лет восемнадцать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a706ddd6-b2ff-379e-a919-57172edee2ff",
                                        "entry_id": "b69dede0-17bc-35fd-b3b2-2a75db3b1504",
                                        "glosses": [
                                            "техн. жарг. : цифры, полученные нестандартной методикой измерения, которая завышает результат"
                                        ],
                                        "tags": [
                                            "о единицах измерения"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31c090b0-f0aa-4385-81c0-0f258262b935",
                                                "sense_id": "a706ddd6-b2ff-379e-a919-57172edee2ff",
                                                "text": "Китайские ватты эпохи перестройки считались по разрушению динамика на третьей секунде (ватт PMPO)."
                                            },
                                            {
                                                "example_id": "8068d0a7-46a1-45be-8fba-c18f705366df",
                                                "sense_id": "a706ddd6-b2ff-379e-a919-57172edee2ff",
                                                "text": "Сварочный инвертор на 250 РЕАЛЬНЫХ, а не китайских ампер в домашнем пользовании совсем не нужен."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
