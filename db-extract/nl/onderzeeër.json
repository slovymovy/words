                "translations": [
                    {
                        "translation_id": "85074ff1-9d92-40d3-9bca-c03d0e8cd417",
                        "source_entry_id": "30b50312-1e04-3d32-b4ac-db71347dcf34",
                        "source_sense_id": "361adf94-64ed-3f23-b968-0dc566da4fc5",
                        "source_sense_description": "een vaartuig dat onder het wateroppervlak kan varen",
                        "target_lang_word": "Unterseeboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterseeboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                        "entry_id": "6989a8cd-5bbf-382e-9c6d-17e0ee28fbf9",
                                        "glosses": [
                                            "ein Schiff, das speziell für Unterwasserfahrten konstruiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4069c282-a70c-4d76-83ba-2217b6578796",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "Die „Nautilus“ ist eines der berühmtesten Unterseeboote."
                                            },
                                            {
                                                "example_id": "edab967b-744c-42fc-8d45-883eb521b16f",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "„Ein Unterseeboot sind wir doch gar nicht. Das hier ist doch bloß ein Tauchboot.“"
                                            },
                                            {
                                                "example_id": "9865f808-bb23-4258-a73d-5c918cd1fd56",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "„Der Kommandant von »Seeadler« ließ seine und unsere Mannschaften antreten, und wir brachten dem siegreichen Unterseeboot drei Hurras aus, die von drüben erwidert wurden.“"
                                            },
                                            {
                                                "example_id": "b64926dd-1034-45a5-94da-3e49b4360613",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "„Sie war einundsechzig Meter lang, verhältnismäßig breit und klobig, einzig und allein zur Abwehr von Unterseebooten gebaut und eigentlich nur ein Ponton für Wasserbomben, Prototyp einer Schiffsklasse, die fortan rasch und billig hergestellt werden konnte, um dem dringenden Bedarf für den Geleitschutz zu genügen.“"
                                            },
                                            {
                                                "example_id": "fa876aa0-ddf8-4555-a410-4fe7dace00a0",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "„Das Prestige zur See, das Tirpitz vor dem Krieg im Wettrüsten mit Großbritannien um den Bau einer Schlachtflotte gesucht hatte, wurde nunmehr von der »Macht, Würde, Herrschaft und Kraft« der deutschen Unterseeboote eingefahren.“"
                                            },
                                            {
                                                "example_id": "50f2bce1-ebc2-4f90-96e0-a421f5a4e261",
                                                "sense_id": "168928e4-c7ff-3503-9352-94ef9be9e5ac",
                                                "text": "„Der kleine Buckel hatte stets in Rathenow bei einer optischen Fabrik gearbeitet und war erst vor kurzem nach Berlin geholt worden, um als Spezialist in einer Fabrik zu arbeiten, die irgendwelches Gerät für Unterseeboote herstellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4dd0903d-7242-422d-b414-b78695a209ca",
                        "source_entry_id": "30b50312-1e04-3d32-b4ac-db71347dcf34",
                        "source_sense_id": "361adf94-64ed-3f23-b968-0dc566da4fc5",
