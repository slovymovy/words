                        "examples": [
                            {
                                "example_id": "7a68ffb7-679a-40b9-b574-0ac2de429a5c",
                                "sense_id": "d473e394-5b32-3830-9226-a2df3b862457",
                                "text": "L’Amour et l’Hymenée y réuniroient des amans de toutes les nations, des Tartares et des Mexicaines, des Siamois et des Laponnes, des Russes et des Algonkines, des Persans et des Moresques, des Kamtschadales et des Géorgiennes."
                            },
                            {
                                "example_id": "30776ee0-b852-47fe-af47-c22532622244",
                                "sense_id": "d473e394-5b32-3830-9226-a2df3b862457",
                                "text": "Kateri Tekakouita, la muse de Chateaubriand.\nElle naît en 1656 d’une Algonkine chrétienne et d’un Agnier païen. En 1653, sa mère, élevée par des colons de Trois-Rivières, a été capturée et choisie par un Agnier après avoir été proposée préalablement pour être mangée."
                            }
                        ]
                    }
