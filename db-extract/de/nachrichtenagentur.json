                        ]
                    },
                    {
                        "translation_id": "13988985-179e-4665-8393-cae51238dfc6",
                        "source_entry_id": "853769ae-1c2c-3a7e-8e87-5e557e6a593d",
                        "source_sense_id": "b18fc085-e0ea-39b6-83ae-5cc41a3d856d",
                        "source_sense_description": "Unternehmen, das Informationen über aktuelle Ereignisse für Massenmedien sammelt und aufbereitet",
                        "target_lang_word": "persbureau",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "persbureau",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0ad6d709-fab0-3dea-bf14-0ce45c46efab",
                                        "entry_id": "6e8c32eb-cf2a-3205-99fd-15ef393b358d",
                                        "glosses": [
                                            "een instelling die zich toelegt op het vergaren en verspreiden van nieuws"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed843a9-b821-464f-9be4-15e17f2ba386",
                                                "sense_id": "0ad6d709-fab0-3dea-bf14-0ce45c46efab",
                                                "text": "Dat deelde het Tunesische persbureau op gezag van de regering mede."
                                            },
                                            {
                                                "example_id": "7efccb46-039d-47a8-8477-6a2cebfda772",
                                                "sense_id": "0ad6d709-fab0-3dea-bf14-0ce45c46efab",
                                                "text": "Het dodental in Zweden is ook veel hoger dan in naburige Scandinavische landen, die allemaal strengere beperkende maatregelen hebben opgelegd. Volgens gegevens van persbureau AFP is het sterftecijfer in Zweden door het coronavirus veel hoger dan in Noorwegen, Denemarken en Finland, die aan het begin van de pandemie veel strengere coronamaatregelen oplegden."
                                            },
                                            {
                                                "example_id": "59aa6079-3efe-4a40-90e3-67cc53199507",
                                                "sense_id": "0ad6d709-fab0-3dea-bf14-0ce45c46efab",
                                                "text": "Van levensbelang: \"De omvang en reikwijdte van de hittestress is schokkend\", zegt zeebioloog Melanie McEnfield tegen persbureau Reuters. \"Sommige riffen hadden er tot dusver geen last van en wij dachten dat ze veerkrachtig waren, dat ze het gedeeltelijk afsterven te boven zouden komen.\""
                                            }
                                        ]
                                    }
