                },
                {
                    "sense_id": "d664378f-069f-3869-9ce2-8dbd06746e45",
                    "sense_definition": "A traditional German deck of fortune-telling cards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "divination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The reader drew several cards from the <w>Kipper</w> deck to predict upcoming events.",
                            "target_lang_translations": {
                                "ru": "Таролог вытянул несколько карт из колоды <w>Киппер</w>, чтобы предсказать грядущие события."
                            }
                        },
                        {
                            "text": "Unlike tarot, <w>Kipper</w> focuses primarily on everyday human relationships and situations.",
                            "target_lang_translations": {
                                "ru": "В отличие от таро, система <w>Киппер</w> фокусируется в основном на повседневных человеческих отношениях и ситуациях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционная немецкая колода карт для гадания."
                    },
                    "translations": {
