                    {
                        "translation_id": "e57b5d3e-1325-435e-a400-6b187a5d68c1",
                        "source_entry_id": "f61a9730-e621-37e6-88bf-39f5cc61436f",
                        "source_sense_id": "a0cd1ca7-fdcb-3c04-935c-5de360e7fe5e",
                        "target_lang_word": "gabble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To talk fast, idly, foolishly, or without meaning."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1896602d-64f2-4138-8bab-3bb214c579d2",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Does she regard him simply as a workman come to do a job for her, someone whom she need never lay eyes on again; or is she gabbling to hide discomfiture?"
                                            },
                                            {
                                                "example_id": "426aaecd-94c1-4172-9be8-700d848e7b1c",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "I pitied thee, took pains to make thee speak, taught thee each hour one thing or other; when thou didst not, savage, know thine own meaning, but wouldst gabble like a thing most brutish"
                                            },
                                            {
                                                "example_id": "d8791a46-fc9d-4216-b01e-76e23ecbfdc9",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Then he fell to gabbling strange and dreadful things which were not clearly understandable."
                                            },
                                            {
                                                "example_id": "d521c9b1-b1bb-4943-b33a-d398f37e1a57",
                                                "sense_id": "7c3cc94f-4cf6-3052-8019-a30ecc383653",
                                                "text": "Americans are always drinking in crossroads saloons on Sunday afternoon; they bring their kids; they gabble and brawl over brews; everything’s fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                                        "glosses": [
                                            "To utter inarticulate sounds with rapidity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d09dc3-e199-45cf-ac5b-bb6f3982985a",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "gabbling fowls"
                                            },
                                            {
                                                "example_id": "8f335da4-203a-4f54-b901-0a528c2d0f95",
                                                "sense_id": "9f8a9cda-e496-319e-ab33-9182273418ce",
                                                "text": "I not to Cinna’s Ears, nor Varus dare aſpire; / But gabble like a Gooſe; amidſt the Svvan-like Quire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gabble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                        "entry_id": "659780f4-ea63-371c-b488-453cc5b7e325",
                                        "glosses": [
                                            "Confused or unintelligible speech."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4181037-7871-4e15-aa5c-6822f1249e0b",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "a lot of gabble from witnesses"
                                            },
                                            {
                                                "example_id": "512c6c79-b33a-411f-b629-6ad242da0f58",
                                                "sense_id": "147245cc-db8c-3fc7-9dee-db250c841fba",
                                                "text": "[T]he driver was delayed there by a skimpy little woman with a thin piping voice practised in the art of defeating escape from it by a ceaseless stream of gabble."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30149677-98fb-440b-944b-5183d6694762",
                        "source_entry_id": "f61a9730-e621-37e6-88bf-39f5cc61436f",
                        "source_sense_id": "a0cd1ca7-fdcb-3c04-935c-5de360e7fe5e",
                        "target_lang_word": "babble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter words indistinctly or unintelligibly; to utter inarticulate sounds"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a193d31e-8efa-4fef-b088-a258199d6910",
                                                "sense_id": "c5a81e53-403e-3305-abfe-8ef0b443f8c7",
                                                "text": "The men were babbling, so we couldn't make sense of anything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47b9baa-2f0e-332e-92e4-4a4dc73976cd",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk incoherently; to utter meaningless words."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To talk too much; to chatter; to prattle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25302be4-f21e-448d-a686-f6e33590dbcb",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "She babbled on for hours about the importance of some new gadget."
                                            },
                                            {
                                                "example_id": "c8e906d2-9612-4a7a-b541-b3608e07629f",
                                                "sense_id": "c79109fb-d661-3c00-9758-f4a8acf17678",
                                                "text": "Radical rather than rhetorical, babble like an oracle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To make a continuous murmuring noise, like shallow water running over stones."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "329cdd9c-4482-4788-833f-570a45693ce7",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "Hounds are said to babble, or to be babbling, when they are too noisy after having found a good scent."
                                            },
                                            {
                                                "example_id": "a9fdb455-748e-461e-88b2-0676886465f9",
                                                "sense_id": "dc4cf23d-6dbc-36b3-8685-1937c22652f0",
                                                "text": "In every babbling brook he finds a friend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To utter in an indistinct or incoherent way; to repeat words or sounds in a childish way without understanding."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf1951c7-9d45-4f30-811c-032d04ed985c",
                                                "sense_id": "36e3e448-085d-35bd-b189-d49c136d3bd5",
                                                "text": "All this vvhile John had conn'd over ſuch a Catalogue of hard VVords, as vvere enough to conjure up the Devil; theſe he uſed to babble indifferently in all Companies, eſpecially at Coffee-houſes; ſo that his Neighbour Tradeſmen began to ſhun his Company as a Man that vvas crack'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d682684-06b9-39d9-b933-f540bdd3f16a",
                                        "entry_id": "3180c382-7cf2-3711-a8c7-32070c869f42",
                                        "glosses": [
                                            "To reveal; to give away (a secret)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "babble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Idle talk; senseless prattle"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2b5a6f7-cffb-4834-b40d-3f24b49b9454",
                                                "sense_id": "a4e7c6fe-8c46-3897-88d0-854c232a0cdd",
                                                "text": "This is mere moral babble.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "Inarticulate speech; constant or confused murmur."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e3dd33-3e95-4d1a-b387-ddd5aa6b48e5",
                                                "sense_id": "685a07fb-8dd3-3d37-af34-bf10357e5881",
                                                "text": "[M]an has an instinctive tendency to speak, as we see in the babble of our young children; whilst no child has an instinctive tendency to brew, bake, or write."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                        "entry_id": "055b559f-e87f-31e6-a26a-c4c94325685e",
                                        "glosses": [
                                            "A sound like that of water gently flowing around obstructions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b847d-9dc8-449f-b931-734ac7599a1a",
                                                "sense_id": "4e422815-780f-3380-9203-3775f65a99cc",
                                                "text": "[T]he babble of the stream / Fell, and without the steady glare / Shrank the sick olive sere and small."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
