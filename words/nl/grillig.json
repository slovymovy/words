                            {
                                "target_lang_word": "capricious",
                                "target_lang_sense_clarification": "impulsive and unpredictable"
                            },
                            {
                                "target_lang_word": "fickle",
                                "target_lang_sense_clarification": "changing frequently, especially as regards one's loyalties or interests"
                            },
                            {
                                "target_lang_word": "erratic",
