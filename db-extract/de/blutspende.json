                                        "glosses": [
                                            "Don d’une partie du sang en vue de l’élaboration de produits sanguins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8516b700-c31a-4c58-9e58-2f63bf959fd1",
                                                "sense_id": "ccb4ab41-2686-3543-9b46-309d2b5b742a",
                                                "text": "Des blessés qui ont perdu beaucoup de sang peuvent être sauvés grâce au don du sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f96285f7-13bf-3719-9294-15d8a7311404",
                                        "entry_id": "9cc20afa-f1ae-3b09-9a4c-c12200b4efaa",
                                        "glosses": [
                                            "(surtout à l’oral) Collecte organisée pour permettre aux gens de donner leur sang plus près de chez eux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f89092f-a1b3-4b43-93e3-3aa0575afeff",
                                                "sense_id": "f96285f7-13bf-3719-9294-15d8a7311404",
                                                "text": "Participerez-vous au don du sang qui aura lieu mercredi à la salle des fêtes ?"
                                            },
                                            {
                                                "example_id": "49f1eb12-4ede-40d5-a508-358bd7f1d1a9",
                                                "sense_id": "f96285f7-13bf-3719-9294-15d8a7311404",
                                                "text": "M. Nanien est absent : il est allé au don du sang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbd2eed3-cb9e-361e-bd95-02c3cf274877",
                                        "entry_id": "9cc20afa-f1ae-3b09-9a4c-c12200b4efaa",
                                        "glosses": [
                                            "Expression que l’on employait pour signifier le devoir qu’avaient autrefois les hommes de participer aux guerres et donc, de verser leur sang pour leur pays ou leur contrée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdf9441-76b1-3e18-bdba-8d82ed773090",
                                        "entry_id": "9cc20afa-f1ae-3b09-9a4c-c12200b4efaa",
                                        "glosses": [
                                            "Expression qui signifiait qu’une personne pouvait donner sa vie pour venger la mort d’une autre personne proche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
