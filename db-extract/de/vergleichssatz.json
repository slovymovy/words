                "senses": [
                    {
                        "sense_id": "1822edb3-3333-3879-a432-c31a5f0d4ac9",
                        "entry_id": "d9f9f295-eb84-3cf9-85b2-997e959d5db9",
                        "glosses": [
                            "untergeordnete Teilsatz, Adverbialsatz, der einen Vergleich zu dem, was im übergeordneten Teilsatz ausgedrückt wird, herstellt und häufig durch als oder wie eingeleitet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c526a84f-93ce-4476-bf0b-64d9afbea9ff",
                                "sense_id": "1822edb3-3333-3879-a432-c31a5f0d4ac9",
                                "text": "In dem Satz: „Er wurde empfangen, wie wenn ein verlorener Sohn nach langer Abwesenheit wieder in den Schoß der Familie zurückkehrt“ ist „wie wenn ein verlorener Sohn nach langer Abwesenheit wieder in den Schoß der Familie zurückkehrt“ ein Vergleichssatz und „Er wurde empfangen“ der übergeordnete Teilsatz (Matrixsatz/Trägersatz)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
