{
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "857805cd-8dfc-37dc-84c9-c612b2dbedbc",
                    "sense_definition": "A device that controls the flow of liquid from a pipe or container.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "plumbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She turned the <w>faucet</w> to wash her hands.",
                            "target_lang_translations": {
                                "cs": "Otočila <w>kohoutkem</w>, aby si umyla ruce."
                            }
                        },
                        {
                            "text": "The <w>faucet</w> is leaking and needs to be fixed.",
                            "target_lang_translations": {
                                "cs": "<w>Kohoutek</w> kape a potřebuje opravit."
                            }
                        }
                    ],
                    "synonyms": [
                        "tap",
                        "spigot"
                    ],
                    "common_phrases": [
                        "leaky faucet",
                        "turn on the faucet"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zařízení, které ovládá průtok kapaliny z potrubí nebo nádoby."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kohoutek",
                                "target_lang_sense_clarification": "běžné označení pro vodovodní ventil v domácnosti"
                            },
                            {
                                "target_lang_word": "kohout",
                                "target_lang_sense_clarification": "techničtější nebo obecnější označení pro uzávěr potrubí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9a000d1-27d5-3064-af50-f9e24eebf8c3",
                    "sense_definition": "A tube inserted into a barrel to allow liquid to be drawn out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plumbing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brewer inserted a wooden <w>faucet</w> into the barrel to serve the ale.",
                            "target_lang_translations": {
                                "cs": "Sládek vrazil do sudu dřevěnou <w>pípu</w>, aby mohl čepovat pivo."
                            }
                        },
                        {
                            "text": "He carefully tapped the barrel with a metal <w>faucet</w>.",
                            "target_lang_translations": {
                                "cs": "Opatrně narazil sud kovovou <w>pípou</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "spigot"
                    ],
                    "target_lang_definitions": {
                        "cs": "Trubice vložená do sudu, která umožňuje vypouštění tekutiny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pípa",
                                "target_lang_sense_clarification": "zařízení pro čepování nápojů ze sudu"
                            },
                            {
                                "target_lang_word": "kohout",
                                "target_lang_sense_clarification": "obecný název pro ventil nebo uzávěr"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "190aa4d9-fb4b-3e72-b971-9b6a5b965c97",
                    "sense_definition": "A mechanism in a game that introduces new currency into the economy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The game developers added a new <w>faucet</w> to help new players earn gold.",
                            "target_lang_translations": {
                                "cs": "Vývojáři hry přidali nový <w>zdroj</w> měny, aby pomohli novým hráčům získat zlato."
                            }
                        },
                        {
                            "text": "Excessive currency <w>faucets</w> can lead to rapid inflation in the game world.",
                            "target_lang_translations": {
                                "cs": "Nadměrné <w>zdroje</w> měny mohou vést k rychlé inflaci v herním světě."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mechanismus ve hře, který zavádí novou měnu do ekonomiky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zdroj",
                                "target_lang_sense_clarification": "obecný termín pro místo, odkud něco přitéká"
                            },
                            {
                                "target_lang_word": "generátor",
                                "target_lang_sense_clarification": "v herním kontextu označuje systém vytvářející herní prostředky"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}