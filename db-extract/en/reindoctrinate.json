                        "glosses": [
                            "To indoctrinate again."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "958c0c9c-3f1c-4b0b-b9d0-abd10dcfbbe2",
                                "sense_id": "3881573c-5ac0-3343-b23e-f5e509cf6aa9",
                                "text": "Reindoctrinate these men in the use of personal protective devices on the assumption that the temporary elevation of hearing level above the monitor limit may have been due to imperfect protection."
                            },
                            {
                                "example_id": "c8a13534-b991-4c7a-ad24-8e611a2a631a",
                                "sense_id": "3881573c-5ac0-3343-b23e-f5e509cf6aa9",
                                "text": "Counseling should help clients to confront their value systems and reindoctrinate themselves with different values, beliefs, and ideas."
                            },
                            {
                                "example_id": "7105ae93-29db-4725-a081-3e8042021732",
                                "sense_id": "3881573c-5ac0-3343-b23e-f5e509cf6aa9",
                                "text": "She wanted to reindoctrinate me and get me back on the right path, to again become the American I should have been all along."
                            }
                        ]
                    }
