{
    "word_family": [
        "ephemera",
        "ephemerality",
        "ephemerally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4037e01d-ebb3-3aa1-a01a-32e3c528fb9f",
                    "sense_definition": "Lasting for a very short period of time.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fame in the digital age is often an <w>ephemeral</w> phenomenon that disappears quickly.",
                            "target_lang_translations": {
                                "tr": "Dijital çağda şöhret, genellikle hızla yok olan <w>geçici</w> bir fenomendir."
                            }
                        },
                        {
                            "text": "They enjoyed an <w>ephemeral</w> moment of fame before everyone forgot about them.",
                            "target_lang_translations": {
                                "tr": "Herkes onları unutmadan önce <w>kısa ömürlü</w> bir şöhret anının tadını çıkardılar."
                            }
                        }
                    ],
                    "synonyms": [
                        "fleeting",
                        "transient",
                        "short-lived",
                        "momentary",
                        "temporary",
                        "brief"
                    ],
                    "antonyms": [
                        "permanent",
                        "eternal",
                        "lasting",
                        "perennial"
                    ],
                    "common_phrases": [
                        "ephemeral pleasure",
                        "ephemeral nature",
                        "ephemeral popularity",
                        "ephemeral beauty"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok kısa bir süre devam eden, geçici olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçici",
                                "target_lang_sense_clarification": "sürekli olmayan, kısa süreli"
                            },
                            {
                                "target_lang_word": "kısa ömürlü",
                                "target_lang_sense_clarification": "varlığı kısa süren"
                            },
                            {
                                "target_lang_word": "fani",
                                "target_lang_sense_clarification": "kalıcı olmayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e94dee0-b58e-3e5c-bcba-9e07d44a46a2",
                    "sense_definition": "Living, blooming, or existing for only one day or a very short cycle, as certain insects or plants.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The desert spring is famous for its <w>ephemeral</w> flowers that bloom for just one afternoon.",
                            "target_lang_translations": {
                                "tr": "Çöl baharı, sadece bir öğleden sonra açan <w>kısa ömürlü</w> çiçekleriyle ünlüdür."
                            }
                        },
                        {
                            "text": "Mayflies are <w>ephemeral</w> insects that live as adults for only a single day.",
                            "target_lang_translations": {
                                "tr": "Mayıs sinekleri, ergin olarak yalnızca tek bir gün yaşayan <w>günlük</w> böceklerdir."
                            }
                        }
                    ],
                    "synonyms": [
                        "short-lived",
                        "transitory"
                    ],
                    "antonyms": [
                        "perennial",
                        "persistent"
                    ],
                    "common_phrases": [
                        "ephemeral flowers",
                        "ephemeral plants"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birtakım böcekler veya bitkiler gibi yalnızca bir gün veya çok kısa bir döngü boyunca yaşayan, açan veya var olan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "günlük",
                                "target_lang_sense_clarification": "ömrü bir gün olan"
                            },
                            {
                                "target_lang_word": "kısa ömürlü",
                                "target_lang_sense_clarification": "biyolojik döngüsü kısa olan"
                            },
                            {
                                "target_lang_word": "efemeral",
                                "target_lang_sense_clarification": "biyolojik bağlamda tek günlük"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddb18b25-59e6-3431-aa80-31e831853130",
                    "sense_definition": "Existing or containing water only briefly after rain or heavy precipitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain transformed the dry desert valley into an <w>ephemeral</w> stream.",
                            "target_lang_translations": {
                                "tr": "Şiddetli yağmur, kuru çöl vadisini <w>geçici</w> bir akarsuya dönüştürdü."
                            }
                        },
                        {
                            "text": "Many species rely on an <w>ephemeral</w> lake for breeding during the wet season.",
                            "target_lang_translations": {
                                "tr": "Birçok tür, yağışlı mevsimde üremek için <w>geçici</w> bir göle güvenir."
                            }
                        }
                    ],
                    "synonyms": [
                        "transient",
                        "temporary"
                    ],
                    "antonyms": [
                        "permanent"
                    ],
                    "common_phrases": [
                        "ephemeral stream",
                        "ephemeral lake",
                        "ephemeral river"
                    ],
                    "target_lang_definitions": {
                        "tr": "Yağmur veya yoğun yağış sonrasında yalnızca kısa bir süre var olan veya su barındıran."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçici",
                                "target_lang_sense_clarification": "sürekli akışı/varlığı olmayan su kaynağı"
                            },
                            {
                                "target_lang_word": "mevsimlik",
                                "target_lang_sense_clarification": "yağışa bağlı kısa süreli"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62a6445c-10af-365d-9eff-8a31e5812af8",
                    "sense_definition": "Something that lasts or lives for a very short time.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The butterfly is an <w>ephemeral</w> among insects, living only a few days.",
                            "target_lang_translations": {
                                "tr": "Kelebek, böcekler arasında yalnızca birkaç gün yaşayan <w>kısa ömürlü bir canlıdır</w>."
                            }
                        },
                        {
                            "text": "Fashion trends are mere <w>ephemerals</w> in the grand scope of human culture.",
                            "target_lang_translations": {
                                "tr": "Moda trendleri, insan kültürünün geniş ölçeğinde yalnızca <w>geçici heveslerdir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ephemeron"
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok kısa bir süre yaşayan veya var olan şey."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geçici şey",
                                "target_lang_sense_clarification": "kısa ömürlü varlık veya olgu"
                            },
                            {
                                "target_lang_word": "efemera",
                                "target_lang_sense_clarification": "kısa ömürlü canlı veya nesne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}