                "senses": [
                    {
                        "sense_id": "470f9a10-fe63-3d32-976a-1bdc4d7780ba",
                        "entry_id": "8bc4df17-0d7c-3872-aa5d-821868e67e86",
                        "glosses": [
                            "Faire perdre son caractère dichotomique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "039b71e9-0765-4069-9cac-5c91d1062b78",
                                "sense_id": "470f9a10-fe63-3d32-976a-1bdc4d7780ba",
                                "text": "C’est une façon très concrète de dédichotomiser production/reproduction au nom d’une compréhension beaucoup plus fluide des activités des femmes."
                            },
                            {
                                "example_id": "29478125-1859-4d9d-93a4-3ed676772397",
                                "sense_id": "470f9a10-fe63-3d32-976a-1bdc4d7780ba",
                                "text": "Ce domaine est toutefois abordé à plusieurs reprises comme le rappelle Philippe Braud ; pour certains auteurs, notamment Max Weber, Norbert Elias, Madeleine Grawitz ou Pierre Ansart, il est déjà question de « dédichotomiser » l’émotionnel du rationnel."
                            }
                        ]
                    }
