        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "c268d355-b387-31cd-848b-76355da5c81c",
                "word": "overerven",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "917246c2-73df-3ad2-880c-b10c2d33ed6b",
                        "entry_id": "c268d355-b387-31cd-848b-76355da5c81c",
                        "glosses": [
                            "doorgeven van een erfelijke eigenschap aan het nageslacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4a1eb8-7221-4e82-8006-c2f012feefe1",
                                "sense_id": "917246c2-73df-3ad2-880c-b10c2d33ed6b",
                                "text": "Volgens sommige onderzoekers is rood haar inderdaad op zijn retour. Een aantal dna-experts verwacht dat deze haarkleur over 300 jaar niet meer voorkomt. Het gen voor rood haar is recessief, wat betekent dat je het gen van beide ouders moet overerven om zelf roodharig te zijn. Dat betekent niet dat je beide ouders rood haar moeten hebben; als je het gen slechts van één kant overerft, ben je zelf niet roodharig, maar je kunt de eigenschap wel doorgeven."
                            },
                            {
                                "example_id": "bd7cf303-ce52-4a3b-ba46-9a4d35b64e52",
                                "sense_id": "917246c2-73df-3ad2-880c-b10c2d33ed6b",
                                "text": "Toen Darwin zijn theorie lanceerde, had hij geen enkele empirische verklaring voor het overerven van eigenschappen (er was immers nog niets over genetica bekend). Dus had zijn theorie toen (volgens Fransens opvatting) geen wetenschappelijke status. Zo blijkt maar weer: als de tegenstanders van ID hun kritiek ook toepassen op de evolutietheorie, wordt duidelijk hoe kwetsbaar deze is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dae3aa34-ed2e-4c56-9a7e-022fba88a0f1",
                        "source_entry_id": "c268d355-b387-31cd-848b-76355da5c81c",
                        "source_sense_id": "917246c2-73df-3ad2-880c-b10c2d33ed6b",
                        "source_sense_description": "doorgeven van een erfelijke eigenschap aan het nageslacht",
                        "target_lang_word": "inherit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inherit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe50614-0f69-34b0-a7ba-af673ba3f1bd",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To receive (property, a title, etc.), by legal succession or bequest after the previous owner's death."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "691a5be5-2e3a-4619-9760-c9e9053d7ab9",
                                                "sense_id": "cfe50614-0f69-34b0-a7ba-af673ba3f1bd",
                                                "text": "After Grandad died, I inherited the house."
                                            },
                                            {
                                                "example_id": "ee47481e-fbfe-4702-91a0-f9fccfd03ea3",
                                                "sense_id": "cfe50614-0f69-34b0-a7ba-af673ba3f1bd",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761a67c5-b396-3819-9105-638bb7f1f174",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To receive (property, a title, etc.), by legal succession or bequest after the previous owner's death.",
                                            "To come into an inheritance."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857c93ce-0f2a-4091-a04a-c8f704f2405d",
                                                "sense_id": "761a67c5-b396-3819-9105-638bb7f1f174",
                                                "text": "Lucky old Daniel – his grandfather died rich, and he's inherited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d5faf5-3e09-3e32-b048-532859c21198",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To take possession of as a right (especially in Biblical translations)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10abac10-d83e-4c40-ab15-26073edbbca2",
                                                "sense_id": "b6d5faf5-3e09-3e32-b048-532859c21198",
                                                "text": "Your descendants will inherit the earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd3c45a-3c22-33f0-b806-cbbf30ccf57c",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To receive a characteristic from one's ancestors by genetic transmission."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cc90739-c235-4cc7-91bf-e7670bf6727f",
                                                "sense_id": "6fd3c45a-3c22-33f0-b806-cbbf30ccf57c",
                                                "text": "Let's hope the baby inherits his mother's looks and his father's intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e27d1a0a-7057-3ac4-9d7e-0e2b265906c9",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To derive from people or conditions previously in force."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b3b1204-174c-4a10-b2bb-dae84ccb1b7e",
                                                "sense_id": "e27d1a0a-7057-3ac4-9d7e-0e2b265906c9",
                                                "text": "This country has inherited an invidious class culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0ec42ac-5d1d-3fb8-ac68-c3d9269769d8",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To derive (existing functionality) from a superclass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26898a44-d526-4fe1-b229-145fd7945dc5",
                                                "sense_id": "c0ec42ac-5d1d-3fb8-ac68-c3d9269769d8",
                                                "text": "ModalWindow inherits all the properties and methods of Window."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "468dbd2e-50fc-38b7-87fa-2c9b3d8a3e0b",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To derive a new class from (a superclass)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c003c316-bcfb-4731-8d2f-47cf7526ce74",
                                                "sense_id": "468dbd2e-50fc-38b7-87fa-2c9b3d8a3e0b",
                                                "text": "For example, the following two code segments, from different assemblies, show how easy it is to inherit a class from another assembly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c016d9f-efb0-30b4-8f7c-e50e48f2e366",
                                        "entry_id": "fd1b95df-ec61-3813-a590-fa0b02d95587",
                                        "glosses": [
                                            "To put in possession of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c6f7dd-af78-4cac-957f-d35a8da843b6",
                                                "sense_id": "6c016d9f-efb0-30b4-8f7c-e50e48f2e366",
                                                "text": "This, or else nothing, will inherit her"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
