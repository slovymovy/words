                        "examples": [
                            {
                                "example_id": "1d165b36-8af2-4053-ba15-88684c2fbc46",
                                "sense_id": "93b76c9f-45c8-30d7-a78f-2e83dbcdc0a7",
                                "text": "„Der letzte Braunbär Österreichs spazierte 1842 einem Holzknecht vor die Gewehrmündung, der nicht lange wartete und abdrückte.“"
                            },
                            {
                                "example_id": "987b9d8d-dd08-4734-bd34-6df910430977",
                                "sense_id": "93b76c9f-45c8-30d7-a78f-2e83dbcdc0a7",
                                "text": "„Eine Gabel wurde kaum gebraucht, ein Messer hatte jeder Holzknecht in der Tasche.“"
                            }
                        ],
