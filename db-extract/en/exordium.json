{
    "word": "exordium",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
                "word": "exordium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "173fd839-e9da-4f9b-89dd-e3336520ae3f",
                        "entry_id": "70092f31-8e62-3fb0-acda-0b81303637e4",
