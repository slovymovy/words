                ],
                "senses": [
                    {
                        "sense_id": "9046d25f-a14a-3201-a5e3-731f3f62a579",
                        "entry_id": "1ceb042c-ab93-3968-96c5-073ec8021aac",
                        "glosses": [
                            "Anfangsphase des Sommers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9416d87-fd67-482d-9794-5e295aed003d",
                                "sense_id": "9046d25f-a14a-3201-a5e3-731f3f62a579",
                                "text": "„Dieses Ziel wollen die ‚Partner für Gesundheit‘ im Rahmen des Wettbewerbs ‚Mission Olympic‘ erreichen. Die Partner für Gesundheit hatten die entsprechenden Unterlagen im Frühsommer beim Komitee eingereicht.“"
                            },
                            {
                                "example_id": "a9ffa358-9743-45a4-974b-29b225f1e0f7",
                                "sense_id": "9046d25f-a14a-3201-a5e3-731f3f62a579",
                                "text": "„Die mit wenigen Ausnahmen allgemeine Wut über Italiens Kriegserklärung und eine Reihe von erfolgreichen Schlachten deutscher Truppen an der Ostfront sorgten im Frühsommer 1915 für einen Stimmungsumschwung:…“"
                            },
                            {
                                "example_id": "24e579d0-953e-4583-974a-0ea14966081a",
                                "sense_id": "9046d25f-a14a-3201-a5e3-731f3f62a579",
                                "text": "„Die Fertigstellung der Büros erfolgte im Frühsommer 1994, der Endausbau bis Mitte 1994.“"
                            },
                            {
                                "example_id": "8df372af-976f-4d81-9db6-9cb8e1cc763e",
                                "sense_id": "9046d25f-a14a-3201-a5e3-731f3f62a579",
                                "text": "„In Wien war alles größer und aufregender. Frühsommer, Trubel auf den Straßen, Menschen aus dem ganzen Kaiserreich, die Mode der Damen ausgefallener, das Gewand der Herren nobler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
