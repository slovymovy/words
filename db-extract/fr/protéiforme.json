        "fr-extract.jsonl": [
            {
                "entry_id": "1a9cc26a-e7cb-34f9-be73-9642b6590608",
                "word": "protéiforme",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f918388b-7a74-4891-b344-22d0bdb9d694",
                        "entry_id": "1a9cc26a-e7cb-34f9-be73-9642b6590608",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "protéiformes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                        "entry_id": "1a9cc26a-e7cb-34f9-be73-9642b6590608",
                        "glosses": [
                            "Qui est susceptible de prendre les formes les plus différentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "299018d4-3697-4a3a-b8cd-d8c47ecad1e0",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "PROTÉIFORME, adj., proteiformis (proteus, Protée, forma, forme) ; qui change à chaque instant de forme. Ex. Difflugia proteiformis."
                            },
                            {
                                "example_id": "56b0b19e-950e-430d-9bea-4906efb869a4",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "La navigation sur la côte Est du Groenland est considérée à juste titre comme une des plus protéiformes et aléatoires […]"
                            },
                            {
                                "example_id": "2ac1c81c-10be-4585-b4ee-751d264169a7",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "La maladie de Lyme est aujourd'hui connue pour son aspect protéiforme."
                            },
                            {
                                "example_id": "432f93da-9fb4-46b9-98b4-1e6ba4507966",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "Mais qui est et fut toujours parfaitement cohérent devant cette bête protéiforme qu’est la COVID-19 ?\nPersonne. Même pas vous qui me lisez."
                            },
                            {
                                "example_id": "32bba3e7-e502-4724-a615-0433b7c4a6ae",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "Le réel est protéiforme, à la fois obstacle et source d'émerveillement, d'éblouissement, d'ennui."
                            },
                            {
                                "example_id": "c9d952d0-596d-4ec5-b583-3c42be303e99",
                                "sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                                "text": "Faisant un bilan des années 1971-1991 de l’écologie politique, Simon Charbonneau [1991] conclut : « Le mouvement écologique apparaît aujourd’hui comme protéiforme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61228795-8a8f-4e0a-9785-1ad001c27df6",
                        "source_entry_id": "1a9cc26a-e7cb-34f9-be73-9642b6590608",
                        "source_sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                        "target_lang_word": "vielseitig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vielseitig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "mehrere Seiten habend, aus mehreren Teilen bestehend, sodass ein relativ weites Gebiet abgedeckt wird oder eine gewisse Diversität gegeben ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69cc4eb9-1727-4ee6-b1a2-5276dd34642b",
                                                "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                                "text": "Er achtet darauf, sich vielseitig zu ernähren."
                                            },
                                            {
                                                "example_id": "16ef2ab8-e053-4091-8414-0a4e05024e06",
                                                "sense_id": "a31b7f6b-55e3-3431-8c01-237ecf9accc8",
                                                "text": "Sie ist sehr vielseitig: Sie spricht drei Sprachen, betreibt mehrere Sportarten, spielt Geige und interessiert sich für Archäologie und Altertumsforschung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "aus vielen Seiten bestehend"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36821ed5-7033-44a6-b10c-d9c20d4a69f7",
                                                "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                                "text": "Der Stein war zu einem vielseitigen Polyeder geschliffen."
                                            },
                                            {
                                                "example_id": "6069de63-142c-4685-aa3d-5ace38a938ca",
                                                "sense_id": "fe20dddb-04dd-395e-8434-4e7d0c1748f2",
                                                "text": "„Für die vorliegende Arbeit werden daher vielseitige Prismen verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "286cccfe-fba8-3b0e-ba6d-fa5043894d1c",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "mehrere Partnern/alle Beziehungen betreffend; mehrseitig, gegenseitig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be2412f-a1dd-47f0-98d1-38e58ab4ec9b",
                                                "sense_id": "286cccfe-fba8-3b0e-ba6d-fa5043894d1c",
                                                "text": "Sie schlossen ein vielseitiges Abkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                        "entry_id": "79023390-0599-3887-97d4-dd751b0dff53",
                                        "glosses": [
                                            "viele Seiten umfassend"
                                        ],
                                        "tags": [
                                            "von Büchern oder Schriftstücken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170e1590-60f7-4d18-8fe8-638755b16133",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "Das Familienministerium bringt eine vielseitige Broschüre heraus, in der die Unterstützungsmöglichkeiten für junge Mütter ausführlich erläutert werden."
                                            },
                                            {
                                                "example_id": "7fb90f0d-2602-4f29-af6a-9caf045f2b9f",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "Das vielseitige Begleitheft kann nicht geheftet werden. Es muss geklebt werden."
                                            },
                                            {
                                                "example_id": "27f46435-bab2-4a9a-8d75-d5669766734b",
                                                "sense_id": "cf805d53-a50b-32f4-aac9-91863d89a185",
                                                "text": "„Allein nur ihre Abbildungen zu zeigen und ihre Eigenschaften zu beschreiben, würde ein weiteres vielseitiges Buch füllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e6a6f9a-589e-4d00-bece-67d626799fba",
                        "source_entry_id": "1a9cc26a-e7cb-34f9-be73-9642b6590608",
                        "source_sense_id": "fe833510-ff48-3536-a1e9-eb55d2b745a7",
                        "target_lang_word": "protean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
