                "senses": [
                    {
                        "sense_id": "1f00fbaa-a3c3-3def-a510-cf5ccee86301",
                        "entry_id": "8141f2c8-ae7d-3dbc-bdea-c23746ddd9f5",
                        "glosses": [
                            "geographische Region, die Teile von Afghanistan, Pakistan und dem Iran umfasst, in der die meisten Belutschen angesiedelt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c939976-dcac-4fe3-967c-bf0bc3164aa8",
                                "sense_id": "1f00fbaa-a3c3-3def-a510-cf5ccee86301",
                                "text": "Das heutige Belutschistan war damals als Gedrosien bekannt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                        "entry_id": "8141f2c8-ae7d-3dbc-bdea-c23746ddd9f5",
                        "glosses": [
                            "pakistanische Provinz im Südwesten Pakistans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ece1a5f-9b05-43b0-a16d-00a939972880",
                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                "text": "„Während der Westen des Landes (vor allem Belutschistan) durch ein arides Klima geprägt ist, zeichnet sich der übrige Teil durch ein tropisches Klima mit einer Regenzeit in den Sommermonaten und einer Trockenzeit zwischen September und Juni aus.“"
                            },
                            {
                                "example_id": "e13aae6f-f63b-47b8-a364-a2c4dffa8db4",
                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                "text": "„Sie ist erst siebzig Jahre alt, aber ein wahrer Künstler hat sie in seinem Hinterhof gemacht und wollte sie als Beutegut aus Belutschistan verkaufen, als die entlaufene Cousine irgendeines minderen Pharaos, die hier gelandet sei.“"
                            },
                            {
                                "example_id": "a935e248-0826-4e56-a4a1-8ee7817e1e85",
                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                "text": "„Der Pakistani wechselte das Thema und erzählte dem Amerikaner, dass der ISI neue Belege für indische Zahlungen an die Freiheitsbewegung in Belutschistan habe.“"
                            },
                            {
                                "example_id": "486d1667-0802-46ea-a7b3-0e2da84aeb3a",
                                "sense_id": "02d62fd3-75b5-3f35-8d62-0bdaef675c7a",
                                "text": "„Die meisten Taliban waren eng mit Pakistan verbunden, waren dort aufgewachsen und in Madrassas unterrichtet worden, die der sprunghafte Maulana Fazlur Rehman und seine Jamiat-e-Ulema Islam (JUI) leiteten - eine fundamentalistische Partei, die beträchtlich von den Paschtunen in Belutschistan und der Nordwestprovinz unterstützt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
