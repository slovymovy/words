                "senses": [
                    {
                        "sense_id": "547db1f0-c480-3401-ae68-83b5e05640c1",
                        "entry_id": "4ce83af4-5208-371b-97e4-3436f4b0cfb8",
                        "glosses": [
                            "een besloten vereniging alleen voor de allerrijksten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0feac7-abfe-4826-8117-1469f25c0b02",
                                "sense_id": "547db1f0-c480-3401-ae68-83b5e05640c1",
                                "text": "\"Daar snappen wij niks van,\"zegt Melissa Koutouzis, die ook het woord neemt via de megafoon. \"De gemeente wil niet naar de rechter en bewoners luisteren. De gemeente zet zich in om een eliteclub tot stand te brengen.\"Koutouzis wil er duidelijk over zijn: ze is niet tegen hotels of het Soho House. \"Maar wel op deze plek. Culturele vrijhavens verdwijnen en er komen besloten clubs voor in de plaats.\""
                            },
                            {
                                "example_id": "19eadb19-65c3-421d-84ef-539c78c5191d",
                                "sense_id": "547db1f0-c480-3401-ae68-83b5e05640c1",
                                "text": "Poetin, die ook op het congres sprak, had het in zijn toespraak niet over de verkiezingen, maar hij waarschuwde wel dat leden de partij niet moesten beschouwen áls een prestigieuze eliteclub'die kan worden aangewend ten behoeve van de eigen carrière."
                            }
                        ]
                    },
                    {
                        "sense_id": "2657ba10-63e3-317b-88ea-003d7ba5fd9a",
                        "entry_id": "4ce83af4-5208-371b-97e4-3436f4b0cfb8",
                        "glosses": [
                            "een club die behoort tot de groep van de beste en belangrijkste clubs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8f99dc3-9088-459d-b249-edce26a30bd6",
                                "sense_id": "2657ba10-63e3-317b-88ea-003d7ba5fd9a",
                                "text": "De kritiek van de parlementaire commissie richt zich vooral op de eliteclubs in de Premier League."
                            },
                            {
                                "example_id": "8940d716-b8c8-4781-9db8-59e8256a46cd",
                                "sense_id": "2657ba10-63e3-317b-88ea-003d7ba5fd9a",
                                "text": "Maar het mooiste was de winst van de Arolbeker in 1962. Ik kreeg als aanvoerder de beker van Henk Happelhof, de voorzitter van AFC. Dat was toch een eliteclub. Dat betekende veel voor mij."
                            }
                        ]
                    }
