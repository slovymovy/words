                                                "sense_id": "3538d4cf-d094-3671-94eb-00cb4852abe9",
                                                "text": "The engine runs smoothly on diesel."
                                            },
                                            {
                                                "example_id": "8813e7f5-0e82-49a4-89de-3aca3e3e80dd",
                                                "sense_id": "3538d4cf-d094-3671-94eb-00cb4852abe9",
                                                "text": "talk smoothly"
                                            },
                                            {
                                                "example_id": "f54c0c40-de9d-4fc5-b1df-1c4078a82d9b",
                                                "sense_id": "3538d4cf-d094-3671-94eb-00cb4852abe9",
                                                "text": "The plans didn't go/run as smoothly as we'd hoped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db424e2a-1074-429a-9006-9c76e2f47ea4",
                        "source_entry_id": "0869eb67-dc29-380d-81e2-904712cb324e",
