                ],
                "senses": [
                    {
                        "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                        "entry_id": "36b97f93-6292-32f6-a536-d535773e058d",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f49ecd1-d54c-4a07-901e-8aa4f8c20256",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Frau Fensterle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16cae4d6-5e85-4d47-b2ba-a538c19033c5",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Herr Fensterle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a232df30-290d-48bc-8e7a-3ecc7f534de1",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Die Fensterles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "46df73bd-cacc-4da6-b1d8-38749135ee60",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Der Fensterle trägt nie die Pullover, die die Fensterle ihm strickt."
                            },
                            {
                                "example_id": "449d194e-1c31-4867-9611-8bcba8740bad",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fensterle kommt, geht der Herr Fensterle.“"
                            },
                            {
                                "example_id": "00618765-76d3-4855-8b55-4372c931fe01",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Fensterle kommt und geht."
                            },
                            {
                                "example_id": "4e3afd47-90ef-4dd2-90c7-9b267a784c0b",
                                "sense_id": "59e7e21b-2d76-323d-b333-4f3ac8f027dd",
                                "text": "Fensterles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
