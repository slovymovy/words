                    "frequency": "Middle",
                    "semantic_group_id": "espace_et_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une lumière <w>diffuse</w> éclairait doucement la chambre à travers les voilages blancs."
                        },
                        {
                            "text": "Le patient ressentait une douleur <w>diffuse</w> dans tout le bas du dos."
                        }
                    ],
                    "synonyms": [
