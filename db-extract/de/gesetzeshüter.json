                "senses": [
                    {
                        "sense_id": "065b7e12-910c-36cf-9783-8eecf9038e7b",
                        "entry_id": "63e98ed1-f707-31ce-9759-c8dc107c4e18",
                        "glosses": [
                            "Mitarbeiter einer Polizeibehörde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "150fe182-aebe-41cc-8a27-3c565d6b4d0a",
                                "sense_id": "065b7e12-910c-36cf-9783-8eecf9038e7b",
                                "text": "„Doch die Gesetzeshüter bleiben brav auf ihrer Straßenseite.“"
                            },
                            {
                                "example_id": "4efe555a-4803-4c2e-bf7d-6154da5bf30c",
                                "sense_id": "065b7e12-910c-36cf-9783-8eecf9038e7b",
                                "text": "„Er war es gewiß, denn Otto von Corvins übles Machwerk hat auch zur Zeit der Weimarer Republik und zu Beginn des Dritten Reiches wiederholt den Unwillen der Gesetzeshüter hervorgerufen und wurde in den Jahren 1926 und 1934 ganz oder teilweise verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
