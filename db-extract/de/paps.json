                                "example_id": "8c570df5-683a-4c8f-b8b9-eb137244ff41",
                                "sense_id": "61313c06-663e-31ad-acf2-907211c81923",
                                "text": "Mein Paps rasiert sich noch mit dem Messer."
                            },
                            {
