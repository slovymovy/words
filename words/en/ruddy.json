{
    "word_family": [
        "ruddiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bca5f38-c97e-327a-ac78-4f2cc1918b71",
                    "sense_definition": "Having a reddish color, especially referring to skin, fire, or the sky.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold wind left her cheeks <w>ruddy</w> after the long walk home.",
                            "target_lang_translations": {
                                "pl": "Zimny wiatr sprawił, że jej policzki stały się <w>rumiane</w> po długim spacerze do domu."
                            }
                        },
                        {
                            "text": "The horizon glowed with a <w>ruddy</w> light as the sun began to set.",
                            "target_lang_translations": {
                                "pl": "Horyzont jarzył się <w>czerwonawym</w> światłem, gdy słońce zaczęło zachodzić."
                            }
                        }
                    ],
                    "synonyms": [
                        "rosy"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający czerwonawy odcień, odnoszący się zwłaszcza do skóry, ognia lub nieba."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rumiany",
                                "target_lang_sense_clarification": "odnoszący się do cery lub policzków"
                            },
                            {
                                "target_lang_word": "czerwonawy",
                                "target_lang_sense_clarification": "ogólne określenie koloru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0353b7df-488f-3936-bb4b-27d9031a5e77",
                    "sense_definition": "Appearing healthy, strong, and full of energy, often characterized by a red complexion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "health",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer was in <w>ruddy</w> health despite his many years of hard labor.",
                            "target_lang_translations": {
                                "pl": "Stary rolnik cieszył się <w>krzepkim</w> zdrowiem pomimo wielu lat ciężkiej pracy."
                            }
                        },
                        {
                            "text": "He returned from his vacation looking <w>ruddy</w> and full of life.",
                            "target_lang_translations": {
                                "pl": "Wrócił z wakacji wyglądając na <w>zdrowego</w> i pełnego życia."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruddy health"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wyglądający na zdrowego, silnego i pełnego energii, często charakteryzujący się czerwoną cerą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zdrowy",
                                "target_lang_sense_clarification": "w kontekście krzepkiego wyglądu"
                            },
                            {
                                "target_lang_word": "krzepki",
                                "target_lang_sense_clarification": "silny i pełen wigoru"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a191ae51-8cd0-36ba-8e82-449ac09f38e3",
                    "sense_definition": "Used as a mild intensifier to express annoyance or irritation.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of fixing this <w>ruddy</w> machine every single day.",
                            "target_lang_translations": {
                                "pl": "Mam dość naprawiania tej <w>cholernej</w> maszyny każdego dnia."
                            }
                        },
                        {
                            "text": "Why do I have to fill out this <w>ruddy</w> form again?",
                            "target_lang_translations": {
                                "pl": "Dlaczego muszę znowu wypełniać ten <w>przeklęty</w> formularz?"
                            }
                        }
                    ],
                    "synonyms": [
                        "bally",
                        "bleeding",
                        "blimming",
                        "bloody",
                        "blooming"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Używane jako łagodny wzmacniacz w celu wyrażenia irytacji lub zniecierpliwienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cholerny",
                                "target_lang_sense_clarification": "potoczne określenie wyrażające irytację"
                            },
                            {
                                "target_lang_word": "przeklęty",
                                "target_lang_sense_clarification": "używane do podkreślenia negatywnego stosunku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6f693e1a-bd1f-342b-bb8e-8f1cd0a18833",
                    "sense_definition": "Used as a mild intensifier to express annoyance or irritation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are not <w>ruddy</w> going anywhere until you finish your homework.",
                            "target_lang_translations": {
                                "pl": "Nigdzie się <w>cholera</w> nie wybierasz, dopóki nie odrobisz pracy domowej."
                            }
                        },
                        {
                            "text": "That was a <w>ruddy</w> ridiculous thing to say in front of everyone.",
                            "target_lang_translations": {
                                "pl": "To było <w>cholernie</w> niedorzeczne, żeby mówić coś takiego przy wszystkich."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloody"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Używane jako łagodny wzmacniacz w celu wyrażenia irytacji lub zniecierpliwienia."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cholernie",
                                "target_lang_sense_clarification": "przysłówek wzmacniający negatywne emocje"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "444c6edd-8492-3e10-9e07-808ba0d6a4d5",
                    "sense_definition": "To cause something to become reddish in color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evening light <w>ruddied</w> the walls of the old stone house.",
                            "target_lang_translations": {
                                "pl": "Wieczorne światło <w>zaczerwieniło</w> ściany starego kamiennego domu."
                            }
                        },
                        {
                            "text": "The cold winter air <w>ruddied</w> his cheeks as he walked through the park.",
                            "target_lang_translations": {
                                "pl": "Zimne zimowe powietrze <w>zaczerwieniło</w> jego policzki, gdy szedł przez park."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować, że coś staje się czerwonawego koloru."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zaczerwienić",
                                "target_lang_sense_clarification": "nadać czerwonawy odcień"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "db006626-b374-3568-a9c7-2f6f0a3155ca",
                    "sense_definition": "A type of North American diving duck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spotted several <w>ruddies</w> swimming near the edge of the pond.",
                            "target_lang_translations": {
                                "pl": "Zauważyliśmy kilka <w>sterniczek jamajskich</w> pływających przy brzegu stawu."
                            }
                        },
                        {
                            "text": "The <w>ruddies</w> are known for their stiff tails and bright blue bills.",
                            "target_lang_translations": {
                                "pl": "<w>Sterniczki jamajskie</w> są znane ze swoich sztywnych ogonów i jaskrawoniebieskich dziobów."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Gatunek północnoamerykańskiej kaczki nurkującej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "sterniczka jamajska",
                                "target_lang_sense_clarification": "nazwa gatunkowa ptaka"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "197892e6-19ec-3b58-b430-8280685b2af4",
                    "sense_definition": "A small, reddish-brown ground-dwelling dove.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birdwatcher was excited to see two <w>ruddies</w> feeding in the field.",
                            "target_lang_translations": {
                                "pl": "Obserwator ptaków był podekscytowany, widząc dwa <w>gołębie</w> żerujące na polu."
                            }
                        },
                        {
                            "text": "It can be difficult to distinguish <w>ruddies</w> from other similar dove species.",
                            "target_lang_translations": {
                                "pl": "Może być trudno odróżnić te <w>gołębie</w> od innych podobnych gatunków."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mały, czerwonobrązowy gołąb naziemny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gołąb",
                                "target_lang_sense_clarification": "mała, rudobrązowa naziemna gołębica"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7cb3fe07-da15-3379-ac6a-60499d5f90e3",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Ruddy</w> is the new teacher at the local high school.",
                            "target_lang_translations": {
                                "pl": "Pan <w>Ruddy</w> jest nowym nauczycielem w lokalnym liceum."
                            }
                        },
                        {
                            "text": "The research was conducted by a scientist named Dr. <w>Ruddy</w>.",
                            "target_lang_translations": {
                                "pl": "Badania zostały przeprowadzone przez naukowca o nazwisku dr <w>Ruddy</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nazwisko rodowe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Ruddy",
                                "target_lang_sense_clarification": "nazwisko własne"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}