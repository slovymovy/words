                    "sense_definition": "A minor fight or argument.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conflict",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The players got into a bit of a <w>scrap</w> on the field.",
                            "target_lang_translations": {
                                "ru": "Игроки устроили небольшую <w>потасовку</w> на поле.",
                                "zh": "球员们在场上发生了一点小<w>打架</w>。",
                                "pl": "Zawodnicy wdali się w małą <w>bójkę</w> na boisku.",
                                "cs": "Hráči se na hřišti dostali do menší <w>potyčky</w>.",
                                "fr": "Les joueurs ont eu une petite <w>bagarre</w> sur le terrain.",
                                "it": "I giocatori si sono lasciati andare a una piccola <w>zuffa</w> in campo."
                            }
                        },
                        {
                            "text": "He walked away with a black eye after a <w>scrap</w> at the bar.",
                            "target_lang_translations": {
                                "ru": "Он ушел с фингалом после <w>драки</w> в баре.",
                                "zh": "他在酒吧<w>打架</w>后，带着一只黑眼圈离开了。",
                                "pl": "Wyszedł z podbitym okiem po <w>bójce</w> w barze.",
                                "cs": "Odešel s monoklem po <w>rvačce</w> v baru.",
                                "fr": "Il est reparti avec un œil au beurre noir après une <w>bagarre</w> au bar.",
                                "it": "Se n'è andato con un occhio nero dopo una <w>rissa</w> al bar."
