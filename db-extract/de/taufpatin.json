                        "entry_id": "c4279d1f-3356-39eb-899c-b4527e12aa89",
                        "glosses": [
                            "den Täufling bei der Taufe begleitende weibliche Person, die Zeugin bei der Sakramentsspendung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75fd5116-b7c2-49c6-a042-d396a6510015",
                                "sense_id": "c7572b2c-896f-3056-afdc-0925ada7b6f6",
                                "text": "Ich bin die Taufpatin meiner Nichte."
                            },
                            {
                                "example_id": "5a5ff254-66d2-4bfa-a315-6ea23479776b",
                                "sense_id": "c7572b2c-896f-3056-afdc-0925ada7b6f6",
                                "text": "„Von Guste, die er für seine Taufpatin hielt, erbte Janosch die Vorliebe für Gold und Flitter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
