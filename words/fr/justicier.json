                    "frequency": "Middle",
                    "semantic_group_id": "vigilantisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les bandes dessinées, ce héros agit souvent comme un <w>justicier</w> solitaire la nuit."
                        },
                        {
                            "text": "Il refuse d'attendre la police et préfère jouer au <w>justicier</w> dans son quartier."
                        }
                    ],
                    "synonyms": [
