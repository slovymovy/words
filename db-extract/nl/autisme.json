                        "cross_references": [
                            {
                                "target_word": "autism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7335c21b-67f0-317d-8abc-c03bf6b888c1",
                                        "entry_id": "776c1afd-3c3e-3fa5-ad02-28f37d333f2e",
                                        "glosses": [
                                            "A pervasive neurological condition that is observable in early childhood and persists throughout the lifespan, characterised by atypical communication patterns (e.g., differences in body language or eye contact), delayed language development, and sensory processing sensitivities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192b899c-b8e5-46eb-8fa3-d5ae481323c7",
                                                "sense_id": "7335c21b-67f0-317d-8abc-c03bf6b888c1",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6036847-3337-3e7d-84f1-3df3268819a1",
                                        "entry_id": "776c1afd-3c3e-3fa5-ad02-28f37d333f2e",
                                        "glosses": [
                                            "A pervasive neurological condition that is observable in early childhood and persists throughout the lifespan, characterised by atypical communication patterns (e.g., differences in body language or eye contact), delayed language development, and sensory processing sensitivities.",
                                            "Synonym of autism spectrum; a range of disorders."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fad073c-2626-31cf-8bf4-df95845738f2",
                                        "entry_id": "776c1afd-3c3e-3fa5-ad02-28f37d333f2e",
                                        "glosses": [
                                            "A diagnosis involving a pathological tendency to engage in self-centered fantasy thinking, historically considered a symptom of insanity or schizophrenia."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7734e70d-9638-3e21-a897-c67d7e71c664",
                                        "entry_id": "776c1afd-3c3e-3fa5-ad02-28f37d333f2e",
                                        "glosses": [
                                            "Abnormal and unhealthy focus or persistence, stereotypically coupled with low self-awareness and unhealthy hatred of opposition or criticism."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "offensive",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9a55f21-dea9-428a-a67b-2c0e5e19895b",
                                                "sense_id": "7734e70d-9638-3e21-a897-c67d7e71c664",
                                                "text": "weaponized autism"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ae9e333-d820-4c4c-bb07-3be38675d30b",
                        "source_entry_id": "82b46195-5be9-38cc-bb64-d5485e1a56fb",
                        "source_sense_id": "ebbc41ec-198d-3c62-a72a-fe48a4d9dfee",
                        "source_sense_description": "ontwikkelingsstoornis",
                        "target_lang_word": "autisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                        "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                                        "glosses": [
                                            "Trouble, particularité neurologique caractérisée par des difficultés de communication, ainsi que des comportements à caractère restreint et répétitif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f9d1f3e-d728-45f4-9f30-886fe00ff015",
                                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                                "text": "D’où son ambition d’expliquer l’autisme, d’abord à son environnement proche, puis aux recruteurs et à la société tout entière."
                                            },
                                            {
                                                "example_id": "f5741b9b-3172-49cb-9d38-5df8bd9f9fee",
                                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                                "text": "Le soutien et la compréhension de la famille ne sont pas toujours au rendez-vous, au risque de développer de la culpabilité chez les personnes atteintes des troubles du spectre de l’autisme."
                                            },
                                            {
                                                "example_id": "d261d322-1e9b-4d6a-b647-5a3e8cb2639d",
                                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                                "text": "On sait que l’on entre dans le spectre de l’autisme dès lors que l’on repère des particularités communicationnelles et interactionnelles « déficitaires » ainsi que des comportements « à caractère restreint et répétitif »."
                                            },
                                            {
                                                "example_id": "ef7cc608-5b88-44a1-8c98-2a2d8c15dc46",
                                                "sense_id": "bfedd21e-1473-3577-ae2f-fdcf63316441",
                                                "text": "Hans Asperger est connu pour avoir donné son nom au syndrome de l’autisme dit de « haut niveau », sans déficit intellectuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56dff8b9-3d7f-3a85-b508-a27277a7191a",
                                        "entry_id": "32baf623-5828-34f7-9f40-66399a6c35c2",
                                        "glosses": [
                                            "Tout comportement de repli sur soi."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cefc939d-9b1c-4eab-a21a-5aa62e559419",
                                                "sense_id": "56dff8b9-3d7f-3a85-b508-a27277a7191a",
                                                "text": "On l’a enfermé de plus en plus radicalement dans son autisme, dans sa coupure d’avec la réalité, rien n’a été fait pour l’aider à rétablir un lien, un dialogue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
