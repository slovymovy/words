                "senses": [
                    {
                        "sense_id": "9fee6ceb-6c21-3966-9d47-aa9271dd6e94",
                        "entry_id": "a9f9274f-e4bb-372a-9205-2007359918c2",
                        "glosses": [
                            "sehr aggressiv und ohne Nachdenken handelnd, als ob man von Testosteron gesteuert werden würde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75802f13-241b-4fa1-af62-3c1d1b8af04a",
                                "sense_id": "9fee6ceb-6c21-3966-9d47-aa9271dd6e94",
                                "text": "„Wenn aber ein Dutzend testosterongesteuerter Bürstenschnitt-Jungs in Braun ihn mit gezückten Waffen aufforderten, gefälligst an Bord zu bleiben, bis ihn jemand abholen käme - dann wüsste er, dass es aus war.“"
                            }
                        ],
