                "senses": [
                    {
                        "sense_id": "024b2f3a-afdd-3379-b1a0-e840821296f9",
                        "entry_id": "cdc7894a-848b-3d6f-bdb7-57cfb138a598",
                        "glosses": [
                            "Arrondir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd219210-ccae-4093-bbde-5847e411a0ab",
                                "sense_id": "024b2f3a-afdd-3379-b1a0-e840821296f9",
                                "text": "Il le masse avec soin, c'est-à-dire qu'à l'aide du marteau il le réarrondit, en le raffermissant pour lui donner sa forme définitive."
                            },
                            {
                                "example_id": "01d54205-a6d5-40a8-a582-f26bb0c15be4",
                                "sense_id": "024b2f3a-afdd-3379-b1a0-e840821296f9",
                                "text": "Il y a loin de là aux fragments obtenus par secouage qui sont très déformés et mettent deux heures à se réarrondir."
                            }
                        ]
                    }
