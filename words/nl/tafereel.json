    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "047f08dc-6fc8-3e06-9ddf-df0295c55235",
                    "sense_definition": "een gebeurtenis of situatie waarnaar men kijkt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gebeurtenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij zag het <w>tafereel</w> voor zijn ogen gebeuren en wist niet wat hij moest doen.",
                            "target_lang_translations": {
                                "en": "He saw the <w>scene</w> unfold before his eyes and didn't know what to do."
                            }
                        },
                        {
                            "text": "Ik zet een paar stappen terug en laat het <w>tafereel</w> op me inwerken.",
                            "target_lang_translations": {
                                "en": "I take a few steps back and let the <w>scene</w> sink in."
                            }
                        }
                    ],
                    "synonyms": [
                        "scène",
                        "schouwspel",
                        "gebeurtenis"
                    ],
                    "common_phrases": [
                        "het tafereel gadeslaan",
                        "een prachtig tafereel",
                        "het tafereel op me inwerken"
                    ],
                    "target_lang_definitions": {
                        "en": "an event or situation that one observes"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scene",
                                "target_lang_sense_clarification": "a sequence of events or a view of a situation"
                            },
                            {
                                "target_lang_word": "spectacle",
                                "target_lang_sense_clarification": "a visually striking performance or display"
                            },
                            {
                                "target_lang_word": "sight",
                                "target_lang_sense_clarification": "something that is seen or worth seeing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7644404e-7c7c-38cc-90d6-c4b0555e2098",
                    "sense_definition": "een afbeelding of schilderij van een bepaalde situatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afbeelding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze had besloten om deze keer gewoon één <w>tafereel</w> op het doek af te beelden.",
                            "target_lang_translations": {
                                "en": "She had decided to simply depict one <w>scene</w> on the canvas this time."
                            }
                        },
                        {
                            "text": "In het museum hangt een schilderij met een levendig <w>tafereel</w> van een marktplaats.",
                            "target_lang_translations": {
                                "en": "In the museum hangs a painting with a vivid <w>scene</w> of a marketplace."
                            }
                        }
                    ],
                    "synonyms": [
                        "afbeelding",
                        "schilderij",
                        "voorstelling"
                    ],
                    "common_phrases": [
                        "een levendig tafereel",
                        "een tafereel afbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "an image or painting depicting a specific situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scene",
                                "target_lang_sense_clarification": "a depiction of a specific setting or event in art"
                            },
                            {
                                "target_lang_word": "tableau",
                                "target_lang_sense_clarification": "a graphic description or representation"
                            },
                            {
                                "target_lang_word": "depiction",
                                "target_lang_sense_clarification": "a representation in an image or painting"
                            }
                        ]
                    }
                }
            ]
        }
    ]
