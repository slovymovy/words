        "nl-extract.jsonl": [
            {
                "entry_id": "2235d1a6-fd6e-353b-ad47-60c12381d838",
                "word": "opensperren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "deac1dc9-362e-3547-bfbc-d0f651a6cada",
                        "entry_id": "2235d1a6-fd6e-353b-ad47-60c12381d838",
                        "glosses": [
                            "een grote opening maken door de randen wijd uit elkaar te trekken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "422f7afa-ae3d-3976-8a60-c63dc54fd0e1",
                        "entry_id": "2235d1a6-fd6e-353b-ad47-60c12381d838",
                        "glosses": [
                            "de mond of ander lichaamsdeel wijd open doen"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "684f4409-0aad-4ed9-9dcd-029c1c0f7bec",
                                "sense_id": "422f7afa-ae3d-3976-8a60-c63dc54fd0e1",
                                "text": "U kent het beeld: onooglijke vogeltjes met donzige veertjes, samengepakt in een nest, die simultaan de bek zo wijd mogelijk opensperren in de hoop dat de ouders er een flink maal komen insteken. Het zijn smeekbedes die getriggerd worden door gezang. Horen de vogeltjes een vertrouwd lied, dan gaan ze niet alleen smeken, maar gaan ze ook meer wriemelen en kijken naar de ‘ingang’ van het nest."
                            },
                            {
                                "example_id": "87305817-2ed4-4920-9372-aea5c5fb3852",
                                "sense_id": "422f7afa-ae3d-3976-8a60-c63dc54fd0e1",
                                "text": "Stamppot rauwe andijvie - gisteren weer gegeten - ruikt goed, maar braaf, vertrouwenwekkend, doe maar gewoon. Citrus wekt op, verblijdt, doet de neusgaten opensperren. Olijfolie op warme bonensoep ruikt naar nooit gestorven winterblad, Thaise groene curry brandt zoet op koudvuur van anijs, koele pinot noir zingt van opwekkende vrede."
                            },
                            {
                                "example_id": "0bdebd87-a032-4792-92a3-e747872ffef5",
                                "sense_id": "422f7afa-ae3d-3976-8a60-c63dc54fd0e1",
                                "text": "Kleine Woord draaide zich om. Hij sperde zijn ogen zo wijd mogelijk open om De Steen, waarover Heer Ulva had gesproken, in het donker van de nacht te ontdekken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ec54a93-c539-4f88-b50f-66aed48f8c9c",
                        "source_entry_id": "2235d1a6-fd6e-353b-ad47-60c12381d838",
                        "source_sense_id": "deac1dc9-362e-3547-bfbc-d0f651a6cada",
                        "source_sense_description": "een grote opening maken door de randen wijd uit elkaar te trekken",
                        "target_lang_word": "break open",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "break open",
