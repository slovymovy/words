                },
                {
                    "sense_id": "3980f0a5-305d-3840-af60-21e1f55dabd9",
                    "sense_definition": "Belonging to the earliest stages of development or history.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the <w>primal</w> soup from which life on Earth is thought to have emerged.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>первичный</w> бульон, из которого, как считается, возникла жизнь на Земле."
                            }
                        },
                        {
                            "text": "The cave paintings provide a rare glimpse into the <w>primal</w> world of our ancestors.",
                            "target_lang_translations": {
                                "ru": "Наскальные рисунки позволяют заглянуть в <w>первобытный</w> мир наших предков."
                            }
                        }
                    ],
                    "synonyms": [
                        "primeval",
                        "primordial",
                        "primaeval"
                    ],
                    "antonyms": [
                        "modern",
                        "recent"
                    ],
                    "common_phrases": [
