            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e81e5673-406f-3a27-a45f-9007d253eae8",
                    "sense_definition": "vloeiend en zonder onderbreking voortbewegen van bijvoorbeeld verkeer of mensen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe weg moet ervoor zorgen dat het verkeer weer vlot kan <w>doorstromen</w>.",
                            "target_lang_translations": {
                                "en": "The new road should ensure that traffic can <w>flow through</w> smoothly again."
                            }
                        },
                        {
                            "text": "Door de extra uitgang konden de bezoekers na het concert sneller <w>doorstromen</w> naar buiten.",
                            "target_lang_translations": {
                                "en": "The extra exit allowed visitors to <w>move</w> outside more quickly after the concert."
                            }
