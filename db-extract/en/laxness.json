                        ],
                        "examples": [
                            {
                                "example_id": "66584207-910c-4012-b4f5-c5992f988ebb",
                                "sense_id": "892047a6-0473-36ed-ac2d-daf6aa0083d2",
                                "text": "There was a certain laxness in safety preparations that made the fire worse."
