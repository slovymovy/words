                    {
                        "translation_id": "2a5f936e-042e-4769-97ad-5b95d2f3fb45",
                        "source_entry_id": "ea7409bc-d4ed-36a2-bbc8-79117a11a9f8",
                        "source_sense_description": "prune rouge comme une cerise",
                        "target_lang_word": "алыча",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "алыча",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa73cf8-9328-38a2-99e1-2bfa1cd5a83a",
                                        "entry_id": "ab447ba3-0c8d-3be6-a097-a95d3ffc83e9",
                                        "glosses": [
                                            "ботан. южное дерево семейства розоцветных, близкое к сливе, с плодами жёлтого или тёмно-красного цвета (Prunus cerasifera)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f65a4db1-f78d-444d-a0ab-70b8b914b137",
                                                "sense_id": "2fa73cf8-9328-38a2-99e1-2bfa1cd5a83a",
                                                "text": "Под лестницей, прислонившись к стволу алычи, стоял отец Серёжки и Наташки."
                                            },
                                            {
                                                "example_id": "d623f778-874c-40de-9144-624293ba032a",
                                                "sense_id": "2fa73cf8-9328-38a2-99e1-2bfa1cd5a83a",
                                                "text": "Нежным розовым цветом цвели персики и алыча, курчавая травка пушилась на дворе и на склоне горы под верхнечегемской дорогой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93f2beab-397d-3166-b35d-332ba01cbfe6",
                                        "entry_id": "ab447ba3-0c8d-3be6-a097-a95d3ffc83e9",
                                        "glosses": [
                                            "плод или плоды такого дерева, употребляемые в пищу"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fd66dc1-d6a3-482e-90a6-e49f2fea8a4e",
                                                "sense_id": "93f2beab-397d-3166-b35d-332ba01cbfe6",
                                                "text": "Он угощает меня чаем и вареньем из алычи, покупает сигареты, если я попрошу, и оказывает другие небольшие услуги."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e68f017f-8a5c-3df8-8ea1-c1b074c045fb",
                                        "entry_id": "ab447ba3-0c8d-3be6-a097-a95d3ffc83e9",
                                        "glosses": [
                                            "древесина такого дерева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "659bce9b-6e36-4ac4-ac68-d179783dabc8",
                                                "sense_id": "e68f017f-8a5c-3df8-8ea1-c1b074c045fb",
                                                "text": "Подтвердит подмерзание внешний признак — буро-коричневый цвет коры древесины у яблони, вишни, сливы, алычи, черешни, абрикоса и чёрный — у груши."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
