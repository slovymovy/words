                        ],
                        "examples": [
                            {
                                "example_id": "d22280c2-db1d-4844-83f0-df0e2c393158",
                                "sense_id": "0a27209c-5cac-3d57-a004-4d0342f4bf88",
                                "text": "In 2015 werd het leenstelsel ingevoerd. Dit betekent dat studenten die een hbo- of wo-opleiding volgen, de studiefinanciering alleen nog maar kunnen lenen."
                            }
                        ]
                    }
