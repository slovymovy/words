                    {
                        "sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                        "entry_id": "9cea5cc3-76fc-3e2c-9d2c-8c48e029a5bd",
                        "glosses": [
                            "de tweede maand van het jaar volgens de gregoriaanse kalender"
                        ],
                        "tags": [
                            "tijdrekening"
                        ],
                        "examples": [
                            {
                                "example_id": "259783b2-e61a-4334-bf08-7449ae6a642c",
                                "sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                                "text": "Het sneeuwklokje bloeit al in februari."
                            },
                            {
                                "example_id": "d920cde3-66c3-4297-8186-a615043dfc46",
                                "sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                                "text": "Ik was zeker geïnteresseerd om er een keer bij aanwezig te zijn, maar voor maandag 1 februari stond een belangrijke zakelijke afspraak in Duitsland in mijn agenda en met het weekend ertussen was het niet mogelijk die te verzetten."
                            },
                            {
                                "example_id": "34b3af7a-d7b9-4411-9420-586ce5f72c00",
                                "sense_id": "eb7c9464-2945-3fb1-986c-5f33366d10c3",
                                "text": "Ik werd als manager voor Nederland van een Duits modemerk in het herdenkingsweekend van 1 februari 2003 op de Collection Première Düsseldorf (cpd) verwacht."
                            }
                        ]
                    }
                ],
                "translations": [
