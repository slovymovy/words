                        "entry_id": "36920922-f3c0-31de-ba14-481c1eb47583",
                        "glosses": [
                            "Celle qui raconte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2454b088-4a8c-46ce-9ba8-9dd467fc1157",
                                "sense_id": "f71dd620-83f2-3951-bc5c-36b02f3bbc0b",
                                "text": "Je suis raconteuse d’histoires et de contes pour enfants."
                            },
                            {
                                "example_id": "343eadaf-e0be-453a-ad38-3de3768e24e6",
                                "sense_id": "f71dd620-83f2-3951-bc5c-36b02f3bbc0b",
                                "text": "Oh, mais c'est déjà minuit ! dit la raconteuse en regardant sa montre, c’en est d'ailleurs le premier épisode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
