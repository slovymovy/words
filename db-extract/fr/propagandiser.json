                                        "examples": [
                                            {
                                                "example_id": "5223efe9-592d-438e-a1c9-30a948ef3c60",
                                                "sense_id": "b59c7c57-9d8e-353c-a753-8cb011749e20",
                                                "text": "After we'd managed to make ourselves comfortable in this garret, my new friends began to propagandize me. All they knew about me was that I was a student […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b6d3c3a-2ba3-3ecc-8eb8-994f2df58f81",
                                        "entry_id": "ae48e29d-4ee0-3f30-890e-ed34de667b91",
                                        "glosses": [
                                            "To use something or someone in propaganda purposes."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31ab3e85-14d8-41c5-9af5-b0de4547ca5e",
                                                "sense_id": "8b6d3c3a-2ba3-3ecc-8eb8-994f2df58f81",
                                                "text": "He propagandized this panacea with single-minded determination throughout the revolutionary period and even managed to establish a People's Bank for a short time before his arrest in 1849."
                                            }
                                        ]
                                    }
                                ]
                            }
