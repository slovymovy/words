                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postawa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz nauczyciel był bardzo <w>wyrozumiały</w> dla uczniów, którzy spóźnili się z powodu śnieżycy.",
                            "target_lang_translations": {
                                "ru": "Наш учитель был очень <w>снисходителен</w> к ученикам, опоздавшим из-за метели."
                            }
                        },
                        {
                            "text": "Proszę być <w>wyrozumiałym</w>, ponieważ to dopiero mój pierwszy dzień w nowej pracy.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, отнеситесь с <w>пониманием</w>, ведь это только мой первый день на новой работе."
                            }
                        }
                    ],
                    "synonyms": [
                        "pobłażliwy",
                        "tolerancyjny"
                    ],
                    "antonyms": [
                        "surowy",
                        "bezwzględny",
                        "niewyrozumiały"
                    ],
                    "common_phrases": [
                        "być wyrozumiałym dla kogoś",
                        "wyrozumiałe spojrzenie"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся с пониманием к чужим ошибкам или слабостям, готовый прощать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снисходительный",
                                "target_lang_sense_clarification": "нестрогий, терпимый к слабостям и ошибкам"
                            },
                            {
                                "target_lang_word": "понимающий",
                                "target_lang_sense_clarification": "способный войти в положение, проявить сочувствие"
                            },
                            {
                                "target_lang_word": "терпеливый",
                                "target_lang_sense_clarification": "проявляющий сдержанность и терпимость"
                            }
                        ]
                    }
                }
            ]
        },
        {
