                "translations": [
                    {
                        "translation_id": "6ebbbd41-5cea-41ca-9105-fbeb645354df",
                        "source_entry_id": "ef20cdf0-ddd4-399d-befd-59d83b127675",
                        "source_sense_id": "9b6aabf5-f9dd-3fbc-9b82-cd7ad8cb1736",
                        "target_lang_word": "adaptogen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adaptogen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fba3a1d-7f2e-3866-a88c-14a0c7daa422",
                                        "entry_id": "36b604fc-b82c-3a6a-aa08-be8f50552829",
                                        "glosses": [
                                            "Any natural herbal substance, such as ginseng, that is purported to assist the body to adapt to stress, and to exert a normalizing effect upon body functions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "845391ce-3929-41d1-a1a6-85ce32d2b6df",
                                                "sense_id": "5fba3a1d-7f2e-3866-a88c-14a0c7daa422",
                                                "text": "As members sipped from their glasses, Joey Rubin, a leader of the group’s Los Angeles chapter, explained that the drink contained adaptogens, herbs said to increase focus and stimulate creativity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "097834a3-5637-41b9-929a-b841e41faf99",
                        "source_entry_id": "ef20cdf0-ddd4-399d-befd-59d83b127675",
                        "source_sense_id": "9b6aabf5-f9dd-3fbc-9b82-cd7ad8cb1736",
                        "target_lang_word": "адаптоге́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "адаптоге́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0e8f86fb-8220-3d81-ba24-a90b3e1560e5",
                                        "entry_id": "491fb3d8-f2e0-38f5-b67a-244d5924a95c",
                                        "glosses": [
                                            "фарм. представитель фармакологической группы препаратов природного или искусственного происхождения, способных повышать неспецифическую сопротивляемость организма к широкому спектру вредных воздействий физической, химической и биологической природы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcdc7190-33b7-4bb2-9e71-8b674f713828",
                                                "sense_id": "0e8f86fb-8220-3d81-ba24-a90b3e1560e5",
                                                "text": "— Чтобы витамины лучше усвоились организмом, их нужно принимать вместе с препаратами-адаптогенами. Животный адаптоген «пантокрин» (из рожек молодых оленей), к сожалению, дороговат. А вот растительные препараты (женьшень, элеутерококк, аралия, корень солодки, заманиха, китайский лимонник, морские водоросли) продаются в любой аптеке и всем доступны."
                                            },
                                            {
                                                "example_id": "6233d506-0a12-411b-9d9c-07a5eafc883a",
                                                "sense_id": "0e8f86fb-8220-3d81-ba24-a90b3e1560e5",
                                                "text": "С утра — кальций, магний и витамин С, чтобы с их помощью распределить силы на весь день. После обеда — адаптогены (например, элеутерококк)."
                                            },
                                            {
                                                "example_id": "6c13a232-f95a-499c-a13f-97fbe3ce0b19",
                                                "sense_id": "0e8f86fb-8220-3d81-ba24-a90b3e1560e5",
                                                "text": "Заслуживает внимания и комплексный биостимулятор-адаптоген «Энергия», главное достоинство которого заключается в том, что он продлевает период плодоношения овощей и период цветения многолетних цветов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
