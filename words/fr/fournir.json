{
    "word_family": [
        "fournisseur",
        "fourniture"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22991ac4-45dc-3622-8d7a-c4c9e3d23839",
                    "sense_definition": "Approvisionner en vivres ou en matériel ; procurer ce qui est nécessaire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "approvisionnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ferme <w>fournit</w> tous les légumes frais du marché chaque semaine."
                        },
                        {
                            "text": "L'organisation s'engage à <w>fournir</w> du matériel scolaire aux enfants défavorisés."
                        }
                    ],
                    "synonyms": [
                        "approvisionner",
                        "procurer",
                        "livrer"
                    ],
                    "antonyms": [
                        "priver",
                        "retirer"
                    ],
                    "common_phrases": [
                        "fournir du matériel",
                        "fournir de l'aide"
                    ]
                },
                {
                    "sense_id": "441198ea-9b15-3c64-9c95-51c25829d049",
                    "sense_definition": "Consacrer, déployer de l'énergie ou une activité soutenue pour accomplir quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants doivent <w>fournir</w> un effort constant pour préparer l'examen."
                        },
                        {
                            "text": "Il a <w>fourni</w> une énergie incroyable pour terminer son projet à temps."
                        }
                    ],
                    "synonyms": [
                        "déployer",
                        "produire"
                    ],
                    "antonyms": [
                        "ménager",
                        "économiser"
                    ],
                    "common_phrases": [
                        "fournir un effort",
                        "fournir un travail"
                    ]
                },
                {
                    "sense_id": "30cd7f1c-ff90-34ab-b44d-e187958cca68",
                    "sense_definition": "Présenter ou remettre des pièces justificatives, des documents ou des preuves à une autorité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "administration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le candidat doit <w>fournir</w> plusieurs documents officiels pour finaliser son inscription."
                        },
                        {
                            "text": "L'avocat a promis de <w>fournir</w> de nouvelles preuves avant la fin du procès."
                        }
                    ],
                    "synonyms": [
                        "présenter",
                        "produire",
                        "apporter"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "cacher"
                    ],
                    "common_phrases": [
                        "fournir des preuves",
                        "fournir des pièces justificatives"
                    ]
                },
                {
                    "sense_id": "ffeded44-0a46-3f03-b10a-8bfe12ae2e23",
                    "sense_definition": "Au jeu de cartes, jouer une carte de la couleur demandée par l'entameur.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand on joue à la belote, il faut obligatoirement <w>fournir</w> à la couleur demandée."
                        },
                        {
                            "text": "Le joueur n'a pas pu <w>fournir</w> de trèfle et a donc dû couper avec un atout."
                        }
                    ],
                    "common_phrases": [
                        "fournir de la couleur",
                        "fournir de l'atout"
                    ]
                },
                {
                    "sense_id": "23f1b9c9-98d1-345c-9e59-b485eb390903",
                    "sense_definition": "Contribuer financièrement ou matériellement pour faire face à une dépense, subvenir aux besoins.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses maigres économies ne suffisent plus à <w>fournir</w> aux besoins essentiels de sa famille."
                        },
                        {
                            "text": "Le budget alloué par la région permettra de <w>fournir</w> aux dépenses d'aménagement."
                        }
                    ],
                    "synonyms": [
                        "subvenir",
                        "pourvoir"
                    ],
                    "common_phrases": [
                        "fournir aux frais",
                        "fournir à la dépense"
                    ]
                }
            ]
        }
    ]
}