                ],
                "senses": [
                    {
                        "sense_id": "a709def8-b421-3f90-807a-70ef1d95d1ff",
                        "entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "glosses": [
                            "To remove carbon from something.",
                            "To clean hard sooty deposits from inside an internal combustion engine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7097719-e664-4791-8956-e1e80f1001a7",
                                "sense_id": "a709def8-b421-3f90-807a-70ef1d95d1ff",
                                "text": "During the overhaul, the cylinder heads were found to be reusable, as long as they got a good cleaning to decarbonize the valve seat areas."
                            },
                            {
                                "example_id": "3b8e9b9a-bf0a-474f-95b1-82adeb893ea2",
                                "sense_id": "a709def8-b421-3f90-807a-70ef1d95d1ff",
                                "text": "To decarbonize piston rings and ring grooves, remove each ring carefully by spreading the ends just enough to get them clear of the piston top land and lifted off."
                            }
                        ]
                    },
                    {
                        "sense_id": "af10d2a1-2c42-3876-b262-da59eb0090ed",
                        "entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "glosses": [
                            "To remove carbon from something.",
                            "To remove carbon content from iron or steel, either intentionally or accidentally, as by (for example) overheating steel in the presence of air, destroying its former temper and hardness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9264ab52-3549-421b-94a0-9e2290e42808",
                                "sense_id": "af10d2a1-2c42-3876-b262-da59eb0090ed",
                                "text": "A blast furnace decarbonizes iron enough that it can be used as input to a steelmaking furnace."
                            },
                            {
                                "example_id": "dea82a46-7e4d-47ac-81f0-3673bbfa4569",
                                "sense_id": "af10d2a1-2c42-3876-b262-da59eb0090ed",
                                "text": "Repeatedly scorching a case-hardened tool will ruin the case by decarbonizing it."
                            }
                        ]
                    },
                    {
                        "sense_id": "e174b8d2-2ff8-383f-a0a8-00c6b0c92559",
                        "entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "glosses": [
                            "To remove carbon from something.",
                            "To reduce or replace fossil fuels by renewable energy in energy production and distribution systems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac26dfe3-4785-4800-8fa4-ad92f31620a3",
                                "sense_id": "e174b8d2-2ff8-383f-a0a8-00c6b0c92559",
                                "text": "Efforts to decarbonize the automotive fleet are challenging, but no one wants nightmare-grade climate change, either."
                            },
                            {
                                "example_id": "3b9b59a4-c45c-44a8-86eb-a44a815bdcdb",
                                "sense_id": "e174b8d2-2ff8-383f-a0a8-00c6b0c92559",
                                "text": "In fact, at a time when it is urgent to decarbonize the economy by all means possible, carbon footprinting misses the majority of the footprint of many sectors, either due to technique or lack of data."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce964211-804b-4d5a-be9a-6ab5f6d7915c",
                        "source_entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "décarboniser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décarboniser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8fad60-3986-3ff2-9925-b82051f0e1aa",
                                        "entry_id": "6c07c05e-fa5a-3f2c-821e-88b86c16a204",
                                        "glosses": [
                                            "Retirer le carbone de (une substance chimique)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6eacc3fb-e628-35da-8765-fdec197e5dd5",
                                        "entry_id": "6c07c05e-fa5a-3f2c-821e-88b86c16a204",
                                        "glosses": [
                                            "Nettoyer en débarrassant du carbone qui salissait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb3ed31-5d54-43f5-8acf-7fe66a57e171",
                                                "sense_id": "6eacc3fb-e628-35da-8765-fdec197e5dd5",
                                                "text": "Pullen l’a emmenée au garage pour la faire décarboniser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32723a37-1b87-3cf4-8de2-a908f16a4057",
                                        "entry_id": "6c07c05e-fa5a-3f2c-821e-88b86c16a204",
                                        "glosses": [
                                            "Ne plus baser sur le carbone, sur les sources d’énergie produisant du gaz carbonique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65789d71-2d01-4a29-9164-b913ba468a4c",
                                                "sense_id": "32723a37-1b87-3cf4-8de2-a908f16a4057",
                                                "text": "Il faut « décarboniser » l'économie pour sauver l'Europe de la crise !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaee97f6-a2fd-481b-8f05-a0f1377f9c6c",
                        "source_entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "décarboner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décarboner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32911640-488c-3d45-9b35-483f838c4204",
                                        "entry_id": "e037147c-acfb-39c9-a4d1-63593127c319",
                                        "glosses": [
                                            "Réduire les émissions de dioxyde de carbone dans (une production, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f62a7ac8-3b52-4102-9510-c91012e97565",
                                                "sense_id": "32911640-488c-3d45-9b35-483f838c4204",
                                                "text": "Des efforts de recherche « substantiels » devraient toutefois être menés pour décarboner aussi les secteurs difficiles à électrifier « à des coûts raisonnables », comme les transports, la construction ou certaines activités industrielles, en poussant les bioénergies ou le captage du CO₂."
                                            },
                                            {
                                                "example_id": "950cf293-17bc-4579-839a-69e5e0fb5d8e",
                                                "sense_id": "32911640-488c-3d45-9b35-483f838c4204",
                                                "text": "La plus grande part des GES étant représentée par le dioxyde de carbone (CO2), il s’agit donc de « décarboner » nos économies."
                                            },
                                            {
                                                "example_id": "315d7255-749c-403f-abac-10d86be26e46",
                                                "sense_id": "32911640-488c-3d45-9b35-483f838c4204",
                                                "text": "En déplacement à Dunkerque (Nord), le vendredi 4 février, pour préciser un programme de financement pour « décarboner » l’industrie, Jean Castex s’y est rendu en train, avant de rentrer en avion à 16 h 06 (42 minutes de vol), ce qui a obligé un Falcon à faire un déplacement à vide pour venir le chercher."
                                            },
                                            {
                                                "example_id": "76bdd388-702c-49c7-ad61-972b8b8ac66c",
                                                "sense_id": "32911640-488c-3d45-9b35-483f838c4204",
                                                "text": "Voilà qui donne à l’autopartage de jolis arguments à faire valoir dans le contexte actuel, où il faut à la fois désencombrer les réseaux routiers des grandes villes, lutter contre la pollution de l’air et décarboner les transports, premier secteur émetteur de gaz à effet de serre en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf6046c8-6e83-40d2-a533-02f0fd6c4c68",
                        "source_entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
                        "source_sense_description": "Translations",
                        "target_lang_word": "dekarbonisieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dekarbonisieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                        "entry_id": "e41f0d8e-3723-3dd1-8a96-beb38918f799",
                                        "glosses": [
                                            "von Kohlenstoff befreien"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17247a3e-76e7-4d4c-b7f6-069c7a3fa0bd",
                                                "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                                "text": "„Inzwischen ist aber allen klar: Wir haben ein CO2-Problem und müssen dekarbonisieren.“"
                                            },
                                            {
                                                "example_id": "0fb677a8-995a-42a2-899e-145af4338c5d",
                                                "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                                "text": "Denn: Die Zukunft der Menschheit hängt davon ab, ob es uns gelingt, die gesamte Energieversorgung zu dekarbonisieren, zu „entkohlen“."
                                            },
                                            {
                                                "example_id": "452c3ae1-2584-4946-9cd7-52ad68df0063",
                                                "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                                "text": "Die G7-Staaten haben sich geeinigt, die Wirtschaft bis zur Mitte des Jahrhunderts zu „dekarbonisieren“, also die Emissionen um mindestens 90 Prozent zu senken."
                                            },
                                            {
                                                "example_id": "eadcb783-a12f-4afb-b472-7f8c7a661704",
                                                "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                                "text": "Österreich müsse noch stärker „dekarbonisieren“, also weg von den fossilen Brennstoffen – und sparen."
                                            },
                                            {
                                                "example_id": "70308b14-5fe7-44e2-af40-54fd46287d91",
                                                "sense_id": "6c95dbde-dcbc-3407-bc72-0395b5251398",
                                                "text": "Das Argument sei grundsätzlich richtig, sagt Horster: „Mit dem Divestment lässt sich nicht die Welt, aber das eigene Portfolio dekarbonisieren, also von schädlichen Klimagasen befreien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0ac3e29-7d3a-4f01-8e21-b7fde8c08a00",
                        "source_entry_id": "3251f351-8d78-3a49-8870-6ecc309ab43e",
