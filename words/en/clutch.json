{
    "word_family": [],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8331f8a1-3822-37c6-83f0-17209260ddf0",
                    "sense_definition": "To hold someone or something tightly, often because of fear, pain, or a desire to keep them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "action_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <clutched> her purse tightly as she walked through the dark alley.",
                            "target_lang_translations": {
                                "ru": "Она крепко <сжимала> сумочку, идя по темному переулку.",
                                "zh": "她走过黑暗的小巷时，<w>紧握</w>着她的钱包。"
                            }
                        },
                        {
                            "text": "The child <clutched> his mother's hand in the crowded market.",
                            "target_lang_translations": {
                                "ru": "Ребенок <вцепился> в руку матери на переполненном рынке.",
                                "zh": "在拥挤的市场里，孩子<w>抓紧</w>了母亲的手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grip",
                        "grasp",
                        "hold",
                        "clasp",
                        "cling",
                        "hang on",
                        "hold tight"
                    ],
                    "common_phrases": [
                        "clutch at straws",
                        "clutch one's chest",
                        "clutch tightly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Держать кого-то или что-то крепко, часто из-за страха, боли или желания удержать.",
                        "zh": "指紧紧地握住某人或某物，通常是因为恐惧、疼痛或想要留住对方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "крепко держать в руках"
                            },
                            {
                                "target_lang_word": "вцепиться",
                                "target_lang_sense_clarification": "схватиться и не отпускать"
                            },
                            {
                                "target_lang_word": "зажать",
                                "target_lang_sense_clarification": "удерживать силой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧握",
                                "target_lang_sense_clarification": "用力握住"
                            },
                            {
                                "target_lang_word": "抓紧",
                                "target_lang_sense_clarification": "紧紧抓住不放"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "927c7f1b-3f7e-31a3-9fca-3cf440466d27",
                    "sense_definition": "To seize or grab something suddenly or eagerly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <clutch> the railing before he fell, but he missed.",
                            "target_lang_translations": {
                                "ru": "Он попытался <ухватиться> за перила, прежде чем упасть, но промахнулся.",
                                "zh": "他在摔倒前试图<w>一把抓住</w>栏杆，但没抓到。"
                            }
                        },
                        {
                            "text": "The greedy man <clutched> the money as soon as it was offered.",
                            "target_lang_translations": {
                                "ru": "Жадный мужчина <схватил> деньги, как только их предложили.",
                                "zh": "那个贪婪的人一看到钱被递过来就立刻<w>抢夺</w>了过去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "grab",
                        "nab",
                        "glaum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить или ухватиться за что-то внезапно или жадно.",
                        "zh": "指突然或急切地抓住某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "взять резким движением"
                            },
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "попытаться поймать или удержаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一把抓住",
                                "target_lang_sense_clarification": "动作迅速地抓取"
                            },
                            {
                                "target_lang_word": "抢夺",
                                "target_lang_sense_clarification": "急切地夺取"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d7f076e-16b1-3357-833d-b6110eb42ace",
                    "sense_definition": "The pedal or mechanism in a vehicle that allows the driver to change gears by separating the engine from the wheels.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to press the <clutch> down fully before you shift gears.",
                            "target_lang_translations": {
                                "ru": "Нужно полностью выжать <сцепление>, прежде чем переключать передачу.",
                                "zh": "换挡前你需要把<w>离合器</w>踩到底。"
                            }
                        },
                        {
                            "text": "My car's <clutch> is worn out and needs to be replaced soon.",
                            "target_lang_translations": {
                                "ru": "<Сцепление> в моей машине изношено, и его скоро нужно менять.",
                                "zh": "我车的<w>离合器</w>磨损严重，很快就需要更换了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "release the clutch",
                        "ride the clutch",
                        "slip the clutch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Педаль или механизм в транспортном средстве, который позволяет водителю переключать передачи, разъединяя двигатель и колеса.",
                        "zh": "车辆中用于切断发动机与车轮连接，以便驾驶员换挡的踏板或机械装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сцепление",
                                "target_lang_sense_clarification": "механизм автомобиля"
                            },
                            {
                                "target_lang_word": "педаль сцепления",
                                "target_lang_sense_clarification": "элемент управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "离合器",
                                "target_lang_sense_clarification": "汽车机械部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e838ea2-8a74-33d0-8b2e-f2b492f47da6",
                    "sense_definition": "A small, flat handbag without handles or straps, usually carried in the hand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a stunning red dress and carried a silver <clutch> to the gala.",
                            "target_lang_translations": {
                                "ru": "Она была в потрясающем красном платье и с серебристым <клатчем> на гала-вечере.",
                                "zh": "她穿着一件迷人的红裙子，带着一个银色的<w>手拿包</w>参加了晚宴。"
                            }
                        },
                        {
                            "text": "I only have room for my phone and keys in this tiny <clutch>.",
                            "target_lang_translations": {
                                "ru": "В этом крошечном <клатче> есть место только для телефона и ключей.",
                                "zh": "这个小小的<w>手拿包</w>里只能装下我的手机和钥匙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clutch bag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая плоская сумочка без ручек и ремешков, которую обычно носят в руке.",
                        "zh": "一种没有提手或肩带的小型扁平手提包，通常用手拿着。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клатч",
                                "target_lang_sense_clarification": "вид сумки"
                            },
                            {
                                "target_lang_word": "сумочка-клатч",
                                "target_lang_sense_clarification": "аксессуар"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手拿包",
                                "target_lang_sense_clarification": "无带小包"
                            },
                            {
                                "target_lang_word": "晚宴包",
                                "target_lang_sense_clarification": "正式场合用的手拿包"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1c412e-adba-3915-b29d-d97a9c553515",
                    "sense_definition": "Power or control over someone or something, often used to imply being trapped or held against one's will.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero managed to escape from the <clutches> of the villain just in time.",
                            "target_lang_translations": {
                                "ru": "Герою удалось вырваться из <лап> злодея как раз вовремя.",
                                "zh": "英雄及时从恶棍的<w>魔掌</w>中逃脱了。"
                            }
                        },
                        {
                            "text": "Many people fall into the <clutches> of predatory lenders due to financial desperation.",
                            "target_lang_translations": {
                                "ru": "Многие люди попадают в <лапы> хищных кредиторов из-за финансовой безысходности.",
                                "zh": "许多人因经济窘迫而落入高利贷者的<w>魔掌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "grip",
                        "stranglehold"
                    ],
                    "common_phrases": [
                        "in someone's clutches",
                        "escape the clutches"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "usually plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Власть или контроль над кем-то или чем-то, часто подразумевающие невозможность вырваться.",
                        "zh": "指对某人或某事的控制权，常暗示被困住或违背意愿被掌控。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лапы",
                                "target_lang_sense_clarification": "перен. власть, контроль"
                            },
                            {
                                "target_lang_word": "когти",
                                "target_lang_sense_clarification": "перен. цепкая власть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "魔掌",
                                "target_lang_sense_clarification": "比喻邪恶的控制"
                            },
                            {
                                "target_lang_word": "掌控",
                                "target_lang_sense_clarification": "权力的控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fcc97fc0-254d-3f01-884c-ab3785447228",
                    "sense_definition": "A critical or crucial situation where the outcome is decided, often requiring high performance under pressure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is known for his ability to come through in the <clutch> when the team needs him most.",
                            "target_lang_translations": {
                                "ru": "Он известен своей способностью выручать в <решающий момент>, когда команда нуждается в нем больше всего.",
                                "zh": "他以在球队最需要他时的<w>关键时刻</w>挺身而出而闻名。"
                            }
                        },
                        {
                            "text": "The veteran player proved his worth in the <clutch> with a game-winning hit.",
                            "target_lang_translations": {
                                "ru": "Ветеран доказал свою ценность в <критической ситуации> победным ударом.",
                                "zh": "这位老将用一次制胜击球证明了他在<w>关键时刻</w>的价值。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the clutch",
                        "come through in the clutch"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Критическая или решающая ситуация, где исход зависит от действий под давлением.",
                        "zh": "指决定胜负的关键时刻，通常需要在压力下有出色表现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решающий момент",
                                "target_lang_sense_clarification": "ситуация высокого напряжения"
                            },
                            {
                                "target_lang_word": "критическая ситуация",
                                "target_lang_sense_clarification": "опасное или важное положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关键时刻",
                                "target_lang_sense_clarification": "决定性时刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d365009c-127f-3110-b3fd-ececb6631d08",
                    "sense_definition": "A group of eggs laid at the same time, or a small group of people or things.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother bird carefully guarded her <clutch> of eggs until they hatched.",
                            "target_lang_translations": {
                                "ru": "Птица-мать тщательно охраняла свою <кладку> яиц, пока они не вылупились.",
                                "zh": "母鸟小心翼翼地守护着它的<w>一窝</w>蛋，直到它们孵化。"
                            }
                        },
                        {
                            "text": "A new <clutch> of graduates enters the job market every spring.",
                            "target_lang_translations": {
                                "ru": "Каждую весну на рынок труда выходит новый <выводок> выпускников.",
                                "zh": "每年春天，都有<w>一窝</w>新的毕业生进入就业市场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sitting",
                        "setting"
                    ],
                    "common_phrases": [
                        "clutch of eggs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа яиц, отложенных одновременно, или небольшая группа людей или предметов.",
                        "zh": "指一次产下的蛋，或指一小群人或物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кладка",
                                "target_lang_sense_clarification": "яиц"
                            },
                            {
                                "target_lang_word": "выводок",
                                "target_lang_sense_clarification": "группа птенцов или людей (перен.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一窝",
                                "target_lang_sense_clarification": "用于蛋或幼崽"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d3735f7f-2341-30cd-968c-3602092a7d32",
                    "sense_definition": "Able to perform well in difficult, high-pressure situations, especially in sports or games.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <clutch> play that saved the game for us in the final seconds.",
                            "target_lang_translations": {
                                "ru": "Это был <решающий> ход, который спас для нас игру на последних секундах.",
                                "zh": "那是一次<w>关键的</w>进攻，在最后几秒钟为我们挽救了比赛。"
                            }
                        },
                        {
                            "text": "He is not the fastest player, but he is incredibly <clutch> during playoffs.",
                            "target_lang_translations": {
                                "ru": "Он не самый быстрый игрок, но невероятно <надёжен> в плей-офф.",
                                "zh": "他不是跑得最快的球员，但在季后赛中却非常<w>抗压</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "clutch player",
                        "clutch performance",
                        "clutch play"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный действовать эффективно в трудных, напряженных ситуациях, особенно в спорте.",
                        "zh": "指在困难、高压环境下（特别是在体育比赛中）表现出色的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решающий",
                                "target_lang_sense_clarification": "определяющий исход"
                            },
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "в критической ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "关键的",
                                "target_lang_sense_clarification": "决定胜负的"
                            },
                            {
                                "target_lang_word": "抗压的",
                                "target_lang_sense_clarification": "在压力下表现稳定的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}