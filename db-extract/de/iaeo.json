        "de-extract.jsonl": [
            {
                "entry_id": "8a58b834-863e-3f0f-a284-1e9d6b19d0cc",
                "word": "IAEO",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
                        "entry_id": "8a58b834-863e-3f0f-a284-1e9d6b19d0cc",
                        "glosses": [
                            "Abkürzung für Internationale Atomenergieorganisation, einer am 29. Juli 1957 unter der Patronanz der UNO gegründeten autonomen Organisation zur Förderung der friedlichen Nutzung der Kernenergie und der Verhinderung der Erzeugung und Verbreitung von Atomwaffen mit Verwaltungssitz in Wien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c25121-53b9-455b-87c8-7e42c8de94dd",
                                "sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
                                "text": "Die Internationale Atombehörde IAEO, die Nuklearprogramme von Staaten in aller Welt beobachtet, feiert am Sonntag ihr 50-jähriges Bestehen."
                            },
                            {
                                "example_id": "79080bb9-2d1e-4fa7-8398-78e00beec2db",
                                "sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
                                "text": "Außerdem erhielt die IAEO von Teheran die Erlaubnis, in näherer Zukunft den im Bau befindlichen Schwerwasserreaktor in Arak zu besichtigen."
                            },
                            {
                                "example_id": "8f343a74-0667-44cb-99df-7177c1bffbc2",
                                "sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
                                "text": "Die Abschaltung des Atomreaktors Yongbyon sowie die Überwachung der übrigen Atomanlagen durch die IAEO sei \"ein wichtiger Schritt auf dem Weg zu einer atomwaffenfreien Zone auf der koreanischen Halbinsel\", sagte US-Botschafter Greg Schulte."
                            },
                            {
                                "example_id": "05fa7f6f-b456-4cfe-a2f0-8be142dd91ef",
                                "sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
                                "text": "Der diesjährige Friedensnobelpreis geht an die Internationale Atomenergie-Organisation IAEO und ihren Chef Mohammed El-Baradei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bffeda13-5d19-4949-ad45-973e3a20970b",
                        "source_entry_id": "8a58b834-863e-3f0f-a284-1e9d6b19d0cc",
                        "source_sense_id": "05471334-c18f-3102-9e96-3f2cd5f6c2d4",
