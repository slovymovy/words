                        ],
                        "form": "die Drahtseile"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce8970dc-f867-3b92-8f4c-6545b51fffae",
                        "entry_id": "a586f5d0-acf5-3f9e-b9da-371eca4379de",
                        "glosses": [
                            "Seil, dessen einzelne Litzen und Kardeelen nicht aus Fasern, sondern aus Stahl bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0596ab3-b1ca-4357-a8e4-e2ccdea88376",
                                "sense_id": "ce8970dc-f867-3b92-8f4c-6545b51fffae",
                                "text": "Der Zirkuskünstler balanciert auf einem Drahtseil."
                            },
                            {
                                "example_id": "335a28d1-88b4-4c4c-abb0-e3c04a4928c3",
                                "sense_id": "ce8970dc-f867-3b92-8f4c-6545b51fffae",
                                "text": "„Ab und zu tauchen die Fassaden von Gebäuden hinter dem Park in den blauen Fluten auf, aber das Drahtseil selbst, das oben im Dunkel gespannt ist, bleibt unsichtbar.“"
                            },
                            {
                                "example_id": "e3787da9-02b5-4891-81b8-902891127e86",
                                "sense_id": "ce8970dc-f867-3b92-8f4c-6545b51fffae",
                                "text": "„Bei bestem Ausflugswetter am Sonntagnachmittag verkeilt sich eine der 32 Kabinen und macht damit eine Rückfahrt an den Drahtseilen unmöglich.“"
                            },
                            {
                                "example_id": "4f7cd4f9-2e52-4dc5-a67b-23d630edf7fb",
                                "sense_id": "ce8970dc-f867-3b92-8f4c-6545b51fffae",
                                "text": "„Vielleicht kann er ja auch auf einem Drahtseil ohne Netz mit acht Bällen jonglieren oder mit einem Floß den Atlantik überqueren und dabei Harmonium spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
