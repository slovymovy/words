                "senses": [
                    {
                        "sense_id": "325193f5-5481-3471-be24-22cffc3a936e",
                        "entry_id": "390fefdd-8a29-3ca9-a750-3d18e76a9627",
                        "glosses": [
                            "The edible and aromatic seed pods (properly, capsules) of the Abelmoschus moschatus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "66d6c47b-4d6e-48cb-ac2a-47ac1a4c4f6a",
                                "sense_id": "325193f5-5481-3471-be24-22cffc3a936e",
                                "text": "Egyptian Ketmia, with a perfumed or Musk-Seed..., called Abelmosch of Morison."
                            },
                            {
                                "example_id": "68fb1edc-bbb0-4d07-9c5e-743836acb1cd",
                                "sense_id": "325193f5-5481-3471-be24-22cffc3a936e",
                                "text": "Abelmosk grains are the seeds of a plant... indigenous to Central Africa, Arabia, and India."
                            }
                        ]
                    },
                    {
                        "sense_id": "6eda107d-411d-3c2f-85a3-5f50cd0fb710",
                        "entry_id": "390fefdd-8a29-3ca9-a750-3d18e76a9627",
                        "glosses": [
                            "The tropical evergreen shrub Abelmoschus moschatus itself."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0b4472bc-4614-45f6-9427-ead19bff1040",
                                "sense_id": "6eda107d-411d-3c2f-85a3-5f50cd0fb710",
                                "text": "Abelmosk, Abelmosch, or Abelmusk, the Syrian mallow, or musk okro, a species of hibiscus (H. abelmoschus)."
                            },
                            {
                                "example_id": "ac28a650-a7d2-466a-bf9a-bcdb2c801051",
                                "sense_id": "6eda107d-411d-3c2f-85a3-5f50cd0fb710",
                                "text": "The same description fits abelmosk, the Hibiscus abelmoshus, better known to the world as the East Indian dwarf okra plant."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f30ed19-5854-3a1e-a459-679f6f83362d",
                        "entry_id": "390fefdd-8a29-3ca9-a750-3d18e76a9627",
                        "glosses": [
                            "Other members of the genus Abelmoschus, such as okra."
                        ],
