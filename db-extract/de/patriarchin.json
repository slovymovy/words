                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144b0d30-8cda-4b78-99d9-4bf708e71ff7",
                                "sense_id": "7d24e40e-37f4-3902-b282-7aa47d2ed2c7",
                                "text": "„Die langlebigste Familie der Welt, der Melis-Clan auf Sardinien, hat seine Patriarchin verloren.“"
                            },
                            {
                                "example_id": "77c21cad-2b34-4fe4-8b3e-bc912218494b",
                                "sense_id": "7d24e40e-37f4-3902-b282-7aa47d2ed2c7",
                                "text": "„Großchen war nach dem frühen Tod ihres Mannes Ludwig zu einer sanften Patriarchin geworden, eine Rolle, die sie zunächst in ihrer Familie, den Rosenows, spielte und später im Haus ihres Schwiegersohns, bei den Buchsteiners.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
