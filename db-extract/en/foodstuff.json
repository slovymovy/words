                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "161bea78-77ea-47ee-b988-9470cb7c2c5f",
                                                "sense_id": "820c3150-37c3-31b0-b89b-e5582dceaf8e",
                                                "text": "In grote delen van het centrum van Berlijn hadden de huurpanden winkels op de begane grond, dat kon van alles zijn, van levensmiddelen en kleine naaiateliers tot antiquairs, groentemannen en meubelverkopers, groot en klein door elkaar heen zonder enig systeem, behalve in grote winkelstraten zoals de Leipziger Strasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc1af4eb-3434-49de-9319-5e6b52007b73",
                        "source_entry_id": "ffd386cf-a2a8-3ac1-8adb-4d719f342fe6",
                        "source_sense_id": "992889c4-c27b-39e9-97d4-8905030c1b9e",
                        "source_sense_description": "material that may be used as food",
                        "target_lang_word": "voedsel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voedsel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "824e7cfb-00c9-336a-8d32-093e1690cb96",
                                        "entry_id": "84782594-0f14-380a-a681-8c9217561688",
                                        "glosses": [
                                            "alles wat een levend wezen tot zich neemt om aan bouwstof en energie te komen.\\nDit kan zowel een vaste of vloeibare substantie zijn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d83672-23b3-44b3-9587-79a9f328f7f5",
                                                "sense_id": "824e7cfb-00c9-336a-8d32-093e1690cb96",
                                                "text": "Een derde van al het geproduceerde voedsel wereldwijd wordt verspild. Hiermee is een kostenpost gemoeid van 565 miljard euro."
                                            },
                                            {
                                                "example_id": "47e75cfa-876c-490d-8450-a86ba77fe611",
                                                "sense_id": "824e7cfb-00c9-336a-8d32-093e1690cb96",
                                                "text": "Mijn 18 kilo zware rugzak, bepakt met voedsel en water, voelde als lood op mijn rug."
                                            },
                                            {
                                                "example_id": "bb3e4060-062a-4b07-8283-445850d4dce7",
                                                "sense_id": "824e7cfb-00c9-336a-8d32-093e1690cb96",
                                                "text": "De ratten in Amsterdam hebben toegang tot huizen met bouwkundige problemen, zoals een kapot riool of gaten in kruipruimten. De dieren worden aangetrokken door voedsel, zoals etensresten op straat bij afvalbakken of voer voor duiven of eenden. Deze factoren kunnen de overlast vergroten, stelt de gemeente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5da97a9-f8a7-48f1-b448-ceb3f80c7577",
                        "source_entry_id": "ffd386cf-a2a8-3ac1-8adb-4d719f342fe6",
                        "source_sense_id": "992889c4-c27b-39e9-97d4-8905030c1b9e",
                        "source_sense_description": "material that may be used as food",
                        "target_lang_word": "aliment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aliment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                        "entry_id": "80d7063d-abe5-3977-9854-15a25849c5a2",
                                        "glosses": [
                                            "Ce qui se mange et sert à entretenir la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2857a33-ff76-47ff-8f35-f87d2a369ae4",
                                                "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                                "text": "Les pois mûrs & secs sont un des légumes qui fournissent la purée la plus délicate, & l’aliment le moins grossier."
                                            },
                                            {
                                                "example_id": "a9c3b681-1c89-4155-a3ad-8eeb1d0e77b3",
                                                "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                                "text": "Le fruit nommé cul-de-chien, nèfle d’Allemagne, est astringent avant sa maturité ; lorsqu’il a molli sur la paille c’est un aliment fort agréable ; […]."
                                            },
                                            {
                                                "example_id": "d40c26d6-67d2-42c9-aea6-752f9afddd8b",
                                                "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                                "text": "Dans l'état de vacuité, la membrane muqueuse de l'estomac est d'une couleur grisâtre. Au moment où les aliments s'accumulent dans le réservoir gastrique, cette membrane devient rose, […]."
                                            },
                                            {
                                                "example_id": "71f84f88-b0ca-422e-b6dd-122d5ee39e93",
                                                "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                                "text": "Dans Mythologiques , Claude Lévi-Strauss écrit que cuire un aliment, c’est couper court au processus naturel qui fait qu’à terme un aliment cru (un légume, un fruit, un morceau de viande) devient une chose pourrie."
                                            },
                                            {
                                                "example_id": "58e240b2-1763-4cd0-972e-8b03deea870a",
                                                "sense_id": "646ef4d4-abc1-3ee1-99cb-13bb65994164",
                                                "text": "L’être humain, quel que soit l’âge, est méfiant en face d’un aliment qu’il consomme pour la première fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7382e03e-6039-34e4-8f08-8cf4ed273b67",
                                        "entry_id": "80d7063d-abe5-3977-9854-15a25849c5a2",
                                        "glosses": [
                                            "Action de nourrir."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a23a1b8a-d011-42f3-bc8a-4e1d2fd23cac",
                                                "sense_id": "7382e03e-6039-34e4-8f08-8cf4ed273b67",
                                                "text": "Des biens destinés pour l’aliment des pauvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                        "entry_id": "80d7063d-abe5-3977-9854-15a25849c5a2",
                                        "glosses": [
                                            "Ce qui entretient quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e47378d-09b0-419f-8a7b-19119d7d6e85",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "Défaites-vous, ma Fille, de cette laide et noire humeur qui est si contraire à l’esprit de Dieu et qui sert d’aliment à votre amour-propre, souvenez-vous que c’est une trop grande lâcheté que de se laisser vaincre à une petite imagination (…)."
                                            },
                                            {
                                                "example_id": "a521993a-c92d-4912-b333-14a259e2fe39",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "Le service de Charles X, ou ce qu’il appelait la politique, donnait un aliment à son envie de faire, de travailler, d’être compté."
                                            },
                                            {
                                                "example_id": "efd8905d-5534-4d95-91cb-ad08a36bade7",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "Personne ne fit d’abord attention à lui ; mais, lorsque la curiosité publique n’eut pas d’autre aliment, il devint le but de tous les regards."
                                            },
                                            {
                                                "example_id": "87b37fc6-e41d-4d1c-bbb8-f863eba9cbbe",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "Le bois est l’aliment du feu."
                                            },
                                            {
                                                "example_id": "dbf1d949-6d95-40cf-9376-e66ac5d4808a",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "Les sciences sont l’aliment de l’esprit."
                                            },
                                            {
                                                "example_id": "e249c6b4-e83a-4bd0-b7ce-b8a462db1add",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "L’aliment des passions."
                                            },
                                            {
                                                "example_id": "66667b60-82c1-4c66-b1d7-a6ed7ad21995",
                                                "sense_id": "b16e2ce5-6c7b-3f2f-b203-fb53246eb236",
                                                "text": "L’aliment des factions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19eb9934-04ce-434a-b937-81169181f37a",
                        "source_entry_id": "ffd386cf-a2a8-3ac1-8adb-4d719f342fe6",
                        "source_sense_id": "992889c4-c27b-39e9-97d4-8905030c1b9e",
                        "source_sense_description": "material that may be used as food",
                        "target_lang_word": "Nahrungsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nahrungsmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                        "entry_id": "fc4e76e1-1347-3afd-8219-40985cdee0d4",
                                        "glosses": [
                                            "Speisen und Getränke, die dem Menschen und seinem Körper zur Ernährung, also seiner Versorgung mit Energie, Baustoffen und Vitaminen dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24e19faf-09c0-4bdf-85dc-71423b4ec831",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "Nur wertvolle Nahrungsmittel sollten den Hunger vieler Kinder stillen."
                                            },
                                            {
                                                "example_id": "856f4297-3173-4980-924a-16ca14660850",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Mit dem Begriff Nahrungsmittel bezeichnet man eine inhomogene Gruppe organischer Stoffe tierischer oder pflanzlicher Herkunft und deren Zubereitungen, sowie bestimmte Salze und Flüssigkeiten.“"
                                            },
                                            {
                                                "example_id": "119600ca-b7b0-4047-946d-a566fcfb09fc",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Die heute am weitesten verbreitete, schonendste und effektivste Methode zum Haltbarmachen von Nahrungsmitteln ist […] die Kühlung bzw. Tiefkühlung.“"
                                            },
                                            {
                                                "example_id": "7d6f9a40-4778-425f-8833-7bb094ef2c30",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Das Misstrauen gegenüber gentechnisch veränderten Lebensmitteln ist zwar groß, allerdings sind »Gene« natürlich in jedem Lebewesen und damit auch in allen Nahrungsmitteln enthalten.“"
                                            },
                                            {
                                                "example_id": "1e0a50ac-6fe7-4700-8d7b-87ab794e078b",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Alltägliche Nahrungsmittel, die Impfstoffe oder andere medizinisch wirksame Zusatzstoffe enthalten, gibt es zwar noch nicht zu kaufen, sie sind aber schon Gegenstand der Forschung.“"
                                            },
                                            {
                                                "example_id": "39261fde-d8e1-48a2-989a-dd571df90787",
                                                "sense_id": "e7d81ebe-e3f4-3489-a37f-283e32500862",
                                                "text": "„Wir durften nicht einmal ein Boot an Land schicken, um frische Nahrungsmittel zu beschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
