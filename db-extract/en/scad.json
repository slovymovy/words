                                        "glosses": [
                                            "Meeresfisch, der an den Küsten des nordöstlichen Atlantik von Norwegen bis Südafrika, sowie im Mittelmeer vorkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9845cdf6-e3c6-4666-824f-29e325dca31e",
                                                "sense_id": "c1942689-f8e7-3be5-a010-a596e37936a6",
                                                "text": "„Der Stöcker kommt an der gesamten ostatlantischen Küste bis nach Südafrika im Süden vor.“"
                                            }
