                                            {
                                                "example_id": "e40bd8b8-69ef-43d1-aa24-b14544c9bcc5",
                                                "sense_id": "fa2fc17b-4125-3222-8129-dea3c3066ba4",
                                                "text": "Soustraire l’enfant à la rencontre structurante de l’interdit est un sévice (qui condamne l'enfant à épargner son enfant-despote au maximum)."
                                            },
                                            {
                                                "example_id": "44512a64-a389-45ec-b664-bd6633f67084",
                                                "sense_id": "fa2fc17b-4125-3222-8129-dea3c3066ba4",
                                                "text": "Un parent commet un sévice moral en se livrant à une charge sur l’être jeune qui ne peut faire face."
                                            },
                                            {
                                                "example_id": "98c1dd1d-b893-46f8-afd5-2483f3ce1fab",
                                                "sense_id": "fa2fc17b-4125-3222-8129-dea3c3066ba4",
                                                "text": "Les animaux l’aiment et, à son approche, ils montent des caves, descendent des greniers ; ils quittent le trou qui les abrite contre les sévices des gamins et viennent ronronner autour d’elle."
                                            }
                                        ]
                                    }
                                ]
