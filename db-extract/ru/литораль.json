                                        "entry_id": "fc407a8f-4157-3f5e-86a2-23e3cf8ce216",
                                        "glosses": [
                                            "der Lebensraum der ufernahen Zone von Seen und Meeren, in dem das ins Wasser fallende Licht noch für die Fotosynthese von pflanzlichen Organismen ausreicht"
                                        ],
                                        "tags": [],
                                        "examples": [
