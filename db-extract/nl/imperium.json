                "translations": [
                    {
                        "translation_id": "07932199-2d3d-4b29-9e7a-650afabe3490",
                        "source_entry_id": "efb8a0ee-c4eb-3642-89d4-b2da05798814",
                        "target_lang_word": "empire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "empire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1c4cfc-18cc-3575-8a99-d14dc126f2f9",
                                        "entry_id": "83ab8040-2c3d-3f11-b83c-ec4406deba2a",
                                        "glosses": [
                                            "A political state, often a monarchy, that has achieved a much greater current size than its initial size by conquering surrounding territories, cities or nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1efc573-1617-43c7-9f67-d373e15af944",
                                                "sense_id": "3d1c4cfc-18cc-3575-8a99-d14dc126f2f9",
                                                "text": "the Russian empire"
                                            },
                                            {
                                                "example_id": "619c1067-bd87-4eaa-a641-31ce0b0a1a6f",
                                                "sense_id": "3d1c4cfc-18cc-3575-8a99-d14dc126f2f9",
                                                "text": "States and empires fail when they are no longer the solution, they are the problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e7968c-7582-3443-9a50-7a725d24c985",
                                        "entry_id": "83ab8040-2c3d-3f11-b83c-ec4406deba2a",
                                        "glosses": [
                                            "A political unit ruled by an emperor or empress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b44472a-8c3c-4667-81e8-861903c2a1a9",
                                                "sense_id": "b1e7968c-7582-3443-9a50-7a725d24c985",
                                                "text": "The Empire of Vietnam was a short-lived client state of Japan governing Vietnam between March 11 and August 23, 1945."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf9bffc-d153-33d5-a09e-f2854df62a3c",
                                        "entry_id": "83ab8040-2c3d-3f11-b83c-ec4406deba2a",
                                        "glosses": [
                                            "The group of states or other territories that owe allegiance to an imperial power (foreign to them), when distinguished from the native territory of that power; imperial possessions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6a30ead-1c73-4a6b-b46c-8d2bc9df7dcc",
                                                "sense_id": "daf9bffc-d153-33d5-a09e-f2854df62a3c",
                                                "text": "British people [...] continued to believe in empire. It was what gave Britain a unique role in the world, and in return Britain had drawn strength from its empire to enable it to survive two great wars that had wrecked so many of its competitors. Imperial management in the twentieth[…]"
                                            },
                                            {
                                                "example_id": "abbe64c2-ea26-4226-ad19-81fffbcd9071",
                                                "sense_id": "daf9bffc-d153-33d5-a09e-f2854df62a3c",
                                                "text": "Since Britain imported mainly foodstuffs from its empire, no preferences could be granted to the colonies without Britain first imposing a tariff on foodstuffs imported from other countries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52ee5825-f8ef-3fcc-9119-a2d9008beb34",
                                        "entry_id": "83ab8040-2c3d-3f11-b83c-ec4406deba2a",
                                        "glosses": [
                                            "An expansive and powerful enterprise under the control of one person or group."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f14402e-1523-4854-a978-d0559bc972ce",
                                                "sense_id": "52ee5825-f8ef-3fcc-9119-a2d9008beb34",
                                                "text": "the McDonald's fast food empire"
                                            },
                                            {
                                                "example_id": "ba234e2f-5d31-45bc-abfb-5e253a983520",
                                                "sense_id": "52ee5825-f8ef-3fcc-9119-a2d9008beb34",
                                                "text": "“Revenues for Jackson's non-profit empire sky-rocketed from $4 million in 1997, to more than $14 million just two years later.”"
                                            },
                                            {
                                                "example_id": "a92f6ad8-944f-4188-a418-eec69b027e25",
                                                "sense_id": "52ee5825-f8ef-3fcc-9119-a2d9008beb34",
                                                "text": "The Mafia never forgave Castro but Lansky had already laid the foundations of a mob gambling empire all over the Caribbean […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e380ff5-9f40-366a-95b3-9df4ae14a617",
                                        "entry_id": "83ab8040-2c3d-3f11-b83c-ec4406deba2a",
                                        "glosses": [
                                            "control, dominion, sway."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd99c20b-3988-43a3-bd1d-789b2ec5f095",
                                                "sense_id": "1e380ff5-9f40-366a-95b3-9df4ae14a617",
                                                "text": "The brutality, the unthinking, the unreflecting character of the barbarians were so great, that the new faith, the new feelings with which they had been inspired, exercised but a very slight empire over them."
                                            },
                                            {
                                                "example_id": "14a0eb43-78ea-4a80-a1f7-2251b104a858",
                                                "sense_id": "1e380ff5-9f40-366a-95b3-9df4ae14a617",
                                                "text": "With infinite complacency men went to and fro over this globe about their little affairs, serene in their assurance of their empire over matter."
                                            },
                                            {
                                                "example_id": "68402ed3-971c-4f8f-8485-333596d0845e",
                                                "sense_id": "1e380ff5-9f40-366a-95b3-9df4ae14a617",
                                                "text": "[…] could gain some political strength for the pope, but in so doing the pope would lose the uniqueness and supremacy of his empire over souls: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
