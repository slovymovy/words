                "senses": [
                    {
                        "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                        "entry_id": "1213ff5f-5df5-38c9-a1ba-83cce2f4cf2f",
                        "glosses": [
                            "Spiel, bei dem die Kunstfigur Tarzan als Spielimpuls und Ideenspender fungiert; Abenteuerspiel, bei dem geklettert, gehangelt, in die Rolle von Tieren geschlüpft oder mit urweltlichen Geräuschen agiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a129a4a-229b-43d6-9199-23102fb1dc46",
                                "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                                "text": "„Allein mit dem Tarzanspiel können sich zwei oder drei Familien mit Kindern oder eine Jugendgruppe einen ganzen Nachmittag und länger vergnügen.“"
                            },
                            {
                                "example_id": "c6a8377b-885b-40e7-83fa-6dab981450b2",
                                "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                                "text": "„Das Tarzanspiel mit Perkussion und Stimme ist nun ihr Spiel geworden, das sie nicht müde werden zu wiederholen.“"
                            },
                            {
                                "example_id": "de2c8f15-3b8c-47aa-a8a3-49ebd8eacc05",
                                "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                                "text": "„Wir waren in der Zeit nach dem Krieg meistens kleine wilde, durchstreiften das Gelände als Banden und lernten beispielsweise, Fische mit den Händen zu fangen. Ein Freund, etwa in meinem Alter, erinnert sich an das Tarzanspiel im Wald.“"
                            },
                            {
                                "example_id": "95d0abf0-6886-4f15-a1ca-c0a456ae0296",
                                "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                                "text": "„Doch mit dem fortgeschrittenen Alter, Kind und Kegel sowie dem einen oder anderen Kilo zuviel auf den Rippen ist das so eine Sache. Da klappt das Tarzanspiel von einst nicht mehr wie geplant und der vollschlanke Eric (Kevin James) bleibt mit dem Seil am Baum hängen.“"
                            },
                            {
                                "example_id": "94ada700-876b-437c-a6e2-e4723d684d4d",
                                "sense_id": "79678bbc-f569-3f2c-bef1-d229cc104968",
                                "text": "„Es war so, als wäre mir nicht nur mein Tarzanspiel verdorben, sondern der ganze Frühling irgendwie vermasselt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
