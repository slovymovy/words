                            {
                                "example_id": "f3cc65cf-4e73-4339-aeb9-24a0e3f1066a",
                                "sense_id": "bcd74ae1-de5b-3534-a0c4-f29cbee6bf12",
                                "text": "De doos was erg gewichtig en moeilijk te tillen.",
                                "translation": "The box was very heavy and hard to lift.",
                                "english": "The box was very heavy and hard to lift."
                            },
                            {
                                "example_id": "e318fcea-2f29-48f8-ae05-8242a88d9f00",
                                "sense_id": "bcd74ae1-de5b-3534-a0c4-f29cbee6bf12",
                                "text": "Hij sprak met een gewichtige stem, waardoor iedereen aandachtig luisterde.",
                                "translation": "He spoke with a weighty voice, capturing everyone's attention.",
                                "english": "He spoke with a weighty voice, capturing everyone's attention."
                            }
                        ]
                    },
