                "senses": [
                    {
                        "sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                        "entry_id": "7ab58fb4-9bcd-3a48-87a2-d99c90b92f8e",
                        "glosses": [
                            "lichamelijke schade met name aangericht in een ongeluk of gevecht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418ba88c-7fe7-4938-92f4-288b220151fb",
                                "sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                                "text": "Het motorongeluk veroorzaakte gelukkig weinig permanent letsel bij hem."
                            },
                            {
                                "example_id": "cb2f25e0-63a9-4ecf-9c83-c9c79d167748",
                                "sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                                "text": "Dat moet veranderen, vindt minister Madlener van Infrastructuur, want elk jaar belanden veel mensen na een fietsongeluk op de spoedeisende hulp. Vorig jaar waren dat 74.300 fietsers, van wie 48.900 met ernstig letsel, blijkt uit nieuwe cijfers van VeiligheidNL. En de groep met ernstig letsel wordt steeds groter."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e84140b-a8e9-4335-a566-bfc2817a06dd",
                        "source_entry_id": "7ab58fb4-9bcd-3a48-87a2-d99c90b92f8e",
                        "source_sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                        "source_sense_description": "lichamelijke schade met name aangericht in een ongeluk of gevecht",
                        "target_lang_word": "Verletzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verletzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "eine Beschädigung von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91166979-0281-4914-acc6-3ea838d69718",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "„Bei den von mir untersuchten Wagnissportarten Bergsteigen, Fallschirmspringen, Gleitschirm-, Drachen-, Segelfliegen und Bungeespringen wird – gemessen an der Anzahl der Einzelaktionen, der Betätigungsdauer und der Schwere der Verletzungen – ein Gefährdungslevel unterschritten, der in anderen gesellschaftlichen Bereichen (z.B. dem Straßenverkehr) und in Volkssportarten (Fußball, Abfahrtski) allgemein toleriert wird.“"
                                            },
                                            {
                                                "example_id": "43baee43-193d-45a1-b6b7-5bde7cfec572",
                                                "sense_id": "b75477ea-7ddc-3440-b188-b905e5dbb55f",
                                                "text": "Ich habe mir gestern eine Verletzung der Milz zugezogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                        "entry_id": "2a5a2490-5b86-385a-8cfe-f39ab89b127a",
                                        "glosses": [
                                            "das Übertreten eines Gebotes, einer Grenze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e952727-0649-45db-914d-094ff0f1efb3",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "Es war eine schwere Verletzung der Aufsichtspflicht."
                                            },
                                            {
                                                "example_id": "b0c6ccb7-14cc-48a6-9b19-d9a5ae287a67",
                                                "sense_id": "64e1679e-531f-3126-a052-77a50681a514",
                                                "text": "„Wir glauben kaum nötig zu haben, unsern Lesern die Tatsache zu bestätigen, die der Squire soeben erzählte und die, wie wir wissen, genau dahin ging, daß der berühmte Sieger wirklich zu dieser Geldstrafe wegen Verletzung der Habeascorpusakte während seines Oberbefehls verurteilt wurde: eine Strafe, der er sich auch willig unterzog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6909eb98-c13f-4b21-b68f-02b027c991ee",
                        "source_entry_id": "7ab58fb4-9bcd-3a48-87a2-d99c90b92f8e",
                        "source_sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                        "source_sense_description": "lichamelijke schade met name aangericht in een ongeluk of gevecht",
                        "target_lang_word": "harm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Physical injury; hurt; damage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87d2d36-9634-4ca0-88f0-962d53317db8",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "You can do a lot of harm to someone if you kick them in the teeth."
                                            },
                                            {
                                                "example_id": "94f28af4-5332-4b8a-9640-595be76f35cb",
                                                "sense_id": "cfdaed99-858a-3ce3-b3c7-d197d20d8251",
                                                "text": "No harm came to my possessions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Emotional or figurative hurt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7279cb7-6f49-43aa-93bf-3140196c8297",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "Although not physically injured in the car accident, she received some psychological harm."
                                            },
                                            {
                                                "example_id": "5922821c-9c6c-411f-ab62-66f8d907848b",
                                                "sense_id": "73c3c7b4-f7f8-350f-a340-e78fc69d5070",
                                                "text": "And Vickers launched forth into a tirade very different from his platform utterances. He spoke with extreme contempt of the dense stupidity exhibited on all occasions by the working classes. He said that if you wanted to do anything for them, you must rule them, not pamper them. Soft heartedness caused more harm than good."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "Detriment; misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55b6a2d6-95db-4971-9d30-1c52892bbf7f",
                                                "sense_id": "8f72db51-9adc-388b-a487-dcfe42eb7aeb",
                                                "text": "I wish him no harm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                        "entry_id": "6e0f3269-f82d-3ffa-ac57-899b01003265",
                                        "glosses": [
                                            "That which causes injury, damage, or loss."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f0401c-956e-4e3c-a741-e2c55552964c",
                                                "sense_id": "b82f5774-c4e6-368d-a9a8-69a7d12da4c1",
                                                "text": "We, ignorant of ourselves, / Beg often our own harms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "harm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                        "entry_id": "7a954a5c-e442-302d-b4be-b1f7d7e65c5e",
                                        "glosses": [
                                            "To damage, hurt, or injure something, usually an inanimate object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75d11b4-c576-4454-a85f-9c6de440fe3a",
                                                "sense_id": "05de3270-c097-33e9-972c-27360469aafc",
                                                "text": "Will justice and conscience of society not be harmed if people avoid the truth?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a483094-8f01-4b4a-8161-386beb7271e1",
                        "source_entry_id": "7ab58fb4-9bcd-3a48-87a2-d99c90b92f8e",
                        "source_sense_id": "89005708-3d91-3e2f-b75f-b66771919901",
                        "source_sense_description": "lichamelijke schade met name aangericht in een ongeluk of gevecht",
                        "target_lang_word": "trauma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trauma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "Any serious injury to the body, often resulting from violence or an accident."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff17aa2-d0b8-4c3e-a291-ef58d0390d8c",
                                                "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                                "text": "Repeated trauma or shaking to the brain can be even worse, leading to chronic traumatic encephalopathy, or CTE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An emotional wound leading to psychological injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a38e053-0fdc-47c8-9406-0d81113336dd",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "Jailing her on Wednesday, magistrate Liz Clyne told Robins: \"You have shown little remorse either for the death of the kitten or the trauma to your former friend Sarah Knutton.\" She was also banned from keeping animals for 10 years."
                                            },
                                            {
                                                "example_id": "a7ae946b-cb5a-49ee-ac41-6c1d3cc13e37",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "And although it doesn’t mean acting like an infant again, it does require recognizing that many of the thoughts and behaviors you’d like to change come from lingering feelings of childhood traumas or your inner child, said Dr. Avigail Lev, a licensed clinical psychologist at the Bay Area CBT Center in San Francisco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430edc1e-4d14-321f-a4a3-aed0542f87b6",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An event that causes great distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2952f391-a74e-49f2-a2a0-10823aa0ba85",
                        "source_entry_id": "7ab58fb4-9bcd-3a48-87a2-d99c90b92f8e",
