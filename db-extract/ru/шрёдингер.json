                    },
                    {
                        "translation_id": "68ad60fc-cbab-44c5-b46a-dcf328f8ba59",
                        "source_entry_id": "b183d5ac-ca3e-3733-b277-3595c9169cbb",
                        "source_sense_id": "29a65c25-80d3-3f86-93b4-8ae3e222c01a",
                        "target_lang_word": "Schrödinger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schrödinger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                        "entry_id": "85b7bd53-77a2-3be9-ad34-d06c1d5e12fe",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7bf7bb-e900-403f-b864-fd8df91fcad9",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "„Die Gleichung wurde 1926 von Erwin Schrödinger (1887–1961) zuerst als Wellengleichung aufgestellt und schon bei ihrer ersten Anwendung erfolgreich zur Erklärung der Spektren des Wasserstoffatoms genutzt.“"
                                            },
                                            {
                                                "example_id": "811af14b-abd1-411e-838e-7897ff08d91b",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "„Bei Schrödingers Katze handelt es sich um ein Gedankenexperiment aus der Physik, das 1935 von Erwin Schrödinger vorgeschlagen wurde.“"
                                            },
                                            {
                                                "example_id": "561d30d5-95d2-430e-b137-dcc6aeeedb08",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Frau Schrödinger ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "98fd210d-7d92-458a-934a-4bf4f1e85e3c",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Herr Schrödinger wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "150430b4-f754-40e2-abc3-815cc30219e3",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Die Schrödingers kommen heute vom Attersee."
                                            },
                                            {
                                                "example_id": "54d79e31-ebf0-4445-858b-50e91193110a",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Der Schrödinger trägt nie die Schals, die die Schrödinger ihm strickt."
                                            },
                                            {
                                                "example_id": "bcba5729-24cf-40bb-b7ff-603c4ceb095b",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schrödinger kommt, geht der Herr Schrödinger.“"
                                            },
                                            {
                                                "example_id": "45a3f276-acb2-4cb0-b0fa-f1977cebcf8a",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Schrödinger kommt und geht."
                                            },
                                            {
                                                "example_id": "14393f0b-28ae-4cd9-bd69-c78f4674b638",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "Schrödingers kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "84d2aa83-9864-498a-96ec-fb69db9edfaa",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "An verregneten Herbsttagen ist Familie Schrödingers liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "4313b4cf-7533-411b-abad-2decf463cd09",
                                                "sense_id": "d695d093-47f3-3d93-b0bf-af3030448bac",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Schrödinger das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
