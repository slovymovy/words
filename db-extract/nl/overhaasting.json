                        "sense_id": "68e373d0-5c3f-3468-aa48-39a00901c8b0",
                        "entry_id": "1b5224d8-99e1-3ac2-94d2-15140d1f0be7",
                        "glosses": [
                            "met te grote spoed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6396513-015e-4365-a348-8c328615538a",
                                "sense_id": "68e373d0-5c3f-3468-aa48-39a00901c8b0",
                                "text": "Petter van Raalte, cultureel ondernemer: „Als het voldoende humanistisch is, ben ik voor. Ik ben benieuwd of het loopt. We hebben in de Gouvernestraat indertijd ook films vertoond over levensvragen, en daar was veel waardering voor, maar het liep niet storm. Het past bij de tijd, waar in de overhaasting van sociale media, toenemend behoefte ontstaat aan ‘echte’ sociale contacten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64e71791-fbeb-47c2-89e0-909b56be03a9",
                        "source_entry_id": "1b5224d8-99e1-3ac2-94d2-15140d1f0be7",
                        "source_sense_id": "68e373d0-5c3f-3468-aa48-39a00901c8b0",
                        "target_lang_word": "improvidence",
