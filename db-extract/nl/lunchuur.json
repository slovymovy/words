                        "entry_id": "49f41858-e7f4-3d37-9288-9ad4176c84c0",
                        "glosses": [
                            "periode van de dag dat men een pauze heeft van het werk om het middageten te gerbuiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb920897-2872-4e57-b438-3c2b5654de94",
                                "sense_id": "c2a62b63-89d9-39ac-b302-252726ed2895",
                                "text": "De klus was dinsdagochtend nog voor het lunchuur geklaard. De bomenploeg van de gemeente Oldenzaal had slechts enkele uren nodig om in totaal twaalf lindes langs de Prinses Beatrixstraat, tussen Spoorstraat en Prins Hendrikstraat, neer te halen."
                            },
                            {
                                "example_id": "743ceb34-7d6c-48a8-8171-8e672030a229",
                                "sense_id": "c2a62b63-89d9-39ac-b302-252726ed2895",
                                "text": "De telefoons in het callcenter van het failliete Slotervaartziekenhuis staan roodgloeiend. Al tegen het lunchuur was er ruim 1300 keer gebeld, nu al drie keer zoveel als op een normale dag."
                            }
                        ]
                    }
