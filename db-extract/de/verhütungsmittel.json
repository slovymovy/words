                        "glosses": [
                            "Mittel zur Empfängnisverhütung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37a95614-791e-4205-9075-5e7df60c12c7",
                                "sense_id": "ccf69f6c-e98f-3ee1-98de-16245ff1ef86",
