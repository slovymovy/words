                                    },
                                    {
                                        "sense_id": "641e752c-bbf4-3566-baee-b7f3688ee38d",
                                        "entry_id": "e6f52add-effa-331c-a36a-e7ddac136a47",
                                        "glosses": [
                                            "A person employed to find suitable music to accompany silent films."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dfb633a-6426-4ce9-af49-96181539991e",
                                                "sense_id": "641e752c-bbf4-3566-baee-b7f3688ee38d",
                                                "text": "For the fitter of film music in the silent era visual reference was the surest indicator of content."
                                            }
                                        ]
                                    }
                                ]
                            },
