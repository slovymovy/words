        "fr-extract.jsonl": [
            {
                "entry_id": "8277811d-be11-389b-835d-f47b449259fe",
                "word": "immanquable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2aba496-6642-4549-bd26-68d25f454ce5",
                        "entry_id": "8277811d-be11-389b-835d-f47b449259fe",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "immanquables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b72145c5-1fa0-3c50-8262-36defa9f07a4",
                        "entry_id": "8277811d-be11-389b-835d-f47b449259fe",
                        "glosses": [
                            "Inévitable. Qui ne peut manquer d’être, qui ne peut manquer d’arriver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b80dc294-a646-477c-8538-fd6df29ba043",
                                "sense_id": "b72145c5-1fa0-3c50-8262-36defa9f07a4",
                                "text": "La piété, les vertus, la libéralité et les mérites de l’étranger furent bientôt connus de toute la ville de Berlin, et, comme cela était immanquable, le bruit de sa réputation parvint aux oreilles de l’électeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "3545c0ac-9ab2-3afa-823c-0e84314cb2b4",
                        "entry_id": "8277811d-be11-389b-835d-f47b449259fe",
                        "glosses": [
                            "Infaillible, inratable. Qui ne peut ou qu’on ne peut manquer de réussir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2bcc1a-00ba-4b52-9bda-018b48b0c833",
                                "sense_id": "3545c0ac-9ab2-3afa-823c-0e84314cb2b4",
                                "text": "Certes, la vertu du saint ne peut être qu’immanquable quand on sait quel extraordinaire miracle fut le sien, aux temps lointains où il était en vie."
                            }
                        ]
                    },
                    {
                        "sense_id": "6151d96f-e778-303f-9421-24d02ae235b2",
                        "entry_id": "8277811d-be11-389b-835d-f47b449259fe",
                        "glosses": [
                            "Qu’il ne faut surtout pas manquer, où il faut absolument être présent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57d2aed-df16-480c-9822-7dda5666ad19",
                                "sense_id": "6151d96f-e778-303f-9421-24d02ae235b2",
                                "text": "Puisque vous serez probablement en train de roupiller pendant que Franck Ferrand lira ses notes, 20 Minutes vous propose trois sites immanquables du tracé de cette année, sous le contrôle d’Alain Cassaigne, auteur de plusieurs ouvrages sur le patrimoine hexagonal."
                            }
                        ]
                    }
                ],
