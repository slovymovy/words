                        "examples": [
                            {
                                "example_id": "6097226b-ca4c-4e1f-9569-04ba6433ad0b",
                                "sense_id": "69b607e2-a5cc-3a7a-9f10-c5c864ce5479",
                                "text": "Pelagea Danilovna Meljoekova, een struise, energieke vrouw, zat met haar bril op in een ruimvallend gewaad in de salon, omringd door haar dochters, die ze probeerde aangenaam bezig te houden."
                            },
                            {
                                "example_id": "64689fe5-ec21-43d3-a048-2766f167df17",
                                "sense_id": "69b607e2-a5cc-3a7a-9f10-c5c864ce5479",
                                "text": "Ik vind het moeilijk om mijn verhaal te vertellen, omdat ik bang ben veroordeeld te worden, dat mensen vinden dat je het hebt uitgelokt. Wat ik ook ernstig vind, is dat ik zou moeten melden dat ik géén hockeyrokje droeg, maar een trainingsbroek en een ruimvallend sportvest."
                            }
                        ]
                    }
