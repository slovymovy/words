                                        "sense_id": "82f30f57-10ef-3c94-949f-224cfc3c6aad",
                                        "entry_id": "40d4d5e5-8f08-3df2-a779-c403ceba41e3",
                                        "glosses": [
                                            "Of or pertaining to prescribing or enjoining, especially an action or behavior based on a norm or standard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee019645-6f39-4e67-bc23-adf40663b01d",
                                                "sense_id": "82f30f57-10ef-3c94-949f-224cfc3c6aad",
                                                "text": "For one thing, spoken language tends to be less subjected to prescriptive\n pressures than written language, and hence is a less artificial medium of com-\n munication (written language is often a kind of 'censored' version of spoken\n language). [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
