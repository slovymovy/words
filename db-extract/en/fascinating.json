                                    {
                                        "sense_id": "9e88783a-f5de-3a59-9cc3-a8ef19488897",
                                        "entry_id": "7f75b5d0-d735-3794-8332-7971815f8bc2",
                                        "glosses": [
                                            "Qui suscite une profonde attirance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ececd8-ea83-4359-bd4c-0e236d0be0ff",
                                                "sense_id": "9e88783a-f5de-3a59-9cc3-a8ef19488897",
                                                "text": "Rien n’a pu effacer le souvenir de la sauvagerie de la pointe du Raz et de la Baie des Trépassés, et l’horreur fascinante de la mer mugissant dans l'enfer de Plogoff."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fascinant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01b8055e-fa98-3ebe-aab6-b278e5181a3c",
                                        "entry_id": "94b8acab-973e-3275-9bb1-c2462587e2d5",
                                        "glosses": [
                                            "Participe présent du verbe fasciner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf60d6fc-c67d-46b5-933c-3c925e600e44",
                                                "sense_id": "01b8055e-fa98-3ebe-aab6-b278e5181a3c",
                                                "text": "Parmi les autres véhicules, le pick-up se distinguait du troupeau comme un animal issu des âges préhistoriques fascinant immédiatement les quelques gamins embarqués, yeux grands ouverts, attirés par cette chose ferrailleuse, imposante comme une armure d’iguanodon agrémentée d’amulettes en plastoc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42b7f56a-ab3d-4457-bc96-a428db2887cc",
                        "source_entry_id": "0eebac26-6464-34b1-a6ef-15ef0cfbc0ca",
                        "source_sense_id": "c3c3e5a9-342f-3727-a5c5-55de21566f5f",
                        "source_sense_description": "having interesting qualities; captivating; attractive",
                        "target_lang_word": "passionnant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                        "entry_id": "fdb56cc1-716b-3b02-8c51-399922d0fb45",
                                        "glosses": [
                                            "Qui passionne, qui est propre à passionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f515f21b-224d-4084-a1aa-3f3b688c05fc",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "La Canasta peut réunir de deux à six joueurs ; mais elle est surtout passionnante quand elle peut être pratiquée par deux équipes de deux joueurs."
                                            },
                                            {
                                                "example_id": "a3b1894f-e727-4354-b25c-26fe27d39b98",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Fort heureusement pour moi, il n’eut pas le temps de m'expliquer plus avant tout l'intérêt qu’offrait la manière dont il eût souhaité que je conjuguasse mes verbes. Quelqu'un, en effet, venait d'arriver, interrompant dans l’œuf un développement qui risquait d'être plus passionné que passionnant."
                                            },
                                            {
                                                "example_id": "414f8e9a-7555-4c7b-9ff9-ebe93a563403",
                                                "sense_id": "77620e1c-5526-340f-9ff6-911301bb85d7",
                                                "text": "Parce que Charlie Roquin a le talent de nous émerveiller dans ces joutes oratoires wagnériennes, passionnantes, tout en maintenant une pression sur le lecteur quant à l’issue de cette confrontation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "passionnant",
                                "target_lang_code": "fr",
                                "target_senses": [
