                "senses": [
                    {
                        "sense_id": "f5fe97e6-7bf0-348e-8ec7-b6f99f48fb86",
                        "entry_id": "b0915ea5-89ab-3d41-a633-6420f6d8b0f3",
                        "glosses": [
