                "senses": [
                    {
                        "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                        "entry_id": "1740e126-8977-3fac-b9cb-bd55dab4183d",
                        "glosses": [
                            "Qualifie les caractères alphabétiques dont se servaient les Arabes avant le quatrième siècle de l’hégire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13bc1be4-bc58-430e-849f-51453ef26e2b",
                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                "text": "Entrons plus avant dans la texture de la page coufique."
                            },
                            {
                                "example_id": "89aec80b-54f1-43fd-9a42-3e130e83e054",
                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                "text": "Une signature typiquement coufique, puisque cette variante de la calligraphie arabe se caractérise par une exagération des horizontales et des verticales."
                            },
                            {
                                "example_id": "a5955799-3f57-4e0d-91f4-cacbcdc85a66",
                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                "text": "Non moins curieux sont les bordures et les encadrements faits de caractères arabes, allant jusqu'à des transcriptions en coufique de passages du Coran (à Moissac, au Puy, à Saint-Guilhem-le-Désert dans l'Hérault)."
                            },
                            {
                                "example_id": "3ffea1a6-7f5d-45d2-8f91-c770770c3e65",
                                "sense_id": "b0bca231-540a-307d-bd1f-1938bb153894",
                                "text": "L’écriture coufique."
                            }
                        ]
                    }
                ],
