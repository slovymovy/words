                        ],
                        "examples": [
                            {
                                "example_id": "423a9aa6-aa5b-4029-96f5-948017c26a05",
                                "sense_id": "7b52a20a-ace4-3b17-8cb0-e2fae073a92d",
                                "text": "On a bien songé ajouter une étagère mais vu le caillon régnant dans la cambuse, ça reviendrait à installer un lit à baldaquin dans une Trabant."
                            }
                        ]
