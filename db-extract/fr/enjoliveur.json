                    },
                    {
                        "form_id": "3fbf623e-eff9-4364-ba4f-8e7f82e8701d",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "enjoliveuse"
                    },
                    {
                        "form_id": "42dde6d3-dea7-4d5b-a031-6414a59c2045",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "enjoliveuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c7c382c-a76d-3dad-91a5-58b23e9c0c80",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "glosses": [
                            "Celui dont le métier est de faire des enjolivures."
                        ],
                        "tags": [
                            "Anciennement"
                        ],
                        "examples": [
                            {
                                "example_id": "95cc1065-08f8-4078-a93b-3de01348a403",
                                "sense_id": "9c7c382c-a76d-3dad-91a5-58b23e9c0c80",
                                "text": "Enjoliveur. Quoique ce nom convienne en général à tous ceux qui ajustent, parent, ornent ou enrichissent quelque ouvrage, il est particulier aux plumassiers, doreurs de cuirs, bouquetiers, qui, dans leurs statuts, prennent le nom d'enjoliveurs ainsi que les patenôtriers & boutonniers."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5c007bb-1f3f-3009-81af-85cc5aee49ca",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "glosses": [
                            "Celui qui aime à enjoliver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515de4e2-4411-492d-b3d0-f03cfecacacb",
                                "sense_id": "d5c007bb-1f3f-3009-81af-85cc5aee49ca",
                                "text": "De jolis petits soldais, de jolis petits canons, de jolis petits campements, de jolis petits sièges : ce sont là les dessins de cet artiste, qui s’engagea pour voir la guerre de près, et qui n’en a jamais été que l’enjoliveur et le bistreur coquet."
                            },
                            {
                                "example_id": "b554f074-3c8f-4c35-8b3b-c1b34ca78333",
                                "sense_id": "d5c007bb-1f3f-3009-81af-85cc5aee49ca",
                                "text": "Mais l’enjoliveuse n’enjolive pas ; elle vend des enjolivures (ou enjolivements)."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa04490c-1055-367f-b3bf-f048e68e4f02",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "glosses": [
                            "Objet qui enjolive."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "acd15fd7-b4e1-3873-a6ff-da4c609fe46b",
                        "entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "glosses": [
                            "Flasque posée sur la jante de la roue d’un véhicule pour en masquer l’apparence."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "759e3fd5-8991-4200-b38f-610a59fd8616",
                        "source_entry_id": "87348c72-1a40-38e4-990b-c504f205c5b7",
                        "source_sense_description": "flasque posée sur la roue d’un véhicule pour en masquer l’apparence",
                        "target_lang_word": "Radkappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radkappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                        "entry_id": "793af69d-b0cf-3a7f-b07f-5555f2303014",
                                        "glosses": [
                                            "Abdeckung der Felge eines Reifens / Nabe eines Rades"
                                        ],
                                        "tags": [
                                            "Automobil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3492d25-5d67-4920-b4c7-4c5ab1cf6e04",
                                                "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                                "text": "Bei meinen Winterreifen montiere ich nie die Radkappen."
                                            },
                                            {
                                                "example_id": "751fc595-a7f6-4ad5-ba03-1da0ba0f3d45",
                                                "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                                "text": "Bis unters Dach ist die Auto-Werkstatt vollgepackt mit Radkappen, Reifen und Werkzeugen jeglicher Art."
                                            },
                                            {
                                                "example_id": "3e58ac1a-8aff-44f1-beaf-32e658452eb7",
                                                "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                                "text": "Sogar Kunststoffe lassen sich aus dem Chinagras fertigen. So gibt es bereits Lenkräder, Stoßstangen und Radkappen aus dem pflanzlichen Alleskönner."
                                            },
                                            {
                                                "example_id": "eff6e0a8-2a08-4bd1-a74c-e45d5e3e1a86",
                                                "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                                "text": "Wenn Ptolemy Elrington Radkappen in Straßengräben findet, entsteht daraus etwas völlig Neues: Seine Hubcap Creatures."
                                            },
                                            {
                                                "example_id": "c5c61f9d-6295-4b03-87cb-298a571139c6",
                                                "sense_id": "33358d29-cc33-3baf-ae97-a02887ab1ae3",
                                                "text": "„Wenn Sie eine Sekunde warten, bitte, wir schauen uns gerade noch im Fahrzeug um.“ Die Verstecke [um Bargeld über die Grenze zu schmuggeln] reichen vom Verbandskasten über die Radkappe bis zur Unterhose."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
