                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3ea98121-1e81-3e06-a25d-14b22d5a5f92",
                        "entry_id": "8063d443-35ef-3811-bd87-32bc75fe8406",
                        "glosses": [
                            "D’une manière superstitieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901dae24-aa39-4368-bf60-432dfb0f3923",
                                "sense_id": "3ea98121-1e81-3e06-a25d-14b22d5a5f92",
                                "text": "Croire superstitieusement aux revenants."
                            },
                            {
                                "example_id": "709bd6a9-208a-451c-8559-ff92b4493f50",
                                "sense_id": "3ea98121-1e81-3e06-a25d-14b22d5a5f92",
                                "text": "On pouvait même dire qu’en plusieurs circonstances, les chefs avaient superstitieusement abusé de ce merveilleux poivrot qui bronchait depuis un quart de siècle sans pouvoir dégringoler, que les balles ne pouvaient jamais atteindre et qui démolissait tout devant lui."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fba3844-d60f-3701-8a6b-6db66f8ef215",
                        "entry_id": "8063d443-35ef-3811-bd87-32bc75fe8406",
                        "glosses": [
                            "En portant l’exactitude, le scrupule jusqu'à l’excès."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d043e4ed-07ab-475b-a228-25aceaa56805",
                                "sense_id": "4fba3844-d60f-3701-8a6b-6db66f8ef215",
                                "text": "Il ne faut pas s'attacher superstitieusement aux choses indifférentes."
                            },
                            {
                                "example_id": "9d94e5c2-c5ce-4ffa-a93e-716272d946ff",
                                "sense_id": "4fba3844-d60f-3701-8a6b-6db66f8ef215",
                                "text": "Une enfant superstitieusement attachée aux fêtes des saisons, aux dates marquées par un cadeau, une fleur, un traditionnel gâteau…"
                            }
                        ]
                    }
                ],
