                    },
                    {
                        "translation_id": "af4a7305-d202-42e6-9e41-dcce24079bc4",
                        "source_entry_id": "ffedcc74-2528-37aa-b0e1-7b266dc37396",
                        "source_sense_id": "74b447af-3645-3872-b1a5-ca13a6f61f1d",
                        "target_lang_word": "dépravation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépravation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24f7252e-6caa-3c4d-9348-0d4b8a303b89",
                                        "entry_id": "207f9d4c-4b3a-3efc-9d0c-51b41455404e",
                                        "glosses": [
                                            "État de ce qui est dépravé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf615839-da5b-419a-980b-a96017696d42",
                                                "sense_id": "24f7252e-6caa-3c4d-9348-0d4b8a303b89",
                                                "text": "Le sieur Jean-Paul-Stanislas Marneffe appartenait à cette nature d’employés qui résiste à l’abrutissement par l’espèce de puissance que donne la dépravation."
                                            },
                                            {
                                                "example_id": "a33d4245-080f-4f5b-8df1-8355549a8b62",
                                                "sense_id": "24f7252e-6caa-3c4d-9348-0d4b8a303b89",
                                                "text": "Si c’est le désir d’animer votre monotone existence de jeune fille curieuse qui vous a mis la plume à la main, ceci n’a-t-il pas l’apparence d’une dépravation ?"
                                            },
                                            {
                                                "example_id": "bb5732ff-5710-493a-95f7-b16a0972c385",
                                                "sense_id": "24f7252e-6caa-3c4d-9348-0d4b8a303b89",
                                                "text": "Cette naïveté de dépravation causa au comte de Morvelle un sentiment de dégoût qu'il aurait eu peine à contenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "546e07d9-e636-3339-8aee-b1ab6642603c",
                                        "entry_id": "207f9d4c-4b3a-3efc-9d0c-51b41455404e",
                                        "glosses": [
                                            "Vice de quelqu'un, de quelque chose, qui a de mauvaises mœurs, qui est sans moralité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26346402-5442-4857-8f60-82b6223208ca",
                                                "sense_id": "546e07d9-e636-3339-8aee-b1ab6642603c",
                                                "text": "Quant aux gens qui, par peur de l'enfantement, se condamnent à la continence absolue, il est avéré qu'ils sont incomparablement plus que les autres individus, portés à des dépravations bien plus néfastes, à tous les points de vue, que ne le sont les pires abus dans les rapports normaux."
                                            },
                                            {
                                                "example_id": "f69dd31b-9c13-48ca-92c0-1faabd00dba3",
                                                "sense_id": "546e07d9-e636-3339-8aee-b1ab6642603c",
                                                "text": "A ces dévergondages, à ces déliquescences, à ces dépravations, il y a de douloureuses conséquences. […] ; une partie de la jeunesse aurait été atteinte en sa constitution physique, aux sources mêmes de la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
