                {
                    "sense_id": "5f164be6-3d66-33c8-952c-adae8e891baa",
                    "sense_definition": "The profession of acting or the world of theatre as an art form.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "platform_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to leave the <w>stage</w> after thirty years of acting in plays.",
                            "target_lang_translations": {
                                "ru": "Он решил уйти со <w>сцены</w> после тридцати лет игры в спектаклях.",
                                "tr": "Oyunlarda otuz yıl oyunculuk yaptıktan sonra <w>sahneyi</w> bırakmaya karar verdi.",
                                "zh": "在演了三十年戏后，他决定告别<w>舞台</w>。"
                            }
                        },
                        {
                            "text": "Many famous movie stars started their careers on the <w>stage</w>.",
                            "target_lang_translations": {
                                "ru": "Многие известные кинозвезды начинали свою карьеру на <w>сцене</w>.",
                                "tr": "Birçok ünlü film yıldızı kariyerine <w>tiyatroda</w> başladı.",
                                "zh": "许多著名的电影明星都是从<w>舞台</w>开始他们的职业生涯的。"
                            }
