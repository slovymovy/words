{
    "word_family": [
        "infernal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b785192c-32c2-3086-b915-587e5077df41",
                    "sense_definition": "A large, intense, and out-of-control fire that causes significant destruction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inferno</w> ripped through the forest, destroying anything in its path.",
                            "target_lang_translations": {
                                "ru": "Бушующее <w>пламя</w> пронеслось по лесу, уничтожая всё на своём пути."
                            }
                        },
                        {
                            "text": "Firefighters struggled for hours to contain the towering <w>inferno</w> that had engulfed the warehouse.",
                            "target_lang_translations": {
                                "ru": "Пожарные часами пытались сдержать гигантское <w>пламя</w>, охватившее склад."
                            }
                        }
                    ],
                    "common_phrases": [
                        "towering inferno",
                        "raging inferno",
                        "blazing inferno"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный, интенсивный и неконтролируемый пожар, вызывающий значительные разрушения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "адское пламя",
                                "target_lang_sense_clarification": "о сильном огне"
                            },
                            {
                                "target_lang_word": "бушующее пламя",
                                "target_lang_sense_clarification": "о неконтролируемом огне"
                            },
                            {
                                "target_lang_word": "пекло",
                                "target_lang_sense_clarification": "место, где сосредоточен сильный огонь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29f17d87-51e0-3f14-a8d4-328aa0757fe1",
                    "sense_definition": "A place or situation that is extremely unpleasant, chaotic, or resembles Hell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hellish situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory floor was a living <w>inferno</w> of noise, heat, and dangerous machinery.",
                            "target_lang_translations": {
                                "ru": "Заводской цех был настоящим <w>адом</w> из шума, жары и опасного оборудования."
                            }
                        },
                        {
                            "text": "At each sudden explosion in the <w>inferno</w> below they sprang back from the brink of the volcanic crater.",
                            "target_lang_translations": {
                                "ru": "При каждом внезапном взрыве в бушующем внизу <w>пекле</w> они отпрянули от края вулканического кратера."
                            }
                        }
                    ],
                    "synonyms": [
                        "afterlife"
                    ],
                    "common_phrases": [
                        "living inferno",
                        "veritable inferno"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место или ситуация, которые крайне неприятны, хаотичны или напоминают ад."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ад",
                                "target_lang_sense_clarification": "мучительная обстановка или ситуация"
                            },
                            {
                                "target_lang_word": "пекло",
                                "target_lang_sense_clarification": "опасное или невыносимо жаркое место"
                            },
                            {
                                "target_lang_word": "преисподняя",
                                "target_lang_sense_clarification": "в переносном смысле о хаосе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}