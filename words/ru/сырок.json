{
    "word_family": [
        "сыр",
        "сырный",
        "сыровар",
        "сыроварня"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cecc54e8-c53a-3ca2-b1ea-23881d04d740",
                    "sense_definition": "Небольшой брусок из творожной массы, часто глазированный шоколадом.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столик шлепнулся пакетик с глазированными <w>сырками</w>.",
                            "target_lang_translations": {
                                "de": "Ein Tütchen mit glasierten <w>Quarkriegeln</w> landete auf dem Tisch."
                            }
                        },
                        {
                            "text": "Ребёнку нужно обязательно дать в школу что-нибудь вкусное: яблоко, банан, бутерброд, творожный <w>сырок</w>, хрустящие хлебцы.",
                            "target_lang_translations": {
                                "de": "Man muss dem Kind unbedingt etwas Leckeres für die Schule mitgeben: einen Apfel, eine Banane, ein belegtes Brot, einen <w>Quarkriegel</w> oder Knäckebrot."
                            }
                        }
                    ],
                    "synonyms": [
                        "творог"
                    ],
                    "common_phrases": [
                        "глазированный сырок",
                        "творожный сырок"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein kleiner Riegel aus Quarkmasse, oft mit Schokolade überzogen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Quarkriegel",
                                "target_lang_sense_clarification": "Süßer Riegel aus Quark, oft schokoliert"
                            },
                            {
                                "target_lang_word": "Schokoriegel",
                                "target_lang_sense_clarification": "Allgemeiner Begriff für schokolierte Riegel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed5833b8-868f-3317-9143-be0d6dfa9b67",
                    "sense_definition": "Уменьшительно-ласкательная форма к слову <w>сыр</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы купили вкусный <w>сырок</w> к завтраку.",
                            "target_lang_translations": {
                                "de": "Wir haben einen leckeren <w>Käse</w> zum Frühstück gekauft."
                            }
                        },
                        {
                            "text": "На тарелке лежал маленький кусочек, настоящий <w>сырок</w>.",
                            "target_lang_translations": {
                                "de": "Auf dem Teller lag ein kleines Stück, ein echtes <w>Käschen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сыр"
                    ],
                    "target_lang_definitions": {
                        "de": "Verkleinerungsform von Käse."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Käschen",
                                "target_lang_sense_clarification": "Verniedlichung von Käse"
                            },
                            {
                                "target_lang_word": "kleiner Käse",
                                "target_lang_sense_clarification": "Ein kleines Stück Käse"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "419cf588-c092-3acc-ac77-33cbc9dd3c54",
                    "sense_definition": "Промысловая рыба семейства лососёвых, обитающая в северных водоёмах.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В северных реках часто встречается <w>сырок</w>.",
                            "target_lang_translations": {
                                "de": "In nördlichen Flüssen kommt häufig die <w>Peledmaräne</w> vor."
                            }
                        },
                        {
                            "text": "Рыбаки поймали крупный <w>сырок</w> в озере.",
                            "target_lang_translations": {
                                "de": "Die Fischer fingen eine große <w>Peledmaräne</w> im See."
                            }
                        }
                    ],
                    "synonyms": [
                        "пелядь"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Fischart aus der Familie der Lachsfische, die in nördlichen Gewässern vorkommt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Peledmaräne",
                                "target_lang_sense_clarification": "Wissenschaftliche Bezeichnung für den Fisch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}