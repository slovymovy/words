                    {
                        "sense_id": "f90a40a9-e250-3555-8b09-f6e9fcbbe3df",
                        "entry_id": "8dcb5316-6712-381f-a06c-6f0bd662ead1",
                        "glosses": [
                            "Openly declared or acknowledged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ad919d-3565-473c-9ed5-0ad6956bfb34",
                                "sense_id": "f90a40a9-e250-3555-8b09-f6e9fcbbe3df",
                                "text": "His professed religion was Catholicism."
                            }
                        ]
                    },
                    {
                        "sense_id": "3acf7012-5d4c-31ef-bb78-6ce30112f048",
                        "entry_id": "8dcb5316-6712-381f-a06c-6f0bd662ead1",
                        "glosses": [
                            "Professing to be qualified."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2991d8e-7a08-4e21-9538-7c602e6e27e2",
                                "sense_id": "3acf7012-5d4c-31ef-bb78-6ce30112f048",
                                "text": "She is a professed expert in mechanics."
                            },
                            {
                                "example_id": "c6f38239-aef4-4484-b6fc-f7763aae3f61",
                                "sense_id": "3acf7012-5d4c-31ef-bb78-6ce30112f048",
                                "text": "[…] flowers, which, if not identical with our violets, sufficiently correspond to them for the purposes of readers who are not professed botanists."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2760b44-25c7-3645-9950-126374d12df9",
                        "entry_id": "8dcb5316-6712-381f-a06c-6f0bd662ead1",
                        "glosses": [
                            "Admitted to a religious order."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72679052-30d3-466b-b9bd-901951288302",
                                "sense_id": "d2760b44-25c7-3645-9950-126374d12df9",
                                "text": "The rule of the Perpetual Adoration is so strict that it horrifies; novices hold back, and the order is not recruited. In 1845 a few lay sisters were still found here and there, but no professed nuns."
                            }
                        ]
                    }
