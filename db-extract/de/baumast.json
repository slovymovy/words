                ],
                "senses": [
                    {
                        "sense_id": "dd0f8e97-8d5a-30d2-8eac-52a6f5367e7d",
                        "entry_id": "a91c881b-7c04-3f17-900b-b810514f9bcc",
                        "glosses": [
                            "Ast eines Baumes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0825d217-12bf-486a-9c53-ae41dc2cd136",
                                "sense_id": "dd0f8e97-8d5a-30d2-8eac-52a6f5367e7d",
                                "text": "„Das unheimliche, fieberhafte Licht, das sie in jener Nacht auf jedem Baumast und jedem Holzbrett des Hauses sah, schien die Inkarnation jener schrecklichen Krankheit zu sein, über die gemunkelt wurde, und an der, wie sie fürchtete, ihr Freund litt.“"
                            },
                            {
                                "example_id": "ee688ba7-29c5-49e4-9196-8a5bf7744267",
                                "sense_id": "dd0f8e97-8d5a-30d2-8eac-52a6f5367e7d",
                                "text": "„So legte ich ihr eines Morgens eine Schlinge um den Hals und knüpfte sie an einem Baumast auf; ich erhängte sie unter strömenden Tränen und bittersten Gewissensqualen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
