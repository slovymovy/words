    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6a4e963-22d9-3513-92c3-b6dc062288c0",
                    "sense_definition": "Glamorous; stylishly attractive or charming.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>glam</w> dress to the evening gala. ",
                            "target_lang_translations": {
                                "tr": "Akşam galasına <w>havalı</w> bir elbise giydi."
                            }
                        },
                        {
                            "text": "Her <w>glam</w> look immediately caught everyone's attention on the red carpet.",
                            "target_lang_translations": {
                                "tr": "Kırmızı halıdaki <w>göz alıcı</w> tarzı hemen herkesin dikkatini çekti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glam look",
                        "glam style",
                        "glam dress"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal abbreviation of glamorous"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çekici, şık ve havalı; alımlı veya büyüleyici."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "havalı",
                                "target_lang_sense_clarification": "Şık ve çekici görünüm"
                            },
                            {
                                "target_lang_word": "büyüleyici",
                                "target_lang_sense_clarification": "Etkileyici ve alımlı"
                            },
                            {
                                "target_lang_word": "şık",
                                "target_lang_sense_clarification": "Zarif ve göz alıcı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4fd9fb2f-ff03-3efd-9c62-e456de28024a",
                    "sense_definition": "Glamour; exciting attractiveness or charm.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "glam_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Hollywood event was full of pure <w>glam</w> and elegance.",
                            "target_lang_translations": {
                                "tr": "Hollywood etkinliği saf <w>cazibe</w> ve zarafet doluydu."
                            }
                        },
                        {
                            "text": "She was captivated by the full <w>glam</w> of the high-fashion world.",
                            "target_lang_translations": {
                                "tr": "Yüksek moda dünyasının tüm <w>görkemine</w> kapılmıştı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full glam"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal shortening of glamour"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Göz alıcılık, cazibe veya büyüleyicilik."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cazibe",
                                "target_lang_sense_clarification": "Çekicilik, alım"
                            },
                            {
                                "target_lang_word": "görkem",
                                "target_lang_sense_clarification": "Göz alıcılık, şaşaa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "736abc0e-d249-3902-8b1c-c86c89a8b47d",
                    "sense_definition": "A style of rock music popular in the 1970s, characterized by outrageous costumes and makeup.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "glam_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He loves listening to 1970s <w>glam</w> on old vinyl records.",
                            "target_lang_translations": {
                                "tr": "Eski taş plaklarda 1970'lerin <w>glam rock</w> müziğini dinlemeyi seviyor."
                            }
                        },
                        {
                            "text": "The band drew heavy inspiration from early British <w>glam</w> rock.",
                            "target_lang_translations": {
                                "tr": "Grup, erken dönem İngiliz <w>glam</w> rock müziğinden büyük ölçüde ilham aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "glitter"
                    ],
                    "common_phrases": [
                        "glam rock",
                        "era of glam"
                    ],
                    "target_lang_definitions": {
                        "tr": "1970'lerde popüler olan, abartılı kostümler ve makyajla tanınan bir rock müzik türü."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "glam rock",
                                "target_lang_sense_clarification": "Müzik türü"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2bc99666-9dd2-3914-a896-a55013fc020b",
                    "sense_definition": "To make someone or something look more glamorous, especially through makeup and clothing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They like to <w>glam</w> up before going out on Saturday night.",
                            "target_lang_translations": {
                                "tr": "Cumartesi gecesi dışarı çıkmadan önce <w>süslenip püslemeyi</w> severler."
                            }
                        },
                        {
                            "text": "The stylist helped <w>glam</w> the actors for the premiere.",
                            "target_lang_translations": {
                                "tr": "Stilist, prömiyer için oyuncuları <w>hazırlayıp şıklaştırmaya</w> yardımcı oldu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "glam up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Makyaj ve giyim yoluyla birini veya bir şeyi daha çekici ve göz alıcı hale getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "süslenmek",
                                "target_lang_sense_clarification": "Kendi kendine şıklaşmak"
                            },
                            {
                                "target_lang_word": "güzelleştirmek",
                                "target_lang_sense_clarification": "Daha alımlı hale getirmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
