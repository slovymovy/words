                ],
                "senses": [
                    {
                        "sense_id": "da10c12b-6204-34a3-a260-aca9ebd0bbb4",
                        "entry_id": "ba16a825-2c48-36ab-863b-4c5cb892dfeb",
                        "glosses": [
                            "Of, or relating to the telegraph."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868e6a90-9f14-4528-967f-d8041cf6a824",
                                "sense_id": "da10c12b-6204-34a3-a260-aca9ebd0bbb4",
                                "text": "It turned out to be no more than the weekly Reuter’s telegram sent as an ordinary letter from the nearest telegraphic office fifty miles away."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d348781-6a03-3267-82ee-a72ec53d4344",
                        "entry_id": "ba16a825-2c48-36ab-863b-4c5cb892dfeb",
                        "glosses": [
                            "Brief or concise, especially resembling a telegram with clipped syntax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e60f424e-0eb2-4e97-af80-facac5c46b35",
                                "sense_id": "3d348781-6a03-3267-82ee-a72ec53d4344",
                                "text": "Her conversation, I soon found, was couched in the telegraphic style. “Weeds grow like house afire. Can’t keep even with ’em. Shall press you in. Better be careful.”"
                            },
                            {
                                "example_id": "5e81a52a-af16-4a1b-b0fd-d9fa65ed56fd",
                                "sense_id": "3d348781-6a03-3267-82ee-a72ec53d4344",
                                "text": "This section is based on […] I am presenting the facts in a telegraphic fashion; for the sources, discussion and disagreements see the five scholars I listed."
                            }
                        ]
                    }
                ],
                "translations": [
