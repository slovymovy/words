                "senses": [
                    {
                        "sense_id": "1d0bff9c-48ac-31fc-81c0-97bbc1f65b1d",
                        "entry_id": "6ca3fadb-7c6a-382c-9e8c-ab0bbd330490",
                        "glosses": [
                            "опускаться, наклоняться, свисать вниз над кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3ff26e-6b5b-46c5-84b3-4c99fd689486",
                                "sense_id": "1d0bff9c-48ac-31fc-81c0-97bbc1f65b1d",
                                "text": "От Ровнеди как бы отщепилась скала и нависла над рекой."
                            }
                        ]
                    },
                    {
                        "sense_id": "32a6cc01-df9e-3a2c-99c4-c9285d4d2846",
                        "entry_id": "6ca3fadb-7c6a-382c-9e8c-ab0bbd330490",
                        "glosses": [
                            "висеть низко над кем-либо, чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b0b2d6a-559d-49c8-a207-0e97599dcc98",
                                "sense_id": "32a6cc01-df9e-3a2c-99c4-c9285d4d2846",
                                "text": "Ветер стих, черные тучи низко нависли над местом сражения, сливаясь на горизонте с пороховым дымом."
                            }
                        ]
                    },
                    {
                        "sense_id": "12185347-f723-3394-b0ce-bab2a8be6f97",
                        "entry_id": "6ca3fadb-7c6a-382c-9e8c-ab0bbd330490",
                        "glosses": [
                            "перен. возникнув, предвещать что-либо неприятное, опасное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b210462d-ea6d-4400-a58b-2a46da42adf4",
                                "sense_id": "12185347-f723-3394-b0ce-bab2a8be6f97",
                                "text": "Теперь он лежал в своей тюрьме, под плащом, спокойный и неподвижный, а над городом нависли печаль, недоумение, стыд…"
                            }
                        ]
                    }
