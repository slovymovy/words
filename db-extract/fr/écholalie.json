                    {
                        "translation_id": "b5449c41-03bd-42ae-8ccb-fd8c73b6e84b",
                        "source_entry_id": "26d43aa4-de18-3226-92a4-a48f93c3e22c",
                        "source_sense_id": "8de3e066-c9e2-3fff-995e-7d74f50a9a2f",
