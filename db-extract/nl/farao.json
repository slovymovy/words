                    {
                        "sense_id": "cb492fbb-dcb8-3469-b39d-61b1937c1be6",
                        "entry_id": "9c19c120-93ae-34a2-a50e-a9e055d91d3e",
                        "glosses": [
                            "titel van de koning van Egypte, ook gebruikt als eigennaam; de enige farao's die in het OT bij hun eigen naam worden genoemd, zijn Chofra, Necho, Sisak en Tirhaka (274×: Gen. 12:15 +, Ex. 1:11 +, Deut. 6:21 +, 1 Sam. 2:27 +, 1 Kon. 3:1 +, 2 Kon. 17:7 +, Jes. 19:11 +, Jer. 25:19 +, Ez. 17:17 +, Ps. 135:9 +, Hoogl. 1:9, Neh. 9:10, 1 Kron. 4:18, 2 Kron. 8:11; ook 5× in NT)"
                        ],
                        "tags": [
                            "Jiddisch-Hebreeuws"
                        ],
                        "examples": [
                            {
                                "example_id": "ea071adc-011d-481d-ae08-7a1c5a0db987",
                                "sense_id": "cb492fbb-dcb8-3469-b39d-61b1937c1be6",
                                "text": "De Egyptenaren noemden hun koning zelden farao."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f644019-4b16-460f-99af-638ce82b561d",
                        "source_entry_id": "9c19c120-93ae-34a2-a50e-a9e055d91d3e",
                        "source_sense_id": "cb492fbb-dcb8-3469-b39d-61b1937c1be6",
                        "target_lang_word": "Pharao",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pharao",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f926204-6194-37ee-b6fa-a7106d8da270",
                                        "entry_id": "ea40c706-afba-37b7-b28d-fa4f20569413",
                                        "glosses": [
                                            "Titel altägyptischer Könige"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                                        "entry_id": "ea40c706-afba-37b7-b28d-fa4f20569413",
                                        "glosses": [
                                            "Träger des Titels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a86a90b-ca6c-414e-b6b9-0932207dff76",
                                                "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                                                "text": "Auf ihrer Reise durch Ägypten besuchten sie auch das Grab eines Pharaos."
                                            },
                                            {
                                                "example_id": "7b6cc2db-d191-4714-94cb-cc328b83be2f",
                                                "sense_id": "9d050129-2cdc-38b4-a8ae-8b566702c0b3",
                                                "text": "„Der Pharao trägt eine feierliche Königstitulatur aus fünf Namen, die ihrerseits jeweils aus mehreren Bestandteilen bestehen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Pharao",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0fc55df-b2fd-3ea0-b89a-e84dfe8d412a",
                                        "entry_id": "e45e551f-e4a9-3980-b182-74c6a2e434fe",
                                        "glosses": [
                                            "Glücksspiel mit Karten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01883d8b-91d1-441c-9781-c7a6fd6d24f9",
                                                "sense_id": "c0fc55df-b2fd-3ea0-b89a-e84dfe8d412a",
                                                "text": "„Wir kamen in ein Zimmer und sahen einen großen, ringsum mit vornehmen Leuten besetzen Tisch, die Pharao spielten; der Fürst hielt die Karten, und die Bank schien in Sovrano-Münzen und Dukaten wohl über dreizehn- oder vierzehntausend Gulden zu verfügen.“"
                                            },
                                            {
                                                "example_id": "0bcddc04-5207-42da-b97e-e74340938e51",
                                                "sense_id": "c0fc55df-b2fd-3ea0-b89a-e84dfe8d412a",
                                                "text": "„Ich besaß die Standhaftigkeit, den ganzen Karneval zu verbringen, ohne mein Geld im Pharao zu riskieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8172de7-dcda-4e31-95f6-f460a6c27113",
                        "source_entry_id": "9c19c120-93ae-34a2-a50e-a9e055d91d3e",
                        "source_sense_id": "cb492fbb-dcb8-3469-b39d-61b1937c1be6",
                        "target_lang_word": "pharaoh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
