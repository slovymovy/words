                        "sense_id": "453bfaa4-557e-3c5b-86ca-a0b404b37af4",
                        "entry_id": "1962f79d-3f52-3506-8dc9-ca258364c09a",
                        "glosses": [
                            "landen in het Oosten (vanuit Europa gezien), Azië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca38e65-be52-441f-8944-bca8dae18f4d",
                                "sense_id": "453bfaa4-557e-3c5b-86ca-a0b404b37af4",
                                "text": "Maar er zijn ook momenten van verstilde, vanzelfsprekende kameraadschap en spiritualiteit gevoed door sacrale muziek uit de Oriënt en het Westen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ccd35c8f-8521-4286-a87c-883624f32df2",
                        "source_entry_id": "1962f79d-3f52-3506-8dc9-ca258364c09a",
                        "source_sense_id": "453bfaa4-557e-3c5b-86ca-a0b404b37af4",
                        "target_lang_word": "east",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "east",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                        "entry_id": "8476fea3-04d1-3ec2-a429-e419cc6bd149",
                                        "glosses": [
                                            "The direction of the earth's rotation, specifically 90°."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72204c4f-0f17-4299-a6dc-239ea4d6ad4a",
                                                "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                                "text": "Portsmouth is to the east of Southampton."
                                            },
                                            {
                                                "example_id": "2b040ddd-2954-48c8-b98d-9c5fc7a7b598",
                                                "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                                "text": "We live in the east of the country."
                                            },
                                            {
                                                "example_id": "778b14ea-05ca-423e-998e-8f58cf789fd8",
                                                "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                                "text": "The sun rises in the east."
                                            },
                                            {
                                                "example_id": "4a0bd5b8-d3a9-48f5-a161-e560d66859f8",
                                                "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                                "text": "The levanter wind is in/from the east."
                                            },
                                            {
                                                "example_id": "e31a6f50-0631-4c0e-8e44-23b82ced9d86",
                                                "sense_id": "05c2c687-b0cd-38c9-9fe7-02bfc4828d61",
                                                "text": "In a few hours the birds come to it from all points of the compass – east, west, north, and south […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4734cb4-6018-3f4c-80aa-3ccd1be0d74f",
                                        "entry_id": "8476fea3-04d1-3ec2-a429-e419cc6bd149",
                                        "glosses": [
                                            "The eastern region or area; the inhabitants thereof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37bab1d0-1987-41ac-857d-94da15ebac34",
                                                "sense_id": "a4734cb4-6018-3f4c-80aa-3ccd1be0d74f",
                                                "text": "We, in the west, agreed amongst ourselves that a penitentiary should be erected with our half of the money arising as above stated; and the east agreed to improve the country in their vicinity with the other half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e6daf1b-a2e3-3feb-ab11-89043b469028",
                                        "entry_id": "8476fea3-04d1-3ec2-a429-e419cc6bd149",
                                        "glosses": [
                                            "In a church: the direction of the altar and chancel; the direction faced by the priest when celebrating ad orientem."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c878aa90-39c7-4a74-bae3-82ea6dceaa72",
                                                "sense_id": "4e6daf1b-a2e3-3feb-ab11-89043b469028",
                                                "text": "A few [Anglican churches in South Carolina, Virginia and Maryland] are oriented other than due [geographic] east—St. Paul's, St. George's, and Prince George's parish churches face northeast and St. Andrew's, southeast. […] Throughout the book I refer directionally to the altar and chancel of St. Andrew's as situated at ecclesiastical east (to avoid overcomplicating matters), not geographical or magnetic southeast. Thus, the altar is located at the east end of the church, and the gallery, at the west."
                                            },
                                            {
                                                "example_id": "fc1de767-c163-407d-9790-40249c6b475b",
                                                "sense_id": "4e6daf1b-a2e3-3feb-ab11-89043b469028",
                                                "text": "However, in Mies' chapel, liturgical east is magnetic west."
                                            },
                                            {
                                                "example_id": "81439c9a-ae81-46e9-a9f5-cccd6b55e611",
                                                "sense_id": "4e6daf1b-a2e3-3feb-ab11-89043b469028",
                                                "text": "The tapestry by Graham Sutherland that occupies the whole wall of the liturgical east and geographic north of the cathedral is recognisable to the point of visual exhaustion."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "east",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
