                        "glosses": [
                            "Relâchement de multiples œufs lors de l’ovulation, généralement obtenu médicalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18316518-3d9b-4b74-9389-9f091df62305",
                                "sense_id": "aef3df8a-f7dc-30c8-8091-073a4941ba7c",
                                "text": "Les raisons en sont l’âge plus avancé des mères et l’utilisation de la fécondation médicalement assistée, qui favorise une hyperovulation."
                            },
                            {
                                "example_id": "978f620f-8d53-46c6-9fae-87aabb9b0dd0",
                                "sense_id": "aef3df8a-f7dc-30c8-8091-073a4941ba7c",
                                "text": "Cette étape est suivie par le déclenchement artificiel d'une « hyperovulation » qui forcera ce corps à produire entre quinze et quarante ovocytes selon les pratiques cliniques."
                            }
                        ]
