            {
                "entry_id": "f1739a4e-6ad8-35fa-a34e-695dca965fbc",
                "word": "réparatrice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b535001a-0c41-409d-8abe-13d6a7eeb29f",
                        "entry_id": "f1739a4e-6ad8-35fa-a34e-695dca965fbc",
                        "tags": [
