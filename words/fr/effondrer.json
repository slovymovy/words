    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "95b07aee-defc-30c6-b447-abd3070a0772",
                    "sense_definition": "Faire crouler, abattre ou défoncer une construction ou un terrain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "crouler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La violente tempête a fait céder la charpente et a <w>effondré</w> le toit de la grange."
                        },
                        {
                            "text": "Le poids excessif de la neige a fini par <w>effondrer</w> cette vieille cabane abandonnée."
                        }
                    ],
                    "synonyms": [
                        "abattre",
                        "démolir",
                        "écrouler"
                    ],
                    "antonyms": [
                        "bâtir",
                        "édifier"
                    ],
                    "common_phrases": [
                        "effondrer le toit",
                        "effondrer le sol"
                    ]
                },
                {
                    "sense_id": "1d665f56-50c5-3baa-a21f-59169ed4c99d",
                    "sense_definition": "Chuter brutalement ou diminuer de façon spectaculaire en valeur, en force ou en moral.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moral des troupes a commencé à s'<w>effondrer</w> après cette lourde défaite."
                        },
                        {
                            "text": "Après l'annonce des mauvais résultats, la valeur de leurs actions s'est <w>effondrée</w> en bourse."
                        }
                    ],
                    "synonyms": [
                        "chuter",
                        "dégringoler"
                    ],
                    "antonyms": [
                        "augmenter",
                        "grimper"
                    ],
                    "common_phrases": [
                        "effondrer les prix",
                        "effondrer les cours"
                    ]
                },
                {
                    "sense_id": "bbbcabe0-1ea3-334b-b9a0-5d4ab9c778ac",
                    "sense_definition": "Remuer et fouiller profondément une terre en y mêlant de l'engrais.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier a <w>effondré</w> la terre sur plusieurs décimètres avant de planter la vigne."
                        },
                        {
                            "text": "Il convient d'<w>effondrer</w> ce terrain rocailleux pour permettre aux jeunes racines de pénétrer."
                        }
                    ],
                    "synonyms": [
                        "défoncer",
                        "fouiller"
                    ],
                    "common_phrases": [
                        "effondrer la terre",
                        "effondrer le sol"
                    ]
                },
                {
                    "sense_id": "0f04ed8c-c179-3959-983c-14e28bfb5421",
                    "sense_definition": "Vider les entrailles d'une volaille, d'un poisson ou d'un gibier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "boucherie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier doit <w>effondrer</w> le poisson avec précaution pour ne pas percer le fiel."
                        },
                        {
                            "text": "Avant de rôtir le poulet fermier, il faut l'<w>effondrer</w> et bien le nettoyer."
                        }
                    ],
                    "synonyms": [
                        "éviscérer",
                        "vider"
                    ],
                    "common_phrases": [
                        "effondrer une volaille",
                        "effondrer un poisson"
                    ]
                }
            ]
        }
    ]
}