                        "examples": [
                            {
                                "example_id": "7e7a4b4f-98c2-41b7-bbc8-68942760f01f",
                                "sense_id": "0d7614b6-ca22-3bfb-8a38-2d137982ddf2",
                                "text": "В поэзии появляются «сумрак мглисто-шаткий / Да пятна окон без огня» (В. Кривич, осень 1917); «тень» по «окровавленной пыли» (Т. Ефименко, ноябрь 1917); «наш город темный / В темном море потонул» (А. Радлова, декабрь 1917)."
                            }
                        ]
                    }
