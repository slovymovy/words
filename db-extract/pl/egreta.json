                                                "example_id": "5728f383-2925-4fe7-b4c9-aed014a64810",
                                                "sense_id": "94286ecd-ccd5-322f-a480-f5847e51a83f",
                                                "text": "Egrets picked their way through the grass, attentive and showy as fussy girlfriends at the cows' sides."
                                            }
                                        ]
                                    },
