                                "sense_id": "16152397-6d1f-3d20-a6e8-76a8f6cf1739",
                                "text": "The book had lain on the attic floor until it was found decades later."
                            },
                            {
                                "example_id": "2dd80a53-11cb-4806-97f9-7cecff24a421",
                                "sense_id": "16152397-6d1f-3d20-a6e8-76a8f6cf1739",
                                "text": "He had lain there for many hours."
                            },
                            {
                                "example_id": "758b2b4f-9f13-4629-a01e-d2538b07be97",
                                "sense_id": "16152397-6d1f-3d20-a6e8-76a8f6cf1739",
                                "text": "I ascended to my room, and lay down upon the bed. A whole hour I must have lain thus, with my head resting upon my hand."
                            }
                        ]
