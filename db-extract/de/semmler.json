                ],
                "senses": [
                    {
                        "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                        "entry_id": "7630ce03-70c0-3cf1-9652-5c2fc049900f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9d1d2da-899d-4a55-a83c-ff5be1503e65",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Frau Semmler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "74c7d15b-b4cd-47b1-a9e7-63abe94142d6",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Herr Semmler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9019b5b2-1496-450c-a1f4-64df6e8f5071",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Die Semmlers fahren heute in den Böhmerwald."
                            },
                            {
                                "example_id": "3b0ad3de-140a-453b-989d-77603a7c4099",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Der Semmler trägt nie die Schals, die die Semmler ihm strickt."
                            },
                            {
                                "example_id": "4b6aabe1-de67-4b15-8c97-a877a7869128",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Semmler kommt, geht der Herr Semmler.“"
                            },
                            {
                                "example_id": "98c96af7-d2d9-46ed-9390-dd44164623d9",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Semmler kommt und geht."
                            },
                            {
                                "example_id": "d4dea6e3-dd62-4e82-93d8-0efad0d277e6",
                                "sense_id": "0114c6a7-50e0-3230-a60d-30d3dfd8f943",
                                "text": "Semmlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
