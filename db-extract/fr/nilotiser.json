                "senses": [
                    {
                        "sense_id": "c90bd7aa-4f3f-34bf-95c5-f8b43e4ffd1b",
                        "entry_id": "0f6717ce-179d-36a5-9f93-eb921a1bb4af",
                        "glosses": [
                            "Donner un caractère nilotique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d829872d-41c5-4e2b-b2a9-3b0b15b6260d",
                                "sense_id": "c90bd7aa-4f3f-34bf-95c5-f8b43e4ffd1b",
                                "text": "Le clan des Bega est, d'autre part, représenté dans les régions nilotisées qui entourent le Rwanda."
                            },
                            {
                                "example_id": "a87eeec0-56df-4f91-b4db-6c8792e18128",
                                "sense_id": "c90bd7aa-4f3f-34bf-95c5-f8b43e4ffd1b",
                                "text": "Ils sont à tous les échelons de la vie nationale, mais leur ambition finale est de conquérir d'abord l'Est du pays qui leur servira de tremplin afin de nilotiser la République Démocratique du Congo."
                            },
                            {
                                "example_id": "d4c0f444-427a-4e43-8636-020fe229be0a",
                                "sense_id": "c90bd7aa-4f3f-34bf-95c5-f8b43e4ffd1b",
                                "text": "Pure préhistoire en amont, elle se nilotise en devenant néolithique et s'égyptologuise à l'approche des premières dynasties pharaoniques."
                            }
                        ]
                    }
                ],
