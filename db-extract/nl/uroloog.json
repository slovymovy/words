                    {
                        "sense_id": "82df9807-e89f-3621-b173-f1aba9c57674",
                        "entry_id": "559c5d96-b97b-30a7-a6b1-191f608d8722",
                        "glosses": [
                            "een specialist in de geneeskunde die zich bezighoudt met de urinewegen bij de man en de vrouw, en de geslachtsorganen van de man"
                        ],
                        "tags": [
                            "beroep"
                        ],
