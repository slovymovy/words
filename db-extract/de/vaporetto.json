                "senses": [
                    {
                        "sense_id": "e4d46802-bf04-3024-b996-90fc532273fe",
                        "entry_id": "0b3bc1d6-4291-3752-a1fa-bb8c55caa998",
                        "glosses": [
                            "kleines Motorboot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f75dd2-a5a3-400c-9532-4510c2144297",
                                "sense_id": "e4d46802-bf04-3024-b996-90fc532273fe",
                                "text": "„Sie haben bereits etliche Vermouth hinter sich, nun stehen sie mit heißen Köpfen an der Mole und warten auf das Vaporetto und können nicht schnell genug ans Meer kommen, wo Paula endlich ihren zitronengelben Badeanzug zeigen will.“"
                            },
                            {
                                "example_id": "28fff3a9-1832-4a19-b458-63ff7ef28e8e",
                                "sense_id": "e4d46802-bf04-3024-b996-90fc532273fe",
                                "text": "„In Venedig, auf einer Fahrt mit dem Vaporetto vom Bahnhof durch den Canale Grande zum Markusplatz, war mir vor kurzem schockartig zu Bewusstsein gekommen, dass Gotik sich in dieser Stadt mit der arabischen Architektur verwoben hat.“"
                            },
                            {
                                "example_id": "c3968c86-6c3c-4abb-8113-c0b44c153b4e",
                                "sense_id": "e4d46802-bf04-3024-b996-90fc532273fe",
                                "text": "„Das Wasser war blau und still, aber es hob und senkte die Reihen der Gondeln, wenn ein Vaporetto vor San Zacearia heranrauschte und hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
