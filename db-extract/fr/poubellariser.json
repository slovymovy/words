                ],
                "senses": [
                    {
                        "sense_id": "eed2cf89-0a64-3f8c-a9ee-1159702e3f7c",
                        "entry_id": "cbb083a5-50b2-3b03-973a-d1f1752112af",
                        "glosses": [
                            "Placer des poissons vivant habituellement en aquarium dans une poubelle ou un autre endroit non spécifiquement conçu pour eux, dans le but de réduire les coûts et de faire vivre ses poissons de façon plus naturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5052fc1-2b87-45bd-b6da-a936a3284e01",
                                "sense_id": "eed2cf89-0a64-3f8c-a9ee-1159702e3f7c",
                                "text": "Je n'en connais aucun autre qui puisse passer l'hiver (mais tous n'ont pas été essayés), mais tous peuvent être poubellarisés en été."
                            },
                            {
                                "example_id": "4800ec3d-3c51-4131-a0a5-6b1612f8539b",
                                "sense_id": "eed2cf89-0a64-3f8c-a9ee-1159702e3f7c",
                                "text": "Juste une précision : à partir de quel moment estimez vous qu'un poisson est \"apte\" à être poubellarisé ?"
                            },
                            {
                                "example_id": "1dcbe1db-2f0c-415f-bd1d-052f0b1f0527",
                                "sense_id": "eed2cf89-0a64-3f8c-a9ee-1159702e3f7c",
                                "text": "ce printemps je poubellarise mes poipois."
                            }
                        ]
                    }
                ],
