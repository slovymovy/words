                "senses": [
                    {
                        "sense_id": "91d03eea-6d28-3824-97e6-abacef259dbc",
                        "entry_id": "d80adf42-128f-3993-941f-23a73ae44000",
                        "glosses": [
                            "Lüftungskanal, durch den die Abluft aus einem Raum abgeleitet/abgesaugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f1cb356-8844-4e15-81c8-a2e9631b0540",
                                "sense_id": "91d03eea-6d28-3824-97e6-abacef259dbc",
                                "text": "„Der Abluftkanal führt den im Fettfilter vom Fett gereinigten Wrasen nach draußen.“"
                            },
                            {
                                "example_id": "cca6350c-39ae-427e-90a2-3ee3be8f18e7",
                                "sense_id": "91d03eea-6d28-3824-97e6-abacef259dbc",
                                "text": "„Vermeiden Sie unnötige Bögen und in jedem Fall eine Querschnittsverkleinerung des Abluftkanals“"
                            },
                            {
                                "example_id": "d94650b3-9241-4e7f-ba0e-4e24910ab5fc",
                                "sense_id": "91d03eea-6d28-3824-97e6-abacef259dbc",
                                "text": "„Bei der ersten Variante werden die Küchendünste über einen Abluftkanal nach außen abgesaugt.“"
                            },
                            {
                                "example_id": "27d3a680-9b4a-4335-a029-2f45ccdb2b0e",
                                "sense_id": "91d03eea-6d28-3824-97e6-abacef259dbc",
                                "text": "„Im danebenliegenden Abluftkanal wird die verbrauchte Luft abgeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
