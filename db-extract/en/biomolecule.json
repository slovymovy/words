                    }
                ],
                "senses": [
                    {
                        "sense_id": "47a34ba8-1ee3-3214-be6c-9eac27a20efb",
                        "entry_id": "8f2243ce-c3c8-3272-8805-cde146a3e545",
                        "glosses": [
                            "Molecules, such as amino acids, sugars, nucleic acids, proteins, polysaccharides, DNA, and RNA, that occur naturally in living organisms; any such molecule, even if created outside a living thing (as for example in a test tube or bioreactor)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "789c2663-2b65-4300-80d3-c7a23eb8ae6a",
                                "sense_id": "47a34ba8-1ee3-3214-be6c-9eac27a20efb",
                                "text": "Zinc oxide is biosafe and, therefore, there are no toxic effects for biomedical applications that immobilize and modify biomolecules (Kumar and Shen, 2008)."
                            },
                            {
                                "example_id": "9752ee42-74cf-4cd6-8801-67cb182996cc",
                                "sense_id": "47a34ba8-1ee3-3214-be6c-9eac27a20efb",
                                "text": "In the close vicinity of a chiral nanostructure, the circular dichroism of a biomolecule could be greatly enhanced, due to the interaction with the local superchiral fields."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
