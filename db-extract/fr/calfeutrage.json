                        "sense_id": "5588ef1d-545e-3cb6-9a69-9368139f279d",
                        "entry_id": "68306c71-9598-3a6a-9462-9dc579711bad",
                        "glosses": [
                            "Action de calfeutrer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54adccd4-4ede-4106-bdfc-4b5b850757ee",
                                "sense_id": "5588ef1d-545e-3cb6-9a69-9368139f279d",
                                "text": "Le calfeutrage sert le même dessein d’isolation protectrice."
                            },
                            {
                                "example_id": "24ade724-86ea-4536-baf8-f1e66933a8f3",
                                "sense_id": "5588ef1d-545e-3cb6-9a69-9368139f279d",
                                "text": "Né en 1935, mon oncle, se souvient de séances de calfeutrage des fenêtres pour ne pas être repérés dans les bombardements, mais ne peut préciser si c’était avant ou après l’arrivée des Allemands."
                            }
                        ]
                    }
                ],
