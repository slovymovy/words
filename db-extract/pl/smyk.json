                                "target_senses": [
                                    {
                                        "sense_id": "a1d4e9f0-e921-367b-b08d-55ea93798e46",
                                        "entry_id": "90763037-1f64-388a-93f3-30e63aeab6e9",
                                        "glosses": [
                                            "разг., шутл. маленький, малорослый ребёнок"
