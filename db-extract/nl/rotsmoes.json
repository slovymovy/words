                "senses": [
                    {
                        "sense_id": "234a5bc0-51e6-30b1-a4a1-6f4f7989cafe",
                        "entry_id": "07d1c36e-faf5-397f-a6fe-2034bc3849e1",
                        "glosses": [
                            "slappe, flauwe uitvlucht; flauwe smoes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf93589d-b7ec-423d-a2ed-6dfe893717bb",
                                "sense_id": "234a5bc0-51e6-30b1-a4a1-6f4f7989cafe",
                                "text": "Voor haar deur stond Nick. 'Ik vroeg me af of je eh… een kopje suiker te leen hebt', mompelde hij. Om er meteen achteraan te gooien: 'god, wat een rotsmoes. Ik heb gewoon zin een glas wijn met je te drinken.'"
                            },
                            {
                                "example_id": "fddad02b-63c0-4976-9a71-74771e4f8d18",
                                "sense_id": "234a5bc0-51e6-30b1-a4a1-6f4f7989cafe",
                                "text": "De rotsmoesjes over leveringszekerheid zijn naar het rijk der fabelen verwezen. Want het is gewoon de pinautomaat Groningen die moet draaien. En wij burgers zijn nu eindelijk eens bovenaan gesteld. Het is een van de mooiste dagen van mijn leven.”"
                            },
                            {
                                "example_id": "bbdaa03a-2382-4a64-ae7b-26ac26e91fe4",
                                "sense_id": "234a5bc0-51e6-30b1-a4a1-6f4f7989cafe",
                                "text": "Ik had geen andere keus dan de borrel met een rotsmoes af te blazen. Ik ben nog bij hem langs geweest om hem zijn afscheidscadeau te geven; een tenenkrommend bezoek."
                            }
                        ]
                    }
