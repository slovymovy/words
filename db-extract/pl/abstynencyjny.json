                                            {
                                                "example_id": "140adb71-caa6-498c-9170-e6d51bda1072",
                                                "sense_id": "4bb0c0b0-777c-3468-a2cd-9382cfbcf293",
                                                "text": "The abstinence from a present pleasure that offers itself is a pain, nay, oftentimes, a very great one."
