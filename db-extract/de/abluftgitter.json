                "senses": [
                    {
                        "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                        "entry_id": "b9575fc5-e294-33ca-9414-87b57f3b33d6",
                        "glosses": [
                            "Lüftungsgitter, durch das die Abluft aus einem Raum abgesaugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64e67e3f-6a15-4d4b-86e8-af22bc036302",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "Durch das Abluftgitter im Abluftkanal wird Raumluft von der Klimaanlage angesaugt und durch frische Zuluft ersetzt."
                            },
                            {
                                "example_id": "54c0533b-41bf-49b1-803d-936575528a76",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "„Bei diesem System werden die Räume über ein kombiniertes Zu- und Abluftgitter be- und entlüftet, wobei die Zuluft über einen Filter gereinigt wird.“"
                            },
                            {
                                "example_id": "366e04ab-a011-45ae-95ad-a45a02d70c6b",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "„Die Ballschutzgitter werden als Zuluft- oder Abluftgitter in Turn-, Sport- oder Mehrzweckhallen verwendet.“"
                            },
                            {
                                "example_id": "580dc95f-25fa-43eb-9236-d9658a5a29e6",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "„In Küche und Bad werden Abluftgitter eingebaut und mit dem zentralen Abluftrohr verbunden.“"
                            },
                            {
                                "example_id": "f0c0b73d-8f05-4b02-baa3-e010a8d854f5",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "„Drei Dinge braucht der Frischluftkanal: Einen Ventilator mit Abdeckung und Rückschlagklappe gegen eindringende Außenluft, ein Teleskoprohr, das der Mauerstärke angepasst wird, und ein äußeres Abluftgitter mit einer Gazeeinlage zur Insektenabwehr.“"
                            },
                            {
                                "example_id": "f28ab5b4-08a4-4866-8669-af025211c01f",
                                "sense_id": "58a1f45e-cd5e-36f3-98cb-fd29a5fa2885",
                                "text": "„Wir benötigen 54 dieser Abluftgitter für verschiedene Räume.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
