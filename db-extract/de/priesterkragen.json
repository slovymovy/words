                "senses": [
                    {
                        "sense_id": "ba77eaa9-6473-3b1b-920a-515815cdda31",
                        "entry_id": "3fd7781c-8d49-36bb-94d9-6493dfa2b0b5",
                        "glosses": [
                            "den Hals einfassendes Teil der Kleidung eines Priesters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c403bba-bc3f-4949-8c4c-b47cd17561f8",
                                "sense_id": "ba77eaa9-6473-3b1b-920a-515815cdda31",
                                "text": "„Den ganzen Tag hatte er in seiner schwarzen Hose, dem schwarzen Hemd und dem Priesterkragen geschwitzt.“"
                            },
                            {
                                "example_id": "2a5bd04d-4df5-412a-a208-7b38653b11b3",
                                "sense_id": "ba77eaa9-6473-3b1b-920a-515815cdda31",
                                "text": "„Er trägt einen schwarzen Anzug mit Priesterkragen und zieht einen leichten schwarzen Talar darüber, als er den Spielbereich durchquert und dabei winzige Actionsfiguren und Starfighter unter den Sohlen seiner schwarzen Schuhe zerquetscht.“"
                            },
                            {
                                "example_id": "e199aeaa-dbe4-429d-8d2e-a92cf8b11648",
                                "sense_id": "ba77eaa9-6473-3b1b-920a-515815cdda31",
                                "text": "„Ein dünner, ungefähr fünfzigjähriger Mann mit einem Priesterkragen blickte auf und lächelte freundlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
