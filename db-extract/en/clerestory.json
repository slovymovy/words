    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                "word": "clerestory",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f90078e2-727d-4804-bc22-b83ad77bac4d",
                        "entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                        "tags": [
                            "plural"
                        ],
                        "form": "clerestories"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                        "entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                        "glosses": [
                            "The upper part of a wall containing windows to let in natural light to a building, especially in the nave, transept and choir of a church or cathedral."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aed9fb0-2400-485b-a0e0-f9a9a0f65fe0",
                                "sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                                "text": "Following these signs, he beheld three or four men with bent bows, leaning from the clerestory gallery."
                            },
                            {
                                "example_id": "c5db613b-8e6d-4eeb-be7d-be2b441ef41d",
                                "sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                                "text": "On the Visby-Västerhejde Railway there is a steam car. [...] The upperworks consist of a short clerestory coach body with end platforms and the engine chimney protruding from the roof like a stovepipe."
                            },
                            {
                                "example_id": "75ef4b55-84c6-489d-87e0-d3726acb0d64",
                                "sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                                "text": "The cars built before 1913 had clerestory roofs, after the American style, and also were provided with gates and end vestibule platforms requiring gatemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7d46cb6-78d7-4dcc-8a76-bb59ee2ff841",
                        "source_entry_id": "cfb23e06-af6a-34e4-8408-bd3e33a59ecf",
                        "source_sense_id": "55eb7d6b-0602-3475-98dd-4306c3eae74c",
                        "source_sense_description": "upper part of a wall containing windows",
                        "target_lang_word": "lichtbeuk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
