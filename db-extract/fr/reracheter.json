                "senses": [
                    {
                        "sense_id": "d3470bee-ebc5-3fa8-99e0-041c6367859f",
                        "entry_id": "29c06261-3531-37fe-b781-81a4e155f307",
                        "glosses": [
                            "Racheter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07cc3327-9e85-42e1-a2b4-325144972c06",
                                "sense_id": "d3470bee-ebc5-3fa8-99e0-041c6367859f",
                                "text": "Je le voulais d’autant plus que Six Hommes Morts, vendu par mon éditeur en 1931, m’avait tout juste rapporté dix-huit mille francs et que le sujet, racheté, revendu, reracheté, rerevendu, etc., avait gentiment passé le million (à ce qu’on m’a dit)."
                            },
                            {
                                "example_id": "042b44d1-5ca7-4e29-9282-db19784ceaa6",
                                "sense_id": "d3470bee-ebc5-3fa8-99e0-041c6367859f",
                                "text": "A la rigueur les gens peuvent l'acheter une fois au tarif mini, et si ils aiment, le reracheter un peu plus haut pour récompenser le studio."
                            }
                        ]
                    }
