                "senses": [
                    {
                        "sense_id": "76734b41-eaea-31d9-bd0a-1dffdaf29c25",
                        "entry_id": "6be22c8b-6852-33ae-861a-fc0ad664c0d7",
                        "glosses": [
                            "страд. прич. прош. вр. от замусорить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "f613a666-79a4-48e2-bbaa-5630d620648b",
                                "sense_id": "76734b41-eaea-31d9-bd0a-1dffdaf29c25",
                                "text": "Снег у порога был затоптан и замусорен позавчерашнею таскою дров."
                            },
                            {
                                "example_id": "268b9ede-f3db-4fb4-a44a-8eea1f87d39d",
                                "sense_id": "76734b41-eaea-31d9-bd0a-1dffdaf29c25",
                                "text": "Он молча стоял у калитки, глядя на грязный, замусоренный древесной щепой и опилками прямоугольник двора."
                            }
                        ]
                    }
                ],
