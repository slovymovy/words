                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d862763-600e-4654-bda8-33b25c3f78e9",
                                "sense_id": "0abff08f-aa3b-3aee-8316-4a23e7a076cd",
                                "text": "Ideally, we would like to integrate out the parameters #92;theta, i.e. marginalize in order to obtain a prediction. Since this is again hard to realize analytically, one usually approximates the integral via sampling from the posterior."
                            }
                        ]
                    }
                ],
