                "senses": [
                    {
                        "sense_id": "a88853f3-6aa7-37c5-a017-f42e01d437c6",
                        "entry_id": "2df9f2eb-c414-3248-bb2a-291dcd54d2f6",
                        "glosses": [
                            "Wirkstoff, der zwischen Individuen der gleichen Art Signale vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967d8db8-929d-43a3-a61c-54308298e97f",
                                "sense_id": "a88853f3-6aa7-37c5-a017-f42e01d437c6",
                                "text": "Pheromone dienen der Signalübermittlung zwischen den Individuen einer Spezies. Ein Beispiel ist Bombykol, der über die Luft verbreitete Sexuallockstoff des Seidenspinners Bombyx mori."
                            },
                            {
                                "example_id": "1b6b9665-6efc-40cf-aea2-df9a490aa7d7",
                                "sense_id": "a88853f3-6aa7-37c5-a017-f42e01d437c6",
                                "text": "„Dass Pheromone auch gerade dabei waren, Toms Gehirn zu verändern, bemerkte er nicht, da sie unbewusst aufgenommen wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
