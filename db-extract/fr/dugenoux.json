                        "examples": [
                            {
                                "example_id": "54fb0030-20aa-42c0-a233-12973bf0a2f3",
                                "sense_id": "50281b1a-0aeb-3c04-9eef-18a7e1c58e71",
                                "text": "Ouais, dugenoux, c’est parce qu’on vous cuisine aux petits oignons depuis presque une heure que ta mémoire se remet à avoir du tonus, tu vois qu’on a bien fait d’insister un peu."
                            },
                            {
                                "example_id": "12509bc4-4dec-4b29-a397-b30373acdf7d",
                                "sense_id": "50281b1a-0aeb-3c04-9eef-18a7e1c58e71",
                                "text": "Madame dugenoux passait devant nous avec son large sourire. Elle avait toujours son haut XXL qui cachait maladroitement sa poitrine généreuse. Elle nous rappelait nos jeux d'enfants, lorsqu'accroupis, nous détruisions nos T-shirts en mimant un décolleté plongeant, au grand dam de nos mères."
                            }
                        ]
                    }
