    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "390da1c1-53f3-32f1-8fc9-662461615195",
                    "sense_definition": "iets wat irritatie of ergernis opwekt",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>ergerlijk</w> probleem dat steeds weer terugkomt.",
                            "target_lang_translations": {
                                "en": "It is an <w>annoying</w> problem that keeps coming back."
                            }
                        },
                        {
                            "text": "Ik vind het een <w>ergerlijke</w> gewoonte om altijd te laat te komen.",
                            "target_lang_translations": {
                                "en": "I find it an <w>irritating</w> habit to always be late."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritant",
                        "vervelend",
                        "hinderlijk"
                    ],
                    "antonyms": [
                        "aangenaam",
                        "prettig"
                    ],
                    "common_phrases": [
                        "een ergerlijke gewoonte",
                        "ergerlijk gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "something that causes irritation or annoyance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoying",
                                "target_lang_sense_clarification": "causing irritation"
                            },
                            {
                                "target_lang_word": "irritating",
                                "target_lang_sense_clarification": "causing slight anger or impatience"
                            },
                            {
                                "target_lang_word": "vexing",
                                "target_lang_sense_clarification": "causing frustration or worry"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "81dbfa9f-4f9c-3945-a161-8ae9b90f42d9",
                    "sense_definition": "op een manier die ergernis of irritatie veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trein was weer <w>ergerlijk</w> traag tijdens de ochtendspits.",
                            "target_lang_translations": {
                                "en": "The train was <w>annoyingly</w> slow again during the morning rush hour."
                            }
                        },
                        {
                            "text": "Hij gedroeg zich <w>ergerlijk</w> arrogant tijdens het hele gesprek.",
                            "target_lang_translations": {
                                "en": "He behaved <w>irritatingly</w> arrogant throughout the entire conversation."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritant",
                        "hinderlijk"
                    ],
                    "common_phrases": [
                        "ergerlijk traag",
                        "ergerlijk langzaam"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that causes annoyance or irritation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "annoyingly",
                                "target_lang_sense_clarification": "in an irritating way"
                            },
                            {
                                "target_lang_word": "irritatingly",
                                "target_lang_sense_clarification": "in a way that causes impatience"
                            },
                            {
                                "target_lang_word": "exasperatingly",
                                "target_lang_sense_clarification": "to an intensely irritating degree"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "556a9d2f-18af-3aa2-97f5-2eac2a2defe2",
                    "sense_definition": "op een manier die morele verontwaardiging of aanstoot opwekt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanstoot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kwaliteit van het werk was <w>ergerlijk</w> slecht voor die prijs.",
                            "target_lang_translations": {
                                "en": "The quality of the work was <w>shamefully</w> poor for that price."
                            }
                        },
                        {
                            "text": "Zijn gebrek aan respect was <w>ergerlijk</w> voor alle aanwezigen.",
                            "target_lang_translations": {
                                "en": "His lack of respect was <w>offensive</w> to everyone present."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanstootgevend",
                        "schandalig"
                    ],
                    "common_phrases": [
                        "ergerlijk slecht"
                    ],
                    "target_lang_definitions": {
                        "en": "in a manner that causes moral indignation or offense"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shamefully",
                                "target_lang_sense_clarification": "in a way that is disgracefully bad"
                            },
                            {
                                "target_lang_word": "shockingly",
                                "target_lang_sense_clarification": "in a way that causes moral outrage"
                            },
                            {
                                "target_lang_word": "appallingly",
                                "target_lang_sense_clarification": "in a way that is very bad or offensive"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}