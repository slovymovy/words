                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "77a9c229-076c-3b7b-8b34-a5710e2b8de2",
                                        "entry_id": "72bd88c1-a6b8-37a6-971a-7cd7ec29eb32",
                                        "glosses": [
                                            "drukarka atramentowa"
                                        ],
                                        "tags": [
                                            "środ."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3ffb0b-f46b-490c-9ffc-3a76eb8b7ab8",
                                                "sense_id": "77a9c229-076c-3b7b-8b34-a5710e2b8de2",
