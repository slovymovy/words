        "fr-extract.jsonl": [
            {
                "entry_id": "3d46c82f-4c94-366c-8825-eaaf07ccb54f",
                "word": "bousculade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1232e0ea-0df8-4374-8793-76bb3b072d3b",
                        "entry_id": "3d46c82f-4c94-366c-8825-eaaf07ccb54f",
                        "tags": [
                            "plural"
                        ],
                        "form": "bousculades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                        "entry_id": "3d46c82f-4c94-366c-8825-eaaf07ccb54f",
                        "glosses": [
                            "Désordre par suite de poussée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc37742-56c6-4f6f-adb3-873d0e5b39c5",
                                "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                                "text": "À toute allure les autobus, les omnibus et les charrettes de commissionnaires voituraient malles et valises vers la gare ; sur les quais envahis, l'exode des hiverneurs d'élite se heurtait à la bousculade des voyageurs de toute espèce."
                            },
                            {
                                "example_id": "0509f996-d903-44ce-9fbc-60d491526759",
                                "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                                "text": "Une bousculade plus violente se produisit ; les petits veaux et les génisses rejetés de droite et de gauche par la poussée des grands bestiaux s’égratignèrent aux ronces flottantes des haies."
                            },
                            {
                                "example_id": "c86adc67-352f-4621-b964-5cfc1a673f54",
                                "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                                "text": "Il y eut quelques bousculades, d'ailleurs vites réprimées, des cris aigus de filles, des plaintes, des protestations, […]."
                            },
                            {
                                "example_id": "0386400b-3514-4cd7-96ad-674b9e7d0ebe",
                                "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                                "text": "Une douzaine de jeune gens entouraient une sorte de croquant endimanché, coiffé d'un chapeau melon qui roulait des yeux ahuris et s'efforçait d'éviter la bousculade systématique dont il se voyait l'objet."
                            },
                            {
                                "example_id": "47b75c6e-1499-41a6-862f-0a26ffc03e7b",
                                "sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                                "text": "Et, tandis que la foule transportée hurlait ses acclamations, Ahmed Abdou entraîna Zariffa loin de cette bousculade."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e2b4c78-49ad-4d16-8c68-d1b96e46b4f7",
                        "source_entry_id": "3d46c82f-4c94-366c-8825-eaaf07ccb54f",
                        "source_sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                        "target_lang_word": "Gedränge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gedränge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                        "entry_id": "a5370866-983f-3f23-bb91-0e347e488fe0",
                                        "glosses": [
                                            "Situation, in der viele Leute auf engem Raum sind und sich dabei schieben und schubsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8045bf-ad94-4151-9f87-f3c7a45500aa",
                                                "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                                "text": "Am verkaufsoffenen Sonntag herrscht immer ein großes Gedränge im Kaufhaus."
                                            },
                                            {
                                                "example_id": "0bc5e491-6a35-4d94-9ebf-c199522084d5",
                                                "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                                "text": "„Schon seit fast drei Stunden wartete er im Gedränge der Passanten auf den Zug.“"
                                            },
                                            {
                                                "example_id": "1ac666f8-b272-44c7-b1ab-d7f0043f95ef",
                                                "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                                "text": "„Stefan hatte sie im Gedränge verloren.“"
                                            },
                                            {
                                                "example_id": "685dbff6-76b2-4a6a-812c-e4576625e242",
                                                "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                                "text": "„Endlich waren alle Fuhrwerke vorbei, das Gedränge liess nach, und das letzte Bataillon betrat die Brücke.“"
                                            },
                                            {
                                                "example_id": "705be5d3-9b6b-42df-bfa2-d4e2c61a9149",
                                                "sense_id": "9e7fcae3-2654-37f6-9799-3a275dcba0ac",
                                                "text": "„Er drückte die Ellenbogen an sich, damit sein schwarzes Fräckchen in dem Gedränge nicht Not leide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e55ecdf5-36ff-3e6c-b386-cd1929d87070",
                                        "entry_id": "a5370866-983f-3f23-bb91-0e347e488fe0",
                                        "glosses": [
                                            "Situation nach bestimmten Regelverstößen, bei dem sich mehrere Mitspieler in einer Gruppe der Gruppe der Gegenspieler gegenüberstellen und dann versuchen den Gegner zurückzudrängen"
                                        ],
                                        "tags": [
                                            "Rugby"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26e55113-7214-46b9-9232-845614b76fdf",
                        "source_entry_id": "3d46c82f-4c94-366c-8825-eaaf07ccb54f",
                        "source_sense_id": "57c5553b-aeee-3aaf-a488-e3226680744a",
                        "target_lang_word": "Geschiebe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschiebe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "47c9bb4f-c4c0-31ad-94a6-b29f6d9d11b8",
                                        "entry_id": "14f9b519-8941-3ae3-b1b6-59e888b6dc24",
                                        "glosses": [
                                            "stetiges oder wiederholtes Bewegen von etwas durch Druck"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73ec611f-2b98-458f-997c-0057c40c2827",
                                                "sense_id": "47c9bb4f-c4c0-31ad-94a6-b29f6d9d11b8",
                                                "text": "„Jenes Gedränge und Geschiebe von Menschen, die vollgepfropften Treppen und Gänge bei noch halbleerer Kirche, der Neid und Streit um einen Sitzplatz, […] von dem allen finden wie keine Spur […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b24ff935-9a62-341d-aa47-6ef5fc2f1866",
                                        "entry_id": "14f9b519-8941-3ae3-b1b6-59e888b6dc24",
                                        "glosses": [
                                            "von einer Kraft (Gletscher/fließendes Wasser) über Grund bewegte (=‚geschobene‘) Masse (meistens Sand, Steine)"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "681c0889-a7c4-4104-9557-af0549d73ea0",
                                                "sense_id": "b24ff935-9a62-341d-aa47-6ef5fc2f1866",
                                                "text": "„Von den Gebirgsabhängen stürzen zahlreiche, aber meist nur zur Regenzeit Wasser führende Bäche herunter, die ihre Geschiebe an den veränderlichen Ufern ablagern und an der Mündung meist kleine Deltas bilden.“"
                                            },
                                            {
                                                "example_id": "5e799193-405c-461f-8ca5-819b0d6b475a",
                                                "sense_id": "b24ff935-9a62-341d-aa47-6ef5fc2f1866",
                                                "text": "„Der Glimmerschiefer bedeckt in Skandinavien gewöhnlich nur die höchsten Gipfel […]. Dieser Umstand hat, wenn das Wasser nicht so hoch gestiegen ist, seine Versetzung gehindert; deshalb erscheint er nur selten unter den Geschieben, […]“"
                                            },
                                            {
                                                "example_id": "2b1500bc-0ef3-4dd1-8025-d537d5e7f891",
                                                "sense_id": "b24ff935-9a62-341d-aa47-6ef5fc2f1866",
                                                "text": "versteinert: „Es gibt sowohl ‚nördliche‘ als auch ‚südliche‘ Konglomerate. […] Ein klassisches nördliches Geschiebe ist zum Beispiel das ‚Digerberg-Konglomerat‘.“"
                                            },
                                            {
                                                "example_id": "0e311c23-700d-4a0c-b49a-efb00c370bc5",
                                                "sense_id": "b24ff935-9a62-341d-aa47-6ef5fc2f1866",
                                                "text": "„Die Küste von Les Hachettes bot seltsame Geschiebe, und als ihnen der Herbergswirt den Weg gezeigt hatte, erreichten sie den Strand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6e0050c1-7c33-3ff3-a20b-c1453b9af888",
                                        "entry_id": "14f9b519-8941-3ae3-b1b6-59e888b6dc24",
                                        "glosses": [
                                            "die zum Befestigen dienenden Elemente einer Zahnprothese (Patrize) zusammen mit den entsprechenden im Kiefer fest sitzenden Verankerungen (Matrize)"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec79204e-e7eb-4f8e-a50c-b408edfc21f5",
                                                "sense_id": "6e0050c1-7c33-3ff3-a20b-c1453b9af888",
                                                "text": "„Geschiebe bieten eine gute Kraftverteilung innerhalb des Gebisses und der Prothese, unterstützen also einen weiterhin guten Biss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
