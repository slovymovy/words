                            "masculine"
                        ],
                        "form": "équatoriaux"
                    },
                    {
                        "form_id": "dc18500f-2142-4763-889a-5797d6a8fade",
                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "équatoriale"
                    },
                    {
                        "form_id": "8ad267a5-f6b1-41b9-b1f2-66c473c2cdb8",
                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "équatoriales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                        "glosses": [
                            "Qui appartient à l’équateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7aefff1-d99a-4831-ba88-16e72d8d478d",
                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                "text": "Avec les vents alizés et le courant équatorial d'une vitesse de dix à soixante-dix milles par jour, ç’aurait été pour moi la traversée la plus courte et la plus facile."
                            },
                            {
                                "example_id": "7fa52080-0715-421f-860c-cb8670b31207",
                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                "text": "Une plus grande teneur de l’air en gaz carbonique permettrait d'ailleurs d'expliquer la luxuriance de la végétation sans faire intervenir un climat équatorial."
                            },
                            {
                                "example_id": "bf4f834e-9d1c-4965-acfe-6888e1e73906",
                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                "text": "La ligne équatoriale, l’équateur."
                            },
                            {
                                "example_id": "20dccd08-2fe2-4a4a-9419-e992b2b670e8",
                                "sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                                "text": "Le rayon équatorial est à la fois perpendiculaire à l'axe terrestre et à la tangente respective de l'équateur et du méridien coupant ce rayon."
                            }
                        ]
                    },
                    {
                        "sense_id": "075b5689-56e5-342c-861e-42a77cb916c9",
                        "entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                        "glosses": [
                            "Voisin de l’équateur céleste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e586da53-6625-4362-a547-197344a9bf61",
                                "sense_id": "075b5689-56e5-342c-861e-42a77cb916c9",
                                "text": "Étoiles, constellations équatoriales."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27506573-5eed-4276-aee7-4014cdae8f08",
                        "source_entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
                        "source_sense_id": "f6910039-ac77-3ce0-a0e4-b5d27452fe3b",
                        "source_sense_description": "Qui appartient à l’équateur.",
                        "target_lang_word": "äquatorial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äquatorial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                        "entry_id": "1635f0a7-84bc-34a7-aa08-c23b35c30647",
                                        "glosses": [
                                            "auf einen Äquator oder eine Äquatorebene bezogen, an einem Äquator oder in einer Äquatorebene gelegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e02adff-78d9-4c74-87c1-21fd24d4895e",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Eine weitere nahezu windlose Zone ist der äquatorial gelegene Kalmengürtel."
                                            },
                                            {
                                                "example_id": "0af8ceea-0293-4ebb-a944-4d7a5713776c",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Das Klima ist typisch äquatorial und kennzeichnet sich neben ganzjährig hohen Temperaturen durch eine hohe Luftfeuchtigkeit."
                                            },
                                            {
                                                "example_id": "39684dad-e901-4240-90ef-757f23958221",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Die Frucht bildet eine rote, rötliche, grünliche oder bräunliche Scheinbeere, welche bei Reife abtrocknet und äquatorial aufreißt."
                                            },
                                            {
                                                "example_id": "900ca055-e31d-4ef5-adce-ea5d6dadc238",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Die Keimöffnungen sind entweder äquatorial diporat oder meridional zonasulcat."
                                            },
                                            {
                                                "example_id": "ebfdbbc5-3e23-40f9-94a5-123378b9dd4b",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Dabei ist das Wasserstoffatom und ein Carbonylligand axial, die drei weiteren Carbonylliganden äquatorial angeordnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8804f8c3-0535-3e66-8d70-650331d855d8",
                                        "entry_id": "1635f0a7-84bc-34a7-aa08-c23b35c30647",
                                        "glosses": [
                                            "Astronomie (von Koordinatensystemen): mit einer Himmelsachse, die gleich der Erdachse ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13ba949-ffae-4aaf-b69e-ce2db82f4989",
                                                "sense_id": "8804f8c3-0535-3e66-8d70-650331d855d8",
                                                "text": "Der Frühlingspunkt dient sowohl für das äquatoriale wie für das ekliptikale Koordinatensystem als Nullpunkt, von dem aus Rektaszension bzw. ekliptikale Länge gezählt werden (nach Osten positiv)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84e7e125-842c-4dbe-ad83-1c5b9892c920",
                        "source_entry_id": "9c839ad4-30b7-3f8f-999a-272aae8fc92b",
