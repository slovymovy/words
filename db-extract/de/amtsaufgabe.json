                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc5481b-f2aa-411a-b053-26d171e67e28",
                                "sense_id": "19c7e1e0-4444-323a-92bc-5388f46d4621",
                                "text": "„Im Jahr 1999 zwang es sogar die gesamte EU-Kommission zur Amtsaufgabe, weil es große Zweifel an einer ordentlichen Haushaltsführung hatte.“"
                            }
                        ],
