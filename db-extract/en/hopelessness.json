                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2611536-3e8e-4c72-bf6c-b7a52e53ea9e",
                                                "sense_id": "1c132079-e297-3721-ad9c-e2f6fe7e9cee",
                                                "text": "De hopeloosheid van een depressieve patiënt moet iedereen met enig gevoel wel aanspreken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d25d7b32-9133-4fdc-9e93-96de73022c3d",
                        "source_entry_id": "28c56b92-1c46-3fb9-b5df-c716889bab9d",
                        "source_sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                        "source_sense_description": "the lack of hope; despair",
                        "target_lang_word": "désespérance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désespérance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                        "entry_id": "8edb57ef-56fa-3289-927c-5b024006e4a3",
                                        "glosses": [
                                            "État d’une âme qui a perdu l’espérance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f886e90-fb7b-4144-ab8c-e9b89b44e3ca",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "Mais souvenez-vous bien, fille de Satan ! que les désirs contre nature ne sont jamais assouvis. Vous rencontrerez la désespérance au moment où vous croirez au bonheur !"
                                            },
                                            {
                                                "example_id": "98481dac-c1f5-4691-a885-dfb033d1187a",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "— Nous voici dans les Landes, dit Vitalis ; nous avons vingt ou vingt-cinq lieues à faire au milieu de ce désert. Mets ton courage dans tes jambes.\nC’était non-seulement dans les jambes qu’il fallait le mettre, mais dans la tête et le cœur ; car, à marcher sur cette route qui semblait ne devoir finir jamais, on se sentait envahi par une vague tristesse, une sorte de désespérance."
                                            },
                                            {
                                                "example_id": "6cafa4e6-59d3-4e59-a439-ee602533195c",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "Je me demandai : « Que sera-ce de cet enfant ? »\n« Que sera-ce aussi de sa petite amie, dont la silhouette apparaît, persistante, au bout du chemin ? Qu’y a-t-il de désespérance dans ce tout petit cœur ; qu’y a-t-il d’angoisse, en présence de cet abandon ? »"
                                            },
                                            {
                                                "example_id": "f005fa51-1d7b-4a1f-9cf0-83f590678dac",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "Il avait fini par s’enfermer, dans des crises de désespérance telles, qu’il pleurait à gros sanglots, pendant des heures, en dehors de tout chagrin immédiat, écrasé sous la seule et immense tristesse des choses."
                                            },
                                            {
                                                "example_id": "d3646a99-0fc4-4650-8bae-3af2d4266cac",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "[…], tout cela lui semblait prenant, tyrannique, hostile jusqu’à la désespérance presque…"
                                            },
                                            {
                                                "example_id": "db5b351f-2f2e-4ec5-ad6d-08b207930129",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "La silhouette d’une femme convoitée une heure alternait avec le décor du bar interlope où, un soir de spleen, j’avais grignoté les amandes salées de la désespérance."
                                            },
                                            {
                                                "example_id": "deb19635-3e49-4797-8bae-80948dff133a",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "Rien entre nous, que des souvenirs assez pitoyables, le tas lugubre des dèches quotidiennes, des privations et des désespérances."
                                            },
                                            {
                                                "example_id": "3c5365af-0a1a-4f9e-85a8-5595c5fa5ee4",
                                                "sense_id": "e96104c9-a16e-3650-9ada-632f2e7f32e6",
                                                "text": "Nos compatriotes souffrent, l’angoisse, la désespérance sociale sont fortes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8786d70a-3c22-4e17-aef0-9d62ea7ef862",
                        "source_entry_id": "28c56b92-1c46-3fb9-b5df-c716889bab9d",
                        "source_sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                        "source_sense_description": "the lack of hope; despair",
                        "target_lang_word": "Hoffnungslosigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hoffnungslosigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                        "entry_id": "a29d9462-9630-3fe6-840b-9f4b9a3145d7",
                                        "glosses": [
                                            "Hoffnungslossein; hoffnungslose Eigenschaft/Situation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a036faf-6715-4cc4-9036-01b7b1180a6f",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "Die Diagnose versetzte ihn zeitweise in Hoffnungslosigkeit."
                                            },
                                            {
                                                "example_id": "55710f2f-aa09-4c6b-a694-d67554c8263f",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "Die emotionale Situation der Jugendlichen ohne Arbeit ist von Hoffnungslosigkeit geprägt."
                                            },
                                            {
                                                "example_id": "b8edd0f9-051e-458b-9a53-8832acce50b7",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "„In diesem Augenblick fühlte er nichts anderes als einen unbestimmten Zorn, einen tiefen Widerwillen und den Beginn einer grenzenlosen Hoffnungslosigkeit.“"
                                            },
                                            {
                                                "example_id": "b05bf3a0-df57-4b7c-ab8d-39d41165354c",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "„Sie starben aber auch an Hoffnungslosigkeit und seelischer Pein.“"
                                            },
                                            {
                                                "example_id": "82267904-310c-47a1-a83e-7d6e757784d4",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "„Er machte eine Handbewegung, die Hoffnungslosigkeit ausdrücken sollte.“"
                                            },
                                            {
                                                "example_id": "d8dd6300-fa60-43e0-a2bb-c99381985494",
                                                "sense_id": "97863497-fc51-3fbd-852f-175bc31c1d5f",
                                                "text": "„Hoffnungslosigkeit machte sich breit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
