                    {
                        "sense_id": "3b2005b4-ab9d-3840-a524-22243db9664c",
                        "entry_id": "10212326-a87f-3490-ac2c-e0f0e238b8f0",
                        "glosses": [
                            "Person, die hobbymäßig (meist wertvolle oder besondere) Automobile beobachtet und oft auch fotografiert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d380688d-e9be-4302-b299-986c4d7c13c5",
                                "sense_id": "3b2005b4-ab9d-3840-a524-22243db9664c",
                                "text": "„Ferdinand und Simon sind nicht die einzigen Carspotter an der Maximilianstraße.“"
                            },
                            {
                                "example_id": "d4ebc256-211d-4f6e-9b72-7df7d5fed317",
                                "sense_id": "3b2005b4-ab9d-3840-a524-22243db9664c",
                                "text": "„Der Braunschweiger Carspotter Joost ist oft unterwegs, um schicke Autos zu fotografieren.“"
                            },
                            {
                                "example_id": "133848d1-786b-4c5b-8cde-a8e95d65b2d2",
                                "sense_id": "3b2005b4-ab9d-3840-a524-22243db9664c",
                                "text": "„Auf dem Kurfürstendamm in Berlin tummeln sich die Carspotter, die in Berlin unter Namen wie ‚Kudammchillaz‘ oder ‚Berlin Rich Streets‘ operieren, um ihre letzten Abschüsse zu tätigen: Lamborghini Gallardos, Porsche Carrera GTs, AMG-getunte S-Klassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
