                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46869b81-007e-4f66-a7a0-e74b31175c8a",
                                                "sense_id": "cb089bb9-6d6c-34b0-9a94-dc1d62ab3b5c",
                                                "text": "Parmi les plantes oléagineuses, on cultive le colza et la navette, et, parmi les plantes textiles, le chanvre et le lin […]"
                                            },
                                            {
                                                "example_id": "0f4358df-e209-4f13-b89c-76b1e320e5d7",
                                                "sense_id": "cb089bb9-6d6c-34b0-9a94-dc1d62ab3b5c",
                                                "text": "Enfin, les fourrages annuels d’hiver comportent surtout le trèfle incarnat, souvent appelé « farouch », la navette d’hiver, le seigle-fourrage […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99ed8dd8-3060-3782-a4a3-16fa82dcc27a",
                                        "entry_id": "3522116a-d68f-3a37-80b6-22b8136f1fb1",
                                        "glosses": [
                                            "Graines oléagineuses de cette plante."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0701c14-6f0d-3165-9764-a64bf0045abb",
                                        "entry_id": "3522116a-d68f-3a37-80b6-22b8136f1fb1",
                                        "glosses": [
                                            "Graine oléagineuse fournie par une cultivée en France pour en tirer de l'huile entre le 16e et 20e siècles, remplacée par le colza."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb33831-8ea9-44db-a71f-b6cac488a8ed",
                                                "sense_id": "d0701c14-6f0d-3165-9764-a64bf0045abb",
                                                "text": "Chemin faisant, j'ai rencontré un champ de navette en fleur avec des coquelicots et des papillons."
                                            },
                                            {
                                                "example_id": "ba409a50-64b6-4b37-ae73-594822e1c6bf",
                                                "sense_id": "d0701c14-6f0d-3165-9764-a64bf0045abb",
                                                "text": "L'huillier travaillait surtout en hiver. La grosse meule dressée tournait dans l'auge broyant colza et navette."
                                            },
                                            {
                                                "example_id": "b977abf4-c0db-419f-a336-01d660ef4d35",
                                                "sense_id": "d0701c14-6f0d-3165-9764-a64bf0045abb",
                                                "text": "Huile de navette."
                                            }
                                        ]
                                    }
                                ]
