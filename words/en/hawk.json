{
    "word_family": [
        "hawkish",
        "hawker",
        "hawking",
        "goshawk",
        "sparrowhawk"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96b7a6ad-9df7-3235-b6b3-8cbabc7e32a3",
                    "sense_definition": "A diurnal predatory bird of the family Accipitridae, smaller than an eagle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "birds of prey",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hawk</w> circled high above the field, searching for its next meal.",
                            "target_lang_translations": {
                                "ru": "<w>Ястреб</w> кружил высоко над полем в поисках добычи."
                            }
                        },
                        {
                            "text": "It is illegal to hunt <w>hawks</w> or other raptors in many parts of the world.",
                            "target_lang_translations": {
                                "ru": "Во многих частях мира охота на <w>ястребов</w> или других хищных птиц запрещена законом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hawk eyes",
                        "soaring hawk",
                        "predatory hawk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дневная хищная птица семейства ястребиных, размером меньше орла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ястреб",
                                "target_lang_sense_clarification": "хищная птица"
                            },
                            {
                                "target_lang_word": "сокол",
                                "target_lang_sense_clarification": "в широком смысле о хищных птицах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1b17e25-474f-320e-a0b8-65e6c6da3a4a",
                    "sense_definition": "An advocate of aggressive political positions and actions, especially in favor of war or military intervention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "political stances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senator is known as a foreign policy <w>hawk</w> who supports increased military spending.",
                            "target_lang_translations": {
                                "ru": "Сенатор известен как внешнеполитический <w>ястреб</w>, поддерживающий увеличение военных расходов."
                            }
                        },
                        {
                            "text": "In the debate between the <w>hawks</w> and the doves, the president chose a middle path.",
                            "target_lang_translations": {
                                "ru": "В споре между <w>ястребами</w> и голубями президент выбрал срединный путь."
                            }
                        }
                    ],
                    "synonyms": [
                        "warmonger",
                        "war hawk"
                    ],
                    "antonyms": [
                        "dove"
                    ],
                    "common_phrases": [
                        "political hawk",
                        "hawks and doves"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сторонник агрессивной политической позиции, особенно в пользу войны или военного вмешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ястреб",
                                "target_lang_sense_clarification": "политический термин"
                            },
                            {
                                "target_lang_word": "милитарист",
                                "target_lang_sense_clarification": "сторонник военной мощи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db5fcafa-2d72-3858-a580-719e8546651a",
                    "sense_definition": "A cold, sharp, or biting wind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned up his collar against the <w>hawk</w> blowing from the river.",
                            "target_lang_translations": {
                                "ru": "Он поднял воротник, защищаясь от <w>ледяного ветра</w>, дующего с реки."
                            }
                        },
                        {
                            "text": "The <w>hawk</w> blowing off the lake was enough to make your teeth drop right out of your skull.",
                            "target_lang_translations": {
                                "ru": "<w>Резкий ветер</w> с озера был таким сильным, что зубы были готовы выскочить изо рта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the hawk blowing"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Particularly associated with Chicago"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Холодный, резкий или пронизывающий ветер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ледяной ветер",
                                "target_lang_sense_clarification": "пронизывающий холод"
                            },
                            {
                                "target_lang_word": "резкий ветер",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e09001d2-6a35-374b-a88a-f63de56f429d",
                    "sense_definition": "A plasterer's tool consisting of a flat square surface with a handle below, used to hold plaster.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plasterer held the <w>hawk</w> in one hand and the trowel in the other.",
                            "target_lang_translations": {
                                "ru": "Штукатур держал <w>сокол</w> в одной руке, а мастерок — в другой."
                            }
                        },
                        {
                            "text": "He loaded a fresh batch of mortar onto his <w>hawk</w> before climbing the ladder.",
                            "target_lang_translations": {
                                "ru": "Он положил свежую порцию раствора на свой <w>соколок</w>, прежде чем подняться по лестнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "mortarboard"
                    ],
                    "common_phrases": [
                        "plasterer's hawk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент штукатура, представляющий собой плоскую квадратную поверхность с ручкой снизу, используемый для удержания раствора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокол",
                                "target_lang_sense_clarification": "штукатурный инструмент"
                            },
                            {
                                "target_lang_word": "соколок",
                                "target_lang_sense_clarification": "уменьшительное название инструмента"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da5ca773-fa30-3491-92f5-0c52d4058f6c",
                    "sense_definition": "To sell goods or offer them for sale by calling out in the street; to peddle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "selling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vendors were <w>hawking</w> their wares from little tables lining the market square.",
                            "target_lang_translations": {
                                "ru": "Торговцы <w>продавали вразнос</w> свои товары с маленьких столиков, расставленных вдоль рыночной площади."
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>hawking</w> newspapers to people passing by on the sidewalk.",
                            "target_lang_translations": {
                                "ru": "Вторую половину дня он провел, <w>предлагая</w> газеты прохожим на тротуаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "tout"
                    ],
                    "common_phrases": [
                        "hawk wares",
                        "hawk goods"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать товары, предлагая их вразнос или выкрикивая на улице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торговать вразнос",
                                "target_lang_sense_clarification": "предлагать товары на улице"
                            },
                            {
                                "target_lang_word": "продавать",
                                "target_lang_sense_clarification": "предлагать товар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e1a5ddb-d9a4-396c-bc52-7a50afd4f99a",
                    "sense_definition": "To clear the throat noisily or to cough up phlegm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bodily functions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hawked</w> loudly before spitting into the gutter.",
                            "target_lang_translations": {
                                "ru": "Он громко <w>харкнул</w>, прежде чем сплюнуть в сточную канаву."
                            }
                        },
                        {
                            "text": "The old man sat on the porch <w>hawking</w> and wheezing all morning.",
                            "target_lang_translations": {
                                "ru": "Старик сидел на крыльце, <w>отхаркиваясь</w> и хрипя все утро."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hawk and spit",
                        "hawk up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шумно прочищать горло или отхаркивать мокроту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "харкать",
                                "target_lang_sense_clarification": "отхаркивать мокроту"
                            },
                            {
                                "target_lang_word": "отхаркиваться",
                                "target_lang_sense_clarification": "прочищать горло"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5860267a-cea4-3571-9364-8921ef975db1",
                    "sense_definition": "To hunt with a trained hawk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hunting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobility would often go <w>hawking</w> in the forests during the autumn months.",
                            "target_lang_translations": {
                                "ru": "Знать часто <w>охотилась с ястребами</w> в лесах в осенние месяцы."
                            }
                        },
                        {
                            "text": "He rode his horse through the fields while <w>hawking</w> for small game.",
                            "target_lang_translations": {
                                "ru": "Он ехал верхом через поля, <w>охотясь с ловчей птицей</w> на мелкую дичь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go hawking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Охотиться с обученным ястребом или соколом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охотиться с ястребом",
                                "target_lang_sense_clarification": "вид соколиной охоты"
                            },
                            {
                                "target_lang_word": "заниматься соколиной охотой",
                                "target_lang_sense_clarification": "общий термин для охоты с птицами"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a8e5fb67-3007-3136-b96e-461d1556f4e4",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Hawk</w> was appointed as the new director of the local museum.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Хок</w> был назначен новым директором местного музея."
                            }
                        },
                        {
                            "text": "The <w>Hawks</w> have lived in this neighborhood for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Хок</w> живет в этом районе уже более трех поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Common English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Хок",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}