                                "sense_id": "08fc949f-29de-3f28-b1b8-bf42d508f300",
                                "text": "Le groupe auxiliaire de puissance est un petit turbomoteur."
                            },
                            {
                                "example_id": "c915b91f-33be-449c-af92-520b9c622214",
                                "sense_id": "08fc949f-29de-3f28-b1b8-bf42d508f300",
                                "text": "Ils disparaissaient, laissant traîner, longtemps derrière eux, le ronronnement de leurs turbomoteurs."
                            }
                        ]
                    }
