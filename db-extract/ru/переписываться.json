                        "cross_references": [
                            {
                                "target_word": "correspond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1abab2cd-68c3-3ec6-ad63-bb301fc4ec02",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To be equivalent or similar in character, quantity, quality, origin, structure, function etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cda26be-b1fe-34ef-b19d-4cc8b9828c7c",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To exchange messages, especially by postal letter, over a period of time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb27d2c-cc39-4148-9f10-0f2b5d457d8d",
                                                "sense_id": "6cda26be-b1fe-34ef-b19d-4cc8b9828c7c",
                                                "text": "I've been corresponding with my German pen pal for three years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                        "entry_id": "f734d088-9d74-38bf-b18f-ad89c0790c10",
                                        "glosses": [
                                            "To have sex with."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c613ae-4ea1-488d-8bf8-55f359b304e9",
                                                "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                                "text": "He pleaded guilty to the charge, so far as acknowledging that he had corresponded with other women lately, in order to get the better of his affection for me, but the experiment had failed, and he found that he should be for ever miserable."
                                            },
                                            {
                                                "example_id": "b44ee733-b766-417d-90a7-6aa6082bbbf0",
                                                "sense_id": "64b45fd4-90b0-3c1a-ae35-6ab38131a1b5",
                                                "text": "When a Babylonian and his wife had a mind to correspond, they always first lit up the fuming pan, imagining it improved the passion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0056ae83-0a42-4601-8017-b1aa8da465ae",
                        "source_entry_id": "a5de3b1c-4dde-3851-8370-5489a4ac2247",
