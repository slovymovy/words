                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7050052d-0279-4512-b320-6d0fafd7175b",
                                "sense_id": "443688fb-06db-3774-8d38-c0a1ccf7755d",
                                "text": "Trouwen, dat deed je toch niet meer? De enige die de stemming er een beetje in hield, was mijn schoonmoeder, die elk halfuur vroeg of de Bruiloftsmars van Mendelssohn, door mij gedraaid bij opening van de eerste fles champagne, nog een keer op mocht."
                            },
                            {
                                "example_id": "8e96ea41-abbd-44b5-9cbd-16e31b16992b",
                                "sense_id": "443688fb-06db-3774-8d38-c0a1ccf7755d",
                                "text": "Met de trofee in zijn hand zal hij vier dagen later zijn bruid naar het altaar begeleiden. Niet met de bruiloftsmars uit de speakers, maar met zijn opkomstnummer als darter: 'Shut Up and Dance'."
                            }
                        ]
                    }
