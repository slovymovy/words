                "senses": [
                    {
                        "sense_id": "89aead11-2050-3bf7-b14e-fdcbbdbd1f73",
                        "entry_id": "923bfcd5-0e77-3906-bbe4-5f86a742745b",
                        "glosses": [
                            "ein altes bergmännisches Längenmaß"
                        ],
                        "tags": [
                            "Bergbau",
                            "mitteldeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "f147cc35-2292-4cc5-a58c-3fe218db9b55",
                                "sense_id": "89aead11-2050-3bf7-b14e-fdcbbdbd1f73",
                                "text": "\"Ein Lachter entsprach in etwa dem Maß, welches ein Mann mit ausgestreckten Armen umfassen konnte.\""
                            },
                            {
                                "example_id": "558ff529-4b66-4217-9456-be21a4c55700",
                                "sense_id": "89aead11-2050-3bf7-b14e-fdcbbdbd1f73",
                                "text": "Das Lachter ist gewissermaßen das bergmännische Klafter."
                            },
                            {
                                "example_id": "607a858e-8929-4a8e-8772-5a77e5b73fd5",
                                "sense_id": "89aead11-2050-3bf7-b14e-fdcbbdbd1f73",
                                "text": "„Und wenn seine Frau ausging, trottete er zwanzig Lachter von ihr entfernt hinterdrein, und wenn sie in ein Haus ging, wartete er draußen auf dem Wege, betrachtete den Himmel und spuckte; blieb sie jedoch lange fort, klopfte er an die Hautür und sagte, daß er auf seine Frau warte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
