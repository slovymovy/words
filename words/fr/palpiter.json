{
    "word_family": [
        "palpitant",
        "palpitation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "053eccae-208b-3a04-af68-cb025cc19c6a",
                    "sense_definition": "Battre avec un rythme régulier, accéléré ou saccadé, en parlant du cœur ou des artères.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "battement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue course sous le soleil, son cœur se mit à <w>palpiter</w> très vite."
                        },
                        {
                            "text": "Le médecin pose la main sur sa poitrine pour sentir <w>palpiter</w> son cœur avant l'examen."
                        }
                    ],
                    "synonyms": [
                        "battre"
                    ],
                    "common_phrases": [
                        "sentir palpiter son cœur",
                        "faire palpiter le cœur"
                    ]
                },
                {
                    "sense_id": "d7f5a298-4437-3ffe-a420-8e38d44772b6",
                    "sense_definition": "Éprouver une vive émotion, vibrer sous le coup de l'impatience, de l'angoisse ou de l'espoir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute l'assemblée <w>palpite</w> d'angoisse en attendant les résultats officiels du concours."
                        },
                        {
                            "text": "L'adolescent <w>palpitait</w> d'espérance en ouvrant cette mystérieuse lettre cachetée."
                        }
                    ],
                    "common_phrases": [
                        "palpiter d'impatience",
                        "palpiter d'angoisse"
                    ]
                },
                {
                    "sense_id": "3be9ed88-3458-355c-a79c-80832de99e85",
                    "sense_definition": "Être agité de petits tressaillements ou de contractions involontaires et répétées.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À cause de la fatigue et du stress, sa paupière gauche n'arrête pas de <w>palpiter</w>."
                        },
                        {
                            "text": "Le petit oiseau blessé <w>palpitait</w> doucement entre les mains de la vétérinaire."
                        }
                    ],
                    "common_phrases": [
                        "paupière qui palpite"
                    ]
                }
            ]
        }
    ]
}