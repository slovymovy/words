    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea45507b-20c0-3bad-b25b-8e27ac20c8cf",
                    "sense_definition": "Small in amount or effect; barely meeting a standard or requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The improvement in his test scores was <w>marginal</w> at best.",
                            "target_lang_translations": {
                                "ru": "Улучшение его результатов теста было в лучшем случае <w>незначительным</w>.",
                                "zh": "他的考试成绩提高得充其量也很<w>有限</w>。"
                            }
                        },
                        {
                            "text": "The pilots struggled to land the plane in <w>marginal</w> weather conditions.",
                            "target_lang_translations": {
                                "ru": "Пилоты с трудом посадили самолет в <w>предельных</w> погодных условиях.",
                                "zh": "飞行员在<w>临界</w>天气条件下艰难地让飞机着陆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slight",
                        "minimal",
                        "negligible"
                    ],
                    "antonyms": [
                        "significant",
                        "substantial"
                    ],
                    "common_phrases": [
                        "marginal weather conditions",
                        "marginal improvement",
                        "marginal difference"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный по количеству или эффекту; едва соответствующий стандарту или требованию.",
                        "zh": "数量或影响很小；勉强达到某种标准或要求的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незначительный",
                                "target_lang_sense_clarification": "о количестве или эффекте"
                            },
                            {
                                "target_lang_word": "минимальный",
                                "target_lang_sense_clarification": "едва достаточный"
                            },
                            {
                                "target_lang_word": "предельный",
                                "target_lang_sense_clarification": "о погодных условиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有限的",
                                "target_lang_sense_clarification": "数量、程度或影响很小"
