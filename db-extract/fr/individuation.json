        "fr-extract.jsonl": [
            {
                "entry_id": "0ac3f7b0-ee7b-3ec7-8383-f169c09673a8",
                "word": "individuation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "470cd0ef-f545-4abb-bbc9-1825151481ab",
                        "entry_id": "0ac3f7b0-ee7b-3ec7-8383-f169c09673a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "individuations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df839b39-0eb9-3984-be9a-fbfa28e39964",
                        "entry_id": "0ac3f7b0-ee7b-3ec7-8383-f169c09673a8",
                        "glosses": [
                            "Ce qui fait qu’un individu diffère d’un autre individu."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "40cebe17-52b7-4319-9ff2-97957ddedf75",
                                "sense_id": "df839b39-0eb9-3984-be9a-fbfa28e39964",
                                "text": "Devenir un individu, c'est aussi une expérience intime […] Bien sûr, l'individuation est tout autant un cheminement intime, qui se construit dans la sphère familiale, privée. L'individuation est tout simplement l'enjeu de l'éducation, qu'elle soit parentale, scolaire, populaire."
                            },
                            {
                                "example_id": "6863a887-4b90-4fa8-b71c-5bd285eff605",
                                "sense_id": "df839b39-0eb9-3984-be9a-fbfa28e39964",
                                "text": "Dira-t-on que le principe d'individuation réside dans les accidents matériels qui se surajoutent à l'essence spécifique : […]?"
                            },
                            {
                                "example_id": "85a0c5f7-bed3-4352-b0b3-0a7964138b77",
                                "sense_id": "df839b39-0eb9-3984-be9a-fbfa28e39964",
                                "text": "Plus qu'un travail psychologique de développement personnel, le processus d'individuation est un cheminement spirituel."
                            }
                        ]
                    }
                ],
