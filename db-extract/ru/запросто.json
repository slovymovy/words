                        "translation_id": "91469306-0c64-4c71-b86a-28014cce35d4",
                        "source_entry_id": "1e4e0c79-ea4b-3729-8f92-0540f42b0ad5",
                        "source_sense_description": "без соблюдения общепринятых формальностей",
                        "target_lang_word": "unceremoniously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unceremoniously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                                        "entry_id": "33fe4504-ccd6-33b7-86be-271fd4e9db46",
                                        "glosses": [
                                            "In an unceremonious manner, abruptly, without the due formalities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49bef1e-270c-40ef-95f7-63f6984881f0",
                                                "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                                                "text": "Encountering difficulties with the parcels’ unhelpful recipient, the deliveryman unceremoniously dumped the packages in the street outside the door."
                                            },
                                            {
                                                "example_id": "14ef131d-3037-4f42-9f61-51b678a433e3",
                                                "sense_id": "3243781a-cb7e-3b2b-b8a2-0611b77d99c3",
                                                "text": "Given these operational constraints and a renewed focus on the environment, plans to electrify the [Windermere] branch resurfaced in 2013 when the Department for Transport consented to a £16 million scheme to erect wires by 2024. Unfortunately, it was one of a trio of projects to then be unceremoniously scrapped by former Secretary of State for Transport Chris Grayling in July 2017, in response to spiralling costs on the Great Western Electrification Programme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bc978a7-56e0-4250-976d-78323da48227",
                        "source_entry_id": "1e4e0c79-ea4b-3729-8f92-0540f42b0ad5",
                        "source_sense_description": "без соблюдения общепринятых формальностей",
                        "target_lang_word": "without ceremony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "without ceremony",
