                                                "example_id": "3ca6e973-ad09-459e-aaaa-81447e94d14d",
                                                "sense_id": "2577af3e-79ba-310c-b69f-75115df40ea9",
                                                "text": "a battle cry"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc15be2f-208b-3ff7-bc93-b77b0c7ecfda",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A clamour or outcry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d4f4ee-790a-4d9e-8dd9-a22dbac5fe65",
                                                "sense_id": "fc15be2f-208b-3ff7-bc93-b77b0c7ecfda",
                                                "text": "His pupil, Maimonides, that he might not be under the necessity of violating the laws of friendship and gratitude, by joining the general cry against Averroes, left Corduba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10334940-f490-31fe-ae1a-8dee4cd8f2cf",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A group of hounds."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81075426-f358-4d6d-9a7e-dce09984c298",
                                                "sense_id": "10334940-f490-31fe-ae1a-8dee4cd8f2cf",
                                                "text": "A cry more tunable / Was never hollaed to, nor cheered with horn."
                                            },
                                            {
                                                "example_id": "5709b78e-635d-4c07-aea3-0d9eddef032c",
                                                "sense_id": "10334940-f490-31fe-ae1a-8dee4cd8f2cf",
                                                "text": "1667, Milton, Paradise Lost, Book II, in Edward Hawkins, The Poetical Works of John Milton: With Notes of Various Authors, Vol. I, W. Baxter, J. Parker, G. B. Whittaker (publs., 1824) pages 124 to 126, lines 648 to 659.\n[…] Before the gates there sat / On either side a formidable shape; / The one seem’d woman to the waste, and fair, / But ended foul in many a scaly fold / Voluminous and vast, a serpent arm’d / With mortal sting: about her middle round / A cry of hell-hounds never ceasing bark’d / With wide Cerberean mouths full loud and rung / A hideous peal; yet, when they list,would creep, / If ought disturb'd their noise, into her womb, / and kennel there, yet there still bark’d and howl’d, / Within unseen. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61f67c0d-f89d-327d-a0a0-c4f05fbf4fca",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A pack or company of people."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43466775-9ce0-4744-8d31-4bf4f577bcb1",
                                                "sense_id": "61f67c0d-f89d-327d-a0a0-c4f05fbf4fca",
                                                "text": "Would not this […] get me a fellowship in a cry of players?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eeaadc2-7541-338f-9c13-9df002ce36f8",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A typical sound made by the species in question."
                                        ],
                                        "tags": [
                                            "of an animal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a03b26b-725d-4d54-8355-af90f91fbcba",
                                                "sense_id": "3eeaadc2-7541-338f-9c13-9df002ce36f8",
                                                "text": "\"Woof\" is the cry of a dog, while \"neigh\" is the cry of a horse."
                                            },
                                            {
                                                "example_id": "0bb874c2-0eb1-4623-aa37-ea4baf34e1dd",
                                                "sense_id": "3eeaadc2-7541-338f-9c13-9df002ce36f8",
                                                "text": "But the shrill wild cry of the heron overpowered the cries of all the other birds, whom it seemed to terrify; they were silent the moment they heard it, and a silence followed which made the interruption doubly unpleasant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dded9567-a003-3543-b126-152025fd9ce2",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "A desperate or urgent request."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dba8bb68-1a82-34e1-a574-588c5a0d82b2",
                                        "entry_id": "df1195c7-cf2f-300c-8b0f-7ca63fbd65a0",
                                        "glosses": [
                                            "Common report; gossip."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fbd16da-59ff-4b04-84fd-c35858c88f25",
                                                "sense_id": "dba8bb68-1a82-34e1-a574-588c5a0d82b2",
                                                "text": "The cry goes that you shall marry her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
