{
    "word_family": [
        "expiration",
        "expiry",
        "expiratory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43a1af47-2db8-36b0-a2be-07ab1b8418a3",
                    "sense_definition": "To reach the end of a period of validity and become no longer usable or effective.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to renew my passport because it will <w>expire</w> next month.",
                            "target_lang_translations": {
                                "ru": "Мне нужно обновить паспорт, потому что его срок действия <w>истекает</w> в следующем месяце.",
                                "zh": "我需要更新护照，因为它下个月就要<w>过期</w>了。",
                                "es": "Necesito renovar mi pasaporte porque <w>vencerá</w> el próximo mes."
                            }
                        },
                        {
                            "text": "Please check the <w>expire</w> date on the milk carton before you drink it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте дату <w>истечения</w> срока годности на пакете молока, прежде чем пить его.",
                                "zh": "喝牛奶前，请先检查包装盒上的<w>过期</w>日期。",
                                "es": "Por favor, comprueba la fecha de <w>caducidad</w> en el cartón de leche antes de beberla."
                            }
                        }
                    ],
                    "synonyms": [
                        "lapse",
                        "run out",
                        "terminate"
                    ],
                    "common_phrases": [
                        "expire date",
                        "soon to expire",
                        "contract will expire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закончиться по истечении срока действия; стать недействительным.",
                        "zh": "指证件、合同或物品的有效期结束，不再具有法律效力或使用价值。",
                        "es": "Alcanzar el final de un periodo de validez y dejar de ser utilizable o efectivo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о сроке действия"
                            },
                            {
                                "target_lang_word": "заканчиваться",
                                "target_lang_sense_clarification": "о сроке годности или действия"
                            },
                            {
                                "target_lang_word": "истечь",
                                "target_lang_sense_clarification": "совершенный вид, о сроке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "过期",
                                "target_lang_sense_clarification": "指时间超过了有效期"
                            },
                            {
                                "target_lang_word": "失效",
                                "target_lang_sense_clarification": "指不再具有效力"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vencer",
                                "target_lang_sense_clarification": "dicho de un plazo, contrato o norma que pierde su validez"
                            },
                            {
                                "target_lang_word": "caducar",
                                "target_lang_sense_clarification": "dicho de un producto o documento que pierde su utilidad por el paso del tiempo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f1abb4f-d89d-3bb7-9954-cb9abb940c18",
                    "sense_definition": "To come to an end or conclude, often referring to a period of time or an agreement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conclusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lease on our apartment is about to <w>expire</w> at the end of the year.",
                            "target_lang_translations": {
                                "ru": "Срок аренды нашей квартиры <w>истекает</w> в конце года.",
                                "zh": "我们公寓的租约将在年底<w>期满</w>。",
                                "es": "El contrato de alquiler de nuestro apartamento está a punto de <w>vencer</w> a finales de año."
                            }
                        },
                        {
                            "text": "Once the introductory offer <w>expires</w>, the price will return to the standard rate.",
                            "target_lang_translations": {
                                "ru": "Как только срок действия ознакомительного предложения <w>закончится</w>, цена вернется к стандартному тарифу.",
                                "zh": "一旦优惠活动<w>结束</w>，价格将恢复到标准费率。",
                                "es": "Una vez que la oferta de introducción <w>termine</w>, el precio volverá a la tarifa estándar."
                            }
                        }
                    ],
                    "synonyms": [
                        "end",
                        "finish",
                        "conclude"
                    ],
                    "common_phrases": [
                        "term expires",
                        "offer expires",
                        "period expires"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подойти к концу или завершиться (о периоде времени, договоре или предложении).",
                        "zh": "指一段时间、协议或合同期满而终止。",
                        "es": "Llegar a su fin o concluir, a menudo refiriéndose a un periodo de tiempo o un acuerdo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истекать",
                                "target_lang_sense_clarification": "о времени или договоре"
                            },
                            {
                                "target_lang_word": "завершаться",
                                "target_lang_sense_clarification": "о периоде или соглашении"
                            },
                            {
                                "target_lang_word": "кончаться",
                                "target_lang_sense_clarification": "о времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "期满",
                                "target_lang_sense_clarification": "指期限届满"
                            },
                            {
                                "target_lang_word": "终止",
                                "target_lang_sense_clarification": "指协议或合同结束"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "vencer",
                                "target_lang_sense_clarification": "llegar al fin de un plazo o contrato"
                            },
                            {
                                "target_lang_word": "terminar",
                                "target_lang_sense_clarification": "concluir un periodo de tiempo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb8e88b-7ba1-3015-baf1-b31d15c50c9e",
                    "sense_definition": "To die; to draw one's last breath.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elderly patient <w>expired</w> peacefully in his sleep surrounded by family.",
                            "target_lang_translations": {
                                "ru": "Пожилой пациент мирно <w>скончался</w> во сне в окружении семьи.",
                                "zh": "那位年迈的病人在家人的陪伴下在睡梦中安详地<w>去世</w>了。",
                                "es": "El paciente anciano <w>falleció</w> pacíficamente mientras dormía rodeado de su familia."
                            }
                        },
                        {
                            "text": "Medical records show that the victim <w>expired</w> shortly after arriving at the hospital.",
                            "target_lang_translations": {
                                "ru": "Медицинские записи показывают, что пострадавший <w>умер</w> вскоре после прибытия в больницу.",
                                "zh": "医疗记录显示，受害者在抵达医院后不久便<w>死亡</w>了。",
                                "es": "Los registros médicos muestran que la víctima <w>falleció</w> poco después de llegar al hospital."
                            }
                        }
                    ],
                    "synonyms": [
                        "decease",
                        "pass away",
                        "perish",
                        "succumb"
                    ],
                    "common_phrases": [
                        "patient expired"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in medical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скончаться, испустить последний вздох (обычно в медицинском или официальном контексте).",
                        "zh": "指人死亡，通常用于医学或正式场合。",
                        "es": "Morir; dejar de respirar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скончаться",
                                "target_lang_sense_clarification": "официально о смерти"
                            },
                            {
                                "target_lang_word": "испустить дух",
                                "target_lang_sense_clarification": "книжное"
                            },
                            {
                                "target_lang_word": "умереть",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "去世",
                                "target_lang_sense_clarification": "委婉的说法"
                            },
                            {
                                "target_lang_word": "死亡",
                                "target_lang_sense_clarification": "正式用语"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "fallecer",
                                "target_lang_sense_clarification": "término formal para morir"
                            },
                            {
                                "target_lang_word": "morir",
                                "target_lang_sense_clarification": "término general"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27689d11-047d-3328-a329-26eaa77105d1",
                    "sense_definition": "To exhale or breathe out air from the lungs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to inspire deeply and then slowly <w>expire</w>.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента глубоко вдохнуть, а затем медленно <w>выдохнуть</w>.",
                                "zh": "医生让病人深吸一口气，然后缓慢地<w>呼气</w>。",
                                "es": "El médico pidió al paciente que inspirara profundamente y luego <w>espirara</w> lentamente."
                            }
                        },
                        {
                            "text": "Humans <w>expire</w> carbon dioxide as a byproduct of cellular respiration.",
                            "target_lang_translations": {
                                "ru": "Люди <w>выдыхают</w> углекислый газ как побочный продукт клеточного дыхания.",
                                "zh": "人类作为细胞呼吸的副产品会<w>呼出</w>二氧化碳。",
                                "es": "Los humanos <w>exhalan</w> dióxido de carbono como subproducto de la respiración celular."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhale",
                        "breathe out"
                    ],
                    "antonyms": [
                        "inspire"
                    ],
                    "common_phrases": [
                        "expire air"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical or physiological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдыхать воздух из легких.",
                        "zh": "指从肺部呼出空气。",
                        "es": "Exhalar o expulsar aire de los pulmones."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдыхать",
                                "target_lang_sense_clarification": "физиологический процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "呼气",
                                "target_lang_sense_clarification": "生理学上的呼出动作"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "exhalar",
                                "target_lang_sense_clarification": "expulsar aire de los pulmones"
                            },
                            {
                                "target_lang_word": "espirar",
                                "target_lang_sense_clarification": "término técnico o fisiológico para expulsar aire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5f27505-3c78-3697-b9b3-9b8abc3bd18f",
                    "sense_definition": "To emit or give forth a fluid, vapor, or minute particles gently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The damp soil began to <w>expire</w> a thick mist as the morning sun warmed the ground.",
                            "target_lang_translations": {
                                "ru": "Влажная почва начала <w>источать</w> густой туман, когда утреннее солнце прогрело землю.",
                                "zh": "当晨曦温暖大地时，潮湿的土壤开始<w>散发</w>出浓雾。",
                                "es": "El suelo húmedo comenzó a <w>exhalar</w> una espesa niebla a medida que el sol de la mañana calentaba la tierra."
                            }
                        },
                        {
                            "text": "Certain flowers <w>expire</w> a heavy scent only during the late hours of the night.",
                            "target_lang_translations": {
                                "ru": "Определенные цветы <w>издают</w> сильный аромат только в поздние ночные часы.",
                                "zh": "有些花只在深夜才会<w>散发</w>出浓郁的香气。",
                                "es": "Ciertas flores <w>emanan</w> un aroma intenso solo durante las últimas horas de la noche."
                            }
                        }
                    ],
                    "synonyms": [
                        "emit",
                        "exude",
                        "release"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English for this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять или испускать жидкость, пар или аромат (устаревшее).",
                        "zh": "指缓慢地散发出液体、蒸汽或气味（古语）。",
                        "es": "Emitir o desprender un fluido, vapor o partículas diminutas suavemente."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "источать",
                                "target_lang_sense_clarification": "о запахе или влаге"
                            },
                            {
                                "target_lang_word": "выделять",
                                "target_lang_sense_clarification": "о веществе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "散发",
                                "target_lang_sense_clarification": "指气味或蒸汽"
                            },
                            {
                                "target_lang_word": "渗出",
                                "target_lang_sense_clarification": "指液体或湿气"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "exhalar",
                                "target_lang_sense_clarification": "desprender o emitir un olor o vapor"
                            },
                            {
                                "target_lang_word": "emanar",
                                "target_lang_sense_clarification": "desprenderse de un cuerpo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}