        "fr-extract.jsonl": [
            {
                "entry_id": "51772105-43ad-36e0-b61f-3bba94b6b32d",
                "word": "chefferie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "25242868-7932-4b92-8bc2-95ce2428ec27",
