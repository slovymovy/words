                "senses": [
                    {
                        "sense_id": "de81b8e4-9d0d-3163-a122-88e5d18dfdb0",
                        "entry_id": "81e57d91-6df7-3926-b7fd-2dca5b165898",
                        "glosses": [
                            "der auf einen atomaren Angriff folgende Vergeltungsschlag, der mit Waffen geführt wird, die durch den ersten Atomangriff aufgrund ihrer Stationierung oder ihrer Mobilität prinzipiell nicht ausgeschaltet werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38deb7c9-5359-444f-8f3c-e3aa47338606",
                                "sense_id": "de81b8e4-9d0d-3163-a122-88e5d18dfdb0",
                                "text": "Der Begriff Zweitschlag steht in der Philosophie des Kalten Krieges für einen umfassenden Vergeltungsschlag auf einen atomaren Erstschlag."
                            },
                            {
                                "example_id": "c0719060-40d8-48d0-b25b-9de6f18107ba",
                                "sense_id": "de81b8e4-9d0d-3163-a122-88e5d18dfdb0",
                                "text": "Diesem Land fehlt die Fähigkeit zu einem militärischen Zweitschlag."
                            },
                            {
                                "example_id": "bf1d0881-d3c3-4a21-adaa-315853d941a5",
                                "sense_id": "de81b8e4-9d0d-3163-a122-88e5d18dfdb0",
                                "text": "„Seegestützte Interkontinentalraketen stellten die Fähigkeit zum Zweitschlag sicher, sollte der Gegner versuchen, mit einem Überraschungsschlag die landgestützten Systeme auszuschalten.“"
                            },
                            {
                                "example_id": "510f4ed6-c516-47bc-9c99-e3c42fa1abbc",
                                "sense_id": "de81b8e4-9d0d-3163-a122-88e5d18dfdb0",
                                "text": "„Sie sollen den Streitkräften nur im letzten Moment übergeben werden, wenn Indien einen nuklearen Erstschlag erlitten hat und zum Zweitschlag ausholen will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
