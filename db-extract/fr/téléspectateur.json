                                            {
                                                "example_id": "0c5fee03-0045-4d6e-8926-7e44340cd338",
                                                "sense_id": "68124c58-e7f8-3b56-aa6a-4007f649c136",
                                                "text": "In vielen Sendungen werden die Fernsehzuschauer dazu aufgefordert, per Telefon eine Preisfrage zu beantworten."
