            "senses": [
                {
                    "sense_id": "2154f1a1-5766-3dc0-8050-b13d6a0dda45",
                    "sense_definition": "Present participle and gerund of <w>try</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am <w>trying</w> to finish my homework before dinner.",
                            "target_lang_translations": {
                                "ru": "Я <w>пытаюсь</w> закончить домашнюю работу до ужина.",
                                "pl": "<w>Próbuję</w> skończyć pracę domową przed kolacją."
                            }
                        },
                        {
                            "text": "She is <w>trying</w> to learn how to play the guitar.",
                            "target_lang_translations": {
                                "ru": "Она <w>пытается</w> научиться играть на гитаре.",
                                "pl": "Ona <w>stara się</w> nauczyć grać na gitarze."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола try (пытаться).",
                        "pl": "Imiesłów czasu teraźniejszego (present participle) i gerundium od czasownika try (próbować, starać się)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пытаться",
                                "target_lang_sense_clarification": "делать попытку"
                            },
