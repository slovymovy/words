{
    "word_family": [
        "studly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29fe6409-1dff-36a8-aca1-82a5a05c1b23",
                    "sense_definition": "A small metal or plastic object that sticks out from a surface, often used for decoration, grip on shoes, or as a fastener.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "protrusion_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The football player checked his <w>studs</w> before running onto the muddy field.",
                            "target_lang_translations": {
                                "ru": "Футболист проверил свои <w>шипы</w> перед тем, как выбежать на грязное поле.",
                                "zh": "足球运动员在跑进泥泞的场地前检查了他的<w>鞋钉</w>。"
                            }
                        },
                        {
                            "text": "Her leather jacket was covered in silver <w>studs</w> to give it a punk style.",
                            "target_lang_translations": {
                                "ru": "Её кожаная куртка была покрыта серебряными <w>заклёпками</w> для придания панк-стиля.",
                                "zh": "她的皮夹克上布满了银色<w>铆钉</w>，以展现朋克风格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metal studs",
                        "football studs",
                        "press stud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой металлический или пластиковый выступ на поверхности, используемый для украшения, сцепления (на обуви) или как застежка.",
                        "zh": "表面上突出的金属或塑料小物件，常用于装饰、增加鞋底抓地力或作为紧固件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "на подошве обуви или шине"
                            },
                            {
                                "target_lang_word": "заклёпка",
                                "target_lang_sense_clarification": "декоративная деталь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鞋钉",
                                "target_lang_sense_clarification": "用于运动鞋底的防滑钉"
                            },
                            {
                                "target_lang_word": "铆钉",
                                "target_lang_sense_clarification": "用于装饰或加固的金属扣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb5c2e2f-2682-340b-8bc6-53f181c19a51",
                    "sense_definition": "A small piece of jewelry worn in the ear that is attached with a straight post.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protrusion_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a simple pair of diamond <w>studs</w> to the wedding.",
                            "target_lang_translations": {
                                "ru": "Она надела на свадьбу простую пару бриллиантовых <w>гвоздиков</w>.",
                                "zh": "她戴着一对简约的钻石<w>耳钉</w>参加了婚礼。"
                            }
                        },
                        {
                            "text": "I lost one of my gold <w>studs</w> while I was swimming in the ocean.",
                            "target_lang_translations": {
                                "ru": "Я потеряла один из своих золотых <w>гвоздиков</w>, когда плавала в океане.",
                                "zh": "我在海里游泳时弄丢了一只金<w>耳钉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "diamond studs",
                        "pair of studs",
                        "gold studs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое украшение, которое носят в ухе (серьга-гвоздик).",
                        "zh": "一种通过直针固定在耳朵上的小型耳饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гвоздик",
                                "target_lang_sense_clarification": "разговорное название серег"
                            },
                            {
                                "target_lang_word": "пуссета",
                                "target_lang_sense_clarification": "ювелирный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳钉",
                                "target_lang_sense_clarification": "针式耳环"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc09622-04de-3b0d-87c8-30c11436fea2",
                    "sense_definition": "A vertical wooden or metal post inside the frame of a wall, used to support the structure.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to find a <w>stud</w> before you drill a heavy shelf into the wall.",
                            "target_lang_translations": {
                                "ru": "Нужно найти <w>стойку</w>, прежде чем прикручивать тяжелую полку к стене.",
                                "zh": "在墙上钻孔安装重型搁板之前，你需要先找到<w>龙骨</w>。"
                            }
                        },
                        {
                            "text": "The carpenter spaced the wooden <w>studs</w> sixteen inches apart.",
                            "target_lang_translations": {
                                "ru": "Плотник установил деревянные <w>стойки</w> на расстоянии шестнадцати дюймов друг от друга.",
                                "zh": "木匠将木制<w>龙骨</w>按十六英寸的间距排列。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wall studs",
                        "find a stud"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in construction and DIY contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальная стойка внутри каркаса стены, используемая для опоры конструкции.",
                        "zh": "墙体框架内的垂直木制或金属支柱，用于支撑结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "элемент каркаса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "龙骨",
                                "target_lang_sense_clarification": "建筑墙体内部的支撑结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb5e999d-f40e-31a7-88d3-e2c1d0512fb4",
                    "sense_definition": "A man who is considered to be sexually attractive and masculine.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "breeding_sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thinks he is a real <w>stud</w> just because he drives a fast car.",
                            "target_lang_translations": {
                                "ru": "Он считает себя настоящим <w>жеребцом</w> только потому, что водит быструю машину.",
                                "zh": "他以为自己是个<w>猛男</w>，仅仅是因为他开着一辆快车。"
                            }
                        },
                        {
                            "text": "All the girls at the party were looking at the handsome <w>stud</w> by the door.",
                            "target_lang_translations": {
                                "ru": "Все девушки на вечеринке смотрели на красивого <w>жеребца</w> у двери.",
                                "zh": "派对上的女孩们都在注视着门口那位帅气的<w>猛男</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hunk",
                        "he-man"
                    ],
                    "common_phrases": [
                        "real stud",
                        "young stud"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужчина, который считается сексуально привлекательным и мужественным.",
                        "zh": "被认为具有性吸引力和阳刚之气的男性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жеребец",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛男",
                                "target_lang_sense_clarification": "俚语，指非常有魅力的男性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e842cf4-7eab-3b40-bce1-c2323bcff700",
                    "sense_definition": "A male animal, especially a horse, that is kept for breeding.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "breeding_sexual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prize-winning horse was retired from racing and put out to <w>stud</w>.",
                            "target_lang_translations": {
                                "ru": "Лошадь-призера сняли со скачек и отправили в <w>производители</w>.",
                                "zh": "这匹获奖马退役后被送去做了<w>种马</w>。"
                            }
                        },
                        {
                            "text": "The farmer bought a new <w>stud</w> to improve the quality of his herd.",
                            "target_lang_translations": {
                                "ru": "Фермер купил нового <w>производителя</w>, чтобы улучшить качество своего стада.",
                                "zh": "农场主买了一匹新的<w>种马</w>来改良他的畜群质量。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stallion",
                        "sire"
                    ],
                    "common_phrases": [
                        "at stud",
                        "stud horse",
                        "stud farm"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical in agriculture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самец животного (особенно лошади), которого содержат для разведения.",
                        "zh": "用于繁殖的雄性动物，尤指马。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "производитель",
                                "target_lang_sense_clarification": "животное для разведения"
                            },
                            {
                                "target_lang_word": "племенной жеребец",
                                "target_lang_sense_clarification": "о лошадях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "种马",
                                "target_lang_sense_clarification": "用于配种的雄性马匹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5a8c738-dd3b-3905-9a68-4f3d3f91e379",
                    "sense_definition": "A type of poker game in which players receive a mix of face-down and face-up cards.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The men gathered in the back room every Friday night to play <w>stud</w>.",
                            "target_lang_translations": {
                                "ru": "Мужчины собирались в задней комнате каждую пятницу вечером, чтобы поиграть в <w>стад</w>.",
                                "zh": "男人们每周五晚上都会聚在后屋玩<w>梭哈</w>。"
                            }
                        },
                        {
                            "text": "He lost all his money playing seven-card <w>stud</w> at the casino.",
                            "target_lang_translations": {
                                "ru": "Он проиграл все свои деньги, играя в семикарточный <w>стад</w> в казино.",
                                "zh": "他在赌场玩七张牌<w>梭哈</w>时输光了所有的钱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stud poker"
                    ],
                    "common_phrases": [
                        "play stud",
                        "seven-card stud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разновидность покера, в которой игроки получают смесь открытых и закрытых карт.",
                        "zh": "一种扑克游戏，玩家会收到部分明牌和部分暗牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стад",
                                "target_lang_sense_clarification": "вид покера"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "梭哈",
                                "target_lang_sense_clarification": "一种扑克玩法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5985e059-5b4d-389c-9e68-e6c92da8e406",
                    "sense_definition": "To cover or decorate a surface with many small objects scattered across it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "protrusion_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>stud</w> the holiday ham with cloves before baking it.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>нашпиговать</w> праздничную ветчину гвоздикой перед запеканием.",
                                "zh": "烘烤前，你应该在节日火腿上<w>镶嵌</w>丁香。"
                            }
                        },
                        {
                            "text": "Millions of bright stars <w>stud</w> the dark sky on a clear winter night.",
                            "target_lang_translations": {
                                "ru": "Миллионы ярких звезд <w>усеивают</w> темное небо ясной зимней ночью.",
                                "zh": "晴朗的冬夜，数百万颗明亮的星星<w>点缀</w>着漆黑的夜空。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stud with",
                        "thickly stud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или украшать поверхность множеством мелких предметов.",
                        "zh": "在表面上散布或装饰许多小物件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усеивать",
                                "target_lang_sense_clarification": "покрывать поверхность"
                            },
                            {
                                "target_lang_word": "нашпиговывать",
                                "target_lang_sense_clarification": "в кулинарии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "点缀",
                                "target_lang_sense_clarification": "装饰表面"
                            },
                            {
                                "target_lang_word": "镶嵌",
                                "target_lang_sense_clarification": "嵌入或装饰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}