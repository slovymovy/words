                "senses": [
                    {
                        "sense_id": "9f4d5069-e352-3f66-a037-de18743bf619",
                        "entry_id": "d474797b-bf78-3f49-b71e-bb72c8ae6287",
                        "glosses": [
                            "tropischer Wirbelsturm im nordwestlichen Teil des Pazifischen Ozeans"
                        ],
                        "tags": [],
