                            {
                                "example_id": "710b22c8-5ea1-4825-bc4b-f042e7a0e0b0",
                                "sense_id": "8e5f7ec5-ecfe-3ce0-a7ee-54c3324d5ab0",
                                "text": "Tijdens het gala droegen alle meisjes een avondjurk."
                            },
                            {
                                "example_id": "b985126a-ade8-45b5-8ac2-d7d5139db4c0",
                                "sense_id": "8e5f7ec5-ecfe-3ce0-a7ee-54c3324d5ab0",
                                "text": "Hij had die schilderopdracht niet moeten aannemen, hij had Teresa moeten zeggen dat ze ergens anders werk moest zoeken, hij had Olive in het donker niet moeten tegenhouden, in haar avondjurk en met haar haar dat alle kanten uit stond."
                            }
                        ]
                    }
