                        "examples": [
                            {
                                "example_id": "26fd400f-b3bd-4e53-a2ef-50c2a4d3bee5",
                                "sense_id": "6a38e098-c6fd-356f-85ac-1f27e194dc4c",
                                "text": "La diminution de la volémie expose à une hypotension, donc à des lésions de bas débit chez l’athéromateux, pouvant provoquer une insuffisance rénale aiguë."
