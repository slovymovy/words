                "senses": [
                    {
                        "sense_id": "bb29db81-7ffa-33cc-a555-85d7ce95cb0a",
                        "entry_id": "2c99f6da-377b-3872-8692-82a219276010",
                        "glosses": [
                            "Stelle (Geschäft, Büro oder Ähnliches), an der bestimmte Dinge entgegengenommen werden oder abgegeben werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca342fb-916f-488b-b9a8-ba0273646d19",
                                "sense_id": "bb29db81-7ffa-33cc-a555-85d7ce95cb0a",
                                "text": "„Mehrere deutsche Städte wollen Hamburger Modell übernehmen – 76 Prozent befürworten anonyme Abgabestelle für Neugeborene“."
                            },
                            {
                                "example_id": "469f88f7-0e5d-48e8-9565-7fde1a79bb23",
                                "sense_id": "bb29db81-7ffa-33cc-a555-85d7ce95cb0a",
                                "text": "„Für einen Pkw voll mit gefalteten Kartons aus Mutters Lebensmittelgeschäft zahlte ihm die Abgabestelle für Altpapier sogar 24 Zloty.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65c19164-1337-3f68-8966-2134c3c9c40d",
                        "entry_id": "2c99f6da-377b-3872-8692-82a219276010",
                        "glosses": [
                            "Stelle (Geschäft, Büro oder Ähnliches), an der bestimmte Dinge ausgegeben/abgegeben werden, zu erhalten sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8866cbd2-2d41-4db6-a79c-bce5b7c1c118",
                                "sense_id": "65c19164-1337-3f68-8966-2134c3c9c40d",
                                "text": "„Lange Schlangen vor Abgabestelle von Gratis-Benzin in New York“ (Artikelüberschrift)"
                            },
                            {
                                "example_id": "ff2be58c-12ff-47ae-9efd-bcbcd74f584a",
                                "sense_id": "65c19164-1337-3f68-8966-2134c3c9c40d",
                                "text": "„Sollte der Plan in die Tat umgesetzt werden, könnte sich der gesamte Stadtteil Hammerbrook zu einem weiteren Szenestandort entwickeln. Es ist unter anderem im Gespräch die Abgabestelle für Heroin an der Süderstraße anzusiedeln.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
