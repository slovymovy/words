                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "thrilling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d0d666e-ea4c-3343-934c-3517c5bd7ad7",
                                        "entry_id": "5ea26f8a-ab0b-3e68-a750-73bd9e497b38",
                                        "glosses": [
                                            "Causing a feeling of sudden excitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8ed88a-4b9b-4fe1-88f2-26c8b48efd81",
                                                "sense_id": "0d0d666e-ea4c-3343-934c-3517c5bd7ad7",
                                                "text": "He was thinking; but the glory of the song, the swell from the great organ, the clustered lights, […], the height and vastness of this noble fane, its antiquity and its strength—all these things seemed to have their part as causes of the thrilling emotion that accompanied his thoughts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "thrilling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfe3609b-f846-30b9-bb62-077753d58781",
                                        "entry_id": "a03390ec-7a4c-3092-83af-4b3a3bb7653b",
                                        "glosses": [
                                            "A thrill."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf21380-3431-42aa-85d7-6c98bb335739",
                                                "sense_id": "bfe3609b-f846-30b9-bb62-077753d58781",
                                                "text": "[…] my heart told me that she did all be stirred with small thrillings of defiance unto me, and with thrillings of love […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
