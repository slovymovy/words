            "senses": [
                {
                    "sense_id": "e5fd9be1-f30e-3330-aec0-f3e83af4ce48",
                    "sense_definition": "ptaki hodowane przez człowieka dla mięsa, jaj lub piór, takie jak kury, kaczki, gęsi i indyki",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ptactwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnik każdego ranka wypuszcza <w>drób</w> na ogrodzony wybieg.",
                            "target_lang_translations": {
                                "ru": "Каждое утро фермер выпускает <w>домашнюю птицу</w> в огороженный загон."
                            }
                        },
                        {
                            "text": "Gospodarstwo mojej babci specjalizuje się w hodowli <w>drobiu</w>.",
                            "target_lang_translations": {
                                "ru": "Ферма моей бабушки специализируется на разведении <w>птицы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hodowla drobiu"
                    ],
                    "target_lang_definitions": {
                        "ru": "птицы, разводимые человеком ради мяса, яиц или перьев, такие как куры, утки, гуси и индейки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "домашняя птица",
                                "target_lang_sense_clarification": "разводимые человеком птицы"
                            },
                            {
                                "target_lang_word": "птица",
                                "target_lang_sense_clarification": "собир., в сельском хозяйстве"
                            },
                            {
                                "target_lang_word": "живность",
                                "target_lang_sense_clarification": "разг., о птице и мелком скоте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf3d8505-0dae-3945-befe-443c9ddc6093",
                    "sense_definition": "mięso pochodzące z ptaków hodowlanych",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kulinaria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tej restauracji przygotowują doskonałe dania z <w>drobiu</w>.",
                            "target_lang_translations": {
                                "ru": "В этом ресторане готовят превосходные блюда из <w>птицы</w>."
                            }
                        },
                        {
                            "text": "Lekarz zalecił mu dietę opartą na gotowanym <w>drobiu</w> i warzywach.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал ему диету на основе варёного <w>мяса птицы</w> и овощей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mięso z drobiu",
                        "dania z drobiu"
                    ],
                    "target_lang_definitions": {
                        "ru": "мясо домашней птицы, используемое в пищу"
                    },
                    "translations": {
