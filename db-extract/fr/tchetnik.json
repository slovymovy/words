                    {
                        "sense_id": "520a776f-e7b8-399f-aa6c-37369b806213",
                        "entry_id": "2154e804-0f0b-382f-820a-5b9aec766bda",
                        "glosses": [
                            "Soldat de la résistance armée yougoslave durant la Seconde Guerre mondiale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ba66a7-c4a4-4e45-ab4a-cda89c5a5e6a",
                                "sense_id": "520a776f-e7b8-399f-aa6c-37369b806213",
                                "text": "Lors de cette rencontre, le ministre britannique a exigé que les tchetniks de Mihaïlovitch cessent immédiatement les attaques contre les forces occupantes."
                            },
                            {
                                "example_id": "11064149-a30c-416d-b1ab-18b747d77a3d",
                                "sense_id": "520a776f-e7b8-399f-aa6c-37369b806213",
                                "text": "L'année 1942 redoubla d'actions punitives contre les tchetniks, que le Fùhrer considérait plus dangereux que les partisans."
                            }
                        ]
                    }
                ],
                "translations": [
