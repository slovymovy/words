                    "sense_definition": "taki, który nie słucha poleceń, sprzeciwia się nakazom lub zasadom",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mały chłopiec bywa bardzo <w>nieposłuszny</w> wobec swoich rodziców.",
                            "target_lang_translations": {
                                "ru": "Этот маленький мальчик бывает очень <w>непослушным</w> по отношению к своим родителям."
                            }
                        },
                        {
                            "text": "Wychowawca musiał ukarać <w>nieposłusznego</w> ucznia za ignorowanie poleceń.",
                            "target_lang_translations": {
                                "ru": "Воспитателю пришлось наказать <w>непослушного</w> ученика за игнорирование указаний."
                            }
                        }
                    ],
                    "synonyms": [
