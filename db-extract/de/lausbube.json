                "senses": [
                    {
                        "sense_id": "d73e13d8-8d0f-3ec6-b580-6195233de665",
                        "entry_id": "c3ccfd6f-cb91-3506-9c41-641460b36a08",
                        "glosses": [
                            "männliches Kind, das Streiche spielt; übertragen auch Erwachsener"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "8c14288b-5eec-4d34-b9f5-b5ac9db89e28",
                                "sense_id": "d73e13d8-8d0f-3ec6-b580-6195233de665",
                                "text": "„Bald war er der Lausbube und Anführer in allen Streichen, wenn es galt, die Lehrer an der Nase herumzuführen.“"
                            },
                            {
                                "example_id": "d8c75219-70d1-4ed5-aafe-c9656f44f405",
                                "sense_id": "d73e13d8-8d0f-3ec6-b580-6195233de665",
                                "text": "„Die Kerle sehen aus wie typische Lausbuben in der Literatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
