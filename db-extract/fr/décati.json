                "entry_id": "02a3c752-0a41-3d2f-a488-9c534c15718a",
                "word": "décati",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02e48db8-deda-4257-b3f7-ee3b3fbb5e3e",
                        "entry_id": "02a3c752-0a41-3d2f-a488-9c534c15718a",
                        "tags": [
