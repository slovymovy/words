            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb4772c0-b23a-387d-87bf-6e0ad2fc83bd",
                    "sense_definition": "verschillen of veranderen afhankelijk van de situatie of tijd",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleur van de vleugels <w>varieert</w> bij deze vogel van donkergrijs tot zwart.",
                            "target_lang_translations": {
                                "en": "The color of the wings <w>varies</w> in this bird from dark gray to black."
                            }
                        },
                        {
                            "text": "De prijzen van groenten kunnen sterk <w>variëren</w> per seizoen.",
                            "target_lang_translations": {
                                "en": "Vegetable prices can <w>vary</w> greatly by season."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwisselen"
                    ],
                    "common_phrases": [
                        "sterk variëren",
                        "variëren van tot"
                    ],
                    "target_lang_definitions": {
                        "en": "to differ or change depending on the situation or time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vary",
                                "target_lang_sense_clarification": "to be different or change according to circumstances"
                            },
                            {
                                "target_lang_word": "differ",
                                "target_lang_sense_clarification": "to be unlike or distinct from one another"
                            },
                            {
                                "target_lang_word": "fluctuate",
                                "target_lang_sense_clarification": "to change frequently in level or amount"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c95ee881-ef2f-33af-a607-f2a009caf9a1",
                    "sense_definition": "iets doelbewust laten veranderen of aanpassen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verandering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De druk en de temperatuur werden <w>gevarieerd</w>, maar het volume constant gehouden.",
                            "target_lang_translations": {
                                "en": "The pressure and temperature were <w>varied</w>, but the volume was kept constant."
                            }
                        },
                        {
                            "text": "Het is gezond om je dagelijkse voeding voldoende te <w>variëren</w>.",
                            "target_lang_translations": {
                                "en": "It is healthy to <w>vary</w> your daily diet sufficiently."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwisselen"
                    ],
                    "common_phrases": [
                        "voldoende variëren"
                    ],
                    "target_lang_definitions": {
                        "en": "to deliberately change or adjust something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vary",
                                "target_lang_sense_clarification": "to introduce variety or change into something"
                            },
                            {
                                "target_lang_word": "diversify",
                                "target_lang_sense_clarification": "to make more diverse or varied"
                            },
                            {
                                "target_lang_word": "alternate",
                                "target_lang_sense_clarification": "to switch between different things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa46b738-eb51-3da3-8f82-54d9289e92e6",
                    "sense_definition": "verschillende versies of variaties maken op een specifiek thema of onderwerp",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creativiteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De componist begon eindeloos te <w>variëren</w> op het hoofdthema van het stuk.",
                            "target_lang_translations": {
                                "en": "The composer began to <w>vary</w> endlessly on the main theme of the piece."
                            }
                        },
                        {
                            "text": "Je kunt op dit basisrecept <w>variëren</w> door verschillende kruiden toe te voegen.",
                            "target_lang_translations": {
                                "en": "You can <w>vary</w> this basic recipe by adding different herbs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "variëren op een thema"
                    ],
                    "target_lang_definitions": {
                        "en": "to create different versions or variations on a specific theme or subject"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vary",
                                "target_lang_sense_clarification": "to create variations on a theme"
                            },
                            {
                                "target_lang_word": "improvise",
                                "target_lang_sense_clarification": "to create variations spontaneously"
                            },
                            {
                                "target_lang_word": "elaborate",
                                "target_lang_sense_clarification": "to develop a theme in more detail"
                            }
                        ]
                    }
                }
