                                "target_senses": [
                                    {
                                        "sense_id": "f947d339-0813-3810-a47b-81f42c779cd2",
                                        "entry_id": "e185be87-3df7-3bec-80a7-beda3c8f8e0b",
                                        "glosses": [
                                            "A diminutive of the female given name Elizabeth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f4f20dd-f63e-4278-bd64-59f8c2560a3a",
                                                "sense_id": "f947d339-0813-3810-a47b-81f42c779cd2",
                                                "text": "People in the last century weren't afraid of homely names; now we are all so smart and fine: no more \"Lady Bettys\" now."
                                            },
                                            {
                                                "example_id": "9e6fcac2-d719-4ae1-aefb-adbb7e2d71ee",
                                                "sense_id": "f947d339-0813-3810-a47b-81f42c779cd2",
                                                "text": "But Mrs. Betty Carver respects tradition, and this, I'm afraid, is ours. - - - She smells like expensive soap and her teeth are shiny-white. She does not in any way look like her name. It's not her fault that she was born in a time when people believed in names like Wanda, Dottie and Betty. She's more of a Vanessa or Paulina."
                                            }
                                        ]
                                    }
                                ]
