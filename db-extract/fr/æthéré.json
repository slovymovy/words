                        "sense_id": "57826ea5-e9a3-371f-af74-48b87f4845c7",
                        "entry_id": "3cab3dbc-25fc-33f0-8660-501514bb1812",
                        "glosses": [
                            "Variante orthographique de éthéré."
                        ],
                        "tags": [
