                "senses": [
                    {
                        "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                        "entry_id": "d0f940eb-0ab7-3955-9f65-b4b4037ed79c",
                        "glosses": [
                            "Action de pointiller. Contestation sur des bagatelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f42707c9-ed09-4df5-be6a-75bcbea9e72c",
                                "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                                "text": "Entre cet homme et sa femme, il y a des pointilleries continuelles."
                            },
                            {
                                "example_id": "7a08a346-b1cd-474c-9171-bb69bfdde367",
                                "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                                "text": "Ce ne sont que pointilleries entre eux."
                            },
                            {
                                "example_id": "68c9de55-d142-4c2a-8e00-4339fb32b29f",
                                "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                                "text": "Quoi de plus effrayant à peindre que ces aigres pointilleries auxquelles les gens passionnés préfèrent des coups de poignard ? — (Honoré de Balzac)"
                            },
                            {
                                "example_id": "f37426fb-1b81-41b2-b138-d698424db1aa",
                                "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                                "text": "Si le père Birotteau fait faillite, ce petit drôle sera un excellent syndic ; sa pointillerie est précieuse. — (Honoré de Balzac)"
                            },
                            {
                                "example_id": "a5c3ef03-4424-4aa6-8419-0ca253610777",
                                "sense_id": "39d34b7c-1c4e-3995-8adf-275277e4fca7",
                                "text": "Ces sortes d'hommes, après avoir passé leur jeunesse dans les satisfactions secondères de l'amour-propre et des sens, faisaient dans les pointillerie du buraliste. — (Louis Veuillot)"
                            }
                        ]
                    }
                ],
