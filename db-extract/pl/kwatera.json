                                ]
                            },
                            {
                                "target_word": "lodgings",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5bdf01c-489a-33df-9d0f-9acac82de573",
                                        "entry_id": "a11b3c3a-6369-3bba-bd46-e55cb94ae495",
                                        "glosses": [
                                            "A room or set of rooms in another person's house where a person lodges."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a58736fb-0709-448e-b345-e2a0b92d1752",
                                                "sense_id": "e5bdf01c-489a-33df-9d0f-9acac82de573",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d04a227f-0af1-35c5-9149-5dac76b6c8c9",
                                        "entry_id": "a11b3c3a-6369-3bba-bd46-e55cb94ae495",
                                        "glosses": [
                                            "An official residence."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "992409aa-6627-47b0-a8f7-02e021801831",
                        "source_entry_id": "65c2bdb9-d5d1-30b9-b755-4c3af9c708c5",
                        "source_sense_id": "00120975-9b0f-35a0-9d60-cc54ecc3be27",
                        "target_lang_word": "onderdak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderdak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5e3406-3d19-3053-864f-2c13266ecd82",
                                        "entry_id": "66ee2bab-d3d4-3e20-92e8-b4f240be370d",
                                        "glosses": [
                                            "plaats waar men kan verblijven of schuilen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "617aa89b-1be6-48c2-8167-38b7dee84ced",
                                                "sense_id": "9f5e3406-3d19-3053-864f-2c13266ecd82",
                                                "text": "De vluchtelingen hebben tijdelijk onderdak gevonden in het tentenkamp."
                                            },
                                            {
                                                "example_id": "07e5428e-ef9d-4adb-9781-921c4bcae2a1",
                                                "sense_id": "9f5e3406-3d19-3053-864f-2c13266ecd82",
                                                "text": "Ik leefde volledig in het nu en had alleen oog voor essentiële levensbehoeftes als voedsel en veilig onderdak."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "daf1eed8-5a05-3ef7-89a6-66db7416de60",
                                        "entry_id": "66ee2bab-d3d4-3e20-92e8-b4f240be370d",
                                        "glosses": [
                                            "~ bieden aan: herbergen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38672c80-9b1b-416e-8f06-ee9a22eb7db1",
                                                "sense_id": "daf1eed8-5a05-3ef7-89a6-66db7416de60",
                                                "text": "Het wijkgebouw biedt onderdak aan tal van organisaties en instellingen."
                                            },
                                            {
                                                "example_id": "4357a2de-b28c-4f94-b6da-61395507591d",
                                                "sense_id": "daf1eed8-5a05-3ef7-89a6-66db7416de60",
                                                "text": "Honderden aanvragen: Frankrijk is al langer bezig met het aantrekken van Amerikaanse onderzoekers. Begin dit jaar al vroeg de regering universiteiten met plannen te komen om hun Amerikaanse collega's onderdak te bieden. Verschillende instellingen, waaronder de beroemde Sorbonne universiteit in Parijs, zijn daar nu mee bezig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa36235b-d42f-4e2b-abed-22479fc2d7e5",
                        "source_entry_id": "65c2bdb9-d5d1-30b9-b755-4c3af9c708c5",
                        "source_sense_id": "00120975-9b0f-35a0-9d60-cc54ecc3be27",
                        "target_lang_word": "accommodatie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accommodatie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ea943790-560a-3f34-936c-2026e9cf6422",
                                        "entry_id": "1c647806-3d27-3415-9775-ea6c2e5ba849",
                                        "glosses": [
                                            "voorzieningen ten behoeve van het (aangenaam) verblijf van personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a15c3b86-bcfb-4921-8588-f3e8e8328cec",
                                                "sense_id": "ea943790-560a-3f34-936c-2026e9cf6422",
                                                "text": "Het schoolkamp werd gehouden in een accommodatie die speciaal voor het verblijf van groepen jongeren was ingericht."
                                            },
                                            {
                                                "example_id": "6260ecb1-e706-479a-b1ef-6a052e53bc2f",
                                                "sense_id": "ea943790-560a-3f34-936c-2026e9cf6422",
                                                "text": "‘Dit soort prachtige accommodaties vind je overal ter wereld,’ beweerde haar echtgenoot stellig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f455a909-9d9f-3d5e-9773-d346bed39a0e",
                                        "entry_id": "1c647806-3d27-3415-9775-ea6c2e5ba849",
                                        "glosses": [
                                            "aanpassing (aan de omstandigheden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b68da9d4-9b7b-493b-8b0f-943de833ed7f",
                                                "sense_id": "f455a909-9d9f-3d5e-9773-d346bed39a0e",
                                                "text": "De accommodatie van het oog, nodig om dichtbij scherp te kunnen zien gaat bij oudere mensen verloren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ad0246b-a51f-4f0a-91cb-75b047ffe131",
                        "source_entry_id": "65c2bdb9-d5d1-30b9-b755-4c3af9c708c5",
                        "source_sense_id": "00120975-9b0f-35a0-9d60-cc54ecc3be27",
                        "target_lang_word": "logeeradres",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "logeeradres",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a3a3957a-1bde-3d3a-99bd-2a54cd4e7ace",
                                        "entry_id": "e07f6b91-d9d6-36db-8598-fd63f750732a",
                                        "glosses": [
                                            "plaats waar men als gast de nacht kan doorbrengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9ddd882-c1ec-4589-8de9-531849e71c7a",
                                                "sense_id": "a3a3957a-1bde-3d3a-99bd-2a54cd4e7ace",
                                                "text": "Hij hield haar hand even vast voordat hij hem losliet. Ík was wel naar de veerboot gekomen als ik het geweten had. Hebt u een logeeradres?'`Ja. Hier vlak tegenover.'Ze gebaarde over het zand naar de cottage. `Bij Diighall?"
                                            },
                                            {
                                                "example_id": "ab615c45-3d25-4746-92b0-3eddef45ca7a",
                                                "sense_id": "a3a3957a-1bde-3d3a-99bd-2a54cd4e7ace",
                                                "text": "Het team wil zo snel mogelijk op het vliegtuig stappen, maar er moeten nog praktische zaken worden geregeld, zoals visumverplichtingen en een logeeradres in Paramaribo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf0ad1bc-8445-4a8b-9e63-d14a09d65841",
                        "source_entry_id": "65c2bdb9-d5d1-30b9-b755-4c3af9c708c5",
                        "source_sense_id": "00120975-9b0f-35a0-9d60-cc54ecc3be27",
                        "target_lang_word": "Quartier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quartier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                        "entry_id": "ada51142-d7f7-3c61-8c33-99161409836a",
                                        "glosses": [
                                            "Örtlichkeit, an der jemand unterkommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29c6dbf0-0c14-412d-8efa-162b544bca98",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "Alle Quartiere sind belegt."
                                            },
                                            {
                                                "example_id": "ef3f6f67-1256-46ea-9fe6-531ee05d7e9a",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Wir erkundigten uns ungesäumt hergebrachterweise, was für Quartier, Tisch, Wein, Frühstück und sonstiges Bestimmbare zu bezahlen sei.“"
                                            },
                                            {
                                                "example_id": "e1814eeb-2fd4-40e4-8f54-3876971bd91c",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Während die allermeisten Teilnehmer in Zelten und Massenunterkünften Quartier finden, hat Gerhard einmal mehr das große Los gezogen.“"
                                            },
                                            {
                                                "example_id": "e97ec8f0-022e-4996-ada2-c60c71186d22",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Gilli kam die Straße entlang, verschränkte die Arme wie jemand, der friert, ging in Richtung zu ihrem Quartier und winkte gequält.“"
                                            },
                                            {
                                                "example_id": "08e3dd4b-2748-4712-8167-0b610ef8547f",
                                                "sense_id": "83039465-3340-3d1e-bb41-39e17d4736ad",
                                                "text": "„Schlump und Jolles gingen in die Stadt, um sich nach einem Quartier umzusehen, die anderen räumten aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                        "entry_id": "ada51142-d7f7-3c61-8c33-99161409836a",
                                        "glosses": [
                                            "Teil einer Stadt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30712990-4ffb-4d7b-b79c-e3e7788edf79",
                                                "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                                "text": "In diesem Quartier wohnen viele Menschen mit Migrationshintergrund."
                                            },
                                            {
                                                "example_id": "cb11fe88-157a-404c-80cd-fd0f37edac1f",
                                                "sense_id": "78319d2d-f08e-358f-90ea-59dc378d6fb1",
                                                "text": "„16 Polizeibeamte unterstehen ihm, sie sollen gegen Drogendealer vorgehen, Cafés kontrollieren, das Quartier entkriminalisieren, so weit das möglich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
