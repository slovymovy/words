{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d76d9720-ac14-3547-846c-46781bebfbeb",
                    "sense_definition": "Запрещено; не разрешается (законами, правилами или нормами поведения).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В библиотеке <нельзя> громко разговаривать.",
                            "target_lang_translations": {
                                "en": "You <must not> talk loudly in the library.",
                                "zh": "在图书馆里<w>不可以</w>大声说话。"
                            }
                        },
                        {
                            "text": "Детям <нельзя> смотреть этот страшный фильм.",
                            "target_lang_translations": {
                                "en": "Children are <not allowed> to watch this scary movie.",
                                "zh": "孩子们<w>不可以</w>看这部恐怖电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "запрещено",
                        "недопустимо"
                    ],
                    "antonyms": [
                        "можно",
                        "разрешено"
                    ],
                    "common_phrases": [
                        "здесь нельзя",
                        "строго нельзя",
                        "никому нельзя"
                    ],
                    "target_lang_definitions": {
                        "en": "Forbidden; not permitted (by laws, rules, or norms of behavior).",
                        "zh": "被禁止；不被允许（根据法律、规则或行为准则）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "must not",
                                "target_lang_sense_clarification": "prohibition"
                            },
                            {
                                "target_lang_word": "not allowed",
                                "target_lang_sense_clarification": "lack of permission"
                            },
                            {
                                "target_lang_word": "forbidden",
                                "target_lang_sense_clarification": "strict prohibition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不可以",
                                "target_lang_sense_clarification": "表示不被允许"
                            },
                            {
                                "target_lang_word": "禁止",
                                "target_lang_sense_clarification": "表示严格的禁令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af08a587-e992-393b-8497-4df1b27feb4e",
                    "sense_definition": "Невозможно; нет физической возможности или условий для совершения действия.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Прошлое вернуть <нельзя>, нужно жить настоящим.",
                            "target_lang_translations": {
                                "en": "It is <impossible> to bring back the past; one must live in the present.",
                                "zh": "过去<w>无法</w>挽回，人应该活在当下。"
                            }
                        },
                        {
                            "text": "Без воды и еды прожить <нельзя>.",
                            "target_lang_translations": {
                                "en": "One <cannot> survive without water and food.",
                                "zh": "没有水和食物是<w>不能</w>生存的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "невозможно"
                    ],
                    "antonyms": [
                        "можно",
                        "возможно"
                    ],
                    "common_phrases": [
                        "нельзя сказать",
                        "нельзя забыть",
                        "иначе нельзя"
                    ],
                    "target_lang_definitions": {
                        "en": "Impossible; there is no physical possibility or conditions to perform the action.",
                        "zh": "不可能；没有物理上的可能性或条件来执行某项动作。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible",
                                "target_lang_sense_clarification": "lack of possibility"
                            },
                            {
                                "target_lang_word": "cannot",
                                "target_lang_sense_clarification": "inability"
                            },
                            {
                                "target_lang_word": "can't",
                                "target_lang_sense_clarification": "informal inability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无法",
                                "target_lang_sense_clarification": "表示没有能力或条件"
                            },
                            {
                                "target_lang_word": "不能",
                                "target_lang_sense_clarification": "表示客观上做不到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e5f6522-f490-32d5-b7ff-1140cffd7567",
                    "sense_definition": "О ситуации, когда невозможно не сделать что-либо; необходимо или неизбежно (используется с частицей «не» и инфинитивом).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С вашими аргументами <нельзя> не согласиться.",
                            "target_lang_translations": {
                                "en": "It is <impossible> not to agree with your arguments.",
                                "zh": "对于你的论点，我<w>不得不</w>表示赞同。"
                            }
                        },
                        {
                            "text": "<Нельзя> не заметить, как сильно изменился город.",
                            "target_lang_translations": {
                                "en": "It is <impossible> not to notice how much the city has changed.",
                                "zh": "你<w>不得不</w>注意到这座城市发生了多大的变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "нельзя не отметить",
                        "нельзя не признать"
                    ],
                    "target_lang_definitions": {
                        "en": "Regarding a situation where it is impossible not to do something; necessary or inevitable (used with the particle \"не\" and an infinitive).",
                        "zh": "指不得不做某事的情况；必然或不可避免。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "impossible not to",
                                "target_lang_sense_clarification": "double negative construction"
                            },
                            {
                                "target_lang_word": "cannot help but",
                                "target_lang_sense_clarification": "inevitability"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不得不",
                                "target_lang_sense_clarification": "表示必然性或无法避免"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}