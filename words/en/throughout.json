                {
                    "sense_id": "54b7303e-8536-39e9-86d6-f4a9cdf70ebb",
                    "sense_definition": "During an entire period of time; from the beginning to the end.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extent_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He remained silent <w>throughout</w> and did not answer any questions.",
                            "target_lang_translations": {
                                "ru": "Он молчал <w>всё это время</w> и не отвечал ни на какие вопросы.",
                                "tr": "Süreç <w>boyunca</w> sessiz kaldı ve hiçbir soruya cevap vermedi.",
                                "zh": "他<w>全程</w>保持沉默，没有回答任何问题。"
                            }
                        },
                        {
                            "text": "The team played well <w>throughout</w>, maintaining their lead until the end.",
                            "target_lang_translations": {
                                "ru": "Команда играла хорошо <w>от начала до конца</w>, сохраняя лидерство до финала.",
