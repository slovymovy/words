                        ],
                        "examples": [
                            {
                                "example_id": "5c60b744-bebd-4226-a815-d17d3e07b965",
                                "sense_id": "0e3b0e20-f4e0-38ee-88b4-6847b425b515",
                                "text": "„Abgetriebenes Wespennest. […], hernach radle 2 fingerbreite Streifel, radle sie mitten wieder voneinander, bestreue sie mit Ziweben, und Weimberl, rolle sie zusammen, […]“"
                            },
                            {
                                "example_id": "671aa3f9-b748-4616-a78f-1d33c7069bf0",
                                "sense_id": "0e3b0e20-f4e0-38ee-88b4-6847b425b515",
                                "text": "„‚Es wartet ein Festmahl auf dich‘, sagte Karl, ‚von der Hausherrin mit eigener Hand bereitet: Kürbisbrot, Tofu-Würsterl und auf jedem Avocadoschnitz a Weimberl – eine Weintraube.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "17c1192a-fbbd-354c-a592-36f7127ff535",
                        "entry_id": "c86fd786-5154-3dbc-aae4-74fd09efd933",
                        "glosses": [
                            "Einschmeichler"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "aa34ad6f-6806-4506-9ffb-c9c2fbb12d99",
                                "sense_id": "17c1192a-fbbd-354c-a592-36f7127ff535",
                                "text": "„Jetzt is er ganz zerissen und bluatig, wia s' durchgstochen ham mit eanere Messer: der Cassius, der hinterfotzige Casca und in Julius sei größtes Weimberl, der Brutus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
