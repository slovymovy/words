                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d4c7859-574f-3130-a567-1a63afa20366",
                        "entry_id": "801d48d6-869e-3975-9c58-f223f59c0240",
                        "glosses": [
                            "kriegerische Auseinandersetzung zwischen den Nordstaaten und den Südstaaten in Nordamerika (1861 bis 1865)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "175465db-eaa8-45eb-bf7b-f2d7266c5bb9",
                                "sense_id": "0d4c7859-574f-3130-a567-1a63afa20366",
                                "text": "Nach dem Sezessionskrieg wurde die Sklaverei in den USA abgeschafft."
                            },
                            {
                                "example_id": "6f0a4264-99b3-4dc4-b11c-1fb57aabc2d6",
                                "sense_id": "0d4c7859-574f-3130-a567-1a63afa20366",
                                "text": "„Das klang wie das perfekte Ende einer im »tiefen Süden«, wenige Jahre nach dem Sezessionskrieg angesiedelten nordamerikanischen Fernsehserie.“"
                            },
                            {
                                "example_id": "465f015e-dea6-45ec-a278-f65685a7cb67",
                                "sense_id": "0d4c7859-574f-3130-a567-1a63afa20366",
                                "text": "„Der kaltblütige Cyrus Smith hatte natürlich auch bei keinem Schlagabtausch des Sezessionskrieges gefehlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "713d5182-94a9-3cee-bb43-cdaba84e72e1",
                        "entry_id": "801d48d6-869e-3975-9c58-f223f59c0240",
                        "glosses": [
                            "Bürgerkrieg, der aufgrund der Bestrebung eines Landesteils zur Abspaltung (Sezession) und damit zur Erlangung der Unabhängigkeit geführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be1e96da-76ce-4948-9e49-cc3f7ade451c",
                                "sense_id": "713d5182-94a9-3cee-bb43-cdaba84e72e1",
                                "text": "„Der Sezessionskrieg im Südsudan war der bewaffnete Kampf um die Autonomie bzw. Unabhängigkeit der sudanesischen Region Südsudan.“"
                            },
                            {
                                "example_id": "e90c1f46-299f-4deb-bff5-cb737870013c",
                                "sense_id": "713d5182-94a9-3cee-bb43-cdaba84e72e1",
                                "text": "„Im Sudan kostet ein jahrzehntelanger Bürgerkrieg bis 2004 zwei Millionen Menschen das Leben, der vergebliche Sezessionskrieg Biafras von Nigeria Ende der 1960er Jahre fordert fast ebenso viele Tote, dem Völkermord der Hutu an den Tutsi in Ruanda 1994 fallen mindestens 800000 Menschen zum Opfer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
