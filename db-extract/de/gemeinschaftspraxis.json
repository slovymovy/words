                "senses": [
                    {
                        "sense_id": "7d1b0d39-1140-3c1c-a236-b0a3178e5952",
                        "entry_id": "dd77ff73-a749-31bf-8757-9718478cb6a3",
                        "glosses": [
                            "Arztpraxis, in der mehrere Ärzte (meist unterschiedlicher Fachrichtungen) praktizieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09b48477-ff95-4d25-8ff2-a90696fbba60",
                                "sense_id": "7d1b0d39-1140-3c1c-a236-b0a3178e5952",
                                "text": "„Am Montag hatte er in der Gemeinschaftspraxis zunächst ordnungsgemäß seine Praxisgebühr entrichtet und sich dann ins Wartezimmer gesetzt.“"
                            },
                            {
                                "example_id": "8b8cd1c1-e16c-4c6a-9274-3a35e58f8428",
                                "sense_id": "7d1b0d39-1140-3c1c-a236-b0a3178e5952",
                                "text": "„Schließlich führte mich eine weitere offene Treppe zu den wenigen restlichen Zimmern des Hauses, wo vier junge Zahnärzte eine Art Gemeinschaftspraxis eröffnet hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
