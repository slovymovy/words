                "senses": [
                    {
                        "sense_id": "d7a8724f-7d47-3706-aec4-08b4c8ba8171",
                        "entry_id": "9888562c-8291-3700-8aca-4588a17e4b0e",
                        "glosses": [
                            "een termijn mondeling afbestellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f752a0-c297-4fab-b4d4-a9eaffdcfe1f",
                                "sense_id": "d7a8724f-7d47-3706-aec4-08b4c8ba8171",
                                "text": "Zonder afzegging wordt het volledige tarief in rekening gebracht."
                            },
                            {
                                "example_id": "4f66f585-1d60-4f53-a2c2-369b3ca8b7cb",
                                "sense_id": "d7a8724f-7d47-3706-aec4-08b4c8ba8171",
                                "text": "Het drukbezochte festival Down the Rabbit Hole had afgelopen weekend te kampen met meerdere last-minute afzeggingen, onder meer wegens coronabesmettingen. Een optreden gaat wel vaker niet door op het laatste moment, maar corona heeft die kans vergroot. Wat gebeurt er als een artiest vlak voor het geplande optreden geen acte de presence op een festival kan geven?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5636a1b1-fd29-4346-9837-c3e502947b0c",
                        "source_entry_id": "9888562c-8291-3700-8aca-4588a17e4b0e",
                        "source_sense_id": "d7a8724f-7d47-3706-aec4-08b4c8ba8171",
