                            "participle",
                            "past"
                        ],
                        "form": "издо́хши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "23898542-84b2-39fd-84f4-e98cc7120389",
                        "entry_id": "8552bda8-8069-3580-bc6e-3f00f2d68c23",
                        "glosses": [
                            "умереть; околеть"
                        ],
                        "tags": [
                            "о животных"
                        ],
                        "examples": [
                            {
                                "example_id": "be09c66e-19b9-43d4-95cc-c6115bb7f68b",
                                "sense_id": "23898542-84b2-39fd-84f4-e98cc7120389",
                                "text": "— Во-первых, кролик издох, а во-вторых, сегодня в большом ― «Аида». 〈…〉 — Не издох. Ну, всё равно издохнет. Эх, доктор Борменталь, жаль пса, ласковый был, хотя и хитрый."
                            }
                        ]
                    },
                    {
                        "sense_id": "99f1f6c2-cbc2-30c3-a43f-17943bad7812",
                        "entry_id": "8552bda8-8069-3580-bc6e-3f00f2d68c23",
                        "glosses": [
                            "груб. : умереть"
                        ],
                        "tags": [
                            "о человеке"
                        ],
                        "examples": [
                            {
                                "example_id": "fdd033f6-6b9b-4f0b-914c-0c6ad81b05b1",
                                "sense_id": "99f1f6c2-cbc2-30c3-a43f-17943bad7812",
                                "text": "[Зоя, жен] Изверг рода человеческого! [Егор, муж] Издохнуть бы скорей, легче бы было. [Зоя, жен] Полно, Егорушка, не греши!"
                            },
                            {
                                "example_id": "e1d455e3-5fec-4f8c-bbfe-b86a612b2081",
                                "sense_id": "99f1f6c2-cbc2-30c3-a43f-17943bad7812",
                                "text": "— Россию люблю, Алексей, русского бога люблю, хоть я сам и подлец! Да я там издохну! — воскликнул он вдруг, засверкав глазами."
                            },
                            {
                                "example_id": "b9835434-6f86-4d38-bfe1-4ace7fdecbcb",
                                "sense_id": "99f1f6c2-cbc2-30c3-a43f-17943bad7812",
                                "text": "— Я не дождусь, издохну, но зато чьи-нибудь правнуки дождутся."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c330e0bf-3803-413b-991d-87cbf851d46c",
                        "source_entry_id": "8552bda8-8069-3580-bc6e-3f00f2d68c23",
                        "source_sense_description": "о животных: умереть; околеть",
                        "target_lang_word": "krepieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krepieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "037d392d-31c1-3402-ba63-d3a52e980b74",
                                        "entry_id": "bbf9d23b-bfa7-3701-99aa-76c507d8d137",
                                        "glosses": [
                                            "zugrunde gehen, sterben"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "546bf080-458f-4da7-bdc8-d80073fa2b6d",
                                                "sense_id": "037d392d-31c1-3402-ba63-d3a52e980b74",
                                                "text": "Krepieren sollst du wie ein Hund!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6276b44e-915c-3fe7-96be-dc2d566e3cfc",
                                        "entry_id": "bbf9d23b-bfa7-3701-99aa-76c507d8d137",
                                        "glosses": [
                                            "bersten, zerbersten"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d23c1d-0598-407a-9751-190529603374",
                                                "sense_id": "6276b44e-915c-3fe7-96be-dc2d566e3cfc",
                                                "text": "„Die Metaphern, Symbole, Analogien, Begriffe dieses Romans erstehen aus einer Landschaft, die durch Schützengräben zerschnitten, von Bunkern unterminiert ist, in der Granaten krepieren, Menschen zerrissen werden, Panzer sich als ‚Riesenkröten der Maschinenzeit‘ voranwälzen, ‚von einer frostigen Zukunft überstrahlt‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cce5ef45-a27a-48fe-8267-3264053ca85d",
                        "source_entry_id": "8552bda8-8069-3580-bc6e-3f00f2d68c23",
                        "source_sense_description": "о животных: умереть; околеть",
                        "target_lang_word": "verrecken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verrecken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2336ed-e81f-3c41-9c15-9c75ea905406",
                                        "entry_id": "a3ab0cd6-8687-3e6c-8084-48e4bf3e44f2",
                                        "glosses": [
                                            "sterben"
                                        ],
                                        "tags": [
                                            "impolite",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d65b913-3e14-4141-a0f6-d8e6de86dc35",
                                                "sense_id": "fb2336ed-e81f-3c41-9c15-9c75ea905406",
                                                "text": "„Doch warum kann mich mittlerweile nicht einmal das mehr erschrecken, wenn irgendwo Menschen an dreckigem Wasser verrecken?“ - Fettes Brot"
                                            },
                                            {
                                                "example_id": "4ca1851b-e8aa-4c41-88ea-1c92090361a6",
                                                "sense_id": "fb2336ed-e81f-3c41-9c15-9c75ea905406",
                                                "text": "„Während alle ihre Interessen wahren, verrecken Frauen und Kinder im Kugelhagel, werden Männer zu Mördern und enden als Krüppel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
