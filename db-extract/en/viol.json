                                        "glosses": [
                                            "муз., истор. название семейства смычковых инструментов, популярных с XV по XVIII век, отличавшихся от инструментов скрипичного семейства прежде всего тем, что играли на них, упирая в колено или держа между коленями"
                                        ],
                                        "tags": [],
