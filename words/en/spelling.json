                },
                {
                    "sense_id": "2a32c956-91b9-3987-9e54-0b3448af7e92",
                    "sense_definition": "A specific way in which a word is written.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "writing_instance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictionary lists two different <w>spellings</w> for this word.",
