                    {
                        "sense_id": "87b13ade-9d97-39d7-97d2-31fb543b69ac",
                        "entry_id": "a3c66aff-4264-3799-ae7b-fcd8fd44d147",
                        "glosses": [
                            "In films, someone who performs stunts that are deemed too dangerous or physically difficult for the main actors to attempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec6c911-5e2b-41c4-8bef-67fcd6026a71",
                                "sense_id": "87b13ade-9d97-39d7-97d2-31fb543b69ac",
                                "text": "During filming a stuntman was injured as he jumped from a railway bridge onto the roof of a train passing below."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cfa3489a-e9a2-43bb-939b-79b32126e366",
                        "source_entry_id": "a3c66aff-4264-3799-ae7b-fcd8fd44d147",
                        "source_sense_id": "87b13ade-9d97-39d7-97d2-31fb543b69ac",
