                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a glissé sur la route mouillée avant de <w>chuter</w> lourdement."
                        },
                        {
                            "text": "Faites très attention sur ce sentier escarpé pour ne pas <w>chuter</w> dans le ravin."
                        }
                    ],
                    "common_phrases": [
