                        "sense_id": "14fc9f3b-d07d-3b39-bceb-29fb92be1cfc",
                        "entry_id": "8eac728b-fdbf-3073-a0eb-387501e5c071",
                        "glosses": [
                            "het niet weten hoe iets is"
