                "senses": [
                    {
                        "sense_id": "c37ced1c-2763-3be5-93ba-40c6367744ba",
                        "entry_id": "f665c165-4096-3dd4-bc4c-a73ab0027c21",
                        "glosses": [
                            "rezygnacja z wygód lub przyzwyczajeń"
                        ],
                        "tags": [],
