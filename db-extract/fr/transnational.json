                                "target_senses": [
                                    {
                                        "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                        "entry_id": "4a46366b-a7cd-3020-a6c9-818ce3ee6ca8",
                                        "glosses": [
                                            "eine Trennlinie (Grenze, Landesgrenze) überquerend, nicht nur in einem eingegrenzten Gebiet geltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09444450-55fc-4d2d-bdf7-004611ef0465",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "„Damit soll auf die internationale, grenzüberschreitende Bedeutung der Wälder der Erde hingewiesen werden.“"
                                            },
                                            {
                                                "example_id": "fa2c5fcb-b828-4f7b-87ba-7249fe5c8630",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "Bei Geldwäsche handelt es sich eindeutig um ein grenzüberschreitendes Problem."
                                            },
                                            {
                                                "example_id": "4ca9c2d0-06a2-4239-8cf4-7f4e3e44cb77",
                                                "sense_id": "922bcbe2-4866-3e41-a523-5db0e40f76c8",
                                                "text": "Das steht so in der UN-Konvention zur nicht-schiffahrtlichen Nutzung grenzüberschreitender Wasserläufe."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57c63689-a1b6-4e65-a71a-fb7730eb3fe7",
