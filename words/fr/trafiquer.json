{
    "word_family": [
        "trafic",
        "trafiquant",
        "traficotage",
        "traficoter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cb627331-f37a-3170-b47f-b1b48b15c134",
                    "sense_definition": "Faire un commerce illicite ou de contrebande, notamment de stupéfiants ou d'armes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce_illicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a arrêté un groupe qui cherchait à <w>trafiquer</w> des armes de contrebande."
                        },
                        {
                            "text": "Ils ont été lourdement condamnés pour avoir <w>trafiqué</w> de la drogue pendant plusieurs années."
                        }
                    ],
                    "synonyms": [
                        "dealer"
                    ],
                    "common_phrases": [
                        "trafiquer des armes",
                        "trafiquer de la drogue"
                    ]
                },
                {
                    "sense_id": "3e6aab80-a7c7-3ccf-995d-c324b05512e7",
                    "sense_definition": "Modifier, altérer ou falsifier frauduleusement quelque chose pour tromper.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "falsification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garagiste malhonnête a <w>trafiqué</w> le compteur kilométrique de cette vieille voiture."
                        },
                        {
                            "text": "Il a été renvoyé parce qu'il tentait de <w>trafiquer</w> les comptes de l'entreprise."
                        }
                    ],
                    "synonyms": [
                        "falsifier",
                        "truquer",
                        "manipuler"
                    ],
                    "common_phrases": [
                        "trafiquer les comptes",
                        "trafiquer le compteur",
                        "trafiquer un document"
                    ]
                },
                {
                    "sense_id": "76be4800-04e0-3c98-a5f0-ccca9b2ab4b3",
                    "sense_definition": "Tirer un profit immoral, honteux ou illégal de choses non matérielles comme le pouvoir ou l'honneur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "commerce_illicite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme politique corrompu n'hésitait pas à <w>trafiquer</w> de son influence auprès des juges."
                        },
                        {
                            "text": "On l'accuse d'avoir <w>trafiqué</w> des secrets d'État au profit d'une puissance étrangère."
                        }
                    ],
                    "synonyms": [
                        "monnayer",
                        "marchander"
                    ],
                    "common_phrases": [
                        "trafiquer de son influence",
                        "trafiquer de son honneur"
                    ]
                },
                {
                    "sense_id": "8434654a-6f95-3d29-bf82-9667e53f876b",
                    "sense_definition": "Faire du commerce, exercer une activité marchande d'achat et de vente.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce port lointain, les marchands venaient <w>trafiquer</w> avec les marins de passage."
                        },
                        {
                            "text": "Au dix-septième siècle, cette compagnie maritime pouvait <w>trafiquer</w> librement avec les colonies."
                        }
                    ],
                    "synonyms": [
                        "commercer",
                        "négocier"
                    ],
                    "common_phrases": [
                        "trafiquer avec l'étranger"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Sens ancien, neutre à l'origine mais supplanté par des termes comme commercer ou négocier."
                        }
                    ]
                }
            ]
        }
    ]
}