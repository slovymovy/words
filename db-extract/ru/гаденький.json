                                                "example_id": "924184eb-1394-47cf-b555-d601ec0f025f",
                                                "sense_id": "87f369ce-4eaa-3ce3-96f0-1a62afe01227",
                                                "text": "— Bon Dieu ! Y en a quand même des rudes dégueulasses sur terre ! Foutre son gosse au bagne ! J’aurais jamais cru ça… Jamais."
                                            },
                                            {
                                                "example_id": "2eee7988-d661-419c-932c-1422bb41a864",
                                                "sense_id": "87f369ce-4eaa-3ce3-96f0-1a62afe01227",
                                                "text": "Dans un coin pourri\nDu pauvre Paris,\nSur une place,\nL’est un vieux bistrot\nTenu pas un gros\nDégueulasse."
                                            }
                                        ]
                                    }
