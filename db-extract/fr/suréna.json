                        ],
                        "examples": [
                            {
                                "example_id": "6552f491-956a-447f-b41c-030f951f4c60",
                                "sense_id": "154cf72f-8a0d-3c3e-9c76-fc777fd5aa11",
                                "text": "Suréna n'est point un nom propre, c'est un titre d'honneur, un nom de dignité ; le suréna des Parthes était l'ethmadoulet des Persans d'aujourd'hui, le grand visir des Turcs."
                            },
                            {
                                "example_id": "d44bfb64-deed-4dad-b31b-9a342ab7e61f",
                                "sense_id": "154cf72f-8a0d-3c3e-9c76-fc777fd5aa11",
                                "text": "Tour à tour, il secourut le dauphin de France et le roi d’Angleterre, les templiers de Jérusalem, le suréna des Parthes, le négus d’Abyssinie et l’empereur de Calicut."
                            }
                        ]
