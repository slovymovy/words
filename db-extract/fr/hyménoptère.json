                    }
                ],
                "senses": [
                    {
                        "sense_id": "f137dcce-636b-34f6-be7b-0e553d4553ce",
                        "entry_id": "33c3136a-1a55-32e9-9552-12bd429107fd",
                        "glosses": [
                            "Qui a deux paires d’ailes membraneuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "359c2bf1-4e0c-4118-b427-666f1857cb32",
                                "sense_id": "f137dcce-636b-34f6-be7b-0e553d4553ce",
                                "text": "Les abeilles, les guêpes, les fourmis sont des insectes hyménoptères."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4d18c7f4-3f8e-3b2b-80bc-d6c1d987bc2f",
                "word": "hyménoptère",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8709b629-4286-41dc-9d41-d13917a229d6",
                        "entry_id": "4d18c7f4-3f8e-3b2b-80bc-d6c1d987bc2f",
                        "tags": [
                            "plural"
                        ],
                        "form": "hyménoptères"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c0e4ef20-01a3-346b-8894-713820bf6242",
                        "entry_id": "4d18c7f4-3f8e-3b2b-80bc-d6c1d987bc2f",
                        "glosses": [
                            "Ordre d’insectes ayant deux paires d’ailes membraneuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7fa9408-b941-4305-9f8a-c9d447a63def",
                                "sense_id": "c0e4ef20-01a3-346b-8894-713820bf6242",
                                "text": "C’est un paradis d’hyménoptères, je n’ai jamais entendu pareils bourdonnements."
                            },
                            {
                                "example_id": "531c9254-a73b-4cc3-a000-13206cdd9636",
                                "sense_id": "c0e4ef20-01a3-346b-8894-713820bf6242",
                                "text": "L’hyménoptère introduit en 2004 a depuis colonisé quasi tout le territoire métropolitain. Il est responsable de la mort, mardi, d’un homme de 57 ans dans le Calvados."
                            },
                            {
                                "example_id": "2728993f-8cbd-4d2d-b6ae-300aa3178b19",
                                "sense_id": "c0e4ef20-01a3-346b-8894-713820bf6242",
                                "text": "Les abeilles, les fourmis et les guêpes sont des hyménoptères."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a95b876-e1fa-4395-af1e-555820b599f2",
                        "source_entry_id": "4d18c7f4-3f8e-3b2b-80bc-d6c1d987bc2f",
                        "source_sense_id": "c0e4ef20-01a3-346b-8894-713820bf6242",
                        "target_lang_word": "Hautflügler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hautflügler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9b3d9541-83d3-3d48-8353-ac9f5f9235b5",
                                        "entry_id": "33287234-99d2-3350-943f-0b132940f5b9",
                                        "glosses": [
                                            "die höchstentwickelte Ordnung der Insekten mit zwei wenig geaderten, an feine dünne, durchsichtige Häute erinnernden Flügelpaaren, zu der Ameisen, Bienen und Wespen gehören"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3d6a049-39fc-45ce-9d27-5354087eded8",
                                                "sense_id": "9b3d9541-83d3-3d48-8353-ac9f5f9235b5",
                                                "text": "Die Hautflügler stellen zweifellos die am höchsten entwickelten Insekten dar und machen alle eine vollkommene Verwandlung durch."
                                            },
                                            {
                                                "example_id": "885d837d-0e22-457e-8c25-7568499f824c",
                                                "sense_id": "9b3d9541-83d3-3d48-8353-ac9f5f9235b5",
                                                "text": "„Wahrscheinlich hat sich Eusozialität innerhalb der Hautflügler nicht weniger als elfmal unabhängig voneinander entwickelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
