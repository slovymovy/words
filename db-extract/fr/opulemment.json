                "senses": [
                    {
                        "sense_id": "f1336ebe-a1d1-37b8-8593-75e9bbd0f607",
                        "entry_id": "ae9f1b45-adb9-37d4-8c82-691a542d7349",
                        "glosses": [
                            "(peu usité) Avec opulence."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "8daaec0e-c92b-4d07-97c0-7d74b9f299e3",
                                "sense_id": "f1336ebe-a1d1-37b8-8593-75e9bbd0f607",
                                "text": "L’énorme capitale est un fruit douloureux.\nSon écorce effondrée et ses pulpes trop mûres\nTeignent opulemment leurs riches pourritures\nD’ors verts, de violets, et de roux phosphoreux.\n(Iwan Gilkin – La Capitale)"
                            },
                            {
                                "example_id": "9893f498-e1f6-4d82-8f9a-5e72b96c9890",
                                "sense_id": "f1336ebe-a1d1-37b8-8593-75e9bbd0f607",
                                "text": "Il a entre autres intention de marier son fils à une jeune fille dépourvue de charme mais opulemment dotée."
                            },
                            {
                                "example_id": "d69c716e-c30d-437b-8c59-53797d552fac",
                                "sense_id": "f1336ebe-a1d1-37b8-8593-75e9bbd0f607",
                                "text": "Le public a répondu en nombre afin de se laisser transporter par le son de l’harmonium du chef-lieu, acheté par la paroisse Saint-Maurice d’Orelle en 1855, marié au décor opulemment baroque de l’édifice du XVe siècle. (Bulletin municipal d'Orelle)"
                            }
                        ]
                    }
                ],
