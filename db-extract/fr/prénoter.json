                "senses": [
                    {
                        "sense_id": "b1d13251-cfe3-3998-950e-2979c682770f",
                        "entry_id": "0d2a9ab5-73bd-3be5-b9a9-8119b5d3dc60",
                        "glosses": [
                            "Noter à l’avance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4063af-b9de-4a77-a770-34ff1e27f126",
                                "sense_id": "b1d13251-cfe3-3998-950e-2979c682770f",
                                "text": "Il lui est permis, dans tous ces cas, de sauvegarder son droit prétendu en le faisant « prénoter » sur les livres fonciers."
                            },
                            {
                                "example_id": "1f6e1371-df90-42d3-8f61-eee62c8db311",
                                "sense_id": "b1d13251-cfe3-3998-950e-2979c682770f",
                                "text": "Il prend à l’avance la peine de prénoter son droit sur un registre spécial tenu dans les bureaux de la Commission foncière."
                            },
                            {
                                "example_id": "6f6e9280-8913-468f-9b12-c1492d209c13",
                                "sense_id": "b1d13251-cfe3-3998-950e-2979c682770f",
                                "text": "Nous pensons d’ailleurs que la solution eût été la même si, au lieu de faire prénoter son droit, l’acquéreur l’avait fait inscrire directement, l’effet conservatoire de la prénotation ne pouvant se détailler."
                            }
                        ]
                    }
