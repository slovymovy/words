{
    "word_family": [
        "bedwingen",
        "dwang",
        "dwingen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6b5bf11-2d75-3c45-8192-c06f4a046acd",
                    "sense_definition": "de toestand van beheersing of controle over iets of iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "controle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een paar diepe ademhalingen had ze haar zenuwen weer volledig <w>in bedwang</w>.",
                            "target_lang_translations": {
                                "en": "After a few deep breaths, she had her nerves completely <w>under control</w> again."
                            }
                        },
                        {
                            "text": "De brandweer probeerde het vuur snel <w>in bedwang</w> te houden.",
                            "target_lang_translations": {
                                "en": "The fire brigade tried to quickly keep the fire <w>under control</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "beheersing",
                        "controle",
                        "bedwinging"
                    ],
                    "common_phrases": [
                        "in bedwang houden",
                        "in bedwang krijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "the state of mastery, restraint, or control over something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "control",
                                "target_lang_sense_clarification": "having power or influence over something"
                            },
                            {
                                "target_lang_word": "restraint",
                                "target_lang_sense_clarification": "keeping something under control or check"
                            },
                            {
                                "target_lang_word": "check",
                                "target_lang_sense_clarification": "as in keeping something in check"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c115788-fd4f-3f0c-b6b1-c46bc32ab66a",
                    "sense_definition": "een dwingende kracht of beperking die iemands vrijheid belemmert",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beperking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij weigerde te leven onder de strenge <w>bedwang</w> van de traditie.",
                            "target_lang_translations": {
                                "en": "He refused to live under the strict <w>constraint</w> of tradition."
                            }
                        },
                        {
                            "text": "De burgers kwamen in opstand tegen de harde <w>bedwang</w> van het regime.",
                            "target_lang_translations": {
                                "en": "The citizens revolted against the harsh <w>subjugation</w> of the regime."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwang",
                        "beperking",
                        "onderdrukking"
                    ],
                    "antonyms": [
                        "vrijheid"
                    ],
                    "common_phrases": [
                        "onder bedwang van"
                    ],
                    "target_lang_definitions": {
                        "en": "a coercive force, constraint, or restriction that limits someone's freedom"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constraint",
                                "target_lang_sense_clarification": "a limitation or restriction"
                            },
                            {
                                "target_lang_word": "coercion",
                                "target_lang_sense_clarification": "the practice of persuading someone using force or threats"
                            },
                            {
                                "target_lang_word": "subjugation",
                                "target_lang_sense_clarification": "the action of bringing someone or something under domination or control"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}