                                                "sense_id": "92eeb436-fb47-392b-a0a3-3e8a27033f30",
                                                "text": "Ohne die Thrombozyten würde man leicht verbluten."
                                            },
                                            {
                                                "example_id": "83dcaddb-8316-4d98-99cb-cf9098077bd3",
                                                "sense_id": "92eeb436-fb47-392b-a0a3-3e8a27033f30",
                                                "text": "Heparin ist ein Wirkstoff, den Schlaganfallpatienten gegen eine Verklumpung der Thrombozyten nehmen."
                                            }
