                "senses": [
                    {
                        "sense_id": "7296d62b-c286-3ede-a805-e6d00bdd7d53",
                        "entry_id": "dc1b1c47-87bf-353c-a5a3-fd70997a94f2",
                        "glosses": [
                            "разг. действ. прич. прош. вр. от залипать"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "7013d8f6-14bf-486b-bae0-cb4a1a316f57",
                                "sense_id": "7296d62b-c286-3ede-a805-e6d00bdd7d53",
                                "text": "Невозможно было найти дороги в непроницаемой тьме от несомого бурей горящего пепла, залипавшего глаза и обжигавшего лицо."
                            },
                            {
                                "example_id": "b5f013cc-2b5a-4018-b34f-f1ebe13f1f4d",
                                "sense_id": "7296d62b-c286-3ede-a805-e6d00bdd7d53",
                                "text": "После выполнения этих действий, залипавшая ранее кнопка, будет снова работать."
                            },
                            {
                                "example_id": "ffd2f36f-d7f2-49fd-a237-1bca29498102",
                                "sense_id": "7296d62b-c286-3ede-a805-e6d00bdd7d53",
                                "text": "Вставил новое, заведомо исправное реле и проблема больше не повторилась. Причина крылась в подгоревших и залипавших контактах реле."
                            }
                        ]
                    }
                ],
