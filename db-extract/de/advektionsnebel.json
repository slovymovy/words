                            "plural"
                        ],
                        "form": "die Advektionsnebel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                        "entry_id": "ec735b07-f8cb-3596-979c-db6fed33cbdf",
                        "glosses": [
                            "Nebel, der bei waagrechter Zufuhr warmer, feuchter Luft über eine kühle Oberfläche oder Luftschicht entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf7d24ab-a839-49dd-a4e9-b0ce036cec20",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Beim Advektionsnebel bildet der Tagesverlauf eine untergeordnete Rolle."
                            },
                            {
                                "example_id": "9cc69b42-d283-4d58-a763-1c673f3f414b",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Der Advektionsnebel wird dichter, wenn sich die Windgeschwindigkeit auf etwa 15 Knoten erhöht."
                            },
                            {
                                "example_id": "f6187038-047d-464c-b851-70a8bed38624",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Wenn sich dann eine Hochdrucklage einstellt, kann der Advektionsnebel mehrere Tage oder Wochen andauern."
                            },
                            {
                                "example_id": "b063fac0-a832-4824-bedd-14a56025307b",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Beim Advektionsnebel spielen große Luftbewegungen die Hauptrolle."
                            },
                            {
                                "example_id": "4ab67f38-2380-41b9-8a4a-5af59a2e71a2",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Der Nebel marinen Ursprungs ist als Advektionsnebel bzw. Stratusdecke über dem kalten Benguelastrom entstanden und wird vom Wind ins Landesinnere verfrachtet."
                            },
                            {
                                "example_id": "4158416f-bfa0-4e73-8c65-dca6d0faf149",
                                "sense_id": "4f8c0804-bfc0-35df-b153-99482b9fb224",
                                "text": "Schönes Naturschauspiel: Dank des Advektionsnebel[s] sieht der Sonnenaufgang in Peking noch schöner aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
