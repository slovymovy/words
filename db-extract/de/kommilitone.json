                                            {
                                                "example_id": "efb0db6b-f3c1-416d-b572-ed90458e797f",
                                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                                "text": "Ik kon heel veel leren van mijn medestudenten"
                                            },
                                            {
                                                "example_id": "15c88f70-a5c7-4b02-b479-24038cdf65cf",
                                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                                "text": "Mijn beste vrienden waren medestudenten tijdens mijn opleiding."
                                            },
                                            {
                                                "example_id": "83e030fa-490b-4fab-b955-db4dfe7ede0e",
                                                "sense_id": "6e5b4157-3d29-3ba4-af1f-54696be1700a",
                                                "text": "De meeste medestudenten aan de Handelshogeschool hadden het waarschijnlijk allemaal als een grap gezien, of als een sport met de bedoeling de studielening te verdubbelen die alle studenten van het land cadeau kregen van de sociaaldemocratische staat, ook wie het totaal niet nodig had."
                                            }
