                        "examples": [
                            {
                                "example_id": "3f830975-a2c0-46e0-80bc-476e11fc3631",
                                "sense_id": "1174eaf5-887c-33f3-9771-d4226ea0605f",
                                "text": "Псовые охотники скрадывают друг у друга собак."
                            }
                        ]
                    },
                    {
                        "sense_id": "d36bded4-d1f9-3df4-8590-f95e60077402",
                        "entry_id": "d8d04429-09ae-32f7-a68d-1215abe206e2",
                        "glosses": [
                            "скрывать, делать незаметным, невидимым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19412f9c-e3f9-46a1-8914-2085797b819b",
                                "sense_id": "d36bded4-d1f9-3df4-8590-f95e60077402",
                                "text": "Мешковатая одежда скрадывает недостатки фигуры."
                            }
                        ]
                    },
                    {
                        "sense_id": "2becac93-b459-32a0-a139-a1393ff3d690",
                        "entry_id": "d8d04429-09ae-32f7-a68d-1215abe206e2",
                        "glosses": [
                            "ловить, охотиться, подстерегая, подкрадываясь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8f11d89-c031-4190-bcbc-74901b640123",
                                "sense_id": "2becac93-b459-32a0-a139-a1393ff3d690",
                                "text": "Охотник скрадывает дичь, укрываясь от неё в складках местности, двигаясь без шума."
                            }
                        ]
                    }
