                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "revisionisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b830042b-36cc-348b-86e1-f813eb6bb202",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "streven naar herziening"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "55ab2d29-8407-39d8-a703-950cb1035833",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "richting in het socialisme die op een geleidelijke verandering van de maatschappij aanstuurt, niet op revolutie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435cd63c-6132-4d7c-96bd-9aa812034c1c",
                                                "sense_id": "55ab2d29-8407-39d8-a703-950cb1035833",
                                                "text": "Revisionisme was in het internationale communisme heel lang een beledigende term voor alles met afwijkende meningen"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ad9880a-a1ba-3406-a3c0-66db5b19bc4a",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "de opportunistische herziening of herschrijving van de geschiedenis op grond van latere, nationalistisch, religieus of ideologisch gedreven opvattingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "412f61a7-3bb4-498b-8322-eb27841b6094",
                                                "sense_id": "2ad9880a-a1ba-3406-a3c0-66db5b19bc4a",
                                                "text": "Het is in Latijns-Amerika dat een aantal mensen zich het meest beijveren om de ‘zwarte legende’ van de veroveringen uit te wissen; om de religieuze en juridische instellingen die de gouverneurs en belastingambtenaren van het oude Spanje naar dit continent gebracht hebben, uitbundig te prijzen; om aan te tonen dat het Spaanse ezeltje meer heeft gedaan om de Indiaan een menswaardig bestaan te geven dan alle liberale of democratische ideeën van de vorige eeuw ... In naam van de ‘hispaniteit’ - waarbij men soms wijst op de milde houding van José Martí jegens Spanje - komt men tot een historisch revisionisme dat de schijn heeft van ‘malinchisme’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4472d831-5005-3bcd-bff8-bdcd1ad5aff3",
                                        "entry_id": "e122a8cb-561a-3dcb-aeb0-207490e325a4",
                                        "glosses": [
                                            "politieke stroming in een land die een eerder gesloten verdrag dat tot het afstaan van territoria of gebieden heeft geleid, wil laten herzien of opzeggen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a4d8e2-b30b-4a72-acbd-4fe49cb134fe",
                        "source_entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
                        "source_sense_description": "advocacy of a revision of some view",
                        "target_lang_word": "révisionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "révisionnisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Démarche critique consistant à réviser certaines opinions, doctrines, théories couramment admises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65225fb0-5a92-45c6-b8de-03326f61c28c",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Quelle gêne, le succès du révisionnisme ! Ô désespoir ! le grand courant révisionniste fera-t-il des épaves de nos petites préparations !"
                                            },
                                            {
                                                "example_id": "b99398ba-676d-4bb8-b4bc-42cc25e08087",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Citoyens ; il en est temps encore, revenez-en à la théorie de la souveraineté absolue du peuple – et permanente – sans cela le boulangisme tuera le révisionnisme sans profit pour les boulangistes."
                                            },
                                            {
                                                "example_id": "63a50331-d0aa-445d-9102-f7ffe0590722",
                                                "sense_id": "05603527-d8a4-3ddc-af9b-226be3f9758b",
                                                "text": "Le négationnisme vient en parfaite contradiction des événements qui se sont effectivement déroulés, lorsque le révisionnisme essaye de réinterpréter ou de remettre en perspective des faits, en accord avec les données objectives, sans opérer de sélection dans celles-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e65cbfa-0871-3413-b60f-891a8edcc626",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Souvent Adaptation du marxisme à la conjoncture économique, sociologique, politique, etc."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08f4ce8b-ae70-4265-96b9-75a261a676c8",
                                                "sense_id": "8e65cbfa-0871-3413-b60f-891a8edcc626",
                                                "text": "Faire preuve de révisionnisme petit-bourgeois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1b36c9-9f83-3c88-8219-3a2c7fd27664",
                                        "entry_id": "5312c2ef-6d42-3212-9cfe-729fd1a023a9",
                                        "glosses": [
                                            "Mouvement demandant la révision du procès Dreyfus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fb728ec-a639-452a-aaab-4f9e34548619",
                        "source_entry_id": "83d903d4-4934-381c-9080-2ffe96e0b689",
