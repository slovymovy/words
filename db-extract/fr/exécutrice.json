                                "target_senses": [
                                    {
                                        "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                        "entry_id": "9f1366d8-06a1-38d5-924e-1b90256aa8fd",
                                        "glosses": [
                                            "женск. к исполнитель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0399c640-dd04-46ec-8789-b32b9fd5e582",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Рябая девица была Александра Ивановна Ковригина, двоюродная моя сестра, круглая сирота, с малых лет взятая на воспитанье Прасковьей Ивановной; она находилась в должности главной исполнительницы приказаний бабушки, то есть хозяйки дома."
                                            },
                                            {
                                                "example_id": "f20b528a-9b6a-4fbe-bf79-03d84624a6c5",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Были такие моменты, когда Надежда Васильевна настолько увлекалась своими мыслями, что необыкновенно живо воспроизводила пред собой широкую картину осуществившихся приваловских планов, деятельной участницей и исполнительницей которых была она сама."
                                            },
                                            {
                                                "example_id": "5a2f815a-348f-445a-a183-ec631e32ff29",
                                                "sense_id": "26981e75-937f-3cb7-9997-b81bf4a73b63",
                                                "text": "Говорят, что лучшие исполнительницы лезгинки ― татарки Дагестанских гор."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
