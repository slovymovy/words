                                "target_lang_sense_clarification": "general knowledge"
                            },
                            {
                                "target_lang_word": "figures",
                                "target_lang_sense_clarification": "numerical data"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数据",
