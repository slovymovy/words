                ],
                "senses": [
                    {
                        "sense_id": "51222cbc-eaeb-35e4-86e6-22db9cb94606",
                        "entry_id": "1d90ba36-88f3-3eb0-9661-ba33efc37c2c",
                        "glosses": [
                            "jemand, der etwas fordert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6eb8fcd-91b4-4166-939b-167c8152007d",
                                "sense_id": "51222cbc-eaeb-35e4-86e6-22db9cb94606",
                                "text": "„Der Bundesverband Deutscher Zeitschriftenverleger (BDZV) ist der härteste Forderer des Leistungsschutzrechtes.“"
                            },
                            {
                                "example_id": "58c33c51-1256-4002-b646-583b02249bb7",
                                "sense_id": "51222cbc-eaeb-35e4-86e6-22db9cb94606",
                                "text": "„2001 dann gründete er gemeinsam mit seinem Bruder die Partei für Recht und Gerechtigkeit, eine nationalkonservative Gruppierung, deren erklärtes Ziel es ist, Teile der populistischen Rechte ins bürgerliche Lager zu integrieren. Als Forderer eines starken Staates und Kämpfer für Recht und Ordnung traten die Brüder fortan auf, was vielen Polen gefiel.“"
                            },
                            {
                                "example_id": "ceaf298c-0455-43c5-9e82-f53505cd77b9",
                                "sense_id": "51222cbc-eaeb-35e4-86e6-22db9cb94606",
                                "text": "„»Darf man als großer Forderer auftreten, wenn man seine Hausaufgaben so schlecht gemacht hat?«, fragt Plasberg den Studiogast Koch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
