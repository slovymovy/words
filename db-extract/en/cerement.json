                "senses": [
                    {
                        "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                        "entry_id": "5dc5768a-13f0-3898-94c3-ee9b7e3341c8",
                        "glosses": [
                            "A burial shroud or garment."
                        ],
                        "tags": [
                            "often",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "f1af3e75-384b-4616-a45e-942785c79778",
                                "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                                "text": "Why thy canonized bones, hearsed in death, have burst their cerements."
                            },
                            {
                                "example_id": "5400f809-9b4b-401f-8af6-1ef16481d2e3",
                                "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                                "text": "Oh! when his sacred dust\nThe cerements of the tomb shall burst,\nMight I be worthy at his feet to rise,\nTo yonder blissful skies,\nWhere angel-hosts resplendent shine,\nJehovah!—Lord of Hosts, the glory shall be thine."
                            },
                            {
                                "example_id": "1838e9f5-8c1e-4bd8-8266-de9fe7817694",
                                "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                                "text": "\"Who is the woman in the cerements?\", she inconsequently wondered."
                            },
                            {
                                "example_id": "9325e997-ab6f-4a15-a2d5-bbd913077898",
                                "sense_id": "9eb8aba5-6cd3-3fea-b8e3-82734e558cf3",
                                "text": "The cerements still cling to their wasted frames, but will soon be exchanged for a gayer garb in their passage from the tomb to the temple."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f02e152-50e4-38c7-9c75-f015eb081ebd",
                        "entry_id": "5dc5768a-13f0-3898-94c3-ee9b7e3341c8",
                        "glosses": [
                            "Cerecloth."
                        ],
