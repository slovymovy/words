                        "target_lang_word": "charbon de bois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charbon de bois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97fcda95-c1d8-3997-b832-62973c9226c6",
                                        "entry_id": "4d057451-4c66-3ea6-9788-97e5833807fb",
                                        "glosses": [
                                            "Bois duquel on a retiré l’humidité et toute matière végétale ou organique volatile, afin de ne laisser que le carbone et quelques minéraux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe41eee0-729d-46af-aa94-e46b5327c2be",
                                                "sense_id": "97fcda95-c1d8-3997-b832-62973c9226c6",
                                                "text": "En raison de la faible proportion de cendres qu'il contient et de son pouvoir calorifique élevé, qui varie de 7,500 à 8,000 calories, le charbon de bois convient très-bien pour les opérations métallurgiques. On distingue généralement le charbon de bois dur et le charbon de bois tendre ; le premier est surtout employé dans les hauts-fourneaux où il doit être soumis à une pression considérable ; le second qui brûle plus rapidement est préféré pour les feux d’affinerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da5928c5-94d1-3429-b065-c2d85c1e2a6c",
                                        "entry_id": "4d057451-4c66-3ea6-9788-97e5833807fb",
                                        "glosses": [
                                            "Combustible fabriqué artificiellement utilisé pour faire du feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2cfc74d-5458-461f-b249-4f4a77114892",
                                                "sense_id": "da5928c5-94d1-3429-b065-c2d85c1e2a6c",
                                                "text": "Le travail ne manquait pas dans sa forge ; mais le charbon de bois était si cher !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c7c3844-f058-3d2b-8165-d6887188c4ce",
                                        "entry_id": "4d057451-4c66-3ea6-9788-97e5833807fb",
                                        "glosses": [
                                            "Médicament utilisé pour prévenir certaines pathologies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "225a51dd-1bcb-42fe-ab32-a8270dd60868",
                                                "sense_id": "4c7c3844-f058-3d2b-8165-d6887188c4ce",
                                                "text": "Hippocrate (400 avant J.-C.) et Pline (50 avant J.-C.) recommandent le charbon de bois dans le traitement de l’épilepsie, du vertige, de la chlorose et de la « maladie du charbon » contractée par les tanneurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0d1164-a830-3be6-a948-e156eaea5ddf",
                                        "entry_id": "4d057451-4c66-3ea6-9788-97e5833807fb",
                                        "glosses": [
                                            "Outil de dessin."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80882c1c-1803-434b-8c20-540722e3f9f3",
                                                "sense_id": "4a0d1164-a830-3be6-a948-e156eaea5ddf",
                                                "text": "Une fois que vous êtes devenu familier avec l’utilisation de charbon de bois, vous cherchez peut-être un moyen d’améliorer vos dessins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
