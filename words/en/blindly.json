{
    "word_family": [
        "blind",
        "blindness",
        "blindfold"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "11eecf0a-35bc-32a3-88bd-f23e9163f09a",
                    "sense_definition": "Without consideration, question, or critical judgment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "without_thinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is dangerous to <w>blindly</w> follow advice without checking the facts first.",
                            "target_lang_translations": {
                                "ru": "Опасно <w>слепо</w> следовать советам, сначала не проверив факты."
                            }
                        },
                        {
                            "text": "She refused to <w>blindly</w> trust the navigation system when the road looked blocked.",
                            "target_lang_translations": {
                                "ru": "Она отказалась <w>слепо</w> доверять навигационной системе, когда дорога казалась заблокированной."
                            }
                        }
                    ],
                    "synonyms": [
                        "unthinkingly"
                    ],
                    "antonyms": [
                        "critically",
                        "thoughtfully"
                    ],
                    "common_phrases": [
                        "blindly follow",
                        "blindly trust",
                        "accept blindly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без размышлений, сомнений или критической оценки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слепо",
                                "target_lang_sense_clarification": "не задумываясь, не рассуждая"
                            },
                            {
                                "target_lang_word": "безрассудно",
                                "target_lang_sense_clarification": "не опираясь на здравый смысл"
                            },
                            {
                                "target_lang_word": "наверенно",
                                "target_lang_sense_clarification": "наугад, без проверки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b0687c5-9745-31b2-ac42-1ea4421471f1",
                    "sense_definition": "In a blind manner; without being able to see.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "without_sight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reached out <w>blindly</w> in the dark room, trying to find the light switch.",
                            "target_lang_translations": {
                                "ru": "Он <w>на ощупь</w> протянул руку в темной комнате, пытаясь найти выключатель."
                            }
                        },
                        {
                            "text": "I stumbled <w>blindly</w> through the thick forest, unable to see the path ahead.",
                            "target_lang_translations": {
                                "ru": "Я <w>вслепую</w> пробирался сквозь густой лес, не видя тропинки впереди."
                            }
                        }
                    ],
                    "synonyms": [
                        "eyelessly",
                        "sightlessly"
                    ],
                    "common_phrases": [
                        "grope blindly",
                        "stumble blindly",
                        "reach blindly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вслепую, без возможности видеть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вслепую",
                                "target_lang_sense_clarification": "не видя ничего вокруг"
                            },
                            {
                                "target_lang_word": "на ощупь",
                                "target_lang_sense_clarification": "ориентируясь только по прикосновениям"
                            },
                            {
                                "target_lang_word": "слепо",
                                "target_lang_sense_clarification": "подобно слепому"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}