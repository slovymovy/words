                "senses": [
                    {
                        "sense_id": "01d6c447-7d88-3802-903c-6e173bdb0a48",
                        "entry_id": "60aa5aaa-0267-3d6e-9ffc-935d14462194",
                        "glosses": [
                            "Appareil électromécanique permettant la génération et la réception de messages via une ligne filaire, remplacé partiellement par le télécopieur (fax) et totalement par la messagerie électronique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4925f16-0ab1-48f9-960b-84c4d1901cb7",
                                "sense_id": "01d6c447-7d88-3802-903c-6e173bdb0a48",
                                "text": "Un réseau de télécommunications international a été créé pour relier les téléscripteurs : le télex."
                            },
                            {
                                "example_id": "b4c965a6-1c94-483f-8fb4-6686d1482313",
                                "sense_id": "01d6c447-7d88-3802-903c-6e173bdb0a48",
                                "text": "Cette nouvelle vient de tomber sur les téléscripteurs de la rédaction."
                            },
                            {
                                "example_id": "ac71ce40-3454-4cdb-9ce1-adc0f67a9bef",
                                "sense_id": "01d6c447-7d88-3802-903c-6e173bdb0a48",
                                "text": "« France Inter, il est dix-sept heures, l’heure des informations, présentées par… » Un court indicatif musical, et puis : « La nouvelle vient de tomber sur les téléscripteurs : Jacques Brel est mort. »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "272ddabc-e8ba-4651-b2c2-6aee1bffe8e2",
                        "source_entry_id": "60aa5aaa-0267-3d6e-9ffc-935d14462194",
                        "source_sense_id": "01d6c447-7d88-3802-903c-6e173bdb0a48",
