                "senses": [
                    {
                        "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                        "entry_id": "b05919d6-eeae-3c6b-873b-cf4283ad7ca9",
                        "glosses": [
                            "Spielgattung, bei welcher der Spielende neue Erfahrungen machen kann, bei welcher die Wissbegier und der Erkundungsdrang ausgelebt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f1d5d32-e0d0-4c7f-974b-5b593fe40ca9",
                                "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                                "text": "„In den Entdeckerspielen erschließen sich neue Objekte, neue Menschen, neue Umwelten, neue Verhaltensformen, neue Sportarten, neue musikalische Klangformen, neue sprachliche Ausdrucksmöglichkeiten.“"
                            },
                            {
                                "example_id": "c3a01c76-edfa-4509-b9eb-13c5122aa4e5",
                                "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                                "text": "„Bilderbuchtröge und kleine, fest installierte Entdeckerspiele geben auch den Jüngsten schon Anregungen für eigenes Erkunden.“"
                            },
                            {
                                "example_id": "87567006-615c-4ecc-b95d-76e0cae1cf27",
                                "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                                "text": "„Zahlreiche Aktionen, Aufgaben, Fragen und Fotos machen das Diercke Entdeckerspiel zu einem rasanten, spannenden und kurzweiligen Spielspaß für die ganze Familie!“"
                            },
                            {
                                "example_id": "63e646ff-35d6-4723-8479-ed93d3396d02",
                                "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                                "text": "„Das Entdeckerspiel ‚20 x Budenzauber’ findet an allen vier Adventssonntagen jeweils von 13 bis 17 Uhr statt.“"
                            },
                            {
                                "example_id": "7ecb6630-d5f1-44ac-97e1-df1e182ede81",
                                "sense_id": "9ce32152-e748-3df4-9ea1-4dce68c9f66a",
                                "text": "„Von hier aus bestand die Möglichkeit zu einer Spielrallye durch die Innenstadt aufzubrechen. Dabei gab es z.B. ein Entdeckerspiel in der Stadtbibliothek, Steinspielchen und Kreidemachen auf dem Münsterplatz und Papierschiffrennen am Bächle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
