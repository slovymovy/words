                                                "example_id": "3765c680-03e6-4dea-988f-16ffedc6bad5",
                                                "sense_id": "da3b9c7a-3b5c-327b-9c6b-0d17b1c4cb47",
                                                "text": "The referee is blatantly partial!"
                                            },
