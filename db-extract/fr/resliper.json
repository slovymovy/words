                "senses": [
                    {
                        "sense_id": "00005a4e-2b74-3c0e-a171-cd819f01ab16",
                        "entry_id": "868e2fbb-596d-366d-b7e2-5f7f8578b16e",
                        "glosses": [
                            "Rééquiper en slips."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9a31e13-eb02-4c8b-bbd7-c8aa940abf50",
                                "sense_id": "00005a4e-2b74-3c0e-a171-cd819f01ab16",
                                "text": "S’il faut resliper toute la famille, la fin du prochain mois est budgétairement mal partie."
                            }
                        ]
                    },
                    {
                        "sense_id": "be4fecd4-56d5-38f7-b1ff-da34a5333e95",
                        "entry_id": "868e2fbb-596d-366d-b7e2-5f7f8578b16e",
                        "glosses": [
                            "Remettre son slip."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "4e24e467-f113-4946-99eb-c64a1de8c51e",
                                "sense_id": "be4fecd4-56d5-38f7-b1ff-da34a5333e95",
                                "text": "Minable ! Tout juste bon à jouer les mitraillettes, à lâcher une courte rafale et à se resliper !"
                            },
                            {
                                "example_id": "f6f212f7-481a-4f50-b518-789eb7bc8bf1",
                                "sense_id": "be4fecd4-56d5-38f7-b1ff-da34a5333e95",
                                "text": "Je m’approche tandis que Mélanie se reslipe."
                            }
                        ]
                    }
