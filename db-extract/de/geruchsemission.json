                ],
                "senses": [
                    {
                        "sense_id": "4804804f-82ee-3ef4-9121-af955433fe42",
                        "entry_id": "0943a4b0-6ef8-378b-9974-e6a7024ef395",
                        "glosses": [
                            "Emission von Geruch"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "e7f0bfb6-ebc9-47ec-9b32-1a80717272cc",
                                "sense_id": "4804804f-82ee-3ef4-9121-af955433fe42",
                                "text": "„Neben der einwandfreien technischen Ausrüstung kommt der Betriebsführung und dem Engagement des Anlagenpersonals die größte Bedeutung bei der Minimierung von Geruchsemissionen zu.“"
                            },
                            {
                                "example_id": "4bbc437f-f9e0-49f8-b425-f24a3bbe3e99",
                                "sense_id": "4804804f-82ee-3ef4-9121-af955433fe42",
                                "text": "„Aufgrund der vorherrschenden Unterdrucksituation im Gebäude können diese Gase und Dämpfe durch ausgetrocknete Syphonabläufe in die Laborzellen hineingezogen werden und Geruchsemission verursachen.“"
                            },
                            {
                                "example_id": "906311b2-ccd6-4813-8951-ae7fefd3b941",
                                "sense_id": "4804804f-82ee-3ef4-9121-af955433fe42",
                                "text": "„Werden für die Tierhaltung Bauten und Anlagen erstellt, geändert oder erweitert, müssen diese den berechneten Mindestabstand für Geruchsemissionen einhalten.“"
                            },
                            {
                                "example_id": "cac0f9d6-0ccb-4c38-bc16-06bafb34b010",
                                "sense_id": "4804804f-82ee-3ef4-9121-af955433fe42",
                                "text": "„Neben einer optimalen Energienutzung wird vor allem auch eine geringe Geruchsemission im Vordergrund stehen müssen, was vor allem für die Heckholzhäuser Bürger wichtig ist, die östlich der Anlage wohnen und durch die vorherrschende Windrichtung von West nach Ost in der Vergangenheit schon enormen Geruchsbelästigungen durch die Kompostierungsanlage \"Niederstein Nord\" ausgesetzt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
