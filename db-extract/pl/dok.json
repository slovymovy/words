                                "sense_id": "229a02d9-38fc-3ad7-9c76-525e14858421",
                                "text": "Kwadrans później podwiesiłam mojego TIE-a w doku i opuściłam kokpit z drżącymi rękoma"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
