                                "target_senses": [
                                    {
                                        "sense_id": "85ab5b8e-99e8-3bdc-a8bb-1c140f14b3a4",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "The belief that people of one sex (or gender) are inherently different from those of another sex, and generally that one sex is superior to others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c30257-fd86-436f-a799-88d95fdeb0d7",
                                                "sense_id": "85ab5b8e-99e8-3bdc-a8bb-1c140f14b3a4",
                                                "text": "The notion that either gender is superior is sexism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "Discrimination or different treatment based on sex or gender, especially discrimination against women."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4ab249d-c6a9-4055-98d5-a9fc70d07705",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "The fact that there is only one woman in a management position in that company makes it easy to believe that sexism runs rampant there."
                                            },
                                            {
                                                "example_id": "8b6cfc34-2e4e-48a8-8502-b8381786d79c",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "Dati launched a blistering attack on the prime minister, François Fillon, under whom she served as justice minister, accusing him of sexism, elitism, arrogance and hindering the political advancement of ethnic minorities."
                                            },
                                            {
                                                "example_id": "014338ee-ea2f-42c8-b98d-73a1af41b86c",
                                                "sense_id": "e5a47c77-2b6e-30ef-b1e4-97a7bde17f85",
                                                "text": "Beyond the glaring sexism inherent in suggesting that women's brains are so different from men's that they can't think properly, Musk lending credence to this dogshit hypothesis is incredibly goofy given that he and his audience of supposedly \"high-T\" men seem far more likely to fall in line with the sort of groupthink the original post references in such pseudo-phrenological terms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5635cb-61c5-363b-a376-34fc22031ddd",
                                        "entry_id": "ab5bb114-0d9a-358d-9246-3a3fd32c9b35",
                                        "glosses": [
                                            "Attitudes or actions that are based on or promote the expectation that people adhere to stereotypical social roles (gender roles) based on sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d7e80c8-ae25-4e33-87ad-e37771f93857",
                                                "sense_id": "6e5635cb-61c5-363b-a376-34fc22031ddd",
                                                "text": "The sexism of making and promoting violent films for men and romantic comedies for women."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
