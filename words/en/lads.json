                    "sense_definition": "Plural of <w>lad</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>lads</w> played football in the park until sunset.",
                            "target_lang_translations": {
                                "ru": "Молодые <w>парни</w> играли в футбол в парке до заката.",
                                "es": "Los jóvenes <w>chicos</w> jugaron al fútbol en el parque hasta el atardecer."
                            }
                        },
                        {
                            "text": "Two <w>lads</w> helped the teacher carry the heavy books.",
                            "target_lang_translations": {
                                "ru": "Двое <w>ребят</w> помогли учителю нести тяжелые книги.",
                                "es": "Dos <w>muchachos</w> ayudaron al profesor a llevar los libros pesados."
                            }
                        }
