                ],
                "senses": [
                    {
                        "sense_id": "a6d8c290-e440-3476-95c9-7f2126eb7a45",
                        "entry_id": "75990a8f-36d2-3511-8209-672e05885d57",
                        "glosses": [
                            "alle einzelnen Objekte zusammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "426fa053-0783-4c9a-b537-ddfbe60a5778",
                                "sense_id": "a6d8c290-e440-3476-95c9-7f2126eb7a45",
                                "text": "„Die Stadt an der Côte d'Azur hat eine neue Obergrenze für die Gesamtzahl der Kreuzfahrtpassagiere pro Tag verkündet.“"
                            },
                            {
                                "example_id": "150b280f-492a-478b-b545-dde60bd2a05f",
                                "sense_id": "a6d8c290-e440-3476-95c9-7f2126eb7a45",
                                "text": "„Das Repertoire der ägyptischen Hieroglyphen unterschied sich von den chinesischen Zeichen sowohl in der Gesamtzahl wie auch in der Proportion.“"
                            },
                            {
                                "example_id": "ce546a62-d4fb-4e65-9657-c90618bffb8c",
                                "sense_id": "a6d8c290-e440-3476-95c9-7f2126eb7a45",
                                "text": "„Von der Gesamtzahl aller lebenden Sprachen der Welt sind nur etwa 13% verschriftet, das heißt die große Mehrheit aller Einzelsprachen ist schriftlos.“"
                            },
                            {
                                "example_id": "3b7a95a2-2043-46f5-b8e8-6a4e4fffa2bb",
                                "sense_id": "a6d8c290-e440-3476-95c9-7f2126eb7a45",
                                "text": "„Von der Gesamtzahl der Krieger zogen sie die Toten ab, gaben die Verwundeten hinzu, die bald wiederhergestellt sein würden, und wussten am Ende, was es gekostet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
