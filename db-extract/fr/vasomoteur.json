                "senses": [
                    {
                        "sense_id": "dbd11dc0-3dac-3cca-84b1-54da7eee4b70",
                        "entry_id": "b3dc5bbf-4508-3e55-9da6-95f7924ccced",
                        "glosses": [
                            "Qui produit les mouvements des vaisseaux sanguins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "097aa27c-c3e5-455a-bd5c-a3c95213fbea",
                                "sense_id": "dbd11dc0-3dac-3cca-84b1-54da7eee4b70",
                                "text": "Relativement fréquente, la rhinite vasomotrice correspond à une forme de rhinite persistante dont l'origine n'est pas allergique."
                            },
                            {
                                "example_id": "1cd9c7ea-4f30-4ca2-ba4e-c7e735f9fc00",
                                "sense_id": "dbd11dc0-3dac-3cca-84b1-54da7eee4b70",
                                "text": "Environ 75 % des femmes ménopausées éprouvent des symptômes vasomoteurs, y compris des bouffées de chaleur, des sueurs nocturnes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d39dda0b-25c7-3752-adee-87b410303552",
                        "entry_id": "b3dc5bbf-4508-3e55-9da6-95f7924ccced",
                        "glosses": [
                            "Qualifie les nerfs qui déterminent la contraction ou la dilatation des vaisseaux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "aba742a3-74dc-40b5-a56f-6a28b5469c9d",
                                "sense_id": "d39dda0b-25c7-3752-adee-87b410303552",
                                "text": "Les centres vasomoteurs sont situés dans le tronc cérébral. Ce sont ces centres qui sont responsables de la régulation de la pression artérielle."
                            }
                        ]
                    }
                ],
