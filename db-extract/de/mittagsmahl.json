                ],
                "senses": [
                    {
                        "sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                        "entry_id": "d888c66c-e0af-355d-88e9-e3019a11d50d",
                        "glosses": [
                            "ein Essen zu Mittag"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "59b7b46e-5a20-410c-a1eb-271b7f34dd87",
                                "sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                                "text": "„Dort war es sehr ruhig, weil die Angestellten zum Mittagsmahl nach Hause gegangen waren, während Ortega in seinem Schreibtischsessel saß und mit hochgelegten Beinen eine kleine Siesta hielt.“"
                            },
                            {
                                "example_id": "7b073934-a71d-45a8-8f55-3305dc2d67f6",
                                "sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                                "text": "„Er hatte sich das stets fleischlose Mittagsmahl wieder vom Gasthof durch einen Pagen holen lassen, der sich ihm durch kleine Besorgungen schon häufiger gefällig erwiesen hatte.“"
                            },
                            {
                                "example_id": "0ef31185-e0ec-4826-9873-b6c8b76d155f",
                                "sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                                "text": "„Doch kaum hatte die Familie ihr Mittagsmahl beendet und der Squire noch zwei eben eingetroffene Briefe gelesen, da hörte man Pferdegetrappel.“"
                            },
                            {
                                "example_id": "b420f637-12b7-4f12-b9aa-faedfb78e5b3",
                                "sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                                "text": "„Trotzdem trieb Francesco, der Gefängniskoch, besonders schöne auf, als sich die begüterten Häftlinge Leblanc und Alcoba für das Mittagsmahl des 15. November Pellkartoffeln bestellten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b114414-6765-4ed0-81de-8d104dffd0d1",
                        "source_entry_id": "d888c66c-e0af-355d-88e9-e3019a11d50d",
                        "source_sense_id": "ae1c5c82-9fb9-3391-9434-ab6c9b694d11",
                        "source_sense_description": "gehoben: ein Essen zu Mittag",
                        "target_lang_word": "déjeuner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déjeuner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b565ab82-7c90-3537-ba42-6179b88c689e",
                                        "entry_id": "e02f107e-00bd-3f1d-a26c-381d18aaa540",
                                        "glosses": [
                                            "Repas de midi. Repas du matin."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5799017f-4ad9-4055-a190-ab2b229d8795",
                                                "sense_id": "b565ab82-7c90-3537-ba42-6179b88c689e",
                                                "text": "Elle décidait de l’entrée au logis et de la mort des cochons, frondait le jardinier, arrêtait le menu du déjeuner et du dîner, allait de la cave au grenier, du grenier dans la cave, en y balayant tout à sa fantaisie sans rien trouver qui lui résistât."
                                            },
                                            {
                                                "example_id": "32166494-adae-4ad2-afdd-990239f1e682",
                                                "sense_id": "b565ab82-7c90-3537-ba42-6179b88c689e",
                                                "text": "À midi, elle lisait déjà, le grand déjeuner finissant à onze heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df04925b-4bdf-32ff-a5e8-3fb34a8d2bea",
                                        "entry_id": "e02f107e-00bd-3f1d-a26c-381d18aaa540",
                                        "glosses": [
                                            "Repas du matin."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Canada",
                                            "Suisse & nombreuses régions françaises"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c7bf756-8734-4668-9387-0e48e21c1e19",
                                                "sense_id": "df04925b-4bdf-32ff-a5e8-3fb34a8d2bea",
                                                "text": "J’ai souvenir encore d’une vieille maison\n Que l’on se partageait chacun à sa façon\n Un logement bien chauffé, on a si bien gelé\n Les rats dans l’escalier prenaient leur déjeuner."
                                            },
                                            {
                                                "example_id": "1e6911b1-97ec-4a65-bf4b-f7231d685686",
                                                "sense_id": "df04925b-4bdf-32ff-a5e8-3fb34a8d2bea",
                                                "text": "Peux-tu commencer à travailler demain? J’ouvre à sept heures. Les déjeuners marchent fort ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "617dafe0-808c-3290-a0f8-a63f5cdc1cfc",
                                        "entry_id": "e02f107e-00bd-3f1d-a26c-381d18aaa540",
                                        "glosses": [
                                            "Pièce de vaisselle de la forme d’une tasse, mais d’une contenance très supérieure, utilisée le matin lors du petit déjeuner. Le déjeuner est un peu moins haut et plus large que le « mug »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba5e054-2865-4d14-a24d-06242764905e",
                                                "sense_id": "617dafe0-808c-3290-a0f8-a63f5cdc1cfc",
                                                "text": "Un déjeuner en porcelaine de Sèvres, pâle tendre, ancien décor à bandes bleues alternées de bouquets de fleurs, 285 fr."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "déjeuner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38153f94-b819-340c-b8e3-b534a629f4fb",
                                        "entry_id": "b844f30e-7da2-31ba-94f3-8b945d1e1175",
                                        "glosses": [
                                            ", , , Prendre le repas du matin."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Canada",
                                            "Suisse",
                                            "Occitanie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8e6f3a9-7f39-40eb-bd3f-b1b04487fe28",
                                                "sense_id": "38153f94-b819-340c-b8e3-b534a629f4fb",
                                                "text": "On fait, en Suisse, ordinairement trois repas : le matin, on déjeune au miel et au café; vers midi, on lunche, et le soir, on dîne ou soupe à la table d’hôte ou isolément."
                                            },
                                            {
                                                "example_id": "7e38c96a-5746-4c72-a0d2-0b7c976218c2",
                                                "sense_id": "38153f94-b819-340c-b8e3-b534a629f4fb",
                                                "text": "À sept heures vingt-huit, je suis dans la rue. Je n’ai encore jamais eu le temps de déjeuner ni de me laver, bien entendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3b4296d-fe5c-31b5-907f-2601cd375a8d",
                                        "entry_id": "b844f30e-7da2-31ba-94f3-8b945d1e1175",
                                        "glosses": [
                                            "Prendre le déjeuner ; prendre le repas du midi."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7580a08e-f4a1-4a53-b155-fd233dc163fc",
                                                "sense_id": "e3b4296d-fe5c-31b5-907f-2601cd375a8d",
                                                "text": "[…] nous remontons au sommet du Hohneck par un sentier à nombreux zigzags, et bientôt toute la société réunie s’entasse pour déjeuner dans le restaurant en planches établi près de la table d’orientation du Club alpin."
                                            },
                                            {
                                                "example_id": "e40d8d4e-fe44-489f-89ab-cf3ba4542883",
                                                "sense_id": "e3b4296d-fe5c-31b5-907f-2601cd375a8d",
                                                "text": "Il est onze heures, allons, nous déjeunerons à Rosières, un nom affriolant !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
