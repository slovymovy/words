        "ru-extract.jsonl": [
            {
                "entry_id": "c68e98e9-5fa2-3c5d-b6f7-3f5193f9c6ab",
                "word": "бескровно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b54263b-bd4f-367d-90b2-9c067aa33950",
                        "entry_id": "c68e98e9-5fa2-3c5d-b6f7-3f5193f9c6ab",
                        "glosses": [
                            "наречие к бескровныйᴵ; без пролития крови"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "a079c7ad-208d-459e-9f26-c3f558ce7f53",
                                "sense_id": "4b54263b-bd4f-367d-90b2-9c067aa33950",
                                "text": "Москва без единого почти выстрела и почти бескровно перешла в руки новой власти."
                            },
                            {
                                "example_id": "e87540bb-f071-4dc6-81e5-f97809cc480d",
                                "sense_id": "4b54263b-bd4f-367d-90b2-9c067aa33950",
                                "text": "Мясоедов вызвал Гучкова на дуэль, которая окончилась бескровно."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c940808-574f-3146-9c5e-18d35e2c9b19",
                        "entry_id": "c68e98e9-5fa2-3c5d-b6f7-3f5193f9c6ab",
                        "glosses": [
                            "наречие к бескровныйᴵ; без крови или с малым количеством крови"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "07f73d1f-c4a0-4c88-9d64-e32907575bd9",
                                "sense_id": "3c940808-574f-3146-9c5e-18d35e2c9b19",
                                "text": "Его голое снизу, до пояса, тело бескровно просвечивало на стене, со сбитыми коленками и руками с изломанными ногтями: на стене чёрным пятном застыла кровь, да, она уже застыла; видимо, Веретенников бился о стену."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d49593c-8624-394b-bc3c-51a379c2bae5",
                        "entry_id": "c68e98e9-5fa2-3c5d-b6f7-3f5193f9c6ab",
                        "glosses": [
                            "перен. наречие к бескровныйᴵ; без силы, выразительности; без ярких, характерных черт"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": []
                    }
