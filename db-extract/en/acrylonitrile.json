                        "translation_id": "baecedb6-a40d-411b-be77-2b8e8a64c4e1",
                        "source_entry_id": "b5f37b72-8d9d-34a0-a0ef-f33ab561473e",
                        "source_sense_id": "b4d15866-8dfb-38be-b0ee-c47ff4b2949a",
