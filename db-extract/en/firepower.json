                                        "glosses": [
                                            "totale vermogen van een aantal vuurwapens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e67cd1d-3567-4482-b547-2d8ac851391b",
                                                "sense_id": "32c7b6da-bf82-3012-8bfe-afb0b7f32d39",
                                                "text": "Wij hebben niet genoeg vuurkracht voor deze taak"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2936764-82d0-4a77-8009-a46bf4100614",
                        "source_entry_id": "669da3f4-10b4-348b-af49-157bad39af87",
                        "source_sense_description": "capacity of a weapon",
                        "target_lang_word": "puissance de feu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puissance de feu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34d7152c-d067-3d45-ba59-bfab70abdfaa",
                                        "entry_id": "2d0fea7d-28cb-3f03-87cd-dc6a6ec3a47d",
                                        "glosses": [
                                            "Capacité de destruction et cadence de tir d’une arme à feu, d’un bâtiment ou d’une armée entière."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95e2d1ae-ada7-41b4-b7f5-f102d8fa0f4e",
                                                "sense_id": "34d7152c-d067-3d45-ba59-bfab70abdfaa",
                                                "text": "Passé la surprise des premiers jours, le camp russe s’est montré plutôt avare en génie tactique, n’avançant que frontalement, grâce à l’écrasante supériorité de sa puissance de feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32151c4-24a1-3705-9868-a7ed26c2cc03",
                                        "entry_id": "2d0fea7d-28cb-3f03-87cd-dc6a6ec3a47d",
                                        "glosses": [
                                            "Forte influence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25b0d168-9509-4d89-9c5a-1bed321eecea",
                                                "sense_id": "b32151c4-24a1-3705-9868-a7ed26c2cc03",
                                                "text": "Parmi tous les groupes d’influence, celui des chasseurs, représenté par l’influent lobbyiste Thierry Coste, possède il est vrai une puissance de feu considérable."
                                            },
                                            {
                                                "example_id": "a3e36386-0b07-4f11-802d-733aedb7a5b5",
                                                "sense_id": "b32151c4-24a1-3705-9868-a7ed26c2cc03",
                                                "text": "L’accord de libre-échange entre l’UE et le Mercosur fait craindre aux producteurs français d’être écrasés par la puissance de feu du Brésil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
