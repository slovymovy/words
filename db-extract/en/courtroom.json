                                    {
                                        "sense_id": "c6fca0f7-c21a-3d95-b268-87634b7aa160",
                                        "entry_id": "2dfc3e84-781e-3a80-89aa-ae1123471e0f",
                                        "glosses": [
                                            "de ruimte waar een rechtszitting gehouden wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "498f5784-5720-46bd-82f6-30848a943b39",
                                                "sense_id": "c6fca0f7-c21a-3d95-b268-87634b7aa160",
                                                "text": "In de rechtszaal speelt de man de vermoorde onschuld."
                                            },
                                            {
                                                "example_id": "d62f4937-6ab7-4886-a87c-25a612b4e653",
                                                "sense_id": "c6fca0f7-c21a-3d95-b268-87634b7aa160",
                                                "text": "Gerard Sanderinks ict-bedrijf Centric wankelt onder de aanhoudende stroom van slechte publiciteit. Die opmerkelijke bekentenis deed bestuursvoorzitter Louis Luijten maandagmorgen in de rechtszaal in Almelo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bb17347-c2b6-41c8-95e3-3ffdd4127d12",
                        "source_entry_id": "9fe71c97-bbc5-36a3-9288-0acefc00a985",
                        "source_sense_id": "268ed049-e502-3eba-8e9a-f284fecff591",
                        "source_sense_description": "room where a judge presides",
                        "target_lang_word": "salle d'audience",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a71f78ad-ef67-4db2-9b66-56a269d0d1b9",
                        "source_entry_id": "9fe71c97-bbc5-36a3-9288-0acefc00a985",
                        "source_sense_id": "268ed049-e502-3eba-8e9a-f284fecff591",
                        "source_sense_description": "room where a judge presides",
                        "target_lang_word": "Gerichtssaal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gerichtssaal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86b3cabe-9b58-3377-aee1-ec9743e8061c",
                                        "entry_id": "5a490728-6a1f-389e-a458-1d9227b06e9c",
                                        "glosses": [
                                            "größerer Raum, in dem ein Gericht verhandeln kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3a4faa-a86f-4d7e-a95d-9a2a9ab2463c",
                                                "sense_id": "86b3cabe-9b58-3377-aee1-ec9743e8061c",
                                                "text": "„Als sie sich geschlossen weigerten, riss dem obersten Richter der Geduldsfaden, und im Gerichtssaal brach Tumult aus.“"
                                            },
                                            {
                                                "example_id": "4bcf4c38-a8e5-4e07-b1f2-87aee88ccefc",
                                                "sense_id": "86b3cabe-9b58-3377-aee1-ec9743e8061c",
                                                "text": "„Unter den wenigen Zuhörern auf den Bänken des Gerichtssaals war der Kassenwart des Schriftstellerverbandes, aber ob er aus Solidarität oder Neugierde gekommen war, wusste Eigil nicht.“"
                                            },
                                            {
                                                "example_id": "dc29dcc8-3082-4a08-8f49-767aaa2986ad",
                                                "sense_id": "86b3cabe-9b58-3377-aee1-ec9743e8061c",
                                                "text": "„Eigentlich müsste er dank der Lizenzgebühr mehr als komfortabel leben können, stattdessen sitzt er in Gerichtssälen.“"
                                            },
                                            {
                                                "example_id": "1a57949d-9fd1-4238-a63a-0cc621a9b0c0",
                                                "sense_id": "86b3cabe-9b58-3377-aee1-ec9743e8061c",
                                                "text": "„Elsa verlässt den Gerichtssaal und entdeckt Jürgen Loose, der am Ausgang wartet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
