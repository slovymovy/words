                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to light",
                                "target_lang_sense_clarification": "a candle or lamp"
                            },
                            {
                                "target_lang_word": "to ignite",
                                "target_lang_sense_clarification": "a flame or light source"
                            },
                            {
                                "target_lang_word": "to switch on",
                                "target_lang_sense_clarification": "a light or device"
                            }
                        ]
