                    {
                        "sense_id": "158b8d87-5f5d-3660-ae74-4bfd9f0bd2f6",
                        "entry_id": "fc4f6094-e904-31fe-9d4d-9290ef488b2c",
                        "glosses": [
                            "slip box, card file"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "be4d54a9-984c-44d0-bad0-6bd71f8eb170",
                                "sense_id": "158b8d87-5f5d-3660-ae74-4bfd9f0bd2f6",
                                "text": "Diese Enttäuschung resultierte wohl schon aus dem Äußeren des Zettelkastens, der in seiner Unauffälligkeit auf bemerkenswerte Weise mit dem Erscheinungsbild seines Erstellers korrespondierte: Sechs größere hölzerne Karteikästen mit je vier Auszügen, das Ganze nicht größer als ein Schrank."
                            },
                            {
                                "example_id": "46b4a05c-0646-4adc-a6b1-99f3698ed000",
                                "sense_id": "158b8d87-5f5d-3660-ae74-4bfd9f0bd2f6",
                                "text": "Das ist genauso abwegig wie die Idee, der Zettelkasten sei so etwas wie der Vorläufer von Wikipedia oder gar des Internets – auf diese Ideen kann man nur kommen, wenn man keine Ahnung hat, wie man mit ihm tatsächlich arbeitet."
                            }
                        ]
                    }
