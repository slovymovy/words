                    {
                        "translation_id": "46b76c4d-4c1c-4978-9a36-2494c59695f1",
                        "source_entry_id": "eb33c66d-93d6-3940-90e2-62ea33fab676",
                        "source_sense_id": "404888e0-e0e9-3ae3-abad-4224c8ffb769",
                        "target_lang_word": "chocolaterie",
                        "target_lang_code": "fr",
