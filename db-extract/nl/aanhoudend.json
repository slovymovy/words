                                            {
                                                "example_id": "f309daf4-df23-4a23-86dd-3d0bc76205d0",
                                                "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                                "text": "The dog's incessant barking kept the girl awake all night."
                                            },
                                            {
                                                "example_id": "d99ba1c0-f99b-40ad-8ab2-5780973fa96c",
                                                "sense_id": "2eb82fa7-5f8f-3812-95c7-1d743e66e5c6",
                                                "text": "[…] incessant interferings and bickerings, in every country, between the secular powers and the ecclesiastical."
                                            },
