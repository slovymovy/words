                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Werft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                        "entry_id": "f6940768-c6c1-320d-b390-0342317dd31c",
                                        "glosses": [
                                            "Industrieanlage zum Bauen und Reparieren von Schiffen oder Flugzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "517ac32e-7952-47af-a9dd-34e7612e4d6a",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„In aller Frühe ließ er uns heraustrommeln, lief mit uns im Laufschritt zum Dampfer, und wir fuhren zur Werft, um dort die einzelnen Gegenstände für unsere Ausrüstung zu requirieren.“"
                                            },
                                            {
                                                "example_id": "ebe9ac3a-5bcd-4dd8-ab08-07ffde27d1d7",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„Am Ende der städtischen Werften begannen die Becken, wo die Schiffe ausgestattet oder gebaut wurden.“"
                                            },
                                            {
                                                "example_id": "9aac5e0a-1615-4041-9109-a1fdc9c4db48",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„In den Küstenstädten Wismar, Rostock und Stralsund sind moderne und leistungsfähige Werften entstanden.“"
                                            },
                                            {
                                                "example_id": "9a10482d-cae7-4d10-9af1-13a03da8ff9a",
                                                "sense_id": "9ec81b69-a727-3437-9880-118874eb410a",
                                                "text": "„Die Werft in Turku ist eine der größten Europas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
