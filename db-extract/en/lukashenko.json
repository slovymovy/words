                    {
                        "translation_id": "20a6b76b-b197-4534-81aa-a97769c28a39",
                        "source_entry_id": "d7513d72-7cde-3eed-955a-49a64f550be4",
                        "source_sense_id": "efa26540-cb37-300c-802c-9184d12061b9",
