                                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                                        "glosses": [
                                            "D’une manière provisoire, en attendant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd28b087-a842-47a9-a68d-35b3238252ef",
                                                "sense_id": "dfde0cba-bb35-30bd-b77b-ca82c1dd20d1",
                                                "text": "Parfois, l'ampleur des travaux est telle que la route doit être provisoirement fermée et interdite à toute circulation. Un itinéraire de déviation est alors provisoirement mis en place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                                        "glosses": [
                                            "Par provision."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b0ee78-bf50-4b2e-b517-2a9d23f2d7e5",
                                                "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                                                "text": "Cela n'a été jugé que provisoirement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
