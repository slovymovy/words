                    {
                        "translation_id": "4653be6c-d23d-4e7c-a0d8-6e05187d269f",
                        "source_entry_id": "3ea61265-08c7-3b50-9fec-9fc09deeb46b",
                        "source_sense_description": "state",
                        "target_lang_word": "Brême",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brême",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5555486e-69bd-3827-822b-ef477f5270b9",
                                        "entry_id": "745d7e3b-cfa1-3a4a-a491-10fb039b03c8",
                                        "glosses": [
                                            "Ville d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "384f8bd3-0061-4155-9f48-d1bf0eb92afa",
                                                "sense_id": "5555486e-69bd-3827-822b-ef477f5270b9",
                                                "text": "Remarquez que je suis attendu par des sociétés littéraires et scientifiques d’Emden, de Hambourg, et de Brême…"
                                            },
                                            {
                                                "example_id": "939fd168-339f-47ee-8c1d-892230dda622",
                                                "sense_id": "5555486e-69bd-3827-822b-ef477f5270b9",
                                                "text": "En Allemagne, la campagne a l’air aussi tranquille et aussi prospère qu’en 1932. Rien n’annonce cet amas de décombres qu’est la ville de Brême ; mais décombres n’est pas le mot qui convient : tout a été balayé, nettoyé. Ne restent debout que des ruines bien propres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fe3a116-adef-382f-8ed9-d0042c8070e0",
                                        "entry_id": "745d7e3b-cfa1-3a4a-a491-10fb039b03c8",
                                        "glosses": [
                                            "Un des seize Länder qui constituent la République fédérale d’Allemagne."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77f425b4-d0e1-4e58-a5f5-64b76fb1caf2",
                        "source_entry_id": "3ea61265-08c7-3b50-9fec-9fc09deeb46b",
                        "source_sense_description": "state",
                        "target_lang_word": "Bremen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                        "entry_id": "4f448c3d-109f-329f-86fe-0078eb23524c",
                                        "glosses": [
                                            "eine Stadt an der Weser in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f6698c9-ba97-4c78-8646-e48c1a22d2e2",
                                                "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                                "text": "Die Hansestadt Bremen liegt an der Weser."
                                            },
                                            {
                                                "example_id": "73651e96-753d-44e3-b4ae-1d43f276b87c",
                                                "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                                "text": "„Weißt du was, sprach der Esel, ich gehe nach Bremen, dort Stadtmusikant zu werden, geh mit und laß dich auch bei der Musik annehmen.“"
                                            },
                                            {
                                                "example_id": "60be4909-9fe6-4f66-95d7-3aec3dbc0570",
                                                "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                                "text": "„Die Verhandlungen in Bremen währten länger, als erwartet, und kamen erst zum Abschluß, als eine nach den friesischen Inseln unternommene Reise die bis dahin bezweifelte Durchführbarkeit des Unternehmens bewiesen hatte.“"
                                            },
                                            {
                                                "example_id": "f7a12ee6-a5ae-42b2-bc2b-2b753be2d2e4",
                                                "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                                "text": "„Seit 1867 gehört Bremen zum Norddeutschen Bund.“"
                                            },
                                            {
                                                "example_id": "a1b47af4-0a12-4873-92c3-80237ca6b6f1",
                                                "sense_id": "a8ff9f0b-398d-3eb5-8b24-166cf841c5d1",
                                                "text": "Bremen liegt im Nordwesten Deutschlands."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e1269f4-a244-3bb6-9892-6ef277f26cc4",
                                        "entry_id": "4f448c3d-109f-329f-86fe-0078eb23524c",
                                        "glosses": [
                                            "Freie Hansestadt Bremen, ein Bundesland der Bundesrepublik Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c039d724-91ef-4286-94a9-6e210a004116",
                                                "sense_id": "9e1269f4-a244-3bb6-9892-6ef277f26cc4",
                                                "text": "Bremen liegt im Nordwesten Deutschlands."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
