                                            {
                                                "example_id": "2d7295b1-2d7b-4e07-a211-11fdca608bdb",
                                                "sense_id": "9db587b5-1754-3ad1-9d40-247b6ea5b829",
                                                "text": "Po otevření obalu opatrně vyjměte obsah."
                                            },
                                            {
                                                "example_id": "304dd4fc-9165-4cd0-bf6b-50e25a8ac8c0",
                                                "sense_id": "9db587b5-1754-3ad1-9d40-247b6ea5b829",
                                                "text": "Komunisté sice dávno nejsou revolucionáři, popolézají opatrně jako hadi, šikovně se snaží spojit s Babišem, ale zároveň dokonale využívají faktu, že od roku 1989 uběhlo mnoho let, lidé zapomínají a věci se relativizují, nic už jako by nebyla pravda."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9835c02-1a6b-4511-9542-735ba4ab0956",
                        "source_entry_id": "6842ea92-fd0e-3179-b1e0-1205029ca1c8",
                        "source_sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
