                "senses": [
                    {
                        "sense_id": "73ee4bc2-bfc6-3446-bc3f-fb21cb66a447",
                        "entry_id": "d31600f4-a36b-3f24-87cc-5d2fe10e8baf",
                        "glosses": [
                            "Aufseher in einem Nationalpark, Schutzgebiet oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8787fa7d-46b1-4be2-b8ec-d3e1b7c0a300",
                                "sense_id": "73ee4bc2-bfc6-3446-bc3f-fb21cb66a447",
                                "text": "Der Ranger hat uns im Yellowstone-Nationalpark gefragt, warum wir an diesem Platz kampieren, weil es im Park wegen der Wildtiere lebensgefährlich ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76971393-9c81-36da-9052-8fd33110fb82",
                        "entry_id": "d31600f4-a36b-3f24-87cc-5d2fe10e8baf",
                        "glosses": [
                            "im Nah- und Einzelkampf geschulter Soldat der US Army"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0d74bfe-aafb-4b64-ac37-7bbfe5be0181",
                                "sense_id": "76971393-9c81-36da-9052-8fd33110fb82",
                                "text": "„Danach schloss er sich den Rangers an und wurde von dort aus für die Deltas rekrutiert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
