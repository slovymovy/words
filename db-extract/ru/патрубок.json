                                        "examples": [
                                            {
                                                "example_id": "321eb409-5e6d-473c-937d-5e6ef6bef683",
                                                "sense_id": "27423fd1-368a-39c8-855a-a44621a2c052",
                                                "text": "Her head and trunk were carved out of, or rather into, the bole of a great red cedar. She seemed to be part of the tree itself, as if she had grown there at its heart, and the carver had only chipped away the outer wood so that you could see her. Her arms were spliced and socketed to the trunk, and were flung wide in a circling, compelling movement."
                                            }
