                ],
                "senses": [
                    {
                        "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                        "entry_id": "5be0e744-7836-3284-b194-34b46ed5a982",
                        "glosses": [
                            "hinteres Teil, Schwanzregion"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "eade82f4-f292-4769-9978-18267e99feb2",
                                "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                                "text": "„Parda ließen ihren Schwanz oder Stert normal einfach am Körper herabhängen, obwohl er tatsächlich eine sehr muskulöse Extremität war. Allerdings konnte man sehr gut Emotionen am Stert des Besitzers ablesen.“"
                            },
                            {
                                "example_id": "26c70ff6-bda7-4d27-89f9-afcc6de156f4",
                                "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                                "text": "„Die Carnica hat zwar keine grüne Feder am Stert, wohl aber erkennt man sie an einem ganz bestimmten Aussehen.“"
                            },
                            {
                                "example_id": "a483d055-ba81-4aa9-8017-de40fd630bed",
                                "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                                "text": "„Ein Hahn wird am Stert gerupft, mit Salz eingerieben und mit zugehaltenem Schnabel (!) auf die Beule gesetzt. Stirbt er, so kommt ein anderer an die Stelle, bis einer am Leben bleibt, »dann ist das Gift heraus«.“ (1909)"
                            },
                            {
                                "example_id": "a6f62106-4853-4183-927c-390893a9a305",
                                "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                                "text": "„Die Heringskurre (aus der Netzfabrik von Mewes & von Eitzen in Altona) ist 132 Fuß lang, wovon 70 auf die Flügel, 40 auf den Mittelteil und 22 auf den Stert kommen.“"
                            },
                            {
                                "example_id": "ec4236ec-d907-44c0-91c4-d7e102a792c7",
                                "sense_id": "a5d8bc92-95ce-3d6f-83e5-05ea6f1ae409",
                                "text": "„Die Bark stampfte, schlingerte, stellte sich auf den Kopf, setzte sich auf den Stert, rollte, ächzte, und wir mußten uns festklammern, wenn wir auf Deck, und uns gegen die Kojen spreizen, wenn wir unter Deck waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
