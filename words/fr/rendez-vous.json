{
    "word_family": [
        "rendre",
        "reddition",
        "rendement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df44c1fc-6d15-3c91-a8ec-de29169a3e3e",
                    "sense_definition": "Convention fixée entre deux ou plusieurs personnes pour se rencontrer à un moment et en un lieu précis.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rencontre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai pris un <w>rendez-vous</w> chez le médecin pour demain matin."
                        },
                        {
                            "text": "N'oubliez pas d'arriver à l'heure à votre <w>rendez-vous</w> professionnel."
                        }
                    ],
                    "common_phrases": [
                        "prendre rendez-vous",
                        "donner rendez-vous",
                        "avoir rendez-vous",
                        "manquer un rendez-vous"
                    ]
                },
                {
                    "sense_id": "0ccec08e-2b11-3b36-a1e2-c134f4559607",
                    "sense_definition": "Rencontre convenue entre deux personnes dans un cadre amoureux ou de séduction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rencontre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils étaient très nerveux lors de leur premier <w>rendez-vous</w> au café."
                        },
                        {
                            "text": "Elle a accepté un <w>rendez-vous</w> avec son nouveau prétendant ce soir."
                        }
                    ],
                    "synonyms": [
                        "date",
                        "rancard",
                        "rencard"
                    ],
                    "common_phrases": [
                        "premier rendez-vous",
                        "rendez-vous amoureux",
                        "rendez-vous galant"
                    ]
                },
                {
                    "sense_id": "ffa35964-fecf-3571-bd00-3376ceb6d08b",
                    "sense_definition": "Lieu où des personnes ont coutume de se retrouver ou de se rassembler.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux bistrot est le <w>rendez-vous</w> habituel de tous les artistes du quartier."
                        },
                        {
                            "text": "La place du village sert de <w>rendez-vous</w> aux jeunes le week-end."
                        }
                    ],
                    "common_phrases": [
                        "lieu de rendez-vous",
                        "point de rendez-vous"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c8f0cfd-2888-38ea-b984-eb11de7f29e7",
                    "sense_definition": "Deuxième personne du pluriel de l'impératif présent du verbe <w>se rendre</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Rendez-vous</w> immédiatement à la réception pour récupérer votre badge d'accès."
                        },
                        {
                            "text": "Dès la fin de la réunion, <w>rendez-vous</w> directement dans la grande salle."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "5cd4b3f9-2308-3e52-af3e-419949e20c59",
                    "sense_definition": "Ordre intimé à un ennemi ou à un adversaire d'abandonner le combat et de capituler.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "capitulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de police ont crié aux fugitifs : « <w>Rendez-vous</w>, vous êtes cernés ! »"
                        },
                        {
                            "text": "Le commandant a sommé les assiégés : « <w>Rendez-vous</w> sans poser de conditions ! »"
                        }
                    ]
                }
            ]
        }
    ]
}