                        "target_lang_word": "Pinscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "43a55b68-780c-4334-8f73-21a75557bdf1",
                        "source_entry_id": "2ce635ea-49b3-3899-a267-0b791273bbbe",
                        "source_sense_id": "b3a86816-4390-34b5-90b7-dc3d9c3e0ff4",
                        "source_sense_description": "small and insignificant person",
                        "target_lang_word": "Niemand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niemand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                        "entry_id": "a6c3c5eb-e51e-3638-a030-255e79477a65",
                                        "glosses": [
                                            "Person ohne viel Bedeutung; bedeutungslose Person; jemand, dem nicht viel Bedeutung geschenkt wird"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943bbac5-0ed5-47ce-a55b-1411ad39a6b4",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Wer bist du schon außer ein Niemand?“"
                                            },
                                            {
                                                "example_id": "ce241a61-adb3-4290-86b1-2eec3abc223a",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Ich raste gegen Nichts und Niemand.“"
                                            },
                                            {
                                                "example_id": "39a67939-425c-4d24-8a9d-2120f2ffc0c4",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Vieles muß sich jedoch zusammenfügen, wenn ein Niemand Literatur vorlegt, die zum Bestseller wird.“"
                                            },
                                            {
                                                "example_id": "f8dcf76a-6c63-47d6-8a4d-f45aaaa9bc0d",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Mit der Zeit wurden einige dieser Niemande wieder zu Jemanden, die neue Niemande zur Welt brachten.“"
                                            },
                                            {
                                                "example_id": "0eda6fd8-47a3-4a34-b225-22deb63774ca",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Aber das Vertrauen dieses Erzählers in die Überlegenheit nicht nur seines Onkels, sondern seiner ganzen Familie im Vergleich zu den Bediensteten, diese Niemande und Jemande, lässt eine andere Geschichte sichtbar werden.“"
                                            },
                                            {
                                                "example_id": "44c4aa6e-e1bb-4ecf-ad51-d467f10d1213",
                                                "sense_id": "11611577-94d2-370c-a16e-4be3c671c314",
                                                "text": "„Und diese Niemande waren nur in einer Sache geschickt – daran, russisches Geld in ihre eigenen Taschen zu befördern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
