                ],
                "senses": [
                    {
                        "sense_id": "bcff8afd-0df8-397e-8b44-1b5eb9fafcb8",
                        "entry_id": "c0be426f-ff75-3715-a69b-ce81b62e7f65",
                        "glosses": [
                            "Homme qui fait une offre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34794c9a-79ea-445a-8b27-a0424acb4507",
                                "sense_id": "bcff8afd-0df8-397e-8b44-1b5eb9fafcb8",
                                "text": "Elle a inventé une ruse pour que personne ne devine l’identité de l’offreur."
                            },
                            {
                                "example_id": "0ecc9c9f-6ce6-4c15-b34d-3576fa9ece4f",
                                "sense_id": "bcff8afd-0df8-397e-8b44-1b5eb9fafcb8",
                                "text": "Pour les biens intellectuels ou virtuels (émissions de télévision, logiciels non personnalisés), l’offreur ne se prive pas du bien qu’il offre."
                            }
                        ]
                    },
                    {
                        "sense_id": "737b613f-40f7-355a-94ac-1c45fea5ff31",
                        "entry_id": "c0be426f-ff75-3715-a69b-ce81b62e7f65",
                        "glosses": [
                            "Homme qui propose un prix dans une vente."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "554901aa-833c-4694-81cf-a5d53873e83c",
                                "sense_id": "737b613f-40f7-355a-94ac-1c45fea5ff31",
                                "text": "Et votre offreur, il propose combien ?"
                            },
                            {
                                "example_id": "35168656-06be-463f-9aec-bc8f6f919144",
                                "sense_id": "737b613f-40f7-355a-94ac-1c45fea5ff31",
                                "text": "Un offreur a monté l’enchère à 1 000 000 € !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "787221ec-11e0-459b-b1b8-55d878837cc7",
                        "source_entry_id": "c0be426f-ff75-3715-a69b-ce81b62e7f65",
                        "target_lang_word": "Anbieter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anbieter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                        "entry_id": "800d12ec-a532-38ec-9ce7-4a3d0c1f0588",
                                        "glosses": [
                                            "jemand, der etwas anbietet; jemand, der eine Ware oder Dienstleistung gegen Bezahlung zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29045b40-bfbe-4ea6-a9d8-c122f6affbe6",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "Nirgendwo ist der Preisvergleich so schnell und einfach wie im Internet: Datenbanken suchen den günstigsten Anbieter für ein Produkt."
                                            },
                                            {
                                                "example_id": "e84575c9-e6e3-43ba-8676-82eef1741070",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "„Dementsprechend wichtig ist es, einen versierten Finanzierungsberater an der Seite zu haben, der nicht nur weiß, worauf es den Anbietern besonders ankommt, sondern der durch seine Erfahrung auch manchen Kniff kennt, der das Vorhaben günstig und schnell wahr werden lässt.“"
                                            },
                                            {
                                                "example_id": "9e3df487-efa1-4c06-bd4a-3b20b68ed9b3",
                                                "sense_id": "20f2a37e-8e80-3731-9941-87d5ae24189c",
                                                "text": "„Der Markt für Wallboxen ist insgesamt recht unübersichtlich, es gibt eine Vielzahl von Anbietern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "089cbaa5-92a8-4347-a73a-756b1e6a6f9b",
                        "source_entry_id": "c0be426f-ff75-3715-a69b-ce81b62e7f65",
                        "target_lang_word": "bidder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "Someone who bids (all senses), but most commonly, one offers to pay a specified price at an auction"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4396afa5-567e-48db-bf07-1885b0edeb5f",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "The highest bidder shall get the house."
                                            },
                                            {
                                                "example_id": "17e0f737-7436-461c-817f-ed51122de8a1",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "But that is changing; in the coming months, Mr. Gollinger said, his company will hold an auction in a suburban New York community where lenders will help preapprove bidders for mortgages."
                                            },
                                            {
                                                "example_id": "6f6de968-8d7f-45d4-b040-918515176819",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In 2004, the authority declared Abec a nonresponsible bidder after the company failed to submit accurate information."
                                            },
                                            {
                                                "example_id": "fdee07e7-72a5-4fb0-9aba-a0879976de09",
                                                "sense_id": "4118e30b-fcb2-3656-b914-38c855ab21b2",
                                                "text": "In other words, the transaction is preferred because it is the best of bad choices. And at least one study has found that when management preannounces a deal it results in lower premiums presumably because it scares off other bidders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b9db15d-fa47-3b9e-b9db-a95909097368",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who commands or orders"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34b50926-e018-31fc-92ad-6f1eda7aaf58",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who asks or invites"
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aab5a96-515d-327b-98f7-82db39505e6a",
                                        "entry_id": "71a6a6b2-b05e-36b3-95ef-18c8dbc30766",
                                        "glosses": [
                                            "One who begs"
