                        "entry_id": "0cdca371-c352-37d0-aa8b-91515d38335d",
                        "glosses": [
                            "die Bewegung des Springers beim Schach – zwei Felder gerade in eine Richtung und ein Feld zur Seite"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c81fd700-3b39-41b3-9dcf-94573b954d97",
                                "sense_id": "c050768a-60b4-3833-bfa5-651100e439b6",
                                "text": "Mit dem Rösselsprung darf der Springer als einzige Schachfigur andere Figuren überspringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "679f14da-065d-3e28-9190-3cff1e141078",
                        "entry_id": "0cdca371-c352-37d0-aa8b-91515d38335d",
                        "glosses": [
                            "Silben- oder Buchstabenrätsel, wobei sich die Lösung durch aufeinanderfolgende Rösselsprünge^([1]) ergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b72e94-80ad-4704-af69-8277395ca8f4",
                                "sense_id": "679f14da-065d-3e28-9190-3cff1e141078",
                                "text": "Rösselsprung mag ich nicht so gerne, Silbenrätsel und Vexierbild finde ich spannender."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
