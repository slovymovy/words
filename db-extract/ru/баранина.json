                        ]
                    },
                    {
                        "translation_id": "ff72fd19-faa3-4f81-82be-1398fd94c523",
                        "source_entry_id": "b8122ff3-5a4d-3935-ae9c-809d1c034a8f",
                        "source_sense_description": "мясо барана или овцы, употребляемое в пищу",
                        "target_lang_word": "Hammelfleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hammelfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                        "entry_id": "6ba6c3df-b9c7-3cd2-8d5c-c8b8c099dd28",
                                        "glosses": [
                                            "das zubereitete oder zur Zubereitung vorgesehene Fleisch vom Hammel"
                                        ],
                                        "tags": [
                                            "Nahrungsmittel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50a5aac-9106-4a11-a85f-69c70ab37af7",
                                                "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                                "text": "Vielen Leuten schmeckt Hammelfleisch nicht besonders gut."
                                            },
                                            {
                                                "example_id": "63ab2a46-c949-4667-bc16-ac1849244dcb",
                                                "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                                "text": "„Wir bekommen Mittagessen, ausgezeichnetes gebratenes Hammelfleisch und ausgezeichnete Suppe, hinterher bekommen wir sogar delikate Piroggen.“"
                                            },
                                            {
                                                "example_id": "0ef4be09-ab01-4a5d-a238-55d1d8bab4fc",
                                                "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                                "text": "„Die blonden Männer machen es sich gemütlich, froh, dass am Wochenende doch keine Großfamilie einfällt und Hammelfleisch in Schnellkochtöpfen mitbringt.“"
                                            },
                                            {
                                                "example_id": "30acfb98-ca0c-413b-a5bf-2a84cf8ae749",
                                                "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                                "text": "„Biwakfeuer entzündeten sie nicht, um sich zu wärmen, sondern um Hammelfleisch an Spießen zu garen.“"
                                            },
                                            {
                                                "example_id": "e139056d-ccd3-4f1d-a063-c0143af779b7",
                                                "sense_id": "7e490945-3aa2-30dc-975b-287fb54bcec0",
                                                "text": "„Nun wurde Hammelfleisch, Rührei, ein Samowar, Schnaps und Wein gebracht, den Wein hatten die Franzosen einem russischen Keller entnommen und mitgebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0a929c9-a535-4ce6-a68b-e7638e06bbc6",
