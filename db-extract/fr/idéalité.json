        "fr-extract.jsonl": [
            {
                "entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                "word": "idéalité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2a41d867-ee53-44fa-8384-d85751e3f48d",
                        "entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "tags": [
                            "plural"
                        ],
                        "form": "idéalités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3ed2597-c4a8-371a-9f02-24b973310044",
                        "entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "glosses": [
                            "État de ce qui est idéal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f054127d-cd9e-43b3-b9af-26aebe859326",
                                "sense_id": "e3ed2597-c4a8-371a-9f02-24b973310044",
                                "text": "En mathématique, un objet est une idéalité bien définie, obéissant à des lois internes précises."
                            },
                            {
                                "example_id": "2a039eba-2a91-4afe-9d37-eb5c563dcca2",
                                "sense_id": "e3ed2597-c4a8-371a-9f02-24b973310044",
                                "text": "Tout bien examiné, je n’ai manqué presque en rien à mes promesses de cléricature. Je suis sorti de la spiritualité pour rentrer dans l’idéalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "aa685d72-eeab-3832-9e33-3302fec5580b",
                        "entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "glosses": [
                            "Chose qui n’existe que dans l’imagination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf90f3dc-8c67-450c-b042-144256a4c17c",
                                "sense_id": "aa685d72-eeab-3832-9e33-3302fec5580b",
                                "text": "Un personnage palpable, tel qu’un Mercure, un Griffon, ou une idéalité, que l’on appelait la renommée, la discorde, etc."
                            },
                            {
                                "example_id": "b8433c81-cfbd-4362-8ff9-3abd2801f9b6",
                                "sense_id": "aa685d72-eeab-3832-9e33-3302fec5580b",
                                "text": "Les soldats se font remarquer par des ajustements singuliers et farouches comme on en prêtait dans le moyen âge aux personnages antiques, orientaux ou juifs, dont on ne connaissait pas le costume ; ils sont d’ailleurs campés avec une audace et crânerie qui font le plus heureux contraste avec l’idéalité et la mélancolie des autres figures."
                            },
                            {
                                "example_id": "0cc15f44-8557-4c91-be37-3475f1917cfc",
                                "sense_id": "aa685d72-eeab-3832-9e33-3302fec5580b",
                                "text": "De jour comme de nuit, elle briquait les deux maisons, la grande, où nous pénétrions rarement, et la vieille, la maison à vivre, avec pour idéalité les cuivres astiqués et la porcelaine de Delft des intérieurs hollandais."
                            }
                        ]
                    },
                    {
                        "sense_id": "a68473d1-e8b0-38b8-a6b3-53205a92c166",
                        "entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "glosses": [
                            "Idéalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99be71ed-19b3-49f2-9dc5-863ca5dea1cc",
                                "sense_id": "a68473d1-e8b0-38b8-a6b3-53205a92c166",
                                "text": "Parfois le poète lyrique l’emporte sur le satiriste, évoquant des figures non idéales, certes, — il est trop réaliste pour cela, — mais d’une idéalité sympathique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ab812e0-01e1-47b3-a1a7-76af1a523507",
                        "source_entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "source_sense_description": "état de ce qui est idéal",
                        "target_lang_word": "Idealität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Idealität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b076ae3-e2b7-3bab-a80c-b76ff9e34e86",
                                        "entry_id": "1784183e-3450-34ca-937c-88e67d01e355",
                                        "glosses": [
                                            "Eigenschaft (eines Sachverhalts/Konstrukts), (nur) in der Vorstellung, einer Idee entsprechend (ideal) vorhanden zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d9d368-c675-4d1d-85ce-f6dc885b68ad",
                                                "sense_id": "2b076ae3-e2b7-3bab-a80c-b76ff9e34e86",
                                                "text": "„Diese Differenz enthält die Verschiedenheit von Denken und Sein, von Idealität und Realität.“"
                                            },
                                            {
                                                "example_id": "851d8fc7-0157-45b2-a54d-9514ec0dbebf",
                                                "sense_id": "2b076ae3-e2b7-3bab-a80c-b76ff9e34e86",
                                                "text": "„Nun aber ist die Idealität nicht Etwas, das es außer und neben der Realität giebt, sondern der Begriff der Idealität besteht ausdrücklich darin, die Wahrheit der Realität zu seyn, d. h. die Realität als das gesetzt, was sie an sich ist, erweist sich selbst als Idealität.“ (Hegel, 1843)"
                                            },
                                            {
                                                "example_id": "eefda35d-8133-4e6b-ba5f-6fbf73b7f5aa",
                                                "sense_id": "2b076ae3-e2b7-3bab-a80c-b76ff9e34e86",
                                                "text": "„Kant hat gemeint und gesagt: Die Mathematik als synthetische Erkenntniß a priori ist nur möglich unter der Voraussetzung der transscendentalen Idealität, ist unmöglich unter der Voraussetzung der transscendentalen Realität des Raumes.“ (1870)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3295bfae-ab60-37b6-895c-8b81baebdadc",
                                        "entry_id": "1784183e-3450-34ca-937c-88e67d01e355",
                                        "glosses": [
                                            "die (gedankliche, idealtypische) Vorstellung davon, wie ein Ding im Idealfall aussehen soll, welche besten, geeignetsten, perfekten (idealen) Eigenschaften es haben sollte"
                                        ],
                                        "tags": [
                                            "Problemlösung",
                                            "Produktentwicklung",
                                            "TRIZ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6018f9a-4651-4163-a5d9-8760a10aa1e4",
                                                "sense_id": "3295bfae-ab60-37b6-895c-8b81baebdadc",
                                                "text": "„Die Logik der zunehmenden Idealität ist wundervoll einfach und lässt sich von jedem leicht und sofort verstehen und anwenden: Mehr Idealität heißt mehr Nutzen und weniger Kosten durch Eliminieren aller Probleme.“"
                                            },
                                            {
                                                "example_id": "df1301e8-3a62-4073-84cb-214157f346ad",
                                                "sense_id": "3295bfae-ab60-37b6-895c-8b81baebdadc",
                                                "text": "„Idealität ist definiert als „die Summe aller nützlichen Funktionen geteilt durch die Summe aller schädlichen bzw. ungewollten Funktionen eines Systems\" (Terninko et al. 1998). Das ideale System stellt eine gewünschte Funktion zur Verfügung, ohne selbst existent zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "300b9202-1e72-4f97-a350-f15120c95ba1",
                        "source_entry_id": "4ec496b5-3a20-3e45-a205-356e45185f6a",
                        "source_sense_description": "état de ce qui est idéal",
                        "target_lang_word": "ideality",
