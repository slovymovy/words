                ],
                "senses": [
                    {
                        "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                        "entry_id": "9e3c1e01-b4ea-3b83-a7fc-015f3f583af3",
                        "glosses": [
                            "Person mit fundiertem Wissen und meist auch umfangreicher persönlicher Erfahrung im Bereich des Laufens/Laufsports, die andere Menschen in diesem Bereich fachlich berät"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "d0cb43a0-55a3-414b-9a0a-b1d2f764c1cd",
                                "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                                "text": "„Der Biomechaniker und Laufberater Lee Saxby pflichtet ihm bei: ‚Mutter Natur hat den menschlichen Fuß für die Menschheit optimal konstruiert’, erklärt der Experte.“"
                            },
                            {
                                "example_id": "3b493fd7-0c41-45dd-bd8d-34d1224524ad",
                                "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                                "text": "„Hallmann hat sich als Laufberater und Lauftrainer selbstständig gemacht, Meyer hat sogar ihr eigenes Running-Unternehmen gegründet.“"
                            },
                            {
                                "example_id": "7e52299f-a75d-4a70-beac-2d26625a884b",
                                "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                                "text": "„Wenn man dann allen Laufberatern glaubt: Natürlich kein Fortschritt!“"
                            },
                            {
                                "example_id": "f2d0e7cd-9f22-4ed7-b157-26e57817f586",
                                "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                                "text": "„Fasste dann kurzerhand den Entschluss, Laufberater zu werden und ‚Natural Running‘ in Deutschland zu etablieren, einen wunderbaren Anglizismus haben wir ja schon.“"
                            },
                            {
                                "example_id": "17c755ec-9749-4112-82d9-d5ed3f4f1c70",
                                "sense_id": "4662ff79-90c5-309e-a52d-596b588f6e0a",
                                "text": "„Letzte Gelegenheit sich uns anzuschließen - immer Mittwochs um 19.00 Uhr ... Euer Laufberater“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                        "entry_id": "9e3c1e01-b4ea-3b83-a7fc-015f3f583af3",
                        "glosses": [
                            "Ratgeberbuch beziehungsweise ähnliches Medium, das fachliches Wissen über das Laufen vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37723179-640b-4a32-9d90-a439ea3b001e",
                                "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                                "text": "„Pünktlich zu den großen Laufveranstaltungen in diesem Herbst ist das neue GRR-Magazin ‚road races 2019‘ als Lesestoff und als Laufberater auf dem Markt.“"
                            },
                            {
                                "example_id": "73ddbd5d-627d-45b2-a424-b878789f6bcb",
                                "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                                "text": "„Von der ‚normalen’ Bescherung in Familie mal abgesehen, haben mir Achim Achilles und Sport-Outlet24 noch schöne Weihnachtsgeschenke gemacht…ich habe ein Bücherpaket(Laufkalender und Laufberater von Achim Achilles) und Race Compression Socks von 2XU(von Sport-Outlet24) gewonnen.“"
                            },
                            {
                                "example_id": "50365c82-69fd-4518-b684-98f1a760a029",
                                "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                                "text": "„Neben den Klassikern von Steffny oder Cierpinski (‚Meilenweit bis Marathon‚) und den ‚For ever young‚ – Schwarten des Vorderfussläufers und Fitness-Gurus Strunz (um nur mal einige wenige zu nennen), gibt es seit einiger Zeit die neuen Bestseller und Abräumer ‚Achilles Verse‘ und den ‚Achilles Laufberater‘ in den Regalen aller besseren Buchhandlungen.“"
                            },
                            {
                                "example_id": "c8e39d29-5d3f-4e91-a220-1f3bdb529680",
                                "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                                "text": "„Ebenso ärgerlich fand ich es, dass ein Text bereits wortwörtlich im Laufberater zu lesen war.“"
                            },
                            {
                                "example_id": "ff8a9d5a-6d27-4e39-b079-a4066b6798d0",
                                "sense_id": "5359e75d-ea63-3d8d-8cf0-bb247ef7e7ab",
                                "text": "„Doch bereits der Laufberater, der online genutzt werden kann, macht mehr Spaß als das Betrachten einiger Schuhe im Regal.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
