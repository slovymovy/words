                                        "entry_id": "91671f15-846f-3bcd-87a5-cba75ed0ae4d",
                                        "glosses": [
                                            "Dienstgradgruppe",
                                            "die die Dienstgrade vom Unteroffizier [1] bis zum Oberstabsfeldwebel umfasst"
                                        ],
                                        "tags": [
                                            "Bundeswehr"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "bef17a36-2cd0-3644-b2d2-a971c4077979",
                                        "entry_id": "91671f15-846f-3bcd-87a5-cba75ed0ae4d",
                                        "glosses": [
                                            "Dienstgradgruppe",
                                            "die die Dienstgrade vom Unteroffizier [1] bis zum Stabsfeldwebel umfasst"
                                        ],
                                        "tags": [
                                            "Wehrmacht"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                        "entry_id": "91671f15-846f-3bcd-87a5-cba75ed0ae4d",
                                        "glosses": [
                                            "Person, die den Dienstgrad eines Unteroffiziers innehat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83faa224-ba37-4b32-ba69-82d228aae493",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Ich bin Unteroffizier geworden.“"
                                            },
                                            {
                                                "example_id": "af19ee1c-8f0b-4a0c-8eac-c18ae8ac6323",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Der Unteroffizier ging weiter.“"
                                            },
                                            {
                                                "example_id": "0d5271ba-7d6f-4bf0-9747-1cf1167e25a6",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Ein Blick des Unteroffiziers Zache traf mich.“"
                                            },
                                            {
                                                "example_id": "ffae24cc-a6fc-43eb-a1dd-5ce878ce7fa5",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Es heißt, der Unteroffizier Stephan sei im Schützengraben von einem Schuss der feindlichen Artillerie getroffen worden.“"
                                            },
                                            {
                                                "example_id": "2f5c7e3f-425c-45b8-b9c4-fce771a1c9b8",
                                                "sense_id": "09a2c3f9-ae51-3adb-8ba3-006c19ab2449",
                                                "text": "„Einer der Offiziere und zwei der Unteroffiziere sprachen ein wenig Englisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af75667-e59c-417e-b7da-845422bffb50",
                        "source_entry_id": "8aa8d26a-9630-3af0-aa7d-58d787330a9e",
                        "source_sense_id": "7afc9f51-7a0d-3b65-b3e6-0b30929fe91c",
                        "target_lang_word": "onderofficier",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onderofficier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb72400-a6ec-3af0-8f33-b8461935fa18",
                                        "entry_id": "3e07c82a-bbde-3c93-9197-f8c80bd7e1ca",
                                        "glosses": [
                                            "een functionaris die de leiding en/of het toezicht heeft op ondergeschikten, rang tussen de gewone soldaten en de officieren in sergeant, adjudant, korporaal"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "894fe37c-6247-4cf9-9c72-0388e7d46b6f",
                                                "sense_id": "3bb72400-a6ec-3af0-8f33-b8461935fa18",
                                                "text": "Intussen groeit wel de onrust onder de zes miljoen veteranen. Zij zijn bij eerdere reorganisaties afgescheept met een fooi en kunnen door gebrek aan kennis en kunde niet aan het werk komen in de moderne Chinese economie. Deze herfst demonstreerden bijna dertigduizend verarmde veteranen op het Tiananmenplein en op acht andere plaatsen, een relatief bescheiden aantal maar in Chinese verhouding heel opmerkelijk. Onder hen: officieren en onderofficieren die hebben deelgenomen aan de oorlogen in Korea (1950-’52) en Vietnam en daar levenslange handicaps opliepen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31a9c487-65c7-457d-8c63-893f4e81bb04",
