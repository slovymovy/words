                            {
                                "example_id": "6d2d180c-0d67-46cd-9d8f-157ab27b1549",
                                "sense_id": "a068480e-dddc-3697-94ae-fd555d00a262",
                                "text": "Vanaf de uitkijktoren hadden we een prachtig uitzicht over het hele park.",
                                "translation": "From the lookout tower, we had a wonderful view over the entire park.",
                                "english": "From the lookout tower, we had a wonderful view over the entire park."
                            },
                            {
                                "example_id": "68124fa0-4a43-4fc0-9a92-3343837d264c",
                                "sense_id": "a068480e-dddc-3697-94ae-fd555d00a262",
                                "text": "De brandweer gebruikte de uitkijktoren om naar mogelijke brandhaarden te zoeken.",
                                "translation": "The fire department used the lookout tower to search for possible fire outbreaks.",
                                "english": "The fire department used the lookout tower to search for possible fire outbreaks."
                            },
                            {
                                "example_id": "d8ca15c6-9d83-4911-a744-7b14d5ea92c1",
                                "sense_id": "a068480e-dddc-3697-94ae-fd555d00a262",
                                "text": "In het midden van het bos staat een oud uitkijktorentje.",
                                "translation": "In the middle of the forest stands an old lookout tower.",
                                "english": "In the middle of the forest stands an old lookout tower."
                            }
                        ]
