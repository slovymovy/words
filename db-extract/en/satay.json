                "senses": [
                    {
                        "sense_id": "541ec0b6-274e-3138-acbd-bd61ad472f55",
                        "entry_id": "5b7a223f-e7d0-3794-822a-c7da022c00f0",
                        "glosses": [
                            "A dish made from small pieces of meat or fish grilled on a skewer and served with a spicy peanut sauce, originating from Indonesia and Malaysia."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4ae825-6f00-4f77-ba9e-c18b3e512dcf",
                                "sense_id": "541ec0b6-274e-3138-acbd-bd61ad472f55",
                                "text": "Crabbe bought sateh for all: tiny knobs and wedges of fire-hot meat on wooden skewers, to be dipped in a lukewarm sauce of fire and eaten with slivers of sweet potato and cucumber."
                            }
                        ]
                    }
                ],
                "translations": [
