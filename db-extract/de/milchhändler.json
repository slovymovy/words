                                        "glosses": [
                                            "Relatif au commerce des produits laitiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a38b1603-db6d-481c-aace-ba2b463bc822",
                                                "sense_id": "e860d96c-65f5-32ce-b665-b4752b1d7bcc",
