                                        "glosses": [
                                            "profondo interesse ad apprendere cose nuove"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b1fed1b-0dff-4901-bd14-f0f04da2fdbc",
                                                "sense_id": "a1f1b965-095a-3caf-8ae5-68aa113ef3f2",
                                                "text": "la curiosità è un forte stimolo alla conoscenza"
                                            },
                                            {
                                                "example_id": "ec7ea286-3152-47e5-8b8b-2eb6980c6432",
                                                "sense_id": "a1f1b965-095a-3caf-8ae5-68aa113ef3f2",
                                                "text": "la curiosità è la passione degli intelligenti e la tomba dei peccatori"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d33c4681-42d6-34a1-81d9-0e61cd9bf56a",
                                        "entry_id": "084e7110-a5f8-3a99-870e-6bb5155b48eb",
                                        "glosses": [
                                            "cosa o avvenimento insolito, capace di suscitare interesse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "328c6b6a-21b3-480c-98b9-9703eca5b97e",
                                                "sense_id": "d33c4681-42d6-34a1-81d9-0e61cd9bf56a",
                                                "text": "ti racconto una curiosità"
                                            },
                                            {
                                                "example_id": "dd4dbb28-9098-49a1-a99f-4b2ad8e0eeaa",
                                                "sense_id": "d33c4681-42d6-34a1-81d9-0e61cd9bf56a",
                                                "text": "sono stato ad una mostra di curiosità antiche"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ec1fcdd-48a1-304f-b39f-7bc5d2d31613",
                                        "entry_id": "084e7110-a5f8-3a99-870e-6bb5155b48eb",
                                        "glosses": [
                                            "desiderio istintivo che, non sempre buono, è diretto a cercare di vedere, ascoltare, capire e quindi scoprire cose che si reputano pressoché proprio possesso"
                                        ],
