                                        "entry_id": "eaf1ae86-4e91-32c3-8f29-02a949f48336",
                                        "glosses": [
                                            "A part, usually performed by instruments, that gives support or adds to the background in music, or adds for ornamentation; also, the harmony of a figured bass."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce47e7b-9c65-4b38-9736-92413465b181",
                                                "sense_id": "e7caa432-879a-3624-a1de-e8c788aef8e8",
                                                "text": "Brooks performed a saxophone solo on stage, with Robert as accompaniment on the bass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6235a196-fb17-3c97-b418-5ab0a3593712",
                                        "entry_id": "eaf1ae86-4e91-32c3-8f29-02a949f48336",
                                        "glosses": [
                                            "That which accompanies; something that attends as a circumstance, or which is added to give greater completeness to the principal thing, or by way of ornament, or for the sake of symmetry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af7a5ba-afab-48b2-ba49-cb00eb5540b9",
                                                "sense_id": "6235a196-fb17-3c97-b418-5ab0a3593712",
                                                "text": "A side salad is a common accompaniment to a main dish."
                                            },
                                            {
                                                "example_id": "f571d177-1522-4015-bdd9-648f7ae5c0f1",
                                                "sense_id": "6235a196-fb17-3c97-b418-5ab0a3593712",
                                                "text": "forecasting torrential rain, with an accompaniment of crashing thunder."
                                            },
                                            {
                                                "example_id": "56c4f8b5-a4be-4e10-be3c-32b994deb9f7",
                                                "sense_id": "6235a196-fb17-3c97-b418-5ab0a3593712",
                                                "text": "Green sauce is the perfect accompaniment to baked fish."
                                            },
                                            {
                                                "example_id": "434a6811-ce16-47d6-81df-d369760cb7fd",
                                                "sense_id": "6235a196-fb17-3c97-b418-5ab0a3593712",
                                                "text": "My audience to this not-too-easy operation was a small group of Scottish school lasses, who seemed (perhaps naturally) to find the proceedings somewhat mysterious, but at any rate amusing. I wished they would go away, but they didn't, so I had to get on with the job to the accompaniment of a background of giggles!"
                                            }
                                        ]
                                    }
                                ]
                            }
