                                                "sense_id": "4422903d-123b-3b2f-a60f-602e966ac6e5",
                                                "text": "Die Balletttänzer wurden vom Publikum bejubelt."
                                            },
                                            {
                                                "example_id": "81c77d82-950f-45d9-83c1-82aa45c034cd",
                                                "sense_id": "4422903d-123b-3b2f-a60f-602e966ac6e5",
                                                "text": "„Das im Sommer kurzfristig gestoppte Stück über den sowjetischen Balletttänzer Rudolf Nurejew soll nun im Dezember Premiere feiern, so der Direktor des Opernhauses, Wladimir Urin, am Freitag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
