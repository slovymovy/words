                                        "examples": [
                                            {
                                                "example_id": "e1286f08-817a-481e-b7e8-34452bb977b3",
                                                "sense_id": "23ef7af9-1a10-3579-aa26-2fc268536eca",
                                                "text": "You need to lengthen the story if you want to have it published."
                                            },
                                            {
                                                "example_id": "573d63b3-80e1-4a7d-ac43-ca02fd121302",
                                                "sense_id": "23ef7af9-1a10-3579-aa26-2fc268536eca",
                                                "text": "The platforms of all stations from Shepherds Bush to Liverpool Street have been lengthened from 325 ft. to 427 ft. between tunnel headwalls, to take longer trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a532ec92-8636-389d-b72c-6a0236630e0c",
                                        "entry_id": "19fb3c18-7b73-3173-ba7d-9c4a8e212334",
                                        "glosses": [
                                            "To become longer."
