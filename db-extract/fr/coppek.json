                "senses": [
                    {
                        "sense_id": "611f68f5-645e-3816-b8d4-494e920acca9",
                        "entry_id": "138f683c-2785-3363-8527-813401c6bfe1",
                        "glosses": [
                            "Orthographe ancienne de kopeck, centième du rouble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02fd6cc-9048-4d65-9203-75326cbf8b15",
                                "sense_id": "611f68f5-645e-3816-b8d4-494e920acca9",
                                "text": "Non ! non !… Bàrine…, Excellence, Votre Grâce… attendez un moment… ajoutez… ajoutez un « petit-cinquante… », rien que cinquante coppeks, rien que cela, milenki !…"
                            },
                            {
                                "example_id": "bf99b009-dc9d-4d52-a25b-f2fbba440c2d",
                                "sense_id": "611f68f5-645e-3816-b8d4-494e920acca9",
                                "text": "Et voulez-vous savoir l’humble vérité ? c’est qu’à l’heure qu’il est, je ne prêterais pas un coppek sur votre signature !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44540098-f5d7-4f7c-909a-0d78d9e58812",
                        "source_entry_id": "138f683c-2785-3363-8527-813401c6bfe1",
                        "source_sense_id": "611f68f5-645e-3816-b8d4-494e920acca9",
