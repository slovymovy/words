                        "hartelijk"
                    ],
                    "common_phrases": [
                        "lauwe reactie",
                        "lauw ontvangst"
                    ],
                    "target_lang_definitions": {
                        "en": "reacting with little enthusiasm or indifference"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lukewarm",
                                "target_lang_sense_clarification": "unenthusiastic about a proposal or idea"
                            },
                            {
                                "target_lang_word": "tepid",
                                "target_lang_sense_clarification": "exhibiting little passion or eagerness"
                            },
                            {
                                "target_lang_word": "half-hearted",
                                "target_lang_sense_clarification": "without enthusiasm or energy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf8f00ca-d953-31ae-8dc1-af70cfc569e4",
                    "sense_definition": "leuk, prettig of ontspannen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat was echt een <w>lauwe</w> film die we gisteravond hebben gezien.",
                            "target_lang_translations": {
