                            {
                                "target_word": "carbonic acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                        "entry_id": "c157204e-a66c-39c1-815a-f5e6f98a886e",
                                        "glosses": [
                                            "A weak unstable acid, H₂CO₃, known only in solution, and as carbonate salts; it is present in carbonated drinks, and sparkling wine, but decomposes to form carbon dioxide and water."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab2d291-a863-4f86-93c1-60414e402d02",
                                                "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                                "text": "Had she lived now, she would have talked of the last delightful lecture on gas, or the charming new treatise on carbonic acid; she would have studied German, and delighted in the society of \"talented people.\""
                                            },
                                            {
                                                "example_id": "8325054d-7497-498e-83d9-a390e59f33ce",
                                                "sense_id": "4056af02-1dfd-3a25-8c14-06aae39fe59e",
                                                "text": "[I]t sank down through the air and poured over the ground in a manner rather liquid than gaseous, abandoning the hills, and streaming into the valleys and ditches and water-courses even as I have heard the carbonic acid gas that pours from volcanic clefts is wont to do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd3d95e9-6111-3a7f-8f23-286582e97ece",
                                        "entry_id": "c157204e-a66c-39c1-815a-f5e6f98a886e",
                                        "glosses": [
                                            "Carbon dioxide."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "060371f2-de42-4bc4-a42f-4fbdc7d94557",
                        "source_entry_id": "9cd35953-b950-33ba-b6c0-c8d86447abaf",
                        "source_sense_id": "9e2e3ade-c05c-31aa-8604-51e7caa6c774",
