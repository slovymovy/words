                        "glosses": [
                            "A bird that is kept confined in a cage."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "c8b1b3e2-9170-4a1c-8e67-e8bd281088f4",
                                "sense_id": "6828b424-a42a-3008-a086-6d4e68cf6aea",
                                "text": "Am I as a child perhaps, chasing a flown cageling, who among the branches free plays and peeps at the offered cage?"
                            },
                            {
                                "example_id": "3d332002-d270-4c0a-a826-aafc77de3f08",
                                "sense_id": "6828b424-a42a-3008-a086-6d4e68cf6aea",
                                "text": "Semmacherib says that he cooped up King Hezekiah of Judah in Jerusalem like a cageling."
                            }
                        ]
                    }
