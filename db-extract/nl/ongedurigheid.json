                        "glosses": [
                            "het onrustige verlangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c914c7-58a5-45bf-b454-edc764f26f80",
                                "sense_id": "63509a5d-4416-33e8-bbe0-77951a161d42",
                                "text": "Rondom Kerstmis; ongedurigheid en verveling van Natasja vanwege de afwezigheid van vorst Andrej."
                            },
                            {
                                "example_id": "6d35b2d2-0aa7-4dbe-b27e-441c6c789804",
                                "sense_id": "63509a5d-4416-33e8-bbe0-77951a161d42",
                                "text": "Wij doen dat overigens niet om te provoceren. Het is meer een bepaalde ongedurigheid in combinatie met een sterk verlangen naar elkaar. De omgeving is daar niet altijd gelukkig mee. Men durft er zelden iets van te zeggen, maar de chagrijnige blikken spreken over het algemeen boekdelen."
                            }
                        ]
                    }
