                                    {
                                        "sense_id": "87a1a25d-24e6-3a7c-a5f1-fe6074e82123",
                                        "entry_id": "208e9d18-b1ba-31be-8bec-d2386b05ec7b",
                                        "glosses": [
                                            "derde persoon enkelvoud en meervoud, versterkte vorm van zich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a734771a-47ec-4906-b662-1b2b5d756879",
                                                "sense_id": "87a1a25d-24e6-3a7c-a5f1-fe6074e82123",
                                                "text": "Hij bekeek zichzelf in de spiegel."
                                            },
                                            {
                                                "example_id": "8fc14f0c-3fdd-47b2-944f-c29c3c436001",
                                                "sense_id": "87a1a25d-24e6-3a7c-a5f1-fe6074e82123",
                                                "text": "In de garage stonden honderden resupplydozen met voedsel die hikers aan zichzelf hadden gestuurd."
                                            },
                                            {
                                                "example_id": "65cd51c1-9e22-4ce3-b919-6e55345d16cb",
                                                "sense_id": "87a1a25d-24e6-3a7c-a5f1-fe6074e82123",
                                                "text": "Antimateriehypernuclei: Antihyperhelium-4 bestaat uit een mix van antimaterieversies van protonen, neutronen en deeltjes die hyperonen worden genoemd. Hyperonen zijn op zichzelf al exotisch, omdat ze een of meer quarks van het ‘vreemde’ type bevatten. Deze ‘vreemdheid’ is moeilijk te vinden en moeilijk te maken. Daarom begrijpen onderzoekers nog steeds niet helemaal hoe hyperonen zich gedragen in de natuur, waar ze vermoedelijk voorkomen in exotische omgevingen zoals het binnenste van neutronensterren, zegt Dönigus. Bovendien blijven er vragen bestaan over hoe antimaterieversies van deze en andere deeltjes op elkaar reageren."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ba18f6-17b9-34a2-9f05-1464daccd2f5",
                                        "entry_id": "208e9d18-b1ba-31be-8bec-d2386b05ec7b",
                                        "glosses": [
                                            "tweede persoon enkelvoud en meervoud beleefdheidsvorm, versterkte vorm van zich"
                                        ],
                                        "tags": [],
                                        "examples": [
