                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "glosses": [
                            "immers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1f5b6ab-1797-4481-8213-ec16a222af52",
                                "sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                                "text": "Het is tenslotte bijna vrijdag."
                            },
                            {
                                "example_id": "26aeed36-f014-4d8f-9a0e-76f0ae18b350",
                                "sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                                "text": "Water is tenslotte het allerbelangrijkste onder de felle zon."
                            },
                            {
                                "example_id": "e29a80cc-53a3-4264-ab28-2340b52349bc",
                                "sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                                "text": "Alle anderen bij de bouw wisten tenslotte dat hij Noors was — hoezeer hij zich ook had verzweedst, zoals ze deze mengtaal hadden genoemd onder de spoorwegarbeiders op de Hardangervidda, zodra hij zijn mond opende wist je meteen dat hij Noors was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2987a93c-8be0-4da3-90bc-11b71dbd51e0",
                        "source_entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "source_sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "source_sense_description": "immers",
                        "target_lang_word": "endlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                        "entry_id": "69ce36dc-0766-3a17-8bf5-5f0aa0c5aeb5",
                                        "glosses": [
                                            "ein Ende habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8c58f9d-f5bb-4b99-bd2c-834c85b4446b",
                                                "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                                "text": "Das Universum ist sehr groß, aber endlich."
                                            },
                                            {
                                                "example_id": "83eb3800-4559-498f-a376-1a081679de57",
                                                "sense_id": "4ddc2f28-8165-3404-995b-5f4cd1e1c6b6",
                                                "text": "Dieser Nachbar zieht demnächst um, und dass bedeutet, wir haben hier ein endliches Problem. Das wird sich von alleine lösen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "endlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                        "entry_id": "5d80ad31-f1ab-3b0a-81fd-255ec5c90518",
                                        "glosses": [
                                            "am Ende, nach langer Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "223fe09c-5b08-4858-be21-f49b84603f03",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "„Das 20. Jahrhundert brachte für Frauen erheblich verbesserte Bildungsmöglichkeiten; außerdem wurde im Jahr 1920 durch einen Zusatzartikel zur Verfassung endlich in allen Bundesstaaten das Frauenwahlrecht eingeführt.“"
                                            },
                                            {
                                                "example_id": "f09159c5-6c93-4dc0-a4c7-6befef4a6ab1",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "Nach vielen Jahren des Wartens war es endlich soweit."
                                            },
                                            {
                                                "example_id": "6c31fec5-f29a-4ce7-b19f-62f876fbee27",
                                                "sense_id": "ea3c2f7e-556a-3ff4-821e-c6664b4130e5",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                        "entry_id": "5d80ad31-f1ab-3b0a-81fd-255ec5c90518",
                                        "glosses": [
                                            "doch noch (heiß ersehnt)"
                                        ],
                                        "tags": [
                                            "mit Nachdruck und Gefühlen verbunden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22dbfd52-4da1-4ad4-b982-34ecf17039e2",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "Na, endlich kommst Du!"
                                            },
                                            {
                                                "example_id": "7a49b80f-b2af-4b13-8e5b-b5714626c4ed",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "Na, endlich! Was dauert das denn hier so lange!"
                                            },
                                            {
                                                "example_id": "7eb6787b-2e4e-4fbd-b5ea-8f573b72e684",
                                                "sense_id": "47f103a0-7147-381c-ac58-363dd4ee0089",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98404f96-4d99-49a9-a4c1-4cb11348beb8",
                        "source_entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "source_sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "source_sense_description": "immers",
                        "target_lang_word": "after all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "after all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                        "entry_id": "62d83ea2-ba00-3c5a-949f-ce8840cd6bc6",
                                        "glosses": [
                                            "anyway, in any case; indicates a statement is true regardless of other considerations; used to reinforce or explain a point."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb6b3e36-d59e-42c3-bae3-a186d736c214",
                                                "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                                "text": "After all, they never come home for Christmas."
                                            },
                                            {
                                                "example_id": "5d7b4a6b-6183-428e-a38f-0372fa533592",
                                                "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                                "text": "Of course he won't give you credit. After all, his first and last concern is his company's profit margin."
                                            },
                                            {
                                                "example_id": "7b169dd7-0b9d-47b4-8ec5-86bda3126302",
                                                "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                                "text": "“What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all.—I consider it as one of the first refinements of polished societies.”"
                                            },
                                            {
                                                "example_id": "8af59d14-c233-4e44-9dec-968e29941b43",
                                                "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                                "text": "After all, it is undeniable that the B.R. standard coach scored highly in comparative trials with other European railway vehicles on the Continent a few years ago, so that B.R. civil engineers must share responsibility for any defects in its behaviour over here."
                                            },
                                            {
                                                "example_id": "1ae89a3b-62e7-49e1-9c63-c5c48ddbd7d3",
                                                "sense_id": "d97bd5f7-4e4a-30f8-bca5-0abc62e9d004",
                                                "text": "8 Jan 2020, Felicity Cloake in The Guardian, How to make the perfect gluten-free chocolate brownies – recipe\nI’d prefer to keep things straightforward and stick in the lovely, tasty yolks, too. After all, there’s no such thing as too rich when it comes to brownies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1805bf4f-c541-33ab-b27f-3057ca623783",
                                        "entry_id": "62d83ea2-ba00-3c5a-949f-ce8840cd6bc6",
                                        "glosses": [
                                            "in the end, however; used in referring to something that was believed to be the case, but is not; or to an outcome that is not what was expected or predicted."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71822740-3b23-4adb-9eff-913272600147",
                                                "sense_id": "1805bf4f-c541-33ab-b27f-3057ca623783",
                                                "text": "They won't be coming home for Christmas after all."
                                            },
                                            {
                                                "example_id": "ff98cea1-56cc-4698-beb6-51bb03a72820",
                                                "sense_id": "1805bf4f-c541-33ab-b27f-3057ca623783",
                                                "text": "Then the idea returned to her that, after all, her son might not be innocent in the Ellen matter—and this was so interesting that she felt bound to get as near the truth as she could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d982034d-a378-342e-acbf-b5d1546fb3d4",
                                        "entry_id": "62d83ea2-ba00-3c5a-949f-ce8840cd6bc6",
                                        "glosses": [
                                            "Introduces information that supports the preceding statement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318ea090-ba46-4caf-96de-7b5ff9587081",
                                                "sense_id": "d982034d-a378-342e-acbf-b5d1546fb3d4",
                                                "text": "Of course he's coming to the party. After all, he did promise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b166c0e-8654-4b30-8beb-bd9b66a5792e",
                        "source_entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "source_sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "source_sense_description": "immers",
                        "target_lang_word": "en somme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en somme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                        "entry_id": "aa5bad64-c9a7-3adb-b333-5247b550b85b",
                                        "glosses": [
                                            "Enfin ; en résumé ; pour conclusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed59203b-436b-4121-a876-425942756cd5",
                                                "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                                "text": "C’était en somme, avec sa peau blanche, sa haute taille et ses larges épaules, un fort beau cavalier dans l’acception ordinaire du mot, […]."
                                            },
                                            {
                                                "example_id": "f18159bd-5545-4314-a8cd-d0cbc8715c21",
                                                "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "0222d70c-0afc-49be-b0a9-40a00859167f",
                                                "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            },
                                            {
                                                "example_id": "112d9efa-764b-4160-b435-9902b2b1055b",
                                                "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                                "text": "[…] ; Saint-Nicolas est devenue une petite ville fort proprette, mais en somme, peu intéressante, […]."
                                            },
                                            {
                                                "example_id": "16ffbfd7-b6ab-41d0-acd1-1e37949b054e",
                                                "sense_id": "7f714eaa-7f81-3e34-aece-3d97337dd98f",
                                                "text": "On dira sans doute que cela n’est pas particulier à notre ville et qu’en somme tous nos contemporains sont ainsi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9bb7ec1-b67e-4a8d-93ad-7fe25e8ab2ad",
                        "source_entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "source_sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "source_sense_description": "immers",
                        "target_lang_word": "en effet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en effet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc9bff12-ed16-3ded-ad55-39085e27f3a1",
                                        "entry_id": "c815db86-801e-3538-b866-a1fb73bd3b08",
                                        "glosses": [
                                            "Réellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8e6d41b-59cf-4717-99de-ad0a83da0e22",
                                                "sense_id": "fc9bff12-ed16-3ded-ad55-39085e27f3a1",
                                                "text": "Ces symptômes correspondent sans doute à des lésions du myocarde ou du péricarde qui ont été constatées en effet quelquefois."
                                            },
                                            {
                                                "example_id": "3316b8f3-48cb-4bf3-94d0-94c20f5d81d2",
                                                "sense_id": "fc9bff12-ed16-3ded-ad55-39085e27f3a1",
                                                "text": "Pendant la longue durée de son administration il avait amassé une fortune considérable, si considérable, en effet, qu’un jour le gouvernement chérifien jugea le moment venu de s’en emparer."
                                            },
                                            {
                                                "example_id": "7e12bade-671b-48f5-97fa-50892c1260de",
                                                "sense_id": "fc9bff12-ed16-3ded-ad55-39085e27f3a1",
                                                "text": "Le fait divers, en effet, comme le téléshopping (le merveilleux téléshopping !) est un promoteur d’objets. D’un objet anonyme il va faire une star. À l’inanimé il va donner une âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a769ee65-fc28-31e0-baa9-678434c32d6b",
                                        "entry_id": "c815db86-801e-3538-b866-a1fb73bd3b08",
                                        "glosses": [
                                            "Au commencement d’une phrase, est le plus souvent synonyme de car et annonce qu’on va donner une preuve de ce qu’on vient de dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb52f83a-b866-429e-8260-d139ce514ede",
                                                "sense_id": "a769ee65-fc28-31e0-baa9-678434c32d6b",
                                                "text": "Il maintient que telle chose est : en effet, peut-on en douter après tant d’expériences ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05f6e6c6-3d12-3f75-82d7-440be626d123",
                                        "entry_id": "c815db86-801e-3538-b866-a1fb73bd3b08",
                                        "glosses": [
                                            "Marque la confirmation, assurément, oui."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bd33f34-d46b-42ce-9456-44772a1a53e1",
                        "source_entry_id": "f27e5a63-67ae-3d28-97ea-5be6d16b0de4",
                        "source_sense_id": "a0674e3b-9c2d-3f4f-a894-5f4724acbd65",
                        "source_sense_description": "immers",
                        "target_lang_word": "en fin de compte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en fin de compte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                        "entry_id": "19a0cfab-5294-331a-8df5-9eafca7c9ce9",
                                        "glosses": [
                                            "Tout bien considéré ; après tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7dac867-bd1a-40a7-b2f9-b51193abb78f",
                                                "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                                "text": "Il […] se résolut, en fin de compte, quand les fruits seraient mûrs, à profiter d’un jour où son ennemi serait en tournée quelque part, dans le finage, pour mettre à sac son potager et ses arbres, […]."
                                            },
                                            {
                                                "example_id": "62406de0-6900-4397-af9e-6403338dc52c",
                                                "sense_id": "bd1059f7-71e8-3c46-aaea-a0835be7b179",
                                                "text": "Voir que même fuité ça passait crème, ça valait pour autorisation. En fin de compte le rapport entre le risque que je prenais et l'effet réel pour la boîte, était assez minable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                        "entry_id": "19a0cfab-5294-331a-8df5-9eafca7c9ce9",
                                        "glosses": [
                                            "Finalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864c8c3d-003f-4102-9269-1eb9f25db5a8",
                                                "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                                "text": "L’espèce entière dépendait de ces méticulosités, en fin de compte."
                                            },
                                            {
                                                "example_id": "eefbdec4-2827-40bc-889c-fc0683486ee9",
                                                "sense_id": "2572f544-2281-36da-a310-a2dd325671a3",
                                                "text": "En fait, l'assurance va marcher, en fin de compte. Tout est couvert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
