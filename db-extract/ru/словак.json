                ],
                "senses": [
                    {
                        "sense_id": "6ed4ba47-76f3-3ba0-a9d6-d6ddc016df74",
                        "entry_id": "eac933e0-d540-3956-b9c8-3ee83ac9b1a6",
                        "glosses": [
                            "житель, гражданин или уроженец Словакии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de857898-b861-401f-972f-709505863931",
                                "sense_id": "6ed4ba47-76f3-3ba0-a9d6-d6ddc016df74",
                                "text": "— Жили у себя [беженцы], так же как и мы, какие ни есть, а избу имели — и пригородные бабы приносили ребятам тряпьё и, жалея молодых словаков в австрийских мундирах, приносили хлеб."
                            },
                            {
                                "example_id": "2747534e-4167-4252-ad0d-88532619b645",
                                "sense_id": "6ed4ba47-76f3-3ba0-a9d6-d6ddc016df74",
                                "text": "Корпусу из военнопленных чехов и словаков, сформированному в 1917 г. для военных действий на стороне Антанты, советское правительство разрешило вернуться на родину через Владивосток."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48ccb6ea-4615-41ea-8bc6-f8c4ff260fd5",
                        "source_entry_id": "eac933e0-d540-3956-b9c8-3ee83ac9b1a6",
                        "source_sense_id": "6ed4ba47-76f3-3ba0-a9d6-d6ddc016df74",
                        "target_lang_word": "Slowake",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Slowake",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "511a9f5d-2244-36ca-8015-50121982cc77",
                                        "entry_id": "6c3284b8-5701-396e-acf6-4dffbcabb106",
                                        "glosses": [
                                            "Staatsbürger der Slowakei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3a9db1f-fdcc-411a-a118-0c20f3a06eb0",
                                                "sense_id": "511a9f5d-2244-36ca-8015-50121982cc77",
                                                "text": "Im Frühjahr war ein Slowake bei uns zu Gast."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9626f74-1f9d-3cff-9f7c-c38e35bf1c09",
                                        "entry_id": "6c3284b8-5701-396e-acf6-4dffbcabb106",
                                        "glosses": [
                                            "Angehöriger des Volks der Slowaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a33fa8e-2e18-424e-9611-44f2eeab4b49",
                                                "sense_id": "d9626f74-1f9d-3cff-9f7c-c38e35bf1c09",
                                                "text": "„Es sind vor allem zwei große geschichtliche Verknotungen, die Tschechen und Deutsche – von den Slowaken war bis ins 20. Jahrhundert hinein keine Rede, und was man später die Slowakei nannte, hieß bis 1918 Oberungarn – gegeneinander hetzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
