                ],
                "senses": [
                    {
                        "sense_id": "a7dce4c5-eeb6-375d-9afa-ccd823f973fd",
                        "entry_id": "f2c3b945-4694-34e9-8283-c67cf61e5a9e",
                        "glosses": [
                            "elk van de buiten de kern van het atoom gelegen elementaire deeltjes, het lichtste deeltje met een elektrische negatieve lading"
                        ],
                        "tags": [
                            "deeltjesfysica"
                        ],
                        "examples": [
                            {
                                "example_id": "54043f2a-9cd0-461e-896a-663744a6a3e9",
                                "sense_id": "a7dce4c5-eeb6-375d-9afa-ccd823f973fd",
                                "text": "De elektronen kunnen lading doorgeven."
                            },
                            {
                                "example_id": "d99760ca-8a54-46cd-9577-717222449f90",
                                "sense_id": "a7dce4c5-eeb6-375d-9afa-ccd823f973fd",
                                "text": "Recordbrekende antimaterie: Antimaterie is de tegenhanger van ‘gewone’ materie. Van elk elementair materiedeeltjestype bestaat een antimaterieversie die in veel opzichten erop lijkt, maar het spiegelbeeld is. Zo is het anti-elektron (of positron) net zo zwaar als het elektron maar heeft het een positieve lading in plaats van een negatieve."
                            }
                        ]
                    },
                    {
                        "sense_id": "b086c2e8-7e5c-30b2-83ab-fa23bd401cc2",
                        "entry_id": "f2c3b945-4694-34e9-8283-c67cf61e5a9e",
                        "glosses": [
                            "witte magnesiumlegering met aluminium, zink, koper, mangaan en silicium, lichter dan aluminium"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a02330b-e5d9-4b22-a241-d78c0433e954",
                        "source_entry_id": "f2c3b945-4694-34e9-8283-c67cf61e5a9e",
                        "source_sense_id": "a7dce4c5-eeb6-375d-9afa-ccd823f973fd",
                        "source_sense_description": "een van de elementaire deeltjes, het lichtste deeltje met een elektrische lading",
                        "target_lang_word": "Elektron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                        "entry_id": "5a95e9d3-d919-316c-b57d-c2af9cc9381b",
                                        "glosses": [
                                            "negativ geladenes Elementarteilchen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e6fcc0-2a9d-4b6f-abc2-c92f71893f95",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "Ein Atom des Heliums besitzt zwei Elektronen."
                                            },
                                            {
                                                "example_id": "b68618f6-9d52-4a23-9781-fb930ae9caf1",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Früher hatte man jedes Atom für ein Sonnensystem im kleinen gehalten, das aus einem Kern bestand, der von kreisenden Elektronen umgeben war und die Sphärenharmonie in mikroskopischem Maßstab widerspiegelte.“"
                                            },
                                            {
                                                "example_id": "5e843e31-420e-4356-ab44-eaf7ba8d5fce",
                                                "sense_id": "74315e74-3344-377a-b02e-df1c7acdf717",
                                                "text": "„Weder gibt es einen Plus- noch einen Minuspol, sondern nur ein Gefälle von geladenen Teilchen wie Elektronen oder Ionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
                                        "entry_id": "5a95e9d3-d919-316c-b57d-c2af9cc9381b",
                                        "glosses": [
                                            "eine Legierung aus Gold und Silber"
                                        ],
                                        "tags": [
                                            "Betonung nur auf der 2. Silbe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c222caa9-c826-4e6c-a8ce-43943b46a428",
                                                "sense_id": "65f3d67b-6c69-32e0-b3f2-a896fb27e3cf",
                                                "text": "Ursprünglich hielt man Elektron für ein eigenständiges Metall."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "993b189a-79f2-44e8-af8c-efaadb110eba",
                        "source_entry_id": "f2c3b945-4694-34e9-8283-c67cf61e5a9e",
                        "source_sense_id": "a7dce4c5-eeb6-375d-9afa-ccd823f973fd",
