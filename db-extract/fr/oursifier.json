                        "entry_id": "d1cf4d94-9be5-3e4b-b293-0137e9b4f083",
                        "glosses": [
                            "Prendre un caractère d’ours, s’isoler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a80d317-869e-4154-8b32-880339caaef9",
                                "sense_id": "bdc34e9e-810a-3188-b09f-5a9e119fb3bd",
                                "text": "Vraiment pas envie de m’oursifier moi décidément."
                            },
                            {
                                "example_id": "5aa3166f-6e10-42bf-8849-b6bb0a3d8fa4",
                                "sense_id": "bdc34e9e-810a-3188-b09f-5a9e119fb3bd",
                                "text": "Je m’oursifie et m'assombris de plus en plus — et ce qui se passe dans la capitale n'est pas fait pour m’égayer."
                            },
                            {
                                "example_id": "d0b94aef-40d1-4c45-b06d-ca5723645457",
                                "sense_id": "bdc34e9e-810a-3188-b09f-5a9e119fb3bd",
                                "text": "On marche, on tourne, on s’oursifie."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3fba668-1bb1-30af-a704-e79160647244",
                        "entry_id": "d1cf4d94-9be5-3e4b-b293-0137e9b4f083",
                        "glosses": [
                            "Hiberner comme un ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc359122-fd31-447a-818b-55f25f5efc4b",
                                "sense_id": "a3fba668-1bb1-30af-a704-e79160647244",
                                "text": "Pour passer le printemps sans rien faire, il suffit de s’oursifier."
                            }
                        ]
