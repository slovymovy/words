                        ],
                        "examples": [
                            {
                                "example_id": "c5aac0a9-4460-48b4-b2b4-7c7ef8fe6185",
                                "sense_id": "dc347591-8998-3dbb-b99d-0ca62ec4962d",
                                "text": "In Zembla noemt hoogleraar Milieukunde Lucas Reijnders stookolie voor zeeschepen een ‘zinkput voor alle rotzooi die ze bedacht hebben, een heksenbrouwsel’."
                            },
                            {
                                "example_id": "76972ea0-345d-4823-8ae4-cb737173cb4a",
                                "sense_id": "dc347591-8998-3dbb-b99d-0ca62ec4962d",
                                "text": "Ze zouden per saldo geen extra koolstof opslaan of afgeven. Nu dat wel gebeurt, functioneren de bossen als 'zinkput'voor koolstof die elders door de verbranding van fossiele brandstoffen vrijkomt."
                            }
                        ]
                    }
