            {
                "entry_id": "e878a7af-664c-36b6-9391-ee676496001e",
                "word": "compendium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c3c03729-0dd2-4dba-980b-f6192643a165",
                        "entry_id": "e878a7af-664c-36b6-9391-ee676496001e",
                        "tags": [
