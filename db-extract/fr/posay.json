                        "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                        "entry_id": "8f5fccc5-9ac6-3488-8ded-04abf3c9b2f1",
                        "glosses": [
                            "Variante de posé ; qui est dans un contexte relax, une ambiance détendue, sans stress et ce pour un temps donné."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "fe5497f9-e79b-44fa-9e8a-bb5dfe398afb",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "Reprise des stream posay sur dofus comme a l'ancienne y'a 4 ans ;)"
                            },
                            {
                                "example_id": "1a3f52a6-c65c-47a0-832e-ec449a722d51",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "Ah oui ça je me souviens, t’étais au bout du rouleau là bas… :/ mais la ils m’ont juste scié. Le pire c que ds mon tarif j’ai droit à un bagage soute que j’utilise même pas. A 2 doigts de lui payer un siège adulte à son nom pr qu’elle soit posay à côté de moi pr le même prix !!"
                            },
                            {
                                "example_id": "eea8eb46-3242-41a0-b2ef-e41415a4aa76",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "J'ai fini par trouver une image d'exemple. Donc ma chatte fait comme ça. Tout le temps. Même quand elle est juste posay et qu'elle dort pas."
                            },
                            {
                                "example_id": "8ef58550-c247-4074-9427-ce7dd287b672",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "Toujours en live tranquille et posay sur LoL ;)"
                            },
                            {
                                "example_id": "150ab53b-4ef0-43f4-a484-11ea572feaef",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "J'ai trop prouver mes sentiments a certaine qui font trop le malin , mtn je reste posay ."
                            },
                            {
                                "example_id": "c8456db4-bd32-4a99-b76a-44f3b2f5b824",
                                "sense_id": "558c8982-ee8e-3d82-b7f9-bd535e5d423a",
                                "text": "Et bien, salut à toutes et à tous. C’est Hugo, chuis posay comme d’habitude."
                            }
                        ]
                    }
