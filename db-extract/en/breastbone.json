                        "entry_id": "5917f5da-31c8-325e-9ff0-08d39d60901d",
                        "glosses": [
                            "The central narrow bone in the front of the chest, connecting the collarbone and the top ribs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a39a2c6-6d79-4519-8072-9c359f730562",
                                "sense_id": "1afcec09-6b1e-38f1-ab6c-4da8ed981d6b",
                                "text": "He lapped out of his hand, then sat up in the sunlight, crossing his shins in front of him, and after a time let his woolly head fall on his breastbone."
                            }
                        ]
                    }
