                                    {
                                        "sense_id": "1eaa7996-321c-3c13-bbe0-fbf7f2774b5e",
                                        "entry_id": "9d94b5fc-4bac-3a69-8808-3d50b2262b47",
                                        "glosses": [
                                            "Manière de prononcer correctement un mot dans une langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a16992-99e2-4bbd-9e37-0b8f39801b37",
                                                "sense_id": "1eaa7996-321c-3c13-bbe0-fbf7f2774b5e",
                                                "text": "L’auteur reconnaît dans toute grammaire moderne six parties : l’orthographe, l’étymologie, la syntaxe, la ponctuation, la prosodie et l’orthoépie (recta dictio), qui n’est autre chose que la prononciation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1ccab0-f680-3cc4-8154-764630ff2714",
                                        "entry_id": "9d94b5fc-4bac-3a69-8808-3d50b2262b47",
                                        "glosses": [
                                            "Étude de la prononciation correcte des mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9de1331-8a70-4851-a20e-0268e9f384a8",
                                                "sense_id": "3e1ccab0-f680-3cc4-8154-764630ff2714",
                                                "text": "L'histoire de cette orthoépie du latin au XVIᵉ siècle est encore mal connue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0aedee32-d857-4471-96e4-3539f7c90fd9",
                        "source_entry_id": "89aefa8a-7aef-3f40-9e24-dfa2d153f12b",
                        "source_sense_description": "study of pronunciation",
                        "target_lang_word": "Orthoepie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Orthoepie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                        "entry_id": "1237a20d-3043-33ac-a5d7-3e0e4f9dd500",
                                        "glosses": [
                                            "normgerechte Aussprache, Lautung; korrekte Standardlautung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a15f4b-8092-4494-91be-47bfea6f9143",
                                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                                "text": "Mit Orthoepie ist eine genormte Standardlautung (Standardaussprache) gemeint, die frei ist von regionalen Einflüssen."
                                            },
                                            {
                                                "example_id": "da39a7d1-8376-40ea-a6f3-39719d0c9e0a",
                                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                                "text": "„Die Orthoepie dient nicht nur ästhetischen Zwecken (vgl. Goethes »Regeln für Schauspieler« 1803), sondern vor allem kommunikativen und sprachökonomischen Zwecken.“"
                                            },
                                            {
                                                "example_id": "dfb44b1c-d9d7-4919-a01d-45bdb4b3e9f5",
                                                "sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                                                "text": "„Die Orthographie und die Orthoepie sind zwar strenger kodifiziert als die anderen sprachlichen Ebenen, doch kann auch in diesen Bereichen, zum Beispiel bei der Eindeutschung von Fremdwörtern (…), die zeitliche, mitunter sogar die räumliche Dimension einer Veränderung beobachtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
