                    },
                    {
                        "translation_id": "1c9af8d6-4e39-4a29-913e-4757f67c6ff2",
                        "source_entry_id": "48d4ec4a-1ff8-3cd5-9e5a-96bcaa901e92",
                        "source_sense_description": "цепляя, навесить на что-либо, закрепить на чём-либо",
                        "target_lang_word": "anhängen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anhängen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8652d517-ef8f-3462-a634-12fd18a4ccd1",
                                        "entry_id": "d53b473a-0984-303c-a9bc-82bd48e251cc",
                                        "glosses": [
                                            "etwas haftet an jemandem, lastet auf jemandem (für einen langen Zeitraum)"
                                        ],
                                        "tags": [
                                            "etwas hängt an jemandem"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6b55c8a-5b6b-47da-8c6b-a5b09c8dc41f",
                                                "sense_id": "8652d517-ef8f-3462-a634-12fd18a4ccd1",
                                                "text": "„So ging es auch mir; und was ich da hörte, hing mir noch lange an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1942eab6-f151-3971-936f-9e13d9af93d6",
                                        "entry_id": "d53b473a-0984-303c-a9bc-82bd48e251cc",
                                        "glosses": [
                                            "Anhänger einer Person, Ideals, Gruppe sein"
                                        ],
                                        "tags": [
                                            "jemandem",
                                            "etwas anhängen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4402da7f-d2bf-40ef-bc2c-a6bee2aba746",
                                                "sense_id": "1942eab6-f151-3971-936f-9e13d9af93d6",
                                                "text": "„Er war nicht aktiv bei der Resistance, hat viel zu lang den Kommunisten angehangen, nun fühlt er sich ständig an der Front.“"
                                            },
                                            {
                                                "example_id": "459779c3-d22c-48b3-a732-6d0e4f3d2514",
                                                "sense_id": "1942eab6-f151-3971-936f-9e13d9af93d6",
                                                "text": "„Da sie wie der Vater der Quäkersekte anhing, verwarf sie die Autorität der heiligen Texte ebenso wie die der papistischen Kirche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1e4d62a4-8d8a-313d-9f1a-5dda73a9924a",
                                        "entry_id": "d53b473a-0984-303c-a9bc-82bd48e251cc",
                                        "glosses": [
                                            "beim Erhitzen am Boden des Kochgeschirrs haften bleiben"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "005e302c-5c09-4919-bd6a-c43a61bc1320",
                                                "sense_id": "1e4d62a4-8d8a-313d-9f1a-5dda73a9924a",
                                                "text": "Durch ständiges Rühren kannst du verhindern, dass der Grießbrei anhängt."
