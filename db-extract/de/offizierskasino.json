                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce06e95f-6cb5-344c-a799-23d41e0e4d76",
                                        "entry_id": "4d2d0976-3d9c-3522-9a1d-7e1743c23159",
                                        "glosses": [
                                            "To belong to a mess."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e764f844-837f-3a84-acae-a83370297902",
                                        "entry_id": "4d2d0976-3d9c-3522-9a1d-7e1743c23159",
                                        "glosses": [
                                            "To eat (with others)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e19bd72-97cc-4796-9e83-3df1a5c62924",
                                                "sense_id": "e764f844-837f-3a84-acae-a83370297902",
                                                "text": "Resolved 18. That no Guide or Interpreter whether at the Factory Depot or Inland be permitted to mess with Commissioned Gentlemen or Clerks in charge of Posts; but while at the Depot they will be allowed per Week 4 days ordinary rations..."
                                            },
                                            {
                                                "example_id": "2fb40c79-bf26-4c45-ac2c-855313361f7e",
                                                "sense_id": "e764f844-837f-3a84-acae-a83370297902",
                                                "text": "I mess with the wardroom officers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6de31b0-7521-30a7-9e0c-b42de34a727a",
