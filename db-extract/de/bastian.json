                            {
                                "example_id": "a38ab82b-02d3-47a9-b1ab-823c788871a5",
                                "sense_id": "b59185fd-98ca-38c2-9e45-23370f2db313",
                                "text": "Bastian bringt montags immer den Müll raus."
                            },
                            {
                                "example_id": "33943054-dbeb-4ee1-9d4a-e792b73c94a7",
                                "sense_id": "b59185fd-98ca-38c2-9e45-23370f2db313",
                                "text": "„Geräuschlos war Bastian eingetreten und servierte das Paprikahuhn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
