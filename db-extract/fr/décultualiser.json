                ],
                "senses": [
                    {
                        "sense_id": "9621d886-09d8-39a2-b682-8eb0d7bc74c6",
                        "entry_id": "c0878c72-b3d3-3f16-964a-9117d052dddc",
                        "glosses": [
                            "Faire perdre son caractère cultuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ca43942-c17a-4928-b07a-498810916df2",
                                "sense_id": "9621d886-09d8-39a2-b682-8eb0d7bc74c6",
                                "text": "Toute fondation religieuse désacralise autant qu’elle sacralise, disqualifie des divinités anciennes dans le moment même où elle qualifie une divinité nouvelle, décultualise en même temps qu’elle recultualise."
                            },
                            {
                                "example_id": "da26ac2a-603f-47aa-a551-0069f4a271d1",
                                "sense_id": "9621d886-09d8-39a2-b682-8eb0d7bc74c6",
                                "text": "L’Association Zen Internationale (AZI) créée par ce moine japonais a ainsi développé un bouddhisme conçu comme une sagesse décultualisée, adaptée à la vie de l’occidental moderne urbain."
                            },
                            {
                                "example_id": "ee671d26-f81b-4f62-92e0-c6d3b90cfe84",
                                "sense_id": "9621d886-09d8-39a2-b682-8eb0d7bc74c6",
                                "text": "La société ne doit-elle pas se « décultualiser » ?"
                            }
                        ]
                    }
                ],
