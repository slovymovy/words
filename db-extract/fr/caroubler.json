                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793fbea3-176e-4f65-b4b2-d5536db8879a",
                                "sense_id": "4a2eca4e-b41f-3eb4-aac8-07d8934d09b1",
                                "text": "J’ai pas l’intention de me salir les pognes à te caroubler jusqu’à ce que tu me dises où il est…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e496bca8-966e-3673-bb13-ebe009fa501f",
                        "entry_id": "e73ac8f0-bae8-3d85-b00d-39cbc33a1e86",
                        "glosses": [
                            "Verrouiller."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "26c33dc4-3021-417c-92e5-c8ce3d80c7f9",
                                "sense_id": "e496bca8-966e-3673-bb13-ebe009fa501f",
                                "text": "C’est d’ailleurs une réelle nouveauté : le changement radical est en mesure d’émerger par le système électoral, pourtant bien caroublé, et en accepte le principe y compris dans ses discours les plus révolutionnaires."
                            }
                        ]
