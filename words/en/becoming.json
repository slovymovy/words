{
    "word_family": [
        "become",
        "unbecoming",
        "becomingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "24f68a12-101d-38f1-8e77-01843fabe856",
                    "sense_definition": "Present participle and gerund of <w>become</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather is <w>becoming</w> colder as winter approaches.",
                            "target_lang_translations": {
                                "ru": "Погода <w>становится</w> холоднее с приближением зимы.",
                                "zh": "随着冬天的临近，天气正<w>变得</w>越来越冷。"
                            }
                        },
                        {
                            "text": "She is interested in <w>becoming</w> a doctor after she graduates.",
                            "target_lang_translations": {
                                "ru": "Она заинтересована в том, чтобы <w>стать</w> врачом после окончания учебы.",
                                "zh": "她毕业后有兴趣<w>成为</w>一名医生。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола \"become\" (становиться).",
                        "zh": "动词 become 的现在分词和动名词形式，表示“变成”、“成为”。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становиться",
                                "target_lang_sense_clarification": "переходить в другое состояние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变得",
                                "target_lang_sense_clarification": "表示状态或性质的转变"
                            },
                            {
                                "target_lang_word": "成为",
                                "target_lang_sense_clarification": "表示转变为某种身份或职业"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "94d166a0-39bb-3ddc-bf8b-b2cf7125bd19",
                    "sense_definition": "Enhancing the appearance of someone; attractive and suitable.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new hairstyle is very <w>becoming</w> on you.",
                            "target_lang_translations": {
                                "ru": "Эта новая прическа тебе очень <w>идет</w>.",
                                "zh": "那个新发型对你来说非常<w>好看</w>。"
                            }
                        },
                        {
                            "text": "She wore a <w>becoming</w> blue dress to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела на вечеринку <w>идущее ей</w> голубое платье.",
                                "zh": "她穿着一件很<w>相称的</w>蓝色连衣裙去参加聚会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flattering",
                        "attractive",
                        "fetching"
                    ],
                    "antonyms": [
                        "unbecoming"
                    ],
                    "common_phrases": [
                        "very becoming",
                        "becoming on someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делающий внешность более привлекательной; подходящий, идущий к лицу.",
                        "zh": "（尤指衣着、发型等）相称的，好看的，适合某人外表的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идущий к лицу",
                                "target_lang_sense_clarification": "об одежде или прическе"
                            },
                            {
                                "target_lang_word": "к лицу",
                                "target_lang_sense_clarification": "в значении сказуемого: подходит к внешности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相称的",
                                "target_lang_sense_clarification": "与容貌、外表相搭配且好看"
                            },
                            {
                                "target_lang_word": "好看的",
                                "target_lang_sense_clarification": "适合并增添美感"
                            },
                            {
                                "target_lang_word": "适合的",
                                "target_lang_sense_clarification": "穿戴合衬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbb281e5-48f8-375c-a558-c16ae6bd6536",
                    "sense_definition": "Appropriate, proper, or suitable for a particular situation or person.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suitability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is not <w>becoming</w> for a leader to panic in a crisis.",
                            "target_lang_translations": {
                                "ru": "Лидеру не <w>подобает</w> паниковать в кризисной ситуации.",
                                "zh": "领导者在危机中惊慌失措是极不<w>得体的</w>。"
                            }
                        },
                        {
                            "text": "He behaved with a dignity <w>becoming</w> his rank.",
                            "target_lang_translations": {
                                "ru": "Он вел себя с достоинством, <w>подобающим</w> его званию.",
                                "zh": "他表现出了与其级别相<w>称的</w>尊严。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appropriate",
                        "fitting",
                        "proper",
                        "suitable"
                    ],
                    "antonyms": [
                        "unbecoming"
                    ],
                    "common_phrases": [
                        "becoming behavior",
                        "becoming conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уместный, правильный или подходящий для конкретной ситуации или человека.",
                        "zh": "合宜的，得体的，符合身份或场合的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подобающий",
                                "target_lang_sense_clarification": "соответствующий статусу или морали"
                            },
                            {
                                "target_lang_word": "приличествующий",
                                "target_lang_sense_clarification": "уместный, достойный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "得体的",
                                "target_lang_sense_clarification": "言行举止合乎礼仪或规范"
                            },
                            {
                                "target_lang_word": "合宜的",
                                "target_lang_sense_clarification": "符合特定身份或情境"
                            },
                            {
                                "target_lang_word": "相称的",
                                "target_lang_sense_clarification": "与地位、身份匹配"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6eaa6d0-9861-3b9e-907f-5405b8044047",
                    "sense_definition": "The process of coming into existence or changing into a new state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher discussed the concept of being versus <w>becoming</w>.",
                            "target_lang_translations": {
                                "ru": "Философ обсуждал концепцию бытия в противовес <w>становлению</w>.",
                                "zh": "哲学家探讨了“存在”与“<w>生成</w>”的概念对立。"
                            }
                        },
                        {
                            "text": "Life is a constant process of <w>becoming</w> rather than a fixed state.",
                            "target_lang_translations": {
                                "ru": "Жизнь — это постоянный процесс <w>становления</w>, а не застывшее состояние.",
                                "zh": "生活是一个不断<w>演变</w>的过程，而不是一种固定的状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "transformation",
                        "development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс возникновения или перехода в новое состояние.",
                        "zh": "（哲学等语境中）生成，演变，形成的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "становление",
                                "target_lang_sense_clarification": "процесс развития"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生成",
                                "target_lang_sense_clarification": "哲学术语，指事物产生与变化的过程"
                            },
                            {
                                "target_lang_word": "演变",
                                "target_lang_sense_clarification": "发展变化的过程"
                            },
                            {
                                "target_lang_word": "形成",
                                "target_lang_sense_clarification": "事物逐步塑造成型的过程"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}