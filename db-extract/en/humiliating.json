                "senses": [
                    {
                        "sense_id": "8f53210a-5f79-34eb-9070-e43936c102da",
                        "entry_id": "fe092266-33e9-3a88-b70a-ad03c8927368",
                        "glosses": [
                            "Liable to humiliate, degrade, shame or embarrass someone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "394cd8a2-b57e-4e72-8d6c-d5962a77151c",
                                "sense_id": "8f53210a-5f79-34eb-9070-e43936c102da",
                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite. There is something humiliating about it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce251534-3b11-49e3-86d1-c463645556c2",
                        "source_entry_id": "fe092266-33e9-3a88-b70a-ad03c8927368",
                        "source_sense_id": "8f53210a-5f79-34eb-9070-e43936c102da",
