                    "sense_definition": "A motorcycle with a sidecar attached.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They toured the countryside on a vintage motorcycle <w>combination</w>.",
                            "target_lang_translations": {
                                "ru": "Они путешествовали по сельской местности на старинном <w>мотоцикле с коляской</w>.",
                                "zh": "他们骑着一辆复古的<w>边三轮摩托车</w>在乡间游览。"
