                ],
                "senses": [
                    {
                        "sense_id": "21462829-491b-3a41-9078-1c858a4e9114",
                        "entry_id": "100d6e39-883a-3b58-a27f-b0d4ca3765d2",
                        "glosses": [
                            "Herd, der mit Kohle befeuert werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e707d05c-b818-4c8c-b484-7ecbf2eec72a",
                                "sense_id": "21462829-491b-3a41-9078-1c858a4e9114",
                                "text": "„Auf dem guten alten Kohleherd wurden die Mahlzeiten mühevoll zubereitet.“"
                            },
                            {
                                "example_id": "a017354c-7e12-46ad-a727-11ecc3aa3c2d",
                                "sense_id": "21462829-491b-3a41-9078-1c858a4e9114",
                                "text": "„In die Brennkammer des alten Kohleherds hatte einer der letzten Bewohner einen Ölbrenner eingebaut, wann das letzte Mal Feuer unter den gusseisernen Ofenringen gebrannt hatte, war dennoch schwer zu sagen.“"
                            },
                            {
                                "example_id": "0f795c15-9f63-4d42-92bf-48252fa8ec61",
                                "sense_id": "21462829-491b-3a41-9078-1c858a4e9114",
                                "text": "„Sie saß immer in der Küche neben dem Kohleherd, eingemummelt in lange Röcke, mit einer Decke um die Schultern und einem Kopftuch auf dem Kopf. Der Kohleherd brannte immer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
