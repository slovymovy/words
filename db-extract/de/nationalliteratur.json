                "senses": [
                    {
                        "sense_id": "dcce8859-d0ac-3a51-96a1-28986b146004",
                        "entry_id": "f13467d4-1ede-3cca-871e-529034005ba6",
                        "glosses": [
                            "Gesamtheit der literarischen Werke in einer Nationalsprache und/oder einer Nation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06b3d7d-fb31-4ac5-909b-51b8aad2d851",
                                "sense_id": "dcce8859-d0ac-3a51-96a1-28986b146004",
                                "text": "„Auf unserem Globus gibt es eben sehr viele Länder mit sehr vielen Büchern, die alle um Aufmerksamkeit konkurrieren und in die enge Pforte weltweiter, kultureller Anerkennung drängen; da hilft es natürlich, die eigene Nationalliteratur mit dem nötigen Geld und einem weitgespannten Netz von Institutionen zu fördern.“"
                            },
                            {
                                "example_id": "611f8d78-3c8c-4fce-bee4-bbc3f3cf3b9e",
                                "sense_id": "dcce8859-d0ac-3a51-96a1-28986b146004",
                                "text": "„Die deutsche Nationalliteratur formierte sich im späten 18. Jahrhundert. Dieser Prozess fällt in die Zeit der Aufklärung und in die Epoche der Empfindsamkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
