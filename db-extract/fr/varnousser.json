                ],
                "senses": [
                    {
                        "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                        "entry_id": "27ecc475-e701-3d56-b6ed-88dec11f14d7",
                        "glosses": [
                            "Vaquer à ses occupations sans se presser."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "06073321-5dc2-4d71-90ee-2f5780721757",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Méo est déjà descendu. On peut l'entendre varnousser dans la cuisine. Il se verse sans doute une tasse de thé fort …"
                            },
                            {
                                "example_id": "2d246739-da71-483a-947a-5fbefa0ed1f3",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Alors, tu vas varnousser et zigonner... mais n'oublie pas de bizouner!"
                            },
                            {
                                "example_id": "9e0bce7d-a405-4c55-8d50-4c6b34eaced8",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Mais c'est pas sortable deworre pour varnousser."
                            },
                            {
                                "example_id": "9da13e1d-50e2-466d-a4f5-2ac3c7eb67ba",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Le lendemain, je suis resté à varnousser près de la maison, je n'osais pas m'éloigner."
                            },
                            {
                                "example_id": "d5be9f53-73c4-4959-aac8-31dd66efb9f4",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Il aime varnousser (ou vernoucher), c'est-à-dire « s'activer lentement », picorer, transporter."
                            },
                            {
                                "example_id": "e560ab22-9125-46ca-84c1-b8e2b77106ee",
                                "sense_id": "031a6906-7474-351e-a7b5-83986202b75e",
                                "text": "Le verbe « varnousser», c'est un vieux mot français, vernoucher, qui veut dire s'activer lentement."
                            }
                        ]
                    }
                ],
