                        "examples": [
                            {
                                "example_id": "20183812-bdbc-43c6-a0fb-60a92ab39723",
                                "sense_id": "fba222aa-f72e-3ca6-9797-267bd7c920c0",
                                "text": "Roe v. Wade was preceded by all those moments that make a movement: tentative and explosive sharings in kitchens and CR groups; times of great courage and stillness, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "44136b65-b0d5-3e5e-98ca-9c53bfe7b225",
                        "entry_id": "d67a813d-561d-35a3-a1e1-da27bd9f96a4",
