                "senses": [
                    {
                        "sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                        "entry_id": "45ae9855-89e1-3528-a696-a86470b9255d",
                        "glosses": [
                            "spontaniczne powstawanie życia z materii nieożywionej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb4998d-457f-4e20-9763-5a223782a5ee",
                                "sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                                "text": "Pierwszym krokiem obalającym teorię arystotelowskiej abiogenezy było wykazanie przez Włocha Francesco Rediego w 1668, że robaki obserwowane w gnijącym mięsie nie powstają samoistnie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07fca070-00d6-4622-81e7-d76dbb71fb48",
                        "source_entry_id": "45ae9855-89e1-3528-a696-a86470b9255d",
                        "source_sense_id": "bf332d4d-ed52-37d9-8c0f-3aa0670691fe",
                        "target_lang_word": "abiogenèse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abiogenèse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                        "entry_id": "ea71e191-6c73-37f5-8ec8-11160167d621",
                                        "glosses": [
                                            "Ensemble des théories expliquant l'émergence de la vie à partir de matière inorganique inanimée."
                                        ],
                                        "tags": [
                                            "Astrobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78a07cb-84ed-45ac-80f4-18c2fc282a46",
                                                "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                                "text": "Les biologistes d’aujourd'hui sont dans leur très grande majorité des tenants de l’abiogenèse."
                                            },
                                            {
                                                "example_id": "70b7e5b0-e347-4483-b37a-2b52c45c26ff",
                                                "sense_id": "be2c76d9-662e-3ab9-9bca-fa06f8914ce3",
                                                "text": "Ainsi, il n’est pas exclu que, si les événements qui ont conduit à la vie terrestre sont extrêmement rares, peu importe qu’il y ait des centaines de milliards d’étoiles dans des milliards de galaxies, les nombreux systèmes stellaires seraient insuffisants, statistiquement, pour donner lieu à l’abiogenèse ailleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aab468dc-50df-4b15-8a9e-0c9190b500eb",
