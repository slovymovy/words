                ],
                "senses": [
                    {
                        "sense_id": "550f875d-43a7-3dfe-9dba-5d94bc2bd283",
                        "entry_id": "b316607b-a1f2-3667-9810-e6eb88c68c3b",
                        "glosses": [
                            "Tür, die den Zugang zum Cockpit ermöglicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664e53ae-af8d-4965-ba25-eb3080462a82",
                                "sense_id": "550f875d-43a7-3dfe-9dba-5d94bc2bd283",
                                "text": "„Gerade noch hatten die Passagiere auf eine baldige Ankunft in Winnipeg gehofft, da sahen sie den Piloten gegen die Cockpittür hämmern, weil er sie nicht mehr aufbekam.“"
                            },
                            {
                                "example_id": "20330d15-ba43-4c8b-9da9-aa31f1654b43",
                                "sense_id": "550f875d-43a7-3dfe-9dba-5d94bc2bd283",
                                "text": "„Das gilt laut Thier für den Großteil der Flugzeuge – nämlich solche, in denen der Pilot ohne aufzustehen über eine Kamera sehen kann, wer vor der Cockpittür steht.“"
                            },
                            {
                                "example_id": "580ea299-ccbf-475b-ba37-0329037ac553",
                                "sense_id": "550f875d-43a7-3dfe-9dba-5d94bc2bd283",
                                "text": "„Die neue Cockpittür soll die Piloten vor ungebetenen Gästen schützen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
