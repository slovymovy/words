{
    "word_family": [
        "textual",
        "texting",
        "textbook",
        "textless",
        "context",
        "subtext",
        "hypertext",
        "plaintext"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4110d150-6e52-3754-b4f6-cb87e27bb671",
                    "sense_definition": "A piece of writing consisting of characters, symbols, or sentences.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "written_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please read the <w>text</w> on page twenty and answer the questions.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте <w>текст</w> на двадцатой странице и ответьте на вопросы."
                            }
                        },
                        {
                            "text": "The <w>text</w> of the document was translated into five different languages.",
                            "target_lang_translations": {
                                "ru": "<w>Текст</w> документа был переведен на пять разных языков."
                            }
                        }
                    ],
                    "common_phrases": [
                        "read the text",
                        "written text",
                        "original text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменная работа, состоящая из символов, знаков или предложений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "письменный отрывок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bb8089f-a43c-309b-8375-54f051dcdd68",
                    "sense_definition": "A brief written message sent between mobile phones.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "messaging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I received a <w>text</w> from my brother saying he will be late.",
                            "target_lang_translations": {
                                "ru": "Я получил <w>сообщение</w> от брата о том, что он задержится."
                            }
                        },
                        {
                            "text": "She forgot to send a <w>text</w> to confirm the meeting time.",
                            "target_lang_translations": {
                                "ru": "Она забыла отправить <w>СМС</w>, чтобы подтвердить время встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "message",
                        "SMS"
                    ],
                    "common_phrases": [
                        "send a text",
                        "receive a text",
                        "get a text"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used as a shortened form of text message"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое письменное сообщение, отправляемое между мобильными телефонами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сообщение",
                                "target_lang_sense_clarification": "передаваемое сведение"
                            },
                            {
                                "target_lang_word": "СМС",
                                "target_lang_sense_clarification": "короткое текстовое сообщение"
                            },
                            {
                                "target_lang_word": "эсэмэска",
                                "target_lang_sense_clarification": "разговорное название СМС"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab3aac9b-fa4e-3b10-befb-3848a677308d",
                    "sense_definition": "A book or other set of writings, especially one used for study.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "written_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor assigned a new <w>text</w> for the history seminar.",
                            "target_lang_translations": {
                                "ru": "Профессор назначил новый <w>учебник</w> для семинара по истории."
                            }
                        },
                        {
                            "text": "Students must purchase the required <w>text</w> before the first day of class.",
                            "target_lang_translations": {
                                "ru": "Студенты должны приобрести необходимый <w>текст</w> до первого дня занятий."
                            }
                        }
                    ],
                    "common_phrases": [
                        "required text",
                        "standard text",
                        "classical text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга или другой набор сочинений, используемый специально для обучения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учебник",
                                "target_lang_sense_clarification": "книга для учебы"
                            },
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "материал для изучения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81d2f022-c004-36e7-ae42-cb79980ccf8c",
                    "sense_definition": "Data that can be interpreted as human-readable characters rather than binary code.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer program converts the raw data into plain <w>text</w>.",
                            "target_lang_translations": {
                                "ru": "Компьютерная программа преобразует необработанные данные в обычный <w>текст</w>."
                            }
                        },
                        {
                            "text": "You should save the file as a <w>text</w> file to ensure compatibility.",
                            "target_lang_translations": {
                                "ru": "Вам следует сохранить файл как <w>текстовый</w> файл, чтобы обеспечить совместимость."
                            }
                        }
                    ],
                    "antonyms": [
                        "binary"
                    ],
                    "common_phrases": [
                        "plain text",
                        "text file",
                        "text format"
                    ],
                    "target_lang_definitions": {
                        "ru": "Данные, которые могут быть интерпретированы как человекочитаемые символы, а не бинарный код."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "текстовые данные"
                            },
                            {
                                "target_lang_word": "текстовый формат",
                                "target_lang_sense_clarification": "вид компьютерных данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3b275ba-c9e1-3c43-8fb5-34f719609f3c",
                    "sense_definition": "The subject of an argument, discussion, or literary composition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "written_content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main <w>text</w> of his argument focused on economic reform.",
                            "target_lang_translations": {
                                "ru": "Основной <w>текст</w> его аргументации был сосредоточен на экономической реформе."
                            }
                        },
                        {
                            "text": "The speaker departed from his prepared <w>text</w> to address the audience directly.",
                            "target_lang_translations": {
                                "ru": "Оратор отошел от подготовленного <w>текста</w>, чтобы обратиться к аудитории напрямую."
                            }
                        }
                    ],
                    "synonyms": [
                        "topic",
                        "theme"
                    ],
                    "common_phrases": [
                        "main text",
                        "prepared text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет спора, обсуждения или литературного произведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "содержание выступления или аргумента"
                            },
                            {
                                "target_lang_word": "тема",
                                "target_lang_sense_clarification": "предмет обсуждения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1bc4834-4538-3012-a510-dc26e1e70616",
                    "sense_definition": "A verse or passage from Scripture used as the subject of a sermon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest chose a <w>text</w> from the Gospel of Mark for his sermon.",
                            "target_lang_translations": {
                                "ru": "Священник выбрал <w>отрывок</w> из Евангелия от Марка для своей проповеди."
                            }
                        },
                        {
                            "text": "She spent hours studying the sacred <w>text</w> to understand its deeper meaning.",
                            "target_lang_translations": {
                                "ru": "Она часами изучала священный <w>текст</w>, чтобы понять его глубокий смысл."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sacred text",
                        "biblical text",
                        "scriptural text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стих или отрывок из Священного Писания, используемый в качестве темы для проповеди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текст",
                                "target_lang_sense_clarification": "отрывок из Писания"
                            },
                            {
                                "target_lang_word": "писание",
                                "target_lang_sense_clarification": "священный текст"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b931a99c-7a3e-35bc-a084-bcce179d7126",
                    "sense_definition": "To send a message to someone using a mobile phone or similar device.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "messaging_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>text</w> me when you arrive at the station.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>напиши</w> мне, когда приедешь на вокзал."
                            }
                        },
                        {
                            "text": "I will <w>text</w> the address to you so you don't get lost.",
                            "target_lang_translations": {
                                "ru": "Я <w>скину</w> тебе адрес сообщением, чтобы ты не заблудился."
                            }
                        }
                    ],
                    "synonyms": [
                        "message"
                    ],
                    "common_phrases": [
                        "text me",
                        "text the address"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить сообщение кому-либо с помощью мобильного телефона или аналогичного устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "написать",
                                "target_lang_sense_clarification": "отправить сообщение"
                            },
                            {
                                "target_lang_word": "смснуть",
                                "target_lang_sense_clarification": "отправить СМС"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7461b40-455c-35e6-847c-1ae4ed289663",
                    "sense_definition": "To engage in the activity of sending and receiving electronic messages.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "messaging_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>texting</w> during the entire movie, which was very distracting.",
                            "target_lang_translations": {
                                "ru": "Он <w>переписывался</w> на протяжении всего фильма, что очень отвлекало."
                            }
                        },
                        {
                            "text": "Stop <w>texting</w> while you are walking across the street.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>писать СМС</w>, когда переходишь улицу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stop texting",
                        "keep texting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заниматься отправкой и получением электронных сообщений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переписываться",
                                "target_lang_sense_clarification": "обмениваться сообщениями"
                            },
                            {
                                "target_lang_word": "писать СМС",
                                "target_lang_sense_clarification": "процесс отправки сообщений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}