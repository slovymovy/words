                    {
                        "translation_id": "3ebcb9b2-b6be-4ed2-8ffa-35bb28a1a828",
                        "source_entry_id": "5e1afef2-2eb7-3cc2-8da2-2d55abd9e3b4",
                        "target_lang_word": "translation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "translation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eea67686-58c0-3bd0-9a7e-ba437ef0e2c0",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Transport, action par laquelle on fait passer quelque chose d’un lieu à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70e8e2c3-9946-4206-b0ab-ea5c3678490f",
                                                "sense_id": "eea67686-58c0-3bd0-9a7e-ba437ef0e2c0",
                                                "text": "Depuis son origine jusqu'à sa translation à Metz, en vertu d’un décret du 12 février 1794, cette école a eu sept commandans en chef: […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0fbddb-47ee-3ac0-b940-9faccded087a",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Transport, action par laquelle on fait passer quelque chose d’un lieu à un autre.",
                                            "Déplacement de reliques, d'un lieu à un autre."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94806d2d-f55e-3f87-a163-f33bb2fd86da",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Glissement d’un objet sans roulement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcdbf9a7-7dfa-496c-bbce-30fe8f1bf825",
                                                "sense_id": "94806d2d-f55e-3f87-a163-f33bb2fd86da",
                                                "text": "L’adhérence de la roue sur le rail, qui agit le long du plan incliné en sens contraire du mouvement de translation, et produit la rotation de la roue en s’opposant à ce qu’elle puisse glisser sans tourner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f75107e-9fd7-3721-bb2b-f4308b1cf446",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Déplacement, transition d'un concept à un autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60cb9675-555c-4da5-bd97-d4781050c7c8",
                                                "sense_id": "6f75107e-9fd7-3721-bb2b-f4308b1cf446",
                                                "text": "En théorie, le mot révolution garde le sens qu'il a en astronomie. C'est un mouvement qui boucle la boucle, qui passe d'un gouvernement à l'autre après une translation complète."
                                            },
                                            {
                                                "example_id": "865c9380-54f5-4f8b-9ff5-b06b9d2c782d",
                                                "sense_id": "6f75107e-9fd7-3721-bb2b-f4308b1cf446",
                                                "text": "De l'avis du cardinal Villeneuve, la translation de l'individuel de l'âme au collectif de l'association coopérative ne peut pas se faire aussi aisément que le prétend le père Lévesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d6b44c9-a4e0-384a-8e22-e230046624f4",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Action de remettre un événement d’un jour à un autre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9dca1fe-035b-4b08-a40d-841bf5eaee06",
                                                "sense_id": "9d6b44c9-a4e0-384a-8e22-e230046624f4",
                                                "text": "La translation d’une fête,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e83edbde-a723-3b50-b3e1-27ba9d9d5578",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Changement de la catégorie grammaticale d'un mot en une autre catégorie grammaticale, également appelée transfert, conversion ou dérivation impropre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5fdb814-aea4-483d-b8da-e4411ee84ebb",
                                                "sense_id": "e83edbde-a723-3b50-b3e1-27ba9d9d5578",
                                                "text": "Tesnière est probablement celui qui a le plus théorisé le parallélisme entre les subordonnées et les classes de constituants syntaxiques. Il a en effet postulé le mécanisme de la translation, qui consiste à changer une catégorie grammaticale en une autre catégorie grammaticale."
                                            },
                                            {
                                                "example_id": "e95b73c5-3fc5-45ce-ab97-7ad0d23ba885",
                                                "sense_id": "e83edbde-a723-3b50-b3e1-27ba9d9d5578",
                                                "text": "Le manger, le parler, sont des translations de verbes en substantifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cfd3a1-cc9d-39f8-b019-044eba0e6857",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Traduction."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "l’utilisation dans un cadre actuel avec le sens de « traduction » est un anglicisme",
                                        "examples": [
                                            {
                                                "example_id": "6f3ce9c5-5749-4447-abd1-76c530c2c25f",
                                                "sense_id": "90cfd3a1-cc9d-39f8-b019-044eba0e6857",
                                                "text": "L’histoire a commencé, au moyen-âge, par être une traduction de la chronique latine. Les deux grands ouvrages qui portent le nom de Roman de Brut et de Roman de Rou, ne sont que des translations en vers, l’un d’une chronique, l’autre de plusieurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "845abf5e-521c-3e81-aa30-8da8ed1356eb",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Déplacement sans rotation d’une figure."
                                        ],
                                        "tags": [
                                            "Géométrie vectorielle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7581af8b-4d9a-4222-b8de-5da593823261",
                                                "sense_id": "845abf5e-521c-3e81-aa30-8da8ed1356eb",
                                                "text": "Construire l‘image d‘une figure par une translation revient à faire glisser cette figure dans une direction, un sens et avec une longueur donnée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84dbb26a-1dde-34bf-ac17-8f776be4b14c",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Mappage, mise en correspondance de données d’un type à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "486db5bb-d1ac-4d6b-b28b-dbdf5a227a4c",
                                                "sense_id": "84dbb26a-1dde-34bf-ac17-8f776be4b14c",
                                                "text": "L'outil Translation n'effectue pas de rééchantillonnage ou de déformation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39858a4a-0003-30d4-9283-372e5b97e57b",
                                        "entry_id": "7eaf3634-f850-37b0-a2c6-c0ac3458a069",
                                        "glosses": [
                                            "Transport des reliques d’un saint d’un lieu à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6dd2c9d-4ee7-48f1-805c-09dff44ed79a",
                                                "sense_id": "39858a4a-0003-30d4-9283-372e5b97e57b",
                                                "text": "La République de Krakovie […] réclama ses dépouilles mortelles, pour les déposer à côté de celles de Jean Sobieski, de Joseph Poniatowski et de Thadée Kosciuszko ; mais une force majeure empêcha cette translation nationale."
                                            },
                                            {
                                                "example_id": "4e715c45-cc74-466d-8b54-75e10e1a8489",
                                                "sense_id": "39858a4a-0003-30d4-9283-372e5b97e57b",
                                                "text": "Le goût des Espagnols pour ces sortes de solennités est si connu qu’il ne doit pas être difficile de croire aux féeries religieuses par lesquelles l’abbaye de San-Lucar célébra la translation du bienheureux don Juan Belvidéro dans son église."
                                            },
                                            {
                                                "example_id": "a6806550-35a2-4538-af9d-0582f07cc3b2",
                                                "sense_id": "39858a4a-0003-30d4-9283-372e5b97e57b",
                                                "text": "L'acte de cette reconnaissance ayant reçu l'approbation de Mgr l'évêque d'Arras, on fit solennellement la translation de cette chasse de l'église de Canlers, où elle avait été provisoirement déposée , dans celle de Ruisseauville, où elle fut placée, en présence d'un nombreux concours de fidèles , sur les gradins du maitre-autel."
                                            },
                                            {
                                                "example_id": "3e566186-a591-4c07-a217-0ac98a88c12a",
                                                "sense_id": "39858a4a-0003-30d4-9283-372e5b97e57b",
                                                "text": "La translation du corps de l’évêque myroblyte, de Myre à Bari où il repose depuis le 9 mai 1087, n'a pas interrompu le précieux charisme, le tombeau de saint Nicolas n'a point cessé d'être glorieux, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
