                    {
                        "translation_id": "7894c7fe-1a31-4e36-a9b9-da0558a7f8c3",
                        "source_entry_id": "60e8f35c-2b16-39d8-be1c-579e7d27aa6f",
                        "source_sense_id": "196421e1-1dad-33aa-b413-ea271e8c09e3",
                        "source_sense_description": "a drunken reveler",
                        "target_lang_word": "Bacchant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bacchant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "02e087ed-e2c0-398e-8ce2-94f44d9c1001",
                                        "entry_id": "c9f43282-c231-3366-bc7e-4b034b27babc",
                                        "glosses": [
                                            "sagenhafter Teilnehmer an einer Orgie (ausschweifende Feier) des Weingottes Dionysos, der sich in eine Raserei steigert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85526ce7-63f5-456f-93ab-6eb48f85ba03",
                                                "sense_id": "02e087ed-e2c0-398e-8ce2-94f44d9c1001",
                                                "text": "„Die Tanzsprünge gehen in ein Hüpfen über, als wolle sich da ein Bacchant in die Schar des Dionysos einreihen.“"
                                            },
                                            {
                                                "example_id": "a83cfed6-4bd4-49db-9767-4ba700934530",
                                                "sense_id": "02e087ed-e2c0-398e-8ce2-94f44d9c1001",
                                                "text": "„Die temporäre, durch Tanz oder Droge erzeugte Raserei war in der Antike (etwa bei den Bacchanten) und ist noch heute bei vielen Urvölkern eine Methode zwischen den Realitäten der Sinne und der Seele zu reisen.“"
                                            },
                                            {
                                                "example_id": "4469caec-4ebd-446f-b5c0-0f20ed177d97",
                                                "sense_id": "02e087ed-e2c0-398e-8ce2-94f44d9c1001",
                                                "text": "„Sein Gefolge besteht aus Naturdämonen wie Nymphen, Satyrn, Silenen und in Ekstase versetzten Anhängern, den Bacchanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99cb0aec-e590-3d51-83ed-25fe86225b83",
                                        "entry_id": "c9f43282-c231-3366-bc7e-4b034b27babc",
                                        "glosses": [
                                            "stark betrunkene und hemmungslos feiernde Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "377cfa5e-758b-456d-aa07-eadcf26b0668",
                                                "sense_id": "99cb0aec-e590-3d51-83ed-25fe86225b83",
                                                "text": "„Einst ruderten wir zu mehreren im Dunkeln über den See, und ich sang wie ein Bacchant in den sternenbesäten Himmel […].“"
                                            },
                                            {
                                                "example_id": "58d85125-5daa-4da6-85df-fb892a14e597",
                                                "sense_id": "99cb0aec-e590-3d51-83ed-25fe86225b83",
                                                "text": "„Die Bacchanten sangen ihr misstönendes Lied. Fred wurde mitgerissen, war dazu verdammt, sich auch zu drehen und allmählich in Ekstase zu versetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "46be2b0e-7de8-39a8-8380-722a44cd1cbc",
                                        "entry_id": "c9f43282-c231-3366-bc7e-4b034b27babc",
                                        "glosses": [
                                            "herumziehender Schüler, Student"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baf15778-d43b-48da-b78e-26f4dbd929d7",
                                                "sense_id": "46be2b0e-7de8-39a8-8380-722a44cd1cbc",
                                                "text": "„Als Bacchant oder älterer fahrender Schüler unterrichtete er wie Tausende seines Gleichen kleine Schützen […].“"
                                            },
                                            {
                                                "example_id": "0d50d8e7-df6b-4ecb-9f6d-84fefbc2611c",
                                                "sense_id": "46be2b0e-7de8-39a8-8380-722a44cd1cbc",
                                                "text": "„Es sind auf einmal in der Stadt, wie man sagte, etliche tausend Bacchanten und Schüler gewesen, die sich alle vom Almosen ernährten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
