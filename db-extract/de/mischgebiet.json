                "senses": [
                    {
                        "sense_id": "2d8443ed-71e7-33ab-a8b1-f60e5764db68",
                        "entry_id": "308ad709-f65d-325a-a552-df7b6c5f1f64",
                        "glosses": [
                            "Baugebiet, das sowohl gewerblich-industriell als auch als Wohnraum genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f135d3-8390-430a-b98d-f379b3617d65",
                                "sense_id": "2d8443ed-71e7-33ab-a8b1-f60e5764db68",
                                "text": "„Laut Bebauungsplan liegt die Schulstraße im Mischgebiet.“"
                            },
                            {
                                "example_id": "d1f47162-1648-47df-b317-c0e6d5126d9a",
                                "sense_id": "2d8443ed-71e7-33ab-a8b1-f60e5764db68",
                                "text": "„Es gebe für das Mischgebiet schon einen rechtskräftigen Bebauungsplan, dessen Vorgaben gälten.“"
                            },
                            {
                                "example_id": "fea65bed-27bb-4bc6-bfdd-c281b4e19f55",
                                "sense_id": "2d8443ed-71e7-33ab-a8b1-f60e5764db68",
                                "text": "„Mehrheitlich hatten sich die Gemeinderäte wiederholt für das Mischgebiet ausgesprochen, das am Ortsrand von Großhelfendorf, Richtung Grub, entstehen soll.“"
                            },
                            {
                                "example_id": "0ab7adc6-dd2d-4aff-8acf-cc5bc3ac6697",
                                "sense_id": "2d8443ed-71e7-33ab-a8b1-f60e5764db68",
                                "text": "„In einem solchen ‚urbanen Gebiet‘ soll das Nebeneinander von Wohnen und Gewerbe, anders als bislang im Mischgebiet, uneingeschränkt möglich sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
