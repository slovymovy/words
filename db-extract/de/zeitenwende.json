                ],
                "senses": [
                    {
                        "sense_id": "79c02c1e-dd1a-3e3b-9d4f-8dc1d43f2ddb",
                        "entry_id": "32bef17d-9aeb-3b20-a8c4-458b173153ec",
                        "glosses": [
                            "der Übergang/die Wende von einem für wesentlich erachteten Zeitabschnitt (Ära, Epoche, Jahrtausend, Säkulum) zum nächsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26bb9cb6-048b-46a9-9d37-0a390c82e618",
                                "sense_id": "79c02c1e-dd1a-3e3b-9d4f-8dc1d43f2ddb",
                                "text": "„Die Paläontologen knackten immer mehr Konkretionen und fanden auch Schädel von Säugern der frühesten Generation, direkt nach der geologischen Zeitenwende.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "63ec718a-495e-3c1f-ba57-8ab930322189",
                        "entry_id": "32bef17d-9aeb-3b20-a8c4-458b173153ec",
                        "glosses": [
                            "Beginn der christlichen Zeitrechnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd022d5a-479a-4f4c-abde-6643252ff599",
                                "sense_id": "63ec718a-495e-3c1f-ba57-8ab930322189",
                                "text": "„Der reich ausgestattete Band präsentiert nicht nur die Funde aus dem Römerlager und Außenposten, die teilweise bereits restauriert wurden, sondern bettet die Funde auch in die römisch-germanische Geschichte der Zeitenwende ein.“"
                            },
                            {
                                "example_id": "7f61f296-752d-4a3d-8e6a-0a5c6f014b39",
                                "sense_id": "63ec718a-495e-3c1f-ba57-8ab930322189",
                                "text": "„So viel scheint klar: Inspiriert aus dem Mittelmeerraum, mag das runische Alphabet etwa um die Zeitenwende entstanden sein.“"
                            },
                            {
                                "example_id": "ff8dffd6-2310-46da-84b9-3498fc65103f",
                                "sense_id": "63ec718a-495e-3c1f-ba57-8ab930322189",
                                "text": "„Die Latènekultur währte von etwa 450 v. Chr. bis um die Zeitenwende.“"
                            },
                            {
                                "example_id": "ac8e8dc8-44d9-4f9b-ada6-9c8ebed056a3",
                                "sense_id": "63ec718a-495e-3c1f-ba57-8ab930322189",
                                "text": "„Im 19. Jahrhundert, als die deutschen Territorien endlich vor der Vereinigung standen und noch schnell eine gemeinsame Identität suchten, kamen sie auf Hermann den Cherusker, der um die Zeitenwende herum die Römer aus Germanien geworfen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
