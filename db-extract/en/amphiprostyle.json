                                "target_senses": [
                                    {
                                        "sense_id": "80327b6e-33bf-3593-ac16-e9185edd2e1d",
                                        "entry_id": "d0fbb1d2-18a5-3fe9-b310-3f59421b7d28",
                                        "glosses": [
                                            "Temple oblong qui avait plusieurs colonnes à chaque bout."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cffc8186-d09a-4cb2-b514-2747568a426d",
                                                "sense_id": "80327b6e-33bf-3593-ac16-e9185edd2e1d",
                                                "text": "Chaque sorte de temple se distingue par la forme différente qu'il présente à notre vue. La première est le temple à antes, que les Grecs appellent ναὸς ἐν παραστάσι ; les autres sont le prostyle, l'amphiprostyle, le périptère, le pseudodiptère, le diptère, l'hypètre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amphiprostyle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "912a4571-02e6-3cfe-b3e6-d95a273f3035",
                                        "entry_id": "f290a98e-a8f3-3980-815d-d1af8c4bd9ee",
                                        "glosses": [
                                            "Qualifie ce type de temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb8a3fab-b69a-4550-880f-f3cad48c2f60",
                                                "sense_id": "912a4571-02e6-3cfe-b3e6-d95a273f3035",
                                                "text": "Ce sékos lui-même est amphiprostyle hexastyle et il est divisé en deux parties étanches adossées l'une à l'autre et précédées chacune d'un pronaos fermé par des grilles de bronze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
