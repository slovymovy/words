                                "example_id": "5e3100dd-6592-459c-a246-9175eab069c6",
                                "sense_id": "334bf907-60da-3ec2-88b4-53550df371f6",
                                "text": "Elephints a-pilin' teak / In the sludgy, squdgy creek, / Where the silence 'ung that 'eavy you was 'arf afraid to speak!"
                            },
                            {
                                "example_id": "be3be578-7bfc-484e-acc5-773214e6ab3a",
                                "sense_id": "334bf907-60da-3ec2-88b4-53550df371f6",
                                "text": "Well, I was sorry because you were cross. But being in the pond was much too good to be sorry about by itself. You've no idea how squdgy the mud is at the bottom."
                            }
                        ]
                    }
