                "senses": [
                    {
                        "sense_id": "bf010de6-f2d4-37b4-8c3d-e884cee212f1",
                        "entry_id": "2fcfa549-8eb8-3fba-ac9d-008852234523",
                        "glosses": [
                            "South Low Franconian"
