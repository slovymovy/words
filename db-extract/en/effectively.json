                                "target_senses": [
                                    {
                                        "sense_id": "a0fe5566-4987-3708-a2ba-a1de839dffc5",
                                        "entry_id": "7371139d-2522-32c2-b59f-20347a969c38",
                                        "glosses": [
                                            "ook echt plaats vindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad089d6f-a111-4c30-b10a-d94673a8a0a9",
                                                "sense_id": "a0fe5566-4987-3708-a2ba-a1de839dffc5",
                                                "text": "Na de goedkeuring en maandenlange planning kon het daadwerkelijke bouwen starten."
                                            },
                                            {
                                                "example_id": "56b5268a-4014-4c8e-be85-3e8d35a3fcfa",
                                                "sense_id": "a0fe5566-4987-3708-a2ba-a1de839dffc5",
                                                "text": "Als ik Venetië en alles wat er was gebeurd daadwerkelijk wilde vergeten, moest ik mij eerst alles zo precies mogelijk herinneren. Wie zich niet alles herinnert wat hij wil vergeten, loopt het risico dat hij bepaalde zaken vergeet te vergeten."
                                            },
                                            {
                                                "example_id": "bf9a227a-fb8a-4329-b8f4-c4e6b4a86066",
                                                "sense_id": "a0fe5566-4987-3708-a2ba-a1de839dffc5",
                                                "text": "Twee van de gemelde incidenten waren in een nachtclub, één in een café of daar in de buurt. Dat blijkt uit de aangiftes die de redactie van NOS Stories in handen heeft. Eén aangifte leidde daadwerkelijk tot een politieonderzoek waarbij camerabeelden van de betreffende club werden opgevraagd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "daadwerkelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "669369db-ebde-3df8-ad5a-78da76e47fb2",
                                        "entry_id": "0904f412-8467-3af0-ab8c-0e3dfa022a51",
                                        "glosses": [
                                            "echt plaats vindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d90d84cc-dc3c-4248-8707-71362840a725",
                                                "sense_id": "669369db-ebde-3df8-ad5a-78da76e47fb2",
                                                "text": "Je zult vast obstakels tegenkomen of het eng vinden om daadwerkelijk alleen op reis te gaan, maar dit is met tijd en planning te voorkomen."
                                            },
                                            {
                                                "example_id": "2cd876dc-ba11-4979-bd38-8bf0f6abcae5",
                                                "sense_id": "669369db-ebde-3df8-ad5a-78da76e47fb2",
                                                "text": "Als er daadwerkelijk een auto wordt weggegeven, doe ik misschien wel mee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "392a8b0e-b85b-4077-88d5-cbf409ff28ab",
                        "source_entry_id": "46cce09a-e0d3-3b71-b409-f04006fcaf0c",
                        "source_sense_description": "essentially",
                        "target_lang_word": "tatsächlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tatsächlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                        "entry_id": "418c6704-8a1f-3b8a-8ac8-f22d926425f4",
                                        "glosses": [
                                            "(manchmal auch wider Erwarten) wahrheitsgemäß, wirklich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63edba5d-01d5-42a3-937c-6f923a5eba67",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Der Dozent ist tatsächlich netter, als ich gedacht hatte."
                                            },
                                            {
                                                "example_id": "23a85b9a-954e-4785-9035-b8e5f7b2b941",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Tatsächlich ordnet sich der gegen Philipp V. ausgebrochene 2. Römisch-Makedonische Krieg in eine lange Reihe imperialistischer Übergriffe ein, die so alt waren wie die Errichtung der römischen Hegemonie über Italien.“"
                                            },
                                            {
                                                "example_id": "2aa8eebb-2ffd-4e99-8665-fb660a346f6f",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Penibel ausgearbeitete Pläne für Internierungslager und Listen mit Namen der zur Internierung vorgesehenen Systemkritiker lagen tatsächlich längst vor.“"
                                            },
                                            {
                                                "example_id": "63223d4c-359f-4340-907a-d26d6bbfedab",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "Den Einwand verstehe ich nicht, es hat doch eine tatsächliche Veränderung stattgefunden, oder nicht?"
                                            },
                                            {
                                                "example_id": "bea08c6f-2874-4137-867b-d721ae326511",
                                                "sense_id": "d37ae229-5742-38a2-b465-78e3440a8e85",
                                                "text": "„Eine tatsächliche Verständigung bleibt auch dann wirksam, wenn von den Beteiligten nicht vorhergesehene Besteuerungsfolgen eintreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
