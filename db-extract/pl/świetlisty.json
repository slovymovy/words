                                    {
                                        "sense_id": "82be3c7b-bd67-351d-ad66-e077be5627a9",
                                        "entry_id": "536cb8db-6969-365d-8a6c-a417b3e11b5c",
                                        "glosses": [
                                            "Emitting light; glowing brightly; shining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa770110-7590-49a8-8d9b-99bee4804f07",
                                                "sense_id": "82be3c7b-bd67-351d-ad66-e077be5627a9",
                                                "text": "The moon, which had been slowly ascending, now shone through an open space between the trees; and the rippling waters of the brook gave back her light in luminous vibrations."
                                            },
                                            {
                                                "example_id": "8fcffa5a-a0ef-4459-9939-3972cc6d4c80",
                                                "sense_id": "82be3c7b-bd67-351d-ad66-e077be5627a9",
                                                "text": "The bonfire in his heart made luminous the rose-tan in his cheek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d10662-85ae-3493-80f8-b39998413cd2",
                                        "entry_id": "536cb8db-6969-365d-8a6c-a417b3e11b5c",
                                        "glosses": [
                                            "Brightly illuminated."
                                        ],
