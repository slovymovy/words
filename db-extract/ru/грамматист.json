                                    {
                                        "sense_id": "f60ccb0b-7ee1-37f1-b1e3-5567224dd3f9",
                                        "entry_id": "6cea026c-ff77-37d8-b763-d5bf67c53428",
                                        "glosses": [
                                            "Gramatical."
                                        ],
                                        "tags": [],
