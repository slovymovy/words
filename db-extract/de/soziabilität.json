                    {
                        "sense_id": "66d59252-7839-319f-8b12-611db42dfa45",
                        "entry_id": "1b4ac043-1b45-3d7f-812b-552f710b4c5d",
                        "glosses": [
                            "Fähigkeit, sich sozial, also gesellschaftlichen Bedürfnissen entsprechend zu verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21b98d14-e677-403d-b8d8-21cd36ed8f02",
                                "sense_id": "66d59252-7839-319f-8b12-611db42dfa45",
                                "text": "Soziabilität kann auch eine Chance zu schädigendem Handeln sein, das heißt zur Ausbeutung der Sozialität der Mitakteure."
                            },
                            {
                                "example_id": "f1d31f32-b4ae-4e1c-bbee-3fad9e799633",
                                "sense_id": "66d59252-7839-319f-8b12-611db42dfa45",
                                "text": "„Auf diesem Wege schlage ich schließlich einige Hypothesen darüber vor, welche Muster der Soziabilität in unseren Gesellschaften im Entstehen begriffen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "979c5d2d-9bbf-3087-a699-2659abadfb6f",
                        "entry_id": "1b4ac043-1b45-3d7f-812b-552f710b4c5d",
                        "glosses": [
                            "Fähigkeit, sozial zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777b11f4-1066-4ae8-9745-0889efe9cf4c",
                                "sense_id": "979c5d2d-9bbf-3087-a699-2659abadfb6f",
                                "text": "\"Diese künstliche Menschenordnung setzt aber immer die Naturordnung voraus und vollendet sie in einer Weise. Diese Fähigkeit, sozial zu werden (bei Grotuis etwa um 1630 heißt sie \"Soziabilität\") ist eben eine Pflicht.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
