                        "source_sense_id": "542ba6aa-57d4-3275-a76e-1b5d9e191b34",
                        "target_lang_word": "date",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c84a58b7-ba39-3bbf-bd1a-cf415399f3a6",
                                        "entry_id": "d1a1cb55-882a-3dc9-9968-3c86ff81e0db",
                                        "glosses": [
                                            "The fruit of the date palm, Phoenix dactylifera, somewhat in the shape of an olive, containing a soft, sweet pulp and enclosing a hard kernel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5693ff59-6423-44d5-a621-6fd0064f2b48",
                                                "sense_id": "c84a58b7-ba39-3bbf-bd1a-cf415399f3a6",
                                                "text": "We made a nice cake from dates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ccc17d9-2efb-3682-b9a5-07c3662bbd8c",
                                        "entry_id": "d1a1cb55-882a-3dc9-9968-3c86ff81e0db",
                                        "glosses": [
                                            "The date palm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15148089-2b86-460b-a538-f4c2f07947b4",
                                                "sense_id": "3ccc17d9-2efb-3682-b9a5-07c3662bbd8c",
                                                "text": "There were a few dates planted around the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aed7c6f-da43-338b-a8d1-309e3c19069c",
                                        "entry_id": "d1a1cb55-882a-3dc9-9968-3c86ff81e0db",
                                        "glosses": [
                                            "The anus."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e752cf3-07b6-42aa-bb85-7bea5e723f7b",
                                                "sense_id": "3aed7c6f-da43-338b-a8d1-309e3c19069c",
                                                "text": "The bullet took the middle finger of his right hand clean off […]. ‘He sure won't be sticking that finger up his date again,’ said Max."
                                            },
                                            {
                                                "example_id": "89a3ed32-4c0f-429a-91d1-cde5d627d4ed",
                                                "sense_id": "3aed7c6f-da43-338b-a8d1-309e3c19069c",
                                                "text": "Black Superman could kiss his date, the little faggot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "205a5b47-fd73-365a-b1e7-0d7382b30ebb",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "The addition to a writing, inscription, coin, etc., which specifies the time (especially the day, month, and year) when the writing or inscription was given, executed, or made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29bc9832-c95e-41dc-8e4a-e953b1ab37c5",
                                                "sense_id": "205a5b47-fd73-365a-b1e7-0d7382b30ebb",
                                                "text": "US date : 05/24/08 = Tuesday, May 24th, 2008. UK date : 24/05/08 = Tuesday 24th May 2008."
                                            },
                                            {
                                                "example_id": "666c0780-2610-4799-8b79-5ecb32eba9bd",
                                                "sense_id": "205a5b47-fd73-365a-b1e7-0d7382b30ebb",
                                                "text": "the date of a letter, of a will, of a deed, of a coin, etc."
                                            },
                                            {
                                                "example_id": "e3ffde14-ac72-46a9-88cd-37d3955315a5",
                                                "sense_id": "205a5b47-fd73-365a-b1e7-0d7382b30ebb",
                                                "text": "And bonds without a date, they say, are void."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "A specific day in time at which a transaction or event takes place, or is appointed to take place; a given point of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16a93281-abd4-4758-80fd-1502b6c33a30",
                                                "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                                "text": "the date for pleading"
                                            },
                                            {
                                                "example_id": "f5637dda-e595-4954-b411-ff3df6da69b6",
                                                "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                                "text": "The start date for the festival is September 2."
                                            },
                                            {
                                                "example_id": "95202319-1126-446d-ba0c-c924b9b199cc",
                                                "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                                "text": "He at once, Down the long series of eventful time, So fix'd the dates of being, so disposed To every living soul of every kind The field of motion, and the hour of rest."
                                            },
                                            {
                                                "example_id": "b1ef828f-cb3c-46e7-98b2-8a9edf8b4623",
                                                "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                                "text": "Do you know the date of the wedding?"
                                            },
                                            {
                                                "example_id": "98140406-33d7-41dc-a791-5cad7925c28e",
                                                "sense_id": "fec3a561-ba36-33ac-93ee-f40bf38b9268",
                                                "text": "We had to change the dates of the festival because of the flooding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a58e92c-23fa-3056-866a-dfe28ec5601d",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "A point in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cb14c70-572b-409a-890c-f2b0f16b5ad0",
                                                "sense_id": "6a58e92c-23fa-3056-866a-dfe28ec5601d",
                                                "text": "You may need that at a later date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb0cc7d-2bfb-3d8d-a6c0-50654cbff5fa",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "An assigned end; a conclusion."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c942b2-9855-454b-9384-ac4209cfee41",
                                                "sense_id": "7eb0cc7d-2bfb-3d8d-a6c0-50654cbff5fa",
                                                "text": "But because he is but briefe, and these things of great consequence not to be kept obscure, I shall conceave it nothing above my duty either for the difficulty or the censure that may passe thereon, to communicate such thoughts as I also have had, and do offer them now in this generall labour of reformation, to the candid view both of Church and Magistrate; especially because I see it the hope of good men, that those irregular and unspirituall Courts have spun their utmost date in this Land; and some beter course must now be constituted."
                                            },
                                            {
                                                "example_id": "7d2b0bf3-6c4f-46d7-bce2-e5c8e6761a3b",
                                                "sense_id": "7eb0cc7d-2bfb-3d8d-a6c0-50654cbff5fa",
                                                "text": "What Time would spare, from Steel receives its date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "852f36b4-b3cd-3fcc-ac62-f7d04c649992",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "A given or assigned length of life; duration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141c63b5-4175-4aee-8265-05704f197889",
                                                "sense_id": "852f36b4-b3cd-3fcc-ac62-f7d04c649992",
                                                "text": "Good luck prolonged hath thy date."
                                            },
                                            {
                                                "example_id": "c37826fe-b545-42b9-800c-fce503adfe53",
                                                "sense_id": "852f36b4-b3cd-3fcc-ac62-f7d04c649992",
                                                "text": "1611-15, George Chapman (translator), Homer (author), The Odysseys of Homer, Volume 1, Book IV, lines 282–5,\nAs now Saturnius, through his life's whole date,\nHath Nestor's bliss raised to as steep a state,\nBoth in his age to keep in peace his house,\nAnd to have children wise and valorous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "470ed5b5-6ad9-34bd-9671-40fffa0fd3ac",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "A pre-arranged meeting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73d15b8c-d8f4-48c7-bd4e-e58354787cfc",
                                                "sense_id": "470ed5b5-6ad9-34bd-9671-40fffa0fd3ac",
                                                "text": "I arranged a date with my Australian business partners."
                                            },
                                            {
                                                "example_id": "f5b391ec-5d5a-48ab-b0f7-f4091b59a70f",
                                                "sense_id": "470ed5b5-6ad9-34bd-9671-40fffa0fd3ac",
                                                "text": "\"Why, Mr. Nisbet! I thought you were in New York.\"\n\"I had a telegram this morning, calling the date off,\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3ec987-4283-315e-b842-2acfff11dca9",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "One's companion for social activities or occasions, especially a romantic partner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2bacf6f-206e-4cc1-99d4-f56ea527eb83",
                                                "sense_id": "3a3ec987-4283-315e-b842-2acfff11dca9",
                                                "text": "I brought Melinda to the wedding as my date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22ba6c2f-ac3b-3db1-b3be-67ce0ec3ff57",
                                        "entry_id": "2fa1240c-f82b-345a-ae66-53d6a0e163e4",
                                        "glosses": [
                                            "A romantic meeting or outing with a lover or potential lover, or the person so met."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e67801d3-bd2a-45b7-8268-1a16ac08aa00",
                                                "sense_id": "22ba6c2f-ac3b-3db1-b3be-67ce0ec3ff57",
                                                "text": "We really hit it off on the first date, so we decided to meet the week after."
                                            },
                                            {
                                                "example_id": "b40ffe20-5392-40af-b791-3d03e3366518",
                                                "sense_id": "22ba6c2f-ac3b-3db1-b3be-67ce0ec3ff57",
                                                "text": "The cinema is a popular place to take someone on a date."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "date",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7b20f1d-9862-3256-af6f-764fd546863d",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To note the time or place of writing or executing; to express in an instrument the time of its execution."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2afc754-1dda-4abf-adc2-ccdf274b5d3d",
                                                "sense_id": "b7b20f1d-9862-3256-af6f-764fd546863d",
                                                "text": "to date a letter, a bond, a deed, or a charter"
                                            },
                                            {
                                                "example_id": "e9c0ce1a-981a-4f2f-8f56-a7fdf6f4e705",
                                                "sense_id": "b7b20f1d-9862-3256-af6f-764fd546863d",
                                                "text": "You will be surprised, I don't question, to find among your correspondencies in foreign parts, a letter dated from Blois."
                                            },
                                            {
                                                "example_id": "5f7ce82c-cec8-4987-aff3-811b277d850c",
                                                "sense_id": "b7b20f1d-9862-3256-af6f-764fd546863d",
                                                "text": "I keep to the very words of the letter; but that, by \"this State,\" is meant the State of Pennsylvania, cannot be doubted, especially when we see that the letter is dated at Philadelphia."
                                            },
                                            {
                                                "example_id": "83c6ba34-7671-4f51-85b9-de1cf74c341c",
                                                "sense_id": "b7b20f1d-9862-3256-af6f-764fd546863d",
                                                "text": "In these countries much of his Journal seems to have been written; parts of it are dated from them; and there, a few weeks before his fifty-ninth birthday, he fell sick and died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9636ddf9-c98d-34bd-a542-a383bb9b0575",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To note or fix the time of (an event); to give the date of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99bda372-6413-44d1-90f1-5324e34f2bae",
                                                "sense_id": "9636ddf9-c98d-34bd-a542-a383bb9b0575",
                                                "text": "The writer dates the festival on June 21st, which is probably a mistake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da0ee4f2-bf0c-3c34-be8e-a37c11e02f11",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To determine the age of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "379c4371-448a-47c1-93df-86773748bfcb",
                                                "sense_id": "da0ee4f2-bf0c-3c34-be8e-a37c11e02f11",
                                                "text": "to date the building of the pyramids"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2edfcfd-2e6c-3f14-8560-57a0f72b44a2",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To take (someone) on a date, or a series of dates."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b33daa36-0f4d-3502-84f2-0e5b5b611a66",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To have a steady relationship with; to be romantically involved with."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de002798-ccf1-479a-8474-ae1c96e46d98",
                                                "sense_id": "b33daa36-0f4d-3502-84f2-0e5b5b611a66",
                                                "text": "Jessica Simpson reportedly went on a drinking binge after discovering ex-boyfriend John Mayer is dating Jennifer Aniston."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1176fc2-8cbc-319c-bd3c-2b04d5700673",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To have a steady relationship with each other; to be romantically involved with each other."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "reciprocal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed08a0e2-9879-4036-800e-924921a5a1f7",
                                                "sense_id": "f1176fc2-8cbc-319c-bd3c-2b04d5700673",
                                                "text": "They met a couple of years ago, but have been dating for about five months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e288917-d7d0-3f92-8617-b9ccced82a8e",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To make or become old, especially in such a way as to fall out of fashion, become less appealing or attractive, etc."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9603b0a8-ae35-4189-a001-9153b745aabc",
                                                "sense_id": "0e288917-d7d0-3f92-8617-b9ccced82a8e",
                                                "text": "This show hasn't dated well."
                                            },
                                            {
                                                "example_id": "6f7a9819-c2ab-47cb-9903-5d36fa06933e",
                                                "sense_id": "0e288917-d7d0-3f92-8617-b9ccced82a8e",
                                                "text": "The comedian dated himself by making quips about bands from the 1960s."
                                            },
                                            {
                                                "example_id": "0f26d967-3686-4dfc-bb36-20859249daad",
                                                "sense_id": "0e288917-d7d0-3f92-8617-b9ccced82a8e",
                                                "text": "In these days of decimalization and metrication it is a pity that SI units were not used as this will date a very useful little book prematurely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53c451ab-d9d0-338a-9424-7abd494675b5",
                                        "entry_id": "6b9f8687-b300-380e-8632-a9f82cb65a54",
                                        "glosses": [
                                            "To have beginning; to begin; to be dated or reckoned."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ddb4c4-024d-4529-b737-14ef46264248",
                                                "sense_id": "53c451ab-d9d0-338a-9424-7abd494675b5",
                                                "text": "The Batavian republic dates from the successes of the French arms."
                                            },
                                            {
                                                "example_id": "4437450b-09ad-4f60-b86f-62bb3fcbc793",
                                                "sense_id": "53c451ab-d9d0-338a-9424-7abd494675b5",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "a95fe1d9-ac98-4731-9301-4668f713c183",
                                                "sense_id": "53c451ab-d9d0-338a-9424-7abd494675b5",
                                                "text": "From the ground, Colombo’s port does not look like much. Those entering it are greeted by wire fences, walls dating back to colonial times and security posts. For mariners leaving the port after lonely nights on the high seas, the delights of the B52 Night Club and Stallion Pub lie a stumble away."
