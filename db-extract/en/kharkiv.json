    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                "word": "Kharkiv",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "147f05d4-54ba-32db-9a1a-43bd82dbd2ba",
                        "entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                        "glosses": [
                            "An industrial city, the administrative centre of Kharkiv Raion, Kharkiv Oblast, in eastern Ukraine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6f6bfb-20ec-4fb2-ae26-64597b87259a",
                                "sense_id": "147f05d4-54ba-32db-9a1a-43bd82dbd2ba",
                                "text": "As a schoolboy in the Soviet Ukraine’s second largest city of Kharkiv, (it was then spelled Kharkov in line with the all-permeating ‘Russification’), I was a railway buff."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fe9a377-40df-3d59-b4aa-953500cdb7e4",
                        "entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                        "glosses": [
                            "A raion of Kharkiv Oblast, in eastern Ukraine. Seat: Kharkiv."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0d8e63de-a463-3004-a1ab-87dcf0e1b0a7",
                        "entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                        "glosses": [
                            "An oblast in eastern Ukraine. Seat: Kharkiv."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc0c89d-0326-4188-805b-e5055743ee70",
                                "sense_id": "0d8e63de-a463-3004-a1ab-87dcf0e1b0a7",
                                "text": "But Ukraine claimed its forces had shot down one of these drones for the first time last month near the city of Kupyansk in Kharkiv."
                            },
                            {
                                "example_id": "25768208-9b40-42e9-a64b-ec6ebd59ece7",
                                "sense_id": "0d8e63de-a463-3004-a1ab-87dcf0e1b0a7",
                                "text": "The Russian military command likely chose the seizure of Vovchansk as one of the key tactical objectives of the first phase of the offensive operation in northern Kharkiv Oblast, since Vovchansk is the largest settlement immediately on the border that would provide Russian forces a staging ground close to the Russian rear to prepare for and launch the second phase of the Russian offensive operation."
                            },
                            {
                                "example_id": "dd06a4f4-83f2-4d28-814f-ea270595e56e",
                                "sense_id": "0d8e63de-a463-3004-a1ab-87dcf0e1b0a7",
                                "text": "We switch to the developments along the front line and, uh, the Ukrainians are reporting that the Russians do reconnaissance forces… send reconnaissance forces over the border in Chernihiv, in Sumy, as well as in Kharkiv, so basically along the whole northern border."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1baf2bb-68e6-31ae-aa96-016db862d0d5",
                        "entry_id": "d0f0e415-e8b4-3ef2-9a6e-577d516d81a4",
                        "glosses": [
                            "A river in eastern Ukraine."
                        ],
