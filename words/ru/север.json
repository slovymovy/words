            "senses": [
                {
                    "sense_id": "a74e807c-9118-3201-a059-138d5fd31de7",
                    "sense_definition": "Сторона света, противоположная югу",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перелётные птицы осенью летят на юг, а весной возвращаются на <w>север</w>.",
                            "target_lang_translations": {
                                "de": "Zugvögel fliegen im Herbst nach Süden und kehren im Frühling nach <w>Norden</w> zurück.",
                                "en": "Migratory birds fly south in autumn and return to the <w>north</w> in spring."
                            }
                        },
                        {
                            "text": "Путешественники сверяли свой путь по компасу и постоянно держали курс на <w>север</w>.",
                            "target_lang_translations": {
                                "de": "Die Reisenden überprüften ihren Weg mit dem Kompass und hielten beständig Kurs auf <w>Nord</w>.",
                                "en": "The travelers checked their route by the compass and constantly kept heading <w>north</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "норд"
                    ],
                    "antonyms": [
                        "юг"
                    ],
                    "common_phrases": [
                        "на север",
                        "курс на север",
                        "крайний север"
                    ],
                    "target_lang_definitions": {
                        "de": "Himmelsrichtung, die dem Süden gegenüberliegt",
                        "en": "The cardinal direction opposite to south"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Norden",
                                "target_lang_sense_clarification": "Himmelsrichtung"
                            },
                            {
                                "target_lang_word": "Nord",
                                "target_lang_sense_clarification": "als Kurs oder Richtungsangabe"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "north",
                                "target_lang_sense_clarification": "cardinal direction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ffc38da-d64e-3dbd-807e-3e80703ef084",
                    "sense_definition": "Северная часть какой-либо территории или страны",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом мы решили поехать на <w>север</w> страны, чтобы увидеть древние леса и озёра.",
                            "target_lang_translations": {
                                "de": "Im Sommer beschlossen wir, in den <w>Norden</w> des Landes zu fahren, um alte Wälder und Seen zu sehen.",
                                "en": "In the summer, we decided to travel to the <w>north</w> of the country to see ancient forests and lakes."
                            }
                        },
                        {
                            "text": "Они переехали жить на <w>север</w> Италии ближе к Альпам.",
                            "target_lang_translations": {
                                "de": "Sie zogen in den <w>Norden</w> Italiens, näher an die Alpen.",
                                "en": "They moved to live in the <w>north</w> of Italy, closer to the Alps."
                            }
                        }
                    ],
                    "antonyms": [
                        "юг"
                    ],
                    "common_phrases": [
                        "на севере страны",
                        "поехать на север"
                    ],
                    "target_lang_definitions": {
                        "de": "Nördlicher Teil eines Gebietes oder Landes",
                        "en": "The northern part of a territory or country"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Norden",
                                "target_lang_sense_clarification": "Region im nördlichen Teil"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "north",
                                "target_lang_sense_clarification": "northern region of an area or country"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a77fd8f-0220-3aec-b1fb-4f80acf6973d",
                    "sense_definition": "Полярные и приполярные территории, Арктика",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочие отправляются на Крайний <w>Север</w> на долгосрочную вахту.",
                            "target_lang_translations": {
                                "de": "Die Arbeiter fahren für einen Langzeiteinsatz in den Hohen <w>Norden</w>.",
                                "en": "Workers head to the Far <w>North</w> for a long-term shift."
                            }
                        },
                        {
                            "text": "Жизнь на <w>севере</w> требует особой закалки и привычки к суровым морозам.",
                            "target_lang_translations": {
                                "de": "Das Leben im <w>Norden</w> erfordert eine besondere Abhärtung und Gewöhnung an strenge Fröste.",
                                "en": "Life in the <w>north</w> requires special resilience and getting used to severe frosts."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Крайний Север",
                        "жизнь на севере"
                    ],
                    "target_lang_definitions": {
                        "de": "Polare und subpolare Gebiete, Arktis",
                        "en": "Polar and subpolar regions, the Arctic"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Norden",
                                "target_lang_sense_clarification": "polare Regionen, wie z. B. der Hohe Norden"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "North",
                                "target_lang_sense_clarification": "polar regions or Arctic"
                            },
                            {
                                "target_lang_word": "Far North",
                                "target_lang_sense_clarification": "high-latitude or Arctic regions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a556d0d-7fd0-3a8a-b0b3-a76d4f05bb7a",
                    "sense_definition": "Северные штаты США во время Гражданской войны",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В годы Гражданской войны <w>Север</w> активно развивал промышленность.",
                            "target_lang_translations": {
                                "de": "In den Jahren des Bürgerkriegs entwickelten die <w>Nordstaaten</w> aktiv die Industrie.",
                                "en": "During the Civil War, the <w>North</w> actively developed industry."
                            }
                        },
                        {
                            "text": "Конфликт между <w>Севером</w> и Югом оказал огромное влияние на историю страны.",
                            "target_lang_translations": {
                                "de": "Der Konflikt zwischen dem <w>Norden</w> und dem Süden hatte einen großen Einfluss auf die Geschichte des Landes.",
                                "en": "The conflict between the <w>North</w> and the South had a huge impact on the country's history."
                            }
                        }
                    ],
                    "synonyms": [
