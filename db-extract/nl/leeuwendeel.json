                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee246c33-5148-42b9-87a8-59bb4c70ca45",
                        "source_entry_id": "d5c3f698-2a1f-3efc-b36b-0b942b744479",
                        "source_sense_id": "6f449910-e4e9-3ac6-9060-a5f6076156c3",
                        "target_lang_word": "Löwenanteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Löwenanteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                        "entry_id": "6694dba6-53e9-3ae3-ac28-75eaf1608583",
                                        "glosses": [
                                            "der Hauptanteil, der größte Anteil"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdc91ba5-5fdf-4552-8104-e98baf292884",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "Er hat sich den Löwenanteil des Geländes zum Kauf gesichert."
                                            },
                                            {
                                                "example_id": "1befbb1a-4f8b-4d7f-956e-7767c57724e9",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "„Bund, Land und EU übernehmen den Löwenanteil, aber auch Klosterkammer, diverse Stiftungen und Spender beteiligen sich an den Kosten.“"
                                            },
                                            {
                                                "example_id": "87ba9297-7aa1-419d-bb88-6da065b63697",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "„Denn diese Schlepper haben die Hauptarbeit zu verrichten und bekommen auch den Löwenanteil am Ergebnis dieser riesigen Wurzerei.“"
                                            },
                                            {
                                                "example_id": "373a2e69-36a5-4ad1-aeea-f1544faa4a9e",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "„Doch die Welt wird verteilt, und es sind die großen europäischen Mächte, die dabei den Löwenanteil beanspruchen.“"
                                            },
                                            {
                                                "example_id": "369061a1-958d-4158-adef-389fe0c84904",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "„Allerdings bekamen die Italiener den Löwenanteil, während das spätere Jugoslawien sich mit dem wenig attraktiven Stadtteil Susak im Osten zufriedengeben musste.“"
                                            },
                                            {
                                                "example_id": "ecb94fdd-ee80-4080-b497-40e601b7421c",
                                                "sense_id": "5364145b-7236-37a7-a20b-37797006be22",
                                                "text": "„Weltweit wurden im vergangenen Jahr rund 7,4 Milliarden Tonnen Steinkohle gefördert, fast die Hälfte davon in China. Den Löwenanteil verbrauchen die fördernden Länder selbst,“ […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da77ef74-85e9-4178-9fe2-4cc624d9c412",
                        "source_entry_id": "d5c3f698-2a1f-3efc-b36b-0b942b744479",
                        "source_sense_id": "6f449910-e4e9-3ac6-9060-a5f6076156c3",
                        "target_lang_word": "lion's share",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lion's share",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                        "entry_id": "883b93a4-5698-387d-8492-c7c44408fe24",
                                        "glosses": [
                                            "The majority; a large or generous portion."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9dc56c6d-5029-40ad-b073-37c110bc11e7",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "They got a large donation, but the lion’s share of the money went straight into paying off debt."
                                            },
                                            {
                                                "example_id": "45eb5494-afe3-4030-baff-6de998894be2",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "In place of dividing the merit of the discovery between the Englishman and the Scotchman, and giving the lion's share to my countryman, I have given the whole merit of the discovery to [Henry] Cavendish the Englishman, and have reserved only for [James] Watt the Scotchman, the merit of the previous hypothesis,—a merit freely given him by Cavendish himself, and one which no other person ever claimed."
                                            },
                                            {
                                                "example_id": "21c3532a-9c89-42c3-8bf0-e1b4b25c08a2",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "But when a fortunate section of them should begin to win lions' shares of the spoil through superior aptitude for the struggle, can we doubt in what direction the disappointed ones would seek for consolation and support?"
                                            },
                                            {
                                                "example_id": "29ac63af-6a41-40b5-bdca-55576017d42d",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "But England suffered great damage, and was put to very heavy expense in compelling restitution. She voluntarily surrendered all claim to the lion's share of the prize, though she certainly did the lion's share of the work, and bore the lion's share of the expense."
                                            },
                                            {
                                                "example_id": "70883a3d-f194-4ebe-b679-54e27f4c171a",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "The real cause of poverty in Europe is the great wealth of the few. The masses always be poor when a few kings and nobles hoard such enormous lion's shares."
                                            },
                                            {
                                                "example_id": "617ce625-1e1b-476c-bb98-a044d0c2a6b2",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "You would have the lion's share of everything. Now for myself I intend to have the lion's share. And why shouldn't I? Isn't it about time some woman had it? You can't have the lion's share if you are not free. I mean to be free. If I marry I shall want a husband that is not a prison …"
                                            },
                                            {
                                                "example_id": "814ee778-2b52-4590-8067-8c0fe8f6896e",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "Accordingly, Mitchell and his fireman, apparently without removing the engine from the up line, set to work and disconnected the motion on the defective side, after which Fireman Richardson, who probably had done the lion's share of the work, betook himself to the refreshment room and had a cup of coffee."
                                            },
                                            {
                                                "example_id": "2cc993b3-9fe0-4058-a592-c1e904f1b225",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "In fact, at the end of some of the Con Game sessions, some subjects suggested playing for money. We must add, however, that it was usually those who had collected the lion's shares of the points who made such suggestions."
                                            },
                                            {
                                                "example_id": "36eafb81-0c39-4510-a3f1-2d5bcb0613d5",
                                                "sense_id": "5b2c58b0-c3f7-38f5-aed7-bd39c20adf21",
                                                "text": "Yet it could have been so different for Tony Pulis's side, who weathered a good start by the hosts to create the lion's share of what few first-half chances came along."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "905960b1-3cdf-4032-b1d8-6d2817d9f6b0",
                        "source_entry_id": "d5c3f698-2a1f-3efc-b36b-0b942b744479",
                        "source_sense_id": "6f449910-e4e9-3ac6-9060-a5f6076156c3",
                        "target_lang_word": "part du lion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "part du lion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5897da4-27ff-36b4-9b15-6253d9ba8b70",
                                        "entry_id": "c1623741-d189-3815-9a98-14a2a5035370",
                                        "glosses": [
                                            "Part démesurée dont s’empare le plus fort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16d8a83-ec88-4d32-abe7-c42d1d7c35ad",
                                                "sense_id": "e5897da4-27ff-36b4-9b15-6253d9ba8b70",
                                                "text": "Outre tous ses Matterhorns, la capitale du Haut-Valais possède plusieurs attractions bien agréables à visiter par mauvais temps et tout à fait propres à réjouir le cœur et réconforter un moral en baisse. Le cimetière, d’abord, où reposent maintes victimes des montagnes environnantes, et principalement du Cervin, qui s’est réservé la part du lion."
                                            },
                                            {
                                                "example_id": "4f3362b5-c643-481c-b2c5-1632eebb65f0",
                                                "sense_id": "e5897da4-27ff-36b4-9b15-6253d9ba8b70",
                                                "text": "L’activité en voie de devenir la plus populaire est le chat (clavardage) entre amis bien que la télévision occupe toujours la part du lion de leurs activités de loisir."
                                            },
                                            {
                                                "example_id": "004719d2-97f7-432d-b703-9d7a10bccf8e",
                                                "sense_id": "e5897da4-27ff-36b4-9b15-6253d9ba8b70",
                                                "text": "Ces \"grands producteurs\" génèrent la part du lion des revenus agricoles au Canada pour les trois provinces des Prairies, qui possèdent à elles seules 70 % des ressources agricoles du pays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0464fb07-b196-47d7-b01b-847d25bd9ae7",
                        "source_entry_id": "d5c3f698-2a1f-3efc-b36b-0b942b744479",
                        "source_sense_id": "6f449910-e4e9-3ac6-9060-a5f6076156c3",
