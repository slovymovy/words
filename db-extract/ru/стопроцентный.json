                        "glosses": [
                            "не содержащий примесей, чистый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f1a95e-5931-4084-82e7-4df8f681be34",
                                "sense_id": "f5757d9e-0445-3e1b-970c-58d179ece3ad",
                                "text": "Стопроцентный спирт."
                            }
                        ]
                    },
                    {
                        "sense_id": "3afb65e0-a22e-32ea-a490-a18a0b3f8949",
                        "entry_id": "c6db7a19-ce21-38e4-bbef-a0ce3f80fc62",
                        "glosses": [
                            "полный, без исключений"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742ad40c-5f02-424c-947b-c8e1da2dff48",
                                "sense_id": "3afb65e0-a22e-32ea-a490-a18a0b3f8949",
                                "text": "Например, массовость организации, стопроцентный охват пионерским движением всей нашей многомиллионной детворы."
                            },
                            {
                                "example_id": "e7e45ad1-9a5c-4164-8c99-caf25fec0ed4",
                                "sense_id": "3afb65e0-a22e-32ea-a490-a18a0b3f8949",
                                "text": "Его использование в сочетании с методикой Запашного даёт почти стопроцентный результат…"
                            }
                        ]
                    },
                    {
                        "sense_id": "75660cac-79d9-33bd-b7c0-a167f0b2a5df",
                        "entry_id": "c6db7a19-ce21-38e4-bbef-a0ce3f80fc62",
                        "glosses": [
                            "разг. полностью соответствующий некоему образу, ожиданиям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743c4e14-7f99-49fb-9c4d-c17d78080339",
                                "sense_id": "75660cac-79d9-33bd-b7c0-a167f0b2a5df",
                                "text": "Когда я летел в Америку, я знал, что меня ожидает Тамара Москвина, прагматик стопроцентный."
                            },
                            {
                                "example_id": "666b2782-2c6c-463b-b4df-ae1b789d30b8",
                                "sense_id": "75660cac-79d9-33bd-b7c0-a167f0b2a5df",
                                "text": "На пороге стоял стопроцентный английский джентльмен лет пятидесяти."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c3734b2-bfcc-3daf-ba55-45310830cf99",
                        "entry_id": "c6db7a19-ce21-38e4-bbef-a0ce3f80fc62",
                        "glosses": [
                            "разг. полностью соответствующий истине, действительности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f3e3995-6f1c-4bff-be6a-803c5dde051f",
                                "sense_id": "7c3734b2-bfcc-3daf-ba55-45310830cf99",
                                "text": "У нас бы тогда стопроцентный прогноз был."
                            }
                        ]
                    }
                ],
