                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdadb887-eedf-4034-9e25-077354e9b5cb",
                                                "sense_id": "32f89133-695f-35ab-848e-b9fbdecd1b9b",
                                                "text": "Sire, do I have your permission to execute this traitor?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e95f6da-d499-313c-8593-21b9205a1218",
