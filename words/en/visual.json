{
    "word_family": [
        "visualize",
        "visualization",
        "visually"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4f9ea647-d2c4-3b8c-a120-f56ad8658fd2",
                    "sense_definition": "Relating to sight or the ability to see.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "sight_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie is famous for its stunning <w>visual</w> effects.",
                            "target_lang_translations": {
                                "ru": "Этот фильм славится своими потрясающими <w>визуальными</w> эффектами.",
                                "zh": "这部电影以其震撼的<w>视觉</w>效果而闻名。"
                            }
                        },
                        {
                            "text": "She is a <w>visual</w> learner who understands better with diagrams than with words.",
                            "target_lang_translations": {
                                "ru": "Она — <w>визуал</w>, который понимает информацию лучше с помощью диаграмм, чем слов.",
                                "zh": "她属于<w>视觉</w>型学习者，通过图表理解比通过文字理解更有效。"
                            }
                        }
                    ],
                    "synonyms": [
                        "optical"
                    ],
                    "common_phrases": [
                        "visual arts",
                        "visual aid",
                        "visual effects",
                        "visual field"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к зрению или способности видеть.",
                        "zh": "与视觉或视力有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуа́льный",
                                "target_lang_sense_clarification": "относящийся к восприятию зрением (напр. эффекты, искусство)"
                            },
                            {
                                "target_lang_word": "зри́тельный",
                                "target_lang_sense_clarification": "относящийся к физиологии зрения или памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视觉的",
                                "target_lang_sense_clarification": "与视觉感知或功能相关的"
                            },
                            {
                                "target_lang_word": "视觉上的",
                                "target_lang_sense_clarification": "用于描述感官体验"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6faf0123-bef8-3936-9d5e-2a9b2ee9a0be",
                    "sense_definition": "Able to be seen; visible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship made <w>visual</w> contact with the lighthouse just before dawn.",
                            "target_lang_translations": {
                                "ru": "Корабль установил <w>визуальный</w> контакт с маяком прямо перед рассветом.",
                                "zh": "船只在黎明前与灯塔建立了<w>视觉</w>联系。"
                            }
                        },
                        {
                            "text": "There was no <w>visual</w> evidence of the damage, but the engine sounded terrible.",
                            "target_lang_translations": {
                                "ru": "Не было никаких <w>видимых</w> признаков повреждения, но двигатель звучал ужасно.",
                                "zh": "虽然没有<w>可见</w>的损坏迹象，但引擎的声音听起来很糟糕。"
                            }
                        }
                    ],
                    "synonyms": [
                        "visible",
                        "perceptible"
                    ],
                    "antonyms": [
                        "invisible"
                    ],
                    "common_phrases": [
                        "visual contact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доступный для зрения; видимый.",
                        "zh": "可以被看见的；可见的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуа́льный",
                                "target_lang_sense_clarification": "осуществляемый с помощью зрения (напр. контакт, осмотр)"
                            },
                            {
                                "target_lang_word": "ви́димый",
                                "target_lang_sense_clarification": "тот, который можно увидеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可见的",
                                "target_lang_sense_clarification": "能够被肉眼观察到的"
                            },
                            {
                                "target_lang_word": "视觉上的",
                                "target_lang_sense_clarification": "指通过视觉手段进行的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da80b93a-151b-3fcd-9707-29a4c5623649",
                    "sense_definition": "The picture elements of a film, video, or presentation, as distinct from the sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audio is clear, but the <w>visuals</w> are a bit blurry.",
                            "target_lang_translations": {
                                "ru": "Звук чистый, но <w>изображение</w> немного размыто.",
                                "zh": "音频很清晰，但<w>画面</w>有点模糊。"
                            }
                        },
                        {
                            "text": "Great <w>visuals</w> can make a presentation much more engaging for the audience.",
                            "target_lang_translations": {
                                "ru": "Отличный <w>визуальный ряд</w> может сделать презентацию гораздо более интересной для аудитории.",
                                "zh": "出色的<w>视觉</w>呈现能让演示对观众更具吸引力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "graphics",
                        "imagery"
                    ],
                    "antonyms": [
                        "audio"
                    ],
                    "common_phrases": [
                        "audio and visuals",
                        "stunning visuals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Визуальные элементы (картинка) фильма, видео или презентации, в отличие от звука.",
                        "zh": "电影、视频或演示文稿中的视觉元素，与声音相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "визуа́льный ряд",
                                "target_lang_sense_clarification": "совокупность зрительных образов"
                            },
                            {
                                "target_lang_word": "изображе́ние",
                                "target_lang_sense_clarification": "картинка на экране"
                            },
                            {
                                "target_lang_word": "гра́фика",
                                "target_lang_sense_clarification": "графические элементы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画面",
                                "target_lang_sense_clarification": "指视频或电影中的视觉内容"
                            },
                            {
                                "target_lang_word": "视觉效果",
                                "target_lang_sense_clarification": "指呈现出的视觉表现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c95d775-f845-3721-b624-75a293ea9d89",
                    "sense_definition": "An image, picture, or diagram used to explain or illustrate something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher used a colorful <w>visual</w> to help explain the water cycle.",
                            "target_lang_translations": {
                                "ru": "Учитель использовал красочное <w>наглядное пособие</w>, чтобы объяснить круговорот воды.",
                                "zh": "老师用了一张色彩鲜艳的<w>图示</w>来帮助解释水循环。"
                            }
                        },
                        {
                            "text": "Please include at least one <w>visual</w> on each slide of your presentation.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, включите хотя бы одну <w>иллюстрацию</w> на каждый слайд вашей презентации.",
                                "zh": "请在演示文稿的每一页幻灯片中至少包含一个<w>视觉</w>元素。"
                            }
                        }
                    ],
                    "synonyms": [
                        "illustration",
                        "picture",
                        "diagram"
                    ],
                    "common_phrases": [
                        "key visual"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение, рисунок или диаграмма, используемые для объяснения или иллюстрации чего-либо.",
                        "zh": "用于解释或说明某事物的图像、图片或图表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагля́дное посо́бие",
                                "target_lang_sense_clarification": "материал для обучения"
                            },
                            {
                                "target_lang_word": "иллюстра́ция",
                                "target_lang_sense_clarification": "поясняющее изображение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直观教具",
                                "target_lang_sense_clarification": "用于教学的视觉辅助材料"
                            },
                            {
                                "target_lang_word": "图示",
                                "target_lang_sense_clarification": "用于说明的图片或图表"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}