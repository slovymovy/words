{
    "word_family": [
        "evilly",
        "evilness",
        "evildoer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a948ad9a-b4d7-399e-8096-94fbc341a678",
                    "sense_definition": "Morally bad, cruel, or intending to harm others.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moral_badness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>evil</w> witch cast a powerful spell on the entire kingdom.",
                            "target_lang_translations": {
                                "ru": "<w>Злая</w> ведьма наложила сильное заклятие на всё королевство.",
                                "zh": "那个<w>邪恶的</w>女巫对整个王国施下了强大的魔咒。"
                            }
                        },
                        {
                            "text": "He realized that the villain had an <w>evil</w> plan to steal the money.",
                            "target_lang_translations": {
                                "ru": "Он понял, что у злодея был <w>коварный</w> план украсть деньги.",
                                "zh": "他意识到那个坏人有一个<w>邪恶的</w>偷钱计划。"
                            }
                        },
                        {
                            "text": "She felt an <w>evil</w> presence watching her from the shadows of the room.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>зловещее</w> присутствие, наблюдающее за ней из теней комнаты.",
                                "zh": "她感觉到有一股<w>邪恶的</w>气息正从房间的阴影里注视着她。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wicked",
                        "malicious",
                        "malevolent",
                        "immoral",
                        "sinful",
                        "sinister",
                        "vile",
                        "villainous",
                        "nefarious",
                        "bad",
                        "cruel",
                        "foul"
                    ],
                    "antonyms": [
                        "good",
                        "angelic",
                        "moral",
                        "righteous",
                        "well-intentioned",
                        "benign"
                    ],
                    "common_phrases": [
                        "evil eye",
                        "evil spirit",
                        "pure evil",
                        "evil thoughts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально плохой, жестокий или желающий причинить вред другим.",
                        "zh": "道德上邪恶、残忍，或意图伤害他人的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злой",
                                "target_lang_sense_clarification": "исполненный недоброжелательности, враждебности"
                            },
                            {
                                "target_lang_word": "порочный",
                                "target_lang_sense_clarification": "склонный к безнравственным поступкам"
                            },
                            {
                                "target_lang_word": "злобный",
                                "target_lang_sense_clarification": "выражающий злобу и агрессию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邪恶的",
                                "target_lang_sense_clarification": "道德上坏的，带有害人意图"
                            },
                            {
                                "target_lang_word": "恶毒的",
                                "target_lang_sense_clarification": "心肠狠毒、存心伤人"
                            },
                            {
                                "target_lang_word": "凶恶的",
                                "target_lang_sense_clarification": "凶狠可怕，常形容人或气息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3deee01-0c1e-33bb-9429-00725f476d9d",
                    "sense_definition": "Causing or threatening sorrow, distress, or bad luck.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harm_calamity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The villagers believed that the black cat was an <w>evil</w> sign.",
                            "target_lang_translations": {
                                "ru": "Деревенские жители верили, что черная кошка — это <w>дурной</w> знак.",
                                "zh": "村民们相信黑猫是一个<w>不祥的</w>征兆。"
                            }
                        },
                        {
                            "text": "They fell upon <w>evil</w> times during the long years of the war.",
                            "target_lang_translations": {
                                "ru": "В долгие годы войны для них настали <w>тяжёлые</w> времена.",
                                "zh": "在漫长的战争岁月里，他们陷入了<w>艰难的</w>时期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harmful",
                        "injurious",
                        "detrimental",
                        "deleterious",
                        "pernicious"
                    ],
                    "antonyms": [
                        "benign"
                    ],
                    "common_phrases": [
                        "evil omen",
                        "evil days"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причиняющий или предвещающий горе, страдания или неудачу.",
                        "zh": "会造成或预示悲伤、痛苦或厄运的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурной",
                                "target_lang_sense_clarification": "предвещающий несчастье, плохой"
                            },
                            {
                                "target_lang_word": "зловещий",
                                "target_lang_sense_clarification": "угрожающий бедой"
                            },
                            {
                                "target_lang_word": "лихой",
                                "target_lang_sense_clarification": "приносящий беду (устар./разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不祥的",
                                "target_lang_sense_clarification": "预示厄运或灾祸"
                            },
                            {
                                "target_lang_word": "不吉的",
                                "target_lang_sense_clarification": "带来坏运气，不吉利"
                            },
                            {
                                "target_lang_word": "艰难的",
                                "target_lang_sense_clarification": "处境困苦、难挨，多用于时代或日子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6285df9e-db3f-34aa-8af3-7ed3f41fa1e7",
                    "sense_definition": "Extremely unpleasant, foul, or offensive to the senses.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A very <w>evil</w> smell came from the swamp behind the old house.",
                            "target_lang_translations": {
                                "ru": "От болота за старым домом исходил очень <w>дурной</w> запах.",
                                "zh": "老房子后面的沼泽里飘来一股非常<w>难闻的</w>气味。"
                            }
                        },
                        {
                            "text": "He woke up in an <w>evil</w> temper and refused to speak to anyone.",
                            "target_lang_translations": {
                                "ru": "Он проснулся в <w>скверном</w> настроении и отказывался с кем-либо разговаривать.",
                                "zh": "他醒来时心情<w>恶劣</w>，谁都不肯搭理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foul",
                        "nasty",
                        "vile"
                    ],
                    "common_phrases": [
                        "evil smell",
                        "evil temper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used in literary contexts describing smells or tempers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно неприятный, отвратительный или оскорбительный для чувств.",
                        "zh": "极其令人不快、污浊难闻，或强烈冒犯感官的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скверный",
                                "target_lang_sense_clarification": "очень плохой, неприятный (о запахе или характере)"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "вызывающий сильное отвращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难闻的",
                                "target_lang_sense_clarification": "气味等非常不好闻"
                            },
                            {
                                "target_lang_word": "令人作呕的",
                                "target_lang_sense_clarification": "令人厌恶、反感"
                            },
                            {
                                "target_lang_word": "恶劣的",
                                "target_lang_sense_clarification": "情绪、脾气等很差"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "06537468-140e-3351-b10e-35f5c5c88de0",
                    "sense_definition": "The force or reality of being morally bad or wrong; the opposite of good.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "moral_badness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie tells a classic story of the battle between good and <w>evil</w>.",
                            "target_lang_translations": {
                                "ru": "Фильм рассказывает классическую историю битвы между добром и <w>злом</w>.",
                                "zh": "这部电影讲述了一个关于善与<w>邪恶</w>斗争的经典故事。"
                            }
                        },
                        {
                            "text": "Many people believe that money is the root of all <w>evil</w> in society.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что деньги — это корень всего <w>зла</w> в обществе.",
                                "zh": "许多人认为金钱是社会上一切<w>罪恶</w>的根源。"
                            }
                        },
                        {
                            "text": "She dedicated her life to fighting against <w>evil</w> and injustice.",
                            "target_lang_translations": {
                                "ru": "Она посвятила свою жизнь борьбе со <w>злом</w> и несправедливостью.",
                                "zh": "她毕生都在与<w>邪恶</w>和不公作斗争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wickedness",
                        "immorality",
                        "sin",
                        "depravity"
                    ],
                    "antonyms": [
                        "good"
                    ],
                    "common_phrases": [
                        "good and evil",
                        "root of all evil",
                        "fight against evil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила или сущность того, что является морально плохим или неправильным; противоположность добру.",
                        "zh": "道德上坏或错误的力量或本质；与善相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зло",
                                "target_lang_sense_clarification": "нечто дурное, вредное, противоположное добру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "邪恶",
                                "target_lang_sense_clarification": "与善相对的邪恶力量或性质"
                            },
                            {
                                "target_lang_word": "罪恶",
                                "target_lang_sense_clarification": "道德上的恶与坏"
                            },
                            {
                                "target_lang_word": "恶",
                                "target_lang_sense_clarification": "泛指恶的一面，较抽象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1334c3f-c6dd-3b2e-83e9-c2136433f147",
                    "sense_definition": "Something that causes harm, suffering, or problems.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harm_calamity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided that raising taxes was the lesser of two <w>evils</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили, что повышение налогов — это меньшее из двух <w>зол</w>.",
                                "zh": "我们认为加税是两种<w>祸害</w>中较轻的一种。"
                            }
                        },
                        {
                            "text": "Unemployment is a serious social <w>evil</w> that affects many families.",
                            "target_lang_translations": {
                                "ru": "Безработица — это серьезное социальное <w>зло</w>, которое затрагивает многие семьи.",
                                "zh": "失业是一种严重的社会<w>弊害</w>，影响着许多家庭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "affliction",
                        "curse",
                        "harm",
                        "misfortune"
                    ],
                    "common_phrases": [
                        "lesser of two evils",
                        "necessary evil",
                        "social evils"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что причиняет вред, страдания или создает проблемы.",
                        "zh": "造成伤害、痛苦或问题的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зло",
                                "target_lang_sense_clarification": "беда, несчастье, вред"
                            },
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "горестное событие, несчастье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祸害",
                                "target_lang_sense_clarification": "造成伤害或麻烦的事物"
                            },
                            {
                                "target_lang_word": "弊害",
                                "target_lang_sense_clarification": "社会或制度中的严重害处"
                            },
                            {
                                "target_lang_word": "灾祸",
                                "target_lang_sense_clarification": "带来痛苦或不幸的事"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7d67d7be-9ee1-3cb1-8e63-bcb6ff888cd1",
                    "sense_definition": "In a wicked or harmful manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not speak <w>evil</w> of those who are not present to defend themselves.",
                            "target_lang_translations": {
                                "ru": "Не следует говорить <w>дурно</w> о тех, кто не присутствует, чтобы защитить себя.",
                                "zh": "你不该<w>恶意地</w>议论那些不在场、无法为自己辩护的人。"
                            }
                        },
                        {
                            "text": "The project went <w>evil</w> from the very beginning due to poor planning.",
                            "target_lang_translations": {
                                "ru": "Проект пошел <w>прахом</w> с самого начала из-за плохого планирования.",
                                "zh": "由于规划不周，这个项目从一开始就<w>变糟了</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wickedly",
                        "badly"
                    ],
                    "common_phrases": [
                        "speak evil"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English typically uses 'evilly' or 'badly'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злобно или вредоносно.",
                        "zh": "以邪恶或有害的方式；古旧用法中也可指情况变坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурно",
                                "target_lang_sense_clarification": "плохо, предосудительно"
                            },
                            {
                                "target_lang_word": "зло",
                                "target_lang_sense_clarification": "со злостью, враждебно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恶意地",
                                "target_lang_sense_clarification": "带着恶意地，心怀伤害地"
                            },
                            {
                                "target_lang_word": "狠毒地",
                                "target_lang_sense_clarification": "以不友善、恶毒的方式"
                            },
                            {
                                "target_lang_word": "变糟",
                                "target_lang_sense_clarification": "事情朝坏的方向发展，常见于古旧用法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}