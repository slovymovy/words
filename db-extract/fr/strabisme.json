                                        "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To look with the eyes partly closed, as in bright sunlight, or as a threatening expression."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258516c5-edcf-4413-ba4e-ce661932eae6",
                                                "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                                                "text": "The children squinted to frighten each other."
                                            },
                                            {
                                                "example_id": "66ca37ca-9a52-41bb-aa9e-9f642117fa66",
                                                "sense_id": "d36700f4-4f27-3196-aae6-a986862c2a8a",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b235a0bf-7002-3de5-909c-fc4edb63e7e7",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To look or glance sideways."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f89108a-6c79-30cb-8f27-2971307438c5",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To look with, or have eyes that are turned in different directions; to suffer from strabismus."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1012ee2-494e-3bb5-89f4-b55531ea18a3",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To have an indirect bearing, reference, or implication; to have an allusion to, or inclination towards, something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "559502a1-b50e-4bfc-b4d7-97ca27c1b93b",
                                                "sense_id": "d1012ee2-494e-3bb5-89f4-b55531ea18a3",
                                                "text": "Yet if the following sentence means anything, it is a squinting toward hypnotism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "922740c1-aebb-3e57-b38a-0c9cf1952e23",
                                        "entry_id": "380a189a-d0d4-3adf-bc8d-2abe005b4b7f",
                                        "glosses": [
                                            "To be not quite straight, off-centred; to deviate from a true line; to run obliquely."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
