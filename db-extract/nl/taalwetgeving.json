                        "glosses": [
                            "alle wetten en verordeningen die het gebruik van een bepaalde taal in een bepaalde context verplichten of juist verbieden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533726a8-9e28-4717-81bf-ae91b72dfadc",
                                "sense_id": "d762eaa8-61ae-3692-8e60-ec79a00b306f",
                                "text": "De strikte Belgische taalwetgeving (Nederlands in Vlaanderen, Frans in Wallonië en beide talen in Brussel) geldt ook voor sociale media, zegt een jurist van de Vlaamse overheid. Ook anderstalige berichten retweeten mag niet zomaar."
                            },
                            {
                                "example_id": "750fe62e-91de-4ea8-89d2-da0866b46de0",
                                "sense_id": "d762eaa8-61ae-3692-8e60-ec79a00b306f",
                                "text": "De Belgische advocaat Sven Mary wil vrijspraak voor terrorismeverdachte Salah Abdeslam, omdat er tijdens de aanstelling van een onderzoeksrechter inbreuk zou zijn gepleegd op de Belgische taalwetgeving."
                            },
                            {
                                "example_id": "9d44761e-ab34-487f-814d-1f51ff214b21",
                                "sense_id": "d762eaa8-61ae-3692-8e60-ec79a00b306f",
                                "text": "Er komt dan toch geen (forse) versoepeling van de taalwetgeving in het hoger onderwijs. Nederlandstalige bachelors mogen vandaag maximum 18,33% anderstalige vakken bevatten. Dat blijft zo."
                            }
                        ]
