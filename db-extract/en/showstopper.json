                                "target_senses": [
                                    {
                                        "sense_id": "d79d80ef-31e2-3a6a-8a39-b2569d47f4e3",
                                        "entry_id": "b5469a9d-f407-3d5c-9592-c93585077cd9",
                                        "glosses": [
                                            "Bedingung, deren Erfüllung zum Ausschluss von etwas führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2a3970-72d3-4ce8-ac0e-20ad313cd8b8",
                                                "sense_id": "d79d80ef-31e2-3a6a-8a39-b2569d47f4e3",
                                                "text": "„Auch Kapitalverflechtungen mit solchen Gesellschaften werden von den Juroren als Ausschlusskriterium gewertet.“"
                                            },
                                            {
                                                "example_id": "b59db7e2-c214-4045-894c-9241150d86d8",
                                                "sense_id": "d79d80ef-31e2-3a6a-8a39-b2569d47f4e3",
                                                "text": "„Gemäß griechischem Recht dürfen Kandidaten nur dann nicht für eine Wahl kandidieren, wenn sie wegen eines Verbrechens verurteilt wurden. Laufende Ermittlungen sind kein Ausschlusskriterium.“"
                                            },
                                            {
                                                "example_id": "c419f6be-47ad-4a6e-96d9-74584f8e8520",
                                                "sense_id": "d79d80ef-31e2-3a6a-8a39-b2569d47f4e3",
                                                "text": "„Eine Sehschwäche von mehr als drei Dioptrien gelten als Ausschlusskriterium.“"
                                            },
                                            {
                                                "example_id": "e077be40-df5e-4a86-a102-1d5674216ce0",
                                                "sense_id": "d79d80ef-31e2-3a6a-8a39-b2569d47f4e3",
                                                "text": "„Auch eine schlechtere Note stellt kein absolutes Ausschlusskriterium da [sic!], sofern im Rahmen des Studiums eine klare Leistungssteigerung zu verzeichnen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
