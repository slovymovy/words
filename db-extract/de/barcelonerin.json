                                        "glosses": [
                                            "Someone from Barcelona"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62106a15-a4dd-445a-9bd6-22f6129267a2",
                                                "sense_id": "2ee745fa-1255-3ac3-87b6-d746ba2225c7",
                                                "text": "For more than a century, the Barcelonans were engaged in incessant struggles with the Moors, but ultimately maintained their independence till the annexation of the principality of Catalonia to the crown of Aragon in the twelfth century."
