                        "sense_id": "8ae2d8a1-5647-31ce-9451-ca3cd1b03363",
                        "entry_id": "c2a6fd55-f11e-3bdc-a80a-08c921b62e71",
                        "glosses": [
                            "Pêcher à pied dans la rocaille."
                        ],
                        "tags": [
                            "Normandie"
                        ],
                        "examples": []
                    },
