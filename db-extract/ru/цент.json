                                "target_senses": [
                                    {
                                        "sense_id": "0e1c286a-1938-3bfb-a7fc-8431c5b230b4",
                                        "entry_id": "b5161345-83e1-3b4e-a7b1-a8381d3dada7",
                                        "glosses": [
                                            "A subunit of currency equal to one-hundredth of the main unit of currency in many countries. Symbol: ¢."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a7a47ea-4f77-4dd4-a540-0516e6bc9dc5",
                                                "sense_id": "0e1c286a-1938-3bfb-a7fc-8431c5b230b4",
                                                "text": "It's true. 1.7 cents to make 1 cent. That really makes the phrase “you have to spend money to make money” ring painfully true."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b89512-fe62-332c-b436-ae7f99dfffa6",
                                        "entry_id": "b5161345-83e1-3b4e-a7b1-a8381d3dada7",
                                        "glosses": [
                                            "A small sum of money."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d84a47-1b39-43cd-adad-6f309fd242ab",
                                                "sense_id": "17b89512-fe62-332c-b436-ae7f99dfffa6",
                                                "text": "He blew every last cent."
                                            },
                                            {
                                                "example_id": "b8efd44c-faca-4b34-b80e-4c445518925a",
                                                "sense_id": "17b89512-fe62-332c-b436-ae7f99dfffa6",
                                                "text": "Every cent aside from his own expenses for the barest kind of living went to his down-and-out buddies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc36884a-1eec-3fe7-9421-96a01a0db9ae",
                                        "entry_id": "b5161345-83e1-3b4e-a7b1-a8381d3dada7",
                                        "glosses": [
                                            "A subunit of currency equal to one-hundredth of the euro."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17bef9b7-b4bf-362a-bedc-bff4f75432ed",
                                        "entry_id": "b5161345-83e1-3b4e-a7b1-a8381d3dada7",
                                        "glosses": [
                                            "A coin having face value of one cent (in either of the above senses)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
