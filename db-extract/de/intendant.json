                    },
                    {
                        "translation_id": "af5aae84-a78d-44b8-9713-d829d9ffb2ae",
                        "source_entry_id": "40684372-f310-3ba9-85ff-24d893dce6c4",
                        "source_sense_id": "79a76493-07bf-34ac-b118-e6d4234620a9",
                        "source_sense_description": "(künstlerischer) Leiter einer Oper, eines Theaters oder eines Rundfunksenders",
                        "target_lang_word": "administrateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administrateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                        "entry_id": "65639e34-7c1e-3902-8ee4-1fcad19d31e8",
                                        "glosses": [
                                            "Personne chargée de quelque administration, d’une partie du gouvernement, ou qui régit les biens, les affaires d’une société, d’un grand établissement, d’un site internet, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f826e17-3435-4fce-8ceb-a0d3f5b61b5b",
                                                "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                                "text": "Comme nous l'avons déjà évoqué, le gérant d'une SPRL est le mandataire de celle-ci. Il en découle que, comme tout mandataire, il est révocable en tout temps, à l'instar de ce qui se passe pour l’administrateur de société anonyme."
                                            },
                                            {
                                                "example_id": "99ae52fb-d258-4f47-85d3-0bf0ad05408a",
                                                "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                                "text": "Les demandes de désignation d’un administrateur provisoire d’une copropriété en difficulté sont quant à elle acceptées dans la très grande majorité des cas (plus de neuf fois sur dix) et sont traitées dans des délais très brefs."
                                            },
                                            {
                                                "example_id": "e4e5ab08-63d3-442c-bb46-28b91bc8a0ec",
                                                "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                                "text": "L’administrateur du Collège de France, de la Bibliothèque nationale, de la Comédie-Française."
                                            },
                                            {
                                                "example_id": "8b6e0ed7-f8ed-48ff-a99f-3aff97a57b0e",
                                                "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                                "text": "Administrateur d’une société par actions."
                                            },
                                            {
                                                "example_id": "708d9a05-8ad3-49f7-9597-4317360c62df",
                                                "sense_id": "1be177bc-330a-3526-9e63-32c238b5e8bf",
                                                "text": "Cette abbesse fut une bonne administratrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "128ed26b-ffe9-37ba-8408-18b9f2b31b5a",
                                        "entry_id": "65639e34-7c1e-3902-8ee4-1fcad19d31e8",
                                        "glosses": [
                                            "Personne chargée de quelque administration, d’une partie du gouvernement, ou qui régit les biens, les affaires d’une société, d’un grand établissement, d’un site internet, etc.",
                                            "Celui qui est chargé de quelque administration, d’une partie du gouvernement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be70042b-3db4-4a39-bfdf-bc4aed2e1b36",
                                                "sense_id": "128ed26b-ffe9-37ba-8408-18b9f2b31b5a",
                                                "text": "En principe, il y a quatre blancs : l'administrateur et son adjoint, que vous avez vu, le docteur, qui est presque toujours en tournée, et le missionnaire blanc qui parcourt la brousse en motocyclette..."
                                            },
                                            {
                                                "example_id": "333df44e-c6d1-43fe-998f-fcc16d9cdf98",
                                                "sense_id": "128ed26b-ffe9-37ba-8408-18b9f2b31b5a",
                                                "text": "Au pied de la tour Clovis et sous les marronniers de l'avenue de l'Observatoire nous avons rêvé ensemble au métier d'administrateur de la France d'outre-mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fb2f834-c52d-3ec6-94df-5874925177bc",
                                        "entry_id": "65639e34-7c1e-3902-8ee4-1fcad19d31e8",
                                        "glosses": [
                                            "Personne chargée de quelque administration, d’une partie du gouvernement, ou qui régit les biens, les affaires d’une société, d’un grand établissement, d’un site internet, etc.",
                                            "Celui qui sait bien administrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945e6bbc-90de-4327-89a9-065ea598e0c9",
                                                "sense_id": "9fb2f834-c52d-3ec6-94df-5874925177bc",
                                                "text": "Ce préfet n’est point administrateur."
                                            },
                                            {
                                                "example_id": "a2f529d2-5136-48dc-a33a-039834a6a9a9",
                                                "sense_id": "9fb2f834-c52d-3ec6-94df-5874925177bc",
                                                "text": "Cette solution est-elle bonne, ou bien est-elle mauvaise ? Peu importe : l’essentiel est que ce soit une solution. Avec moi, pas d’affaires qui traînent, et c’est à cela que je dois ma réputation d’administrateur : je fais quelque chose, tandis que tant de mes confrères ne font rien du tout."
                                            },
                                            {
                                                "example_id": "0d42aea4-ae4c-471d-b690-ab9be9e01cb3",
                                                "sense_id": "9fb2f834-c52d-3ec6-94df-5874925177bc",
                                                "text": "Bref, Salomon (...) était le type même de ces psychiatres qui sont avant tout des administrateurs, qui excellent dans l’art difficile du gouvernement des aliénés et qui tirent de leurs subordonnés (non moins difficiles à gouverner) tout ce qu’on peut raisonnablement exiger de paysans mal dégrossis, peu rétribués et dépourvus de toute formation professionnelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e48805a-219e-3c01-842a-edb6a84e16f9",
                                        "entry_id": "65639e34-7c1e-3902-8ee4-1fcad19d31e8",
                                        "glosses": [
                                            "Administrateur système."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191c3bff-b377-46dc-9c4a-b5a5e4fb54ee",
                                                "sense_id": "4e48805a-219e-3c01-842a-edb6a84e16f9",
                                                "text": "Lors d'une exécution automatique, si un logiciel malicieux est détecté, le prochain administrateur qui se loguera sur le système sera notifié par un message dans la zone de notification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aef1ba6-1f45-3c88-9df5-a0993c4a3c17",
                                        "entry_id": "65639e34-7c1e-3902-8ee4-1fcad19d31e8",
                                        "glosses": [
                                            "Grades dans les différentes fonctions publiques, en France notamment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab791085-649d-40c8-a9fa-13955d549ed9",
                        "source_entry_id": "40684372-f310-3ba9-85ff-24d893dce6c4",
                        "source_sense_id": "79a76493-07bf-34ac-b118-e6d4234620a9",
                        "source_sense_description": "(künstlerischer) Leiter einer Oper, eines Theaters oder eines Rundfunksenders",
                        "target_lang_word": "administratrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "administratrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d30cd5-7601-3e99-9ad7-5614e8790408",
                                        "entry_id": "4f8f03ba-98dd-3fda-ad81-aeaecf8cf377",
                                        "glosses": [
                                            "Femme chargée de quelque administration, d’une partie du gouvernement, ou qui régit les biens, les affaires d’une société, d’un grand établissement, d’un site internet, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb2078d7-76df-461e-a557-4e51c97f7acd",
                                                "sense_id": "b9d30cd5-7601-3e99-9ad7-5614e8790408",
                                                "text": "Durant le long règne « provisoire » de cette administratrice, les gros salaires de la SPA n’ont pas vraiment chuté."
                                            },
                                            {
                                                "example_id": "943990f5-9daa-4345-af09-35fadb5c0cb6",
                                                "sense_id": "b9d30cd5-7601-3e99-9ad7-5614e8790408",
                                                "text": "Par arrêté de la ministre de la Culture, publié au Journal Officiel du 31 octobre, Isabelle de Gourcuff a été nommée administratrice générale du château de Fontainebleau."
                                            },
                                            {
                                                "example_id": "a4639261-c5d7-489b-9ed4-fa6abcd396e3",
                                                "sense_id": "b9d30cd5-7601-3e99-9ad7-5614e8790408",
                                                "text": "Lénaig L’Aot Lombard, administratrice adjointe, et Jean-Yves Besselièvre, administrateur au musée de la Marine, ont enrichi l’exposition consacrée à l’Académie de Marine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
