                    "sense_definition": "alte, gebrauchte Gegenstände oder Waren von geringem Wert",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "waren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf dem Dachboden sammelt sich seit vielen Jahren alter <w>Trödel</w> an.",
                            "target_lang_translations": {
