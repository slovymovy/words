                        "examples": [
                            {
                                "example_id": "d722376d-47cd-4761-a09d-dfe09905bfdc",
                                "sense_id": "2bcb416a-2aa1-3392-8468-41bb8070cf54",
                                "text": "Van de 35 doodskisten in de sportzaal in het Italiaanse stadje, dat niet ver van de zwaar getroffen dorpen Amatrice en Accumoli ligt, waren er twee klein en witgelakt. Daarin lagen de stoffelijke resten van twee van de 21 kinderen die door de aardbeving zijn omgekomen."
                            },
                            {
                                "example_id": "9f4d1a72-aa2e-4dab-a599-e9545ff5feda",
                                "sense_id": "2bcb416a-2aa1-3392-8468-41bb8070cf54",
                                "text": "Het aantal gebruikte materialen is beperkt gebleven: berkenmultiplex, witgelakt staal en geslepen beton – polybeton waarvan nadien de bovenste laag wordt afgeschuurd, waardoor de granulaten weer zichtbaar zijn. Lichte en robuuste materialen, die perfect bij elkaar passen."
                            },
                            {
                                "example_id": "96a65064-ab0d-454e-be0d-ae1135d44aef",
                                "sense_id": "2bcb416a-2aa1-3392-8468-41bb8070cf54",
                                "text": "Hij warmt zijn voeten op de openstaande klep van een geëmailleerd houtfornuis, uit de ketel op het fornuis komt een sliert witte stoom. De kleine kamer heeft een lichtgroene lambrizering en een glanzend witgelakt plafond."
                            }
                        ]
                    }
