                ],
                "senses": [
                    {
                        "sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
                        "entry_id": "0eb52044-ca16-3bb8-aa8c-f5289408bc80",
                        "glosses": [
                            "schlechter, unbegabter Dichter"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "520c5942-1ce6-43cf-8c3c-cef996e7c458",
                                "sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
                                "text": "Im Bewußtsein, daß ich etwas Ausgezeichnetes, wenn auch nichts Gutes geleistet habe, fordere ich Sie auf, mich öffentlich für einen frechen, erbärmlichen Dichterling zu erklären, wenn Sie mein Trauerspiel den Produkten der gewöhnlichen heutigen Dichter ähnlich finden."
                            },
                            {
                                "example_id": "5044ea78-af34-4575-a941-1caf622cd3cb",
                                "sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
                                "text": "„So oder ähnlich sahen es die Dichterlinge.“"
                            },
                            {
                                "example_id": "13f2d4ea-2139-4c6e-bc9d-aa176e6e2221",
                                "sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
                                "text": "„Der englische Dichter W.H. Auden vergleicht einen angehenden Dichterling, der sich der Poesie verschrieben hat, mit einem Grünschnabel, der sich in eine schier unerrreichbare Frau verliebt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4380601-22af-4390-b3f2-3358c38ed2ea",
                        "source_entry_id": "0eb52044-ca16-3bb8-aa8c-f5289408bc80",
                        "source_sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
                        "source_sense_description": "abwertend: schlechter, unbegabter Dichter",
                        "target_lang_word": "rimeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rimeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31d11908-b752-3135-b900-2d707323c6eb",
                                        "entry_id": "1206e290-90e8-3619-8ddd-de1011c570f2",
                                        "glosses": [
                                            "Celui qui fait des vers, qui accouple des rimes."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af3e442-0391-4dbb-af51-9b2b75bd38aa",
                                                "sense_id": "31d11908-b752-3135-b900-2d707323c6eb",
                                                "text": "Mais le seul nom qui ait été sauvé de l'oubli, dans la poésie profane, est celui de ce médiocre rimeur de Mathieu-le-Juif, d'Arras, qui vivait au XIIIᵉ siècle […]."
                                            },
                                            {
                                                "example_id": "4df8dbd9-fb61-4dad-9694-003d78a21294",
                                                "sense_id": "31d11908-b752-3135-b900-2d707323c6eb",
                                                "text": "Ne demandiez-vous pas pourquoi, mademoiselle,\nContre ce seul rimeur cent hommes furent mis?\nC'est parce qu'on savait qu'il est de mes amis!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "411f7738-e298-491a-aa0d-1d4f1a202b05",
                        "source_entry_id": "0eb52044-ca16-3bb8-aa8c-f5289408bc80",
                        "source_sense_id": "1a067d8b-5d27-304e-a656-bdd78b0f98b8",
