                "senses": [
                    {
                        "sense_id": "190925bc-5106-382a-ac05-8e8b16df05e8",
                        "entry_id": "c7e3f0ee-14a4-36fd-9c65-4277f86b20a6",
                        "glosses": [
                            "Deutschland zur Zeit des Nationalsozialismus (1933–1945)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c28220bd-e95a-4f68-bb57-6e8352199f91",
                                "sense_id": "190925bc-5106-382a-ac05-8e8b16df05e8",
                                "text": "„Seit Tagen fiebert Russland dem 9. Mai entgegen, Russlands wichtigstem Feiertag gleich nach Neujahr: dem Tag des Sieges der Sowjetunion über Hitlerdeutschland.  “"
                            },
                            {
                                "example_id": "8c83e96a-175c-4eca-a913-5a43e7989dd6",
                                "sense_id": "190925bc-5106-382a-ac05-8e8b16df05e8",
                                "text": "„Die American Nazi Party wurde im März 1959 gegründet und hatte ihr Hauptquartier in Arlington (US-Bundesstaat Virginia). Dahinter stand George Lincoln Rockwell, ein glühender Nazi, der eine Pilotenausbildung absolviert und im Zweiten Weltkrieg noch gegen Hitlerdeutschland und Japan gekämpft hatte.“"
                            },
                            {
                                "example_id": "27451938-d216-4145-9de5-bf5c307fd7f0",
                                "sense_id": "190925bc-5106-382a-ac05-8e8b16df05e8",
                                "text": "„Hitlerdeutschland marschierte am 12. März 1938 mit Armee, SS und Polizei im Nachbarland ein. Die Spitzen des Staates kapitulierten unter der unmittelbaren Drohung schon am Vorabend, ‚wichen der Gewalt‘ und übergaben die Macht den Nationalsozialisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
