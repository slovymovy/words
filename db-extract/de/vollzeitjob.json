                "senses": [
                    {
                        "sense_id": "fc91798b-ceb7-30f4-9514-844ef1a42cd8",
                        "entry_id": "9e871bf3-cb90-3f81-b8e1-fa98c1086efc",
                        "glosses": [
                            "Job mit der vollen üblichen Arbeitszeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "00bb8067-3ca0-4632-a2fc-869183474342",
                                "sense_id": "fc91798b-ceb7-30f4-9514-844ef1a42cd8",
                                "text": "„Selbst wenn sie einen Vollzeitjob hätte, würde sie gerade genug verdienen, um das Schulgeld und ihre Bücher zu bezahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2e4ee1e-a2b6-3032-b13a-df3d702b86ae",
                        "entry_id": "9e871bf3-cb90-3f81-b8e1-fa98c1086efc",
                        "glosses": [
                            "zeitlich voll auslastende Tätigkeit"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e0e7b84a-1126-4d5c-af7c-302190df15a7",
                                "sense_id": "f2e4ee1e-a2b6-3032-b13a-df3d702b86ae",
                                "text": "„›Für mich klingt das nach einem Vollzeitjob.‹“"
                            },
                            {
                                "example_id": "d153859d-25e7-4074-b2b5-fcf10e4b84f3",
                                "sense_id": "f2e4ee1e-a2b6-3032-b13a-df3d702b86ae",
                                "text": "„Flowerbody hat sich bemüht, mir beizubringen, wie ich meine Trauer ›managen‹ kann. Aber Trauerarbeit wird schnell zu einem Vollzeitjob ohne Aufstiegschancen.“"
                            },
                            {
                                "example_id": "27fdad70-6956-4da7-9ad6-df3e64514ea7",
                                "sense_id": "f2e4ee1e-a2b6-3032-b13a-df3d702b86ae",
                                "text": "„Allein den Heizkessel immer wieder kaputt zu machen ist ein Vollzeitjob.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
