                    {
                        "translation_id": "b6e4cdf7-9480-4b4a-930c-b4e509e2a2d4",
                        "source_entry_id": "3cfea062-4b3d-30a7-99f6-11aa6dc643cd",
                        "source_sense_id": "f843fa94-74ef-3da2-af4d-54c702da3e2a",
                        "source_sense_description": "Religion : un des quatre ordre mineurs",
                        "target_lang_word": "Lektorat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lektorat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                                        "entry_id": "1c26e31b-422e-3874-a069-51b904f72ce5",
                                        "glosses": [
                                            "Stelle, die für die Vermittlung bestimmter Fertigkeiten zuständig ist"
                                        ],
                                        "tags": [
                                            "Universität"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf2799f-b3be-4fc1-95f8-225b674a20c1",
                                                "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                                                "text": "In den Studienfächern, in denen Sprachkenntnisse vermittelt werden müssen, sind meist Lektorate dafür zuständig."
                                            },
                                            {
                                                "example_id": "9987b97b-ce0b-4cbd-a57e-81042e6b988e",
                                                "sense_id": "270f9ae9-3fc8-3053-99ee-e80d6ecd2b1d",
                                                "text": "„Das Lektorat Deutsch als Fremdsprache bietet über 40 verschiedene studienbegleitende Deutschkurse für ausländische Studierende, DoktorandInnen [sic], GastwissenschaftlerInnen [sic] und MitarbeiterInnen [sic] der Universität Göttingen an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                        "entry_id": "1c26e31b-422e-3874-a069-51b904f72ce5",
                                        "glosses": [
                                            "Abteilung, in der eingereichte Manuskripte überprüft und gegebenenfalls mit den Autoren zusammen überarbeitet werden"
                                        ],
                                        "tags": [
                                            "Verlagswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12511a78-2b49-4a66-b760-501090b7343c",
                                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                                "text": "Viele Verlage haben Lektorate, die Manuskripte daraufhin überprüfen, ob sie bereits druckfertig sind."
                                            },
                                            {
                                                "example_id": "0899059b-df02-4800-8371-0d412e49dda5",
                                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                                "text": "„Einmal bewarb ich mich in einem kleinen Verlag, der einen studentischen Mitarbeiter für das Lektorat suchte.“"
                                            },
                                            {
                                                "example_id": "66e74c51-37ae-4ae1-a9a1-ae3a07edf262",
                                                "sense_id": "890c2ce4-c909-33be-aaac-b63fc164f28f",
                                                "text": "„Die Veränderungen, die das Lektorat dann im veröffentlichten Text vornimmt, belegen dies eindeutig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Lektorat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                        "entry_id": "64b2ce82-7e45-3d14-bd05-60bd41c27363",
                                        "glosses": [
                                            "Dienst des Vortrags der Lesungen im Gottesdienst (Dienstamt des Lektors)"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b5e779-4360-4748-82eb-05cfdcabc908",
                                                "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                                "text": "„Auf diese Weise wird es – auch für diejenigen, die sich auf den Weg zum geweihten Dienst machen – deutlicher, dass der Lektorat und der Akolythat im Sakrament der Taufe und der Firmung verwurzelt sind und dass wir auf das eingehen, was in der heutigen Zeit für die Mission verlangt wird und das Zeugnis so vieler Frauen begrüßen, die sich um den Dienst am Wort und am Altar gekümmert haben und weiterhin kümmern.“"
                                            },
                                            {
                                                "example_id": "b87daa3e-3fe8-46c5-ac7f-2df1dede7d01",
                                                "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                                "text": "„Der Lektorat, für den die ersten Zeugnisse sich erst bei Tertullian (De prasecr. 41 R 300) und Cyprian (Ep. 29 Hartel o. 548) finden, hat sich offenbar vom Diakonat abgezweigt, mit dessen Funktionen beim Lehrgottesdienst er die größte innere Verwandtschaft hat.“"
                                            },
                                            {
                                                "example_id": "e05cb9be-fb02-403e-ae7a-1e48c84c8656",
                                                "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                                "text": "„Das ist nur eine, freilich besonders akzentuierte Stellungnahme unter vielen anderen, und es ist fraglich, ob man auf Dauer den Akolythat und den Lektorat in der von ›Ministeria quaedam‹ vorgesehenen Form aufrecht erhalten kann und soll.“"
                                            },
                                            {
                                                "example_id": "d76a950e-70a0-4cf8-9c97-3746c9829ae3",
                                                "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                                "text": "„Deshalb ist es folgerichtig, dass der Papst diese Beschränkung aufgehoben hat und in Zukunft Frauen und Männer dauerhaft zu den Diensten des Lektorats und Akolythats beauftragt werden können.“"
                                            },
                                            {
                                                "example_id": "8b5acb48-a9f9-49d8-bc18-15769a11a2c2",
                                                "sense_id": "901fc5b6-fac6-3b68-ac05-430700eb8a60",
                                                "text": "„Sie versteht das Lektorat als Auftrag, trifft sich mit anderen Lektorinnen und Lektoren zum Austausch – auch über spirituelle Inhalte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
