                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a15e4028-e6d9-4b78-8877-06ef6594bdd8",
                                "sense_id": "474ee6ca-288e-3dbc-9546-8ed22c2ddcd8",
                                "text": "Une question est généralement omise : la portée du cadre spatial dans la définition des économies externes ; le cadre intra-urbain est-il significatif pour une analyse fondée sur les économies externes ?"
                            },
                            {
                                "example_id": "e5c1f02a-d3fc-4f95-b2ad-d76358f2b35d",
                                "sense_id": "474ee6ca-288e-3dbc-9546-8ed22c2ddcd8",
                                "text": "La partition spatiale ayant une grande influence sur les résultats de ce modèle de simulation des dynamiques intra-urbaines, il s'avère en effet que l'homogénéité du découpage est un facteur décisif pour le bon fonctionnement du modèle, […]."
                            }
                        ]
