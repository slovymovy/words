                "entry_id": "ed0169ef-0c46-333d-8e1f-bf7007b95359",
                "word": "tonnenweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "08dafda6-6b81-3c02-8248-b5ffe2d9397e",
                        "entry_id": "ed0169ef-0c46-333d-8e1f-bf7007b95359",
                        "glosses": [
                            "in der Menge mehrerer Tonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e3c846e-bafb-4794-bda4-254a2f312265",
                                "sense_id": "08dafda6-6b81-3c02-8248-b5ffe2d9397e",
                                "text": "„Kenias Regierung hat tonnenweise Elfenbein verbrannt.“"
                            },
                            {
                                "example_id": "375e1ddb-d884-465d-99e1-23cbe75e1ad2",
                                "sense_id": "08dafda6-6b81-3c02-8248-b5ffe2d9397e",
                                "text": "„Wer einmal nach New York fliegt und zurück, stößt vier Tonnen CO2 aus. Wer eine 130 Quadratmeter große, schlecht gedämmte Altbauwohnung beheizt, 4,6 Tonnen CO2 pro Jahr. Damit liegt dieser Mensch bereits tonnenweise über dem deutschen Durchschnitt, der bei rund elf Tonnen CO2 jährlich liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2dde2db-a6e6-30f6-9b8c-40ed5f2acd02",
                        "entry_id": "ed0169ef-0c46-333d-8e1f-bf7007b95359",
                        "glosses": [
                            "in sehr großen Mengen"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "80febddc-6a3d-4847-9127-44f84c9b3c72",
                                "sense_id": "a2dde2db-a6e6-30f6-9b8c-40ed5f2acd02",
                                "text": "Wenn ihr Schnee haben wollt, dann kommt zu uns, wir haben tonnenweise davon."
                            },
                            {
                                "example_id": "aa8e36cd-4e1c-4719-b662-09a8bdc00fde",
                                "sense_id": "a2dde2db-a6e6-30f6-9b8c-40ed5f2acd02",
                                "text": "„Sie würden auch tonnenweise Energie und harte Arbeit hineinstecken müssen, um es in ihr Traumhaus zu verwandeln, vor allem, da sie ihre Ersparnisse völlig aufgebraucht hatten und kein Geld mehr für die Handwerker übrig war.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
