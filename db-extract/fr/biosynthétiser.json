                        "glosses": [
                            "Synthétiser par des processus biologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81964fb3-9406-4898-a689-e056811cfce4",
                                "sense_id": "9a90a4e0-1b53-3fed-96e1-f151f11b7e8b",
                                "text": "En résumé, on voit qu'à la suite des travaux des cinq à six dernières années, des lignées cellulaires végétales à haute performance, sélectionnées pour leur production élevée en métabolites secondaires ou en raison de leur capacité spécifique à biosynthétiser ou à biotransformer des molécules de nature diverse, ont déjà pu être établies."
                            },
                            {
                                "example_id": "75ff8ac2-1145-4998-a6ec-7c4cf7c06ebe",
                                "sense_id": "9a90a4e0-1b53-3fed-96e1-f151f11b7e8b",
                                "text": "Certaines souches sont capables de biosynthétiser une protéase extra-cellulaire."
                            }
                        ]
                    }
