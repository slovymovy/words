                    },
                    {
                        "translation_id": "e126f530-d31d-4308-a651-eb954afba0f7",
                        "source_entry_id": "22dce9a4-462c-3122-b2d6-4c3846f2412a",
                        "source_sense_id": "7479d83d-3790-3d7a-a536-6331205ae723",
                        "target_lang_word": "solute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "solute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd11a263-de46-3521-b241-879d3e7c492e",
                                        "entry_id": "51b5ddb5-5c1f-3127-889a-68297cf6f3ac",
                                        "glosses": [
                                            "Free; liberal; loose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e163c3e-d6f8-4611-b5b9-d6880fa03d52",
                                                "sense_id": "dd11a263-de46-3521-b241-879d3e7c492e",
                                                "text": "a solute interpretation"
                                            },
                                            {
                                                "example_id": "bad8ba8b-3679-40c8-aace-2970bb605009",
                                                "sense_id": "dd11a263-de46-3521-b241-879d3e7c492e",
                                                "text": "The Interpretations of the Scriptures are of two ſorts: Methodical, and Solute, or at large, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6fd1de0-3d67-3470-9016-ea1584fd14e3",
                                        "entry_id": "51b5ddb5-5c1f-3127-889a-68297cf6f3ac",
                                        "glosses": [
                                            "Relaxed; hence, cheerful, merry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b188b967-e886-4894-880f-6813ad0b5cb2",
                                                "sense_id": "d6fd1de0-3d67-3470-9016-ea1584fd14e3",
                                                "text": "So ſung Philander, as his Friend went round / In the rich Ichor, in the gen'rous Blood / Of Bacchus, purple God of joyous Wit, / A Brow ſolute, and ever-laughing Eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc758d53-9ad3-34d2-b98d-deab5b5298b5",
                                        "entry_id": "51b5ddb5-5c1f-3127-889a-68297cf6f3ac",
                                        "glosses": [
                                            "Able to be dissolved; soluble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8ea5fd-2aca-4e21-bbf3-da6ab87480e3",
                                                "sense_id": "cc758d53-9ad3-34d2-b98d-deab5b5298b5",
                                                "text": "a solute salt"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfbe8e5-243b-3003-851c-69182c7b269d",
                                        "entry_id": "51b5ddb5-5c1f-3127-889a-68297cf6f3ac",
                                        "glosses": [
                                            "Not adhering; loose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790c4df9-7a21-44d6-9dd2-f7d2b46e5a4b",
                                                "sense_id": "1cfbe8e5-243b-3003-851c-69182c7b269d",
                                                "text": "a solute stipule"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "solute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea34bf8b-734b-32c6-84dd-6cf23013dbff",
                                        "entry_id": "64955c6b-1bd7-3689-9fb1-fe6bff0b13c6",
                                        "glosses": [
                                            "Any substance that is dissolved in a liquid solvent to create a solution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c425e3e2-4e65-4661-961b-eaff2fb22972",
                                                "sense_id": "ea34bf8b-734b-32c6-84dd-6cf23013dbff",
                                                "text": "Holonym: solution"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "solute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ea2b2d-b5f7-3789-9b26-e2bb90c30865",
                                        "entry_id": "c00e3013-3b3c-39b6-9069-a142d5235b54",
                                        "glosses": [
                                            "To dissolve."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d94bec9-3326-4648-989c-feb49fcc8e22",
                                                "sense_id": "e4ea2b2d-b5f7-3789-9b26-e2bb90c30865",
                                                "text": "In summer, the action of the air as a menstruum, is rendered so powerful by the increase of heat, that water is immediately and intimately combined with it: for when the particles of water are influenced by heat, and acted upon by a dry, warm air, they easilty rise therein, and become soluted in the atmosphere."
                                            },
                                            {
                                                "example_id": "6d53f3f2-8933-4782-aa4a-7865ae0dff44",
                                                "sense_id": "e4ea2b2d-b5f7-3789-9b26-e2bb90c30865",
                                                "text": "In the present day they hold out that the metallic calces are soluted in acids, accordingly as they possess oxygen."
                                            },
                                            {
                                                "example_id": "7ccca808-2747-4562-881c-7570cc97d4a3",
                                                "sense_id": "e4ea2b2d-b5f7-3789-9b26-e2bb90c30865",
                                                "text": "Porter, in old times, was brewed only with brown malts; from the hardness of which, and the fire they contained, Thames water seems better adapted than any other to solute the saccharine substance of those malts."
                                            },
                                            {
                                                "example_id": "420ac4fa-8d11-4d2e-ad3f-15b7238faa7c",
                                                "sense_id": "e4ea2b2d-b5f7-3789-9b26-e2bb90c30865",
                                                "text": "The difference between burnt and unburnt brick is simply this : the one becomes soluted the moment it comes in contact with water, and the other admits the moisture without becoming dissolved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                        "entry_id": "c00e3013-3b3c-39b6-9069-a142d5235b54",
                                        "glosses": [
                                            "To solve; to expose the errors of; to explain"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "928cf192-8b2a-4af8-a5ef-594b625b02a9",
                                                "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                                "text": "to solute sin"
                                            },
                                            {
                                                "example_id": "878b615a-e902-4c1a-8c12-e3c686c943fa",
                                                "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                                "text": "Because ye desire your argument to be soluted, at your own request I will take some paine: God grant it may profit!"
                                            },
                                            {
                                                "example_id": "7619c551-dd96-49f9-b1b7-9f15c7ef7937",
                                                "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                                "text": "If thys argument be not good reproue it in your answere and solute it not withe a fyre or a rope as ye vse comunly to do God send yow hys holy sprete."
                                            },
                                            {
                                                "example_id": "f235d478-5271-4568-a59b-803f0aee7678",
                                                "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                                "text": "The first Argument of them, which abuse God's Holy Predestination, is easily soluted."
                                            },
                                            {
                                                "example_id": "b89a576e-c14d-4644-a1fb-8503ccc4e07e",
                                                "sense_id": "78783c7b-dad7-3758-b42a-e22e6953d3fa",
                                                "text": "The places and arguments which are brought against him are soluted with the same solutions that they use which maintain the papacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c773efb-0231-3cf2-a750-9dc4810299d2",
                                        "entry_id": "c00e3013-3b3c-39b6-9069-a142d5235b54",
                                        "glosses": [
                                            "Alternative form of salute."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ed4b6dc-b3ac-4030-abfe-fa1358d77b3b",
                                                "sense_id": "5c773efb-0231-3cf2-a750-9dc4810299d2",
                                                "text": "To whom Ledovick the Emperour, descending from his Horse, fell down upon the Earth thrice before his feete, and the third time soluted him thus, blessed be the Lord God, who commeth in the Name of the Lord, and who hath shined upon us."
                                            },
                                            {
                                                "example_id": "a46dda4f-f123-4a34-8a32-4be0420a936a",
                                                "sense_id": "5c773efb-0231-3cf2-a750-9dc4810299d2",
                                                "text": "but yet nothing of danger visible, when in the midst of this his fear and languishing, he was by one of the Secretaries, who knew nothing of the design, called into the Kings Privy Chamber, whereupon, having soluted each of the company, as if he took his last farewell of them, going directly thither, he was no sooner entred, but the dore was boulted, and one of those who were appointed for the business, struck a dagger through his throat downward into his breast, whereby his mouth was presently filled with bloud, and stopped, that he could not speak, but only fetch so deep a groan as was heard with horror by those who stood by."
                                            },
                                            {
                                                "example_id": "a5865c26-760c-4fb8-af66-0c743a9f1c8a",
                                                "sense_id": "5c773efb-0231-3cf2-a750-9dc4810299d2",
                                                "text": "The minstrel advanced, and soluted the company with the air of one more accustomed to grant protection than crave it."
                                            },
                                            {
                                                "example_id": "e707c365-0040-46b0-84d3-2502b638964a",
                                                "sense_id": "5c773efb-0231-3cf2-a750-9dc4810299d2",
                                                "text": "Here was the antient and much-famed oracle so difficult and dangerous of access through the Libyan Deserts, consulted by Alexander the Great, who, by the flattery of the priests, was soluted as the son of Jupiter, and whose head, on some of his medals, bears a ram's horn in token of this descent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
