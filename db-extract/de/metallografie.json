                        "sense_id": "ee9eb986-6762-3283-8939-0f9d294f7155",
                        "entry_id": "4ecf3e1a-8a41-3f57-959e-582f843203f5",
                        "glosses": [
                            "Teilgebiet der Metallkunde, das sich mit der qualitativen und quantitativen Untersuchung und Beschreibung des Gefüges metallischer Werkstoffe mit Hilfe mikroskopischer Verfahren beschäftigt"
                        ],
                        "tags": [
                            "Werkstoffwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "05d61bd8-e423-4a42-aec7-554b5ed3f37f",
                                "sense_id": "ee9eb986-6762-3283-8939-0f9d294f7155",
                                "text": "In der Metallografie geschieht dies üblicherweise durch die Präparation eines Anschliffes, der auf Hochglanz poliert und auflichtmikroskopisch untersucht wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
