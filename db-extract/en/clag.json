                        "examples": [
                            {
                                "example_id": "f3c76609-2ca1-4e95-995b-18aaf7b80817",
                                "sense_id": "682a2008-7ef9-321b-9851-e65256c03415",
                                "text": "The sky was thick with dirty gray clag"
                            },
                            {
                                "example_id": "844bb60f-bce4-46fc-ad3d-e925f3545943",
                                "sense_id": "682a2008-7ef9-321b-9851-e65256c03415",
                                "text": "This programme included practice interceptions, simulator training, day flying, night flying, clag flying -- in addition to […] [a footnote states that clag flying was Air Force slang for foul weather flying.]"
                            },
                            {
                                "example_id": "bacab3db-75f8-43e4-86e2-0f14dc4431a0",
                                "sense_id": "682a2008-7ef9-321b-9851-e65256c03415",
                                "text": "We went along in the clag for what seemed like an eternity [a footnote defines clag as low cloud cover]"
                            }
                        ]
                    },
                    {
                        "sense_id": "db6cb2dd-d8ef-3c61-ad3c-cb9959b16e03",
                        "entry_id": "e00a4e49-5f44-3cee-9e89-98cf4b851063",
                        "glosses": [
                            "Unburned carbon (smoke) from a steam or diesel locomotive, or multiple unit."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f4b172ac-0b3f-33be-825a-920c74df49fd",
                        "entry_id": "e00a4e49-5f44-3cee-9e89-98cf4b851063",
                        "glosses": [
                            "Bits of rubber which are shed from tires during a race and collect off the racing line, especially on the outside of corners (cf. marbles)."
                        ],
                        "tags": [
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e37b606-f6a2-4048-ab95-701f5ba83141",
                                "sense_id": "f4b172ac-0b3f-33be-825a-920c74df49fd",
                                "text": "He ran wide in the corner, hit the clag and spun off."
                            }
                        ]
                    }
