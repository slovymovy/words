                "senses": [
                    {
                        "sense_id": "f2f087c4-cc13-3131-ae4b-84b032912d1c",
                        "entry_id": "6f3172f4-315e-3569-a382-1897fb4da332",
                        "glosses": [
                            "фигура, имеющая форму половины геометрического шара; о чём-либо, имеющем форму половины шара"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "aaf15e98-7343-3ca1-bc84-837e4fff8fc9",
                        "entry_id": "6f3172f4-315e-3569-a382-1897fb4da332",
                        "glosses": [
                            "одна из половин, на которые условно делится земной шар"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a25e5dd-c6d3-4f21-a0c4-9538b0010276",
                                "sense_id": "aaf15e98-7343-3ca1-bc84-837e4fff8fc9",
                                "text": "Начальный меридиан делит земной шар на два полушария — Восточное и Западное."
                            }
                        ]
                    },
                    {
                        "sense_id": "4846d1ab-3d38-3bfd-8bbe-98004469c563",
                        "entry_id": "6f3172f4-315e-3569-a382-1897fb4da332",
                        "glosses": [
                            "одна из половин, на которые условно делится небесная сфера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1ded16-41ca-49fd-8ea3-39858c954e69",
                                "sense_id": "4846d1ab-3d38-3bfd-8bbe-98004469c563",
                                "text": "Небесный экватор (подобно земному) делит не­бесную сферу на два полушария: Северное и Южное"
                            }
                        ]
                    }
                ],
