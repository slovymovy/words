                                        "glosses": [
                                            "A rock consisting of small crystals of olivine, pyroxene and hornblende; the major constituent of the Earth's mantle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
