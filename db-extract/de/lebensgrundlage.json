                                        "sense_id": "ef2538a7-4960-3993-977f-4423d15927d1",
                                        "entry_id": "922a9642-9415-3997-a309-9f77a1057534",
                                        "glosses": [
                                            "The absolute minimum resources necessary for long-term physical well-being, usually in terms of consumption goods."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191b31f0-4bcb-4e14-b2db-87aee53f3f5a",
                                                "sense_id": "ef2538a7-4960-3993-977f-4423d15927d1",
                                                "text": "Who then should determine basic needs? The answer seems to be the following: “The unequivocal answer is that the people themselves should decide on the scope, content and priority of their own basic needs”."
                                            }
                                        ]
                                    }
                                ]
                            }
