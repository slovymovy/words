                        "examples": [
                            {
                                "example_id": "33ae63db-c777-4c8b-b945-aff5ddec7820",
                                "sense_id": "773eb0d1-9893-3033-ba50-de78f628e754",
                                "text": "Volgens het OM ging het om een ruzie in het drugscircuit. De politie had vorig jaar april in een woning in Oosterwolde een man aangehouden. In de woning werd ook een partij van 50 kilo amfetamine en 5 kilo cocaïne in beslag genomen."
                            },
                            {
                                "example_id": "946a07c6-9f54-495a-b4b0-3a685e51429f",
                                "sense_id": "773eb0d1-9893-3033-ba50-de78f628e754",
                                "text": "Josemans zegt dat de wietpas niet alleen mensen die in coffeeshops werken hun baan kost. Veel mensen die drugs kopen, geven ook elders in de stad geld uit. Ook bij de toeleveranciers van de coffeeshops zoals kwekers en koeriers verdwijnt werkgelegenheid. Josemans sluit niet uit dat een deel van de mensen die werkloos zijn geraakt, in het illegale drugscircuit gaat werken."
                            }
                        ]
