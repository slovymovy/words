                        "entry_id": "74ec4ac9-a54f-3070-a760-38120124fb6d",
                        "glosses": [
                            "компьютерный терминал специального назначения, устанавливаемый в общественных местах"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb20484f-59ac-4835-8dbd-4901fc5cf013",
                        "source_entry_id": "74ec4ac9-a54f-3070-a760-38120124fb6d",
                        "target_lang_word": "kiosk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiosk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "010102f4-e0eb-3091-9849-f8a472e90ec0",
                                        "entry_id": "af5fedda-d588-3e0d-a9a4-a2ae8adc9f4b",
                                        "glosses": [
                                            "A small enclosed structure, often freestanding, open on one side or with a window, used as a booth to sell newspapers, cigarettes, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03df2f27-0145-4ae8-a684-589ab65ec59b",
                                                "sense_id": "010102f4-e0eb-3091-9849-f8a472e90ec0",
                                                "text": "I remember that one time I went to the kiosk next door to buy condoms, it was raining, she appeared."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ea22b1-3b4b-3f62-a8c1-2659ba45d6c2",
                                        "entry_id": "af5fedda-d588-3e0d-a9a4-a2ae8adc9f4b",
                                        "glosses": [
                                            "A similar unattended stand for the automatic dispensing of tickets, etc; an e-kiosk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e1bc56f-affa-4fcc-8fdf-a25a1042f974",
                                                "sense_id": "36ea22b1-3b4b-3f62-a8c1-2659ba45d6c2",
                                                "text": "Not only has the infamous upgrade gone by the wayside, but cashiers at fast-food restaurants are becoming increasingly uncommon. McDonald's started rolling out ordering kiosks at its US locations in 2015, and the chain hasn't looked back since: by 2020, most of its 14,000 locations will have kiosks installed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d48281e-c4ef-3c82-bdc5-82851e7a26b5",
                                        "entry_id": "af5fedda-d588-3e0d-a9a4-a2ae8adc9f4b",
                                        "glosses": [
                                            "A public telephone booth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed3b69ce-e160-350b-9668-0638bb0d1f31",
                                        "entry_id": "af5fedda-d588-3e0d-a9a4-a2ae8adc9f4b",
                                        "glosses": [
                                            "A Turkish garden pavilion."
                                        ],
