        "fr-extract.jsonl": [
            {
                "entry_id": "332f8475-618a-3268-817e-a83dbf2b26d2",
                "word": "francium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3468845-bea7-48d7-a6ed-f9dabe7a8412",
