                        "glosses": [
                            "Petit lapin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c005c63b-0f58-4b4c-8140-08c88c1dee17",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Viens découvrir des lapinons! Tu apprendras à décoder leur langage, à leur créer un petit parcours d'obstacles et à les caresser tout en les respectant."
                            },
                            {
                                "example_id": "a3fc7b6c-54ce-4512-b489-bb1383e35ec7",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Venez à la rencontre des lapinons sioux ou du gentil ours polaire, rêvez dans les nuages des oursons ou de petit oiseau pailleté, voyagez avec le flamant rose vers une contrée exotique ou encore envolez-vous dans les airs comme des aviateurs."
                            },
                            {
                                "example_id": "3a74c200-8659-400e-b00d-1e108390f527",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Lapin en papier Miss-etc. Papercraft lapin en rond de bosse. Des lapinons pour mon mariage..."
                            },
                            {
                                "example_id": "49eb2ea5-a3ae-474f-860d-552b42a53453",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Faut-il en déduire que le multipartisme a permis à des lapinons de participer à une bataille réservée aux lions ?"
                            },
                            {
                                "example_id": "daf78ec5-a4ca-4d34-8444-31867159c4f3",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "A quand les moyens de contraception dans l'Amazonie?...parce que ça copule comme des lapinons lol et ils se retrouvent vite avec 9 enfants."
                            },
                            {
                                "example_id": "60104c63-362b-4b26-b8bc-ce8583829a9f",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Oh, des lapinons !"
                            },
                            {
                                "example_id": "eb47f20f-eb4f-4bf4-b69e-d82b83578067",
                                "sense_id": "ab7ba289-7769-3584-a209-9797e4eefc0e",
                                "text": "Toi avec des chiots et moi avec des lapinons !"
                            }
                        ]
                    }
