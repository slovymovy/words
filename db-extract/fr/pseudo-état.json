                                "target_senses": [
                                    {
                                        "sense_id": "f8cd928a-4521-3dc8-bae6-e6e77a809f2a",
                                        "entry_id": "b6e88caf-72ae-3819-8dff-f0a7f6373ee5",
                                        "glosses": [
                                            "A geopolitical entity which has some of the trappings of an independently-governed country or territory, but which lacks real independence and is not recognized as a self-governing political entity by the international community of nations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fefc3199-bae7-4b11-a552-dd518137b5b4",
                                                "sense_id": "f8cd928a-4521-3dc8-bae6-e6e77a809f2a",
                                                "text": "In 1975 the state decreed that the Mfengu were really Xhosa, and that their traditional \"homeland\" was 300 miles away, in a Xhosa pseudostate called Ciskei."
                                            },
                                            {
                                                "example_id": "60c20756-5e7a-4eb4-aa58-4e90f009ed21",
                                                "sense_id": "f8cd928a-4521-3dc8-bae6-e6e77a809f2a",
                                                "text": "For Iran, Syria is a counterweight to any Sunni resurgence in Iraq, as well as the conduit to Hizbullah, its client Shiite pseudo-state in Lebanon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b360ad7-bb32-3c3d-adf8-ba4c375698dd",
                                        "entry_id": "b6e88caf-72ae-3819-8dff-f0a7f6373ee5",
                                        "glosses": [
                                            "An entity that resembles, but is not in fact, a state in a state machine or similar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b21ac36-6b02-4664-b208-c6118a469add",
                                                "sense_id": "8b360ad7-bb32-3c3d-adf8-ba4c375698dd",
                                                "text": "Every exit pseudostate that does not have an incoming transition becomes a priority relevant exit pseudostate, the other exit pseudostates become non-priority relevant exit pseudostates."
                                            }
                                        ]
                                    }
                                ]
                            }
