                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0560d3-5beb-4b7e-9944-2537dc0987d6",
                                "sense_id": "b632db0d-86a7-3993-add4-06a296f37e89",
                                "text": "C’était une semaine très étrange, relate un ex-employé, sous couvert d’anonymat."
                            },
                            {
                                "example_id": "6876a243-371c-40f0-b8cd-830c3071e22c",
                                "sense_id": "b632db0d-86a7-3993-add4-06a296f37e89",
                                "text": "Dans l'ATF 141 III 119, des ex-employés d’une banque s’opposaient à la remise par la banque de leurs données aux autorités américaines et demandaient une copie de leurs données."
                            },
                            {
                                "example_id": "79281c7d-cfb2-4bd2-9e33-2635c4868c55",
                                "sense_id": "b632db0d-86a7-3993-add4-06a296f37e89",
                                "text": "Cependant, bon nombre de leurs ex-employés étaient restés en contact, irréversiblement liés par les terribles et merveilleux moments qu’ils avaient traversés ensemble, parfois presque simultanément."
                            }
                        ]
