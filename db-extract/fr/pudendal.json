                                "example_id": "979a29a6-0137-4de3-b7bd-3998fb40c620",
                                "sense_id": "b6859519-575e-3f44-94c5-3f3600100ab0",
                                "text": "La névralgie pudendale est une affection d'origine nerveuse qui touche un nerf situé dans une région profonde de la fesse, le nerf « honteux interne », appelé aussi nerf « pudendal », du latin pudendus qui signifie honteux. Il dessert toute la région pelvienne et donc, les zones les plus intimes du corps."
                            },
                            {
                                "example_id": "01f447b8-939c-4b4e-947a-1a91411afb46",
                                "sense_id": "b6859519-575e-3f44-94c5-3f3600100ab0",
                                "text": "Nerf pudendal."
                            }
                        ]
                    }
