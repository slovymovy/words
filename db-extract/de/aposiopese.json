                "senses": [
                    {
                        "sense_id": "9e4ec17c-dc31-33e1-b21f-ba17ee2d6197",
                        "entry_id": "0546390f-8a2f-37c9-a538-919a88d1e50b",
                        "glosses": [
                            "rhetorische Figur des bewussten Abbrechens der Rede (die der Rezipient aber ergänzen kann), und die direkt vor der entscheidenden Aussage"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "14b7a327-627f-4f40-badd-9ecd09132d87",
                                "sense_id": "9e4ec17c-dc31-33e1-b21f-ba17ee2d6197",
                                "text": "In dem Beispiel „Es war eine Zeit – Laßt mich allein, Kameraden!“ erfolgt die Aposiopese bei dem Gedankenstrich."
                            },
                            {
                                "example_id": "b34029ec-b9e9-4e86-9766-982711103899",
                                "sense_id": "9e4ec17c-dc31-33e1-b21f-ba17ee2d6197",
                                "text": "„Ich hätt' ihn - ! Schwamm drüber, lass uns hier weitermachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "318fa3c8-94f6-41ec-a5d8-46e00d7a308f",
                        "source_entry_id": "0546390f-8a2f-37c9-a538-919a88d1e50b",
                        "source_sense_id": "9e4ec17c-dc31-33e1-b21f-ba17ee2d6197",
                        "source_sense_description": "rhetorische Figur des bewussten Abbrechens der Rede direkt vor der entscheidenden Aussage",
                        "target_lang_word": "aposiopesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aposiopesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                        "entry_id": "f1313449-7572-3802-b38a-8af99a999311",
                                        "glosses": [
                                            "An abrupt breaking-off in speech, often indicated in print using an ellipsis (…) or an em dash (—)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc056c89-cd67-4974-b601-c64937ca4a7f",
                                                "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                                "text": "—\"My ſiſter, mayhap,\" quoth my uncle Toby, \"does not chooſe to let a man come ſo near her ****\" Make this daſh—'tis an Apoſiopeſis.—Take the daſh away, and write Backſide,—'tis Bawdy."
                                            },
                                            {
                                                "example_id": "fc3b0c67-0a32-49bb-abec-9298ce29a705",
                                                "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                                "text": "Aposiopesis leaves imperfect sense;\nAnd, sometimes, such a pause speaks eloquence."
                                            },
                                            {
                                                "example_id": "01b2bfa4-7acd-4056-8abd-c3918eec38d5",
                                                "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                                "text": "“If you are not—” The aposiopesis was icy."
                                            },
                                            {
                                                "example_id": "3a13beca-28c8-475c-b5fd-5afc491b9d01",
                                                "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                                "text": "“Have fire in this garret before night or—” / He stopped because he could not go on. It was an aposiopesis of the purest kind."
                                            },
                                            {
                                                "example_id": "34f731fd-2819-478c-884e-2df39f549b76",
                                                "sense_id": "9f3d9e2f-0b18-3223-bd1f-c45d096a9396",
                                                "text": "This somewhat abrupt ending (or aposiopesis) is caused by a previous movement from the figure on the bed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6844fca0-89cb-4d65-80b0-1124cb876b78",
                        "source_entry_id": "0546390f-8a2f-37c9-a538-919a88d1e50b",
