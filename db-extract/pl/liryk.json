                        "glosses": [
                            "autor utworów lirycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e6900a0-0eef-44aa-ae0a-ef87ae8d4dfd",
                                "sense_id": "b19453f0-4d9b-3886-b39c-92ad3f39941d",
                                "text": "Liryków, którzy przyjechali na sympozjum o poezji Herberta, odwieziono do hotelu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff5ba08b-94c5-43c1-be3e-6388a98f48fb",
                        "source_entry_id": "40b0c83c-d5d7-3971-9874-71ef06f0c304",
                        "source_sense_id": "b19453f0-4d9b-3886-b39c-92ad3f39941d",
                        "target_lang_word": "lyricist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lyricist",
