                            {
                                "target_lang_word": "方便时",
                                "target_lang_sense_clarification": "用于表示在某人有空的时候"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2792368-ec7b-3ee1-bd03-7aa09b3b20be",
                    "sense_definition": "A useful device, service, or appliance that makes tasks easier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apartment has every modern <w>convenience</w>.",
                            "target_lang_translations": {
                                "ru": "В квартире есть все современные <w>удобства</w>.",
                                "de": "Die Wohnung verfügt über jeden modernen <w>Komfort</w>.",
                                "zh": "这间公寓拥有各种现代化的<w>便利设施</w>。"
                            }
                        },
                        {
                            "text": "A dishwasher is a great <w>convenience</w> for a large family.",
                            "target_lang_translations": {
                                "ru": "Посудомоечная машина — это огромное <w>удобство</w> для большой семьи.",
                                "de": "Eine Spülmaschine ist eine große <w>Erleichterung</w> für eine große Familie.",
                                "zh": "洗碗机对大家庭来说是一项极大的<w>便利</w>。"
                            }
                        }
