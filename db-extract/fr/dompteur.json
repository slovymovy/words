                        "entry_id": "9570c083-59d6-3532-a788-bd947ec871b4",
                        "glosses": [
                            "Celui qui dompte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23ede9ec-d08e-41f0-89f5-90b4bf77685b",
                                "sense_id": "be7f3d78-d6da-32f5-bcee-605c3ea740c2",
                                "text": "Un dompteur de fauves."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec45b858-3332-312d-ba53-887e5f88c701",
                        "entry_id": "9570c083-59d6-3532-a788-bd947ec871b4",
                        "glosses": [
                            "Celui qui fait profession de dompter les bêtes dites « féroces », ou n’importe quel animal non domestique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "420f5197-f1fd-49d6-b9ae-d4230f82d26c",
                                "sense_id": "ec45b858-3332-312d-ba53-887e5f88c701",
                                "text": "Il avait revêtu la tenue rouge galonnée d’or de l’équipage du duc, et ressemblait à ce dompteur de Médrano que j’admirais dans mon enfance."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
