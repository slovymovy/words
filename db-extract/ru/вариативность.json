                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ccabf2e-1591-4260-917b-995d3e2b2b7a",
                        "source_entry_id": "9857e672-abc1-3c72-b3a6-f8aad4a12fca",
                        "source_sense_id": "a75fc049-5f2f-3676-9b18-746e77aec6b9",
                        "target_lang_word": "variation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "variation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68946ad5-9d34-3aef-bc8f-0ed6164d96f5",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "The act of varying; a partial change in the form, position, state, or qualities of a thing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0d948e-2405-40bb-857b-8ab5a8b1769e",
                                                "sense_id": "68946ad5-9d34-3aef-bc8f-0ed6164d96f5",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72441db1-e8d4-38b8-9de8-f586a5842b9d",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "A related but distinct thing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026dbe6f-c7a2-4038-b16a-2afc308385c3",
                                                "sense_id": "72441db1-e8d4-38b8-9de8-f586a5842b9d",
                                                "text": "When the process didn't work, we tried a variation."
                                            },
                                            {
                                                "example_id": "88591e8c-99a8-42bd-8a41-dd1c4507db47",
                                                "sense_id": "72441db1-e8d4-38b8-9de8-f586a5842b9d",
                                                "text": "All of his soups are variations on a single recipe."
                                            },
                                            {
                                                "example_id": "26cb1987-aec1-4723-9539-5a7115e3149f",
                                                "sense_id": "72441db1-e8d4-38b8-9de8-f586a5842b9d",
                                                "text": "Selfishness has different variations, but in the end it is all the same."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835eb7a8-3688-3b3e-bf79-50ec4f49e234",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "The angular difference at the vessel between the direction of true north and magnetic north."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d87f62c3-8ef5-33e7-8e19-0e4e58442794",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "A line of play that differs from the original."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b358d30-dcc1-3132-8ca0-fb13afbe56ff",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "A technique where material is repeated with alterations to the melody, harmony, rhythm, timbre, texture, counterpoint or orchestration; but with some invariant characteristic, e.g. a ground bass."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ee70714-205e-3ed3-83fe-3d2297465833",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "The modification of a hereditary trait."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91d2afb6-8c3f-3901-a331-183434424605",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "Deviation from the mean orbit of a heavenly body."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6a68aed-10bc-30bd-8b11-6fd33ce8096f",
                                        "entry_id": "746e425d-4f12-3b71-ac00-c66b07d8fbf4",
                                        "glosses": [
                                            "The situation where two or more linguistic forms appear in the same environment without a change in meaning, the choice of form being determined by factors of dialect, sociolect, register or simply the speaker's preference."
