                "senses": [
                    {
                        "sense_id": "7d125bff-39c8-33d7-9a11-b3d1a0bc864a",
                        "entry_id": "0a7f8d41-5635-30c3-b9bc-dc567bbea99f",
                        "glosses": [
                            "Schweizer Kanton mit dem Hauptort Lausanne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30df10cb-05a8-49f2-96a5-ee076ab523bb",
                                "sense_id": "7d125bff-39c8-33d7-9a11-b3d1a0bc864a",
                                "text": "„Die Waadt ist nach dem Wallis der zweitgrösste Weinhersteller der Schweiz.“"
                            },
                            {
                                "example_id": "cbc22c24-2e74-4ede-b329-fe6fef127153",
                                "sense_id": "7d125bff-39c8-33d7-9a11-b3d1a0bc864a",
                                "text": "„Um die Waadt kommt man nicht herum. Breit thront das Waadtland in der Mitte der Westschweiz. Und oft fällt in Reden einheimischer Politiker das stolze Wort, die Waadt sei – zusammen mit Bern – der einzige Kanton, der an Mittelland, Alpen und Jura Anteil habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
