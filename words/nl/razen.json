                            }
                        }
                    ],
                    "synonyms": [
                        "tekeergaan",
                        "stormen"
                    ],
                    "common_phrases": [
                        "over het land razen",
                        "een razende storm"
                    ],
                    "target_lang_definitions": {
                        "en": "The passing of a natural phenomenon, such as a storm, with great violence and noise."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
                                "target_lang_sense_clarification": "to move with great violence, as a storm"
                            },
                            {
                                "target_lang_word": "roar",
                                "target_lang_sense_clarification": "to move or act with a loud, deep sound"
                            },
                            {
                                "target_lang_word": "storm",
                                "target_lang_sense_clarification": "to blow with great force"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "534b59f9-8e26-3d3c-9ed5-6b140e22cdc9",
                    "sense_definition": "uiterst boos zijn en dit met veel lawaai en heftige bewegingen uiten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur <w>raasde</w> tegen zijn personeel nadat hij het slechte nieuws hoorde.",
                            "target_lang_translations": {
                                "en": "The director <w>raged</w> at his staff after hearing the bad news."
                            }
                        },
                        {
                            "text": "Hij bleef maar <w>razen</w> en tieren totdat hij eindelijk kalmer werd.",
                            "target_lang_translations": {
                                "en": "He kept <w>ranting</w> and raving until he finally calmed down."
                            }
                        }
                    ],
                    "synonyms": [
                        "tieren",
                        "briesen",
                        "razen en tieren"
                    ],
                    "antonyms": [
                        "kalmeren",
                        "bedaren"
                    ],
                    "common_phrases": [
                        "razen en tieren"
                    ],
                    "target_lang_definitions": {
                        "en": "To be extremely angry and express this with a lot of noise and violent movements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rage",
