                        "examples": [
                            {
                                "example_id": "eaa60fa3-d12f-4e26-a047-c0eb928f6847",
                                "sense_id": "a472ae5e-63ff-3aac-8616-584989ea93ba",
                                "text": "Toen hij me aan het eind van de Koninginnedag het verdiende bedrag van bijna driehonderd gulden liet zien, vroeg ik hem geschokt hoeveel boekjes hij in godsnaam verkocht had. Nou, er waren er nog over — voor volgend jaar. Hij had vanmorgen ingezet op een riks per exemplaar. Ze bleken zo grif van de hand te gaan dat hij de prijs verhoogd had tot vijf gulden, later tot zeven vijftig. 'Niemand vond het erg.'"
                            }
                        ]
                    }
