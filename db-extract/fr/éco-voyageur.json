                "senses": [
                    {
                        "sense_id": "1bdf2bff-95a7-3512-8f8d-63fffe70593b",
                        "entry_id": "2f48b3c2-b1c8-33cb-9b4d-a53eb9903c6e",
                        "glosses": [
                            "Voyageur qui privilégie la durabilité et la responsabilité environnementale, en choisissant des destinations et des activités qui minimisent l'impact sur l'environnement et les populations locales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0448117a-9b62-44e1-98ce-82de8c2d27b0",
                                "sense_id": "1bdf2bff-95a7-3512-8f8d-63fffe70593b",
                                "text": "De plus en plus de vacanciers font le choix de devenir éco-voyageur. Ils tentent ainsi de limiter les conséquences du tourisme de masse."
                            },
                            {
                                "example_id": "b70093d1-b983-4550-afbc-5a102fd215a6",
                                "sense_id": "1bdf2bff-95a7-3512-8f8d-63fffe70593b",
                                "text": "Être éco-voyageur c’est avant tout un état d’esprit, une façon de se comporter."
                            }
                        ]
                    }
                ],
