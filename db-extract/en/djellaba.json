                        "entry_id": "c1fa5b39-2756-3a8c-9a04-acfe646a5d7f",
                        "glosses": [
                            "A loose-fitting, ankle-length hooded robe worn by men in North Africa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c83b14-edb1-4337-9311-3373bc7a505a",
                                "sense_id": "5e58d781-8649-3e04-8fd5-2ace4b838737",
                                "text": "Dignified gentlemen in sober djellabas, of excellent cut and material, their wives in equally sober djellabas, sat in the tea shops with their children and servants, sipping mint tea."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63e81295-d5c3-4703-a5df-2cd2e43514c1",
                        "source_entry_id": "c1fa5b39-2756-3a8c-9a04-acfe646a5d7f",
                        "source_sense_id": "5e58d781-8649-3e04-8fd5-2ace4b838737",
                        "source_sense_description": "robe worn by men in North Africa",
                        "target_lang_word": "Dschellaba",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dschellaba",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "861d1de1-6dc1-31b0-92fc-3ab6d7f5f1a9",
                                        "entry_id": "d87b8bb0-f0f2-33ac-a4d5-dad60f18e375",
                                        "glosses": [
                                            "weites, wollenes nordafrikanisches Kleidungsstück mit Kapuze (für Männer und Frauen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd9b5c4-2666-4ca0-891d-d0354afb55a1",
                                                "sense_id": "861d1de1-6dc1-31b0-92fc-3ab6d7f5f1a9",
                                                "text": "Er trug eine Dschellaba."
                                            },
                                            {
                                                "example_id": "60677577-e5d4-4623-b22e-a5fd8be18049",
                                                "sense_id": "861d1de1-6dc1-31b0-92fc-3ab6d7f5f1a9",
                                                "text": "„Vers 59 der 33. Sure, ‚Die Parteien‘: ‚Prophet, sag deinen Frauen und deinen Töchtern und allen Frauen der Gläubigen, dass sie die Dschellaba tragen sollen. Dies ist besser so, damit die Leute wissen, dass es sich um ehrbare Personen handelt und sie nicht belästigt werden.‘ Diesen Vers zitieren die Fundamentalisten am häufigsten, um das Tragen des Schleiers zu rechtfertigen. Es gibt sogar Übersetzungen, die von radikalen muslimischen Übersetzern absichtlich verfälscht wurden, denn sie schreiben ‚Schleier‘ anstatt ‚Dschellaba‘. - Die klassische arabische Dschellaba ist aber ein Kleidungsstück, das von den Schultern bis zu den Füssen reicht und den Kopf freilässt.“"
                                            },
                                            {
                                                "example_id": "3a8057a3-0635-46cb-b7ce-b54c865e9c75",
                                                "sense_id": "861d1de1-6dc1-31b0-92fc-3ab6d7f5f1a9",
                                                "text": "„Währenddessen gaffte ich die Berberin, deren schmale Finger am Ärmel ihrer indigofarbenen Dschellaba zupften, unverwandt an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
