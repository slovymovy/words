                        "form": "den Neuanfang"
                    },
                    {
                        "form_id": "560ff9dc-2f21-4132-9ab8-671aed605019",
                        "entry_id": "45417c83-ba2b-31ef-981d-c268e4aa965f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Neuanfänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bda6de22-77ef-3486-8ef3-86662e14cf0b",
                        "entry_id": "45417c83-ba2b-31ef-981d-c268e4aa965f",
                        "glosses": [
                            "erneuter Beginn einer Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db42ebe1-60a8-4b2b-be20-74eff829f2b8",
                                "sense_id": "bda6de22-77ef-3486-8ef3-86662e14cf0b",
                                "text": "„Ein Neuanfang macht wacher und flexibler, der gefährliche Weg in unbekanntes Gebiet lässt uns bewusster leben, wir lernen, Chancen und Risiken besser einzuschätzen.“"
                            },
                            {
                                "example_id": "5c1885f3-e9f0-4796-b5ac-183acbfaf798",
                                "sense_id": "bda6de22-77ef-3486-8ef3-86662e14cf0b",
                                "text": "„Noch lebt Schulz vom Zauber des Neuanfangs.“"
                            },
                            {
                                "example_id": "a32c56eb-6c03-49bd-be2f-504ba7b442e1",
                                "sense_id": "bda6de22-77ef-3486-8ef3-86662e14cf0b",
                                "text": "„Jetzt, nachdem er die Tonbandtexte verinnerlicht hatte, spürte er, dass die akustische Wiederbegegnung mit Almuth ihn dazu herausforderte, seinem Leben eine Wendung zu geben, einen Neuanfang oder so was zu beginnen.“"
                            },
                            {
                                "example_id": "0f9507a0-52e7-4be4-8cee-ca0b3c1ba862",
                                "sense_id": "bda6de22-77ef-3486-8ef3-86662e14cf0b",
                                "text": "„Alle späteren Versuche, einen demokratischen Neuanfang zu wagen, scheiterten an der Intoleranz der Unabhängigkeitsbewegung und der aus ihr hervorgegangenen Partei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
