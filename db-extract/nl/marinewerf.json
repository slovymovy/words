                        "glosses": [
                            "plaats waar oorlogsschepen worden gebouwd en onderhouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b231b56-658f-4225-a796-d9b0e2901162",
                                "sense_id": "8b9310b7-d9df-3b61-9499-a790b5f69913",
                                "text": "Trots toonde ze hem haar marinewerf te Chatham; de aanblik van zo veel prachtige schepen maakte grote indruk op hem, en verhevigde zonder twijfel zijn verlangen haar echtgenoot te zijn en het gezag over die schepen te hebben."
                            },
                            {
                                "example_id": "f7f92942-bd33-4cd0-b1de-04bc1300838f",
                                "sense_id": "8b9310b7-d9df-3b61-9499-a790b5f69913",
                                "text": "Prinses Beatrix kreeg De Groene Draeck toen ze achttien jaar werd. Zestig jaar geleden dus. Het schip kwam in 1957 in de vaart. Bij dit geschenk hoorde de, overigens nogal vage, toezegging dat het onderhoud ervan uit de schatkist betaald zou worden en op de Marinewerf in Den Helder zou plaats vinden. De jaarlijkse kosten daarvan bleven lang verborgen, want zaten weggestopt in de begroting van Defensie."
                            }
                        ]
                    }
