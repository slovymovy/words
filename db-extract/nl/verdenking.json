                "senses": [
                    {
                        "sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                        "entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "glosses": [
                            "het vermoeden van het uitvoeren van een (strafbaar) feit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31cd455a-c2ba-4107-a277-c564a5e7bb61",
                                "sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                                "text": "Bij de supermarkt aan de Iepenlaan in Woerden heeft de politie maandagochtend een 17-jarige jongen uit Litouwen aangehouden op verdenking van diefstal van boodschappen met een winkelwaarde van € 57,-. De dief wilde die morgen rond tien uur een winkelwagen vol boodschappen zonder te betalen de winkel uitloodsen."
                            }
                        ]
                    },
                    {
                        "sense_id": "52f07f25-2ead-382f-807e-b2165b848d64",
                        "entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "glosses": [
                            "het vermoeden van iets"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c660a00-0e46-4063-a379-e9b2adf8334c",
                        "source_entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "source_sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                        "source_sense_description": "het vermoeden van het uitvoeren van een (strafbaar) feit",
                        "target_lang_word": "Verdacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e290c1a8-829c-3694-904b-1398b74a5366",
                                        "entry_id": "5350db65-acb6-384e-b252-cd03c682c660",
                                        "glosses": [
                                            "Annahme, Vermutung, dass ein bestimmter Sachverhalt vorliege, ohne dass man es genau weiß"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24e3bff-1c76-4a8e-ad1a-cb18b9882dc0",
                                                "sense_id": "e290c1a8-829c-3694-904b-1398b74a5366",
                                                "text": "Ich habe den Verdacht, dass du dich gestern erkältet hast."
                                            },
                                            {
                                                "example_id": "4a58b2f6-ef62-44bf-b1d5-3e9b1c7ae9ad",
                                                "sense_id": "e290c1a8-829c-3694-904b-1398b74a5366",
                                                "text": "„Es fehlen unabhängige Untersuchungsgremien, die nicht von den betroffenen Institutionen geleitet werden und bei denen der Verdacht der Befangenheit gar nicht erst aufkommt.“"
                                            },
                                            {
                                                "example_id": "4bcafb4d-0662-4dd8-bcb7-15ec10b66547",
                                                "sense_id": "e290c1a8-829c-3694-904b-1398b74a5366",
                                                "text": "„Der Verdacht verdichtet sich zur Gewissheit, es müsse eine dunkle Interessengruppe hinter diesen Vorgängen stehen und bare Münze aus dem Missgeschick der gequälten Damenwelt schlagen.“"
                                            },
                                            {
                                                "example_id": "dcbc8d0a-2a62-4ad0-8a20-b58b81ee6720",
                                                "sense_id": "e290c1a8-829c-3694-904b-1398b74a5366",
                                                "text": "„Der Student Hans Langenscheidt schöpft Verdacht, geht zur Polizei und erstattet Anzeige.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b53a0196-4878-3f8e-9b33-6f23f27ebb87",
                                        "entry_id": "5350db65-acb6-384e-b252-cd03c682c660",
                                        "glosses": [
                                            "vorläufige Annahme einer rechtswidrigen Handlung oder Unterlassung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd3fc30-5a4d-406b-97b4-af249a3a3319",
                                                "sense_id": "b53a0196-4878-3f8e-9b33-6f23f27ebb87",
                                                "text": "Er steht unter dem Verdacht, die Leute betrogen zu haben."
                                            },
                                            {
                                                "example_id": "60ae2c31-a7ef-4b08-9c69-0c26786fe99b",
                                                "sense_id": "b53a0196-4878-3f8e-9b33-6f23f27ebb87",
                                                "text": "„Jeder, der im Verdacht illegaler Russlandkontakte steht, könnte unter Eid – Lieblingswaffe der Trump-Jäger – aussagen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "170fb315-5238-4ec6-80f4-1426d0e15ae9",
                        "source_entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "source_sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                        "source_sense_description": "het vermoeden van het uitvoeren van een (strafbaar) feit",
                        "target_lang_word": "suspicion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                                        "entry_id": "ca0367b6-7f23-3f4a-95df-53acd06edf62",
                                        "glosses": [
                                            "The act of suspecting something or someone, especially of something wrong."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d4b1831-5c27-4820-8a89-2068ec9953a1",
                                                "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                                                "text": "[…]purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                                            },
                                            {
                                                "example_id": "968a7ced-7fcf-418e-963f-f95d5bc692a8",
                                                "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                                                "text": "His unruly hair was slicked down with water, and as Jessamy introduced him to Miss Brindle his face assumed a cherubic innocence which would immediately have aroused the suspicions of anyone who knew him."
                                            },
                                            {
                                                "example_id": "aebb8d56-7976-44bf-8023-e61add2f2da3",
                                                "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                                                "text": "\"When it comes to strangers with guns,\" I told her, \"I think suspicion is more likely to keep you alive than trust.\""
                                            },
                                            {
                                                "example_id": "750c31f6-5aaa-4ef2-a520-63965ada44b2",
                                                "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                                                "text": "Given these entrenched ideological assumptions about the colonial order, it is no wonder that the state and those groups with an interest in the status quo viewed with suspicion and hostility any challenges to the fixed and \"natural\" boundaries between different sorts of people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dd7e303-2fd8-36ee-8373-2c543b5d4509",
                                        "entry_id": "ca0367b6-7f23-3f4a-95df-53acd06edf62",
                                        "glosses": [
                                            "The condition of being suspected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dddf07fd-2e15-3f22-a836-0910b7b54b5c",
                                        "entry_id": "ca0367b6-7f23-3f4a-95df-53acd06edf62",
                                        "glosses": [
                                            "Uncertainty, doubt."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bd3a2bb-0d99-4290-875c-691706408645",
                                                "sense_id": "dddf07fd-2e15-3f22-a836-0910b7b54b5c",
                                                "text": "In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass.[…]Strangers might enter the room, but they were made to feel that they were there on sufferance: they were received with distance and suspicion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "062ab64f-b13e-3a56-b248-ade60f403a47",
                                        "entry_id": "ca0367b6-7f23-3f4a-95df-53acd06edf62",
                                        "glosses": [
                                            "A trace, or slight indication."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f33645-306a-493d-ab2d-bd87f4a624f3",
                                                "sense_id": "062ab64f-b13e-3a56-b248-ade60f403a47",
                                                "text": "a suspicion of a smile"
                                            },
                                            {
                                                "example_id": "f2f5ad7a-c6df-4e66-9577-e47762f82e27",
                                                "sense_id": "062ab64f-b13e-3a56-b248-ade60f403a47",
                                                "text": "The features are mild but expressive, with just a suspicion[…]of saturnine or sarcastic humor."
                                            },
                                            {
                                                "example_id": "427aca79-6d6c-4c6c-862f-c00b389a88a0",
                                                "sense_id": "062ab64f-b13e-3a56-b248-ade60f403a47",
                                                "text": "Keep hot for 3 minutes, then turn right side up, polish the top with a suspicion of butter, cut in quarters, and send to table."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44267bbe-abb1-34f8-b868-79967733ef34",
                                        "entry_id": "ca0367b6-7f23-3f4a-95df-53acd06edf62",
                                        "glosses": [
                                            "The imagining of something without evidence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "suspicion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c497437-0885-3d90-bb13-66af8fbbfc9c",
                                        "entry_id": "4656ea95-cf26-37fc-b61e-93c6fc94ab25",
                                        "glosses": [
                                            "To suspect; to have suspicions."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a5de22f-3684-4631-948b-ddc5214fcca7",
                                                "sense_id": "7c497437-0885-3d90-bb13-66af8fbbfc9c",
                                                "text": "“Well, what’s more dangerous than coming here in the day time!—anybody would suspicion us that saw us.”"
                                            },
                                            {
                                                "example_id": "f6cc9da1-cbfd-4a51-abcd-04d3c4b15fc6",
                                                "sense_id": "7c497437-0885-3d90-bb13-66af8fbbfc9c",
                                                "text": "Mulvaney continued— \"Whin I was full awake the palanquin was set down in a street, I suspicioned, for I cud hear people passin' an' talkin'. But I knew well I was far from home. […]"
                                            },
                                            {
                                                "example_id": "c5dd1484-621f-491f-a104-f914ca05a37c",
                                                "sense_id": "7c497437-0885-3d90-bb13-66af8fbbfc9c",
                                                "text": "\"I've been suspicioning here was where they got their information right along,\" the sheriff commented, and slipped the handcuffs on the landlord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b63cdb7-8441-4164-8b93-6e1cf7e6f052",
                        "source_entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "source_sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                        "source_sense_description": "het vermoeden van het uitvoeren van een (strafbaar) feit",
                        "target_lang_word": "soupçon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soupçon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                        "entry_id": "accb752f-93d7-32d0-9d5c-45d550dbf486",
                                        "glosses": [
                                            "Opinion ou croyance désavantageuse, accompagnée de doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b1c96c1-35a1-4b12-b504-e19bd3f62130",
                                                "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                                "text": "Une fois entré dans la voie du soupçon, on ne s’arrête plus : aussi le landgrave, voulant, à quelque prix que ce fût, acquérir une certitude, étouffa-t-il ce sentiment généreux et instinctif qui fait que tout homme de cœur répugne à s’abaisser au métier d’espion ; […]."
                                            },
                                            {
                                                "example_id": "3dda1dea-b74d-449f-bf11-7aa193a14d88",
                                                "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                                "text": "Ses soupçons se portèrent sur l’eau, véhicule naturel des germes contagieux."
                                            },
                                            {
                                                "example_id": "95100c0f-8d2a-47ca-8411-6d9f0b86067d",
                                                "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                                "text": "Rien dans ses agissements, ses relations, n'était douteux. Plusieurs heures durant, vingt limiers du Bureau Central avaient travaillé d'arrache-pied sur cette matière, cherchant la faille par où pourrait s'insinuer le soupçon. Pour aboutir à délivrer vingt certificats de bonne vie et mœurs..."
                                            },
                                            {
                                                "example_id": "5b7db38b-23cd-44df-a1b1-687e66368563",
                                                "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                                "text": "Il fit peser les camions aux points de départ, d'arrivée, et en chemin. Cela n'éveilla pas les soupçons : on pèse les camions à des fins fiscales."
                                            },
                                            {
                                                "example_id": "4f9fb549-a215-40cf-9412-d6eac7922c27",
                                                "sense_id": "85ae74b7-4bcf-36d2-b400-e746fb2cd450",
                                                "text": "En réponse, Martin Dimitrov, de la coalition pro-européenne PP-DB, a déclaré : « Le soupçon demeure sur le fait que vous essayez de nuire à la Bulgarie avec ce référendum, de faire sortir notre pays de l’UE »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef9c1b0a-04b9-36e5-9eb7-76a58cba091a",
                                        "entry_id": "accb752f-93d7-32d0-9d5c-45d550dbf486",
                                        "glosses": [
                                            "Simple conjecture de croyances, intuition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1a690a3-effe-41f4-a3a1-0cc8e9a96bf9",
                                                "sense_id": "ef9c1b0a-04b9-36e5-9eb7-76a58cba091a",
                                                "text": "Ce n’est pas une certitude, ce n’est qu’un soupçon."
                                            },
                                            {
                                                "example_id": "247c211d-db95-4aa2-bb87-f8aa5998de72",
                                                "sense_id": "ef9c1b0a-04b9-36e5-9eb7-76a58cba091a",
                                                "text": "Ses soupçons s'avérèrent être exacts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f777b7d0-7bdf-3162-a027-1b5357980dfb",
                                        "entry_id": "accb752f-93d7-32d0-9d5c-45d550dbf486",
                                        "glosses": [
                                            "Légère apparence, légère atteinte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a7291d-c279-4aec-9c00-1900e6614b3f",
                                                "sense_id": "f777b7d0-7bdf-3162-a027-1b5357980dfb",
                                                "text": "Un soupçon de fièvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fabc506-6c4d-366d-ae5c-650b134f45d8",
                                        "entry_id": "accb752f-93d7-32d0-9d5c-45d550dbf486",
                                        "glosses": [
                                            "Très petite quantité d'une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f50234-1d6c-4837-a532-638b5bdc4536",
                                                "sense_id": "0fabc506-6c4d-366d-ae5c-650b134f45d8",
                                                "text": "Un coin du canton dans la préfecture du Schwarzenbourg, le Guggisberg, était autrefois connu pour ses costumes originaux. Les femmes portaient un tout petit colletin, un soupçon de corsage carré placé sur la poitrine comme la bavette d’un tablier, et des jupes également réduites à des proportions modestes finissant au genou et même un peu plus haut."
                                            },
                                            {
                                                "example_id": "813d90b2-c349-42ae-94df-1f517421394f",
                                                "sense_id": "0fabc506-6c4d-366d-ae5c-650b134f45d8",
                                                "text": "Le campanile de la cathédrale Notre-Dame de l’Assomption de Pise, plus connu sous le nom de Tour penchée de Pise, a cessé de s’affaisser doucement, et s’est même redressé d’un soupçon."
                                            },
                                            {
                                                "example_id": "26f471a0-df15-4490-bc22-40d512d143a8",
                                                "sense_id": "0fabc506-6c4d-366d-ae5c-650b134f45d8",
                                                "text": "— C'est bon, tu as fini de faire des cochonneries avec ton crush numéro 1 ? rigola Lila au téléphone, sans un soupçon d'animosité, de jalousie ou de malveillance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "973649c6-a9d2-47e0-a07e-9047b52bfca7",
                        "source_entry_id": "2d6607f8-cc53-3ef0-b9e4-f2de9a05d85c",
                        "source_sense_id": "12c17863-64f6-3b3d-b11d-0f5354fadbec",
                        "source_sense_description": "het vermoeden van het uitvoeren van een (strafbaar) feit",
                        "target_lang_word": "suspicion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suspicion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "110eb41f-f7f5-3819-baba-28e76c509b34",
                                        "entry_id": "613e1d99-b22a-314a-91be-208d462ba8ec",
                                        "glosses": [
                                            "Soupçon ; action de tenir pour suspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c0af6f-d923-4bb5-9a0b-6440cf01a916",
                                                "sense_id": "110eb41f-f7f5-3819-baba-28e76c509b34",
                                                "text": "Depuis le commencement de 1820, Cadiz est, aux yeux du gouvernement d’Espagne, en état de suspicion et de défiance."
                                            },
                                            {
                                                "example_id": "b5863f26-1803-422c-be37-f9488f4ad961",
                                                "sense_id": "110eb41f-f7f5-3819-baba-28e76c509b34",
                                                "text": "À contrecœur elle faisait pacte avec l’Est : « Je m’arrange avec lui », disait-elle. Mais elle demeurait pleine de suspicion et surveillait, entre tous les cardinaux et collatéraux, ce point glacé, traître, aux jeux meurtriers."
                                            },
                                            {
                                                "example_id": "8c753639-ba0c-4d43-a2dd-d3159ecbeb01",
                                                "sense_id": "110eb41f-f7f5-3819-baba-28e76c509b34",
                                                "text": "Les groupes religieux minoritaires ne sont pas forcément rejetés : les adeptes de la religion monophysite, ou les quakers ou les amishs, ne sont l'objet d'aucune suspicion."
                                            },
                                            {
                                                "example_id": "06bdcd20-7ec0-410c-aa4e-2da7ce4fa74d",
                                                "sense_id": "110eb41f-f7f5-3819-baba-28e76c509b34",
                                                "text": "Les indications des radiographies du crâne sont limitées aux suspicions d’embarrure et aux plaies profondes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
