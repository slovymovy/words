                    },
                    {
                        "translation_id": "02d78d34-467a-45d8-91b3-4cd41eb78185",
                        "source_entry_id": "fc26d202-5b84-3b13-a784-3be2260ba87b",
                        "source_sense_id": "78c9ae69-1f45-30cb-a070-09a2eeee93f8",
                        "target_lang_word": "adrenochrome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adrenochrome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0744d94-b397-3830-87b5-cff1eec8009c",
                                        "entry_id": "7c3b4ea8-38bf-39d5-96a6-5ceacd94ba2d",
                                        "glosses": [
                                            "An oxidation product of adrenaline or epinephrine; its semicarbazone is used as a drug to reduce bleeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf679147-fdc9-4775-aded-90c3a470224a",
                                                "sense_id": "d0744d94-b397-3830-87b5-cff1eec8009c",
                                                "text": "Investigation of the chemical constitution showed that it has the properties of N-methyl-2:3-dihydro-3-hydroxyindole-5:6-quinone. The shorter name adrenochrome is proposed for this substance. […] Adrenochrome is a very unstable substance: it is completely destroyed in 4 min. by 1% hydrochloric acid, and in 40 sec. by 1% ammonia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5aeb023-f799-3e5b-816c-f00dfe76f526",
                                        "entry_id": "7c3b4ea8-38bf-39d5-96a6-5ceacd94ba2d",
                                        "glosses": [
                                            "A fictional drug obtained from human adrenal glands."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d69ca1fb-63b2-4113-b578-34ad021619bc",
                                                "sense_id": "a5aeb023-f799-3e5b-816c-f00dfe76f526",
                                                "text": "“[…]He's one of these Satanism freaks. He offered me human blood—said it would make me higher than I'd ever been in my life,” he laughed. “I thought he was kidding, so I told him I'd just as soon have an ounce or so of pure adrenochrome—or maybe just a fresh adrenalin gland to chew on.”"
                                            },
                                            {
                                                "example_id": "7987917a-218d-4627-a776-dad6b85be3a4",
                                                "sense_id": "a5aeb023-f799-3e5b-816c-f00dfe76f526",
                                                "text": "It also revives old slurs, but instead of openly accusing Jews of drinking the blood of gentile children, various euphemisms are employed: “Coastal elites,” “Hollywood,” and “George Soros” are now said to be harvesting a chemical called adrenochrome to prolong their life spans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
