                                        "glosses": [
                                            "vom östlichen Mitteleuropa bis China verbreiteter, großer Falke, der besonders kleine Säugetiere und Vögel jagt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdba9d11-7f56-47ca-ac8d-155b6241dc04",
                                                "sense_id": "41fc2a46-7a5f-30f5-8296-9d842a1f95ae",
                                                "text": "„In seinem Badezimmer traten brütende Raubvögel mit Kapuzen wie Henker missmutig von einem Bein aufs andere. Ein Würgfalke. Ein Lannerfalke.“"
                                            }
