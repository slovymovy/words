                ],
                "senses": [
                    {
                        "sense_id": "0718cd05-69b3-3936-8a05-7038ce0daf82",
                        "entry_id": "2fa57a87-3035-3a03-8350-416cf5575d71",
                        "glosses": [
                            "Appareil servant à mesurer la dilatation d’un objet en fonction de la température et inversement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "470c69d5-fcdc-495a-8bca-10962514cf5b",
                                "sense_id": "0718cd05-69b3-3936-8a05-7038ce0daf82",
                                "text": "Un dilatomètre volumique."
                            },
                            {
                                "example_id": "944c9897-715f-438a-ab47-6f6fdf0e7493",
                                "sense_id": "0718cd05-69b3-3936-8a05-7038ce0daf82",
                                "text": "On a construit un dilatomètre très simple qui permet la détermination précise de la dilatation thermique des solides."
                            }
                        ]
                    },
                    {
                        "sense_id": "e587e188-96ce-3559-a4d8-536426555d23",
                        "entry_id": "2fa57a87-3035-3a03-8350-416cf5575d71",
                        "glosses": [
                            "Appareil servant à mesurer la dilatation de l’éthanol en solution et ce faisant la quantité d’éthanol contenue."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca71036a-8a15-4cf8-94cb-bc319c2adbfd",
                        "source_entry_id": "2fa57a87-3035-3a03-8350-416cf5575d71",
                        "target_lang_word": "Dilatometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dilatometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                        "entry_id": "8c21715e-b8c8-3810-b77e-f994dae014b3",
                                        "glosses": [
                                            "Messgerät zur Bestimmung der Ausdehnung einer Probe"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "619fd840-6c25-4705-bfc5-24fae95e2fbd",
                                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                                "text": "„Die thermische Ausdehnung wird im Allgemeinen mit dem Dilatometer bestimmt.“"
                                            },
                                            {
                                                "example_id": "80c9ab20-100f-4a53-bff6-623b06b7bb17",
                                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                                "text": "„Bei zyklischer Temperaturänderung ist somit eine eigentliche Umwandlungs-Hysterese zu konstatieren, wie dies am besten anhand von Ausdehnungs- und Kontraktionsmessungen mit dem Dilatometer erkannt werden kann (Figur 23).“"
                                            },
                                            {
                                                "example_id": "8a0d1555-0fbe-4020-8333-63a025bddae4",
                                                "sense_id": "da68af61-1938-3a14-a1ab-332c50a6d16c",
                                                "text": "„Zur Klärung dieser Frage werden deshalb ergänzend zur Frostprüfung Messungen der Ausdehnungskoeffizienten mit dem Dilatometer erforderlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7e6cb5ae-4cdd-3959-9dad-d361b80d21f1",
                                        "entry_id": "8c21715e-b8c8-3810-b77e-f994dae014b3",
                                        "glosses": [
                                            "Gerät zur Ermittlung des Alkoholgehalts innerhalb einer Flüssigkeit"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8bc1b63-33d9-44d5-97f6-7ca3e609edb6",
                                                "sense_id": "7e6cb5ae-4cdd-3959-9dad-d361b80d21f1",
                                                "text": "„Der Stand der Flüssigkeit im Dilatometer zeigt dann sofort den Alkoholgehalt an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
