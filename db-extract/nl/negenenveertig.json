                            {
                                "example_id": "c97be70c-1677-4b75-aff8-8681ce0f94a8",
                                "sense_id": "99b5132c-4632-3020-a898-f2d3f0b2cd39",
                                "text": "Het is weer de negenenveertig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
