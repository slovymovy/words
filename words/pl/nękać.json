{
    "word_family": [
        "nękanie",
        "nękający",
        "nękany"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d54a2bcc-0f7f-334f-9c21-ae045544ee3d",
                    "sense_definition": "powodować u kogoś silne cierpienie fizyczne lub psychiczne",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dręczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspomnienia o wypadku <w>nękały</w> go przez wiele lat po zdarzeniu.",
                            "target_lang_translations": {
                                "ru": "Воспоминания об аварии <w>терзали</w> его долгие годы после случившегося."
                            }
                        },
                        {
                            "text": "Choroba <w>nęka</w> go od dłuższego czasu, odbierając radość życia.",
                            "target_lang_translations": {
                                "ru": "Болезнь <w>мучает</w> его уже долгое время, лишая радости жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "dręczyć",
                        "trapić",
                        "męczyć"
                    ],
                    "common_phrases": [
                        "nękać chorobą",
                        "nękać wspomnieniami"
                    ],
                    "target_lang_definitions": {
                        "ru": "причинять кому-либо сильные физические или душевные страдания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "мучить, причинять сильные страдания"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять страдания, беспокойство"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "доводить до изнеможения, мучить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfc2c2b1-dd34-3ed9-b609-23d0f301aaed",
                    "sense_definition": "uporczywie niepokoić kogoś, naprzykrzać się komuś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dręczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agresywni koledzy <w>nękali</w> go w szkole każdego dnia.",
                            "target_lang_translations": {
                                "ru": "Агрессивные одноклассники <w>донимали</w> его в школе каждый день."
                            }
                        },
                        {
                            "text": "Dziennikarze <w>nękają</w> gwiazdę pytaniami o jej życie prywatne.",
                            "target_lang_translations": {
                                "ru": "Журналисты <w>преследуют</w> звезду вопросами о её личной жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "męczyć",
                        "zamęczać"
                    ],
                    "common_phrases": [
                        "nękać pytaniami"
                    ],
                    "target_lang_definitions": {
                        "ru": "настойчиво беспокоить кого-либо, надоедать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "докучать",
                                "target_lang_sense_clarification": "надоедать, навязываться"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "настойчиво беспокоить, надоедать"
                            },
                            {
                                "target_lang_word": "преследовать",
                                "target_lang_sense_clarification": "надоедать, неотступно следовать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be3d8b94-ca1d-3024-b1a3-6a439b61a074",
                    "sense_definition": "ciągle o coś prosić lub zwracać uwagę, być uciążliwym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dręczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci <w>nękały</w> rodziców prośbami o kupno nowego psa.",
                            "target_lang_translations": {
                                "ru": "Дети <w>донимали</w> родителей просьбами купить новую собаку."
                            }
                        },
                        {
                            "text": "Nie <w>nękaj</w> mnie już tymi ciągłymi uwagami o porządku.",
                            "target_lang_translations": {
                                "ru": "Не <w>приставай</w> ко мне больше с этими постоянными замечаниями о порядке."
                            }
                        }
                    ],
                    "synonyms": [
                        "męczyć",
                        "zamęczać"
                    ],
                    "common_phrases": [
                        "nękać prośbami"
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно о чем-то просить или обращать внимание, быть назойливым"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донимать",
                                "target_lang_sense_clarification": "надоедать просьбами или придирками"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "назойливо обращаться с просьбами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "010a4741-1077-390e-988a-968a183fe1da",
                    "sense_definition": "ciągle o czymś nieprzyjemnym myśleć, odczuwać niepokój",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dręczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Poczucie winy <w>nękało</w> go po podjęciu tej trudnej decyzji.",
                            "target_lang_translations": {
                                "ru": "Чувство вины <w>терзало</w> его после принятия этого трудного решения."
                            }
                        },
                        {
                            "text": "Ciągle <w>nękany</w> wyrzutami sumienia, nie mógł spokojnie zasnąć.",
                            "target_lang_translations": {
                                "ru": "Постоянно <w>мучимый</w> угрызениями совести, он не мог спокойно уснуть."
                            }
                        }
                    ],
                    "synonyms": [
                        "trapić"
                    ],
                    "common_phrases": [
                        "nękany wyrzutami sumienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "постоянно думать о чем-то неприятном, испытывать тревогу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "мучить (о мыслях, чувствах)"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "не давать покоя (о мыслях, совести)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acec6959-6084-3d4d-8dff-274eaa6c058e",
                    "sense_definition": "wzajemnie sobie dokuczać lub sprawiać cierpienie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dręczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Skłóceni małżonkowie <w>nękają</w> się nawzajem złośliwymi uwagami.",
                            "target_lang_translations": {
                                "ru": "Поссорившиеся супруги <w>изводят</w> друг друга язвительными замечаниями."
                            }
                        },
                        {
                            "text": "Przez lata <w>nękali</w> się w tym toksycznym związku.",
                            "target_lang_translations": {
                                "ru": "Годами они <w>терзали</w> друг друга в этих токсичных отношениях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно причинять друг другу неприятности или страдания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "взаимно мучить друг друга"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "взаимно причинять душевную боль"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}