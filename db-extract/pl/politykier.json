                ],
                "translations": [
                    {
                        "translation_id": "cdb5e786-2482-4774-9407-50c3325bf873",
                        "source_entry_id": "474317e1-083b-3a52-b5c4-979eff0d2eda",
                        "source_sense_id": "aff78fdb-5ff1-3fcb-ad2f-954d00aa4ffc",
                        "target_lang_word": "politicard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politicard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb57b4fd-58a3-3a2c-8bf1-8424165e42ae",
                                        "entry_id": "eeea070d-574c-3ee4-950f-3da8604e1bd5",
                                        "glosses": [
                                            "Politique, calculateur, intéressé, sans scrupules."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d339c4ba-19ee-47a9-9e63-2625dd271734",
                                                "sense_id": "eb57b4fd-58a3-3a2c-8bf1-8424165e42ae",
                                                "text": "Les grandes manoeuvres politicardes ont commencé, les élections approchent."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "politicard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a7faff3-02db-3e72-97f0-ea85069a43f9",
                                        "entry_id": "632f17f5-5f58-33c2-8d17-046e0295bcb0",
                                        "glosses": [
                                            "Professionnel de la politique. Politicien manœuvrier, sans scrupules."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1b545b-daa9-4709-b908-e8d407c6305d",
                                                "sense_id": "3a7faff3-02db-3e72-97f0-ea85069a43f9",
                                                "text": "Vouloir épouser un homme sans fortune, sans situation, un politicard sans avenir !"
                                            },
                                            {
                                                "example_id": "de672716-89b4-4a1d-a7cd-f0dd4b23cf2b",
                                                "sense_id": "3a7faff3-02db-3e72-97f0-ea85069a43f9",
                                                "text": "«Des obus, il y en a. Mais il faut que des politicards, des salauds, des ordures apposent leur signature pour qu'ils soient livrés», s'est emporté M. Prigojine."
                                            },
                                            {
                                                "example_id": "e5ee2653-30de-4c7e-9a39-f94eaced776a",
                                                "sense_id": "3a7faff3-02db-3e72-97f0-ea85069a43f9",
                                                "text": "Les gens en ont marre des politicards !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8b525f9-bcf7-409d-91a4-2c7c0c229486",
                        "source_entry_id": "474317e1-083b-3a52-b5c4-979eff0d2eda",
                        "source_sense_id": "aff78fdb-5ff1-3fcb-ad2f-954d00aa4ffc",
                        "target_lang_word": "politicastro",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "politicastro",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b5befbdf-686b-3ea0-9cfc-d2838824c89c",
                                        "entry_id": "d8bef645-e9c6-36dd-beb1-b1868389f318",
                                        "glosses": [
                                            "Persona que ejerce la política (el gobierno y los asuntos públicos) de modo ineficiente, deshonesto o para fines poco loables."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0250afa6-1f3c-4990-a08c-7c9e91546d27",
                                                "sense_id": "b5befbdf-686b-3ea0-9cfc-d2838824c89c",
                                                "text": "Ese politicastro le robó millones al país."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "669720be-c653-4d29-857f-6343bca96035",
                        "source_entry_id": "474317e1-083b-3a52-b5c4-979eff0d2eda",
