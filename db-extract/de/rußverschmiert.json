                ],
                "senses": [
                    {
                        "sense_id": "173a4296-f33a-35f5-96b2-0e77492f92ed",
                        "entry_id": "ac145ad7-58ad-3d6a-b447-2116eae9f3ef",
                        "glosses": [
                            "mit Ruß verschmiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f8d738f-9eed-4597-9726-7ad9dacd6da9",
                                "sense_id": "173a4296-f33a-35f5-96b2-0e77492f92ed",
                                "text": "„Scarsdale und ich blieben schmutzig, rußverschmiert, schwitzend und völlig ermüdet in einer schleimverkrusteten Arena zurück.“"
                            },
                            {
                                "example_id": "a3820f94-6357-42c4-9f1f-de42e091c867",
                                "sense_id": "173a4296-f33a-35f5-96b2-0e77492f92ed",
                                "text": "„Ein rußverschmierter fetter Mann kommt hustend aus dem brennenden Gebäude auf mich zu gerannt.“"
                            },
                            {
                                "example_id": "de64e3b3-05b1-4978-ad4b-088a8b8eb649",
                                "sense_id": "173a4296-f33a-35f5-96b2-0e77492f92ed",
                                "text": "„Er blickte auf. Das Gesicht rußverschmiert.“"
                            },
                            {
                                "example_id": "4b92b85a-17e8-4927-9c51-109ff1bb758c",
                                "sense_id": "173a4296-f33a-35f5-96b2-0e77492f92ed",
                                "text": "„Rußverschmierte Männer und Frauen wankten aus dem Gebäude.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
