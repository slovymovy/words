{
    "word_family": [
        "scepticisme",
        "sceptiquement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8645fb83-6d06-3248-bbdd-410ba2abe902",
                    "sense_definition": "Qui éprouve ou manifeste du doute, qui hésite à croire une affirmation sans preuves convaincantes.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré ses explications détaillées, je reste <w>sceptique</w> quant à la réussite de ce projet."
                        },
                        {
                            "text": "Le professeur a jeté un regard <w>sceptique</w> sur les excuses inventées par l'élève."
                        }
                    ],
                    "synonyms": [
                        "dubitatif",
                        "incrédule",
                        "méfiant"
                    ],
                    "antonyms": [
                        "confiant",
                        "convaincu",
                        "crédule"
                    ],
                    "common_phrases": [
                        "rester sceptique",
                        "regard sceptique",
                        "air sceptique"
                    ]
                },
                {
                    "sense_id": "796c3b7e-45fa-3bff-ab51-acaeed436f16",
                    "sense_definition": "Relatif au scepticisme, doctrine philosophique selon laquelle l'esprit humain ne peut parvenir à aucune certitude absolue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les penseurs de l'Antiquité ont développé une philosophie <w>sceptique</w> fondée sur la suspension du jugement."
                        },
                        {
                            "text": "Cette approche <w>sceptique</w> remet en question la possibilité même d'accéder à la vérité."
                        }
                    ],
                    "synonyms": [
                        "pyrrhonien"
                    ],
                    "antonyms": [
                        "dogmatique"
                    ],
                    "common_phrases": [
                        "philosophie sceptique",
                        "école sceptique"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c85b8d6a-8c39-3757-8382-d22bfc80c477",
                    "sense_definition": "Personne qui met en doute les croyances communes, les théories ou les faits non prouvés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>sceptiques</w> affirmaient que le nouveau moteur ne fonctionnerait jamais correctement."
                        },
                        {
                            "text": "Malgré les critiques initiales, le chercheur a réussi à convaincre les <w>sceptiques</w> les plus endurcis."
                        }
                    ],
                    "synonyms": [
                        "incrédule"
                    ],
                    "antonyms": [
                        "croyant",
                        "crédule"
                    ],
                    "common_phrases": [
                        "convaincre les sceptiques"
                    ]
                },
                {
                    "sense_id": "a43c9213-ca7c-34eb-ba33-314cf08e249a",
                    "sense_definition": "Doctrine ou philosophie pyrrhonienne fondée sur la suspension du jugement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce traité ancien, l'auteur examine les principes fondamentaux de la <w>sceptique</w>."
                        },
                        {
                            "text": "La <w>sceptique</w> proposait d'atteindre la paix de l'âme par la suspension de tout jugement."
                        }
                    ],
                    "synonyms": [
                        "pyrrhonisme",
                        "scepticisme"
                    ],
                    "antonyms": [
                        "dogmatisme"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare ou vieilli au féminin pour désigner la doctrine"
                        }
                    ]
                }
            ]
        }
    ]
}