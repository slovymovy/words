                "senses": [
                    {
                        "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                        "entry_id": "5ac91e56-ea6f-341b-bf68-456c0ccece19",
                        "glosses": [
                            "Krankheitsbild mit mehreren Faktoren/Symptomen (Syndrom), das Nachwirkungen/Langzeitfolgen von Covid-19 beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7645a9de-ab5d-4ac2-8f98-d9fa1d24cfb0",
                                "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                                "text": "„Hier steht neben diffusen Schmerzen und Atembeschwerden vor allem eine von vielen als bleiern bezeichnete Müdigkeit im Vordergrund, die Post-Covid-Fatigue.“"
                            },
                            {
                                "example_id": "62bcf767-4c95-4930-a45b-68229f3a7a18",
                                "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                                "text": "„Obgleich viele Menschen unter der Pandemie und ihren Folgen leiden, stellt die Post-Covid-Fatigue wahrscheinlich kein rein psychisches Problem dar.“"
                            },
                            {
                                "example_id": "92ff0098-2964-441c-8b28-803ca7eec562",
                                "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                                "text": "„Wenn es um die konkrete Behandlung der Post-Covid-Fatigue geht, kann Dr. Peter Trunzer auf jahrelange Erfahrung mit dem chronischen Fatigue-Syndrom zurückgreifen.“"
                            },
                            {
                                "example_id": "0038c714-8b26-4c52-a6ef-6c40642a3658",
                                "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                                "text": "„Litwinenko verweist aber auf eine italienische Studie, bei der zehn Wochen nach der Erkrankung noch über die Hälfte der Betroffenen an Symptomen litt. ‚Die Post-Covid-Ambulanz in Jena berichtet von 60 Prozent Patienten mit Post-Covid-Fatigue.‘“"
                            },
                            {
                                "example_id": "ec6db142-9c29-4b40-8a40-a4eea0072eee",
                                "sense_id": "111fecb1-6923-3620-8249-4688da5d2f27",
                                "text": "„Die Post-Covid-Fatigue äußert sich darin, dass sie ohne Rollator nicht gehen kann. Schon der Weg ins Bad verursacht Erschöpfung und beim Autofahren kann sie die Arme nicht am Lenkrad halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
