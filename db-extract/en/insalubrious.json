                "senses": [
                    {
                        "sense_id": "4861ceb5-7413-3145-b232-3967fe3a7807",
                        "entry_id": "e1be37dd-60d8-3c74-90b0-992c156da7ac",
                        "glosses": [
                            "Unhealthful, not providing or promoting health."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72eb1144-2f99-4344-b3e5-520feb63cf27",
                                "sense_id": "4861ceb5-7413-3145-b232-3967fe3a7807",
                                "text": "What in the name of Common Sense is to recommend Brinshore?—A most insalubrious Air—Roads proverbially detestable—Water Brackish beyond example, impossible to get a good dish of Tea within 3 miles of the place—& as for the Soil—it is so cold & ungrateful that it can hardly be made to yeild^([sic]) a Cabbage.",
                                "translation": "Sanditon",
                                "english": "Sanditon"
                            },
                            {
                                "example_id": "ddb541e8-56cb-494b-9c05-1988f2602e6a",
                                "sense_id": "4861ceb5-7413-3145-b232-3967fe3a7807",
                                "text": "But while the were a few pockets of the city centre that were desirable places in which to live, for the most part London's traditional areas were overcrowded and insalubrious."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e84fad7-f420-4be6-86dd-341ee4d74c2c",
                        "source_entry_id": "e1be37dd-60d8-3c74-90b0-992c156da7ac",
                        "source_sense_id": "4861ceb5-7413-3145-b232-3967fe3a7807",
                        "source_sense_description": "unhealthful",
                        "target_lang_word": "insalubre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insalubre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                        "entry_id": "b5aad689-b491-3a21-be18-019693a1f4ed",
                                        "glosses": [
                                            "Qualifie les lieux où la santé est en danger par suite de mauvaises conditions environnantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d55e180-5f86-4f56-a4ac-b31caf4580ee",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Du devoir pour les municipalités d'assainir les quartiers insalubres des villes manufacturières."
                                            },
                                            {
                                                "example_id": "153888c6-ace7-428f-8b25-753d0f86e832",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "Pour peu que les baigneurs se plaignent et que l’on bouche les riveaux, les prairies de Nauzan et de Bernezac redeviendront des marais insalubres."
                                            },
                                            {
                                                "example_id": "3f565daa-52c9-439c-9f47-a67fa8bd3112",
                                                "sense_id": "caf0a2db-909d-3777-a96e-7eb18492e18e",
                                                "text": "[…] les fenêtres des chambres peuvent à peine être entrouvertes et c’est ainsi que, faute d’aération, un tel établissement est insalubre pour une asthmatique invétérée comme Pep."
                                            }
                                        ]
                                    }
