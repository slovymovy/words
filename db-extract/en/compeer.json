                        "glosses": [
                            "The equal or peer of someone else; a close companion or associate."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6ce4608e-2352-4659-b6df-a20715480ec2",
                                "sense_id": "86d57c34-1815-3ca7-a9e4-73f2bb249967",
                                "text": "And him thus answer'd soon his bold compeer."
                            },
                            {
                                "example_id": "a4dabb8e-95ef-45ab-ab90-3cf825653485",
                                "sense_id": "86d57c34-1815-3ca7-a9e4-73f2bb249967",
                                "text": "She had fallen into the common error of supposing that the author must personify his works, and that his conversation must be copy and compeer of his writings."
                            }
                        ]
                    }
                ],
