                                    },
                                    {
                                        "sense_id": "bdfa40c6-96a2-316f-bb4e-a1fd9fdb3209",
                                        "entry_id": "ddb371bc-3de8-3fe9-9ff5-1bd7b18c7f1c",
                                        "glosses": [
