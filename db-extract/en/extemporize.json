                                            {
                                                "example_id": "f08a0806-eee5-42a3-9e24-0b579fc8052c",
                                                "sense_id": "14c742ed-7b21-321c-8568-d441a887ad8f",
                                                "text": "Coś tam zaimprowizował, ale Ahlgrim, słuchający czujnie, ze ściągniętymi brwiami, szybko go poprawił"
