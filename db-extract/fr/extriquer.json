                        "source_sense_id": "b59e10d6-2d25-3e18-861e-3f2f1fe5f8d3",
                        "target_lang_word": "extricate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extricate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e69f0d0-f0bb-3c54-a159-2e348ee97b56",
                                        "entry_id": "514f1ed9-0aa7-3eda-9bd0-84ee517b07e9",
                                        "glosses": [
                                            "To free, disengage, loosen, or untangle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "173a4459-2f44-4d67-8026-268538547d7f",
                                                "sense_id": "2e69f0d0-f0bb-3c54-a159-2e348ee97b56",
                                                "text": "I finally managed to extricate myself from the tight jacket."
                                            },
                                            {
                                                "example_id": "b9ef9119-5694-4ad9-b1a6-e1fe96c0ed1d",
                                                "sense_id": "2e69f0d0-f0bb-3c54-a159-2e348ee97b56",
                                                "text": "The firefighters had to use the jaws of life to extricate Monica from the car wreck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cdd106a-c7e4-3212-9757-eb0f86299c54",
                                        "entry_id": "514f1ed9-0aa7-3eda-9bd0-84ee517b07e9",
                                        "glosses": [
                                            "To free from intricacies or perplexity."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06df7af-4f4c-4823-8f45-3cd0d7426db2",
                                                "sense_id": "9cdd106a-c7e4-3212-9757-eb0f86299c54",
                                                "text": "Your argumentation ... is invelloped with certain intricacies, that are not easie to be extricated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
