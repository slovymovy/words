                        ],
                        "form": "das Amüsement"
                    },
                    {
                        "form_id": "c0ffc91d-ab85-4266-95bc-e12ba54e72e0",
                        "entry_id": "ab6987e6-5774-39f2-8e57-5c2b95a110a3",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Amüsements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                        "entry_id": "ab6987e6-5774-39f2-8e57-5c2b95a110a3",
                        "glosses": [
                            "unterhaltsamer, heiterer Zeitvertreib, häufig auch nur oberflächliches Vergnügen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288c4a95-34cb-4c85-ba8d-3c68e5300343",
                                "sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                                "text": "Aber die Frau wollte auch einmal ein Amüsement haben, war des verdrießlichen Zuhausehockens satt."
                            },
                            {
                                "example_id": "478e0d7b-433c-4b3d-b3bf-5ba6a9cd3e7d",
                                "sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                                "text": "„Es lag klar zu Tage, dass für den alten Grafen eine Stellung im Staatsdienst allein noch Rettung bedeuten konnte; so fuhr er nach Petersburg, um sich eine Stellung zu suchen und, wie er selbst sagte, den jungen Mädchen zum letzten Mal Gelegenheit zum Amüsement zu geben.“"
                            },
                            {
                                "example_id": "42b0e419-dd42-460b-bf2c-f1554573c9bf",
                                "sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                                "text": "„Großen Gefallen fand Rotermund schon als Kind an ausgefallenen, oft absurden Spielereien, die der Stiefbruder zu seinem Amüsement bei jeder Gelegenheit aus dem Ärmel zu schütteln wußte.“"
                            },
                            {
                                "example_id": "f69eebc2-aeef-42a0-9f90-bc6afdff0399",
                                "sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                                "text": "„Lillian sah den Funken von Ironie und Amüsement im Auge des Mannes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c8f4e09-c5ad-40ba-91ea-3fa01b2ff7c2",
                        "source_entry_id": "ab6987e6-5774-39f2-8e57-5c2b95a110a3",
                        "source_sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                        "source_sense_description": "unterhaltsamer, heiterer Zeitvertreib, häufig auch nur oberflächliches Vergnügen",
                        "target_lang_word": "amusement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "Entertainment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247c70fa-286d-4bef-bebb-e0e7702ea5d2",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "To my great amusement, the dog kept on chasing its tail and yelped when it bit it."
                                            },
                                            {
                                                "example_id": "0e737311-22aa-422b-bf9b-65a918b4bb94",
                                                "sense_id": "321fcd87-27d7-37e2-a6a7-d5520cb3e57a",
                                                "text": "This is some form of amusement you're talking about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                        "entry_id": "e1bca45e-7d33-3ee3-b6f5-743a380f7c24",
                                        "glosses": [
                                            "An activity that is entertaining or amusing, such as dancing, gunning, or fishing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5d70d6-fdd6-425e-afd2-45ab4bad3bd4",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "\"What a charming amusement for young people this is, Mr. Darcy! There is nothing like dancing after all. I consider it as one of the first refinements of polished society.\""
                                            },
                                            {
                                                "example_id": "0bdd7367-bdd2-498d-9848-56ca96262f11",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "His chief amusements were gunning and fishing, or sauntering along the beach and through the myrtles, in quest of shells or entomological specimens--his collection of the latter might have been envied by a Swammerdamm."
                                            },
                                            {
                                                "example_id": "7013f761-b22d-467a-bb84-05d69a48f281",
                                                "sense_id": "e4f97894-f873-3dfd-8037-c185990084d8",
                                                "text": "The Cat was sour-tempered and grumpy, at first, but before they had journeyed far, the crystal creature had discovered a fine amusement. The long tails of the monkeys were constantly sticking through the bars of their cage, and when they did, the Glass Cat would slyly seize the tails in her paws and pull them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c723c52-9f0d-437f-8f03-99d7529ba1c9",
                        "source_entry_id": "ab6987e6-5774-39f2-8e57-5c2b95a110a3",
                        "source_sense_id": "ef9b8df9-f6aa-340f-b0f9-7be6fde3df02",
                        "source_sense_description": "unterhaltsamer, heiterer Zeitvertreib, häufig auch nur oberflächliches Vergnügen",
                        "target_lang_word": "amusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                        "entry_id": "0ff6ce56-8ca1-33a1-aadc-6f7afe82aadb",
                                        "glosses": [
                                            "Ce qui amuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "550e23a6-cd16-4d6c-8da5-42792405cd39",
                                                "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                                "text": "Les apologistes de la reine la représentent comme une femme du dix-huitième siècle, aimant la vie, l’amusement, la distraction, […], mais une femme honnête et pure."
                                            },
                                            {
                                                "example_id": "c729e970-5ca3-4914-95cc-dc42e10c4106",
                                                "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                                "text": "Mais avec un petit poële net, propre, chauffé par l’électricité et pourvu de thermomètres, avec des températures absolument contrôlables et des écrans protecteurs, la cuisine pourrait devenir une distraction et un amusement même pour les dames âgées ou valétudinaires."
                                            },
                                            {
                                                "example_id": "d5d71ff0-b398-49c1-b244-d46cad068b16",
                                                "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                                "text": "Ceux-ci, d’ailleurs, un peu hautains et dédaigneux, affectaient souvent de regarder comme indignes d’eux les amusements habituels des gosses."
                                            },
                                            {
                                                "example_id": "80eafbe2-4341-450c-a230-1c1f8e403635",
                                                "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                                "text": "Le beau soldat, dans son cadre doré, avait l’air d’écouter les deux petites et d’y trouver amusement ; ses yeux étaient pleins d’une rieuse insouciance."
                                            },
                                            {
                                                "example_id": "7a77b1bf-a0f9-47ce-a228-30cb4926dd8d",
                                                "sense_id": "55be3544-385f-3732-95ac-4d79d0bd0c95",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu'un prétexte d'orgies, une occasion de plaisirs faciles, au lieu d'un amusement salutaire et convenable à la dignité de l'homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8f46df-2fac-3a51-a352-3a40acf62277",
                                        "entry_id": "0ff6ce56-8ca1-33a1-aadc-6f7afe82aadb",
                                        "glosses": [
                                            "Perte de temps, retardement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8542ae02-f0a7-4fbc-a7ce-3605c6e4ac8e",
                                                "sense_id": "1b8f46df-2fac-3a51-a352-3a40acf62277",
                                                "text": "Pas tant d’amusement, allez vite où je vous ai dit."
                                            },
                                            {
                                                "example_id": "432e9295-08a7-42a8-83ad-78f4dee1cda3",
                                                "sense_id": "1b8f46df-2fac-3a51-a352-3a40acf62277",
                                                "text": "Le moindre amusement vous peut être fatal.\nJ'ai, pour vous emmener, mon carrosse à la porte,\nAvec mille louis qu'ici je vous apporte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95fa2aa1-58d3-3a6d-b020-bf4b9e41116d",
                                        "entry_id": "0ff6ce56-8ca1-33a1-aadc-6f7afe82aadb",
                                        "glosses": [
                                            "Tromperie, promesses trompeuses."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ee9197-32d3-4b87-a96e-99ad2d3c859e",
                                                "sense_id": "95fa2aa1-58d3-3a6d-b020-bf4b9e41116d",
                                                "text": "Tout ce que vous me dites là n’est qu’un amusement."
                                            },
                                            {
                                                "example_id": "ae70ca98-eab9-4a3a-ba42-ee849264f3af",
                                                "sense_id": "95fa2aa1-58d3-3a6d-b020-bf4b9e41116d",
                                                "text": "Je suis las de tant d’amusements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d314be52-29a4-3963-9845-c4cfdd257797",
                                        "entry_id": "0ff6ce56-8ca1-33a1-aadc-6f7afe82aadb",
                                        "glosses": [
                                            "Sentiment divertissant et joyeux né de ce qui fait rire ou sourire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070a2d72-45fb-4fa9-9322-4cc7fc6a07e9",
                                                "sense_id": "d314be52-29a4-3963-9845-c4cfdd257797",
                                                "text": "Son amusement se lisait sur ses lèvres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
