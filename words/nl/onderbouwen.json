{
    "word_family": [
        "onderbouw",
        "onderbouwing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8d4f212-2b12-3d5a-bd16-459ecafeac48",
                    "sense_definition": "Argumenten, feiten of bewijzen geven om een mening, stelling of plan te ondersteunen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je stelling goed <w>onderbouwen</w> met feiten.",
                            "target_lang_translations": {
                                "en": "You need to <w>back up</w> your statement well with facts."
                            }
                        },
                        {
                            "text": "De onderzoeker kon zijn theorie overtuigend <w>onderbouwen</w> met feiten.",
                            "target_lang_translations": {
                                "en": "The researcher was able to convincingly <w>substantiate</w> his theory with facts."
                            }
                        }
                    ],
                    "synonyms": [
                        "ondersteunen"
                    ],
                    "common_phrases": [
                        "een mening onderbouwen",
                        "met feiten onderbouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "Provide arguments, facts, or evidence to support an opinion, statement, or plan."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "substantiate",
                                "target_lang_sense_clarification": "provide evidence to prove something"
                            },
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "back up an argument or claim"
                            },
                            {
                                "target_lang_word": "back up",
                                "target_lang_sense_clarification": "reinforce a statement with facts"
                            },
                            {
                                "target_lang_word": "justify",
                                "target_lang_sense_clarification": "provide reasoning for a decision or idea"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67cdfbb3-84a1-3462-849e-0a14e6cd5bea",
                    "sense_definition": "Een fysieke constructie aan de onderkant van een stevige basis of fundering voorzien.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ingenieurs moeten de brug extra <w>onderbouwen</w> vanwege de zware belasting.",
                            "target_lang_translations": {
                                "en": "The engineers must extra <w>underpin</w> the bridge due to the heavy load."
                            }
                        },
                        {
                            "text": "Het is nodig om deze oude muur goed te <w>onderbouwen</w> tegen instortingsgevaar.",
                            "target_lang_translations": {
                                "en": "It is necessary to properly <w>underpin</w> this old wall against the risk of collapse."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Provide a physical structure with a solid base or foundation underneath."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "underpin",
                                "target_lang_sense_clarification": "support a wall or building from below"
                            },
                            {
                                "target_lang_word": "undergird",
                                "target_lang_sense_clarification": "strengthen a structure underneath"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fdda40a-8c0d-3417-8092-de44c1499f6f",
                    "sense_definition": "Meststoffen in de grond inwerken of onderploegen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer moet de mest goed <w>onderbouwen</w> om de voedingstoffen in de bodem te houden.",
                            "target_lang_translations": {
                                "en": "The farmer must <w>plow under</w> the manure well to keep the nutrients in the soil."
                            }
                        },
                        {
                            "text": "In het voorjaar gaan ze de meststoffen in het veld <w>onderbouwen</w>.",
                            "target_lang_translations": {
                                "en": "In the spring, they are going to <w>work in</w> the fertilizers in the field."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "agricultural context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Work fertilizers into the soil or plow them under."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plow under",
                                "target_lang_sense_clarification": "in agriculture, incorporating manure into soil"
                            },
                            {
                                "target_lang_word": "work in",
                                "target_lang_sense_clarification": "mix fertilizer into the earth"
                            }
                        ]
                    }
                }
            ]
        },
        {
