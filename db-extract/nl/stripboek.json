                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e672f7a6-fd65-3859-9d74-e561100c746d",
                                        "entry_id": "6f23113d-e402-3abe-94cc-07868611191d",
                                        "glosses": [
                                            "A series of drawings, in sequence, often but not necessarily depicting something funny or satirical in nature; more specifically, a single work consisting of a short row of such drawings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01e134e7-1a95-3fee-96de-91eabe3d92a9",
                                        "entry_id": "6f23113d-e402-3abe-94cc-07868611191d",
                                        "glosses": [
                                            "An ongoing series of comics published in strip form, whether or not containing a continuing narrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def07385-3bbe-403a-8ecb-d1a1efec9117",
                                                "sense_id": "01e134e7-1a95-3fee-96de-91eabe3d92a9",
                                                "text": "Calvin and Hobbes was one of the most significant American comic strips of the 1980s and 1990s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d7dc3f-5076-4df6-b438-e080a7fb83f2",
                        "source_entry_id": "efb6dfd8-28fa-3bb7-9bc2-fb4cb7493397",
                        "source_sense_id": "9196bdd3-6c5c-322d-8b48-d3569f90db14",
                        "source_sense_description": "een boek met een verhaal in beeldvorm",
                        "target_lang_word": "bande dessinée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bande dessinée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8ed282-dd50-3eee-9984-125757a95410",
                                        "entry_id": "9827126d-7b6d-3df3-a7ac-cb65a61ac6f8",
                                        "glosses": [
                                            "Œuvre utilisant des images fixes non purement photographiques, généralement des dessins, articulées dans une visée narrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b9e23b-6f66-419d-b6af-4bfab751adc4",
                                                "sense_id": "cf8ed282-dd50-3eee-9984-125757a95410",
                                                "text": "C'est sous la forme d'une bande dessinée de Jean-Louis Tripp que la ville de Moissy-Cramayel a choisi de faire connaître au public les nouveaux locaux de sa médiathèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                        "entry_id": "9827126d-7b6d-3df3-a7ac-cb65a61ac6f8",
                                        "glosses": [
                                            "L’album contenant une bande dessinée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ceb61ad-30d2-441b-aff5-7bc6a75d3e3a",
                                                "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                                "text": "Quand tu l’auras finie, tu pourras me prêter ta bande dessinée ?"
                                            },
                                            {
                                                "example_id": "8d1a3a91-cefa-4734-bcc8-638836247085",
                                                "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                                "text": "Le monde de la bande dessinée est bien plus cruel qu'il n'y paraît : un nombre hallucinant d'albums afflue dans les bouclards chaque mois, et bien rares sont les titres qui parviennent à s'imposer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
