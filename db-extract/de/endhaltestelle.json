                "senses": [
                    {
                        "sense_id": "dec2ce2d-05f2-3b69-97f2-0e7ab593328b",
                        "entry_id": "8b3ce7ef-c6f7-312d-bc5f-774305999db7",
                        "glosses": [
                            "Ziel, letzter Haltepunkt eines Linienverkehrsmittels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77f4c434-3fea-4b39-ac1a-d157053ddcac",
                                "sense_id": "dec2ce2d-05f2-3b69-97f2-0e7ab593328b",
                                "text": "„Je näher die S-Bahn der Endhaltestelle kommt, desto mehr Hochhäuser säumen die Gleise, wie eine gleichförmige Armee kantiger Riesen.“"
                            },
                            {
                                "example_id": "02f0a897-6c7f-4afd-9414-879990d9a351",
                                "sense_id": "dec2ce2d-05f2-3b69-97f2-0e7ab593328b",
                                "text": "„Anscheinend befand sich hier die Endhaltestelle der Straßenbahn, obgleich die Schienen noch ein Stück weiterliefen.“"
                            },
                            {
                                "example_id": "c5279e27-7cd9-4482-8b56-6937deef30ff",
                                "sense_id": "dec2ce2d-05f2-3b69-97f2-0e7ab593328b",
                                "text": "„Ich stieg bei der Endhaltestelle auf eine Elektrische.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
