                                        "examples": [
                                            {
                                                "example_id": "3acc99b7-779a-4446-921f-d44f313d40fc",
                                                "sense_id": "01610981-a94c-3a54-85a7-1a8a154b01b6",
                                                "text": "When money comes in, stablecoin operators can exercise how and when to buy reserves. When they face redemptions, they have to act faster."
                                            }
