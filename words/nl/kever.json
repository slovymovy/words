                                "target_lang_word": "chatter",
                                "target_lang_sense_clarification": "command to talk or stop talking"
                            },
                            {
                                "target_lang_word": "nag",
                                "target_lang_sense_clarification": "command regarding complaining"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34b3e199-b2ae-306e-b305-c7213a6142e5",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>keveren</w> in inversie",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "keveren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>kever</w> je de hele tijd over dat kleine probleem?",
                            "target_lang_translations": {
                                "en": "Why do you <w>nag</w> all the time about that small problem?"
                            }
                        },
                        {
                            "text": "<w>Kever</w> je nu alweer over hetzelfde onderwerp als gisteren?",
                            "target_lang_translations": {
