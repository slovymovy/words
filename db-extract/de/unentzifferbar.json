                ],
                "senses": [
                    {
                        "sense_id": "955b5fd8-cfaa-33bb-a614-450e29de0a32",
                        "entry_id": "c3b1b3b8-fe83-3b4c-b43a-59ad35144e7c",
                        "glosses": [
                            "unmöglich zu entziffern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8662cc66-2c42-4f0e-99fd-3d41e9061dd9",
                                "sense_id": "955b5fd8-cfaa-33bb-a614-450e29de0a32",
                                "text": "„Das Gefäß wies einen Durchmesser von etwa zehn Zentimetern und einen breiten Rand auf, verziert mit schnörkeligen, unentzifferbaren Zeichen, die wie mit Säure tief eingeätzt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fafd0938-1d13-41c1-a70b-c5860d3f2f59",
                        "source_entry_id": "c3b1b3b8-fe83-3b4c-b43a-59ad35144e7c",
                        "source_sense_id": "955b5fd8-cfaa-33bb-a614-450e29de0a32",
                        "source_sense_description": "unmöglich zu entziffern",
                        "target_lang_word": "undecipherable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "undecipherable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ba6712a-cbb3-3e8f-89c4-1c245e8c8d36",
