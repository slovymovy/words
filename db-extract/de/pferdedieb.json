                    },
                    {
                        "translation_id": "65c977b3-39d7-4be1-8b5c-93ee78d9c608",
                        "source_entry_id": "05e9bdce-7235-383f-b356-a5e3cc1aa94a",
                        "source_sense_id": "8dffb942-8d31-3651-9451-045a736c2038",
