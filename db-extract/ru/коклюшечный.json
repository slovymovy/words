                "senses": [
                    {
                        "sense_id": "0cd28ad9-482a-30eb-a54d-dc96d43672e2",
                        "entry_id": "1d7703bf-3d54-3a0f-a138-ae83a939eee4",
                        "glosses": [
                            "спец. основанный на применении коклюшек либо имеющий к этим приспособлениям иное непосредственное отношение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f33f863-d2bf-4755-a996-c52235df6777",
                                "sense_id": "0cd28ad9-482a-30eb-a54d-dc96d43672e2",
                                "text": "Коклюшечные кружева."
                            },
                            {
                                "example_id": "046b4dc3-fa1c-429a-805c-461f2ac90510",
                                "sense_id": "0cd28ad9-482a-30eb-a54d-dc96d43672e2",
                                "text": "Кружевной коклюшечный промысел."
                            },
                            {
                                "example_id": "f1a50d6c-47b6-4f03-9adc-b292e40a3f50",
                                "sense_id": "0cd28ad9-482a-30eb-a54d-dc96d43672e2",
                                "text": "Гипюр в этом сезоне коклюшечный, грубоватый, но при этом узор наложен на очень тонкие вуали."
                            }
                        ]
                    }
                ],
