                "senses": [
                    {
                        "sense_id": "65c0b5be-3865-3567-b72f-e94586e0d0ee",
                        "entry_id": "8afb0eea-c022-3434-a4c3-cae6c39285af",
                        "glosses": [
                            "przedstawiciel ssaków, u których w wyniku ewolucji wykształciła się torba lęgowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20229894-43da-4a70-afd7-895e4a2d2365",
                                "sense_id": "65c0b5be-3865-3567-b72f-e94586e0d0ee",
                                "text": "Podstawową cechą odróżniającą torbacze od ssaków łożyskowych jest sposób rozrodu i rozwoju zarodka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e321d1-2d1f-4441-8688-19e6fafdc4dd",
                        "source_entry_id": "8afb0eea-c022-3434-a4c3-cae6c39285af",
                        "source_sense_id": "65c0b5be-3865-3567-b72f-e94586e0d0ee",
                        "target_lang_word": "marsupial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marsupial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e490cd6a-ab00-3283-aa08-670f7ab182b7",
                                        "entry_id": "3e6bcff4-b680-35ed-9678-6a0b77e9b235",
                                        "glosses": [
                                            "Any member of the mammalian infraclass Marsupialia, including those where the female has a pouch in which it rears its young through early infancy, such as kangaroos, koalas, wombats and opossums, as well as the pouchless shrew opossums."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marsupial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "360b8cfb-275d-3cb0-a6cf-13704e6c7f90",
                                        "entry_id": "c2f9ae8f-c2f4-39a0-af55-d85392f7fe5d",
                                        "glosses": [
                                            "Of or pertaining to a marsupial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "822d3ad4-5d5a-469e-89aa-a1183c13ea3e",
                                                "sense_id": "360b8cfb-275d-3cb0-a6cf-13704e6c7f90",
                                                "text": "Showing that this animal is marsupial, consists of the following characters."
                                            },
                                            {
                                                "example_id": "8e5e6890-be2e-408b-bd55-0b97c421cc9d",
                                                "sense_id": "360b8cfb-275d-3cb0-a6cf-13704e6c7f90",
                                                "text": "It seemed to me, meandering around Earls Court, that motors should be more marsupial."
                                            },
                                            {
                                                "example_id": "988258e0-8cef-4080-86eb-263f6ad564d5",
                                                "sense_id": "360b8cfb-275d-3cb0-a6cf-13704e6c7f90",
                                                "text": "But there's this pouch just below my belly button, very marsupial, where the kangaroo lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b331aa8d-1fe3-3288-aa74-22411f0986bc",
                                        "entry_id": "c2f9ae8f-c2f4-39a0-af55-d85392f7fe5d",
                                        "glosses": [
                                            "Of or relating to a marsupium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78677c9-cf90-49ce-83c0-8d249cb439d0",
                                                "sense_id": "b331aa8d-1fe3-3288-aa74-22411f0986bc",
                                                "text": "the marsupial bones"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e304a770-4a59-457f-ac5e-9f92e881772d",
                        "source_entry_id": "8afb0eea-c022-3434-a4c3-cae6c39285af",
                        "source_sense_id": "65c0b5be-3865-3567-b72f-e94586e0d0ee",
