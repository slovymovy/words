                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                        "glosses": [
                            "Introduit, contre le droit, dans quelque dignité ecclésiastique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f789f440-8167-4827-a38a-21a5286ae019",
                                "sense_id": "734a6f9e-0862-332a-a995-b166177d8055",
                                "text": "Un prêtre, évêque intrus, une abbesse intruse, nom donné, durant la Révolution française, aux ecclésiastiques assermentés ou constitutionnels, c’est-à-dire qui avaient prêté serment à la constitution civile du clergé."
                            },
                            {
                                "example_id": "f3df95d8-4df2-4bc3-a723-82075219040b",
                                "sense_id": "734a6f9e-0862-332a-a995-b166177d8055",
                                "text": "Si vous êtes intrus dans le lieu saint."
                            }
                        ]
                    },
                    {
                        "sense_id": "382a1632-3200-37c1-9925-aa4e18e8a862",
                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                        "glosses": [
                            "Introduit illégitimement dans quelque fonction que ce soit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56484338-45e4-43e3-88db-adbe8f4e2d54",
                                "sense_id": "382a1632-3200-37c1-9925-aa4e18e8a862",
                                "text": "Intrus dans cette charge."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6f15c99-b964-355e-ab8b-a17f50da027d",
                        "entry_id": "d9066471-2612-3037-9688-7cc6fddb1f3b",
                        "glosses": [
                            "Qui n’est pas à sa place, et dont la présence peut déranger."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f22ff7d0-498e-431c-9f8f-0b7dab41ab04",
                                "sense_id": "b6f15c99-b964-355e-ab8b-a17f50da027d",
                                "text": "Elle invente une substance merveilleuse, la nacre, en enrobe l’intruse particule pour se l’incorporer et crée ainsi la perle."
                            }
                        ]
                    }
                ],
