{
    "word_family": [
        "średnicowy",
        "średnicówka",
        "średni",
        "średnia",
        "wyśrodkować"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27c1697c-046a-3f8f-bbe3-c90ffe22eb81",
                    "sense_definition": "odcinek łączący dwa punkty na okręgu lub kuli i przechodzący przez ich środek",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nauczyciel narysował na tablicy okrąg i zaznaczył czerwoną linią jego <w>średnicę</w>.",
                            "target_lang_translations": {
                                "ru": "Учитель нарисовал на доске окружность и отметил красной линией её <w>диаметр</w>."
                            }
                        },
                        {
                            "text": "Każda <w>średnica</w> dzieli koło na dwie równe części.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>диаметр</w> делит круг на две равные части."
                            }
                        }
                    ],
                    "common_phrases": [
                        "średnica koła",
                        "średnica okręgu"
                    ],
                    "target_lang_definitions": {
                        "ru": "отрезок прямой, соединяющий две точки окружности или сферы и проходящий через их центр"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаметр",
                                "target_lang_sense_clarification": "геометрический отрезок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65f7b381-5e2f-3995-af7b-b73530429f17",
                    "sense_definition": "długość odcinka przechodzącego przez środek okręgu, koła lub obiektu cylindrycznego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometria",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rura kanalizacyjna ma <w>średnicę</w> dziesięciu centymetrów.",
                            "target_lang_translations": {
                                "ru": "Канализационная труба имеет <w>диаметр</w> десять сантиметров."
                            }
                        },
                        {
                            "text": "Zgubienie obrączki Paweł usiłował wytłumaczyć jej zbyt dużą <w>średnicą</w>.",
                            "target_lang_translations": {
                                "ru": "Потерю обручального кольца Павел пытался объяснить его слишком большим <w>диаметром</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "⌀"
                    ],
                    "common_phrases": [
                        "duża średnica",
                        "mała średnica"
                    ],
                    "target_lang_definitions": {
                        "ru": "длина отрезка, проходящего через центр круга, окружности или цилиндрического объекта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаметр",
                                "target_lang_sense_clarification": "величина, размер круглого объекта"
                            },
                            {
                                "target_lang_word": "поперечник",
                                "target_lang_sense_clarification": "толщина, размер в поперечнике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d579421-78de-368a-9ce3-3bbb6d58836d",
                    "sense_definition": "odległość między dwoma najbardziej oddalonymi od siebie punktami danej figury lub przestrzeni",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "wymiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teleskop pozwolił oszacować <w>średnicę</w> odległej asteroidy na kilkaset metrów.",
                            "target_lang_translations": {
                                "ru": "Телескоп позволил оценить <w>диаметр</w> далёкого астероида в несколько сотен метров."
                            }
                        },
                        {
                            "text": "Nowy krater uderzeniowy miał <w>średnicę</w> ponad dwudziestu metrów.",
                            "target_lang_translations": {
                                "ru": "Новый ударный кратер имел <w>диаметр</w> более двадцати метров."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "расстояние между двумя наиболее удалёнными точками геометрической фигуры или пространства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаметр",
                                "target_lang_sense_clarification": "максимальное расстояние между точками"
                            },
                            {
                                "target_lang_word": "поперечник",
                                "target_lang_sense_clarification": "наибольшая ширина объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48956d0e-8a6a-3305-9027-3f093e5a8972",
                    "sense_definition": "linia lub trasa przecinająca dany obszar, zwłaszcza miasto",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nowa trasa tramwajowa pobiegnie wzdłuż głównej <w>średnicy</w> aglomeracji.",
                            "target_lang_translations": {
                                "ru": "Новая трамвайная линия пройдёт вдоль главного <w>диаметра</w> агломерации."
                            }
                        },
                        {
                            "text": "Pociągi podmiejskie kursują przez warszawską linię średnicową, łącząc krańce miasta wzdłuż jego <w>średnicy</w>.",
                            "target_lang_translations": {
                                "ru": "Пригородные поезда курсируют по варшавской диаметральной линии, соединяя окраины города по его <w>диаметру</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "линия или маршрут, пересекающий территорию, в частности город, из конца в конец"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диаметр",
                                "target_lang_sense_clarification": "сквозная транспортная магистраль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "584e9370-42d0-3d0c-b4c9-144e11f820b0",
                    "sense_definition": "osobniki z danej grupy organizmów charakteryzujące się przeciętnymi rozmiarami",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W populacji leśnej dominowała <w>średnica</w>, podczas gdy okazy skrajnie duże należały do rzadkości.",
                            "target_lang_translations": {
                                "ru": "В лесной популяции преобладали <w>особи средних размеров</w>, в то время как исключительно крупные экземпляры были редкостью."
                            }
                        },
                        {
                            "text": "Badacze wyselekcjonowali <w>średnicę</w> stada do dalszych obserwacji behawioralnych.",
                            "target_lang_translations": {
                                "ru": "Исследователи отобрали <w>животных средней величины</w> из стада для дальнейших поведенческих наблюдений."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "особи определенной популяции, обладающие средними размерами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средний размер",
                                "target_lang_sense_clarification": "особи средних габаритов"
                            },
                            {
                                "target_lang_word": "средняя фракция",
                                "target_lang_sense_clarification": "средняя весовая или размерная группа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffc29dcb-0988-3a41-bd3a-d87a74536d75",
                    "sense_definition": "dźwięki o średniej wysokości i częstotliwości",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Akustyk skorygował brzmienie głośników, uwypuklając naturalną <w>średnicę</w> wokalu.",
                            "target_lang_translations": {
                                "ru": "Акустик скорректировал звучание динамиков, подчеркнув естественные <w>средние частоты</w> вокала."
                            }
                        },
                        {
                            "text": "W nagraniu wyraźnie brakowało basu, za to cała <w>średnica</w> brzmiała niezwykle czysto.",
                            "target_lang_translations": {
                                "ru": "В записи явно не хватало баса, зато вся <w>середина</w> звучала необычайно чисто."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "звуки средней высоты и частоты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средние частоты",
                                "target_lang_sense_clarification": "звуковой диапазон"
                            },
                            {
                                "target_lang_word": "середина",
                                "target_lang_sense_clarification": "средний частотный регистр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}