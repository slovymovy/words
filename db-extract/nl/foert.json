        "nl-extract.jsonl": [
            {
                "entry_id": "cc288843-e675-3c59-b19c-d54dfd3803a2",
                "word": "foert",
                "pos": "intj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "18835122-f6a5-33ac-9c6b-3a3df9fdd8d5",
                        "entry_id": "cc288843-e675-3c59-b19c-d54dfd3803a2",
                        "glosses": [
                            "uitdrukking die aangeeft dat je je ergens niet (meer) mee bezig wil houden"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "8fdcc8f4-c84b-4a69-a7a6-9b14cde406a6",
                                "sense_id": "18835122-f6a5-33ac-9c6b-3a3df9fdd8d5",
                                "text": "Als ik overspannen geraak moet ik soms eens leren foert zeggen."
                            },
                            {
                                "example_id": "b77dbfff-4cbd-4160-9f43-7108fea0030a",
                                "sense_id": "18835122-f6a5-33ac-9c6b-3a3df9fdd8d5",
                                "text": "Sport. Dat is voor de mannen. \"Foert met al dat sportgedoe\", zeggen de vrouwen."
                            }
                        ]
                    },
                    {
                        "sense_id": "82d8d18b-77e6-3d7f-82df-063b61e815eb",
                        "entry_id": "cc288843-e675-3c59-b19c-d54dfd3803a2",
                        "glosses": [
                            "uitroep die aangeeft dat je wil dat iemand weggaat"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "b3440334-dfc3-49d1-9d67-c6d61f13656d",
                                "sense_id": "82d8d18b-77e6-3d7f-82df-063b61e815eb",
                                "text": "Vanuit die context valt Groenewegens egelstelling gemakkelijk te begrijpen: het heeft geen zin in discussie te treden met hen die alleen wegwerpgebaren maken. Groenewegen zegt \"foert\" en schaart zich met zijns gelijken rond de tafel."
                            }
                        ]
                    },
                    {
                        "sense_id": "39bc091d-cdb7-342e-9ca0-893d0ad47767",
                        "entry_id": "cc288843-e675-3c59-b19c-d54dfd3803a2",
                        "glosses": [
                            "om een uitroep te versteken"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "eca9f4e1-e269-4a09-bcb4-2edfc09d0c05",
                                "sense_id": "39bc091d-cdb7-342e-9ca0-893d0ad47767",
                                "text": "Na die nacht sprak ze met zichzelf een droomverbod af. Ze foeterde zichzelf uit: \"Foert! Stik! Feeks! Heks!\" Die droom van het perfecte geluk teisterde Virgilia, en dwong haar om zichzelf een streng regime van zelfcontrole op te leggen. Niet alleen tijdens haar wakende leven probeerde ze haar geest te bemeesteren, ook poogde ze haar nachtelijke inferno's te beteugelen."
                            }
                        ]
                    }
                ],
