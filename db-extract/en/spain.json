        "de-extract.jsonl": [
            {
                "entry_id": "2b27506d-df13-3681-b8bd-5d8692dcd03d",
                "word": "Spain",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "97324324-9e22-3641-bea0-674d632ba984",
                        "entry_id": "2b27506d-df13-3681-b8bd-5d8692dcd03d",
                        "glosses": [
                            "Land auf der Iberischen Halbinsel in Südwesteuropa; Spanien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62af885d-3545-4da8-8f53-18525bd1c318",
                                "sense_id": "97324324-9e22-3641-bea0-674d632ba984",
                                "text": "The only bordering countries from Spain are Portugal, France, Gibraltar and Andorra.",
                                "translation": "Die einzigen Nachbarstaaten von Spanien sind Portugal, Frankreich, Gibraltar und Andorra."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed7d0803-b363-4962-99da-1ed99fb60484",
                        "source_entry_id": "2b27506d-df13-3681-b8bd-5d8692dcd03d",
                        "source_sense_id": "97324324-9e22-3641-bea0-674d632ba984",
                        "source_sense_description": "Land auf der Iberischen Halbinsel in Südwesteuropa; Spanien",
                        "target_lang_word": "Spanien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spanien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                        "entry_id": "b16bc7ff-d1dd-3441-90db-fbcc0177d5f1",
                                        "glosses": [
                                            "Staat in Südwesteuropa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a34b29ec-9800-4dac-b3e5-8d933d8d31f4",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Spaniens Himmel breitet seine Sterne // über unsre Schützengräben aus. // Und der Morgen grüßt schon aus der Ferne, // bald geht es zu neuem Kampf hinaus.“"
                                            },
                                            {
                                                "example_id": "bfbe7617-4e69-4686-94a2-bcc5a14c03af",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Zwar hat die Internationalisierung der Lebensstile auch Spanien voll erfaßt, doch die ungebrochene Existenz des baskischen, katalanischen oder galizischen Nationalismus, die sich auf zum Teil antike, in jedem Falle aber auf mittelalterliche Ursprünge zurückführen lassen, belegen die Persistenz lokaler und regionaler Identitäten …“"
                                            },
                                            {
                                                "example_id": "37f452f0-3b60-45c8-9878-ebbccf8a0463",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Unter den deutschen Geldhäusern ist nach der Hypo Real Estate (HRE) die DZ Bank am stärksten in Staatsanleihen der schuldengeplagten Länder Portugal, Irland, Griechenland und Spanien (PIGS) engagiert.“"
                                            },
                                            {
                                                "example_id": "055d9ffd-a38b-4951-875f-280cde7cbbe5",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Um Spanien zum blühendsten aller Königreiche der Erde zu machen, müßte man es erobern, es in seinen Grundfesten erschüttern und fast zerstören; dann würde es nach seiner Wiedergeburt ein Land für glückliche Menschen werden.“"
                                            },
                                            {
                                                "example_id": "42054a32-612f-4218-b4df-d60d0dcd0f44",
                                                "sense_id": "5c2a3425-6573-3939-8661-f71113df42d6",
                                                "text": "„Danach konnte sie sich einfach nicht mehr auf ihren Essay über Spanien konzentrieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c019309f-6e6c-4055-9c0b-b8db2d62f1d7",
                        "source_entry_id": "2b27506d-df13-3681-b8bd-5d8692dcd03d",
                        "source_sense_id": "97324324-9e22-3641-bea0-674d632ba984",
                        "source_sense_description": "Land auf der Iberischen Halbinsel in Südwesteuropa; Spanien",
                        "target_lang_word": "España",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "España",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "594fdaa1-8b55-3d90-bf0d-65ca977f85da",
                                        "entry_id": "f7f19c63-dc01-3250-a469-6606e138c46d",
                                        "glosses": [
                                            "País ubicado en el suroeste de Europa, que ocupa la mayoría de la península ibérica. Limita al oeste con Portugal y el océano Atlántico, al norte con el mar Cantábrico, Francia y Andorra y al este y sur con el mar Mediterráneo. Lo integran también las Islas Baleares, las Islas Canarias y las ciudades de Ceuta y Melilla."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ba3365-b0a3-42ce-a290-9cce9123deab",
                                                "sense_id": "594fdaa1-8b55-3d90-bf0d-65ca977f85da",
                                                "text": "—¿Cómo os han acogido aquí en España?\n—Mucho más intenso que en Uruguay; la gente es muy tranquila; por ejemplo, me saluda, me reconoce […] (extraído de entrevista realizada por RTV)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cd49de23-ea19-359e-8548-bf1ba5cb4d2e",
                                        "entry_id": "f7f19c63-dc01-3250-a469-6606e138c46d",
                                        "glosses": [
                                            "Apellido."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
