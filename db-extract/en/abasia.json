                "senses": [
                    {
                        "sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                        "entry_id": "82c85cb9-df4d-3135-840e-8d57e9e192da",
                        "glosses": [
                            "An inability to walk due to a defect in muscular coordination."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "50b54af1-d464-436d-896e-3f962c5aa4ba",
                                "sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                                "text": "The patient is able to move her legs while lying down but has abasia when she stands up."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d26c42a0-b982-4b78-bcb5-1585e4f7334e",
                        "source_entry_id": "82c85cb9-df4d-3135-840e-8d57e9e192da",
                        "source_sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                        "source_sense_description": "incapacity to walk",
                        "target_lang_word": "abasie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "feab4ec0-a0df-3c6e-a483-35a852e6fc71",
                                        "entry_id": "56f0ccc8-9637-3bad-916d-8dff075b4283",
                                        "glosses": [
                                            "aandoening waarbij je niet goed kan blijven lopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf1975f5-596e-464a-a32b-f0fd0f0df072",
                                                "sense_id": "feab4ec0-a0df-3c6e-a483-35a852e6fc71",
                                                "text": "Ook de sectievergaderingen werden druk bezocht. In die voor neurologie en psychiatrie voerde onder anderen dr. Thijssen het woord over astasie en abasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a11c484-4f72-4d2e-8963-01f135c8b942",
                        "source_entry_id": "82c85cb9-df4d-3135-840e-8d57e9e192da",
                        "source_sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                        "source_sense_description": "incapacity to walk",
                        "target_lang_word": "abasie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abasie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                        "entry_id": "af2bf1c5-c0a1-3eef-910e-0cde0f3c561c",
                                        "glosses": [
                                            "Perte plus ou moins complète de la faculté de marcher, d'origine neurologique ou psychologique, mais sans trouble de la force musculaire ni de la sensibilité. Elle coïncide généralement avec l’astasie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0efb7fb3-3719-4a1b-b084-eaade285515f",
                                                "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                                "text": "Il s’agissait d’une banale histoire de secousses morales qui n’expliquait ni pourquoi l’intéressée devait être atteinte d’hystérie, ni pour quelle raison l’hystérie avait justement pris la forme d’une abasie."
                                            },
                                            {
                                                "example_id": "f20ce89b-8dd4-4046-95bd-5e54aa45d8ab",
                                                "sense_id": "389652a1-70f0-3487-8572-bbee7df9541d",
                                                "text": "Lacan, associé à Trenel, fait une communication à la Société de Neurologie de Paris, sur un cas d'abasie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07494751-7c6a-4d0d-aad2-e5abc508c260",
                        "source_entry_id": "82c85cb9-df4d-3135-840e-8d57e9e192da",
                        "source_sense_id": "e9253ab2-5781-339c-9232-c99ccb5fb7cf",
                        "source_sense_description": "incapacity to walk",
                        "target_lang_word": "Abasie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
