        "nl-extract.jsonl": [
            {
                "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                "word": "capitulatie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "8a661ebe-21bd-466b-875e-199f1bad71e1",
                        "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "tags": [
                            "plural"
                        ],
                        "form": "capitulaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cd96b65-3b3b-3749-a214-b3ab472d06cb",
                        "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "glosses": [
                            "internationaalrechtelijke verklaring dat een partij de strijd tijdens een oorlog opgeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98bd81f9-5f07-4281-8991-4154c458e7c5",
                                "sense_id": "7cd96b65-3b3b-3749-a214-b3ab472d06cb",
                                "text": "Sommigen hadden het nog wel over een robbertje vechten met de vijand, maar in de lagere regionen waar Albert en zijn kameraden zaten, was men sinds de overwinning van de geallieerden in Vlaanderen, de bevrijding van Lille, de Oostenrijkse aftocht en de capitulatie van de Turken meestal een stuk minder uitbundig dan de officieren."
                            },
                            {
                                "example_id": "014373bb-5a3d-4ef7-8be8-20058368ad63",
                                "sense_id": "7cd96b65-3b3b-3749-a214-b3ab472d06cb",
                                "text": "Het deed hem bijna plezier, gaf hij tenminste voor zichzelf toe, hij zou het niet hardop zeggen, om te lezen hoe de Franse generaals en politici gedwongen waren hun capitulatie te ondertekenen in dezelfde spoorwagon waarin ze het begin van die vreselijke Vrede van Versailles hadden gedicteerd."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d47b0e0-bc85-3dc8-8fc4-47a37c96d70c",
                        "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "glosses": [
                            "verdrag waarin een staat afstand doet van jurisdictie binnen zijn grenzen over de onderdanen van een andere staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "defc2ac6-4b74-4a34-afbd-2d80b3b3d63b",
                                "sense_id": "4d47b0e0-bc85-3dc8-8fc4-47a37c96d70c",
                                "text": "Ten gevolge van de opheffing der capitulaties zijn thans ongeveer 4500 in Japan gevestigde blanken onder de Japansche rechtspraak gekomen; van dezen hebben de Engelschen de meerderheid: 1800, terwijl het aantal Amerikanen ongeveer 1000 en dat der Duitschers slechts 500 bedraagt. Het eerste geval waarin eene Japansche rechtbank een vreemdeling zal hebben te vonnissen is dat van een Amerikaan, die een landgenoot en twee Japansche vrouwen heeft vermoord. Een niet onaardig begin!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f38d5a9f-6f77-355a-81be-92797e3d7f23",
                        "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "glosses": [
                            "belofte, vaak in de vorm van een eed, van een kandidaat-bestuurder aan stemgerechtigden om in geval van verkiezing een aantal zaken te regelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e4eef55-a985-47c1-be9d-23b0068b6510",
                                "sense_id": "f38d5a9f-6f77-355a-81be-92797e3d7f23",
                                "text": "In het na den dood van Martinus gehouden conclave stelden de kardinalen een capitulatie vast, d.w.z. verschillende voorwaarden, die de toekomstige Paus moest onderhouden."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3fcc682-5495-3ab8-8196-7870a17576aa",
                        "entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "glosses": [
                            "contract waarbij een soevereine staat een of meerdere legereenheden verhuurt aan een andere staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fed48e05-6de6-4085-af4b-627c9c9cdd07",
                                "sense_id": "e3fcc682-5495-3ab8-8196-7870a17576aa",
                                "text": "23 september 1814. Capitulatie gesloten met kanton Bern tot indiensttreding van het Regiment Zwitsers van Jean Louis Nicolas de Jenner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ad9337d-0763-4a5e-a3bd-3d4069a5a369",
                        "source_entry_id": "3294c0ea-1981-3e23-8509-9506d0665df1",
                        "source_sense_id": "7cd96b65-3b3b-3749-a214-b3ab472d06cb",
                        "source_sense_description": "internationaalrechtelijke verklaring dat een partij de strijd tijdens een oorlog opgeeft",
                        "target_lang_word": "Kapitulation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kapitulation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                        "entry_id": "fa31c312-b51a-3fba-a76f-a5b3e4751ca1",
                                        "glosses": [
                                            "Handlung, sich für militärisch besiegt zu erklären (Kapitulationen können nur von Kommandanten größerer selbständiger Einheiten unterzeichnet werden)"
                                        ],
                                        "tags": [
                                            "Kriegsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a0bf5b5-4e1a-43ad-846f-1f7d2f6643a4",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "Die deutsche Kapitulation im Zweiten Weltkrieg wurde am 08. Mai 1945 unterzeichnet."
                                            },
                                            {
                                                "example_id": "2a4e83d1-995c-4f6b-9f25-8c78e6962a98",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "Die bedingungslose Kapitulation ist militärisch die größte Schande."
                                            },
                                            {
                                                "example_id": "a4902d18-b263-41ef-a665-540a20f2c1cc",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "„Auch Stalin grollte im Kreml. Denn ihm paßte die Kapitulation der deutschen Heeresgruppe in Italien überhaupt nicht in seine strategischen Überlegungen.“"
                                            },
                                            {
                                                "example_id": "666b88fc-ba57-4901-82ef-7bd1968388e8",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "„Die Existenz dieser Gerüchte zeigt, wie konsequent die Siegermächte auch nach der bedingungslosen Kapitulation Deutschlands über ihre Nachkriegspläne Stillschweigen bewahren.“"
                                            },
                                            {
                                                "example_id": "a2b32cd3-8fd3-4824-8d5a-0157765de3ac",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "„Mit der Niederlage und Kapitulation hatte das nichts mehr zu tun.“"
                                            },
                                            {
                                                "example_id": "bafd7b86-3704-4dc1-aa3f-1f1f1b86de3d",
                                                "sense_id": "3ca9408a-7aaf-3185-a9d0-00c7df19d2fe",
                                                "text": "„Er ist hier, am vorsorglich verabredeten Ort; bald nach der Kapitulation wurde er aus der Gefangenschaft entlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "676ad204-9063-3e2d-9777-f548c83c11e3",
                                        "entry_id": "fa31c312-b51a-3fba-a76f-a5b3e4751ca1",
                                        "glosses": [
                                            "Vertrag zur Beendigung eines militärischen Konfliktes, in welchem sich ein Vertragspartner den Anordnungen des anderen Vertragspartners unterwirft"
                                        ],
                                        "tags": [
                                            "Völkerrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82e22072-740a-473f-8300-785c63c552b0",
                                                "sense_id": "676ad204-9063-3e2d-9777-f548c83c11e3",
                                                "text": "Die Kapitulation ist eine Unterwerfungserklärung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "da3cb5d0-4d66-3e61-a7d4-ea76c08f2dbc",
                                        "entry_id": "fa31c312-b51a-3fba-a76f-a5b3e4751ca1",
                                        "glosses": [
                                            "völlige Aufgabe der eigenen Position in einer Auseinandersetzung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95271b8-f92c-4a5d-b39a-0442b73c9155",
                                                "sense_id": "da3cb5d0-4d66-3e61-a7d4-ea76c08f2dbc",
                                                "text": "„So sehen Prohibitionsbefürworter in Legalisierungsvorschlägen eine Kapitulation vor dem Drogenproblem.“"
                                            },
                                            {
                                                "example_id": "89ca5a18-13fc-4323-b1cb-235eb61a265c",
                                                "sense_id": "da3cb5d0-4d66-3e61-a7d4-ea76c08f2dbc",
                                                "text": "„Das Filmverbot wird zur Kapitulation vor den anstürmenden Feinden der Republik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1fb32a30-204e-3e60-9d4e-bad3a3703093",
                                        "entry_id": "fa31c312-b51a-3fba-a76f-a5b3e4751ca1",
                                        "glosses": [
                                            "in Kapitel eingeteilter Vertrag (zum Beispiel über den Dienst als Kapitulant, das heißt als Freiwilliger im Militär)"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51fd1af5-c33c-4cc4-b7cf-865bef516877",
                                                "sense_id": "1fb32a30-204e-3e60-9d4e-bad3a3703093",
                                                "text": "„Mannschaften, welche nach erfüllter aktiver Dienstpflicht freiwillig im aktiven Heere verbleiben wollen, müssen mit dem betreffenden Truppenteil (Regiment, selbständigen Bataillon) einen schriftlichen Vertrag (Kapitulation) abschließen, durch welchen sie sich zum Weiterdienen auf bestimmte Zeit — in der Regel auf mindestens ein Jahr — verpflichten“."
                                            },
                                            {
                                                "example_id": "9f77c6fe-dfcd-4136-a4d2-940433504ef8",
                                                "sense_id": "1fb32a30-204e-3e60-9d4e-bad3a3703093",
                                                "text": "„Die Einzelheiten der Dienstverpflichtung regelte ein Vertrag (Kapitulation)“."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
