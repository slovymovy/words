                                        "glosses": [
                                            "Lehrerin oder Wissenschaftlerin im Fach Germanistik (Sprach- und/oder Literaturwissenschaftlerin) (im engen Sinne im Bereich der deutschen Sprache, im weiten Sinne im Bereich der germanischen Sprachen einschließlich des Deutschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2196de20-11af-42df-8f69-3b2cebe015cb",
                                                "sense_id": "a6f3ee59-60c7-32b4-9130-8f9cbc4ced2d",
                                                "text": "„Er war so perfekt wie aus dem Mund einer Germanistin.“"
                                            },
                                            {
                                                "example_id": "97e55d02-0693-4dad-8c68-b988cc641739",
                                                "sense_id": "a6f3ee59-60c7-32b4-9130-8f9cbc4ced2d",
                                                "text": "„Einmal war ich in eine Germanistin verliebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
