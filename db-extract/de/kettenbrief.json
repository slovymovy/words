                ],
                "senses": [
                    {
                        "sense_id": "a26261c2-8529-3240-bac7-d8dae63a0e39",
                        "entry_id": "88520246-5501-325f-b91b-84288a8ed544",
                        "glosses": [
                            "Brief in einer Folge von Briefen, der vom Empfänger vervielfältigt und an weitere Adressen versandt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29621ed-e2fc-45d2-beb1-e297b3bffd40",
                                "sense_id": "a26261c2-8529-3240-bac7-d8dae63a0e39",
                                "text": "„Ob wir auch schon Kettenbriefe geschrieben hätten?“"
                            },
                            {
                                "example_id": "7e9e57d4-7e3f-47e6-a9c2-eb287e33c2fa",
                                "sense_id": "a26261c2-8529-3240-bac7-d8dae63a0e39",
                                "text": "„Volker hatte einen Kettenbrief gekriegt, den er siebenmal abschreiben und verschicken sollte, sonst werde es ihm dreckig gehen.“"
                            },
                            {
                                "example_id": "fb1c98d1-129b-4a45-ad2c-0d0e7eee13c2",
                                "sense_id": "a26261c2-8529-3240-bac7-d8dae63a0e39",
                                "text": "„Als das Büchlein in Deutschland erscheint, wird es von der Militärzensur wegen fehlender Druckerlaubnis verboten und kursiert in mehreren illegalen Nachdrucken und Abschriften, sogar in Form eines Kettenbriefs.“"
                            },
                            {
                                "example_id": "45e39ea5-01ea-46f1-a235-bf984c3f73ad",
                                "sense_id": "a26261c2-8529-3240-bac7-d8dae63a0e39",
                                "text": "„Ich sinnierte ein wenig über die Dynamik, mit der sich Ereignisse verbreiten, wie sich, gleich einem Kettenbrief, der Schock vervielfältigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
