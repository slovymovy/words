                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86028fc5-333e-4d77-b15d-e1feba913b95",
                                "sense_id": "782c8ffe-91f1-3dc7-8f27-3850dd9e42f5",
                                "text": "Femina proterva, rude, indocte, imperite, ignare, indiscrette, incivile, inurbaine, mal morigerée, ignorante qui t’a enseigné à parler en ceste façon ?"
                            },
                            {
                                "example_id": "e2e023fc-b801-4743-9eb0-09b8b546dafe",
                                "sense_id": "782c8ffe-91f1-3dc7-8f27-3850dd9e42f5",
                                "text": "Tout indocte et rustique que vous affectiez d’être, vous avez sans doute entendu parler de ces jolis signes, taches, meurtrissures, marques de dents, mémoire des folâtres ébats que les amants ont coutume d’avoir ensemble ?"
                            }
                        ]
                    }
