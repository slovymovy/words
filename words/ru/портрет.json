{
    "word_family": [
        "портретист",
        "портретный",
        "автопортрет"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e9f1bc6-6898-31ba-87f3-2dc4e65a1fa0",
                    "sense_definition": "Изображение человека на картине, фотографии или в скульптуре",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В музее мы долго рассматривали старинный <w>портрет</w> генерала.",
                            "target_lang_translations": {
                                "en": "In the museum, we examined an old <w>portrait</w> of the general for a long time.",
                                "zh": "在博物馆里，我们看了很久那幅将军的古老<w>肖像画</w>。"
                            }
                        },
                        {
                            "text": "Художник предложил написать мой <w>портрет</w> маслом.",
                            "target_lang_translations": {
                                "en": "The artist offered to paint my <w>portrait</w> in oil.",
                                "zh": "画家提议为我画一幅油画<w>肖像</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "изображение"
                    ],
                    "common_phrases": [
                        "семейный портрет",
                        "писать портрет",
                        "групповой портрет"
                    ],
                    "target_lang_definitions": {
                        "en": "An image of a person in a painting, photograph, or sculpture",
                        "zh": "指绘画、摄影或雕塑中对人物的描绘"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "portrait",
                                "target_lang_sense_clarification": "artistic representation of a person"
                            },
                            {
                                "target_lang_word": "picture",
                                "target_lang_sense_clarification": "general term for an image"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肖像画",
                                "target_lang_sense_clarification": "指艺术作品中对人物的描绘"
                            },
                            {
                                "target_lang_word": "画像",
                                "target_lang_sense_clarification": "指人物的图像或绘画"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "260a8668-c580-3dd9-ae50-1ce5f6fb1308",
                    "sense_definition": "Художественное описание характера или внешности героя в литературном произведении или кино",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор создал глубокий психологический <w>портрет</w> своего персонажа.",
                            "target_lang_translations": {
                                "en": "The author created a deep psychological <w>portrait</w> of his character.",
                                "zh": "作者对他笔下的人物进行了深刻的心理<w>刻画</w>。"
                            }
                        },
                        {
                            "text": "В романе представлен подробный <w>портрет</w> целого поколения.",
                            "target_lang_translations": {
                                "en": "The novel presents a detailed <w>portrait</w> of an entire generation.",
                                "zh": "这部小说对整整一代人进行了详尽的<w>描写</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "образ"
                    ],
                    "common_phrases": [
                        "психологический портрет",
                        "литературный портрет"
                    ],
                    "target_lang_definitions": {
                        "en": "An artistic description of a character's nature or appearance in literature or film",
                        "zh": "文学作品或电影中对人物性格或外貌的艺术性描述"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "portrait",
                                "target_lang_sense_clarification": "figurative description"
                            },
                            {
                                "target_lang_word": "portrayal",
                                "target_lang_sense_clarification": "depiction of a character"
                            },
                            {
                                "target_lang_word": "description",
                                "target_lang_sense_clarification": "account in words"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刻画",
                                "target_lang_sense_clarification": "指对人物形象的塑造与描写"
                            },
                            {
                                "target_lang_word": "描写",
                                "target_lang_sense_clarification": "指对人物或事物的文字描述"
                            },
                            {
                                "target_lang_word": "写照",
                                "target_lang_sense_clarification": "人物的心理写照，名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae3356b-7151-3f12-82fd-b5cc3e4dae68",
                    "sense_definition": "Лицо человека",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во время драки он получил удар прямо по <w>портрету</w>.",
                            "target_lang_translations": {
                                "en": "During the fight, he got punched right in the <w>mug</w>.",
                                "zh": "打架时，他的<w>脸</w>上狠狠挨了一拳。"
                            }
                        },
                        {
                            "text": "Убери свой недовольный <w>портрет</w> и начни работать.",
                            "target_lang_translations": {
                                "en": "Take your unhappy <w>mug</w> away and start working.",
                                "zh": "把你那张不高兴的<w>脸</w>收起来，开始工作吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "морда",
                        "рожа"
                    ],
                    "common_phrases": [
                        "получить по портрету"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in informal or rough speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person's face (slang/colloquial)",
                        "zh": "指人的脸部（俚语）"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mug",
                                "target_lang_sense_clarification": "slang for face"
                            },
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "body part"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "脸",
                                "target_lang_sense_clarification": "指人的面部"
                            },
                            {
                                "target_lang_word": "嘴脸",
                                "target_lang_sense_clarification": "指人的面貌，常含贬义"
                            }
                        ]
                    }
                }
            ]
        }
    ]
