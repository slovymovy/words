                ],
                "senses": [
                    {
                        "sense_id": "6c7de54f-2b16-3a06-bfc6-c290a80cdd5d",
                        "entry_id": "e58605fe-5e49-39b3-9b3f-8997cf3a9ede",
                        "glosses": [
                            "Rendre caca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9278ac4-3661-4084-83da-2f6bd33b90c8",
                                "sense_id": "6c7de54f-2b16-3a06-bfc6-c290a80cdd5d",
                                "text": "Devant le refus de la machine face à la divinité, qui telle le paria ose défier les forces de Krishna, celles si justement représentées par les océans de sagesse de la tradition brahmanique, il me faut couper, réduire, dévaluer, charlie-hebdoïser, profaniser, matérialiser, cacaïser, prout-proutiser... à regrets vous le devinez bien ..."
                            },
                            {
                                "example_id": "e312a6a2-4053-4d14-b95f-d098216e39a2",
                                "sense_id": "6c7de54f-2b16-3a06-bfc6-c290a80cdd5d",
                                "text": "Quel dommage que ces beaux maillots soient cacaïsés par des sponsors."
                            },
                            {
                                "example_id": "d45684cb-ed9b-42dc-889d-0301cbd73422",
                                "sense_id": "6c7de54f-2b16-3a06-bfc6-c290a80cdd5d",
                                "text": "La Jeunesse Universitaire Haïtienne est en train de rééditer 2004 où des cancres heureux qui n'ont jamais fréquenté l'université et même quand ils y ont été, ils n'ont jamais compris ce qu'ils faisaient à l'intérieur de cette structure vu qu'ils sont nés arnaqueurs cacaïsés qui croient que tous les Haïtiens sont appelés à être comme eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "489859af-c230-34ea-97dc-0fa2b6ff9dec",
                        "entry_id": "e58605fe-5e49-39b3-9b3f-8997cf3a9ede",
                        "glosses": [
                            "Faire caca."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cf133c17-dd54-485e-9668-6a05ef4eb780",
                                "sense_id": "489859af-c230-34ea-97dc-0fa2b6ff9dec",
                                "text": "Il ne parle, mange, boit, respire, « cacaïse » qu'au nom de la marque."
                            }
                        ]
                    }
