                    "frequency": "High",
                    "semantic_group_id": "evitement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise a trouvé un moyen astucieux de <w>contourner</w> la loi fiscale en vigueur."
                        },
                        {
                            "text": "Au lieu de faire face aux difficultés, il préfère toujours <w>contourner</w> le problème."
                        }
                    ],
                    "common_phrases": [
                        "contourner la loi",
                        "contourner les règles",
