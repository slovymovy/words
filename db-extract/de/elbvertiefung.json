                ],
                "senses": [
                    {
                        "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                        "entry_id": "95184bb2-1e0a-3e36-beef-aa58f41b027b",
                        "glosses": [
                            "das Ausbaggern des Flussbettes des Flusses Elbe zwischen Cuxhaven (an der Mündung) und dem Hafen Hamburgs (ca. 100 Kilometer flussaufwärts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b50ce7f-956b-4ae9-9569-0458e047c43e",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Zwischen Cuxhaven, wo die Elbe in die Nordsee mündet, und dem Containerterminal Altenwerder will die Stadt Hamburg mit Unterstützung des Bundes das Flussbett ausbauen. Es geht um die neunte Elbvertiefung seit 1880.“"
                            },
                            {
                                "example_id": "0c7c2825-97b6-4406-a2ee-7474bc488afa",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Mit der Elbvertiefung soll der Fluss so ausgebaut werden, dass künftig noch größere Frachter den Hamburger Hafen erreichen können.“"
                            },
                            {
                                "example_id": "fa7d4db0-b810-4894-8526-f8d3780cf1a6",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Es ist ein \"Ur-Streit\": Wirtschaftliches Wachstum versus Umweltschutz. Ein Beispiel, das seit Jahrzehnten dafür steht wie kaum ein anderes: Die Hamburger Elbvertiefung. Vom 19. bis 21. Dezember wird in Leipzig vor dem Bundesverwaltungsgericht über die mittlerweile neunte Elbvertiefung verhandelt.“"
                            },
                            {
                                "example_id": "9afd93e1-e839-433d-932a-ba6f4eca2100",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Statt der Elbvertiefung fordern die Umweltverbände eine engere Kooperation des Hamburger Hafens mit Bremerhaven und dem Tiefwasserhafen in Wilhelmshaven.“"
                            },
                            {
                                "example_id": "1bb16180-e4cf-4704-8de9-b98bbdd656b1",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Die Verhandlungen vor dem Bundesverwaltungsgericht in Leipzig über die Rechtmäßigkeit einer Elbvertiefung begannen am Dienstag (15.7.2014).“"
                            },
                            {
                                "example_id": "c577e31d-c555-49b0-9ec9-26c87be840fb",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Der Entwicklung des Hafens wird alles untergeordnet und ohne Rücksicht auf ökologische Verluste schon einmal für eine radikale Elbvertiefung plädiert.“"
                            },
                            {
                                "example_id": "2b00e680-274b-4376-a667-1bfd175e0168",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„»Die letzte Elbvertiefung war so gravierend für uns [Fischer], dass wir wirklich Fangplätze aufgeben mussten und auch starke Einbußen hatten bei den Fängen, weil die Fische andere Wege nehmen, wo wir nicht mehr hinkönnen.«“"
                            },
                            {
                                "example_id": "4c66543f-0273-4f01-b538-a68b30c3d290",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Umweltschützer retteten mit ihrem Einspruch gegen die Elbvertiefung eine weltweit einzigartige Pflanze: den Schierlings-Wasserfenchel.“"
                            },
                            {
                                "example_id": "3dea1944-b3c5-4c33-a3c4-c765d32db912",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„Die Gesamtkosten der Elbvertiefung sind noch nicht offiziell beziffert, weil die Ausschreibungen noch laufen. Sie dürften ungefähr 800 Millionen Euro betragen.“"
                            },
                            {
                                "example_id": "880f8476-ad65-420a-9bfb-9aaddb86099f",
                                "sense_id": "477997b3-cad4-382c-b0ae-9a1dce9ccfbf",
                                "text": "„»Die Prognosen, die 2005 dazu geführt haben, dass man die Elbvertiefung für nötig hielt, sind doch längst nicht mehr belastbar. Damals ist man von einem Umschlag von 25 bis 28 Millionen Containern pro Jahr ausgegangen. Experten sagen heute: Selbst wenn es gut läuft, sind es vielleicht zwölf Millionen.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
