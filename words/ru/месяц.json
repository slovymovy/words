    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56dce3e8-5502-3391-8554-1e0b6d833e2b",
                    "sense_definition": "Единица исчисления времени, равная одной двенадцатой части года, или промежуток времени в 30 суток.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В прошлом <w>месяце</w> мы всей семьёй ездили отдыхать на море.",
                            "target_lang_translations": {
                                "en": "Last <w>month</w> our whole family went to the seaside for a vacation.",
                                "zh": "上个<w>月</w>我们全家去海边度假了。"
                            }
                        },
                        {
                            "text": "Мой брат обещал вернуться домой через один <w>месяц</w>.",
                            "target_lang_translations": {
                                "en": "My brother promised to return home in one <w>month</w>.",
                                "zh": "我弟弟答应过一个<w>月</w>后回家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "каждый месяц",
                        "целый месяц",
                        "раз в месяц",
                        "в следующем месяце"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of time equal to one twelfth of a year, or a period of roughly 30 days.",
                        "zh": "时间单位，等于一年的十二分之一，或约30天的时间段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "month",
                                "target_lang_sense_clarification": "period of time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "月",
                                "target_lang_sense_clarification": "时间单位"
                            },
                            {
                                "target_lang_word": "月份",
                                "target_lang_sense_clarification": "指代具体的某个月"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "219570a2-c6ed-32f2-b9e5-1a407f8e7c2f",
                    "sense_definition": "Луна (обычно неполная, в виде узкого серпа) или небесное светило в народно-поэтической речи.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "celestial_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На тёмном ночном небе ярко светил молодой <w>месяц</w>.",
                            "target_lang_translations": {
                                "en": "A young <w>moon</w> shone brightly in the dark night sky.",
                                "zh": "漆黑的夜空中，一弯<w>新月</w>明亮地照耀着。"
                            }
                        },
                        {
                            "text": "Из-за тяжёлых туч выглянул бледный <w>месяц</w> и осветил дорогу.",
                            "target_lang_translations": {
                                "en": "A pale <w>moon</w> peeked out from behind heavy clouds and illuminated the road.",
                                "zh": "苍白的<w>月亮</w>从厚重的云层后探出头来，照亮了道路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "луна"
                    ],
                    "common_phrases": [
                        "молодой месяц",
                        "ясный месяц",
                        "светит месяц",
                        "серп месяца"
                    ],
                    "target_lang_definitions": {
                        "en": "The moon, specifically when seen as a crescent or in poetic contexts.",
                        "zh": "月亮，特指呈新月状或在文学语境中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "moon",
                                "target_lang_sense_clarification": "celestial body"
                            },
                            {
                                "target_lang_word": "crescent moon",
                                "target_lang_sense_clarification": "shape/phase"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "月亮",
                                "target_lang_sense_clarification": "天体"
                            },
                            {
                                "target_lang_word": "新月",
                                "target_lang_sense_clarification": "月相"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ea35cf4-9b52-3aca-b38f-61ce6cc0a6bf",
                    "sense_definition": "В астрономии — промежуток времени, за который Луна совершает полный оборот вокруг Земли.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сидерический <w>месяц</w> короче синодического примерно на два дня.",
                            "target_lang_translations": {
                                "en": "A sidereal <w>month</w> is shorter than a synodic one by approximately two days.",
                                "zh": "恒星<w>月</w>比朔望月短大约两天。"
                            }
                        },
                        {
                            "text": "Учёные используют лунный <w>месяц</w> для расчёта некоторых календарей.",
                            "target_lang_translations": {
                                "en": "Scientists use the lunar <w>month</w> to calculate certain calendars.",
                                "zh": "科学家们利用朔望<w>月</w>来计算某些历法。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "лунный месяц",
                        "сидерический месяц",
                        "календарный месяц"
                    ],
                    "target_lang_definitions": {
                        "en": "In astronomy, the period of time it takes for the Moon to complete one revolution around the Earth.",
                        "zh": "在天文学中，指月球绕地球公转一周所需的时间。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "month",
                                "target_lang_sense_clarification": "astronomical period"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "月",
                                "target_lang_sense_clarification": "天文周期"
                            }
                        ]
                    }
                }
            ]
        },
