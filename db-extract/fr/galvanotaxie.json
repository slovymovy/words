                    {
                        "sense_id": "bf5b4107-5ad0-3339-89a2-1976cc77a800",
                        "entry_id": "548a8b99-9177-3f24-bd6f-79d4fc14a5dc",
                        "glosses": [
                            "Orientation provoquée chez certains animaux (poissons, amphibiens, …) ou des organes unicellulaires, par un courant électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bbd821a-f5f9-4db1-9b9a-3c0184ecc219",
                                "sense_id": "bf5b4107-5ad0-3339-89a2-1976cc77a800",
                                "text": "La phototaxie et la galvanotaxie sont des phénomènes dont les unicellulaires fournissent de très nombreux exemples."
                            },
                            {
                                "example_id": "d3cfbe1d-26e8-40a8-a951-2bc61d76192b",
                                "sense_id": "bf5b4107-5ad0-3339-89a2-1976cc77a800",
                                "text": "Dans le second cas la première est contrecarrée et plus ou moins enrayée par la seconde : dans le troisième cas la thermotaxie l’emporte sur la galvanotaxie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b6a9dee-8ec6-4dc0-a074-c0af7358d5b8",
                        "source_entry_id": "548a8b99-9177-3f24-bd6f-79d4fc14a5dc",
                        "source_sense_id": "bf5b4107-5ad0-3339-89a2-1976cc77a800",
                        "target_lang_word": "гальванотаксис",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гальванотаксис",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0bbc9c38-d0c7-3128-9779-930a2c6618cb",
                                        "entry_id": "8d32fd84-ea7d-30f8-b7ab-1431eebe3f61",
                                        "glosses": [
                                            "биол. направленное движение биологических клеток или организмов, обусловленное пропусканием гальванического (постоянного) электрического тока через жидкость, в которой они находятся"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cceeaf7e-d112-46be-a1ae-767622b81f97",
                                                "sense_id": "0bbc9c38-d0c7-3128-9779-930a2c6618cb",
                                                "text": "Одни организмы, напр., туфельки (Paramaecium), амёбы, а также белые кровяные клетки позвоночных (Mendelssohn, 1912), при замыкании постоянного тока, двигаются к катоду, обнаруживая отрицательный гальванотаксис, другие — к аноду, обнаруживая положительный гальванотаксис. Влияние гальванического тока было впервые замечено и на высших животных, исследованных Германом, Нагелем, Лёбом и др."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
