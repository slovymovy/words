                        "entry_id": "d5ed8970-7e01-3451-80a3-27a393d26df9",
                        "glosses": [
                            "Gesamtheit der Veränderungen an geochemischen oder biogeochemischen Kreisläufen der Erde mit technischen Mitteln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1df593-fe62-4f96-b86f-97133f778711",
                                "sense_id": "06e5d90d-f322-3663-9d7c-9cca351ed482",
                                "text": "„Zudem zeigen Untersuchungen, dass auch mit Geoengineering die Dekarbonisierung weiter vorangetrieben werden müsste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
