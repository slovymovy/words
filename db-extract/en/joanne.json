                "senses": [
                    {
                        "sense_id": "d4dcbd64-8f35-3c04-b1d6-f4a90b3d4ee8",
                        "entry_id": "357fc661-07f2-3d84-8bfd-75ce9b2c86b9",
                        "glosses": [
                            "A female given name from French."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509eb594-21ef-4f2f-b714-cb2c91411185",
                                "sense_id": "d4dcbd64-8f35-3c04-b1d6-f4a90b3d4ee8",
                                "text": "\"Ye've seen the Lady?\"\n\"I have,\" said I; \"and I have seen the young ladies too, except Miss Joanne.\"\n\"Ye may just as weel lay by the Miss, and ca' her Joan, like her mother afore her, noo—They've flung the puir lassie clean aff, Mr Waldie. Greeting for the father, and nae thought for the bairn—that's the warld's way, Mr Waldie.—But God strikes not wi' baith hands, young man..."
                            },
                            {
                                "example_id": "010b8fdc-e061-40e2-aa44-eb61c8dd9578",
                                "sense_id": "d4dcbd64-8f35-3c04-b1d6-f4a90b3d4ee8",
                                "text": "Jocasta wasn't Jocasta's name: her real name was Joanne. She changed it when she was thirty-eight because, as she said what can you do with a name like Joanne? Too nice. She didn't dye her hair green or wear a safety pin in her ear but calling herself Jocasta was the equivalent. Good taste kills, said Jocasta."
                            }
                        ]
                    }
