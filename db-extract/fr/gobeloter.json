                        "entry_id": "4fbeb15f-e274-3cf2-a36d-09b814e9576f",
                        "glosses": [
                            "Boire à petits coups en prenant son temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5231b3a8-526d-4576-b21a-80a9f0caacfb",
                                "sense_id": "6d1b53a3-0e62-30a0-b498-054b02bed15e",
                                "text": "Pour avoir des amis, ne faut-il pas se lier avec des jeunes gens, posséder quelques sous afin d’aller gobeloter avec eux, se rendre ensemble partout où vont des étudiants !"
                            },
                            {
                                "example_id": "7cb6245c-d820-4a33-8103-9030029e3f6d",
                                "sense_id": "6d1b53a3-0e62-30a0-b498-054b02bed15e",
                                "text": "Il relut mon texte en gobelotant son éternel thé."
                            }
                        ]
                    }
