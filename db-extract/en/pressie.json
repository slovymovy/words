                    {
                        "sense_id": "a856ffb6-bfe8-33f7-82e0-9f30c7b758e8",
                        "entry_id": "45961e8c-9080-377e-845d-36390c1607ef",
                        "glosses": [
                            "A present (gift)."
                        ],
                        "tags": [
                            "colloquial"
                        ],
