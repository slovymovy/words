                    {
                        "translation_id": "84a7f5ff-822c-4ae5-a7f3-17237951b654",
                        "source_entry_id": "0f905ab4-ffc3-3b11-b24b-741dbbff72ba",
                        "source_sense_id": "1c497b39-e41d-315a-b53e-4e9965732dc3",
                        "source_sense_description": "bildungssprachlich: Vortäuschung einer Meinung, ohne diese wirklich zu vertreten",
                        "target_lang_word": "hypocrisie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocrisie",
