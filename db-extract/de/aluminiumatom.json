                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e1be18-127b-47eb-8d47-5100357fc4b9",
                                "sense_id": "8580a372-5bbf-32e0-a328-cfaf6b6f972c",
                                "text": "„Das Magnesiumatom ist größer als das Aluminiumatom und kommt immer in oktaedrischer Koordination vor (umgeben von sechs Sauerstoffatomen).“"
                            },
                            {
                                "example_id": "3fdbc113-065b-48aa-984c-7aa7991ebf43",
                                "sense_id": "8580a372-5bbf-32e0-a328-cfaf6b6f972c",
                                "text": "„Wir sahen bereits, daß in den Alumosilikaten die Aluminiumatome gleichsam an die Stelle von Siliziumatomen treten, indem sie den Platz im Mittelpunkt der Sauerstofftetraeder einnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
