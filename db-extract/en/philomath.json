                        "entry_id": "a2b32d90-9659-3d2a-bc76-9caf7cfe4fd3",
                        "glosses": [
                            "A lover of learning; a scholar."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ecbf6d00-0fd9-4941-8bfb-a49257d16e8c",
                                "sense_id": "8c76eb01-670d-3143-813b-892dd35eb821",
                                "text": "For this (in my humble opinion, not very important purpose, and fitter to employ the talent of a philomath than a Newton) he and Leibnitz, much about the same, struck out a fluxional method, which they both took for a demonstration."
                            },
                            {
                                "example_id": "87ff929f-2704-439b-8619-ab5eca82098c",
                                "sense_id": "8c76eb01-670d-3143-813b-892dd35eb821",
                                "text": "Jerman for twenty years past had been the author of a Quaker almanac, and had for about the same time been engaged in a fierce almanac warfare with Jacob Taylor, a philomath and a printer of Friends’ books."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aa270b8-8ee6-34bf-b2dd-bd563d8f9fcd",
                        "entry_id": "a2b32d90-9659-3d2a-bc76-9caf7cfe4fd3",
                        "glosses": [
                            "An astrologer or predictor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "159efae9-ddc9-4806-8651-4c3d2923f628",
                                "sense_id": "1aa270b8-8ee6-34bf-b2dd-bd563d8f9fcd",
                                "text": "\"The success of an almanac depended upon the appeal of the \"philomath\"-the resident astrologer who did the writing and predicting.\""
                            }
                        ]
                    }
