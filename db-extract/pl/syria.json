                                                "example_id": "5b5b08c7-ded3-4b61-9551-9660ab0e757a",
                                                "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                                "text": "Damaskus ist die Hauptstadt von Syrien."
                                            },
