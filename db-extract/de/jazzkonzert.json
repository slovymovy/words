                ],
                "senses": [
                    {
                        "sense_id": "a498edf9-7ff6-3739-8bb2-18e3d122d6bf",
                        "entry_id": "a5181224-0d39-3885-8ef0-a4066ec12c91",
                        "glosses": [
                            "Konzert, das von Jazzmusikern gestaltet wird; bei dem Jazzmusik dargeboten wird"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "6495e5ce-a1d8-421a-a5fc-3f50bc0ee3e2",
                                "sense_id": "a498edf9-7ff6-3739-8bb2-18e3d122d6bf",
                                "text": "„Die Mädchen und Jungen, die sich auf die Eckbank der leeren Bahnhofshalle setzten, kamen aus einem Jazzkonzert. Ihr Gespräch verstummte rasch. Einer nach dem anderen legten sie den Kopf auf die Schulter ihres Nebenmanns.“"
                            },
                            {
                                "example_id": "c41446e0-aa9e-4703-a808-3ea8f0f01b5f",
                                "sense_id": "a498edf9-7ff6-3739-8bb2-18e3d122d6bf",
                                "text": "„Zum nunmehr 25. Mal präsentiert Impresario Gerhard Kosel Jazzkonzerte in einem der schönsten Höfe der Grazer Innenstadt.“"
                            },
                            {
                                "example_id": "b651c096-72e6-4e3b-a7bb-31169fc4068f",
                                "sense_id": "a498edf9-7ff6-3739-8bb2-18e3d122d6bf",
                                "text": "„Bald sieben Jahre ist es her, dass sie sich dazu entschlossen hat – nach einem Jazzkonzert in Ascona, in Erinnerung daran, wie sie selbst in schwerster Zeit während des Zweiten Weltkriegs Menschlichkeit erfahren habe.“"
                            },
                            {
                                "example_id": "2ae8b599-81b4-466c-b441-441f9cbb86ea",
                                "sense_id": "a498edf9-7ff6-3739-8bb2-18e3d122d6bf",
                                "text": "„Auf dem Rückweg kam er an der »Arena« vorbei, wo ihr Jazzkonzert stattgefunden hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
