{
    "word_family": [
        "moulting",
        "molter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe44ad5f-f6e8-36df-a008-5151895d14a9",
                    "sense_definition": "to shed hair, feathers, shell, or horns, which are then replaced by new growth",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_processes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young bird began to <w>molt</w> its dull feathers to make room for bright adult plumage.",
                            "target_lang_translations": {
                                "ru": "Молодая птица начала <w>сбрасывать</w> тусклые перья, чтобы освободить место для яркого взрослого оперения."
                            }
                        },
                        {
                            "text": "During the summer months, many snakes will <w>molt</w> their skin as they continue to grow larger.",
                            "target_lang_translations": {
                                "ru": "В летние месяцы многие змеи <w>сбрасывают</w> кожу по мере того, как продолжают расти."
                            }
                        }
                    ],
                    "synonyms": [
                        "shed",
                        "slough"
                    ],
                    "common_phrases": [
                        "molt feathers",
                        "molt skin"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сбрасывать шерсть, перья, панцирь или рога, которые затем заменяются новыми"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линять",
                                "target_lang_sense_clarification": "о животных, птицах"
                            },
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "кожу, панцирь или перья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e176bea-9360-3cfd-b435-d1fed78f778b",
                    "sense_definition": "archaic simple past of <w>melt</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "archaic_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old poem, the wax <w>molt</w> away under the heat of the flickering candle.",
                            "target_lang_translations": {
                                "ru": "В старинном стихотворении воск <w>растаял</w> под жаром мерцающей свечи."
                            }
                        },
                        {
                            "text": "The knight watched as the lead <w>molt</w> in the crucible during the ancient ritual.",
                            "target_lang_translations": {
                                "ru": "Рыцарь наблюдал, как свинец <w>плавился</w> в тигле во время древнего ритуала."
                            }
                        }
                    ],
                    "synonyms": [
                        "melted"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical past tense form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "архаичная форма прошедшего времени глагола melt (таять, плавиться)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растаял",
                                "target_lang_sense_clarification": "устаревшая форма"
                            },
                            {
                                "target_lang_word": "расплавился",
                                "target_lang_sense_clarification": "устаревшая форма"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d4050f4-79f2-3987-9637-01f93b86ac8d",
                    "sense_definition": "the process of shedding and replacing feathers, hair, or an exoskeleton",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_processes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crab is very vulnerable to predators immediately after a <w>molt</w> before its new shell hardens.",
                            "target_lang_translations": {
                                "ru": "Краб очень уязвим для хищников сразу после <w>линьки</w>, пока его новый панцирь не затвердеет."
                            }
                        },
                        {
                            "text": "The bird's annual <w>molt</w> usually occurs after the breeding season has finished.",
                            "target_lang_translations": {
                                "ru": "Ежегодная <w>линька</w> у птиц обычно происходит после окончания сезона размножения."
                            }
                        }
                    ],
                    "synonyms": [
                        "moulting",
                        "ecdysis"
                    ],
                    "common_phrases": [
                        "annual molt",
                        "complete molt"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "American English spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс сбрасывания и замены перьев, шерсти или экзоскелета"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "линька",
                                "target_lang_sense_clarification": "биологический процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}