                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81311d71-f850-4bf7-a296-06c6efa91dc1",
                        "source_entry_id": "977359a3-0446-3f5b-bf46-e94f3df0de42",
                        "source_sense_description": "of descriptions or distinctions based on some quality rather than on some quantity",
                        "target_lang_word": "qualitatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualitatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57ce828c-de58-3613-be33-b9012351fed0",
                                        "entry_id": "f114114d-7641-34c9-9b2c-f052c2ddedde",
                                        "glosses": [
                                            "Qui concerne la qualité (souvent par opposition à quantitatif)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f8a04b-ae3b-4032-a537-4aa2cbc8956c",
                                                "sense_id": "57ce828c-de58-3613-be33-b9012351fed0",
                                                "text": "Les éléments qualitatifs d’une sensation sont ceux qui ne peuvent être exprimés par des nombres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                        "entry_id": "f114114d-7641-34c9-9b2c-f052c2ddedde",
                                        "glosses": [
                                            "De qualité."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f9d0fdf-214a-4505-a8dd-1947973ff494",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Je les ai toutes et tous vus, tous traités, et je puis dire, sans vanité, que j’ai fait faire à la carrière de certains un saut qualitatif."
                                            },
                                            {
                                                "example_id": "7958dec3-01a5-4aa8-964a-2faa70a7c698",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "J’entreprenais là un véritable saut qualitatif dans l’escalade du mensonge."
                                            },
                                            {
                                                "example_id": "e807fd7b-d789-49cd-9640-787b8f8fa468",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Pour parler de son produit qualitatif, il faut le magnifier !"
                                            },
                                            {
                                                "example_id": "e43c48ec-e458-46ca-8e71-17b3d0fb8879",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Pour autant, ce partenariat, signé en mars 2016 pour cinq ans, va nous permettre de développer et de proposer un produit qualitatif."
                                            },
                                            {
                                                "example_id": "8ed9b4d3-1f9d-4dd1-9243-43070a9cc0eb",
                                                "sense_id": "2b4158be-816d-31a9-a61c-ed40159023aa",
                                                "text": "Utilisée en entretien, la cire d’abeille est un produit qualitatif réputé haut de gamme !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
