                                "de": "Wir müssen diese Arbeit <w>schnell</w> beenden.",
                                "fr": "Nous devons finir ce travail <w>rapidement</w>.",
                                "it": "Dobbiamo finire questo lavoro <w>rapidamente</w>.",
                                "cs": "Musíme tuto práci <w>rychle</w> dokončit.",
                                "tr": "Bu işi <w>çabuk</w> bitirmeliyiz.",
                                "es": "Debemos terminar este trabajo <w>rápidamente</w>."
                            }
