{
    "word_family": [
        "continue",
        "continuation",
        "continuity",
        "continuous",
        "continual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "48a9252a-fa9f-328d-9770-17fc8666baf4",
                    "sense_definition": "The act of keeping something going or the state of remaining in existence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>continuance</w> of the harsh weather made travel impossible for several days.",
                            "target_lang_translations": {
                                "ru": "<w>Продолжение</w> суровой погоды сделало путешествия невозможными на несколько дней.",
                                "zh": "恶劣天气的<w>持续</w>导致这几天无法出行。"
                            }
                        },
                        {
                            "text": "We hope for the <w>continuance</w> of our strong partnership in the coming years.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на <w>продолжение</w> нашего крепкого партнерства в ближайшие годы.",
                                "zh": "我们希望在未来几年内能<w>延续</w>我们稳固的伙伴关系。"
                            }
                        }
                    ],
                    "synonyms": [
                        "permanence"
                    ],
                    "antonyms": [
                        "discontinuance"
                    ],
                    "common_phrases": [
                        "continuance of operations",
                        "continuance in office"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по продолжению чего-либо или состояние сохранения существования.",
                        "zh": "指使某事继续进行的行为，或保持存在状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продолжение",
                                "target_lang_sense_clarification": "действие или состояние"
                            },
                            {
                                "target_lang_word": "сохранение",
                                "target_lang_sense_clarification": "поддержание существования"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "持续",
                                "target_lang_sense_clarification": "指状态或动作的延续"
                            },
                            {
                                "target_lang_word": "延续",
                                "target_lang_sense_clarification": "指事物延长或继续存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad0a5ce-f38f-3c64-a421-b688bb020dc8",
                    "sense_definition": "A formal order by a court to delay a legal proceeding until a later date.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense attorney decided to request a <w>continuance</w> to review the new evidence.",
                            "target_lang_translations": {
                                "ru": "Адвокат защиты решил ходатайствовать об <w>отсрочке</w>, чтобы изучить новые доказательства.",
                                "zh": "辩护律师决定申请<w>延期</w>以审查新证据。"
                            }
                        },
                        {
                            "text": "The judge granted a <w>continuance</w> because a key witness was unavailable.",
                            "target_lang_translations": {
                                "ru": "Судья предоставил <w>отсрочку</w>, так как ключевой свидетель отсутствовал.",
                                "zh": "由于关键证人无法出庭，法官批准了<w>延期</w>审理。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grant a continuance",
                        "request a continuance",
                        "motion for continuance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное постановление суда об отложении судебного разбирательства на более поздний срок.",
                        "zh": "法院正式下令将法律诉讼推迟到以后的日期。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отсрочка",
                                "target_lang_sense_clarification": "перенос судебного заседания"
                            },
                            {
                                "target_lang_word": "отложение дела",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "延期",
                                "target_lang_sense_clarification": "法律程序上的推迟"
                            },
                            {
                                "target_lang_word": "休庭",
                                "target_lang_sense_clarification": "指案件审理的暂时中止或推迟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07796797-d1ec-3932-b32b-1d8c338dc8fd",
                    "sense_definition": "The period of time during which a specific event, condition, or contract lasts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tenant must maintain the property during the <w>continuance</w> of the lease.",
                            "target_lang_translations": {
                                "ru": "Арендатор обязан содержать имущество в порядке в течение <w>срока действия</w> аренды.",
                                "zh": "租户必须在租赁<w>期间</w>维护好房产。"
                            }
                        },
                        {
                            "text": "No changes were made to the rules during the <w>continuance</w> of the festival.",
                            "target_lang_translations": {
                                "ru": "В правила не вносилось никаких изменений во время <w>продолжения</w> фестиваля.",
                                "zh": "在节日活动<w>期间</w>，规则没有发生任何变化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "during the continuance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, в течение которого длится определенное событие или действует договор.",
                        "zh": "特定事件、条件或合同持续的时间段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срок действия",
                                "target_lang_sense_clarification": "договора или соглашения"
                            },
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "времени или события"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "期间",
                                "target_lang_sense_clarification": "指某个特定的时间段"
                            },
                            {
                                "target_lang_word": "有效期",
                                "target_lang_sense_clarification": "指合同或协议有效的期限"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}