                "senses": [
                    {
                        "sense_id": "7c93eb7d-a860-3413-8f49-ab06d32ea392",
                        "entry_id": "c9443ff7-e8c4-3e0f-b722-60399d403d92",
                        "glosses": [
                            "Wörterbuch, Nachschlagewerk für die Fachbegriffe einer Wissenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb714d14-c92b-4ad7-aec3-66ce3fe3bc59",
                                "sense_id": "7c93eb7d-a860-3413-8f49-ab06d32ea392",
                                "text": "In Fachwörterbüchern kann man Erklärungen für die Bedeutung der Fachbegriffe finden."
                            },
                            {
                                "example_id": "2aa2bf93-e79d-412a-bae2-18d67bd63154",
                                "sense_id": "7c93eb7d-a860-3413-8f49-ab06d32ea392",
                                "text": "„Fremdwörter- und Fachwörterbücher widerspiegeln die Breite der lexikographischen Bemühungen.“"
                            },
                            {
                                "example_id": "ffe49f75-cff0-472f-b76a-50cd676e9582",
                                "sense_id": "7c93eb7d-a860-3413-8f49-ab06d32ea392",
                                "text": "„Heute haben wir Fachwörterbücher für die verschiedenen Zweige der Wissenschaft und Technik, darunter zwei- und mehrsprachige für Übersetzungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
