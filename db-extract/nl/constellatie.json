                "senses": [
                    {
                        "sense_id": "950a4f6d-7202-3ad0-8cb8-b15a67607ce5",
                        "entry_id": "2601d2e5-1bc7-387d-a823-a5ee05cc049f",
                        "glosses": [
                            "het gehele samenstel van factoren dat invloed op iets of iemand uitoefent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1443f95a-9b39-4798-b39f-f47b9f7ec1d8",
                                "sense_id": "950a4f6d-7202-3ad0-8cb8-b15a67607ce5",
                                "text": "Een cordon sanitaire om partijen als de PVV dient in de huidige constellatie gestalte te krijgen door niet deel te nemen aan een kabinet met deze partij, zolang zij niet overtuigend in het gareel van de democratische rechtsstaat is gedwongen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7df9454-89fa-35c1-af4e-fe4fe3d84fd7",
                        "entry_id": "2601d2e5-1bc7-387d-a823-a5ee05cc049f",
                        "glosses": [
                            "configuratie, onderlinge stand van hemellichamen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "866aef34-c307-3e47-8167-3ef2187f92f0",
                        "entry_id": "2601d2e5-1bc7-387d-a823-a5ee05cc049f",
