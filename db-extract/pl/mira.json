                "translations": [
                    {
                        "translation_id": "18c4e613-f4d1-4c90-a327-1027b3c719f7",
                        "source_entry_id": "b49b55f7-813d-3055-afaa-075445cc5e82",
                        "source_sense_id": "4dbf3b94-4af2-33a0-a5bb-d610cfe73012",
                        "target_lang_word": "Мира",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Мира",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a78e1d56-839b-3636-8662-d5bcb0aa1f9d",
                                        "entry_id": "9b6068ba-71c3-3e2d-90d9-a06fd274ec92",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cac6bb19-3a71-4635-a745-23f95d983572",
                                                "sense_id": "a78e1d56-839b-3636-8662-d5bcb0aa1f9d",
                                                "text": "Пролетела розовая юность незаметно, пришла пора замуж выходить, и выдали принцессу Миру замуж за короля дальней страны."
                                            },
                                            {
                                                "example_id": "a1b444b4-43ed-4cf7-a73e-fa7f7d0d0fec",
                                                "sense_id": "a78e1d56-839b-3636-8662-d5bcb0aa1f9d",
                                                "text": "За это время Прокофьев женился еще раз на Мире Мендельсон, женщине приятной, но скучной и обладательнице нестерпимого голоса."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a427f2e-3387-32af-9b0e-1d1e17d3eeab",
                                        "entry_id": "9b6068ba-71c3-3e2d-90d9-a06fd274ec92",
                                        "glosses": [
                                            "женское имя; гипокор. к Мирослава"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f865c53-bfd5-4b2c-9b02-fc76ae347a18",
                                                "sense_id": "0a427f2e-3387-32af-9b0e-1d1e17d3eeab",
                                                "text": "— Среди ваших учеников — «папина дочка» Мира Карпович и Максим Матвеев, которого запомнили по «Стилягам»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25160e1c-876b-32a0-ba86-9bc1764f99ff",
                                        "entry_id": "9b6068ba-71c3-3e2d-90d9-a06fd274ec92",
                                        "glosses": [
                                            "женское имя; гипокор. к Дамира"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a3700b-0c6c-4518-9f42-9950285300ee",
                                                "sense_id": "25160e1c-876b-32a0-ba86-9bc1764f99ff",
                                                "text": "Меня зовут Мира"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11a7db56-9ab9-3325-bcb3-dcf7af6c976a",
                                        "entry_id": "9b6068ba-71c3-3e2d-90d9-a06fd274ec92",
                                        "glosses": [
                                            "женское имя; гипокор. к Замира"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2c6d9e-f7af-4b1d-b31d-d64b831f748d",
                                                "sense_id": "11a7db56-9ab9-3325-bcb3-dcf7af6c976a",
                                                "text": "Меня зовут Мира"
