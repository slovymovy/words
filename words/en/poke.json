                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to order a spicy tuna <w>poke</w> for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы решили заказать острое <w>поке</w> с тунцом на обед.",
                                "zh": "我们决定午餐点一份辣味金枪鱼<w>波奇饭</w>。",
                                "cs": "Rozhodli jsme se k obědu objednat pikantní tuňákové <w>poke</w>."
                            }
                        },
                        {
                            "text": "The restaurant serves a delicious salmon <w>poke</w> bowl with avocado and rice.",
