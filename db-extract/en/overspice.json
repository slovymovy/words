                        "entry_id": "594a64e0-5316-31de-803d-d72705d9dc0c",
                        "glosses": [
                            "To add too much spice to (a dish)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4362a3ff-f9b1-4385-b6bb-a21d375170ca",
                                "sense_id": "9f485b58-2024-39f5-9ca8-0a29c7acd947",
                                "text": "A whiff of nutmeg adds to its distinctive merit, but don't overspice it."
                            },
                            {
                                "example_id": "01f8aee9-02ce-4885-a328-5965ba3a9d1d",
                                "sense_id": "9f485b58-2024-39f5-9ca8-0a29c7acd947",
                                "text": "I tend to overspice things, to go for big, peasant flavors."
                            },
                            {
                                "example_id": "31812ca4-9a68-4fcd-b810-963cc0a58a8c",
                                "sense_id": "9f485b58-2024-39f5-9ca8-0a29c7acd947",
                                "text": "Mulate's did not overspice the already spicy crawfish, and the accompanying sauce of onions and peppers was among the best I've tasted in years."
                            }
                        ]
                    }
