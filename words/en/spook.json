{
    "word_family": [
        "spooky",
        "spookiness",
        "spookily",
        "spooked"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04c4d992-85b4-38bc-9b45-e62efad3d80e",
                    "sense_definition": "to frighten or make nervous, especially by startling someone or an animal",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frighten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden movement in the bushes <w>spooked</w> the deer and they ran away.",
                            "target_lang_translations": {
                                "ru": "Внезапное движение в кустах <w>вспугнуло</w> оленей, и они убежали.",
                                "zh": "灌木丛里的突然动静<w>惊到</w>了鹿，它们就跑开了。"
                            }
                        },
                        {
                            "text": "Loud noises often <w>spook</w> horses during the parade.",
                            "target_lang_translations": {
                                "ru": "Громкие звуки часто <w>пугают</w> лошадей во время парада.",
                                "zh": "游行时，巨大的噪声常常会<w>吓到</w>马匹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frighten",
                        "scare",
                        "startle",
                        "alarm",
                        "Unnerve"
                    ],
                    "antonyms": [
                        "calm",
                        "soothe",
                        "reassure"
                    ],
                    "common_phrases": [
                        "easily spooked"
                    ],
                    "target_lang_definitions": {
                        "ru": "напугать или заставить нервничать, особенно внезапно испугав человека или животное",
                        "zh": "使害怕或紧张，尤指因突然的动静而把人或动物吓到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспугнуть",
                                "target_lang_sense_clarification": "заставить животное или человека убежать от испуга"
                            },
                            {
                                "target_lang_word": "напугать",
                                "target_lang_sense_clarification": "вызвать внезапный страх"
                            },
                            {
                                "target_lang_word": "перепугать",
                                "target_lang_sense_clarification": "сильно напугать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊到",
                                "target_lang_sense_clarification": "尤指突然把人或动物吓到、惊动"
                            },
                            {
                                "target_lang_word": "吓到",
                                "target_lang_sense_clarification": "使感到害怕或紧张"
                            },
                            {
                                "target_lang_word": "使受惊",
                                "target_lang_sense_clarification": "较正式；使突然受到惊吓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0a954fa-6335-3bb3-9aef-62a2a984d69c",
                    "sense_definition": "to become frightened or nervous due to something startling",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frighten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cattle might <w>spook</w> if they hear the thunder.",
                            "target_lang_translations": {
                                "ru": "Скот может <w>испугаться</w>, если услышит гром.",
                                "zh": "牛群如果听到雷声，可能会<w>受惊</w>。"
                            }
                        },
                        {
                            "text": "The deer <w>spooked</w> at the sound of the dogs barking in the distance.",
                            "target_lang_translations": {
                                "ru": "Олени <w>шарахнулись</w> от звука лая собак вдалеке.",
                                "zh": "远处传来狗叫声时，鹿群<w>受惊</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "panic",
                        "bolt"
                    ],
                    "target_lang_definitions": {
                        "ru": "испугаться или занервничать из-за чего-то внезапного",
                        "zh": "因突然发生的事而变得害怕或紧张。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугаться",
                                "target_lang_sense_clarification": "приходить в состояние испуга"
                            },
                            {
                                "target_lang_word": "шарахаться",
                                "target_lang_sense_clarification": "резко бросаться в сторону от испуга"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受惊",
                                "target_lang_sense_clarification": "因突发情况而害怕、紧张，常用于动物"
                            },
                            {
                                "target_lang_word": "吓一跳",
                                "target_lang_sense_clarification": "更口语；突然被吓到"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74a165a4-0ac7-3625-84df-750682b642e6",
                    "sense_definition": "to haunt a place or person",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Local legends say that an old spirit continues to <w>spook</w> the halls of the manor.",
                            "target_lang_translations": {
                                "ru": "Местные легенды гласят, что старый дух продолжает <w>пугать</w> обитателей залов поместья.",
                                "zh": "当地传说说，一个古老的幽灵仍在庄园的大厅里<w>出没</w>。"
                            }
                        },
                        {
                            "text": "He felt as if a ghost was trying to <w>spook</w> him in the dark basement.",
                            "target_lang_translations": {
                                "ru": "Ему казалось, будто призрак пытается <w>напугать</w> его в темном подвале.",
                                "zh": "他觉得仿佛有个鬼魂在漆黑的地下室里想对他<w>作祟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "haunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in a supernatural context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "преследовать или являться в виде привидения в каком-либо месте",
                        "zh": "像鬼魂一样缠着某个地方或某个人，常指幽灵出没或作祟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "являться",
                                "target_lang_sense_clarification": "о привидении"
                            },
                            {
                                "target_lang_word": "пугать",
                                "target_lang_sense_clarification": "о духах или призраках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出没",
                                "target_lang_sense_clarification": "指鬼魂在某地出现、游荡"
                            },
                            {
                                "target_lang_word": "作祟",
                                "target_lang_sense_clarification": "指鬼怪闹腾、捣乱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c4175db-27d2-30eb-8e40-c12af32ad32a",
                    "sense_definition": "a ghost, spirit, or phantom",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children were convinced they saw a <w>spook</w> in the abandoned house.",
                            "target_lang_translations": {
                                "ru": "Дети были убеждены, что видели <w>привидение</w> в заброшенном доме.",
                                "zh": "孩子们确信自己在那栋废弃的房子里看见了一个<w>幽灵</w>。"
                            }
                        },
                        {
                            "text": "The old building was reportedly haunted by a couple of <w>spooks</w>.",
                            "target_lang_translations": {
                                "ru": "По слухам, в старом здании обитали пара <w>призраков</w>.",
                                "zh": "据说那栋老楼里有几个<w>鬼魂</w>出没。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ghost",
                        "phantom",
                        "specter",
                        "spirit",
                        "apparition"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal term for a ghost"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "призрак, дух или фантом",
                        "zh": "鬼、幽灵或幻影。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "призрак",
                                "target_lang_sense_clarification": "видение, привидение"
                            },
                            {
                                "target_lang_word": "привидение",
                                "target_lang_sense_clarification": "дух умершего"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幽灵",
                                "target_lang_sense_clarification": "常见说法，指鬼或灵体"
                            },
                            {
                                "target_lang_word": "鬼魂",
                                "target_lang_sense_clarification": "较通用，指鬼怪、亡灵"
                            },
                            {
                                "target_lang_word": "鬼",
                                "target_lang_sense_clarification": "口语化说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "710a3391-5b39-3016-af2b-dd067b359a80",
                    "sense_definition": "an undercover agent, spy, or intelligence analyst",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espionage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government sent a <w>spook</w> to gather information on the rival organization.",
                            "target_lang_translations": {
                                "ru": "Правительство подослало <w>шпиона</w>, чтобы собрать информацию о конкурирующей организации.",
                                "zh": "政府派出了一名<w>特工</w>去搜集那个敌对组织的情报。"
                            }
                        },
                        {
                            "text": "He spent twenty years working as a <w>spook</w> for the intelligence agency.",
                            "target_lang_translations": {
                                "ru": "Он провел двадцать лет, работая <w>разведчиком</w> на спецслужбы.",
                                "zh": "他为情报机构当了二十年的<w>情报人员</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spy",
                        "agent",
                        "operative",
                        "intelligence officer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal term for a spy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "секретный агент, шпион или аналитик разведки",
                        "zh": "卧底特工、间谍或情报分析人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпион",
                                "target_lang_sense_clarification": "тайный агент"
                            },
                            {
                                "target_lang_word": "разведчик",
                                "target_lang_sense_clarification": "сотрудник спецслужб"
                            },
                            {
                                "target_lang_word": "ищейка",
                                "target_lang_sense_clarification": "пренебрежительно об агенте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "间谍",
                                "target_lang_sense_clarification": "最常见，对秘密从事情报活动的人"
                            },
                            {
                                "target_lang_word": "特工",
                                "target_lang_sense_clarification": "强调执行秘密任务的人员"
                            },
                            {
                                "target_lang_word": "情报人员",
                                "target_lang_sense_clarification": "较宽泛，可指情报机构工作人员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6071adee-cec2-32e6-94cc-4185032d6981",
                    "sense_definition": "a sudden scare or fright",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "frighten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The big spider gave me a real <w>spook</w> when it crawled across my desk.",
                            "target_lang_translations": {
                                "ru": "Большой паук вызвал у меня настоящий <w>испуг</w>, когда прополз по моему столу.",
                                "zh": "那只大蜘蛛从我桌上爬过时，真把我吓了一场<w>惊吓</w>。"
                            }
                        },
                        {
                            "text": "I didn't mean to give you a <w>spook</w> by jumping out like that.",
                            "target_lang_translations": {
                                "ru": "Я не хотел тебя <w>пугать</w>, выпрыгивая вот так.",
                                "zh": "我不是故意那样跳出来给你来一场<w>惊吓</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scare",
                        "fright",
                        "jolt",
                        "shock"
                    ],
                    "common_phrases": [
                        "give someone a spook"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "внезапный испуг или страх",
                        "zh": "突然的一吓，或突如其来的惊恐感觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испуг",
                                "target_lang_sense_clarification": "состояние внезапного страха"
                            },
                            {
                                "target_lang_word": "встряска",
                                "target_lang_sense_clarification": "сильное эмоциональное потрясение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惊吓",
                                "target_lang_sense_clarification": "突然受到惊吓的感觉或经历"
                            },
                            {
                                "target_lang_word": "惊吓一场",
                                "target_lang_sense_clarification": "口语化，指被狠狠吓了一次"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac9a42dc-baa0-35dc-85e6-57eb38d9c046",
                    "sense_definition": "a psychiatrist",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeons often referred to the hospital's psychiatrists as <w>spooks</w>.",
                            "target_lang_translations": {
                                "ru": "Хирурги часто называли больничных психиатров <w>мозгоправами</w>.",
                                "zh": "外科医生常把医院里的<w>精神科医生</w>那样戏称。"
                            }
                        },
                        {
                            "text": "He was sent to see a <w>spook</w> after the traumatic incident at work.",
                            "target_lang_translations": {
                                "ru": "Его отправили к <w>психиатру</w> после травмирующего инцидента на работе.",
                                "zh": "经历了那次工作中的创伤事件后，他被安排去看一位<w>精神科医生</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrink",
                        "psychiatrist"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory or informal medical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "психиатр (сленг)",
                        "zh": "精神科医生；原词是俚语，常带不礼貌或贬义色彩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мозгоправ",
                                "target_lang_sense_clarification": "ироничное или грубое название психиатра"
                            },
                            {
                                "target_lang_word": "психиатр",
                                "target_lang_sense_clarification": "врач-специалист"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神科医生",
                                "target_lang_sense_clarification": "最准确，对 psychiatrist 的常用说法；此义原词为俚语，常带贬义"
                            },
                            {
                                "target_lang_word": "心理医生",
                                "target_lang_sense_clarification": "较口语，但不如前者准确"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5a3b819-b5e1-3808-9e86-2cdd5813d612",
                    "sense_definition": "a black person",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ethnic_slur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The character used the word <w>spook</w> as a racial slur in the historical novel.",
                            "target_lang_translations": {
                                "ru": "Персонаж использовал слово <w>ниггер</w> как расовое оскорбление в историческом романе.",
                                "zh": "在那部历史小说里，这个角色把<w>黑鬼</w>这个词当作种族辱称来使用。"
                            }
                        },
                        {
                            "text": "He was shocked by the blatant use of the term <w>spook</w> in the old film.",
                            "target_lang_translations": {
                                "ru": "Он был шокирован вопиющим использованием слова <w>черномазый</w> в старом фильме.",
                                "zh": "他对那部老电影里公然使用<w>黑鬼</w>一词感到震惊。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "highly offensive racial slur"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "оскорбительное обозначение чернокожего человека",
                        "zh": "对黑人的极具侮辱性的种族蔑称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ниггер",
                                "target_lang_sense_clarification": "крайне оскорбительное расовое ругательство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黑鬼",
                                "target_lang_sense_clarification": "对黑人的极具侮辱性的蔑称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}