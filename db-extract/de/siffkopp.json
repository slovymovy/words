                        "sense_id": "a0a13be6-e127-3e18-a95b-e561cf4d3a72",
                        "entry_id": "105162fa-beba-33a9-9d5a-f1856dbc1f65",
                        "glosses": [
                            "Mensch, der nicht auf Ordnung und Hygiene bedacht ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a9704645-eaff-4412-80b0-ed504a87dcd1",
                                "sense_id": "a0a13be6-e127-3e18-a95b-e561cf4d3a72",
                                "text": "Lehrer: „Was ist das denn? Die Kniffte unter Deinem Tisch ist ja schon verschimmelt! Siffkopp!“"
                            },
                            {
                                "example_id": "cf71563d-4ece-4d6f-b524-dfdff98ab45f",
                                "sense_id": "a0a13be6-e127-3e18-a95b-e561cf4d3a72",
                                "text": "„Beispielsweise war ein auffallend Fettleibiger und zugleich Fresssüchtiger mit dem birnigen Spitznamen ‚Dicki, der Siffkopp‘ ständig in der Flüsterkneipe anzutreffen, […] Der unappetitliche Fettsack hat beim Essen immer geschwitzt wie in der Sauna […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
