                },
                {
                    "sense_id": "02b15a82-cbd8-3987-ad24-9d00adffb1e3",
                    "sense_definition": "To put forward an idea, theory, or argument for consideration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "proposal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist plans to <w>advance</w> a new theory about climate change.",
                            "target_lang_translations": {
                                "ru": "Учёный планирует <w>выдвинуть</w> новую теорию об изменении климата.",
                                "pl": "Naukowiec planuje <w>wysunąć</w> nową teorię na temat zmian klimatu."
                            }
                        },
                        {
                            "text": "Several arguments were <w>advanced</w> to support the new policy.",
                            "target_lang_translations": {
                                "ru": "Было <w>выдвинуто</w> несколько аргументов в поддержку новой политики.",
                                "pl": "Wysunięto kilka argumentów na poparcie nowej polityki."
                            }
                        }
                    ],
                    "synonyms": [
                        "adduce",
                        "allege"
                    ],
                    "common_phrases": [
