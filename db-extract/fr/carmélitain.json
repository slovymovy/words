                        "examples": [
                            {
                                "example_id": "41fbe6d8-1b18-4ea5-bfd6-064ef2c683d3",
                                "sense_id": "a275d3cd-fa19-3e56-a258-27705ef927d5",
                                "text": "Poète d'un lyrisme inégalé, universitaire à la théologie divine très sûre, Jean de la Croix réforme avec Thérèse d'Avila la vie carmélitaine espagnole."
                            },
                            {
                                "example_id": "c72388a7-3029-4e23-b388-6b1537ed5039",
                                "sense_id": "a275d3cd-fa19-3e56-a258-27705ef927d5",
                                "text": "Après la translation de la communauté dans le nouveau carmel, l’ancien monastère provisoire fut loué, pendant une dizaine d’années, à Mère Véronique, fondatrice du « tiers ordre carmélitain apostolique » pour l'instruction des filles en Inde."
                            }
                        ]
                    }
