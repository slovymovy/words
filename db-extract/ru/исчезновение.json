                                        "examples": [
                                            {
                                                "example_id": "3706ad7e-b933-478b-86dd-a9117c144278",
                                                "sense_id": "ee7f2b07-7743-3da5-878a-34b98522fdfb",
                                                "text": "Konsekwencją erozji jest zmniejszenie obiektu, zniknięcie wąskich gałęzi i małych obiektów, likwidacja szumu, rozszerzenie się „dziur” w niespójnym obszarze – przyjmują one kształt elementu strukturalnego."
                                            },
                                            {
                                                "example_id": "e4661319-471a-4bcd-a70e-befeb88c6003",
                                                "sense_id": "ee7f2b07-7743-3da5-878a-34b98522fdfb",
                                                "text": "Więc mówiła mu o połowie ryb, o gołębiach, o zniknięciu pary najładniejszych bażantów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
