                "senses": [
                    {
                        "sense_id": "848a31b6-23c8-3440-8405-f1d9ad878517",
                        "entry_id": "4c94b744-880f-39b7-b0fd-0181268fb5f0",
                        "glosses": [
                            "действие по значению гл. обольстить; обольщать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f707e125-5aa4-465c-b79f-4c5f060f1133",
                                "sense_id": "848a31b6-23c8-3440-8405-f1d9ad878517",
                                "text": "А все то же: вредные замыслы, корыстолюбие, плутовство и обольщение, тайные сборища, еретическая типография, поколебание и развращение умов, опаиванье зельем..."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d3515da-8d6d-3380-a24c-922038329b53",
                        "entry_id": "4c94b744-880f-39b7-b0fd-0181268fb5f0",
                        "glosses": [
                            "состояние по значению гл. обольститься, обольщаться; иллюзия"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "69ed46d4-dbd8-3878-a648-03aebe81b5de",
                        "entry_id": "4c94b744-880f-39b7-b0fd-0181268fb5f0",
                        "glosses": [
                            "то, что обольщает; соблазн, искушение"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6091b31a-2912-474d-a8b5-6dbe4ab45f8d",
                        "source_entry_id": "4c94b744-880f-39b7-b0fd-0181268fb5f0",
                        "target_lang_word": "seduction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seduction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cae1d0a5-4764-3556-b3e4-4c31c1b65087",
                                        "entry_id": "3c48f0d4-b300-3598-b098-6551645885ed",
                                        "glosses": [
                                            "The act of seducing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1693a474-6070-4713-89b5-bae25555d5b1",
                                                "sense_id": "cae1d0a5-4764-3556-b3e4-4c31c1b65087",
                                                "text": "Douglas: Well done on passing the test, Jen... Yes, all those clumsy attempts at seduction. Don't tell me you couldn't see through them. They were a test to find out whether you really wanted to work for me or whether you just wanted to come up here for my body.\nJen: Oh, no, no, no, no, no, not at all.\nDouglas: All right.\nJen: No, physically you're just not the sort of man I go for.\nDouglas: Yeah, thanks, Jen.\nJen: I go for the classically good-looking men: Blond, broad, and generally clean shaven.\nDouglas: Alright, yeah, enough of the jibber-jabber!"
                                            },
                                            {
                                                "example_id": "389d2505-16ca-46b4-ad45-8a97869a6143",
                                                "sense_id": "cae1d0a5-4764-3556-b3e4-4c31c1b65087",
                                                "text": "Seduction is the fine art of manipulating people based on physical attraction and desire. Step 1: Be attractive. Step 2: Don't be unattractive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0568f972-9a9c-382f-a460-9361c70a6563",
                                        "entry_id": "3c48f0d4-b300-3598-b098-6551645885ed",
                                        "glosses": [
                                            "The felony of, as a man, inducing a previously chaste unmarried female to engage in sexual intercourse on a promise of marriage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af521bdf-3c79-3298-9167-57521cc07229",
                                        "entry_id": "3c48f0d4-b300-3598-b098-6551645885ed",
                                        "glosses": [
                                            "A seductive aspect of something; appeal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bad1ded-b315-4e36-bd5c-5f862b612243",
                                                "sense_id": "af521bdf-3c79-3298-9167-57521cc07229",
                                                "text": "It is with no small degree of irony that I confess that immersing myself in an interdisciplinary project has warmed me to the seductions of disciplinary perspectives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
