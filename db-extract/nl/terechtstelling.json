                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b364e261-8799-4090-ac21-a0397a4f39d8",
                                "sense_id": "103216c8-c07c-3ca3-b28c-82eebc517f2d",
                                "text": "Het was tijd voor zijn terechtstelling."
                            },
                            {
                                "example_id": "e076a4a0-f227-42b8-8d7a-92924a59f841",
                                "sense_id": "103216c8-c07c-3ca3-b28c-82eebc517f2d",
