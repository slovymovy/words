    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6cc98a0-22fe-35e1-9f15-4940b743a1c2",
                    "sense_definition": "mimowolne i bolesne napięcie mięśnia",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od kilku dni dokuczają mi nocne <w>skurcze</w> w łydce.",
                            "target_lang_translations": {
                                "ru": "Уже несколько дней меня мучают ночные <w>судороги</w> в икрах."
                            }
                        },
                        {
                            "text": "Po intensywnym treningu poczułem nagły <w>skurcz</w> w nodze.",
                            "target_lang_translations": {
                                "ru": "После интенсивной тренировки я почувствовал резкую <w>судорогу</w> в ноге."
                            }
                        }
                    ],
                    "synonyms": [
                        "kurcz",
                        "spazm"
                    ],
                    "common_phrases": [
                        "bolesny skurcz",
                        "nocny skurcz"
                    ],
                    "target_lang_definitions": {
                        "ru": "непроизвольное и болезненное напряжение мышцы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судорога",
                                "target_lang_sense_clarification": "болезненное мышечное сокращение"
                            },
                            {
                                "target_lang_word": "спазм",
                                "target_lang_sense_clarification": "резкое непроизвольное сокращение мышц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bae1c0d-e1f9-34cb-9de7-b5c852f7e7fd",
                    "sense_definition": "zmniejszenie się objętości lub długości jakiegoś obiektu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Materiał pod wpływem wysokiej temperatury uległ <w>skurczowi</w>.",
                            "target_lang_translations": {
                                "ru": "Материал под воздействием высокой температуры дал <w>усадку</w>."
                            }
                        },
                        {
                            "text": "Gwałtowny <w>skurcz</w> metalu spowodował pęknięcie konstrukcji.",
                            "target_lang_translations": {
                                "ru": "Резкое <w>сжатие</w> металла привело к трещине в конструкции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skurcz materiału"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшение объема или длины какого-либо объекта"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усадка",
                                "target_lang_sense_clarification": "уменьшение размеров материала"
                            },
                            {
                                "target_lang_word": "сжатие",
                                "target_lang_sense_clarification": "процесс уменьшения объема под воздействием физических факторов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30ad978e-9fde-33ce-a005-ce014eb80bc9",
                    "sense_definition": "druga osoba liczby pojedynczej trybu rozkazującego od czasownika <w>skurczyć</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gramatyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Skurcz</w> tę tkaninę w gorącej wodzie przed szyciem.",
                            "target_lang_translations": {
                                "ru": "<w>Уменьши</w> эту ткань в горячей воде перед шитьем."
                            }
                        },
                        {
                            "text": "Jeśli chcesz, by pasowała, <w>skurcz</w> ją nieco w praniu.",
                            "target_lang_translations": {
                                "ru": "Если хочешь, чтобы она подошла, немного <w>уменьши</w> её при стирке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma czasownika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повелительное наклонение глагола «сжать» или «уменьшить в размере»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сожми",
                                "target_lang_sense_clarification": "повелительная форма от глагола сжать"
                            },
                            {
                                "target_lang_word": "уменьши",
                                "target_lang_sense_clarification": "повелительная форма от глагола уменьшить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
