        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80fc5e62-35f8-3212-b17b-67d4824a0d96",
                    "sense_definition": "To promote heavily; to advertise or build up.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "promotion_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is <w>hyping</w> its new smartphone as a revolutionary device.",
                            "target_lang_translations": {
                                "ru": "Компания <w>раскручивает</w> свой новый смартфон как революционное устройство.",
                                "zh": "这家公司正在把它的新款智能手机<w>大肆宣传</w>成革命性设备。",
                                "es": "La empresa está <w>promocionando</w> su nuevo teléfono inteligente como un dispositivo revolucionario."
                            }
                        },
                        {
                            "text": "They <w>hyped</w> the event for weeks, but attendance was surprisingly low.",
                            "target_lang_translations": {
                                "ru": "Они <w>пиарили</w> мероприятие неделями, но посещаемость была удивительно низкой.",
                                "zh": "他们为这场活动<w>大肆炒作</w>了好几个星期，但到场人数却出奇地少。",
                                "es": "Dieron mucho <w>bombo</w> al evento durante semanas, pero la asistencia fue sorprendentemente baja."
                            }
                        }
                    ],
                    "synonyms": [
                        "promote",
                        "advertise",
                        "publicize",
                        "plug"
                    ],
                    "common_phrases": [
                        "hype up",
                        "hype the product"
                    ],
                    "target_lang_definitions": {
                        "ru": "Активно рекламировать, создавать шумиху вокруг чего-либо.",
                        "zh": "大力宣传；刻意炒热、抬高声势。",
                        "es": "Promocionar algo intensamente, a menudo creando una expectación exagerada."
