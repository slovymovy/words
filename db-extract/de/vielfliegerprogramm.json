                ],
                "senses": [
                    {
                        "sense_id": "92ef2e60-b91f-32df-b863-394302bcb04c",
                        "entry_id": "64a06fb1-d8d0-35f0-b833-040238913356",
                        "glosses": [
                            "ein Vielfliegerprogramm soll die Kundenbindung verstärken, indem die häufige Nutzung von Flügen einer Fluggesellschaft die an diesem Programm teilnimmt mit Rabatten oder Prämien belohnt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c8dcb6-0946-447a-9ed4-a31acb6c4c20",
                                "sense_id": "92ef2e60-b91f-32df-b863-394302bcb04c",
                                "text": "„Großaktionär Etihad, der mit 29 Prozent bei Air Berlin eingestiegen ist und schon vor mehr als einem Jahr mit einer rettenden Kapitalspritze aushelfen musste, hat angekündigt, die Mehrheit am Air-Berlin-Vielfliegerprogramm \"Topbonus\" zu übernehmen.“"
                            },
                            {
                                "example_id": "19286a9f-6c17-4fe7-9c73-7c2cfb71c1ea",
                                "sense_id": "92ef2e60-b91f-32df-b863-394302bcb04c",
                                "text": "„Längst wird die Mehrzahl der Meilen beim Vielfliegerprogramm Miles and More der Lufthansa nicht mehr mit Flügen verdient, sondern beim Kauf ganz anderer Dinge: Aktienfonds und Zeitschriftenabonnements, sogar für Autoreifen gibt es heute Meilengutschriften.“"
                            },
                            {
                                "example_id": "1dd03912-df02-4479-8594-c4da7c84ecf2",
                                "sense_id": "92ef2e60-b91f-32df-b863-394302bcb04c",
                                "text": "„Mit der Überführung vom Vielfliegerprogramm Swiss Travel Club in Miles & More am 1. April wurde die im vergangenen Sommer angelaufene Zusammenarbeit der beiden Programme abgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
