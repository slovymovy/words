                                    },
                                    {
                                        "sense_id": "3a7d0f08-d7d1-3668-8eca-92d014f4cb63",
                                        "entry_id": "24111fed-7f4d-32b8-baff-f8e3efd1e404",
                                        "glosses": [
                                            "Excessive praise."
                                        ],
