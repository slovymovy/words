        "fr-extract.jsonl": [
            {
                "entry_id": "84256053-d99f-361f-bc6e-d82c2b5da44c",
                "word": "désastreusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d0a4f85-3140-3012-9aa8-c122395d6a5a",
                        "entry_id": "84256053-d99f-361f-bc6e-d82c2b5da44c",
                        "glosses": [
                            "D’une manière désastreuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6026a6-4257-409e-9fee-05b86cdcd9fb",
                                "sense_id": "2d0a4f85-3140-3012-9aa8-c122395d6a5a",
                                "text": "La fête a fini désastreusement."
                            },
                            {
                                "example_id": "2bf42239-61fc-498e-aa6c-d774092db099",
                                "sense_id": "2d0a4f85-3140-3012-9aa8-c122395d6a5a",
                                "text": "Elle portait une robe de chaly vert tendre dont le dessin imitait des branches de corail ; ses manches étaient immenses et désastreusement soutenues à l’intérieur par des ronds de crin baleinés, qui les empêchaient de perdre un pouce de leur ampleur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0391fd3-db4d-4150-8334-42be6ef5c24a",
                        "source_entry_id": "84256053-d99f-361f-bc6e-d82c2b5da44c",
                        "source_sense_id": "2d0a4f85-3140-3012-9aa8-c122395d6a5a",
                        "target_lang_word": "disastrously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disastrously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f35bec9b-3c6d-3c00-b860-6a8b8f47ea28",
                                        "entry_id": "07e69285-218d-3cc9-ada7-a78159d84b50",
                                        "glosses": [
                                            "In a disastrous way. (Of the nature of a disaster; calamitously.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf6c29b-21d5-4fbb-accd-b02d5f90647b",
                                                "sense_id": "f35bec9b-3c6d-3c00-b860-6a8b8f47ea28",
                                                "text": "It has frequently been found that these [timber dry] docks have been incapable of successfully resisting this force, and in many instances the altars have been forced off, the sides of the entrance works have been forced inward, the bottom of the dock has been uplifted, and, where defects in the work have existed, an inflood of water once set up has resulted very disastrously and endangered the entire structure."
                                            },
                                            {
                                                "example_id": "34158e30-3307-4455-b059-9b07607ee563",
                                                "sense_id": "f35bec9b-3c6d-3c00-b860-6a8b8f47ea28",
                                                "text": "Mr. Dukakis charged that when it came to advising President Reagan on Iran, Mr. Bush was \"disastrously and completely and unforgivably wrong.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
