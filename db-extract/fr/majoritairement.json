                                "target_senses": [
                                    {
                                        "sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
                                        "entry_id": "12852ca7-a046-3253-b9e5-70508fa17037",
                                        "glosses": [
                                            "In a predominant manner. Most commonly or frequently by a large margin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf322be5-86a3-4e7f-be10-fcf5c53b1d21",
                                                "sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
                                                "text": "The membership is predominantly elderly, as 90% are over age 60."
                                            },
                                            {
                                                "example_id": "c26530e3-0d53-4d65-8f38-9252cff066ee",
                                                "sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
                                                "text": "Both groups are predominantly confined to areas with warm to tropical climates[…]"
                                            },
                                            {
                                                "example_id": "371583e4-7935-4191-8084-1d4d8ac7b0c6",
                                                "sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
                                                "text": "The first phase of our pilot study found that the signage on the campus grounds was well regulated by the institution and was predominantly English."
                                            },
                                            {
                                                "example_id": "d76afe74-2dee-4b35-9af0-cf036a0d082f",
                                                "sense_id": "69dc8656-2626-37f1-b1bb-5a579fd6e181",
                                                "text": "“With the food packages that we drop off, we are adding messages in the local dialect of Xhosa, because this is predominately for the Xhosa areas,” Kolisi said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
