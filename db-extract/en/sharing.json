                "senses": [
                    {
                        "sense_id": "d8eba497-c100-3582-9a53-6fdac21a1124",
                        "entry_id": "6a3e3b6c-c802-3ff0-9b3a-9aad7567cb66",
                        "glosses": [
                            "Something shared; a point in common."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38bfb34c-d1fe-4f80-8abf-8157c5c218d2",
                                "sense_id": "d8eba497-c100-3582-9a53-6fdac21a1124",
                                "text": "IE also has sharings with Nakh-Daghestanian, Semitic, and Sumerian. IE and Kartvelian, and no other languages, share numerals with Semitic."
                            }
                        ]
                    },
                    {
                        "sense_id": "96c7abc4-69e6-3719-8a02-e23eb20d8cfd",
                        "entry_id": "6a3e3b6c-c802-3ff0-9b3a-9aad7567cb66",
                        "glosses": [
                            "The act by which something is shared."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a000fb-e4d7-4336-8080-c67dac2714ee",
                                "sense_id": "96c7abc4-69e6-3719-8a02-e23eb20d8cfd",
                                "text": "Roe v. Wade was preceded by all those moments that make a movement: tentative and explosive sharings in kitchens and CR groups; times of great courage and stillness, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "136b42c3-f7b6-49b1-82b5-79ed97d45a61",
                        "source_entry_id": "6a3e3b6c-c802-3ff0-9b3a-9aad7567cb66",
                        "source_sense_description": "a common point",
                        "target_lang_word": "partage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "partage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                        "entry_id": "22c11b14-db84-37a8-be33-53d72f2c35d6",
                                        "glosses": [
                                            "Division de quelque chose en plusieurs portions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81b71aa-e6f8-44d1-8d5a-16eb8cd8d93d",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Le partage d’un pays conquis."
                                            },
                                            {
                                                "example_id": "41df649b-2df7-4458-9d0d-a85178ffeffc",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Les enfants peuvent venir à partage de la succession de leur père, ou y renoncer."
                                            },
                                            {
                                                "example_id": "302df2ea-8a5b-406c-b561-0361e13a4ba3",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Procéder à un partage."
                                            },
                                            {
                                                "example_id": "712153d3-aace-45ae-a5f6-53d405ae3eab",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Il entre en partage avec les autres héritiers."
                                            },
                                            {
                                                "example_id": "8a42f3a0-8983-4086-96e5-2ffdce42095a",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "C’était pour elle le seul moment de la journée où elle avait son père sans partage."
                                            },
                                            {
                                                "example_id": "8699b7e3-b0ad-4e67-8ffb-1db82306f0b6",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Faire le partage d’une succession."
                                            },
                                            {
                                                "example_id": "fe1fb8ee-9c93-482f-8421-0a6132f5d1c2",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Faire le partage des meubles qu’on a achetés en commun."
                                            },
                                            {
                                                "example_id": "5a961589-7e59-403d-a37c-c2503ec805ce",
                                                "sense_id": "207ba5b9-f8f8-332f-ba12-2d2c7bf05f5d",
                                                "text": "Faire le partage du butin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "329a99fe-a84b-3186-8f38-5c780c37450b",
                                        "entry_id": "22c11b14-db84-37a8-be33-53d72f2c35d6",
                                        "glosses": [
                                            "Portion de la chose partagée, qui est assignée à chaque partageant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec190f01-8fc2-4312-8fe3-f95adeb8418f",
                                                "sense_id": "329a99fe-a84b-3186-8f38-5c780c37450b",
                                                "text": "Il rappelle que jamais les archevêques de Lyon n’eurent le Franc-Lyonnais en partage, que la plupart des seigneuries appartenaient au chapitre, et que l'archevêque n'en possédait qu'une partie ; […]."
                                            },
                                            {
                                                "example_id": "2f41a5b1-6946-4351-b08c-2afcb941da8b",
                                                "sense_id": "329a99fe-a84b-3186-8f38-5c780c37450b",
                                                "text": "Partage égal ou inégal."
                                            },
                                            {
                                                "example_id": "a288caa0-5ec3-4a46-9b1e-d17cb1c504fe",
                                                "sense_id": "329a99fe-a84b-3186-8f38-5c780c37450b",
                                                "text": "Cette ferme m’est échue, m’est tombée en partage. — C’est le notaire qui a fait les partages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f2ca07-ef89-3e51-b75c-bf2013aa8a67",
                                        "entry_id": "22c11b14-db84-37a8-be33-53d72f2c35d6",
                                        "glosses": [
                                            "Ce que l'on tient de la nature ou de la fortune, en parlant des biens et des maux, des qualités bonnes ou mauvaises."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19a5e6a7-4e50-47b2-a236-59e003f7b284",
                                                "sense_id": "16f2ca07-ef89-3e51-b75c-bf2013aa8a67",
                                                "text": "Les maladies et les misères sont le partage du genre humain. — Le ciel lui a donné en partage un noble caractère."
                                            },
                                            {
                                                "example_id": "797c5f79-8a33-438f-a293-8b18ee8239a7",
                                                "sense_id": "16f2ca07-ef89-3e51-b75c-bf2013aa8a67",
                                                "text": "Une absurde vanité lui est échue en partage. — Il eut pour son partage la misère et la souffrance."
                                            },
                                            {
                                                "example_id": "daa6a972-5d74-499a-a539-c97a4530a0a0",
                                                "sense_id": "16f2ca07-ef89-3e51-b75c-bf2013aa8a67",
                                                "text": "Ce qui nous frappa tout d'abord quand nous entrâmes à Jerez, ce fut un air de bien-être, de richesse, de propreté, qui n'est pas le partage de toutes les petites villes espagnoles."
                                            },
                                            {
                                                "example_id": "69325c13-de33-40b8-b41a-b501ae9c82b8",
                                                "sense_id": "16f2ca07-ef89-3e51-b75c-bf2013aa8a67",
                                                "text": "Mlle de Neulise était bien sûre que M. de Savines avait la bonté en partage. !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad72ec2f-14b3-3702-a827-cb3de00abcf6",
                                        "entry_id": "22c11b14-db84-37a8-be33-53d72f2c35d6",
                                        "glosses": [
                                            "Répartition égale, en parlant des opinions, des votes, des suffrages d’une assemblée, d’une compagnie délibérante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bac3cef9-478f-4f21-89c3-3426c48b711c",
                                                "sense_id": "ad72ec2f-14b3-3702-a827-cb3de00abcf6",
                                                "text": "Partage de voix, d’opinions."
                                            },
                                            {
                                                "example_id": "e0d3f625-afa8-47b1-a1e8-68a2e4f6e26e",
                                                "sense_id": "ad72ec2f-14b3-3702-a827-cb3de00abcf6",
                                                "text": "En cas de partage, on recommencera le scrutin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "partage",
