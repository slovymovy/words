                                "example_id": "04e9444c-2417-4a50-ab4a-7037e2041854",
                                "sense_id": "3aef8d19-db57-3b67-bec5-2b40c8a5aa20",
                                "text": "Bleirohre wurden früher für Trinkwasserleitungen verwendet."
                            },
                            {
                                "example_id": "8b946298-366c-40a9-807a-901f2ecb5e68",
                                "sense_id": "3aef8d19-db57-3b67-bec5-2b40c8a5aa20",
                                "text": "„Wegen eines neuen, strengeren Grenzwertes für Trinkwasser müssen Bleirohre in älteren Gebäuden künftig in der Regel ausgetauscht werden.“"
                            }
                        ],
