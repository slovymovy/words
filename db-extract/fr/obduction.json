                                        "sense_id": "e9e8f98a-3392-3a1e-b34c-ff04f82412a5",
                                        "entry_id": "92a526f1-9703-3e5b-8763-bf119a31eb7b",
                                        "glosses": [
                                            "The act of drawing or laying over, as a covering."
                                        ],
