                                            "To make oneself ready; to get ready, make preparation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c7f88b-e6fc-43f3-b832-b9c61bfacab2",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "We prepared for a bumpy ride."
                                            },
                                            {
                                                "example_id": "92200ba6-1a18-4917-871a-2a3c79d8ca19",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "As soon as Julia returned with a constable, Timothy, who was on the point of exhaustion, prepared to give over to him gratefully. The newcomer turned out to be a powerful youngster, fully trained and eager to help, and he stripped off his tunic at once."
                                            },
                                            {
                                                "example_id": "15d980aa-b2d6-4fd7-b8ce-6df3332e8477",
                                                "sense_id": "af04f53e-08b4-3c08-8508-269bfba460fd",
                                                "text": "Tourists visited a memorial hall adorned by a slogan in the handwriting of Chiang Kai-shek, Taiwan's divisive former nationalist leader: \"Stay alert and prepare for battle.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ace6ec1-44d6-3044-bc29-e1fcb8f815df",
                                        "entry_id": "ec3e234e-c236-3af2-a64d-02c7b7de1cdc",
                                        "glosses": [
                                            "To produce or make by combining elements; to synthesize, compound."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be5cf9ed-22fe-4664-b70d-732d53dd38d8",
                                                "sense_id": "1ace6ec1-44d6-3044-bc29-e1fcb8f815df",
                                                "text": "She prepared a meal from what was left in the cupboards."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prepare",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a694783-27cb-34b1-93ed-6e7e08e28ff1",
                                        "entry_id": "8b3cd839-e7c9-32c6-9d96-b895405f280d",
                                        "glosses": [
                                            "preparation"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ffb353-d530-49a8-8086-b79f6a4db01d",
                                                "sense_id": "8a694783-27cb-34b1-93ed-6e7e08e28ff1",
                                                "text": "Go levy men, and make prepare for war;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41ed93f1-6146-40d4-8a7a-b9684a4069b2",
