                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d75ecb13-370e-40cb-9738-019344e4ab44",
                                "sense_id": "723bc449-9422-3cc2-b240-d6dcca6d4d7e",
                                "text": "„Ich möchte noch nicht einmal eine Mücke mit Insektenspray umbringen, wenn ich in Südfrankreich bin.“"
                            },
                            {
                                "example_id": "bf65e1c1-6981-47cc-a20e-84b675c893e3",
                                "sense_id": "723bc449-9422-3cc2-b240-d6dcca6d4d7e",
                                "text": "„In Claras und Davids Bungalow entdeckten wir zum Glück unzählige Fläschchen Insektenspray.“"
                            },
                            {
                                "example_id": "8004c193-3578-4e78-a830-5467f6aec9f9",
                                "sense_id": "723bc449-9422-3cc2-b240-d6dcca6d4d7e",
                                "text": "„Das Letzte, woran sich Joanne erinnern konnte, war dieses unsagbar stinkende und ätzende Insektenspray.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
