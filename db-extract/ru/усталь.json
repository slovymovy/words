                        "form": "*у́сталях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                        "entry_id": "95e90c3a-b9af-33e1-8b46-5570b9aa02d7",
                        "glosses": [
                            "то же, что усталость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1d2991c-3638-43f5-9a88-88b9fbad9f82",
                                "sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                                "text": ".. он целый день без устали работал под дождём у себя на ферме."
                            },
                            {
                                "example_id": "bdad8b4f-7915-46e0-8fca-94baa5301561",
                                "sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                                "text": "Мы сражаемся без устали, а выходит, и сражаться-то не за что!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10ff191a-0152-4cb6-a814-e3e787e69206",
                        "source_entry_id": "95e90c3a-b9af-33e1-8b46-5570b9aa02d7",
                        "source_sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                        "target_lang_word": "Müdigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müdigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                        "entry_id": "34be500c-ea5e-3807-ab22-9a5f95ce6694",
                                        "glosses": [
                                            "Zustand des Schlafmangels oder des Unausgeruhtseins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e488c2b-b5db-4c16-b5e6-2d568f3e01f7",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "„Es überkam sie jenes Träumen von nie wiederkehrenden Dingen, jene Müdigkeit, die uns angesichts jeder unabänderlichen Tatsache übermannt, jener Schmerz schließlich, den uns die Unterbrechung jeder gewohnt gewordenen Bewegung bringt, das jähe Aufhören einer Schwingung, die lange angedauert hat.“"
                                            },
                                            {
                                                "example_id": "30a4b18c-fb89-4c8a-826d-613063acdb92",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "Die Müdigkeit überkam sie sofort nach der Arbeit."
                                            },
                                            {
                                                "example_id": "fb46582a-6f0f-4cf8-9611-529ddfae852e",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "„Ich verspürte Müdigkeit, und ich dachte daran, daß ich am nächsten Morgen früh an Deck zu sein hatte.“"
                                            },
                                            {
                                                "example_id": "4bdb4ae8-eeed-4bf0-93b1-e1f36e342d0c",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "„Eine halbe Flasche Rotwein half mir, aus der überdrehten Müdigkeit in den Schlaf zu finden.“"
                                            },
                                            {
                                                "example_id": "61fc9545-d0c9-4abb-84b8-ae8a779ada62",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "„Eine Wolke von Müdigkeit lagert noch über ihm.“"
                                            },
                                            {
                                                "example_id": "4a5b3523-39f1-4772-9a19-8c05879c6d5e",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "Als ich ihn fragte, woher er so müde ist, meinte er: \"Auf den Winterschlaf folgt die Frühjahrsmüdigkeit gefolgt von der Sommerlethargie\"."
                                            },
                                            {
                                                "example_id": "cf679eb1-5676-45c9-8438-5fde94db9e22",
                                                "sense_id": "6bf2bffb-617a-3460-8f4e-5773c20f8561",
                                                "text": "Nach dem Marathon spürte ich eine Müdigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86c8c481-f77e-32b1-9355-2bad483a9d73",
                                        "entry_id": "34be500c-ea5e-3807-ab22-9a5f95ce6694",
                                        "glosses": [
                                            "Zustand der Überanstrengung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2076e9e6-884c-4911-ac5f-bd6aeeae0ff1",
                                                "sense_id": "86c8c481-f77e-32b1-9355-2bad483a9d73",
                                                "text": "Nach dem Marathon spürte ich eine Müdigkeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9fc0017-9cb6-4488-a9b2-6c90fdbaf86f",
                        "source_entry_id": "95e90c3a-b9af-33e1-8b46-5570b9aa02d7",
                        "source_sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                        "target_lang_word": "Erschöpfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erschöpfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Zustand aufgebrauchter Reserven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9c0146c-747b-4b41-baed-86e0815ba621",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "Die Erschöpfung der Mine brachte über 1000 Bergleute um ihren Arbeitsplatz."
                                            },
                                            {
                                                "example_id": "19390d89-8f36-4048-9083-1616fa197a2e",
                                                "sense_id": "ed1be0f2-7579-32dd-9453-e4effafc99e3",
                                                "text": "„In St. Joachimsthal begannen nach der Erschöpfung der reichsten Lagerstättenpartien die Ausbeuten aus den Silbergruben von der Mitte des 16. Jahrhunderts an bedenklich zu sinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                        "entry_id": "0fd17766-591c-3669-9743-211d4f99ba9f",
                                        "glosses": [
                                            "Schwäche, Kraftlosigkeit und sehr starke Ermüdung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b101c5ff-1983-4017-99bf-7b7214d5b17c",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "Er rannte bis zur völligen Erschöpfung."
                                            },
                                            {
                                                "example_id": "ef931d32-e67c-4fcb-9e56-d2cc03f22ecd",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Doch auch wenn es zu allen Zeiten vom Leben ermattete Menschen gab - die Erschöpfung als Massenleiden ist wohl wirklich ein Phänomen unserer Zeit.“"
                                            },
                                            {
                                                "example_id": "58660a59-3839-4c01-bb03-5c42d0e08017",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Trotz ihrer Erschöpfung gingen sie noch hundert Yards weiter.“"
                                            },
                                            {
                                                "example_id": "3d594bcc-580f-4a5d-ae19-a17636324195",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Melanie sah ihm die Erschöpfung an.“"
                                            },
                                            {
                                                "example_id": "4d02e06a-10fc-4372-acf4-9249fd2f6dfa",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Blutverlust und frühere Erschöpfung hatten die Kräfte des jungen Menschen so ganz aufgerieben, daß sie ihn kaum mit Anstrengung aller ihrer Kräfte aufrecht erhalten konnten.“"
                                            },
                                            {
                                                "example_id": "2105a317-323b-4cf7-891f-71401f1b8bc3",
                                                "sense_id": "fcc24bb0-ddea-38c3-8052-b8d79b494c57",
                                                "text": "„Überflüssige Anstrengung bedeutete Erschöpfung, und Erschöpfung bedeutete unweigerllich den Tod.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21a0a4b-7365-4ea0-87ca-3b8e6ac3c2d3",
                        "source_entry_id": "95e90c3a-b9af-33e1-8b46-5570b9aa02d7",
                        "source_sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                        "target_lang_word": "lassitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lassitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "384ae00f-a6fc-365f-ae2d-f8f04ef259af",
                                        "entry_id": "4dc2e116-df1e-3898-86d2-85e39062e294",
                                        "glosses": [
                                            "Sensation de fatigue causée par une mauvaise disposition de santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfb38c68-b017-401a-853b-db5b240da22f",
                                                "sense_id": "384ae00f-a6fc-365f-ae2d-f8f04ef259af",
                                                "text": "J’avais les membres roidis et ressentais une si pénible lassitude, que je restai longtemps sans pouvoir trouver le sommeil."
                                            },
                                            {
                                                "example_id": "85df95c1-146f-4ef4-b712-2450faf8cbaa",
                                                "sense_id": "384ae00f-a6fc-365f-ae2d-f8f04ef259af",
                                                "text": "Il a renoncé à cette correspondance par pure lassitude d’avoir toujours les mêmes choses à dire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3068a9b8-306b-34b6-857d-d4a8aa7f5f7a",
                                        "entry_id": "4dc2e116-df1e-3898-86d2-85e39062e294",
                                        "glosses": [
                                            "État de celui qui est las, de celle qui est lasse, au propre et au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7be6ab91-4053-4b5e-998e-8a36c52f8f3c",
                                                "sense_id": "3068a9b8-306b-34b6-857d-d4a8aa7f5f7a",
                                                "text": "La douceur alanguie du printemps ne faisait que rendre plus lourde la lassitude de Zaheira."
                                            },
                                            {
                                                "example_id": "9edc1ef3-942b-4fa7-adb5-8b296473b085",
                                                "sense_id": "3068a9b8-306b-34b6-857d-d4a8aa7f5f7a",
                                                "text": "Une restauration n’est possible qu’aux brefs instants de lassitude quand les idées, les hommes et les faits s'accordent une trêve, quand l’essoufflement rompt l’assaut des générations montantes."
                                            },
                                            {
                                                "example_id": "f25eede9-8a55-4f61-b466-ce33cc44424f",
                                                "sense_id": "3068a9b8-306b-34b6-857d-d4a8aa7f5f7a",
                                                "text": "Je l’écoutais à peine. J’avais cédé de guerre lasse. Elle avait l’ardeur de ses 16 ans et moi la lassitude de mes sept décennies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fa4c86e-2215-400a-91f8-105d85b5dc0a",
                        "source_entry_id": "95e90c3a-b9af-33e1-8b46-5570b9aa02d7",
                        "source_sense_id": "21ec9f40-4720-3550-bc30-f610b9e9d7ed",
                        "target_lang_word": "fatigue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatigue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "098770d3-9db9-3a16-8e99-9333c0978b9a",
                                        "entry_id": "3ad8cd6b-44d1-3360-b0dc-1653a827f218",
                                        "glosses": [
                                            "Sensation de faiblesse physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31151e5f-d478-40d2-947b-22a38116679c",
                                                "sense_id": "098770d3-9db9-3a16-8e99-9333c0978b9a",
                                                "text": "Cependant la fatigue physique commençait à lutter avec la préoccupation morale, et, lorsque onze heures et demie sonnèrent, il était temps qu’arrivât la fin de sa veille, car ses yeux se fermaient malgré lui."
                                            },
                                            {
                                                "example_id": "f29d4509-2754-4891-a55a-2f2016d49689",
                                                "sense_id": "098770d3-9db9-3a16-8e99-9333c0978b9a",
                                                "text": "Elle s’assit sur une chaise, lourdement. Un eût dit qu’une fatigue, tout d’un coup, lui avait cassé les membres."
                                            },
                                            {
                                                "example_id": "49287dc2-842f-4d98-bc28-29bc7a2a7a1e",
                                                "sense_id": "098770d3-9db9-3a16-8e99-9333c0978b9a",
                                                "text": "Je n’en entendis pas davantage. J’étais moralement épuisé. Ma fatigue physique dépassa même toute mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                        "entry_id": "3ad8cd6b-44d1-3360-b0dc-1653a827f218",
                                        "glosses": [
                                            "Trop grande dépense de force qui cause de la lassitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2b6cfbc-5bd5-4722-b630-3f10eae682c3",
                                                "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                                "text": "La Girafe, excitée à fuir, se presse, s’emporte, et est bientôt hors de vue ; mais elle ne soutient point longtemps cet effort, qu’elle ressent comme une fatigue."
                                            },
                                            {
                                                "example_id": "aa660d7f-42cf-4c0c-bdb8-e847dbd26d94",
                                                "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                                "text": "C’est pour la société qu’il a des valets qui l’ennuient, et un luxe de maison qui lui est une fatigue."
                                            },
                                            {
                                                "example_id": "445f35f9-8567-4cfe-9ccf-42554b17f93e",
                                                "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                                "text": "Les nouaïb […] sont des hordes absolument indisciplinées, mais parmi lesquelles on trouve certainement d’excellents cavaliers, des fantassins durs à la fatigue et de bons tireurs."
                                            },
                                            {
                                                "example_id": "2d68808a-771c-44b9-9171-012cf576245f",
                                                "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                                "text": "Dites donc, vous autres, – les apostropha-t-il, […], – je meurs de fatigue, et je ne me tiens plus sur les jambes d’avoir été si longtemps en selle. Impossible de vous accorder une seule seconde d’entretien, je suis fourbu, esquinté."
                                            },
                                            {
                                                "example_id": "56a9cd27-e155-4911-a8ba-129ccc0d3b2a",
                                                "sense_id": "b00b0b32-81ad-3517-907b-ce64e982cf4a",
                                                "text": "Les carnitines aident au transport des acides gras à longue chaîne du cytoplasme aux mitochondries, ce qui peut augmenter la production d'énergie dans les cellules et combattre la fatigue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fae8f12-e02a-3150-9dfb-4728d3bf037f",
                                        "entry_id": "3ad8cd6b-44d1-3360-b0dc-1653a827f218",
                                        "glosses": [
                                            "Perte de résistance, présence d’un point de fragilité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "761e8b84-eae6-37d6-b535-f92a2e006820",
                                        "entry_id": "3ad8cd6b-44d1-3360-b0dc-1653a827f218",
                                        "glosses": [
                                            "Mécanisme de dégradation d'un matériau sous l'effet de petites sollicitations répétées des milliers voire des millions de fois."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
