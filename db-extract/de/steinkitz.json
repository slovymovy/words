                "senses": [
                    {
                        "sense_id": "0fbf72e3-939a-3488-a33b-87d52d8aea13",
                        "entry_id": "b7e8dd55-c229-38ef-9864-586e3954e30d",
                        "glosses": [
                            "Jungtier des Steinbocks"
                        ],
                        "tags": [
                            "Jagd"
                        ],
                        "examples": [
                            {
                                "example_id": "7fced0b7-b0f7-4920-b2cf-9fa8b09e82ac",
                                "sense_id": "0fbf72e3-939a-3488-a33b-87d52d8aea13",
                                "text": "„Sie wurde für ihr Projekt, die Patenschaft für das Steinkitz Mägi, mit 1500 Franken und einem Drachen für jedes Kind belohnt.“"
                            },
                            {
                                "example_id": "3a0fd2ea-726e-4088-9d04-429df4e14373",
                                "sense_id": "0fbf72e3-939a-3488-a33b-87d52d8aea13",
                                "text": "„Steinkitze werden etwa sechs Monate von der Mutter gesäugt, bevor sie selbständig werden.“"
                            },
                            {
                                "example_id": "26a42047-443f-4626-9e36-f660f3251de4",
                                "sense_id": "0fbf72e3-939a-3488-a33b-87d52d8aea13",
                                "text": "„Gleich nach der Geburt folgen Steinkitze ihren Müttern. Die agilen Jungtiere schließen sich innerhalb des Rudels zu einem „Kindergarten“ zusammen.“"
                            },
                            {
                                "example_id": "cc552cf7-9cd0-4e91-9937-e2ce17e8a7ab",
                                "sense_id": "0fbf72e3-939a-3488-a33b-87d52d8aea13",
                                "text": "1906 lieferte der Wilderer Joseph Bérard erstmals aus dem königlichen Jagdgebiet im Aostatal, Italien, die ersten Steinkitze nach St. Gallen. Ein Steinkitz kostete damals so viel wie heute ein Auto mittlerer Klasse."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
