        "nl-extract.jsonl": [
            {
                "entry_id": "1513a606-8fb7-3854-89fc-ad94ff09c0db",
                "word": "aanzwellend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cfd9384e-1831-3e9a-ba44-31715bbd2fbb",
                        "entry_id": "1513a606-8fb7-3854-89fc-ad94ff09c0db",
                        "glosses": [
                            "in omvang toenemend, groter wordend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c7bdeb-23b8-40aa-b502-b99f536f6ccf",
                                "sense_id": "cfd9384e-1831-3e9a-ba44-31715bbd2fbb",
                                "text": "Ook de hoge werkdruk leidt tot aanzwellende kritiek."
                            },
                            {
                                "example_id": "3bf89d5f-2ffe-4585-a79b-a4d11ee097e6",
                                "sense_id": "cfd9384e-1831-3e9a-ba44-31715bbd2fbb",
                                "text": "Personeel van de IJsselhallen dirigeert de aanzwellende stroom bezoekers rond acht uur richting de concertzaal."
                            },
                            {
                                "example_id": "01a5a768-20a0-4d3f-bda8-552a946dc088",
                                "sense_id": "cfd9384e-1831-3e9a-ba44-31715bbd2fbb",
                                "text": "Het duurt een paar tellen voordat hij het gezicht kan plaatsen, hij bestudeert het alsof zijn herinneringen het beeld kunnen scherpstellen. Ze staat een paar meter verderop. Hij zou haar zó kunnen roepen, dan zou ze opkijken en hij zou naar haar glimlachen. In één klap zijn de afgelopen dertig jaar ongedaan gemaakt. Onder de grijze golven van het IJ die tegen de kade klotsen en het geronk van de boot hoort hij een aanzwellend koor in zijn hoofd van vrouwenstemmen."
                            }
                        ]
                    }
