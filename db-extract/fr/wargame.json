        "de-extract.jsonl": [
            {
                "entry_id": "1be8574d-cd1d-3a5a-b5fc-a6b14174d217",
                "word": "wargame",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d267bf8-219c-3b15-8c41-673e3c94f5cd",
                        "entry_id": "1be8574d-cd1d-3a5a-b5fc-a6b14174d217",
                        "glosses": [
                            "Spiel, das einen kriegerischen Konflikt simuliert; Kriegsspiel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "036fc034-2932-4308-bb88-ce7352451874",
                        "source_entry_id": "1be8574d-cd1d-3a5a-b5fc-a6b14174d217",
                        "source_sense_id": "5d267bf8-219c-3b15-8c41-673e3c94f5cd",
                        "source_sense_description": "Spiel, das einen kriegerischen Konflikt simuliert; Kriegsspiel",
                        "target_lang_word": "Kriegsspiel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kriegsspiel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                        "entry_id": "f9d5b4ec-461a-3fec-8720-5c7d42e14f5a",
                                        "glosses": [
                                            "kriegsähnliches Unterhaltungs- und Gesellschaftsspiel mit symbolischen Kriegshandlungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c0df01-61ad-41b0-b5ee-2eaebfc97575",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„Meldungen über die Amokläufer von Erfurt, Emsdetten oder Winnenden, die vor ihren Anschlägen nächtelang Kriegsspiele gespielt hatten, schürten die Vorurteile von Pädagogen und Politikern.“"
                                            },
                                            {
                                                "example_id": "16bc6eed-f465-4ace-a859-d49ee569b098",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„An einem Wochenende wurde ein merkwürdiges Kriegsspiel auf dem Schulhof gegeben.“"
                                            },
                                            {
                                                "example_id": "fbe9a52a-e1e9-4db8-ab42-5eade4297c2e",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„Beim Kriegsspiel traf ihn sein Bruder Zdeněk versehentlich ins Bein.“"
                                            },
                                            {
                                                "example_id": "0cc1e5a5-06d5-4b40-993e-a213a17202c8",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„Kriegsspiele aller Art standen zu jeder Zeit und in allen Ländern vor allem bei der männlichen Bevölkerung in der Spielgunst hoch im Kurs.“"
                                            },
                                            {
                                                "example_id": "5c436706-698e-4d8e-a65e-8a33a2332547",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„Das Kriegsspiel, vor allem das der medialen Art, vermag übermenschliche, magische und mythische Kräfte in das Spektrum der Auseinandersetzung einzubeziehen.“"
                                            },
                                            {
                                                "example_id": "8f8e8f86-c0c7-40a8-aaa3-9f23fed7be4c",
                                                "sense_id": "a72af502-aadf-3102-ad3d-2e61bdbc8226",
                                                "text": "„Im gemeinsamen Kriegsspielen können aggressive Impulse in einer sozial angemessenen Weise ausgedrückt und verarbeitet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                        "entry_id": "f9d5b4ec-461a-3fec-8720-5c7d42e14f5a",
                                        "glosses": [
                                            "militärisches Planspiel, mit dem reale Kriegshandlungen simuliert, erprobt und eingeübt werden, Manöver"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b8f7444-df3c-44c7-acef-6019df0d793b",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Soldaten trainieren mit Kriegsspielen.“"
                                            },
                                            {
                                                "example_id": "847a11fb-9fb8-496f-8768-597b2d96b674",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Die Bedeutung des Kriegsspieles für die Kriegsplanung soll an dieser Stelle angedeutet werden.“"
                                            },
                                            {
                                                "example_id": "f6a25b08-207a-4845-9759-ef387b9eeb0a",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Der Einsatz von Panzerkorps und Panzerarmeen wurde im Kriegsspiel bereits geübt, […] und die Angriffskriege des Zweiten Weltkrieges sind im Kriegsspiel detailliert geplant worden.“"
                                            },
                                            {
                                                "example_id": "2df9746d-49ea-4324-aa9b-4f0338621d29",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Nun könnte man der Meinung sein, derartige Kriegsspiele seien ausschließlich für die Zwecke der militärischen Planung oder Ausbildung geeignet.“"
                                            },
                                            {
                                                "example_id": "7c224066-27d0-47b3-b725-dc47fe2f234b",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Aufgrund der Erfahrungen aus dem Krieg von 1870/71 wurde der Anwendungsbereich von Kriegsspielen nunmehr auch auf Führungsaufgaben, operative Schulungsmaßnahmen und strategische Planungen erweitert.“"
                                            },
                                            {
                                                "example_id": "37f50310-06ca-47cc-85ed-e738275bfa14",
                                                "sense_id": "9e974bf1-bc43-3eed-b05d-78d1797ef7f1",
                                                "text": "„Das komplexe Kampfgeschehen wird wie im Reißwitzschen Kriegsspiel in einer Bewegungsphase und einer Angriffsphase simuliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                        "entry_id": "f9d5b4ec-461a-3fec-8720-5c7d42e14f5a",
                                        "glosses": [
                                            "bildhafte Bezeichnung für aggressive Handlungen größeren Ausmaßes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72ff044c-6f7d-4323-95d7-7d32bf29f049",
                                                "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                                "text": "„Deshalb möge man auch das Kriegsspiel der Herren Chamenei und Ahmadinedschad nicht mit Realität verwechseln.“"
                                            },
                                            {
                                                "example_id": "23764ba4-ebe0-4816-af35-afce941cfd15",
                                                "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                                "text": "„Hinzu kommen Terror und Kriegsgefahr, die durch atomare Kriegsspiele wie zwischen Trumps Amerika und Nordkorea noch angeheizt wird.“"
                                            },
                                            {
                                                "example_id": "d95211eb-0026-48bc-9b15-a0020f6e4790",
                                                "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                                "text": "„Anlässlich der russischen Kriegsspiele lässt sich studieren, wie groß das Misstrauen zwischen Russland und den Nato-Ländern ist.“"
                                            },
                                            {
                                                "example_id": "5ef2f444-1c61-4dda-bbdc-807c0fc1914a",
                                                "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                                "text": "„Zwar hat Kim die Ankündigung vorerst zurückgenommen, mitten durch dieses Kriegsspiel hindurch vier Raketen in Richtung der US-Garnisonsinsel Guam abzufeuern.“"
                                            },
                                            {
                                                "example_id": "0263cea8-1bc1-4b3a-9dbc-29ecf3c10535",
                                                "sense_id": "68ced2c8-77a5-3c97-a99d-1526e0cc4433",
                                                "text": "„Die kosovarische Regierung entsandte ihre Sondereinheit an die Grenze, was die serbische Regierung als Kriegsspiel deutete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
