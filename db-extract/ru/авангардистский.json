                                                "example_id": "6a8f4674-3e6c-43d7-8a78-4f5eb62fe971",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "It was a very avant-garde production."
                                            },
                                            {
                                                "example_id": "934786cf-3b9e-44e4-9f1e-be809479b30e",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "I fear she will pay a heavy price for the avant garde ideas she has been sold."
                                            },
                                            {
                                                "example_id": "c9fba185-e31e-4dad-a753-fe1de5adba01",
                                                "sense_id": "0dda979d-3529-3fbb-a71d-a1243f3ca35c",
                                                "text": "There’s a moment, for instance, in the competition show Beast Games that struck me as something close to avant garde. Donaldson lays out a million dollars in cash in a big pile, and instructs each of the 10 remaining contestants to come out of their little houses one by one, and to choose how much money they want to take from the pile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e7995ce-e5ce-4ba8-b69f-4e779f4c6fa4",
                        "source_entry_id": "9745db71-c1bc-3c2e-a8d8-798c4acf0d39",
                        "source_sense_id": "224d8448-8c57-32c2-9d6f-6446ddd65400",
                        "target_lang_word": "avantgardistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avantgardistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5741e4bd-558a-38e2-bb69-693bd982f241",
                                        "entry_id": "49814918-6c7d-3bf9-8c9a-829dd88b25fb",
                                        "glosses": [
                                            "den Avantgardismus betreffend, zur Avantgarde gehörend, für neue Ideen auf einem bestimmten Gebiet eintretend"
                                        ],
                                        "tags": [
                                            "meist Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2726ad65-6957-42c1-999a-e7d540cac864",
                                                "sense_id": "5741e4bd-558a-38e2-bb69-693bd982f241",
                                                "text": "Er interessiert sich für avantgardistische Malerei."
                                            },
                                            {
                                                "example_id": "33c0329d-1f7b-44ca-81f9-69f9f644bbed",
                                                "sense_id": "5741e4bd-558a-38e2-bb69-693bd982f241",
                                                "text": "„Offensichtlich machte sich Cocteau lustig über bestimmte Neuerungen der avantgardistischen Literatur überhaupt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
