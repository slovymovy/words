        "fr-extract.jsonl": [
            {
                "entry_id": "999fc7ab-d162-3ea5-a294-dcccc4395e90",
                "word": "filleule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "040b6ffe-fb84-4756-bad9-273c5a0135c0",
                        "entry_id": "999fc7ab-d162-3ea5-a294-dcccc4395e90",
                        "tags": [
