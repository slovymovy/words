                        "tags": [
                            "plural"
                        ],
                        "form": "hyperspaces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2b6a5f5-af6f-3ec3-b17b-2b214db11d79",
                        "entry_id": "5aab6d36-d9cf-34c1-aa40-e03ebea0df7d",
                        "glosses": [
                            "An n-dimensional Euclidian space with n > 3."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2e48b212-728d-381e-bfbe-7211b8182abd",
                        "entry_id": "5aab6d36-d9cf-34c1-aa40-e03ebea0df7d",
                        "glosses": [
                            "A Euclidian space of unspecified dimension."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7281c7f3-eacc-34c1-887c-f02b791b4620",
                        "entry_id": "5aab6d36-d9cf-34c1-aa40-e03ebea0df7d",
                        "glosses": [
                            "A notional space orthogonal to the usual dimensions of space-time often used for faster-than-light travel."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e32569b5-6169-4ea3-93cd-ae601e8a156d",
                                "sense_id": "7281c7f3-eacc-34c1-887c-f02b791b4620",
                                "text": "We can only get to the Nimrodian Galaxy if we go through hyperspace."
                            },
                            {
                                "example_id": "293bd8ec-f195-4581-8fd8-1321586c4e7f",
                                "sense_id": "7281c7f3-eacc-34c1-887c-f02b791b4620",
                                "text": "I'm in command of 18 competitively selected super-perfect physical specimens with an average age of 24.6 who have been locked up in hyperspace for 378 days."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10d67aa7-7345-4c20-9218-ac333db27930",
                        "source_entry_id": "5aab6d36-d9cf-34c1-aa40-e03ebea0df7d",
                        "source_sense_description": "mathematics",
                        "target_lang_word": "hyperespace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hyperespace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebe1f54d-ae73-3a21-9a1f-25ca91541196",
                                        "entry_id": "9b7082e5-c865-3fb2-bdca-713face8c36d",
                                        "glosses": [
                                            "Espace euclidien de dimension supérieure à 3."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7967a291-ed23-3656-aff6-810cbdf3ba33",
                                        "entry_id": "9b7082e5-c865-3fb2-bdca-713face8c36d",
                                        "glosses": [
                                            "Continuum espace-temps fictif pour un moyen de transport supraluminique."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1ff7ad-2f0b-4f82-9839-365a123759f7",
                                                "sense_id": "7967a291-ed23-3656-aff6-810cbdf3ba33",
                                                "text": "Alors, le vaisseau sauta en hyperespace et réapparut 10,000 années-lumière plus loin, au bord de la Voie Lactée. Il ne s’était déroulé qu’une minute."
                                            },
                                            {
                                                "example_id": "0a1f8b88-897b-4d54-aaf6-03218e823a88",
                                                "sense_id": "7967a291-ed23-3656-aff6-810cbdf3ba33",
                                                "text": "L’harmonie, la mélodie deviennent des choses très volatiles. Adieu le bon vieux plancher des vaches, comme avec Straight, no chaser, ou Rhyhm-a-ning. Avec celui-là, on est dans l’hyperespace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
