                    "sense_definition": "de handeling van het werpen van iets",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die <w>worp</w> met de dobbelstenen bracht hem de winst in het spel.",
                            "target_lang_translations": {
                                "en": "That <w>throw</w> of the dice brought him the win in the game."
                            }
                        },
                        {
                            "text": "Hij maakte een verre <w>worp</w> om de bal naar zijn teamgenoot te krijgen.",
                            "target_lang_translations": {
                                "en": "He made a long <w>throw</w> to get the ball to his teammate."
                            }
                        }
                    ],
                    "synonyms": [
