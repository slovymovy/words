                                    {
                                        "sense_id": "1e448c95-4965-326e-b671-c53f32024184",
                                        "entry_id": "f0b319cc-fc2a-3551-a86e-627a4c272e43",
                                        "glosses": [
                                            "eine Sammelbezeichnung für die westslawischen Sprachen Obersorbisch und Niedersorbisch in der Lausitz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69af699a-ab28-4129-96f8-def92e9da528",
                                                "sense_id": "1e448c95-4965-326e-b671-c53f32024184",
                                                "text": "Wie heißt das auf Sorbisch?"
                                            },
                                            {
                                                "example_id": "fb5c3ff1-6659-47db-a03c-3445f50377f7",
                                                "sense_id": "1e448c95-4965-326e-b671-c53f32024184",
                                                "text": "Das Sorbische besteht aus zwei Sprachen."
                                            },
                                            {
                                                "example_id": "cf9d3b38-5441-45d2-a296-601c2a03da5f",
                                                "sense_id": "1e448c95-4965-326e-b671-c53f32024184",
                                                "text": "„Die einzige bedeutsame Minoritätssprache auf deutschem Boden ist das zum Westslawischen gehörende Sorbische in der Ober- und Niederlausitz.“"
                                            },
                                            {
                                                "example_id": "4f2050d7-431e-487c-a97e-85dd165ddc76",
                                                "sense_id": "1e448c95-4965-326e-b671-c53f32024184",
                                                "text": "„Sachsens Ministerpräsident Stanislaw Tillich ist Sorbe, mit einer Tschechin verheiratet, und hat mir bei einem Empfang im gläsernen Phaetonwerk erklärt, dass er sich mit seiner Frau ohne weiteres unterhalten kann, wenn er seine zweite Muttersprache, nämlich Sorbisch, spricht und sie Tschechisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
