                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9778b12-94c6-4cb9-9cb9-09047773b17d",
                                "sense_id": "10ed09d1-00a6-30de-ba4a-05b9c66da6d5",
                                "text": "“A bit airsome, sir.” Airsome, indeed! The tired old ship, unable to advance in the teeth of such frenzy, “ burned down” for the night; which is to say, stopped and reduced steam. Her boilers needed cleaning, too, and behold the opportunity."
                            },
                            {
                                "example_id": "cfa6ee26-8329-4a4e-8857-d347f8eaed01",
                                "sense_id": "10ed09d1-00a6-30de-ba4a-05b9c66da6d5",
                                "text": "New Venice was nothing close to hot or even warm, but outside was certainly airsome, and the atmosphere was as solid as a hall of mirrors."
                            }
                        ]
