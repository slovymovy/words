                    {
                        "sense_id": "3bbaf471-e157-3e8c-b957-1b5c3a1c89fd",
                        "entry_id": "24111fed-7f4d-32b8-baff-f8e3efd1e404",
                        "glosses": [
                            "The act of deifying; exaltation to divine honors; apotheosis."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3a7d0f08-d7d1-3668-8eca-92d014f4cb63",
                        "entry_id": "24111fed-7f4d-32b8-baff-f8e3efd1e404",
                        "glosses": [
                            "Excessive praise."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "63f942db-7807-31f6-b933-a3024a6b5f43",
                        "entry_id": "24111fed-7f4d-32b8-baff-f8e3efd1e404",
                        "glosses": [
                            "A deified embodiment."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0cb164d9-6de3-4ad9-ad49-ec85db7bd7c3",
                                "sense_id": "63f942db-7807-31f6-b933-a3024a6b5f43",
                                "text": "We went through the main hall, four-armed Amaat looming, the air still smelling of incense and the heap of flowers at the god's feet and knees, back to a tiny chapel tucked into a corner, dedicated to an old and now-obscure provincial god, one of those personifications of abstract concepts so many pantheons hold, in this case a deification of legitimate political authority."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a5b13f7-368c-34ea-a07a-688eb9f13172",
                        "entry_id": "24111fed-7f4d-32b8-baff-f8e3efd1e404",
                        "glosses": [
                            "Union with God; theosis."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "95014037-966c-4db4-8c39-8d51055c9648",
                                "sense_id": "5a5b13f7-368c-34ea-a07a-688eb9f13172",
                                "text": "There is an experiential component to Maximos’ writings: he draws upon the reality of the contemplative life and in doing so secures deification as the goal of the monastic spiritual life in Orthodoxy."
                            }
                        ]
                    }
                ],
