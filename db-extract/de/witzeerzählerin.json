                "senses": [
                    {
                        "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                        "entry_id": "8eb78f83-7953-3bcc-9067-cb3c93f70324",
                        "glosses": [
                            "weibliche Person, die Witze erzählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b69819-fc7b-4756-8036-ef958a1c4643",
                                "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                                "text": "„Besonders gekränkt hat ihn, dass ausgerechnet eine jüdische Witzeerzählerin seiner Meinung nach sämtliche Pointen hingemeuchelt und damit die Witze umgebracht habe.“"
                            },
                            {
                                "example_id": "7a4e2aaf-0520-46ec-b373-03ad0ae7c9fd",
                                "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                                "text": "„Aber zurück zu dem, worum ich die Männer heute noch beneide und was ich immer noch nicht gelernt habe, obwohl ich schon so lange in dieser Branche arbeite und so viele brillante Vorbilder erleben durfte: Ich wäre so gerne eine gute Witzeerzählerin!“"
                            },
                            {
                                "example_id": "12dd637e-c070-4d20-a0ec-31e2702cb43f",
                                "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                                "text": "„Die Fernsehmoderatorin Kim Fisher (45) hält sich für eine schlechte Witzeerzählerin.“"
                            },
                            {
                                "example_id": "425ccef6-da18-40a1-963d-03baa694e15b",
                                "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                                "text": "„Ich mag dieses Hintersinnige ja sehr gern. Aber ich bin nun mal keine gute Witzeerzählerin.“"
                            },
                            {
                                "example_id": "ff9db2cb-90a1-4e33-bdfd-3725fa1aa150",
                                "sense_id": "f224f394-1eb8-39ec-9b5b-820a5ccc7dd3",
                                "text": "„Ihr Programm zeigt die ganz persönlichen Erscheinungsformen der Künstlerin als Moderatorin, Conferencieuse, Witzeerzählerin, Gedichtaufsagerin, Chansonette mit Gitarre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
