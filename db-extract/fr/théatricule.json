                        "tags": [],
                        "examples": [
                            {
                                "example_id": "804132a5-24a3-4512-8461-ab43e0dc273a",
                                "sense_id": "63756d47-4bff-3a6a-83b1-9ccd14091f94",
                                "text": "Le goût de la comédie prit le jeune attrape-science en suivant les représentations du théatricule Ponlaudemérien."
                            },
                            {
                                "example_id": "868005fa-03f0-4db8-ab1b-5e192f32a529",
                                "sense_id": "63756d47-4bff-3a6a-83b1-9ccd14091f94",
                                "text": "Les jeunes hommes, tour à tour, montaient sur un petit théâtricule situé, au fond de la salle, puis, là, disaient des vers ou chantaient des chansons."
                            },
                            {
                                "example_id": "e84fa1d9-fd7b-4f94-9fd5-b3696017460a",
                                "sense_id": "63756d47-4bff-3a6a-83b1-9ccd14091f94",
                                "text": "Théâtricule en plein air. Des madriers sur des futailles. Brillent des cierges loués par le prophète de Cormeilles à des conditions exceptionnelles."
                            }
                        ]
                    }
