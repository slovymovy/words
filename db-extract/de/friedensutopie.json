                ],
                "senses": [
                    {
                        "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                        "entry_id": "279ed557-ae1f-331e-ada7-6ab28530416a",
                        "glosses": [
                            "utopische Idealvorstellung einer in Frieden lebenden Menschheit oder Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7147ad93-0acc-407b-ad01-cf5168fcaa77",
                                "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                                "text": "„Garant dieser ‚Friedensutopie‘ ist bald nicht mehr der ‚aufgeklärte‘ und wissenschaftlich denkende Mensch, sondern die Maschine selbst.“"
                            },
                            {
                                "example_id": "1a84390d-646c-4457-bbd5-e0632f9a45c7",
                                "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                                "text": "„Man kann auch nicht behaupten, dass Hesses Kultur- und Friedensutopie durchweg beifällig aufgenommen worden wäre.“"
                            },
                            {
                                "example_id": "c68c915d-6485-44e5-87bd-0eeb197813a2",
                                "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                                "text": "„Interessant ist für uns auch, dass zugleich mit der Zivilisationskritik die Friedensutopie erwacht.“"
                            },
                            {
                                "example_id": "f9a7b116-eba0-4e73-8454-7e21536e62bf",
                                "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                                "text": "„Es ist die Friedensutopie der Aufklärung, zu der sich Goethe hier noch ohne Einschränkung bekennt.“"
                            },
                            {
                                "example_id": "dfdfaa7e-dda8-46e5-960f-5c12b116e430",
                                "sense_id": "e0958c8d-e7a2-35c8-8de0-d24856aab71d",
                                "text": "„Am Vorabend des Ersten Weltkrieges musste sich seine Friedensutopie dem Expansionswillen der europäischen Mächte geschlagen geben - im Ersten Weltkrieg ging mit dem brüchigen Frieden auch ein Teil jener Welt unter, die Kahns Fotografen auf Farbfotos gebannt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
