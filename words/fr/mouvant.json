            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6142356-a37b-36ac-bf20-ade2aac6bbdb",
                    "sense_definition": "Qui manque de consistance et se dérobe sous le poids, en parlant d'un sol ou d'une matière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut éviter cette zone marécageuse car les sables y sont <w>mouvants</w> et dangereux."
                        },
                        {
                            "text": "Le randonneur avançait avec précaution sur ce sol <w>mouvant</w> qui s'enfonçait sous ses pas."
                        }
                    ],
                    "synonyms": [
                        "fuyant",
                        "instable"
                    ],
                    "antonyms": [
                        "ferme",
                        "solide"
                    ],
                    "common_phrases": [
                        "sables mouvants",
                        "sol mouvant"
                    ]
                },
                {
                    "sense_id": "47cd46f0-6f1e-3c22-8877-9e1458df2ffb",
                    "sense_definition": "Qui est en perpétuel mouvement ou change continuellement de forme ou d'aspect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La surface de la mer offrait un spectacle <w>mouvant</w> sous les rafales de vent."
                        },
                        {
                            "text": "Nous observions avec émerveillement la lumière <w>mouvante</w> créée par les flammes du feu de bois."
                        }
                    ],
                    "synonyms": [
                        "changeant",
                        "mobile"
                    ],
                    "antonyms": [
                        "fixe",
                        "immobile"
                    ],
                    "common_phrases": [
                        "lumière mouvante",
                        "matière mouvante"
                    ]
                },
                {
                    "sense_id": "93787184-60ec-318b-97b5-9f1587178f4a",
                    "sense_definition": "Qui n'est pas fixe ni durable, qui évolue de manière incertaine ou fluctuante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise doit apprendre à évoluer rapidement dans un contexte économique particulièrement <w>mouvant</w>."
                        },
                        {
                            "text": "Prendre une décision définitive reste difficile dans une situation aussi <w>mouvante</w>."
                        }
                    ],
                    "synonyms": [
                        "fluctuant",
                        "incertain",
                        "instable"
                    ],
                    "antonyms": [
                        "constant",
                        "immuable",
                        "stable"
                    ],
                    "common_phrases": [
                        "contexte mouvant",
                        "terrain mouvant"
                    ]
                },
                {
                    "sense_id": "9811bfa9-b79c-37f4-aa24-61869f1c878c",
                    "sense_definition": "Qui dépendait d'un autre fief ou d'une autre seigneurie, dans le système féodal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feodalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien découvrit un ancien domaine <w>mouvant</w> qui relevait de la juridiction royale."
                        },
                        {
                            "text": "Ce fief <w>mouvant</w> imposait à son propriétaire de prêter hommage au seigneur voisin."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "droit féodal"
                        }
                    ]
                },
                {
                    "sense_id": "ca46be8f-ee3c-3ccb-8694-bc633dc06669",
                    "sense_definition": "Se dit d'une pièce ou d'un meuble inanimé qui semble sortir d'un bord de l'écu ou d'une autre pièce.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blason présente un rocher <w>mouvant</w> de la pointe inférieure de l'écu."
                        },
                        {
                            "text": "Ces armoiries anciennes comportent deux bras <w>mouvants</w> des flancs du bouclier."
                        }
                    ]
                }
            ]
        },
        {
