                    {
                        "sense_id": "41d9ed4f-1dbc-3776-9052-316004d621f9",
                        "entry_id": "7e63d756-b839-37e4-9b12-4415677c26d5",
                        "glosses": [
                            "kleines Tuch aus saugfähigem Material zum Abspülen von Geschirr und Reinigung von Oberflächen (in der Küche)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b64d991-2cf6-429c-b6cf-3226dbc4a779",
                                "sense_id": "41d9ed4f-1dbc-3776-9052-316004d621f9",
                                "text": "„Wettex ist ein geschützter Markenname, welcher in Österreich zudem Eingang in die Umgangssprache fand. Diesbezüglich werden nicht nur originale Markenartikel, sondern generell Schwamm- und Spültücher mit dem Begriff bezeichnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "925e7dd6-123e-3a3b-b815-518a5edeb40b",
                        "entry_id": "7e63d756-b839-37e4-9b12-4415677c26d5",
                        "glosses": [
                            "Tuch zum Abtrocknen von gespültem sauberen Geschirr"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "2059fddb-2da9-4ca7-9f09-6e7abb7ab972",
                                "sense_id": "925e7dd6-123e-3a3b-b815-518a5edeb40b",
                                "text": "Bitte nimm zum Abtrocknen der Gläser ein frisches Spültuch!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
