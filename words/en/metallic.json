{
    "word_family": [
        "metal",
        "metallize",
        "metallurgy",
        "metalloid",
        "metallicity"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "085a7067-f578-3ccf-957c-c7c56e20e5a0",
                    "sense_definition": "Made of or containing metal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer replaced the plastic parts with <w>metallic</w> components for better durability.",
                            "target_lang_translations": {
                                "ru": "Инженер заменил пластиковые детали на <w>металлические</w> компоненты для большей долговечности.",
                                "zh": "工程师为了提高耐用性，将塑料零件更换成了<w>金属</w>零件。"
                            }
                        },
                        {
                            "text": "Be careful when using <w>metallic</w> film balloons near power lines as they can cause outages.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны при использовании <w>металлизированных</w> фольгированных шаров вблизи линий электропередач, так как они могут вызвать перебои в сети.",
                                "zh": "在电线附近使用<w>金属</w>膜气球时要小心，因为它们可能会导致停电。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metallical",
                        "metallous"
                    ],
                    "antonyms": [
                        "nonmetallic"
                    ],
                    "common_phrases": [
                        "metallic film balloons",
                        "metallic surface",
                        "metallic container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из металла или содержащий металл.",
                        "zh": "由金属制成或含有金属成分的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлический",
                                "target_lang_sense_clarification": "состоящий из металла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金属的",
                                "target_lang_sense_clarification": "由金属构成"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2c69022-ecbc-3a96-b6ae-8808adbeeb10",
                    "sense_definition": "Having the appearance or shine of polished metal.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a <w>metallic</w> blue paint for her new sports car.",
                            "target_lang_translations": {
                                "ru": "Она выбрала синюю краску <w>металлик</w> для своего нового спортивного автомобиля.",
                                "zh": "她为她的新跑车选了一种<w>金属</w>蓝色的车漆。"
                            }
                        },
                        {
                            "text": "The fabric had a <w>metallic</w> sheen that caught the light beautifully.",
                            "target_lang_translations": {
                                "ru": "Ткань имела <w>металлический</w> блеск, который красиво переливался на свету.",
                                "zh": "这种布料有一种<w>金属</w>光泽，在光线下非常漂亮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metalish"
                    ],
                    "common_phrases": [
                        "metallic sheen",
                        "metallic paint",
                        "metallic finish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий вид или блеск полированного металла.",
                        "zh": "具有抛光金属外观或光泽的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлический",
                                "target_lang_sense_clarification": "о цвете или блеске"
                            },
                            {
                                "target_lang_word": "металлик",
                                "target_lang_sense_clarification": "о краске или покрытии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金属质感的",
                                "target_lang_sense_clarification": "形容外观或光泽"
                            },
                            {
                                "target_lang_word": "金属色",
                                "target_lang_sense_clarification": "指颜色或涂料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebb23fd8-1a14-3657-9113-7d75ce0c74ce",
                    "sense_definition": "Describing a sound that is harsh or ringing, like metal objects striking each other.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sharp <w>metallic</w> sound echoed through the hallway when the keys hit the floor.",
                            "target_lang_translations": {
                                "ru": "Резкий <w>металлический</w> звук эхом разнесся по коридору, когда ключи упали на пол.",
                                "zh": "钥匙掉在地上时，走廊里回荡着一声尖锐的<w>金属</w>撞击声。"
                            }
                        },
                        {
                            "text": "The robot spoke in a cold <w>metallic</w> voice that lacked any emotion.",
                            "target_lang_translations": {
                                "ru": "Робот говорил холодным <w>металлическим</w> голосом, лишенным каких-либо эмоций.",
                                "zh": "机器人用一种冰冷且毫无感情的<w>金属</w>嗓音说话。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "metallic sound",
                        "metallic voice",
                        "metallic ring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает резкий или звенящий звук, подобный удару металлических предметов друг о друга.",
                        "zh": "形容像金属物体碰撞时发出的刺耳或清脆的声音。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлический",
                                "target_lang_sense_clarification": "о звуке или голосе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金属般的",
                                "target_lang_sense_clarification": "形容声音或语调"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f6b8f2-de4a-3e60-9d3b-5106ed3d8a76",
                    "sense_definition": "Relating to or having the chemical or physical characteristics of a <w>metal</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the <w>metallic</w> properties of this new alloy at high temperatures.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>металлические</w> свойства этого нового сплава при высоких температурах.",
                                "zh": "科学家们正在研究这种新合金在高温下的<w>金属</w>特性。"
                            }
                        },
                        {
                            "text": "The substance exhibits <w>metallic</w> behavior under extreme pressure.",
                            "target_lang_translations": {
                                "ru": "Вещество проявляет <w>металлические</w> свойства под экстремальным давлением.",
                                "zh": "该物质在极端压力下表现出<w>金属</w>特性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metallical"
                    ],
                    "common_phrases": [
                        "metallic properties",
                        "metallic bond",
                        "metallic element"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к химическим или физическим характеристикам металла.",
                        "zh": "与金属的化学或物理特性有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлический",
                                "target_lang_sense_clarification": "научный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金属的",
                                "target_lang_sense_clarification": "科学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "922eae30-b0ee-36e8-870c-c335a6d49ee8",
                    "sense_definition": "A paint, fabric, or color that has a metallic appearance or shine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This season's fashion collection features a variety of bright <w>metallics</w> and pastels.",
                            "target_lang_translations": {
                                "ru": "В модной коллекции этого сезона представлено множество ярких <w>металликов</w> и пастельных тонов.",
                                "zh": "本季时装系列采用了多种亮眼的<w>金属色</w>和柔和色调。"
                            }
                        },
                        {
                            "text": "The artist used <w>metallics</w> to add highlights to the sculpture.",
                            "target_lang_translations": {
                                "ru": "Художник использовал краски <w>металлик</w>, чтобы добавить блики на скульптуру.",
                                "zh": "艺术家使用了<w>金属色</w>颜料来为雕塑增加高光。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shiny metallics",
                        "array of metallics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краска, ткань или цвет, имеющие металлический вид или блеск.",
                        "zh": "具有金属外观或光泽的涂料、织物或颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "металлик",
                                "target_lang_sense_clarification": "тип материала или цвета"
                            },
                            {
                                "target_lang_word": "оттенок металлик",
                                "target_lang_sense_clarification": "цветовая гамма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "金属色",
                                "target_lang_sense_clarification": "指颜色或涂料"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}