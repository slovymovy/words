                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "скорпио́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a65706e7-96cc-3863-b12f-680c11493d78",
                                        "entry_id": "ee92867e-22b9-3683-96f3-193a055dc7f3",
                                        "glosses": [
                                            "зоол. ядовитое животное класса паукообразных, с длинным хвостом, оканчивающимся ядовитым жалом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47abc67c-3c77-4de9-9bfe-391cb9ff9b16",
                                                "sense_id": "a65706e7-96cc-3863-b12f-680c11493d78",
                                                "text": "Проплыл страшный водяной скорпион, с широко раскинутыми клешнями, готовыми схватить, сжать, разорвать все, что попадется живого."
                                            },
                                            {
                                                "example_id": "cb839bd2-16c5-4130-8eb8-4da7428abc74",
                                                "sense_id": "a65706e7-96cc-3863-b12f-680c11493d78",
                                                "text": "«По свидетельству французских путешественников… на берегах Амура встречаются три рода скорпионов разных цветов, ― писал Борисов, ― серые, зеленые и красные.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76017b98-61d7-3461-9515-31b3d3447641",
                                        "entry_id": "ee92867e-22b9-3683-96f3-193a055dc7f3",
                                        "glosses": [
                                            "перен. жестокий, коварный, подлый человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03ccd33-ad9c-4be5-ae95-6bb81d100244",
                                                "sense_id": "76017b98-61d7-3461-9515-31b3d3447641",
                                                "text": "Радуясь предстоящему пришествию судебных скорпионов, газеты, к сожалению, не воздержались от издевок над скорпионами административными."
                                            },
                                            {
                                                "example_id": "1537cd7a-2ec7-47b6-9fcb-cb4c1e0fb270",
                                                "sense_id": "76017b98-61d7-3461-9515-31b3d3447641",
                                                "text": "Или ты не человек, а скорпион, тарантул, или тебе совершенно неизвестны отцовские чувства!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "скорпио́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6566ab7e-0a4a-3961-8eaf-0be0ab669c8d",
                                        "entry_id": "68d0b556-b783-3f43-9687-eb69b3600228",
                                        "glosses": [
                                            "истор., неодуш. небольшая катапульта, стреломёт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7959a44e-602e-4ce3-9cf2-717f2369aff1",
                                                "sense_id": "6566ab7e-0a4a-3961-8eaf-0be0ab669c8d",
                                                "text": "Действие «скорпионов» и катапульт губило многих сразу; тяжесть извергнутых ими масс камней срывала брустверы со стены, разбивала углы башен."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "393b4905-5103-35a2-82ab-2518df2606ba",
                                        "entry_id": "68d0b556-b783-3f43-9687-eb69b3600228",
                                        "glosses": [
                                            "истор., неодуш. орудие пытки или телесного наказания — хлыст или тонкая цепь с металлическими крючками или иглами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d58b98b-5ac2-49c2-a4c1-594fc40d4f5a",
                                                "sense_id": "393b4905-5103-35a2-82ab-2518df2606ba",
                                                "text": "…Если отец мой обременял вас тяжким игом, то я увеличу иго ваше; отец мой наказывал вас бичами, а я буду наказывать вас скорпионами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
