                ],
                "senses": [
                    {
                        "sense_id": "7d28b064-16fa-3659-b3c6-76af33c35167",
                        "entry_id": "03003f86-69d3-3b51-a60e-912628c019cc",
                        "glosses": [
                            "aus zwölf Mondmonaten bestehender Zeitraum; die 354 Tage, die der Mond braucht, um die Erde zwölfmal von Neumond zu Neumond zu umkreisen; zwölf/dreizehn Mondmonate, um in der Dauer einem Kalenderjahr zu entsprechen"
                        ],
                        "tags": [
                            "oder auch"
                        ],
                        "examples": [
                            {
                                "example_id": "4e1c40d3-0988-4a73-a5f0-950e204f4624",
                                "sense_id": "7d28b064-16fa-3659-b3c6-76af33c35167",
                                "text": "Die Islamische Zeitrechnung richtet sich nach dem Mondjahr, der gregorianische Kalender nach dem Sonnenjahr."
                            },
                            {
                                "example_id": "0be449dd-c4e7-4acd-8d7e-b618d594b8c4",
                                "sense_id": "7d28b064-16fa-3659-b3c6-76af33c35167",
                                "text": "„Man versteht gewöhnlich unter einem Mondjahre den Zeitinhalt von so vielen Lunationen, als im Verlaufe eines Sonnenjahres Platz finden, öfters zwölf, manchmal dreizehn an der Zahl.“ (1869)"
                            },
                            {
                                "example_id": "252172b0-dc91-4a3e-91c9-12c22f026e43",
                                "sense_id": "7d28b064-16fa-3659-b3c6-76af33c35167",
                                "text": "„Wenn man die Länge des Mondjahres nur zu 12 * 29 1/2 = 354 Tagen rechnet, würde in jedem Jahre eine Vernachlässigung von 8 Stunden 48 Minuten 36 Sekunden begangen werden.“"
                            },
                            {
                                "example_id": "af369baa-003d-44cc-9f46-b737c0e66c95",
                                "sense_id": "7d28b064-16fa-3659-b3c6-76af33c35167",
                                "text": "„Es ist diese Zahl (genauer: die Differenz beider Konstanten für Sonne und Mond), die zum synodischen Monat und zur Länge des Mondjahres zu 354,37 Tagen führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
