                ],
                "senses": [
                    {
                        "sense_id": "0665176a-39de-37ba-b474-4207b99f414d",
                        "entry_id": "84ea5672-3a19-3faa-afd3-75da5569f014",
                        "glosses": [
                            "Merkmal (Symptom) einer Erkrankung, das sich am Atmungsorgan Lunge zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2e0b65f-8b69-4d30-8fa1-c6a318313f4b",
                                "sense_id": "0665176a-39de-37ba-b474-4207b99f414d",
                                "text": "„Wenige Stunden nach dem initialen Schüttelfrost und bevor irgendein Lungensymptom vorhanden ist, treten die Zeichen der Herzaffektion nur allzu deutlich hervor.“"
                            },
                            {
                                "example_id": "9c6fe61d-df9e-4124-90a4-e1b6c4e40db2",
                                "sense_id": "0665176a-39de-37ba-b474-4207b99f414d",
                                "text": "„Schwere Hautprobleme, aber auch Nieren-, Herz- und Lungensymptome können besondere Aufmerksamkeit erfordern.“"
                            },
                            {
                                "example_id": "41e5d7b0-a497-4c2c-ac05-4618ac025597",
                                "sense_id": "0665176a-39de-37ba-b474-4207b99f414d",
                                "text": "„Die Formen sind die akute pulmonale Histoplasmose, die symptomatisch und asymptomatisch verlaufen kann, und die chronische pulmonale Histoplasmose mit chronischen Lungensymptomen.“"
                            },
                            {
                                "example_id": "ca8c7084-a494-455f-a7bf-94ac9ef3f624",
                                "sense_id": "0665176a-39de-37ba-b474-4207b99f414d",
                                "text": "„Die primäre Lungenpest schreitet unter allen Pestformen am raschesten voran. Zu den Frühsymptomen gehören unter anderem Schüttelfrost, Fieber und Kopfschmerzen. Bereits am zweiten Tag treten Lungensymptome wie Husten, blutiger Auswurf sowie Atemnot und gesteigerte Atemfrequenz auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
