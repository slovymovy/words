                "senses": [
                    {
                        "sense_id": "d6e0a3b6-b2e5-3d8e-945b-d5e0d6a75bd5",
                        "entry_id": "b2d7826d-84b7-3b7c-b1b3-3955631714f3",
                        "glosses": [
                            "Variante ancienne de dessoufrer (débarrasser (une substance) du soufre qu’elle contient)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "720d0020-b71f-48c6-bcaf-de25c4b2c06b",
                                "sense_id": "d6e0a3b6-b2e5-3d8e-945b-d5e0d6a75bd5",
                                "text": "Ce fer est aigre, & entre difficilement en fusion ; il a besoin de beaucoup de substances calcaires pour le désoufrer."
                            },
                            {
                                "example_id": "fcf86d6b-85c0-42e2-be9d-8ca56a247012",
                                "sense_id": "d6e0a3b6-b2e5-3d8e-945b-d5e0d6a75bd5",
                                "text": "La seconde méthode s'obtient en saturant la substance que l'on veut désoufrer avec un acide végétal quelconque & en la calcinant ; par ce moyen l'acide végétal se trouvera décomposé."
                            },
                            {
                                "example_id": "29096657-bd64-41ad-9e2d-4d72b09ca20b",
                                "sense_id": "d6e0a3b6-b2e5-3d8e-945b-d5e0d6a75bd5",
                                "text": "Garofoli fit un signe et l’enfant qui lui avait présenté l’allumette non désoufrée s’approcha."
                            }
                        ]
                    }
                ],
