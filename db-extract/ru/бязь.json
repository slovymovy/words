                                                "sense_id": "f95082d0-a28d-3b1b-abdc-e81f35cd0b21",
                                                "text": "Mit den feinen Händen griff sie hinunter in die häßlichen Nesseln, sie waren wie Feuer; - (H. C. Andersen, Die wilden Schwäne)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "deb9981c-d720-30c8-84bc-782d7eb8bab8",
                                        "entry_id": "6bddac34-48c9-3edf-b541-81e4d37635a0",
                                        "glosses": [
