            "senses": [
                {
                    "sense_id": "710622c9-d522-3229-ad53-e6c4e4bd4060",
                    "sense_definition": "Contraindre quelqu'un ou le mettre dans la nécessité absolue de faire quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tempête soudaine va <w>obliger</w> les marins à rentrer rapidement au port."
                        },
                        {
                            "text": "Cette situation financière difficile nous <w>oblige</w> à faire des choix prudents."
                        }
                    ],
                    "synonyms": [
                        "contraindre",
                        "forcer",
                        "astreindre"
                    ]
                },
                {
                    "sense_id": "05c01629-b4ea-3685-9e7d-a05dcf776d70",
                    "sense_definition": "Lier quelqu'un par un contrat ou une promesse pour l'amener à exécuter un engagement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "engagement_juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel accord d'entreprise <w>oblige</w> l'employeur à garantir la sécurité des salariés."
                        },
                        {
                            "text": "Une clause stricte de ce document <w>oblige</w> les signataires à respecter le calendrier prévu."
                        }
                    ],
                    "synonyms": [
                        "engager",
                        "lier",
                        "assujettir"
                    ],
                    "common_phrases": [
