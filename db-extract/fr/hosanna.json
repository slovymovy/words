        "fr-extract.jsonl": [
            {
                "entry_id": "e3c1afaa-581a-3f32-8348-2ee9f095439d",
                "word": "hosanna",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "779c1869-0543-4ee2-9716-d80bb0fd3cfc",
                        "entry_id": "e3c1afaa-581a-3f32-8348-2ee9f095439d",
                        "tags": [],
                        "form": "hosannah"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f2fc6855-e2aa-31ed-9e89-e44db436db00",
                        "entry_id": "e3c1afaa-581a-3f32-8348-2ee9f095439d",
                        "glosses": [
                            "Acclamation religieuse originairement en usage chez les hébreux et qui est employée dans certains offices de l’Église."
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "273de1cf-3337-45f5-a950-d5f366b24923",
                                "sense_id": "f2fc6855-e2aa-31ed-9e89-e44db436db00",
                                "text": "Et quel réveil joyeux, lorsque la virginité sera méprisée, lorsque la fécondité redeviendra une vertu, dans l’hosanna des forces naturelles libérées, les désirs honorés, les passions utilisées, le travail exalté, la vie aimée, enfantant l’éternelle création de l’amour !"
                            },
                            {
                                "example_id": "3b070c5f-0a28-4ce3-9f83-bdc7b93f5df8",
                                "sense_id": "f2fc6855-e2aa-31ed-9e89-e44db436db00",
                                "text": "crier hosanna, Faire une ovation à quelqu’un ; ou se réjouir de quelque chose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b7c925c-c13d-48a8-8d54-b096987b8cb0",
                        "source_entry_id": "e3c1afaa-581a-3f32-8348-2ee9f095439d",
                        "source_sense_id": "f2fc6855-e2aa-31ed-9e89-e44db436db00",
                        "target_lang_word": "hosanna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hosanna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f36f1f-6681-30dd-9304-40468c429f0d",
                                        "entry_id": "6cd086b0-5297-3973-b4ba-0f416249cd74",
                                        "glosses": [
                                            "A cry of praise or adoration to God in liturgical use among the Jews, and said to have been shouted in recognition of the Messiahship of Jesus on his entry into Jerusalem; hence since used in the Christian Church."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hosanna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                        "entry_id": "3aa10c32-a3ad-38fc-adee-6ab365059d37",
                                        "glosses": [
                                            "A cry of ‘hosanna’."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ab97e9-b8c9-4548-8023-1d8cded68e42",
                                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                                "text": "When we arrived in New York, we found a day of extreme brilliance. It would be impossible ever to forget the first sight of the groups of slender towers that form the skyline of New York City, chanting hosannas to an autumn sky."
                                            },
                                            {
                                                "example_id": "0e47b1f4-55b7-4771-aad3-1305e5a0e86c",
                                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                                "text": "Imagine God in Heaven surrounded by the choirs of adoring angels singing hosannahs unendingly."
                                            },
                                            {
                                                "example_id": "4f1121e6-8f05-41a4-97ae-1adf91052d5f",
                                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                                "text": "The hall rang with the hosannas of the faithful, while the women knelt at his feet to ask for salvation."
                                            },
                                            {
                                                "example_id": "9732499b-e6ed-46a5-beb6-19946979d812",
                                                "sense_id": "3dd0f211-4cfc-332a-91b3-9b2f4e680e78",
                                                "text": "I’ve written before about the inevitable, tragic dynamic of this brokeback bromance; Trump needs a mindless cheering section screaming hosannas no matter how often he stumbles toward the nuclear and political precipice."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hosanna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2579c9a-bc02-3235-a538-e55289238ce3",
                                        "entry_id": "3db5fdd5-5d5b-3ebf-b548-0059ed5cb111",
                                        "glosses": [
                                            "To give a cry of ‘hosanna’."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
