                    "sense_definition": "A moderate degree of heat; the sensation of being warm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire provided much-needed <w>warmth</w> on the cold winter night.",
                            "target_lang_translations": {
                                "ru": "Огонь давал столь необходимое <w>тепло</w> в холодную зимнюю ночь.",
                                "zh": "在寒冷的冬夜，炉火提供了急需的<w>温暖</w>。",
                                "es": "El fuego proporcionó el <w>calor</w> tan necesario en la fría noche de invierno.",
                                "nl": "Het vuur zorgde voor de broodnodige <w>warmte</w> op de koude winternacht.",
                                "pl": "Ogień zapewnił tak potrzebne <w>ciepło</w> podczas mroźnej zimowej nocy.",
                                "de": "Das Feuer spendete in der kalten Winternacht die dringend benötigte <w>Wärme</w>.",
                                "fr": "Le feu a apporté une <w>chaleur</w> bien nécessaire lors de la froide nuit d'hiver.",
                                "it": "Il fuoco ha fornito il tanto necessario <w>calore</w> nella fredda notte d'inverno.",
                                "cs": "Oheň poskytl tolik potřebné <w>teplo</w> během chladné zimní noci.",
                                "tr": "Ateş, soğuk kış gecesinde çok ihtiyaç duyulan <w>sıcaklığı</w> sağladı."
                            }
                        },
                        {
                            "text": "She could feel the <w>warmth</w> of the sun on her face as she walked.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала солнечное <w>тепло</w> на лице во время прогулки.",
                                "zh": "她走路时能感觉到阳光照在脸上的<w>温暖</w>。",
                                "es": "Podía sentir el <w>calor</w> del sol en su cara mientras caminaba.",
                                "nl": "Ze kon de <w>warmte</w> van de zon op haar gezicht voelen terwijl ze liep.",
                                "pl": "Podczas spaceru czuła na twarzy <w>ciepło</w> słońca.",
                                "de": "Sie konnte beim Gehen die <w>Wärme</w> der Sonne auf ihrem Gesicht spüren.",
                                "fr": "Elle pouvait sentir la <w>chaleur</w> du soleil sur son visage pendant qu'elle marchait.",
                                "it": "Poteva sentire il <w>calore</w> del sole sul viso mentre camminava.",
                                "cs": "Během chůze cítila na tváři <w>teplo</w> slunečních paprsků.",
                                "tr": "Yürürken güneşin <w>sıcaklığını</w> yüzünde hissedebiliyordu."
                            }
                        }
                    ],
