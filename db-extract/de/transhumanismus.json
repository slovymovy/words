                "senses": [
                    {
                        "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                        "entry_id": "5239b04d-9f14-33f8-b49b-94051108afbb",
                        "glosses": [
                            "Denkrichtung der Philosophie, die darauf abzielt, die natürlichen Grenzen des Menschen durch den Einsatz neuer Technologien zu überwinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd24f3b6-2a62-4e21-8f13-e8466f6b53ae",
                                "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                                "text": "„Das verhandelte Thema ist der Transhumanismus, jene technospirituelle Bewegung, die den menschlichen Körper als ein Problem ansieht, das darauf wartet, gelöst zu werden.“"
                            },
                            {
                                "example_id": "5792d58b-377e-40d4-aed1-4f3fd8bde6f6",
                                "sense_id": "f540f0c8-1bf6-3bc4-afae-1e6884cbc1dc",
                                "text": "„Der Transhumanismus bleibt letztlich anthropozentrisch, da nicht ein Ablösung des Menschen durch künstliche Lebensformen angestrebt wird, sondern eine Verschmelzung mit der Technik […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
