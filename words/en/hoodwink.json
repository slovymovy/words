                    "frequency": "VeryLow",
                    "semantic_group_id": "hiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>hoodwinked</w> his eyes to the corruption happening right in front of him."
                        },
                        {
                            "text": "It is dangerous to <w>hoodwink</w> oneself when facing such obvious problems."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
