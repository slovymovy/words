                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b36e594-82e0-3dfb-981f-4541b165c016",
                        "entry_id": "62fe6355-63ed-3ceb-a58e-10a9008695a4",
                        "glosses": [
                            "To take effect, to be operative; used with to."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3be11188-a05f-493b-bdd9-c6785a46d960",
                                "sense_id": "7b36e594-82e0-3dfb-981f-4541b165c016",
                                "text": "All our striving enures to our own spiritual benefit."
                            },
                            {
                                "example_id": "ab8615b4-af96-4862-a5a2-13efae2e0636",
                                "sense_id": "7b36e594-82e0-3dfb-981f-4541b165c016",
                                "text": "The position of the individual as a subject of international law has often been obscured by the failure to observe the distinction between the recognition, in an international instrument of rights enuring to the benefit of the individual and the enforceability of these rights at his instance."
                            }
                        ]
                    }
