                    {
                        "sense_id": "d4498ed9-291c-3053-b07c-5016e9e5b904",
                        "entry_id": "1874030d-5649-3041-89ae-9383efff3b1b",
                        "glosses": [
                            "S’excommunier mutuellement (au sens propre, en parlant de plusieurs papes, ou, plus souvent, au sens figuré)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb84457-13ef-4c53-88bb-0b008181b439",
                                "sense_id": "d4498ed9-291c-3053-b07c-5016e9e5b904",
                                "text": "Partout, aux environs de Rome, troupes « clémentistes » et « urbainistes » s’affrontèrent en de sanglants combats, tandis que par-dessus la mêlée les papes rivaux s’entre-excommunaient en se jetant l’un l’autre l’anathème."
                            },
                            {
                                "example_id": "3ce3d9a0-d22a-4ace-a250-bd8e959b5bf7",
                                "sense_id": "d4498ed9-291c-3053-b07c-5016e9e5b904",
                                "text": "Nous entre-excommunier, c’est nous reprocher publiquement les uns aux autres de détruire une partie essentielle de la Foi."
                            },
                            {
                                "example_id": "d9b7f86f-602b-4845-ae12-8c6e461ea487",
                                "sense_id": "d4498ed9-291c-3053-b07c-5016e9e5b904",
                                "text": "Les intellectuels vont se combattre, polémiquer et s’entre-excommunier avec une passion affamée."
                            }
                        ]
                    }
                ],
