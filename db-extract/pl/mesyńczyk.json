                "senses": [
                    {
                        "sense_id": "ef2166fe-a694-3fcb-9871-632154c2e168",
                        "entry_id": "6611129e-7b51-3b50-ac03-37f912b356ad",
                        "glosses": [
                            "mieszkaniec Mesyny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099517a8-cd1a-45f7-9f88-da8d38aaaf08",
                                "sense_id": "ef2166fe-a694-3fcb-9871-632154c2e168",
                                "text": "Na brzegu morza zebrał się tłum mesyńczyków."
                            },
                            {
                                "example_id": "39228c75-c259-42c4-a254-67bab8f06027",
                                "sense_id": "ef2166fe-a694-3fcb-9871-632154c2e168",
                                "text": "Lettereo jest to imię chrzestne często używane w Mesynie. Pochodzi ono od pewnego listu, który Najświętsza Panna miała pisać do mieszkańców tego miasta, datując go: „w roku 1452 od narodzenia mojego syna”. Mesyńczycy taką cześć oddają temu listowi, jaką neapolitańczycy krwi świętego Januarego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
