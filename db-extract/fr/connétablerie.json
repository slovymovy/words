                    {
                        "sense_id": "b9ce0136-bcdd-3caa-a6b2-93df65659b4f",
                        "entry_id": "5b124b1c-7c7d-3089-83c6-f246fb26b1a0",
                        "glosses": [
                            "Charge, dignité de connétable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fffc84f-34d9-4f6c-946a-f8f51773de71",
                                "sense_id": "b9ce0136-bcdd-3caa-a6b2-93df65659b4f",
                                "text": "Il regloit toutes les choses de la guerre, pour la punition des crimes, pour le butin, reddition des places, & enfin pour tout ce qui touchoit les soldats. Pour cela il avoit un Prevôt, nommé de la Connétablerie."
                            },
                            {
                                "example_id": "38a5cff3-68a2-463c-b777-26d8e0f3b9e2",
                                "sense_id": "b9ce0136-bcdd-3caa-a6b2-93df65659b4f",
                                "text": "La charge de Connétable s’appeloit Connétablerie. Ce Titre se donnoit quelquefois à des Officiers qui ne commandoient qu’à un certain nombre de Soldats : ces compagnies se nommoient Connétablies."
                            },
                            {
                                "example_id": "52cbccd9-63fd-48f5-a913-ead05534f616",
                                "sense_id": "b9ce0136-bcdd-3caa-a6b2-93df65659b4f",
                                "text": "Au milieu de ces bas-reliefs dont l’habileté répond au reste et présente bien l’usage des actions qui sont notées au bas, est une main tenant une épée, emblème de la connétablerie, avec cette inscription NON SINE NUMINE."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5f1bc26-e98c-3494-a0fc-215a5731c63f",
                        "entry_id": "5b124b1c-7c7d-3089-83c6-f246fb26b1a0",
                        "glosses": [
                            "Circonscription militaire dirigée par un connétable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1581faff-f828-47a7-8d35-fa31dd590be6",
                                "sense_id": "b5f1bc26-e98c-3494-a0fc-215a5731c63f",
                                "text": "Le comté est inclus dans une unité territoriale plus grande, la connétablerie. Ce sont des circonscriptions militaires.Elles comprennent un ou deux comtés, des villes, des terres royales etc. Le comte peut être connétable de la connétablerie où se trouve son comté."
                            }
                        ]
                    }
