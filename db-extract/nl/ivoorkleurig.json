                    {
                        "sense_id": "c0fb1bd4-196f-36e4-941c-7fcc348cedfc",
                        "entry_id": "8062b478-2142-37c0-a97d-c8a6abf6fbf6",
                        "glosses": [
                            "met eeb gebroken witte kleur zoals de slagtanden van de olifant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90283ecb-fb32-4236-a954-e49d85989b28",
                                "sense_id": "c0fb1bd4-196f-36e4-941c-7fcc348cedfc",
                                "text": "Een ivoorkleurig ripslint steekt uit de opening aan de bovenkant, om de kussens in het vak te trekken."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fed374e-452b-3f27-8b3d-0d3218dab594",
                        "entry_id": "8062b478-2142-37c0-a97d-c8a6abf6fbf6",
                        "glosses": [
                            "tint geel met RAL-nummer 1014 ( )"
                        ],
