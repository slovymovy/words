                        "glosses": [
                            "Soldat d’élite de la Fédération de la Super-Terre dans la duologie vidéoludique Helldivers."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "26b76315-4ab7-4547-bc60-d833c53ea911",
                                "sense_id": "a211cd91-7dbe-39ae-8149-5e60ced91af5",
                                "text": "« Helldivers » tire son origine des expressions « war is hell » (litt. « la guerre, c’est l’enfer ») et « diving into war » (litt. « plonger dans la guerre »)."
                            }
                        ]
                    }
                ],
                "translations": [
