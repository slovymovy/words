                                            {
                                                "example_id": "9bfda16c-020c-4918-9b92-2503b3fbb3af",
                                                "sense_id": "a2c4f4b8-11d8-3b37-a4fb-27b5f4de7275",
                                                "text": "— Écoutez, vous connaissez peut-être Prévost, le chocolat Prévost, tout près d’ici, sur les allées de Tourny."
                                            },
                                            {
                                                "example_id": "302b0554-9143-4dd6-b012-8bbf455b6f47",
                                                "sense_id": "a2c4f4b8-11d8-3b37-a4fb-27b5f4de7275",
                                                "text": "Paroles de soignants : fragments Samir Atroun, Guy Berthelot, Chloé Dandigny, Stéphanie Geiger-Boichot, Pierre Mayeux, Cécile Prévost, Anne Siegesmund, Nicolas Tiercelin, Claire Vernhes."
                                            }
                                        ]
                                    }
