                        "examples": [
                            {
                                "example_id": "e2c1c743-a755-4be9-b084-49315b44d90b",
                                "sense_id": "3e2ec1f2-81f9-3e2f-9f26-9403cd901750",
                                "text": "Je vous le dis en cet instant, vous êtes « reringardisés » et, après une nouvelle lecture de ce texte à l'Assemblée nationale, vous serez non seulement ringards mais tricards !"
                            },
                            {
                                "example_id": "9f571544-9c5d-4862-a922-6e5f0085f1c6",
                                "sense_id": "3e2ec1f2-81f9-3e2f-9f26-9403cd901750",
                                "text": "Il faut essayer de reringardiser cette foutue mode de la fourrure, faire en sorte d'être \"hype\" en disant non et en n’en portant pas."
                            }
                        ]
                    }
