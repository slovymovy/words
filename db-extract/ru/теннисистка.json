                ],
                "senses": [
                    {
                        "sense_id": "c18b8713-4420-3318-bf8c-f4d87ee2bd67",
                        "entry_id": "23b76769-be88-356e-85cf-c698fb0d77b9",
                        "glosses": [
                            "женск. к теннисист"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85e1be86-4c4e-453d-84f8-6cc1e8fcc56e",
                                "sense_id": "c18b8713-4420-3318-bf8c-f4d87ee2bd67",
                                "text": "Про известного поэта говорила одна теннисистка: «Да хоть какие его выступления с трибуны, а я с ним один раз играла, и теперь меня никакой гражданской позицией не обманешь!»"
                            },
                            {
                                "example_id": "68ae3252-29d3-4331-83e3-d021992b9dd4",
                                "sense_id": "c18b8713-4420-3318-bf8c-f4d87ee2bd67",
                                "text": "Российская теннисистка Вера Душевина одержала победу на проходившем в Ки-Бискейне неофициальном чемпионате мира среди спортсменок до 18 лет."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b80713e-554e-42aa-a96e-e0a2d93047c8",
                        "source_entry_id": "23b76769-be88-356e-85cf-c698fb0d77b9",
                        "source_sense_id": "c18b8713-4420-3318-bf8c-f4d87ee2bd67",
                        "target_lang_word": "Tennisspielerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tennisspielerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d215e16-f0b1-3896-974c-4fe0d352290e",
                                        "entry_id": "efa82fb3-d15d-3d24-aa21-044bc6045d15",
                                        "glosses": [
                                            "Sportlerin, die das Tennisspiel ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3175aef-17c7-4102-9828-0bde4d4d4c34",
                                                "sense_id": "3d215e16-f0b1-3896-974c-4fe0d352290e",
                                                "text": "„In Neuseeland nutzen Aktivisten den Auftritt der Tennisspielerin Shahar Peer für Proteste gegen Israels Palästina-Politik - und ärgern damit die Turnierleitung.“"
                                            },
                                            {
                                                "example_id": "3e279ba0-fb85-4d2c-8369-67a920f1d7b1",
                                                "sense_id": "3d215e16-f0b1-3896-974c-4fe0d352290e",
                                                "text": "„Sie war selbst eine hervorragende Tennisspielerin und eine gute Skifahrerin.“"
                                            },
                                            {
                                                "example_id": "04d8e6cf-f3af-42bf-867a-2a8d2da62032",
                                                "sense_id": "3d215e16-f0b1-3896-974c-4fe0d352290e",
                                                "text": "„Sie war sechzehn, als der Krieg zu Ende ging, ein schönes Mädchen, blond, die beste Tennisspielerin zwischen Bonn und Remagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
